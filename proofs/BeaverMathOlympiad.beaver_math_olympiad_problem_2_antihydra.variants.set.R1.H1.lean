theorem card_succ (p : ℕ → Prop) [DecidablePred p] (n : ℕ) :
    ((Finset.Ico 0 (n + 1)).filter p).card =
      ((Finset.Ico 0 n).filter p).card + if p n then 1 else 0 := by
  rw [← Finset.range_eq_Ico, ← Finset.range_eq_Ico, Finset.card_filter, Finset.card_filter,
    Finset.sum_range_succ]

theorem set_range (a : ℕ → ℕ) (a_ini : a 0 = 8) (a_rec : ∀ n, a (n + 1) = (3 * a n) / 2)
    (n : ℕ) (hn : n ≤ 100000) :
    ((Finset.Ico 0 n).filter fun x ↦ Odd (a x)).card ≤
      2 * ((Finset.Ico 0 n).filter fun x ↦ Even (a x)).card := by
  have hb := range a
    (fun k => 2 * (((Finset.Ico 0 k).filter fun x ↦ Even (a x)).card : ℤ) -
      (((Finset.Ico 0 k).filter fun x ↦ Odd (a x)).card : ℤ))
    a_ini a_rec (by simp) (by
      intro k
      rw [card_succ (fun x ↦ Even (a x)) k, card_succ (fun x ↦ Odd (a x)) k]
      by_cases h : a k % 2 = 0
      · have he : Even (a k) := Nat.even_iff.mpr h
        have ho : ¬ Odd (a k) := Nat.not_odd_iff_even.mpr he
        rw [if_pos h, if_pos he, if_neg ho]
        push_cast
        ring
      · have he : ¬ Even (a k) := fun he => h (Nat.even_iff.mp he)
        have ho : Odd (a k) := Nat.not_even_iff_odd.mp he
        rw [if_neg h, if_neg he, if_pos ho]
        push_cast
        ring) n hn
  omega

end OMA.Antihydra

theorem OMA.solution : OMA.R_BeaverMathOlympiad_beaver_math_olympiad_problem_2_antihydra_variants_set_R1.H1 := by
  intro a a_ini a_rec n hn
  exact OMA.Antihydra.set_range a a_ini a_rec n hn
