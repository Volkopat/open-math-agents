  have ha0 : a 0 = A0 := a_ini
  have hb0 : b 0 = (B0 : ℤ) := by rw [b_ini]; rfl
  obtain ⟨r0, ha1, hb1⟩ := run_spec a b a_rec b_rec 4000 0 A0 B0 A1 B1 ha0 hb0 t0
  rw [Nat.zero_add] at ha1 hb1
  obtain ⟨r1, ha2, hb2⟩ := run_spec a b a_rec b_rec 4000 4000 A1 B1 A2 B2 ha1 hb1 t1
  rw [show 4000 + 4000 = 8000 from rfl] at ha2 hb2
  obtain ⟨r2, ha3, hb3⟩ := run_spec a b a_rec b_rec 4000 8000 A2 B2 A3 B3 ha2 hb2 t2
  rw [show 8000 + 4000 = 12000 from rfl] at ha3 hb3
  obtain ⟨r3, ha4, hb4⟩ := run_spec a b a_rec b_rec 4000 12000 A3 B3 A4 B4 ha3 hb3 t3
  rw [show 12000 + 4000 = 16000 from rfl] at ha4 hb4
  obtain ⟨r4, ha5, hb5⟩ := run_spec a b a_rec b_rec 4000 16000 A4 B4 A5 B5 ha4 hb4 t4
  rw [show 16000 + 4000 = 20000 from rfl] at ha5 hb5
  obtain ⟨r5, ha6, hb6⟩ := run_spec a b a_rec b_rec 4000 20000 A5 B5 A6 B6 ha5 hb5 t5
  rw [show 20000 + 4000 = 24000 from rfl] at ha6 hb6
  obtain ⟨r6, ha7, hb7⟩ := run_spec a b a_rec b_rec 4000 24000 A6 B6 A7 B7 ha6 hb6 t6
  rw [show 24000 + 4000 = 28000 from rfl] at ha7 hb7
  obtain ⟨r7, ha8, hb8⟩ := run_spec a b a_rec b_rec 4000 28000 A7 B7 A8 B8 ha7 hb7 t7
  rw [show 28000 + 4000 = 32000 from rfl] at ha8 hb8
  obtain ⟨r8, ha9, hb9⟩ := run_spec a b a_rec b_rec 4000 32000 A8 B8 A9 B9 ha8 hb8 t8
  rw [show 32000 + 4000 = 36000 from rfl] at ha9 hb9
  obtain ⟨r9, ha10, hb10⟩ := run_spec a b a_rec b_rec 4000 36000 A9 B9 A10 B10 ha9 hb9 t9
  rw [show 36000 + 4000 = 40000 from rfl] at ha10 hb10
  obtain ⟨r10, ha11, hb11⟩ := run_spec a b a_rec b_rec 4000 40000 A10 B10 A11 B11 ha10 hb10 t10
  rw [show 40000 + 4000 = 44000 from rfl] at ha11 hb11
  obtain ⟨r11, ha12, hb12⟩ := run_spec a b a_rec b_rec 4000 44000 A11 B11 A12 B12 ha11 hb11 t11
  rw [show 44000 + 4000 = 48000 from rfl] at ha12 hb12
  obtain ⟨r12, ha13, hb13⟩ := run_spec a b a_rec b_rec 4000 48000 A12 B12 A13 B13 ha12 hb12 t12
  rw [show 48000 + 4000 = 52000 from rfl] at ha13 hb13
  obtain ⟨r13, ha14, hb14⟩ := run_spec a b a_rec b_rec 4000 52000 A13 B13 A14 B14 ha13 hb13 t13
  rw [show 52000 + 4000 = 56000 from rfl] at ha14 hb14
  obtain ⟨r14, ha15, hb15⟩ := run_spec a b a_rec b_rec 4000 56000 A14 B14 A15 B15 ha14 hb14 t14
  rw [show 56000 + 4000 = 60000 from rfl] at ha15 hb15
  obtain ⟨r15, ha16, hb16⟩ := run_spec a b a_rec b_rec 4000 60000 A15 B15 A16 B16 ha15 hb15 t15
  rw [show 60000 + 4000 = 64000 from rfl] at ha16 hb16
  obtain ⟨r16, ha17, hb17⟩ := run_spec a b a_rec b_rec 4000 64000 A16 B16 A17 B17 ha16 hb16 t16
  rw [show 64000 + 4000 = 68000 from rfl] at ha17 hb17
  obtain ⟨r17, ha18, hb18⟩ := run_spec a b a_rec b_rec 4000 68000 A17 B17 A18 B18 ha17 hb17 t17
  rw [show 68000 + 4000 = 72000 from rfl] at ha18 hb18
  obtain ⟨r18, ha19, hb19⟩ := run_spec a b a_rec b_rec 4000 72000 A18 B18 A19 B19 ha18 hb18 t18
  rw [show 72000 + 4000 = 76000 from rfl] at ha19 hb19
  obtain ⟨r19, ha20, hb20⟩ := run_spec a b a_rec b_rec 4000 76000 A19 B19 A20 B20 ha19 hb19 t19
  rw [show 76000 + 4000 = 80000 from rfl] at ha20 hb20
  obtain ⟨r20, ha21, hb21⟩ := run_spec a b a_rec b_rec 4000 80000 A20 B20 A21 B21 ha20 hb20 t20
  rw [show 80000 + 4000 = 84000 from rfl] at ha21 hb21
  obtain ⟨r21, ha22, hb22⟩ := run_spec a b a_rec b_rec 4000 84000 A21 B21 A22 B22 ha21 hb21 t21
  rw [show 84000 + 4000 = 88000 from rfl] at ha22 hb22
  obtain ⟨r22, ha23, hb23⟩ := run_spec a b a_rec b_rec 4000 88000 A22 B22 A23 B23 ha22 hb22 t22
  rw [show 88000 + 4000 = 92000 from rfl] at ha23 hb23
  obtain ⟨r23, ha24, hb24⟩ := run_spec a b a_rec b_rec 4000 92000 A23 B23 A24 B24 ha23 hb23 t23
  rw [show 92000 + 4000 = 96000 from rfl] at ha24 hb24
  obtain ⟨r24, ha25, hb25⟩ := run_spec a b a_rec b_rec 4000 96000 A24 B24 A25 B25 ha24 hb24 t24
  rw [show 96000 + 4000 = 100000 from rfl] at ha25 hb25
