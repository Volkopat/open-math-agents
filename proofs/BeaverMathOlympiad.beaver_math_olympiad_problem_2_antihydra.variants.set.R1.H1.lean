    rwa [e] at h
  by_cases g4 : n ≤ 20000
  · have h := r4 (n - 16000) (by omega)
    have e : 16000 + (n - 16000) = n := by omega
    rwa [e] at h
  by_cases g5 : n ≤ 24000
  · have h := r5 (n - 20000) (by omega)
    have e : 20000 + (n - 20000) = n := by omega
    rwa [e] at h
  by_cases g6 : n ≤ 28000
