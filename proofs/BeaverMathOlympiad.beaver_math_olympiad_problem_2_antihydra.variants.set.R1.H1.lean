-- Antihydra, counting form: among a 0, ..., a (n - 1) the odd terms are at most twice the even terms, n <= 100000.
-- The counter b n = 2 (number of even terms) - (number of odd terms) satisfies the recurrence of the counter
-- form (set_range), so this follows from the range for the counter.
-- run executes the recurrence from a stored state, checks that the counter can be decremented whenever a is
-- odd, and compares the final state with the next stored state (run_spec ties this to any sequences a, b
-- satisfying the recurrences). The kernel runs 25 blocks of 4000 steps between 26 stored states (computed
-- outside Lean; the last value of a has 17610 digits). Blocks are short because the kernel cost of a
-- structurally recursive loop grows faster than linearly in its length.
-- A verified numerical range only; not progress on the problem.

namespace OMA.Antihydra

/-- Run `f` steps from the state `(A, B)`, checking that the counter can always be decremented,
and compare the final state with `(A', B')`. -/
def run : ℕ → ℕ → ℕ → ℕ → ℕ → Bool
  | 0, A, B, A', B' => decide (A = A') && decide (B = B')
  | f + 1, A, B, A', B' =>
    if A % 2 = 0 then run f (3 * A / 2) (B + 2) A' B'
    else decide (1 ≤ B) && run f (3 * A / 2) (B - 1) A' B'

theorem run_spec (a : ℕ → ℕ) (b : ℕ → ℤ) (a_rec : ∀ n, a (n + 1) = (3 * a n) / 2)
    (b_rec : ∀ n, b (n + 1) = if a n % 2 = 0 then b n + 2 else b n - 1) :
    ∀ (f k A B A' B' : ℕ), a k = A → b k = (B : ℤ) → run f A B A' B' = true →
      (∀ i, i ≤ f → 0 ≤ b (k + i)) ∧ a (k + f) = A' ∧ b (k + f) = (B' : ℤ) := by
  intro f
  induction f with
  | zero =>
    intro k A B A' B' ha hb h
    rw [run, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at h
    refine ⟨fun i hi => ?_, ?_, ?_⟩
    · have hi0 : i = 0 := by omega
      subst hi0
      rw [Nat.add_zero, hb]
      exact Int.natCast_nonneg B
    · rw [Nat.add_zero, ha]
      exact h.1
    · rw [Nat.add_zero, hb, h.2]
  | succ f ih =>
    intro k A B A' B' ha hb h
    rw [run] at h
    have ha1 : a (k + 1) = 3 * A / 2 := by rw [a_rec, ha]
    have e : k + 1 + f = k + (f + 1) := by omega
    by_cases hA : A % 2 = 0
    · rw [if_pos hA] at h
      have hb1 : b (k + 1) = ((B + 2 : ℕ) : ℤ) := by
        rw [b_rec, ha, if_pos hA, hb]
        push_cast
        ring
      obtain ⟨h1, h2, h3⟩ := ih (k + 1) _ _ A' B' ha1 hb1 h
      rw [e] at h2 h3
      refine ⟨fun i hi => ?_, h2, h3⟩
      rcases Nat.eq_zero_or_pos i with rfl | hpos
      · rw [Nat.add_zero, hb]
        exact Int.natCast_nonneg B
      · have h4 := h1 (i - 1) (by omega)
        have e2 : k + 1 + (i - 1) = k + i := by omega
        rwa [e2] at h4
    · rw [if_neg hA, Bool.and_eq_true, decide_eq_true_eq] at h
      have hb1 : b (k + 1) = ((B - 1 : ℕ) : ℤ) := by
        rw [b_rec, ha, if_neg hA, hb]
        have h5 := h.1
        omega
      obtain ⟨h1, h2, h3⟩ := ih (k + 1) _ _ A' B' ha1 hb1 h.2
      rw [e] at h2 h3
      refine ⟨fun i hi => ?_, h2, h3⟩
      rcases Nat.eq_zero_or_pos i with rfl | hpos
      · rw [Nat.add_zero, hb]
        exact Int.natCast_nonneg B
      · have h4 := h1 (i - 1) (by omega)
        have e2 : k + 1 + (i - 1) = k + i := by omega
        rwa [e2] at h4

