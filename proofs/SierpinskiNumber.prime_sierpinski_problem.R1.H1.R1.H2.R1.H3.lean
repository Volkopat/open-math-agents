private theorem squareChain_add (m i j x : ℕ) :
    squareChain m (i + j) x = squareChain m j (squareChain m i x) := by
  induction i generalizing x with
  | zero => simp [squareChain]
  | succ i ih => rw [Nat.succ_add, squareChain, squareChain, ih]


