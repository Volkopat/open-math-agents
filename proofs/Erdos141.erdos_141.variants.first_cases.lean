import FormalConjectures.ErdosProblems.«141»
import Mathlib.NumberTheory.LucasPrimality
import Mathlib.Data.List.Prime

/-!
A certificate for the progression of ten consecutive primes found by Manfred Toplic,
published by Dubner, Forbes, Lygeros, Mizony and Zimmermann,
Ten consecutive primes in arithmetic progression, Math. Comp. 71 (2002), 1323–1328.
The Lucas certificate format follows the binary-exponentiation approach in
the project's HyperperfectNumber.two_hyperperfect_characterization proof by Deldor14.
FactorDB provided factorizations for the large predecessors.
-/

namespace ConsecutivePrimes141

-- Radix-64 modular exponentiation keeps the recursion for 93-digit inputs below 52 steps.
private def residue (p : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 1
  | h+1, a, n => if n = 0 then 1 else
      (a ^ (n % 64) * (residue p h a (n/64)) ^ 64) % p

private theorem cast_residue (p h a n : ℕ) (hn : n < 64^h) :
    (residue p h a n : ZMod p) = (a : ZMod p)^n := by
  induction h generalizing a n with
  | zero =>
    have : n = 0 := by simpa using hn
    simp [this, residue]
  | succ h ih =>
    by_cases hzero : n = 0
    · simp [hzero, residue]
    rw [pow_succ] at hn
    simp only [residue, if_neg hzero, ZMod.natCast_mod, Nat.cast_mul, Nat.cast_pow,
      ih a (n/64) (by omega), ← pow_mul, ← pow_add]
    congr 1
    omega

private theorem lucas (p a : ℕ) (f : List ℕ) (hf : f.prod = p-1)
    (primeFactors : ∀ q ∈ f, Nat.Prime q)
    (hsize : p < 64^52)
    (full : residue p 52 a (p-1) = 1)
    (partialPowers : ∀ q ∈ f, residue p 52 a ((p-1)/q) % p ≠ 1 % p) : p.Prime := by
  apply lucas_primality p (a : ZMod p)
  · rw [← cast_residue p 52 a (p-1) (by omega), full, Nat.cast_one]
  · intro q hq hd h
    rw [← hf] at hd
    obtain ⟨r, hr, hqr⟩ := (Prime.dvd_prod_iff hq.prime).mp hd
    obtain rfl := (Nat.prime_dvd_prime_iff_eq hq (primeFactors r hr)).mp hqr
    have hn := Nat.div_le_self (p-1) q
    rw [← cast_residue p 52 a _ (by omega), ← Nat.cast_one (R := ZMod p)] at h
    exact partialPowers q hr ((ZMod.natCast_eq_natCast_iff ..).mp h)

private theorem composite (n d : ℕ) (hc :
    (1 < d ∧ d < n ∧ n % d = 0) ∨
      (n < 64^52 ∧ residue n 52 2 n % n ≠ 2 % n)) : ¬ n.Prime := by
  intro hp
  rcases hc with ⟨h1, h2, hd⟩ | ⟨hsize, hpow⟩
  · rcases (Nat.dvd_prime hp).mp (Nat.dvd_of_mod_eq_zero hd) with h | h <;> omega
  · let : Fact n.Prime := ⟨hp⟩
    apply hpow
    apply (ZMod.natCast_eq_natCast_iff ..).mp
    rw [cast_residue _ _ _ _ hsize, Nat.cast_ofNat, ZMod.pow_card]


-- Each certificate (p, a, fs) may use factors certified earlier in the list.
private def ok : List ℕ → List (ℕ × ℕ × List ℕ) → Bool
  | _, [] => true
  | k, (p, a, fs) :: cs => fs.all (fun q => k.contains q || q < 5000 && decide q.Prime) &&
      decide (fs.prod = p-1 ∧ p < 64^52 ∧ residue p 52 a (p-1) = 1 ∧
        fs.all (fun q => decide (residue p 52 a ((p-1)/q) % p ≠ 1 % p)) = true) && ok (p :: k) cs

private theorem sound (cs : List (ℕ × ℕ × List ℕ)) : ∀ k, ok k cs = true →
    (∀ q ∈ k, q.Prime) → ∀ p ∈ cs.map (·.1), p.Prime := by
  induction cs with
  | nil => simp
  | cons c cs ih =>
    obtain ⟨p, a, fs⟩ := c
    intro k h hk
    simp only [ok, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, Bool.or_eq_true,
      List.contains_iff_mem] at h
    have hp : p.Prime := lucas p a fs h.1.2.1 (fun q hq => (h.1.1 q hq).elim (hk q)
      (·.2)) h.1.2.2.1 h.1.2.2.2.1 h.1.2.2.2.2
    simpa [hp] using ih _ h.2 (by simpa [hp] using hk)

