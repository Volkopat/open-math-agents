/-! ### Part 1: Bitmask sieve for primes < M = 200446 -/

private def geomSum (p : ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => 1 + (geomSum p k <<< p)

private def geomFast (p k : ℕ) : ℕ :=
  ((1 <<< (k * p)) - 1) / ((1 <<< p) - 1)

private lemma shiftLeft_eq_mul_pow (a b : ℕ) : a <<< b = a * 2 ^ b := by
  simp [Nat.shiftLeft_eq]

private lemma shiftRight_eq_div_pow (a b : ℕ) : a >>> b = a / 2 ^ b := by
  simp [Nat.shiftRight_eq_div_pow]

private lemma land_pow_sub_one (a b : ℕ) : a &&& (2 ^ b - 1) = a % 2 ^ b := by
  rw [Nat.and_two_pow_sub_one_eq_mod]

private lemma geomSum_mul (p k : ℕ) :
    geomSum p k * (2 ^ p - 1) = 2 ^ (k * p) - 1 := by
  induction k with
  | zero => simp [geomSum]
  | succ k ih =>
    have h1 : 1 ≤ 2 ^ p := Nat.one_le_pow p 2 (by decide)
    have h2 : 1 ≤ 2 ^ (k * p) := Nat.one_le_pow (k * p) 2 (by decide)
    have h3 : (k + 1) * p = k * p + p := by ring
    have h4 : 1 ≤ 2 ^ (k * p) * 2 ^ p := by nlinarith
    rw [geomSum, shiftLeft_eq_mul_pow, Nat.add_mul, Nat.one_mul, Nat.mul_right_comm, ih, h3,
      pow_add]
    zify [h1, h2, h4]
    ring

private lemma geomFast_eq_geomSum {p : ℕ} (hp : 0 < p) (k : ℕ) :
    geomFast p k = geomSum p k := by
  unfold geomFast
  rw [shiftLeft_eq_mul_pow, shiftLeft_eq_mul_pow, Nat.one_mul, Nat.one_mul]
  have hpos : 0 < 2 ^ p - 1 := by
    have : 2 ≤ 2 ^ p := by
      calc 2 = 2 ^ 1 := by decide
        _ ≤ 2 ^ p := Nat.pow_le_pow_right (by decide) hp
    omega
  rw [← geomSum_mul p k, Nat.mul_div_cancel _ hpos]

private lemma testBit_geomSum {p : ℕ} (hp : 0 < p) (k n : ℕ) :
    (geomSum p k).testBit n = decide (p ∣ n ∧ n < k * p) := by
  induction k generalizing n with
  | zero => simp [geomSum]
  | succ k ih =>
    rw [geomSum, shiftLeft_eq_mul_pow]
    have hlo : (1 : ℕ) < 2 ^ p := by
      have : 2 ≤ 2 ^ p := by
        calc 2 = 2 ^ 1 := by decide
          _ ≤ 2 ^ p := Nat.pow_le_pow_right (by decide) hp
      omega
    by_cases hn : n < p
    · have h1 : (1 + geomSum p k * 2 ^ p).testBit n = (1 : ℕ).testBit n := by
        rw [Nat.testBit, Nat.testBit, Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow]
        have hpow : 2 ^ p = 2 ^ n * 2 ^ (p - n) := by
          rw [← pow_add, Nat.add_sub_of_le hn.le]
        have hrew : 1 + geomSum p k * 2 ^ p = 1 + (geomSum p k * 2 ^ (p - n)) * 2 ^ n := by
          rw [hpow]; ring
        rw [hrew, Nat.add_mul_div_right _ _ (by positivity)]
        have h2 : 2 ∣ 2 ^ (p - n) := dvd_pow_self 2 (by omega)
        obtain ⟨t, ht⟩ := h2
        have hmod : 1 &&& (1 / 2 ^ n + geomSum p k * 2 ^ (p - n)) = 1 &&& (1 / 2 ^ n) := by
          rw [ht, Nat.and_comm 1, Nat.and_comm 1, Nat.and_one_is_mod, Nat.and_one_is_mod,
            show geomSum p k * (2 * t) = 2 * (geomSum p k * t) by ring, Nat.add_mul_mod_self_left]
        rw [hmod]
      rw [h1]
      rcases Nat.eq_zero_or_pos n with rfl | hn0
      · simp [Nat.mul_pos (Nat.succ_pos k) hp]
      · have hndvd : ¬ p ∣ n := Nat.not_dvd_of_pos_of_lt hn0 hn
        have htb : (1 : ℕ).testBit n = false := by
          rw [Nat.testBit, Nat.shiftRight_eq_div_pow]
          have : 2 ≤ 2 ^ n := by
            calc 2 = 2 ^ 1 := by decide
              _ ≤ 2 ^ n := Nat.pow_le_pow_right (by decide) hn0
          rw [Nat.div_eq_of_lt (by omega)]
          rfl
        simp [htb, hndvd]
    · push Not at hn
      have h1 : (1 + geomSum p k * 2 ^ p).testBit n = (geomSum p k).testBit (n - p) := by
        rw [Nat.testBit, Nat.testBit, Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow]
        have hpow : 2 ^ n = 2 ^ p * 2 ^ (n - p) := by
          rw [← pow_add, Nat.add_sub_of_le hn]
        rw [hpow, ← Nat.div_div_eq_div_mul, Nat.add_mul_div_right _ _ (by positivity),
          Nat.div_eq_of_lt hlo, Nat.zero_add]
      rw [h1, ih (n - p)]
      have hdvd : p ∣ n - p ↔ p ∣ n := by
        constructor
        · intro h
          rw [← Nat.sub_add_cancel hn]
          exact dvd_add h (dvd_refl p)
        · intro h
          exact Nat.dvd_sub h (dvd_refl p)
      have hlt : n - p < k * p ↔ n < (k + 1) * p := by
        rw [Nat.add_mul, Nat.one_mul]; omega
      simp [hdvd, hlt]

private def multMask (p : ℕ) : ℕ :=
  let k := (M - 1) / p + 1
  geomFast p k - 1 - (1 <<< p)

private lemma multMask_testBit {p : ℕ} (hp : 2 ≤ p) {n : ℕ} (hn : n < M) :
    (multMask p).testBit n = decide (p ∣ n ∧ 2 * p ≤ n) := by
  unfold multMask
  dsimp only
  have hp0 : 0 < p := by omega
  have hkp : M ≤ ((M - 1) / p + 1) * p := by
    have := Nat.lt_mul_div_succ (M - 1) hp0
    rw [Nat.mul_comm]; omega
  have hk_pos : 1 ≤ (M - 1) / p + 1 := Nat.succ_pos _
  generalize (M - 1) / p + 1 = k at hkp hk_pos ⊢
  rw [geomFast_eq_geomSum hp0 k]
  by_cases hk2 : k < 2
  · have hk1 : k = 1 := by omega
    have hpm : M ≤ p := by rw [hk1, Nat.one_mul] at hkp; exact hkp
    have hzero : geomSum p k - 1 - (1 <<< p) = 0 := by
      rw [hk1]; simp [geomSum]
    rw [hzero, Nat.zero_testBit]
    simp [show ¬ (2 * p ≤ n) by omega]
  · push Not at hk2
    obtain ⟨m, rfl⟩ : ∃ m, k = m + 2 := ⟨k - 2, by omega⟩
    have hdecomp : geomSum p (m + 2) = 1 + 2 ^ p + geomSum p m * 2 ^ (2 * p) := by
      simp only [geomSum, shiftLeft_eq_mul_pow, Nat.add_mul, Nat.one_mul, Nat.mul_assoc, ← pow_add]
      rw [show p + p = 2 * p by ring]
      ring
    rw [hdecomp, shiftLeft_eq_mul_pow, Nat.one_mul]
    have hsub : 1 + 2 ^ p + geomSum p m * 2 ^ (2 * p) - 1 - 2 ^ p = geomSum p m * 2 ^ (2 * p) := by
      omega
    rw [hsub]
    by_cases h2p : n < 2 * p
    · have htb : (geomSum p m * 2 ^ (2 * p)).testBit n = false := by
        rw [Nat.testBit, Nat.shiftRight_eq_div_pow]
        have hpow : 2 ^ (2 * p) = 2 ^ n * 2 ^ (2 * p - n) := by
          rw [← pow_add, Nat.add_sub_of_le h2p.le]
        have hrew : geomSum p m * 2 ^ (2 * p) = (geomSum p m * 2 ^ (2 * p - n)) * 2 ^ n := by
          rw [hpow]; ring
        rw [hrew, Nat.mul_div_cancel _ (by positivity)]
        have h2 : 2 ∣ 2 ^ (2 * p - n) := dvd_pow_self 2 (by omega)
        obtain ⟨t, ht⟩ := h2
        rw [ht, Nat.and_comm 1, Nat.and_one_is_mod,
          show geomSum p m * (2 * t) = 2 * (geomSum p m * t) by ring, Nat.mul_mod_right]
        rfl
      simp [htb, show ¬ (2 * p ≤ n) by omega]
    · push Not at h2p
      have htb : (geomSum p m * 2 ^ (2 * p)).testBit n = (geomSum p m).testBit (n - 2 * p) := by
        rw [Nat.testBit, Nat.testBit, Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow]
        have hpow : 2 ^ n = 2 ^ (2 * p) * 2 ^ (n - 2 * p) := by
          rw [← pow_add, Nat.add_sub_of_le h2p]
        rw [hpow, ← Nat.div_div_eq_div_mul, Nat.mul_div_cancel _ (by positivity)]
      rw [htb, testBit_geomSum hp0 m (n - 2 * p)]
      have hdvd : p ∣ n - 2 * p ↔ p ∣ n := by
        constructor
        · intro h
          rw [← Nat.sub_add_cancel h2p]
          exact dvd_add h (dvd_mul_left p 2)
        · intro h
          exact Nat.dvd_sub h (dvd_mul_left p 2)
      have hlt : n - 2 * p < m * p := by
        have : (m + 2) * p = m * p + 2 * p := by ring
        omega
      simp [hdvd, hlt, h2p]

private def orMasks : ℕ → ℕ → ℕ
  | _, 0 => 0
  | i, 1 => multMask (getP86 i)
  | i, n + 2 =>
    let half := (n + 2) / 2
    orMasks i half ||| orMasks (i + half) (n + 2 - half)

private def allComp : ℕ := 3 ||| orMasks 0 86

private def primeMask : ℕ :=
  ((1 <<< M) - 1) ^^^ (allComp &&& ((1 <<< M) - 1))

private lemma testBit_orMasks (i len n : ℕ) :
    (orMasks i len).testBit n = true ↔
      ∃ j, i ≤ j ∧ j < i + len ∧ (multMask (getP86 j)).testBit n = true := by
  induction len using Nat.strongRecOn generalizing i with
  | ind len ih =>
    match len with
    | 0 =>
      simp only [orMasks, Nat.zero_testBit, Bool.false_eq_true, Nat.add_zero, false_iff, not_exists]
      intro x hx
      omega
    | 1 =>
      simp only [orMasks]
      constructor
      · intro h; exact ⟨i, le_rfl, by omega, h⟩
      · rintro ⟨j, hj1, hj2, h⟩
        have hji : j = i := by omega
        subst hji
        exact h
    | m + 2 =>
      unfold orMasks
      dsimp only
      set half := (m + 2) / 2
      have h1 : half < m + 2 := by omega
      have h2 : m + 2 - half < m + 2 := by omega
      rw [Nat.testBit_lor, Bool.or_eq_true, ih half h1 i, ih (m + 2 - half) h2 (i + half)]
      constructor
      · rintro (⟨j, hj1, hj2, h⟩ | ⟨j, hj1, hj2, h⟩)
        · exact ⟨j, hj1, by omega, h⟩
        · exact ⟨j, by omega, by omega, h⟩
      · rintro ⟨j, hj1, hj2, h⟩
        by_cases hj : j < i + half
        · exact Or.inl ⟨j, hj1, hj, h⟩
        · exact Or.inr ⟨j, by omega, by omega, h⟩

private lemma testBit_pow_sub_one (m n : ℕ) :
    (2 ^ m - 1).testBit n = decide (n < m) := by
  have h := testBit_geomSum (p := 1) (by decide) m n
  rw [← geomFast_eq_geomSum (by decide)] at h
  unfold geomFast at h
  rw [shiftLeft_eq_mul_pow, shiftLeft_eq_mul_pow, Nat.one_mul, Nat.one_mul, Nat.mul_one] at h
  simpa only [show 2 ^ 1 - 1 = 1 by decide, Nat.div_one, one_dvd, true_and] using h

private lemma primeMask_testBit (n : ℕ) :
    primeMask.testBit n = (decide (n < M) && !allComp.testBit n) := by
  unfold primeMask
  rw [shiftLeft_eq_mul_pow, Nat.one_mul, Nat.testBit_xor, Nat.testBit_and, testBit_pow_sub_one]
  by_cases hn : n < M <;> simp [hn]

private lemma testBit_three (n : ℕ) : (3 : ℕ).testBit n = decide (n < 2) := by
  have := testBit_pow_sub_one 2 n
  exact this

private lemma ps86_prime : ∀ i : Fin 86, (getP86 i.1).Prime := by decide +kernel
private lemma ps86_strictMono : ∀ i : Fin 85, getP86 i.1 < getP86 (i.1 + 1) := by decide +kernel
private lemma ps86_complete : ∀ q : Fin 449, q.1.Prime → ∃ i : Fin 86, getP86 i.1 = q.1 := by
  decide +kernel

private lemma ps86_ge_two {i : ℕ} (hi : i < 86) : 2 ≤ getP86 i :=
  (ps86_prime ⟨i, hi⟩).two_le

private lemma ps86_le_443 {i : ℕ} (hi : i < 86) : getP86 i ≤ 443 := by
  have h85 : getP86 85 = 443 := by decide +kernel
  have hmono : ∀ a b : ℕ, a ≤ b → b < 86 → getP86 a ≤ getP86 b := by
    intro a b hab hb
    induction hab with
    | refl => exact le_rfl
    | @step m hm ih =>
      exact (ih (by omega)).trans (ps86_strictMono ⟨m, by omega⟩).le
  exact (hmono i 85 (by omega) (by omega)).trans_eq h85

private lemma primeMask_testBit_iff_prime {n : ℕ} (hn : n < M) :
    primeMask.testBit n = true ↔ n.Prime := by
  rw [primeMask_testBit, Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true']
  simp only [hn, true_and]
  unfold allComp
  rw [Nat.testBit_lor, Bool.or_eq_false_iff, testBit_three, decide_eq_false_iff_not, not_lt,
    ← Bool.not_eq_true, testBit_orMasks]
  push Not
  constructor
  · rintro ⟨hn2, hno⟩
    by_contra hnp
    set q := n.minFac
    have hqp : q.Prime := Nat.minFac_prime (by omega)
    have hqdvd : q ∣ n := Nat.minFac_dvd n
    have hqsq : q * q ≤ n := by simpa [sq] using Nat.minFac_sq_le_self (by omega) hnp
    have hq448 : q < 449 := by dsimp only [M] at hn; nlinarith
    obtain ⟨⟨j, hj⟩, hjq⟩ := ps86_complete ⟨q, hq448⟩ hqp
    dsimp only at hjq
    have h2q : 2 * getP86 j ≤ n := by
      have := hqp.two_le
      nlinarith
    have hbad := hno j (Nat.zero_le _) (by omega)
    rw [multMask_testBit (ps86_ge_two hj) hn] at hbad
    exact hbad (decide_eq_true ⟨hjq.symm ▸ hqdvd, h2q⟩)
  · intro hp
    refine ⟨hp.two_le, fun j _ hj => ?_⟩
    rw [multMask_testBit (ps86_ge_two (by omega)) hn]
    simp only [ne_eq, decide_eq_true_eq]
    rintro ⟨hdvd, h2p⟩
    have hpj := ps86_prime ⟨j, by omega⟩
    dsimp only at hpj
    rcases hp.eq_one_or_self_of_dvd _ hdvd with h1 | hself
    · exact hpj.ne_one h1
    · have := hpj.two_le; omega

/-! ### Part 2: Exact popcount and prefix sum table -/

private def bitCount (mask n : ℕ) : ℕ :=
  ((Finset.range n).filter (fun i => mask.testBit i)).card

private lemma land_one_eq_ite (x : ℕ) : (x &&& 1) = if x.testBit 0 then 1 else 0 := by
  rw [Nat.and_one_is_mod, Nat.testBit_zero]
  rcases Nat.mod_two_eq_zero_or_one x with h | h <;> simp [h]

private lemma shiftRight_land_one (x k : ℕ) :
    ((x >>> k) &&& 1) = if x.testBit k then 1 else 0 := by
  rw [land_one_eq_ite, Nat.testBit_shiftRight, Nat.add_zero]

private def pop8 (x : ℕ) : ℕ :=
  (x &&& 1) + ((x >>> 1) &&& 1) + ((x >>> 2) &&& 1) + ((x >>> 3) &&& 1) +
  ((x >>> 4) &&& 1) + ((x >>> 5) &&& 1) + ((x >>> 6) &&& 1) + ((x >>> 7) &&& 1)

private def pop64 (x : ℕ) : ℕ :=
  pop8 x + pop8 (x >>> 8) + pop8 (x >>> 16) + pop8 (x >>> 24) +
  pop8 (x >>> 32) + pop8 (x >>> 40) + pop8 (x >>> 48) + pop8 (x >>> 56)

private lemma bitCount_add (mask a b : ℕ) :
    bitCount mask (a + b) = bitCount mask a + bitCount (mask >>> a) b := by
  unfold bitCount
  rw [Finset.card_filter, Finset.card_filter, Finset.card_filter, Finset.sum_range_add]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  rw [Nat.testBit_shiftRight]

private lemma pop8_eq_bitCount (x : ℕ) : pop8 x = bitCount x 8 := by
  unfold pop8 bitCount
  rw [Finset.card_filter]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.zero_add,
    land_one_eq_ite, Nat.testBit_shiftRight]

private lemma pop64_eq_bitCount (x : ℕ) : pop64 x = bitCount x 64 := by
  unfold pop64
  simp only [pop8_eq_bitCount]
  have h1 : bitCount x 16 = bitCount x 8 + bitCount (x >>> 8) 8 := bitCount_add x 8 8
  have h2 : bitCount x 24 = bitCount x 16 + bitCount (x >>> 16) 8 := bitCount_add x 16 8
  have h3 : bitCount x 32 = bitCount x 24 + bitCount (x >>> 24) 8 := bitCount_add x 24 8
  have h4 : bitCount x 40 = bitCount x 32 + bitCount (x >>> 32) 8 := bitCount_add x 32 8
  have h5 : bitCount x 48 = bitCount x 40 + bitCount (x >>> 40) 8 := bitCount_add x 40 8
  have h6 : bitCount x 56 = bitCount x 48 + bitCount (x >>> 48) 8 := bitCount_add x 48 8
  have h7 : bitCount x 64 = bitCount x 56 + bitCount (x >>> 56) 8 := bitCount_add x 56 8
  omega

private lemma lane16_add_mul_geom (L t c : ℕ) (ht : t < 2 ^ (16 * L))
    (hc : ∀ b < L, ((t >>> (b * 16)) &&& 0xffff) + c < 2 ^ 16) :
    t + c * geomSum 16 L < 2 ^ (16 * L) ∧
    ∀ b < L, (((t + c * geomSum 16 L) >>> (b * 16)) &&& 0xffff) =
      ((t >>> (b * 16)) &&& 0xffff) + c := by
  induction L generalizing t with
  | zero =>
    simp only [Nat.mul_zero, pow_zero] at ht ⊢
    exact ⟨by simp [geomSum]; omega, fun b hb => by omega⟩
  | succ L ih =>
    set t0 := t % 2 ^ 16
    set t1 := t / 2 ^ 16
    have ht_eq : t = t0 + t1 * 2 ^ 16 := by dsimp [t0, t1]; omega
    have ht0_eq : (t >>> (0 * 16)) &&& 0xffff = t0 := by
      rw [Nat.zero_mul, Nat.shiftRight_zero, show (0xffff : ℕ) = 2 ^ 16 - 1 by decide,
        land_pow_sub_one]
    have ht0c : t0 + c < 2 ^ 16 := by
      rw [← ht0_eq]; exact hc 0 (Nat.succ_pos L)
    have ht1_lt : t1 < 2 ^ (16 * L) := by
      rw [show t1 = t / 2 ^ 16 from rfl, Nat.div_lt_iff_lt_mul (by positivity)]
      calc t < 2 ^ (16 * (L + 1)) := ht
        _ = 2 ^ (16 * L) * 2 ^ 16 := by rw [Nat.mul_add, pow_add]
    have ht1_lanes : ∀ b < L, ((t1 >>> (b * 16)) &&& 0xffff) = ((t >>> ((b + 1) * 16)) &&& 0xffff) := by
      intro b _
      rw [show t1 = t / 2 ^ 16 from rfl, shiftRight_eq_div_pow, shiftRight_eq_div_pow,
        Nat.div_div_eq_div_mul, ← pow_add, show 16 + b * 16 = (b + 1) * 16 by ring]
    have hih := ih t1 ht1_lt (fun b hb => by rw [ht1_lanes b hb]; exact hc (b + 1) (by omega))
    have hcomb : t + c * geomSum 16 (L + 1) = (t0 + c) + (t1 + c * geomSum 16 L) * 2 ^ 16 := by
      rw [ht_eq, geomSum, shiftLeft_eq_mul_pow]; ring
    constructor
    · rw [hcomb, show 2 ^ (16 * (L + 1)) = 2 ^ (16 * L) * 2 ^ 16 by rw [Nat.mul_add, pow_add]]
      have h1 := hih.1
      nlinarith
    · intro b hb
      rw [hcomb]
      rcases b with _ | b
      · rw [Nat.zero_mul, Nat.shiftRight_zero, show (0xffff : ℕ) = 2 ^ 16 - 1 by decide,
          land_pow_sub_one, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt ht0c,
          Nat.shiftRight_zero, land_pow_sub_one]
      · rw [← ht1_lanes b (by omega), ← hih.2 b (by omega)]
        rw [shiftRight_eq_div_pow, shiftRight_eq_div_pow,
          show (b + 1) * 16 = 16 + b * 16 by ring, pow_add, ← Nat.div_div_eq_div_mul,
          Nat.add_mul_div_right _ _ (by positivity), Nat.div_eq_of_lt ht0c, Nat.zero_add]

private def buildPop : ℕ → ℕ → ℕ × ℕ
  | mask, 0 => (pop64 mask, 0)
  | mask, d + 1 =>
    let halfBits := 64 <<< d
    let loMask := mask &&& ((1 <<< halfBits) - 1)
    let hiMask := mask >>> halfBits
    let (pLo, tLo) := buildPop loMask d
    let (pHi, tHi) := buildPop hiMask d
    let halfLanes := 1 <<< d
    let ones16 := geomFast 16 halfLanes
    let tHiShifted := tHi + pLo * ones16
    (pLo + pHi, tLo + (tHiShifted <<< (16 * halfLanes)))

private lemma bitCount_and_pow_sub_one (mask H k : ℕ) (hk : k ≤ H) :
    bitCount (mask &&& (2 ^ H - 1)) k = bitCount mask k := by
  unfold bitCount
  congr 1
  apply Finset.filter_congr
  intro i hi
  have hiH : i < H := lt_of_lt_of_le (Finset.mem_range.mp hi) hk
  rw [Nat.testBit_and, testBit_pow_sub_one, decide_eq_true hiH, Bool.and_true]

private lemma buildPop_spec (d : ℕ) : ∀ (mask : ℕ),
    (buildPop mask d).1 = bitCount mask (64 * 2 ^ d) ∧
    (bitCount mask (64 * 2 ^ d) < 2 ^ 16 →
      (buildPop mask d).2 < 2 ^ (16 * 2 ^ d) ∧
      ∀ b < 2 ^ d, (((buildPop mask d).2 >>> (b * 16)) &&& 0xffff) = bitCount mask (64 * b)) := by
  induction d with
  | zero =>
    intro mask
    simp only [buildPop, pow_zero, Nat.mul_one, pop64_eq_bitCount]
    refine ⟨trivial, fun _ => ⟨by decide, fun b hb => ?_⟩⟩
    have hb0 : b = 0 := by omega
    subst hb0
    simp [bitCount]
  | succ d ih =>
    intro mask
    unfold buildPop
    dsimp only
    set H := 64 * 2 ^ d
    set L := 2 ^ d
    have hH : 64 <<< d = H := by rw [shiftLeft_eq_mul_pow]
    have hL : 1 <<< d = L := by rw [shiftLeft_eq_mul_pow, Nat.one_mul]
    rw [hH, hL, shiftLeft_eq_mul_pow, Nat.one_mul]
    set loMask := mask &&& (2 ^ H - 1)
    set hiMask := mask >>> H
    have hlo := ih loMask
    have hhi := ih hiMask
    have hpLo : (buildPop loMask d).1 = bitCount mask H := by
      rw [hlo.1]; exact bitCount_and_pow_sub_one mask H H le_rfl
    have htot : bitCount mask (64 * 2 ^ (d + 1)) = bitCount mask H + bitCount hiMask H := by
      rw [show 64 * 2 ^ (d + 1) = H + H by dsimp [H]; ring]
      exact bitCount_add mask H H
    constructor
    · rw [hpLo, hhi.1, htot]
    · intro hsmall
      have hlo_small : bitCount loMask H < 2 ^ 16 := by
        rw [bitCount_and_pow_sub_one mask H H le_rfl]; omega
      have hhi_small : bitCount hiMask H < 2 ^ 16 := by omega
      obtain ⟨htLo_lt, htLo_lanes⟩ := hlo.2 hlo_small
      obtain ⟨htHi_lt, htHi_lanes⟩ := hhi.2 hhi_small
      have hsum_lanes : ∀ b < L,
          (((buildPop hiMask d).2 >>> (b * 16)) &&& 0xffff) + (buildPop loMask d).1 < 2 ^ 16 := by
        intro b hb
        rw [htHi_lanes b hb, hpLo]
        have hle : bitCount hiMask (64 * b) ≤ bitCount hiMask H :=
          Finset.card_le_card (Finset.filter_subset_filter _ (Finset.range_mono (by
            dsimp [H, L] at *; nlinarith)))
        omega
      have hshift := lane16_add_mul_geom L (buildPop hiMask d).2 (buildPop loMask d).1 htHi_lt hsum_lanes
      rw [geomFast_eq_geomSum (by decide) L, shiftLeft_eq_mul_pow]
      set tLo := (buildPop loMask d).2
      set tHiS := (buildPop hiMask d).2 + (buildPop loMask d).1 * geomSum 16 L
      have h16L : 2 ^ (16 * 2 ^ (d + 1)) = 2 ^ (16 * L) * 2 ^ (16 * L) := by
        rw [← pow_add]; congr 1; dsimp [L]; ring
      constructor
      · rw [h16L]
        have h1 := hshift.1
        nlinarith
      · intro b hb
        by_cases hbL : b < L
        · have hlow : ((tLo + tHiS * 2 ^ (16 * L)) >>> (b * 16)) &&& 0xffff =
              (tLo >>> (b * 16)) &&& 0xffff := by
            rw [shiftRight_eq_div_pow, shiftRight_eq_div_pow,
              show (0xffff : ℕ) = 2 ^ 16 - 1 by decide, land_pow_sub_one, land_pow_sub_one]
            have hpow : 2 ^ (16 * L) = 2 ^ (b * 16) * (2 ^ ((L - 1 - b) * 16) * 2 ^ 16) := by
              rw [← pow_add, ← pow_add]; congr 1; omega
            have hrew : tLo + tHiS * 2 ^ (16 * L) =
                tLo + (tHiS * 2 ^ ((L - 1 - b) * 16) * 2 ^ 16) * 2 ^ (b * 16) := by
              rw [hpow]; ring
            rw [hrew, Nat.add_mul_div_right _ _ (Nat.two_pow_pos _), Nat.add_mul_mod_self_right]
          rw [hlow, htLo_lanes b hbL]
          exact bitCount_and_pow_sub_one mask H (64 * b) (by dsimp [H, L] at *; nlinarith)
        · push Not at hbL
          have hhigh : ((tLo + tHiS * 2 ^ (16 * L)) >>> (b * 16)) &&& 0xffff =
              (tHiS >>> ((b - L) * 16)) &&& 0xffff := by
            rw [shiftRight_eq_div_pow, shiftRight_eq_div_pow]
            have hpow : 2 ^ (b * 16) = 2 ^ (16 * L) * 2 ^ ((b - L) * 16) := by
              rw [← pow_add]; congr 1; omega
            rw [hpow, ← Nat.div_div_eq_div_mul, Nat.add_mul_div_right _ _ (Nat.two_pow_pos _),
              Nat.div_eq_of_lt htLo_lt, Nat.zero_add]
          rw [hhigh, hshift.2 (b - L) (by dsimp [L] at *; omega),
            htHi_lanes (b - L) (by dsimp [L] at *; omega), hpLo]
          have heq : 64 * b = H + 64 * (b - L) := by dsimp [H, L] at *; omega
          rw [heq, bitCount_add, Nat.add_comm]

private lemma primeMask_eq_lit : primeMask = primeMaskLit := by decide +kernel
private lemma popTable_eq_lit : (buildPop primeMaskLit 12).2 = popTableLit := by decide +kernel
private lemma totPop_lt : (buildPop primeMaskLit 12).1 < 2 ^ 16 := by decide +kernel

private def piFast (y : ℕ) : ℕ :=
  let b := y / 64
  let r := y % 64
  let base := (popTableLit >>> (b * 16)) &&& 0xffff
  let w := (primeMaskLit >>> (b * 64)) &&& ((1 <<< (r + 1)) - 1)
  base + pop64 w

private lemma piFast_eq_primeCounting {y : ℕ} (hy : y < M) :
    piFast y = Nat.primeCounting y := by
  have hspec := buildPop_spec 12 primeMaskLit
  have hsmall : bitCount primeMaskLit (64 * 2 ^ 12) < 2 ^ 16 := by
    rw [← hspec.1]; exact totPop_lt
  obtain ⟨_, hlanes⟩ := hspec.2 hsmall
  unfold piFast
  dsimp only
  set b := y / 64
  set r := y % 64
  have hb : b < 2 ^ 12 := by dsimp [b, M] at *; omega
  have hr : r < 64 := Nat.mod_lt y (by decide)
  have hy_eq : y + 1 = 64 * b + (r + 1) := by dsimp [b, r]; omega
  rw [← popTable_eq_lit, hlanes b hb, pop64_eq_bitCount,
    shiftLeft_eq_mul_pow, Nat.one_mul]
  have hw : bitCount ((primeMaskLit >>> (b * 64)) &&& (2 ^ (r + 1) - 1)) 64 =
      bitCount (primeMaskLit >>> (64 * b)) (r + 1) := by
    rw [show b * 64 = 64 * b by ring]
    unfold bitCount
    congr 1
    ext i
    simp only [Finset.mem_filter, Finset.mem_range, Nat.testBit_and, testBit_pow_sub_one,
      Bool.and_eq_true, decide_eq_true_eq]
    constructor
    · rintro ⟨_, h1, h2⟩; exact ⟨h2, h1⟩
    · rintro ⟨h1, h2⟩; exact ⟨by omega, h2, h1⟩
  rw [hw, ← bitCount_add, ← hy_eq, ← primeMask_eq_lit]
  unfold bitCount
  rw [Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range]
  congr 1
  apply Finset.filter_congr
  intro n hn
  have hnM : n < M := by have := Finset.mem_range.mp hn; omega
  exact primeMask_testBit_iff_prime hnM

/-! ### Part 3: Verification of `psMid` (all 1089 primes in `[449, 9486]`) -/

private lemma psMid_props :
    ∀ j : Fin 1089, 449 ≤ getPMid j.1 ∧ getPMid j.1 ≤ 9486 ∧
      primeMaskLit.testBit (getPMid j.1) = true := by decide +kernel

private lemma psMid_strictMono : ∀ j : Fin 1088, getPMid j.1 < getPMid (j.1 + 1) := by
  decide +kernel

private lemma psMid_lt_of_lt {a b : ℕ} (hab : a < b) (hb : b < 1089) :
    getPMid a < getPMid b := by
  induction b with
  | zero => omega
  | succ b ih =>
    by_cases h : a = b
    · subst h; exact psMid_strictMono ⟨a, by omega⟩
    · exact (ih (by omega) (by omega)).trans (psMid_strictMono ⟨b, by omega⟩)

private lemma psMid_prime {j : ℕ} (hj : j < 1089) : (getPMid j).Prime := by
  have h := psMid_props ⟨j, hj⟩
  dsimp only at h
  have hlt : getPMid j < M := by dsimp only [M]; omega
  exact (primeMask_testBit_iff_prime hlt).mp (primeMask_eq_lit ▸ h.2.2)

private lemma piFast_448 : piFast 448 = 86 := by decide +kernel
private lemma piFast_9486 : piFast 9486 = 1175 := by decide +kernel

private lemma psMid_complete {p : ℕ} (hp : p.Prime) (hlo : 449 ≤ p) (hhi : p ≤ 9486) :
    ∃ j < 1089, getPMid j = p := by
  set S := (Finset.Icc 449 9486).filter Nat.Prime
  set T := (Finset.range 1089).image getPMid
  have hsub : T ⊆ S := by
    intro x hx
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hx
    have hj' : j < 1089 := Finset.mem_range.mp hj
    have hpj := psMid_props ⟨j, hj'⟩
    dsimp only at hpj
    exact Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hpj.1, hpj.2.1⟩, psMid_prime hj'⟩
  have hTcard : T.card = 1089 := by
    rw [Finset.card_image_of_injOn, Finset.card_range]
    intro a ha b hb heq
    have ha' : a < 1089 := Finset.mem_range.mp ha
    have hb' : b < 1089 := Finset.mem_range.mp hb
    rcases lt_trichotomy a b with h | h | h
    · exact absurd heq (ne_of_lt (psMid_lt_of_lt h hb'))
    · exact h
    · exact absurd heq.symm (ne_of_lt (psMid_lt_of_lt h ha'))
  have hScard : S.card = 1089 := by
    have hdisj : Disjoint ((Finset.range 449).filter Nat.Prime) S := by
      rw [Finset.disjoint_left]
      intro x hx1 hx2
      have h1 : x < 449 := Finset.mem_range.mp (Finset.mem_filter.mp hx1).1
      have h2 : 449 ≤ x := (Finset.mem_Icc.mp (Finset.mem_filter.mp hx2).1).1
      omega
    have hunion : (Finset.range 449).filter Nat.Prime ∪ S = (Finset.range 9487).filter Nat.Prime := by
      ext x
      simp only [S, Finset.mem_union, Finset.mem_filter, Finset.mem_range, Finset.mem_Icc]
      constructor
      · rintro (⟨h1, hp⟩ | ⟨⟨h1, h2⟩, hp⟩) <;> exact ⟨by omega, hp⟩
      · rintro ⟨h1, hp⟩
        by_cases hx : x < 449
        · exact Or.inl ⟨hx, hp⟩
        · exact Or.inr ⟨⟨by omega, by omega⟩, hp⟩
    have h448 : ((Finset.range 449).filter Nat.Prime).card = 86 := by
      have := piFast_eq_primeCounting (y := 448) (by decide)
      rw [piFast_448, Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range] at this
      exact this.symm
    have h9486 : ((Finset.range 9487).filter Nat.Prime).card = 1175 := by
      have := piFast_eq_primeCounting (y := 9486) (by decide)
      rw [piFast_9486, Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range] at this
      exact this.symm
    have hsum := Finset.card_union_of_disjoint hdisj
    rw [hunion, h448, h9486] at hsum
    omega
  have hEq : T = S := Finset.eq_of_subset_of_card_le hsub (by omega)
  have hpS : p ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hlo, hhi⟩, hp⟩
  rw [← hEq] at hpS
  obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hpS
  exact ⟨j, Finset.mem_range.mp hj, rfl⟩

private lemma psMid_prefix_card {j : ℕ} (hj : j < 1089) :
    ((Finset.range (getPMid j)).filter Nat.Prime).card = 86 + j := by
  have hpj := psMid_props ⟨j, hj⟩
  dsimp only at hpj
  set L := (Finset.range 86).image getP86 ∪ (Finset.range j).image getPMid
  have hsub : L ⊆ (Finset.range (getPMid j)).filter Nat.Prime := by
    intro x hx
    rcases Finset.mem_union.mp hx with hx1 | hx2
    · obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx1
      have hi' : i < 86 := Finset.mem_range.mp hi
      have hle := ps86_le_443 hi'
      exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), ps86_prime ⟨i, hi'⟩⟩
    · obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hx2
      have hk' : k < j := Finset.mem_range.mp hk
      exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (psMid_lt_of_lt hk' hj),
        psMid_prime (by omega)⟩
  have hsup : (Finset.range (getPMid j)).filter Nat.Prime ⊆ L := by
    intro p hp
    obtain ⟨hp_lt, hp_prime⟩ := Finset.mem_filter.mp hp
    have hp_lt' : p < getPMid j := Finset.mem_range.mp hp_lt
    by_cases h449 : p < 449
    · obtain ⟨⟨i, hi⟩, rfl⟩ := ps86_complete ⟨p, h449⟩ hp_prime
      exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨i, Finset.mem_range.mpr hi, rfl⟩)
    · have hp_hi : p ≤ 9486 := by omega
      obtain ⟨k, hk, rfl⟩ := psMid_complete hp_prime (by omega) hp_hi
      have hkj : k < j := by
        by_contra hge; push Not at hge
        rcases eq_or_lt_of_le hge with rfl | hlt
        · omega
        · have := psMid_lt_of_lt hlt hk; omega
      exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨k, Finset.mem_range.mpr hkj, rfl⟩)
  have hEq : (Finset.range (getPMid j)).filter Nat.Prime = L := Finset.Subset.antisymm hsup hsub
  rw [hEq]
  have hdisj : Disjoint ((Finset.range 86).image getP86) ((Finset.range j).image getPMid) := by
    rw [Finset.disjoint_left]
    intro x hx1 hx2
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx1
    obtain ⟨k, hk, heq⟩ := Finset.mem_image.mp hx2
    have h1 := ps86_le_443 (Finset.mem_range.mp hi)
    have hk' : k < 1089 := by have := Finset.mem_range.mp hk; omega
    have h2 := (psMid_props ⟨k, hk'⟩).1
    dsimp only at h2
    omega
  rw [Finset.card_union_of_disjoint hdisj]
  have hc1 : ((Finset.range 86).image getP86).card = 86 := by
    rw [Finset.card_image_of_injOn, Finset.card_range]
    intro a ha b hb heq
    have ha' : a < 86 := Finset.mem_range.mp ha
    have hb' : b < 86 := Finset.mem_range.mp hb
    have hlt : ∀ u v : ℕ, u < v → v < 86 → getP86 u < getP86 v := by
      intro u v huv hv
      induction v with
      | zero => omega
      | succ v ih =>
        by_cases h : u = v
        · subst h; exact ps86_strictMono ⟨u, by omega⟩
        · exact (ih (by omega) (by omega)).trans (ps86_strictMono ⟨v, by omega⟩)
    rcases lt_trichotomy a b with h | h | h
    · exact absurd heq (ne_of_lt (hlt a b h hb'))
    · exact h
    · exact absurd heq.symm (ne_of_lt (hlt b a h ha'))
  have hc2 : ((Finset.range j).image getPMid).card = j := by
    rw [Finset.card_image_of_injOn, Finset.card_range]
    intro a ha b hb heq
    have ha' : a < j := Finset.mem_range.mp ha
    have hb' : b < j := Finset.mem_range.mp hb
    rcases lt_trichotomy a b with h | h | h
    · exact absurd heq (ne_of_lt (psMid_lt_of_lt h (by omega)))
    · exact h
    · exact absurd heq.symm (ne_of_lt (psMid_lt_of_lt h (by omega)))
  rw [hc1, hc2]

private lemma card_primes_Icc_mid {j : ℕ} (hj : j < 1089) :
    ((Finset.Icc (getPMid j) (N / getPMid j)).filter Nat.Prime).card =
      piFast (N / getPMid j) - (86 + j) := by
  have hpj := psMid_props ⟨j, hj⟩
  dsimp only at hpj
  have hdiv_lt : N / getPMid j < M := by
    have hle : N / getPMid j ≤ N / 449 := Nat.div_le_div_left hpj.1 (by decide)
    have h449 : N / 449 < M := by decide
    omega
  have hle_div : getPMid j ≤ N / getPMid j := by
    rw [Nat.le_div_iff_mul_le (by omega)]
    have : getPMid j ≤ 9486 := hpj.2.1
    dsimp [N]; nlinarith
  rw [piFast_eq_primeCounting hdiv_lt, Nat.primeCounting, Nat.primeCounting',
    Nat.count_eq_card_filter_range, ← psMid_prefix_card hj]
  have hdisj : Disjoint ((Finset.range (getPMid j)).filter Nat.Prime)
      ((Finset.Icc (getPMid j) (N / getPMid j)).filter Nat.Prime) := by
    rw [Finset.disjoint_left]
    intro x hx1 hx2
    have h1 := Finset.mem_range.mp (Finset.mem_filter.mp hx1).1
    have h2 := (Finset.mem_Icc.mp (Finset.mem_filter.mp hx2).1).1
    omega
  have hunion : (Finset.range (getPMid j)).filter Nat.Prime ∪
      (Finset.Icc (getPMid j) (N / getPMid j)).filter Nat.Prime =
      (Finset.range (N / getPMid j + 1)).filter Nat.Prime := by
    ext x
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_range, Finset.mem_Icc]
    constructor
    · rintro (⟨h1, hp⟩ | ⟨⟨h1, h2⟩, hp⟩) <;> exact ⟨by omega, hp⟩
    · rintro ⟨h1, hp⟩
      by_cases hx : x < getPMid j
      · exact Or.inl ⟨hx, hp⟩
      · exact Or.inr ⟨⟨by omega, by omega⟩, hp⟩
  have hsum := Finset.card_union_of_disjoint hdisj
  rw [hunion] at hsum
  have hcard_eq : ((Finset.range (N / getPMid j + 1)).filter Nat.Prime).card =
      ({x ∈ Finset.range (N / getPMid j + 1) | Nat.Prime x}).card := by
    congr 1
  rw [hcard_eq] at hsum
  omega

private def sumP2Aux : ℕ → ℕ → ℕ
  | _, 0 => 0
  | j, 1 => piFast (N / getPMid j) - (86 + j)
  | j, n + 2 =>
    let half := (n + 2) / 2
    sumP2Aux j half + sumP2Aux (j + half) (n + 2 - half)

private lemma sumP2Aux_eq (j len : ℕ) :
    sumP2Aux j len = ∑ k ∈ Finset.Ico j (j + len), (piFast (N / getPMid k) - (86 + k)) := by
  induction len using Nat.strongRecOn generalizing j with
  | ind len ih =>
    match len with
    | 0 => simp [sumP2Aux]
    | 1 => simp [sumP2Aux]
    | m + 2 =>
      unfold sumP2Aux
      dsimp only
      set half := (m + 2) / 2
      have h1 : half < m + 2 := by omega
      have h2 : m + 2 - half < m + 2 := by omega
      rw [ih half h1 j, ih (m + 2 - half) h2 (j + half)]
      have heq : j + half + (m + 2 - half) = j + (m + 2) := by omega
      rw [heq, Finset.sum_Ico_consecutive _ (by omega : j ≤ j + half) (by omega : j + half ≤ j + (m + 2))]

/-! ### Part 4: Exact `phiFast` correctness -/

private def sifted (x m : ℕ) : Finset ℕ :=
  (Finset.Icc 1 x).filter (fun n => ∀ i < m, ¬ getP86 i ∣ n)

private def phiSpec (x m : ℕ) : ℕ := (sifted x m).card

private lemma ps86_lt_of_lt {a b : ℕ} (hab : a < b) (hb : b < 86) :
    getP86 a < getP86 b := by
  induction b with
  | zero => omega
  | succ b ih =>
    by_cases h : a = b
    · subst h; exact ps86_strictMono ⟨a, by omega⟩
    · exact (ih (by omega) (by omega)).trans (ps86_strictMono ⟨b, by omega⟩)

private lemma ps86_prefix_primes {m : ℕ} (hm : m < 86) {q : ℕ} (hq : q.Prime) (hqle : q ≤ getP86 m) :
    ∃ i ≤ m, getP86 i = q := by
  have h443 := ps86_le_443 hm
  obtain ⟨⟨i, hi⟩, hiq⟩ := ps86_complete ⟨q, by omega⟩ hq
  dsimp only at hiq
  have him : i ≤ m := by
    by_contra hgt; push Not at hgt
    have := ps86_lt_of_lt hgt hi
    omega
  exact ⟨i, him, hiq⟩

private lemma phiSpec_zero (x : ℕ) : phiSpec x 0 = x := by
  simp [phiSpec, sifted]

private lemma phiSpec_zero_x (m : ℕ) : phiSpec 0 m = 0 := by
  simp [phiSpec, sifted]

private lemma phiSpec_succ {x m : ℕ} (hm : m < 86) :
    phiSpec x (m + 1) = phiSpec x m - phiSpec (x / getP86 m) m := by
  set p := getP86 m
  have hp : p.Prime := ps86_prime ⟨m, hm⟩
  have hdisj : Disjoint (sifted x (m + 1)) ((sifted x m).filter (fun n => p ∣ n)) := by
    rw [Finset.disjoint_left]
    intro n hn1 hn2
    have hnd := (Finset.mem_filter.mp hn1).2 m (Nat.lt_succ_self m)
    exact hnd (Finset.mem_filter.mp hn2).2
  have hunion : sifted x (m + 1) ∪ (sifted x m).filter (fun n => p ∣ n) = sifted x m := by
    ext n
    simp only [sifted, Finset.mem_union, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro (⟨hI, h⟩ | ⟨⟨hI, h⟩, _⟩)
      · exact ⟨hI, fun i hi => h i (Nat.lt_succ_of_lt hi)⟩
      · exact ⟨hI, h⟩
    · rintro ⟨hI, h⟩
      by_cases hpn : p ∣ n
      · exact Or.inr ⟨⟨hI, h⟩, hpn⟩
      · refine Or.inl ⟨hI, fun i hi => ?_⟩
        rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | rfl
        · exact h i hlt
        · exact hpn
  have hbij : ((sifted x m).filter (fun n => p ∣ n)).card = (sifted (x / p) m).card := by
    apply Finset.card_bij (fun n _ => n / p)
    · intro n hn
      obtain ⟨hns, hpn⟩ := Finset.mem_filter.mp hn
      obtain ⟨hI, hnd⟩ := Finset.mem_filter.mp hns
      obtain ⟨h1, hx⟩ := Finset.mem_Icc.mp hI
      have hmul : p * (n / p) = n := Nat.mul_div_cancel' hpn
      have hpos : 1 ≤ n / p := by
        rcases Nat.eq_zero_or_pos (n / p) with h0 | hpos
        · rw [h0, Nat.mul_zero] at hmul; omega
        · exact hpos
      refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hpos, Nat.div_le_div_right hx⟩, fun i hi hdiv => ?_⟩
      exact hnd i hi (hmul ▸ dvd_mul_of_dvd_right hdiv p)
    · intro a ha b hb heq
      have hpa := (Finset.mem_filter.mp ha).2
      have hpb := (Finset.mem_filter.mp hb).2
      rw [← Nat.mul_div_cancel' hpa, ← Nat.mul_div_cancel' hpb, heq]
    · intro k hk
      obtain ⟨hI, hnd⟩ := Finset.mem_filter.mp hk
      obtain ⟨h1, hkdiv⟩ := Finset.mem_Icc.mp hI
      refine ⟨p * k, ?_, Nat.mul_div_cancel_left k hp.pos⟩
      refine Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨?_, ?_⟩, ?_⟩, dvd_mul_right p k⟩
      · have := hp.two_le; nlinarith
      · exact (Nat.le_div_iff_mul_le hp.pos).mp hkdiv |> fun h => by rwa [Nat.mul_comm] at h
      · intro i hi hdiv
        rcases (ps86_prime ⟨i, by omega⟩).dvd_mul.mp hdiv with hdp | hdk
        · have heq := (Nat.prime_dvd_prime_iff_eq (ps86_prime ⟨i, by omega⟩) hp).mp hdp
          dsimp only [p] at heq
          have hlt := ps86_lt_of_lt hi hm
          omega
        · exact hnd i hi hdk
  have hcard := Finset.card_union_of_disjoint hdisj
  rw [hunion, hbij] at hcard
  unfold phiSpec
  omega

private lemma phiSpec_lt_p {x m : ℕ} (hm : m < 86) (hx1 : 1 ≤ x) (hxp : x < getP86 m) :
    phiSpec x (m + 1) = 1 := by
  have hEq : sifted x (m + 1) = {1} := by
    ext n
    simp only [sifted, Finset.mem_filter, Finset.mem_Icc, Finset.mem_singleton]
    constructor
    · rintro ⟨⟨h1, hnx⟩, hnd⟩
      by_contra hne
      set q := n.minFac
      have hqp : q.Prime := Nat.minFac_prime hne
      have hqle : q ≤ getP86 m := (Nat.minFac_le (by omega)).trans (by omega)
      obtain ⟨i, him, hiq⟩ := ps86_prefix_primes hm hqp hqle
      exact hnd i (by omega) (hiq.symm ▸ Nat.minFac_dvd n)
    · rintro rfl
      refine ⟨⟨le_rfl, hx1⟩, fun i hi hdvd => ?_⟩
      have h2 := ps86_ge_two (by omega : i < 86)
      have hle := Nat.le_of_dvd (by decide) hdvd
      omega
  unfold phiSpec; rw [hEq]; rfl

private lemma phiSpec_lt_sq {x m : ℕ} (hm : m < 86) (hxlo : getP86 m ≤ x)
    (hxhi : x < getP86 m * getP86 m) :
    phiSpec x (m + 1) = 1 + Nat.primeCounting x - (m + 1) := by
  set P := (Finset.range (x + 1)).filter Nat.Prime
  set B := (Finset.range (m + 1)).image getP86
  have hBsub : B ⊆ P := by
    intro q hq
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hq
    have hi' : i ≤ m := by have := Finset.mem_range.mp hi; omega
    have hle : getP86 i ≤ getP86 m := by
      rcases eq_or_lt_of_le hi' with rfl | hlt
      · exact le_rfl
      · exact (ps86_lt_of_lt hlt hm).le
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), ps86_prime ⟨i, by omega⟩⟩
  have hBcard : B.card = m + 1 := by
    rw [Finset.card_image_of_injOn, Finset.card_range]
    intro a ha b hb heq
    have ha' : a < m + 1 := Finset.mem_range.mp ha
    have hb' : b < m + 1 := Finset.mem_range.mp hb
    rcases lt_trichotomy a b with h | h | h
    · exact absurd heq (ne_of_lt (ps86_lt_of_lt h (by omega)))
    · exact h
    · exact absurd heq.symm (ne_of_lt (ps86_lt_of_lt h (by omega)))
  have h1notP : 1 ∉ P \ B := fun h => Nat.not_prime_one (Finset.mem_filter.mp (Finset.mem_sdiff.mp h).1).2
  have hEq : sifted x (m + 1) = insert 1 (P \ B) := by
    ext n
    simp only [sifted, P, B, Finset.mem_filter, Finset.mem_Icc, Finset.mem_insert,
      Finset.mem_sdiff, Finset.mem_range, Finset.mem_image]
    constructor
    · rintro ⟨⟨h1, hnx⟩, hnd⟩
      by_cases hn1 : n = 1
      · exact Or.inl hn1
      · right
        have hnp : n.Prime := by
          by_contra hnot
          set q := n.minFac
          have hqp : q.Prime := Nat.minFac_prime hn1
          have hqsq : q * q ≤ n := by simpa [sq] using Nat.minFac_sq_le_self (by omega) hnot
          have hqlt : q ≤ getP86 m := by nlinarith
          obtain ⟨i, him, hiq⟩ := ps86_prefix_primes hm hqp hqlt
          exact hnd i (by omega) (hiq.symm ▸ Nat.minFac_dvd n)
        refine ⟨⟨by omega, hnp⟩, ?_⟩
        rintro ⟨i, hi, rfl⟩
        exact hnd i hi (dvd_refl _)
    · rintro (rfl | ⟨⟨hnx, hnp⟩, hnotB⟩)
      · refine ⟨⟨le_rfl, by have := ps86_ge_two hm; omega⟩, fun i hi hdvd => ?_⟩
        have h2 := ps86_ge_two (by omega : i < 86)
        have hle := Nat.le_of_dvd (by decide) hdvd
        omega
      · refine ⟨⟨hnp.one_le, by omega⟩, fun i hi hdvd => ?_⟩
        have hpi := ps86_prime ⟨i, by omega⟩
        dsimp only at hpi
        rcases hnp.eq_one_or_self_of_dvd _ hdvd with h1 | hself
        · exact hpi.ne_one h1
        · exact hnotB ⟨i, hi, hself⟩
  unfold phiSpec
  rw [hEq, Finset.card_insert_of_notMem h1notP, Finset.card_sdiff_of_subset hBsub, hBcard,
    Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range]
  have hle : m + 1 ≤ P.card := hBcard ▸ Finset.card_le_card hBsub
  have hcard_eq : ({y ∈ Finset.range (x + 1) | Nat.Prime y}).card = P.card := by
    convert rfl
  rw [hcard_eq]
  omega

private def wheelPred (n : ℕ) : Bool :=
  decide (¬ (2 ∣ n) ∧ ¬ (3 ∣ n) ∧ ¬ (5 ∣ n) ∧ ¬ (7 ∣ n))

private lemma sifted_four_eq (x : ℕ) :
    sifted x 4 = (Finset.Icc 1 x).filter (fun n => wheelPred n = true) := by
  have h0 : getP86 0 = 2 := by decide +kernel
  have h1 : getP86 1 = 3 := by decide +kernel
  have h2 : getP86 2 = 5 := by decide +kernel
  have h3 : getP86 3 = 7 := by decide +kernel
  unfold sifted
  congr 1
  ext n
  simp only [wheelPred, decide_eq_true_eq]
  constructor
  · intro h; exact ⟨h0 ▸ h 0 (by decide), h1 ▸ h 1 (by decide), h2 ▸ h 2 (by decide), h3 ▸ h 3 (by decide)⟩
  · rintro ⟨c0, c1, c2, c3⟩ i hi
    interval_cases i
    · rwa [h0]
    · rwa [h1]
    · rwa [h2]
    · rwa [h3]

private lemma wheelPred_add_210 (n : ℕ) : wheelPred (n + 210) = wheelPred n := by
  simp only [wheelPred]
  have d2 : 2 ∣ n + 210 ↔ 2 ∣ n := by omega
  have d3 : 3 ∣ n + 210 ↔ 3 ∣ n := by omega
  have d5 : 5 ∣ n + 210 ↔ 5 ∣ n := by omega
  have d7 : 7 ∣ n + 210 ↔ 7 ∣ n := by omega
  simp [d2, d3, d5, d7]

private lemma wheelPred_add_mul_210 (r k : ℕ) : wheelPred (r + 210 * k) = wheelPred r := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show r + 210 * (k + 1) = (r + 210 * k) + 210 by ring, wheelPred_add_210, ih]

private lemma w4_spec :
    ∀ r : Fin 211, getW4 r.1 = ((Finset.Icc 1 r.1).filter (fun n => wheelPred n = true)).card := by
  decide +kernel

private lemma phiSpec_four (x : ℕ) : phiSpec x 4 = (x / 210) * 48 + getW4 (x % 210) := by
  have hstep : ∀ a : ℕ, phiSpec (a + 210) 4 = phiSpec a 4 + 48 := by
    intro a
    unfold phiSpec
    rw [sifted_four_eq, sifted_four_eq]
    have hdisj : Disjoint ((Finset.Icc 1 a).filter (fun n => wheelPred n = true))
        ((Finset.Icc (a + 1) (a + 210)).filter (fun n => wheelPred n = true)) := by
      rw [Finset.disjoint_left]
      intro n h1 h2
      have := (Finset.mem_Icc.mp (Finset.mem_filter.mp h1).1).2
      have := (Finset.mem_Icc.mp (Finset.mem_filter.mp h2).1).1
      omega
    have hunion : (Finset.Icc 1 a).filter (fun n => wheelPred n = true) ∪
        (Finset.Icc (a + 1) (a + 210)).filter (fun n => wheelPred n = true) =
        (Finset.Icc 1 (a + 210)).filter (fun n => wheelPred n = true) := by
      ext n
      simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_Icc]
      constructor
      · rintro (⟨⟨h1, h2⟩, hw⟩ | ⟨⟨h1, h2⟩, hw⟩) <;> exact ⟨⟨by omega, by omega⟩, hw⟩
      · rintro ⟨⟨h1, h2⟩, hw⟩
        by_cases ha : n ≤ a
        · exact Or.inl ⟨⟨h1, ha⟩, hw⟩
        · exact Or.inr ⟨⟨by omega, h2⟩, hw⟩
    rw [← hunion, Finset.card_union_of_disjoint hdisj]
    congr 1
    have h48 : ((Finset.Icc 1 210).filter (fun n => wheelPred n = true)).card = 48 := by
      have hw210 := w4_spec ⟨210, by decide⟩
      dsimp only at hw210
      have hv : getW4 210 = 48 := by decide +kernel
      omega
    rw [← h48]
    apply Finset.card_bij (fun n _ => (n - 1) % 210 + 1)
    · intro n hn
      obtain ⟨hI, hw⟩ := Finset.mem_filter.mp hn
      obtain ⟨h1, h2⟩ := Finset.mem_Icc.mp hI
      refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by omega, by have := Nat.mod_lt (n - 1) (by decide : 0 < 210); omega⟩, ?_⟩
      have hq : n = ((n - 1) % 210 + 1) + 210 * ((n - 1) / 210) := by omega
      have hmod : wheelPred n = wheelPred ((n - 1) % 210 + 1) := by
        conv_lhs => rw [hq]
        exact wheelPred_add_mul_210 _ _
      rwa [← hmod]
    · intro u hu v hv heq
      obtain ⟨hIu, _⟩ := Finset.mem_filter.mp hu
      obtain ⟨hIv, _⟩ := Finset.mem_filter.mp hv
      obtain ⟨hu1, hu2⟩ := Finset.mem_Icc.mp hIu
      obtain ⟨hv1, hv2⟩ := Finset.mem_Icc.mp hIv
      omega
    · intro r hr
      obtain ⟨hIr, hw⟩ := Finset.mem_filter.mp hr
      obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hIr
      set t := if r - 1 < a % 210 then a / 210 + 1 else a / 210
      set n := r + 210 * t
      have hnI : a + 1 ≤ n ∧ n ≤ a + 210 := by
        dsimp [n, t]
        split_ifs with hlt <;> omega
      refine ⟨n, Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr hnI, ?_⟩, ?_⟩
      · rwa [show n = r + 210 * t from rfl, wheelPred_add_mul_210]
      · have hsub : n - 1 = (r - 1) + 210 * t := by omega
        rw [hsub, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]
        omega
  set q := x / 210
  set r := x % 210
  have hx : x = r + 210 * q := by dsimp [q, r]; omega
  rw [hx]
  have hrlt : r < 211 := by have := Nat.mod_lt x (by decide : 0 < 210); omega
  induction q with
  | zero =>
    simp only [Nat.mul_zero, Nat.add_zero, Nat.zero_mul, Nat.zero_add]
    unfold phiSpec
    rw [sifted_four_eq, w4_spec ⟨r, hrlt⟩]
  | succ q ih =>
    rw [show r + 210 * (q + 1) = (r + 210 * q) + 210 by ring, hstep, ih]
    ring

private def phiFast (x : ℕ) : ℕ → ℕ
  | 0 => x
  | m + 1 =>
    if x == 0 then 0
    else if m + 1 == 4 then (x / 210) * 48 + getW4 (x % 210)
    else
      let p := getP86 m
      if x < p then 1
      else if x < p * p then 1 + piFast x - (m + 1)
      else phiFast x m - phiFast (x / p) m

private lemma phiFast_eq_phiSpec : ∀ m ≤ 86, ∀ x, phiFast x m = phiSpec x m := by
  intro m
  induction m with
  | zero => intro _ x; simp [phiFast, phiSpec_zero]
  | succ m ih =>
    intro hm x
    unfold phiFast
    by_cases hx0 : x = 0
    · subst hx0; simp [phiSpec_zero_x]
    · simp only [beq_iff_eq, hx0, ↓reduceIte]
      by_cases hm4 : m + 1 = 4
      · simp only [hm4, ↓reduceIte]
        exact (phiSpec_four x).symm
      · simp only [hm4, ↓reduceIte]
        set p := getP86 m
        by_cases hxp : x < p
        · simp only [hxp, ↓reduceIte]
          exact (phiSpec_lt_p (by omega) (by omega) hxp).symm
        · simp only [hxp, ↓reduceIte]
          by_cases hxsq : x < p * p
          · simp only [hxsq, ↓reduceIte]
            have hxM : x < M := by
              have h443 := ps86_le_443 (by omega : m < 86)
              dsimp [M]; nlinarith
            rw [piFast_eq_primeCounting hxM]
            exact (phiSpec_lt_sq (by omega) (by omega) hxsq).symm
          · simp only [hxsq, ↓reduceIte]
            rw [ih (by omega) x, ih (by omega) (x / p), phiSpec_succ (by omega)]

/-! ### Part 5: Kernel evaluations and Meissel lower bound -/

private theorem eval_P2 : sumP2Aux 0 1089 = 3053946 := by decide +kernel

set_option maxHeartbeats 8000000 in
private theorem eval_phi : phiFast N 86 = 8270815 := by decide +kernel

private lemma mem_sifted {x m n : ℕ} (hn : n ∈ sifted x m) :
    1 ≤ n ∧ n ≤ x ∧ ∀ i < m, ¬ getP86 i ∣ n := by
  unfold sifted at hn
  obtain ⟨hI, hnd⟩ := Finset.mem_filter.mp hn
  obtain ⟨h1, h2⟩ := Finset.mem_Icc.mp hI
  exact ⟨h1, h2, hnd⟩

private def PbigOf (x : ℕ) : Finset ℕ := (Finset.Icc 449 x).filter Nat.Prime

private def SemiOf (x K : ℕ) : Finset ℕ :=
  (Finset.range K).biUnion fun j =>
    ((Finset.Icc (getPMid j) (x / getPMid j)).filter Nat.Prime).image (fun q => getPMid j * q)

private lemma sifted_subset_aux {x K : ℕ} (hx : x = N) (hK : K = 1089) :
    sifted x 86 ⊆ insert 1 (PbigOf x ∪ SemiOf x K) := by
  intro n hn
  obtain ⟨h1, hnN, hnd⟩ := mem_sifted hn
  by_cases hn1 : n = 1
  · exact Finset.mem_insert.mpr (Or.inl hn1)
  · apply Finset.mem_insert_of_mem
    have hmin_ge : 449 ≤ n.minFac := by
      by_contra hlt; push Not at hlt
      obtain ⟨⟨i, hi⟩, hiq⟩ := ps86_complete ⟨n.minFac, hlt⟩ (Nat.minFac_prime hn1)
      dsimp only at hiq
      exact hnd i hi (hiq.symm ▸ Nat.minFac_dvd n)
    by_cases hnp : n.Prime
    · apply Finset.mem_union_left
      have : n = n.minFac := hnp.minFac_eq.symm
      exact Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by omega, hnN⟩, hnp⟩
    · apply Finset.mem_union_right
      set p := n.minFac
      set q := n / p
      have hpp : p.Prime := Nat.minFac_prime hn1
      have hpsq : p * p ≤ n := by simpa [sq] using Nat.minFac_sq_le_self (by omega) hnp
      have hple : p ≤ 9486 := by subst hx; dsimp [N] at hnN; nlinarith
      obtain ⟨j, hj, hjp⟩ := psMid_complete hpp hmin_ge hple
      have hmul : p * q = n := Nat.mul_div_cancel' (Nat.minFac_dvd n)
      have hqge : p ≤ q := by nlinarith
      have hqle : q ≤ x / p := by
        rw [Nat.le_div_iff_mul_le hpp.pos]; rw [Nat.mul_comm]; omega
      have hqp : q.Prime := by
        by_contra hqnot
        have hqne1 : q ≠ 1 := by omega
        set r := q.minFac
        have hrp : r.Prime := Nat.minFac_prime hqne1
        have hrsq : r * r ≤ q := by simpa [sq] using Nat.minFac_sq_le_self (by omega) hqnot
        have hrge : 449 ≤ r := by
          by_contra hrlt; push Not at hrlt
          obtain ⟨⟨i, hi⟩, hir⟩ := ps86_complete ⟨r, hrlt⟩ hrp
          dsimp only at hir
          exact hnd i hi (hir.symm ▸ dvd_trans (Nat.minFac_dvd q) (hmul ▸ dvd_mul_left q p))
        have : 449 * 449 * 449 ≤ n := by nlinarith
        subst hx; dsimp [N] at hnN; omega
      unfold SemiOf
      refine Finset.mem_biUnion.mpr ⟨j, Finset.mem_range.mpr (by omega), Finset.mem_image.mpr ⟨q, ?_, ?_⟩⟩
      · rw [hjp]
        exact Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hqge, hqle⟩, hqp⟩
      · rw [hjp]; exact hmul

private lemma semi_card_le (x K : ℕ) :
    (SemiOf x K).card ≤ ∑ j ∈ Finset.range K,
      ((Finset.Icc (getPMid j) (x / getPMid j)).filter Nat.Prime).card := by
  calc (SemiOf x K).card
      ≤ ∑ j ∈ Finset.range K,
          (((Finset.Icc (getPMid j) (x / getPMid j)).filter Nat.Prime).image (fun q => getPMid j * q)).card :=
        Finset.card_biUnion_le
    _ ≤ ∑ j ∈ Finset.range K,
          ((Finset.Icc (getPMid j) (x / getPMid j)).filter Nat.Prime).card :=
        Finset.sum_le_sum fun j _ => Finset.card_image_le

private lemma p2_sum_eq {K : ℕ} (hK : K = 1089) :
    ∑ j ∈ Finset.range K, ((Finset.Icc (getPMid j) (N / getPMid j)).filter Nat.Prime).card =
      sumP2Aux 0 K := by
  calc ∑ j ∈ Finset.range K, ((Finset.Icc (getPMid j) (N / getPMid j)).filter Nat.Prime).card
      = ∑ j ∈ Finset.range K, (piFast (N / getPMid j) - (86 + j)) := by
        apply Finset.sum_congr rfl
        intro j hj
        have hj' : j < 1089 := by have := Finset.mem_range.mp hj; omega
        exact card_primes_Icc_mid hj'
    _ = ∑ j ∈ Finset.Ico 0 (0 + K), (piFast (N / getPMid j) - (86 + j)) := by
        rw [Nat.zero_add, Nat.Ico_zero_eq_range]
    _ = sumP2Aux 0 K := (sumP2Aux_eq 0 K).symm

private lemma pbig_card_add_86 {x : ℕ} (hx : 449 ≤ x) :
    (PbigOf x).card + 86 = Nat.primeCounting x := by
  have hdisj : Disjoint ((Finset.range 449).filter Nat.Prime) (PbigOf x) := by
    rw [Finset.disjoint_left]
    intro a h1 h2
    have := Finset.mem_range.mp (Finset.mem_filter.mp h1).1
    have := (Finset.mem_Icc.mp (Finset.mem_filter.mp h2).1).1
    omega
  have hunion : (Finset.range 449).filter Nat.Prime ∪ PbigOf x =
      (Finset.range (x + 1)).filter Nat.Prime := by
    ext a
    simp only [PbigOf, Finset.mem_union, Finset.mem_filter, Finset.mem_range, Finset.mem_Icc]
    constructor
    · rintro (⟨h1, hp⟩ | ⟨⟨h1, h2⟩, hp⟩) <;> exact ⟨by omega, hp⟩
    · rintro ⟨h1, hp⟩
      by_cases ha : a < 449
      · exact Or.inl ⟨ha, hp⟩
      · exact Or.inr ⟨⟨by omega, by omega⟩, hp⟩
  have h448 : ((Finset.range 449).filter Nat.Prime).card = 86 := by
    have h := piFast_eq_primeCounting (y := 448) (by decide)
    rw [piFast_448, Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range] at h
    convert h.symm
  have hsum := Finset.card_union_of_disjoint hdisj
  rw [hunion, h448] at hsum
  have hpc : ((Finset.range (x + 1)).filter Nat.Prime).card = Nat.primeCounting x := by
    rw [Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range]
  rw [hpc] at hsum
  omega

private lemma sifted_card_le_aux {x K : ℕ} (hcov : sifted x 86 ⊆ insert 1 (PbigOf x ∪ SemiOf x K)) :
    (sifted x 86).card ≤ 1 + (PbigOf x).card + (SemiOf x K).card := by
  calc (sifted x 86).card
      ≤ (insert 1 (PbigOf x ∪ SemiOf x K)).card := Finset.card_le_card hcov
    _ ≤ (PbigOf x ∪ SemiOf x K).card + 1 := Finset.card_insert_le _ _
    _ ≤ ((PbigOf x).card + (SemiOf x K).card) + 1 := Nat.add_le_add_right (Finset.card_union_le _ _) 1
    _ = 1 + (PbigOf x).card + (SemiOf x K).card := by ring

theorem meissel_lower : 5216100 ≤ Nat.primeCounting 90000000 := by
  have hphi : (sifted N 86).card = 8270815 := by
    change phiSpec N 86 = 8270815
    rw [← phiFast_eq_phiSpec 86 le_rfl N]
    exact eval_phi
  have hSemi_card : (SemiOf N 1089).card ≤ 3053946 :=
    (semi_card_le N 1089).trans (by rw [p2_sum_eq rfl, eval_P2])
  have hPbig_card : (PbigOf N).card + 86 = Nat.primeCounting N :=
    pbig_card_add_86 (by decide)
  have hcard_le : (sifted N 86).card ≤ 1 + (PbigOf N).card + (SemiOf N 1089).card :=
    sifted_card_le_aux (sifted_subset_aux rfl rfl)
  change 5216100 ≤ Nat.primeCounting N
  omega

