def D (N : ℕ) : ℕ := (N / 4).factorial * ((N + 1) / 4).factorial * ((N + 2) / 4).factorial *
  ((N + 3) / 4).factorial

lemma D_pos (N : ℕ) : 0 < D N := by
  unfold D
  positivity

lemma D_dvd (N : ℕ) : D N ∣ N.factorial := by
  have h : N = N / 4 + (N + 1) / 4 + (N + 2) / 4 + (N + 3) / 4 := by omega
  unfold D
  conv_rhs => rw [h]
  exact (Nat.mul_dvd_mul_right (Nat.mul_dvd_mul_right
    (Nat.factorial_mul_factorial_dvd_factorial_add _ _) _) _).trans
    ((Nat.mul_dvd_mul_right (Nat.factorial_mul_factorial_dvd_factorial_add _ _) _).trans
      (Nat.factorial_mul_factorial_dvd_factorial_add _ _))

lemma D_succ (N : ℕ) : D (N + 1) = (N / 4 + 1) * D N := by
  unfold D
  rw [show (N + 1 + 1) / 4 = (N + 2) / 4 by omega, show (N + 1 + 2) / 4 = (N + 3) / 4 by omega,
    show (N + 1 + 3) / 4 = N / 4 + 1 by omega, Nat.factorial_succ]
  ring

lemma step (N : ℕ) : ((N / 4 + 1 : ℕ) : ℤ) * a (N + 1) = ((N + 1 : ℕ) : ℤ) * a N := by
  obtain ⟨k, hk⟩ := D_dvd N
  obtain ⟨k', hk'⟩ := D_dvd (N + 1)
  have e0 : a N = ((N.factorial / D N : ℕ) : ℤ) := rfl
  have e1 : a (N + 1) = (((N + 1).factorial / D (N + 1) : ℕ) : ℤ) := rfl
  have hp := D_pos N
  have hp' := D_pos (N + 1)
  rw [e0, e1, hk, hk', Nat.mul_div_cancel_left _ hp, Nat.mul_div_cancel_left _ hp']
  have key : (N / 4 + 1) * k' = (N + 1) * k := by
    apply Nat.eq_of_mul_eq_mul_left hp
    rw [D_succ, Nat.factorial_succ, hk] at hk'
    calc D N * ((N / 4 + 1) * k') = (N / 4 + 1) * D N * k' := by ring
      _ = (N + 1) * (D N * k) := hk'.symm
      _ = D N * ((N + 1) * k) := by ring
  exact_mod_cast key

