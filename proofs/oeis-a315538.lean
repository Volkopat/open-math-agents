  have u := fun k => (le_F (x, y, 0) k).trans (show F (x, y, 0) ≤ -1 by omega)
  exact farkas_ub x y 0 2 5 0 (-1) 1 1 0 0 0 0 0 (by decide +kernel) (u _) (u _) (u _) (by norm_num)

