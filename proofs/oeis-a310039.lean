  have e2 : (-2 * X ^ 14 + 6 * X ^ 13 - 7 * X ^ 12 + 6 * X ^ 11 - X ^ 10 + X ^ 9 + X ^ 8 + 4 * X ^ 7 - 4 * X ^ 6 + 6 * X ^ 5 - 3 * X ^ 4 + 3 * X ^ 3 + X ^ 2 + 1 : ℚ⟦X⟧) = C 1 + X ^ 2 * C 1 + X ^ 3 * C 3 - X ^ 4 * C 3 + X ^ 5 * C 6 - X ^ 6 * C 4 + X ^ 7 * C 4 + X ^ 8 * C 1 + X ^ 9 * C 1 - X ^ 10 * C 1 + X ^ 11 * C 6 - X ^ 12 * C 7 + X ^ 13 * C 6 - X ^ 14 * C 2 := by
    simp only [map_ofNat, map_one]
