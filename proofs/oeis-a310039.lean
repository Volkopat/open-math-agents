theorem nearOK_all (k : Fin 24) : nearOK k = true := by
  fin_cases k
  exacts [nearOK0_dec.down, nearOK1_dec.down, nearOK2_dec.down, nearOK3_dec.down, nearOK4_dec.down, nearOK5_dec.down, nearOK6_dec.down, nearOK7_dec.down, nearOK8_dec.down, nearOK9_dec.down, nearOK10_dec.down, nearOK11_dec.down, nearOK12_dec.down, nearOK13_dec.down, nearOK14_dec.down, nearOK15_dec.down, nearOK16_dec.down, nearOK17_dec.down, nearOK18_dec.down, nearOK19_dec.down, nearOK20_dec.down, nearOK21_dec.down, nearOK22_dec.down, nearOK23_dec.down]

/-- Every vertex of a checked class s with F at most R0c s, other than v0, has a neighbor where fv is
one less. -/
theorem near_desc_rep (v : V) (hF : F v ≤ R0c v.2.2) (hv : v ≠ v0) (hrep : repC v.2.2 = true) :
    ∃ w, G.Adj v w ∧ fv w + 1 = fv v := by
  obtain ⟨x, y, s⟩ := v
  change F (x, y, s) ≤ R0c s at hF
  change repC s = true at hrep
  obtain ⟨hx1, hx2, hy1, hy2⟩ := near_box x y s hF
  have h1 := nearOK_all s
  unfold nearOK at h1
  rw [hrep] at h1
  simp only [Bool.not_true, Bool.false_or, List.all_eq_true, List.mem_range] at h1
  have h' := h1 (x + BXn s).toNat (by omega) (y + BYn s).toNat (by omega)
  have ex : (((x + BXn s).toNat : ℕ) : ℤ) - BXn s = x := by omega
  have ey : (((y + BYn s).toNat : ℕ) : ℤ) - BYn s = y := by omega
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, Nat.blt_eq, Nat.beq_eq, Nat.add_eq] at h'
  rcases h' with (h2 | ⟨⟨h2, h3⟩, h4⟩) | ⟨⟨hlt, hs⟩, hfe⟩
  · have hv' := FP_val s (x + BXn s).toNat (y + BYn s).toNat
    rw [ex, ey] at hv'
    have hr : R0c s = (R0N s : ℤ) := rfl
    omega
  · exfalso
    apply hv
    have hx0 : x = 0 := by omega
    have hy0 : y = 0 := by omega
    have hs0 : s = 1 := Fin.ext h4
    rw [hx0, hy0, hs0]
    rfl
  · rw [fvNn_eq _ _ _ _ hlt hs, fvN_eq, ex, ey] at hfe
    obtain ⟨e, hmem, h1, h2, h3, h4, -⟩ := edge_of _ hlt
    have ha := adj_of_mem e hmem x y
    have hs' : e.1 = s := Fin.ext (h1.trans hs)
    have ht' : e.2.1 = tgtF (nearE s (x + BXn s).toNat (y + BYn s).toNat) := Fin.ext (by
      show e.2.1.val = tgtv (nearE s (x + BXn s).toNat (y + BYn s).toNat) % 24
      rw [← h2, Nat.mod_eq_of_lt e.2.1.isLt])
    rw [hs', ht', h3, h4] at ha
    exact ⟨_, ha, hfe⟩

def sym_O_dec : PLift (∀ o ∈ O, (∃ o' ∈ O, o'.1 = sig o.1) ∧ fv (sig o.1) = fv o.1) := ⟨by
  decide +kernel⟩

theorem sym_O : ∀ o ∈ O, (∃ o' ∈ O, o'.1 = sig o.1) ∧ fv (sig o.1) = fv o.1 := sym_O_dec.down

theorem sig_fv (v : V) : fv (sig v) = fv v := by
  by_cases hv : ∃ o ∈ O, o.1 = v
  · obtain ⟨o, ho, rfl⟩ := hv
    exact (sym_O o ho).2
  push Not at hv
  have hs : ∀ o ∈ O, o.1 ≠ sig v := by
    intro o ho he
    obtain ⟨o', ho', he'⟩ := (sym_O o ho).1
    apply hv o' ho'
    rw [he', he, sig_sig]
  rw [fv_of _ hs, fv_of _ hv, sig_F]

theorem near_desc (v : V) (hF : F v ≤ R0c v.2.2) (hv : v ≠ v0) : ∃ w, G.Adj v w ∧ fv w + 1 = fv v := by
  rcases (sym_ok.2.1 v.2.2).2.2.2.2 with hr | hr
  · exact near_desc_rep v hF hv hr
  · have hu : F (sig v) ≤ R0c (sig v).2.2 := by
      rw [sig_F]
      show F v ≤ R0c (piS v.2.2)
      rw [(sym_ok.2.1 v.2.2).2.2.2.1]
      exact hF
    have huv : sig v ≠ v0 := fun h => hv (by rw [← sig_sig v, h, sym_ok.2.2.2.2])
    obtain ⟨w, hw, he⟩ := near_desc_rep (sig v) hu huv hr
    refine ⟨sig w, ?_, ?_⟩
    · have := sig_adj _ _ hw
      rwa [sig_sig] at this
    · rw [sig_fv]
      rw [sig_fv] at he
      exact he

theorem desc (v : V) (hv : v ≠ v0) : ∃ w, G.Adj v w ∧ fv w + 1 = fv v := by
  by_cases hF : F v ≤ R0c v.2.2
  · exact near_desc v hF hv
  have hge := R0c_ge v.2.2
  have hvO : ∀ o ∈ O, o.1 ≠ v := fun o ho he => by
    have := (O_ok o ho).1
    rw [he] at this
    omega
  obtain ⟨w, hw, he⟩ := far_desc v (by omega)
  have hwO : ∀ o ∈ O, o.1 ≠ w := fun o ho hw' => by
    have := (O_ok o ho).1
    rw [hw'] at this
    omega
  exact ⟨w, hw, by rw [fv_of v hvO, fv_of w hwO]; exact he⟩

theorem dist_eq_of_potential {W : Type*} (H : SimpleGraph W) (w0 : W) (f : W → ℕ)
    (h0 : f w0 = 0) (hlip : ∀ u w, H.Adj u w → f w ≤ f u + 1)
    (hdesc : ∀ v, v ≠ w0 → ∃ w, H.Adj v w ∧ f w + 1 = f v) (v : W) :
    H.dist w0 v = f v := by
  have up : ∀ n, ∀ v, f v = n → ∃ p : H.Walk w0 v, p.length = n := by
    intro n
    induction n with
    | zero =>
      intro v hv
      by_cases hv0 : v = w0
      · subst hv0
        exact ⟨SimpleGraph.Walk.nil, rfl⟩
      · obtain ⟨w, -, hw⟩ := hdesc v hv0
        omega
    | succ n ih =>
      intro v hv
      have hv0 : v ≠ w0 := by
        rintro rfl
        omega
      obtain ⟨w, hvw, hw⟩ := hdesc v hv0
      obtain ⟨p, hp⟩ := ih w (by omega)
      exact ⟨p.concat hvw.symm, by rw [SimpleGraph.Walk.length_concat, hp]⟩
  have low : ∀ (u : W) (p : H.Walk u v), f v ≤ f u + p.length := by
    intro u p
    induction p with
    | nil => simp
    | cons h p ih =>
      rw [SimpleGraph.Walk.length_cons]
      have := hlip _ _ h
      omega
  obtain ⟨p, hp⟩ := up (f v) v rfl
  apply le_antisymm
  · exact (H.dist_le p).trans hp.le
  · obtain ⟨q, hq⟩ := SimpleGraph.Reachable.exists_walk_length_eq_dist (G := H) ⟨p⟩
    have := low w0 q
    omega

/-- The graph distance from v0 is fv: the value listed in O, and the largest potential off O. -/
theorem dist_eq (v : V) : G.dist v0 v = (fv v).toNat := by
  apply dist_eq_of_potential G v0 (fun v => (fv v).toNat)
  · show (fv v0).toNat = 0
    decide +kernel
  · intro u w h
    have := lip_fv u w h
    have := fv_nonneg w
    have := fv_nonneg u
    show (fv w).toNat ≤ (fv u).toNat + 1
    omega
  · intro v hv
    obtain ⟨w, hw, he⟩ := desc v hv
    refine ⟨w, hw, ?_⟩
    have := fv_nonneg w
    show (fv w).toNat + 1 = (fv v).toNat
    omega

/-- Off the list O the graph distance from v0 is the largest potential. -/
theorem dist_eq_F (v : V) (hv : ∀ o ∈ O, o.1 ≠ v) : G.dist v0 v = (F v).toNat := by
  rw [dist_eq v, fv_of v hv]

/-- From n = 3 on, the coordination sequence counts the level set F = n. -/
theorem a_eq_F (n : ℕ) (hn : 3 ≤ n) : a n = Set.ncard {v : V | (F v).toNat = n} := by
  unfold a
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq]
  rw [dist_eq v]
  by_cases hv : ∃ o ∈ O, o.1 = v
  · obtain ⟨o, ho, rfl⟩ := hv
    obtain ⟨h1, h2, h3, -⟩ := O_ok o ho
    omega
  push Not at hv
  rw [fv_of v hv]

/-- The cells |x| ≤ 1, |y| ≤ 1, every class. -/
def boxF : Finset V :=
  (Finset.range 3 ×ˢ Finset.range 3 ×ˢ (Finset.univ : Finset (Fin 24))).map
    ⟨fun p => ((p.1 : ℤ) - 1, (p.2.1 : ℤ) - 1, p.2.2), fun a b h => by
      simp only [Prod.mk.injEq] at h
      exact Prod.ext (by omega) (Prod.ext (by omega) h.2.2)⟩

theorem mem_boxF (v : V) (h : (fv v).toNat ≤ 3) : v ∈ boxF := by
  obtain ⟨x, y, s⟩ := v
  have hb : F (x, y, s) ≤ 3 := by
    by_cases hv : ∃ o ∈ O, o.1 = (x, y, s)
    · obtain ⟨o, ho, he⟩ := hv
      have := (O_ok o ho).1
      rw [he] at this
      omega
    push Not at hv
    rw [fv_of _ hv] at h
    have := F_nonneg (x, y, s)
    omega
  obtain ⟨h1, h2, h3, h4⟩ := small_box x y s hb
  rw [boxF, Finset.mem_map]
  refine ⟨((x + 1).toNat, (y + 1).toNat, s), ?_, ?_⟩
  · simp only [Finset.mem_product, Finset.mem_range, Finset.mem_univ, and_true]
    omega
  · show ((((x + 1).toNat : ℕ) : ℤ) - 1, (((y + 1).toNat : ℕ) : ℤ) - 1, s) = (x, y, s)
    rw [Prod.mk.injEq, Prod.mk.injEq]
    exact ⟨by omega, by omega, rfl⟩

/-- Up to n = 3, a n counts the cells of the box where fv = n. -/
theorem a_small (n : ℕ) (hn : n ≤ 3) : a n = (boxF.filter fun v => (fv v).toNat = n).card := by
  unfold a
  rw [← Set.ncard_coe_finset]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq, Finset.coe_filter]
  rw [dist_eq v]
  constructor
  · intro h
    exact ⟨mem_boxF v (by omega), h⟩
  · rintro ⟨-, h⟩
    exact h

/-- The coordination sequence below n = 3. -/
theorem small_vals : (List.range 3).map a = [1, 3, 5] := by
  rw [List.map_congr_left (fun n hn => a_small n (by rw [List.mem_range] at hn; omega))]
  decide +kernel


/-! ## Counting the spheres

The sphere F = n splits into pieces: class s and the first facet i attaining the maximum. The
gradient of facet i is gc i times the primitive vector (Ap i, Bp i), so the points of class s with
pot_i = n lie on the line Ap i x + Bp i y = c with c = lev s i n, and only when gc i divides
n - Cc s i. That line is par s i c u = (al i c + Bp i u, be i c - Ap i u), and potential j is
ka i j c + Dm i j u + Cc s j there (`pot_par`). The previous facet bounds u from above, the next one
from below, and for n ≥ 7 the other facets lie below by Farkas certificates (`cf1` .. `cf0`: the
gradient part is checked once by `certG_ok`, the constant part for every class by `certC_ok`). So
each piece is an interval of integers (`piece_eq`), the sphere size is a sum of floor quotients
(`cnt_eq_S`), and shifting n by 12 moves every quotient by an integer (`inner_shift`, `S_shift`).
The tables are fields of natural numbers (`ctab`), which the kernel reads in constant time. The
section lives in the namespace `Count`; `gf`, `recur`, `controls` and `a_step` (and `a_closed` for
a short period) are restated after it. -/

namespace Count

/-- Field k of the B-bit fields packed in T (a table entry plus its offset). -/
def ctabN (T B k : ℕ) : ℕ := T >>> (B * k) % 2 ^ B

def gcV (k : ℕ) : ℕ := ctabN 8800356 3 k

def gcN (k : ℕ) : ℤ := (gcV k : ℤ)

def gc (i : Fin 8) : ℤ := gcN i.val

def ApV (k : ℕ) : ℕ := ctabN 3262216 3 k

def ApN (k : ℕ) : ℤ := (ApV k : ℤ) - 2

def Ap (i : Fin 8) : ℤ := ApN i.val

def BpV (k : ℕ) : ℕ := ctabN 1819689012 4 k

def BpN (k : ℕ) : ℤ := (BpV k : ℤ) - 5

def Bp (i : Fin 8) : ℤ := BpN i.val

def alV (k : ℕ) : ℕ := ctabN 6436435 3 k

def alN (k : ℕ) : ℤ := (alV k : ℤ) - 3

def al (i : Fin 8) : ℤ := alN i.val

def beV (k : ℕ) : ℕ := ctabN 42500 2 k

def beN (k : ℕ) : ℤ := (beV k : ℤ) - 1

def be (i : Fin 8) : ℤ := beN i.val

theorem prim : ∀ i : Fin 8, Ac i = gc i * Ap i ∧ Bc i = gc i * Bp i ∧ 0 < gc i ∧
    al i * Ap i + be i * Bp i = 1 := by
  decide +kernel

/-- Potential j changes by Dm i j along the line of facet i, per lattice step. -/
def Dm (i j : Fin 8) : ℤ := Ac j * Bp i - Bc j * Ap i

def ka (i j : Fin 8) : ℤ := Ac j * al i + Bc j * be i

theorem orient : ∀ i : Fin 8, 0 < Dm i (i - 1) ∧ Dm i (i + 1) < 0 := by decide +kernel

/-- The point with parameter u on the line Ap i x + Bp i y = c, in class s. -/
def par (s : Fin 24) (i : Fin 8) (c u : ℤ) : V :=
  (al i * c + Bp i * u, be i * c - Ap i * u, s)

theorem pot_par (s : Fin 24) (i j : Fin 8) (c u : ℤ) :
    pot (par s i c u) j = ka i j * c + Dm i j * u + Cc s j := by
  simp only [pot, par, ka, Dm]
  ring

theorem par_inv (v : V) (i : Fin 8) :
    v = par v.2.2 i (Ap i * v.1 + Bp i * v.2.1) (be i * v.1 - al i * v.2.1) := by
  obtain ⟨x, y, s⟩ := v
  have hb := (prim i).2.2.2
  simp only [par, Prod.mk.injEq, and_true]
  constructor
  · linear_combination (-x) * hb
  · linear_combination (-y) * hb

theorem pot_lev (v : V) (i : Fin 8) : pot v i = gc i * (Ap i * v.1 + Bp i * v.2.1) + Cc v.2.2 i := by
  obtain ⟨h1, h2, -, -⟩ := prim i
  simp only [pot]
  rw [h1, h2]
  ring

theorem par_inj (s : Fin 24) (i : Fin 8) (c : ℤ) : Function.Injective (par s i c) := by
  intro u u' h
  simp only [par, Prod.mk.injEq] at h
  have hb := (prim i).2.2.2
  have h1 : Bp i * (u - u') = 0 := by linarith [h.1]
  have h2 : Ap i * (u - u') = 0 := by linarith [h.2.1]
  have h3 : (u - u') = (u - u') * (al i * Ap i + be i * Bp i) := by rw [hb, mul_one]
  have : u - u' = 0 := by
    rw [h3]
    linear_combination (al i) * h2 + (be i) * h1
  linarith

/-- Some facet attains the maximum. -/
theorem F_attained (v : V) : ∃ k : Fin 8, pot v k = F v := by
  by_contra hne
  have h : ∀ k, pot v k ≤ F v - 1 := fun k => by
    have h1 := le_F v k
    have h2 : pot v k ≠ F v := fun e => hne ⟨k, e⟩
    omega
  have := F_le v (F v - 1) (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) (h 6) (h 7)
  omega

/-- The first facet attaining the maximum. -/
noncomputable def fi (v : V) : Fin 8 := Fin.find (fun k => pot v k = F v) (F_attained v)

theorem fi_spec (v : V) : pot v (fi v) = F v ∧ ∀ j, j < fi v → pot v j < F v :=
  ⟨Fin.find_spec (F_attained v), fun j hj =>
    lt_of_le_of_ne (le_F v j) (Fin.find_min (F_attained v) hj)⟩

theorem fi_iff (v : V) (i : Fin 8) : fi v = i ↔ pot v i = F v ∧ ∀ j, j < i → pot v j < F v := by
  constructor
  · rintro rfl
    exact fi_spec v
  · rintro ⟨h1, h2⟩
    obtain ⟨g1, g2⟩ := fi_spec v
    rcases lt_trichotomy (fi v) i with h | h | h
    · exact absurd g1 (ne_of_lt (h2 _ h))
    · exact h
    · exact absurd h1 (ne_of_lt (g2 _ h))

theorem ite01 (c : Prop) [Decidable c] : (0 : ℤ) ≤ (if c then 1 else 0) ∧ (if c then 1 else 0 : ℤ) ≤ 1 := by
  split_ifs <;> norm_num

/-- On the sphere F = n, the first maximal facet is i exactly when potential i is n and every
potential j is at most n - [j < i]. -/
theorem piece_iff (v : V) (i : Fin 8) (n : ℤ) :
    (F v = n ∧ fi v = i) ↔ (pot v i = n ∧ ∀ j, pot v j ≤ n - (if j < i then 1 else 0)) := by
  rw [fi_iff]
  constructor
  · rintro ⟨rfl, h1, h2⟩
    refine ⟨h1, fun j => ?_⟩
    split_ifs with hj
    · have := h2 j hj
      omega
    · have := le_F v j
      omega
  · rintro ⟨h1, h2⟩
    have h3 : ∀ j, pot v j ≤ n := fun j => le_trans (h2 j) (sub_le_self n (ite01 _).1)
    have hF : F v = n := le_antisymm (F_le_all v n h3) (h1 ▸ le_F v i)
    refine ⟨hF, hF ▸ h1, fun j hj => ?_⟩
    have := h2 j
    rw [if_pos hj] at this
    omega

/-! The Farkas multipliers (cf1, cf2, cf3, cf0) of the facet pair (i, j): cf1 times
(pot_(i-1) ≤ pot_i - [i-1 < i]) plus cf2 times (pot_(i+1) ≤ pot_i - [i+1 < i]) plus cf3 times
(pot_i ≤ pot_j) plus cf0 times (7 ≤ pot_i) is a contradiction, for every class. -/

def cf1V (k : ℕ) : ℕ := ctabN 55193785116883291936601926314279197698087118123442405376 3 k

def cf1N (k : ℕ) : ℤ := (cf1V k : ℤ)

def cf1 (i : Fin 8) (j : Fin 8) : ℤ := cf1N (j.val + 8 * i.val)

def cf2V (k : ℕ) : ℕ := ctabN 1559433939279329976167982852949695742372184892073050880 3 k

def cf2N (k : ℕ) : ℤ := (cf2V k : ℤ)

def cf2 (i : Fin 8) (j : Fin 8) : ℤ := cf2N (j.val + 8 * i.val)

def cf3V (k : ℕ) : ℕ := ctabN 40063384507693206272519438446704612838891818147940176640 3 k

def cf3N (k : ℕ) : ℤ := (cf3V k : ℤ)

def cf3 (i : Fin 8) (j : Fin 8) : ℤ := cf3N (j.val + 8 * i.val)

def cf0V (k : ℕ) : ℕ := ctabN 2097721602925111528027490178803185264 2 k

def cf0N (k : ℕ) : ℤ := (cf0V k : ℤ)

def cf0 (i : Fin 8) (j : Fin 8) : ℤ := cf0N (j.val + 8 * i.val)


/-- The class-independent part of the certificate of (i, j): nonnegative multipliers whose
combination of the gradients vanishes. -/
def certG (i j : Fin 8) : Prop :=
  let h := i - 1
  let k := i + 1
  0 ≤ cf1 i j ∧ 0 ≤ cf2 i j ∧ 0 ≤ cf3 i j ∧ 0 ≤ cf0 i j ∧
    cf1 i j * (Ac h - Ac i) + cf2 i j * (Ac k - Ac i) + cf3 i j * (Ac i - Ac j) - cf0 i j * Ac i = 0 ∧
    cf1 i j * (Bc h - Bc i) + cf2 i j * (Bc k - Bc i) + cf3 i j * (Bc i - Bc j) - cf0 i j * Bc i = 0

/-- The class constants Cc s i, packed for the kernel. -/
def cTV (k : ℕ) : ℕ := ctabN 1630796151851913164585147451251098706964964113002288256156195601361636979063124312638969475236069085386380294629522872407392866090667455294237483351648426901284937690453729641464386380463340316288919959897761102103851681459748429409199412405767030519169430222306362003008816424110681077261 5 k

def cTN (k : ℕ) : ℤ := (cTV k : ℤ) - 8

def cT (s : Fin 24) (i : Fin 8) : ℤ := cTN (i.val + 8 * s.val)

theorem cT_eq : ∀ s : Fin 24, ∀ i : Fin 8, cT s i = Cc s i := by
  decide +kernel

/-- The part of the certificate of (i, j) for class s: the combination of the constants is positive. -/
def certC (s : Fin 24) (i j : Fin 8) : Prop :=
  let h := i - 1
  let k := i + 1
  0 < cf1 i j * (cT s h - cT s i + (if h < i then 1 else 0)) +
    cf2 i j * (cT s k - cT s i + (if k < i then 1 else 0)) + cf3 i j * (cT s i - cT s j) +
    cf0 i j * (7 - cT s i)

instance (i j : Fin 8) : Decidable (certG i j) := by
  unfold certG; infer_instance

theorem certG_ok : ∀ i j : Fin 8, j ≠ i - 1 → j ≠ i → j ≠ i + 1 → certG i j := by
  decide +kernel

/-- j is i or a neighbour of i around the growth polygon. -/
def nearB (i j : ℕ) : Bool := j == i || j == (i + 1) % 8 || j == (i + 7) % 8

/-- certC in natural numbers, for the kernel: Cc = cTV - 8, the negative terms moved across; the
previous facet of i is (i + 7) % 8, the next one (i + 1) % 8. -/
def certNat (s i j : ℕ) : Bool :=
  Nat.blt ((cf1V (j + 8 * i) + cf2V (j + 8 * i) + cf0V (j + 8 * i)) * cTV (i + 8 * s) +
      cf3V (j + 8 * i) * cTV (j + 8 * s))
    (cf1V (j + 8 * i) * (cTV ((i + 7) % 8 + 8 * s) + (if (i + 7) % 8 < i then 1 else 0)) +
      cf2V (j + 8 * i) * (cTV ((i + 1) % 8 + 8 * s) + (if (i + 1) % 8 < i then 1 else 0)) +
      cf3V (j + 8 * i) * cTV (i + 8 * s) + cf0V (j + 8 * i) * 15)

def certOK : Bool :=
  (List.range 24).all fun s => (List.range 8).all fun i => (List.range 8).all fun j =>
    nearB i j || certNat s i j

theorem certOK_eq : certOK = true := by
  decide +kernel

theorem fin_prev : ∀ i : Fin 8, (i - 1).val = (i.val + 7) % 8 := by decide +kernel

theorem fin_next : ∀ i : Fin 8, (i + 1).val = (i.val + 1) % 8 := by decide +kernel

/-- The constant parts of the certificates hold in the integers: the natural-number check moved
across. -/
theorem certC_ok (s : Fin 24) (i j : Fin 8) (e1 : j ≠ i - 1) (e2 : j ≠ i) (e3 : j ≠ i + 1) :
    certC s i j := by
  have a1 := fin_prev i
  have a2 := fin_next i
  have hn : nearB i.val j.val = false := by
    have n1 : j.val ≠ i.val := fun h => e2 (Fin.ext h)
    have n2 : j.val ≠ (i.val + 1) % 8 := fun h => e3 (Fin.ext (h.trans a2.symm))
    have n3 : j.val ≠ (i.val + 7) % 8 := fun h => e1 (Fin.ext (h.trans a1.symm))
    simp only [nearB, Bool.or_eq_false_iff, beq_eq_false_iff_ne]
    exact ⟨⟨n1, n2⟩, n3⟩
  have hc := certOK_eq
  unfold certOK at hc
  simp only [List.all_eq_true, List.mem_range] at hc
  have hk := hc s.val s.isLt i.val i.isLt j.val j.isLt
  rw [hn, Bool.false_or] at hk
  simp only [certNat, Nat.blt_eq] at hk
  have ck := (Nat.cast_lt (α := ℤ)).mpr hk
  show 0 < cf1 i j * (cT s (i - 1) - cT s i + (if i - 1 < i then 1 else 0)) +
    cf2 i j * (cT s (i + 1) - cT s i + (if i + 1 < i then 1 else 0)) +
    cf3 i j * (cT s i - cT s j) + cf0 i j * (7 - cT s i)
  simp only [cf1, cf2, cf3, cf0, cf1N, cf2N, cf3N, cf0N, cT, cTN, Fin.lt_def, a1, a2]
  push_cast at ck ⊢
  ring_nf at ck ⊢
  linarith

theorem farkas4 (v : V) (h i k j : Fin 8) (e1 e2 r l1 l2 l3 l0 : ℤ)
    (hl : 0 ≤ l1 ∧ 0 ≤ l2 ∧ 0 ≤ l3 ∧ 0 ≤ l0)
    (hx : l1 * (Ac h - Ac i) + l2 * (Ac k - Ac i) + l3 * (Ac i - Ac j) - l0 * Ac i = 0)
    (hy : l1 * (Bc h - Bc i) + l2 * (Bc k - Bc i) + l3 * (Bc i - Bc j) - l0 * Bc i = 0)
    (hc : 0 < l1 * (Cc v.2.2 h - Cc v.2.2 i + e1) + l2 * (Cc v.2.2 k - Cc v.2.2 i + e2) +
      l3 * (Cc v.2.2 i - Cc v.2.2 j) + l0 * (r - Cc v.2.2 i))
    (f1 : pot v h ≤ pot v i - e1) (f2 : pot v k ≤ pot v i - e2) (f3 : pot v i ≤ pot v j)
    (f0 : r ≤ pot v i) : False := by
  have g1 := mul_nonpos_of_nonneg_of_nonpos hl.1 (show pot v h - pot v i + e1 ≤ 0 by linarith)
  have g2 := mul_nonpos_of_nonneg_of_nonpos hl.2.1 (show pot v k - pot v i + e2 ≤ 0 by linarith)
  have g3 := mul_nonpos_of_nonneg_of_nonpos hl.2.2.1 (show pot v i - pot v j ≤ 0 by linarith)
  have g0 := mul_nonpos_of_nonneg_of_nonpos hl.2.2.2 (show r - pot v i ≤ 0 by linarith)
  have e : l1 * (pot v h - pot v i + e1) + l2 * (pot v k - pot v i + e2) +
      l3 * (pot v i - pot v j) + l0 * (r - pot v i) =
      l1 * (Cc v.2.2 h - Cc v.2.2 i + e1) + l2 * (Cc v.2.2 k - Cc v.2.2 i + e2) +
        l3 * (Cc v.2.2 i - Cc v.2.2 j) + l0 * (r - Cc v.2.2 i) := by
    simp only [pot]
    linear_combination v.1 * hx + v.2.1 * hy
  linarith

/-- The level of the line of facet i through the points of class s with pot_i = n. -/
def lev (s : Fin 24) (i : Fin 8) (n : ℤ) : ℤ := (n - Cc s i) / gc i

theorem lev_mul (s : Fin 24) (i : Fin 8) (n : ℤ) (hd : (n - Cc s i) % gc i = 0) :
    gc i * lev s i n = n - Cc s i :=
  Int.mul_ediv_cancel' (Int.dvd_of_emod_eq_zero hd)

/-- The bound R in Dm i j * u ≤ R that says pot_j ≤ n - [j < i] on the piece (s, i). -/
def Rb (s : Fin 24) (i j : Fin 8) (n : ℤ) : ℤ :=
  n - (if j < i then 1 else 0) - ka i j * lev s i n - Cc s j

def hi (s : Fin 24) (i : Fin 8) (n : ℤ) : ℤ := Rb s i (i - 1) n / Dm i (i - 1)

def lo (s : Fin 24) (i : Fin 8) (n : ℤ) : ℤ := -(Rb s i (i + 1) n / (-Dm i (i + 1)))

theorem pot_le_iff (s : Fin 24) (i j : Fin 8) (n u : ℤ) :
    pot (par s i (lev s i n) u) j ≤ n - (if j < i then 1 else 0) ↔ Dm i j * u ≤ Rb s i j n := by
  rw [pot_par, Rb]
  constructor <;> intro h <;> linarith

theorem le_hi_iff (s : Fin 24) (i : Fin 8) (n u : ℤ) :
    u ≤ hi s i n ↔ Dm i (i - 1) * u ≤ Rb s i (i - 1) n := by
  rw [hi, Int.le_ediv_iff_mul_le (orient i).1, mul_comm]

theorem lo_le_iff (s : Fin 24) (i : Fin 8) (n u : ℤ) :
    lo s i n ≤ u ↔ Dm i (i + 1) * u ≤ Rb s i (i + 1) n := by
  have hd : 0 < -Dm i (i + 1) := by linarith [(orient i).2]
  rw [lo, neg_le, Int.le_ediv_iff_mul_le hd]
  constructor <;> intro h <;> linarith

theorem ka_self (i : Fin 8) : ka i i = gc i := by
  obtain ⟨h1, h2, -, hb⟩ := prim i
  rw [ka, h1, h2]
  linear_combination (gc i) * hb

theorem Dm_self (i : Fin 8) : Dm i i = 0 := by
  obtain ⟨h1, h2, -, -⟩ := prim i
  rw [Dm, h1, h2]
  ring

theorem pot_par_self (s : Fin 24) (i : Fin 8) (n u : ℤ) (hd : (n - Cc s i) % gc i = 0) :
    pot (par s i (lev s i n) u) i = n := by
  rw [pot_par, ka_self, Dm_self, lev_mul s i n hd]
  ring

/-- From n = 7 on, the points of the interval [lo, hi] are the piece. -/
theorem par_piece (s : Fin 24) (i : Fin 8) (n u : ℤ) (hn : 7 ≤ n)
    (hd : (n - Cc s i) % gc i = 0) (h1 : lo s i n ≤ u) (h2 : u ≤ hi s i n) :
    ∀ j, pot (par s i (lev s i n) u) j ≤ n - (if j < i then 1 else 0) := by
  have hi' := pot_par_self s i n u hd
  have hh := (pot_le_iff s i (i - 1) n u).2 ((le_hi_iff s i n u).1 h2)
  have hk := (pot_le_iff s i (i + 1) n u).2 ((lo_le_iff s i n u).1 h1)
  intro j
  by_cases e1 : j = i - 1
  · rw [e1]; exact hh
  by_cases e2 : j = i
  · simp only [e2, hi', lt_irrefl, if_false, sub_zero, le_refl]
  by_cases e3 : j = i + 1
  · rw [e3]; exact hk
  obtain ⟨c1, c2, c3, c0, cx, cy⟩ := certG_ok i j e1 e2 e3
  have cc := certC_ok s i j e1 e2 e3
  simp only [certC, cT_eq] at cc
  by_contra hne
  have f3 : pot (par s i (lev s i n) u) i ≤ pot (par s i (lev s i n) u) j := by
    have := (ite01 (j < i)).2
    rw [hi']
    linarith [not_le.1 hne]
  exact farkas4 (par s i (lev s i n) u) (i - 1) i (i + 1) j _ _ 7 _ _ _ _ ⟨c1, c2, c3, c0⟩ cx cy cc
    (by rw [hi']; exact hh) (by rw [hi']; exact hk) f3 (by rw [hi']; exact hn)

/-- The box that holds the sphere F = n. -/
noncomputable def Bx (n : ℤ) : Finset V :=
  Finset.Icc (-(1 * n + 8)) (1 * n + 8) ×ˢ
    (Finset.Icc (-(1 * n + 8)) (1 * n + 8) ×ˢ Finset.univ)

theorem Cbound : ∀ s : Fin 24, ∀ j : Fin 8, -8 ≤ Cc s j ∧ Cc s j ≤ 8 := by decide +kernel

/-- Weighted pairs of facets whose gradients add up to a multiple of an axis direction. -/
theorem box_pairs : 1 * Ac 3 + 1 * Ac 4 = 12 ∧ 1 * Bc 3 + 1 * Bc 4 = 0 ∧
    1 * Ac 0 + 1 * Ac 7 = (-12) ∧ 1 * Bc 0 + 1 * Bc 7 = 0 ∧
    1 * Ac 5 + 1 * Ac 7 = 0 ∧ 1 * Bc 5 + 1 * Bc 7 = 12 ∧
    1 * Ac 1 + 2 * Ac 2 = 0 ∧ 1 * Bc 1 + 2 * Bc 2 = (-18) := by
  decide +kernel

/-- Each weighted pair of facets bounds one coordinate by F. -/
theorem coord_le (x y : ℤ) (s : Fin 24) :
    12 * x ≤ 2 * F (x, y, s) + 16 ∧
    12 * (-x) ≤ 2 * F (x, y, s) + 16 ∧
    12 * y ≤ 2 * F (x, y, s) + 16 ∧
    18 * (-y) ≤ 3 * F (x, y, s) + 24 := by
  obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8⟩ := box_pairs
  have e0 : 1 * pot (x, y, s) 3 + 1 * pot (x, y, s) 4 =
      12 * x + 1 * Cc s 3 + 1 * Cc s 4 := by
    simp only [pot]; linear_combination x * p1 + y * p2
  have q0 := le_F (x, y, s) 3
  have r0 := le_F (x, y, s) 4
  have k0 := Cbound s 3
  have l0 := Cbound s 4
  have e1 : 1 * pot (x, y, s) 0 + 1 * pot (x, y, s) 7 =
      12 * (-x) + 1 * Cc s 0 + 1 * Cc s 7 := by
    simp only [pot]; linear_combination x * p3 + y * p4
  have q1 := le_F (x, y, s) 0
  have r1 := le_F (x, y, s) 7
  have k1 := Cbound s 0
  have l1 := Cbound s 7
  have e2 : 1 * pot (x, y, s) 5 + 1 * pot (x, y, s) 7 =
      12 * y + 1 * Cc s 5 + 1 * Cc s 7 := by
    simp only [pot]; linear_combination x * p5 + y * p6
  have q2 := le_F (x, y, s) 5
  have r2 := le_F (x, y, s) 7
  have k2 := Cbound s 5
  have l2 := Cbound s 7
  have e3 : 1 * pot (x, y, s) 1 + 2 * pot (x, y, s) 2 =
      18 * (-y) + 1 * Cc s 1 + 2 * Cc s 2 := by
    simp only [pot]; linear_combination x * p7 + y * p8
  have q3 := le_F (x, y, s) 1
  have r3 := le_F (x, y, s) 2
  have k3 := Cbound s 1
  have l3 := Cbound s 2
  refine ⟨?_, ?_, ?_, ?_⟩ <;> linarith

theorem mem_Bx (v : V) (n : ℤ) (h : F v ≤ n) : v ∈ Bx n := by
  obtain ⟨x, y, s⟩ := v
  obtain ⟨b1, b2, b3, b4⟩ := coord_le x y s
  have h0 := F_nonneg (x, y, s)
  simp only [Bx, Finset.mem_product, Finset.mem_Icc, Finset.mem_univ, and_true]
  omega

/-- The piece of the sphere F = n with class s and first maximal facet i. -/
noncomputable def PF (s : Fin 24) (i : Fin 8) (n : ℤ) : Finset V :=
  (Bx n).filter (fun v => v.2.2 = s ∧ F v = n ∧ fi v = i)

theorem piece_eq (s : Fin 24) (i : Fin 8) (n : ℤ) (hn : 7 ≤ n) :
    PF s i n = if (n - Cc s i) % gc i = 0 then
      (Finset.Icc (lo s i n) (hi s i n)).image (par s i (lev s i n)) else ∅ := by
  split_ifs with hd
  · ext v
    simp only [PF, Finset.mem_filter, Finset.mem_image, Finset.mem_Icc]
    constructor
    · rintro ⟨-, hs, hv⟩
      obtain ⟨h1, h2⟩ := (piece_iff v i n).1 hv
      have hl : lev s i n = Ap i * v.1 + Bp i * v.2.1 := by
        rw [lev, ← h1, pot_lev, hs, Int.add_sub_cancel,
          Int.mul_ediv_cancel_left _ (ne_of_gt (prim i).2.2.1)]
      have hv' := par_inv v i
      rw [hs, ← hl] at hv'
      refine ⟨be i * v.1 - al i * v.2.1, ⟨?_, ?_⟩, hv'.symm⟩
      · rw [lo_le_iff, ← pot_le_iff, ← hv']
        exact h2 (i + 1)
      · rw [le_hi_iff, ← pot_le_iff, ← hv']
        exact h2 (i - 1)
    · rintro ⟨u, ⟨h1, h2⟩, rfl⟩
      have hp := par_piece s i n u hn hd h1 h2
      have hv := (piece_iff (par s i (lev s i n) u) i n).2 ⟨pot_par_self s i n u hd, hp⟩
      exact ⟨mem_Bx _ n (le_of_eq hv.1), rfl, hv⟩
  · rw [PF]
    apply Finset.filter_false_of_mem
    rintro v - ⟨hs, hv⟩
    obtain ⟨h1, -⟩ := (piece_iff v i n).1 hv
    apply hd
    rw [← hs, ← h1, pot_lev, Int.add_sub_cancel, Int.mul_emod_right]

/-- The length of the piece (s, i) at level n, as an integer. -/
def inner (s : Fin 24) (i : Fin 8) (n : ℤ) : ℤ :=
  if (n - Cc s i) % gc i = 0 then hi s i n + 1 - lo s i n else 0

theorem card_piece (s : Fin 24) (i : Fin 8) (n : ℤ) (hn : 7 ≤ n) :
    (PF s i n).card = (inner s i n).toNat := by
  rw [piece_eq s i n hn, inner]
  split_ifs
  · rw [Finset.card_image_of_injective _ (par_inj s i _), Int.card_Icc]
  · rfl

/-- The number of points with F = n. -/
noncomputable def cnt (n : ℤ) : ℕ := Set.ncard {v : V | F v = n}

theorem cnt_eq_card (n : ℤ) : cnt n = ((Bx n).filter (fun v => F v = n)).card := by
  rw [cnt, ← Set.ncard_coe_finset]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq, Finset.coe_filter]
  exact ⟨fun h => ⟨mem_Bx v n (le_of_eq h), h⟩, fun h => h.2⟩

theorem cnt_eq_sum (n : ℤ) : cnt n = ∑ p : Fin 24 × Fin 8, (PF p.1 p.2 n).card := by
  rw [cnt_eq_card, Finset.card_eq_sum_card_fiberwise (f := fun v => (v.2.2, fi v))
    (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [PF, Finset.filter_filter]
  congr 1
  apply Finset.filter_congr
  intro v _
  constructor
  · rintro ⟨h1, h2⟩
    rw [← h2]
    exact ⟨rfl, h1, rfl⟩
  · rintro ⟨h1, h2, h3⟩
    exact ⟨h2, by rw [h1, h3]⟩

/-- The closed form of the sphere size: the sum of the piece lengths. -/
def S (n : ℤ) : ℤ := ∑ p : Fin 24 × Fin 8, inner p.1 p.2 n

/-! Shifting n by 12 = gc i * Lq i moves each quotient of a piece length by an integer. -/

def LqV (k : ℕ) : ℕ := ctabN 1009990707 4 k

def LqN (k : ℕ) : ℤ := (LqV k : ℤ)

def Lq (i : Fin 8) : ℤ := LqN i.val

def mhV (k : ℕ) : ℕ := ctabN 1246183495 4 k

def mhN (k : ℕ) : ℤ := (mhV k : ℤ) - 5

def mh (i : Fin 8) : ℤ := mhN i.val

def mkV (k : ℕ) : ℕ := ctabN 1886681716 4 k

def mkN (k : ℕ) : ℤ := (mkV k : ℤ) - 5

def mk (i : Fin 8) : ℤ := mkN i.val

theorem shift_ok : ∀ i : Fin 8, (12 : ℤ) = gc i * Lq i ∧
    12 - ka i (i - 1) * Lq i = Dm i (i - 1) * mh i ∧
    12 - ka i (i + 1) * Lq i = (-Dm i (i + 1)) * mk i := by
  decide +kernel

theorem inner_shift (s : Fin 24) (i : Fin 8) (n : ℤ) :
    inner s i (n + 12) = inner s i n + (if (n - Cc s i) % gc i = 0 then mh i + mk i else 0) := by
  obtain ⟨e0, e1, e2⟩ := shift_ok i
  have hg := (prim i).2.2.1
  have hx : n + 12 - Cc s i = (n - Cc s i) + gc i * Lq i := by linear_combination e0
  have hm : (n + 12 - Cc s i) % gc i = (n - Cc s i) % gc i := by
    rw [hx, Int.add_mul_emod_self_left]
  have hl : lev s i (n + 12) = lev s i n + Lq i := by
    rw [lev, lev, hx, Int.add_mul_ediv_left _ _ (ne_of_gt hg)]
  have r1 : Rb s i (i - 1) (n + 12) = Rb s i (i - 1) n + Dm i (i - 1) * mh i := by
    rw [← e1]; simp only [Rb, hl]; ring
  have r2 : Rb s i (i + 1) (n + 12) = Rb s i (i + 1) n + (-Dm i (i + 1)) * mk i := by
    rw [← e2]; simp only [Rb, hl]; ring
  rw [inner, inner, hm]
  split_ifs
  · simp only [hi, lo, r1, r2]
    rw [Int.add_mul_ediv_left _ _ (ne_of_gt (orient i).1),
      Int.add_mul_ediv_left _ _ (ne_of_gt (show 0 < -Dm i (i + 1) by linarith [(orient i).2]))]
    ring
  · ring

/-- The growth of S over one period, from the residue of n mod 4 = gc i * lgq i. -/
def Gs (n : ℤ) : ℤ :=
  ∑ q : Fin 24 × Fin 8, (if (n - Cc q.1 q.2) % gc q.2 = 0 then mh q.2 + mk q.2 else 0)

theorem S_shift (n : ℤ) : S (n + 12) = S n + Gs n := by
  simp only [S, Gs, inner_shift, Finset.sum_add_distrib]

def lgqV (k : ℕ) : ℕ := ctabN 3183369 3 k

def lgqN (k : ℕ) : ℤ := (lgqV k : ℤ)

def lgq (i : Fin 8) : ℤ := lgqN i.val

theorem lg_ok : ∀ i : Fin 8, (4 : ℤ) = gc i * lgq i := by
  decide +kernel

theorem Gs_periodic (x q : ℤ) : Gs (x + 4 * q) = Gs x := by
  simp only [Gs]
  refine Finset.sum_congr rfl (fun r _ => ?_)
  have e : x + 4 * q - Cc r.1 r.2 = (x - Cc r.1 r.2) + gc r.2 * (lgq r.2 * q) := by
    linear_combination q * lg_ok r.2
  rw [e, Int.add_mul_emod_self_left]

theorem mhk_nonneg : ∀ i : Fin 8, 0 ≤ mh i + mk i := by decide +kernel

/-- The growth of the piece with index c = i + 8 s, read by the kernel from the tables. -/
def gsN (c : ℕ) (n : ℤ) : ℤ :=
  if (n - cTN c) % gcN (c % 8) = 0 then mhN (c % 8) + mkN (c % 8) else 0

theorem gsN_eq (s : Fin 24) (i : Fin 8) (n : ℤ) :
    gsN (i.val + 8 * s.val) n = (if (n - Cc s i) % gc i = 0 then mh i + mk i else 0) := by
  have hi := i.isLt
  have h : (i.val + 8 * s.val) % 8 = i.val := by omega
  rw [gsN, h, ← cT_eq]
  rfl

def GsN (n : ℤ) : ℤ := ((List.range (24 * 8)).map fun c => gsN c n).sum

/-! The piece length in table form, for the kernel: on a level with points, inner s i n is
(uh i c + vh s i) / dh i + (uk i c + vk s i) / dk i + 1 with c = lev s i n. -/

def uhV (k : ℕ) : ℕ := ctabN 434185372023 5 k

def uhN (k : ℕ) : ℤ := (uhV k : ℤ) - 15

def uh (i : Fin 8) : ℤ := uhN i.val

def dhV (k : ℕ) : ℕ := ctabN 40420139483916 6 k

def dhN (k : ℕ) : ℤ := (dhV k : ℤ)

def dh (i : Fin 8) : ℤ := dhN i.val

def ukV (k : ℕ) : ℕ := ctabN 790856716971 5 k

def ukN (k : ℕ) : ℤ := (ukV k : ℤ) - 15

def uk (i : Fin 8) : ℤ := ukN i.val

def dkV (k : ℕ) : ℕ := ctabN 55253885043276 6 k

def dkN (k : ℕ) : ℤ := (dkV k : ℤ)

def dk (i : Fin 8) : ℤ := dkN i.val

def vhV (k : ℕ) : ℕ := ctabN 686809094450379794216959926492852577609365675805444268224602167751601739401038237510977760153802262087770824185714358272449322574901977954957744095290837432269678781741823278179624035156635388470607785774908018026075427054122403525025933438981131351266189810411720088701086724627613554033 5 k

def vhN (k : ℕ) : ℤ := (vhV k : ℤ) - 9

def vh (s : Fin 24) (i : Fin 8) : ℤ := vhN (i.val + 8 * s.val)

def vkV (k : ℕ) : ℕ := ctabN 3495495296523225600709261244743912479579100105178354018169697384679331624725440988821255345479450111166965878029647218156461345527467849069963624065024055205290470014276375620341384627554134902430180468153773553164451768601388441456743093330444269551104086701816267648212791351056108400006 5 k

def vkN (k : ℕ) : ℤ := (vkV k : ℤ) - 9

def vk (s : Fin 24) (i : Fin 8) : ℤ := vkN (i.val + 8 * s.val)

def levT (s : Fin 24) (i : Fin 8) (n : ℤ) : ℤ := (n - cT s i) / gc i

def innerT (s : Fin 24) (i : Fin 8) (n : ℤ) : ℤ :=
  if (n - cT s i) % gc i = 0 then
    (uh i * levT s i n + vh s i) / dh i + (uk i * levT s i n + vk s i) / dk i + 1 else 0

theorem tab_facet : ∀ i : Fin 8, uh i = gc i - ka i (i - 1) ∧ dh i = Dm i (i - 1) ∧
    uk i = gc i - ka i (i + 1) ∧ dk i = -Dm i (i + 1) := by
  decide +kernel

theorem tab_class : ∀ s : Fin 24, ∀ i : Fin 8,
    vh s i = cT s i - cT s (i - 1) - (if i - 1 < i then 1 else 0) ∧
    vk s i = cT s i - cT s (i + 1) - (if i + 1 < i then 1 else 0) := by
  decide +kernel

theorem tab_ok (s : Fin 24) (i : Fin 8) : uh i = gc i - ka i (i - 1) ∧
    vh s i = Cc s i - Cc s (i - 1) - (if i - 1 < i then 1 else 0) ∧
    dh i = Dm i (i - 1) ∧ uk i = gc i - ka i (i + 1) ∧
    vk s i = Cc s i - Cc s (i + 1) - (if i + 1 < i then 1 else 0) ∧
    dk i = -Dm i (i + 1) := by
  obtain ⟨f1, f2, f3, f4⟩ := tab_facet i
  obtain ⟨c1, c2⟩ := tab_class s i
  simp only [cT_eq] at c1 c2
  exact ⟨f1, c1, f2, f3, c2, f4⟩

theorem inner_eq (s : Fin 24) (i : Fin 8) (n : ℤ) : inner s i n = innerT s i n := by
  have hl : levT s i n = lev s i n := by rw [levT, lev, cT_eq]
  rw [inner, innerT, cT_eq, hl]
  split_ifs with hd
  · obtain ⟨e1, e2, e3, e4, e5, e6⟩ := tab_ok s i
    have hc := lev_mul s i n hd
    have r1 : Rb s i (i - 1) n = uh i * lev s i n + vh s i := by
      rw [e1, e2, Rb]; linear_combination (-1 : ℤ) * hc
    have r2 : Rb s i (i + 1) n = uk i * lev s i n + vk s i := by
      rw [e4, e5, Rb]; linear_combination (-1 : ℤ) * hc
    rw [hi, lo, r1, r2, e3, e6]
    ring
  · rfl

/-- The closed form in table form. -/
def ST (n : ℤ) : ℤ := ∑ p : Fin 24 × Fin 8, innerT p.1 p.2 n

theorem S_eq_ST (n : ℤ) : S n = ST n := by
  simp only [S, ST, inner_eq]

/-- The piece length with index c = i + 8 s, read by the kernel from the tables directly. -/
def innerN (c : ℕ) (n : ℤ) : ℤ :=
  if (n - cTN c) % gcN (c % 8) = 0 then
    (uhN (c % 8) * ((n - cTN c) / gcN (c % 8)) + vhN c) / dhN (c % 8) +
      (ukN (c % 8) * ((n - cTN c) / gcN (c % 8)) + vkN c) / dkN (c % 8) + 1
  else 0

theorem innerN_eq (s : Fin 24) (i : Fin 8) (n : ℤ) :
    innerN (i.val + 8 * s.val) n = innerT s i n := by
  have hi := i.isLt
  have h : (i.val + 8 * s.val) % 8 = i.val := by omega
  rw [innerN, h]
  rfl

theorem sum_range_list (f : ℕ → ℤ) (N : ℕ) :
    ∑ c ∈ Finset.range N, f c = ((List.range N).map f).sum := by
  rw [Finset.sum_eq_multiset_sum, Finset.range_val, ← Multiset.coe_range, Multiset.map_coe,
    Multiset.sum_coe]

/-- The closed form over the indices of the pieces. -/
def STN (n : ℤ) : ℤ := ((List.range (24 * 8)).map fun c => innerN c n).sum

theorem ST_eq_STN (n : ℤ) : ST n = STN n := by
  rw [ST, STN, Fintype.sum_equiv finProdFinEquiv (fun q : Fin 24 × Fin 8 => innerT q.1 q.2 n)
    (fun c : Fin (24 * 8) => innerN c.val n) (fun q => (innerN_eq q.1 q.2 n).symm),
    Fin.sum_univ_eq_sum_range (fun c => innerN c n) (24 * 8), sum_range_list]

theorem Gs_eq_GsN (n : ℤ) : Gs n = GsN n := by
  rw [Gs, GsN, Fintype.sum_equiv finProdFinEquiv
    (fun q : Fin 24 × Fin 8 => if (n - Cc q.1 q.2) % gc q.2 = 0 then mh q.2 + mk q.2 else 0)
    (fun c : Fin (24 * 8) => gsN c.val n) (fun q => (gsN_eq q.1 q.2 n).symm),
    Fin.sum_univ_eq_sum_range (fun c => gsN c n) (24 * 8), sum_range_list]

/-- The closed form's tables, packed: the steps, the values on one period from 3 and below 3. -/
def dtabV (k : ℕ) : ℕ := ctabN 2550957200481765181860 6 k

def tblV (k : ℕ) : ℕ := ctabN 3070887912147006059273 6 k

def initV (k : ℕ) : ℕ := ctabN 345 3 k

/-- The step of the closed form at residue t mod 12. -/
def dv (t : ℕ) : ℕ := dtabV (t % 12)

/-- The sequence in closed form: b(n + 12) = b(n) + dv (n - 3) for n ≥ 3. -/
def b (n : ℕ) : ℕ :=
  if n < 3 then initV n else dv (n - 3) * ((n - 3) / 12) + tblV ((n - 3) % 12)

theorem b_step (n : ℕ) (hn : 3 ≤ n) : b (n + 12) = b n + dv (n - 3) := by
  rw [b, b, if_neg (show ¬ (n + 12 < 3) by omega), if_neg (show ¬ (n < 3) by omega),
    show n + 12 - 3 = n - 3 + 12 by omega, dv, dv, Nat.add_mod_right,
    Nat.add_div_right _ (by norm_num : 0 < 12)]
  ring

theorem b_shift (n : ℕ) (hn : 3 ≤ n) : b (n + 12) = b n + 1 * dv (n - 3) := by
  rw [b, b, if_neg (show ¬ (n + 12 < 3) by omega), if_neg (show ¬ (n < 3) by omega),
    show n + 12 - 3 = n - 3 + 12 * 1 by omega, dv, dv, Nat.add_mul_mod_self_left,
    Nat.add_mul_div_left _ _ (by norm_num : 0 < 12)]
  ring

/-- b on the residue class of 3 + j mod 12. -/
theorem b_res (k j : ℕ) (hj : j < 12) : b (12 * k + (3 + j)) = dv j * k + tblV j := by
  rw [b, if_neg (show ¬ (12 * k + (3 + j) < 3) by omega),
    show 12 * k + (3 + j) - 3 = j + 12 * k by omega, dv, dv, Nat.add_mul_mod_self_left,
    Nat.add_mul_div_left _ _ (by norm_num : 0 < 12), Nat.mod_eq_of_lt hj, Nat.div_eq_of_lt hj]
  ring

/-- The growth of S over one period at each residue mod 4. -/
def GsT : List ℤ := [38, 36, 34, 36]

theorem Gs_tab : ∀ r : ℕ, r < 4 → GsN (r : ℤ) = GsT.getD r 0 := by
  decide +kernel

/-- The growth of b over 12 terms is that of S, on one period of the residues. -/
theorem grow_base : ∀ t : ℕ, t < 12 → 1 * (dv t : ℤ) = GsT.getD ((3 + t) % 4) 0 := by
  decide +kernel

theorem grow (n : ℕ) (_hn : 3 ≤ n) : 1 * (dv (n - 3) : ℤ) = Gs n := by
  have h1 := grow_base ((n - 3) % 12) (Nat.mod_lt _ (by norm_num))
  have e1 : dv ((n - 3) % 12) = dv (n - 3) := by
    rw [dv, dv, Nat.mod_mod_of_dvd _ (by norm_num : 12 ∣ 12)]
  have e2 : (3 + (n - 3) % 12) % 4 = n % 4 := by omega
  rw [e1, e2, ← Gs_tab (n % 4) (Nat.mod_lt _ (by norm_num)), ← Gs_eq_GsN] at h1
  rw [h1]
  have e3 : (((n % 4 : ℕ) : ℤ) + 4 * ((n / 4 : ℕ) : ℤ)) = n := by omega
  rw [← e3, Gs_periodic]

/-- One kernel pass over n = 7, ..., 18: every piece length is nonnegative and the
closed form agrees with b. -/
theorem period_ok : ∀ r : ℕ, r < 12 →
    ((List.range (24 * 8)).all fun c => decide (0 ≤ innerN c (7 + (r : ℤ)))) = true ∧
      STN (7 + (r : ℤ)) = b (7 + r) := by
  decide +kernel

/-- Every piece length is nonnegative from n = 7 on: checked on one period, then shifted. -/
theorem inner_nonneg (s : Fin 24) (i : Fin 8) (n : ℤ) (hn : 7 ≤ n) : 0 ≤ inner s i n := by
  obtain ⟨t, rfl⟩ : ∃ t : ℕ, n = 7 + t := ⟨(n - 7).toNat, by omega⟩
  induction t using Nat.strong_induction_on with
  | _ t ih =>
    by_cases ht : t < 12
    · rw [inner_eq, ← innerN_eq]
      have hc : i.val + 8 * s.val < 24 * 8 := by
        have := i.isLt
        have := s.isLt
        omega
      exact of_decide_eq_true (List.all_eq_true.1 (period_ok t ht).1 _ (List.mem_range.2 hc))
    · have := ih (t - 12) (by omega) (by omega)
      have e : (7 : ℤ) + t = (7 + (t - 12 : ℕ)) + 12 := by
        push_cast [Nat.cast_sub (by omega : 12 ≤ t)]; ring
      rw [e, inner_shift]
      have hpos := mhk_nonneg i
      split_ifs <;> linarith

theorem cnt_eq_S (n : ℤ) (hn : 7 ≤ n) : (cnt n : ℤ) = S n := by
  rw [cnt_eq_sum, S, Nat.cast_sum]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [card_piece p.1 p.2 n hn]
  exact Int.toNat_of_nonneg (inner_nonneg p.1 p.2 n hn)

theorem S_eq_b (n : ℕ) (hn : 7 ≤ n) : S n = b n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases h : n < 19
    · obtain ⟨r, rfl⟩ : ∃ r, n = 7 + r := ⟨n - 7, by omega⟩
      rw [S_eq_ST, ST_eq_STN]
      push_cast
      exact (period_ok r (by omega)).2
    · have h1 := ih (n - 12) (by omega) (by omega)
      have h2 := S_shift ((n - 12 : ℕ) : ℤ)
      have h3 := b_shift (n - 12) (by omega)
      have h4 := grow (n - 12) (by omega)
      rw [show n - 12 + 12 = n by omega] at h3
      rw [show ((n - 12 : ℕ) : ℤ) + 12 = n by omega] at h2
      rw [h2, h1, h3]
      push_cast
      linarith

/-! ## The small spheres

The points with F ≤ 6 lie in the box -2 ≤ x ≤ 2, -2 ≤ y ≤ 2 (`small_box`), and
the kernel checks that those of the box are the 62 points of `smallL` (`smallOK_eq`). -/

theorem small_box (x y : ℤ) (s : Fin 24) (h : F (x, y, s) ≤ 6) :
    -2 ≤ x ∧ x ≤ 2 ∧ -2 ≤ y ∧ y ≤ 2 := by
  obtain ⟨b1, b2, b3, b4⟩ := coord_le x y s
  omega

/-- The points with F ≤ 6, with their values of F. -/
def smallV : List (V × ℤ) :=
  [((0, 0, 1), 1), ((0, 0, 12), 1), ((0, 1, 0), 1), (((-1), 0, 23), 2), (((-1), 1, 11), 2), ((0, 0, 2), 2), ((0, 0, 13), 2), ((0, 0, 14), 2), ((0, 1, 3), 2), (((-1), 0, 20), 3), (((-1), 1, 10), 3), (((-1), 1, 16), 3), (((-1), 1, 22), 3), ((0, 0, 6), 3), ((0, 0, 7), 3), ((0, 0, 17), 3), ((0, 0, 18), 3), ((0, 1, 4), 3), (((-1), 0, 8), 4), (((-1), 0, 21), 4), (((-1), 1, 9), 4), (((-1), 1, 15), 4), (((-1), 1, 19), 4), ((0, 0, 5), 4), ((0, 0, 8), 4), ((0, 0, 9), 4), ((0, 0, 21), 4), ((0, 1, 5), 4), ((0, 1, 15), 4), ((0, 1, 19), 4), (((-1), 0, 9), 5), (((-1), 0, 17), 5), (((-1), 0, 18), 5), (((-1), 1, 4), 5), (((-1), 1, 5), 5), (((-1), 1, 8), 5), (((-1), 1, 17), 5), ((0, 0, 4), 5), ((0, 0, 10), 5), ((0, 0, 15), 5), ((0, 0, 20), 5), ((0, 1, 6), 5), ((0, 1, 16), 5), ((0, 1, 22), 5), ((1, 0, 7), 5), (((-1), 0, 10), 6), (((-1), 0, 13), 6), (((-1), 1, 3), 6), (((-1), 1, 6), 6), (((-1), 1, 13), 6), (((-1), 1, 21), 6), ((0, 0, 3), 6), ((0, 0, 11), 6), ((0, 0, 16), 6), ((0, 0, 19), 6), ((0, 0, 23), 6), ((0, 1, 7), 6), ((0, 1, 10), 6), ((0, 1, 11), 6), ((0, 1, 14), 6), ((1, 0, 6), 6), ((1, 0, 14), 6)]

def smallL : List V := smallV.map Prod.fst

theorem smallV_ok : (smallV.all fun q => decide (F q.1 = q.2)) = true := by
  decide +kernel

/-- The potentials, packed: Ac = ATV - 8, Bc = BTV - 8. -/
def ATV (k : ℕ) : ℕ := ctabN 148596205696 5 k

def ATN (k : ℕ) : ℤ := (ATV k : ℤ) - 8

def AT (i : Fin 8) : ℤ := ATN i.val

def BTV (k : ℕ) : ℕ := ctabN 428972575748 5 k

def BTN (k : ℕ) : ℤ := (BTV k : ℤ) - 8

def BT (i : Fin 8) : ℤ := BTN i.val

theorem AB_eq : ∀ i : Fin 8, AT i = Ac i ∧ BT i = Bc i := by
  decide +kernel

/-- Some potential exceeds 6 at the box point ((a : ℤ) - 2, (b : ℤ) - 2, s), in natural
numbers: the negative terms moved across. -/
def bigNat (a b s : ℕ) : Bool :=
  (List.range 8).any fun i =>
    Nat.blt (14 + ATV i * 2 + 8 * a + BTV i * 2 + 8 * b)
      (ATV i * a + 16 + BTV i * b + 16 + cTV (i + 8 * s))

theorem big_pot (a b : ℕ) (s : Fin 24) (h : bigNat a b s.val = true) :
    (6 : ℤ) < F ((a : ℤ) - 2, (b : ℤ) - 2, s) := by
  obtain ⟨i, hi, hb⟩ := List.any_eq_true.1 h
  rw [List.mem_range] at hi
  have hl := (Nat.cast_lt (α := ℤ)).mpr (Nat.blt_eq.mp hb)
  have hp := le_F ((a : ℤ) - 2, (b : ℤ) - 2, s) ⟨i, hi⟩
  obtain ⟨eA, eB⟩ := AB_eq ⟨i, hi⟩
  have e3 := cT_eq s ⟨i, hi⟩
  simp only [pot] at hp
  rw [← eA, ← eB, ← e3] at hp
  simp only [AT, BT, ATN, BTN, cT, cTN] at hp
  push_cast at hl hp
  ring_nf at hl hp ⊢
  linarith

def smallOK : Bool :=
  (List.range 5).all fun a => (List.range 5).all fun b => (List.finRange 24).all fun s =>
    bigNat a b s.val || decide (((a : ℤ) - 2, (b : ℤ) - 2, s) ∈ smallL)

theorem smallOK_eq : smallOK = true := by
  decide +kernel

theorem small_mem (v : V) (hF : F v ≤ 6) : v ∈ smallL := by
  obtain ⟨x, y, s⟩ := v
  obtain ⟨hx1, hx2, hy1, hy2⟩ := small_box x y s hF
  have h := smallOK_eq
  unfold smallOK at h
  simp only [List.all_eq_true, List.mem_range, List.mem_finRange, forall_const] at h
  have h' := h (x + 2).toNat (by omega) (y + 2).toNat (by omega) s
  have ex : (((x + 2).toNat : ℕ) : ℤ) - 2 = x := by omega
  have ey : (((y + 2).toNat : ℕ) : ℤ) - 2 = y := by omega
  simp only [Bool.or_eq_true, decide_eq_true_eq] at h'
  rcases h' with h1 | h1
  · have := big_pot _ _ s h1
    rw [ex, ey] at this
    omega
  · rw [ex, ey] at h1
    exact h1

theorem cnt_small (n : ℤ) (hn : n ≤ 6) :
    cnt n = (((smallV.filter (fun q => decide (q.2 = n))).map Prod.fst).toFinset).card := by
  rw [cnt, ← Set.ncard_coe_finset]
  congr 1
  ext v
  have hv := smallV_ok
  simp only [List.all_eq_true, decide_eq_true_eq] at hv
  simp only [Set.mem_ofPred_eq, List.coe_toFinset, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · intro h
    obtain ⟨q, hq, rfl⟩ := List.mem_map.1 (small_mem v (by omega))
    exact ⟨q, ⟨hq, by rw [← hv q hq]; exact h⟩, rfl⟩
  · rintro ⟨q, ⟨hq, h2⟩, rfl⟩
    rw [hv q hq]
    exact h2

/-- The small spheres from 3 on, in closed form. -/
theorem small_ok : ∀ n : ℕ, 3 ≤ n → n < 7 →
    (((smallV.filter (fun q => decide (q.2 = (n : ℤ)))).map Prod.fst).toFinset).card = b n := by
  decide +kernel

/-! ## The coordination sequence

`a n` counts the level set F = n from n = 3 on (`a_eq_cnt`, from `a_eq_F`), and `small_vals`
lists the terms below 3. The terms from 3 to 6 are counted in `smallL`, those from 7 on
are S(n), and all agree with the closed form b (`a_eq_b`). The step from n to n + 12, the closed form
per residue (`a_closed`), the controls, the recurrence and the g.f. follow, their base cases checked by
the kernel on b. -/

theorem a_eq_cnt (n : ℕ) (hn : 3 ≤ n) : a n = cnt n := by
  rw [a_eq_F n hn, cnt]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq]
  have := F_nonneg v
  omega

theorem a_eq_S (n : ℕ) (hn : 7 ≤ n) : (a n : ℤ) = S n := by
  rw [a_eq_cnt n (by omega)]
  exact cnt_eq_S n (by exact_mod_cast hn)

theorem a_lt_R0 (n : ℕ) (hn : n < 3) : a n = b n := by
  have h : (List.range 3).map a = (List.range 3).map b := by
    rw [small_vals]
    decide +kernel
  exact List.map_inj_left.1 h n (List.mem_range.2 hn)

/-- The coordination sequence in closed form. -/
theorem a_eq_b (n : ℕ) : a n = b n := by
  rcases (show n < 3 ∨ (3 ≤ n ∧ n < 7) ∨ 7 ≤ n by omega) with h | ⟨h1, h2⟩ | h
  · exact a_lt_R0 n h
  · rw [a_eq_cnt n h1, cnt_small _ (by omega)]
    exact small_ok n h1 h2
  · have h1 := a_eq_S n h
    rw [S_eq_b n h] at h1
    exact_mod_cast h1

/-- The step a(n + 12) = a(n) + dv (n - 3) for n ≥ 3. -/
theorem a_step (n : ℕ) (hn : 3 ≤ n) : a (n + 12) = a n + dv (n - 3) := by
  rw [a_eq_b, a_eq_b]
  exact b_step n hn

/-- The steps and the values on one period, by the kernel. -/
theorem closed_vals : dv 0 = 36 ∧ tblV 0 = 9 ∧ dv 1 = 38 ∧ tblV 1 = 12 ∧ dv 2 = 36 ∧ tblV 2 = 15 ∧ dv 3 = 34 ∧ tblV 3 = 17 ∧ dv 4 = 36 ∧ tblV 4 = 19 ∧ dv 5 = 38 ∧ tblV 5 = 24 ∧ dv 6 = 36 ∧ tblV 6 = 29 ∧ dv 7 = 34 ∧ tblV 7 = 31 ∧ dv 8 = 36 ∧ tblV 8 = 33 ∧ dv 9 = 38 ∧ tblV 9 = 36 ∧ dv 10 = 36 ∧ tblV 10 = 39 ∧ dv 11 = 34 ∧ tblV 11 = 41 := by
  decide +kernel

/-- The closed form per residue of n mod 12, for n ≥ 3. -/
theorem a_closed (k : ℕ) :
    a (12 * k + 3) = 36 * k + 9 ∧
    a (12 * k + 4) = 38 * k + 12 ∧
    a (12 * k + 5) = 36 * k + 15 ∧
    a (12 * k + 6) = 34 * k + 17 ∧
    a (12 * k + 7) = 36 * k + 19 ∧
    a (12 * k + 8) = 38 * k + 24 ∧
    a (12 * k + 9) = 36 * k + 29 ∧
    a (12 * k + 10) = 34 * k + 31 ∧
    a (12 * k + 11) = 36 * k + 33 ∧
    a (12 * k + 12) = 38 * k + 36 ∧
    a (12 * k + 13) = 36 * k + 39 ∧
    a (12 * k + 14) = 34 * k + 41 := by
  obtain ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23⟩ := closed_vals
  simp only [a_eq_b]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [show 12 * k + 3 = 12 * k + (3 + 0) from rfl, b_res k 0 (by norm_num), c0, c1]
  · rw [show 12 * k + 4 = 12 * k + (3 + 1) from rfl, b_res k 1 (by norm_num), c2, c3]
  · rw [show 12 * k + 5 = 12 * k + (3 + 2) from rfl, b_res k 2 (by norm_num), c4, c5]
  · rw [show 12 * k + 6 = 12 * k + (3 + 3) from rfl, b_res k 3 (by norm_num), c6, c7]
  · rw [show 12 * k + 7 = 12 * k + (3 + 4) from rfl, b_res k 4 (by norm_num), c8, c9]
  · rw [show 12 * k + 8 = 12 * k + (3 + 5) from rfl, b_res k 5 (by norm_num), c10, c11]
  · rw [show 12 * k + 9 = 12 * k + (3 + 6) from rfl, b_res k 6 (by norm_num), c12, c13]
  · rw [show 12 * k + 10 = 12 * k + (3 + 7) from rfl, b_res k 7 (by norm_num), c14, c15]
  · rw [show 12 * k + 11 = 12 * k + (3 + 8) from rfl, b_res k 8 (by norm_num), c16, c17]
  · rw [show 12 * k + 12 = 12 * k + (3 + 9) from rfl, b_res k 9 (by norm_num), c18, c19]
  · rw [show 12 * k + 13 = 12 * k + (3 + 10) from rfl, b_res k 10 (by norm_num), c20, c21]
  · rw [show 12 * k + 14 = 12 * k + (3 + 11) from rfl, b_res k 11 (by norm_num), c22, c23]

/-- Controls: the entry's data a(0..49). -/
theorem controls : (List.range 50).map a =
    [1, 3, 5, 9, 12, 15, 17, 19, 24, 29, 31, 33, 36, 39, 41, 45, 50, 51, 51, 55, 62, 65, 65, 69, 74, 75, 75, 81, 88, 87, 85, 91, 100, 101, 99, 105, 112, 111, 109, 117, 126, 123, 119, 127, 138, 137, 133, 141, 150, 147] := by
  rw [show a = b from funext a_eq_b]
  decide +kernel

/-- The steps satisfy the recurrence, on one period of the residues. -/
theorem drec_base : ∀ t : ℕ, t < 12 → (dv (t + 12) : ℤ) = 3 * (dv (t + 11) : ℤ) - 5 * (dv (t + 10) : ℤ) + 6 * (dv (t + 9) : ℤ) - 5 * (dv (t + 8) : ℤ) + 3 * (dv (t + 7) : ℤ) - 2 * (dv (t + 6) : ℤ) + 3 * (dv (t + 5) : ℤ) - 5 * (dv (t + 4) : ℤ) + 6 * (dv (t + 3) : ℤ) - 5 * (dv (t + 2) : ℤ) + 3 * (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
  decide +kernel

theorem drec (t : ℕ) : (dv (t + 12) : ℤ) = 3 * (dv (t + 11) : ℤ) - 5 * (dv (t + 10) : ℤ) + 6 * (dv (t + 9) : ℤ) - 5 * (dv (t + 8) : ℤ) + 3 * (dv (t + 7) : ℤ) - 2 * (dv (t + 6) : ℤ) + 3 * (dv (t + 5) : ℤ) - 5 * (dv (t + 4) : ℤ) + 6 * (dv (t + 3) : ℤ) - 5 * (dv (t + 2) : ℤ) + 3 * (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 12 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 1, e 2, e 3, e 4, e 5, e 6, e 7, e 8, e 9, e 10, e 11, e 12]
  exact drec_base (t % 12) (Nat.mod_lt _ (by norm_num))

/-- The recurrence on its first 12 terms, by the kernel. -/
theorem recur_base : ∀ q : ℕ, q < 12 → (b (q + 15) : ℤ) = 3 * b (q + 14) - 5 * b (q + 13) + 6 * b (q + 12) - 5 * b (q + 11) + 3 * b (q + 10) - 2 * b (q + 9) + 3 * b (q + 8) - 5 * b (q + 7) + 6 * b (q + 6) - 5 * b (q + 5) + 3 * b (q + 4) - b (q + 3) := by
  decide +kernel

theorem b_recur (q : ℕ) : (b (q + 15) : ℤ) = 3 * b (q + 14) - 5 * b (q + 13) + 6 * b (q + 12) - 5 * b (q + 11) + 3 * b (q + 10) - 2 * b (q + 9) + 3 * b (q + 8) - 5 * b (q + 7) + 6 * b (q + 6) - 5 * b (q + 5) + 3 * b (q + 4) - b (q + 3) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 12 ∨ 12 ≤ q by omega) with hq | hq
    · exact recur_base q hq
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 12 := ⟨q - 12, by omega⟩
      have h0 : (b (v + 15) : ℤ) = 3 * b (v + 14) - 5 * b (v + 13) + 6 * b (v + 12) - 5 * b (v + 11) + 3 * b (v + 10) - 2 * b (v + 9) + 3 * b (v + 8) - 5 * b (v + 7) + 6 * b (v + 6) - 5 * b (v + 5) + 3 * b (v + 4) - b (v + 3) := ih (v + 0) (by omega)
      have s3 : b (v + 15) = b (v + 3) + dv (v + 0) := by
        have h := b_step (v + 3) (by omega)
        rw [show v + 3 + 12 = v + 15 by omega,
          show v + 3 - 3 = v + 0 by omega] at h
        exact h
      have s4 : b (v + 16) = b (v + 4) + dv (v + 1) := by
        have h := b_step (v + 4) (by omega)
        rw [show v + 4 + 12 = v + 16 by omega,
          show v + 4 - 3 = v + 1 by omega] at h
        exact h
      have s5 : b (v + 17) = b (v + 5) + dv (v + 2) := by
        have h := b_step (v + 5) (by omega)
        rw [show v + 5 + 12 = v + 17 by omega,
          show v + 5 - 3 = v + 2 by omega] at h
        exact h
      have s6 : b (v + 18) = b (v + 6) + dv (v + 3) := by
        have h := b_step (v + 6) (by omega)
        rw [show v + 6 + 12 = v + 18 by omega,
          show v + 6 - 3 = v + 3 by omega] at h
        exact h
      have s7 : b (v + 19) = b (v + 7) + dv (v + 4) := by
        have h := b_step (v + 7) (by omega)
        rw [show v + 7 + 12 = v + 19 by omega,
          show v + 7 - 3 = v + 4 by omega] at h
        exact h
      have s8 : b (v + 20) = b (v + 8) + dv (v + 5) := by
        have h := b_step (v + 8) (by omega)
        rw [show v + 8 + 12 = v + 20 by omega,
          show v + 8 - 3 = v + 5 by omega] at h
        exact h
      have s9 : b (v + 21) = b (v + 9) + dv (v + 6) := by
        have h := b_step (v + 9) (by omega)
        rw [show v + 9 + 12 = v + 21 by omega,
          show v + 9 - 3 = v + 6 by omega] at h
        exact h
      have s10 : b (v + 22) = b (v + 10) + dv (v + 7) := by
        have h := b_step (v + 10) (by omega)
        rw [show v + 10 + 12 = v + 22 by omega,
          show v + 10 - 3 = v + 7 by omega] at h
        exact h
      have s11 : b (v + 23) = b (v + 11) + dv (v + 8) := by
        have h := b_step (v + 11) (by omega)
        rw [show v + 11 + 12 = v + 23 by omega,
          show v + 11 - 3 = v + 8 by omega] at h
        exact h
      have s12 : b (v + 24) = b (v + 12) + dv (v + 9) := by
        have h := b_step (v + 12) (by omega)
        rw [show v + 12 + 12 = v + 24 by omega,
          show v + 12 - 3 = v + 9 by omega] at h
        exact h
      have s13 : b (v + 25) = b (v + 13) + dv (v + 10) := by
        have h := b_step (v + 13) (by omega)
        rw [show v + 13 + 12 = v + 25 by omega,
          show v + 13 - 3 = v + 10 by omega] at h
        exact h
      have s14 : b (v + 26) = b (v + 14) + dv (v + 11) := by
        have h := b_step (v + 14) (by omega)
        rw [show v + 14 + 12 = v + 26 by omega,
          show v + 14 - 3 = v + 11 by omega] at h
        exact h
      have s15 : b (v + 27) = b (v + 15) + dv (v + 12) := by
        have h := b_step (v + 15) (by omega)
        rw [show v + 15 + 12 = v + 27 by omega,
          show v + 15 - 3 = v + 12 by omega] at h
        exact h
      have hd := drec v
      show (b (v + 27) : ℤ) = 3 * b (v + 26) - 5 * b (v + 25) + 6 * b (v + 24) - 5 * b (v + 23) + 3 * b (v + 22) - 2 * b (v + 21) + 3 * b (v + 20) - 5 * b (v + 19) + 6 * b (v + 18) - 5 * b (v + 17) + 3 * b (v + 16) - b (v + 15)
      omega

/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 14 < n → (a n : ℤ) = 3 * a (n - 1) - 5 * a (n - 2) + 6 * a (n - 3) - 5 * a (n - 4) + 3 * a (n - 5) - 2 * a (n - 6) + 3 * a (n - 7) - 5 * a (n - 8) + 6 * a (n - 9) - 5 * a (n - 10) + 3 * a (n - 11) - a (n - 12) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 15 := ⟨n - 15, by omega⟩
  rw [show q + 15 - 1 = q + 14 by omega, show q + 15 - 2 = q + 13 by omega, show q + 15 - 3 = q + 12 by omega, show q + 15 - 4 = q + 11 by omega, show q + 15 - 5 = q + 10 by omega, show q + 15 - 6 = q + 9 by omega, show q + 15 - 7 = q + 8 by omega, show q + 15 - 8 = q + 7 by omega, show q + 15 - 9 = q + 6 by omega, show q + 15 - 10 = q + 5 by omega, show q + 15 - 11 = q + 4 by omega, show q + 15 - 12 = q + 3 by omega]
  simp only [a_eq_b]
  exact b_recur q

/-- The coefficients of the g.f. below 15, by the kernel. -/
theorem gf_base : ∀ n : ℕ, n < 15 → 1 * (b n : ℤ) - 3 * (if 1 ≤ n then (b (n - 1) : ℤ) else 0) + 5 * (if 2 ≤ n then (b (n - 2) : ℤ) else 0) - 6 * (if 3 ≤ n then (b (n - 3) : ℤ) else 0) + 5 * (if 4 ≤ n then (b (n - 4) : ℤ) else 0) - 3 * (if 5 ≤ n then (b (n - 5) : ℤ) else 0) + 2 * (if 6 ≤ n then (b (n - 6) : ℤ) else 0) - 3 * (if 7 ≤ n then (b (n - 7) : ℤ) else 0) + 5 * (if 8 ≤ n then (b (n - 8) : ℤ) else 0) - 6 * (if 9 ≤ n then (b (n - 9) : ℤ) else 0) + 5 * (if 10 ≤ n then (b (n - 10) : ℤ) else 0) - 3 * (if 11 ≤ n then (b (n - 11) : ℤ) else 0) + 1 * (if 12 ≤ n then (b (n - 12) : ℤ) else 0) = (if n = 0 then (1 : ℤ) else 0) + (if n = 2 then (1 : ℤ) else 0) * 1 + (if n = 3 then (1 : ℤ) else 0) * 3 - (if n = 4 then (1 : ℤ) else 0) * 3 + (if n = 5 then (1 : ℤ) else 0) * 6 - (if n = 6 then (1 : ℤ) else 0) * 4 + (if n = 7 then (1 : ℤ) else 0) * 4 + (if n = 8 then (1 : ℤ) else 0) * 1 + (if n = 9 then (1 : ℤ) else 0) * 1 - (if n = 10 then (1 : ℤ) else 0) * 1 + (if n = 11 then (1 : ℤ) else 0) * 6 - (if n = 12 then (1 : ℤ) else 0) * 7 + (if n = 13 then (1 : ℤ) else 0) * 6 - (if n = 14 then (1 : ℤ) else 0) * 2 := by
  decide +kernel

