/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * ((X - 1) ^ 2 * (X ^ 2 + 1) ^ 2 * (X ^ 2 - X + 1) * (X ^ 4 - X ^ 2 + 1)) =
      -2 * X ^ 14 + 6 * X ^ 13 - 7 * X ^ 12 + 6 * X ^ 11 - X ^ 10 + X ^ 9 + X ^ 8 + 4 * X ^ 7 - 4 * X ^ 6 + 6 * X ^ 5 - 3 * X ^ 4 + 3 * X ^ 3 + X ^ 2 + 1 := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  have e1 : A * ((X - 1) ^ 2 * (X ^ 2 + 1) ^ 2 * (X ^ 2 - X + 1) * (X ^ 4 - X ^ 2 + 1)) = C 1 * A - C 3 * (A * X ^ 1) + C 5 * (A * X ^ 2) - C 6 * (A * X ^ 3) + C 5 * (A * X ^ 4) - C 3 * (A * X ^ 5) + C 2 * (A * X ^ 6) - C 3 * (A * X ^ 7) + C 5 * (A * X ^ 8) - C 6 * (A * X ^ 9) + C 5 * (A * X ^ 10) - C 3 * (A * X ^ 11) + C 1 * (A * X ^ 12) := by
    simp only [map_ofNat, map_one]
