abbrev Index := Fin 489

def window (i : Index) : Local :=
  let v := ((windows[i.val / 16]?.getD #[])[i.val % 16]?).getD 0
  ⟨(v >>> 0) % 64, (v >>> 6) % 64, (v >>> 12) % 64, (v >>> 18) % 64, (v >>> 24) % 64, (v >>> 30) % 64, v.testBit 36, v.testBit 37, v.testBit 38⟩

def link (i : Index) (t x y : Bool) : Index :=
  let v := ((links[i.val / 16]?.getD #[])[i.val % 16]?).getD 0
  ⟨((v >>> (9 * code t x y)) % 512) % 489, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 8000 in
set_option maxHeartbeats 8000000 in
lemma certificate : ∀ i : Index, valid (window i) ∧
    ∀ t x y : Bool, window (link i t x y) = descend (window i) t x y := by
  decide +kernel

lemma at_origin : position 0 0 0 0 = window 0 := by decide

lemma decomposes (n : ℕ) : digit (n / 2) (n % 2 == 1) = n := by
  rcases (show n % 2 = 0 ∨ n % 2 = 1 by omega) with h | h <;> simp [digit, h] <;> omega

lemma covered (w t x y : ℕ) (ht : t < 2 ^ w) (hx : x < 2 ^ w) (hy : y < 2 ^ w) :
    ∃ i, position w t x y = window i := by
  induction w generalizing t x y with
  | zero =>
    simp only [pow_zero] at ht hx hy
    obtain rfl : t = 0 := by omega
    obtain rfl : x = 0 := by omega
    obtain rfl : y = 0 := by omega
    exact ⟨0, at_origin⟩
  | succ w ih =>
    simp only [pow_succ] at ht hx hy
    obtain ⟨i, hi⟩ := ih (t / 2) (x / 2) (y / 2) (by omega) (by omega) (by omega)
    refine ⟨link i (t % 2 == 1) (x % 2 == 1) (y % 2 == 1), ?_⟩
    have h := position_digit w (t / 2) (x / 2) (y / 2) (t % 2 == 1) (x % 2 == 1) (y % 2 == 1)
    rw [decomposes, decomposes, decomposes, hi, ← (certificate i).2] at h
    exact h

lemma address_stable (w t x y : ℕ) (ht : t < 2 ^ w) (hx : x < 2 ^ w) (hy : y < 2 ^ w) :
    address (w + 1) t x y = address w t x y := by
  induction w generalizing t x y with
  | zero =>
    simp only [pow_zero] at ht hx hy
    have : t = 0 := by omega
    have : x = 0 := by omega
    have : y = 0 := by omega
    subst_vars
    decide
  | succ w ih =>
    simp only [pow_succ] at ht hx hy
    change go (address (w + 1) (t / 2) (x / 2) (y / 2)) _ _ _ = go (address w _ _ _) _ _ _
    rw [ih (t / 2) (x / 2) (y / 2) (by omega) (by omega) (by omega)]

lemma address_wider (w u t x y : ℕ) (hu : w ≤ u) (ht : t < 2 ^ w) (hx : x < 2 ^ w)
    (hy : y < 2 ^ w) : address u t x y = address w t x y := by
  induction u, hu using Nat.le_induction with
  | base => rfl
  | succ u hu ih =>
    have hpow : 2 ^ w ≤ (2 : ℕ) ^ u := Nat.pow_le_pow_right (by decide) hu
    rw [address_stable u t x y (by omega) (by omega) (by omega), ih]

def value (t x y : ℕ) := lit (address (t + x + y + 1) t x y)

lemma at_width (w t x y : ℕ) (ht : t < 2 ^ w) (hx : x < 2 ^ w) (hy : y < 2 ^ w) :
    value t x y = lit (address w t x y) := by
  unfold value
  by_cases h : w ≤ t + x + y + 1
  · rw [address_wider w _ _ _ _ h ht hx hy]
  · have hb := Nat.lt_two_pow_self (n := t + x + y + 1)
    rw [address_wider (t + x + y + 1) w _ _ _ (by omega) (by omega) (by omega) (by omega)]

lemma natural_law (r t x y : ℕ) (hr : r = 430) :
    (t = 0 → value t x y = decide (x = 0 ∧ y = 0)) ∧
    value (t + 1) x y = localRule r (value t x y) (value t (prev x) y) (value t (x + 1) y)
      (value t x (prev y)) (value t x (y + 1)) := by
  let w := t + x + y + 2
  have hw : t + x + y + 2 < 2 ^ w := Nat.lt_two_pow_self
  obtain ⟨i, hi⟩ := covered w t x y (by omega) (by omega) (by omega)
  have h := (certificate i).1
  rw [← hi] at h
  simp only [valid, position] at h
  have hpow : t + x + y + 2 < 2 ^ (w + 1) := by rw [pow_succ]; omega
  have hpx : prev x ≤ x + 1 := by unfold prev; split <;> omega
  have hpy : prev y ≤ y + 1 := by unfold prev; split <;> omega
  rw [at_width (w + 1) t x y (by omega) (by omega) (by omega),
    at_width (w + 1) (t + 1) x y (by omega) (by omega) (by omega),
    at_width (w + 1) t (prev x) y (by omega) (by omega) (by omega),
    at_width (w + 1) t (x + 1) y (by omega) (by omega) (by omega),
    at_width (w + 1) t x (prev y) (by omega) (by omega) (by omega),
    at_width (w + 1) t x (y + 1) (by omega) (by omega) (by omega)]
  constructor
  · intro ht
    have h0 := h.1 (by simp [ht])
    cases x <;> cases y <;> simpa using h0
  · subst hr; exact h.2

def plane (t : ℕ) (x y : ℤ) := value t x.natAbs y.natAbs

lemma plane_zero (x y : ℤ) : plane 0 x y = decide (x = 0 ∧ y = 0) := by
  simpa [plane] using (natural_law 430 0 x.natAbs y.natAbs (rfl : 430 = 430)).1 rfl

lemma neighbors (x : ℤ) :
    ((x - 1).natAbs = prev x.natAbs ∧ (x + 1).natAbs = x.natAbs + 1) ∨
    ((x + 1).natAbs = prev x.natAbs ∧ (x - 1).natAbs = x.natAbs + 1) := by
  rcases lt_trichotomy x 0 with h | rfl | h
  · right
    have a := Int.ofNat_natAbs_of_nonpos (show x ≤ 0 by omega)
    have b := Int.ofNat_natAbs_of_nonpos (show x + 1 ≤ 0 by omega)
    have c := Int.ofNat_natAbs_of_nonpos (show x - 1 ≤ 0 by omega)
    unfold prev; split <;> omega
  · decide
  · left
    have a := Int.natAbs_of_nonneg (show 0 ≤ x by omega)
    have b := Int.natAbs_of_nonneg (show 0 ≤ x + 1 by omega)
    have c := Int.natAbs_of_nonneg (show 0 ≤ x - 1 by omega)
    unfold prev; split <;> omega

lemma plane_step (r t : ℕ) (x y : ℤ) (hr : r = 430) :
    plane (t + 1) x y = localRule r (plane t x y) (plane t (x - 1) y) (plane t (x + 1) y)
      (plane t x (y - 1)) (plane t x (y + 1)) := by
  unfold plane
  rw [(natural_law r t x.natAbs y.natAbs hr).2]
  unfold localRule
  rcases neighbors x with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rcases neighbors y with ⟨h3, h4⟩ | ⟨h3, h4⟩ <;>
    rw [h1, h2, h3, h4] <;> ac_rfl



def tag (k q : ℕ) := ([220, 1, 2].getD k 0 : ℕ).testBit q

def ord (x t : ℕ) : ℕ := if x < t then 0 else if x = t then 1 else 2

def nextOrd (k : ℕ) (x t : Bool) := if k = 1 then ord x.toNat t.toNat else k

lemma ord_digit (x t : ℕ) (b c : Bool) :
    ord (digit x b) (digit t c) = nextOrd (ord x t) b c := by
  rcases lt_trichotomy x t with h|h|h <;> cases b <;> cases c <;>
    simp (disch := omega) [nextOrd, ord, digit, *] <;> grind

lemma axis_cert : ∀ q : Fin 40, ∀ k : Fin 3, tag k q = true → ∀ b c : Bool,
    let q' := go q c b false
    let k' := nextOrd k b c
    tag k' q' = true ∧ q' < 40 ∧ lit q' = (decide (k' < 2) && (c || b || decide (k' = 1))) := by
  decide +kernel

lemma axis_inv (w t x : ℕ) (ht : t < 2^w) (hx : x < 2^w) :
    let q := address w t x 0
    let k := ord x t
    tag k q = true ∧ q < 40 ∧ lit q = decide (x ≤ t ∧ (t%2=1 ∨ x%2=1 ∨ x=t)) := by
  induction w generalizing t x with
  | zero =>
    have ht0 : t = 0 := by simpa using ht
    have hx0 : x = 0 := by simpa using hx
    subst t; subst x; decide
  | succ w ih =>
    rw [pow_succ] at ht hx
    obtain ⟨hv,hq,_⟩ := ih (t/2) (x/2) (by omega) (by omega)
    have hk : ord (x/2) (t/2) < 3 := by unfold ord; split_ifs <;> decide
    have hs := axis_cert ⟨_,hq⟩ ⟨_,hk⟩ hv (x%2 == 1) (t%2 == 1)
    have ho := ord_digit (x/2) (t/2) (x%2 == 1) (t%2 == 1)
    rw [decomposes, decomposes] at ho
    dsimp only at hs ⊢
    rw [←ho] at hs
    simp only [address, Nat.zero_div, Nat.zero_mod, Bool.false_eq_true] 
    refine ⟨hs.1,hs.2.1,hs.2.2.trans ?_⟩
    rcases lt_trichotomy x t with h|h|h <;> rcases Nat.mod_two_eq_zero_or_one x with hx'|hx' <;>
      rcases Nat.mod_two_eq_zero_or_one t with ht'|ht' <;> simp (disch := omega) [ord, *] <;> grind

lemma actual (t : ℕ) (x y : ℤ) : state t x y = plane t x y := by
  induction t generalizing x y with
  | zero => exact (plane_zero x y).symm
  | succ t ih => rw [plane_step 430 t x y rfl]; simp only [state, localRule, ih]

lemma axis (n j : ℕ) : state n j 0 = decide (j≤n ∧ (n%2=1 ∨ j%2=1 ∨ j=n)) := by
  rw [actual]; change value n j 0 = _
  apply (axis_inv _ _ _ _ _).2.2
  all_goals have h := @Nat.lt_two_pow_self (n+j+0+1); omega

lemma add_two (n : ℕ) : a (n+2) = a n + (if n%2=1 then (2:ℤ)^(n+2) else 0) + 2^(n+1) := by
  unfold a
  rw [Finset.sum_range_succ', Finset.sum_range_succ']
  have h (j : ℕ) : state (n+2) (↑(j+1+1) : ℤ) 0 = state n j 0 := by
    have he : (j+1+1 ≤ n+2 ∧ ((n+2)%2=1 ∨ (j+1+1)%2=1 ∨ j+1+1=n+2)) ↔
        (j≤n ∧ (n%2=1 ∨ j%2=1 ∨ j=n)) := by omega
    simp only [axis,he]
  simp only [h, show ∀ j : ℕ, n+2-(j+1+1)=n-j by omega, Nat.cast_zero, Nat.cast_one,
    show n+2-1=n+1 by omega, Nat.sub_zero]
  have h0 : state (n+2) 0 0 = decide (n%2=1) := by
    have h' := axis (n+2) 0
    have he : (0≤n+2 ∧ ((n+2)%2=1 ∨ 0%2=1 ∨ 0=n+2)) ↔ n%2=1 := by omega
    simpa only [he,Nat.cast_zero] using h'
  have h1 : state (n+2) 1 0 = true := by simpa using (axis (n+2) 1)
  simp only [Nat.zero_add,Nat.cast_one,h0,h1]
  split_ifs with hp <;> simp [hp] <;> ring

end Scale430
open OMA.S_oeis_a282124 PowerSeries

namespace Barker430

lemma pair (F : ℕ → ℤ) (init : F 0 = 1 ∧ F 1 = 3)
    (step : ∀ n, F (n+2) = F n + (if n%2=1 then (2:ℤ)^(n+2) else 0) + 2^(n+1))
    (k : ℕ) : 3*F (2*k) = 2*4^k+1 ∧ F (2*k+1) = 4*4^k-1 := by
  induction k with
  | zero => norm_num [init.1,init.2]
  | succ k ih =>
    rw [show 2*(k+1)=2*k+2 by omega,show 2*k+2+1=(2*k+1)+2 by omega,step,step]
    simp only [show (2*k)%2=0 by omega,show (2*k+1)%2=1 by omega, ↓reduceIte]
    simp only [pow_add,pow_mul,pow_succ (4:ℤ) k]
    norm_num
    constructor <;> linarith only [ih.1,ih.2]

lemma jac (k : ℕ) :
    3*a001045 (2*k+1) = 2*4^k+1 ∧ 3*a001045 (2*k+2) = 4*4^k-1 := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [show 2*(k+1)+1=(2*k+1)+2 by omega,show 2*(k+1)+2=(2*k+2)+2 by omega]
    have h3 : a001045 ((2*k+1)+2) = a001045 (2*k+2)+2*a001045 (2*k+1) := rfl
    have h4 : a001045 ((2*k+2)+2) = a001045 ((2*k+1)+2)+2*a001045 (2*k+2) := rfl
    rw [h4,h3,pow_succ]; constructor <;> linarith only [ih.1,ih.2]

lemma trace_step (n : ℕ) : a098646 (n+2) = 4*a098646 n := by
  have sq : krawtchouk ^ 2 = (4:ℤ) • (1 : Matrix (Fin 3) (Fin 3) ℤ) := by decide
  rw [a098646,pow_add,sq,Matrix.mul_smul,Matrix.mul_one,Matrix.trace_smul]
  rfl

lemma trace_pair (k : ℕ) : a098646 (2*k) = 3*4^k ∧ a098646 (2*k+1) = 2*4^k := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [show 2*(k+1)=2*k+2 by omega,show 2*k+2+1=(2*k+1)+2 by omega,trace_step,trace_step,
      ih.1,ih.2,pow_succ]; constructor <;> ring

lemma parity (n : ℕ) : ∃ k, n=2*k ∨ n=2*k+1 := ⟨n/2,by omega⟩

lemma recurrence (F : ℕ → ℤ)
    (h : ∀ k, 3*F (2*k) = 2*4^k+1 ∧ F (2*k+1) = 4*4^k-1)
    (n : ℕ) (hn : 3<n) : F n = 5*F (n-2)-4*F (n-4) := by
  obtain ⟨k,hk|hk⟩ := parity (n-4)
  · have h2 := (h (k+2)).1
    have h1 := (h (k+1)).1
    rw [show 2*(k+2)=n by omega,pow_add] at h2
    rw [show 2*(k+1)=n-2 by omega,pow_succ] at h1
    rw [hk]; linarith only [h2,h1,(h k).1]
  · have h2 := (h (k+2)).2
    have h1 := (h (k+1)).2
    rw [show 2*(k+2)+1=n by omega,pow_add] at h2
    rw [show 2*(k+1)+1=n-2 by omega,pow_succ] at h1
    rw [hk]; linarith only [h2,h1,(h k).2]

lemma gf (F : ℕ → ℤ) (hr : ∀ n, 3<n → F n = 5*F (n-2)-4*F (n-4))
    (h0 : F 0=1) (h1 : F 1=3) (h2 : F 2=3) (h3 : F 3=15) :
    mk F * ((1-X)*(1+X)*(1-2*X)*(1+2*X)) = 1+3*X-2*X^2 := by
  suffices hs : mk F * X^0 + (-5:ℤ) • (mk F*X^2) + (4:ℤ) • (mk F*X^4) =
      X^0 + (3:ℤ) • (X^1) + (-2:ℤ) • (X^2) by
    simp only [zsmul_eq_mul] at hs
    linear_combination hs
  ext n
  simp only [map_add,map_zsmul,coeff_mul_X_pow',coeff_X_pow,coeff_mk]
  by_cases hn : 3<n
  · simp only [if_pos (show 0≤n by omega), if_pos (show 2≤n by omega), if_pos (show 4≤n by omega),
      if_neg (show n≠0 by omega), if_neg (show n≠1 by omega), if_neg (show n≠2 by omega),
      Nat.sub_zero,zsmul_eq_mul]
    norm_num
    linarith only [hr n hn]
  · interval_cases n <;> norm_num [zsmul_eq_mul,h0,h1,h2,h3]

lemma formulas (F : ℕ → ℤ)
    (h : ∀ k, 3*F (2*k) = 2*4^k+1 ∧ F (2*k+1) = 4*4^k-1) :
    (∀ n : ℕ, (F n : ℚ) = ((-1) + 2 * (-1) ^ n - (-1) ^ n * 2 ^ (1 + n) + 2 ^ (2 + n)) / 3) ∧
    (∀ n : ℕ, F n = a001045 (n+1) * (if Even n then 1 else 3)) ∧
    (∀ n : ℕ, F (n+4) = F n + 10*a081631 n) ∧
    (∀ n : ℕ, F (2*n+1) = 2^(2*n+2)-1) ∧
    (∀ n : ℕ, F (n+2) = F n + a098646 (n+1)) := by
  refine ⟨?_,?_,?_,?_,?_⟩
  · intro n
    obtain ⟨k,rfl|rfl⟩ := parity n
    · have hq : 3*(F (2*k):ℚ) = 2*4^k+1 := by exact_mod_cast (h k).1
      simp only [pow_add,pow_mul]; norm_num; linarith
    · have hq : (F (2*k+1):ℚ) = 4*4^k-1 := by exact_mod_cast (h k).2
      simp only [pow_add,pow_mul]; norm_num; linarith
  · intro n
    obtain ⟨k,rfl|rfl⟩ := parity n
    · simp only [even_two_mul, ↓reduceIte,mul_one]; linarith only [(h k).1,(jac k).1]
    · simp only [Nat.not_even_iff_odd.mpr (by exact ⟨k,by omega⟩ : Odd (2*k+1)), ↓reduceIte]
      linarith only [(h k).2,(jac k).2]
  · intro n
    obtain ⟨k,rfl|rfl⟩ := parity n
    · have hp := (h (k+2)).1
      rw [show 2*(k+2)=2*k+4 by omega,pow_add] at hp
      simp only [a081631,pow_mul]; norm_num; linarith only [hp,(h k).1]
    · have hp := (h (k+2)).2
      rw [show 2*(k+2)+1=2*k+1+4 by omega,pow_add] at hp
      simp only [a081631,pow_add,pow_mul]; norm_num; linarith only [hp,(h k).2]
  · intro n; rw [(h n).2,pow_add,pow_mul]; ring
  · intro n
    obtain ⟨k,rfl|rfl⟩ := parity n
    · have hp := (h (k+1)).1
      rw [show 2*(k+1)=2*k+2 by omega,pow_succ] at hp
      rw [(trace_pair k).2]; linarith only [hp,(h k).1]
    · have hp := (h (k+1)).2
      rw [show 2*(k+1)+1=2*k+1+2 by omega,pow_succ] at hp
      rw [show 2*k+1+1=2*(k+1) by omega,(trace_pair _).1,pow_succ]
      linarith only [hp,(h k).2]

end Barker430

theorem OMA.solution : type_of% @OMA.S_oeis_a282124.main := by
  have h := Barker430.pair a (by decide) Scale430.add_two
  obtain ⟨f,j,c,o,t⟩ := Barker430.formulas a h
  exact ⟨f, Barker430.recurrence a h, Barker430.gf a (Barker430.recurrence a h) (by decide) (by decide) (by decide) (by decide), j, c, o, t⟩
