/-!
# The shallow part of the tree: `n < 8`, and words of length at most `9` for every `n`

`T w j` is the triple reached from the root `(j, j + 1, 2 j² + 2 j - 1)` by the word `w`.

* For a fixed `n < 8`: the top entry of `T w j` is increasing in `j` and does not decrease when
  the word is extended, so one bracket `z_w(j) < a n < z_w(j + 1)` per word with `z_w(2) ≤ a n`
  excludes `a n` (`chk`, `chk_sound`, `cert0` … `cert7`).
* For all `n ≥ 8` at once: modulo each prime `q` of the table `P`, `a n` is periodic in `n` with
  period dividing `6` (`per`), and the top entry of `T w j` only depends on `j` modulo `q`
  (`T_cong`). For each of the 1023 words of length at most `9` the hints name primes `q` and
  classes `r` of `n - 8` modulo `6` such that `a n` is not a value of the top entry modulo `q`
  (`okw`, `cov`). The first case is `a n ≡ 5 (mod 7)`, where `2·5 + 3` is not a square.
-/

namespace OMA.A144743Cover
open OMA.S_oeis_a144743

/-- The two upward moves on a sorted triple. -/
def step (b : Bool) (t : ℤ × ℤ × ℤ) : ℤ × ℤ × ℤ :=
  if b then (t.1, t.2.2, 2 * t.1 * t.2.2 - t.2.1) else (t.2.1, t.2.2, 2 * t.2.1 * t.2.2 - t.1)

/-- The triple reached from the root `j` by the word `w` (last move first). -/
def T : List Bool → ℤ → ℤ × ℤ × ℤ
  | [], j => (j, j + 1, 2 * j * j + 2 * j - 1)
  | b :: w, j => step b (T w j)

theorem ord (w : List Bool) (j : ℤ) (hj : 1 ≤ j) :
    1 ≤ (T w j).1 ∧ (T w j).1 ≤ (T w j).2.1 ∧ (T w j).2.1 ≤ (T w j).2.2 := by
  induction w with
  | nil => simp only [T]; refine ⟨hj, by linarith, by nlinarith⟩
  | cons b w ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    cases b
    · simp only [T, step, Bool.false_eq_true, if_false]
      refine ⟨by linarith, h3, ?_⟩
      nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ (T w j).2.1 - 1)
        (by linarith : (0 : ℤ) ≤ (T w j).2.2)]
    · simp only [T, step, if_true]
      refine ⟨h1, by linarith, ?_⟩
      nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ (T w j).1 - 1)
        (by linarith : (0 : ℤ) ≤ (T w j).2.2)]

theorem mono (w : List Bool) (j j' : ℤ) (hj : 1 ≤ j) (hjj : j ≤ j') :
    j' - j ≤ (T w j').1 - (T w j).1 ∧
    (T w j').1 - (T w j).1 ≤ (T w j').2.1 - (T w j).2.1 ∧
    (T w j').2.1 - (T w j).2.1 ≤ (T w j').2.2 - (T w j).2.2 := by
  induction w with
  | nil =>
    simp only [T]
    refine ⟨by linarith, by linarith, ?_⟩
    nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ j' - j) (by linarith : (0 : ℤ) ≤ j' + j)]
  | cons b w ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    obtain ⟨a1, a2, a3⟩ := ord w j hj
    obtain ⟨b1, b2, b3⟩ := ord w j' (by linarith)
    cases b
    · simp only [T, step, Bool.false_eq_true, if_false]
      refine ⟨by linarith, h3, ?_⟩
      nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ (T w j').2.1 - 1)
          (by linarith : (0 : ℤ) ≤ (T w j').2.2 - (T w j).2.2),
        mul_nonneg (by linarith : (0 : ℤ) ≤ (T w j).2.2)
          (by linarith : (0 : ℤ) ≤ (T w j').2.1 - (T w j).2.1)]
    · simp only [T, step, if_true]
      refine ⟨h1, by linarith, ?_⟩
      nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ (T w j').1 - 1)
          (by linarith : (0 : ℤ) ≤ (T w j').2.2 - (T w j).2.2),
        mul_nonneg (by linarith : (0 : ℤ) ≤ (T w j).2.2)
          (by linarith : (0 : ℤ) ≤ (T w j').1 - (T w j).1)]

theorem z_mono (w : List Bool) (j j' : ℤ) (hj : 1 ≤ j) (hjj : j ≤ j') :
    (T w j).2.2 ≤ (T w j').2.2 := by
  obtain ⟨h1, h2, h3⟩ := mono w j j' hj hjj
  linarith

theorem ext (u w : List Bool) (j : ℤ) (hj : 1 ≤ j) : (T w j).2.2 ≤ (T (u ++ w) j).2.2 := by
  induction u with
  | nil => simp
  | cons b u ih =>
    obtain ⟨h1, h2, h3⟩ := ord (u ++ w) j hj
    refine le_trans ih ?_
    cases b
    · simp only [List.cons_append, T, step, Bool.false_eq_true, if_false]
      nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ (T (u ++ w) j).2.1 - 1)
        (by linarith : (0 : ℤ) ≤ (T (u ++ w) j).2.2)]
    · simp only [List.cons_append, T, step, if_true]
      nlinarith [mul_nonneg (by linarith : (0 : ℤ) ≤ (T (u ++ w) j).1 - 1)
        (by linarith : (0 : ℤ) ≤ (T (u ++ w) j).2.2)]

/-- The certificate checker: walk the tree of words, pruning when `z_w(2) > A` and otherwise
reading a bracket `j` from the hint list. -/
def chk (A : ℤ) : ℕ → List Bool → List ℤ → Option (List ℤ)
  | 0, _, _ => none
  | fuel + 1, w, hs =>
    if A < (T w 2).2.2 then some hs
    else match hs with
      | [] => none
      | j :: hs' =>
        if 2 ≤ j ∧ (T w j).2.2 < A ∧ A < (T w (j + 1)).2.2 then
          (chk A fuel (false :: w) hs').bind (chk A fuel (true :: w))
        else none

theorem chk_sound (A : ℤ) : ∀ (fuel : ℕ) (w : List Bool) (hs hs' : List ℤ),
    chk A fuel w hs = some hs' → ∀ (u : List Bool) (j : ℤ), 2 ≤ j → (T (u ++ w) j).2.2 ≠ A := by
  intro fuel
  induction fuel with
  | zero => intro w hs hs' h; simp [chk] at h
  | succ fuel ih =>
    intro w hs hs' h u j hj
    unfold chk at h
    split_ifs at h with hprune
    · have h1 := ext u w j (by linarith)
      have h2 := z_mono w 2 j (by norm_num) hj
      intro heq
      linarith
    · cases hs with
      | nil => simp at h
      | cons j0 hs0 =>
        simp only at h
        split_ifs at h with hbr
        obtain ⟨hj0, hlo, hhi⟩ := hbr
        obtain ⟨hs1, hf, ht⟩ := Option.bind_eq_some_iff.mp h
        rcases List.eq_nil_or_concat u with rfl | ⟨u', b, rfl⟩
        · simp only [List.nil_append]
          intro heq
          rcases le_or_gt j j0 with hle | hgt
          · have := z_mono w j j0 (by linarith) hle
            linarith
          · have := z_mono w (j0 + 1) j (by linarith) (by linarith)
            linarith
        · have e : u'.concat b ++ w = u' ++ (b :: w) := by simp
          rw [e]
          cases b
          · exact ih _ _ _ hf u' j hj
          · exact ih _ _ _ ht u' j hj


theorem T_eq_foldr (w : List Bool) (j : ℤ) :
    T w j = w.foldr (fun b t => if b then (t.1, t.2.2, 2 * t.1 * t.2.2 - t.2.1)
        else (t.2.1, t.2.2, 2 * t.2.1 * t.2.2 - t.1))
      ((j, j + 1, 2 * j * j + 2 * j - 1) : ℤ × ℤ × ℤ) := by
  induction w with
  | nil => rfl
  | cons b w ih => simp only [T, step, List.foldr_cons, ih]

