/-- The entries of a triple only depend on `j` modulo `q`. -/
theorem T_cong (q : ℤ) (w : List Bool) (j j' : ℤ) (h : j ≡ j' [ZMOD q]) :
    (T w j).1 ≡ (T w j').1 [ZMOD q] ∧ (T w j).2.1 ≡ (T w j').2.1 [ZMOD q] ∧
      (T w j).2.2 ≡ (T w j').2.2 [ZMOD q] := by
  induction w with
  | nil =>
    simp only [T]
    exact ⟨h, h.add_right 1,
      ((((Int.ModEq.refl 2).mul h).mul h).add ((Int.ModEq.refl 2).mul h)).sub_right 1⟩
  | cons b w ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    cases b
    · simp only [T, step, Bool.false_eq_true, if_false]
      exact ⟨h2, h3, (((Int.ModEq.refl 2).mul h2).mul h3).sub h1⟩
    · simp only [T, step, if_true]
      exact ⟨h1, h3, (((Int.ModEq.refl 2).mul h1).mul h3).sub h2⟩

/-- Periodicity of `a n` modulo `q` from a table of six residues. -/
theorem per (q : ℤ) (tbl : List ℤ) (h0 : a 8 % q = tbl.getD 0 0)
    (hstep : ∀ i < 6, ((tbl.getD i 0) ^ 2 - tbl.getD i 0 - 1) % q = tbl.getD ((i + 1) % 6) 0) :
    ∀ m : ℕ, a (8 + m) % q = tbl.getD (m % 6) 0 := by
  intro m
  induction m with
  | zero => simpa using h0
  | succ m ih =>
    have e : a (8 + (m + 1)) = a (8 + m) ^ 2 - a (8 + m) - 1 := rfl
    have hc : (a (8 + m) % q) ^ 2 - a (8 + m) % q - 1 ≡ a (8 + m) ^ 2 - a (8 + m) - 1 [ZMOD q] :=
      (((Int.mod_modEq (a (8 + m)) q).pow 2).sub (Int.mod_modEq (a (8 + m)) q)).sub_right 1
    rw [e, ← hc, ih, hstep (m % 6) (Nat.mod_lt _ (by norm_num))]
    congr 1
    omega

/-- The primes used, each with the residues of `a 8, …, a 13`. -/
def P : List (ℤ × List ℤ) := [(3, [1, 2, 1, 2, 1, 2]), (5, [4, 1, 4, 1, 4, 1]), (7, [5, 5, 5, 5, 5, 5]), (11, [10, 1, 10, 1, 10, 1]), (13, [6, 3, 5, 6, 3, 5]), (17, [16, 1, 16, 1, 16, 1]), (19, [1, 18, 1, 18, 1, 18]), (23, [19, 19, 19, 19, 19, 19]), (29, [11, 22, 26, 11, 22, 26]), (31, [30, 1, 30, 1, 30, 1]), (41, [1, 40, 1, 40, 1, 40]), (43, [1, 42, 1, 42, 1, 42]), (47, [19, 12, 37, 15, 21, 43]), (61, [15, 26, 39, 17, 27, 30]), (71, [19, 57, 67, 19, 57, 67]), (89, [1, 88, 1, 88, 1, 88]), (97, [56, 72, 67, 56, 72, 67]), (113, [1, 112, 1, 112, 1, 112]), (139, [35, 77, 13, 16, 100, 30]), (151, [106, 106, 106, 106, 106, 106]), (191, [190, 1, 190, 1, 190, 1]), (211, [193, 130, 100, 193, 130, 100]), (223, [209, 209, 209, 209, 209, 209]), (353, [19, 341, 155, 218, 3, 5]), (359, [341, 341, 341, 341, 341, 341])]

def good (p : ℤ × List ℤ) : Bool :=
  decide (0 < p.1) && decide (a 8 % p.1 = p.2.getD 0 0) &&
    (List.range 6).all (fun i =>
      decide (((p.2.getD i 0) ^ 2 - p.2.getD i 0 - 1) % p.1 = p.2.getD ((i + 1) % 6) 0))

theorem allgood : P.all good = true := by decide +kernel

/-- A word is covered by hints `(index into P, classes of (n - 8) mod 6)`. -/
def okw (w : List Bool) (h : List (ℕ × List ℕ)) : Bool :=
  (List.range 6).all (fun r => h.any (fun e => e.2.contains r)) &&
  h.all (fun e => match P[e.1]? with
    | none => false
    | some p => (List.range p.1.toNat).all (fun j0 =>
        e.2.all (fun r => (T w (j0 : ℤ)).2.2 % p.1 != p.2.getD r 0)))

theorem okw_sound (w : List Bool) (h : List (ℕ × List ℕ)) (hok : okw w h = true)
    (n : ℕ) (hn : 8 ≤ n) (j : ℤ) : (T w j).2.2 ≠ a n := by
  intro heq
  simp only [okw, Bool.and_eq_true, List.all_eq_true, List.any_eq_true, List.mem_range] at hok
  obtain ⟨hcov, heach⟩ := hok
  obtain ⟨m, rfl⟩ : ∃ m, n = 8 + m := ⟨n - 8, by omega⟩
  obtain ⟨e, he, hr⟩ := hcov (m % 6) (Nat.mod_lt _ (by norm_num))
  have h1 := heach e he
  cases hp : P[e.1]? with
  | none => simp [hp] at h1
  | some p =>
    simp only [hp, List.all_eq_true, List.mem_range, bne_iff_ne, ne_eq] at h1
    have hpm : p ∈ P := List.mem_of_getElem? hp
    have hg := List.all_eq_true.mp allgood p hpm
    simp only [good, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at hg
    obtain ⟨⟨hq, h0⟩, hstep⟩ := hg
    have htab := per p.1 p.2 h0 hstep m
    have hj0 : (j % p.1).toNat < p.1.toNat :=
      (Int.toNat_lt_toNat hq).mpr (Int.emod_lt_of_pos j hq)
    have hcast : ((j % p.1).toNat : ℤ) = j % p.1 :=
      Int.toNat_of_nonneg (Int.emod_nonneg j hq.ne')
    have hc := (T_cong p.1 w j ((j % p.1).toNat : ℤ)
      (by rw [hcast]; exact (Int.mod_modEq j p.1).symm)).2.2
    have hmem : m % 6 ∈ e.2 := by simpa using hr
    apply h1 _ hj0 (m % 6) hmem
    rw [← htab, ← heq]
    exact hc.symm

/-- Walk all words of length at most `d` above `w`, one hint per word. -/
def cov : ℕ → List Bool → List (List (ℕ × List ℕ)) → Option (List (List (ℕ × List ℕ)))
  | _, _, [] => none
  | 0, w, h :: hs => if okw w h then some hs else none
  | d + 1, w, h :: hs =>
    if okw w h then (cov d (false :: w) hs).bind (cov d (true :: w)) else none

theorem cov_sound : ∀ (d : ℕ) (w : List Bool) (hs hs' : List (List (ℕ × List ℕ))),
    cov d w hs = some hs' → ∀ (u : List Bool), u.length ≤ d →
      ∀ (n : ℕ), 8 ≤ n → ∀ j : ℤ, (T (u ++ w) j).2.2 ≠ a n := by
  intro d
  induction d with
  | zero =>
    intro w hs hs' h u hu n hn j
    have hu0 : u = [] := List.eq_nil_of_length_eq_zero (Nat.le_zero.mp hu)
    subst hu0
    cases hs with
    | nil => simp [cov] at h
    | cons h0 hs0 =>
      simp only [cov] at h
      split_ifs at h with hok
      simpa using okw_sound w h0 hok n hn j
  | succ d ih =>
    intro w hs hs' h u hu n hn j
    cases hs with
    | nil => simp [cov] at h
    | cons h0 hs0 =>
      simp only [cov] at h
      split_ifs at h with hok
      obtain ⟨hs1, hf, ht⟩ := Option.bind_eq_some_iff.mp h
      rcases List.eq_nil_or_concat u with rfl | ⟨u', b, rfl⟩
      · simpa using okw_sound w h0 hok n hn j
      · have e : u'.concat b ++ w = u' ++ (b :: w) := by simp
        have hu' : u'.length ≤ d := by
          simp only [List.concat_eq_append, List.length_append, List.length_cons,
            List.length_nil] at hu
          omega
        rw [e]
        cases b
        · exact ih _ _ _ hf u' hu' n hn j
        · exact ih _ _ _ ht u' hu' n hn j

