lemma S_sq : S * S = R := by
  have := bs_sq (R - 1) (by simp [R])
  unfold S; rw [this]; ring

noncomputable def DD : PowerSeries ℚ := 2 - 6 * X + 2 * X ^ 2 - 2 * X ^ 3 + 6 * X ^ 4 - 2 * X ^ 5
noncomputable def NN : PowerSeries ℚ := -1 + 2 * X + X ^ 2 + 2 * X ^ 3 - X ^ 4 + (1 - X - X ^ 2) * S
noncomputable def AA : PowerSeries ℚ := NN * DD⁻¹

lemma hA : AA * DD = NN := by
  unfold AA
  rw [mul_assoc, PowerSeries.inv_mul_cancel _ (by simp [DD]), mul_one]

lemma hdD : derivative ℚ DD = -10*X^4 + 24*X^3 - 6*X^2 + 4*X - 6 := by
  simp [DD] <;> ring
lemma hdR : derivative ℚ R = 4*X^3 - 6*X^2 - 2*X - 2 := by
  simp [R] <;> ring
lemma hdN : derivative ℚ NN = -4*X^3 + 6*X^2 + 2*X + 2 + (-2*X - 1) * S + (-X^2 - X + 1) * derivative ℚ S := by
  simp [NN] <;> ring

lemma ode : ((-1) * X ^ 1 + (3) * X ^ 2 + (-6) * X ^ 3 + (7) * X ^ 4 + (-8) * X ^ 5 + (1) * X ^ 6 + (1) * X ^ 7) * AA + ((1) * X ^ 1 + (-4) * X ^ 2 + (3) * X ^ 3 + (1) * X ^ 4 + (3) * X ^ 5 + (-3) * X ^ 6 + (-2) * X ^ 7 + (1) * X ^ 8) * derivative ℚ AA = ((3) * X ^ 3 + (-1) * X ^ 4 + (1) * X ^ 5 : PowerSeries ℚ) := by
  have r1 := hA
  have r2 : derivative ℚ AA * DD + AA * derivative ℚ DD = derivative ℚ NN := by
    have := congrArg (derivative ℚ) hA
    rw [Derivation.leibniz] at this
    simp only [smul_eq_mul] at this
    rw [← this]; ring
  have r4 := sqrt_ode S R S_sq
  have hK : (2 * R * DD ^ 2 : PowerSeries ℚ) ≠ 0 := by
    intro h
    have := congrArg constantCoeff h
    simp [R, DD] at this
  apply mul_left_cancel₀ hK
  rw [hdD, hdN] at r2
  rw [hdR] at r4
  unfold NN at r1
  unfold DD at r1 r2
  unfold R at r4
  unfold DD R
  linear_combination (16*X^16 - 112*X^15 + 232*X^14 - 80*X^13 - 8*X^12 - 408*X^11 + 120*X^10 + 424*X^9 + 72*X^8 - 56*X^7 - 376*X^6 + 152*X^5 - 8*X^4 + 72*X^3 - 48*X^2 + 8*X) * r1 + (-4*X^17 + 28*X^16 - 52*X^15 - 16*X^14 + 68*X^13 + 44*X^12 + 112*X^11 - 372*X^10 + 184*X^9 - 196*X^8 + 432*X^7 - 292*X^6 + 140*X^5 - 160*X^4 + 116*X^3 - 36*X^2 + 4*X) * r2 + (2*X^15 - 8*X^14 - 4*X^13 + 36*X^12 - 2*X^11 - 32*X^10 - 34*X^9 + 12*X^8 + 78*X^7 - 48*X^6 + 14*X^5 - 44*X^4 + 44*X^3 - 16*X^2 + 2*X) * r4

lemma ha (n : ℕ) : a n = coeff (n + 0) AA := rfl

lemma rec_a (k : ℕ) : (((k + 7 : ℕ) : ℚ)) * a (k + 7) + (3 - 4*((k + 7 : ℕ) : ℚ)) * a (k + 6) + (3*((k + 7 : ℕ) : ℚ) - 3) * a (k + 5) + (((k + 7 : ℕ) : ℚ) - 9) * a (k + 4) + (3*((k + 7 : ℕ) : ℚ) - 5) * a (k + 3) + (7 - 3*((k + 7 : ℕ) : ℚ)) * a (k + 2) + (13 - 2*((k + 7 : ℕ) : ℚ)) * a (k + 1) + (((k + 7 : ℕ) : ℚ) - 6) * a (k + 0) = 0 := by
  have h := congrArg (coeff (k + 7)) ode
  rcases k with _ | k
  all_goals
    simp only [add_mul, sub_mul, neg_mul, one_mul, map_add, map_sub, map_neg, mul_assoc, cm2, cm3, cm4, cm5, cm6, cm7, cm8, cm9, cm10, cm13, cm24, coeff_X_pow_mul', coeff_derivative] at h
    simp [PowerSeries.coeff_X] at h
    simp only [ha]
    simp only [Nat.add_assoc, Nat.reduceAdd, Nat.add_zero, Nat.zero_add] at h ⊢
    push_cast at h ⊢
    try simp only [PowerSeries.coeff_zero_eq_constantCoeff_apply] at h ⊢
    linear_combination h

end OMA.S_oeis_a166287

theorem OMA.solution : type_of% @OMA.S_oeis_a166287.main := by
  intro n hn
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 7 := ⟨n - 7, by omega⟩
  simp only [show k + 7 - 1 = k + 6 from by omega, show k + 7 - 2 = k + 5 from by omega, show k + 7 - 3 = k + 4 from by omega, show k + 7 - 4 = k + 3 from by omega, show k + 7 - 5 = k + 2 from by omega, show k + 7 - 6 = k + 1 from by omega, show k + 7 - 7 = k + 0 from by omega]
  have h := OMA.S_oeis_a166287.rec_a k
  push_cast at h ⊢
  linear_combination h
