import OMAStatements.S_oeis_a069755

open OMA.S_oeis_a069755

/-- Coprimality from an explicit Bezout identity over the integers. -/
theorem bc69_cop (a b : ℕ) (u v : ℤ) (h : u * (a : ℤ) + v * (b : ℤ) = 1) : Nat.Coprime a b :=
  Nat.isCoprime_iff_coprime.mp ⟨u, v, h⟩

/-- Every element of the additive closure of three numbers is a combination of them. -/
theorem bc69_mem3 (x y z w : ℕ) (hw : w ∈ AddSubmonoid.closure ({x, y, z} : Set ℕ)) :
    ∃ a b c : ℕ, a * x + b * y + c * z = w := by
  refine AddSubmonoid.closure_induction
    (motive := fun w _ => ∃ a b c : ℕ, a * x + b * y + c * z = w) ?_ ?_ ?_ hw
  · intro w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    rcases hw with h | h | h
    · exact ⟨1, 0, 0, by rw [h]; ring⟩
    · exact ⟨0, 1, 0, by rw [h]; ring⟩
    · exact ⟨0, 0, 1, by rw [h]; ring⟩
  · exact ⟨0, 0, 0, by ring⟩
  · intro u v _ _ hu hv
    obtain ⟨a, b, c, hu⟩ := hu
    obtain ⟨a', b', c', hv⟩ := hv
    exact ⟨a + a', b + b', c + c', by rw [← hu, ← hv]; ring⟩

/-- Gluing a two-generator semigroup with Frobenius number `F1`, scaled by `e + 1`,
with one more generator `D` of that semigroup, coprime to `e + 1`. -/
theorem bc69_glue (p q e D F1 : ℕ) (hF1 : FrobeniusNumber F1 {p, q})
    (hD : D ∈ AddSubmonoid.closure ({p, q} : Set ℕ))
    (hcop : Nat.Coprime (e + 1) D) :
    FrobeniusNumber ((e + 1) * F1 + e * D) {(e + 1) * p, (e + 1) * q, D} := by
  rw [frobeniusNumber_iff] at hF1 ⊢
  obtain ⟨hF1n, hF1k⟩ := hF1
  have pair_mem : ∀ a b : ℕ, a * p + b * q ∈ AddSubmonoid.closure ({p, q} : Set ℕ) := by
    intro a b
    refine (AddSubmonoid.mem_closure_pair p q _).mpr ⟨a, b, ?_⟩
    simp only [smul_eq_mul]
  constructor
  · intro hmem
    obtain ⟨a, b, c, h⟩ := bc69_mem3 _ _ _ _ hmem
    have h2 : (e + 1) * (a * p + b * q) + (c + 1) * D = (e + 1) * (F1 + D) := by
      zify at h ⊢
      linear_combination h
    have hdvd : (e + 1) ∣ (c + 1) * D := by
      have h3 : (e + 1) ∣ (e + 1) * (a * p + b * q) + (c + 1) * D := by
        rw [h2]
        exact dvd_mul_right _ _
      exact (Nat.dvd_add_right (dvd_mul_right _ _)).mp h3
    obtain ⟨t, ht⟩ := hcop.dvd_of_dvd_mul_right hdvd
    have h4 : a * p + b * q + t * D = F1 + D := by
      have h5 : (e + 1) * (a * p + b * q + t * D) = (e + 1) * (F1 + D) := by
        rw [← h2, ht]
        ring
      exact Nat.eq_of_mul_eq_mul_left (by omega) h5
    have ht0 : t ≠ 0 := by
      rintro rfl
      rw [mul_zero] at ht
      omega
    obtain ⟨s, rfl⟩ : ∃ s, t = s + 1 := ⟨t - 1, by omega⟩
    have h6 : a * p + b * q + s * D = F1 := by
      have h7 : (s + 1) * D = s * D + D := by ring
      omega
    apply hF1n
    rw [← h6]
    have hs : s • D ∈ AddSubmonoid.closure ({p, q} : Set ℕ) := nsmul_mem hD s
    rw [smul_eq_mul] at hs
    exact add_mem (pair_mem a b) hs
  · intro k hk
    obtain ⟨c, hc, hcm⟩ := Nat.exists_mul_mod_eq_of_coprime k hcop.symm (by omega : e + 1 ≠ 0)
    have hcD : D * c ≤ e * D := by
      rw [mul_comm D c]
      exact Nat.mul_le_mul_right D (by omega)
    have hle : D * c ≤ k := by omega
    have hcm' : D * c ≡ k [MOD e + 1] := hcm
    obtain ⟨y, hy⟩ := (Nat.modEq_iff_dvd' hle).mp hcm'
    have hk2 : k = (e + 1) * y + D * c := by omega
    have hy2 : F1 < y := by
      by_contra hcon
      have h8 : (e + 1) * y ≤ (e + 1) * F1 := Nat.mul_le_mul_left _ (not_lt.mp hcon)
      omega
    obtain ⟨a, b, hab⟩ := (AddSubmonoid.mem_closure_pair p q y).mp (hF1k y hy2)
    have m1 : (e + 1) * p ∈ AddSubmonoid.closure ({(e + 1) * p, (e + 1) * q, D} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    have m2 : (e + 1) * q ∈ AddSubmonoid.closure ({(e + 1) * p, (e + 1) * q, D} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    have m3 : D ∈ AddSubmonoid.closure ({(e + 1) * p, (e + 1) * q, D} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    have key : k = a • ((e + 1) * p) + b • ((e + 1) * q) + c • D := by
      rw [hk2, ← hab]
      simp only [smul_eq_mul]
      ring
    rw [key]
    exact add_mem (add_mem (nsmul_mem m1 a) (nsmul_mem m2 b)) (nsmul_mem m3 c)

/-- Evaluating `f` from an exact multiple of eight. -/
theorem bc69_fval (n : ℕ) (F : ℤ)
    (h : -14 + 6 * (-1 : ℤ) ^ n + (3 + 9 * (-1 : ℤ) ^ n) * (n : ℤ) +
      3 * (5 + (-1 : ℤ) ^ n) * (n : ℤ) ^ 2 + 6 * (n : ℤ) ^ 3 = 8 * F) :
    f n = F := by
  have h2 : f n = (8 * F) / 8 := by
    unfold OMA.S_oeis_a069755.f
    exact congrArg (fun x : ℤ => x / 8) h
  rw [h2]
  exact Int.mul_ediv_cancel_left F (by norm_num)

/-- The case `n = 2`: the semigroup generated by `3, 6, 10`. -/
theorem bc69_two :
    FrobeniusNumber (f (2 * 1)).toNat {T (2 * 1), T (2 * 1 + 1), T (2 * 1 + 2)} := by
  have h1 : (f (2 * 1)).toNat = 3 * 10 - 3 - 10 := by
    rw [bc69_fval (2 * 1) 17 (by norm_num)]
    first
      | rfl
      | decide
      | norm_num
  have h2 : T (2 * 1) = 3 := by rfl
  have h3 : T (2 * 1 + 1) = 6 := by rfl
  have h4 : T (2 * 1 + 2) = 10 := by rfl
  rw [h1, h2, h3, h4]
  have hc : AddSubmonoid.closure ({3, 6, 10} : Set ℕ) =
      AddSubmonoid.closure ({3, 10} : Set ℕ) := by
    apply le_antisymm
    · rw [AddSubmonoid.closure_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      have h3m : (3 : ℕ) ∈ AddSubmonoid.closure ({3, 10} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      have h10m : (10 : ℕ) ∈ AddSubmonoid.closure ({3, 10} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      have h6m : (6 : ℕ) ∈ AddSubmonoid.closure ({3, 10} : Set ℕ) := by
        have h := nsmul_mem h3m 2
        rw [smul_eq_mul] at h
        exact h
      rcases hx with h | h | h
      · rw [h]; exact h3m
      · rw [h]; exact h6m
      · rw [h]; exact h10m
    · apply AddSubmonoid.closure_mono
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
      omega
  have hp := frobeniusNumber_pair (m := 3) (n := 10) (bc69_cop 3 10 (-3) 1 (by norm_num))
    (by norm_num) (by norm_num)
  rw [frobeniusNumber_iff] at hp ⊢
  rw [hc]
  exact hp

/-- Even `n = 2 (j + 2)`: glue `(2j+5) * <j+2, j+3>` with `(j+3)(2j+7)`. -/
theorem bc69_even (j : ℕ) :
    FrobeniusNumber (f (2 * (j + 2))).toNat
      {T (2 * (j + 2)), T (2 * (j + 2) + 1), T (2 * (j + 2) + 2)} := by
  have hT0 : T (2 * (j + 2)) = (2 * j + 4 + 1) * (j + 2) := by
    unfold OMA.S_oeis_a069755.T
    exact Nat.div_eq_of_eq_mul_left (by norm_num) (by ring)
  have hT1 : T (2 * (j + 2) + 1) = (2 * j + 4 + 1) * (j + 3) := by
    unfold OMA.S_oeis_a069755.T
    exact Nat.div_eq_of_eq_mul_left (by norm_num) (by ring)
  have hT2 : T (2 * (j + 2) + 2) = (j + 3) * (2 * j + 7) := by
    unfold OMA.S_oeis_a069755.T
    exact Nat.div_eq_of_eq_mul_left (by norm_num) (by ring)
  have hneg : (-1 : ℤ) ^ (2 * (j + 2)) = 1 := by
    rw [pow_mul]
    norm_num
  have hf : (f (2 * (j + 2))).toNat =
      (2 * j + 4 + 1) * (j * j + 3 * j + 1) + (2 * j + 4) * ((j + 3) * (2 * j + 7)) := by
    rw [bc69_fval (2 * (j + 2))
      (((2 * j + 4 + 1) * (j * j + 3 * j + 1) + (2 * j + 4) * ((j + 3) * (2 * j + 7)) : ℕ) : ℤ)
      (by rw [hneg]; push_cast; ring), Int.toNat_natCast]
  have hF1 : FrobeniusNumber (j * j + 3 * j + 1) {j + 2, j + 3} := by
    have h := frobeniusNumber_pair (m := j + 2) (n := j + 3)
      (bc69_cop _ _ (-1) 1 (by push_cast; ring)) (by omega) (by omega)
    have e1 : (j + 2) * (j + 3) - (j + 2) - (j + 3) = j * j + 3 * j + 1 := by
      have e2 : (j + 2) * (j + 3) = j * j + 3 * j + 1 + (j + 2) + (j + 3) := by ring
      omega
    rw [e1] at h
    exact h
  have hD : (j + 3) * (2 * j + 7) ∈ AddSubmonoid.closure ({j + 2, j + 3} : Set ℕ) := by
    refine (AddSubmonoid.mem_closure_pair _ _ _).mpr ⟨0, 2 * j + 7, ?_⟩
    simp only [smul_eq_mul]
    ring
  have hcop : Nat.Coprime (2 * j + 4 + 1) ((j + 3) * (2 * j + 7)) :=
    Nat.Coprime.mul_right (bc69_cop _ _ (-1) 2 (by push_cast; ring))
      (bc69_cop _ _ ((j : ℤ) + 3) (-((j : ℤ) + 2)) (by push_cast; ring))
  rw [hT0, hT1, hT2, hf]
  exact bc69_glue (j + 2) (j + 3) (2 * j + 4) ((j + 3) * (2 * j + 7)) (j * j + 3 * j + 1)
    hF1 hD hcop

/-- Odd `n = 2 (j + 1) + 1`: glue `(j+2) * <2j+3, 2j+5>` with `(j+3)(2j+5)`. -/
theorem bc69_odd (j : ℕ) :
    FrobeniusNumber (f (2 * (j + 1) + 1)).toNat
      {T (2 * (j + 1) + 1), T (2 * (j + 1) + 1 + 1), T (2 * (j + 1) + 1 + 2)} := by
  have hT0 : T (2 * (j + 1) + 1) = (j + 1 + 1) * (2 * j + 3) := by
    unfold OMA.S_oeis_a069755.T
    exact Nat.div_eq_of_eq_mul_left (by norm_num) (by ring)
  have hT1 : T (2 * (j + 1) + 1 + 1) = (j + 1 + 1) * (2 * j + 5) := by
    unfold OMA.S_oeis_a069755.T
    exact Nat.div_eq_of_eq_mul_left (by norm_num) (by ring)
  have hT2 : T (2 * (j + 1) + 1 + 2) = (j + 3) * (2 * j + 5) := by
    unfold OMA.S_oeis_a069755.T
    exact Nat.div_eq_of_eq_mul_left (by norm_num) (by ring)
  have hneg : (-1 : ℤ) ^ (2 * (j + 1) + 1) = -1 := by
    rw [pow_succ, pow_mul]
    norm_num
  have hf : (f (2 * (j + 1) + 1)).toNat =
      (j + 1 + 1) * (4 * (j * j) + 12 * j + 7) + (j + 1) * ((j + 3) * (2 * j + 5)) := by
    rw [bc69_fval (2 * (j + 1) + 1)
      (((j + 1 + 1) * (4 * (j * j) + 12 * j + 7) + (j + 1) * ((j + 3) * (2 * j + 5)) : ℕ) : ℤ)
      (by rw [hneg]; push_cast; ring), Int.toNat_natCast]
  have hF1 : FrobeniusNumber (4 * (j * j) + 12 * j + 7) {2 * j + 3, 2 * j + 5} := by
    have h := frobeniusNumber_pair (m := 2 * j + 3) (n := 2 * j + 5)
      (bc69_cop _ _ ((j : ℤ) + 2) (-((j : ℤ) + 1)) (by push_cast; ring)) (by omega) (by omega)
    have e1 : (2 * j + 3) * (2 * j + 5) - (2 * j + 3) - (2 * j + 5) = 4 * (j * j) + 12 * j + 7 := by
      have e2 : (2 * j + 3) * (2 * j + 5) = 4 * (j * j) + 12 * j + 7 + (2 * j + 3) + (2 * j + 5) := by
        ring
      omega
    rw [e1] at h
    exact h
  have hD : (j + 3) * (2 * j + 5) ∈ AddSubmonoid.closure ({2 * j + 3, 2 * j + 5} : Set ℕ) := by
    refine (AddSubmonoid.mem_closure_pair _ _ _).mpr ⟨0, j + 3, ?_⟩
    simp only [smul_eq_mul]
    ring
  have hcop : Nat.Coprime (j + 1 + 1) ((j + 3) * (2 * j + 5)) :=
    Nat.Coprime.mul_right (bc69_cop _ _ (-1) 1 (by push_cast; ring))
      (bc69_cop _ _ (-2) 1 (by push_cast; ring))
  rw [hT0, hT1, hT2, hf]
  exact bc69_glue (2 * j + 3) (2 * j + 5) (j + 1) ((j + 3) * (2 * j + 5))
    (4 * (j * j) + 12 * j + 7) hF1 hD hcop

theorem OMA.solution : type_of% @OMA.S_oeis_a069755.main := by
  intro n hn
  rcases Nat.mod_two_eq_zero_or_one n with h | h
  · obtain ⟨k, rfl⟩ : ∃ k, n = 2 * k := ⟨n / 2, by omega⟩
    rcases Nat.lt_or_ge k 2 with h2 | h2
    · obtain rfl : k = 1 := by omega
      exact bc69_two
    · obtain ⟨j, rfl⟩ : ∃ j, k = j + 2 := ⟨k - 2, by omega⟩
      exact bc69_even j
  · obtain ⟨k, rfl⟩ : ∃ k, n = 2 * k + 1 := ⟨n / 2, by omega⟩
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    exact bc69_odd j
