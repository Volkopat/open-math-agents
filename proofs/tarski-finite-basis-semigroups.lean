namespace P455MathlibMarker
open Turing
variable {K : Type} {G : K → Type} {L V : Type} [DecidableEq K]
abbrev Track := TM2to1.Γ' K G
def safe : TM1.Stmt (Track (G := G)) L V → Prop
  | .move _ s | .load _ s => safe s
  | .write w s => (∀ a v, (w a v).1 = a.1) ∧ safe s
  | .branch _ p q => safe p ∧ safe q
  | .goto _ | .halt => True
omit [DecidableEq K] in
theorem trNormal_safe (s : TM2.Stmt G L V) : safe (TM2to1.trNormal s) := by
  induction s <;> simp_all [TM2to1.trNormal,safe]
theorem tr_safe (M : L → TM2.Stmt G L V) (q) : safe (TM2to1.tr M q) := by
  cases q with
  | normal => exact trNormal_safe _
  | ret => exact ⟨trNormal_safe _,True.intro⟩
  | go k s q => cases s <;> simp [TM2to1.tr,TM2to1.trStAct,safe]
variable [Inhabited L] [Inhabited V]
variable (M : L → TM1.Stmt (Track (G := G)) L V)
def safeState (q : TM1to0.Λ' M) := ∀ p ∈ q.1, safe p
def preserves (a : Track (G := G)) : TM0.Stmt (Track (G := G)) → Prop
  | .move _ => True
  | .write b => b.1 = a.1
variable (hm : ∀ l, safe (M l))
include hm
omit [DecidableEq K] [Inhabited L] [Inhabited V] in
theorem trAux_safe (a : Track (G := G)) (p : TM1.Stmt (Track (G := G)) L V)
    (hp : safe p) (v) :
    safeState M (TM1to0.trAux M a p v).1 ∧ preserves a (TM1to0.trAux M a p v).2 := by
  induction p generalizing v with
  | move _ q => simpa [TM1to0.trAux,safeState,preserves,safe] using hp
  | write w q => exact ⟨fun _ h => Option.some.inj h ▸ hp.2, hp.1 _ _⟩
  | load _ _ ih => exact ih hp _
  | branch b p q ih₁ ih₂ =>
    cases e : b a v <;> simp only [TM1to0.trAux,e,cond] <;> first | exact ih₁ hp.1 v | exact ih₂ hp.2 v
  | goto l => simpa [TM1to0.trAux,safeState,preserves] using hm (l a v)
  | halt => simp [TM1to0.trAux,safeState,preserves]
omit [DecidableEq K] in
theorem guarded {S : Finset (TM1to0.Λ' M)} (hs : TM0.Supports (TM1to0.tr M) ↑S) :
    ∃ U : Finset (TM1to0.Λ' M), TM0.Supports (TM1to0.tr M) ↑U ∧
      ∀ q ∈ U, ∀ a q' b, (TM1to0.tr M) q a = some (q',.write b) → b.1 = a.1 := by
  classical
  refine ⟨S.filter (safeState M), ⟨?_,?_⟩,?_⟩
  · apply Finset.mem_filter.mpr
    refine ⟨hs.1, ?_⟩
    intro p hp
    change some (M default) = some p at hp
    exact (Option.some.inj hp) ▸ hm default
  · rintro ⟨_ | p,v⟩ a q' s step good
    · contradiction
    obtain ⟨mem,safeP⟩ := Finset.mem_filter.mp good
    have hp := safeP p rfl
    have h := (trAux_safe M hm a p hp v).1
    exact Finset.mem_filter.mpr ⟨hs.2 step mem,(congrArg (safeState M) (congrArg Prod.fst (Option.some.inj step))).mp h⟩
  · rintro ⟨_ | p,v⟩ good a q' b step
    · contradiction
    have hp := (Finset.mem_filter.mp good).2 p rfl
    have h := (trAux_safe M hm a p hp v).2
    exact (congrArg (preserves a) (congrArg Prod.snd (Option.some.inj step))).mp h
end P455MathlibMarker
end
section
namespace P455Closure.Move
open Problem455
variable {r : Nat} {Allowed : List Bool → Prop} {Mark : Nat → Nat → Prop}
  {u v : List Nat}
theorem asSlotMove (h : P455Closure.Move r Allowed Mark u v) :
    ∃ s : Slots.Move (r-2), u = Slots.before s ∧ v = Slots.after s ∧
      (∀ a ∈ s.p, ∀ b ∈ s.q, ¬ Mark a b ∧ ¬ Mark b a) ∧ 16 ≤ r := by
  obtain ⟨f,bit,l,t,hf,hu,hv,hc⟩ := h
  have hr := hf.1
  have hx : ∀ x, x ∈ f.p ∨ x ∈ f.q →
      (l ++ f.early ++ f.mid ++ f.beforeMutable).count x = r-2 := by
    intro x hx
    have hh := f.mutable_index hf bit l t (hu ▸ hc) x hx
    omega
  obtain ⟨_,_,_,np,nq,dis,marks,_⟩ := hf
  let s : Slots.Move (r-2) :=
    { pre := l ++ f.early ++ f.mid ++ f.beforeMutable
      p := f.p
      q := f.q
      post := f.beforeFinalP ++ f.p ++ f.beforeFinalQ ++ f.q ++ t
      dp := np
      dq := nq
      disjoint := dis
      indexP := fun x m => hx x (.inl m)
      indexQ := fun x m => hx x (.inr m) }
  cases bit with
  | false =>
    refine ⟨s,?_,?_,marks,by omega⟩ <;>
      simp [s, hu, hv, Slots.before, Slots.after, Frame.core, Frame.pair, List.append_assoc]
  | true =>
    let t' : Slots.Move (r-2) :=
      { pre := s.pre
        p := s.q
        q := s.p
        post := s.post
        dp := s.dq
        dq := s.dp
        disjoint := fun x hx hx' => s.disjoint x hx' hx
        indexP := s.indexQ
        indexQ := s.indexP }
    refine ⟨t',?_,?_,(fun x hx y hy => (marks y hy x hx).symm),by omega⟩ <;>
      simp [s, t', hu, hv, Slots.before, Slots.after, Frame.core, Frame.pair, List.append_assoc]
theorem order_iff (h : P455Closure.Move r Allowed Mark u v) (pat : List Slots.Event)
    (idx : ∀ e ∈ pat, e.2 ≠ r-2) : Slots.sees u pat ↔ Slots.sees v pat := by
  obtain ⟨s,rfl,rfl,_⟩ := asSlotMove h
  exact Slots.immutable_pattern s pat idx
theorem slot_iff (h : P455Closure.Move r Allowed Mark u v) (owner i a : Nat)
    (hi : Slots.slotStart i) : Slots.occupies u owner i a ↔ Slots.occupies v owner i a := by
  obtain ⟨s,rfl,rfl,_,hr⟩ := asSlotMove h
  have h1 : i ≠ r-2 := by unfold Slots.slotStart at hi; omega
  have h2 : i+1 ≠ r-2 := by unfold Slots.slotStart at hi; omega
  exact exists_congr (fun j => Slots.open_slot_event s owner i (i+1) (a,j) h1 h2)
theorem marked_proj (h : P455Closure.Move r Allowed Mark u v) (a b : Nat)
    (hm : Mark a b) : Slots.select [a,b] u = Slots.select [a,b] v := by
  obtain ⟨s,rfl,rfl,marks,_⟩ := asSlotMove h
  apply Slots.protected_projection
  by_cases hap : a ∈ s.p
  · right
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
    exact ⟨fun eq => s.disjoint a hap (eq ▸ hx),
           fun eq => (marks a hap b (eq ▸ hx)).1 hm⟩
  · by_cases hbp : b ∈ s.p
    · right
      intro x hx
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
      exact ⟨fun eq => (marks b hbp a (eq ▸ hx)).2 hm,
             fun eq => s.disjoint b hbp (eq ▸ hx)⟩
    · left
      intro x hx
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
      exact ⟨fun eq => hap (eq ▸ hx),fun eq => hbp (eq ▸ hx)⟩
theorem typed_iff (h : P455Closure.Move r Allowed Mark u v) (a b : Nat)
    (tag : List Bool) (hne : a ≠ b) (hlen : tag.length+16 = r) :
    Slots.typed u a b tag ↔ Slots.typed v a b tag := by
  constructor
  · obtain ⟨s,rfl,rfl,_⟩ := asSlotMove h
    exact Slots.type_forward s a b tag hne (by omega)
  · obtain ⟨s,hu,hv,_⟩ := asSlotMove h.symm
    rw [hu,hv]
    exact Slots.type_forward s a b tag hne (by omega)
end P455Closure.Move
end
section
namespace Problem455Finite
def rules (r : Nat) (allow : List Bool → Prop) (mark : Nat → Nat → Prop) :
    P455Quotient.Rules Nat where
  r := r
  step := P455Closure.Move r allow mark
  reverse := P455Closure.Move.symm
  counts := P455Closure.Move.count_eq
  extend h l t := P455Closure.Move.extend_of_cap h l t
open P455Quotient
def wordsUpTo (alphabet : List α) : Nat → List (List α)
  | 0 => [[]]
  | n+1 => [] :: alphabet.flatMap (fun a => (wordsUpTo alphabet n).map (List.cons a))
theorem covered (a : List α) (n : Nat) (w : List α) (len : w.length ≤ n)
    (names : ∀ x ∈ w, x ∈ a) : w ∈ wordsUpTo a n := by
  induction n generalizing w with
  | zero =>
    cases w <;> simp_all [wordsUpTo]
  | succ n ih =>
    cases w with
    | nil => simp [wordsUpTo]
    | cons x w =>
      have hx := names x (by simp)
      have hl : w.length ≤ n := by simpa using len
      have hw := ih w hl (fun z hz => names z (by simp [hz]))
      apply List.mem_cons_of_mem
      apply List.mem_flatMap.mpr
      exact ⟨x,hx,List.mem_map.mpr ⟨w,hw,rfl⟩⟩
theorem good_bound [DecidableEq α] (R : Rules α) (T w : Word α)
    (good : Good R T w) : w.length ≤ T.length ∧ ∀ x ∈ w, x ∈ T := by
  obtain ⟨v,path,l,t,hv⟩ := good
  have perm := List.perm_iff_count.mpr (count_walk R path)
  have len := perm.length_eq
  refine ⟨?_,?_⟩
  · simp only [hv,List.length_append] at len
    omega
  · intro x hx
    apply perm.mem_iff.mpr
    simp [hv,hx]
def carrier [DecidableEq α] (R : Rules α) (T : Word α) : List (Q R T) :=
  zero R T :: (wordsUpTo T T.length).map (ofWord R T)
theorem carrier_complete [DecidableEq α] (R : Rules α) (T : Word α) (q : Q R T) :
    q ∈ carrier R T := by
  by_cases dead : q = zero R T
  · simp [carrier,dead]
  · obtain ⟨w,good,e⟩ := nonzero_representative R q dead
    obtain ⟨len,names⟩ := good_bound R T w good
    exact List.mem_cons_of_mem _ (List.mem_map.mpr ⟨w, covered T T.length w len names, e⟩)
end Problem455Finite
end
section
namespace Problem455BlockBridge
open P455Closure
open Problem455Swap
theorem occ_count (a : Nat) (w : List Nat) : occ a w = w.count a := by
  induction w with
  | nil => rfl
  | cons b w ih =>
    by_cases h : a = b
    · subst b; simp [occ, ih, List.count_cons, Nat.add_comm]
    · simp [occ, ih, List.count_cons, h, Ne.symm h]
private def leftPart (f : Frame Nat) (l : List Nat) :=
  l ++ f.early ++ f.mid ++ f.beforeMutable
private def rightPart (f : Frame Nat) (t : List Nat) :=
  f.beforeFinalP ++ f.p ++ f.beforeFinalQ ++ f.q ++ t
private theorem frame_false (f : Frame Nat) (l t : List Nat) :
    l ++ f.core false ++ t = leftPart f l ++ f.p ++ f.q ++ rightPart f t := by
  simp [leftPart, rightPart, Frame.core, Frame.pair, List.append_assoc]
private theorem frame_true (f : Frame Nat) (l t : List Nat) :
    l ++ f.core true ++ t = leftPart f l ++ f.q ++ f.p ++ rightPart f t := by
  simp [leftPart, rightPart, Frame.core, Frame.pair, List.append_assoc]
private theorem early_factor (f : Frame Nat) (l t : List Nat) (b : Bool) :
    Factor (privatePhase f.p f.q) (l ++ f.core b ++ t) := by
  refine ⟨l, f.mid ++ f.beforeMutable ++ f.pair b ++ f.beforeFinalP ++ f.p ++
      f.beforeFinalQ ++ f.q ++ t, ?_⟩
  simp [Frame.core, Frame.early, privatePhase, List.append_assoc]
private theorem frameLink {r : Nat} {allow : List Bool → Prop} {mark : Nat → Nat → Prop}
    (f : Frame Nat) (l t : List Nat) (wf : f.Valid r allow mark)
    (hc : Cap r (l ++ f.core false ++ t)) (x y : Nat) :
    Link r (l ++ f.core false ++ t) x y ↔ Link r (l ++ f.core true ++ t) x y := by
  have pn : f.p ≠ [] := by simp [Frame.p]
  have qn : f.q ≠ [] := by simp [Frame.q]
  let i := f.pHead
  let j := f.q.head qn
  let s := f.p.getLast pn
  let z := f.qLast
  have hp : f.p.head? = some i := rfl
  have hq : f.q.head? = some j := List.head?_eq_head qn
  have ep : f.p.getLast? = some s := List.getLast?_eq_getLast pn
  have eq : f.q.getLast? = some z := by simp [Frame.q,z]
  have disj := wf.2.2.2.2.2.1
  have hpMem : i ∈ f.p := by simp [i, Frame.p]
  have hqMem : j ∈ f.q := List.head_mem _
  have epMem : s ∈ f.p := List.getLast_mem _
  have eqMem : z ∈ f.q := by simp [z,Frame.q]
  have hij : i ≠ j := fun h => disj i hpMem (h ▸ hqMem)
  have hsz : s ≠ z := fun h => disj s epMem (h ▸ eqMem)
  have cf : cap r (l ++ f.core false ++ t) := by
    intro a
    rw [occ_count]
    exact hc a
  have ef := early_factor f l t false
  have et := early_factor f l t true
  rw [frame_false] at cf ef ⊢
  rw [frame_true] at et ⊢
  exact repeatedLink_swap _ _ hp hq ep eq hij hsz cf ef et x y
theorem move_link {r : Nat} {allow : List Bool → Prop} {mark : Nat → Nat → Prop}
    {u v : List Nat} (h : Move r allow mark u v) (x y : Nat) :
    Link r u x y ↔ Link r v x y := by
  have hd := h.cap_right
  obtain ⟨f,b,l,t,hf,rfl,rfl,hc⟩ := h
  cases b
  · exact frameLink f l t hf hc x y
  · exact (frameLink f l t hf hd x y).symm
theorem move_sameBlock {r : Nat} {allow : List Bool → Prop} {mark : Nat → Nat → Prop}
    {u v : List Nat} (h : Move r allow mark u v) (x y : Nat) :
    SameBlock r u x y ↔ SameBlock r v x y := by
  have rel : Link r u = Link r v := funext fun a => funext fun b => propext (move_link h a b)
  simp only [SameBlock,rel,occ_count,h.count_eq]
end Problem455BlockBridge
end
