namespace P455OriginalWalk
open Problem455.Slots P455Witness P455Paths P455ContactLift P455Retained
def OriginalGuard (r : Nat) (allow : Tag → Prop) (mark : Marking) (u : W)
    (kept : Nat → Prop) (seed J : Nat) : Prop :=
  ∀ x, Near r allow mark u seed x J →
    kept x ∧ ∀ i, slotStart i → ∀ y, occupies u x i y → kept y ∧ u.count y = r
theorem lift_walk {v e kept r allow mark seed J h l k s}
    (exp : Expansion v e kept) (hr : 1 < r) (capU : P455Closure.Cap r (v.flatMap e))
    (p455Original : OriginalGuard r allow mark (v.flatMap e) kept seed J)
    (capZ : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (start : Supplies v h r seed s)
    (p : List Step) (len : p.length ≤ J)
    (walk : Walk r allow mark (l ++ v.flatMap h ++ k) s p) :
    let d := donor v h r
    let y := d (endpoint s p)
    Walk r allow mark (v.flatMap e) seed (relabel d p) ∧
      endpoint seed (relabel d p) = y ∧ (relabel d p).length = p.length ∧ kept y ∧
      Supplies v h r y (endpoint s p) ∧ Supplies (v.flatMap e) h r y (endpoint s p) := by
  let d := donor v h r
  have pos : 0 < r := by omega
  have eq : d s = seed := donor_eq pos (factor_cap capZ) start
  obtain ⟨small,supply⟩ := P455ContactLift.lift_walk pos capZ start (exp.guard hr capU p455Original) p len walk
  have large := exp.walk hr capU seed _ small
  have ep : endpoint seed (relabel d p) = d (endpoint s p) := by rw [← eq,endpoint_relabel]
  have lp : (relabel d p).length = p.length := by simp [relabel]
  have reach : Near r allow mark (v.flatMap e) seed (d (endpoint s p)) J :=
    ⟨relabel d p,large,ep,lp ▸ len⟩
  have ky := (p455Original _ reach).1
  exact ⟨large,ep,lp,ky,supply,(exp.count_eq v (fun _ h => h) _ ky).trans supply.1,supply.2⟩
end P455OriginalWalk
end
section
namespace P455OriginalEdges
open Problem455.Slots P455Witness P455Paths P455Retained P455PortReflection
section
variable {r : Nat} {v : W} {e : Nat → W} {kept : Nat → Prop}
    {allow : Tag → Prop} {mark : Marking}
theorem kept_roles (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {a : Node} (recProof : Holds r allow mark v (typedNode a)) : ∀ x ∈ roles a, kept x := by
  obtain ⟨cnt,cn'⟩ := record_counts (exp.small_cap hr cap) recProof
  intro x hx
  have ct : v.count x = r := by
    rcases (show x = a.owner ∨ x = a.mate by simpa [roles] using hx) with eq|eq
    · exact eq ▸ cnt
    · exact eq ▸ cn'
  apply Classical.byContradiction
  intro gap
  have := (exp.gaps x (List.count_pos_iff.mp (by omega)) gap).1
  omega
theorem expand_markedNode (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {a : Node} {bit : Bool} (recProof : Holds r allow mark v (markedNode a bit)) :
    Holds r allow mark (v.flatMap e) (markedNode a bit) := by
  have eq := exp.select_eq v (roles a) (fun _ h => h) (kept_roles exp hr cap (marked_typed recProof))
  exact ⟨recProof.1,recProof.2.1,recProof.2.2.1,recProof.2.2.2.1,eq.trans recProof.2.2.2.2⟩
theorem expand_typedNode (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {a : Node} (recProof : Holds r allow mark v (typedNode a)) : Holds r allow mark (v.flatMap e) (typedNode a) :=
  exp.contact hr cap (.record a.tag false) recProof
theorem expand_order (exp : Expansion v e kept) {p : List Event}
    (labels : ∀ ev ∈ p, kept ev.1) (ord : Holds r allow mark v (.order p)) :
    Holds r allow mark (v.flatMap e) (.order p) := by
  let ks := p.map Prod.fst
  have all : ∀ a ∈ ks, kept a := by
    intro a h
    obtain ⟨ev,he,rfl⟩ := List.mem_map.mp h
    exact labels ev he
  refine ⟨ord.1,P455ContactReflection.select_sees ks _ p ?_⟩
  rw [exp.select_eq v ks (fun _ h => h) all]
  exact P455ContactReflection.sees_select ks _ p (fun ev he => List.mem_map_of_mem he) ord.2
theorem expand_earlier (exp : Expansion v e kept) {a i b j}
    (ha : kept a) (hb : kept b) (ord : Holds r allow mark v (earlier a i b j)) :
    Holds r allow mark (v.flatMap e) (earlier a i b j) :=
  expand_order exp (by simp [ha,hb]) ord
theorem expand_port (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {p : Nat} {a b : Node} (port : Holds r allow mark v (orientedPort p a b)) :
    Holds r allow mark (v.flatMap e) (orientedPort p a b) := by
  obtain ⟨ra,rb,early,order,_⟩ := port
  have ka := kept_roles exp hr cap ra
  have kb := kept_roles exp hr cap rb
  have earl {xs ys : W} (kx : ∀ a ∈ xs, kept a) (ky : ∀ a ∈ ys, kept a)
      (obs : Holds r allow mark v (earlyBefore xs ys)) :
      Holds r allow mark (v.flatMap e) (earlyBefore xs ys) := by
    apply (earlyBefore_iff _ _).mpr
    exact fun a ha b hb => expand_earlier exp (kx a ha) (ky b hb) ((earlyBefore_iff _ _).mp obs a ha b hb)
  refine ⟨expand_typedNode exp hr cap ra,expand_typedNode exp hr cap rb,?_,?_,True.intro⟩
  · exact early.elim (fun h => Or.inl (earl ka kb h)) (fun h => Or.inr (earl kb ka h))
  · have ka' : kept a.owner ∧ kept a.mate := by simpa [roles] using ka
    have kb' : kept b.owner ∧ kept b.mate := by simpa [roles] using kb
    exact expand_order exp (by simp [ka'.1,ka'.2,kb'.1,kb'.2]) order
theorem expand_right (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {ts : Tiles} {a b : Node} (q : Holds r allow mark v (rightward ts a b)) :
    Holds r allow mark (v.flatMap e) (rightward ts a b) := by
  have p := q.2.1
  exact ⟨q.1,expand_port exp hr cap p,expand_earlier exp (kept_roles exp hr cap p.1 _ (by simp [roles]))
    (kept_roles exp hr cap p.2.1 _ (by simp [roles])) q.2.2.1,True.intro⟩
theorem expand_down (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {ts : Tiles} {a b : Node} (q : Holds r allow mark v (downward ts a b)) :
    Holds r allow mark (v.flatMap e) (downward ts a b) := ⟨q.1,expand_port exp hr cap q.2⟩
theorem expand_neighbor (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {ts : Tiles} {a b : Node} (d : Dir) (q : Holds r allow mark v (neighbor ts a b d)) :
    Holds r allow mark (v.flatMap e) (neighbor ts a b d) := by
  cases d with
  | right => exact expand_right exp hr cap q
  | left => exact expand_right exp hr cap q
  | down => exact expand_down exp hr cap q
  | up => exact expand_down exp hr cap q
private theorem flag {b : Bool} {q : Query}
    (f : Holds r allow mark v q → Holds r allow mark (v.flatMap e) q)
    (h : Holds r allow mark v (flagQ b q)) : Holds r allow mark (v.flatMap e) (flagQ b q) := by
  cases b
  · exact True.intro
  · exact f h
theorem expand_edge (exp : Expansion v e kept) (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    {ts : Tiles} {edge : EdgeCertificate} (query : Holds r allow mark v (edge.query ts)) :
    Holds r allow mark (v.flatMap e) (edge.query ts) := by
  obtain ⟨a,b,localQ,succ,_⟩ := query
  refine ⟨expand_markedNode exp hr cap a,expand_markedNode exp hr cap b,?_,?_,True.intro⟩
  · exact ⟨flag (expand_right exp hr cap) localQ.1,flag (expand_right exp hr cap) localQ.2.1,
      flag (expand_down exp hr cap) localQ.2.2.1,flag (expand_down exp hr cap) localQ.2.2.2.1,
      flag (fun ⟨d,r⟩ => ⟨expand_down exp hr cap d,expand_right exp hr cap r⟩) localQ.2.2.2.2.1,
      True.intro⟩
  · have ka : kept edge.a.owner := kept_roles exp hr cap (marked_typed a) _ (by simp [roles])
    have kb : kept edge.b.owner := kept_roles exp hr cap (marked_typed b) _ (by simp [roles])
    unfold chosenSuccessor at succ ⊢
    dsimp only at succ ⊢
    split at succ
    next ret =>
      rw [if_pos ret]
      exact ⟨succ.1,succ.2.1.elim (fun f => Or.inl (expand_port exp hr cap f))
        (fun b => Or.inr (expand_port exp hr cap b)),expand_earlier exp kb ka succ.2.2.1,True.intro⟩
    next notRet =>
      rw [if_neg notRet]
      exact ⟨succ.1,expand_earlier exp ka kb succ.2⟩
end
end P455OriginalEdges
end
section
namespace P455Compression
open P455Witness P455Retained
inductive Piece where
  | literal (a : Nat)
  | gap (w : W)
  deriving DecidableEq
def body : Piece → W | .literal a => [a] | .gap w => w
def prependOutside (a : Nat) : List Piece → List Piece
  | .gap w :: tail => .gap (a::w) :: tail
  | cs => .gap [a] :: cs
def pieces (names : W) : W → List Piece
  | [] => []
  | a :: u =>
    let rest := pieces names u
    if a ∈ names then .literal a :: rest else prependOutside a rest
def good (names : W) : Piece → Prop
  | .literal a => a ∈ names
  | .gap w => w ≠ [] ∧ ∀ a ∈ w, a ∉ names
def noTouch : List Piece → Prop
  | .gap _ :: .gap _ :: _ => False
  | _ :: tail => noTouch tail
  | [] => True
private theorem prepend_body (a : Nat) (cs : List Piece) :
    (prependOutside a cs).flatMap body = a :: cs.flatMap body := by
  cases cs with
  | nil => rfl
  | cons p tail => cases p <;> rfl
theorem decoded (names u : W) : (pieces names u).flatMap body = u := by
  induction u with
  | nil => rfl
  | cons a u ih =>
    by_cases c : a ∈ names
    · simp [pieces,c,body,ih]
    · simp [pieces,c,prepend_body,ih]
private theorem prepend_good {a : Nat} {cs : List Piece} {names : W} (ha : a ∉ names)
    (all : ∀ c ∈ cs, good names c) : ∀ c ∈ prependOutside a cs, good names c := by
  cases cs with
  | nil => simp [prependOutside,good,ha]
  | cons p tail =>
    cases p with
    | literal b => simp [prependOutside,good,ha] at *; exact all
    | gap w =>
      have h := all (.gap w) (by simp)
      simp only [good] at h
      simp only [prependOutside,List.forall_mem_cons,good,List.cons_ne_nil,not_false_eq_true,true_and]
      exact ⟨⟨by simp,ha,h.2⟩,fun c hc => all c (by simp [hc])⟩
theorem pieces_good (names u : W) : ∀ c ∈ pieces names u, good names c := by
  induction u with
  | nil => simp [pieces]
  | cons a u ih =>
    by_cases k : a ∈ names
    · simp only [pieces,if_pos k,List.forall_mem_cons]
      exact ⟨k,ih⟩
    · simpa only [pieces,if_neg k] using prepend_good k ih
private theorem prepend_sep {cs : List Piece} (a : Nat) (ok : noTouch cs) :
    noTouch (prependOutside a cs) := by
  cases cs with
  | nil => exact True.intro
  | cons p tail =>
    cases p with
    | literal b => exact ok
    | gap w => cases tail with
      | nil => exact True.intro
      | cons p' rest => cases p' <;> exact ok
theorem maximal (names u : W) : noTouch (pieces names u) := by
  induction u with
  | nil => exact True.intro
  | cons a u ih =>
    by_cases k : a ∈ names
    · simpa only [pieces,if_pos k,noTouch] using ih
    · simpa only [pieces,if_neg k] using prepend_sep a ih
def base (u names : W) := u.sum + names.sum + 1
private theorem le_sum {a : Nat} {w : W} (ha : a ∈ w) : a ≤ w.sum := by
  induction w with
  | nil => simp at ha
  | cons b w ih =>
    simp only [List.sum_cons]
    rcases List.mem_cons.mp ha with h|h
    · omega
    · have := ih h; omega
def code : Nat → List Piece → W
  | _,[] => []
  | n,.literal a :: cs => a :: code (n+1) cs
  | n,.gap _ :: cs => n :: code (n+1) cs
def lookup : Nat → List Piece → Nat → W
  | _,[],a => [a]
  | n,.literal _ :: cs,a => lookup (n+1) cs a
  | n,.gap w :: cs,a => if a = n then w else lookup (n+1) cs a
def small (u names : W) := code (base u names) (pieces names u)
def expand (u names : W) := lookup (base u names) (pieces names u)
private theorem low_fixed (cs : List Piece) (a n : Nat) (low : a < n) :
    lookup n cs a = [a] := by
  induction cs generalizing n with
  | nil => rfl
  | cons p cs ih =>
    cases p <;> simp [lookup,show a ≠ n by omega,ih (n+1) (by omega)]
private theorem low_kept (cs : List Piece) (names : W)
    (all : ∀ c ∈ cs, good names c) (a n : Nat) (low : a < n) (use : a ∈ code n cs) :
    a ∈ names := by
  induction cs generalizing n with
  | nil => cases use
  | cons c cs ih =>
    have rest := ih (fun c hc => all c (by simp [hc])) (n+1) (by omega)
    cases c with
    | literal b =>
      rcases List.mem_cons.mp use with eq|mem
      · obtain rfl := eq; exact all (.literal a) (by simp)
      · exact rest mem
    | gap w =>
      rcases List.mem_cons.mp use with eq|mem
      · omega
      · exact rest mem
private theorem decode_code (cs : List Piece) (names : W) (n : Nat)
    (all : ∀ c ∈ cs, good names c) (large : ∀ a ∈ names, a < n) :
    (code n cs).flatMap (lookup n cs) = cs.flatMap body := by
  induction cs generalizing n with
  | nil => rfl
  | cons c cs ih =>
    have goodTail (p) (hp : p ∈ cs) : good names p := all _ (by simp [hp])
    have tail := ih (n+1) goodTail (fun a ha => by have := large a ha; omega)
    cases c with
    | literal a =>
      have low := large a (all (.literal a) (by simp))
      simp [code,lookup,low_fixed cs a (n+1) (by omega),body,tail]
    | gap w =>
      have miss : n ∉ code (n+1) cs := by
        intro h
        have := large n (low_kept cs names goodTail n (n+1) (by omega) h)
        omega
      have eq : (code (n+1) cs).flatMap (lookup n (.gap w :: cs)) =
          (code (n+1) cs).flatMap (lookup (n+1) cs) := by
        simp only [List.flatMap_def]
        apply congrArg List.flatten
        exact List.map_congr_left (fun a ha => by
          have dif : a ≠ n := fun d => miss (d ▸ ha)
          simp [lookup,dif])
      change lookup n (.gap w::cs) n ++ (code (n+1) cs).flatMap _ = w ++ cs.flatMap body
      rw [eq,tail]
      simp [lookup]
private theorem gap_code (cs : List Piece) (names : W) (n : Nat)
    (all : ∀ c ∈ cs, good names c) (large : ∀ a ∈ names, a < n) :
    ∀ g ∈ code n cs, g ∉ names →
    (code n cs).count g = 1 ∧ lookup n cs g ≠ [] ∧ ∀ a ∈ lookup n cs g, a ∉ names := by
  induction cs generalizing n with
  | nil => simp [code]
  | cons c cs ih =>
    intro g use outside
    have goodTail (p) (hp : p ∈ cs) : good names p := all _ (by simp [hp])
    have tail := ih (n+1) goodTail (fun a ha => by have := large a ha; omega) g
    cases c with
    | literal a =>
      have dif : g ≠ a := fun d => outside (d ▸ all (.literal a) (by simp))
      have occurs : g ∈ code (n+1) cs := by simpa [code,dif] using use
      simpa [code,lookup,List.count_cons,dif,Ne.symm dif] using tail occurs outside
    | gap w =>
      by_cases same : g = n
      · subst g
        have miss : n ∉ code (n+1) cs := fun u =>
          outside (low_kept cs names goodTail n (n+1) (by omega) u)
        have gw := all (.gap w) (by simp)
        simpa [code,lookup,List.count_cons,List.count_eq_zero.mpr miss,good] using gw
      · have occurs : g ∈ code (n+1) cs := by simpa [code,same] using use
        simpa [code,lookup,List.count_cons,same,Ne.symm same] using tail occurs outside
theorem recover (u names : W) : (small u names).flatMap (expand u names) = u :=
  (decode_code (pieces names u) names (base u names) (pieces_good names u)
    (fun a h => by have := le_sum h; unfold base; omega)).trans (decoded names u)
theorem canonical (u names : W) : Expansion (small u names) (expand u names) (fun a => a ∈ names) where
  literal x _ kept := low_fixed _ _ _ (by have := le_sum kept; unfold base; omega)
  gaps := gap_code (pieces names u) names (base u names) (pieces_good names u)
    (fun a h => by have := le_sum h; unfold base; omega)
theorem counts_retained (u names : W) (x : Nat) (hx : x ∈ names) :
    (small u names).count x = u.count x := by
  have c := (canonical u names).count_eq (small u names) (fun _ h => h) x hx
  rw [recover] at c
  exact c.symm
end P455Compression
end
section
namespace P455DefectProjection
open P455Witness P455Paths P455SourceFamilies Problem455.Slots
theorem select_sub (keep smaller u : W) (hs : ∀ a ∈ smaller, a ∈ keep) :
    select smaller (select keep u) = select smaller u := by
  induction u with
  | nil => rfl
  | cons x u ih =>
    by_cases hx : x ∈ keep
    · by_cases hm : x ∈ smaller <;> simp_all [select]
    · have hm : x ∉ smaller := fun h => hx (hs _ h)
      simp_all [select]
theorem select_count (keep u : W) (a : Nat) (mem : a ∈ keep) :
    (select keep u).count a = u.count a :=
  List.count_filter (by simpa using mem)
theorem select_cap {r u} (keep : W) (cap : P455Closure.Cap r u) :
    P455Closure.Cap r (select keep u) := by
  intro a
  by_cases mem : a ∈ keep
  · simpa only [select_count keep u _ mem] using cap a
  · have missing : a ∉ select keep u := by simp [select,mem]
    simp [List.count_eq_zero.mpr missing]
theorem select_order {r allow mark u} (keep : W) (pat : List Event)
    (hs : ∀ e ∈ pat, e.1 ∈ keep) (obs : Holds r allow mark u (.order pat)) :
    Holds r allow mark (select keep u) (.order pat) :=
  ⟨obs.1, P455ContactReflection.sees_select keep u pat hs obs.2⟩
theorem select_marked {r allow mark u} (keep : W) (n : Node) (b : Bool)
    (ho : n.owner ∈ keep) (hm : n.mate ∈ keep) (obs : Holds r allow mark u (markedNode n b)) :
    Holds r allow mark (select keep u) (markedNode n b) := by
  obtain ⟨ne,len,tag,mk,eq⟩ := obs
  refine ⟨ne,len,tag,mk,(select_sub keep [n.owner,n.mate] u ?_).trans eq⟩
  simpa using And.intro ho hm
theorem select_record {r allow mark u} (keep : W) (a b : Nat) (tag : Tag) (ha : a ∈ keep)
    (hb : b ∈ keep) (obs : Holds r allow mark u (.record a b tag)) :
    Holds r allow mark (select keep u) (.record a b tag) := by
  obtain ⟨ne,len,ok,bit,eq⟩ := obs
  exact ⟨ne,len,ok,bit,(select_sub keep [a,b] u (by simpa using And.intro ha hb)).trans eq⟩
theorem select_contact {r allow mark u} (keep : W) (a b : Nat) (c : ContactChoice)
    (ha : a ∈ keep) (hb : b ∈ keep) (obs : Holds r allow mark u (contact r a b c)) :
    Holds r allow mark (select keep u) (contact r a b c) := by
  cases c with
  | record tag rev =>
    cases rev with
    | false => exact select_record keep a b tag ha hb obs
    | true => exact select_record keep b a tag hb ha obs
  | port phase rev =>
    obtain ⟨ab,ac,bc,early,order,endQ⟩ := obs
    refine ⟨ab,(select_count keep u a ha).trans ac,(select_count keep u b hb).trans bc,?_,?_,endQ⟩
    · rcases early with ⟨f,_⟩|⟨f,_⟩
      · exact .inl ⟨select_order keep _ (by simpa using And.intro ha hb) f,True.intro⟩
      · exact .inr ⟨select_order keep _ (by simpa using And.intro hb ha) f,True.intro⟩
    · cases rev <;> apply select_order keep _ _ order <;> simp [ha,hb]
theorem select_walk {r allow mark u} (keep : W) (a : Nat) (p : List Step)
    (ha : a ∈ keep) (hs : ∀ m ∈ p, m.1 ∈ keep) (w : Walk r allow mark u a p) :
    Walk r allow mark (select keep u) a p := by
  induction p generalizing a with
  | nil => trivial
  | cons bc rest ih =>
    obtain ⟨b,c⟩ := bc
    have hb := hs (b,c) (by simp)
    exact ⟨select_contact keep a b c ha hb w.1,ih b hb (fun s h => hs s (by simp [h])) w.2⟩
theorem endpoint_kept (keep : W) (a : Nat) (p : List Step) (ha : a ∈ keep)
    (hs : ∀ m ∈ p, m.1 ∈ keep) : endpoint a p ∈ keep := by
  induction p generalizing a with
  | nil => exact ha
  | cons bc p ih => exact ih bc.1 (hs bc (by simp)) (fun s h => hs s (by simp [h]))
theorem select_slot {u : W} (keep : W) (t i b : Nat)
    (ht : t ∈ keep) (hb : b ∈ keep) (obs : occupies u t i b) :
    occupies (select keep u) t i b := by
  obtain ⟨j,h⟩ := obs
  exact ⟨j,P455ContactReflection.sees_select keep u _ (by simp [hb,ht]) h⟩
theorem bounded_defect_kind {r allow mark u} (cap : P455Closure.Cap r u) (n : Node) (bit side : Bool)
    (t i bad : Nat) (anchor : Holds r allow (markNode n) u (markedNode n bit))
    (near : Near r allow mark u (if side then n.mate else n.owner) t 6)
    (slot : slotStart i) (occ : occupies u t i bad) (deficient : u.count bad < r) :
    ∃ (keep : W) (s : SlotCertificate), keep.length ≤ 9 ∧ n.owner ∈ keep ∧ n.mate ∈ keep ∧
      bad ∈ keep ∧ s.defect = .deficient bad ∧ s.anchor = n ∧ s.bit = bit ∧ P455Closure.Cap r (select keep u) ∧
      Holds r allow (markNode n) (select keep u) (s.query r) := by
  let a := if side then n.mate else n.owner
  obtain ⟨p,w,ep,len⟩ := near
  let keep := n.owner :: n.mate :: bad :: p.map Prod.fst
  have h1 : n.owner ∈ keep := by simp [keep]
  have h2 : n.mate ∈ keep := by simp [keep]
  have h3 : bad ∈ keep := by simp [keep]
  have start : a ∈ keep := by cases side <;> simp [a,h1,h2]
  have ins : ∀ m ∈ p, m.1 ∈ keep := fun m hm => by simp [keep,List.mem_map_of_mem hm]
  have last : t ∈ keep := ep ▸ endpoint_kept keep a p start ins
  let s : SlotCertificate := ⟨n,bit,side,p,i,.deficient bad⟩
  refine ⟨keep,s,by simp only [keep,List.length_cons,List.length_map] <;> omega,h1,h2,h3,rfl,rfl,rfl,
    select_cap keep cap,select_marked keep n bit h1 h2 anchor,len,?_,True.intro⟩
  apply (route_iff ..).mpr
  refine ⟨remark_walk _ _ (select_walk keep a p start ins w),?_⟩
  change (slotStart i ∧ occupies (select keep u) (endpoint a p) i bad) ∧ (select keep u).count bad < r
  rw [show endpoint a p = t from ep, select_count keep u bad h3]
  exact ⟨⟨slot,select_slot keep t i bad last h3 occ⟩,deficient⟩
end P455DefectProjection
end
section
namespace P455FirstRewrite
abbrev W := List Nat
abbrev Sub := Nat → W
def Step (G : W → W → Prop) (A B : W) : Prop :=
  ∃ (u v p q : W) (h : Sub), (G u v ∨ G v u) ∧ u ≠ [] ∧ v ≠ [] ∧
    (∀ x, h x ≠ []) ∧ A = p ++ u.flatMap h ++ q ∧ B = p ++ v.flatMap h ++ q
abbrev Derives (G : W → W → Prop) := P455Quotient.Walk (Step G)
theorem first_change {G : W → W → Prop} {A B : W} (ne : A ≠ B)
    (two : ∀ w, Derives G A w → w = A ∨ w = B) (path : Derives G A B) : Step G A B := by
  suffices go : ∀ w, Derives G A w → w = A ∨ Step G A B by
    exact (go B path).resolve_left ne.symm
  intro w walk
  induction walk with
  | refl => exact Or.inl rfl
  | @snoc v w prev step ih =>
    rcases ih with h | done
    · rcases two w (.snoc prev step) with f | f
      · exact Or.inl f
      · exact Or.inr (h ▸ f ▸ step)
    · exact Or.inr done
def proj (a b : Nat) (w : W) : W := w.filter (fun x => decide (x = a ∨ x = b))
private theorem proj_append (a b : Nat) (p q : W) :
    proj a b (p ++ q) = proj a b p ++ proj a b q := List.filter_append p q
private theorem filter_erase (f : Nat → Bool) (a : Nat) (w : W) :
    (w.erase a).filter f = (w.filter f).erase a := by
  induction w with
  | nil => rfl
  | cons x xs ih =>
    by_cases e : x = a
    · subst x
      by_cases h : f a = true
      · simp [h]
      · have n : a ∉ xs.filter f := by simp [h]
        simp [h, List.erase_of_not_mem n]
    · by_cases h : f x = true <;> simp [List.erase_cons, e, h, ih]
private theorem first_split {a : Nat} {v : W} (mem : a ∈ v) :
    ∃ L R : W, v = L ++ a :: R ∧ a ∉ L := by
  induction v with
  | nil => simp at mem
  | cons z zs ih =>
    by_cases e : z = a
    · subst z; exact ⟨[],zs,rfl,by simp⟩
    · obtain ⟨l,r,f,n⟩ := ih ((List.mem_cons.mp mem).resolve_left (Ne.symm e))
      exact ⟨z::l,r,by simp [f],by simp [Ne.symm e,n]⟩
private theorem prefix_head {a z : Nat} {L : W} (n : a ∉ L) (m : z ∈ L) :
    ∃ t, proj a z L = z :: t := by
  induction L with
  | nil => simp at m
  | cons c L ih =>
    have ca : c ≠ a := fun e => n (e ▸ List.mem_cons_self)
    by_cases cz : c = z
    · subst c; exact ⟨proj a z L,by simp [proj]⟩
    · have mz := (List.mem_cons.mp m).resolve_left (Ne.symm cz)
      obtain ⟨t,e⟩ := ih (fun h => n (List.mem_cons_of_mem c h)) mz
      exact ⟨t, by simpa [proj,ca,cz] using e⟩
private theorem flatten_commute (g : Sub) (a : Nat) (L : W)
    (ok : ∀ z ∈ L, g a ++ g z = g z ++ g a) :
    g a ++ L.flatMap g = L.flatMap g ++ g a := by
  induction L with
  | nil => simp
  | cons z L ih =>
    have tail := ih (fun x h => ok x (List.mem_cons_of_mem z h))
    have head := ok z (List.mem_cons_self)
    simp only [List.flatMap_cons]
    calc
      _ = (g a ++ g z) ++ L.flatMap g := (List.append_assoc ..).symm
      _ = (g z ++ g a) ++ L.flatMap g := by rw [head]
      _ = _ := by simp only [List.append_assoc,tail]
theorem trace {u v : W} (g : Sub) (counts : ∀ x, u.count x = v.count x)
    (pairs : ∀ i j, g i ++ g j ≠ g j ++ g i → proj i j u = proj i j v) :
    u.flatMap g = v.flatMap g := by
  induction u generalizing v with
  | nil =>
    cases v with
    | nil => rfl
    | cons b t => simpa using counts b
  | cons a u ih =>
    have m : a ∈ v := List.count_pos_iff.mp (by rw [← counts]; simp)
    obtain ⟨L,R,rfl,n⟩ := first_split m
    have cross (z) (mz : z ∈ L) : g a ++ g z = g z ++ g a := by
      apply Classical.byContradiction
      intro bad
      have pair := pairs a z bad
      obtain ⟨t,eq⟩ := prefix_head n mz
      rw [proj_append,eq] at pair
      have az : a = z := by simpa [proj] using congrArg List.head? pair
      exact n (az ▸ mz)
    have er : (L ++ a :: R).erase a = L ++ R := by
      rw [List.erase_append_right _ n, List.erase_cons_head]
    have cnt (x) : u.count x = (L ++ R).count x := by
      have orig := counts x
      simp only [List.count_append,List.count_cons] at orig ⊢
      omega
    have rest (i j) (bad : g i ++ g j ≠ g j ++ g i) : proj i j u = proj i j (L ++ R) := by
      have eq := congrArg (fun w : W => w.erase a) (pairs i j bad)
      unfold proj at eq
      rw [← filter_erase, ← filter_erase, List.erase_cons_head, er] at eq
      exact eq
    have sub := ih cnt rest
    simp only [List.flatMap_cons,List.flatMap_append] at sub ⊢
    calc
      _ = g a ++ (L.flatMap g ++ R.flatMap g) := by rw [sub]
      _ = _ := by rw [← List.append_assoc, flatten_commute g a L cross, List.append_assoc]
structure TesterRule (r : Nat) (u v : W) : Prop where
  unary : ∀ x, min (u.count x) (r+1) = min (v.count x) (r+1)
  binary : P455Quotient.Cap r u → P455Quotient.Cap r v →
    ∀ i j, proj i j u ≠ proj i j v → u.count i = r ∧ u.count j = r
private theorem cap_rule {r : Nat} {p q u : W} {h : Sub} (ne : ∀ x, h x ≠ [])
    (cap : P455Quotient.Cap r (p ++ u.flatMap h ++ q)) : P455Quotient.Cap r u := by
  intro x
  obtain ⟨a,hm⟩ : ∃ a, a ∈ h x := by
    cases e : h x with
    | nil => exact False.elim (ne x e)
    | cons a t => exact ⟨a,List.mem_cons_self⟩
  have pos := List.count_pos_iff.mpr hm
  have mul := Nat.mul_le_mul_left (u.count x) pos
  have ct := P455DonorInterval.split_contributions h u x a
  have bound := cap a
  simp only [List.count_append] at bound
  simp only [Nat.mul_one] at mul
  omega
private theorem counted_edge (h : Sub) (x a b : Nat)
    (pos : 0 < Problem455Swap.bigram a b (h x)) (u : W) :
    u.count x ≤ Problem455Swap.bigram a b (u.flatMap h) := by
  induction u with
  | nil => simp [Problem455Swap.bigram]
  | cons z u ih =>
    simp only [List.flatMap_cons,Problem455Swap.bigram_append]
    by_cases e : z = x
    · subst z; simp [List.count_cons]; omega
    · simp [List.count_cons,e]; omega
private theorem singleton {r : Nat} {p q u : W} {h : Sub}
    (ne : ∀ x, h x ≠ []) (cap : P455Quotient.Cap r (p ++ u.flatMap h ++ q))
    (compressed : P455SourceFamilies.Compressed r (p ++ u.flatMap h ++ q))
    {x : Nat} (sat : u.count x = r) : ∃ a, h x = [a] := by
  cases e : h x with
  | nil => exact False.elim (ne x e)
  | cons a t =>
    cases t with
    | nil => exact ⟨a,rfl⟩
    | cons b tail =>
      have edge : 0 < Problem455Swap.bigram a b (h x) := by
        rw [e]; simp [Problem455Swap.bigram,Problem455Swap.hit] <;> omega
      have lo := counted_edge h x a b edge u
      let U := p ++ u.flatMap h ++ q
      have lower : r ≤ Problem455Swap.bigram a b U := by
        dsimp [U]; rw [Problem455Swap.bigram_append,Problem455Swap.bigram_append]; omega
      have upper := Problem455Swap.out_bound a b (b+1) (by omega) U
      rw [Problem455BlockBridge.occ_count] at upper
      have hc : U.count a ≤ r := cap a
      exact False.elim (compressed a b (by change Problem455Swap.bigram a b U = r; omega))
private theorem project_images (a b : Nat) (u : W) (h : Sub) :
    proj a b (u.flatMap h) = u.flatMap (fun x => proj a b (h x)) := by
  induction u with
  | nil => rfl
  | cons x u ih => simp only [List.flatMap_cons,proj_append,ih]
private theorem projected_commutes_without (a b c d : Nat) (ca : c ≠ a) (da : d ≠ a) :
    proj a b [c] ++ proj a b [d] = proj a b [d] ++ proj a b [c] := by
  by_cases cb : c = b <;> by_cases db : d = b <;> simp_all [proj]
theorem changed_name {r : Nat} (hr : 0 < r) {p q u v : W} {h : Sub}
    (ne : ∀ x, h x ≠ []) (cap : P455Quotient.Cap r (p ++ u.flatMap h ++ q))
    (compressed : P455SourceFamilies.Compressed r (p ++ u.flatMap h ++ q))
    (rule : TesterRule r u v) (a b : Nat)
    (changed : proj a b (p ++ u.flatMap h ++ q) ≠ proj a b (p ++ v.flatMap h ++ q)) :
    ∃ x ∈ u, h x = [a] := by
  have cu := cap_rule ne cap
  have counts (x) : u.count x = v.count x := by
    have eq := rule.unary x
    have bound := cu x
    omega
  have cv : P455Quotient.Cap r v := fun x => counts x ▸ cu x
  let g : Sub := fun x => proj a b (h x)
  apply Classical.byContradiction
  intro absent
  apply changed
  simp only [proj_append,project_images]
  have pair (i j) (bad : g i ++ g j ≠ g j ++ g i) : proj i j u = proj i j v := by
    apply Classical.byContradiction
    intro diff
    obtain ⟨ci,cj⟩ := rule.binary cu cv i j diff
    obtain ⟨c,ec⟩ := singleton ne cap compressed ci
    obtain ⟨d,ed⟩ := singleton ne cap compressed cj
    have mi : i ∈ u := List.count_pos_iff.mp (ci ▸ hr)
    have mj : j ∈ u := List.count_pos_iff.mp (cj ▸ hr)
    have ca : c ≠ a := fun e => absent ⟨i,mi,ec.trans (e ▸ rfl)⟩
    have da : d ≠ a := fun e => absent ⟨j,mj,ed.trans (e ▸ rfl)⟩
    apply bad
    simpa [g,ec,ed] using projected_commutes_without a b c d ca da
  rw [show u.flatMap (fun x => proj a b (h x)) = v.flatMap (fun x => proj a b (h x))
      from trace g counts pair]
theorem size_le {D C : W} (uniq : D.Nodup) (sub : ∀ a ∈ D, a ∈ C) : D.length ≤ C.length := by
  induction D generalizing C with
  | nil => simp
  | cons a t ih =>
    obtain ⟨fresh,tail⟩ := List.nodup_cons.mp uniq
    have mem := sub a List.mem_cons_self
    have le := ih tail (C := C.erase a) (fun x hx =>
      (List.mem_erase_of_ne (a := x) (b := a) (fun e => fresh (e ▸ hx))).mpr (sub x (List.mem_cons_of_mem _ hx)))
    have len := List.length_erase_of_mem mem
    have pos : 0 < C.length := by cases C <;> simp_all
    simp only [List.length_cons]
    omega
theorem instance_rank {r : Nat} (hr : 0 < r) {p q u v D C : W} {h : Sub}
    (ne : ∀ x, h x ≠ []) (cap : P455Quotient.Cap r (p ++ u.flatMap h ++ q))
    (compressed : P455SourceFamilies.Compressed r (p ++ u.flatMap h ++ q))
    (rule : TesterRule r u v) (uniq : D.Nodup) (cover : ∀ x ∈ u, x ∈ C)
    (changes : ∀ a ∈ D, ∃ b, proj a b (p ++ u.flatMap h ++ q) ≠
      proj a b (p ++ v.flatMap h ++ q)) : D.length ≤ C.length := by
  have sub (a) (ma : a ∈ D) : a ∈ C.map (fun x => (h x).headD 0) := by
    obtain ⟨b,diff⟩ := changes a ma
    obtain ⟨x,mx,e⟩ := changed_name hr ne cap compressed rule a b diff
    exact List.mem_map.mpr ⟨x,cover x mx,by simp [e]⟩
  simpa using size_le uniq sub
def names : W → W
  | [] => []
  | x :: w => if x ∈ w then names w else x :: names w
@[simp] theorem mem_names (a : Nat) (w : W) : a ∈ names w ↔ a ∈ w := by
  induction w with
  | nil => simp [names]
  | cons x w ih =>
    by_cases e : x ∈ w
    · simp only [names,if_pos e,ih,List.mem_cons]
      exact ⟨Or.inr, fun h => h.elim (fun eq => eq ▸ e) id⟩
    · simp [names,e,ih]
theorem names_distinct (w : W) : (names w).Nodup := by
  induction w with
  | nil => simp [names]
  | cons x w ih => by_cases e : x ∈ w <;> simp [names,e,ih]
def rank (u v : W) := (names (u ++ v)).length
theorem rank_swap (u v : W) : rank u v = rank v u := by
  apply Nat.le_antisymm
  · apply size_le (names_distinct _)
    simp [List.mem_append,Or.comm]
  · apply size_le (names_distinct _)
    simp [List.mem_append,Or.comm]
structure Model (A : Type) where
  op : A → A → A
  unit : A
  assoc : ∀ x y z, op (op x y) z = op x (op y z)
  oneL : ∀ x, op unit x = x
  oneR : ∀ x, op x unit = x
namespace Model
variable {A : Type} (M : Model A)
def eval (f : Nat → A) : W → A
  | [] => M.unit
  | x :: xs => M.op (f x) (eval f xs)
def Valid (u v : W) := ∀ f, M.eval f u = M.eval f v
theorem eval_append (f : Nat → A) (u v : W) :
    M.eval f (u ++ v) = M.op (M.eval f u) (M.eval f v) := by
  induction u with
  | nil => simp [eval,M.oneL]
  | cons x t ih => simp [eval,ih,M.assoc]
theorem eval_instance (f : Nat → A) (h : Sub) (w : W) :
    M.eval f (w.flatMap h) = M.eval (fun x => M.eval f (h x)) w := by
  induction w with
  | nil => rfl
  | cons x t ih => simp [eval,eval_append,ih]
theorem step_sound {G : W → W → Prop} (valid : ∀ u v, G u v → M.Valid u v)
    {U V : W} (s : Step G U V) : M.Valid U V := by
  obtain ⟨u,v,p,q,h,orient,_,_,_,rfl,rfl⟩ := s
  intro f
  simp only [M.eval_append,M.eval_instance]
  rcases orient with g | g
  · rw [valid u v g]
  · rw [valid v u g]
theorem derives_sound {G : W → W → Prop} (valid : ∀ u v, G u v → M.Valid u v)
    {U V : W} (walk : Derives G U V) : M.Valid U V := by
  induction walk with
  | refl => intro _; rfl
  | snoc _ st ih => exact fun f => (ih f).trans (M.step_sound valid st f)
end Model
structure RankWitness {A : Type} (M : Model A) (r : Nat) (U V D : W) : Prop where
  nonempty : U ≠ [] ∧ V ≠ []
  different : U ≠ V
  identity : M.Valid U V
  two : ∀ w, M.Valid U w → w = U ∨ w = V
  cap : P455Quotient.Cap r U
  compressed : P455SourceFamilies.Compressed r U
  distinct : D.Nodup
  participants : ∀ a ∈ D, ∃ b, proj a b U ≠ proj a b V
theorem step_rank {A : Type} {M : Model A} {r : Nat} (hr : 0 < r)
    {U V D : W} (wit : RankWitness M r U V D)
    (testers : ∀ u v, M.Valid u v → TesterRule r u v)
    {G : W → W → Prop} (valid : ∀ u v, G u v → M.Valid u v) {T : W}
    (s : Step G U T) (diff : U ≠ T) :
    ∃ u v, G u v ∧ D.length ≤ rank u v := by
  have iden := M.step_sound valid s
  have direct := (wit.two T iden).resolve_left diff.symm
  subst T
  obtain ⟨u,v,p,q,h,oriented,_,_,ne,eq1,eq2⟩ := s
  have vr : M.Valid u v := oriented.elim (valid u v) (fun rev f => (valid v u rev f).symm)
  have cover (x) (m : x ∈ u) : x ∈ names (u ++ v) := by simp [m]
  have bound : D.length ≤ rank u v := by
    apply instance_rank hr ne (eq1 ▸ wit.cap) (eq1 ▸ wit.compressed) (testers _ _ vr)
      wit.distinct cover
    simpa only [← eq1, ← eq2] using wit.participants
  rcases oriented with forward | backward
  · exact ⟨u,v,forward,bound⟩
  · exact ⟨v,u,backward,rank_swap u v ▸ bound⟩
theorem derivation_rank {A : Type} {M : Model A} {r : Nat} (hr : 0 < r)
    {U V D : W} (wit : RankWitness M r U V D)
    (testers : ∀ u v, M.Valid u v → TesterRule r u v)
    {G : W → W → Prop} (valid : ∀ u v, G u v → M.Valid u v) (path : Derives G U V) :
    ∃ u v, G u v ∧ D.length ≤ rank u v :=
  step_rank hr wit testers valid (first_change wit.different
    (fun w walk => wit.two w (M.derives_sound valid walk)) path) wit.different
theorem no_finite_basis_of_witnesses {A : Type} (M : Model A) (r : Nat) (hr : 0 < r)
    (testers : ∀ u v, M.Valid u v → TesterRule r u v)
    (witnesses : ∀ k : Nat, ∃ U V D, RankWitness M r U V D ∧ k < D.length)
    (G : List (W × W)) (valid : ∀ u v, (u,v) ∈ G → M.Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ M.Valid U V ∧ ¬ Derives (fun u v => (u,v) ∈ G) U V := by
  let sizes := G.map (fun t => rank t.1 t.2)
  obtain ⟨U,V,D,w,large⟩ := witnesses sizes.sum
  refine ⟨U,V,w.nonempty.1,w.nonempty.2,w.identity,?_⟩
  intro derivation
  obtain ⟨u,v,mem,bound⟩ := derivation_rank hr w testers valid derivation
  have inSizes : rank u v ∈ sizes := List.mem_map.mpr ⟨(u,v),mem,rfl⟩
  have less (s : List Nat) (n) (m : n ∈ s) : n ≤ s.sum := by
    induction s with
    | nil => simp at m
    | cons z t ih =>
      simp only [List.sum_cons]
      rcases List.mem_cons.mp m with e | m
      · omega
      · have := ih m; omega
  have := less sizes (rank u v) inSizes
  omega
end P455FirstRewrite
end
section
namespace P455FrameProof
open P455Closure P455EffectiveQ P455GraphPrim P455FramePrim
open P455EffectiveQMove (capB frames entries validB moveB)
variable {A B : Type} [Primcodable A] [Primcodable B]
private theorem same_decision {p : Prop} (a b : Decidable p) : @decide p a = @decide p b := by
  rw [Subsingleton.elim a b]
theorem forNames {l : A → List B} {pr : A → B → Prop} [d : ∀ a, DecidablePred (pr a)]
    (hl : Primrec l) (hp : Primrec₂ fun a b => decide (pr a b)) : PrimrecPred fun a => ∀ b∈l a,pr a b := by
  apply Primrec.primrecPred
  apply (allB hl hp).of_eq
  intro a
  apply Bool.eq_iff_iff.mpr
  simp only [List.all_eq_true,decide_eq_true_eq]
theorem capCheck {r : A → Nat} {w : A → W} (hr : Primrec r) (hw : Primrec w) :
    Primrec fun a => capB (r a) (w a) := by
  apply allB hw
  exact (Primrec.nat_le.comp (countN Primrec.snd (hw.comp Primrec.fst)) (hr.comp Primrec.fst)).decide.to₂
theorem validity {r : A → Nat} {tags : A → List Tag} {marks : A → Marks} {f : A → Frame Nat}
    (hr : Primrec r) (ht : Primrec tags) (hm : Primrec marks) (hf : Primrec f) :
    Primrec fun a => validB (r a) (tags a) (fun x y => decide ((x,y)∈marks a)) (f a) := by
  unfold validB
  apply PrimrecPred.decide
  let Fp := P455FramePrim.p.comp hf
  let Fq := P455FramePrim.q.comp hf
  let Ft := P455FramePrim.tag.comp hf
  let Fm := P455FramePrim.middle.comp hf
  have apart : PrimrecPred (fun a => ∀ x∈(f a).p, x∉(f a).q) := by
    apply forNames Fp
    exact (PrimrecPred.not (contains Primrec.snd (Fq.comp Primrec.fst)).primrecPred).decide.to₂
  have marksOK : PrimrecPred (fun a => ∀ x∈(f a).p, ∀ y∈(f a).q,
      decide ((x,y)∈marks a) = false ∧ decide ((y,x)∈marks a) = false) := by
    apply forNames Fp
    apply Primrec₂.mk
    apply PrimrecPred.decide
    apply forNames (Fq.comp Primrec.fst)
    apply Primrec₂.mk
    have old : Primrec (fun s : (A×Nat)×Nat => marks s.1.1) := (hm.comp Primrec.fst).comp Primrec.fst
    have xy : Primrec (fun s : (A×Nat)×Nat => decide ((s.1.2,s.2)∈marks s.1.1)) :=
      (contains (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd) old).of_eq (fun _ => same_decision _ _)
    have yx : Primrec (fun s : (A×Nat)×Nat => decide ((s.2,s.1.2)∈marks s.1.1)) :=
      (contains (Primrec.pair Primrec.snd (Primrec.snd.comp Primrec.fst)) old).of_eq (fun _ => same_decision _ _)
    exact (PrimrecPred.and (Primrec.eq.comp xy (.const false)) (Primrec.eq.comp yx (.const false))).decide
  have saturated : PrimrecPred (fun a => ∀ x∈(f a).p++(f a).q, ((f a).core false).count x = r a) := by
    apply forNames (Primrec.list_append.comp Fp Fq)
    exact (Primrec.eq.comp (countN Primrec.snd ((P455FramePrim.core.comp hf (.const false)).comp Primrec.fst))
      (hr.comp Primrec.fst)).decide.to₂
  apply PrimrecPred.and (Primrec.eq.comp hr (Primrec.nat_add.comp (.const 16) (Primrec.list_length.comp Ft)))
  have member : Primrec (fun a => decide ((f a).tag ∈ tags a)) := (contains Ft ht).of_eq (fun _ => same_decision _ _)
  apply PrimrecPred.and member.primrecPred
  apply PrimrecPred.and (Primrec.eq.comp (Primrec.list_map Fm (Primrec.snd.comp₂ Primrec₂.right)) (phases.comp Ft))
  apply PrimrecPred.and (nodup Fp).primrecPred
  apply PrimrecPred.and (nodup Fq).primrecPred
  apply PrimrecPred.and apart
  apply PrimrecPred.and marksOK
  exact saturated
theorem entriesRec {w : A → W} (hw : Primrec w) : Primrec fun a => entries (w a) := by
  apply Primrec.list_flatMap (wordPool.comp hw)
  apply Primrec₂.mk
  exact Primrec.list_cons.comp (Primrec.pair Primrec.snd (.const false))
    (singleton (Primrec.pair Primrec.snd (.const true)))
private def choices {X Y : Type} (xs : List X) (ys : List Y) : List (X × Y) :=
  xs.flatMap fun x => ys.map fun y => (x,y)
private theorem map_choices {X Y Z : Type} (xs : List X) (ys : List Y) (f : X × Y → Z) :
    (choices xs ys).map f = xs.flatMap fun x => ys.map fun y => f (x,y) := by
  simp only [choices, List.map_flatMap, List.map_map, Function.comp_def]
private theorem choices_rec {X Y : Type} [Primcodable X] [Primcodable Y]
    {xs : A → List X} {ys : A → List Y} (hx : Primrec xs) (hy : Primrec ys) :
    Primrec fun a => choices (xs a) (ys a) := by
  apply Primrec.list_flatMap hx
  apply Primrec₂.mk
  apply Primrec.list_map (hy.comp Primrec.fst)
  exact (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂
private abbrev Body := Nat × W × W × Nat × PairList × W × W × W
private def insertTag (t : Tag) (b : Body) : FrameData :=
  (b.1,b.2.1,b.2.2.1,b.2.2.2.1,t,b.2.2.2.2)
private theorem insert_rec : Primrec₂ insertTag := by
  apply Primrec₂.mk
  have tail1 : Primrec (fun s : Tag × Body => s.2.2) := Primrec.snd.comp Primrec.snd
  have tail2 := Primrec.snd.comp tail1
  have tail3 := Primrec.snd.comp tail2
  have tail4 := Primrec.snd.comp tail3
  exact Primrec.pair (Primrec.fst.comp Primrec.snd) (Primrec.pair (Primrec.fst.comp tail1)
    (Primrec.pair (Primrec.fst.comp tail2) (Primrec.pair (Primrec.fst.comp tail3)
    (Primrec.pair Primrec.fst tail4))))
theorem frameList {tags : A → List Tag} {w : A → W} (ht : Primrec tags) (hw : Primrec w) :
    Primrec fun a => frames (tags a) (w a) := by
  apply Primrec.list_flatMap ht
  apply Primrec₂.mk
  let U : (A × Tag) → W := fun s => w s.1
  let S : (A × Tag) → List W := fun s => P455EffectiveQ.words (U s)
  let E : (A × Tag) → List PairList := fun s =>
    Problem455Finite.wordsUpTo (entries (U s)) (fixedPhases s.2).length
  have hU : Primrec U := hw.comp Primrec.fst
  have hS : Primrec S := wordPool.comp hU
  have hE : Primrec E := wordsUpTo.comp (entriesRec hU) (Primrec.list_length.comp (phases.comp Primrec.snd))
  have bodies := choices_rec hU (choices_rec hS (choices_rec hS (choices_rec hU
    (choices_rec hE (choices_rec hS (choices_rec hS hS))))))
  have attach : Primrec₂ (fun (s : A × Tag) (b : Body) => packing.symm (insertTag s.2 b)) :=
    unpack.comp₂ (insert_rec.comp₂ (Primrec.snd.comp₂ Primrec₂.left) Primrec₂.right)
  apply (Primrec.list_map bodies attach).of_eq
  intro s
  simp only [map_choices, insertTag, packing]
  rfl
theorem literalMove {r : A → Nat} {tags : A → List Tag} {marks : A → Marks} {u v : A → W}
    (hr : Primrec r) (ht : Primrec tags) (hm : Primrec marks) (hu : Primrec u) (hv : Primrec v) :
    Primrec fun a => moveB (r a) (tags a) (fun x y => decide ((x,y)∈marks a)) (u a) (v a) := by
  apply Primrec.and.comp (Primrec.and.comp (Primrec.nat_le.comp hr (Primrec.list_length.comp hu)).decide (capCheck hr hu))
  apply anyB (frameList ht hu)
  apply Primrec₂.mk
  apply Primrec.and.comp (validity (hr.comp Primrec.fst) (ht.comp Primrec.fst) (hm.comp Primrec.fst) Primrec.snd)
  apply anyB (Primrec.const [false,true])
  apply Primrec₂.mk
  apply anyB (wordPool.comp ((hu.comp Primrec.fst).comp Primrec.fst))
  apply Primrec₂.mk
  apply anyB (wordPool.comp (((hu.comp Primrec.fst).comp Primrec.fst).comp Primrec.fst))
  apply Primrec₂.mk
  let C := ((((A × Frame Nat) × Bool) × W) × W)
  have f : Primrec (fun x : C => x.1.1.1.2) := (((Primrec.snd.comp Primrec.fst).comp Primrec.fst).comp Primrec.fst)
  have b : Primrec (fun x : C => x.1.1.2) := ((Primrec.snd.comp Primrec.fst).comp Primrec.fst)
  have l : Primrec (fun x : C => x.1.2) := (Primrec.snd.comp Primrec.fst)
  have t : Primrec (fun x : C => x.2) := Primrec.snd
  apply PrimrecPred.decide
  exact PrimrecPred.and
    (Primrec.eq.comp ((((hu.comp Primrec.fst).comp Primrec.fst).comp Primrec.fst).comp Primrec.fst) (Primrec.list_append.comp (Primrec.list_append.comp l (P455FramePrim.core.comp f b)) t))
    (Primrec.eq.comp ((((hv.comp Primrec.fst).comp Primrec.fst).comp Primrec.fst).comp Primrec.fst) (Primrec.list_append.comp (Primrec.list_append.comp l (P455FramePrim.core.comp f (Primrec.not.comp b))) t))
end P455FrameProof
