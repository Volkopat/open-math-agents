section
namespace P455ConstantLayout
open P455Witness P455SourceFamilies P455CrossedSupport P455SingletonEvaluation
open P455Uncrossed P455MarkedPath
abbrev W := List Nat
def Flip (r : Nat) (allow : Tag → Prop) (used : Nat → Nat → Prop) (s t : W) :=
  ∃ (x y : Nat) (f : P455Closure.Frame Nat) (b : Bool) (l k : W), used x y ∧
    f.p = [x] ∧ f.q = [y] ∧ f.Valid r allow (fun _ _ => False) ∧
    s = side f l k b ∧ t = side f l k (!b)
abbrev Chain (r : Nat) (allow : Tag → Prop) (used : Nat → Nat → Prop) :=
  P455Quotient.Walk (Flip r allow used)
theorem contents {r allow used U V} (path : Chain r allow used U V) (a : Nat) :
    a ∈ U ↔ a ∈ V := by
  induction path with
  | refl => rfl
  | snoc _ mv ih =>
    obtain ⟨x,y,f,b,l,k,_,_,_,_,rfl,rfl⟩ := mv
    exact ih.trans (same_letters f l k b a)
theorem clear_chain {r allow used mark T U V} (capT : P455Quotient.Cap r T)
    (path : Chain r allow used U V) (h : Nat → W)
    (clear : ∀ x y, used x y → Unmarked mark h x y) :
    P455Quotient.ofWord (rules r allow mark) T (U.flatMap h) =
      P455Quotient.ofWord (rules r allow mark) T (V.flatMap h) := by
  induction path with
  | refl => rfl
  | snoc _ mv ih =>
    obtain ⟨x,y,f,b,l,k,pair,hp,hq,valid,rfl,rfl⟩ := mv
    exact ih.trans (uncrossed_words capT f l k b x y hp hq valid h (clear x y pair))
structure Layout (r : Nat) (allow : Tag → Prop) (ts : Tiles) (endWord : Bool → W) where
  used : Nat → Nat → Prop
  path : Chain r allow used (endWord false) (endWord true)
  uniform : ∀ b, ∀ a ∈ endWord b, (endWord b).count a = r
  compressed : ∀ b, Compressed r (endWord b)
  frame : ∀ b x y, used x y → ClosedFlip r allow (endWord b) x y
  clean : ∀ b x y, used x y → ¬ Violation r allow ts (endWord b) x y
theorem compare {r allow used mark T} (capT : P455Quotient.Cap r T)
    (c : Certificate) (only : MarksOnly mark c) (endWord : Bool → W)
    (path : Chain r allow used (endWord false) (endWord true))
    (val : Nat → P455Quotient.Q (rules r allow mark) T)
    (reject : ∀ (b : Bool) (h : Nat → W),
      P455Quotient.Good (rules r allow mark) T ((endWord b).flatMap h) →
      ∀ x y, used x y → ∀ s, ¬ Crosses (markedRecord c s) h x y) :
    P455Quotient.eval (rules r allow mark) capT val (endWord false) =
      P455Quotient.eval (rules r allow mark) capT val (endWord true) := by
  classical
  apply Classical.byContradiction
  intro diff
  let R := rules r allow mark
  have live : ∃ b : Bool, P455Quotient.eval R capT val (endWord b) ≠ P455Quotient.zero R T := by
    by_cases h : P455Quotient.eval R capT val (endWord false) ≠ P455Quotient.zero R T
    · exact ⟨false,h⟩
    · exact ⟨true,fun e => diff ((Classical.not_not.mp h).trans e.symm)⟩
  obtain ⟨b,nz⟩ := live
  have existsRep (a : Nat) (ha : a ∈ endWord b) :=
    P455Quotient.nonzero_representative R (val a) (P455Quotient.live_inputs R capT val _ nz a ha)
  let h (a : Nat) := if yes : a ∈ endWord b then (existsRep a yes).choose else []
  have rep (a) (mem : a ∈ endWord b) : P455Quotient.ofWord R T (h a) = val a := by
    simpa only [h,dif_pos mem] using (existsRep a mem).choose_spec.2
  have value := P455Quotient.eval_rep R capT val _ h rep
  have good := (P455Quotient.nonzero_iff R).mp (value ▸ nz)
  have clear (x y) (use : used x y) : Unmarked mark h x y := by
    intro a ma z mz
    have nope : ¬ (mark a z ∨ mark z a) := by
      intro hit
      obtain ⟨s,cross⟩ := pick_cross only ⟨a,ma,z,mz,hit⟩
      exact reject b h good x y use s cross
    exact ⟨fun e => nope (.inl e),fun e => nope (.inr e)⟩
  have support (s : Bool) (a) (m : a ∈ endWord s) : a ∈ endWord b := by
    cases s <;> cases b
    · exact m
    · exact (contents path a).mp m
    · exact (contents path a).mpr m
    · exact m
  apply diff
  rw [P455Quotient.eval_rep R capT val (endWord false) h (fun a m => rep a (support false a m)),
      P455Quotient.eval_rep R capT val (endWord true) h (fun a m => rep a (support true a m))]
  exact clear_chain capT path h clear
theorem marked_equal {r allow ts mark T} (capT : P455Quotient.Cap r T)
    (endWord : Bool → W) (layout : Layout r allow ts endWord)
    (c : Certificate) (only : MarksOnly mark c) (tester : Holds r allow mark T (c.query r ts))
    (val : Nat → P455Quotient.Q (rules r allow mark) T) :
    P455Quotient.eval (rules r allow mark) capT val (endWord false) =
      P455Quotient.eval (rules r allow mark) capT val (endWord true) := by
  apply compare capT c only endWord layout.path val
  intro b h good x y used s cross
  apply layout.clean b x y used
  exact P455UniformCross.crossed_word capT ts c tester (endWord b) (layout.uniform b)
    (layout.compressed b) x y (layout.frame b x y used) h good s cross
end P455ConstantLayout
end
section
namespace P455ActualGuards
open P455Witness P455SourceFamilies P455GuardProduct P455SingletonEvaluation
open P455SlotSaturation P455CrossedSupport Problem455.Slots P455Paths P455SupportBound
abbrev W := List Nat
theorem matched_change {x y u w} (n : Node) (m : Matches n x y)
    (diff : select [x,y] u ≠ select [x,y] w) : select [n.owner,n.mate] u ≠ select [n.owner,n.mate] w := by
  rcases m with ⟨a,b⟩|⟨a,b⟩
  · simpa only [a,b] using diff
  · simpa only [a,b,select_pair_symm y x] using diff
theorem no_guard {r allow ts u₀ w v x y} (cap₀ : P455Closure.Cap r u₀)
    (identity : (product r allow ts).Valid u₀ w)
    (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ v)
    (g : Guard) (anchor : Matches g.anchor x y) :
    ¬ Holds r allow (markNode g.anchor) v (g.query r ts) := by
  intro bad
  obtain ⟨b,back⟩ := replay (path.symm P455Closure.Move.symm) g bad
  let c := g.withBit b
  have same : c.anchor = g.anchor := by cases g <;> rfl
  have q : Holds r allow (markNode c.anchor) u₀ (c.query r ts) := same.symm ▸ back
  obtain ⟨keep,f,len,ho,hm,kind,ax,ay,capT,read⟩ := P455GuardRename.bounded_guard cap₀ ts c q
  exact (matched_change c.anchor (same ▸ anchor) changed)
    (test_projects identity keep ho hm f c.isFunc kind len ax ay capT read)
theorem capacity {r allow mark ts u₀ w v x y} (cap₀ : P455Closure.Cap r u₀)
    (identity : (product r allow ts).Valid u₀ w)
    (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ v)
    (flip₀ : ClosedFlip r allow u₀ x y) (capV : P455Closure.Cap r v) (flipV : ClosedFlip r allow v x y)
    (cmp : Compressed r v) : Capacity r allow mark v x y 4 := by
  have unif : UniformSlots r allow mark v x y :=
    uniform_variant path (P455GuardSubproduct.uniform cap₀ identity flip₀ changed)
  apply capacity_of_no_overflow unif cmp
  intro t ball i sl xs read
  obtain ⟨tag,bit,marked⟩ := P455SlotProduct.flip_anchor capV flipV
  let n : Node := ⟨x,y,tag⟩
  have hit : ∃ side : Bool, Near r allow mark v (if side then n.mate else n.owner) t 6 :=
    ball.elim (fun h => ⟨false,h⟩) (fun h => ⟨true,h⟩)
  obtain ⟨side,p,walk,ep,len⟩ := hit
  let s : SlotCertificate := ⟨n,bit,side,p,i,.overflow xs⟩
  apply no_guard cap₀ identity changed path (.slot s) (.inl ⟨rfl,rfl⟩)
  refine ⟨marked,len,?_,True.intro⟩
  apply (route_iff ..).mpr
  exact ⟨remark_walk _ _ walk,ep.symm ▸ P455PortReflection.remark (P455GuardProduct.free_term r t i (.overflow xs)) read⟩
def EdgeViolation (r : Nat) (allow : Tag → Prop) (ts : Tiles) (v : W) (x y : Nat) :=
  ∃ (e : EdgeCertificate) (s : Bool), Matches (markedRecord (.edge e) s) x y ∧
    Holds r allow (P455SourceTheorem.sourceMarks id (.edge e)) v (e.query ts)
theorem only_edge {r allow ts u₀ w v x y} (cap₀ : P455Closure.Cap r u₀)
    (identity : (product r allow ts).Valid u₀ w)
    (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ v)
    (bad : Violation r allow ts v x y) : EdgeViolation r allow ts v x y := by
  obtain ⟨c,s,anchor,read⟩ := bad
  cases c with
  | slot p => exact False.elim (no_guard cap₀ identity changed path (.slot p) anchor read)
  | functionality f => exact False.elim (no_guard cap₀ identity changed path (.func f) anchor read)
  | edge e => exact ⟨e,s,anchor,read⟩
end P455ActualGuards
end
section
namespace P455LocalIdentity
open P455Witness P455SourceFamilies P455CrossedSupport P455SingletonEvaluation
open P455SlotSaturation P455GuardProduct P455ActualGuards P455Uncrossed
open P455MarkedPath P455Compression Problem455.Slots
abbrev W := List Nat
theorem marked_equal {r allow mark T} (capT : P455Quotient.Cap r T)
    (ts : Tiles) (c : Certificate) (only : MarksOnly mark c) (tester : Holds r allow mark T (c.query r ts))
    (f : P455Closure.Frame Nat) (l k : W) (x y : Nat) (hp : f.p = [x]) (hq : f.q = [y])
    (fv : f.Valid r allow noMark) (capF : P455Closure.Cap r (side f l k false))
    (u₀ w : W) (cap₀ : P455Closure.Cap r u₀) (identity : (product r allow ts).Valid u₀ w)
    (flip₀ : ClosedFlip r allow u₀ x y) (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (side f l k false))
    (cmp : Compressed r (side f l k false))
    (feasible : ∀ b, ¬ EdgeViolation r allow ts (side f l k b) x y)
    (v : Nat → P455Quotient.Q (rules r allow mark) T) :
    let keep := retained r allow noMark (side f l k false) x y
    P455Quotient.eval (rules r allow mark) capT v (small (side f l k false) keep) =
    P455Quotient.eval (rules r allow mark) capT v (small (side f l k true) keep) := by
  let mv : P455Closure.Move r allow noMark (side f l k false) (side f l k true) :=
    ⟨f,false,l,k,fv,rfl,rfl,capF⟩
  have per := P455RetainedVariant.same_retained (mark := noMark) mv x y
  apply Classical.byContradiction
  intro neq
  have diff : P455Quotient.eval (rules r allow mark) capT v (ruleWord r allow noMark (side f l k false) x y) ≠
      P455Quotient.eval (rules r allow mark) capT v (ruleWord r allow noMark (side f l k true) x y) := by
    intro eq
    apply neq
    dsimp only
    rw [P455RetainedVariant.small_congr_names (side f l k true) per]
    exact eq
  obtain ⟨b,bad⟩ := compare_uniform capT ts c only tester f l k x y hp hq fv capF u₀
    (P455GuardSubproduct.uniform cap₀ identity flip₀ changed) path cmp v diff
  have pb : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (side f l k b) := by
    cases b; exact path; exact .snoc path mv
  exact feasible b (only_edge cap₀ identity changed pb bad)
theorem coordinate_eval (val : Nat → Carrier r allow ts) (i : Index r allow ts) (w : W) :
    (product r allow ts).eval val w i = P455Quotient.eval i.R i.cap (fun x => val x i) w := by
  induction w with
  | nil => rfl
  | cons x w ih => exact congrArg (P455Quotient.mul i.R i.cap (val x i)) ih
theorem guard_coordinate (i : Index r allow ts) : ∃ c : Certificate,
    MarksOnly (P455SlotProduct.pairMark i.a i.b) c ∧
    Holds r allow (P455SlotProduct.pairMark i.a i.b) i.T (c.query r ts) := by
  obtain ⟨g,_,ax,ay,obs⟩ := i.accepted
  cases g with
  | slot s =>
    refine ⟨.slot s,?_,obs⟩
    intro a b h; exact ⟨false,.inl ⟨ax.trans h.1.symm,ay.trans h.2.symm⟩⟩
  | func f =>
    refine ⟨.functionality f,?_,obs⟩
    intro a b h; exact ⟨false,.inl ⟨ax.trans h.1.symm,ay.trans h.2.symm⟩⟩
end P455LocalIdentity
end
section
namespace P455PortUnique
open P455Witness P455Paths P455SourceFamilies P455CrossedSupport P455SlotSaturation
open P455SingletonEvaluation P455ActualGuards P455GuardProduct P455PortReflection Problem455.Slots
abbrev W := List Nat
private theorem tag_unique {a b : Nat} (ne : a ≠ b) (s t : Tag) (p q : W)
    (len : s.length = t.length) (eq : s.flatMap (pair a b) ++ p = t.flatMap (pair a b) ++ q) : s = t := by
  induction s generalizing t with
  | nil => cases t <;> simp_all
  | cons x s ih =>
    cases t with
    | nil => simp at len
    | cons y t =>
      have lk : s.length = t.length := by simpa using len
      cases x <;> cases y <;> simp [List.flatMap_cons,pair,List.append_assoc,ne,Ne.symm ne] at eq ⊢
      all_goals exact ih _ lk eq
theorem node_unique {r allow mark w} (a b : Node) (own : a.owner = b.owner) (mate : a.mate = b.mate)
    (oa : Holds r allow mark w (typedNode a)) (ob : Holds r allow mark w (typedNode b)) : a = b := by
  obtain ⟨x,y,s⟩ := a; obtain ⟨z,t,v⟩ := b
  dsimp at own mate; subst z; subst t
  obtain ⟨ne,len,_,i,hi⟩ := oa
  obtain ⟨_,len',_,j,hj⟩ := ob
  change s.length+16 = r at len; change v.length+16 = r at len'
  have e : profile x y s i = profile x y v j := hi.symm.trans hj
  let pre := [x,x,y,x,y,y] ++ (List.replicate 5 [x,y,x,y]).flatten
  let post := fun bit => [x,y] ++ (pair x y bit ++ [x,y])
  have eq : pre ++ (s.flatMap (pair x y) ++ post i) = pre ++ (v.flatMap (pair x y) ++ post j) := by
    simpa only [pre,post,profile,profilePrefix,List.append_assoc] using e
  have := tag_unique ne s v _ _ (by omega) (List.append_cancel_left eq)
  cases this; rfl
theorem functional {r allow mark ts u₀ w v x y} (cap₀ : P455Closure.Cap r u₀)
    (valid : (product r allow ts).Valid u₀ w) (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ v)
    (cmp : Compressed r v) (n : Node) (side : Matches n x y)
    (recProof : Holds r allow mark v (typedNode n)) : P455GridRows.Functional r allow mark v ts n := by
  intro dir a b nb nc
  obtain ⟨ne,len,tag,bit,proj⟩ := recProof
  have anchor : Holds r allow (markNode n) v (markedNode n bit) := ⟨ne,len,tag,.inl ⟨rfl,rfl⟩,proj⟩
  have roleeq (k : Bool) : roleOf k a = roleOf k b := by
    apply Classical.byContradiction; intro d
    let f : FunctionalityCertificate := ⟨n,bit,a,b,dir,k⟩
    exact no_guard cap₀ valid changed path (.func f) side
      ⟨anchor,neighbor_remark nb,neighbor_remark nc,compressed_separates cmp d,True.intro⟩
  exact node_unique a b (roleeq false) (roleeq true) (neighbor_target_record nb) (neighbor_target_record nc)
end P455PortUnique
end
section
namespace P455BinaryEquality
open P455Witness P455Closure P455Uncrossed P455SlotSaturation P455FirstTesters
open Problem455.Slots
abbrev W := List Nat
def BinaryNames (T : W) := ∀ a ∈ T, a = 0 ∨ a = 1
def IsProfile (r : Nat) (allow : Tag → Prop) (T : W) :=
  ∃ a b tag bit, a ≠ b ∧ tag.length+16 = r ∧ allow tag ∧ T = profile a b tag bit
theorem binary_move_profile {r allow T V} (h : Move r allow noMark T V)
    (two : BinaryNames T) : IsProfile r allow T := by
  obtain ⟨f,bit,l,k,ok,rfl,_,cap⟩ := h
  let a := f.pHead
  let b := f.qLast
  have ap : a ∈ f.p := by simp [a,Frame.p]
  have bq : b ∈ f.q := by simp [b,Frame.q]
  have ab := fun e : a = b => ok.2.2.2.2.2.1 a ap (e ▸ bq)
  have hr : 0 < r := by have := ok.1; omega
  have mem (z : Nat) (hz : z ∈ f.p ∨ z ∈ f.q) : z ∈ l ++ f.core bit ++ k := by
    have count : (f.core bit).count z = r := by
      have cz := ok.2.2.2.2.2.2.2 z hz
      cases bit; exact cz; exact (f.count_core z true).trans cz
    have ins := List.count_pos_iff.mp (count.symm ▸ hr)
    simp [ins]
  have az := two _ (mem a (.inl ap))
  have bz := two _ (mem b (.inr bq))
  have all : ∀ z ∈ l ++ f.core bit ++ k, z = a ∨ z = b := by
    intro z hz; rcases az with ha|ha <;> rcases bz with hb|hb <;> rcases two _ hz with h|h <;> simp_all
  have pr := f.cross_projection ok bit l k cap a b ap bq
  have eq : (l ++ f.core bit ++ k).filter (fun z => decide (z = a ∨ z = b)) = _ :=
    List.filter_eq_self.mpr (fun z hz => decide_eq_true (all z hz))
  rw [eq,P455SlotProduct.profile_eq] at pr
  exact ⟨a,b,f.tag,bit,ab,by have := ok.1; omega,ok.2.1,pr⟩
theorem no_move_in_factor {r allow U V T} (capT : Cap r T) (two : BinaryNames T)
    (plainT : ¬ IsProfile r allow T) (factor : P455Quotient.Factor U T) : ¬ Move r allow noMark U V := by
  rintro mv
  obtain ⟨l,k,rfl⟩ := factor
  exact plainT (binary_move_profile (mv.extend_of_cap l k capT) two)
theorem plain_good {r T U} (g : P455Quotient.Good (plain r) T U) : P455Quotient.Factor U T := by
  obtain ⟨v,p,h⟩ := g
  have eq : T = v := by
    induction p with
    | refl => rfl
    | snoc _ bad _ => exact False.elim bad
  exact eq ▸ h
theorem plain_equal {r allow T} (capT : Cap r T) (two : BinaryNames T) (plainT : ¬ IsProfile r allow T)
    (f : Frame Nat) (l k : W) (x y : Nat) (hp : f.p = [x]) (hq : f.q = [y])
    (v : f.Valid r allow noMark) (val : Nat → P455Quotient.Q (plain r) T) :
    P455Quotient.eval (plain r) capT val (side f l k false) =
    P455Quotient.eval (plain r) capT val (side f l k true) := by
  classical
  let R := plain r
  let E := fun b => P455Quotient.eval R capT val (side f l k b)
  have one (b : Bool) (nz : E b ≠ P455Quotient.zero R T) : E b = E (!b) := by
    have rep (a) (h : a ∈ side f l k b) :=
      P455Quotient.nonzero_representative R _ (P455Quotient.live_inputs R capT val _ nz a h)
    let h a := if m : a ∈ side f l k b then (rep a m).choose else []
    have reps (a) (m : a ∈ side f l k b) : P455Quotient.ofWord R T (h a) = val a := by
      simpa only [h,dif_pos m] using (rep a m).choose_spec.2
    have eq := P455Quotient.eval_rep R capT val _ h reps
    change P455Quotient.eval R capT val (side f l k b) ≠ _ at nz
    have good := (P455Quotient.nonzero_iff R).mp (eq ▸ nz)
    have cap := P455Quotient.good_cap R capT good
    rcases equal_or_move f l k b x y hp hq v h (mark := noMark) (fun _ _ _ _ => ⟨id,id⟩) cap with raw|move
    · change P455Quotient.eval R capT val _ = P455Quotient.eval R capT val _
      rw [eq,raw,P455Quotient.eval_rep R capT val (side f l k (!b)) h
        (fun a m => reps a ((same_letters f l k b a).mpr m))]
    · exact False.elim (no_move_in_factor capT two plainT (plain_good good) move)
  by_cases zero : E false = P455Quotient.zero R T
  · by_cases z : E true = P455Quotient.zero R T
    · exact zero.trans z.symm
    · exact (one true z).symm
  · exact one false zero
end P455BinaryEquality
end
