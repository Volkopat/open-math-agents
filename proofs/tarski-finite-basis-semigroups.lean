namespace P455FlipFromWord
open P455Witness P455Closure P455ChartSchedule P455Structural P455CellClassFrames Problem455.Slots
abbrev W := List Nat
private theorem profile_head (x y : Nat) (tag : Tag) :
    profilePrefix x y tag = early x y ++ phase x y tag := by
  have tags : (tag.flatMap phasePair).map (token x y) = tag.flatMap (Problem455.Slots.pair x y) := by
    induction tag with
    | nil => rfl
    | cons c cs ih => cases c <;> simp [List.flatMap_cons,ih,phasePair,token,Problem455.Slots.pair]
  simp [profilePrefix,early,phase,fixedPhases,List.replicate_succ,tags,phasePair,token]
theorem literal {r allow} (n : Node) (pre post : W) (b : Bool)
    (cap : P455Closure.Cap r (pre++Problem455.Slots.pair n.owner n.mate b++post))
    (recProof : Holds r allow (fun _ _ => False) (pre++Problem455.Slots.pair n.owner n.mate b++post) (typedNode n))
    (clean : Closed (pre++Problem455.Slots.pair n.owner n.mate b++post) n.owner n.mate)
    (cx : pre.count n.owner = r-2) (cy : pre.count n.mate = r-2) :
    Nonempty (Literal r allow (pre++Problem455.Slots.pair n.owner n.mate b++post)
      (pre++Problem455.Slots.pair n.owner n.mate (!b)++post) n) := by
  let x := n.owner
  let y := n.mate
  let k := [x,y]
  obtain ⟨ne,len,allowed,b',pr⟩ := recProof
  have neq : x≠y := ne
  have projPair (c : Bool) : select k (Problem455.Slots.pair x y c) = Problem455.Slots.pair x y c := by
    cases c <;> simp [select,Problem455.Slots.pair,k]
  change select k (pre++Problem455.Slots.pair x y b++post) = profile x y n.tag b' at pr
  rw [select_append, select_append, projPair,profile,List.append_assoc] at pr
  have length : (select k pre).length = (profilePrefix x y n.tag).length := by
    rw [length_select_pair _ _ neq,profile_prefix_length]
    change pre.count n.owner + pre.count n.mate = 2*(14+n.tag.length)
    omega
  obtain ⟨headEq,tailEq⟩ := List.append_inj pr length
  obtain ⟨_,endEq⟩ := List.append_inj tailEq (by cases b <;> cases b' <;> rfl)
  obtain ⟨_,l,t,cut,lx,ly⟩ := clean
  have prefix₁ : (l++early x y) <+: (pre++Problem455.Slots.pair x y b++post) := ⟨t,cut.symm⟩
  have prefix₂ : pre <+: (pre++Problem455.Slots.pair x y b++post) :=
    ⟨_,(List.append_assoc ..).symm⟩
  have before : (l++early x y) <+: pre := by
    rcases List.prefix_or_prefix_of_prefix prefix₁ prefix₂ with yes|reverse
    · exact yes
    · obtain ⟨u,eq⟩ := reverse
      have h := congrArg (List.count x) eq
      have nl : l.count x = 0 := List.count_eq_zero.mpr lx
      have small : (early x y).count x = 3 := by simp [early,List.count_cons,neq,Ne.symm neq]
      simp only [List.count_append,nl,small,Nat.zero_add] at h
      change pre.count x = r-2 at cx; omega
  obtain ⟨m,meq⟩ := before
  have erase : select k l=[] := select_nil _ _ (fun z mem h => by
    rcases (show z = x ∨ z = y by simpa [k] using h) with rfl|rfl
    · exact lx mem
    · exact ly mem)
  have fixedEarly : select k (early x y) = early x y := by simp [select,k,early]
  rw [← meq,select_append,select_append,erase,fixedEarly,List.nil_append,profile_head] at headEq
  have mid := List.append_cancel_left headEq
  have subM : (phase x y n.tag).Sublist m := mid ▸ List.filter_sublist ..
  have subZ : [x,y].Sublist post := endEq ▸ List.filter_sublist ..
  have cc : P455Closure.Cap r (displayed l x y m post false) := by
    intro a
    have h := cap a
    have eq (c : Bool) : (Problem455.Slots.pair x y c).count a =
        (Problem455.Slots.pair x y false).count a := by
      cases c <;> simp [Problem455.Slots.pair,List.count_cons,Nat.add_comm,Nat.add_left_comm]
    change (pre++Problem455.Slots.pair x y b++post).count a ≤ r at h
    simp only [← meq,displayed,List.count_append,eq b] at h ⊢
    exact h
  obtain ⟨f,h,hp,hq,hf,words⟩ := from_phases neq n.tag len allowed l m post subM subZ cc
  refine ⟨⟨f,b,l,h,hp,hq,hf,?_,?_⟩⟩ <;>
    simpa only [x,y,displayed,meq] using (words _)
end P455FlipFromWord
end
section
namespace P455CellClassGrid
open P455RectangleRank P455PaddedMatchings P455PaddedTiles P455PaddedWord P455Witness
open P455CellClassClean P455CellClassFrames P455SlotSaturation P455GridRows Problem455.Slots
noncomputable section
variable {n w h : Nat} {M : MachineTable n}
def labels (R : Rectangle M w h) := tagAt w R.tag
theorem label_at (R : Rectangle M w h) {y x : Nat} (_hy : y < h) (hx : x < w) :
    labels R (idAt w y x) = R.tag y x := tag_id R.tag hx
def zero (R : Rectangle M w h) := text h w (widthCode n) (labels R) (constant false)
def cell (R : Rectangle M w h) (y x : Nat) := node (labels R) (idAt w y x)
abbrev H (R : Rectangle M w h) := Holds (widthCode n+16) (allowed M) noMark (zero R)
theorem coordinates {R : Rectangle M w h} {y x : Nat} (hy : y < h) (hx : x < w) :
    (cell R y x).tag = R.tag y x := label_at R hy hx
def literal_phases (R : Rectangle M w h) (size : 1 < w*h) :
    Phases (widthCode n+16) (allowed M) (w*h) (middle h w (widthCode n) (labels R)) (tail (w*h)) := by
  have yes (i : Nat) (ix : i < w*h) : allowed M (labels R i) := by
    obtain ⟨y,hy,x,hx,rfl⟩ := id_covers ix
    rw [label_at R hy hx]; exact R.eligible y hy x hx
  exact P455CellClassPadded.phases size (labels R) (fun i ix => by
    obtain ⟨tile,eq,_⟩ := yes i ix; rw [← eq,code_length]) yes
theorem cell_typed (R : Rectangle M w h) (size : 1 < w*h) {i : Nat} (ix : i < w*h) :
    H R (typedNode (node (labels R) i)) := typed_cell (literal_phases R size) (constant false) ix noMark
theorem any_record (R : Rectangle M w h) (size : 1 < w*h) (u : Node) (read : H R (typedNode u)) :
    ∃ y < h, ∃ x < w,u = cell R y x := by
  obtain ⟨i,ix,own,mate⟩ := record_roles (constant false) (P455CellClassPadded.names size _ _)
    (P455CellClass.canonical_final _) u read
  have equal := P455PortUnique.node_unique u (node (labels R) i) own mate read (cell_typed R size ix)
  obtain ⟨y,hy,x,hx,eq⟩ := id_covers ix
  exact ⟨y,hy,x,hx,by simpa [cell,eq] using equal⟩
structure Orders (R : Rectangle M w h) : Prop where
  early : ∀ i < w*h,∀ j < w*h,i≠j → H R (earlyDisjoint (P455PaddedPorts.roles i) (P455PaddedPorts.roles j))
  column : ∀ y < h,∀ x, x+1 < w → H R (earlier (owner (idAt w y x)) (13+widthCode n)
      (owner (idAt w y (x+1))) (13+widthCode n))
  first : ∀ i j, i < j → j < w*h → H R (earlier (owner i) 0 (owner j) 0)
theorem orders (R : Rectangle M w h) (size : 1 < w*h) : Orders R :=
  ⟨fun _ hi _ hj ne => early_groups size (labels R) (constant false) (allowed M) noMark ne hi hj,
   fun _ hy _ slope => column_order size (labels R) (constant false) (allowed M) noMark hy slope,
   fun _ _ lt hj => first_owner size (labels R) (constant false) (allowed M) noMark lt hj⟩
theorem port {R : Rectangle M w h} (size : 1 < w*h) (ord : Orders R) (p : Fin 5) {i j}
    (lt : i < w*h) (jt : j < w*h) (ne : i≠j) :
    H R (orientedPort p.val (node (labels R) i) (node (labels R) j)) ↔
      P455PaddedPorts.Block.pair i j ∈ matching h w p.val := by
  have iff := port_iff (k:=widthCode n) size (labels R) (constant false) (allowed M) noMark p ne lt jt
  exact ⟨fun r => (iff.mp r).2.2.2,fun yes => iff.mpr
    ⟨cell_typed R size lt,cell_typed R size jt,ord.early i lt j jt ne,yes⟩⟩
private theorem codeLen (R : Rectangle M w h) {y x : Nat} (hy : y < h) (hx : x < w) :
    (cell R y x).tag.length = widthCode n := by
  obtain ⟨tile,eq,_⟩ := R.eligible y hy x hx; rw [coordinates hy hx,← eq,code_length]
theorem right_iff (R : Rectangle M w h) (size : 1 < w*h) (ord : Orders R) {y x v z : Nat}
    (hy : y < h) (hx : x < w) (hv : v < h) (hz : z < w) :
    H R (rightward (system n) (cell R y x) (cell R v z)) ↔ y = v ∧ x+1 = z := by
  let i := idAt w y x
  let j := idAt w v z
  have li : i < w*h := id_bound hy hx
  have lj : j < w*h := id_bound hv hz
  have col : (system n).oddColumn (cell R y x).tag = odd x := (coordinates hy hx) ▸ (R.flags y hy x hx).2.2.2.2.2
  let p : Fin 5 := ⟨if odd x then 1 else 0,by split <;> decide⟩
  have matchId : matching h w p.val = horizontal h w (odd x) := by cases e : odd x <;> simp [p,matching,e]
  have edges : H R (orientedPort p.val (cell R y x) (cell R v z)) → i≠j →
      P455PaddedPorts.Block.pair i j ∈ horizontal h w (odd x) := by
    intro read ne; rw [← matchId]; exact (port size ord p li lj ne).mp read
  constructor
  · rintro ⟨horiz,read,_,_⟩
    have ne : i≠j := by
      intro eq; obtain ⟨rfl,rfl⟩ := id_inj hx hz eq
      obtain ⟨a,b,pa,pb,good⟩ := horiz
      have same := code_inj (pa.trans pb.symm)
      exact good.2.2.2.2.2.1 (congrArg Tile.oddColumn same)
    rw [col] at read
    obtain ⟨Y,_,X,Xp,_,e1,e2⟩ := (horizontal_edge ..).mp (edges read ne)
    obtain ⟨yy,xx⟩ := id_inj hx (show X < w by omega) e1
    obtain ⟨vv,zz⟩ := id_inj hz Xp e2
    omega
  · rintro ⟨rfl,rfl⟩
    have ne : i≠j := fun eq => by obtain ⟨_,err⟩ := id_inj hx hz eq; omega
    have has : P455PaddedPorts.Block.pair i j ∈ horizontal h w (odd x) :=
      (horizontal_edge ..).mpr ⟨y,hy,x,hz,rfl,rfl,rfl⟩
    have read := (port size ord p li lj ne).mpr (matchId ▸ has)
    refine ⟨?_,?_,?_,True.intro⟩
    · change (system n).horizontal _ _; rw [coordinates hy hx,coordinates hy hz]; exact R.right y hy x hz
    · change H R (orientedPort _ _ _); rw [col]; exact read
    · rw [codeLen R hy hx]; exact ord.column y hy x hz
theorem down_iff (R : Rectangle M w h) (size : 1 < w*h) (ord : Orders R) {y x v z : Nat}
    (hy : y < h) (hx : x < w) (hv : v < h) (hz : z < w) :
    H R (downward (system n) (cell R y x) (cell R v z)) ↔ y+1 = v ∧ x = z := by
  let i := idAt w y x
  let j := idAt w v z
  have li : i < w*h := id_bound hy hx
  have lj : j < w*h := id_bound hv hz
  have row : (system n).oddRow (cell R y x).tag = odd y := (coordinates hy hx) ▸ (R.flags y hy x hx).2.2.2.2.1
  let p : Fin 5 := ⟨if odd y then 3 else 2,by split <;> decide⟩
  have matchId : matching h w p.val = vertical h w (odd y) := by cases e : odd y <;> simp [p,matching,e]
  constructor
  · rintro ⟨vert,read⟩
    have ne : i≠j := by
      intro eq; obtain ⟨rfl,rfl⟩ := id_inj hx hz eq
      obtain ⟨a,b,pa,pb,good⟩ := vert
      have same := code_inj (pa.trans pb.symm)
      exact good.2.2.2.2.2.1 (congrArg Tile.oddRow same)
    rw [row] at read
    have has := (port size ord p li lj ne).mp read
    rw [matchId] at has
    obtain ⟨X,_,Y,Yp,_,e1,e2⟩ := (vertical_edge ..).mp has
    obtain ⟨yy,xx⟩ := id_inj hx (by assumption) e1
    obtain ⟨vv,zz⟩ := id_inj hz (by assumption) e2
    omega
  · rintro ⟨rfl,rfl⟩
    have ne : i≠j := fun eq => by obtain ⟨err,_⟩ := id_inj hx hz eq; omega
    have has : P455PaddedPorts.Block.pair i j ∈ vertical h w (odd y) :=
      (vertical_edge ..).mpr ⟨x,hx,y,hv,rfl,rfl,rfl⟩
    refine ⟨?_,?_⟩
    · change (system n).vertical _ _; rw [coordinates hy hx,coordinates hv hx]; exact R.down y hv x hx
    · change H R (orientedPort _ _ _); rw [row]; exact (port size ord p li lj ne).mpr (matchId ▸ has)
theorem functional {R : Rectangle M w h} (size : 1 < w*h) (ord : Orders R) :
    Ports (widthCode n+16) (allowed M) (system n) (zero R) := by
  intro a recProof d b c nb nc
  obtain ⟨y,hy,x,hx,rfl⟩ := any_record R size a recProof
  obtain ⟨v,hv,z,hz,rfl⟩ := any_record R size b (P455Paths.neighbor_target_record nb)
  obtain ⟨s,hs,q,hq,rfl⟩ := any_record R size c (P455Paths.neighbor_target_record nc)
  have positions : v = s ∧ z = q := by
    cases d with
    | right =>
      have := (right_iff R size ord hy hx hv hz).mp nb
      have := (right_iff R size ord hy hx hs hq).mp nc
      omega
    | left =>
      have := (right_iff R size ord hv hz hy hx).mp nb
      have := (right_iff R size ord hs hq hy hx).mp nc
      omega
    | down =>
      have := (down_iff R size ord hy hx hv hz).mp nb
      have := (down_iff R size ord hy hx hs hq).mp nc
      omega
    | up =>
      have := (down_iff R size ord hv hz hy hx).mp nb
      have := (down_iff R size ord hs hq hy hx).mp nc
      omega
  rw [positions.1,positions.2]
end
end P455CellClassGrid
end
section
namespace P455Prefix
open P455Quotient P455FirstRewrite P455Witness P455Structural Problem455.Slots
open Problem455Swap (Link)
open P455DefectProjection (select_cap)
private theorem linked_changes {r b c a} {u v : Word} (cu : Cap r u) (cv : Cap r v)
    (ul : Link r u b c) (vl : Link r v b c) (bc : b≠c) (ba : b≠a) (ca : c≠a) :
    Changed u v b a ↔ Changed u v c a := by
  have hu := linked_shadow cu ul bc ba ca
  have hv := linked_shadow cv vl bc ba ca
  let d := exchange b c
  have dd : d ∘ d = id := by
    funext y; by_cases x : y = b <;> by_cases z : y = c <;> simp_all [d,exchange,Function.comp_def,Ne.symm]
  have inj (t s : Word) (h : t.map d = s.map d) : t = s := by
    have both := congrArg (List.map d) h
    simpa only [List.map_map,dd,List.map_id_fun,id_eq] using both
  constructor
  · intro changed equal
    exact changed (hu.symm.trans ((congrArg (List.map d) equal).trans hv))
  · intro changed equal
    apply changed; apply inj; rw [show (select [c,a] u).map d = select [b,a] u from hu,
      show (select [c,a] v).map d = select [b,a] v from hv,equal]
private theorem edge_ne {r allow u a c} (e : Edge u r allow a c) : a≠c := by
  rcases e with ⟨_,h,_,_,_⟩|⟨_,h,_,_,_⟩
  · exact h
  · exact Ne.symm h
theorem incident_record {r allow ts u v a b c} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (cmp : P455SourceFamilies.Compressed r u)
    (ab : a≠b) (eb : Changed u v a b) (ec : Edge u r allow a c) : b = c := by
  by_cases bc : b = c
  · exact bc
  have ac := edge_ne ec
  let k := [a,b,c]
  have ma : a∈k := by simp [k]
  have mb : b∈k := by simp [k]
  have mc : c∈k := by simp [k]
  have id3 := select_valid _ k valid
  have cu := select_cap k cap
  have cv : Cap r (select k v) := fun t => P455CellClassBinary.exact_counts cu id3 t ▸ cu t
  have left := changed_symm.mp ((selected_change k ma mb).mpr eb)
  have right : Changed (select k u) (select k v) c a := by
    rcases neighbors_link hr cap valid ab ac bc eb ec with l|l
    · exact (linked_changes cu cv l ((identity_link hr cu id3 b c).mp l) bc ab.symm ac.symm).mp left
    · exact (linked_changes cu cv l ((identity_link hr cu id3 c b).mp l) (Ne.symm bc) ac.symm ab.symm).mpr left
  exact disjoint_changes hr cap valid cmp ab ac eb ((selected_change k ma mc).mp (changed_symm.mpr right))
theorem isolated_pair {r allow ts u v a b} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (cmp : P455SourceFamilies.Compressed r u)
    (ab : a≠b) (edit : Changed u v a b) :
    (∀ c, Edge u r allow a c → b = c) ∧ (∀ c, Edge u r allow b c → a = c) :=
  ⟨fun _ recProof => incident_record hr cap valid cmp ab edit recProof,
   fun _ recProof => incident_record hr cap valid cmp ab.symm (changed_symm.mp edit) recProof⟩
end P455Prefix
end
section
namespace P455ImmutablePrivate
open P455Structural Problem455.Slots
abbrev W := List Nat
private def initial (a b : Nat) : List Event := [(a,0),(a,1),(b,0),(a,2),(b,1),(b,2)]
theorem stamp_length (n : Nat → Nat) (w : W) : (stamp n w).length = w.length := by
  induction w generalizing n with
  | nil => rfl
  | cons a w ih => simp [stamp,ih]
theorem read_names (n : Nat → Nat) (w : W) : (stamp n w).map Prod.fst = w := by
  induction w generalizing n with
  | nil => rfl
  | cons a w ih => simp [stamp,ih]
private theorem stamp_low {n : Nat → Nat} {w : W} {a i : Nat} (m : (a,i)∈stamp n w) : n a ≤ i := by
  induction w generalizing n with
  | nil => contradiction
  | cons b w ih =>
    rcases List.mem_cons.mp m with h|h
    · cases h; exact Nat.le_refl _
    · have lower := ih h
      simp only [advance] at lower; omega
private theorem whole_core {a b : Nat} (ne : a≠b) (l : W) (ax : a∉l) (bx : b∉l) (q : W) :
    events (l++early a b++q) = events l ++ (initial a b ++ stamp (advance (fun _ => 0) (l++early a b)) q) := by
  have la := List.count_eq_zero.mpr ax
  have lb := List.count_eq_zero.mpr bx
  simp [events,stamp_append,initial,early,stamp,advance,List.count_cons,ne,Ne.symm ne,la,lb]
  simp only [advance_append,List.append_assoc,List.singleton_append,List.nil_append]
  rfl
private theorem prefix_of_reads {α : Type} (xs ys : List α)
    (same : ∀ (i : Nat) (e : α), xs[i]?=some e → ys[i]?=some e) : xs <+: ys := by
  induction xs generalizing ys with
  | nil => simp
  | cons a xs ih =>
    have first := same 0 a rfl
    cases ys with
    | nil => contradiction
    | cons b ys =>
      have ab : b = a := Option.some.inj first
      subst b
      obtain ⟨q,eq⟩ := ih ys (fun i e h => same (i+1) e h)
      exact ⟨q,congrArg (List.cons a) eq⟩
theorem closed_transport {r : Nat} {u v : W} {a b : Nat} (hr : 5 ≤ r)
    (closed : Closed u a b)
    (agree : ∀ (i : Nat) (e : Event), (events u)[i]?=some e → e.2≠r-2 → (events v)[i]?=some e) :
    Closed v a b := by
  obtain ⟨ne,l,q,eu,ax,bx⟩ := closed
  let old := initial a b
  have core := whole_core ne l ax bx q
  have atNew (j : Nat) (e : Event) (someE : old[j]?=some e) :
      (events v)[l.length+j]?=some e := by
    obtain ⟨bound,fnd⟩ := List.getElem?_eq_some_iff.mp someE
    have mem : e ∈ old := fnd ▸ List.getElem_mem bound
    have small : e.2 ≤ 2 := by
      simp only [old,initial,List.mem_cons,List.not_mem_nil,or_false] at mem
      rcases mem with h|h|h|h|h|h <;> rw [h] <;> simp
    apply agree _ _ _ (by omega)
    rw [eu,core,List.getElem?_append_right (by
      change (stamp (fun _ => 0) l).length ≤ l.length+j
      rw [stamp_length]; omega)]
    simp only [events,stamp_length,Nat.add_sub_cancel_left]
    exact (List.getElem?_append_left bound).trans someE
  have vlen : l.length < v.length := by
    have m := atNew 0 (a,0) rfl
    obtain ⟨lt,_⟩ := List.getElem?_eq_some_iff.mp m
    simpa [events,stamp_length] using lt
  let low := v.take l.length
  let hi := v.drop l.length
  have split : low++hi = v := List.take_append_drop ..
  have ll : (stamp (fun _ => 0) low).length = l.length := by
    simp [stamp_length,low,Nat.min_eq_left (Nat.le_of_lt vlen)]
  have tail : old <+: stamp (advance (fun _ => 0) low) hi := by
    apply prefix_of_reads
    intro i e got
    have m := atNew i e got
    change (stamp (fun _ => 0) v)[l.length+i]?=some e at m
    rw [←split,stamp_append,List.getElem?_append_right (by omega),ll] at m
    simpa only [show l.length+i-l.length = i by omega] using m
  obtain ⟨z,ez⟩ := tail
  have lowFirst (c : Nat) (h : (c,0) ∈ old) : c∉low := by
    have m : (c,0)∈stamp (advance (fun _ => 0) low) hi := ez ▸ List.mem_append_left z h
    have le := stamp_low m
    change 0+low.count c ≤ 0 at le
    exact List.count_eq_zero.mp (by omega)
  have fst := congrArg (List.map Prod.fst) ez
  simp only [List.map_append,read_names] at fst
  change early a b ++ List.map Prod.fst z = hi at fst
  exact ⟨ne,low,z.map Prod.fst,by rw [←split,←fst]; simp [List.append_assoc],
    lowFirst a (by simp [old,initial]),lowFirst b (by simp [old,initial])⟩
end P455ImmutablePrivate
end
section
namespace P455CellClassHalting
open P455RectangleRank P455PaddedMatchings P455PaddedTiles P455PaddedWord P455Witness
open P455CellClassGrid P455CellClassClean P455CellClassSnake P455SlotSaturation P455GridRows
variable {n w h : Nat} {M : MachineTable n}
private def cert (R : Rectangle M w h) (y x v z : Nat) : EdgeCertificate :=
  ⟨cell R y x,cell R v z,cell R y (x+1),cell R y (x-1),cell R (y+1) x,cell R (y-1) x,cell R (y+1) (x+1)⟩
private theorem guard {R : Rectangle M w h} {b : Bool} {q : Query}
    (met : b = true → H R q) : H R (flagQ b q) := by
  cases b <;> first | exact True.intro | exact met rfl
theorem local_grid (R : Rectangle M w h) (size : 1 < w*h) {y x : Nat} (hy : y < h) (hx : x < w)
    (v z : Nat) : H R (localCert (system n) (cert R y x v z)) := by
  have flags := R.flags y hy x hx
  rw [← coordinates (R:=R) hy hx] at flags
  let a := cell R y x
  have right (on : (!(system n).right a.tag) = true) : x+1 < w := by
    by_cases e : x+1 = w
    · change (!(system n).right (cell R y x).tag) = true at on; rw [flags.2.1] at on; simp [e] at on
    · omega
  have left (on : (!(system n).left a.tag) = true) : 0 < x := by
    by_cases e : x = 0
    · change (!(system n).left (cell R y x).tag) = true at on; rw [flags.1] at on; simp [e] at on
    · omega
  have down (on : (!(system n).bottom a.tag) = true) : y+1 < h := by
    by_cases e : y+1 = h
    · change (!(system n).bottom (cell R y x).tag) = true at on; rw [flags.2.2.2.1] at on; simp [e] at on
    · omega
  have up (on : (!(system n).top a.tag) = true) : 0 < y := by
    by_cases e : y = 0
    · change (!(system n).top (cell R y x).tag) = true at on; rw [flags.2.2.1] at on; simp [e] at on
    · omega
  let ord := orders R size
  refine ⟨guard (fun on => (right_iff R size ord hy hx hy (right on)).mpr ⟨rfl,rfl⟩),
    guard (fun on => (right_iff R size ord hy (by have := left on; omega) hy hx).mpr
      ⟨rfl,by have := left on; omega⟩),
    guard (fun on => (down_iff R size ord hy hx (down on) hx).mpr ⟨rfl,rfl⟩),
    guard (fun on => (down_iff R size ord (by have := up on; omega) hx hy hx).mpr
      ⟨by have := up on; omega,rfl⟩),guard ?_,True.intro⟩
  intro on; obtain ⟨rr,dd⟩ := Bool.and_eq_true_iff.mp on
  exact ⟨(down_iff R size ord hy (right rr) (down dd) (right rr)).mpr ⟨rfl,rfl⟩,
    (right_iff R size ord (down dd) hx (down dd) (right rr)).mpr ⟨rfl,rfl⟩⟩
private theorem end_flag (R : Rectangle M w h) {y x} (hy : y < h) (hx : x < w) :
    endOfRow (system n) (cell R y x) = (if odd y then decide (x = 0) else decide (x+1 = w)) := by
  have f := R.flags y hy x hx
  simp [endOfRow,coordinates hy hx,f.1,f.2.1,f.2.2.2.2.1]
theorem next_grid (R : Rectangle M w h) (size : 1 < w*h) {i : Nat} (lt : i+1 < w*h) :
    At (widthCode n+16) (allowed M) (system n) (zero R) i (i+1) := by
  obtain ⟨y,hy,x,hx,v,hv,z,hz,si,sj,next⟩ := stepping lt
  let e := cert R y x v z
  have readA : H R (typedNode e.a) := cell_typed R size (id_bound hy hx)
  have readB : H R (typedNode e.b) := cell_typed R size (id_bound hv hz)
  have early := (orders R size).first i (i+1) (by omega) lt
  have go : H R (earlier e.a.owner 0 e.b.owner 0) := by
    simpa only [e,cert,cell,node,si,sj] using early
  have f := R.flags y hy x hx
  have finish := end_flag R hy hx
  change endOfRow (system n) e.a = _ at finish
  have row : (system n).oddRow e.a.tag = odd y := by change (system n).oddRow (cell R y x).tag = _; rw [coordinates hy hx,f.2.2.2.2.1]
  have bot : (system n).bottom e.a.tag = decide (y+1 = h) := by change (system n).bottom (cell R y x).tag = _; rw [coordinates hy hx,f.2.2.2.1]
  refine ⟨e,congrArg owner si,congrArg mate si,congrArg owner sj,congrArg mate sj,readA,readB,
    local_grid R size hy hx v z,?_⟩
  rcases next with ⟨par,rows,cols⟩|⟨par,rows,prev⟩|⟨rows,cols,endRow⟩
  · subst v; subst z
    have st : endOfRow (system n) e.a = false := by rw [finish]; simp [par,show x+1≠w by omega]
    simp only [chosenSuccessor,st,Bool.false_and,Bool.false_eq_true,if_false,row,par]
    exact ⟨rfl,go⟩
  · subst v
    have st : endOfRow (system n) e.a = false := by rw [finish]; simp [par,show x≠0 by omega]
    have pred : x-1 = z := by omega
    simp only [chosenSuccessor,st,Bool.false_and,Bool.false_eq_true,if_false,row,par,if_true]
    exact ⟨by change cell R y (x-1) = cell R y z; rw [pred],go⟩
  · subst v; subst z
    have st : endOfRow (system n) e.a = true := by
      cases par : odd y <;> simp [rowEnd,par] at endRow <;> rw [finish] <;> simp [par,endRow]
    have nb : (system n).bottom e.a.tag = false := by rw [bot]; simp [show y+1≠h by omega]
    simp only [chosenSuccessor,st,nb,Bool.true_and,Bool.false_eq_true,if_false,if_true]
    exact ⟨rfl,go⟩
theorem wrap_grid (R : Rectangle M w h) (size : 1 < w*h) :
    At (widthCode n+16) (allowed M) (system n) (zero R) (w*h-1) 0 := by
  obtain ⟨y,hy,x,hx,bottom,endRow,si⟩ := last_cell (show 0 < w*h by omega)
  let e := cert R y x 0 0
  have top := R.positiveH; have left := R.positiveW
  have f := R.flags y hy x hx
  have z := R.flags 0 top 0 left
  have first := first_id w
  have readA : H R (typedNode e.a) := cell_typed R size (id_bound hy hx)
  have readB : H R (typedNode e.b) := cell_typed R size (id_bound top left)
  have st : endOfRow (system n) e.a = true := by
    change endOfRow (system n) (cell R y x) = true; rw [end_flag R hy hx]
    cases par : odd y <;> simp [rowEnd,par] at endRow <;> simp [par,endRow]
  have bot : (system n).bottom e.a.tag = true := by
    change (system n).bottom (cell R y x).tag = true; rw [coordinates hy hx,f.2.2.2.1]; simp [bottom]
  have boundI := id_bound hy hx
  have boundJ := id_bound top left
  have ne : idAt w y x ≠ idAt w 0 0 := by rw [si,first]; omega
  have active : H R (orientedPort 4 e.a e.b) := by
    apply (port size (orders R size) (4 : Fin 5) boundI boundJ ne).mpr
    exact (wrap_edge ..).mpr ⟨si,first⟩
  have go : H R (earlier e.b.owner 0 e.a.owner 0) := by
    apply (orders R size).first _ _ _ boundI
    rw [first,si]; omega
  refine ⟨e,congrArg owner si,congrArg mate si,congrArg owner first,congrArg mate first,
    readA,readB,local_grid R size hy hx 0 0,?_⟩
  simp only [chosenSuccessor,st,bot,Bool.true_and,if_true,allQ,Holds]
  refine ⟨?_,.inl active,go,True.intro⟩
  change ((system n).top (cell R 0 0).tag && (system n).left (cell R 0 0).tag &&
    !(system n).oddRow (cell R 0 0).tag && !(system n).oddColumn (cell R 0 0).tag) = true
  rw [coordinates top left,z.1,z.2.2.1,z.2.2.2.2.1,z.2.2.2.2.2]
  decide
noncomputable def data (R : Rectangle M w h) (size : 1 < w*h) :
    Data (widthCode n+16) (allowed M) (system n) (w*h) (middle h w (widthCode n) (labels R)) (tail (w*h)) :=
  ⟨literal_phases R size,P455CellClassPadded.names size _ _,P455CellClass.canonical_final _,
    small_slots size _ _,functional size (orders R size),fun _ hi => next_grid R size hi,fun _ => wrap_grid R size⟩
theorem no_basis_of_run {s : Nat} (run : Run M w s) (basis : List (List Nat × List Nat))
    (sound : ∀ u v, (u,v) ∈ basis → (P455FullSingleton.model (widthCode n+16) (allowed M) (system n)).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (P455FullSingleton.model (widthCode n+16) (allowed M) (system n)).Valid U V ∧
      ¬ P455FirstRewrite.Derives (fun u v => (u,v) ∈ basis) U V := by
  apply P455CellClassClean.no_basis (by omega) _ basis sound
  intro k
  obtain ⟨height,_,big,⟨R⟩⟩ := unbounded run (k+2)
  have size : 1 < w*height := by omega
  exact ⟨w*height,middle height w (widthCode n) (labels R),tail (w*height),by omega,⟨data R size⟩⟩
end P455CellClassHalting
end
section
namespace P455ChartBuild
open P455Quotient P455Witness P455FirstRewrite P455Prefix P455WordChart P455Uncrossed
open Problem455.Slots P455SlotSaturation
abbrev W := List Nat
def book (r : Nat) (u : W) : List Node :=
  u.flatMap (fun a => u.flatMap (fun b => (Problem455Finite.wordsUpTo [false,true] r).map (fun t => ⟨a,b,t⟩)))
theorem listed {r allow u n} (typed : Holds r allow noMark u (typedNode n)) : n∈book r u := by
  obtain ⟨_,len,_,bit,eq⟩ := typed
  have mem (c : Nat) (hc : c∈profile n.owner n.mate n.tag bit) : c∈u :=
    (List.mem_filter.mp (eq ▸ hc : c∈select [n.owner,n.mate] u)).1
  obtain ⟨a,b,t⟩ := n
  refine List.mem_flatMap.mpr ⟨a,mem _ (by simp [profile,profilePrefix]),List.mem_flatMap.mpr
    ⟨b,mem _ (by simp [profile,profilePrefix]),List.mem_map.mpr ⟨t,?_,rfl⟩⟩⟩
  apply Problem455Finite.covered
  · dsimp at len; omega
  · intro x _; cases x <;> simp
private theorem index_unique {α : Type} [DecidableEq α] (t : List α) {a b : α}
    (ma : a∈t) (mb : b∈t) (h : t.idxOf a = t.idxOf b) : a = b := by
  induction t with
  | nil => contradiction
  | cons c t ih =>
    by_cases ca : c = a <;> by_cases cb : c = b
    · exact ca.symm.trans cb
    · subst c; simp [List.idxOf_cons,cond_eq_if,beq_iff_eq,cb,Ne.symm cb] at h
    · subst c; simp [List.idxOf_cons,cond_eq_if,beq_iff_eq,ca,Ne.symm ca] at h
    · exact ih ((List.mem_cons.mp ma).resolve_left (Ne.symm ca))
        ((List.mem_cons.mp mb).resolve_left (Ne.symm cb))
        (by simpa [List.idxOf_cons,cond_eq_if,beq_iff_eq,ca,cb,Ne.symm] using h)
noncomputable def nodes (r : Nat) (u : W) (i : Nat) : Node := by
  classical
  exact if h : ∃ n ∈ book r u, (book r u).idxOf n = i then h.choose else ⟨0,0,[]⟩
theorem node_index {r u n} (m : n∈book r u) : nodes r u ((book r u).idxOf n) = n := by
  classical
  have h : ∃ y∈book r u, (book r u).idxOf y = (book r u).idxOf n := ⟨n,m,rfl⟩
  simp only [nodes,dif_pos h]
  exact index_unique _ h.choose_spec.1 m h.choose_spec.2
theorem index_node {r allow u v i} (ok : Holds r allow noMark v (typedNode (nodes r u i))) :
    (book r u).idxOf (nodes r u i) = i := by
  classical
  by_cases h : ∃ n∈book r u, (book r u).idxOf n = i
  · simpa only [nodes,dif_pos h] using h.choose_spec.2
  · have bad := ok.1
    simp [nodes,h] at bad
def readBit (w : W) (n : Node) : Bool :=
  decide (select [n.owner,n.mate] w = profile n.owner n.mate n.tag true)
theorem read_actual {w n bit} (ne : n.owner≠n.mate)
    (h : select [n.owner,n.mate] w = profile n.owner n.mate n.tag bit) : readBit w n = bit := by
  cases bit <;> simp_all [readBit,profile,pair]
theorem actual_read {r allow w n} (typed : Holds r allow noMark w (typedNode n)) :
    select [n.owner,n.mate] w = profile n.owner n.mate n.tag (readBit w n) := by
  obtain ⟨b,h⟩ := typed.2.2.2; rw [read_actual typed.1 h,h]
structure PairInfo (r : Nat) (allow : Tag → Prop) (u v : W) (i : Nat) (x y : Event) : Prop where
  roles : (x.1 = (nodes r u i).owner ∧ y.1 = (nodes r u i).mate) ∨
    (y.1 = (nodes r u i).owner ∧ x.1 = (nodes r u i).mate)
  typedU : Holds r allow noMark u (typedNode (nodes r u i))
  typedV : Holds r allow noMark v (typedNode (nodes r u i))
  bits : readBit v (nodes r u i) = !readBit u (nodes r u i)
  mutable : x.2 = r-2 ∧ y.2 = r-2
theorem label_pair {r allow ts u v} (cap : Cap r u) (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (x y : Event) (hx : P455ChangedEvents.Mates u v r x y) : ∃ i, PairInfo r allow u v i x y := by
  have ne : x.1≠y.1 := by
    rintro e
    apply hx.1
    have one (a : Nat) (w : W) : select [a,a] w = List.replicate (w.count a) a := by
      induction w with
      | nil => rfl
      | cons b t ih => by_cases f : b = a <;> simp_all [select,List.count_cons,List.replicate_succ,Ne.symm]
    rw [e,one,one,P455CellClassBinary.exact_counts cap valid]
  obtain ⟨a,b,tag,bit,ord,len,ok,ua,va⟩ := P455CellClassBinary.changed cap valid ne hx.1
  let n : Node := ⟨a,b,tag⟩
  have ab : a≠b := by rcases ord with ⟨p,q⟩|⟨p,q⟩ <;> rw [p,q] <;> first | exact ne | exact Ne.symm ne
  have pairs (w : W) : select [a,b] w = select [x.1,y.1] w := by
    rcases ord with ⟨p,q⟩|⟨p,q⟩ <;> rw [p,q]; exact select_swap _ _ _
  have U := (pairs u).trans ua
  have V := (pairs v).trans va
  have tU : Holds r allow noMark u (typedNode n) := ⟨ab,len,ok,bit,U⟩
  have tV : Holds r allow noMark v (typedNode n) := ⟨ab,len,ok,!bit,V⟩
  let i := (book r u).idxOf n
  have idx : nodes r u i = n := node_index (listed tU)
  refine ⟨i,?_⟩
  constructor
  · rw [idx]; exact ord.elim (fun h => .inl ⟨h.1.symm,h.2.symm⟩) (fun h => .inr ⟨h.1.symm,h.2.symm⟩)
  · rwa [idx]
  · rwa [idx]
  · rw [idx,read_actual (n:=n) ab U,read_actual (n:=n) ab V]
  · exact hx.2
end P455ChartBuild
end
section
namespace P455MachineReduction
open P455MachineCleanup P455MachineTable P455PaddedTiles
def model (M : Ordinary g q) :=
  P455FullSingleton.model (widthCode (g*(q+2+1))+16) (allowed (compile (normalized M))) (system (g*(q+2+1)))
end P455MachineReduction
end
section
namespace P455ChartBuild
open P455Quotient P455Witness P455FirstRewrite P455Prefix P455WordChart P455Uncrossed P455SlotSaturation
open P455Alignment P455ChangedEvents Problem455.Slots
inductive Chunk where
  | fixed (x : Event)
  | turn (i : Nat) (x y : Event)
  deriving DecidableEq
def row (rev : Nat → Bool) : Chunk → List Event
  | .fixed x => [x]
  | .turn i x y => if rev i then [y,x] else [x,y]
def render (rev : Nat → Bool) (cs : List Chunk) := cs.flatMap (row rev)
def labels (rev : Nat → Bool) (cs : List Chunk) := (render rev cs).map Prod.fst
def active (cs : List Chunk) : List Nat := cs.flatMap (fun | .turn i _ _ => [i] | .fixed _ => [])
abbrev Orig : Nat → Bool := fun _ => false
abbrev Last : Nat → Bool := fun _ => true
def AllInfo (r : Nat) (allow : Tag → Prop) (u v : W) (cs : List Chunk) :=
  ∀ i x y, Chunk.turn i x y ∈ cs → PairInfo r allow u v i x y
theorem indexed_chunks {r allow ts u v} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (cmp : P455SourceFamilies.Compressed r u) :
    ∃ cs, AllInfo r allow u v cs ∧ render Orig cs = events u ∧ render Last cs = events v := by
  have non {a b} (d : ChangedPair u v a b) : a≠b := by
    rintro rfl; apply d
    have refl (z : Nat) (w : W) : select [z,z] w = List.replicate (w.count z) z := by
      induction w with
      | nil => rfl
      | cons a w ih => by_cases e : a = z <;> simp_all [select,List.count_cons,List.replicate_succ,Ne.symm]
    rw [refl,refl,P455CellClassBinary.exact_counts cap valid]
  have bs := blocks_of_matching cap valid (fun _ _ _ e f => disjoint_changes hr cap valid cmp (non e) (non f) e f)
  suffices block_info : ∀ {p q}, Blocks (Mates u v r) p q →
      ∃ cs, AllInfo r allow u v cs ∧ render Orig cs = p ∧ render Last cs = q from block_info bs
  intro p q h
  induction h with
  | nil => exact ⟨[],fun _ _ _ h => False.elim (List.not_mem_nil h),rfl,rfl⟩
  | fixed a _ ih =>
    obtain ⟨cs,info,l,k⟩ := ih
    refine ⟨.fixed a::cs,?_,?_,?_⟩
    · intro i x y m; exact info _ _ _ (by simpa using m)
    · simp [render,row,← l]
    · simp [render,row,← k]
  | pair x y mate _ ih =>
    obtain ⟨cs,info,l,k⟩ := ih
    obtain ⟨i,recProof⟩ := label_pair cap valid x y mate
    refine ⟨.turn i x y::cs,?_,?_,?_⟩
    · intro j a b m
      rcases List.mem_cons.mp m with eql|tail
      · cases eql; exact recProof
      · exact info _ _ _ tail
    · simp [render,row,Orig,← l]
    · simp [render,row,Last,← k]
theorem mem_active {cs : List Chunk} {i : Nat} : i ∈ active cs ↔ ∃ x y, Chunk.turn i x y∈cs := by
  constructor
  · intro m
    obtain ⟨q,mem,h⟩ := List.mem_flatMap.mp m
    cases q with
    | fixed x => exact False.elim (List.not_mem_nil h)
    | turn j a b => obtain rfl : i = j := List.mem_singleton.mp h; exact ⟨a,b,mem⟩
  · rintro ⟨x,y,h⟩; exact List.mem_flatMap.mpr ⟨.turn i x y,h,List.mem_cons_self⟩
theorem renders_equal {s t : Nat → Bool} (cs : List Chunk)
    (eq : ∀ i∈active cs, s i = t i) : render s cs = render t cs := by
  unfold render List.flatMap
  apply congrArg List.flatten
  apply List.map_congr_left
  intro q mem; cases q with
  | fixed => rfl
  | turn i x y => simp only [row,eq i (mem_active.mpr ⟨x,y,mem⟩)]
theorem pos_perm (s t : Nat → Bool) (cs : List Chunk) : (render s cs).Perm (render t cs) := by
  induction cs with
  | nil => exact .refl _
  | cons q cs ih =>
    apply List.Perm.append _ ih
    cases q with
    | fixed => exact .refl _
    | turn i x y =>
      cases e : s i <;> cases f : t i <;> simp only [row,e,f,Bool.false_eq_true,if_false,if_true] <;>
        first | exact .refl _ | exact .swap _ _ _
theorem original_labels {cs u} (orig : render Orig cs = events u) : labels Orig cs = u := by
  rw [labels,orig,events,labels_of_stamp]
theorem final_labels {cs v} (last : render Last cs = events v) : labels Last cs = v := by
  rw [labels,last,events,labels_of_stamp]
private theorem stamp_swap (n : Nat → Nat) (x y : Nat) (ne : x≠y) (t : W) :
    stamp n (y::x::t) = (y,n y)::(x,n x)::stamp (advance (advance n [x]) [y]) t := by
  have oa : advance n [y] x = n x := by simp [advance,ne,Ne.symm ne]
  have tail : advance (advance n [y]) [x] = advance (advance n [x]) [y] := by funext z; simp [advance]; omega
  simp only [stamp,oa,tail]
theorem stamp_render {r allow u v} (cs : List Chunk) (info : AllInfo r allow u v cs)
    (n : Nat → Nat) (base : stamp n (labels Orig cs) = render Orig cs) (s : Nat → Bool) :
    stamp n (labels s cs) = render s cs := by
  induction cs generalizing n with
  | nil => rfl
  | cons q cs ih =>
    have tail : AllInfo r allow u v cs := fun i x y m => info _ _ _ (List.mem_cons_of_mem _ m)
    cases q with
    | fixed x =>
      change (x.1,n x.1)::stamp (advance n [x.1]) (labels Orig cs) = x::render Orig cs at base
      exact List.cons.injEq _ _ _ _ |>.mpr ⟨(List.cons.inj base).1,ih tail _ (List.cons.inj base).2⟩
    | turn i x y =>
      have recProof := info i x y List.mem_cons_self
      have ne : x.1≠y.1 := by
        rcases recProof.roles with ⟨a,b⟩|⟨a,b⟩
        · rw [a,b]; exact recProof.typedU.1
        · rw [b,a]; exact Ne.symm recProof.typedU.1
      have h := base
      change stamp n (x.1::y.1::labels Orig cs) = x::y::render Orig cs at h
      have diff : advance n [x.1] y.1 = n y.1 := by simp [advance,ne,Ne.symm ne]
      simp only [stamp,diff,List.cons.injEq] at h
      have rest := ih tail _ h.2.2
      cases f : s i with
      | false =>
        simpa only [labels,render,List.flatMap_cons,row,f,Bool.false_eq_true,if_false,
          List.cons_append,List.nil_append,List.map_cons,stamp,diff,h.1,h.2.1,List.cons.injEq,true_and] using rest
      | true =>
        simp only [labels,render,List.flatMap_cons,row,f,if_true,List.cons_append,List.nil_append,List.map_cons]
        rw [stamp_swap n _ _ ne]
        exact List.cons.injEq _ _ _ _ |>.mpr ⟨h.2.1,List.cons.injEq _ _ _ _ |>.mpr ⟨h.1,rest⟩⟩
theorem immutable {r allow u v} (cs : List Chunk) (info : AllInfo r allow u v cs) (s : Nat → Bool) :
    ∀ (k : Nat) (e : Event), (render Orig cs)[k]? = some e → e.2 ≠ r-2 → (render s cs)[k]? = some e := by
  induction cs with
  | nil => simp [render]
  | cons q cs ih =>
    have tail : AllInfo r allow u v cs := fun i x y m => info _ _ _ (List.mem_cons_of_mem _ m)
    cases q with
    | fixed x =>
      intro k e atK low; cases k with
      | zero => exact atK
      | succ k => exact ih tail _ _ atK low
    | turn i x y =>
      intro k e atK low
      have ranks := (info i x y List.mem_cons_self).mutable
      cases k with
      | zero => exact False.elim (low ((Option.some.inj atK) ▸ ranks.1))
      | succ k => cases k with
        | zero => exact False.elim (low ((Option.some.inj atK) ▸ ranks.2))
        | succ k =>
          cases f : s i <;> simpa only [render,List.flatMap_cons,row,f,Bool.false_eq_true,if_false,if_true,
            List.cons_append,List.nil_append,List.getElem?_cons_succ] using ih tail _ _ atK low
end P455ChartBuild
end
section
namespace P455ChartBuild
open P455Quotient P455Witness P455FirstRewrite P455Prefix P455WordChart
open P455SingletonEvaluation P455ChartSchedule P455Schedule P455SlotSaturation Problem455.Slots
def Touch (x y a b : Nat) := (x = a ∧ y = b) ∨ (y = a ∧ x = b)
theorem touch_symm {a b c d} (h : Touch a b c d) : Touch c d a b :=
  h.elim (fun p => .inl ⟨p.1.symm,p.2.symm⟩) (fun p => .inr ⟨p.2.symm,p.1.symm⟩)
theorem touch_trans {a b c d e f} (p : Touch a b c d) (q : Touch c d e f) : Touch a b e f := by
  rcases p with ⟨h,k⟩|⟨h,k⟩ <;> rcases q with ⟨l,m⟩|⟨l,m⟩ <;>
    simp_all [Touch]
private theorem quiet {a b x y : Nat} (no : ¬Touch x y a b) :
    select [a,b] [x,y] = select [a,b] [y,x] := by
  by_cases xa : x = a <;> by_cases xb : x = b <;> by_cases ya : y = a <;> by_cases yb : y = b <;>
    simp_all [Touch,select]
theorem read_projection (cs : List Chunk) (s t : Nat → Bool) (a b : Nat)
    (same : ∀ i x y, Chunk.turn i x y∈cs → Touch x.1 y.1 a b → s i = t i) :
    select [a,b] (labels s cs) = select [a,b] (labels t cs) := by
  induction cs with
  | nil => rfl
  | cons q cs ih =>
    have rest := ih (fun i x y m => same i x y (List.mem_cons_of_mem _ m))
    simp only [labels,render,List.flatMap_cons,List.map_append]
    change select [a,b] (((row s q).map Prod.fst) ++ labels s cs) =
      select [a,b] (((row t q).map Prod.fst) ++ labels t cs)
    rw [select_append,select_append,rest]
    apply congrArg (fun w : W => w ++ select [a,b] (labels t cs))
    cases q with
    | fixed => rfl
    | turn i x y =>
      by_cases h : Touch x.1 y.1 a b
      · simp only [row,same i x y List.mem_cons_self h]
      · cases g : s i <;> cases f : t i <;> simp only [row,g,f,Bool.false_eq_true,if_false,if_true,List.map_cons,List.map_nil] <;>
          first | exact quiet h | exact (quiet h).symm
theorem match_roles {n m : Node} (p : Touch n.owner n.mate m.owner m.mate) : Matches n m.owner m.mate :=
  p.elim Or.inl (fun h => .inr ⟨h.2,h.1⟩)
theorem one_index {r allow u v a b i j x y f g}
    (p : PairInfo r allow u v i x y) (q : PairInfo r allow u v j f g)
    (px : Touch x.1 y.1 a b) (qy : Touch f.1 g.1 a b) : i = j := by
  have hm : Touch (nodes r u i).owner (nodes r u i).mate (nodes r u j).owner (nodes r u j).mate :=
    touch_trans (touch_symm p.roles) (touch_trans px (touch_trans (touch_symm qy) q.roles))
  have eq := P455WordChart.match_unique q.typedU p.typedU (match_roles hm)
  exact (index_node p.typedU).symm.trans ((congrArg (List.idxOf · (book r u)) eq).trans (index_node q.typedU))
noncomputable def initial (r : Nat) (u : W) : Bits := fun i => readBit u (nodes r u i)
def flags (A s : Bits) : Nat → Bool := fun i => s i != A i
noncomputable def chooseWord (r : Nat) (u : W) (cs : List Chunk) (s : Bits) := labels (flags (initial r u) s) cs
theorem initial_word {r u cs} (src : render Orig cs = events u) :
    chooseWord r u cs (initial r u) = u := by
  have base : flags (initial r u) (initial r u) = Orig := funext (fun _ => by simp [flags,Orig])
  rw [chooseWord,base,original_labels src]
def ending (A : Bits) (C : List Nat) : Bits := fun j => if j∈C then !A j else A j
theorem final_word {r u v cs} (dst : render Last cs = events v) :
    chooseWord r u cs (ending (initial r u) (active cs)) = v := by
  have eq := renders_equal (t := Last) cs (s := flags (initial r u) (ending (initial r u) (active cs)))
    (fun i m => by cases h : initial r u i <;> simp [flags,ending,m,h,Last])
  exact (congrArg (List.map Prod.fst) eq).trans (final_labels dst)
private theorem transfer_typed {r allow n w t}
    (equal : select [n.owner,n.mate] w = select [n.owner,n.mate] t)
    (ok : Holds r allow noMark w (typedNode n)) : Holds r allow noMark t (typedNode n) := by
  obtain ⟨d,h⟩ := ok.2.2.2; exact ⟨ok.1,ok.2.1,ok.2.2.1,d,equal.symm.trans h⟩
private theorem choice_projection {r allow u v cs i x y} (info : AllInfo r allow u v cs)
    (src : render Orig cs = events u) (dst : render Last cs = events v)
    (use : Chunk.turn i x y∈cs) (a b : Nat) (touch : Touch x.1 y.1 a b) (s : Bits) :
    let w := chooseWord r u cs s
    if flags (initial r u) s i then select [a,b] w = select [a,b] v else select [a,b] w = select [a,b] u := by
  let f := flags (initial r u) s
  have fixed (j x' y') (m : Chunk.turn j x' y'∈cs) (h : Touch x'.1 y'.1 a b) : i = j :=
    one_index (info i x y use) (info j x' y' m) touch h
  cases bit : flags (initial r u) s i with
  | false =>
    simp only [Bool.false_eq_true,if_false]
    exact (read_projection cs f Orig a b (fun j _ _ m h => (fixed j _ _ m h) ▸ bit)).trans (congrArg _ (original_labels src))
  | true =>
    simp only [if_true]
    exact (read_projection cs f Last a b (fun j _ _ m h => (fixed j _ _ m h) ▸ bit)).trans (congrArg _ (final_labels dst))
theorem mixed_typed {r allow u v cs} (info : AllInfo r allow u v cs)
    (src : render Orig cs = events u) (dst : render Last cs = events v)
    (s : Bits) (i : Nat) (m : i∈active cs) :
    Holds r allow noMark (chooseWord r u cs s) (typedNode (nodes r u i)) := by
  obtain ⟨x,y,part⟩ := mem_active.mp m
  have h := info i x y part
  have p := choice_projection info src dst part _ _ h.roles s
  split at p
  · exact transfer_typed p.symm h.typedV
  · exact transfer_typed p.symm h.typedU
theorem mixed_read {r allow u v cs} (info : AllInfo r allow u v cs)
    (src : render Orig cs = events u) (dst : render Last cs = events v) (s : Bits)
    (off : Off (active cs) (initial r u) s) :
    Read s (nodes r u) r allow (chooseWord r u cs s) := by
  classical
  intro j typed
  let n := nodes r u j
  let w := chooseWord r u cs s
  change select [n.owner,n.mate] w = profile n.owner n.mate n.tag (s j)
  by_cases existsPart : ∃ i x y, Chunk.turn i x y∈cs ∧ Touch x.1 y.1 n.owner n.mate
  · obtain ⟨i,x,y,m,t⟩ := existsPart
    have h := info i x y m
    have matched : Matches (nodes r u i) n.owner n.mate := match_roles (touch_trans (touch_symm h.roles) t)
    have eq := choice_projection info src dst m n.owner n.mate t s
    have index {z : W} (source : Holds r allow noMark z (typedNode (nodes r u i)))
        (nOK : Holds r allow noMark z (typedNode n)) : i = j := by
      have identical := P455WordChart.match_unique nOK source matched
      exact (index_node source).symm.trans ((congrArg (List.idxOf · (book r u)) identical).trans (index_node typed))
    cases flag : flags (initial r u) s i with
    | false =>
      simp only [flag,Bool.false_eq_true,if_false] at eq
      have nOK := transfer_typed eq typed
      have ij := index h.typedU nOK
      subst i
      have bit : s j = initial r u j := by simpa [flags] using flag
      exact eq.trans (by rw [bit]; exact actual_read nOK)
    | true =>
      simp only [flag,if_true] at eq
      have nOK := transfer_typed eq typed
      have ij := index h.typedV nOK
      subst i
      have bit : s j= !initial r u j := by
        cases x : s j <;> cases y : initial r u j <;> simp_all [flags]
      have bitV : readBit v n = s j := h.bits.trans bit.symm
      exact eq.trans (by rw [← bitV]; exact actual_read nOK)
  · have no : j∉active cs := by
      intro jmem; obtain ⟨x,y,m⟩ := mem_active.mp jmem
      exact existsPart ⟨j,x,y,m,(info j x y m).roles⟩
    have eq : select [n.owner,n.mate] w = select [n.owner,n.mate] u := by
      exact (read_projection cs (flags (initial r u) s) Orig n.owner n.mate (fun i x y m t => (existsPart ⟨i,x,y,m,t⟩).elim)).trans (congrArg _ (original_labels src))
    have nOK := transfer_typed eq typed
    exact eq.trans (by rw [off j no]; exact actual_read nOK)
end P455ChartBuild
end
section
namespace P455ChartBuild
open P455Quotient P455Witness P455FirstRewrite P455Prefix P455WordChart P455Uncrossed
open P455ChartSchedule P455Schedule P455SlotSaturation Problem455.Slots
private theorem marker {r allow u v cs i} (info : AllInfo r allow u v cs) (activeI : i∈active cs) :
    ((nodes r u i).owner,r-2) ∈ render Orig cs := by
  obtain ⟨x,y,m⟩ := mem_active.mp activeI
  have p := info _ _ _ m
  apply List.mem_flatMap.mpr
  refine ⟨.turn i x y,m,?_⟩
  rcases p.roles with ⟨h,_⟩|⟨h,_⟩
  · exact List.mem_cons.mpr (.inl (Prod.ext h p.mutable.1).symm)
  · exact List.mem_cons.mpr (.inr (List.mem_singleton.mpr (Prod.ext h p.mutable.2).symm))
theorem active_distinct {r allow u v} (cs : List Chunk) (info : AllInfo r allow u v cs)
    (nd : (render Orig cs).Nodup) : (active cs).Nodup := by
  induction cs with
  | nil => simp [active]
  | cons q cs ih =>
    have tail : AllInfo r allow u v cs := fun i x y m => info _ _ _ (List.mem_cons_of_mem _ m)
    cases q with
    | fixed => exact ih tail (List.nodup_cons.mp nd).2
    | turn i x y =>
      change (x::y::render Orig cs).Nodup at nd
      have mx := (List.nodup_cons.mp nd).1
      obtain ⟨my,nt⟩ := List.nodup_cons.mp (List.nodup_cons.mp nd).2
      change (i::active cs).Nodup
      refine List.nodup_cons.mpr ⟨?_,ih tail nt⟩
      intro mem
      have m := marker tail mem
      have p := info i x y List.mem_cons_self
      rcases p.roles with ⟨h,_⟩|⟨h,_⟩
      · exact mx (List.mem_cons_of_mem _ ((show x = ((nodes r u i).owner,r-2) from Prod.ext h p.mutable.1).symm ▸ m))
      · exact my ((show y = ((nodes r u i).owner,r-2) from Prod.ext h p.mutable.2).symm ▸ m)
private theorem count_before (n : Nat → Nat) (l t : List Event) (x y : Event) (ne : x.1≠y.1)
    (h : stamp n ((l++x::y::t).map Prod.fst) = l++x::y::t) :
    n x.1 + (l.map Prod.fst).count x.1 = x.2 ∧ n y.1 + (l.map Prod.fst).count y.1 = y.2 := by
  simp only [List.map_append,List.map_cons,stamp_append] at h
  have e := List.append_inj_right h (by rw [P455ImmutablePrivate.stamp_length,List.length_map])
  obtain ⟨hx,sub⟩ := List.cons.inj e
  obtain ⟨hy,_⟩ := List.cons.inj sub
  exact ⟨congrArg Prod.snd hx,by simpa [advance,ne,Ne.symm ne] using congrArg Prod.snd hy⟩
private theorem flags_switch (A s : Bits) (i : Nat) :
    flags A (switch s i) i = !flags A s i ∧ ∀ j, j≠i → flags A (switch s i) j = flags A s j := by
  constructor
  · cases e : s i <;> cases f : A i <;> simp [flags,P455ChartSchedule.switch,e,f]
  · intro j ne; simp [flags,P455ChartSchedule.switch,ne]
theorem mixed_stamp {r allow u v cs} (info : AllInfo r allow u v cs) (src : render Orig cs = events u)
    (s : Bits) : events (chooseWord r u cs s) = render (flags (initial r u) s) cs := by
  exact stamp_render cs info _ (by rw [original_labels src,src]; rfl) _
theorem switched_place {r allow u v cs} (info : AllInfo r allow u v cs)
    (src : render Orig cs = events u) (s : Bits) (i : Nat) (use : i∈active cs) :
    let n := nodes r u i
    ∃ pre post : W, ∃ d : Bool,
      chooseWord r u cs s = pre ++ pair n.owner n.mate d ++ post ∧
      chooseWord r u cs (switch s i) = pre ++ pair n.owner n.mate (!d) ++ post ∧
      pre.count n.owner = r-2 ∧ pre.count n.mate = r-2 := by
  obtain ⟨x,y,m⟩ := mem_active.mp use
  obtain ⟨p,q,e⟩ := List.append_of_mem m
  subst cs
  let f := flags (initial r u) s
  let g := flags (initial r u) (switch s i)
  have turn := info i x y m
  have nd := active_distinct _ info (src ▸ P455Paths.stamp_unique _ _)
  change (active (p++Chunk.turn i x y::q)).Nodup at nd
  have ins : active (p++Chunk.turn i x y::q) = active p ++ i::active q := by
    simp [active,List.flatMap_append]
  rw [ins] at nd
  obtain ⟨_,nq,dis⟩ := List.pairwise_append.mp nd
  have ip : i ∉ active p := fun m => dis i m i List.mem_cons_self rfl
  have iq := (List.nodup_cons.mp nq).1
  have relation := flags_switch (initial r u) s i
  have eq (cs : List Chunk) (absent : i∉active cs) : render g cs = render f cs :=
    renders_equal cs (fun j m => relation.2 j (fun e => absent (e ▸ m)))
  have first := eq p ip; have last := eq q iq
  let pre := labels f p
  let post := labels f q
  have orig : stamp (fun _ => 0) ((render Orig p++x::y::render Orig q).map Prod.fst) =
      render Orig p++x::y::render Orig q := by
    have stamp0 : stamp (fun _ => 0) (labels Orig (p++Chunk.turn i x y::q)) = render Orig (p++Chunk.turn i x y::q) := by
      rw [original_labels src,src]; rfl
    simpa [labels,render,List.flatMap_append,Orig,row] using stamp0
  have ne : x.1≠y.1 := by rcases turn.roles with ⟨a,b⟩|⟨a,b⟩ <;> rw [a,b] <;>
                             first | exact turn.typedU.1 | exact Ne.symm turn.typedU.1
  have cnt := count_before _ _ _ x y ne orig
  have perm : pre.Perm ((render Orig p).map Prod.fst) := (pos_perm f Orig p).map _
  have cx : pre.count x.1 = r-2 := (perm.count_eq x.1).trans ((by simpa using cnt.1 : ((render Orig p).map Prod.fst).count x.1 = x.2).trans turn.mutable.1)
  have cy : pre.count y.1 = r-2 := (perm.count_eq y.1).trans ((by simpa using cnt.2 : ((render Orig p).map Prod.fst).count y.1 = y.2).trans turn.mutable.2)
  have view (h : Nat → Bool) : labels h (p++Chunk.turn i x y::q)=
      labels h p ++ (row h (.turn i x y)).map Prod.fst ++ labels h q := by
    simp [labels,render,List.flatMap_append,List.append_assoc]
  have L : chooseWord r u (p++Chunk.turn i x y::q) s =
      pre ++ (row f (.turn i x y)).map Prod.fst ++ post := view f
  have R : chooseWord r u (p++Chunk.turn i x y::q) (switch s i)=
      pre ++ (row g (.turn i x y)).map Prod.fst ++ post := by
    simpa only [chooseWord,labels,first,last,f,g,pre,post] using view g
  have flip : g i = !f i := relation.1
  dsimp only
  rcases turn.roles with ⟨xo,ym⟩|⟨yo,xm⟩
  · refine ⟨pre,post,f i,?_,?_,xo ▸ cx,ym ▸ cy⟩
    · cases d : f i <;> simpa only [row,d,pair,Bool.false_eq_true,if_false,if_true,List.map_cons,List.map_nil,xo,ym] using L
    · cases d : f i <;> simpa only [row,flip,d,pair,Bool.not_true,Bool.not_false,Bool.false_eq_true,if_false,if_true,List.map_cons,List.map_nil,xo,ym] using R
  · refine ⟨pre,post,!f i,?_,?_,yo ▸ cy,xm ▸ cx⟩
    · cases d : f i <;> simpa only [row,d,pair,Bool.not_true,Bool.not_false,Bool.false_eq_true,if_false,if_true,List.map_cons,List.map_nil,yo,xm] using L
    · cases d : f i <;> simpa only [row,flip,d,pair,Bool.not_true,Bool.not_false,Bool.false_eq_true,if_false,if_true,List.map_cons,List.map_nil,yo,xm] using R
end P455ChartBuild
end
section
namespace P455ChartBuild
open P455Quotient P455Witness P455FirstRewrite P455Prefix P455WordChart P455Uncrossed
open P455ChartSchedule P455Schedule P455SlotSaturation P455Structural Problem455.Slots
theorem geometry_from_chunks {r allow ts u v cs} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (cmp : P455SourceFamilies.Compressed r u)
    (info : AllInfo r allow u v cs) (src : render Orig cs = events u) (dst : render Last cs = events v) :
    Geometry r allow (active cs) (initial r u) (chooseWord r u cs) (nodes r u) := by
  constructor
  · rw [initial_word src]
    intro n ok; exact ⟨(book r u).idxOf n,node_index (listed ok)⟩
  · rw [initial_word src]
    intro i m; obtain ⟨x,y,p⟩ := mem_active.mp m; exact (info i x y p).typedU
  · exact mixed_read info src dst
  · intro s _ i m
    obtain ⟨x,y,p⟩ := mem_active.mp m
    have data := info i x y p
    let n := nodes r u i
    let w := chooseWord r u cs s
    have typed := data.typedU
    have edit : Changed u v n.owner n.mate := by
      intro eq
      have bits : readBit u n = readBit v n := by simp only [readBit,eq]
      have unequal (b : Bool) : b≠ !b := by cases b <;> decide
      exact unequal (readBit u n) (bits.trans data.bits)
    have both := isolated_pair hr cap valid cmp typed.1 edit
    have only (z : Nat) (za : z≠n.owner) (zb : z≠n.mate) :
        ¬ Edge u r allow n.owner z ∧ ¬ Edge u r allow n.mate z :=
      ⟨fun e => zb (both.1 z e).symm,fun e => za (both.2 z e).symm⟩
    have closed := P455PrivatePhase.closed_changed cap valid (show Rec u r allow n.owner n.mate from
      ⟨n.tag,typed⟩) edit only
    have large : 5 ≤ r := by have := typed.2.1; omega
    have stamped := mixed_stamp info src s
    have clean : Closed w n.owner n.mate := P455ImmutablePrivate.closed_transport large closed (by
      intro k e base immutableI
      rw [show events w = render (flags (initial r u) s) cs from stamped]
      exact immutable cs info _ k e (src.symm ▸ base) immutableI)
    have live := mixed_typed info src dst s i m
    have perm : w.Perm u := (show w.Perm (labels Orig cs) from (pos_perm _ Orig cs).map _).trans
      ((original_labels src) ▸ List.Perm.refl _)
    have cp : Cap r w := fun a => Nat.le_trans (Nat.le_of_eq (perm.count_eq a)) (cap a)
    obtain ⟨pre,post,bit,start,endWord,ca,cb⟩ := switched_place info src s i m
    rw [start,endWord]
    apply P455FlipFromWord.literal n pre post bit
    · simpa only [w,start,n,Cap,P455Closure.Cap] using cp
    · simpa only [start] using live
    · simpa only [w,start] using clean
    · exact ca
    · exact cb
theorem capped_schedule_or_rectangle {r allow ts u v} (hr : 0 < r) (law : P455GridRows.Laws ts)
    (cap : Cap r u) (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (cmp : P455SourceFamilies.Compressed r u) :
    Derives (fun a b => (P455FullSingleton.model r allow ts).Valid a b ∧ rank a b ≤ P455MarkedRank.bound r) u v ∨
      Nonempty (P455GridAssembly.Rectangle allow ts) := by
  obtain ⟨cs,info,src,dst⟩ := indexed_chunks hr cap valid cmp
  have g := geometry_from_chunks hr cap valid cmp info src dst
  let A := initial r u
  let C := active cs
  have off : Off C A (ending A C) := by intro i out; simp [ending,out]
  have diff (i : Nat) (m : i∈C) : A i≠ending A C i := by cases h : A i <;> simp [ending,m,h]
  have left := initial_word (r:=r) src
  have right := final_word (r:=r) dst (u:=u)
  simpa only [A,C,left,right] using normalize_layout law g off diff (left.symm ▸ cap)
    (left.symm ▸ cmp) (show (P455FullSingleton.model r allow ts).Valid
      (chooseWord r u cs A) (chooseWord r u cs (ending A C)) by simpa only [A,C,left,right] using valid)
theorem arbitrary_schedule_or_rectangle {r allow ts u v} (hr : 0 < r) (law : P455GridRows.Laws ts)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) :
    Derives (fun a b => (P455FullSingleton.model r allow ts).Valid a b ∧
      rank a b ≤ max (P455MarkedRank.bound r) (2*(r+2)+1)) u v ∨
      Nonempty (P455GridAssembly.Rectangle allow ts) := by
  obtain ⟨A,B,h,_,ca,_,cmp,_,ok,_,_,_,_,lift⟩ := normalized_compressed hr valid
  exact (capped_schedule_or_rectangle hr law ca ok cmp).imp_left (lift _)
end P455ChartBuild
end
section
namespace P455Global
open P455PaddedTiles P455FiniteBasis P455FirstRewrite
abbrev monoid {n} (M : MachineTable n) := P455FullSingleton.model (widthCode n+16) (allowed M) (system n)
def Accepts {n} (M : MachineTable n) := ∃ w s, Nonempty (AcceptingTrace M w s)
def HasBasis {S : Type} (M : Model S) := ∃ rules, Basis M rules
def Stationary {n} (M : MachineTable n) := ∀ {w s}, (T : AcceptingTrace M w s) → ∀ x, x < w →
    M.next (leftAt (T.rows s) x) (T.rows s x) (rightAt (T.rows s) w x) = some (T.rows s x)
theorem finite_of_no_trace {n} (M : MachineTable n) (negative : ¬Accepts M) :
    HasBasis (monoid M) := by
  apply finite_of_uniform _ (P455FiniteModel.fixed_product ..)
    (max (P455MarkedRank.bound (widthCode n+16)) (2*(widthCode n+16+2)+1))
  intro u v _ _ valid
  have alt := P455ChartBuild.arbitrary_schedule_or_rectangle (by omega : 0 < widthCode n+16) (system_laws n) valid
  apply alt.resolve_right
  rintro ⟨R⟩
  exact negative ⟨R.width+1,R.height,⟨assembly_trace R⟩⟩
theorem no_basis_of_trace {n} (M : MachineTable n) (stationary : Stationary M)
    (pos : Accepts M) : ¬HasBasis (monoid M) := by
  obtain ⟨w,s,⟨t⟩⟩ := pos
  let run : Run M w s := ⟨t.positive,t.rows,t.start,t.marks,t.steps,t.accept,stationary t⟩
  rintro ⟨rules,ok,complete⟩
  obtain ⟨u,v,un,vn,idn,fail⟩ := P455CellClassHalting.no_basis_of_run run rules
    (fun a b m => (ok a b m).2.2)
  exact fail (complete u v un vn idn)
theorem table_equivalence {n} (M : MachineTable n) (stationary : Stationary M) :
    HasBasis (monoid M) ↔ ¬Accepts M :=
  ⟨fun base accept => no_basis_of_trace M stationary accept base,finite_of_no_trace M⟩
end P455Global
end
