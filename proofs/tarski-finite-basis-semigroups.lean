namespace Problem455.Slots
def shift (n : Nat → Nat) (e : Event) : Event := (e.1, n e.1 + e.2)
def unshift (n : Nat → Nat) (e : Event) : Event := (e.1, e.2 - n e.1)
theorem stamp_shift (extra n : Nat → Nat) (w : Word) :
    stamp (fun x => extra x + n x) w = (stamp n w).map (shift extra) := by
  induction w generalizing n with
  | nil => rfl
  | cons a w ih =>
    have he : advance (fun x => extra x + n x) [a] =
      (fun x => extra x + advance n [a] x) := by funext x; simp [advance, Nat.add_assoc]
    simp only [stamp, List.map_cons, he, ih, shift]
theorem labels_of_stamp (n : Nat → Nat) (w : Word) :
    (stamp n w).map Prod.fst = w := by
  induction w generalizing n with
  | nil => rfl
  | cons a w ih => simp [stamp, ih]
theorem stamped_mem_label (n : Nat → Nat) (w : Word) (e : Event)
    (h : e ∈ stamp n w) : e.1 ∈ w := by
  rw [← labels_of_stamp n w]
  exact List.mem_map_of_mem h
theorem events_of_factor (l f t : Word) :
    events (l ++ f ++ t) =
      events l ++ ((events f).map (shift (fun a => l.count a)) ++
        stamp (fun a => l.count a + f.count a) t) := by
  have hn : advance (fun _ => 0) l = (fun a => l.count a) := by funext a; simp [advance]
  have hh := stamp_shift (fun a => l.count a) (fun _ => 0) f
  simp only [Nat.add_zero] at hh
  simp only [List.append_assoc, events, stamp_append, hn, hh]
  rfl
private theorem trim_left {α : Type} {a : α} {pat u v : List α}
    (ha : a ∉ u) (h : (a :: pat).Sublist (u ++ v)) : (a :: pat).Sublist v := by
  induction u with
  | nil => exact h
  | cons c u ih =>
    cases h with
    | cons _ h => exact ih (fun hh => ha (by simp [hh])) h
    | cons_cons _ _ => exact False.elim (ha (by simp))
private theorem trim_three {α : Type} {a e b : α} {l f t : List α}
    (ha : a ∉ l) (hb : b ∉ t) :
    [a,e,b].Sublist (l ++ (f ++ t)) ↔ [a,e,b].Sublist f := by
  constructor
  · intro h
    have h' := (trim_left ha h).reverse
    simp only [List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.cons_append, List.singleton_append] at h'
    have hh := (trim_left (by simpa using hb : b ∉ t.reverse) h').reverse
    simpa using hh
  · intro h
    exact List.sublist_append_of_sublist_right (List.sublist_append_of_sublist_left h)
theorem factor_occupies (l f t : Word) (owner i a : Nat) (hl : owner ∉ l) (ht : owner ∉ t) :
    occupies (l ++ f ++ t) owner i a ↔ occupies f owner i a := by
  have hz := List.count_eq_zero.mpr hl
  have left : (owner, i) ∉ events l := fun hm => hl (stamped_mem_label _ _ _ hm)
  have right : (owner, i + 1) ∉ stamp (fun x => l.count x + f.count x) t :=
    fun hm => ht (stamped_mem_label _ _ _ hm)
  let n := fun x => l.count x
  have shiftS : ∀ j, unshift n (owner,j) = (owner,j) := by simp [unshift, n, hz]
  have shiftF : ∀ j, shift n (owner,j) = (owner,j) := by simp [shift,n,hz]
  constructor
  · rintro ⟨k,h⟩
    unfold sees at h
    rw [events_of_factor] at h
    have hh := ((trim_three left right).mp h).map (unshift n)
    refine ⟨k-n a,?_⟩
    simpa [sees, List.map_map, Function.comp_def, Nat.add_sub_cancel_left, shiftS, unshift, shift, n, hz] using hh
  · rintro ⟨k,h⟩
    refine ⟨n a+k,?_⟩
    unfold sees
    rw [events_of_factor]
    apply (trim_three left right).mpr
    have hh := h.map (shift n)
    simpa [shiftF, shift, n, hz] using hh
theorem saturated_factor_occupies (l f t : Word) (owner i a r : Nat)
    (cap : P455Closure.Cap r (l ++ f ++ t)) (sat : f.count owner = r) :
    occupies (l ++ f ++ t) owner i a ↔ occupies f owner i a := by
  have h := cap owner
  simp only [List.count_append, sat] at h
  exact factor_occupies l f t owner i a
    (List.count_eq_zero.mp (by omega)) (List.count_eq_zero.mp (by omega))
end Problem455.Slots
end
section
namespace P455Uncrossed
open P455Closure Problem455Finite
abbrev W := List Nat
abbrev Marks := Nat → Nat → Prop
def side (f : Frame Nat) (l k : W) (bit : Bool) := l ++ f.core bit ++ k
def Unmarked (mark : Marks) (h : Nat → W) (x y : Nat) : Prop :=
  ∀ a ∈ h x, ∀ b ∈ h y, ¬ mark a b ∧ ¬ mark b a
private theorem nodup_of_counts (w : W) (h : ∀ a ∈ w, w.count a ≤ 1) : w.Nodup := by
  induction w with
  | nil => simp
  | cons a w ih =>
    apply List.nodup_cons.mpr
    have one := h a (by simp)
    simp only [List.count_cons_self] at one
    exact ⟨List.count_eq_zero.mp (by omega),
      ih fun b hb => by have hh := h b (by simp [hb]); simp [List.count_cons] at hh; omega⟩
private theorem core_mem {r A M} (f : Frame Nat) (valid : f.Valid r A M)
    (bit : Bool) (a : Nat) (mem : a ∈ f.p ∨ a ∈ f.q) : (f.core bit).count a = r := by
  have base := valid.2.2.2.2.2.2.2 a mem
  cases bit
  · exact base
  · exact (f.count_core a true).trans base
private def mappedFrame (f : Frame Nat) (h : Nat → W) (pHead : Nat) (pTail qInit : W)
    (qLast : Nat) : Frame Nat where
  pHead := pHead
  pTail := pTail
  qInit := qInit
  qLast := qLast
  tag := f.tag
  middle := f.middle.map (fun e => (e.1.flatMap h, e.2))
  beforeMutable := f.beforeMutable.flatMap h
  beforeFinalP := f.beforeFinalP.flatMap h
  beforeFinalQ := f.beforeFinalQ.flatMap h
private theorem mid_image (f : Frame Nat) (h : Nat → W) (phead : Nat) (pt qi : W) (qlast : Nat)
    (hp : f.p.flatMap h = phead :: pt) (hq : f.q.flatMap h = qi ++ [qlast]) :
    f.mid.flatMap h = (mappedFrame f h phead pt qi qlast).mid := by
  simp only [Frame.mid,mappedFrame,List.flatMap_assoc,List.flatMap_map]
  congr 1
  funext z
  obtain ⟨w,b⟩ := z
  cases b <;> simp only [Function.comp_apply, Bool.false_eq_true, if_false, if_true,
    List.flatMap_append, hp, hq] <;> rfl
private theorem core_image (f : Frame Nat) (h : Nat → W) (phead : Nat) (pt qi : W) (qlast : Nat)
    (hp : f.p.flatMap h = phead :: pt) (hq : f.q.flatMap h = qi ++ [qlast]) (bit : Bool) :
    (f.core bit).flatMap h = (mappedFrame f h phead pt qi qlast).core bit := by
  have mid := mid_image f h phead pt qi qlast hp hq
  cases bit <;> simp only [Frame.core,Frame.early,Frame.pair,Bool.false_eq_true,if_false,if_true,
    List.flatMap_append, mid, hp, hq] <;> rfl
theorem equal_or_move {r allow mark} (f : Frame Nat) (l k : W) (bit : Bool) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (h : Nat → W) (clear : Unmarked mark h x y)
    (cap : Cap r ((side f l k bit).flatMap h)) :
    (side f l k bit).flatMap h = (side f l k (!bit)).flatMap h ∨
    Move r allow mark ((side f l k bit).flatMap h) ((side f l k (!bit)).flatMap h) := by
  have xmap : f.p.flatMap h = h x := by simp [hp]
  have ymap : f.q.flatMap h = h y := by simp [hq]
  by_cases empty : h x = [] ∨ h y = []
  · left
    rcases empty with hx | hy <;> cases bit <;>
      simp [side,Frame.core,Frame.pair,List.flatMap_append,xmap,ymap, *]
  right
  have nonX : h x ≠ [] := fun e => empty (Or.inl e)
  have nonY : h y ≠ [] := fun e => empty (Or.inr e)
  obtain ⟨phead,pt,p⟩ : ∃ a t, h x = a :: t := by cases hv : h x <;> simp_all
  obtain ⟨qi,qlast,q⟩ : ∃ t a, h y = t ++ [a] := by
    cases hv : (h y).reverse with
    | nil => have e := congrArg List.reverse hv; simp_all
    | cons a t => exact ⟨t.reverse,a,by simpa using congrArg List.reverse hv⟩
  let g := mappedFrame f h phead pt qi qlast
  have gp : g.p = h x := p.symm
  have gq : g.q = h y := q.symm
  have eq (b : Bool) :
      (side f l k b).flatMap h = l.flatMap h ++ g.core b ++ k.flatMap h := by
    simp only [side,List.flatMap_append,core_image f h _ _ _ _ (xmap.trans p) (ymap.trans q),g]
  have capCore : Cap r ((f.core bit).flatMap h) := by
    intro a; have hh := cap a; simp only [side,List.flatMap_append,List.count_append] at hh; omega
  have xm : x ∈ f.p := by simp [hp]
  have ym : y ∈ f.q := by simp [hq]
  have ne : x ≠ y := fun e => valid.2.2.2.2.2.1 x xm (e ▸ ym)
  have hr : 0 < r := by have := valid.1; omega
  have cx := core_mem f valid bit x (.inl xm)
  have cy := core_mem f valid bit y (.inr ym)
  have usedY : y ∈ f.core bit := List.count_pos_iff.mp (cy.symm ▸ hr)
  have excl (a : Nat) (ha : a ∈ h x) :=
    P455DonorInterval.exclusive h (f.core bit) x a r hr cx ha (capCore a)
  have capImage := eq bit ▸ cap
  have gv : g.Valid r allow mark := by
    apply g.valid_of_capped_shape valid.1 valid.2.1 _ _ _ _ _ bit (l.flatMap h) (k.flatMap h) capImage
    · simpa [g,mappedFrame,List.map_map,Function.comp_def] using valid.2.2.1
    · rw [gp]; apply nodup_of_counts
      exact fun a ha => Nat.le_of_eq (excl a ha).1
    · rw [gq]; apply nodup_of_counts
      exact fun a ha => Nat.le_of_eq (P455DonorInterval.exclusive h (f.core bit) y a r hr cy ha (capCore a)).1
    · rw [gp,gq]; exact fun a ha => (excl a ha).2.1 y usedY ne.symm
    · simpa only [gp,gq,Unmarked] using clear
  exact ⟨g,bit,l.flatMap h,k.flatMap h,gv,eq bit,eq (!bit),cap⟩
private theorem words_from_good {r allow mark T} (capT : P455Quotient.Cap r T)
    (f : Frame Nat) (l k : W) (bit : Bool) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (h : Nat → W) (clear : Unmarked mark h x y)
    (good : P455Quotient.Good (rules r allow mark) T ((side f l k bit).flatMap h)) :
    P455Quotient.ofWord (rules r allow mark) T ((side f l k bit).flatMap h) =
      P455Quotient.ofWord (rules r allow mark) T ((side f l k (!bit)).flatMap h) := by
  let R := rules r allow mark
  have cap := P455Quotient.good_cap R capT good
  rcases equal_or_move f l k bit x y hp hq valid h clear cap with e | move
  · rw [e]
  · have path := P455Quotient.Walk.snoc (s := R.step) (.refl _) move
    have equiv := P455Quotient.good_context R capT path [] []
    simp only [List.nil_append,List.append_nil] at equiv
    exact (P455Quotient.same_nonzero_class R good).mpr ⟨equiv.mp good,path⟩
theorem uncrossed_words {r allow mark T} (capT : P455Quotient.Cap r T)
    (f : Frame Nat) (l k : W) (bit : Bool) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (h : Nat → W) (clear : Unmarked mark h x y) :
    P455Quotient.ofWord (rules r allow mark) T ((side f l k bit).flatMap h) =
      P455Quotient.ofWord (rules r allow mark) T ((side f l k (!bit)).flatMap h) := by
  let R := rules r allow mark
  by_cases g : P455Quotient.Good R T ((side f l k bit).flatMap h)
  · exact words_from_good capT f l k bit x y hp hq valid h clear g
  by_cases g' : P455Quotient.Good R T ((side f l k (!bit)).flatMap h)
  · simpa using (words_from_good capT f l k (!bit) x y hp hq valid h clear g').symm
  have dead (w : W) (h : ¬ P455Quotient.Good R T w) :
      P455Quotient.ofWord R T w = P455Quotient.zero R T := by
    apply Classical.byContradiction
    intro nz; exact h ((P455Quotient.nonzero_iff R).mp nz)
  exact (dead _ g).trans (dead _ g').symm
theorem same_letters (f : Frame Nat) (l k : W) (bit : Bool) (a : Nat) :
    a ∈ side f l k bit ↔ a ∈ side f l k (!bit) := by
  have c := f.count_core a bit
  have perm : (side f l k bit).count a = (side f l k (!bit)).count a := by
    simp only [side,List.count_append,c]
  rw [←List.count_pos_iff,←List.count_pos_iff,perm]
theorem uncrossed_eval {r allow mark T} (capT : P455Quotient.Cap r T)
    (f : Frame Nat) (l k : W) (bit : Bool) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (val : Nat → P455Quotient.Q (rules r allow mark) T) (h : Nat → W)
    (reps : ∀ a ∈ side f l k bit, P455Quotient.ofWord (rules r allow mark) T (h a) = val a)
    (clear : Unmarked mark h x y) :
    P455Quotient.eval (rules r allow mark) capT val (side f l k bit) =
      P455Quotient.eval (rules r allow mark) capT val (side f l k (!bit)) := by
  rw [P455Quotient.eval_rep (rules r allow mark) capT val (side f l k bit) h reps,
      P455Quotient.eval_rep (rules r allow mark) capT val (side f l k (!bit)) h
        (fun a ha => reps a ((same_letters f l k bit a).mpr ha))]
  exact uncrossed_words capT f l k bit x y hp hq valid h clear
theorem difference_crosses {r allow mark T} (capT : P455Quotient.Cap r T)
    (f : Frame Nat) (l k : W) (bit : Bool) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (val : Nat → P455Quotient.Q (rules r allow mark) T) (h : Nat → W)
    (reps : ∀ a ∈ side f l k bit, P455Quotient.ofWord (rules r allow mark) T (h a) = val a)
    (diff : P455Quotient.eval (rules r allow mark) capT val (side f l k bit) ≠
      P455Quotient.eval (rules r allow mark) capT val (side f l k (!bit))) :
    ∃ a ∈ h x, ∃ b ∈ h y, mark a b ∨ mark b a := by
  apply Classical.byContradiction
  intro none
  apply diff
  apply uncrossed_eval capT f l k bit x y hp hq valid val h reps
  intro a ha b hb
  exact ⟨fun e => none ⟨a,ha,b,hb,Or.inl e⟩,fun e => none ⟨a,ha,b,hb,Or.inr e⟩⟩
theorem difference_live_representatives {r allow mark T} (capT : P455Quotient.Cap r T)
    (f : Frame Nat) (l k : W)
    (val : Nat → P455Quotient.Q (rules r allow mark) T)
    (diff : P455Quotient.eval (rules r allow mark) capT val (side f l k false) ≠
      P455Quotient.eval (rules r allow mark) capT val (side f l k true)) :
    ∃ bit : Bool,
      P455Quotient.eval (rules r allow mark) capT val (side f l k bit) ≠
        P455Quotient.zero (rules r allow mark) T ∧
      (∃ h : Nat → W, ∀ a ∈ side f l k bit,
        P455Quotient.Good (rules r allow mark) T (h a) ∧
        P455Quotient.ofWord (rules r allow mark) T (h a) = val a) ∧
      (∀ h : Nat → W, (∀ a ∈ side f l k bit,
        P455Quotient.ofWord (rules r allow mark) T (h a) = val a) →
        ∃ V left right, P455Quotient.Variant (rules r allow mark) T V ∧
          V = left ++ (side f l k bit).flatMap h ++ right) := by
  classical
  let R := rules r allow mark
  have live : ∃ bit, P455Quotient.eval R capT val (side f l k bit) ≠ P455Quotient.zero R T := by
    by_cases nz : P455Quotient.eval R capT val (side f l k false) ≠ P455Quotient.zero R T
    · exact ⟨false,nz⟩
    · exact ⟨true,fun z => diff ((Classical.not_not.mp nz).trans z.symm)⟩
  obtain ⟨bit,nz⟩ := live
  refine ⟨bit,nz,?_,?_⟩
  · have word (a) (ha : a ∈ side f l k bit) :=
      P455Quotient.nonzero_representative R (val a) (P455Quotient.live_inputs R capT val _ nz a ha)
    let h (a : Nat) := if ha : a ∈ side f l k bit then (word a ha).choose else []
    refine ⟨h,fun a ha => ?_⟩
    simpa only [h,dif_pos ha] using (word a ha).choose_spec
  · intro h reps
    exact (P455Quotient.arbitrary_representatives R capT val _ h reps).mp nz
end P455Uncrossed
end
section
namespace P455EffectiveQReach
open P455Quotient
variable {α : Type} [DecidableEq α]
def via (edge : α → α → Bool) : List α → α → α → Bool
  | [], x, y => decide (x = y) || edge x y
  | z::zs, x, y => via edge zs x y || (via edge zs x z && via edge zs z y)
private theorem initial (e : α → α → Bool) (s : List α) {a b : α} (h : a = b ∨ e a b = true) :
    via e s a b = true := by
  induction s with
  | nil => simpa [via] using h
  | cons z zs ih => simp [via,ih]
private theorem splice (e : α → α → Bool) (s : List α) {a b c : α} (mem : b∈s)
    (p : via e s a b = true) (q : via e s b c = true) : via e s a c = true := by
  induction s generalizing a b c with
  | nil => simp at mem
  | cons z zs ih =>
    simp only [via,Bool.or_eq_true,Bool.and_eq_true] at p q ⊢
    rcases List.mem_cons.mp mem with rfl|tail
    · exact Or.inr ⟨p.elim id (·.1),q.elim id (·.2)⟩
    · rcases p with p|⟨px,py⟩ <;> rcases q with q|⟨qx,qy⟩
      · exact .inl (ih tail p q)
      · exact .inr ⟨ih tail p qx,qy⟩
      · exact .inr ⟨px,ih tail py q⟩
      · exact .inr ⟨px,qy⟩
theorem sound {rel : α → α → Prop} (e : α → α → Bool) (ok : ∀ x y,e x y = true → rel x y)
    (s : List α) {a b : α} (h : via e s a b = true) : Walk rel a b := by
  induction s generalizing a b with
  | nil =>
    simp only [via,Bool.or_eq_true,decide_eq_true_eq] at h
    rcases h with rfl|h
    · exact .refl _
    · exact .snoc (.refl _) (ok _ _ h)
  | cons z zs ih =>
    simp only [via,Bool.or_eq_true,Bool.and_eq_true] at h
    exact h.elim ih (fun ⟨p,q⟩ => (ih p).trans (ih q))
theorem complete {rel : α → α → Prop} (e : α → α → Bool) (ok : ∀ x y,rel x y → e x y = true)
    (s : List α) {a b : α} (cover : ∀ x, Walk rel a x → x∈s) (p : Walk rel a b) :
    via e s a b = true := by
  induction p with
  | refl => exact initial _ _ (.inl rfl)
  | snoc p step ih => exact splice _ _ (cover _ p) ih (initial _ _ (.inr (ok _ _ step)))
end P455EffectiveQReach
end
section
namespace P455Witness
open Problem455.Slots
abbrev W := List Nat
abbrev Tag := List Bool
abbrev Marking := Nat → Nat → Prop
inductive Query where
  | fixed (p : Prop)
  | count (a n : Nat)
  | deficient (a : Nat)
  | record (a b : Nat) (tag : Tag)
  | markedBit (a b : Nat) (tag : Tag) (bit : Bool)
  | order (pattern : List Event)
  | slot (owner i a : Nat)
  | separate (a b : Nat)
  | both (x y : Query)
  | either (x y : Query)
def Holds (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) : Query → Prop
  | .fixed p => p
  | .count a n => w.count a = n
  | .deficient a => w.count a < r
  | .record a b tag => a ≠ b ∧ tag.length + 16 = r ∧ allow tag ∧ typed w a b tag
  | .markedBit a b tag bit => a ≠ b ∧ tag.length + 16 = r ∧ allow tag ∧ (mark a b ∨ mark b a) ∧
        select [a,b] w = profile a b tag bit
  | .order pat => (∀ e ∈ pat, e.2 ≠ r - 2) ∧ sees w pat
  | .slot o i a => slotStart i ∧ occupies w o i a
  | .separate a b => ¬ Problem455Swap.SameBlock r w a b
  | .both x y => Holds r allow mark w x ∧ Holds r allow mark w y
  | .either x y => Holds r allow mark w x ∨ Holds r allow mark w y
theorem unordered_projection {r allow mark u v} (h : P455Closure.Move r allow mark u v)
    (a b : Nat) (hm : mark a b ∨ mark b a) : select [a,b] u = select [a,b] v := by
  rcases hm with forward | reverse
  · exact h.marked_proj a b forward
  · simpa only [select_pair_symm b a] using h.marked_proj b a reverse
theorem query_invariant {r allow mark u v} (h : P455Closure.Move r allow mark u v) (q : Query) :
    Holds r allow mark u q ↔ Holds r allow mark v q := by
  induction q with
  | fixed => rfl
  | count a n => simp only [Holds, h.count_eq a]
  | deficient a => simp only [Holds, h.count_eq a]
  | record a b tag =>
    simp only [Holds]
    constructor <;> rintro ⟨ne,len,ok,t⟩
    · exact ⟨ne,len,ok,(h.typed_iff a b tag ne len).mp t⟩
    · exact ⟨ne,len,ok,(h.typed_iff a b tag ne len).mpr t⟩
  | markedBit a b tag bit =>
    simp only [Holds]
    constructor <;> rintro ⟨ne,len,ok,mk,t⟩
    · exact ⟨ne,len,ok,mk,(unordered_projection h a b mk) ▸ t⟩
    · exact ⟨ne,len,ok,mk,(unordered_projection h a b mk).symm ▸ t⟩
  | order pat =>
    constructor <;> rintro ⟨imm,t⟩
    · exact ⟨imm,(h.order_iff pat imm).mp t⟩
    · exact ⟨imm,(h.order_iff pat imm).mpr t⟩
  | slot o i a =>
    constructor <;> rintro ⟨hi,t⟩
    · exact ⟨hi,(h.slot_iff o i a hi).mp t⟩
    · exact ⟨hi,(h.slot_iff o i a hi).mpr t⟩
  | separate a b => exact not_congr (Problem455BlockBridge.move_sameBlock h a b)
  | both _ _ ih jh => exact and_congr ih jh
  | either _ _ ih jh => exact or_congr ih jh
def allQ : List Query → Query
  | [] => .fixed True
  | q :: qs => .both q (allQ qs)
def flagQ (b : Bool) (q : Query) : Query := if b then q else .fixed True
structure Node where
  owner : Nat
  mate : Nat
  tag : Tag
  deriving DecidableEq
def typedNode (n : Node) := Query.record n.owner n.mate n.tag
def markedNode (n : Node) (b : Bool) := Query.markedBit n.owner n.mate n.tag b
def earlier (a i b j : Nat) := Query.order [(a,i),(b,j)]
def earlyBefore (xs ys : W) := allQ (xs.flatMap fun x => ys.map fun y => earlier x 2 y 0)
def earlyDisjoint (xs ys : W) := Query.either (earlyBefore xs ys) (earlyBefore ys xs)
inductive ContactChoice where
  | record (tag : Tag) (reverseRoles : Bool)
  | port (phase : Fin 5) (reverseOrder : Bool)
def contact (r a b : Nat) : ContactChoice → Query
  | .record tag rev => if rev then .record b a tag else .record a b tag
  | .port port rev =>
    let i := 3 + 2 * port.val
    let x := if rev then b else a
    let y := if rev then a else b
    allQ [.fixed (a ≠ b), .count a r, .count b r, earlyDisjoint [a] [b],
          .order [(x,i),(y,i),(x,i+1),(y,i+1)]]
def route (r start : Nat) (steps : List (Nat × ContactChoice)) (terminal : Nat → Query) : Query :=
  match steps with
  | [] => terminal start
  | (b,c) :: rest => .both (contact r start b c) (route r b rest terminal)
inductive SlotDefect where
  | deficient (a : Nat)
  | overflow (occupants : List Nat)
def differentBlocks : W → Query
  | [] => .fixed True
  | a :: xs => .both (allQ (xs.map (Query.separate a))) (differentBlocks xs)
def terminalSlot (r owner i : Nat) : SlotDefect → Query
  | .deficient a => .both (.slot owner i a) (.deficient a)
  | .overflow xs =>
    allQ [.fixed (xs.length = 5), differentBlocks (owner :: xs),
          allQ (xs.map fun a => .both (.count a r) (.slot owner i a))]
structure SlotCertificate where
  anchor : Node
  bit : Bool
  startAtMate : Bool
  steps : List (Nat × ContactChoice)
  terminalIndex : Nat
  defect : SlotDefect
def SlotCertificate.query (s : SlotCertificate) (r : Nat) : Query :=
  let start := if s.startAtMate then s.anchor.mate else s.anchor.owner
  allQ [markedNode s.anchor s.bit, .fixed (s.steps.length ≤ 6),
        route r start s.steps (fun o => terminalSlot r o s.terminalIndex s.defect)]
structure Tiles where
  horizontal : Tag → Tag → Prop
  vertical : Tag → Tag → Prop
  left : Tag → Bool
  right : Tag → Bool
  top : Tag → Bool
  bottom : Tag → Bool
  oddColumn : Tag → Bool
  oddRow : Tag → Bool
def orientedPort (phase : Nat) (a b : Node) : Query :=
  let i := 3 + 2 * phase
  let x := a.owner; let y := a.mate; let z := b.owner; let t := b.mate
  allQ [typedNode a, typedNode b, earlyDisjoint [x,y] [z,t],
        .order [(x,i),(y,i),(z,i),(t,i),(x,i+1),(y,i+1),(z,i+1),(t,i+1)]]
inductive Dir | right | left | down | up
def rightward (ts : Tiles) (a b : Node) :=
  allQ [.fixed (ts.horizontal a.tag b.tag), orientedPort (if ts.oddColumn a.tag then 1 else 0) a b,
        earlier a.owner (13+a.tag.length) b.owner (13+a.tag.length)]
def downward (ts : Tiles) (a b : Node) : Query :=
  .both (.fixed (ts.vertical a.tag b.tag))
    (orientedPort (if ts.oddRow a.tag then 3 else 2) a b)
def neighbor (ts : Tiles) (a b : Node) : Dir → Query
  | .right => rightward ts a b
  | .left => rightward ts b a
  | .down => downward ts a b
  | .up => downward ts b a
structure FunctionalityCertificate where
  anchor : Node
  bit : Bool
  b : Node
  c : Node
  dir : Dir
  distinguishMate : Bool
def FunctionalityCertificate.query (f : FunctionalityCertificate) (ts : Tiles) :=
  let role := fun n : Node => if f.distinguishMate then n.mate else n.owner
  allQ [markedNode f.anchor f.bit, neighbor ts f.anchor f.b f.dir,
        neighbor ts f.anchor f.c f.dir, .separate (role f.b) (role f.c)]
structure EdgeCertificate where
  a : Node
  b : Node
  right : Node
  left : Node
  down : Node
  up : Node
  diagonal : Node
def endOfRow (ts : Tiles) (a : Node) :=
  if ts.oddRow a.tag then ts.left a.tag else ts.right a.tag
def localCert (ts : Tiles) (e : EdgeCertificate) :=
  let a := e.a
  allQ [flagQ (!ts.right a.tag) (rightward ts a e.right),
        flagQ (!ts.left a.tag) (rightward ts e.left a),
        flagQ (!ts.bottom a.tag) (downward ts a e.down),
        flagQ (!ts.top a.tag) (downward ts e.up a),
        flagQ (!ts.right a.tag && !ts.bottom a.tag)
          (.both (downward ts e.right e.diagonal) (rightward ts e.down e.diagonal))]
def chosenSuccessor (ts : Tiles) (e : EdgeCertificate) : Query :=
  let a := e.a; let b := e.b
  if endOfRow ts a && ts.bottom a.tag then
    allQ [.fixed ((ts.top b.tag && ts.left b.tag && !ts.oddRow b.tag && !ts.oddColumn b.tag) = true),
          .either (orientedPort 4 a b) (orientedPort 4 b a), earlier b.owner 0 a.owner 0]
  else
    let next := if endOfRow ts a then e.down else if ts.oddRow a.tag then e.left else e.right
    .both (.fixed (next = b)) (earlier a.owner 0 b.owner 0)
def EdgeCertificate.query (e : EdgeCertificate) (ts : Tiles) :=
  allQ [markedNode e.a true, markedNode e.b false, localCert ts e, chosenSuccessor ts e]
inductive Certificate where
  | slot (s : SlotCertificate)
  | functionality (f : FunctionalityCertificate)
  | edge (e : EdgeCertificate)
def Certificate.query (c : Certificate) (r : Nat) (ts : Tiles) :=
  match c with
  | .slot s => s.query r
  | .functionality f => f.query ts
  | .edge e => e.query ts
abbrev rules := Problem455Finite.rules
theorem arbitrary_reps_designated {r allow mark T} (cap : P455Quotient.Cap r T)
    {β : Type} (val : β → P455Quotient.Q (rules r allow mark) T) (v : List β)
    (h : β → W) (reps : ∀ x ∈ v, P455Quotient.ofWord (rules r allow mark) T (h x) = val x)
    (live : P455Quotient.eval (rules r allow mark) cap val v ≠ P455Quotient.zero (rules r allow mark) T)
    (c : Certificate) (ts : Tiles) (initial : Holds r allow mark T (c.query r ts)) :
    ∃ w l t, P455Quotient.Variant (rules r allow mark) T w ∧
      w = l ++ v.flatMap h ++ t ∧ Holds r allow mark w (c.query r ts) := by
  apply P455Quotient.designated (rules r allow mark) cap val v h reps live _ initial
  exact fun mv old => (query_invariant mv _).mp old
end P455Witness
end
