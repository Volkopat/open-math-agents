namespace P455IndexedProduct
open P455Table P455NumericProduct P455FirstRewrite P455FirstTesters
theorem transport {A B : Type} {M : Model A} {N : Model B} {T : Matrix}
    (present : Represents T M) (f : A → B)
    (inj : ∀ x y, f x = f y → x = y) (surj : ∀ y, ∃ x, f x = y)
    (unit : f M.unit = N.unit) (mul : ∀ x y, f (M.op x y) = N.op (f x) (f y)) : Represents T N := by
  obtain ⟨X,rfl,⟨p⟩⟩ := present
  exact ⟨X,rfl,⟨⟨fun i => f (p.decode i),fun i j eq => p.inj i j (inj _ _ eq),by
    intro y; obtain ⟨x,rfl⟩ := surj y; obtain ⟨i,e⟩ := p.surj x; exact ⟨i,congrArg f e⟩,
    (congrArg f p.one_eq).trans unit,fun i j => (congrArg f (p.mul_eq i j)).trans (mul _ _)⟩⟩⟩
abbrev Sections {I : Type} (F : I → Type) (s : List I) := (i : I) → i∈s → F i
def restricted {I : Type} {F : I → Type} (models : (i:I) → Model (F i)) (s : List I) : Model (Sections F s) where
  op a b i h := (models i).op (a i h) (b i h)
  unit i _ := (models i).unit
  assoc _ _ _ := funext (fun i => funext fun _ => (models i).assoc ..)
  oneL _ := funext fun i => funext fun _ => (models i).oneL _
  oneR _ := funext fun i => funext fun _ => (models i).oneR _
def full {I : Type} {F : I → Type} (models : (i : I) → Model (F i)) : Model ((i : I) → F i) where
  op f g i := (models i).op (f i) (g i)
  unit i := (models i).unit
  assoc _ _ _ := funext fun i => (models i).assoc ..
  oneL _ := funext fun i => (models i).oneL _
  oneR _ := funext fun i => (models i).oneR _
def glue {I : Type} [DecidableEq I] {F : I → Type} (j : I) (s : List I) (v : F j × Sections F s) :
    Sections F (j::s) := fun i h =>
  if eq : j = i then eq ▸ v.1 else v.2 i ((List.mem_cons.mp h).resolve_left (Ne.symm eq))
private theorem glue_inj {I : Type} [DecidableEq I] {F : I → Type} (j : I) (s : List I) (fresh : j∉s)
    (u v : F j × Sections F s) (e : glue j s u = glue j s v) : u = v := by
  apply Prod.ext
  · simpa [glue] using congrArg (fun f : Sections F (j::s) => f j List.mem_cons_self) e
  · funext i h
    have diff : j≠i := fun eq => fresh (eq ▸ h)
    simpa [glue,diff] using congrArg (fun f : Sections F (j::s) => f i (List.mem_cons_of_mem _ h)) e
private theorem glue_surj {I : Type} [DecidableEq I] {F : I → Type} (j : I) (s : List I)
    (v : Sections F (j::s)) : ∃ u, glue j s u = v := by
  refine ⟨(v j List.mem_cons_self,fun i h => v i (List.mem_cons_of_mem _ h)),?_⟩
  funext i h
  by_cases eq : j = i
  · subst i; simp [glue]
  · simp [glue,eq]
theorem partial_product {I : Type} [DecidableEq I] {F : I → Type} (models : (i : I) → Model (F i))
    (raw : I → Matrix) (ok : ∀ i, Represents (raw i) (models i))
    (s : List I) (nd : s.Nodup) : Represents (assemble (s.map raw)) (restricted models s) := by
  induction s with
  | nil =>
    let send (_ : Unit) : Sections F [] := fun _ h => nomatch h
    apply transport (M:=unitModel) (f:=send) ⟨unitOps,rfl,⟨unitPresents⟩⟩
    · intro _ _ _; rfl
    · intro y; exact ⟨(),funext fun _ => funext fun h => nomatch h⟩
    · exact funext fun _ => funext fun h => nomatch h
    · intro _ _; exact funext fun _ => funext fun h => nomatch h
  | cons j s ih =>
    have info := List.nodup_cons.mp nd
    apply transport (represents_tensor (ok j) (ih info.2)) (glue j s)
      (glue_inj j s info.1) (glue_surj j s)
    · funext i h
      by_cases eq : j = i
      · subst i; simp [glue,combine,restricted]
      · simp [glue,eq,combine,restricted]
    · intro u v; funext i h
      by_cases eq : j = i
      · subst i; simp [glue,combine,restricted]
      · simp [glue,eq,combine,restricted]
theorem complete_product {I : Type} [DecidableEq I] {F : I → Type} (models : (i : I) → Model (F i))
    (raw : I → Matrix) (ok : ∀ i, Represents (raw i) (models i)) (s : List I)
    (nd : s.Nodup) (all : ∀ i, i∈s) :
    Represents (assemble (s.map raw)) (full models) := by
  apply transport (partial_product models raw ok s nd) (fun f i => f i (all i))
  · intro f g eq; exact funext fun i => funext fun _ => congrFun eq i
  · intro g; exact ⟨fun i _ => g i,rfl⟩
  · rfl
  · intro _ _; rfl
end P455IndexedProduct
end
section
namespace P455NumericProductPrim
open P455Table P455NumericProduct
variable {A : Type} [Primcodable A]
theorem entry' {T : A → Matrix} {i j : A → Nat} (t : Primrec T) (a : Primrec i) (b : Primrec j) :
    Primrec (fun x => entry (T x) (i x) (j x)) := by
  have row := Primrec.option_getD.comp (Primrec.list_getElem?.comp t a) (Primrec.const [])
  exact Primrec.option_getD.comp (Primrec.list_getElem?.comp row b) (Primrec.const 0)
theorem grid' {n : A → Nat} {f : A → Nat → Nat → Nat} (dim : Primrec n)
    (elem : Primrec (fun p : (A×Nat)×Nat => f p.1.1 p.1.2 p.2)) :
    Primrec fun x => grid (n x) (f x) := by
  exact Primrec.list_map (Primrec.list_range.comp dim)
    (Primrec₂.mk (Primrec.list_map (Primrec.list_range.comp (dim.comp Primrec.fst)) elem.to₂))
theorem tensor' : Primrec₂ tensor := by
  apply Primrec₂.mk
  apply grid' (Primrec.nat_mul.comp (Primrec.list_length.comp Primrec.fst) (Primrec.list_length.comp Primrec.snd))
  let Src := ((Matrix×Matrix)×Nat)×Nat
  have l : Primrec (fun a : Src => a.1.1.1) := Primrec.fst.comp (Primrec.fst.comp Primrec.fst)
  have r : Primrec (fun a : Src => a.1.1.2) := Primrec.snd.comp (Primrec.fst.comp Primrec.fst)
  have d := Primrec.list_length.comp r
  have i : Primrec (fun a : Src => a.1.2) := Primrec.snd.comp Primrec.fst
  have j : Primrec (fun a : Src => a.2) := Primrec.snd
  exact Primrec.nat_add.comp (entry' r (Primrec.nat_mod.comp i d) (Primrec.nat_mod.comp j d))
    (Primrec.nat_mul.comp (entry' l (Primrec.nat_div.comp i d) (Primrec.nat_div.comp j d)) d)
theorem assemble' : Primrec assemble := by
  exact Primrec.list_foldr (h:=fun (_ : List Matrix) (p : Matrix × Matrix) => tensor p.1 p.2) (Primrec.id (α:=List Matrix)) (Primrec.const P455NumericProduct.singleton)
    (Primrec₂.mk (tensor'.comp (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.snd)))
end P455NumericProductPrim
end
section
namespace P455BinaryBasis
open P455BinaryTerms P455FirstRewrite P455Table P455TableSemantics
def eval (T : Matrix) (f : Nat → Nat) : Term → Nat
  | .var x => f x
  | .mul s t => entry T (eval T f s) (eval T f t)
def ValidTerm (T : Matrix) (s t : Term) :=
  ∀ f : Nat → Nat, (∀ x, f x < T.length) → eval T f s = eval T f t
def HasTermBasis (T : Matrix) := ∃ rules : List (Term × Term),
    (∀ s t, (s,t)∈rules → ValidTerm T s t) ∧
    ∀ s t, ValidTerm T s t → Proof (fun x y => (x,y)∈rules) s t
theorem entry_lt {T : Matrix} (good : SemigroupTable T) {i j : Nat}
    (hi : i < T.length) (hj : j < T.length) : entry T i j < T.length := by
  have row := good.2.1 T[i] (List.getElem_mem hi)
  have bound : j < T[i].length := row.1.symm ▸ hj
  have inr := row.2 T[i][j] (List.getElem_mem bound)
  simpa [entry,List.getElem?_eq_getElem hi,List.getElem?_eq_getElem bound] using inr
theorem value_lt {T : Matrix} (good : SemigroupTable T) {f : Nat → Nat}
    (bounded : ∀ i, f i < T.length) (a : Nat) (w : W) : value T f a w < T.length := by
  induction w generalizing a with
  | nil => exact bounded a
  | cons b xs ih => exact entry_lt good (bounded a) (ih b)
theorem concatenate {T : Matrix} (good : SemigroupTable T) {f : Nat → Nat}
    (bounded : ∀ i, f i < T.length) (a : Nat) (A : W) (b : Nat) (B : W) :
    value T f a (A++b::B) = entry T (value T f a A) (value T f b B) := by
  induction A generalizing a with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.cons_append,value,ih]
    exact (good.2.2 _ _ _ (bounded a) (value_lt good bounded x xs) (value_lt good bounded b B)).symm
theorem eval_flat {T : Matrix} (good : SemigroupTable T) {f : Nat → Nat}
    (bounded : ∀ i, f i < T.length) (s : Term) : eval T f s = wordValue T f (flat s) := by
  induction s with
  | var x => rfl
  | mul s t ih ik =>
    simp only [eval,flat,ih,ik]
    obtain ⟨a,A,e⟩ := List.exists_cons_of_ne_nil (nonempty s)
    obtain ⟨b,B,h⟩ := List.exists_cons_of_ne_nil (nonempty t)
    rw [e,h]
    exact (concatenate good bounded a A b B).symm
theorem valid_flat {T : Matrix} (good : SemigroupTable T) (s t : Term) :
    ValidTerm T s t ↔ Valid T (flat s) (flat t) := by
  constructor <;> intro h f bounded
  · exact (eval_flat good bounded s).symm.trans ((h f bounded).trans (eval_flat good bounded t))
  · exact (eval_flat good bounded s).trans ((h f bounded).trans (eval_flat good bounded t).symm)
private theorem word_rule {rules : List (W×W)} {u v : W} (m : (u,v)∈rules) (un : u≠[]) (vn : v≠[]) :
    Derives (fun a b => (a,b)∈rules) u v :=
  .snoc (.refl u) ⟨u,v,[],[],fun i => [i],.inl m,un,vn,by simp,by simp,by simp⟩
theorem basis_iff_words {T : Matrix} (good : SemigroupTable T) :
    HasTermBasis T ↔ HasBasis T := by
  constructor
  · rintro ⟨terms,sound,complete⟩
    let words := terms.map (fun p => (flat p.1,flat p.2))
    refine ⟨words,?_,?_⟩
    · intro u v m
      obtain ⟨⟨s,t⟩,mem,e⟩ := List.mem_map.mp m
      cases e
      exact ⟨nonempty _,nonempty _,(valid_flat good _ _).mp (sound _ _ mem)⟩
    · intro u v un vn ok
      have valid : ValidTerm T (fromWord u) (fromWord v) :=
        (valid_flat good _ _).mpr (by simpa only [flat_from un,flat_from vn] using ok)
      have derive := terms_to_words (G:=fun x y => (x,y)∈words)
        (fun s t m => word_rule (List.mem_map_of_mem m) (nonempty s) (nonempty t))
        (complete _ _ valid)
      simpa only [flat_from un,flat_from vn] using derive
  · rintro ⟨words,sound,complete⟩
    let terms := words.map (fun p => (fromWord p.1,fromWord p.2))
    refine ⟨terms,?_,?_⟩
    · intro s t m
      obtain ⟨⟨u,v⟩,mem,e⟩ := List.mem_map.mp m
      cases e
      obtain ⟨un,vn,ok⟩ := sound _ _ mem
      apply (valid_flat good _ _).mpr
      simpa only [flat_from un,flat_from vn] using ok
    · intro s t ok
      have derive := complete _ _ (nonempty s) (nonempty t) ((valid_flat good _ _).mp ok)
      have path := words_to_terms (H:=fun x y => (x,y)∈terms)
        (fun _ _ m => Proof.gen (List.mem_map_of_mem m)) derive
      exact (norm _ s).trans (path.trans (norm _ t).symm)
end P455BinaryBasis
end
