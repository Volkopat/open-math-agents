namespace P455DefectRename
open P455Witness P455Paths P455ContactLift P455SourceFamilies
open P455ContactReflection P455PortReflection P455DefectProjection Problem455.Slots
def decode (keep : W) (i : Nat) : Nat := (keep[i]?).getD 0
theorem decode_idx (keep : W) {a : Nat} (h : a ∈ keep) : decode keep (keep.idxOf a) = a := by
  induction keep with
  | nil => contradiction
  | cons b keep ih =>
    by_cases eq : b = a
    · subst b; simp [decode]
    · have ha : a ∈ keep := (List.mem_cons.mp h).resolve_left (Ne.symm eq)
      simpa [decode,List.idxOf_cons,cond_eq_if,beq_iff_eq,eq] using ih ha
theorem decode_map {keep w : W} (hs : ∀ a ∈ w, a ∈ keep) :
    (w.map keep.idxOf).map (decode keep) = w := by
  rw [List.map_map]
  calc
    _ = w.map id := List.map_congr_left (fun a ha => decode_idx keep (hs a ha))
    _ = w := List.map_id w
def extend (keep : W) (a : Nat) := if a ∈ keep then keep.idxOf a else keep.length + a
theorem extend_inj (keep : W) {a b : Nat} (h : extend keep a = extend keep b) : a = b := by
  by_cases ha : a ∈ keep <;> by_cases hb : b ∈ keep <;> simp only [extend,ha,hb,if_true,if_false] at h
  · simpa only [decode_idx keep ha, decode_idx keep hb] using congrArg (decode keep) h
  · have := List.idxOf_lt_length_of_mem ha; omega
  · have := List.idxOf_lt_length_of_mem hb; omega
  · omega
abbrev Injects (d : Nat → Nat) := ∀ {a b}, d a = d b → a = b
theorem select_map_inj (d : Nat → Nat) (inj : Injects d) (keep w : W) :
    select (keep.map d) (w.map d) = (select keep w).map d := by
  induction w with
  | nil => rfl
  | cons a w ih =>
    have iff : d a ∈ keep.map d ↔ a ∈ keep := by
      constructor
      · intro h; obtain ⟨b,hb,eq⟩ := List.mem_map.mp h; exact inj eq ▸ hb
      · exact List.mem_map_of_mem
    by_cases ha : a ∈ keep <;> simp_all [select]
theorem kept {keep w : W} {a : Nat} (h : a ∈ select keep w) : a ∈ keep := by
  simpa using (List.mem_filter.mp h).2
theorem extend_map {keep w : W} (hs : ∀ a ∈ w, a ∈ keep) :
    w.map (extend keep) = w.map keep.idxOf :=
  List.map_congr_left (fun a ha => by simp [extend, hs a ha])
theorem binary_select_map (keep w : W) {x y : Nat} (hx : x ∈ keep) (hy : y ∈ keep) :
    (select [x,y] w).map keep.idxOf =
    select [keep.idxOf x,keep.idxOf y] ((select keep w).map keep.idxOf) := by
  have h := select_map_inj (extend keep) (extend_inj keep) [x,y] (select keep w)
  rw [select_sub keep [x,y] w (by simpa using And.intro hx hy),
      extend_map (fun _ ha => kept ha),
      extend_map (keep := keep) (w := select [x,y] w) (by
        intro a ha; have hxy : a = x ∨ a = y := by simpa using kept ha
        rcases hxy with rfl|rfl <;> assumption)] at h
  simpa [extend,hx,hy] using h.symm
theorem count_rename (d : Nat → Nat) (inj : Injects d) (w : W) (a : Nat) :
    (w.map d).count (d a) = w.count a := by
  induction w with
  | nil => rfl
  | cons b w ih =>
    by_cases eq : b = a
    · subst b; simp [ih]
    · have ne : d b ≠ d a := fun e => eq (inj e)
      simp [eq,ne,ih, List.count_cons, beq_iff_eq]
theorem cap_rename {r w} (d : Nat → Nat) (inj : Injects d) (cp : P455Closure.Cap r w) :
    P455Closure.Cap r (w.map d) := by
  intro a
  by_cases mem : a ∈ w.map d
  · obtain ⟨b,_,rfl⟩ := List.mem_map.mp mem
    simpa only [count_rename d inj] using cp b
  · simp [List.count_eq_zero.mpr mem]
theorem rename_sees (d : Nat → Nat) (inj : Injects d) {w pat} (obs : sees w pat) :
    sees (w.map d) (pat.map (eventMap d)) := by
  unfold sees events at *
  rw [← stamp_map d w w (fun _ => 0) (fun _ => 0) (fun _ h => h) (fun _ _ _ _ h => inj h) (fun _ _ => rfl)]
  exact obs.map _
theorem rename_order {r allow src dst w} (d : Nat → Nat) (inj : Injects d) (pat : List Event)
    (h : Holds r allow src w (.order pat)) :
    Holds r allow dst (w.map d) (.order (pat.map (eventMap d))) := by
  refine ⟨?_,rename_sees d inj h.2⟩
  intro e he; obtain ⟨f,hf,rfl⟩ := List.mem_map.mp he; exact h.1 f hf
theorem rename_pattern (d : Nat → Nat) (inj : Injects d) {w a b tag bit}
    (h : select [a,b] w = profile a b tag bit) :
    select [d a,d b] (w.map d) = profile (d a) (d b) tag bit := by
  rw [← map_profile d a b tag bit, ← h, ← select_map_inj d inj [a,b] w]
  rfl
theorem rename_marked {r allow src w} (d : Nat → Nat) (inj : Injects d) (n : Node) (bit : Bool)
    (h : Holds r allow src w (markedNode n bit)) :
    Holds r allow (markNode (sendNode d n)) (w.map d) (markedNode (sendNode d n) bit) :=
  ⟨fun e => h.1 (inj e),h.2.1,h.2.2.1,.inl ⟨rfl,rfl⟩,rename_pattern d inj h.2.2.2.2⟩
theorem rename_record {r allow src dst w a b tag} (d : Nat → Nat) (inj : Injects d)
    (h : Holds r allow src w (.record a b tag)) :
    Holds r allow dst (w.map d) (.record (d a) (d b) tag) := by
  obtain ⟨ne,len,ok,bit,pr⟩ := h
  exact ⟨fun e => ne (inj e),len,ok,bit,rename_pattern d inj pr⟩
theorem rename_contact {r allow src dst w} (d : Nat → Nat) (inj : Injects d) (a b : Nat) (c : ContactChoice)
    (h : Holds r allow src w (contact r a b c)) :
    Holds r allow dst (w.map d) (contact r (d a) (d b) c) := by
  cases c with
  | record tag rev => cases rev <;> exact rename_record d inj h
  | port phase rev =>
    obtain ⟨ab,ac,bc,early,obs,last⟩ := h
    refine ⟨fun e => ab (inj e),(count_rename d inj w a).trans ac,(count_rename d inj w b).trans bc,?_,?_,last⟩
    · rcases early with ⟨h,_⟩|⟨h,_⟩
      · exact .inl ⟨rename_order d inj [(a,2),(b,0)] h,True.intro⟩
      · exact .inr ⟨rename_order d inj [(b,2),(a,0)] h,True.intro⟩
    · cases rev <;> exact rename_order d inj _ obs
theorem rename_walk {r allow src dst w} (d : Nat → Nat) (inj : Injects d) (a : Nat) (p : List Step)
    (h : Walk r allow src w a p) :
    Walk r allow dst (w.map d) (d a) (relabel d p) := by
  induction p generalizing a with
  | nil => trivial
  | cons bc p ih => exact ⟨rename_contact d inj a bc.1 bc.2 h.1,ih _ h.2⟩
theorem rename_deficient {r allow w} (d : Nat → Nat) (inj : Injects d) (s : SlotCertificate)
    (b : Nat) (kind : s.defect = .deficient b) (h : Holds r allow (markNode s.anchor) w (s.query r)) :
    Holds r allow (markNode (sendSlot d s).anchor) (w.map d) ((sendSlot d s).query r) := by
  obtain ⟨len,walk,term⟩ := slot_route s h
  let start := picked s
  have start' : picked (sendSlot d s) = d start := by
    cases side : s.startAtMate <;> simp [sendSlot,picked,sendNode,start,side]
  rw [kind] at term
  obtain ⟨⟨slot,j,seen⟩,cnt⟩ := term
  refine ⟨rename_marked d inj s.anchor s.bit h.1,by simpa [sendSlot,relabel,P455Witness.Holds] using len,?_,True.intro⟩
  apply (route_iff ..).mpr
  change Walk _ _ _ _ (picked (sendSlot d s)) (relabel d s.steps) ∧ Holds _ _ _ _
    (terminalSlot r (endpoint (picked (sendSlot d s)) (relabel d s.steps)) s.terminalIndex (sendDefect d s.defect))
  rw [start',endpoint_relabel,kind]
  exact ⟨rename_walk d inj start s.steps walk,⟨slot,j,rename_sees d inj seen⟩,by simpa only [Holds,count_rename d inj] using cnt⟩
theorem canonical_defect {r allow mark u} (cap : P455Closure.Cap r u) (n : Node) (bit side : Bool)
    (t i bad : Nat) (anchor : Holds r allow (markNode n) u (markedNode n bit))
    (near : Near r allow mark u (if side then n.mate else n.owner) t 6)
    (slot : slotStart i) (occ : occupies u t i bad) (deficient : u.count bad < r) :
    ∃ (keep : W) (s : SlotCertificate), keep.length ≤ 9 ∧ n.owner ∈ keep ∧ n.mate ∈ keep ∧
      s.anchor.owner = keep.idxOf n.owner ∧ s.anchor.mate = keep.idxOf n.mate ∧ s.bit = bit ∧
      s.defect = .deficient (keep.idxOf bad) ∧ (∀ a ∈ (select keep u).map keep.idxOf, a < 9) ∧
      P455Closure.Cap r ((select keep u).map keep.idxOf) ∧
      Holds r allow (markNode s.anchor) ((select keep u).map keep.idxOf) (s.query r) := by
  obtain ⟨keep,s,len,ho,hm,hb,kind,anc,bs,cp,h⟩ :=
    bounded_defect_kind cap n bit side t i bad anchor near slot occ deficient
  let d := extend keep
  have mapEq := extend_map (keep := keep) (w := select keep u) (fun _ ha => kept ha)
  have valid := rename_deficient d (extend_inj keep) s bad kind (by simpa only [anc] using h)
  refine ⟨keep,sendSlot d s,len,ho,hm,by simp [sendSlot,sendNode,d,extend,anc,ho],
    by simp [sendSlot,sendNode,d,extend,anc,hm],bs,by simp [sendSlot,sendDefect,kind,d,extend,hb],?_,?_,?_⟩
  · intro a ha; obtain ⟨b,bm,rfl⟩ := List.mem_map.mp ha
    exact Nat.lt_of_lt_of_le (List.idxOf_lt_length_of_mem (kept bm)) len
  · rw [← mapEq]; exact cap_rename d (extend_inj keep) cp
  · rw [← mapEq]; exact valid
end P455DefectRename
end
section
namespace P455BlockSeparators
open P455Witness Problem455.Slots Problem455Swap
inductive Directed (e : Nat → Nat → Prop) : Nat → Nat → Prop
  | refl (a) : Directed e a a
  | snoc {a b c} : Directed e a b → e b c → Directed e a c
theorem prepend {e a b c} (h : e a b) (p : Directed e b c) : Directed e a c := by
  induction p with
  | refl => exact .snoc (.refl _) h
  | snoc _ last ih => exact .snoc ih last
theorem split_first {e a b} (p : Directed e a b) :
    a = b ∨ ∃ c, e a c ∧ Directed e c b := by
  induction p with
  | refl => exact .inl rfl
  | @snoc y z _ last ih =>
    rcases ih with eq|⟨c,first,rest⟩
    · exact .inr ⟨z, eq ▸ last,.refl z⟩
    · exact .inr ⟨c,first,.snoc rest last⟩
theorem orient {e a b} (outgoing : ∀ {x y z}, e x y → e x z → y = z)
    (incoming : ∀ {x y z}, e y x → e z x → y = z) (p : Joined e a b) :
    Directed e a b ∨ Directed e b a := by
  induction p with
  | refl => exact .inl (.refl _)
  | @extend y z prev h ih =>
    rcases ih with f|b
    · rcases h with f'|b'
      · exact .inl (.snoc f f')
      · cases f with
        | refl => exact .inr (.snoc (.refl _) b')
        | snoc rest last => exact .inl (incoming last b' ▸ rest)
    · rcases h with f'|b'
      · rcases split_first b with eq|⟨c,first,rest⟩
        · exact .inl (eq ▸ Directed.snoc (.refl _) f')
        · exact .inr (outgoing first f' ▸ rest)
      · exact .inr (prepend b' b)
theorem directed_of_same {r w a b} (hr : 0 < r) (cap : P455Closure.Cap r w)
    (same : SameBlock r w a b) : Directed (Link r w) a b ∨ Directed (Link r w) b a := by
  apply orient _ _ same.2.2
  · intro x y z xy xz
    apply Classical.byContradiction; intro ne
    have h := out_bound x y z ne w
    rw [show bigram x y w = r from xy,show bigram x z w = r from xz,Problem455BlockBridge.occ_count] at h
    have hx := cap x; omega
  · intro x y z yx zx
    apply Classical.byContradiction; intro ne
    have h := Nat.le_trans (in_bound y z x ne w) (tail_occ_le x w)
    rw [show bigram y x w = r from yx,show bigram z x w = r from zx,Problem455BlockBridge.occ_count] at h
    have hx := cap x; omega
def rows (a : Nat) : W → List W
  | [] => []
  | b :: w => if a = b then (b :: w) :: rows a w else rows a w
theorem rows_length (a : Nat) (w : W) : (rows a w).length = w.count a := by
  induction w with
  | nil => rfl
  | cons b w ih => by_cases eq : a = b <;> simp_all [rows,List.count_cons,beq_iff_eq,Ne.symm]
private def edgeRows (a b : Nat) : W → List W
  | [] => []
  | c :: w => if c = a ∧ w.head? = some b then w :: edgeRows a b w else edgeRows a b w
private theorem edgeRows_length (a b : Nat) (w : W) : (edgeRows a b w).length = bigram a b w := by
  induction w with
  | nil => rfl
  | cons c w ih =>
    by_cases test : c = a ∧ w.head? = some b <;> simp [edgeRows,bigram,hit,test,ih,Nat.add_comm]
private theorem edge_sub_left (a b : Nat) (w : W) :
    ((edgeRows a b w).map (List.cons a)).Sublist (rows a w) := by
  induction w with
  | nil => exact .slnil
  | cons c w ih =>
    by_cases k : c = a
    · subst c
      by_cases h : w.head? = some b
      · simpa [edgeRows,rows,h] using ih.cons₂ (a::w)
      · simpa [edgeRows,rows,h] using ih.cons (a::w)
    · simpa [rows,edgeRows,k,Ne.symm k] using ih
private theorem edge_sub_right (a b : Nat) (w : W) :
    (edgeRows a b w).Sublist (rows b w.tail) := by
  induction w with
  | nil => exact .slnil
  | cons c w ih =>
    cases w with
    | nil => simp [rows,edgeRows]
    | cons x t =>
      by_cases mem : x = b
      · subst x
        by_cases yes : c = a
        · simpa [rows,edgeRows,yes] using ih.cons₂ (b::t)
        · simpa [rows,edgeRows,yes] using ih.cons (b::t)
      · simpa [rows,edgeRows,mem,Ne.symm mem] using ih
theorem link_rows {r a b w} (cap : P455Closure.Cap r w) (link : Link r w a b) :
    rows a w = (rows b w).map (List.cons a) := by
  have l := edge_sub_left a b w
  have f := edge_sub_right a b w
  have s : (rows b w.tail).Sublist (rows b w) := by
    cases w with
    | nil => exact .slnil
    | cons x t =>
      by_cases eq : b = x
      · simp [rows,eq]
      · simp [rows,eq]
  have t := f.trans s
  have len : (edgeRows a b w).length = r := (edgeRows_length ..).trans link
  have e := t.eq_of_length_le (by rw [rows_length,len]; exact cap b)
  have g := l.eq_of_length_le (by rw [List.length_map,rows_length,len]; exact cap a)
  rw [← g,e]
theorem directed_prefix {r w a b} (cap : P455Closure.Cap r w) (p : Directed (Link r w) a b) :
    ∃ pre : W, rows a w = (rows b w).map (pre ++ ·) := by
  induction p with
  | refl => exact ⟨[],by simp⟩
  | @snoc y z prev edge ih =>
    obtain ⟨pre,h⟩ := ih
    refine ⟨pre ++ [y],?_⟩
    rw [h,link_rows cap edge,List.map_map]
    apply List.map_congr_left
    intro row _; simp
theorem row_head {a : Nat} {w row : W} (h : row ∈ rows a w) : row.head? = some a := by
  induction w with
  | nil => contradiction
  | cons x w ih =>
    by_cases eq : a = x
    · subst x; rcases (show row = a::w ∨ row ∈ rows a w by simpa [rows] using h) with rfl|old
      · rfl
      · exact ih old
    · exact ih (by simpa [rows,eq] using h)
theorem all_next {w : W} (a b : Nat)
    (h : ∀ z ∈ rows a w, z.tail.head? = some b) : bigram a b w = w.count a := by
  induction w with
  | nil => rfl
  | cons x w ih =>
    by_cases eq : x = a
    · subst x
      have next := h (a::w) (by simp [rows])
      have recProof := ih (fun z hz => h z (by simp [rows,hz]))
      simp [bigram,hit,show w.head? = some b from next,recProof,Nat.add_comm]
    · have recProof := ih (fun z hz => h z (by simp [rows,Ne.symm eq,hz]))
      simp [bigram,hit,eq,recProof,List.count_cons,beq_iff_eq]
theorem directed_of_prefix {r w b} (hr : 0 < r) (cap : P455Closure.Cap r w)
    (cb : w.count b = r) (pre : W) (a : Nat)
    (eq : rows a w = (rows b w).map (pre ++ ·)) : Directed (Link r w) a b := by
  have non : rows b w ≠ [] := by
    intro z; have h := rows_length b w; rw [z,cb] at h; simp at h; omega
  obtain ⟨z,hz⟩ := List.exists_mem_of_ne_nil _ non
  induction pre generalizing a with
  | nil =>
    have e : rows a w = rows b w := by simpa using eq
    have ma := row_head (e ▸ hz : z ∈ rows a w)
    exact (show a = b by simpa [row_head hz] using ma.symm) ▸ Directed.refl _
  | cons c p ih =>
    have ma := row_head (w := w) (a := a) (row := (c::p)++z)
      (eq ▸ List.mem_map_of_mem hz)
    have ac : c = a := by simpa using ma
    subst c
    let next := p.head?.getD b
    have all (v) (hv : v ∈ rows b w) : (p ++ v).head? = some next := by
      cases p with
      | nil => simpa [next] using row_head hv
      | cons x xs => rfl
    have ct : w.count a = r := by simpa [rows_length,cb] using congrArg List.length eq
    have li : Link r w a next := by
      apply Eq.trans _ ct; apply all_next
      intro t ht
      rw [eq] at ht
      obtain ⟨v,hv,rfl⟩ := List.mem_map.mp ht
      exact all v hv
    apply prepend li
    apply ih
    have strip := congrArg (List.map List.tail) ((link_rows cap li).symm.trans eq)
    simpa [List.map_map,Function.comp_def] using strip
theorem directed_joined {e a b} (p : Directed e a b) : Joined e a b := by
  induction p with
  | refl => exact .refl _
  | snoc _ last ih => exact .extend ih (.inl last)
theorem reversed_joined {e a b} (p : Directed e a b) : Joined e b a := by
  induction p with
  | refl => exact .refl _
  | snoc _ last ih =>
    have cat {x y z} (p : Joined e x y) (q : Joined e y z) : Joined e x z := by
      induction q with
      | refl => exact p
      | extend _ t j => exact .extend j t
    exact cat (.extend (.refl _) (.inr last)) ih
theorem project_rows (keep : W) {a : Nat} (ha : a ∈ keep) (w : W) :
    rows a (select keep w) = (rows a w).map (select keep) := by
  induction w with
  | nil => rfl
  | cons b w ih =>
    by_cases eq : a = b
    · subst b; simp [rows,select,ha,ih] at *
    · by_cases hb : b ∈ keep <;> simp [rows,select,ha,hb,eq,ih] at *
theorem pair_ext {w v : W} (pairs : ∀ c d : Nat, select [c,d] w = select [c,d] v) : w = v := by
  induction w generalizing v with
  | nil =>
    cases v with
    | nil => rfl
    | cons b v => simpa [select] using pairs b b
  | cons a w ih =>
    cases v with
    | nil => simpa [select] using pairs a a
    | cons b v =>
      have eq : a = b := by simpa [select] using congrArg List.head? (pairs a b)
      subst b
      apply congrArg (List.cons a)
      apply ih
      intro c d
      by_cases ac : a = c <;> by_cases ad : a = d <;> simpa [select,ac,ad] using pairs c d
theorem rowmaps_ext {as bs : List W} (pairs : ∀ c d : Nat,
    as.map (select [c,d]) = bs.map (select [c,d])) : as = bs := by
  induction as generalizing bs with
  | nil => cases bs with
           | nil => rfl
           | cons b bs => simpa using pairs 0 0
  | cons a as ih =>
    cases bs with
    | nil => simpa using pairs 0 0
    | cons b bs =>
      have h (c d) := List.cons.inj (show select [c,d] a :: as.map (select [c,d]) =
        select [c,d] b :: bs.map (select [c,d]) from pairs c d)
      exact List.cons.injEq _ _ _ _ |>.mpr ⟨pair_ext fun c d => (h c d).1,ih fun c d => (h c d).2⟩
theorem row_suffix {a : Nat} {w row : W} (m : row ∈ rows a w) : row <:+ w := by
  induction w with
  | nil => contradiction
  | cons x w ih =>
    by_cases eq : a = x
    · subst x; rcases (show row = a::w ∨ row ∈ rows a w by simpa [rows] using m) with rfl|old
      · exact List.suffix_refl _
      · exact (ih old).trans (List.suffix_cons _ _)
    · exact (ih (by simpa [rows,eq] using m)).trans (List.suffix_cons _ _)
theorem project_prefix (keep : W) (pre : W) (bs : List W) :
    (bs.map (pre ++ ·)).map (select keep) =
    (bs.map (select keep)).map (select keep pre ++ ·) := by
  simp [List.map_map, Function.comp_def, select, List.filter_append]
private theorem reconstruct {r w a b} (hr : 0 < r) (cp : P455Closure.Cap r w)
    (cb : w.count b = r) (ne : a ≠ b) (A B : W) (As Bs : List W)
    (aa : rows a w = A::As) (bb : rows b w = B::Bs) (pre : W) (first : A = pre ++ B)
    (merges : ∀ c d : Nat, ∃ keep : W, a ∈ keep ∧ b ∈ keep ∧ c ∈ keep ∧ d ∈ keep ∧
        SameBlock r (select keep w) a b) : Directed (Link r w) a b := by
  have ma : A ∈ rows a w := by simp [aa]
  have mb : B ∈ rows b w := by simp [bb]
  have headA := row_head ma
  have headB := row_head mb
  have pre_head : pre.head? = some a := by
    cases pre with
    | nil => simp_all
    | cons x p => simpa [first] using headA
  apply directed_of_prefix hr cp cb pre
  apply rowmaps_ext
  intro c d
  obtain ⟨keep,ha,hb,hc,hd,sm⟩ := merges c d
  have not_empty : select keep pre ≠ [] := by
    cases pre with
    | nil => contradiction
    | cons x p =>
      have eq : x = a := by simpa using pre_head
      simp [select,eq,ha]
  have rx := project_rows keep ha w
  have ry := project_rows keep hb w
  have capK := P455DefectProjection.select_cap keep cp
  have hdir := directed_of_same hr capK sm
  have orient' : ∃ k : W, rows a (select keep w) = (rows b (select keep w)).map (k ++ ·) := by
    rcases hdir with f|g
    · exact directed_prefix capK f
    · obtain ⟨k,h⟩ := directed_prefix capK g
      rw [rx,ry,aa,bb] at h
      have eq := (List.cons.inj h).1
      have len := congrArg List.length eq
      simp only [first,select_append,List.length_append] at len
      have pos := List.length_pos_iff.mpr not_empty
      omega
  obtain ⟨k,h⟩ := orient'
  rw [rx,ry] at h
  have fst := h
  rw [aa,bb] at fst
  have eq := (List.cons.inj fst).1
  change select keep A = k ++ select keep B at eq
  rw [first,select_append] at eq
  have := List.append_cancel_right eq
  subst k
  rw [← project_prefix] at h
  let f := select [c,d]
  have nested : ∀ z : W, f (select keep z) = f z := fun z =>
    P455DefectProjection.select_sub keep [c,d] z (by simpa using And.intro hc hd)
  have proj := congrArg (List.map f) h
  simpa only [List.map_map, Function.comp_def,nested] using proj
theorem robust_separators {r w a b} (hr : 0 < r) (cp : P455Closure.Cap r w)
    (ca : w.count a = r) (cb : w.count b = r) (apart : ¬ SameBlock r w a b) :
    ∃ c d : Nat, ∀ keep : W, a ∈ keep → b ∈ keep → c ∈ keep → d ∈ keep →
      ¬ SameBlock r (select keep w) a b := by
  classical
  apply Classical.byContradiction
  intro contra
  have merges : ∀ c d : Nat, ∃ keep : W, a ∈ keep ∧ b ∈ keep ∧ c ∈ keep ∧ d ∈ keep ∧
        SameBlock r (select keep w) a b := by
    intro c d
    apply Classical.byContradiction; intro miss
    apply contra; refine ⟨c,d,?_⟩
    intro keep ha hb hc hd hm
    exact miss ⟨keep,ha,hb,hc,hd,hm⟩
  have oba : occ a w = r := (Problem455BlockBridge.occ_count ..).trans ca
  have obb : occ b w = r := (Problem455BlockBridge.occ_count ..).trans cb
  have ne : a ≠ b := by rintro rfl; exact apart ⟨oba,obb,.refl _⟩
  apply apart
  refine ⟨oba,obb,?_⟩
  have split (z : Nat) (cz : w.count z = r) : ∃ h t, rows z w = h::t := by
    cases eq : rows z w with
    | nil => have := rows_length z w; rw [eq,cz] at this; simp at this; omega
    | cons h t => exact ⟨h,t,rfl⟩
  obtain ⟨A,As,aa⟩ := split a ca
  obtain ⟨B,Bs,bb⟩ := split b cb
  rcases List.suffix_or_suffix_of_suffix (row_suffix (a := b) (by simp [bb] : B ∈ rows b w))
    (row_suffix (a := a) (by simp [aa] : A ∈ rows a w)) with ⟨pre,h⟩|⟨pre,h⟩
  · exact directed_joined (reconstruct hr cp cb ne A B As Bs aa bb pre h.symm merges)
  · apply reversed_joined (reconstruct hr cp ca ne.symm B A Bs As bb aa pre h.symm ?_)
    intro c d
    obtain ⟨keep,ha,hb,hc,hd,m⟩ := merges c d
    refine ⟨keep,hb,ha,hc,hd,m.2.1,m.1,?_⟩
    rcases directed_of_same hr (P455DefectProjection.select_cap keep cp) m with f|g
    · exact reversed_joined f
    · exact directed_joined g
end P455BlockSeparators
end
section
namespace P455FirstTesters
open P455FirstRewrite P455Quotient
def plain (r : Nat) : Rules Nat where
  r := r
  step := fun _ _ => False
  reverse := False.elim
  counts := False.elim
  extend := False.elim
def power (r : Nat) : W := List.replicate r 0
def Binary (r : Nat) (T : W) := (∀ x ∈ T, x = 0 ∨ x = 1) ∧
  Cap r T ∧ 0 < T.count 0 ∧ 0 < T.count 1 ∧ (T.count 0 < r ∨ T.count 1 < r)
abbrev Index (r : Nat) := { T : W // T = power r ∨ Binary r T }
def Index.cap {r : Nat} (i : Index r) : Cap (plain r).r i.val := by
  rcases i.property with e | b
  · intro x; rw [e,power,List.count_replicate]; split <;> simp [plain]
  · exact b.2.1
private theorem binary_length {T : W} (letters : ∀ x ∈ T, x = 0 ∨ x = 1) :
    T.length = T.count 0 + T.count 1 := by
  induction T with
  | nil => rfl
  | cons x t ih =>
    have tail := ih (fun y m => letters y (List.mem_cons_of_mem _ m))
    rcases letters x List.mem_cons_self with rfl | rfl <;> simp [List.count_cons] <;> omega
theorem index_covered {r : Nat} (i : Index r) : i.val ∈ Problem455Finite.wordsUpTo [0, 1] (2*r) := by
  apply Problem455Finite.covered
  · rcases i.property with e | b
    · rw [e,power,List.length_replicate]; omega
    · have cnt := binary_length b.1
      have l := b.2.1 0
      have h := b.2.1 1
      omega
  · intro x m
    rcases i.property with e | b
    · rw [e] at m; have := List.eq_of_mem_replicate m; simp_all [power]
    · simpa using b.1 x m
abbrev Carrier (r : Nat) := (i : Index r) → Q (plain r) i.val
def product (r : Nat) : Model (Carrier r) where
  op := fun x y i => mul (plain r) i.cap (x i) (y i)
  unit := fun i => ofWord (plain r) i.val []
  assoc := fun x y z => funext (fun i => mul_assoc (plain r) i.cap (x i) (y i) (z i))
  oneL := fun x => funext (fun i => (unit_laws (plain r) i.cap (x i)).1)
  oneR := fun x => funext (fun i => (unit_laws (plain r) i.cap (x i)).2)
theorem observed {r u v} (h : (product r).Valid u v) (i : Index r) (f : Sub) :
    ofWord (plain r) i.val (u.flatMap f) = ofWord (plain r) i.val (v.flatMap f) := by
  let val : Nat → Carrier r := fun x j => ofWord (plain r) j.val (f x)
  have comp (w : W) : (product r).eval val w i = ofWord (plain r) i.val (w.flatMap f) := by
    induction w with
    | nil => rfl
    | cons x xs ih =>
      change mul (plain r) i.cap (ofWord (plain r) i.val (f x)) ((product r).eval val xs i) = _
      rw [ih]; rfl
  exact (comp u).symm.trans ((congrFun (h val) i).trans (comp v))
private theorem reflect {r : Nat} {T A B : W} (factor : Factor A T)
    (eq : ofWord (plain r) T A = ofWord (plain r) T B) : A = B := by
  have good : Good (plain r) T A := ⟨T,.refl T,factor⟩
  have path := ((same_nonzero_class (plain r) good).mp eq).2
  induction path with
  | refl => rfl
  | snoc _ f _ => exact False.elim f
def unaryImage (x z : Nat) : W := if z = x then [0] else []
private theorem unary_word (x : Nat) (w : W) :
    w.flatMap (unaryImage x) = power (w.count x) := by
  induction w with
  | nil => rfl
  | cons z t ih =>
    by_cases e : z = x <;> simp [List.flatMap_cons,unaryImage,e,List.count_cons,ih,power,
      List.replicate_succ]
private theorem small_count {r u v} (h : (product r).Valid u v) {x : Nat} (bd : u.count x ≤ r) :
    u.count x = v.count x := by
  let i : Index r := ⟨power r,Or.inl rfl⟩
  have eq := observed h i (unaryImage x)
  simp only [unary_word] at eq
  have fac : Factor (power (u.count x)) (power r) := by
    refine ⟨[], power (r-u.count x), ?_⟩
    simp only [List.nil_append,power,List.replicate_append_replicate]
    congr 1; omega
  simpa [power] using congrArg List.length (reflect fac eq)
def code (i j x : Nat) : W := if x = i then [0] else if x = j then [1] else []
private theorem code_letters (i j : Nat) (w : W) (x : Nat) (m : x ∈ w.flatMap (code i j)) :
    x = 0 ∨ x = 1 := by
  obtain ⟨y,_,m⟩ := List.mem_flatMap.mp m
  unfold code at m
  split at m
  · exact Or.inl (List.mem_singleton.mp m)
  · split at m
    · exact Or.inr (List.mem_singleton.mp m)
    · simp at m
private theorem code_counts (i j : Nat) (ne : i ≠ j) (w : W) :
    (w.flatMap (code i j)).count 0 = w.count i ∧ (w.flatMap (code i j)).count 1 = w.count j := by
  induction w with
  | nil => simp
  | cons x xs ih =>
    by_cases xi : x = i <;> by_cases xj : x = j <;>
      simp_all [List.flatMap_cons,code,List.count_cons]
private theorem decode (i j : Nat) (w : W) :
    (w.flatMap (code i j)).map (fun z => if z = 0 then i else j) = proj i j w := by
  induction w with
  | nil => rfl
  | cons x t ih =>
    by_cases e : x = i <;> by_cases f : x = j <;> simp_all [List.flatMap_cons,code,proj]
private theorem only_one {i j : Nat} (u : W) (miss : j ∉ u) :
    proj i j u = List.replicate (u.count i) i := by
  induction u with
  | nil => rfl
  | cons x t ih =>
    have nx : x ≠ j := fun e => miss (e ▸ List.mem_cons_self)
    have tail := ih (fun m => miss (List.mem_cons_of_mem x m))
    by_cases xi : x = i <;> simp_all [proj,List.count_cons,List.replicate_succ]
private theorem proj_swap (i j : Nat) (w : W) : proj i j w = proj j i w := by
  simp only [proj,Or.comm]
private theorem identical_letter (i : Nat) (w : W) :
    proj i i w = List.replicate (w.count i) i := by
  induction w with
  | nil => rfl
  | cons z t ih => by_cases eq : z = i <;> simp_all [proj,List.count_cons,List.replicate_succ]
theorem tester_rule {r u v} (h : (product r).Valid u v) : TesterRule r u v := by
  have clipped (x) : min (u.count x) (r+1) = min (v.count x) (r+1) := by
    by_cases a : u.count x ≤ r
    · rw [small_count h a]
    · by_cases b : v.count x ≤ r
      · rw [small_count (fun f => (h f).symm) b]
      · omega
  refine ⟨clipped,?_⟩
  intro cu cv i j diff
  have counts (x) : u.count x = v.count x := by have := clipped x; have := cu x; omega
  have ne : i ≠ j := by
    intro e; subst j; apply diff; rw [identical_letter, identical_letter, counts]
  have positive (a b) (d : proj a b u ≠ proj a b v) : 0 < u.count b := by
    apply Nat.pos_of_ne_zero; intro zero; apply d
    have zv : v.count b = 0 := (counts b).symm.trans zero
    rw [only_one u (List.count_eq_zero.mp zero),only_one v (List.count_eq_zero.mp zv),counts]
  have pj := positive i j diff
  have pi := positive j i (by simpa only [proj_swap j i] using diff)
  apply Classical.byContradiction
  intro fail
  have low : u.count i < r ∨ u.count j < r := by
    have := cu i; have := cu j; omega
  let T := u.flatMap (code i j)
  obtain ⟨c0,c1⟩ := code_counts i j ne u
  have letters := code_letters i j u
  have cap : Cap r T := by
    intro x
    by_cases mem : x ∈ T
    · rcases letters x mem with rfl | rfl
      · exact c0 ▸ cu i
      · exact c1 ▸ cu j
    · rw [List.count_eq_zero_of_not_mem mem]; omega
  let ix : Index r := ⟨T,Or.inr ⟨letters,cap,c0 ▸ pi,c1 ▸ pj,by simpa only [T,c0,c1] using low⟩⟩
  have eq := observed h ix (code i j)
  have fac : Factor T T := ⟨[],[],by simp⟩
  have ee := reflect fac eq
  dsimp [T] at ee
  apply diff
  rw [← decode i j u,← decode i j v,ee]
def combine {A B : Type} (M : Model A) (N : Model B) : Model (A × B) where
  op := fun x y => (M.op x.1 y.1,N.op x.2 y.2)
  unit := (M.unit,N.unit)
  assoc := fun _ _ _ => Prod.ext (M.assoc ..) (N.assoc ..)
  oneL := fun _ => Prod.ext (M.oneL _) (N.oneL _)
  oneR := fun _ => Prod.ext (M.oneR _) (N.oneR _)
theorem valid_left {A B : Type} (M : Model A) (N : Model B) {u v}
    (h : (combine M N).Valid u v) : M.Valid u v := by
  intro f
  let g := fun x => (f x,N.unit)
  have fst (w : W) : ((combine M N).eval g w).1 = M.eval f w := by
    induction w with
    | nil => rfl
    | cons x t ih => exact congrArg (M.op (f x)) ih
  exact (fst u).symm.trans ((congrArg Prod.fst (h g)).trans (fst v))
theorem first_change_no_finite_basis {A : Type} (N : Model A) (r : Nat) (hr : 0 < r)
    (witnesses : ∀ k, ∃ U V D, RankWitness (combine (product r) N) r U V D ∧ k < D.length)
    (G : List (W × W)) (valid : ∀ u v, (u,v) ∈ G → (combine (product r) N).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (combine (product r) N).Valid U V ∧
      ¬ Derives (fun u v => (u,v) ∈ G) U V :=
  no_finite_basis_of_witnesses _ r hr (fun _ _ h => tester_rule (valid_left _ _ h))
    witnesses G valid
end P455FirstTesters
end
section
namespace P455Schedule
abbrev Edges := Nat → Nat → Prop
abbrev Bits := Nat → Bool
inductive Path (R : Edges) : Nat → Nat → Prop
  | edge {x y} (e : R x y) : Path R x y
  | join {x y z} (l : Path R x y) (r : Path R y z) : Path R x z
def induced (C : List Nat) (E : Edges) : Edges := fun a b => a ∈ C ∧ b ∈ C ∧ E a b
def Acyclic (C : List Nat) (E : Edges) := ∀ a, ¬Path (induced C E) a a
def Good (C : List Nat) (E : Edges) (s : Bits) :=
  ∀ a b, E a b → (a ∈ C ∨ b ∈ C) → s a = true → s b = true
def Flip (C : List Nat) (E : Edges) (available : Nat → Prop) (s t : Bits) :=
  Good C E s ∧ Good C E t ∧ ∃ a ∈ C, available a ∧ s a ≠ t a ∧ ∀ b, b ≠ a → s b = t b
def Down (C : List Nat) (E : Edges) (available : Nat → Prop) (s t : Bits) :=
  Flip C E available s t ∧ ∀ a, t a = true → s a = true
def meet (A B : Bits) : Bits := fun a => A a && B a
private theorem minimal {R : Edges} (no : ∀ a, ¬ R a a)
    (tr : ∀ {a b c}, R a b → R b c → R a c) (xs : List Nat) (ne : xs ≠ []) :
    ∃ a ∈ xs, ∀ b ∈ xs, ¬ R b a := by
  induction xs with
  | nil => exact (ne rfl).elim
  | cons x xs ih =>
    by_cases emp : xs = []
    · subst xs
      refine ⟨x,List.mem_cons_self,?_⟩
      intro b hb
      obtain rfl := List.mem_singleton.mp hb
      exact no b
    obtain ⟨a,mem,first⟩ := ih emp
    by_cases e : R x a
    · refine ⟨x,List.mem_cons_self,?_⟩
      intro b hb
      rcases List.mem_cons.mp hb with eq|hit
      · exact eq ▸ no x
      · exact fun k => first b hit (tr k e)
    · refine ⟨a,List.mem_cons_of_mem _ mem,?_⟩
      intro b hb
      rcases List.mem_cons.mp hb with eq|hit
      · exact eq ▸ e
      · exact first b hit
private theorem switch {C E} (acy : Acyclic C E) (available : Nat → Prop) (s t : Bits)
    (sOK : Good C E s) (tOK : Good C E t) (todo : List Nat)
    (uniq : todo.Nodup)
    (all : ∀ a ∈ todo, a ∈ C ∧ available a ∧ s a = true ∧ t a = false)
    (cover : ∀ a, s a ≠ t a → a ∈ todo) :
    P455Quotient.Walk (Down C E available) s t := by
  classical
  by_cases empty : todo = []
  · have eq : s = t := by
      funext a; apply Classical.byContradiction; intro diff
      exact List.not_mem_nil (empty ▸ cover a diff)
    rw [eq]; exact .refl _
  obtain ⟨a,am,first⟩ :=
    minimal (R := Path (induced C E)) acy (fun m n => .join m n) todo empty
  obtain ⟨ac,ch,sa,ta⟩ := all a am
  let v : Bits := fun j => if j = a then false else s j
  have change : v a = false := by simp [v]
  have fixed (j) (h : j ≠ a) : v j = s j := by simp [v,h]
  have vOK : Good C E v := by
    intro i j edge touch on
    have si : s i = true := by
      by_cases eq : i = a
      · subst i; simp [change] at on
      · exact (fixed i eq).symm.trans on
    by_cases eq : j = a
    · subst j
      have off : t i = false := by
        cases e : t i with
        | false => rfl
        | true => have impossible := tOK i a edge (.inr ac) e; simp [ta] at impossible
      have active := cover i (by simp [si,off])
      exact False.elim (first i active (.edge ⟨(all i active).1,ac,edge⟩))
    · exact (fixed j eq).trans (sOK i j edge touch si)
  have single : Down C E available s v := by
    refine ⟨⟨sOK,vOK,a,ac,ch,by simp [sa,change],fun j ne => (fixed j ne).symm⟩,?_⟩
    intro j h
    by_cases eq : j = a
    · subst j; simp [change] at h
    · exact (fixed j eq).symm.trans h
  have next (j) (hj : j ∈ todo.erase a) :
      j ∈ C ∧ available j ∧ v j = true ∧ t j = false := by
    obtain ⟨ne,hit⟩ := uniq.mem_erase_iff.mp hj
    obtain ⟨h1,h2,h3,h4⟩ := all j hit
    exact ⟨h1,h2,(fixed j ne).trans h3,h4⟩
  have rem (j) (diff : v j ≠ t j) : j ∈ todo.erase a := by
    by_cases eq : j = a
    · subst j; exact False.elim (diff (change.trans ta.symm))
    · exact uniq.mem_erase_iff.mpr ⟨eq,cover j (fun h => diff ((fixed j eq).trans h))⟩
  have tail := switch acy available v t vOK tOK (todo.erase a) (uniq.erase a) next rem
  exact (P455Quotient.Walk.snoc (.refl _) single).trans tail
termination_by todo.length
decreasing_by
  have n := List.length_erase_of_mem am
  have pos : 0 < todo.length := List.length_pos_iff.mpr empty
  omega
private theorem down_to_meet {C E} (acy : Acyclic C E) (A B : Bits) (gA : Good C E A) (gB : Good C E B)
    (fixed : ∀ a, A a ≠ B a → a ∈ C) :
    P455Quotient.Walk (Down C E (fun a => A a = true ∧ B a = false)) A (meet A B) := by
  let todo := (P455FirstRewrite.names C).filter (fun a => A a && !B a)
  have inTodo (a) : a ∈ todo ↔ a ∈ C ∧ A a = true ∧ B a = false := by
    simp [todo,P455FirstRewrite.mem_names]
  have ok : Good C E (meet A B) := by
    intro i j edge hit h
    obtain ⟨a,b⟩ := Bool.and_eq_true_iff.mp h
    exact Bool.and_eq_true_iff.mpr ⟨gA i j edge hit a,gB i j edge hit b⟩
  apply switch acy _ _ _ gA ok todo ((P455FirstRewrite.names_distinct C).sublist List.filter_sublist)
  · intro a ha
    obtain ⟨hc,h1,h2⟩ := (inTodo a).mp ha
    exact ⟨hc,⟨h1,h2⟩,h1,by simp [meet,h2]⟩
  · intro a diff
    cases ha : A a <;> cases hb : B a <;> simp [meet,ha,hb] at diff
    exact (inTodo a).mpr ⟨fixed a (by simp [ha,hb]),ha,hb⟩
theorem phases {C E} (acy : Acyclic C E) (A B : Bits) (gA : Good C E A) (gB : Good C E B)
    (fixed : ∀ a, A a ≠ B a → a ∈ C) :
    P455Quotient.Walk (Down C E (fun a => A a = true ∧ B a = false)) A (meet A B) ∧
    P455Quotient.Walk (Down C E (fun a => B a = true ∧ A a = false)) B (meet A B) := by
  have eq : meet B A = meet A B := by funext a; exact Bool.and_comm ..
  exact ⟨down_to_meet acy A B gA gB fixed,eq ▸ down_to_meet acy B A gB gA (fun a d => fixed a (Ne.symm d))⟩
def Toward (C : List Nat) (E : Edges) (goal : Bits) (s t : Bits) :=
  Flip C E (fun a => t a = goal a) s t
private theorem map_walk {R S : Bits → Bits → Prop} {a b : Bits}
    (path : P455Quotient.Walk R a b) (one : ∀ {u v}, R u v → S u v) : P455Quotient.Walk S a b := by
  induction path with
  | refl => exact .refl _
  | snoc _ m ih => exact .snoc ih (one m)
private theorem reverse_path {R : Bits → Bits → Prop} {a b : Bits}
    (h : P455Quotient.Walk (fun s t => R t s) a b) : P455Quotient.Walk R b a := by
  induction h with
  | refl => exact .refl _
  | snoc _ m ih => exact (P455Quotient.Walk.snoc (.refl _) m).trans ih
theorem schedule {C E} (acy : Acyclic C E) (A B : Bits) (gA : Good C E A) (gB : Good C E B)
    (fixed : ∀ a, A a ≠ B a → a ∈ C) :
    P455Quotient.Walk (Toward C E B) A B := by
  obtain ⟨lhs,rhs⟩ := phases acy A B gA gB fixed
  apply (map_walk lhs (S := Toward C E B) ?_).trans
  · exact reverse_path (map_walk rhs (S := fun s t => Toward C E B t s) (by
      intro s t st
      obtain ⟨⟨ok1,ok2,a,hc,ab,ne,unch⟩,down⟩ := st
      have ons : s a = true := by cases h : s a <;> cases k : t a <;> simp_all
      exact ⟨ok2,ok1,a,hc,ons.trans ab.1.symm,Ne.symm ne,fun j h => (unch j h).symm⟩))
  · intro s t st
    obtain ⟨⟨ok1,ok2,a,hc,ab,ne,unch⟩,down⟩ := st
    have off : t a = false := by cases h : s a <;> cases k : t a <;> simp_all
    exact ⟨ok1,ok2,a,hc,off.trans ab.2.symm,ne,unch⟩
end P455Schedule
end
section
namespace P455EffectiveMachine
open P455MachineLocal P455MachineCleanup
structure Code (g q : Nat) where
  marker : Fin g
  blank : Fin g
  start : Fin q
  rows : Vector (Vector (Option (Ins (Fin g) (Fin q))) g) q
def quote (M : Ordinary g q) : Code g q :=
  ⟨M.marker,M.blank,M.start,Vector.ofFn (fun s => Vector.ofFn (M.delta s))⟩
def dirCode : Direction → Nat | .left => 0 | .stay => 1 | .right => 2
def entryCode (g : Nat) (i : Option (Ins (Fin g) (Fin q))) : Nat :=
  match i with
  | none => 0
  | some x => 1+3*(g*x.state.val+x.symbol.val)+dirCode x.dir
def Code.numerals (C : Code g q) : List Nat :=
  [g,q,C.marker.val,C.blank.val,C.start.val] ++
  C.rows.toList.flatMap (fun row => row.toList.map (entryCode g))
def unary (n : Nat) := List.replicate n true ++ [false]
def Code.bits (C : Code g q) : List Bool := C.numerals.flatMap unary
end P455EffectiveMachine
end
section
namespace P455SourceTheorem
open P455Witness P455Paths P455ContactLift P455SourceFamilies P455PortReflection
open P455EdgeSource P455Retained P455OriginalWalk Problem455.Slots
def startLabel (c : Certificate) (second mate : Bool) : Nat :=
  match c with
  | .slot s => picked s
  | .functionality f => f.anchor.owner
  | .edge e =>
    let n := if second then e.b else e.a
    if mate then n.mate else n.owner
def transferred (d : Nat → Nat) : Certificate → Certificate
  | .slot s => .slot (sendSlot d s)
  | .functionality f => .functionality (sendFunc d f)
  | .edge e => .edge (sendEdge d e)
def sourceMarks (d : Nat → Nat) : Certificate → Marking
  | .slot s => markNode (sendNode d s.anchor)
  | .functionality f => markNode (sendNode d f.anchor)
  | .edge e => endpointMarks d e
def SourceEvidence (r : Nat) (allow : Tag → Prop) (ts : Tiles) (v : W) (h : Nat → W)
    (seed : Nat) : Certificate → Prop
  | .slot s => SlotResult r allow v h seed s
  | .functionality f => FuncResult r allow ts v h f
  | .edge e => Holds r allow (endpointMarks (donor v h r) e) v ((sendEdge (donor v h r) e).query ts)
theorem in_source {r allow mark v h l k seed} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (ts : Tiles) (c : Certificate)
    (second mate : Bool) (ok : Holds r allow mark (l ++ v.flatMap h ++ k) (c.query r ts))
    (start : Supplies v h r seed (startLabel c second mate)) (guard : Guard r allow mark v seed 6) :
    SourceEvidence r allow ts v h seed c := by
  cases c with
  | slot s => exact slot_source hr cap s ok start guard
  | functionality f => exact functionality_source hr cap ts f ok start guard
  | edge e => exact edge_source_from_role hr cap ts e ok second mate start guard (by split <;> decide)
theorem arbitrary_reps_source_gadget {r allow mark T} (capT : P455Quotient.Cap r T)
    (val : Nat → P455Quotient.Q (rules r allow mark) T) (v : W) (h : Nat → W)
    (reps : ∀ x ∈ v, P455Quotient.ofWord (rules r allow mark) T (h x) = val x)
    (live : P455Quotient.eval (rules r allow mark) capT val v ≠ P455Quotient.zero (rules r allow mark) T)
    (ts : Tiles) (c : Certificate) (initial : Holds r allow mark T (c.query r ts))
    (second mate : Bool) (seed : Nat) (hr : 0 < r)
    (start : Supplies v h r seed (startLabel c second mate)) (guard : Guard r allow mark v seed 6) :
    ∃ z l k, P455Quotient.Variant (rules r allow mark) T z ∧ z = l ++ v.flatMap h ++ k ∧
      Holds r allow mark z (c.query r ts) ∧ SourceEvidence r allow ts v h seed c ∧
      ∀ p : List Step, p.length ≤ 6 → Walk r allow mark z (startLabel c second mate) p →
        Walk r allow mark v seed (relabel (donor v h r) p) ∧
        Supplies v h r (donor v h r (endpoint (startLabel c second mate) p))
                        (endpoint (startLabel c second mate) p) := by
  obtain ⟨z,l,k,path,eq,ok⟩ := arbitrary_reps_designated capT val v h reps live c ts initial
  subst z
  have cap : P455Closure.Cap r (l ++ v.flatMap h ++ k) :=
    fun s => (P455Quotient.count_walk _ path s) ▸ capT s
  exact ⟨_,l,k,path,rfl,ok,in_source hr cap ts c second mate ok start guard,
    fun p bp wp => P455ContactLift.lift_walk hr cap start guard p bp wp⟩
theorem expanded_query {r allow mark ts v h e kept seed c second mate T}
    (exp : Expansion v e kept) (hr : 1 < r) (capU : P455Closure.Cap r (v.flatMap e))
    (capF : P455Closure.Cap r (v.flatMap h))
    (p455Original : OriginalGuard r allow mark (v.flatMap e) kept seed 6)
    (start : Supplies v h r seed (startLabel c second mate))
    (ev : SourceEvidence r allow ts v h seed c)
    (initial : Holds r allow mark T (c.query r ts)) (cmp : Compressed r (v.flatMap e)) :
    let d := donor v h r
    Holds r allow (sourceMarks d c) (v.flatMap e) ((transferred d c).query r ts) := by
  let d := donor v h r
  have pos : 0 < r := by omega
  cases c with
  | edge ed =>
    exact P455OriginalEdges.expand_edge exp hr capU ev
  | functionality f =>
    obtain ⟨bit,b,c,dist,_⟩ := ev
    exact ⟨P455OriginalEdges.expand_markedNode exp hr capU bit,
      P455OriginalEdges.expand_neighbor exp hr capU f.dir b,
      P455OriginalEdges.expand_neighbor exp hr capU f.dir c,compressed_separates cmp dist,True.intro⟩
  | slot s =>
    obtain ⟨bit,walk,terminal,_⟩ := ev
    have eq : d (picked s) = seed := donor_eq pos capF start
    have big := exp.walk hr capU _ _ walk
    let m := markNode (sendNode d s.anchor)
    let finalLabel := endpoint (picked s) s.steps
    have ep : endpoint seed (relabel d s.steps) = d finalLabel := by rw [← eq,endpoint_relabel]
    have pickEq : picked (sendSlot d s) = d (picked s) := by
      cases z : s.startAtMate <;> simp [picked,sendSlot,sendNode,z]
    obtain ⟨len,_,termT⟩ := slot_route s initial
    have valid := valid_slot s.defect termT
    have bigWalk : Walk r allow mark (v.flatMap e) seed (relabel d s.steps) :=
      remark_walk _ _ big
    have reach : Near r allow mark (v.flatMap e) seed (d finalLabel) 6 :=
      ⟨relabel d s.steps,bigWalk,ep,by simpa [relabel] using len⟩
    have ownerKept := (p455Original _ reach).1
    have transfer (y : Nat) (inside : occupies v (d finalLabel) s.terminalIndex y) (cnt : v.count y = r) :
        occupies (v.flatMap e) (d finalLabel) s.terminalIndex y ∧ (v.flatMap e).count y = r := by
      have present : y ∈ v := List.count_pos_iff.mp (by omega)
      have ky : kept y := by
        apply Classical.byContradiction
        intro absent
        have := (exp.gaps y present absent).1
        omega
      have mem : y ∈ e y := by rw [exp.literal y present ky]; simp
      exact ⟨exp.in_original_slot _ _ _ ownerKept inside y mem,(exp.count_eq _ (fun _ h => h) y ky).trans cnt⟩
    have term : Holds r allow m (v.flatMap e)
        (terminalSlot r (d finalLabel) s.terminalIndex (sendDefect d s.defect)) :=
      rebuild_terminal_in d s.defect valid cmp (fun hh => donor_eq pos capF hh) transfer terminal
    refine ⟨P455OriginalEdges.expand_markedNode exp hr capU bit,by simpa [sendSlot,relabel,P455Witness.Holds] using len,?_,True.intro⟩
    apply (route_iff ..).mpr
    change Walk r allow m (v.flatMap e) (picked (sendSlot d s)) (relabel d s.steps) ∧
      Holds r allow m (v.flatMap e) (terminalSlot r (endpoint (picked (sendSlot d s)) (relabel d s.steps))
          s.terminalIndex (sendDefect d s.defect))
    rw [pickEq,endpoint_relabel]
    exact ⟨eq.symm ▸ big,term⟩
theorem arbitrary_reps_original_gadget {r allow mark T} (capT : P455Quotient.Cap r T)
    (val : Nat → P455Quotient.Q (rules r allow mark) T) (v : W) (h : Nat → W)
    (reps : ∀ x ∈ v, P455Quotient.ofWord (rules r allow mark) T (h x) = val x)
    (live : P455Quotient.eval (rules r allow mark) capT val v ≠ P455Quotient.zero (rules r allow mark) T)
    (ts : Tiles) (c : Certificate) (initial : Holds r allow mark T (c.query r ts))
    (second mate : Bool) (seed : Nat) (hr : 1 < r)
    (start : Supplies v h r seed (startLabel c second mate))
    {e kept} (exp : Expansion v e kept) (capU : P455Closure.Cap r (v.flatMap e))
    (p455Original : OriginalGuard r allow mark (v.flatMap e) kept seed 6) :
    let d := donor v h r
    let u := v.flatMap e
    let a := startLabel c second mate
    ∃ z l k, P455Quotient.Variant (rules r allow mark) T z ∧ z = l ++ v.flatMap h ++ k ∧
      Holds r allow mark z (c.query r ts) ∧ SourceEvidence r allow ts v h seed c ∧
      (Compressed r u → Holds r allow (sourceMarks d c) u ((transferred d c).query r ts)) ∧
      ∀ p : List Step, p.length ≤ 6 → Walk r allow mark z a p →
        Walk r allow mark u seed (relabel d p) ∧ endpoint seed (relabel d p) = d (endpoint a p) ∧
        (relabel d p).length = p.length ∧ kept (d (endpoint a p)) ∧
        Supplies v h r (d (endpoint a p)) (endpoint a p) ∧ Supplies u h r (d (endpoint a p)) (endpoint a p) := by
  obtain ⟨z,l,k,path,eq,ok,source,_⟩ := arbitrary_reps_source_gadget capT val v h reps live ts c initial
    second mate seed (by omega) start (exp.guard hr capU p455Original)
  subst z
  have cap : P455Closure.Cap r (l ++ v.flatMap h ++ k) :=
    fun s => (P455Quotient.count_walk _ path s) ▸ capT s
  exact ⟨_,l,k,path,rfl,ok,source,expanded_query exp hr capU (factor_cap cap) p455Original start source initial,
    fun p len walk => P455OriginalWalk.lift_walk exp hr capU p455Original cap start p len walk⟩
end P455SourceTheorem
end
section
namespace P455SmallRank
open P455Closure P455Compression P455Uncrossed
open P455FirstRewrite (names rank size_le mem_names names_distinct Step Model)
private def lits : List Piece → W
  | [] => []
  | .literal a :: t => a :: lits t
  | .gap _ :: t => lits t
private def gaps (n : Nat) : List Piece → W
  | [] => []
  | .literal _ :: t => gaps (n+1) t
  | .gap _ :: t => n :: gaps (n+1) t
private theorem gap_bound (n : Nat) : ∀ (cs : List Piece), noTouch cs →
    (gaps n cs).length ≤ (lits cs).length + 1
  | [],_ => by simp [gaps,lits]
  | .literal _ :: cs,ok => by
    have := gap_bound (n+1) cs ok
    simpa [gaps,lits] using Nat.le_step this
  | [.gap _],_ => by simp [gaps,lits]
  | .gap _ :: .literal _ :: cs,ok => by
    have h := gap_bound (n+1+1) cs ok
    simp only [gaps,lits,List.length_cons]
    omega
  | .gap _ :: .gap _ :: _,ok => False.elim ok
private theorem lit_subset (cs : List Piece) : (lits cs).Sublist (cs.flatMap body) := by
  induction cs with
  | nil => exact .slnil
  | cons p cs ih =>
    cases p with
    | literal a => exact ih.cons₂ a
    | gap w => exact ih.trans (List.sublist_append_right _ _)
private theorem cover (keep : W) (n : Nat) (cs : List Piece)
    (all : ∀ c ∈ cs,good keep c) (a : Nat) (ha : a ∈ code n cs) :
    a ∈ keep ∨ a ∈ gaps n cs := by
  induction cs generalizing n with
  | nil => cases ha
  | cons c cs ih =>
    have tail (p) (hp : p ∈ cs) := all p (List.mem_cons_of_mem _ hp)
    cases c with
    | literal x =>
      rcases List.mem_cons.mp ha with e|m
      · exact .inl (e ▸ all (.literal x) List.mem_cons_self)
      · exact ih (n+1) tail m
    | gap w =>
      rcases List.mem_cons.mp ha with e|m
      · exact .inr (List.mem_cons.mpr (.inl e))
      · exact (ih (n+1) tail m).imp_right (List.mem_cons_of_mem _)
private theorem lit_mem {keep : W} (cs : List Piece) (all : ∀ c ∈ cs,good keep c) :
    ∀ a ∈ lits cs, a ∈ keep := by
  induction cs with
  | nil => simp [lits]
  | cons c cs ih =>
    have tail (p) (hp : p ∈ cs) := all p (List.mem_cons_of_mem _ hp)
    cases c with
    | literal x =>
      intro a m; rcases List.mem_cons.mp m with e|h
      · exact e ▸ all (.literal x) List.mem_cons_self
      · exact ih tail a h
    | gap _ => exact ih tail
private theorem count_away (a : Nat) (w : W) :
    w.length = w.count a + (w.filter (· != a)).length := by
  induction w with
  | nil => rfl
  | cons b w ih =>
    by_cases e : b = a <;> simp [e,List.count_cons] <;> omega
private theorem length_bound (r : Nat) (C w : W) (cap : Cap r w)
    (covered : ∀ a ∈ w, a ∈ C) : w.length ≤ r*C.length := by
  induction C generalizing w with
  | nil =>
    cases w with
    | nil => simp
    | cons a t => exact (List.not_mem_nil (covered a List.mem_cons_self)).elim
  | cons a C ih =>
    let t := w.filter (· != a)
    have subset : t.Sublist w := List.filter_sublist
    have ht : Cap r t := fun b => Nat.le_trans (subset.count_le b) (cap b)
    have tc (b) (hb : b ∈ t) : b ∈ C := by
      obtain ⟨bw,ba⟩ := List.mem_filter.mp hb
      exact (List.mem_cons.mp (covered b bw)).resolve_left (by simpa using ba)
    have h := ih t ht tc
    have split := count_away a w
    have c := cap a
    simp only [List.length_cons,Nat.mul_succ]
    dsimp [t] at h; omega
private theorem literal_bound {r : Nat} (u keep : W) (cap : Cap r u) :
    (lits (pieces keep u)).length ≤ r*(names keep).length := by
  have sub := lit_subset (pieces keep u)
  rw [decoded] at sub
  apply length_bound
  · exact fun a => Nat.le_trans (sub.count_le a) (cap a)
  · exact fun a h => (mem_names a keep).mpr (lit_mem _ (pieces_good keep u) a h)
private theorem code_length (n : Nat) (cs : List Piece) :
    (code n cs).length = (lits cs).length + (gaps n cs).length := by
  induction cs generalizing n with
  | nil => rfl
  | cons c cs ih => cases c <;> simp [code,lits,gaps,ih,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]
theorem joint_rank {r : Nat} (u keep v : W) (cap : Cap r u)
    (same : ∀ a ∈ v, a ∈ small u keep) :
    rank (small u keep) v ≤ (names keep).length + r*(names keep).length + 1 := by
  let cs := pieces keep u
  let n := base u keep
  have l := literal_bound u keep cap
  have g := gap_bound n cs (maximal keep u)
  have le : rank (small u keep) v ≤ ((names keep) ++ gaps n cs).length := by
    apply size_le (names_distinct _)
    intro a ha
    have ma := (List.mem_append.mp ((mem_names _ _).mp ha)).elim id (same a)
    have mem := cover keep n cs (pieces_good keep u) a ma
    exact List.mem_append.mpr (mem.imp_left (mem_names a keep).mpr)
  simp only [List.length_append] at le
  dsimp only [cs] at g; dsimp only [cs] at le; omega
private theorem lookup_nonempty (keep : W) (cs : List Piece) (all : ∀ c ∈ cs,good keep c)
    (n a : Nat) : lookup n cs a ≠ [] := by
  induction cs generalizing n with
  | nil => simp [lookup]
  | cons c cs ih =>
    have tail (p) (hp : p ∈ cs) := all p (List.mem_cons_of_mem _ hp)
    cases c with
    | literal x => exact ih tail (n+1)
    | gap w =>
      by_cases e : a = n
      · simpa only [lookup,if_pos e] using (all (.gap w) List.mem_cons_self).1
      · simpa only [lookup,if_neg e] using ih tail (n+1)
theorem expansion_nonempty (u keep : W) (a : Nat) : expand u keep a ≠ [] :=
  lookup_nonempty keep _ (pieces_good keep u) _ a
theorem bounded_step {A : Type} (M : Model A) {r allowed} (f : Frame Nat)
    (l k keep : W) {x y : Nat} (hx : x ∈ keep) (hy : y ∈ keep)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allowed (fun _ _ => False))
    (b : Bool) (cap : Cap r (side f l k b))
    (semantic : M.Valid (small (side f l k b) keep) (small (side f l k (!b)) keep)) :
    let N := (names keep).length
    Step (fun u v => M.Valid u v ∧ rank u v ≤ N+r*N+1)
      (side f l k b) (side f l k (!b)) := by
  dsimp only
  obtain ⟨g,left,right,gp,_,_,eq,expanded⟩ :=
    P455CompressedFrame.canonical_pair f l k keep hx hy hp hq valid b cap
  have letters (a) (ha : a ∈ small (side f l k (!b)) keep) : a ∈ small (side f l k b) keep := by
    rw [eq] at ha ⊢
    exact (P455Uncrossed.same_letters g left right b a).mpr ha
  have nonempty (c : Bool) : small (side f l k c) keep ≠ [] := by
    rw [eq]; obtain ⟨t,e⟩ := g.core_starts c
    simp [side,e]
  refine ⟨_,_,[],[],expand (side f l k b) keep,.inl ⟨semantic,joint_rank _ _ _ cap letters⟩,
    nonempty b,nonempty (!b),expansion_nonempty _ _,?_,?_⟩
  all_goals simp only [List.nil_append,List.append_nil,eq,expanded]
end P455SmallRank
end
section
namespace P455OtherProjection
open P455Witness P455Paths P455SourceFamilies P455PortReflection P455DefectProjection Problem455.Slots
open Problem455Swap (SameBlock)
def Covers (keep xs : W) := ∀ a ∈ xs, a ∈ keep
private theorem fan {r w} (hr : 0 < r) (cp : P455Closure.Cap r w) (a : Nat) (xs : W)
    (ca : w.count a = r) (sat : ∀ b ∈ xs, w.count b = r)
    (diff : ∀ b ∈ xs, ¬ SameBlock r w a b) :
    ∃ aux : W, aux.length ≤ 2*xs.length ∧ ∀ keep : W, a ∈ keep → Covers keep xs → Covers keep aux →
      ∀ b ∈ xs, ¬ SameBlock r (select keep w) a b := by
  induction xs with
  | nil => exact ⟨[],by simp,by simp⟩
  | cons x xs ih =>
    obtain ⟨c,d,wit⟩ := P455BlockSeparators.robust_separators hr cp ca (sat x (by simp)) (diff x (by simp))
    obtain ⟨more,len,win⟩ := ih (fun b h => sat b (by simp [h])) (fun b h => diff b (by simp [h]))
    refine ⟨c::d::more,by simp; omega,?_⟩
    intro keep ha members extra b hb
    rcases List.mem_cons.mp hb with rfl|hx
    · exact wit keep ha (members _ (by simp)) (extra _ (by simp)) (extra _ (by simp))
    · exact win keep ha (fun j hj => members j (by simp [hj])) (fun j hj => extra j (by simp [hj])) b hx
theorem simultaneous {r w} (hr : 0 < r) (cp : P455Closure.Cap r w) (xs : W)
    (sat : ∀ a ∈ xs, w.count a = r) (diff : xs.Pairwise (fun a b => ¬ SameBlock r w a b)) :
    ∃ aux : W, aux.length ≤ xs.length * (xs.length-1) ∧ ∀ keep : W, Covers keep xs → Covers keep aux →
      xs.Pairwise (fun a b => ¬ SameBlock r (select keep w) a b) := by
  induction xs with
  | nil => exact ⟨[],by simp,by simp⟩
  | cons a xs ih =>
    obtain ⟨ds,pw⟩ := List.pairwise_cons.mp diff
    have st (b) (h : b ∈ xs) := sat b (by simp [h])
    obtain ⟨xs₁,n₁,k₁⟩ := fan hr cp a xs (sat a (by simp)) st ds
    obtain ⟨xs₂,n₂,k₂⟩ := ih st pw
    refine ⟨xs₁ ++ xs₂,?_,?_⟩
    · simp only [List.length_append,List.length_cons,Nat.add_sub_cancel]
      have le := Nat.add_le_add n₁ n₂
      cases n : xs.length with
      | zero => simpa only [n,Nat.mul_zero,Nat.zero_mul] using le
      | succ m =>
        simp [n,Nat.add_mul,Nat.mul_add,Nat.succ_mul,Nat.mul_succ] at *
        omega
    · intro keep mem more
      have keepX (b) (h : b ∈ xs) := mem b (by simp [h])
      exact List.pairwise_cons.mpr ⟨k₁ keep (mem a (by simp)) keepX (fun z h => more z (by simp [h])),
        k₂ keep keepX (fun z h => more z (by simp [h]))⟩
theorem walk_count {r allow mark w} (cap : P455Closure.Cap r w) (a : Nat) (p : List Step)
    (ct : w.count a = r) (walk : Walk r allow mark w a p) : w.count (endpoint a p) = r := by
  induction p generalizing a with
  | nil => exact ct
  | cons bc p ih =>
    obtain ⟨b,c⟩ := bc
    apply ih b _ walk.2
    cases c with
    | record tag rev =>
      cases rev with
      | false => exact (record_counts cap walk.1).2
      | true => exact (record_counts cap walk.1).1
    | port phase rev => exact walk.1.2.2.1
theorem bounded_overflow {r allow u} (hr : 0 < r) (cap : P455Closure.Cap r u) (s : SlotCertificate)
    (xs : W) (kind : s.defect = .overflow xs) (ok : Holds r allow (markNode s.anchor) u (s.query r)) :
    ∃ keep : W, keep.length ≤ 43 ∧ s.anchor.owner ∈ keep ∧ s.anchor.mate ∈ keep ∧
      Covers keep (s.steps.map Prod.fst ++ xs) ∧ P455Closure.Cap r (select keep u) ∧
      Holds r allow (markNode s.anchor) (select keep u) (s.query r) := by
  let a := picked s
  let t := endpoint a s.steps
  obtain ⟨bound,walk,term⟩ := slot_route s ok
  rw [kind] at term
  obtain ⟨len,diff,all,_⟩ := term
  have members (b : Nat) (h : b ∈ xs) :
      u.count b = r ∧ slotStart s.terminalIndex ∧ occupies u t s.terminalIndex b :=
    (allQ_iff _).mp all _ (List.mem_map_of_mem h)
  have ct := record_counts cap (marked_typed (a := s.anchor) (bit := s.bit) ok.1)
  have start : u.count a = r := by
    cases side : s.startAtMate <;> simp [a,picked,side,ct]
  have termCount := walk_count cap a s.steps start walk
  have st : ∀ b ∈ t::xs, u.count b = r := by
    intro b h; rcases List.mem_cons.mp h with rfl|h
    · exact termCount
    · exact (members b h).1
  obtain ⟨more,n,apart⟩ := simultaneous hr cap (t::xs) st ((P455TerminalTransfer.block_separation _).mp diff)
  let keep := s.anchor.owner :: s.anchor.mate :: (s.steps.map Prod.fst ++ xs ++ more)
  have owner : s.anchor.owner ∈ keep := by simp [keep]
  have mate : s.anchor.mate ∈ keep := by simp [keep]
  have used (z) (hz : z ∈ s.steps.map Prod.fst ++ xs) : z ∈ keep :=
    List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_append_left _ hz))
  have keptOcc (b) (hb : b ∈ xs) := used b (List.mem_append_right _ hb)
  have path (m : Step) (hm : m ∈ s.steps) : m.1 ∈ keep :=
    used _ (List.mem_append_left _ (List.mem_map_of_mem hm))
  have pickedKept : a ∈ keep := by cases side : s.startAtMate <;> simp [a,picked,side,owner,mate]
  have last := endpoint_kept keep a s.steps pickedKept path
  have allSep := apart keep (by simpa [Covers] using And.intro last keptOcc)
    (fun z h => by simp [keep,h])
  refine ⟨keep,?_,owner,mate,used,select_cap keep cap,select_marked keep _ _ owner mate ok.1,bound,?_,True.intro⟩
  · change xs.length = 5 at len
    simp only [List.length_cons,len] at n
    simp [keep,len]
    omega
  · apply (route_iff ..).mpr
    refine ⟨select_walk keep a s.steps pickedKept path walk,?_⟩
    rw [kind]
    refine ⟨len,(P455TerminalTransfer.block_separation _).mpr allSep,?_,True.intro⟩
    apply (allQ_iff _).mpr
    intro q hq; obtain ⟨b,h,rfl⟩ := List.mem_map.mp hq
    have m := members b h
    exact ⟨(select_count keep u b (keptOcc b h)).trans m.1,m.2.1,select_slot keep t _ b last (keptOcc b h) m.2.2⟩
theorem select_early {r allow mark u} (keep xs ys : W) (hx : Covers keep xs) (hy : Covers keep ys)
    (obs : Holds r allow mark u (earlyBefore xs ys)) : Holds r allow mark (select keep u) (earlyBefore xs ys) := by
  apply (earlyBefore_iff _ _).mpr
  intro a ha b hb
  apply select_order keep _ _ ((earlyBefore_iff _ _).mp obs a ha b hb)
  simp [hx a ha,hy b hb]
theorem select_port {r allow mark u} (keep : W) (a b : Node) (i : Nat)
    (keepA : Covers keep (roles a)) (keepB : Covers keep (roles b))
    (obs : Holds r allow mark u (orientedPort i a b)) : Holds r allow mark (select keep u) (orientedPort i a b) := by
  have ao := keepA a.owner (by simp [roles]); have am := keepA a.mate (by simp [roles])
  have bo := keepB b.owner (by simp [roles]); have bm := keepB b.mate (by simp [roles])
  obtain ⟨ra,rb,early,order,_⟩ := obs
  refine ⟨select_record keep _ _ _ ao am ra,select_record keep _ _ _ bo bm rb,?_,?_,True.intro⟩
  · rcases early with e|e
    · exact .inl (select_early keep _ _ keepA keepB e)
    · exact .inr (select_early keep _ _ keepB keepA e)
  · apply select_order keep _ _ order; simp [ao,am,bo,bm]
theorem select_neighbor {r allow mark u} (keep : W) (ts : Tiles) (a b : Node) (dir : Dir)
    (keepA : Covers keep (roles a)) (keepB : Covers keep (roles b))
    (obs : Holds r allow mark u (neighbor ts a b dir)) :
    Holds r allow mark (select keep u) (neighbor ts a b dir) := by
  have ao := keepA a.owner (by simp [roles]); have bo := keepB b.owner (by simp [roles])
  cases dir with
  | down => exact ⟨obs.1,select_port keep _ _ _ keepA keepB obs.2⟩
  | up => exact ⟨obs.1,select_port keep _ _ _ keepB keepA obs.2⟩
  | right => exact ⟨obs.1,select_port keep _ _ _ keepA keepB obs.2.1,
      select_order keep _ (by simp [ao,bo]) obs.2.2.1,True.intro⟩
  | left => exact ⟨obs.1,select_port keep _ _ _ keepB keepA obs.2.1,
      select_order keep _ (by simp [ao,bo]) obs.2.2.1,True.intro⟩
theorem bounded_functionality {r allow u} (hr : 0 < r) (cap : P455Closure.Cap r u)
    (ts : Tiles) (f : FunctionalityCertificate)
    (ok : Holds r allow (markNode f.anchor) u (f.query ts)) :
    ∃ keep : W, keep.length ≤ 8 ∧ Covers keep (roles f.anchor ++ roles f.b ++ roles f.c) ∧
      P455Closure.Cap r (select keep u) ∧ Holds r allow (markNode f.anchor) (select keep u) (f.query ts) := by
  obtain ⟨anchor,nb,nc,apart,_⟩ := ok
  let role := roleOf f.distinguishMate
  have sat (n : Node) (obs : Holds r allow (markNode f.anchor) u (neighbor ts f.anchor n f.dir)) :
      u.count (role n) = r := by
    have ct := record_counts cap (neighbor_target_record obs)
    cases side : f.distinguishMate <;> simp [role,roleOf,side,ct]
  obtain ⟨x,y,diff⟩ := P455BlockSeparators.robust_separators hr cap (sat _ nb) (sat _ nc) apart
  let names := roles f.anchor ++ roles f.b ++ roles f.c
  let keep := x::y::names
  have k : Covers keep names := fun z hz => by simp [keep,hz]
  have ka : Covers keep (roles f.anchor) := fun z h => k z (by simp [names,h])
  have kb : Covers keep (roles f.b) := fun z h => k z (by simp [names,h])
  have kc : Covers keep (roles f.c) := fun z h => k z (by simp [names,h])
  have kr (n : Node) (h : Covers keep (roles n)) : role n ∈ keep := by
    apply h
    cases side : f.distinguishMate <;> simp [roles,role,roleOf,side]
  refine ⟨keep,by simp [keep,names,roles],k,select_cap keep cap,
    select_marked keep _ _ (ka _ (by simp [roles])) (ka _ (by simp [roles])) anchor,
    select_neighbor keep ts _ _ _ ka kb nb,select_neighbor keep ts _ _ _ ka kc nc,
    diff keep (kr _ kb) (kr _ kc) (by simp [keep]) (by simp [keep]),True.intro⟩
end P455OtherProjection
end
section
namespace P455Structural
open P455Witness P455Quotient P455Closure P455Uncrossed Problem455.Slots
open P455SourceFamilies P455FirstTesters
abbrev W := List Nat
def Rec (T : W) (r : Nat) (allow : Tag → Prop) (a b : Nat) :=
  ∃ tag, Holds r allow (fun _ _ => False) T (.record a b tag)
def Edge (T : W) (r : Nat) (allow : Tag → Prop) (a b : Nat) :=
  Rec T r allow a b ∨ Rec T r allow b a
def Width (k : Nat) (T : W) := ∃ C : W, C.length ≤ k ∧ ∀ x ∈ T, x ∈ C
def Overlap (T : W) (r : Nat) (allow : Tag → Prop) :=
  ∃ o p q, o ≠ p ∧ o ≠ q ∧ p ≠ q ∧ Edge T r allow o p ∧ Edge T r allow o q
def Intrusion (T : W) (r : Nat) (allow : Tag → Prop) :=
  ∃ o p z j, o ≠ p ∧ z ≠ o ∧ z ≠ p ∧ Rec T r allow o p ∧ sees T [(o,0),(z,j),(p,2)]
def Structural (T : W) (r : Nat) (allow : Tag → Prop) :=
  (Width 4 T ∧ Overlap T r allow) ∨ (Width 3 T ∧ Intrusion T r allow)
def early (a b : Nat) : W := [a,a,b,a,b,b]
def Closed (T : W) (a b : Nat) :=
  a ≠ b ∧ ∃ L R : W, T = L ++ early a b ++ R ∧ a ∉ L ∧ b ∉ L
private theorem only_z (x z : Nat) (L : W) (nx : x ∉ L) :
    select [x,z] L = List.replicate (L.count z) z := by
  induction L with
  | nil => rfl
  | cons c t ih =>
    have nt : x ∉ t := fun h => nx (List.mem_cons_of_mem _ h)
    have cx : c ≠ x := fun e => nx (e ▸ List.mem_cons_self)
    by_cases cz : c = z <;> simp_all [select,List.count_cons,List.replicate_succ]
private theorem early_projection {a b x z : Nat} {T : W} (closed : Closed T a b)
    (inPair : x = a ∨ x = b) (outside : z ≠ a ∧ z ≠ b) :
    ∃ n R, select [x,z] T = List.replicate n z ++ [x,x,x] ++ R := by
  obtain ⟨ab,L,R,rfl,na,nb⟩ := closed
  refine ⟨L.count z,select [x,z] R,?_⟩
  rcases inPair with rfl|rfl <;> rw [select_append,select_append,only_z _ _ _ (by assumption)] <;>
    simp [select,early,ab,Ne.symm ab,Ne.symm outside.1,Ne.symm outside.2]
private theorem not_record_tail {x z : Nat} (xz : x ≠ z) (n : Nat) (tail : W) (tag : Tag) (bit : Bool) :
    List.replicate n z ++ [x,x,x] ++ tail ≠ profile x z tag bit ∧
    List.replicate n z ++ [x,x,x] ++ tail ≠ profile z x tag bit := by
  cases n with
  | zero => simp [profile,profilePrefix,xz]
  | succ n =>
    cases n with
    | zero => simp [profile,profilePrefix,xz,Ne.symm xz,List.replicate_succ]
    | succ n =>
      cases n with
      | zero => simp [profile,profilePrefix,xz,Ne.symm xz,List.replicate_succ]
      | succ n => simp [profile,profilePrefix,xz,Ne.symm xz,List.replicate_succ]
theorem no_external_record {r allow a b T} (closed : Closed T a b) {x z : Nat}
    (inside : x = a ∨ x = b) (out : z ≠ a ∧ z ≠ b) : ¬ Edge T r allow x z := by
  obtain ⟨n,tail,eq⟩ := early_projection closed inside out
  have nz : x ≠ z := by omega
  rintro (⟨t,_,_,_,bit,profileEq⟩|⟨t,_,_,_,bit,profileEq⟩)
  · exact (not_record_tail nz n tail t bit).1 (eq.symm.trans profileEq)
  · exact (not_record_tail nz n tail t bit).2 (eq.symm.trans ((select_pair_symm x z T).symm.trans profileEq))
private theorem early_bound {T : W} {a b o p z j : Nat} (closed : Closed T a b)
    (oi : o = a ∨ o = b) (pi' : p = a ∨ p = b) (out : z ≠ a ∧ z ≠ b) :
    ¬ sees T [(o,0),(z,j),(p,2)] := by
  obtain ⟨ab,L,R,rfl,na,nb⟩ := closed
  intro obs
  have no : o ∉ L := oi.elim (fun e => e ▸ na) (fun e => e ▸ nb)
  have cp : (early a b).count p = 3 := by
    rcases pi' with rfl|rfl <;> simp [early,List.count_cons,ab,Ne.symm ab]
  let inner := (events (early a b)).map (shift (fun x => L.count x))
  let right := stamp (fun x => L.count x + (early a b).count x) R
  have h : [(o,0),(z,j),(p,2)].Sublist (events L ++ (inner ++ right)) := by
    simpa only [sees,events_of_factor,inner,right] using obs
  have nl : (o,0) ∉ events L := fun m => no (stamped_mem_label _ _ _ m)
  have nr : (p,2) ∉ right := by
    intro m
    have low := (P455ContactGeometry.stamp_range (fun x => L.count x + (early a b).count x) R m).1
    omega
  have strip {α : Type} (x : α) (pat u v : List α) (nx : x ∉ u)
      (sub : (x::pat).Sublist (u++v)) : (x::pat).Sublist v := by
    induction u with
    | nil => exact sub
    | cons c u ih =>
      cases sub with
      | cons _ s => exact ih (fun m => nx (List.mem_cons_of_mem _ m)) s
      | cons_cons => exact False.elim (nx List.mem_cons_self)
  have h1 := (strip _ _ _ _ nl h).reverse
  simp only [List.reverse_append,List.reverse_cons,List.reverse_nil,List.nil_append,List.cons_append] at h1
  have h2 := (strip _ _ right.reverse inner.reverse (by simpa using nr) h1).reverse
  have mid : (z,j) ∈ inner := by simpa using h2.subset (show (z,j) ∈ ([(p,2),(z,j),(o,0)] : List Event).reverse by simp)
  obtain ⟨e,me,eq⟩ := List.mem_map.mp mid
  have ze : e.1 = z := congrArg Prod.fst eq
  have is := stamped_mem_label _ _ _ me
  simp [early,ze,out.1,out.2] at is
private theorem rec_mem {T r allow a b} (h : Rec T r allow a b) : a ∈ T ∧ b ∈ T := by
  obtain ⟨t,_,_,_,bit,eq⟩ := h
  have f (x : Nat) (hx : x = a ∨ x = b) : x ∈ T := by
    have mm : x ∈ profile a b t bit := by rcases hx with rfl|rfl <;> simp [profile,profilePrefix]
    rw [← eq] at mm
    exact (List.mem_filter.mp mm).1
  exact ⟨f a (.inl rfl),f b (.inr rfl)⟩
private theorem edge_mem {T r allow a b} (h : Edge T r allow a b) : a ∈ T ∧ b ∈ T :=
  h.elim rec_mem (fun q => (rec_mem q).symm)
private theorem closed_mem {T a b} (h : Closed T a b) : a ∈ T ∧ b ∈ T := by
  obtain ⟨_,l,t,rfl,_,_⟩ := h
  simp [early]
private theorem separated_core {T r allow a b o p} (c : Closed T a b) (edge : Edge T r allow o p) :
    (o = a ∨ o = b) ↔ (p = a ∨ p = b) := by
  constructor
  · intro h
    apply Classical.byContradiction; intro n
    exact no_external_record c h ⟨fun e => n (.inl e),fun e => n (.inr e)⟩ edge
  · intro h
    apply Classical.byContradiction; intro n
    exact no_external_record c h ⟨fun e => n (.inl e),fun e => n (.inr e)⟩ edge.symm
theorem structural_excludes_closed {r allow T a b} (stest : Structural T r allow) (c : Closed T a b) : False := by
  obtain ⟨ma,mb⟩ := closed_mem c
  have ab := c.1
  rcases stest with ⟨⟨C,len,Cmem⟩,o,p,q,op,oq,pq,e1,e2⟩|⟨⟨C,len,Cmem⟩,o,p,z,j,op,zo,zp,rec',seen⟩
  · have linkP := separated_core c e1
    have linkQ := separated_core c e2
    by_cases h : o = a ∨ o = b
    · have hp := linkP.mp h; have hq := linkQ.mp h; omega
    · have A := edge_mem e1; have B := edge_mem e2
      have uniq : [a,b,o,p,q].Nodup := by simp [List.nodup_cons]; omega
      have sub (x) (m : x ∈ [a,b,o,p,q]) : x ∈ C := by
        simp only [List.mem_cons,List.not_mem_nil,or_false] at m
        rcases m with rfl|rfl|rfl|rfl|rfl <;> apply Cmem <;> simp_all
      have := P455FirstRewrite.size_le uniq sub
      simp at this; omega
  · have link := separated_core c (Or.inl rec' : Edge T r allow o p)
    by_cases h : o = a ∨ o = b
    · have hp := link.mp h
      apply early_bound c h hp _ seen
      omega
    · have A := rec_mem rec'
      have uniq : [a,b,o,p].Nodup := by simp [List.nodup_cons]; omega
      have sub (x) (m : x ∈ [a,b,o,p]) : x ∈ C := by
        simp only [List.mem_cons,List.not_mem_nil,or_false] at m
        rcases m with rfl|rfl|rfl|rfl <;> apply Cmem <;> simp_all
      have := P455FirstRewrite.size_le uniq sub
      simp at this; omega
end P455Structural
end
section
namespace P455RectangleRank
open P455FirstRewrite
def owner (i : Nat) := 2*i
def mate (i : Nat) := 2*i+1
def privateCell (i : Nat) : W := [owner i,owner i,mate i,owner i,mate i,mate i]
def mutableCell (bit : Nat → Bool) (i : Nat) : W :=
  if bit i then [mate i,owner i] else [owner i,mate i]
def word (t : Nat) (middle tail : W) (bit : Nat → Bool) :=
  (List.range t).flatMap privateCell ++ middle ++ (List.range t).flatMap (mutableCell bit) ++ tail
def constant (b : Bool) : Nat → Bool := fun _ => b
private theorem within {t i : Nat} (m : i ∈ List.range t) {x : Nat}
    (member : x = owner i ∨ x = mate i) : x < 2*t := by
  have := List.mem_range.mp m
  unfold owner mate at member
  omega
theorem word_names {t : Nat} {middle tail : W} (bit : Nat → Bool)
    (small : ∀ x ∈ middle ++ tail, x < 2*t) (x) (hx : x ∈ word t middle tail bit) : x < 2*t := by
  simp only [word,List.mem_append,List.mem_flatMap] at hx
  rcases hx with ((⟨i,mi,m⟩|m)|⟨i,mi,m⟩)|m
  · apply within mi
    simp only [privateCell,List.mem_cons,List.mem_nil_iff,or_false] at m
    rcases m with h|h|h|h|h|h <;> simp [h]
  · exact small x (List.mem_append_left _ m)
  · apply within mi
    unfold mutableCell at m
    split at m <;> simp_all [Or.comm]
  · exact small x (List.mem_append_right _ m)
private theorem private_factor {t i : Nat} (ix : i < t) (middle tail : W) (bit : Nat → Bool) :
    P455Quotient.Factor (privateCell i) (word t middle tail bit) := by
  obtain ⟨l,r,e⟩ := List.append_of_mem (List.mem_range.mpr ix)
  refine ⟨l.flatMap privateCell,r.flatMap privateCell ++ middle ++
    (List.range t).flatMap (mutableCell bit) ++ tail,?_⟩
  unfold word
  conv => lhs; arg 1; arg 1; arg 1; rw [e]
  simp [List.flatMap_cons,List.append_assoc]
private theorem positive_factor {a b : Nat} {f u : W} (factor : P455Quotient.Factor f u)
    (pos : 0 < Problem455Swap.bigram a b f) : 0 < Problem455Swap.bigram a b u := by
  obtain ⟨p,q,rfl⟩ := factor
  rw [Problem455Swap.bigram_append,Problem455Swap.bigram_append]
  omega
theorem no_links {r t : Nat} (hr : 0 < r) {middle tail : W} (bit : Nat → Bool)
    (small : ∀ x ∈ middle ++ tail, x < 2*t)
    (cap : P455Quotient.Cap r (word t middle tail bit)) :
    P455SourceFamilies.Compressed r (word t middle tail bit) := by
  let U := word t middle tail bit
  intro x y link
  change Problem455Swap.bigram x y U = r at link
  have bound := Problem455Swap.out_bound x y (y+1) (by omega) U
  rw [Problem455BlockBridge.occ_count] at bound
  have mem : x ∈ U := List.count_pos_iff.mp (by omega)
  have smallX := word_names bit small x mem
  let i := x/2
  have ix : i < t := by dsimp [i]; omega
  have either : x = owner i ∨ x = mate i := by simp only [owner,mate,i]; omega
  have ne : owner i ≠ mate i := by simp [owner,mate]
  have fac := private_factor ix middle tail bit
  have aPos : 0 < Problem455Swap.bigram x (owner i) U := by
    apply positive_factor fac
    rcases either with e|e <;> conv => rhs; arg 1; rw [e]
    all_goals simp [privateCell,Problem455Swap.bigram,Problem455Swap.hit,ne,Ne.symm ne] <;> omega
  have bPos : 0 < Problem455Swap.bigram x (mate i) U := by
    apply positive_factor fac
    rcases either with e|e <;> conv => rhs; arg 1; rw [e]
    all_goals simp [privateCell,Problem455Swap.bigram,Problem455Swap.hit,ne,Ne.symm ne] <;> omega
  obtain ⟨z,ny,pz⟩ : ∃ z, y ≠ z ∧ 0 < Problem455Swap.bigram x z U := by
    by_cases e : y = owner i
    · exact ⟨mate i,e ▸ ne,bPos⟩
    · exact ⟨owner i,e,aPos⟩
  have upper := Problem455Swap.out_bound x y z ny U
  rw [Problem455BlockBridge.occ_count] at upper
  have cx : U.count x ≤ r := cap x
  omega
private theorem project_mutable (cells : W) (nd : cells.Nodup) (bit : Nat → Bool) (i : Nat) :
    proj (owner i) (mate i) (cells.flatMap (mutableCell bit)) =
      (if i ∈ cells then mutableCell bit i else []) := by
  induction cells with
  | nil => rfl
  | cons j t ih =>
    have tail := ih (List.nodup_cons.mp nd).2
    by_cases e : i = j
    · subst j
      have out := (List.nodup_cons.mp nd).1
      have one : proj (owner i) (mate i) (mutableCell bit i) = mutableCell bit i := by
        cases hb : bit i <;> simp [proj,mutableCell,hb]
      simp only [List.flatMap_cons,proj,List.filter_append] at tail one ⊢
      rw [one,tail]
      simp [out]
    · have eqs : owner j ≠ owner i ∧ owner j ≠ mate i ∧ mate j ≠ owner i ∧ mate j ≠ mate i := by
        unfold owner mate; omega
      have no : proj (owner i) (mate i) (mutableCell bit j) = [] := by
        cases b : bit j <;> simp [proj,mutableCell,b,eqs.1,eqs.2.1,eqs.2.2.1,eqs.2.2.2]
      simp only [List.flatMap_cons,proj,List.filter_append] at tail no ⊢
      rw [no,tail]
      simp [e]
theorem participants {t : Nat} (middle tail : W) :
    ∀ x ∈ List.range (2*t), ∃ y,
      proj x y (word t middle tail (constant false)) ≠ proj x y (word t middle tail (constant true)) := by
  intro x m
  have lt := List.mem_range.mp m
  let i := x/2
  have mi : i ∈ List.range t := List.mem_range.mpr (by dsimp [i]; omega)
  have pairDiff : proj (owner i) (mate i) (word t middle tail (constant false)) ≠
      proj (owner i) (mate i) (word t middle tail (constant true)) := by
    intro eq
    simp only [word,proj,List.filter_append,List.append_cancel_right_eq,List.append_cancel_left_eq] at eq
    change proj (owner i) (mate i) ((List.range t).flatMap (mutableCell (constant false))) =
      proj (owner i) (mate i) ((List.range t).flatMap (mutableCell (constant true))) at eq
    rw [project_mutable _ List.nodup_range,project_mutable _ List.nodup_range] at eq
    simp [mi,mutableCell,constant,owner,mate] at eq
  have either : x = owner i ∨ x = mate i := by simp only [owner,mate,i]; omega
  rcases either with e|e
  · exact ⟨mate i,e ▸ pairDiff⟩
  · refine ⟨owner i,?_⟩
    rw [e]
    simpa only [proj,Or.comm] using pairDiff
theorem cycle_constant {t : Nat} (bit : Nat → Bool) (next : ∀ i, i+1 < t →
      bit i = true → bit (i+1) = true) (wrap : 0 < t → bit (t-1) = true → bit 0 = true) :
    ∃ b, ∀ i < t, bit i = b := by
  have onward (i j : Nat) (le : i ≤ j) (lt : j < t) (yes : bit i = true) : bit j = true := by
    induction j with
    | zero => have := Nat.eq_zero_of_le_zero le; simpa [this] using yes
    | succ j ih =>
      by_cases e : i = j+1
      · exact e ▸ yes
      · exact next j lt (ih (by omega) (by omega))
  by_cases existsTrue : ∃ i < t, bit i = true
  · obtain ⟨i,lt,active⟩ := existsTrue
    have first := wrap (by omega) (onward i (t-1) (by omega) (by omega) active)
    exact ⟨true,fun j lj => onward 0 j (by omega) lj first⟩
  · exact ⟨false,fun i li => by cases eq : bit i <;> simp_all⟩
theorem word_constant {t : Nat} (middle tail : W) (bit : Nat → Bool) (b : Bool)
    (all : ∀ i < t, bit i = b) : word t middle tail bit = word t middle tail (constant b) := by
  have m : (List.range t).flatMap (mutableCell bit) = (List.range t).flatMap (mutableCell (constant b)) := by
    have go (xs : W) (small : ∀ i ∈ xs, i < t) : xs.flatMap (mutableCell bit) = xs.flatMap (mutableCell (constant b)) := by
      induction xs with
      | nil => rfl
      | cons x xs ih =>
        have tailEq := ih (fun i hi => small i (List.mem_cons_of_mem _ hi))
        simp [List.flatMap_cons,tailEq,mutableCell,constant,all x (small x List.mem_cons_self)]
        rfl
    exact go _ (fun _ => List.mem_range.mp)
  simp only [word,m]
theorem witness {A : Type} {M : Model A} {r t : Nat} (hr : 0 < r) (ht : 0 < t) (middle tail : W)
    (small : ∀ x ∈ middle ++ tail, x < 2*t)
    (cap : P455Quotient.Cap r (word t middle tail (constant false)))
    (identity : M.Valid (word t middle tail (constant false)) (word t middle tail (constant true)))
    (represent : ∀ w, M.Valid (word t middle tail (constant false)) w →
      ∃ bit, w = word t middle tail bit)
    (edge : ∀ bit, M.Valid (word t middle tail (constant false)) (word t middle tail bit) →
      (∀ i, i+1 < t → bit i = true → bit (i+1) = true) ∧
      (0 < t → bit (t-1) = true → bit 0 = true)) :
    RankWitness M r (word t middle tail (constant false)) (word t middle tail (constant true))
      (List.range (2*t)) := by
  have m0 : 0 ∈ List.range (2*t) := List.mem_range.mpr (by omega)
  obtain ⟨y,change0⟩ := participants middle tail 0 m0
  have ne : word t middle tail (constant false) ≠ word t middle tail (constant true) :=
    fun e => change0 (congrArg (proj 0 y) e)
  have nonempty (bit : Nat → Bool) : word t middle tail bit ≠ [] := by
    obtain ⟨p,q,eq⟩ := private_factor (i:=0) ht middle tail bit
    rw [eq]; simp [privateCell]
  refine ⟨⟨nonempty _,nonempty _⟩,ne,identity,?_,cap,no_links hr _ small cap,
    List.nodup_range,participants middle tail⟩
  intro w valid
  obtain ⟨bit,rfl⟩ := represent w valid
  obtain ⟨nx,wrap⟩ := edge bit valid
  obtain ⟨b,all⟩ := cycle_constant bit nx wrap
  cases b with
  | false => exact Or.inl (word_constant middle tail bit false all)
  | true => exact Or.inr (word_constant middle tail bit true all)
end P455RectangleRank
end
section
namespace P455EffectiveMachine
open P455MachineLocal P455MachineCleanup P455MachineTable
structure Alphabet (M : Ordinary g q) where
  bit : Bool → Fin g
  away : ∀ b, bit b ≠ M.marker
  ink : ∀ b, bit b ≠ M.blank
  distinct : bit false ≠ bit true
def inputTape (M : Ordinary g q) (A : Alphabet M) (w : List Bool) : Nat → Fin g
  | 0 => M.marker
  | x+1 => (w[x]?).elim M.blank A.bit
def inputConfig (M : Ordinary g q) (A : Alphabet M) (w : List Bool) : Config g q :=
  ⟨inputTape M A w,0,M.start⟩
def follow (M : Ordinary g q) (c : Config g q) : Nat → Config g q
  | 0 => c
  | t+1 => once M (follow M c t)
def HALT (M : Ordinary g q) (c : Config g q) := ∃ t, instruction M (follow M c t) = none
def selfBits (M : Ordinary g q) (A : Alphabet M) : List Bool :=
  unary (A.bit false).val ++ unary (A.bit true).val ++ (quote M).bits
def SelfHalt (M : Ordinary g q) (A : Alphabet M) :=
  HALT M (inputConfig M A (selfBits M A))
theorem blank_run (M : Ordinary g q) (t : Nat) : follow M (config₀ M) t = p455Original M t := by
  induction t with
  | zero => rfl
  | succ t ih => simp only [follow,p455Original,ih]
theorem blank_halts (M : Ordinary g q) : HALT M (config₀ M) ↔ ∃ t, stopped M t := by
  simp only [HALT,stopped,blank_run]
theorem rest (M : Ordinary g q) (c : Config g q) {t} (h : instruction M (follow M c t) = none) (k) :
    follow M c (t+k) = follow M c t := by
  induction k with
  | zero => rfl
  | succ k ih => simp [Nat.add_succ,follow,ih,once,h]
theorem unique_halt (M : Ordinary g q) (c : Config g q) {a b}
    (ha : instruction M (follow M c a) = none) (hb : instruction M (follow M c b) = none) :
    follow M c a = follow M c b := by
  by_cases le : a ≤ b
  · have e := rest M c ha (b-a)
    rw [show a+(b-a) = b by omega] at e
    exact e.symm
  · have e := rest M c hb (a-b)
    rw [show b+(a-b) = a by omega] at e
    exact e
def trap (M : Ordinary g q) (answer : Fin q → Bool) : Ordinary g q where
  marker := M.marker
  blank := M.blank
  blank_ne := M.blank_ne
  start := M.start
  delta := fun s a =>
    match M.delta s a with
    | some i => some i
    | none => if answer s then some ⟨s,a,.stay⟩ else none
  keeps := by
    intro s a i eq
    cases h : M.delta s a with
    | some j => simp only [h,Option.some.injEq] at eq; exact M.keeps s a i (eq ▸ h)
    | none =>
      simp only [h] at eq
      split at eq <;> simp_all <;> subst i <;> simp
  leftSafe := by
    intro s i eq
    cases h : M.delta s M.marker with
    | some j => simp only [h,Option.some.injEq] at eq; exact M.leftSafe s i (eq ▸ h)
    | none =>
      simp only [h] at eq
      split at eq <;> simp_all <;> subst i <;> simp
def liftAlphabet (M : Ordinary g q) (A : Alphabet M) (answer : Fin q → Bool) : Alphabet (trap M answer) :=
  ⟨A.bit,A.away,A.ink,A.distinct⟩
theorem write_same (f : Nat → Fin g) (p) : writeAt f p (f p) = f := by
  funext i; by_cases h : i = p <;> simp [writeAt,h]
theorem once_trap (M : Ordinary g q) (ans) (c : Config g q) : once (trap M ans) c = once M c := by
  cases c with
  | mk tape pos state =>
    cases e : M.delta state (tape pos) with
    | some i => simp [once,instruction,trap,e]
    | none => cases h : ans state <;> simp [once,instruction,trap,e,h,dest,write_same]
theorem follow_trap (M : Ordinary g q) (ans) (c : Config g q) (t) :
    follow (trap M ans) c t = follow M c t := by
  induction t with
  | zero => rfl
  | succ t ih => simp only [follow,ih,once_trap]
theorem stop_trap (M : Ordinary g q) (ans) (c : Config g q) :
    instruction (trap M ans) c = none ↔ instruction M c = none ∧ ans c.state = false := by
  cases e : M.delta c.state (c.tape c.pos) <;> cases h : ans c.state <;> simp [instruction,trap,e,h]
theorem halt_trap_iff (M : Ordinary g q) (ans) (c : Config g q) {t}
    (ended : instruction M (follow M c t) = none) :
    HALT (trap M ans) c ↔ ans (follow M c t).state = false := by
  constructor
  · rintro ⟨i,hi⟩
    rw [follow_trap,stop_trap] at hi
    exact unique_halt M c hi.1 ended ▸ hi.2
  · intro h
    exact ⟨t,by rw [follow_trap,stop_trap]; exact ⟨ended,h⟩⟩
def DecidesSelf (D : Ordinary g q) (A : Alphabet D) (answer : Fin q → Bool) : Prop :=
  ∀ {g' q'} (P : Ordinary g' q') (B : Alphabet P),
    let c := inputConfig D A (selfBits P B)
    ∃ t, instruction D (follow D c t) = none ∧
      (answer (follow D c t).state = true ↔ SelfHalt P B)
theorem no_self_decider (D : Ordinary g q) (A : Alphabet D) (answer : Fin q → Bool) :
    ¬DecidesSelf D A answer := by
  intro correct
  let P := trap D answer
  let B := liftAlphabet D A answer
  let c := inputConfig D A (selfBits P B)
  have same : inputConfig P B (selfBits P B) = c := rfl
  obtain ⟨t,halt,ok⟩ := correct P B
  change instruction D (follow D c t) = none at halt
  change (answer (follow D c t).state = true ↔ HALT P (inputConfig P B (selfBits P B))) at ok
  rw [same] at ok
  have contradiction := ok.trans (halt_trap_iff D answer c halt)
  cases e : answer (follow D c t).state <;> simp [e] at contradiction
end P455EffectiveMachine
end
