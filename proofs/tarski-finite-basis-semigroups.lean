section
namespace P455Table
open P455FirstRewrite
structure FiniteOps where
  size : Nat
  one : Fin size
  mul : Fin size → Fin size → Fin size
structure Presents {A : Type} (X : FiniteOps) (M : Model A) where
  decode : Fin X.size → A
  inj : ∀ i j, decode i = decode j → i = j
  surj : ∀ a, ∃ i, decode i = a
  one_eq : decode X.one = M.unit
  mul_eq : ∀ i j, decode (X.mul i j) = M.op (decode i) (decode j)
structure Listing (A : Type) where
  eq : DecidableEq A
  items : List A
  all : ∀ x, x∈items
def distinct [DecidableEq A] : List A → List A
  | [] => []
  | x::xs => if x∈xs then distinct xs else x::distinct xs
theorem mem_distinct [DecidableEq A] (a : A) (xs : List A) : a∈distinct xs ↔ a∈xs := by
  induction xs with
  | nil => simp [distinct]
  | cons x xs ih =>
    by_cases h : x∈xs
    · simp only [distinct,if_pos h,ih,List.mem_cons]
      exact ⟨Or.inr,fun v => v.elim (fun e => e ▸ h) id⟩
    · simp [distinct,h,ih]
theorem nodup_distinct [DecidableEq A] (xs : List A) : (distinct xs).Nodup := by
  induction xs with
  | nil => simp [distinct]
  | cons x xs ih =>
    by_cases h : x∈xs
    · simpa [distinct,h] using ih
    · simpa [distinct,h,List.nodup_cons,mem_distinct] using ih
abbrev Matrix := List (List Nat)
def matrix (X : FiniteOps) : Matrix :=
  (List.finRange X.size).map fun i => (List.finRange X.size).map fun j => (X.mul i j).val
def entry (T : Matrix) (i j : Nat) := (T[i]?.getD [])[j]?.getD 0
@[simp] theorem matrix_length (X : FiniteOps) : (matrix X).length = X.size := by simp [matrix]
theorem matrix_entry (X : FiniteOps) (i j : Fin X.size) : entry (matrix X) i j = (X.mul i j).val := by
  simp [entry,matrix,List.getElem?_eq_getElem,i.isLt,j.isLt]
theorem square (X : FiniteOps) : ∀ row∈matrix X, row.length = X.size ∧ ∀ a∈row, a < X.size := by
  intro row mem
  obtain ⟨i,_,rfl⟩ := List.mem_map.mp mem
  refine ⟨by simp,?_⟩
  intro a m; obtain ⟨j,_,rfl⟩ := List.mem_map.mp m
  exact (X.mul i j).isLt
end P455Table
end
section
namespace P455EffectiveWriter
open P455EffectiveMachine P455EffectivePrefix P455MachineLocal P455MachineCleanup P455MachineTable
def dataEnv (M : Ordinary g q) (A : Alphabet M) (word : List Bool) (p : Nat) : Env g :=
  ⟨inputTape M A word,p⟩
theorem input_fresh (M : Ordinary g q) (A : Alphabet M) (w : List Bool) :
    inputTape M A w (w.length+1) = M.blank := by simp [inputTape,List.getElem?_eq_none (Nat.le_refl w.length)]
theorem input_away (M : Ordinary g q) (A : Alphabet M) (w : List Bool) (k : Nat) :
    inputTape M A w (k+1)≠M.marker := by
  change (w[k]?).elim M.blank A.bit ≠ M.marker
  cases w[k]? with
  | none => exact M.blank_ne
  | some b => exact A.away b
theorem tape_snoc (M : Ordinary g q) (A : Alphabet M) (w : List Bool) (b : Bool) :
    writeAt (inputTape M A w) (w.length+1) (A.bit b) = inputTape M A (w++[b]) := by
  funext i
  cases i with
  | zero => simp [writeAt,inputTape]
  | succ j =>
    by_cases lt : j < w.length
    · have ne : j≠w.length := by omega
      simp [writeAt,ne,inputTape,List.getElem?_append_left lt]
    · have le : w.length ≤ j := by omega
      by_cases eq : j = w.length
      · subst j
        simp [writeAt,inputTape,List.getElem?_append_right]
      · have lt' : w.length < j := by omega
        have dead : w.length+1 ≤ j := by omega
        have all : (w++[b]).length ≤ j := by simpa using dead
        simp [writeAt,eq,inputTape,List.getElem?_eq_none le,List.getElem?_eq_none all]
theorem push_bit (M : Ordinary g q) (A : Alphabet M) (p) (b) :
    effect M.marker (.putRight (A.bit b)) (dataEnv M A p (p.length+1))=
      dataEnv M A (p++[b]) ((p++[b]).length+1) := by
  simp [effect,dataEnv,write,motion,dest,input_fresh,M.blank_ne,A.away,tape_snoc]
theorem put_many (M : Ordinary g q) (A : Alphabet M) (w p : List Bool) :
    perform M.marker (w.map (fun b => Cmd.putRight (A.bit b))) (dataEnv M A p (p.length+1))=
    dataEnv M A (p++w) ((p++w).length+1) := by
  induction w generalizing p with
  | nil => simp [perform]
  | cons b ws ih =>
    change perform M.marker (ws.map (fun b => Cmd.putRight (A.bit b)))
      (effect M.marker (.putRight (A.bit b)) (dataEnv M A p (p.length+1))) = _
    rw [push_bit,ih]
    simp
theorem rewind (M : Ordinary g q) (A : Alphabet M) (w : List Bool) (k n : Nat) :
    perform M.marker (List.replicate n (.left : Cmd g)) (dataEnv M A w (k+n)) = dataEnv M A w k := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.replicate_succ]
    change perform M.marker (List.replicate n .left)
      (effect M.marker .left (dataEnv M A w (k+n+1))) = _
    have one : effect M.marker .left (dataEnv M A w (k+n+1)) = dataEnv M A w (k+n) := by
      simp [effect,dataEnv,write,motion,dest,input_away,write_same]
    rw [one,ih]
def writer (M : Ordinary g q) (A : Alphabet M) (w : List Bool) : List (Cmd g) :=
  Cmd.right :: ((w.map (fun b => Cmd.putRight (A.bit b))) ++ List.replicate (w.length+1) .left)
theorem written (M : Ordinary g q) (A : Alphabet M) (w : List Bool) :
    perform M.marker (writer M A w) (dataEnv M A [] 0) = dataEnv M A w 0 := by
  have start : effect M.marker .right (dataEnv M A [] 0) = dataEnv M A [] 1 := by
    simp [effect,dataEnv,motion,write,dest,write_same]
  simp only [writer,perform,List.foldl_cons,List.foldl_append,start]
  change perform M.marker (List.replicate (w.length+1) .left)
    (perform M.marker (w.map (fun b => Cmd.putRight (A.bit b))) (dataEnv M A [] (([] : List Bool).length+1))) = _
  rw [put_many]
  simp only [List.nil_append]
  simpa using rewind M A w 0 (w.length+1)
def blankize (M : Ordinary g q) (A : Alphabet M) (w : List Bool) := install M (writer M A w)
theorem blankize_iff (M : Ordinary g q) (A : Alphabet M) (w : List Bool) :
    (∃ t, stopped (blankize M A w).2 t) ↔ HALT M (inputConfig M A w) := by
  let e := dataEnv M A [] 0
  let cs := writer M A w
  let N := (install M cs).2
  have initial : config₀ N = e.start N := by
    have m : N.marker = M.marker := installed_marker M cs
    have b : N.blank = M.blank := installed_blank M cs
    have f : (fun j => if j = 0 then N.marker else N.blank) = inputTape M A [] := by
      funext j; cases j <;> simp [inputTape,m,b]
    simp [config₀,e,Env.start,dataEnv,f]
  exact (blank_halts N).symm.trans (initial ▸ (install_iff M cs e).trans (by
    change HALT M ((perform M.marker (writer M A w) (dataEnv M A [] 0)).start M) ↔ _
    rw [written]; rfl))
def diagonalInput (P : Ordinary g q) (B : Alphabet P) := blankize P B (selfBits P B)
theorem diagonal_input_iff (P : Ordinary g q) (B : Alphabet P) :
    (∃ t, stopped (diagonalInput P B).2 t) ↔ SelfHalt P B := blankize_iff P B _
theorem diagonal_basis (P : Ordinary g q) (B : Alphabet P) :
    P455Global.HasBasis (P455MachineReduction.model (diagonalInput P B).2) ↔ ¬SelfHalt P B :=
  (P455Decision.ordinary_equivalence _).trans (not_congr (diagonal_input_iff P B))
end P455EffectiveWriter
end
section
namespace P455TableSemantics
open P455Table P455FirstRewrite
def SemigroupTable (T : Matrix) : Prop :=
  0 < T.length ∧ (∀ row∈T, row.length = T.length ∧ ∀ a∈row, a < T.length) ∧
  ∀ a b c, a < T.length → b < T.length → c < T.length →
    entry T (entry T a b) c = entry T a (entry T b c)
def HasUnit (T : Matrix) := ∃ u < T.length, ∀ i < T.length, entry T u i = i ∧ entry T i u = i
theorem output_laws {A : Type} {X : FiniteOps} {M : Model A} (p : Presents X M) :
    SemigroupTable (matrix X) ∧ HasUnit (matrix X) := by
  have assoc (a b c : Fin X.size) : X.mul (X.mul a b) c = X.mul a (X.mul b c) := by
    apply p.inj
    simp only [p.mul_eq,M.assoc]
  refine ⟨⟨by simpa using Nat.lt_of_le_of_lt (Nat.zero_le _) X.one.isLt,
    by simpa only [matrix_length] using square X,?_⟩,?_⟩
  · intro a b c ha hb hc
    let i : Fin X.size := ⟨a,by simpa using ha⟩
    let j : Fin X.size := ⟨b,by simpa using hb⟩
    let k : Fin X.size := ⟨c,by simpa using hc⟩
    change entry _ (entry _ i j) k = entry _ i (entry _ j k)
    simp only [matrix_entry]
    exact congrArg Fin.val (assoc i j k)
  · refine ⟨X.one.val,by simp,?_⟩
    intro i hi
    let j : Fin X.size := ⟨i,by simpa using hi⟩
    change entry _ X.one j = j.val ∧ entry _ j X.one = j.val
    simp only [matrix_entry]
    constructor
    · exact congrArg Fin.val (p.inj _ _ (by rw [p.mul_eq,p.one_eq,M.oneL]))
    · exact congrArg Fin.val (p.inj _ _ (by rw [p.mul_eq,p.one_eq,M.oneR]))
def value (T : Matrix) (f : Nat → Nat) : Nat → List Nat → Nat
  | a, [] => f a
  | a, b::w => entry T (f a) (value T f b w)
def wordValue (T : Matrix) (f : Nat → Nat) : List Nat → Nat
  | [] => 0
  | a::w => value T f a w
def Valid (T : Matrix) (u v : List Nat) := ∀ f : Nat → Nat, (∀ x, f x < T.length) →
    wordValue T f u = wordValue T f v
def HasBasis (T : Matrix) := ∃ rules : List (List Nat × List Nat),
    (∀ u v, (u,v)∈rules → u≠[] ∧ v≠[] ∧ Valid T u v) ∧
    ∀ u v, u≠[] → v≠[] → Valid T u v → Derives (fun a b => (a,b)∈rules) u v
def code (X : FiniteOps) (f : Nat → Fin X.size) : Nat → List Nat → Fin X.size
  | x, [] => f x
  | x, y::ys => X.mul (f x) (code X f y ys)
theorem read_code (X : FiniteOps) (f : Nat → Fin X.size) (x : Nat) (w : List Nat) :
    value (matrix X) (fun a => (f a).val) x w = (code X f x w).val := by
  induction w generalizing x with
  | nil => rfl
  | cons y ys ih => exact (congrArg (entry _ (f x).val) (ih y)).trans (matrix_entry X _ _)
theorem decode_code {X : FiniteOps} {M : Model A} (p : Presents X M) (f : Nat → Fin X.size)
    (x : Nat) (w : List Nat) : p.decode (code X f x w) = M.eval (fun a => p.decode (f a)) (x::w) := by
  induction w generalizing x with
  | nil => simp [code,Model.eval,M.oneR]
  | cons y ys ih =>
    change p.decode (X.mul _ _) = M.op _ _
    rw [p.mul_eq,ih]
theorem valid_iff {X : FiniteOps} {M : Model A} (p : Presents X M) (u v : List Nat)
    (un : u≠[]) (vn : v≠[]) : Valid (matrix X) u v ↔ M.Valid u v := by
  obtain ⟨a,U,rfl⟩ := List.exists_cons_of_ne_nil un
  obtain ⟨b,V,rfl⟩ := List.exists_cons_of_ne_nil vn
  constructor
  · intro h g
    let f (i : Nat) := Classical.choose (p.surj (g i))
    have counts := h (fun x => (f x).val) (fun i => by simp)
    change value _ _ _ _ = value _ _ _ _ at counts
    rw [read_code,read_code] at counts
    have E := congrArg p.decode (Fin.ext counts)
    rw [decode_code,decode_code] at E
    have fg : (fun i => p.decode (f i)) = g := funext fun i => Classical.choose_spec (p.surj (g i))
    simpa only [fg] using E
  · intro h g bounded
    let f (i : Nat) : Fin X.size := ⟨g i,by simpa using bounded i⟩
    change value _ (fun i => (f i).val) _ _ = value _ (fun i => (f i).val) _ _
    rw [read_code,read_code]
    exact congrArg Fin.val (p.inj _ _ ((decode_code p f a U).trans
      ((h (fun i => p.decode (f i))).trans (decode_code p f b V).symm)))
theorem basis_iff {X : FiniteOps} {M : Model A} (p : Presents X M) :
    HasBasis (matrix X) ↔ P455Global.HasBasis M := by
  constructor <;> rintro ⟨rules,sound,complete⟩ <;> refine ⟨rules,?_,?_⟩
  · intro u v m; obtain ⟨a,b,s⟩ := sound u v m
    exact ⟨a,b,(valid_iff p u v a b).mp s⟩
  · intro u v a b s; exact complete u v a b ((valid_iff p u v a b).mpr s)
  · intro u v m; obtain ⟨a,b,s⟩ := sound u v m
    exact ⟨a,b,(valid_iff p u v a b).mpr s⟩
  · intro u v a b s; exact complete u v a b ((valid_iff p u v a b).mp s)
end P455TableSemantics
end
