namespace P455Prefix
open P455FirstRewrite P455FirstTesters P455Quotient
def highNames (r : Nat) (u : Word) := (names u).filter (fun x => decide (r < u.count x))
def headPowers (r : Nat) (xs : Word) := xs.flatMap (List.replicate (r+1))
def residual (xs u : Word) := u.filter (fun a => decide (a ∉ xs))
@[simp] theorem mem_high (r x : Nat) (u : Word) : x ∈ highNames r u ↔ r < u.count x := by
  simp only [highNames,List.mem_filter,mem_names,decide_eq_true_eq]
  exact ⟨And.right,fun h => ⟨List.count_pos_iff.mp (by omega),h⟩⟩
@[simp] theorem residual_count (xs u : Word) (a : Nat) :
    (residual xs u).count a = if a ∈ xs then 0 else u.count a := by
  by_cases h : a ∈ xs
  · rw [if_pos h]; exact List.count_eq_zero.mpr (fun m => by simp [residual,h] at m)
  · simp [residual,List.count_filter,h]
private theorem residual_step (x : Nat) (xs u : Word) :
    residual xs (dropName x u) = residual (x::xs) u := by
  simp only [residual,dropName,List.filter_filter]
  apply List.filter_congr
  intro a _
  by_cases e : a = x <;> by_cases m : a ∈ xs <;> simp [e,m]
private theorem handle_names {r allow ts} (xs u : Word) (dis : xs.Nodup)
    (many : ∀ x ∈ xs, r < u.count x) :
    Derives (Steps r allow ts) u (headPowers r xs ++ residual xs u) := by
  induction xs generalizing u with
  | nil =>
    have empty : residual [] u = u := List.filter_eq_self.mpr (by simp)
    simpa only [headPowers,List.flatMap_nil,List.nil_append,empty] using (Walk.refl (s := Step (Steps r allow ts)) u)
  | cons x xs ih =>
    obtain ⟨fresh,tail⟩ := List.nodup_cons.mp dis
    have p := gather_deduction (allow := allow) (ts := ts) u (many x List.mem_cons_self)
    have sat (a : Nat) (m : a ∈ xs) : r < (dropName x u).count a := by
      have ne : a ≠ x := fun e => fresh (e ▸ m)
      simpa only [drop_count,if_neg ne] using many a (List.mem_cons_of_mem _ m)
    have tailD := ih (dropName x u) tail sat
    have q := context_derives (List.replicate (r+1) x) [] tailD
    apply p.trans
    simpa only [headPowers,List.flatMap_cons,List.append_assoc,List.append_nil,residual_step,gather] using q
private theorem residual_instance (xs u : Word) :
    u.flatMap (fun a => if a ∈ xs then [] else [a]) = residual xs u := by
  induction u with
  | nil => rfl
  | cons a t ih => by_cases h : a ∈ xs <;> simp [residual,h,ih]
theorem residual_valid {A : Type} (M : Model A) (xs : Word) {u v : Word} (h : M.Valid u v) :
    M.Valid (residual xs u) (residual xs v) := by
  intro f
  rw [← residual_instance,← residual_instance,M.eval_instance,M.eval_instance]
  exact h _
theorem arbitrary_prefix {r allow ts} {u v : Word}
    (valid : (P455FullSingleton.model r allow ts).Valid u v) :
    let xs := highNames r u
    let p := headPowers r xs
    let a := residual xs u
    let b := residual xs v
    Derives (Steps r allow ts) u (p ++ a) ∧
    Derives (Steps r allow ts) v (p ++ b) ∧
    Cap r a ∧ Cap r b ∧ (P455FullSingleton.model r allow ts).Valid a b ∧
    (∀ z, a.count z = b.count z) ∧ (a = [] ↔ b = []) := by
  dsimp only
  have power := tester_rule (valid_left _ _ valid)
  let xs := highNames r u
  have high (x : Nat) : r < u.count x ↔ r < v.count x := by
    have := power.unary x; omega
  have distinct : xs.Nodup := (names_distinct u).filter _
  have cA : Cap r (residual xs u) := by
    intro a; rw [residual_count]; by_cases h : a ∈ xs
    · simp [h]
    · have lo : ¬ r < u.count a := fun n => h ((mem_high ..).mpr n)
      simp [h]; omega
  have cB : Cap r (residual xs v) := by
    intro a; rw [residual_count]; by_cases h : a ∈ xs
    · simp [h]
    · have lo : ¬ r < v.count a := fun n => h ((mem_high ..).mpr ((high a).mpr n))
      simp [h]; omega
  have h := residual_valid _ xs valid
  have categories := tester_rule (valid_left _ _ h)
  have count (a : Nat) : (residual xs u).count a = (residual xs v).count a := by
    have := categories.unary a; have := cA a; have := cB a; omega
  refine ⟨handle_names xs u distinct (fun a m => (mem_high ..).mp m),
    handle_names xs v distinct (fun a m => (high a).mp ((mem_high ..).mp m)),
    cA,cB,h,count,?_⟩
  exact ⟨fun e => (List.Perm.nil_eq (e ▸ List.perm_iff_count.mpr count)).symm,
    fun e => (List.Perm.nil_eq (e ▸ (List.perm_iff_count.mpr count).symm)).symm⟩
theorem lift_deduction {G H : Word → Word → Prop} (sub : ∀ a b, G a b → H a b)
    {u v : Word} (p : Derives G u v) : Derives H u v := by
  induction p with
  | refl => exact .refl _
  | snoc _ step ih =>
    obtain ⟨a,b,l,k,f,rule,an,bn,hn,left,right⟩ := step
    exact .snoc ih ⟨a,b,l,k,f,rule.imp (sub a b) (sub b a),an,bn,hn,left,right⟩
theorem reassemble {r allow ts k} {u v : Word}
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (suffixes : Derives (fun a b => (P455FullSingleton.model r allow ts).Valid a b ∧ rank a b ≤ k)
      (residual (highNames r u) u) (residual (highNames r u) v)) :
    Derives (fun a b => (P455FullSingleton.model r allow ts).Valid a b ∧ rank a b ≤ max k (2*(r+2)+1)) u v := by
  obtain ⟨left,right,_⟩ := arbitrary_prefix valid
  let H : Word → Word → Prop := fun a b => (P455FullSingleton.model r allow ts).Valid a b ∧
    rank a b ≤ max k (2*(r+2)+1)
  have widen (a b) (h : Steps r allow ts a b) : H a b := ⟨h.1,Nat.le_trans h.2 (Nat.le_max_right ..)⟩
  have a := lift_deduction widen left
  have b := lift_deduction widen right
  have middle := context_derives (headPowers r (highNames r u)) []
    (lift_deduction (H := H) (fun _ _ h => ⟨h.1,Nat.le_trans h.2 (Nat.le_max_left ..)⟩) suffixes)
  have backwards := b.symm (fun step => P455ReductionBoundary.sym_step step)
  exact (a.trans (by simpa only [List.append_nil] using middle)).trans backwards
end P455Prefix
end
section
namespace P455CellClassBinary
open Problem455.Slots P455Witness P455FirstTesters P455FirstRewrite P455MarkedRank
open P455BinaryEquality P455BinaryProduct P455SlotSaturation P455ProfileComponent
abbrev W := List Nat
theorem exact_counts {r allow ts U V} (cap : P455Quotient.Cap r U)
    (h : (P455FullSingleton.model r allow ts).Valid U V) (x : Nat) :
    U.count x = V.count x := by
  have ct := (tester_rule (valid_left _ _ h)).unary x
  have bd := cap x
  omega
private theorem named {r allow ts U V} (h : (P455FullSingleton.model r allow ts).Valid U V)
    (i : P455BinaryProduct.Index r allow) (f : Nat → W) :
    P455Quotient.ofWord i.R i.T (U.flatMap f) = P455Quotient.ofWord i.R i.T (V.flatMap f) := by
  have idBin := ((valid_pair ..).mp (((valid_pair ..).mp ((valid_pair ..).mp h).2).2)).1
  let g (a : Nat) (j : P455BinaryProduct.Index r allow) := P455Quotient.ofWord j.R j.T (f a)
  have eq := congrFun (idBin g) i
  rw [eval_at,eval_at,P455Quotient.eval_rep i.R i.bound _ U f (fun _ _ => rfl),
    P455Quotient.eval_rep i.R i.bound _ V f (fun _ _ => rfl)] at eq
  exact eq
private theorem encoding (i j : Nat) (ne : i ≠ j) (U : W) :
    let E := U.flatMap (code i j)
    (∀ x ∈ E, x = 0 ∨ x = 1) ∧ E.count 0 = U.count i ∧ E.count 1 = U.count j ∧
    E.length = U.count i + U.count j ∧ E.map (fun z => if z = 0 then i else j) = select [i,j] U := by
  induction U with
  | nil => simp [select]
  | cons a U ih =>
    obtain ⟨names,lo,hi,len,back⟩ := ih
    by_cases ai : a = i <;> by_cases aj : a = j <;>
      simp_all [List.flatMap_cons,code,List.count_cons,select,List.mem_cons, Nat.add_comm,
        Nat.add_left_comm, Nat.add_assoc] <;> exact names
theorem changed {r allow ts U V} (cap : P455Quotient.Cap r U)
    (h : (P455FullSingleton.model r allow ts).Valid U V) {x y : Nat} (ne : x ≠ y)
    (diff : select [x,y] U ≠ select [x,y] V) :
    ∃ a b tag bit, ((a = x ∧ b = y) ∨ (a = y ∧ b = x)) ∧ tag.length+16 = r ∧ allow tag ∧
      select [x,y] U = profile a b tag bit ∧ select [x,y] V = profile a b tag (!bit) := by
  classical
  let f := code x y
  let T := U.flatMap f
  let S := V.flatMap f
  let d := fun z : Nat => if z = 0 then x else y
  obtain ⟨names,c0,c1,len,decU⟩ := encoding x y ne U
  obtain ⟨_,_,_,_,decV⟩ := encoding x y ne V
  change T.map d = _ at decU
  change S.map d = _ at decV
  have neq : T ≠ S := fun same => diff (decU.symm.trans ((congrArg (List.map d) same).trans decV))
  change T.length = U.count x + U.count y at len
  have capT : P455Quotient.Cap r T := by
    intro z; by_cases mem : z ∈ T
    · rcases names z mem with rfl|rfl
      · exact c0 ▸ cap x
      · exact c1 ▸ cap y
    · simp [List.count_eq_zero.mpr mem]
  have capV : P455Quotient.Cap r V := fun i => (exact_counts cap h i) ▸ cap i
  have pr (a b : Nat) (w : W) : proj a b w = select [a,b] w := by simp [proj,select]
  have pos (a b : Nat) (dif : proj a b U ≠ proj a b V) :
      0 < U.count a ∧ 0 < U.count b := by
    obtain ⟨ea,eb⟩ := (tester_rule (valid_left _ _ h)).binary cap capV a b dif
    rcases Nat.eq_zero_or_pos r with zero|positive
    · have empty (u : W) (cp : P455Quotient.Cap r u) : u=[] := by
        cases u with
        | nil => rfl
        | cons z w => have := cp z; simp [zero] at this
      exact False.elim (dif (by rw [empty U cap, empty V capV]))
    · exact ⟨ea ▸ positive,eb ▸ positive⟩
  obtain ⟨px,py⟩ := pos x y (by simpa only [pr] using diff)
  have covered := Problem455Finite.covered [0,1] (2*r) T (by have := cap x; have := cap y; omega)
    (fun z m => by simpa using names z m)
  obtain ⟨n,en⟩ := List.get_of_mem covered
  let i : P455BinaryProduct.Index r allow := ⟨n,decide (IsProfile r allow T),en.symm ▸ capT,by
    rw [en]; exact ⟨.inr ⟨c0 ▸ px,c1 ▸ py⟩,decide_eq_true_iff⟩⟩
  have iT : i.T = T := en
  have ip : i.prof = decide (IsProfile r allow T) := rfl
  have same := named h i f
  change P455Quotient.ofWord i.R i.T T = P455Quotient.ofWord i.R i.T S at same
  have ps : IsProfile r allow T := by
    apply Classical.byContradiction
    intro no
    have rr : i.R = plain r := by simp [P455BinaryProduct.Index.R,ip,no]
    rw [iT,rr] at same
    have ok : P455Quotient.Good (plain r) T T := ⟨T,.refl _,[],[],by simp⟩
    have path := ((P455Quotient.same_nonzero_class _ ok).mp same).2
    exact neq (path.transport (P := fun z => T = z) rfl (fun bad _ => False.elim bad))
  have rr : i.R = rules r allow noMark := by simp [P455BinaryProduct.Index.R,ip,ps]
  rw [iT,rr] at same
  obtain ⟨a,b,tag,bit,ab,tl,ok,et⟩ := ps
  have live : P455Quotient.Good (rules r allow noMark) T T := ⟨T,.refl _,[],[],by simp⟩
  have path := ((P455Quotient.same_nonzero_class _ live).mp same).2
  rw [et] at path
  obtain ⟨v,es⟩ := (variants ab tl ok bit S).mp path
  have opp : v = !bit := by cases v <;> cases bit <;> simp_all
  have az := names a (show a ∈ T by simp [et,profile,profilePrefix])
  have bz := names b (show b ∈ T by simp [et,profile,profilePrefix])
  refine ⟨d a,d b,tag,bit,?_,tl,ok,?_,?_⟩
  · rcases az with h1|h1 <;> rcases bz with h2|h2 <;> simp_all [d]
  · exact decU.symm.trans ((congrArg (List.map d) et).trans (P455ContactReflection.map_profile ..))
  · rw [← decV,es,opp,P455ContactReflection.map_profile]
end P455CellClassBinary
end
section
namespace P455WordChart
open P455Witness P455Paths P455GridRows P455GraphReduction P455GridAssembly
open P455SourceFamilies P455CrossedSupport P455ActualGuards P455SingletonEvaluation
open P455SlotSaturation P455Uncrossed P455PortReflection P455Schedule P455FirstRewrite Problem455.Slots
abbrev W := List Nat
abbrev Walk (r : Nat) (allow : Tag → Prop) := P455Quotient.Walk (P455Closure.Move r allow noMark)
private theorem free_if (p : Bool) (q : Query) (hq : markFree q = true) :
    markFree (flagQ p q) = true := by cases p <;> simp [flagQ,markFree,hq]
private theorem free_local (ts : Tiles) (e : EdgeCertificate) : markFree (localCert ts e) = true := by
  have hr (a b : Node) : markFree (rightward ts a b) = true := rfl
  have hd (a b : Node) : markFree (downward ts a b) = true := rfl
  simp only [localCert,allQ,markFree,free_if _ _ (hr ..),free_if _ _ (hd ..)]
  rw [free_if _ _ (show markFree (.both (downward ts e.right e.diagonal)
    (rightward ts e.down e.diagonal)) = true from rfl)]
  rfl
private theorem free_successor (ts : Tiles) (e : EdgeCertificate) : markFree (chosenSuccessor ts e) = true := by
  dsimp only [chosenSuccessor]; split <;> rfl
theorem remark_arrow {r allow mark mark' w ts e} (a : Arrow r allow mark w ts e) :
    Arrow r allow mark' w ts e :=
  ⟨a.1,a.2.1,remark (free_local ..) a.2.2.1,remark (free_successor ..) a.2.2.2⟩
theorem walk_query {r allow u v} (p : Walk r allow u v) (q : Query) :
    Holds r allow noMark u q ↔ Holds r allow noMark v q := by
  induction p with
  | refl => rfl
  | snoc _ step ih => exact ih.trans (query_invariant step q)
theorem walk_arrow {r allow u v ts e} (p : Walk r allow u v) :
    Arrow r allow noMark u ts e ↔ Arrow r allow noMark v ts e := by
  simp only [Arrow,← walk_query p]
def Read (s : Bits) (nodes : Nat → Node) (r : Nat) (allow : Tag → Prop) (w : W) :=
  ∀ i, Holds r allow noMark w (typedNode (nodes i)) →
    select [(nodes i).owner,(nodes i).mate] w = profile (nodes i).owner (nodes i).mate (nodes i).tag (s i)
private theorem true_false_query {r allow ts u e} (edge : Arrow r allow noMark u ts e)
    (a : select [e.a.owner,e.a.mate] u = profile e.a.owner e.a.mate e.a.tag true)
    (b : select [e.b.owner,e.b.mate] u = profile e.b.owner e.b.mate e.b.tag false) :
    Holds r allow (fun _ _ => True) u (e.query ts) := by
  have h := remark_arrow (mark' := fun _ _ => True) edge
  exact ⟨⟨h.1.1,h.1.2.1,h.1.2.2.1,.inl trivial,a⟩,
    ⟨h.2.1.1,h.2.1.2.1,h.2.1.2.2.1,.inl trivial,b⟩,h.2.2.1,h.2.2.2,trivial⟩
def Changed (u v : W) (n : Node) := select [n.owner,n.mate] u ≠ select [n.owner,n.mate] v
theorem good_of_identity {r allow ts U V w A} (nodes : Nat → Node) (C : List Nat)
    (cap : P455Closure.Cap r U) (valid : (P455FullSingleton.model r allow ts).Valid U V)
    (graph : Walk r allow w U) (read : Read A nodes r allow U)
    (diff : ∀ i ∈ C, Changed U V (nodes i)) :
    Good C (WordEdge r allow noMark w ts nodes) A := by
  intro a b ed member on
  obtain ⟨e,ea,eb,aU⟩ := ed
  have atU := (walk_arrow graph).mp aU
  have left := read a (ea ▸ atU.1)
  have right := read b (eb ▸ atU.2.1)
  rw [← ea,on] at left
  rw [← eb] at right
  cases off : A b with
  | true => rfl
  | false =>
    rw [off] at right
    have mark := ((P455MarkedRank.valid_pair ..).mp ((P455MarkedRank.valid_pair ..).mp valid).2).1
    have edge := ((P455MarkedRank.valid_pair ..).mp mark).2
    have obs := P455EdgeProduct.endpoint_observed cap edge e (true_false_query atU left right)
    rcases member with mem|mem
    · exact False.elim (diff a mem (ea ▸ obs.1))
    · exact False.elim (diff b mem (eb ▸ obs.2))
private theorem bit_inj {a b : Nat} (ne : a≠b) (tag : Tag) {i j : Bool}
    (e : profile a b tag i = profile a b tag j) : i = j := by
  cases i <;> cases j <;> simp_all [profile,pair]
theorem match_unique {r allow w} {n m : Node} (ok : Holds r allow noMark w (typedNode n))
    (other : Holds r allow noMark w (typedNode m)) (match' : Matches m n.owner n.mate) : m = n := by
  rcases match' with ⟨x,y⟩|⟨x,y⟩
  · exact P455PortUnique.node_unique m n x y other ok
  · obtain ⟨b,ob⟩ := ok.2.2.2
    obtain ⟨c,oc⟩ := other.2.2.2
    rw [x,y,select_pair_symm,ob] at oc
    have same := congrArg List.head? oc
    exact False.elim (ok.1 (by simpa [profile,profilePrefix] using same))
theorem feasible {r allow w ts v} (nodes : Nat → Node) (C : List Nat) (s : Bits)
    (p : Walk r allow w v) (read : Read s nodes r allow v)
    (cover : ∀ n, Holds r allow noMark w (typedNode n) → ∃ j, nodes j = n)
    (good : Good C (WordEdge r allow noMark w ts nodes) s)
    {i : Nat} (mem : i ∈ C) (typed : Holds r allow noMark w (typedNode (nodes i))) :
    ¬ EdgeViolation r allow ts v (nodes i).owner (nodes i).mate := by
  rintro ⟨e,side,mt,h⟩
  have typedA : Holds r allow noMark v (typedNode e.a) :=
    ⟨h.1.1,h.1.2.1,h.1.2.2.1,_,h.1.2.2.2.2⟩
  have typedB : Holds r allow noMark v (typedNode e.b) :=
    ⟨h.2.1.1,h.2.1.2.1,h.2.1.2.2.1,_,h.2.1.2.2.2.2⟩
  have arrV : Arrow r allow noMark v ts e :=
    ⟨typedA,typedB,remark (free_local ..) h.2.2.1,remark (free_successor ..) h.2.2.2.1⟩
  have arr := (walk_arrow p).mpr arrV
  have typedI := (walk_query p _).mp typed
  obtain ⟨a,b,ea,eb,incident⟩ : ∃ a b, nodes a = e.a ∧ nodes b = e.b ∧ (a∈C ∨ b∈C) := by
    cases side with
    | false =>
      obtain ⟨b,hb⟩ := cover _ arr.2.1
      exact ⟨i,b,(match_unique typedI typedA mt).symm,hb,.inl mem⟩
    | true =>
      obtain ⟨a,ha⟩ := cover _ arr.1
      exact ⟨a,i,ha,(match_unique typedI typedB mt).symm,.inr mem⟩
  have la := read a (ea ▸ typedA)
  have lb := read b (eb ▸ typedB)
  rw [ea] at la
  rw [eb] at lb
  have one := bit_inj typedA.1 _ (la.symm.trans h.1.2.2.2.2)
  have zero := bit_inj typedB.1 _ (lb.symm.trans h.2.1.2.2.2.2)
  have twice := good a b ⟨e,ea.symm,eb.symm,arr⟩ incident one
  simp [zero] at twice
end P455WordChart
end
section
namespace P455Enum
open P455Witness P455Structural P455PaddedTiles P455BinaryEquality Problem455.Slots
theorem profile_names {a b tag bit} : a∈profile a b tag bit ∧ b∈profile a b tag bit := by
  simp [profile,profilePrefix]
def profileD (r) (M : MachineTable n) (w : List Nat) : Decidable (IsProfile r (allowed M) w) :=
  decidable_of_iff (∃ a∈w, ∃ b∈w, ∃ t∈tags M, ∃ bit : Bool,
    a≠b ∧ t.length+16 = r ∧ w = profile a b t bit) (by
      constructor
      · rintro ⟨a,_,b,_,t,mt,v,ne,len,eq⟩; exact ⟨a,b,t,v,ne,len,mem_tags.mp mt,eq⟩
      · rintro ⟨a,b,t,v,ne,len,mt,rfl⟩
        exact ⟨a,profile_names.1,b,profile_names.2,t,mem_tags.mpr mt,v,ne,len,rfl⟩)
def pairCover (a : Cover α) (b : Cover β) : Cover (α×β) :=
  a.bind (fun _=>b) Prod.mk (fun ⟨x,y⟩=>⟨x,y,rfl⟩)
def coverSub (s : Cover α) (p : α → Prop) [DecidablePred p] : Cover (Subtype p) :=
  ⟨selectSub s.list p,fun i=>selectSub_full i (s.mem _)⟩
def binary (r) (M : MachineTable n) : Cover (P455BinaryProduct.Index r (allowed M)) :=
  let xs := Problem455Finite.wordsUpTo [0,1] (2*r)
  let p (c : Fin xs.length × Bool) := let T:=xs.get c.1; P455Closure.Cap r T ∧
    (T = P455FirstTesters.power r ∨ 0 < T.count 0 ∧ 0 < T.count 1) ∧ (c.2 = true ↔ IsProfile r (allowed M) T)
  letI : DecidablePred p := fun c => by
    letI := capD r (xs.get c.1)
    letI := profileD r M (xs.get c.1)
    unfold p; dsimp only; infer_instance
  (coverSub (pairCover (fins _) bools) p).map
    (fun c=>⟨c.val.1,c.val.2,c.property.1,c.property.2⟩)
    (fun ⟨i,b,cp,ok⟩=>⟨⟨(i,b),cp,ok⟩,rfl⟩)
theorem rec_names {r allow w a b} (h : Rec w r allow a b) : a∈w ∧ b∈w := by
  obtain ⟨t,_,_,_,bit,eq⟩ := h
  have m := @profile_names a b t bit
  rw [←eq] at m
  exact ⟨(List.mem_filter.mp m.1).1,(List.mem_filter.mp m.2).1⟩
theorem edge_names {r allow w a b} (h : Edge w r allow a b) : a∈w ∧ b∈w :=
  h.elim rec_names (fun z => ⟨(rec_names z).2,(rec_names z).1⟩)
instance recD (r) (M : MachineTable n) (w a b) : Decidable (Rec w r (allowed M) a b) := by
  unfold Rec
  exact @search _ (tags M) _ (fun t => by unfold Holds; infer_instance)
    (fun t z => mem_tags.mpr z.2.2.1)
instance edgeD (r) (M : MachineTable n) (w a b) : Decidable (Edge w r (allowed M) a b) := by
  unfold Edge; infer_instance
theorem words_bound {α : Type} (alphabet : List α) (k) {w : List α}
    (mem : w∈Problem455Finite.wordsUpTo alphabet k) : w.length ≤ k := by
  induction k generalizing w with
  | zero => simpa [Problem455Finite.wordsUpTo] using mem
  | succ k ih =>
    rcases List.mem_cons.mp mem with rfl|tail
    · simp
    obtain ⟨a,_,hit⟩ := List.mem_flatMap.mp tail
    obtain ⟨q,m,rfl⟩ := List.mem_map.mp hit
    exact Nat.succ_le_succ (ih m)
def widthD (k : Nat) (w : List Nat) : Decidable (Width k w) :=
  decidable_of_iff (∃ C∈Problem455Finite.wordsUpTo w k,∀ x∈w,x∈C) (by
    constructor
    · rintro ⟨C,h,c⟩
      exact ⟨C,words_bound _ _ h,c⟩
    · rintro ⟨C,len,c⟩
      let V := C.filter (fun x=>x∈w)
      have toV (x) (m : x∈w) : x∈V := by simp [V,c _ m,m]
      exact ⟨V,Problem455Finite.covered _ _ _ (Nat.le_trans (List.length_filter_le ..) len)
        (fun _ m => of_decide_eq_true (List.mem_filter.mp m).2),toV⟩)
def overlapD (r) (M : MachineTable n) (w) : Decidable (Overlap w r (allowed M)) :=
  decidable_of_iff (∃ o∈w, ∃ p∈w, ∃ q∈w, o≠p ∧ o≠q ∧ p≠q ∧ Edge w r (allowed M) o p ∧ Edge w r (allowed M) o q)
    ⟨fun ⟨o,_,p,_,q,_,h⟩=>⟨o,p,q,h⟩,fun ⟨o,p,q,h⟩ =>
      ⟨o,(edge_names h.2.2.2.1).1,p,(edge_names h.2.2.2.1).2,q,(edge_names h.2.2.2.2).2,h⟩⟩
def intrusionD (r) (M : MachineTable n) (w) : Decidable (Intrusion w r (allowed M)) :=
  decidable_of_iff (∃ o∈w, ∃ p∈w, ∃ e∈events w, o≠p ∧ e.1≠o ∧ e.1≠p ∧ Rec w r (allowed M) o p ∧
    sees w [(o,0),e,(p,2)]) ⟨fun ⟨o,_,p,_,e,_,h⟩=>⟨o,p,e.1,e.2,h⟩,fun ⟨o,p,z,j,h⟩=>
      ⟨o,(rec_names h.2.2.2.1).1,p,(rec_names h.2.2.2.1).2,(z,j),h.2.2.2.2.subset (by simp),h⟩⟩
def compressedD {r} (hr : 0 < r) (w) : Decidable (P455SourceFamilies.Compressed r w) :=
  decidable_of_iff (∀ a∈w,∀ b∈w,¬Problem455Swap.Link r w a b)
    ⟨fun f _ _ lk=>f _ (linkNames hr lk).1 _ (linkNames hr lk).2 lk,fun f a _ b _=>f a b⟩
def structural {r} (hr : 0 < r) (M : MachineTable n) : Cover (P455StructuralProduct.Index r (allowed M)) :=
  let xs := P455StructuralProduct.templates r
  let p (i : Fin xs.length) := let w:=xs.get i; P455Closure.Cap r w ∧ P455SourceFamilies.Compressed r w ∧ Structural w r (allowed M)
  letI : DecidablePred p := fun i => by
    let w:=xs.get i
    letI := capD r w; letI := compressedD hr w
    letI := widthD 4 w; letI := widthD 3 w; letI := overlapD r M w; letI := intrusionD r M w
    unfold p Structural; dsimp only; infer_instance
  (coverSub (fins _) p).map (fun c=>⟨c.val,c.property.1,c.property.2.1,c.property.2.2⟩)
    (fun ⟨i,cp,cmp,st⟩=>⟨⟨i,cp,cmp,st⟩,rfl⟩)
end P455Enum
end
section
namespace P455Prefix
open P455FirstRewrite P455Quotient
open Problem455Swap (Link bigram hit)
def openPair (a b z : Nat) : Word := if z = a then [a,b] else [z]
private theorem out_le (a b : Nat) (w : Word) : bigram a b w ≤ w.count a := by
  have h := Problem455Swap.out_bound a b (b+1) (by omega) w
  rw [Problem455BlockBridge.occ_count] at h; omega
private theorem in_le (a b : Nat) (w : Word) : bigram a b w ≤ w.tail.count b := by
  have h := Problem455Swap.in_bound a (a+1) b (by omega) w
  rw [Problem455BlockBridge.occ_count] at h; omega
theorem link_counts {r a b} {w : Word} (c : Cap r w) (l : Link r w a b) :
    w.count a = r ∧ w.count b = r := by
  have h := out_le a b w
  have j := in_le a b w
  have t := Problem455Swap.tail_occ_le b w
  simp only [Problem455BlockBridge.occ_count] at t
  have ca := c a; have cb := c b
  change bigram a b w = r at l
  omega
private theorem parse {a b : Nat} (w : Word)
    (ca : bigram a b w = w.count a) (cb : bigram a b w = w.count b) :
    (dropName b w).flatMap (openPair a b) = w := by
  cases w with
  | nil => rfl
  | cons z t =>
    have nb : z ≠ b := by
      rintro rfl
      have h := in_le a z (z::t)
      simp [List.count_cons] at cb h; omega
    by_cases za : z = a
    · subst z
      cases t with
      | nil => simp [bigram,hit,List.count_cons] at ca
      | cons c s =>
        have next : c = b := by
          apply Classical.byContradiction; intro h
          have lower := out_le a b (c::s)
          simp [bigram,hit,h,List.count_cons] at ca
          simp [bigram,hit,List.count_cons] at lower
          omega
        subst c
        have size : bigram a b (a::b::s) = 1+bigram a b s := by simp [bigram,hit,Ne.symm nb]
        rw [size] at ca cb
        simp [List.count_cons,nb,Ne.symm nb] at ca cb
        have eq := parse s (by omega : bigram a b s = s.count a) (by omega : bigram a b s = s.count b)
        simpa [dropName,openPair,nb] using congrArg (List.cons a ∘ List.cons b) eq
    · have same : bigram a b (z::t) = bigram a b t := by simp [bigram,hit,za]
      rw [same] at ca cb
      simp [List.count_cons,za,nb] at ca cb
      simpa [dropName,openPair,za,nb] using congrArg (List.cons z) (parse t ca cb)
termination_by w.length
theorem recover_link {r a b} {w : Word} (cap : Cap r w) (l : Link r w a b) :
    (dropName b w).flatMap (openPair a b) = w := by
  obtain ⟨p,q⟩ := link_counts cap l
  exact parse w (l.trans p.symm) (l.trans q.symm)
private theorem drop_length (b : Nat) (w : Word) :
    (dropName b w).length + w.count b = w.length := by
  induction w with
  | nil => rfl
  | cons a t ih => by_cases e : a = b <;> simp_all [dropName,List.count_cons] <;> omega
private theorem drop_cap {r} (b : Nat) {w : Word} (cap : Cap r w) : Cap r (dropName b w) := by
  intro a; rw [drop_count]; split
  · omega
  · exact cap a
private theorem drop_valid {A : Type} (M : Model A) (b : Nat) {u v : Word} (h : M.Valid u v) :
    M.Valid (dropName b u) (dropName b v) := by
  have eq (z : Word) : residual [b] z = dropName b z := by
    unfold residual dropName; apply List.filter_congr; intro a _; by_cases e : a = b <;> simp [e]
  simpa only [eq] using residual_valid M [b] h
private theorem nonempty_composition {f g : Nat → Word} (hf : ∀ z, f z ≠ []) (hg : ∀ z, g z ≠ [])
    (z : Nat) : (f z).flatMap g ≠ [] := by
  obtain ⟨a,m⟩ := List.exists_mem_of_ne_nil _ (hf z)
  exact fun nil => hg a ((List.flatMap_eq_nil_iff.mp nil) a m)
def Asymmetric (r : Nat) (u v : Word) : Prop := ∃ a b,
    (Link r u a b ∧ ¬ Link r v a b) ∨ (Link r v a b ∧ ¬ Link r u a b)
theorem contract_common {r allow ts} (hr : 0 < r) (u v : Word) (cu : Cap r u) (cv : Cap r v)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) :
    ∃ A B : Word, ∃ h : Nat → Word, (∀ x, h x ≠ []) ∧ A.flatMap h = u ∧ B.flatMap h = v ∧
      Cap r A ∧ Cap r B ∧ (P455FullSingleton.model r allow ts).Valid A B ∧
      (∀ a b, ¬ (Link r A a b ∧ Link r B a b)) ∧
      ((P455SourceFamilies.Compressed r A ∧ P455SourceFamilies.Compressed r B) ∨ Asymmetric r A B) := by
  classical
  by_cases common : ∃ a b, Link r u a b ∧ Link r v a b
  · obtain ⟨a,b,ul,vl⟩ := common
    have hlt : (dropName b u).length < u.length := by
      have c := (link_counts cu ul).2; have l := drop_length b u; omega
    obtain ⟨A,B,h,non,hu,hv,ca,cb,hvld,last,done⟩ := contract_common hr (dropName b u) (dropName b v)
      (drop_cap b cu) (drop_cap b cv) (drop_valid _ b valid)
    have op (z) : openPair a b z ≠ [] := by by_cases e : z = a <;> simp [openPair,e]
    refine ⟨A,B,fun z => (h z).flatMap (openPair a b),nonempty_composition non op,?_,?_,ca,cb,hvld,last,done⟩
    · rw [← List.flatMap_assoc,hu,recover_link cu ul]
    · rw [← List.flatMap_assoc,hv,recover_link cv vl]
  · have no (a b : Nat) := fun both => common ⟨a,b,both⟩
    refine ⟨u,v,fun a => [a],by simp,by simp,by simp,cu,cv,valid,no,?_⟩
    by_cases all : P455SourceFamilies.Compressed r u ∧ P455SourceFamilies.Compressed r v
    · exact .inl all
    · right
      by_cases one : ∃ a b, Link r u a b
      · obtain ⟨a,b,l⟩ := one; exact ⟨a,b,.inl ⟨l,fun j => no a b ⟨l,j⟩⟩⟩
      · by_cases two : ∃ a b, Link r v a b
        · obtain ⟨a,b,l⟩ := two; exact ⟨a,b,.inr ⟨l,fun j => no a b ⟨j,l⟩⟩⟩
        · exact (all ⟨fun a b l => one ⟨a,b,l⟩,fun a b l => two ⟨a,b,l⟩⟩).elim
termination_by u.length
theorem substitute_deduction {G : Word → Word → Prop} (h : Nat → Word) (non : ∀ x, h x ≠ [])
    {A B : Word} (d : Derives G A B) : Derives G (A.flatMap h) (B.flatMap h) := by
  induction d with
  | refl => exact .refl _
  | snoc _ step ih =>
    obtain ⟨a,b,l,k,f,rule,an,bn,fn,rfl,rfl⟩ := step
    exact .snoc ih ⟨a,b,l.flatMap h,k.flatMap h,fun z => (f z).flatMap h,rule,an,bn,
      nonempty_composition fn non,by simp [List.flatMap_assoc],by simp [List.flatMap_assoc]⟩
end P455Prefix
end
section
namespace P455Alignment
open P455Witness P455Paths P455ContactReflection Problem455.Slots
def Inverted {α : Type} (u v : List α) (a b : α) := [a,b].Sublist u ∧ [b,a].Sublist v
inductive Blocks {α : Type} (mates : α → α → Prop) : List α → List α → Prop where
  | nil : Blocks mates [] []
  | fixed (x) {u v} : Blocks mates u v → Blocks mates (x::u) (x::v)
  | pair (x y) {u v} : mates x y → Blocks mates u v → Blocks mates (x::y::u) (y::x::v)
private theorem prep {α : Type} (a : α) {b : α} {w : List α} (inW : b ∈ w) :
    [a,b].Sublist (a::w) := (List.singleton_sublist.mpr inW).cons₂ a
private theorem second {α : Type} [DecidableEq α] {a b : α} {u v : List α}
    (neq : a≠b) (distinct : (a::u).Nodup) (same : (a::u).Perm (b::v))
    (M : α → α → Prop) (sym : ∀ {x y}, M x y → M y x) (unique : ∀ {x y z}, M x y → M x z → y = z)
    (cross : ∀ x y, Inverted (a::u) (b::v) x y → M x y) : ∃ t, u = b::t := by
  have bu := (List.mem_cons.mp (same.mem_iff.mpr (List.mem_cons_self : b ∈ b::v))).resolve_left (Ne.symm neq)
  have av := (List.mem_cons.mp (same.mem_iff.mp (List.mem_cons_self : a ∈ a::u))).resolve_left neq
  have ba := sym (cross _ _ ⟨prep _ bu,prep _ av⟩)
  cases u with
  | nil => contradiction
  | cons c t =>
    by_cases e : c = b
    · exact ⟨t,by rw [e]⟩
    have bt := (List.mem_cons.mp bu).resolve_left (Ne.symm e)
    have cv := (List.mem_cons.mp (same.mem_iff.mp (show c∈a::c::t by simp))).resolve_left e
    have bc := sym (cross _ _ ⟨(prep c bt).cons a,prep b cv⟩)
    have ca := unique bc ba
    exact False.elim ((List.nodup_cons.mp distinct).1 (ca ▸ List.mem_cons_self))
theorem align {α : Type} [DecidableEq α] (M : α → α → Prop)
    (sym : ∀ {x y}, M x y → M y x) (unique : ∀ {x y z}, M x y → M x z → y = z)
    (u v : List α) (distinct : u.Nodup) (same : u.Perm v)
    (cross : ∀ x y, Inverted u v x y → M x y) : Blocks M u v := by
  cases u with
  | nil => obtain rfl := same.nil_eq; exact .nil
  | cons a u =>
    cases v with
    | nil => cases same.length_eq
    | cons b v =>
      by_cases eq : a = b
      · subst b
        exact .fixed a (align M sym unique u v (List.nodup_cons.mp distinct).2
          ((List.perm_cons _).mp same) (fun x y e => cross x y ⟨e.1.cons a,e.2.cons a⟩))
      · obtain ⟨u',rfl⟩ := second eq distinct same M sym unique cross
        obtain ⟨v',rfl⟩ := second (Ne.symm eq) (same.nodup_iff.mp distinct) same.symm M sym unique
          (fun x y h => sym (cross y x ⟨h.2,h.1⟩))
        have aligned : (a::b::u').Perm (a::b::v') := same.trans (.swap _ _ _)
        have common := (List.perm_cons _).mp ((List.perm_cons _).mp aligned)
        have pair := cross a b ⟨prep _ List.mem_cons_self,prep _ List.mem_cons_self⟩
        exact .pair a b pair (align M sym unique u' v' ((List.nodup_cons.mp
          (List.nodup_cons.mp distinct).2).2) common (fun x y e =>
            cross x y ⟨(e.1.cons b).cons a,(e.2.cons a).cons b⟩))
termination_by u.length
end P455Alignment
end
section
namespace P455CellClass
open P455RectangleRank P455FirstRewrite P455Witness P455Structural Problem455.Slots
abbrev W := List Nat
def samePair (x y i : Nat) : Prop :=
  (x = owner i ∧ y = mate i) ∨ (x = mate i ∧ y = owner i)
private theorem roles (x : Nat) : x = owner (x/2) ∨ x = mate (x/2) := by
  unfold owner mate; omega
theorem private_closed {t i} (ix : i < t) (middle tail : W) (bit : Nat → Bool) :
    Closed (word t middle tail bit) (owner i) (mate i) := by
  let lower := (List.range i).flatMap privateCell
  let higher := ((List.range (t-(i+1))).map (fun x => i+1+x)).flatMap privateCell
  have eq : List.range t = (List.range i ++ [i]) ++
      (List.range (t-(i+1))).map (fun x => i+1+x) := by
    conv => lhs; arg 1; rw [show t = (i+1)+(t-(i+1)) by omega]
    rw [List.range_add,List.range_succ]
  have pre (x : Nat) (inside : x = owner i ∨ x = mate i) : x ∉ lower := by
    intro m
    obtain ⟨j,mj,h⟩ := List.mem_flatMap.mp m
    have lt := List.mem_range.mp mj
    have rr : x = owner j ∨ x = mate j := by simpa [privateCell,or_assoc,or_left_comm,or_comm] using h
    unfold owner mate at *; omega
  refine ⟨by simp [owner,mate],lower,higher ++ middle ++ (List.range t).flatMap (mutableCell bit) ++ tail,?_,
    pre _ (.inl rfl),pre _ (.inr rfl)⟩
  unfold word
  conv => lhs; arg 1; arg 1; arg 1; rw [eq]
  simp [lower,higher,early,privateCell,List.append_assoc,List.flatMap_append]
theorem only_cell {r allow ts t middle tail V} (small : ∀ x ∈ middle ++ tail, x < 2*t)
    (cap : P455Quotient.Cap r (word t middle tail (constant false)))
    (ident : (P455FullSingleton.model r allow ts).Valid (word t middle tail (constant false)) V)
    {x y} (ne : x ≠ y)
    (diff : select [x,y] (word t middle tail (constant false)) ≠ select [x,y] V) :
    ∃ i < t, samePair x y i := by
  let U := word t middle tail (constant false)
  obtain ⟨a,b,tag,bit,order,len,allowT,src,_⟩ := P455CellClassBinary.changed cap ident ne diff
  have edge : Edge U r allow x y := by
    rcases order with ⟨rfl,rfl⟩|⟨rfl,rfl⟩
    · exact .inl ⟨tag,ne,len,allowT,bit,src⟩
    · exact .inr ⟨tag,Ne.symm ne,len,allowT,bit,(select_pair_symm _ _ _).trans src⟩
  have xproj : x ∈ select [x,y] (word t middle tail (constant false)) := by
    rw [src]; rcases order with ⟨rfl,rfl⟩|⟨rfl,rfl⟩ <;> simp [profile,profilePrefix]
  have xlt := word_names _ small x (List.mem_filter.mp xproj).1
  have lt : x/2 < t := by omega
  have xc := roles x
  have yc : y = owner (x/2) ∨ y = mate (x/2) := by
    apply Classical.byContradiction; intro bad
    exact (no_external_record (private_closed lt middle tail _) xc
      ⟨fun h => bad (.inl h),fun h => bad (.inr h)⟩) edge
  exact ⟨x/2,lt,by unfold samePair; omega⟩
private theorem mutable_own (cells : List Nat) (nd : cells.Nodup) (bit : Nat → Bool) (i : Nat) :
    select [owner i,mate i] (cells.flatMap (mutableCell bit)) =
      (if i ∈ cells then mutableCell bit i else []) := by
  induction cells with
  | nil => simp [select]
  | cons j cells ih =>
    rw [List.flatMap_cons,select_append,ih (List.nodup_cons.mp nd).2]
    by_cases eq : i = j
    · subst j
      have fresh := (List.nodup_cons.mp nd).1
      cases b : bit i <;> simp [mutableCell,b,fresh,select]
    · have no : select [owner i,mate i] (mutableCell bit j) = [] := by
        apply select_nil
        intro z m
        have either : z = owner j ∨ z = mate j := by
          cases b : bit j <;> simpa [mutableCell,b,or_comm] using m
        simp only [List.mem_cons,List.not_mem_nil,or_false]
        unfold owner mate at *; omega
      simp [no,eq]
private def stem (t : Nat) (middle : W) :=
  (List.range t).flatMap privateCell ++ middle
private theorem own {t i} (ix : i < t) (middle tail : W) (bit : Nat → Bool)
    (finalPair : select [owner i,mate i] tail = [owner i,mate i]) :
    select [owner i,mate i] (word t middle tail bit) =
      select [owner i,mate i] (stem t middle) ++
        (mutableCell bit i ++ [owner i,mate i]) := by
  unfold word stem
  rw [select_append,select_append,mutable_own _ List.nodup_range,if_pos (List.mem_range.mpr ix),finalPair,
    List.append_assoc]
private theorem kept_other (x y i : Nat) (outside : ¬ samePair x y i) (bit : Nat → Bool) :
    select [x,y] (mutableCell bit i) = select [x,y] (mutableCell (constant false) i) := by
  by_cases b : bit i
  · have emptySide : (∀ a ∈ [owner i], a ∉ [x,y]) ∨ (∀ a ∈ [mate i], a ∉ [x,y]) := by
      simp only [List.mem_singleton,List.mem_cons,List.not_mem_nil,or_false,forall_eq]
      unfold samePair owner mate at *; omega
    have sw := selected_swap [x,y] [] [owner i] [mate i] [] emptySide
    simpa [mutableCell,constant,b] using sw.symm
  · simp [mutableCell,constant,b]
private theorem other {t x y} (middle tail : W) (bit : Nat → Bool)
    (none : ∀ i < t, ¬samePair x y i) :
    select [x,y] (word t middle tail bit) = select [x,y] (word t middle tail (constant false)) := by
  have go (cells : List Nat) (all : ∀ i ∈ cells, ¬ samePair x y i) :
      select [x,y] (cells.flatMap (mutableCell bit)) =
        select [x,y] (cells.flatMap (mutableCell (constant false))) := by
    induction cells with
    | nil => rfl
    | cons i cells ih =>
      simp only [List.flatMap_cons, select_append]
      rw [kept_other x y i (all i List.mem_cons_self) bit,
        ih (fun j hj => all j (List.mem_cons_of_mem _ hj))]
  unfold word
  simp only [select_append,go _ (fun i m => none i (List.mem_range.mp m))]
private theorem reverse_names (w : W) (x y : Nat) : select [x,y] w = select [y,x] w := by
  exact select_pair_symm _ _ _
private theorem mono (w : W) (x : Nat) : select [x,x] w = List.replicate (w.count x) x := by
  induction w with
  | nil => simp [select]
  | cons z w ih => by_cases eq : z = x <;> simp_all [select,List.count_cons,List.replicate_succ]
theorem represent {r allow ts t middle tail V} (small : ∀ x ∈ middle ++ tail, x < 2*t)
    (cap : P455Quotient.Cap r (word t middle tail (constant false)))
    (finalPair : ∀ i < t, select [owner i,mate i] tail = [owner i,mate i])
    (valid : (P455FullSingleton.model r allow ts).Valid (word t middle tail (constant false)) V) :
    ∃ bit, V = word t middle tail bit := by
  classical
  let U := word t middle tail (constant false)
  let bit := fun i => decide (select [owner i,mate i] U ≠ select [owner i,mate i] V)
  have sameCell (i : Nat) (ix : i < t) :
      select [owner i,mate i] V = select [owner i,mate i] (word t middle tail bit) := by
    let x := owner i
    let y := mate i
    let K := select [x,y] (stem t middle)
    have ne : x ≠ y := by simp [x,y,owner,mate]
    have source : select [x,y] U = K ++ [x,y,x,y] := by
      simpa [K,U,x,y,mutableCell,constant] using own ix middle tail (constant false) (finalPair i ix)
    by_cases eq : select [x,y] U = select [x,y] V
    · have hb : bit i = false := by
        change decide (select [x,y] U ≠ select [x,y] V) = false
        simp [eq]
      rw [own ix middle tail bit (finalPair i ix)]
      exact eq.symm.trans (by simpa [mutableCell,hb] using source)
    · have hb : bit i = true := by exact decide_eq_true eq
      obtain ⟨a,b,tag,c,order,_,_,orig,comp⟩ := P455CellClassBinary.changed cap valid ne eq
      have e : K ++ [x,y,x,y] = profilePrefix a b tag ++ (pair a b c ++ [a,b]) :=
        source.symm.trans orig
      have len := congrArg List.length e
      have kl : K.length = (profilePrefix a b tag).length := by
        cases c <;> simp only [pair,if_true,if_false,List.length_append,List.length_cons,
          List.length_nil,Bool.false_eq_true] at len <;> omega
      obtain ⟨ke,rest⟩ := List.append_inj e kl
      have ab : a = x ∧ b = y ∧ c = false := by
        cases c <;> simp [pair] at rest ⊢ <;> omega
      obtain ⟨rfl,rfl,rfl⟩ := ab
      rw [own ix middle tail bit (finalPair i ix)]
      simpa [profile,pair,mutableCell,hb,K,x,y] using comp.trans (by
        change profile x y tag true = K ++ [y,x,x,y]
        rw [ke]; rfl)
  refine ⟨bit,P455BlockSeparators.pair_ext (fun x y => ?_)⟩
  by_cases used : ∃ i < t, samePair x y i
  · obtain ⟨i,ix,⟨rfl,rfl⟩|⟨rfl,rfl⟩⟩ := used
    · exact sameCell i ix
    · exact (reverse_names _ _ _).trans ((sameCell i ix).trans (reverse_names _ _ _))
  · have notUsed : ∀ i < t, ¬ samePair x y i := fun i ix yes => used ⟨i,ix,yes⟩
    rw [other middle tail bit notUsed]
    by_cases eq : x = y
    · subst y; rw [mono,mono,P455CellClassBinary.exact_counts cap valid x]
    · apply Classical.byContradiction; intro diff
      exact used (only_cell small cap valid eq (Ne.symm diff))
theorem canonical_final (t i : Nat) (ix : i < t) :
    select [owner i,mate i] ((List.range t).flatMap (mutableCell (constant false))) = [owner i,mate i] := by
  rw [mutable_own _ List.nodup_range,if_pos (List.mem_range.mpr ix)]; rfl
theorem bit_change {t i : Nat} (ix : i < t) (middle tail : W) (bit : Nat → Bool)
    (yes : bit i = true) (finalPair : select [owner i,mate i] tail=[owner i,mate i]) :
    select [owner i,mate i] (word t middle tail bit) ≠
      select [owner i,mate i] (word t middle tail (constant false)) := by
  rw [own ix middle tail bit finalPair,own ix middle tail (constant false) finalPair]
  simp [mutableCell,constant,yes,owner,mate]
theorem read_bit {t i : Nat} (ix : i < t) (middle tail : W) (bit : Nat → Bool)
    (endPair : select [owner i,mate i] tail=[owner i,mate i]) (tag : Tag)
    (record : typed (word t middle tail bit) (owner i) (mate i) tag) :
    select [owner i,mate i] (word t middle tail bit) = profile (owner i) (mate i) tag (bit i) := by
  obtain ⟨value,eq⟩ := record
  have ne : owner i ≠ mate i := by simp [owner,mate]
  have parts := (own ix middle tail bit endPair).symm.trans eq
  unfold profile at parts
  have len := congrArg List.length parts
  have ends := List.append_inj_right parts (by
    cases bi : bit i <;> cases value <;> simp [mutableCell,bi,pair] at len <;> omega)
  have matchBit : value = bit i := by
    cases bi : bit i <;> cases value <;> simp_all [mutableCell,pair]
  exact matchBit ▸ eq
end P455CellClass
end
section
namespace P455ChartSchedule
open P455Witness P455FirstRewrite P455GraphReduction P455GridAssembly P455GridRows
open P455SourceFamilies P455SlotSaturation P455Schedule P455Uncrossed P455CrossedSupport
open P455ReductionBoundary P455WordChart P455ActualGuards Problem455.Slots
abbrev W := List Nat
def switch (s : Bits) (i : Nat) : Bits := fun j => if j = i then !s j else s j
def Off (C : List Nat) (A s : Bits) := ∀ j, j ∉ C → s j = A j
structure Literal (r : Nat) (allow : Tag → Prop) (u v : W) (n : Node) where
  f : P455Closure.Frame Nat
  bit : Bool
  l : W
  k : W
  owner : f.p=[n.owner]
  mate : f.q=[n.mate]
  shape : f.Valid r allow noMark
  source : u = side f l k bit
  target : v = side f l k (!bit)
theorem Literal.step {r allow u v n} (g : Literal r allow u v n) (cp : P455Closure.Cap r u) :
    P455Closure.Move r allow noMark u v := ⟨g.f,g.bit,g.l,g.k,g.shape,g.source,g.target,cp⟩
theorem walk_cap {r allow u v} (h : P455WordChart.Walk r allow u v) (cap : P455Closure.Cap r u) :
    P455Closure.Cap r v := h.transport cap (fun mv _ => mv.cap_right)
private theorem walk_compressed {r allow u v} (h : P455WordChart.Walk r allow u v) (cmp : Compressed r u) :
    Compressed r v := h.transport cmp (fun mv old a b link => old a b ((Problem455BlockBridge.move_link mv a b).mpr link))
structure Geometry (r : Nat) (allow : Tag → Prop) (C : List Nat) (A : Bits)
    (word : Bits → W) (nodes : Nat → Node) : Prop where
  cover : ∀ n, Holds r allow noMark (word A) (typedNode n) → ∃ j, nodes j = n
  active : ∀ i ∈ C, Holds r allow noMark (word A) (typedNode (nodes i))
  value : ∀ s, Off C A s → Read s nodes r allow (word s)
  flip : ∀ s, Off C A s → ∀ i ∈ C,
    Nonempty (Literal r allow (word s) (word (switch s i)) (nodes i))
private theorem off_switch {A s C i} (off : Off C A s) (mem : i ∈ C) : Off C A (switch s i) := by
  intro j nj
  have ne : j≠i := fun e => nj (e ▸ mem)
  simpa [switch,ne] using off j nj
theorem reach {r allow C A word nodes} (g : Geometry r allow C A word nodes) (B : Bits)
    (offB : Off C A B) (cp : P455Closure.Cap r (word A)) : P455WordChart.Walk r allow (word A) (word B) := by
  have fill (xs : List Nat) (sub : ∀ i∈xs, i∈C) : ∃ s, Off C A s ∧
      P455WordChart.Walk r allow (word A) (word s) ∧ ∀ i∈xs, s i = B i := by
    induction xs with
    | nil => exact ⟨A,fun _ _ => rfl,.refl _,by simp⟩
    | cons i xs ih =>
      obtain ⟨s,off,path,eq⟩ := ih (fun j mem => sub j (List.mem_cons_of_mem i mem))
      by_cases done : s i = B i
      · exact ⟨s,off,path,fun j mem => (List.mem_cons.mp mem).elim (fun ji => ji ▸ done) (eq j)⟩
      have ci := sub i List.mem_cons_self
      obtain ⟨f⟩ := g.flip s off i ci
      refine ⟨switch s i,off_switch off ci,.snoc path (f.step (walk_cap path cp)),?_⟩
      intro j mem
      by_cases ji : j = i
      · subst j; cases h : s i <;> cases z : B i <;> simp_all [switch]
      · simpa [switch,ji] using eq j ((List.mem_cons.mp mem).resolve_left ji)
  obtain ⟨s,off,path,hit⟩ := fill C (fun _ h => h)
  have eq : s = B := funext fun i => by
    by_cases hi : i∈C
    · exact hit i hi
    · exact (off i hi).trans (offB i hi).symm
  exact eq ▸ path
theorem normalize_layout {r allow ts C A B word nodes} (law : Laws ts)
    (g : Geometry r allow C A word nodes) (offB : Off C A B)
    (different : ∀ i∈C, A i≠B i)
    (cap : P455Closure.Cap r (word A)) (cmp : Compressed r (word A))
    (valid : (P455FullSingleton.model r allow ts).Valid (word A) (word B)) :
    Derives (fun u v => (P455FullSingleton.model r allow ts).Valid u v ∧ rank u v ≤ P455MarkedRank.bound r)
      (word A) (word B) ∨ Nonempty (Rectangle allow ts) := by
  classical
  let E := WordEdge r allow noMark (word A) ts nodes
  have allA : Off C A A := fun _ _ => rfl
  have AB := reach g B offB cap
  have diff (i : Nat) (hi : i∈C) : Changed (word A) (word B) (nodes i) := by
    have typed := g.active i hi
    have left := g.value A allA i typed
    have right := g.value B offB i ((walk_query AB _).mp typed)
    intro eq
    have cross := left.symm.trans (eq.trans right)
    have distinct := different i hi
    cases x : A i <;> cases y : B i <;> simp_all [profile,pair,typed.1,Ne.symm typed.1]
  have funct (i : Nat) (mem : i∈C) : Functional r allow noMark (word A) ts (nodes i) :=
    P455PortUnique.functional cap (P455FullSingleton.guard_valid valid) (diff i mem)
      (.refl _) cmp _ (.inl ⟨rfl,rfl⟩) (g.active i mem)
  by_cases loop : ∃ a, Path (induced C E) a a
  · obtain ⟨a,p⟩ := loop
    exact .inr (rectangle_of_cycle law nodes C funct p)
  have goodA : Good C E A := good_of_identity nodes C cap valid (.refl _) (g.value _ allA) diff
  have goodB : Good C E B := good_of_identity nodes C (walk_cap AB cap) (fun f => (valid f).symm) AB
    (g.value _ offB) (fun i h eq => diff i h eq.symm)
  have fixed (a : Nat) (ne : A a≠B a) : a∈C := by
    apply Classical.byContradiction; intro out; exact ne (offB a out).symm
  have sched := schedule (C := C) (E := E) (fun a p => loop ⟨a,p⟩) A B goodA goodB fixed
  have steps (s : Bits) (path : P455Quotient.Walk (Toward C E B) A s) : Off C A s ∧
      Derives (fun u v => (P455FullSingleton.model r allow ts).Valid u v ∧ rank u v ≤ P455MarkedRank.bound r)
        (word A) (word s) := by
    induction path with
    | refl => exact ⟨allA,.refl _⟩
    | @snoc s t _ flip ih =>
      obtain ⟨gs,gt,i,mem,_,ne,others⟩ := flip
      have alt : t = switch s i := funext fun j => by
        by_cases ji : j = i
        · subst j; cases x : s i <;> cases y : t i <;> simp_all [switch]
        · simpa [switch,ji] using (others j ji).symm
      have ot : Off C A t := alt ▸ off_switch ih.1 mem
      have ps := reach g s ih.1 cap
      have pt := reach g t ot cap
      obtain ⟨f⟩ := g.flip s ih.1 i mem
      obtain ⟨f0⟩ := g.flip A allA i mem
      have tgt : word t = side f.f f.l f.k (!f.bit) := alt ▸ f.target
      have cs := walk_cap ps cap
      have ct := walk_cap pt cap
      have pair0 : P455Closure.Cap r (side f.f f.l f.k false) := by
        cases b : f.bit
        · simpa only [f.source,b] using cs
        · simpa only [tgt,b,Bool.not_true] using ct
      have noS := feasible nodes C s ps (g.value s ih.1) g.cover gs mem (g.active i mem)
      have noT := feasible nodes C t pt (g.value t ot) g.cover gt mem (g.active i mem)
      have localok (b : Bool) : ¬EdgeViolation r allow ts (side f.f f.l f.k b)
          (nodes i).owner (nodes i).mate := by
        rw [f.source] at noS; rw [tgt] at noT
        cases fb : f.bit <;> cases b <;> simp_all
      let layout : P455ReductionBoundary.Layout r allow ts (word A) (word B) (word s) (word t) :=
        ⟨(nodes i).owner,(nodes i).mate,f.f,f.l,f.k,f.bit,f.owner,f.mate,f.shape,pair0,
          ⟨f0.f,f0.bit,f0.l,f0.k,f0.owner,f0.mate,f0.shape,f0.source⟩,diff i mem,
          f.source ▸ ps,f.source ▸ walk_compressed ps cmp,localok,f.source,tgt⟩
      exact ⟨ot,.snoc ih.2 (layout.step cap valid)⟩
  exact .inl (steps B sched).2
end P455ChartSchedule
end
section
namespace P455Enum
open P455Witness P455Paths P455PaddedTiles P455CatalogueBounds P455GuardProduct Problem455.Slots
def choices (ts : List Tag) : List ContactChoice :=
  ts.flatMap (fun t => bools.list.map (.record t)) ++ (fins 5).list.flatMap (fun p=>bools.list.map (.port p))
def steps (w : List Nat) (ts : List Tag) : List Step :=
  w.flatMap fun b => (choices ts).map (Prod.mk b)
theorem occMem {w o i a} (h : occupies w o i a) : a∈w := by
  obtain ⟨j,pat⟩ := h
  exact Problem455.Slots.stamped_mem_label _ _ (a,j) (pat.subset (by simp))
theorem step_mem {r w mark a b c} (M : MachineTable n) (h : Holds r (allowed M) mark w (contact r a b c)) :
    (b,c)∈steps w (tags M) := by
  have cell := P455ContactGeometry.contact_slot h
  obtain ⟨_,_,occ⟩ := cell
  apply List.mem_flatMap.mpr
  refine ⟨b,occMem occ,List.mem_map.mpr ⟨c,?_,rfl⟩⟩
  unfold choices
  cases c with
  | port p v => exact List.mem_append_right _ (List.mem_flatMap.mpr ⟨p,(fins 5).mem _,List.mem_map_of_mem (bools.mem v)⟩)
  | record t v =>
    have allow : allowed M t := by cases v <;> exact h.2.2.1
    exact List.mem_append_left _ (List.mem_flatMap.mpr ⟨t,mem_tags.mpr allow,List.mem_map_of_mem (bools.mem v)⟩)
theorem walk_steps {r w mark start} (M : MachineTable n) (p : List Step)
    (walk : Walk r (allowed M) mark w start p) : ∀ e∈p,e∈steps w (tags M) := by
  induction p generalizing start with
  | nil => simp
  | cons e es ih =>
    rcases e with ⟨b,c⟩
    intro z mz
    exact (List.mem_cons.mp mz).elim (fun eq=>eq ▸ step_mem M walk.1) (ih walk.2 z)
def defects (w : List Nat) :=
  w.map SlotDefect.deficient ++ (Problem455Finite.wordsUpTo w 5).map SlotDefect.overflow
theorem defect_mem {r allow mark w o i} (d : SlotDefect) (valid : Holds r allow mark w (terminalSlot r o i d)) :
    d∈defects w := by
  cases d with
  | deficient a => exact List.mem_append_left _ (List.mem_map_of_mem (occMem valid.1.2))
  | overflow xs =>
    have pos (a) (m : a∈xs) : w.count a = r ∧ slotStart i ∧ occupies w o i a :=
      (allQ_iff _).mp valid.2.2.1 _ (List.mem_map_of_mem m)
    exact List.mem_append_right _ (List.mem_map_of_mem (Problem455Finite.covered _ _ xs
      (Nat.le_of_eq valid.1) (fun a m => occMem (pos a m).2.2)))
def slots (w : List Nat) (ts : List Tag) : List SlotCertificate :=
  (pool w ts).flatMap fun a=>bools.list.flatMap fun b=>bools.list.flatMap fun role=>
    (Problem455Finite.wordsUpTo (steps w ts) 6).flatMap fun p=>(List.range 12).flatMap fun i=>
      (defects w).map fun d=>⟨a,b,role,p,i,d⟩
theorem slot_mem {r mark w} (M : MachineTable n) (s : SlotCertificate) (h : Holds r (allowed M) mark w (s.query r)) :
    s∈slots w (tags M) := by
  obtain ⟨len,walk,term⟩ := slot_route s h
  have a := record_in_pool (tags M) (fun _ h=>mem_tags.mpr h) _ (marked_typed h.1)
  have i := P455SourceFamilies.valid_slot _ term
  have ilt : s.terminalIndex <12 := by unfold slotStart at i; omega
  have pp := Problem455Finite.covered _ _ _ len (walk_steps M _ walk)
  simp only [slots,List.mem_flatMap,List.mem_map]
  exact ⟨_,a,_,bools.mem _,_,bools.mem _,_,pp,_,List.mem_range.mpr ilt,_,defect_mem _ term,rfl⟩
def directions : Cover Dir := ⟨[.right,.left,.down,.up],fun d=>by cases d <;> simp⟩
def functionalities (w : List Nat) (ts : List Tag) : List FunctionalityCertificate :=
  let nodes:=pool w ts
  nodes.flatMap fun a=>bools.list.flatMap fun bit=>nodes.flatMap fun b=>nodes.flatMap fun c=>
    directions.list.flatMap fun d=>bools.list.map fun role=>⟨a,bit,b,c,d,role⟩
theorem func_mem {r mark w} (M : MachineTable n) (f : FunctionalityCertificate)
    (ok : Holds r (allowed M) mark w (f.query (system n))) : f∈functionalities w (tags M) := by
  obtain ⟨a,b,c⟩ := bounded_functionality (tags M) (fun _ h=>mem_tags.mpr h) _ ok
  simp only [functionalities,List.mem_flatMap,List.mem_map]
  exact ⟨_,a,_,bools.mem _,_,b,_,c,_,directions.mem _,_,bools.mem _,rfl⟩
def guards (w : List Nat) (ts : List Tag) : List Guard :=
  (slots w ts).map .slot ++ (functionalities w ts).map .func
instance pairD (a b : Nat) : DecidableRel (P455SlotProduct.pairMark a b) := by
  intro x y; unfold P455SlotProduct.pairMark; infer_instance
def guardOK {r} (hr : 0 < r) (M : MachineTable n) (w : List Nat) (kind : Bool) (a b : Nat) :
    Decidable (∃ g : Guard, g.isFunc = kind ∧ g.anchor.owner = a ∧ g.anchor.mate = b ∧
      Holds r (allowed M) (P455SlotProduct.pairMark a b) w (g.query r (system n))) := by
  refine @search _ (guards w (tags M)) _ ?_ ?_
  · intro g
    letI := holdsD hr (allowed M) (P455SlotProduct.pairMark a b) w (g.query r (system n))
      (by cases g with | slot s => exact statSlot r s | func f => exact statFunc n f)
    infer_instance
  · intro g h
    cases g with
    | slot s => exact List.mem_append_left _ (List.mem_map_of_mem (slot_mem M s h.2.2.2))
    | func f => exact List.mem_append_right _ (List.mem_map_of_mem (func_mem M f h.2.2.2))
def sigmaCover (s : Cover α) (b : α → Type) (t : (i : α) → Cover (b i)) : Cover (Sigma b) :=
  ⟨s.list.flatMap (fun i => (t i).list.map (Sigma.mk i)),fun ⟨i,v⟩ =>
    List.mem_flatMap.mpr ⟨i,s.mem _,List.mem_map_of_mem ((t i).mem v)⟩⟩
abbrev GuardKey (r : Nat) := (k : Bool) × (Fin (words r k).length × Fin (width k) × Fin (width k))
def guard {r} (hr : 0 < r) (M : MachineTable n) : Cover (Index r (allowed M) (system n)) :=
  let p (key : GuardKey r) := let w:=(words r key.1).get key.2.1
    P455Closure.Cap r w ∧ ∃g : Guard, g.isFunc = key.1 ∧ g.anchor.owner = key.2.2.1.val ∧ g.anchor.mate = key.2.2.2.val ∧
      Holds r (allowed M) (P455SlotProduct.pairMark key.2.2.1 key.2.2.2) w (g.query r (system n))
  letI : DecidablePred p := fun key => by
    let w:=(words r key.1).get key.2.1
    letI := capD r w; letI := guardOK hr M w key.1 key.2.2.1 key.2.2.2
    unfold p; dsimp only; infer_instance
  let keys : Cover (GuardKey r) := sigmaCover bools _ (fun k => pairCover (fins _) (pairCover (fins _) (fins (width k))))
  (coverSub keys p).map (fun c=>⟨c.val.1,c.val.2.1,c.val.2.2.1,c.val.2.2.2,c.property.1,c.property.2⟩)
    (fun ⟨k,i,a,b,cp,ok⟩=>⟨⟨⟨k,i,a,b⟩,cp,ok⟩,rfl⟩)
end P455Enum
end
section
namespace P455FiniteBasis
open P455FirstRewrite P455FiniteModel
abbrev W := List Nat
def Limited (k : Nat) (w : W) := ∀ x∈w, x < k
def Basis {S : Type} (M : Model S) (rules : List (W × W)) :=
  (∀ u v, (u,v)∈rules → u≠[] ∧ v≠[] ∧ M.Valid u v) ∧
  ∀ u v, u≠[] → v≠[] → M.Valid u v → Derives (fun u v => (u,v)∈rules) u v
private theorem agree {S : Type} (M : Model S) (w : W) (f g : Nat → S)
    (h : ∀ x∈w, f x = g x) : M.eval f w = M.eval g w := by
  induction w with
  | nil => rfl
  | cons a w ih => simp only [Model.eval,h a List.mem_cons_self,ih (fun x m => h x (List.mem_cons_of_mem a m))]
def table {S : Type} (M : Model S) (k : Nat) (w : W) (v : Fin k → S) :=
  M.eval (fun x => if h : x < k then v ⟨x,h⟩ else M.unit) w
private theorem table_valid {S : Type} (M : Model S) {k u v}
    (lu : Limited k u) (lv : Limited k v) (eq : table M k u = table M k v) : M.Valid u v := by
  intro f
  let g (i : Fin k) := f i.val
  have read (w : W) (l : Limited k w) : table M k w g = M.eval f w :=
    agree _ _ _ _ (fun x m => by simp [l x m,g])
  exact (read u lu).symm.trans ((congrFun eq g).trans (read v lv))
private theorem representatives {S : Type} (M : Model S) (finite : Covered S) (k : Nat) :
    ∃ xs : List W, (∀ z∈xs, z≠[] ∧ Limited k z) ∧
      ∀ w, w≠[] → Limited k w → ∃ z∈xs, M.Valid w z := by
  classical
  have vals : Covered (Fin k → S) := pi (fin k) (fun _ => finite) (fun _ => M.unit)
  obtain ⟨ts,cover⟩ := pi vals (fun _ => finite) (fun _ => M.unit)
  let realized (t : (Fin k → S) → S) := ∃ w : W, w≠[] ∧ Limited k w ∧ table M k w = t
  let pick (t : (Fin k → S) → S) := if h : realized t then [Classical.choose h] else []
  refine ⟨ts.flatMap pick,?_,?_⟩
  · intro z m
    obtain ⟨t,_,hit⟩ := List.mem_flatMap.mp m
    by_cases h : realized t
    · obtain rfl : z = Classical.choose h := by simpa [pick,h] using hit
      exact ⟨(Classical.choose_spec h).1,(Classical.choose_spec h).2.1⟩
    · simp [pick,h] at hit
  · intro w ne lim
    let t := table M k w
    have h : realized t := ⟨w,ne,lim,rfl⟩
    obtain ⟨_,lz,ez⟩ := Classical.choose_spec h
    exact ⟨Classical.choose h,List.mem_flatMap.mpr ⟨t,cover t,by simp [pick,h]⟩,
      table_valid M lim lz ez.symm⟩
private theorem use_rule {rules : List (W×W)} {u v : W} (m : (u,v)∈rules) (a : u≠[]) (b : v≠[]) :
    Step (fun p q => (p,q)∈rules) u v :=
  ⟨u,v,[],[],fun i => [i],.inl m,a,b,by simp,by simp,by simp⟩
theorem finite_fragment {S : Type} (M : Model S) (finite : Covered S) (k : Nat) :
    ∃ rules : List (W×W), (∀ u v, (u,v)∈rules → u≠[] ∧ v≠[] ∧ M.Valid u v) ∧
      ∀ u v, u≠[] → v≠[] → Limited k u → Limited k v → M.Valid u v →
        Derives (fun a b => (a,b)∈rules) u v := by
  classical
  obtain ⟨reps,formed,rep⟩ := representatives M finite k
  let left := (List.range k).flatMap (fun x => ([]::reps).map (List.cons x))
  let raw := left.flatMap (fun w => reps.map (fun z => (w,z)))
  let rules := raw.filter (fun p => decide (p.1≠[] ∧ p.2≠[] ∧ M.Valid p.1 p.2))
  have ready (x : Nat) (lt : x < k) (q z : W) (part : q∈[]::reps) (inR : z∈reps)
      (idn : M.Valid (x::q) z) : Step (fun a b => (a,b)∈rules) (x::q) z := by
    have ne := (formed _ inR).1
    apply use_rule _ (by simp) ne
    apply List.mem_filter.mpr
    refine ⟨List.mem_flatMap.mpr ⟨x::q,?_,List.mem_map.mpr ⟨z,inR,rfl⟩⟩,?_⟩
    · exact List.mem_flatMap.mpr ⟨x,List.mem_range.mpr lt,List.mem_map_of_mem part⟩
    · simpa using And.intro ne idn
  have norm (w : W) (ne : w≠[]) (lim : Limited k w) : ∀ z∈reps, M.Valid w z →
      Derives (fun a b => (a,b)∈rules) w z := by
    induction w with
    | nil => contradiction
    | cons x xs ih =>
      intro z inR idn
      have lt := lim _ List.mem_cons_self
      by_cases empty : xs=[]
      · subst xs; exact .snoc (.refl _) (ready _ lt [] z List.mem_cons_self inR idn)
      have tail : Limited k xs := fun j m => lim j (List.mem_cons_of_mem x m)
      obtain ⟨q,m,valid⟩ := rep xs empty tail
      have chain := P455Prefix.context_derives [x] [] (ih empty tail q m valid)
      have last : M.Valid (x::q) z := fun f =>
        (congrArg (M.op (f x)) (valid f).symm).trans (idn f)
      exact .snoc (by simpa using chain) (ready _ lt q z (List.mem_cons_of_mem _ m) inR last)
  refine ⟨rules,fun u v m => (of_decide_eq_true (List.mem_filter.mp m).2),?_⟩
  intro u v un vn lu lv idn
  obtain ⟨z,zr,correct⟩ := rep u un lu
  have U := norm u un lu z zr correct
  have V := norm v vn lv z zr (fun f => (idn f).symm.trans (correct f))
  exact U.trans (V.symm (fun step => P455ReductionBoundary.sym_step step))
private theorem map_eval {S : Type} (M : Model S) (d : Nat → Nat) (w : W) (f : Nat → S) :
    M.eval f (w.map d) = M.eval (fun a => f (d a)) w := by
  induction w with
  | nil => rfl
  | cons a w ih => simp [Model.eval,ih]
theorem finite_rank {S : Type} (M : Model S) (finite : Covered S) (k : Nat) :
    ∃ rules : List (W×W), (∀ u v, (u,v)∈rules → u≠[] ∧ v≠[] ∧ M.Valid u v) ∧
      ∀ u v, u≠[] → v≠[] → rank u v ≤ k → M.Valid u v →
        Derives (fun a b => (a,b)∈rules) u v := by
  obtain ⟨rules,ok,proof⟩ := finite_fragment M finite k
  refine ⟨rules,ok,?_⟩
  intro u v un vn rk idn
  let keep := names (u++v)
  have ku : ∀ x∈u, x∈keep := fun x h => by simp [keep,h]
  have kv : ∀ x∈v, x∈keep := fun x h => by simp [keep,h]
  have lim (w : W) (sur : ∀ x∈w,x∈keep) : Limited k (w.map keep.idxOf) := by
    intro z mz; obtain ⟨x,m,rfl⟩ := List.mem_map.mp mz
    exact Nat.lt_of_lt_of_le (List.idxOf_lt_length_of_mem (sur x m)) rk
  have small := proof (u.map keep.idxOf) (v.map keep.idxOf) (by simpa using un) (by simpa using vn)
    (lim u ku) (lim v kv) (fun f => (map_eval M _ _ _).trans ((idn _).trans (map_eval M _ _ _).symm))
  let sub (i : Nat) := [P455DefectRename.decode keep i]
  have restored := P455Prefix.substitute_deduction sub (by simp [sub]) small
  have flat (w : W) : w.flatMap sub = w.map (P455DefectRename.decode keep) := by
    induction w with
    | nil => rfl
    | cons x w ih => simp [List.flatMap_cons,sub] at *; exact ih
  simpa only [flat,P455DefectRename.decode_map ku,P455DefectRename.decode_map kv] using restored
theorem finite_of_uniform {S : Type} (M : Model S) (finite : Covered S) (k : Nat)
    (uniform : ∀ u v, u≠[] → v≠[] → M.Valid u v →
      Derives (fun a b => M.Valid a b ∧ rank a b ≤ k) u v) : ∃ rules, Basis M rules := by
  obtain ⟨rules,ok,all⟩ := finite_rank M finite k
  refine ⟨rules,ok,?_⟩
  intro u v un vn idn
  have path := uniform u v un vn idn
  induction path with
  | refl => exact .refl _
  | @snoc v w prev step ih =>
    obtain ⟨a,b,l,t,h,rule,an,bn,non,rfl,rfl⟩ := step
    have rule' : M.Valid a b ∧ rank a b ≤ k := by
      rcases rule with fw|rev
      · exact fw
      · exact ⟨fun f => (rev.1 f).symm,(rank_swap b a).symm ▸ rev.2⟩
    have localProof := all a b an bn rule'.2 rule'.1
    have localStep := P455Prefix.context_derives l t (P455Prefix.substitute_deduction h non localProof)
    have prior := M.derives_sound (fun a b (r : M.Valid a b ∧ rank a b ≤ k) => r.1) prev
    have startN : l++a.flatMap h++t≠[] := by
      intro e
      have flat : a.flatMap h=[] := by simpa using (List.append_eq_nil_iff.mp (List.append_eq_nil_iff.mp e).1).2
      obtain ⟨x,hx⟩ := List.exists_mem_of_ne_nil _ an
      exact non x ((List.flatMap_eq_nil_iff.mp flat) x hx)
    exact (ih startN prior).trans localStep
end P455FiniteBasis
end
section
namespace P455Prefix
open P455FirstRewrite P455Quotient P455Witness P455BlockSeparators
open Problem455.Slots
open Problem455Swap (Link)
open P455DefectProjection (select_count select_cap)
theorem next_after_link {r a b : Nat} {w t : Word} (cap : Cap r w)
    (link : Link r w a b) (m : t ∈ rows a w) : t.tail.head? = some b := by
  rw [link_rows cap link] at m
  obtain ⟨row,mem,rfl⟩ := List.mem_map.mp m
  exact row_head mem
theorem link_project {r a b : Nat} {w : Word} (cap : Cap r w) (link : Link r w a b)
    (keep : Word) (ha : a ∈ keep) (hb : b ∈ keep) : Link r (select keep w) a b := by
  have ct := (link_counts cap link).1
  apply (all_next a b ?_).trans ((select_count keep w a ha).trans ct)
  intro t m
  rw [project_rows keep ha] at m
  obtain ⟨s,hm,et⟩ := List.mem_map.mp m
  rw [← et]
  have one := row_head hm
  have two := next_after_link cap link hm
  cases s with
  | nil => simp at one
  | cons x s =>
    obtain rfl : x = a := Option.some.inj one
    cases s with
    | nil => simp at two
    | cons y s =>
      obtain rfl : y = b := Option.some.inj two
      simp [select,ha,hb]
theorem link_of_triples {r a b : Nat} {w : Word} (cap : Cap r w) (ca : w.count a = r)
    (triples : ∀ z, Link r (select [a,b,z] w) a b) : Link r w a b := by
  apply (all_next a b ?_).trans ca
  intro t m
  have first := row_head m
  have each (z : Nat) : (select [a,b,z] t).tail.head? = some b := by
    apply next_after_link (select_cap _ cap) (triples z)
    rw [project_rows _ (by simp : a ∈ [a,b,z])]
    exact List.mem_map.mpr ⟨t,m,rfl⟩
  cases t with
  | nil => simp at first
  | cons x t =>
    have eq : x = a := Option.some.inj first
    subst x
    cases t with
    | nil => simpa [select] using each a
    | cons z s => simpa [select] using each z
end P455Prefix
end
section
namespace P455ChangedEvents
open P455Witness P455Paths P455Alignment P455ContactReflection Problem455.Slots
abbrev W := List Nat
theorem stamped_perm {u v : W} (p : u.Perm v) (n : Nat → Nat) : (stamp n u).Perm (stamp n v) := by
  induction p generalizing n with
  | nil => exact .nil
  | cons a _ ih => exact .cons _ (ih _)
  | trans _ _ ih jh => exact (ih n).trans (jh n)
  | swap a b t =>
    by_cases eq : a = b
    · subst b; exact .refl _
    have oa : advance n [b] a = n a := by simp [advance,eq,Ne.symm eq]
    have ob : advance n [a] b = n b := by simp [advance,eq,Ne.symm eq]
    have tail : advance (advance n [a]) [b] = advance (advance n [b]) [a] := by
      funext z; simp only [advance]; omega
    simp only [stamp,oa,ob,tail]
    exact .swap _ _ _
private theorem earlier_idx {α : Type} [DecidableEq α] (x y : α) (w : List α) (nd : w.Nodup)
    (pat : [x,y].Sublist w) : w.idxOf x < w.idxOf y := by
  induction w with
  | nil => cases pat
  | cons b w ih =>
    obtain ⟨fresh,rest⟩ := List.nodup_cons.mp nd
    cases pat with
    | cons _ h =>
      have bx : b≠x := fun e => fresh (e ▸ h.subset (by simp))
      have by' : b≠y := fun e => fresh (e ▸ h.subset (by simp))
      simpa only [List.idxOf_cons,cond_eq_if,beq_iff_eq,if_neg bx,if_neg by',
        if_neg (Ne.symm bx),if_neg (Ne.symm by'),Nat.add_lt_add_iff_right] using ih rest h
    | cons_cons _ h =>
      have xy : x≠y := fun e => fresh (e ▸ h.subset List.mem_cons_self)
      simp [List.idxOf_cons,cond_eq_if,beq_iff_eq,xy,Ne.symm xy]
private theorem impossible {w : W} {x y : Event} (h : sees w [x,y]) (g : sees w [y,x]) : False :=
  Nat.lt_asymm (earlier_idx _ _ _ (stamp_unique _ _) h) (earlier_idx _ _ _ (stamp_unique _ _) g)
private theorem count_tag {a b z : Nat} (ne : a≠b) (which : z = a ∨ z = b) (tag : Tag) :
    (tag.flatMap (pair a b)).count z = tag.length := by
  induction tag with
  | nil => simp
  | cons bit t ih =>
    cases bit <;> rcases which with rfl|rfl <;>
      simp [pair,List.flatMap_cons,List.count_cons,ih,ne,Ne.symm ne,Nat.add_comm]
private theorem prefix_count {a b z : Nat} (ne : a≠b) (which : z = a ∨ z = b) (tag : Tag) :
    (profilePrefix a b tag).count z = 14+tag.length := by
  have tt := count_tag ne which tag
  rcases which with rfl|rfl <;>
    simp [profilePrefix,List.replicate_succ,List.count_cons,ne,Ne.symm ne,tt] <;> omega
private def profileMove {a b : Nat} (ne : a≠b) (tag : Tag) : Move (14+tag.length) where
  pre := profilePrefix a b tag
  p := [a]
  q := [b]
  post := [a,b]
  dp := by simp
  dq := by simp
  disjoint := by simpa using ne
  indexP := by intro z hz; exact prefix_count ne (.inl (List.mem_singleton.mp hz)) tag
  indexQ := by intro z hz; exact prefix_count ne (.inr (List.mem_singleton.mp hz)) tag
private theorem same_if_missing {a b : Nat} (ne : a≠b) (tag : Tag) (bit : Bool) (pat : List Event)
    (missing : (a,14+tag.length) ∉ pat ∨ (b,14+tag.length) ∉ pat) :
    sees (profile a b tag bit) pat ↔ sees (profile a b tag (!bit)) pat := by
  let m := profileMove ne tag
  have flat : sees (before m) pat ↔ sees (after m) pat :=
    sees_invariant m pat (by simpa [m,profileMove] using missing)
  cases bit
  · exact flat
  · exact flat.symm
private theorem one_name {u : W} (a : Nat) : select [a,a] u = List.replicate (u.count a) a := by
  induction u with
  | nil => rfl
  | cons b t ih =>
    by_cases e : a = b
    · subst b; simpa [select,List.count_cons,List.replicate_succ] using congrArg (List.cons a) ih
    · simpa [select,List.count_cons,e,Ne.symm e,beq_iff_eq] using ih
def ChangedPair (u v : W) (x y : Nat) := select [x,y] u ≠ select [x,y] v
theorem inverted_indices {r allow ts u v} (cap : P455Closure.Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (x y : Event)
    (cross : Inverted (events u) (events v) x y) :
    x.1 ≠ y.1 ∧ ChangedPair u v x.1 y.1 ∧ x.2 = r-2 ∧ y.2 = r-2 := by
  let ks := [x.1,y.1]
  have obs := sees_select ks u [x,y] (by simp [ks]) cross.1
  have rev := sees_select ks v [y,x] (by simp [ks]) cross.2
  have diff : select ks u ≠ select ks v := by
    intro eq; exact impossible (eq ▸ obs) rev
  have names : x.1≠y.1 := by
    intro eq
    have e : select [x.1,y.1] u = select [x.1,y.1] v := by
      rw [← eq,one_name,one_name,P455CellClassBinary.exact_counts cap valid]
    exact diff e
  obtain ⟨a,b,tag,bit,roles,len,_,U,V⟩ := P455CellClassBinary.changed cap valid names diff
  have ab : a≠b := by rcases roles with ⟨h,j⟩|⟨h,j⟩ <;> rw [h,j] <;> first | exact names | exact Ne.symm names
  change sees (select [x.1,y.1] u) [x,y] at obs
  change sees (select [x.1,y.1] v) [y,x] at rev
  rw [U] at obs; rw [V] at rev
  have necessary : (a,14+tag.length) ∈ [x,y] ∧ (b,14+tag.length) ∈ [x,y] := by
    constructor <;> apply Classical.byContradiction <;> intro missing
    · exact impossible ((same_if_missing ab tag bit _ (.inl missing)).mp obs) rev
    · exact impossible ((same_if_missing ab tag bit _ (.inr missing)).mp obs) rev
  obtain ⟨ax,bx⟩ := necessary
  simp only [List.mem_cons,List.not_mem_nil,or_false] at ax bx
  refine ⟨names,diff,?_⟩
  rcases ax with e|e <;> rcases bx with f|f
  · exact False.elim (ab (congrArg Prod.fst (e.trans f.symm)))
  · rw [← e,← f]; simp only; omega
  · rw [← f,← e]; simp only; omega
  · exact False.elim (ab (congrArg Prod.fst (e.trans f.symm)))
def Mates (u v : W) (r : Nat) (x y : Event) := ChangedPair u v x.1 y.1 ∧ x.2 = r-2 ∧ y.2 = r-2
theorem blocks_of_matching {r allow ts u v} (cap : P455Closure.Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (matching : ∀ a b c, ChangedPair u v a b → ChangedPair u v a c → b = c) :
    Blocks (Mates u v r) (events u) (events v) := by
  have cnt := P455CellClassBinary.exact_counts cap valid
  refine align (Mates u v r) ?_ ?_ (events u) (events v) (stamp_unique _ _) (stamped_perm (List.perm_iff_count.mpr cnt) _) ?_
  · intro x y h
    refine ⟨?_,h.2.2,h.2.1⟩
    unfold ChangedPair at *
    simpa only [ChangedPair,select_pair_symm x.1 y.1] using h.1
  · intro x y z h k
    exact Prod.ext (matching _ _ _ h.1 k.1) (h.2.2.trans k.2.2.symm)
  · intro x y i; exact (inverted_indices cap valid x y i).2
end P455ChangedEvents
end
section
namespace P455CellClassFrames
open P455FirstRewrite P455RectangleRank P455Closure P455ConstantLayout P455CrossedSupport
open P455Witness P455Uncrossed P455SlotSaturation Problem455.Slots
abbrev W := List Nat
def token (x y : Nat) (b : Bool) := if b then y else x
def phase (x y : Nat) (tag : Tag) := (fixedPhases tag).map (token x y)
private theorem extract_head {x : Nat} {xs w : W} (trace : (x::xs).Sublist w) :
    ∃ L K : W, w = L ++ x::K ∧ xs.Sublist K := by
  obtain ⟨a,b,rfl,inA,sub⟩ := List.cons_sublist_iff.mp trace
  obtain ⟨p,q,rfl⟩ := List.append_of_mem inA
  exact ⟨p,q++b,by simp [List.append_assoc],sub.trans (List.sublist_append_right q b)⟩
private theorem flat_eq {α β : Type} {xs : List α} {f g : α → List β}
    (eq : ∀ a ∈ xs, f a = g a) : xs.flatMap f = xs.flatMap g :=
  congrArg List.flatten (List.map_congr_left eq)
private def spelling (x y : Nat) (es : List (W × Bool)) : W := es.flatMap (fun e => e.1 ++ [token x y e.2])
private theorem interstices (x y : Nat) (bits : List Bool) (w : W)
    (trace : (bits.map (token x y)).Sublist w) :
    ∃ es K, es.map Prod.snd = bits ∧ w = spelling x y es ++ K := by
  induction bits generalizing w with
  | nil => exact ⟨[],w,rfl,rfl⟩
  | cons b bs ih =>
    obtain ⟨l,d,rfl,sub⟩ := extract_head trace
    obtain ⟨es,k,order,rfl⟩ := ih d sub
    exact ⟨(l,b)::es,k,by simp [order],by simp [spelling,List.flatMap_cons,List.append_assoc]⟩
def displayed (l : W) (x y : Nat) (m z : W) (c : Bool) :=
  l ++ P455Structural.early x y ++ m ++ Problem455.Slots.pair x y c ++ z
theorem typed_from_phases {r allow} {x y : Nat} (ne : x ≠ y) (tag : Tag) (tl : tag.length+16 = r)
    (allowed : allow tag) (l m z : W) (middle : (phase x y tag).Sublist m)
    (finalPair : [x,y].Sublist z) (cap : Cap r (displayed l x y m z false)) :
    ∃ (f : Frame Nat) (k : W), f.tag = tag ∧ f.p=[x] ∧ f.q=[y] ∧ f.Valid r allow noMark ∧
      ∀ c, displayed l x y m z c = side f l k c := by
  obtain ⟨es,rest,order,midEq⟩ := interstices x y (fixedPhases tag) m middle
  obtain ⟨p,s,hz,sub⟩ := extract_head finalPair
  obtain ⟨q,k,last,_⟩ := extract_head sub
  let f : Frame Nat := ⟨x,[],[],y,tag,es,rest,p,q⟩
  have md : f.mid = spelling x y es := by
    unfold Frame.mid spelling
    apply flat_eq
    intro e _
    cases b : e.2 <;> simp [f,Frame.p,Frame.q,token,b]
  have each (c : Bool) : displayed l x y m z c = side f l k c := by
    cases c <;> simp [displayed,side,Frame.core,md,midEq,hz,last,f,Frame.early,Frame.p,Frame.q,
      Frame.pair,P455Structural.early,Problem455.Slots.pair,List.append_assoc]
  refine ⟨f,k,rfl,rfl,rfl,?_,each⟩
  apply f.valid_of_capped_shape (by change r = 16+tag.length; omega) allowed order
      (by simp [f,Frame.p]) (by simp [f,Frame.q])
      (by simp [f,Frame.p,Frame.q,ne]) (by simp [noMark]) false l k
  change Cap r (side f l k false)
  rw [← each]; exact cap
theorem from_phases {r allow} {x y : Nat} (ne : x ≠ y) (tag : Tag) (tl : tag.length+16 = r)
    (allowed : allow tag) (l m z : W) (middle : (phase x y tag).Sublist m)
    (finalPair : [x,y].Sublist z) (cap : Cap r (displayed l x y m z false)) :
    ∃ (f : Frame Nat) (k : W), f.p=[x] ∧ f.q=[y] ∧ f.Valid r allow noMark ∧
      ∀ c, displayed l x y m z c = side f l k c := by
  obtain ⟨f,k,_,rest⟩ := typed_from_phases ne tag tl allowed l m z middle finalPair cap
  exact ⟨f,k,rest⟩
def revise (bits : Nat → Bool) (i : Nat) (c : Bool) (j : Nat) := if j = i then c else bits j
theorem count_word (t : Nat) (middle tail : W) (bits : Nat → Bool) (x : Nat) :
    (word t middle tail bits).count x = (word t middle tail (constant false)).count x := by
  have one (i : Nat) : (mutableCell bits i).count x = (mutableCell (constant false) i).count x := by
    cases b : bits i <;> simp [mutableCell,constant,b,List.count_cons,Nat.add_comm]
  have ls (a : List Nat) : (a.flatMap (mutableCell bits)).count x =
      (a.flatMap (mutableCell (constant false))).count x := by
    induction a with
    | nil => rfl
    | cons z zs ih => simp only [List.flatMap_cons,List.count_append,ih,one]
  simp only [word,List.count_append,ls]
theorem cap_word {r t : Nat} {middle tail : W}
    (zeroCap : Cap r (word t middle tail (constant false))) (bits : Nat → Bool) :
    Cap r (word t middle tail bits) := fun x => count_word t middle tail bits x ▸ zeroCap x
theorem same_word {t : Nat} (m z : W) {s b : Nat → Bool} (agree : ∀ i < t,s i = b i) :
    word t m z s = word t m z b := by
  have eq : (List.range t).flatMap (mutableCell s) = (List.range t).flatMap (mutableCell b) := by
    apply flat_eq; intro i hi; simp [mutableCell,agree i (List.mem_range.mp hi)]
  simp only [word,eq]
def Used (t : Nat) (x y : Nat) := ∃ i < t, x = owner i ∧ y = mate i
structure Phases (r : Nat) (allow : Tag → Prop) (t : Nat) (m z : W) where
  tag : Nat → Tag
  length : ∀ i < t, (tag i).length+16 = r
  allowed : ∀ i < t, allow (tag i)
  tokens : ∀ i < t, (phase (owner i) (mate i) (tag i)).Sublist m
  finalPair : ∀ i < t, [owner i,mate i].Sublist z
  capped : Cap r (word t m z (constant false))
theorem typed_frame {r allow t m z} (p : Phases r allow t m z) (bits : Nat → Bool) {i} (ix : i < t) :
    ∃ (f : Frame Nat) (l k : W), f.tag = p.tag i ∧ f.p=[owner i] ∧ f.q=[mate i] ∧ f.Valid r allow noMark ∧
      ∀ c, word t m z (revise bits i c) = side f l k c := by
  let lo := List.range i
  let hi := (List.range (t-(i+1))).map (fun v => i+1+v)
  have rr : List.range t = (lo ++ [i]) ++ hi := by
    conv => lhs; arg 1; rw [show t = (i+1)+(t-(i+1)) by omega]
    rw [List.range_add,List.range_succ]
  have lower : i ∉ lo := by simp [lo]
  have higher : i ∉ hi := by
    intro h; obtain ⟨v,_,eq⟩ := List.mem_map.mp h; omega
  let L := lo.flatMap privateCell
  let M := hi.flatMap privateCell ++ m ++ lo.flatMap (mutableCell bits)
  let Z := hi.flatMap (mutableCell bits) ++ z
  have fix (s : List Nat) (away : i ∉ s) (c : Bool) :
      s.flatMap (mutableCell (revise bits i c)) = s.flatMap (mutableCell bits) := by
    apply flat_eq; intro j hj
    have d : j ≠ i := fun e => away (e ▸ hj)
    simp [mutableCell,revise,d]
  have e (c : Bool) : word t m z (revise bits i c) = displayed L (owner i) (mate i) M Z c := by
    simp only [word,rr,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil,
      fix lo lower,fix hi higher]
    cases c <;> simp [displayed,privateCell,P455Structural.early,L,M,Z,mutableCell,revise,pair,List.append_assoc]
  have mid := (p.tokens i ix).trans ((List.sublist_append_right (hi.flatMap privateCell) m).trans
    (List.sublist_append_left _ (lo.flatMap (mutableCell bits))))
  have fin : [owner i,mate i].Sublist Z := (p.finalPair i ix).trans (List.sublist_append_right _ z)
  have cp := cap_word p.capped (revise bits i false)
  obtain ⟨f,k,tag,hp,hq,valid,both⟩ := typed_from_phases (by simp [owner,mate]) (p.tag i) (p.length i ix)
    (p.allowed i ix) L M Z mid fin (e false ▸ cp)
  exact ⟨f,L,k,tag,hp,hq,valid,fun c => (e c).trans (both c)⟩
theorem frameAt {r allow t m z} (p : Phases r allow t m z) (bits : Nat → Bool) {i} (ix : i < t) :
    ∃ (f : Frame Nat) (l k : W), f.p=[owner i] ∧ f.q=[mate i] ∧ f.Valid r allow noMark ∧
      ∀ c, word t m z (revise bits i c) = side f l k c := by
  obtain ⟨f,l,k,_,rest⟩ := typed_frame p bits ix
  exact ⟨f,l,k,rest⟩
theorem typed_cell {r allow t m z} (p : Phases r allow t m z) (bits : Nat → Bool) {i} (ix : i < t)
    (mark : Marking) : Holds r allow mark (word t m z bits) (typedNode ⟨owner i,mate i,p.tag i⟩) := by
  obtain ⟨f,l,k,tag,hp,hq,valid,both⟩ := typed_frame p bits ix
  have eq : word t m z bits = side f l k (bits i) := (same_word m z
    (fun j _ => show bits j = revise bits i (bits i) j by by_cases e : j = i <;> simp [revise,e])).trans (both _)
  have cp := cap_word p.capped bits
  rw [eq] at cp ⊢
  refine ⟨by simp [owner,mate],p.length i ix,p.allowed i ix,bits i,?_⟩
  have c := f.cross_projection valid (bits i) l k cp (owner i) (mate i) (hp ▸ List.mem_cons_self) (hq ▸ List.mem_cons_self)
  rw [P455SlotProduct.profile_eq,tag] at c
  simpa [select,side] using c
theorem chain {r allow t m z} (p : Phases r allow t m z) (bits : Nat → Bool) :
    Chain r allow (Used t) (word t m z (constant false)) (word t m z bits) := by
  let active (n j : Nat) := if j < n then bits j else false
  have step (i : Nat) (ix : i < t) : Chain r allow (Used t) (word t m z (active i))
      (word t m z (active (i+1))) := by
    obtain ⟨f,l,k,hp,hq,valid,both⟩ := frameAt p (active i) ix
    have low : word t m z (active i) = side f l k false := by
      rw [← both]; apply same_word; intro j _; by_cases same : j = i <;> simp [revise,active,same]
    have high : word t m z (active (i+1)) = side f l k (bits i) := by
      rw [← both]; apply same_word; intro j _
      by_cases same : j = i
      · simp [revise,active,same]
      · have iff : j < i+1 ↔ j < i := by omega
        simp [revise,active,same,iff]
    cases b : bits i
    · rw [b] at high; rw [low,high]; exact .refl _
    · rw [b] at high
      exact .snoc (.refl _) ⟨owner i,mate i,f,false,l,k,⟨i,ix,rfl,rfl⟩,hp,hq,valid,low,high⟩
  have upto (n : Nat) (hn : n ≤ t) : Chain r allow (Used t) (word t m z (constant false)) (word t m z (active n)) := by
    induction n with
    | zero =>
      have idw : word t m z (constant false) = word t m z (active 0) := same_word m z (by simp [active,constant])
      rw [idw]; exact .refl _
    | succ n ih => exact (ih (by omega)).trans (step n (by omega))
  have finish : word t m z (active t) = word t m z bits := same_word m z (fun i hi => by simp [active,hi])
  exact finish ▸ upto t (Nat.le_refl t)
end P455CellClassFrames
end
section
namespace P455CellClassRank
open P455FirstRewrite P455RectangleRank P455Witness P455ActualGuards P455MarkedRank
open P455CellClass Problem455.Slots
abbrev W := List Nat
theorem no_incident_descent {r allow ts t middle tail bit i} (ix : i < t) (yes : bit i = true)
    (cap : P455Quotient.Cap r (word t middle tail (constant false)))
    (tailPair : select [owner i,mate i] tail = [owner i,mate i])
    (ident : (P455FullSingleton.model r allow ts).Valid (word t middle tail (constant false))
      (word t middle tail bit)) :
    ¬ EdgeViolation r allow ts (word t middle tail bit) (owner i) (mate i) := by
  have cv : P455Quotient.Cap r (word t middle tail bit) :=
    fun a => (P455CellClassBinary.exact_counts cap ident a) ▸ cap a
  have reverse : (P455FullSingleton.model r allow ts).Valid (word t middle tail bit)
    (word t middle tail (constant false)) := fun f => (ident f).symm
  exact endpoint_feasible cv (((valid_pair ..).mp ((valid_pair ..).mp reverse).2).1)
    (bit_change ix middle tail bit yes tailPair)
theorem no_basis {r allow ts} (hr : 0 < r)
    (padding : ∀ k : Nat, ∃ (t : Nat) (middle tail : W), k < 2*t ∧
      (∀ x ∈ middle ++ tail, x < 2*t) ∧
      (∀ i < t, select [owner i,mate i] tail = [owner i,mate i]) ∧
      Nonempty (P455ConstantLayout.Layout r allow ts (fun b => word t middle tail (constant b))) ∧
      (∀ (bit : Nat → Bool) (i : Nat), i+1 < t → bit i = true → bit (i+1) = false →
        EdgeViolation r allow ts (word t middle tail bit) (owner i) (mate i)) ∧
      (∀ (bit : Nat → Bool), 0 < t → bit (t-1) = true → bit 0 = false →
        EdgeViolation r allow ts (word t middle tail bit) (owner (t-1)) (mate (t-1))))
    (basis : List (W × W)) (sound : ∀ u v, (u,v) ∈ basis → (P455FullSingleton.model r allow ts).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (P455FullSingleton.model r allow ts).Valid U V ∧
      ¬ Derives (fun u v => (u,v) ∈ basis) U V := by
  apply P455ConstantProduct.rectangle_no_basis hr _ basis sound
  intro k
  obtain ⟨t,m,z,big,small,tailPair,⟨layout⟩,next,wrap⟩ := padding k
  have cap : P455Quotient.Cap r (word t m z (constant false)) := by
    intro a; by_cases mem : a ∈ word t m z (constant false)
    · exact Nat.le_of_eq (layout.uniform false a mem)
    · simp [List.count_eq_zero.mpr mem]
  refine ⟨t,m,z,big,small,⟨layout⟩,(fun w idw => represent small cap tailPair idw),?_⟩
  intro bit valid
  constructor
  · intro i lt yes
    have ix : i < t := by omega
    cases hb : bit (i+1)
    · exact False.elim (no_incident_descent ix yes cap (tailPair i ix) valid (next bit i lt yes hb))
    · rfl
  · intro positive yes
    have ix : t-1 < t := by omega
    cases hb : bit 0
    · exact False.elim (no_incident_descent ix yes cap (tailPair _ ix) valid (wrap bit positive yes hb))
    · rfl
end P455CellClassRank
end
section
namespace P455Enum
open P455Witness P455Paths P455PaddedTiles P455CatalogueBounds P455EdgeProduct P455EdgeProjection
def certificates (w : List Nat) (ts : List Tag) : List EdgeCertificate :=
  let nodes := pool w ts
  nodes.flatMap fun a => nodes.flatMap fun b => nodes.flatMap fun right => nodes.flatMap fun left =>
    nodes.flatMap fun down => nodes.flatMap fun up => nodes.map fun diag => ⟨a,b,right,left,down,up,diag⟩
theorem bounded_mem {w ts} (e : EdgeCertificate) (all : ∀ v∈fields e,v∈pool w ts) : e∈certificates w ts := by
  simp only [certificates,List.mem_flatMap,List.mem_map]
  exact ⟨_,all e.a (by simp [fields]),_,all e.b (by simp [fields]),_,all e.right (by simp [fields]),
    _,all e.left (by simp [fields]),_,all e.down (by simp [fields]),_,all e.up (by simp [fields]),
    _,all e.diagonal (by simp [fields]),rfl⟩
instance markD (a b c d : Nat) : DecidableRel (marks a b c d) := by
  intro x y; unfold marks; infer_instance
def sameNamesD (w v : List Nat) : Decidable (∀ x : Nat,x∈w ↔ x∈v) :=
  decidable_of_iff ((∀ x∈w,x∈v) ∧ ∀ x∈v,x∈w)
    ⟨fun ⟨f,g⟩ x=>⟨f x,g x⟩,fun h=>⟨fun x=>(h x).1,fun x=>(h x).2⟩⟩
def edgeAccept {r} (hr : 0 < r) (M : MachineTable n) (w : List Nat) (cp : P455Closure.Cap r w)
    (a b c d : Nat) : Decidable (∃ e : EdgeCertificate, e.a.owner = a ∧ e.a.mate = b ∧ e.b.owner = c ∧ e.b.mate = d ∧
      (∀ x : Nat, x∈w ↔ x∈names (system n) e) ∧ Holds r (allowed M) (marks a b c d) w (e.query (system n))) :=
  let p (e : EdgeCertificate) := e.a.owner = a ∧ e.a.mate = b ∧ e.b.owner = c ∧ e.b.mate = d ∧
      (∀ x : Nat, x∈w ↔ x∈names (system n) e) ∧ Holds r (allowed M) (marks a b c d) w (e.query (system n))
  letI : DecidablePred p := fun e=>by
    letI := sameNamesD w (names (system n) e)
    letI := holdsD hr (allowed M) (marks a b c d) w _ (statEdge n e)
    unfold p; infer_instance
  decidable_of_iff (∃ e∈certificates w (tags M),p e) ⟨fun ⟨e,_,h⟩=>⟨e,h⟩,by
    rintro ⟨e,h1,h2,h3,h4,ns,h⟩
    obtain ⟨k,ka,kb,eq,read,bounds⟩ := bounded_edge cp (tags M) (fun _ h=>mem_tags.mpr h) e h
    exact ⟨k,bounded_mem k bounds,by rw [ka,h1],by rw [ka,h2],by rw [kb,h3],by rw [kb,h4],
      by simpa only [eq] using ns,read⟩⟩
abbrev EdgeKey (r : Nat) := Fin (words r).length × Fin 14 × Fin 14 × Fin 14 × Fin 14
def edge {r} (hr : 0 < r) (M : MachineTable n) : Cover (Index r (allowed M) (system n)) :=
  let p (key : EdgeKey r) := let w := (words r).get key.1
    let (a,b,c,d) := key.2
    P455Closure.Cap r w ∧ ∃ e : EdgeCertificate, e.a.owner = a.val ∧ e.a.mate = b.val ∧ e.b.owner = c.val ∧ e.b.mate = d.val ∧
      (∀ x : Nat, x∈w ↔ x∈names (system n) e) ∧ Holds r (allowed M) (marks a b c d) w (e.query (system n))
  letI : DecidablePred p := fun ⟨i,a,b,c,d⟩=>by
    let w:=(words r).get i
    letI := capD r w
    by_cases cp : P455Closure.Cap r w
    · letI := edgeAccept hr M w cp a b c d
      unfold p; dsimp only; infer_instance
    · exact .isFalse (fun h=>cp h.1)
  let keys : Cover (EdgeKey r) := pairCover (fins _) (pairCover (fins _) (pairCover (fins _) (pairCover (fins _) (fins _))))
  (coverSub keys p).map (fun z=>⟨z.val.1,z.val.2.1,z.val.2.2.1,z.val.2.2.2.1,z.val.2.2.2.2,z.property.1,z.property.2⟩)
    (fun ⟨i,a,b,c,d,cp,ok⟩=>⟨⟨(i,a,b,c,d),cp,ok⟩,rfl⟩)
deriving instance DecidableEq for P455GuardProduct.Index
deriving instance DecidableEq for P455EdgeProduct.Index
deriving instance DecidableEq for P455StructuralProduct.Index
deriving instance DecidableEq for P455BinaryProduct.Index
end P455Enum
end
section
namespace P455Prefix
open P455FirstRewrite P455Quotient P455Witness P455Structural Problem455.Slots
open Problem455Swap (Link)
open P455DefectProjection (select_count select_cap)
theorem select_swap (a b : Nat) (w : Word) : select [a,b] w = select [b,a] w := by
  unfold select; apply List.filter_congr; intro x _; simp [Or.comm]
def PairProfile (r : Nat) (allow : Tag → Prop) (a b : Nat) (T : Word) :=
  ∃ tag bit, tag.length+16 = r ∧ allow tag ∧
    (T = profile a b tag bit ∨ T = profile b a tag bit)
theorem edge_iff {r allow a b w} (ab : a ≠ b) :
    Edge w r allow a b ↔ PairProfile r allow a b (select [a,b] w) := by
  constructor
  · rintro (⟨t,_,len,ok,bit,h⟩|⟨t,_,len,ok,bit,h⟩)
    · exact ⟨t,bit,len,ok,.inl h⟩
    · exact ⟨t,bit,len,ok,.inr ((select_swap a b w).trans h)⟩
  · rintro ⟨t,bit,len,ok,h|h⟩
    · exact .inl ⟨t,ab,len,ok,bit,h⟩
    · exact .inr ⟨t,ab.symm,len,ok,bit,(select_swap b a w).trans h⟩
theorem changed_edges {r allow ts u v a b} (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (ab : a ≠ b)
    (diff : select [a,b] u ≠ select [a,b] v) : Edge u r allow a b ∧ Edge v r allow a b := by
  obtain ⟨x,y,t,bit,orient,len,ok,hu,hv⟩ := P455CellClassBinary.changed cap valid ab diff
  rw [edge_iff ab,edge_iff ab]
  rcases orient with ⟨rfl,rfl⟩|⟨rfl,rfl⟩
  · exact ⟨⟨t,bit,len,ok,.inl hu⟩,⟨t,!bit,len,ok,.inl hv⟩⟩
  · exact ⟨⟨t,bit,len,ok,.inr hu⟩,⟨t,!bit,len,ok,.inr hv⟩⟩
theorem edge_persists {r allow ts u v a b} (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (ab : a ≠ b)
    (e : Edge u r allow a b) : Edge v r allow a b := by
  by_cases same : select [a,b] u = select [a,b] v
  · rw [edge_iff ab,← same]; exact (edge_iff ab).mp e
  · exact (changed_edges cap valid ab same).2
private theorem head_not_target {r a b z t} (cap : Cap r (z::t)) (l : Link r (z::t) a b) : z ≠ b := by
  intro eq; subst z
  have h := Problem455Swap.in_bound a (a+1) b (by omega) (b::t)
  rw [Problem455BlockBridge.occ_count] at h
  have c := (link_counts cap l).2
  change Problem455Swap.bigram a b (b::t) = r at l
  simp [List.count_cons] at h c; omega
private theorem double_not_link {r a b c t} (cap : Cap r (c::c::t)) (one : c = a ∨ c = b) :
    ¬ Link r (c::c::t) a b := by
  intro l
  have nb := head_not_target cap l
  rcases one with e|e
  · subst c
    have n := next_after_link cap l (t := a::a::t) (by simp [P455BlockSeparators.rows])
    exact nb (Option.some.inj n)
  · exact nb e
theorem profile_not_link {r allow a b T} (cap : Cap r T)
    (p : PairProfile r allow a b T) : ¬ Link r T a b ∧ ¬ Link r T b a := by
  obtain ⟨t,bit,_,_,e|e⟩ := p <;> subst T
  · exact ⟨double_not_link cap (.inl rfl),double_not_link cap (.inr rfl)⟩
  · exact ⟨double_not_link cap (.inr rfl),double_not_link cap (.inl rfl)⟩
theorem link_fixes_binary {r allow ts a b u v} (cap : Cap r u) (ab : a ≠ b) (l : Link r u a b)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) : select [a,b] u = select [a,b] v := by
  apply Classical.byContradiction; intro bad
  have profile := (edge_iff ab).mp (changed_edges cap valid ab bad).1
  exact (profile_not_link (select_cap _ cap) profile).1 (link_project cap l _ (by simp) (by simp))
theorem not_self {r a} {u : Word} (hr : 0 < r) (cap : Cap r u) : ¬ Link r u a a := by
  intro l
  have rows := P455BlockSeparators.link_rows cap l
  have ct := P455BlockSeparators.rows_length a u
  have pos := (link_counts cap l).1
  cases e : P455BlockSeparators.rows a u with
  | nil => simp [e] at ct; omega
  | cons z s =>
    rw [e] at rows
    have len := congrArg List.length (List.cons.inj rows).1
    simp at len
theorem no_opposite {r a b} {u : Word} (hr : 0 < r) (cap : Cap r u) (l : Link r u a b) :
    ¬ Link r u b a := by
  intro back
  let rows := P455BlockSeparators.rows
  have forward := P455BlockSeparators.link_rows cap l
  have backward := P455BlockSeparators.link_rows cap back
  rw [backward,List.map_map] at forward
  have ct := P455BlockSeparators.rows_length a u
  have pos := (link_counts cap l).1
  cases e : rows a u with
  | nil => change P455BlockSeparators.rows a u = [] at e; simp [e] at ct; omega
  | cons z s =>
    change P455BlockSeparators.rows a u = z::s at e
    rw [e] at forward
    have len := congrArg List.length (List.cons.inj forward).1
    simp at len; omega
def exchange (a b z : Nat) := if z = a then b else if z = b then a else z
private theorem shadow {a b z} (ab : a ≠ b) (az : a ≠ z) (bz : b ≠ z)
    (t : Word) (out : b ∉ t) :
    (select [a,z] (t.flatMap (openPair a b))).map (exchange a b) =
      select [b,z] (t.flatMap (openPair a b)) := by
  induction t with
  | nil => rfl
  | cons c t ih =>
    have cb : c ≠ b := fun e => out (e ▸ List.mem_cons_self)
    have eq := ih (fun h => out (List.mem_cons_of_mem _ h))
    simp only [List.flatMap_cons,select_append,List.map_append,eq]
    by_cases ca : c = a <;> by_cases cz : c = z <;>
      simp_all [openPair,select,exchange,Ne.symm]
private theorem map_prof {r allow a b T} (d : Nat → Nat) (p : PairProfile r allow a b T) :
    PairProfile r allow (d a) (d b) (T.map d) := by
  obtain ⟨t,bit,len,ok,h|h⟩ := p <;> subst T
  · exact ⟨t,bit,len,ok,.inl (P455ContactReflection.map_profile ..)⟩
  · exact ⟨t,bit,len,ok,.inr (P455ContactReflection.map_profile ..)⟩
theorem twin_edges {r allow a b z u} (cap : Cap r u) (l : Link r u a b)
    (ab : a ≠ b) (az : a ≠ z) (bz : b ≠ z) : Edge u r allow a z ↔ Edge u r allow b z := by
  rw [edge_iff az,edge_iff bz]
  let d := exchange a b
  have swap : (select [a,z] u).map d = select [b,z] u := by
    have sh := shadow ab az bz (dropName b u) (by simp)
    rwa [recover_link cap l] at sh
  have back : (select [b,z] u).map d = select [a,z] u := by
    rw [← swap,List.map_map]
    have dd : d ∘ d = id := by
      funext c; by_cases ca : c = a <;> by_cases cb : c = b <;> simp_all [d,exchange,Function.comp_def,Ne.symm]
    simp [dd]
  constructor
  · intro p; have q := map_prof d p
    simpa [d,exchange,ab,Ne.symm az,Ne.symm bz,← swap] using q
  · intro p; have q := map_prof d p
    simpa [d,exchange,Ne.symm ab,Ne.symm az,Ne.symm bz,← back] using q
theorem linked_shadow {r a b z u} (cap : Cap r u) (l : Link r u a b)
    (ab : a ≠ b) (az : a ≠ z) (bz : b ≠ z) :
    (select [b,z] u).map (exchange a b) = select [a,z] u := by
  have sh := shadow ab az bz (dropName b u) (by simp)
  rw [recover_link cap l] at sh
  rw [← sh,List.map_map]
  have ex : exchange a b ∘ exchange a b = id := by
    funext c; by_cases ca : c = a <;> by_cases cb : c = b <;> simp_all [exchange,Function.comp_def,Ne.symm]
  simp [ex]
end P455Prefix
end
section
namespace P455CellClassSnake
open P455RectangleRank P455CellClassFrames P455CellClass P455Witness P455CrossedSupport
open P455Closure P455SlotSaturation P455Uncrossed P455MarkedRank P455GridRows
open P455PortReflection P455ActualGuards P455ConstantLayout Problem455.Slots
abbrev W := List Nat
theorem closedAt {r allow t m z} (p : Phases r allow t m z) (bits : Nat → Bool) {i} (ix : i < t) :
    ClosedFlip r allow (word t m z bits) (owner i) (mate i) := by
  obtain ⟨f,l,k,hp,hq,ok,both⟩ := frameAt p bits ix
  have base : word t m z bits = word t m z (revise bits i (bits i)) :=
    same_word m z (fun j _ => by by_cases same : j = i <;> simp [revise,same])
  exact ⟨f,bits i,l,k,hp,hq,ok,base.trans (both _)⟩
theorem chain_walk {r allow used u v} (cp : Cap r u) (p : Chain r allow used u v) :
    P455Quotient.Walk (P455Closure.Move r allow noMark) u v := by
  induction p with
  | refl => exact .refl _
  | snoc _ flip ih =>
    obtain ⟨x,y,f,b,l,k,_,_,_,yes,rfl,rfl⟩ := flip
    have cv : Cap r (side f l k b) := fun a =>
      (P455Quotient.count_walk (rules r allow noMark) ih a) ▸ cp a
    exact .snoc ih ⟨f,b,l,k,yes,rfl,rfl,cv⟩
def At (r : Nat) (allow : Tag → Prop) (ts : Tiles) (w : W) (i j : Nat) :=
  ∃ e : EdgeCertificate, e.a.owner = owner i ∧ e.a.mate = mate i ∧
    e.b.owner = owner j ∧ e.b.mate = mate j ∧ Arrow r allow noMark w ts e
private theorem free_local (ts : Tiles) (e : EdgeCertificate) : markFree (localCert ts e) = true := by
  have hor (a b : Node) : markFree (rightward ts a b) = true := rfl
  have vert (a b : Node) : markFree (downward ts a b) = true := rfl
  cases rr : ts.right e.a.tag <;> cases ll : ts.left e.a.tag <;>
    cases dd : ts.bottom e.a.tag <;> cases uu : ts.top e.a.tag <;>
      simp [localCert,rr,ll,dd,uu,flagQ,allQ,markFree,hor,vert]
private theorem free_succ (ts : Tiles) (e : EdgeCertificate) : markFree (chosenSuccessor ts e) = true := by
  cases wrap : endOfRow ts e.a && ts.bottom e.a.tag <;> simp only [chosenSuccessor,wrap,Bool.false_eq_true,if_false,if_true] <;> rfl
theorem descent {r allow ts t m z} (p : Phases r allow t m z) (bits : Nat → Bool)
    (finalPair : ∀ i < t, select [owner i,mate i] z=[owner i,mate i])
    {i j : Nat} (ix : i < t) (jx : j < t) (yes : bits i = true) (no : bits j = false)
    (arrow : At r allow ts (word t m z (constant false)) i j) :
    EdgeViolation r allow ts (word t m z bits) (owner i) (mate i) := by
  obtain ⟨e,ao,am,bo,bm,sa,sb,localQ,next⟩ := arrow
  let mark := P455SourceTheorem.sourceMarks id (.edge e)
  let w := word t m z bits
  have walk := chain_walk p.capped (chain p bits)
  have pass (q : Query) (h : Holds r allow noMark (word t m z (constant false)) q) :
      Holds r allow noMark w q := walk.transport h (fun mv old => (query_invariant mv _).mp old)
  have message (n : Node) (k : Nat) (lt : k < t) (o : n.owner = owner k) (a : n.mate = mate k)
      (record : Holds r allow noMark (word t m z (constant false)) (typedNode n))
      (marked : mark n.owner n.mate) : Holds r allow mark w (markedNode n (bits k)) := by
    obtain ⟨ne,len,admitted,tr⟩ := pass _ record
    refine ⟨ne,len,admitted,.inl marked,?_⟩
    rw [o,a] at tr ⊢
    exact read_bit lt m z bits (finalPair k lt) n.tag tr
  have anchor := message e.a i ix ao am sa (Or.inl ⟨rfl,rfl⟩)
  have successor := message e.b j jx bo bm sb (Or.inr ⟨rfl,rfl⟩)
  rw [yes] at anchor; rw [no] at successor
  exact ⟨e,false,.inl ⟨ao,am⟩,anchor,successor,remark (free_local ..) (pass _ localQ),
    remark (free_succ ..) (pass _ next),True.intro⟩
structure Geometry (r : Nat) (allow : Tag → Prop) (ts : Tiles) (t : Nat) (m z : W) where
  phases : Phases r allow t m z
  names : ∀ x ∈ m ++ z, x < 2*t
  finalPair : ∀ i < t, select [owner i,mate i] z=[owner i,mate i]
  clean : ∀ b i, i < t → ¬ P455SingletonEvaluation.Violation r allow ts (word t m z (constant b)) (owner i) (mate i)
  next : ∀ i, i+1 < t → At r allow ts (word t m z (constant false)) i (i+1)
  wrap : 0 < t → At r allow ts (word t m z (constant false)) (t-1) 0
def layout {r allow ts t m z} (hr : 0 < r) (g : Geometry r allow ts t m z) :
    P455ConstantLayout.Layout r allow ts (fun b => word t m z (constant b)) := by
  have cap (b : Bool) := cap_word g.phases.capped (constant b)
  refine ⟨Used t,chain g.phases (constant true),?_,?_,?_,?_⟩
  · intro b a ha
    have small := word_names _ g.names a ha
    have lt : a/2 < t := by omega
    obtain ⟨_,co,cm,_⟩ := flip_counts (cap b) (closedAt g.phases (constant b) lt)
    have which : a = owner (a/2) ∨ a = mate (a/2) := by unfold owner mate; omega
    rcases which with eq|eq <;> first | exact eq ▸ co | exact eq ▸ cm
  · intro b; exact no_links hr (constant b) g.names (cap b)
  · rintro b _ _ ⟨i,ix,rfl,rfl⟩; exact closedAt g.phases (constant b) ix
  · rintro b _ _ ⟨i,ix,rfl,rfl⟩; exact g.clean b i ix
theorem no_basis {r allow ts} (hr : 0 < r)
    (padding : ∀ k : Nat, ∃ (t : Nat) (m z : W), k < 2*t ∧ Nonempty (Geometry r allow ts t m z))
    (basis : List (W × W)) (sound : ∀ u v, (u,v) ∈ basis → (P455FullSingleton.model r allow ts).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (P455FullSingleton.model r allow ts).Valid U V ∧
      ¬ P455FirstRewrite.Derives (fun u v => (u,v) ∈ basis) U V := by
  apply P455CellClassRank.no_basis hr _ basis sound
  intro k; obtain ⟨t,m,z,big,⟨g⟩⟩ := padding k
  exact ⟨t,m,z,big,g.names,g.finalPair,⟨layout hr g⟩,
    fun bit i h yes no => descent g.phases bit g.finalPair (by omega) h yes no (g.next i h),
    fun bit h yes no => descent g.phases bit g.finalPair (by omega) h yes no (g.wrap h)⟩
end P455CellClassSnake
end
section
namespace P455Prefix
open P455FirstRewrite P455Quotient P455Witness P455Structural Problem455.Slots
open Problem455Swap (Link)
open P455DefectProjection (select_cap)
theorem select_valid {A : Type} (M : Model A) (keep : Word) {u v : Word} (valid : M.Valid u v) :
    M.Valid (select keep u) (select keep v) := by
  let f (x : Nat) : Word := if x ∈ keep then [x] else []
  have eq (w : Word) : w.flatMap f = select keep w := by
    induction w with
    | nil => rfl
    | cons c t ih => by_cases k : c ∈ keep <;> simp [f,select,k,ih]
  intro val; rw [← eq,← eq,M.eval_instance,M.eval_instance]; exact valid _
private theorem selected_self (k w : Word) (sup : ∀ t ∈ w, t ∈ k) : select k w = w :=
  List.filter_eq_self.mpr (fun t m => by simpa using sup t m)
private theorem three_ext {a b z : Nat} {u v : Word}
    (su : ∀ t ∈ u, t ∈ [a,b,z]) (sv : ∀ t ∈ v, t ∈ [a,b,z]) (count : ∀ t, u.count t = v.count t)
    (xy : select [a,b] u = select [a,b] v) (xz : select [a,z] u = select [a,z] v)
    (yz : select [b,z] u = select [b,z] v) : u = v := by
  let g (c : Nat) : Word := if c ∈ [a,b,z] then [c] else []
  have dec (w : Word) (sup : ∀ t ∈ w, t ∈ [a,b,z]) : w.flatMap g = w := by
    induction w with
    | nil => rfl
    | cons c t ih =>
      have m := sup c List.mem_cons_self
      simpa only [List.flatMap_cons,g,if_pos m,List.singleton_append] using congrArg (List.cons c) (ih (fun d hd => sup d (List.mem_cons_of_mem _ hd)))
  rw [← dec u su,← dec v sv]
  apply trace g count
  intro i j bad
  have hi : i ∈ [a,b,z] := by
    apply Classical.byContradiction; intro h; exact bad (by simp only [g,if_neg h,List.nil_append,List.append_nil])
  have hj : j ∈ [a,b,z] := by
    apply Classical.byContradiction; intro h; exact bad (by simp only [g,if_neg h,List.nil_append,List.append_nil])
  have ne : i ≠ j := fun e => bad (by rw [e])
  have rev {c d : Nat} (eq : select [c,d] u = select [c,d] v) : select [d,c] u = select [d,c] v := by
    rw [select_swap d c u,select_swap d c v,eq]
  have cvt (x y : Nat) (w : Word) : proj x y w = select [x,y] w := by simp [proj,select]
  rw [cvt,cvt]
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hi hj
  rcases hi with ha|hb|hz <;> rcases hj with ka|kb|kz <;> subst i <;> subst j <;>
    first | contradiction | exact xy | exact xz | exact yz | exact rev xy | exact rev xz | exact rev yz
theorem edge_no_links {r allow a z} {v : Word} (cv : Cap r v) (az : a ≠ z) (e : Edge v r allow a z) :
    ¬ Link r v a z ∧ ¬ Link r v z a := by
  have p := profile_not_link (select_cap [a,z] cv) ((edge_iff az).mp e)
  exact ⟨fun l => p.1 (link_project cv l _ (by simp) (by simp)),
    fun l => p.2 (link_project cv l _ (by simp) (by simp))⟩
theorem triple_invariant {r allow ts a b z} {u v : Word} (hr : 0 < r) (cu : Cap r u) (cv : Cap r v)
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (su : ∀ t ∈ u, t ∈ [a,b,z]) (sv : ∀ t ∈ v, t ∈ [a,b,z]) (left : Link r u a b) : Link r v a b := by
  classical
  apply Classical.byContradiction; intro failed
  have neq : u ≠ v := fun eq => failed (eq ▸ left)
  have ab : a ≠ b := fun eq => not_self hr cu (eq ▸ left)
  have fixed := link_fixes_binary cu ab left valid
  have third : z ≠ a ∧ z ≠ b := by
    have separate (hz : z ∈ [a,b]) : False := by
      have cut (w : Word) (sw : ∀ t ∈ w, t ∈ [a,b,z]) : select [a,b] w = w := by
        apply selected_self; intro t ht
        have mem := sw t ht
        simp only [List.mem_cons,List.not_mem_nil,or_false] at mem hz ⊢
        rcases mem with h|h|h
        · exact .inl h
        · exact .inr h
        · exact h ▸ hz
      exact neq ((cut u su).symm.trans (fixed.trans (cut v sv)))
    exact ⟨fun e => separate (by simp [e]),fun e => separate (by simp [e])⟩
  have az := third.1.symm
  have bz := third.2.symm
  have twins := twin_edges (allow := allow) cu left ab az bz
  have counts := P455CellClassBinary.exact_counts cu valid
  have eA : Edge u r allow a z := by
    by_cases eq : select [a,z] u = select [a,z] v
    · have other : select [b,z] u ≠ select [b,z] v := fun s => neq (three_ext su sv counts fixed eq s)
      exact twins.mpr (changed_edges cu valid bz other).1
    · exact (changed_edges cu valid az eq).1
  have va := edge_persists cu valid az eA
  have vb := edge_persists cu valid bz (twins.mp eA)
  have ea := edge_no_links cv az va
  have eb := edge_no_links cv bz vb
  have rev : ¬ Link r v b a := by
    intro l
    have h := link_project cv l [a,b] (by simp) (by simp)
    rw [← fixed] at h
    exact no_opposite hr (select_cap _ cu) (link_project cu left _ (by simp) (by simp)) h
  have cmp : P455SourceFamilies.Compressed r v := by
    intro i j link
    obtain ⟨ci,cj⟩ := link_counts cv link
    have mi := sv i (List.count_pos_iff.mp (ci ▸ hr))
    have mj := sv j (List.count_pos_iff.mp (cj ▸ hr))
    simp only [List.mem_cons,List.not_mem_nil,or_false] at mi mj
    rcases mi with hi|hi|hi <;> rcases mj with hj|hj|hj <;> subst i <;> subst j <;>
      first | exact not_self hr cv link | exact failed link | exact rev link |
        exact ea.1 link | exact ea.2 link | exact eb.1 link | exact eb.2 link
  have structural : Structural v r allow :=
    .inl ⟨⟨[a,b,z],by simp,sv⟩,z,a,b,third.1,third.2,ab,
      va.elim Or.inr Or.inl,vb.elim Or.inr Or.inl⟩
  have fixedV := selected_self [a,b,z] v sv
  have eq := P455StructuralReflection.literal_projection hr cv (fun f => (valid f).symm)
    [a,b,z] (by simp) (by simpa only [fixedV] using structural) (by simpa only [fixedV] using cmp)
  exact neq (by simpa only [fixedV,selected_self [a,b,z] u su] using eq.symm)
theorem identity_link {r allow ts} (hr : 0 < r) {u v : Word} (cu : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (a b : Nat) :
    Link r u a b ↔ Link r v a b := by
  have counts := P455CellClassBinary.exact_counts cu valid
  have cv : Cap r v := fun i => counts i ▸ cu i
  have go {U V : Word} (cU : Cap r U) (cV : Cap r V)
      (ct : U.count a = V.count a) (idUV : (P455FullSingleton.model r allow ts).Valid U V)
      (l : Link r U a b) : Link r V a b := by
    apply link_of_triples cV (ct.symm.trans (link_counts cU l).1)
    intro z
    let k := [a,b,z]
    have cover (w : Word) (t : Nat) (h : t ∈ select k w) : t ∈ k := by simpa only [decide_eq_true_eq] using (List.mem_filter.mp h).2
    exact triple_invariant hr (select_cap _ cU) (select_cap _ cV) (select_valid _ k idUV)
      (cover U) (cover V) (link_project cU l k (by simp [k]) (by simp [k]))
  exact ⟨go cu cv (counts a) valid,go cv cu (counts a).symm (fun f => (valid f).symm)⟩
theorem compressed_instance {r allow ts} (hr : 0 < r) (u v : Word) (cu : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) :
    ∃ A B : Word, ∃ h : Nat → Word, (∀ z, h z ≠ []) ∧ A.flatMap h = u ∧ B.flatMap h = v ∧
      Cap r A ∧ Cap r B ∧ (P455FullSingleton.model r allow ts).Valid A B ∧
      P455SourceFamilies.Compressed r A ∧ P455SourceFamilies.Compressed r B := by
  have cv : Cap r v := fun i => P455CellClassBinary.exact_counts cu valid i ▸ cu i
  obtain ⟨A,B,h,n,e,f,ca,cb,ok,_,outcome⟩ := contract_common hr u v cu cv valid
  refine ⟨A,B,h,n,e,f,ca,cb,ok,?_⟩
  rcases outcome with done|⟨a,b,⟨l,miss⟩|⟨l,miss⟩⟩
  · exact done
  · exact (miss ((identity_link hr ca ok a b).mp l)).elim
  · exact (miss ((identity_link hr ca ok a b).mpr l)).elim
end P455Prefix
end
section
namespace P455CellClassClean
open P455RectangleRank P455CellClass P455CellClassFrames P455CellClassSnake
open P455Witness P455GridRows P455PortReflection P455SlotSaturation P455SingletonEvaluation
open P455CrossedSupport P455Paths P455TerminalTransfer P455ConstantLayout Problem455.Slots
abbrev W := List Nat
def SmallSlots (U : W) := ∀ o ∈ U, ∀ k, slotStart k → ∃ S : W,
  S.length ≤ 4 ∧ ∀ x, occupies U o k x → x ∈ S
def Ports (r : Nat) (allow : Tag → Prop) (ts : Tiles) (U : W) :=
  ∀ n : Node, Holds r allow noMark U (typedNode n) → Functional r allow noMark U ts n
theorem packed_counts {r allow t m z} (p : Phases r allow t m z)
    (names : ∀ x ∈ m++z,x < 2*t) (bits : Nat → Bool) (a : Nat) (mem : a ∈ word t m z bits) :
    (word t m z bits).count a = r := by
  have small := word_names _ names _ mem
  obtain ⟨_,co,cm,_⟩ := flip_counts (cap_word p.capped bits)
    (closedAt p bits (show a/2 < t by omega))
  have which : a = owner (a/2) ∨ a = mate (a/2) := by unfold owner mate; omega
  rcases which with eq|eq <;> first | exact eq ▸ co | exact eq ▸ cm
theorem record_roles {r allow mark t m z} (bits : Nat → Bool)
    (names : ∀ x ∈ m++z,x < 2*t) (finalPair : ∀ i < t,select [owner i,mate i] z=[owner i,mate i])
    (n : Node) (obs : Holds r allow mark (word t m z bits) (typedNode n)) :
    ∃ i < t,n.owner = owner i ∧ n.mate = mate i := by
  let w := word t m z bits
  obtain ⟨ne,len,tag,bit,pr⟩ := obs
  have mem : n.owner ∈ select [n.owner,n.mate] w := by
    dsimp only [w]; rw [pr]; simp [profile,profilePrefix]
  have lt := word_names bits names n.owner (List.mem_filter.mp mem).1
  let i := n.owner/2
  have ix : i < t := by dsimp [i]; omega
  have own : n.owner = owner i ∨ n.owner = mate i := by unfold owner mate i; omega
  have mat : n.mate = owner i ∨ n.mate = mate i := by
    apply Classical.byContradiction; intro bad
    have forb := P455Structural.no_external_record (r:=r) (allow:=allow) (private_closed ix m z bits) own
      ⟨fun e => bad (Or.inl e),fun e => bad (Or.inr e)⟩
    exact forb (.inl ⟨n.tag,ne,len,tag,bit,pr⟩)
  rcases own with one|one <;> rcases mat with two|two
  · exact False.elim (ne (one.trans two.symm))
  · exact ⟨i,ix,one,two⟩
  · rw [one,two,select_pair_symm (owner i) (mate i)] at pr
    have last := congrArg List.getLast? pr
    simp [word,select_append,finalPair i ix,profile,List.getLast?_append] at last
    unfold owner mate at last; omega
  · exact False.elim (ne (one.trans two.symm))
theorem all_bits {r allow mark t m z} (c value : Bool)
    (names : ∀ x ∈ m++z,x < 2*t) (finalPair : ∀ i < t,select [owner i,mate i] z=[owner i,mate i])
    (n : Node) (obs : Holds r allow mark (word t m z (constant c)) (markedNode n value)) : value = c := by
  obtain ⟨i,ix,o,a⟩ := record_roles (mark:=mark) (constant c) names finalPair n
    ⟨obs.1,obs.2.1,obs.2.2.1,value,obs.2.2.2.2⟩
  have pr := obs.2.2.2.2
  rw [o,a] at pr
  have known := read_bit ix m z (constant c) (finalPair i ix) n.tag ⟨value,pr⟩
  have eq := pr.symm.trans known
  have ne : owner i ≠ mate i := by simp [owner,mate]
  cases value <;> cases c <;> simp_all [constant,profile,pair]
private theorem slot_false {r allow mark t m z} (p : Phases r allow t m z)
    (names : ∀ x ∈ m++z,x < 2*t) (size : SmallSlots (word t m z (constant false)))
    (s : SlotCertificate) (b : Bool)
    (obs : Holds r allow mark (word t m z (constant b)) (s.query r)) : False := by
  obtain ⟨_,_,term⟩ := slot_route s obs
  let w := word t m z (constant b)
  let zero := word t m z (constant false)
  let o := endpoint (if s.startAtMate then s.anchor.mate else s.anchor.owner) s.steps
  change Holds r allow mark w (terminalSlot r o s.terminalIndex s.defect) at term
  let q := terminalSlot r o s.terminalIndex s.defect
  have atW : Holds r allow noMark w q := remark (P455GuardProduct.free_term ..) term
  have walk := chain_walk p.capped (chain p (constant b))
  have back : P455Quotient.Walk (P455Closure.Move r allow noMark) w zero :=
    walk.symm (fun mv => mv.symm)
  have atZ := back.transport atW (fun mv h => (query_invariant mv _).mp h)
  change Holds r allow noMark zero (terminalSlot r o s.terminalIndex s.defect) at atZ
  cases d : s.defect with
  | deficient a =>
    rw [d] at atZ
    obtain ⟨⟨_,j,events⟩,under⟩ := atZ
    have mem := stamped_mem_label _ _ (a,j) (events.subset (by simp))
    have ct := packed_counts p names (constant false) a mem
    change zero.count a < r at under
    change zero.count a = r at ct
    omega
  | overflow xs =>
    rw [d] at atZ
    obtain ⟨count,sep,all,_⟩ := atZ
    change xs.length = 5 at count
    have occupied (a : Nat) (h : a ∈ xs) :
        slotStart s.terminalIndex ∧ occupies zero o s.terminalIndex a := by
      have qh := (P455TerminalTransfer.holds_all _).mp all
        (.both (.count a r) (.slot o s.terminalIndex a)) (by simp [h])
      exact qh.2
    have someA : ∃ a, a ∈ xs := by cases xs with
                                    | nil => simp at count
                                    | cons a ys => exact ⟨a,List.mem_cons_self⟩
    obtain ⟨a,ha⟩ := someA
    obtain ⟨slot,j,ev⟩ := occupied a ha
    have ownMem := stamped_mem_label _ _ (o,s.terminalIndex) (ev.subset (by simp))
    obtain ⟨S,low,cover⟩ := size o ownMem s.terminalIndex slot
    have apart := (block_separation _).mp sep
    have nd : xs.Nodup := by
      apply (List.pairwise_cons.mp apart).2.imp_of_mem
      intro a b ha _ sep same
      subst b
      have req := (P455TerminalTransfer.holds_all _).mp all (.both (.count a r) (.slot o s.terminalIndex a))
        (List.mem_map.mpr ⟨a,ha,rfl⟩)
      have ca : Problem455Swap.occ a zero = r := (Problem455BlockBridge.occ_count ..).trans req.1
      exact sep ⟨ca,ca,.refl _⟩
    have le := P455FirstRewrite.size_le nd (fun x hx => cover _ (occupied _ hx).2)
    omega
theorem clean {r allow ts t m z} (p : Phases r allow t m z)
    (names : ∀ x ∈ m++z,x < 2*t) (finalPair : ∀ i < t,select [owner i,mate i] z=[owner i,mate i])
    (small : SmallSlots (word t m z (constant false))) (ports : Ports r allow ts (word t m z (constant false)))
    (bit : Bool) (x y : Nat) : ¬ Violation r allow ts (word t m z (constant bit)) x y := by
  rintro ⟨c,_,_,read⟩
  cases c with
  | slot s => exact slot_false p names small s bit read
  | functionality f =>
    obtain ⟨marked,nb,nc,different,_⟩ := read
    have atB := neighbor_remark (dst := noMark) nb
    have atC := neighbor_remark (dst := noMark) nc
    have recProof : Holds r allow noMark (word t m z (constant bit)) (typedNode f.anchor) :=
      ⟨marked.1,marked.2.1,marked.2.2.1,f.bit,marked.2.2.2.2⟩
    have walk := (chain_walk p.capped (chain p (constant bit))).symm (fun mv => mv.symm)
    have back (q : Query) (h : Holds r allow noMark (word t m z (constant bit)) q) :
        Holds r allow noMark (word t m z (constant false)) q :=
      walk.transport h (fun mv old => (query_invariant mv _).mp old)
    have eq := ports f.anchor (back _ recProof) f.dir f.b f.c (back _ atB) (back _ atC)
    change ¬ Problem455Swap.SameBlock r _ _ _ at different
    rw [eq] at different
    obtain ⟨ca,cb⟩ := record_counts (cap_word p.capped (constant bit)) (neighbor_target_record atC)
    have occ : Problem455Swap.occ (if f.distinguishMate then f.c.mate else f.c.owner)
        (word t m z (constant bit)) = r := by
      rw [Problem455BlockBridge.occ_count]
      cases b : f.distinguishMate <;> simp only [b,Bool.false_eq_true,if_false,if_true] <;> assumption
    exact different ⟨occ,occ,.refl _⟩
  | edge e =>
    have yes := all_bits bit true names finalPair e.a read.1
    have no := all_bits bit false names finalPair e.b read.2.1
    cases bit <;> contradiction
structure Data (r : Nat) (allow : Tag → Prop) (ts : Tiles) (t : Nat) (m z : W) where
  phases : Phases r allow t m z
  names : ∀ x ∈ m++z,x < 2*t
  finalPair : ∀ i < t,select [owner i,mate i] z=[owner i,mate i]
  small : SmallSlots (word t m z (constant false))
  ports : Ports r allow ts (word t m z (constant false))
  next : ∀ i, i+1 < t → At r allow ts (word t m z (constant false)) i (i+1)
  wrap : 0 < t → At r allow ts (word t m z (constant false)) (t-1) 0
def Data.geometry {r allow ts t m z} (d : Data r allow ts t m z) : Geometry r allow ts t m z :=
  ⟨d.phases,d.names,d.finalPair,fun bit i _ => clean d.phases d.names d.finalPair d.small d.ports bit
    (owner i) (mate i),d.next,d.wrap⟩
theorem no_basis {r allow ts} (hr : 0 < r)
    (padding : ∀ k : Nat, ∃ (t : Nat) (m z : W), k < 2*t ∧ Nonempty (Data r allow ts t m z))
    (basis : List (W × W)) (sound : ∀ u v, (u,v) ∈ basis → (P455FullSingleton.model r allow ts).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (P455FullSingleton.model r allow ts).Valid U V ∧
      ¬ P455FirstRewrite.Derives (fun u v => (u,v) ∈ basis) U V := by
  apply P455CellClassSnake.no_basis hr _ basis sound
  intro k; obtain ⟨t,m,z,g,⟨d⟩⟩ := padding k
  exact ⟨t,m,z,g,⟨d.geometry⟩⟩
end P455CellClassClean
end
section
namespace P455Prefix
open P455Quotient P455FirstRewrite P455Witness Problem455.Slots
open Problem455Swap (bigram Link hit)
def beforePair (a b z : Nat) : Word := if z = b then [a,b] else [z]
theorem recover_link_left {r a b} {w : Word} (hr : 0 < r) (cap : Cap r w) (l : Link r w a b) :
    (dropName a w).flatMap (beforePair a b) = w := by
  have ne : a ≠ b := fun e => not_self hr cap (e ▸ l)
  have restore (t : Word) (fresh : b ∉ t) : (dropName a (t.flatMap (openPair a b))).flatMap
      (beforePair a b) = t.flatMap (openPair a b) := by
    induction t with
    | nil => rfl
    | cons x t ih =>
      have xb : x ≠ b := fun e => fresh (e ▸ List.mem_cons_self)
      have tail := ih (fun h => fresh (List.mem_cons_of_mem _ h))
      simp only [List.flatMap_cons,dropName,List.filter_append,List.flatMap_append] at tail ⊢
      rw [tail]
      by_cases xa : x = a <;> simp [openPair,beforePair,xa,xb,ne,Ne.symm ne]
  have h := restore (dropName b w) (by simp)
  rwa [recover_link cap l] at h
theorem boundary_count (g : Nat → Word) (b c X Y : Nat) (last : (g b).getLast? = some X)
    (first : (g c).head? = some Y) (w : Word) :
    bigram b c w ≤ bigram X Y (w.flatMap g) := by
  induction w with
  | nil => simp [bigram]
  | cons j t ih =>
    rw [List.flatMap_cons,Problem455Swap.bigram_append]
    change hit b c (some j) t.head? + bigram b c t ≤ _
    by_cases h : j = b ∧ t.head?=some c
    · obtain ⟨rfl,p⟩ := h
      have head : (t.flatMap g).head? = some Y := by
        cases t with
        | nil => simp at p
        | cons x s =>
          have xc : x = c := Option.some.inj p
          subst x
          cases e : g c with
          | nil => simp [e] at first
          | cons k ks => simpa [e] using first
      simp [hit,p,last,head]; omega
    · simp [hit,h]; omega
private theorem computed_link {r b c X Y} {w v : Word} (cap : Cap r v) (g : Nat → Word)
    (recover : w.flatMap g = v) (edge : Link r w b c)
    (last : (g b).getLast? = some X) (first : (g c).head? = some Y) : Link r v X Y := by
  have low := boundary_count g b c X Y last first w
  rw [recover,show bigram b c w = r from edge] at low
  have top := Problem455Swap.out_bound X Y (Y+1) (by omega) v
  rw [Problem455BlockBridge.occ_count] at top
  have := cap X
  change bigram X Y v = r; omega
theorem inserted_between {r b c z} {w : Word} (hr : 0 < r) (cap : Cap r w)
    (after : Link r (dropName z w) b c) (split : ¬ Link r w b c)
    (anchored : ∃ p, Link r w p z ∨ Link r w z p) : Link r w b z ∧ Link r w z c := by
  obtain ⟨p,incoming|outgoing⟩ := anchored
  · have recover := recover_link cap incoming
    have head : ((openPair p z) c).head? = some c := by by_cases h : c = p <;> simp [openPair,h]
    have bp : b = p := by
      apply Classical.byContradiction; intro n
      exact split (computed_link cap _ recover after (by simp [openPair,n]) head)
    subst p
    exact ⟨incoming,computed_link cap _ recover after (by simp [openPair]) head⟩
  · have recover := recover_link_left hr cap outgoing
    have last : ((beforePair z p) b).getLast? = some b := by by_cases h : b = p <;> simp [beforePair,h]
    have cp : c = p := by
      apply Classical.byContradiction; intro n
      exact split (computed_link cap _ recover after last (by simp [beforePair,n]))
    subst p
    exact ⟨computed_link cap _ recover after last (by simp [beforePair]),outgoing⟩
theorem first_select (k w : Word) {a b : Nat} (ha : a ∈ k) (hb : b ∈ k) :
    (select k w).idxOf a < (select k w).idxOf b ↔ w.idxOf a < w.idxOf b := by
  induction w with
  | nil => rfl
  | cons x w ih =>
    by_cases xa : x = a <;> by_cases xb : x = b <;> by_cases keep : x ∈ k <;>
      simp_all [select,List.idxOf_cons,cond_eq_if,beq_iff_eq,Ne.symm]
theorem link_first {r a b} {w : Word} (hr : 0 < r) (cap : Cap r w) (l : Link r w a b) :
    w.idxOf a < w.idxOf b := by
  let k := [a,b]
  have ab : a≠b := fun e => not_self hr cap (e ▸ l)
  obtain ⟨ca,_⟩ := link_counts cap l
  have keep : a ∈ k := by simp [k]
  have inW : a ∈ select k w := List.mem_filter.mpr ⟨List.count_pos_iff.mp (ca ▸ hr),by simpa using keep⟩
  have link := link_project cap l k keep (by simp [k])
  have cp := P455DefectProjection.select_cap k cap
  apply (first_select k w keep (by simp [k])).mp
  cases e : select k w with
  | nil => simp [e] at inW
  | cons x t =>
    have m : x ∈ k := by
      have mem : x ∈ select k w := e ▸ List.mem_cons_self
      simpa only [decide_eq_true_eq] using (List.mem_filter.mp mem).2
    have nb : x≠b := by
      intro eq; subst x
      rw [e] at link cp
      have inc := Problem455Swap.in_bound a (a+1) b (by omega) (b::t)
      rw [Problem455BlockBridge.occ_count] at inc
      have total := (link_counts cp link).2
      change bigram a b (b::t) = r at link
      simp [List.count_cons] at inc total; omega
    have xa : x = a := by simpa [k,nb] using m
    subst x; simp [List.idxOf_cons,cond_eq_if,beq_iff_eq,ab,Ne.symm ab]
end P455Prefix
end
section
namespace P455PrivatePhase
open P455Witness P455Structural P455ChangedEvents P455Prefix P455DefectProjection
open P455ContactReflection Problem455.Slots
open Problem455Swap (Link)
abbrev W := List Nat
theorem edge_project {r allow u a b} (k : W) (ka : a∈k) (kb : b∈k) :
    Edge (select k u) r allow a b ↔ Edge u r allow a b := by
  have x := select_sub k [a,b] u (by simpa using And.intro ka kb)
  have y := select_sub k [b,a] u (by simpa using And.intro kb ka)
  simp only [Edge,Rec,Holds,x,y,typed] at *
theorem no_intruder {r allow ts u v a b} (cap : P455Closure.Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (recProof : Rec u r allow a b) (changed : ChangedPair u v a b)
    (isolated : ∀ z, z≠a → z≠b → ¬ Edge u r allow a z ∧ ¬ Edge u r allow b z)
    (z j : Nat) (za : z≠a) (zb : z≠b) : ¬ sees u [(a,0),(z,j),(b,2)] := by
  intro occurs
  obtain ⟨tag,ab,len,tagOk,bit,prof⟩ := recProof
  have hr : 0 < r := by omega
  let k := [a,b,z]
  let U := select k u
  have capU := select_cap k cap
  have sub : select [a,b] U = select [a,b] u := select_sub k [a,b] u (by simp [k])
  have binary : Rec U r allow a b := ⟨tag,ab,len,tagOk,bit,sub.trans prof⟩
  have record : Edge U r allow a b := .inl binary
  have nonAB := edge_no_links capU ab record
  have none := isolated z za zb
  have zaEdge : ¬Edge U r allow z a := by
    intro h
    exact none.1 ((edge_project k (by simp [k]) (by simp [k])).mp (h.elim Or.inr Or.inl))
  have zbEdge : ¬Edge U r allow z b := by
    intro h
    exact none.2 ((edge_project k (by simp [k]) (by simp [k])).mp (h.elim Or.inr Or.inl))
  have nonAZ : ¬ Link r U a z ∧ ¬ Link r U z a := by
    constructor
    · intro h; exact zbEdge ((twin_edges capU h za.symm ab zb).mp record)
    · intro h; exact zbEdge ((twin_edges capU h za zb ab).mpr record)
  have nonBZ : ¬ Link r U b z ∧ ¬ Link r U z b := by
    have ba : Edge U r allow b a := record.elim Or.inr Or.inl
    constructor
    · intro h; exact zaEdge ((twin_edges capU h zb.symm ab.symm za).mp ba)
    · intro h; exact zaEdge ((twin_edges capU h zb za ab.symm).mpr ba)
  have names (t) (m : t∈U) : t∈k := P455DefectRename.kept m
  have cmp : P455SourceFamilies.Compressed r U := by
    intro i l link
    obtain ⟨ci,cl⟩ := link_counts capU link
    have mi := names i (List.count_pos_iff.mp (ci ▸ hr))
    have ml := names l (List.count_pos_iff.mp (cl ▸ hr))
    simp only [k,List.mem_cons,List.not_mem_nil,or_false] at mi ml
    rcases mi with h|h|h <;> rcases ml with e|e|e <;> subst i <;> subst l <;>
      first | exact not_self hr capU link | exact nonAB.1 link | exact nonAB.2 link |
        exact nonAZ.1 link | exact nonAZ.2 link | exact nonBZ.1 link | exact nonBZ.2 link
  have obs := sees_select k u _ (by simp [k]) occurs
  have st : Structural U r allow := .inr ⟨⟨k,by simp [k],names⟩,a,b,z,j,ab,za,zb,binary,obs⟩
  have eq := P455StructuralReflection.literal_projection hr cap valid k (by simp [k]) st cmp
  have ext := congrArg (select [a,b]) eq
  rw [select_sub k [a,b] u (by simp [k]),select_sub k [a,b] v (by simp [k])] at ext
  exact changed ext
private theorem peel (k : W) {w : W} (x : Nat) (t : W) (eq : select k w = x::t) :
    ∃ l r, w = l++x::r ∧ select k l=[] ∧ select k r = t := by
  induction w with
  | nil => cases eq
  | cons a w ih =>
    by_cases keep : a∈k
    · have ⟨e,tail⟩ := List.cons.inj (show a::select k w = x::t by simpa [select,keep] using eq)
      exact ⟨[],w,by simp [e],rfl,tail⟩
    · obtain ⟨l,r,mid,el,er⟩ := ih (by simpa [select,keep] using eq)
      exact ⟨a::l,r,by simp [mid],by simpa [select,keep] using el,er⟩
private theorem cut (k : W) (p : W) (x : Nat) (t : W) (w : W)
    (eq : select k w = p++x::t) : ∃ m z, w = m++x::z ∧ select k m = p ∧ select k z = t := by
  induction p generalizing w with
  | nil => exact peel k x t eq
  | cons a p ih =>
    obtain ⟨l,r,f,el,er⟩ := peel k a (p++x::t) eq
    have keptA : a∈k := P455DefectRename.kept (keep:=k) (w:=w) (a:=a) (by rw [eq]; simp)
    obtain ⟨m,z,mz,em,ez⟩ := ih r er
    refine ⟨l++a::m,z,?_,?_,ez⟩
    · simp [f,mz,List.append_assoc]
    · rw [select_append,el]; simpa [select,keptA] using congrArg (List.cons a) em
private theorem stamped_three (l p q t : W) (a z b : Nat) :
    sees (l ++ a :: (p ++ z :: (q ++ b :: t)))
      [(a,l.count a),(z,(l++a::p).count z),(b,(l++a::(p++z::q)).count b)] := by
  let n₁ := advance (fun _ => 0) l
  let n₂ := advance (advance n₁ [a]) p
  let n₃ := advance (advance n₂ [z]) q
  have one : n₁ a = l.count a := by simp [n₁,advance]
  have two : n₂ z = (l++a::p).count z := by
    simp [n₁,n₂,advance,List.count_cons,List.count_append,beq_iff_eq]; omega
  have three : n₃ b = (l++a::(p++z::q)).count b := by
    simp [n₁,n₂,n₃,advance,List.count_cons,List.count_append,beq_iff_eq]; omega
  unfold sees events
  rw [← one,← two,← three]
  simp only [stamp_append,stamp]
  have end' : [(b,n₃ b)].Sublist ((b,n₃ b)::stamp (advance n₃ [b]) t) :=
    List.singleton_sublist.mpr List.mem_cons_self
  have qq := end'.trans (List.sublist_append_right (stamp (advance n₂ [z]) q) _)
  have zz := qq.cons₂ (z,n₂ z)
  have pp := zz.trans (List.sublist_append_right (stamp (advance n₁ [a]) p) _)
  exact (pp.cons₂ (a,n₁ a)).trans (List.sublist_append_right _ _)
theorem closed_of_no_intruder {w : W} {a b : Nat} (ab : a≠b)
    (profileStart : ∃ t : W, select [a,b] w = P455Structural.early a b++t)
    (none : ∀ z j, z≠a → z≠b → ¬sees w [(a,0),(z,j),(b,2)]) :
    P455Structural.Closed w a b := by
  obtain ⟨t,eq⟩ := profileStart
  let k := [a,b]
  obtain ⟨l,r,first,l0,rest⟩ := peel k a ([a,b,a,b,b]++t) eq
  obtain ⟨m,z,last,middle,_⟩ := cut k [a,b,a,b] b t r rest
  have ca : l.count a = 0 := by
    rw [← select_count k l a (by simp [k]),l0]; rfl
  have cb : l.count b = 0 := by
    rw [← select_count k l b (by simp [k]),l0]; rfl
  have two : m.count b = 2 := by
    rw [← select_count k m b (by simp [k]),middle]
    simp [List.count_cons,ab,Ne.symm ab]
  have sel : select k m = m := by
    apply List.filter_eq_self.mpr
    intro d mem
    by_cases da : d = a
    · simp [k,da]
    by_cases db : d = b
    · simp [k,db]
    obtain ⟨p,q,ms⟩ := List.append_of_mem mem
    have triple := stamped_three l p q z a d b
    have pos : (l++a::(p++d::q)).count b = 2 := by
      rw [← ms]; simp [List.count_cons,ab,Ne.symm ab,cb,two]
    rw [ca,pos] at triple
    apply False.elim (none d ((l++a::p).count d) da db ?_)
    simpa [first,last,ms,List.append_assoc] using triple
  refine ⟨ab,l,z,?_,List.count_eq_zero.mp ca,List.count_eq_zero.mp cb⟩
  have small := sel.symm.trans middle
  simp [first,last,small,P455Structural.early,List.append_assoc]
theorem closed_changed {r allow ts u v a b} (cap : P455Closure.Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (recProof : Rec u r allow a b) (changed : ChangedPair u v a b)
    (isolated : ∀ z, z≠a → z≠b → ¬ Edge u r allow a z ∧ ¬ Edge u r allow b z) :
    P455Structural.Closed u a b := by
  have ban := no_intruder cap valid recProof changed isolated
  obtain ⟨tag,ab,_,_,bit,eq⟩ := recProof
  apply closed_of_no_intruder ab _ ban
  exact ⟨_,by simpa [profile,profilePrefix,P455Structural.early,List.append_assoc] using eq⟩
end P455PrivatePhase
end
section
namespace P455Prefix
open P455FirstRewrite P455Quotient
theorem normalized_compressed {r allow ts} (hr : 0 < r) {u v : Word}
    (valid : (P455FullSingleton.model r allow ts).Valid u v) :
    ∃ A B : Word, ∃ h : Nat → Word,
      (∀ z, h z ≠ []) ∧ Cap r A ∧ Cap r B ∧
      P455SourceFamilies.Compressed r A ∧ P455SourceFamilies.Compressed r B ∧
      (P455FullSingleton.model r allow ts).Valid A B ∧
      A.flatMap h = residual (highNames r u) u ∧ B.flatMap h = residual (highNames r u) v ∧
      Derives (Steps r allow ts) u (headPowers r (highNames r u) ++ A.flatMap h) ∧
      Derives (Steps r allow ts) v (headPowers r (highNames r u) ++ B.flatMap h) ∧
      (∀ k, Derives (fun p q => (P455FullSingleton.model r allow ts).Valid p q ∧ rank p q ≤ k) A B →
        Derives (fun p q => (P455FullSingleton.model r allow ts).Valid p q ∧
          rank p q ≤ max k (2*(r+2)+1)) u v) := by
  obtain ⟨left,right,cu,_,suffixID,_⟩ := arbitrary_prefix valid
  obtain ⟨A,B,h,non,hu,hv,ca,cb,idAB,cmpA,cmpB⟩ := compressed_instance hr _ _ cu suffixID
  refine ⟨A,B,h,non,ca,cb,cmpA,cmpB,idAB,hu,hv,?_,?_,?_⟩
  · rw [hu]; exact left
  · rw [hv]; exact right
  · intro k walk
    apply reassemble valid
    simpa only [hu,hv] using substitute_deduction h non walk
end P455Prefix
end
section
namespace P455CellClassPadded
open P455CellClassFrames P455RectangleRank P455PaddedWord P455Witness P455Closure
open Problem455.Slots
abbrev W := List Nat
private theorem part {α : Type} (f : α → W) {xs : List α} {x : α} (mem : x ∈ xs) :
    (f x).Sublist (xs.flatMap f) := by
  obtain ⟨l,k,rfl⟩ := List.append_of_mem mem
  simp only [List.flatMap_append,List.flatMap_cons]
  exact (List.sublist_append_left ..).trans (List.sublist_append_right ..)
private theorem parts (s : List Nat) (f g : Nat → W)
    (each : ∀ i ∈ s, (f i).Sublist (g i)) : (s.flatMap f).Sublist (s.flatMap g) := by
  induction s with
  | nil => exact .refl _
  | cons c cs ih =>
    exact (each c List.mem_cons_self).append (ih (fun j h => each j (List.mem_cons_of_mem _ h)))
private theorem port_sublist {bs : List P455PaddedPorts.Block} {i : Nat}
    (hi : i∈bs.flatMap P455PaddedPorts.cells) :
    (P455PaddedPorts.roles i ++ P455PaddedPorts.roles i).Sublist (P455PaddedPorts.letters bs) := by
  obtain ⟨block,m,inBlock⟩ := List.mem_flatMap.mp hi
  have v := part P455PaddedPorts.roles inBlock
  have piece := part (fun b => (P455PaddedPorts.cells b ++ P455PaddedPorts.cells b).flatMap P455PaddedPorts.roles) m
  simp only [P455PaddedPorts.letters,P455PaddedPorts.phase,List.flatMap_assoc]
  apply List.Sublist.trans _ piece
  try dsimp only
  rw [List.flatMap_append]; exact v.append v
private theorem ports {h w i : Nat} (size : 1 < w*h) (ix : i < w*h) (k : Nat) :
    (List.replicate k (P455PaddedPorts.roles i ++ P455PaddedPorts.roles i)).flatten.Sublist
      (portChunks h w k) := by
  induction k with
  | zero => exact .refl _
  | succ k ih =>
    have split : portChunks h w (k+1) = portChunks h w k ++ P455PaddedPorts.letters (matching h w k) := by
      simp [portChunks,List.range_succ]
    rw [split,List.replicate_succ',List.flatten_append]; simp only [List.flatten_cons,List.flatten_nil,List.append_nil]
    exact ih.append (port_sublist ((matching_cells size k i).mpr ix))
private theorem enumerate (bs : List Bool) :
    (List.range bs.length).map (fun k => bs[k]?.getD false) = bs := by
  apply List.ext_getElem (by simp)
  intro j _ hj; simp [List.getElem?_eq_getElem hj]
private theorem tag_chunk (x y : Nat) (b : Bool) :
    (phasePair b).map (token x y) = pair x y b := by cases b <;> rfl
theorem tokens {h w k : Nat} (size : 1 < w*h) (tag : Nat → Tag)
    (length : ∀ i < w*h, (tag i).length = k) {i : Nat} (ix : i < w*h) :
    (P455CellClassFrames.phase (owner i) (mate i) (tag i)).Sublist (middle h w k tag) := by
  have fromTags := parts (List.range k)
      (fun j => pair (owner i) (mate i) ((tag i)[j]?.getD false)) (tagPhase (w*h) tag)
      (by intro j _; exact part (mutableCell (fun u => (tag u)[j]?.getD false)) (List.mem_range.mpr ix))
  have proj : (tag i).flatMap (pair (owner i) (mate i)) =
      (List.range k).flatMap (fun j => pair (owner i) (mate i) ((tag i)[j]?.getD false)) := by
    conv => lhs; arg 2; rw [← enumerate (tag i)]
    rw [List.flatMap_map,length i ix]
  rw [← proj] at fromTags
  have col := part P455PaddedPorts.roles ((columns_cells h w i).mpr ix)
  have mid := (ports size ix 5).append (fromTags.append col)
  have shape : P455CellClassFrames.phase (owner i) (mate i) (tag i) =
      (List.replicate 5 (P455PaddedPorts.roles i ++ P455PaddedPorts.roles i)).flatten ++
        ((tag i).flatMap (pair (owner i) (mate i)) ++ P455PaddedPorts.roles i) := by
    unfold P455CellClassFrames.phase fixedPhases
    simp only [List.map_append,List.map_flatMap, tag_chunk,List.append_assoc]
    rfl
  rw [shape]
  simpa only [middle,suffix,List.append_assoc] using mid
private theorem role_small {i t a : Nat} (ix : i < t) (hr : a = owner i ∨ a = mate i) : a < 2*t := by
  unfold owner mate at hr; omega
theorem names {h w : Nat} (size : 1 < w*h) (k : Nat) (tag : Nat → Tag) (a : Nat)
    (mem : a∈middle h w k tag ++ tail (w*h)) : a < 2*(w*h) := by
  have roleMem (j : Nat) (ix : j < w*h) (m : a∈P455PaddedPorts.roles j) :=
    role_small ix (by simpa [P455PaddedPorts.roles] using m : a = owner j ∨ a = mate j)
  have mutMem (f : Nat → Bool) (j : Nat) (ix : j < w*h) (m : a∈mutableCell f j) : a < 2*(w*h) := by
    apply role_small ix
    cases b : f j <;> simpa [mutableCell,b,or_comm] using m
  simp only [middle,suffix,tail,portChunks,tagPhase,List.mem_append,List.mem_flatMap] at mem
  rcases mem with (⟨d,_,p⟩|(⟨_,_,j,inR,m⟩|⟨j,jc,m⟩))|⟨j,jr,m⟩
  · obtain ⟨j,mj,ma⟩ := List.mem_flatMap.mp p
    obtain ⟨block,inB,hj⟩ := List.mem_flatMap.mp mj
    have cell : j∈P455PaddedPorts.cells block := by simpa using hj
    exact roleMem j ((matching_cells size d j).mp (List.mem_flatMap.mpr ⟨block,inB,cell⟩)) ma
  · exact mutMem _ j (List.mem_range.mp inR) m
  · exact roleMem j ((columns_cells h w j).mp jc) m
  · exact mutMem _ j (List.mem_range.mp jr) m
def phases {h w k : Nat} {allow : Tag → Prop} (size : 1 < w*h) (tag : Nat → Tag)
    (length : ∀ i < w*h, (tag i).length = k) (allowed : ∀ i < w*h,allow (tag i))
    :
    Phases (k+16) allow (w*h) (middle h w k tag) (tail (w*h)) where
  tag := tag
  length := fun i hi => by rw [length i hi]
  allowed := allowed
  tokens := fun _ hi => tokens size tag length hi
  finalPair := fun i hi => (P455CellClass.canonical_final (w*h) i hi) ▸ List.filter_sublist
  capped := P455PaddedWord.capped size tag _
end P455CellClassPadded
end
section
namespace P455Prefix
open P455Quotient P455FirstRewrite P455Witness P455Structural Problem455.Slots
open P455DefectProjection (select_cap select_sub)
open Problem455Swap (Link)
def Changed (u v : Word) (a b : Nat) := select [a,b] u ≠ select [a,b] v
theorem changed_symm {u v a b} : Changed u v a b ↔ Changed u v b a := by
  unfold Changed; rw [select_swap a b u,select_swap a b v]
theorem subpair (keep w : Word) {a b : Nat} (ha : a ∈ keep) (hb : b ∈ keep) :
    select [a,b] (select keep w) = select [a,b] w :=
  select_sub _ _ _ (by simpa using And.intro ha hb)
theorem selected_change (keep : Word) {u v a b} (ha : a ∈ keep) (hb : b ∈ keep) :
    Changed (select keep u) (select keep v) a b ↔ Changed u v a b := by
  simp only [Changed,subpair keep _ ha hb]
theorem selected_edge (keep : Word) {r allow w a b} (ab : a ≠ b) (ha : a ∈ keep) (hb : b ∈ keep) :
    Edge (select keep w) r allow a b ↔ Edge w r allow a b := by
  rw [edge_iff ab,edge_iff ab,subpair keep _ ha hb]
private theorem overlapping_projection {r allow ts u v a b c} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (keep : Word) (small : keep.length ≤ 4) (ha : a∈keep) (hb : b∈keep) (hc : c∈keep)
    (ab : a ≠ b) (ac : a ≠ c) (bc : b ≠ c) (edit : Changed u v a b) (ec : Edge u r allow a c) :
    ∃ i j, Link r (select keep u) i j := by
  classical
  have eb := (changed_edges cap valid ab edit).1
  have overlap : Structural (select keep u) r allow := .inl ⟨⟨keep,small,
    fun _ m => by simpa only [decide_eq_true_eq] using (List.mem_filter.mp m).2⟩,
    a,b,c,ab,ac,bc,(selected_edge keep ab ha hb).mpr eb,(selected_edge keep ac ha hc).mpr ec⟩
  apply Classical.byContradiction; intro empty
  have cmp : P455SourceFamilies.Compressed r (select keep u) := fun i j l => empty ⟨i,j,l⟩
  have eq := P455StructuralReflection.literal_projection hr cap valid keep small overlap cmp
  have diff := (selected_change keep ha hb).mpr edit
  exact diff (congrArg (select [a,b]) eq)
private theorem link_names {r w i j} (hr : 0 < r) (cap : Cap r w) (l : Link r w i j) : i∈w ∧ j∈w := by
  obtain ⟨x,y⟩ := link_counts cap l
  exact ⟨List.count_pos_iff.mp (x ▸ hr),List.count_pos_iff.mp (y ▸ hr)⟩
theorem neighbors_link {r allow ts u v a b c} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v)
    (ab : a≠b) (ac : a≠c) (bc : b≠c) (edit : Changed u v a b) (ec : Edge u r allow a c) :
    Link r (select [a,b,c] u) b c ∨ Link r (select [a,b,c] u) c b := by
  let k := [a,b,c]
  have cp := select_cap k cap
  obtain ⟨i,j,l⟩ := overlapping_projection hr cap valid k (by simp [k]) (by simp [k]) (by simp [k])
    (by simp [k]) ab ac bc edit ec
  have m := link_names hr cp l
  have hi : i ∈ k := by simpa only [decide_eq_true_eq] using (List.mem_filter.mp m.1).2
  have hj : j ∈ k := by simpa only [decide_eq_true_eq] using (List.mem_filter.mp m.2).2
  have p := edge_no_links cp ab ((selected_edge k ab (by simp [k]) (by simp [k])).mpr
    (changed_edges cap valid ab edit).1)
  have q := edge_no_links cp ac ((selected_edge k ac (by simp [k]) (by simp [k])).mpr ec)
  simp only [k,List.mem_cons,List.not_mem_nil,or_false] at hi hj
  rcases hi with hi|hi|hi <;> rcases hj with hj|hj|hj <;> subst i <;> subst j <;>
    first | exact (not_self hr cp l).elim | exact (p.1 l).elim | exact (p.2 l).elim |
      exact (q.1 l).elim | exact (q.2 l).elim | exact .inl l | exact .inr l
private theorem split_four {r u a b c} (cap : Cap r u) (cmp : P455SourceFamilies.Compressed r u)
    (l : Link r (select [a,b,c] u) b c) :
    ∃ z, z ∉ [a,b,c] ∧ ¬ Link r (select [a,b,c,z] u) b c := by
  classical
  have count : u.count b = r := by
    have x := (link_counts (select_cap _ cap) l).1
    rwa [P455DefectProjection.select_count _ _ _ (by simp)] at x
  have miss : ∃ z, ¬ Link r (select [a,b,c,z] u) b c := by
    apply Classical.byContradiction; intro none
    apply cmp b c (link_of_triples cap count ?_)
    intro z
    have four : Link r (select [a,b,c,z] u) b c := Classical.byContradiction (fun f => none ⟨z,f⟩)
    have tri := link_project (select_cap _ cap) four [b,c,z] (by simp) (by simp)
    rwa [select_sub _ _ _ (by simp)] at tri
  obtain ⟨z,f⟩ := miss
  refine ⟨z,?_,f⟩
  intro old
  have eq : select [a,b,c,z] u = select [a,b,c] u := by
    unfold select; apply List.filter_congr; intro t _
    by_cases e : t = z
    · subst t; simp at old; simp [old]
    · simp [e]
  exact f (eq ▸ l)
private theorem drop_four {a b c z} (fresh : z ∉ [a,b,c]) (w : Word) :
    dropName z (select [a,b,c,z] w) = select [a,b,c] w := by
  simp only [dropName,select,List.filter_filter]
  apply List.filter_congr; intro t _
  by_cases e : t = z
  · subst t; simp at fresh; simp [fresh]
  · simp [e]
theorem intermediate_neighbor {r allow ts u v a b c} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (cmp : P455SourceFamilies.Compressed r u)
    (ab : a≠b) (ac : a≠c) (bc : b≠c) (eb : Changed u v a b) (ec : Changed u v a c)
    (order : u.idxOf b < u.idxOf c) :
    ∃ z, a≠z ∧ b≠z ∧ c≠z ∧ Changed u v a z ∧ u.idxOf b < u.idxOf z ∧ u.idxOf z < u.idxOf c := by
  let k := [a,b,c]
  have ecR := (changed_edges cap valid ac ec).1
  have base : Link r (select k u) b c := by
    rcases neighbors_link hr cap valid ab ac bc eb ecR with l|l
    · exact l
    · have rev := (first_select k u (by simp [k] : c∈k) (by simp [k] : b∈k)).mp
        (link_first hr (select_cap k cap) l)
      omega
  obtain ⟨z,fresh,bad⟩ := split_four cap cmp base
  let four := [a,b,c,z]
  let U := select four u
  let V := select four v
  have zne : z≠a ∧ z≠b ∧ z≠c := by simpa using fresh
  have ma : a∈four := by simp [four]
  have mb : b∈four := by simp [four]
  have mc : c∈four := by simp [four]
  have mz : z∈four := by simp [four]
  have cp : Cap r U := select_cap _ cap
  have id4 := select_valid _ four valid
  have vcap : Cap r V := fun t => P455CellClassBinary.exact_counts cp id4 t ▸ cp t
  have reverse : ¬ Link r U c b := by
    intro l
    have to3 := link_project cp l k (by simp [k]) (by simp [k])
    have eq : select k U = select k u := select_sub _ _ _ (by simp [k,four])
    exact no_opposite hr (select_cap k cap) base (eq ▸ to3)
  have forb := edge_no_links cp ab ((selected_edge four ab ma mb).mpr (changed_edges cap valid ab eb).1)
  have forc := edge_no_links cp ac ((selected_edge four ac ma mc).mpr ecR)
  obtain ⟨i,j,l⟩ := overlapping_projection hr cap valid four (by simp [four]) ma mb mc ab ac bc eb ecR
  have anchor : ∃ p, Link r U p z ∨ Link r U z p := by
    obtain ⟨pi,pj⟩ := link_names hr cp l
    have hi : i∈four := by simpa only [decide_eq_true_eq] using (List.mem_filter.mp pi).2
    have hj : j∈four := by simpa only [decide_eq_true_eq] using (List.mem_filter.mp pj).2
    simp only [four,List.mem_cons,List.not_mem_nil,or_false] at hi hj
    rcases hi with hi|hi|hi|hi <;> rcases hj with hj|hj|hj|hj <;> subst i <;> subst j <;>
      first | exact (not_self hr cp l).elim | exact (forb.1 l).elim | exact (forb.2 l).elim |
        exact (forc.1 l).elim | exact (forc.2 l).elim | exact (bad l).elim | exact (reverse l).elim |
        exact ⟨_,.inl l⟩ | exact ⟨_,.inr l⟩
  have dropped : dropName z U = select k u := drop_four fresh u
  obtain ⟨bz,zc⟩ := inserted_between hr cp (dropped ▸ base) bad anchor
  have bv := (identity_link hr cp id4 b z).mp bz
  have du := linked_shadow cp bz zne.2.1.symm ab.symm zne.1
  have dv := linked_shadow vcap bv zne.2.1.symm ab.symm zne.1
  have ch : Changed U V a z := by
    intro equal
    have e := congrArg (List.map (exchange b z)) ((select_swap z a U).trans (equal.trans (select_swap a z V)))
    rw [du,dv] at e
    exact (selected_change four ma mb).mpr eb ((select_swap a b U).trans (e.trans (select_swap b a V)))
  exact ⟨z,zne.1.symm,zne.2.1.symm,zne.2.2.symm,(selected_change four ma mz).mp ch,
    (first_select four u mb mz).mp (link_first hr cp bz),(first_select four u mz mc).mp (link_first hr cp zc)⟩
theorem disjoint_changes {r allow ts u v a b c} (hr : 0 < r) (cap : Cap r u)
    (valid : (P455FullSingleton.model r allow ts).Valid u v) (cmp : P455SourceFamilies.Compressed r u)
    (ab : a≠b) (ac : a≠c) (eb : Changed u v a b) (ec : Changed u v a c) : b = c := by
  classical
  by_cases bc : b = c
  · exact bc
  have no (d : Nat) : ∀ i j, u.idxOf j-u.idxOf i = d → a≠i → a≠j → i≠j →
      Changed u v a i → Changed u v a j → u.idxOf i < u.idxOf j → False := by
    induction d using Nat.strongRecOn with
    | ind d ih =>
      intro i j length ai aj ij ei ej order
      obtain ⟨z,az,iz,_,ez,lower,upper⟩ := intermediate_neighbor hr cap valid cmp ai aj ij ei ej order
      exact ih (u.idxOf z-u.idxOf i) (by omega) i z rfl ai az iz ei ez lower
  rcases neighbors_link hr cap valid ab ac bc eb (changed_edges cap valid ac ec).1 with l|l
  · have lt := (first_select [a,b,c] u (by simp : b∈[a,b,c]) (by simp : c∈[a,b,c])).mp
      (link_first hr (select_cap _ cap) l)
    exact (no _ b c rfl ab ac bc eb ec lt).elim
  · have lt := (first_select [a,b,c] u (by simp : c∈[a,b,c]) (by simp : b∈[a,b,c])).mp
      (link_first hr (select_cap _ cap) l)
    exact (no _ c b rfl ac ab (Ne.symm bc) ec eb lt).elim
end P455Prefix
end
