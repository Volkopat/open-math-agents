section
namespace P455EffectiveQRaw
open P455Quotient P455EffectiveQ P455Table P455TableProduct
abbrev Raw := Option W
def distinctRaw (rel : Raw → Raw → Bool) : List Raw → List Raw
  | [] => []
  | a::xs => if xs.any (rel a) then distinctRaw rel xs else a::distinctRaw rel xs
def labels (e : W → W → Bool) (T : W) :=
  distinctRaw (relB e T) (none :: (words T).map some)
def index (e : W → W → Bool) (T : W) (x : Raw) :=
  (labels e T).findIdx fun y => relB e T x y
def rows (e : W → W → Bool) (T : W) :=
  (labels e T).map fun a => (labels e T).map fun b => index e T (mulRaw a b)
theorem same (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) (a b : Raw) : relB e T a b = true ↔ cls R T a = cls R T b :=
  (rel_iff R e correct T a b).trans ⟨fun h => Quotient.sound (s := setoid R T) h,fun h => Quotient.exact h⟩
theorem map_distinct (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) (xs : List Raw) :
    (distinctRaw (relB e T) xs).map (cls R T) =
    @distinct (Q R T) (P455EffectiveQ.decEq R e correct T) (xs.map (cls R T)) := by
  letI := P455EffectiveQ.decEq R e correct T
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    have test : xs.any (relB e T a) = true ↔ cls R T a ∈ xs.map (cls R T) := by
      simp only [List.any_eq_true,List.mem_map,same R e correct]
      exact exists_congr fun x => and_congr_right fun _ => eq_comm
    by_cases hx : cls R T a∈xs.map (cls R T)
    · simp [List.map_cons,distinctRaw,distinct,hx,test.mpr hx,ih]
    · have neg : xs.any (relB e T a) = false := Bool.eq_false_iff.mpr (fun h => hx (test.mp h))
      simp [List.map_cons,distinctRaw,distinct,hx,neg,ih]
theorem map_labels (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) : (labels e T).map (cls R T) =
    @distinct _ (P455EffectiveQ.decEq R e correct T) (Problem455Finite.carrier R T) := by
  have same : (none :: (words T).map some).map (cls R T) = Problem455Finite.carrier R T := by
    simp only [List.map_cons, List.map_map]
    rfl
  rw [←same]
  exact map_distinct R e correct T (none :: (words T).map some)
theorem all_labels (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) (q : Q R T) : q ∈ (labels e T).map (cls R T) := by
  letI := P455EffectiveQ.decEq R e correct T
  rw [map_labels R e correct]
  exact (mem_distinct _ _).mpr (Problem455Finite.carrier_complete R T q)
theorem labels_nodup (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) : ((labels e T).map (cls R T)).Nodup := by
  letI := P455EffectiveQ.decEq R e correct T
  rw [map_labels R e correct]
  exact nodup_distinct _
def number (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) (x : Raw) : Fin (labels e T).length :=
  ⟨index e T x,by
    apply List.findIdx_lt_length_of_exists
    obtain ⟨y,ym,eq⟩ := List.mem_map.mp (all_labels R e correct T (cls R T x))
    exact ⟨y,ym,(same R e correct T ..).mpr eq.symm⟩⟩
theorem decode_number (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) (x : Raw) : cls R T ((labels e T).get (number R e correct T x)) = cls R T x := by
  apply ((same R e correct T ..).mp _).symm
  exact List.findIdx_getElem (w := (number R e correct T x).isLt)
def ops (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) : FiniteOps where
  size := (labels e T).length
  one := number R e correct T (some [])
  mul i j := number R e correct T (mulRaw ((labels e T).get i) ((labels e T).get j))
def presentation (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) (cap : Cap R.r T) : Presents (ops R e correct T) (quotientModel R T cap) where
  decode i := cls R T ((labels e T).get i)
  one_eq := decode_number R e correct T (some [])
  mul_eq i j := decode_number R e correct T _
  inj i j eq := by
    apply Fin.ext
    let xs := (labels e T).map (cls R T)
    have il : i.val < xs.length := by simpa only [xs,List.length_map] using (show i.val < (labels e T).length from i.isLt)
    have jl : j.val < xs.length := by simpa only [xs,List.length_map] using (show j.val < (labels e T).length from j.isLt)
    apply (List.getElem?_inj (l := xs) il (labels_nodup R e correct T)).mp
    change xs[i.val]? = xs[j.val]?
    rw [List.getElem?_eq_getElem il,List.getElem?_eq_getElem jl]
    dsimp only [xs]
    rw [List.getElem_map, List.getElem_map]
    exact congrArg some eq
  surj a := by
    obtain ⟨v,vm,h⟩ := List.mem_map.mp (all_labels R e correct T a)
    obtain ⟨i,hi,atI⟩ := List.getElem_of_mem vm
    exact ⟨⟨i,hi⟩,(congrArg (cls R T) atI).trans h⟩
private theorem tabulate (xs : List α) (f : α → β) :
    (List.finRange xs.length).map (fun i => f (xs.get i)) = xs.map f := by
  apply List.ext_getElem
  · simp
  · intro i lt rt; simp
theorem matrix_eq (R : Rules Nat) (e : W → W → Bool) (correct : ∀ u v,e u v = true ↔ R.step u v) (T : W) : matrix (ops R e correct T) = rows e T := by
  unfold matrix rows ops
  change (List.finRange (labels e T).length).map (fun i => (List.finRange (labels e T).length).map
    (fun j => index e T (mulRaw ((labels e T).get i) ((labels e T).get j)))) = _
  let n := labels e T
  let row (a : Raw) := n.map fun b => index e T (mulRaw a b)
  have inner (i : Fin n.length) : (List.finRange n.length).map
      (fun j => index e T (mulRaw (n.get i) (n.get j))) = row (n.get i) :=
    tabulate n (fun b => index e T (mulRaw (n.get i) b))
  exact (List.map_congr_left (fun i _ => inner i)).trans (tabulate n row)
end P455EffectiveQRaw
end
section
namespace P455Packed
open P455Table P455TableProduct P455TableFactors P455NumericProduct P455IndexedProduct
open P455PaddedTiles P455FirstRewrite P455Quotient
abbrev Spec := List Nat × Option (List (Nat × Nat))
structure Payload where
  r : Nat
  tags : List (List Bool)
  primitive : List Spec
  guard : List Spec
  edge : List Spec
  binary : List Spec
  structural : List Spec
def moves (r : Nat) (tags : List (List Bool)) (marks : Option (List (Nat×Nat))) :
    List Nat → List Nat → Bool := match marks with
  | none => fun _ _ => false
  | some pairs => P455EffectiveQMove.moveB r tags (fun a b => decide ((a,b)∈pairs))
def factorRows (r : Nat) (tags : List (List Bool)) (s : Spec) :=
  P455EffectiveQRaw.rows (moves r tags s.2) s.1
def serialize (p : Payload) : Matrix :=
  let group := fun (xs : List Spec) => assemble (xs.map (factorRows p.r p.tags))
  tensor (group p.primitive)
    (tensor (tensor (group p.guard) (group p.edge)) (tensor (group p.binary) (group p.structural)))
def names {I : Type} (c : Listing I) (record : I → Spec) :=
  letI := c.eq
  (distinct c.items).map record
def primSpec (i : P455FirstTesters.Index r) : Spec := (i.val,none)
def structSpec (i : P455StructuralProduct.Index r allow) : Spec := (i.T,none)
def binSpec (i : P455BinaryProduct.Index r allow) : Spec := (i.T,if i.prof then some [] else none)
def oneSpec (i : P455GuardProduct.Index r allow ts) : Spec := (i.T,some [(i.a.val,i.b.val)])
def twoSpec (i : P455EdgeProduct.Index r allow ts) : Spec :=
  (i.T,some [(i.a.val,i.b.val),(i.c.val,i.d.val)])
def prepared {n} (M : MachineTable n) : Payload :=
  let C := P455Encoded.indices M
  ⟨widthCode n+16,P455Enum.tags M,names C.primitive primSpec,names C.guard oneSpec,
    names C.edge twoSpec,names C.binary binSpec,names C.structural structSpec⟩
private theorem raw_correct (R : Rules Nat) (e : List Nat → List Nat → Bool)
    (correct : ∀ a b, e a b = true ↔ R.step a b) (T : List Nat) (cap : Cap R.r T) :
    Represents (P455EffectiveQRaw.rows e T) (quotientModel R T cap) :=
  ⟨P455EffectiveQRaw.ops R e correct T,(P455EffectiveQRaw.matrix_eq R e correct T).symm,
    ⟨P455EffectiveQRaw.presentation R e correct T cap⟩⟩
private theorem plain (r tags) (T : List Nat) (cap : Cap r T) :
    Represents (factorRows r tags (T,none)) (quotientModel (P455FirstTesters.plain r) T cap) :=
  raw_correct _ _ (fun _ _ => by simp [P455FirstTesters.plain,moves]) T cap
private theorem marked {n} (M : MachineTable n) (r : Nat) (T : List Nat) (pairs : List (Nat×Nat))
    (mark : Nat → Nat → Prop) (same : ∀ x y, (x,y)∈pairs ↔ mark x y) (cap : Cap r T) :
    Represents (factorRows r (P455Enum.tags M) (T,some pairs))
      (quotientModel (Problem455Finite.rules r (allowed M) mark) T cap) := by
  apply raw_correct
  exact P455EffectiveQMove.move_iff (fun _ => P455Enum.mem_tags (M:=M))
    (fun x y => (Iff.of_eq (decide_eq_true_eq)).trans (same x y)) r
private theorem group {I : Type} {F : I → Type} (M : (i : I) → Model (F i))
    (C : Listing I) (record : I → Spec) (r tags)
    (yes : ∀ i, Represents (factorRows r tags (record i)) (M i)) :
    Represents (assemble ((names C record).map (factorRows r tags))) (full M) := by
  letI := C.eq
  simpa only [names,List.map_map,Function.comp_def] using
    complete_product M (fun i => factorRows r tags (record i)) yes (distinct C.items)
      (nodup_distinct _) (fun i => (mem_distinct ..).mpr (C.all i))
private theorem binary_factor {n} (M : MachineTable n) (r : Nat)
    (i : P455BinaryProduct.Index r (allowed M)) :
    Represents (factorRows r (P455Enum.tags M) (binSpec i)) (quotientModel i.R i.T i.bound) := by
  rcases i with ⟨num,prof,cap,accepted⟩
  cases prof with
  | false => exact plain r (P455Enum.tags M) _ cap
  | true => exact marked M r _ [] P455SlotSaturation.noMark (by simp [P455SlotSaturation.noMark]) cap
theorem serialize_represents {n} (M : MachineTable n) :
    Represents (serialize (prepared M)) (P455Global.monoid M) := by
  let r := widthCode n+16
  let L := P455Enum.tags M
  let C := P455Encoded.indices M
  have prim : Represents (assemble ((names C.primitive primSpec).map (factorRows r L)))
      (P455FirstTesters.product r) :=
    group (fun i : P455FirstTesters.Index r => quotientModel _ _ i.cap) C.primitive primSpec _ _
      (fun i => plain r L i.val i.cap)
  have structural : Represents (assemble ((names C.structural structSpec).map (factorRows r L)))
      (P455StructuralProduct.product r (allowed M)) :=
    group (fun i : P455StructuralProduct.Index r (allowed M) => quotientModel (P455FirstTesters.plain r) i.T i.cap)
      C.structural structSpec _ _ (fun i => plain r L i.T i.cap)
  have guards : Represents (assemble ((names C.guard oneSpec).map (factorRows r L)))
      (P455GuardProduct.product r (allowed M) (system n)) :=
    group (fun i : P455GuardProduct.Index r (allowed M) (system n) => quotientModel i.R i.T i.cap)
      C.guard oneSpec _ _ (fun i => marked M r i.T _ _ (by intros; simp [P455SlotProduct.pairMark]) i.cap)
  have edges : Represents (assemble ((names C.edge twoSpec).map (factorRows r L)))
      (P455EdgeProduct.product r (allowed M) (system n)) :=
    group (fun i : P455EdgeProduct.Index r (allowed M) (system n) => quotientModel i.R i.T i.cap)
      C.edge twoSpec _ _ (fun i => marked M r i.T _ _ (by intros; simp [P455EdgeProduct.marks]) i.cap)
  have binary : Represents (assemble ((names C.binary binSpec).map (factorRows r L)))
      (P455BinaryProduct.model r (allowed M)) :=
    group (fun i : P455BinaryProduct.Index r (allowed M) => quotientModel i.R i.T i.bound)
      C.binary binSpec r L (binary_factor M r)
  have combined := represents_tensor prim (represents_tensor (represents_tensor guards edges)
    (represents_tensor binary structural))
  dsimp only [serialize,prepared,P455Global.monoid,P455FullSingleton.model,P455MarkedRank.model]
  exact combined
end P455Packed
end
section
namespace P455RowsPrim
open P455EffectiveQ P455GraphPrim P455ClassPrim
open P455EffectiveQRaw (distinctRaw labels index rows)
variable {A B : Type} [Primcodable A] [Primcodable B]
theorem distinct {r : A → Raw → Raw → Bool}
    (hr : Primrec fun p : A×(Raw×Raw) => r p.1 p.2.1 p.2.2) {l : A → List Raw} (hl : Primrec l) :
    Primrec fun a => distinctRaw (r a) (l a) := by
  let h (a : A) (s : Raw × List Raw × List Raw) :=
    if s.2.1.any (r a s.1) then s.2.2 else s.1::s.2.2
  have hh : Primrec₂ h := by
    apply Primrec₂.mk
    apply Primrec.ite
    · change PrimrecPred (fun p : A×(Raw×List Raw×List Raw) => (p.2.2.1.any (r p.1 p.2.1)) = true)
      have any := anyB (A := A × (Raw × List Raw × List Raw)) (B := Raw) (Primrec.fst.comp (Primrec.snd.comp Primrec.snd))
        ((hr.comp (Primrec.pair (Primrec.fst.comp Primrec.fst)
          (Primrec.pair (Primrec.fst.comp (Primrec.snd.comp Primrec.fst)) Primrec.snd))).to₂)
      exact Primrec.eq.comp any (.const true)
    · exact Primrec.snd.comp (Primrec.snd.comp Primrec.snd)
    · exact Primrec.list_cons.comp (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp (Primrec.snd.comp Primrec.snd))
  apply (Primrec.list_rec hl (Primrec.const []) hh).of_eq
  intro a
  induction l a with
  | nil => rfl
  | cons x xs ih =>
    change h a (x,xs,_) = _
    exact congrArg (fun acc => h a (x,xs,acc)) ih
theorem labelRec {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {t : A → W} (ht : Primrec t) : Primrec fun a => labels (e a) (t a) := by
  apply distinct (r := fun a => relB (e a) (t a))
  · exact relation (A := A×(Raw×Raw)) (e := fun p => e p.1)
      (he.comp (Primrec.pair (Primrec.fst.comp Primrec.fst) Primrec.snd))
      (ht.comp Primrec.fst) (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.snd)
  · exact Primrec.list_cons.comp (.const none)
      (Primrec.list_map (wordPool.comp ht) (Primrec.option_some.comp₂ Primrec₂.right))
theorem indexRec {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {t : A → W} {v : A → Raw} (ht : Primrec t) (hv : Primrec v) :
    Primrec fun a => index (e a) (t a) (v a) := by
  apply Primrec.list_findIdx (labelRec he ht)
  exact (relation (A := A×Raw) (e := fun p => e p.1)
      (he.comp (Primrec.pair (Primrec.fst.comp Primrec.fst) Primrec.snd))
      (ht.comp Primrec.fst) (hv.comp Primrec.fst) Primrec.snd).to₂
theorem rawMul : Primrec₂ (fun x y : Raw => (show Raw from @P455Quotient.mulRaw Nat x y)) := by
  let f (p : Raw × Raw) (u : W) := p.2.map (fun v => u++v)
  have recProof : Primrec₂ f := Primrec₂.mk <|
    Primrec.option_map (Primrec.snd.comp Primrec.fst)
      ((Primrec.list_append.comp (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂)
  apply (Primrec.option_bind (Primrec.fst (α := Raw) (β := Raw)) recProof).of_eq
  rintro ⟨x,y⟩
  cases x <;> cases y <;> rfl
theorem rowsRec {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {t : A → W} (ht : Primrec t) : Primrec fun a => rows (e a) (t a) := by
  apply Primrec.list_map (labelRec he ht)
  apply Primrec₂.mk
  apply Primrec.list_map ((labelRec he ht).comp Primrec.fst)
  apply Primrec₂.mk
  exact indexRec (A := (A×Raw)×Raw) (e := fun p => e p.1.1)
    (he.comp (Primrec.pair (Primrec.fst.comp (Primrec.fst.comp Primrec.fst)) Primrec.snd))
    (ht.comp (Primrec.fst.comp Primrec.fst))
    (rawMul.comp (Primrec.snd.comp Primrec.fst) Primrec.snd)
end P455RowsPrim
end
section
namespace P455WriterProgram
open P455EffectiveMachine P455MachineLocal P455MachineCleanup P455EffectivePrefix P455EffectiveWriter
abbrev Raw := Nat × Nat × Nat × Nat × Nat × List Nat
abbrev g (m : Raw) := m.1
abbrev q (m : Raw) := m.2.1
abbrev marker (m : Raw) := m.2.2.1
abbrev blank (m : Raw) := m.2.2.2.1
abbrev start (m : Raw) := m.2.2.2.2.1
abbrev entries (m : Raw) := m.2.2.2.2.2
def incHead (l : List Nat) := (l.getD 0 0 + 1)::l.tail
def readBits (bits : List Bool) : List Nat :=
  bits.foldr (fun b l => bif b then incHead l else 0::l) []
theorem read_one (n : Nat) (b : List Bool) : readBits (unary n ++ b) = n::readBits b := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change incHead (readBits (unary n ++ b)) = _
    rw [ih]; rfl
theorem read_many (nums : List Nat) (b : List Bool) :
    readBits (nums.flatMap unary ++ b) = nums++readBits b := by
  induction nums with
  | nil => rfl
  | cons x xs ih => simp only [List.flatMap_cons,List.append_assoc,read_one,ih,List.cons_append]
def rowData (M : Ordinary g0 q0) := (quote M).rows.toList.flatMap (fun row => row.toList.map (entryCode g0))
def data (M : Ordinary g0 q0) : Raw := (g0,q0,M.marker.val,M.blank.val,M.start.val,rowData M)
theorem read_self (M : Ordinary g0 q0) (A : Alphabet M) :
    readBits (selfBits M A) =
      (A.bit false).val::(A.bit true).val::g0::q0::M.marker.val::M.blank.val::M.start.val::rowData M := by
  have hn : readBits []=[] := rfl
  have h := read_many (quote M).numerals []
  simpa [selfBits,List.append_assoc,read_one,Code.bits,Code.numerals,quote,rowData,hn] using
    congrArg (fun l => (A.bit false).val::(A.bit true).val::l) h
def raw (w : List Nat) : Raw := (w.getD 2 0,w.getD 3 0,w.getD 4 0,w.getD 5 0,w.getD 6 0,w.drop 7)
theorem raw_self (M : Ordinary g0 q0) (A : Alphabet M) :
    raw (readBits (selfBits M A)) = data M := by rw [read_self]; rfl
def script (a b : Nat) (w : List Bool) :=
  0 :: (w.map (fun x => (bif x then b else a)+2) ++ List.replicate (w.length+1) 1)
def cmdCode : Cmd g0 → Nat
  | .right => 0
  | .left => 1
  | .putRight v => v.val+2
theorem script_spec (M : Ordinary g0 q0) (A : Alphabet M) (w : List Bool) :
    script (A.bit false).val (A.bit true).val w = (writer M A w).map cmdCode := by
  simp only [script,writer,List.map_cons,List.map_append,List.map_replicate,List.map_map,cmdCode]
  congr 2
  apply List.map_congr_left
  intro b _; cases b <;> rfl
def writtenSymbol (c m a : Nat) := if c < 2 ∨ a = m ∨ c-2 = m then a else c-2
def dir (c m a : Nat) := if c = 1 then (if a = m then 1 else 0) else 2
def instr (g z a d : Nat) := 1+3*(g*z+a)+d
def pushRaw (c : Nat) (m : Raw) : Raw :=
  (g m,q m+1,marker m,blank m,q m,
   entries m ++ (List.range (g m)).map fun a =>
     instr (g m) (start m) (writtenSymbol c (marker m) a) (dir c (marker m) a))
def blankRaw (bits : List Bool) :=
  let l := readBits bits
  (script (l.getD 0 0) (l.getD 1 0) bits).foldr pushRaw (raw l)
end P455WriterProgram
end
section
namespace P455WriterTiles
open P455PaddedTiles
abbrev MachineData := Nat × List Bool × Nat × Nat × Nat × List (Option Nat)
def size (D : MachineData) := D.1
def marker (D : MachineData) (c : Nat) := D.2.1[c]?.getD false
def initial (D : MachineData) (left : Bool) := if left then D.2.2.2.1 else D.2.2.1
def accept (D : MachineData) := D.2.2.2.2.1
def address (n l c r : Nat) := (l*n+c)*(n+1)+r
def update (D : MachineData) (l c r : Nat) : Option Nat :=
  D.2.2.2.2.2[address D.1 l c r]?.getD none
structure Models (D : MachineData) {n} (M : MachineTable n) : Prop where
  dim : size D = n
  marks : ∀ c, marker D c.val = M.marker c
  start : ∀ b, initial D b = (M.initial b).val
  final : accept D = M.accept.val
  step : ∀ l c r, update D (letter l) c.val (letter r) = (M.next l c r).map Fin.val
end P455WriterTiles
end
section
namespace P455SerializePrim
open P455Packed
abbrev Tags := List (List Bool)
abbrev Marks := List (Nat × Nat)
abbrev W := List Nat
abbrev Data := Nat × Tags × List Spec × List Spec × List Spec × List Spec × List Spec
def asPayload (x : Data) : Payload :=
  ⟨x.1, x.2.1, x.2.2.1, x.2.2.2.1, x.2.2.2.2.1, x.2.2.2.2.2.1, x.2.2.2.2.2.2⟩
def ofPayload (p : Payload) : Data :=
  (p.r, p.tags, p.primitive, p.guard, p.edge, p.binary, p.structural)
theorem as_of (p : Payload) : asPayload (ofPayload p) = p := rfl
variable {A : Type} [Primcodable A]
theorem move {r : A → Nat} {tags : A → Tags} {mark : A → Option Marks} {u v : A → W}
    (hr : Primrec r) (ht : Primrec tags) (hm : Primrec mark) (hu : Primrec u) (hv : Primrec v) :
    Primrec fun a => moves (r a) (tags a) (mark a) (u a) (v a) := by
  let h (a : A) (ps : Marks) :=
    P455EffectiveQMove.moveB (r a) (tags a) (fun x y => decide ((x,y) ∈ ps)) (u a) (v a)
  have m : Primrec₂ h := Primrec₂.mk (P455FrameProof.literalMove (hr.comp Primrec.fst)
    (ht.comp Primrec.fst) Primrec.snd (hu.comp Primrec.fst) (hv.comp Primrec.fst))
  exact (Primrec.option_casesOn hm (Primrec.const false) m).of_eq (fun a => by
    cases e : mark a <;> simp [moves,e,h])
theorem factor {r : A → Nat} {tags : A → Tags} {s : A → Spec}
    (hr : Primrec r) (ht : Primrec tags) (hs : Primrec s) :
    Primrec fun a => factorRows (r a) (tags a) (s a) := by
  apply P455RowsPrim.rowsRec (e := fun a => moves (r a) (tags a) (s a).2)
  · exact move (hr.comp Primrec.fst) (ht.comp Primrec.fst) ((Primrec.snd.comp hs).comp Primrec.fst)
      (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.snd)
  · exact Primrec.fst.comp hs
theorem group {r : A → Nat} {tags : A → Tags} {s : A → List Spec}
    (hr : Primrec r) (ht : Primrec tags) (hs : Primrec s) :
    Primrec fun a => P455NumericProduct.assemble ((s a).map (factorRows (r a) (tags a))) :=
  P455NumericProductPrim.assemble'.comp (Primrec.list_map hs
    (Primrec₂.mk (factor (hr.comp Primrec.fst) (ht.comp Primrec.fst) Primrec.snd)))
theorem serialize : Primrec fun x : Data => P455Packed.serialize (asPayload x) := by
  have r : Primrec fun x : Data => x.1 := Primrec.fst
  have s := Primrec.snd (α := Nat) (β := Tags × List Spec × List Spec × List Spec × List Spec × List Spec)
  have tags := Primrec.fst.comp s
  have ss := Primrec.snd.comp s
  have gs := Primrec.snd.comp ss
  have es := Primrec.snd.comp gs
  have bs := Primrec.snd.comp es
  exact P455NumericProductPrim.tensor'.comp (group r tags (Primrec.fst.comp ss))
    (P455NumericProductPrim.tensor'.comp
      (P455NumericProductPrim.tensor'.comp (group r tags (Primrec.fst.comp gs)) (group r tags (Primrec.fst.comp es)))
      (P455NumericProductPrim.tensor'.comp (group r tags (Primrec.fst.comp bs)) (group r tags (Primrec.snd.comp bs))))
end P455SerializePrim
end
section
namespace P455WriterProgram
open P455EffectiveMachine P455MachineLocal P455MachineCleanup P455EffectivePrefix P455EffectiveWriter
theorem indices_ofFn {α : Type} (f : Fin n → α) :
    (Vector.ofFn f).toList = (List.finRange n).map f := by
  apply List.ext_getElem (by simp)
  intro i hi hj
  simp [Vector.toList_ofFn]
def row (M : Ordinary g0 q0) (z : Fin q0) :=
  (List.finRange g0).map (fun a => entryCode g0 (M.delta z a))
theorem rows_spec (M : Ordinary g0 q0) : rowData M = (List.finRange q0).flatMap (row M) := by
  simp only [rowData,quote,indices_ofFn,List.flatMap_map,Function.comp_def,List.map_map]
  rfl
theorem cols (n : Nat) : List.range n = (List.finRange n).map Fin.val := by
  apply List.ext_getElem (by simp); intros; simp
theorem code_write (cmd : Cmd g0) (m a : Fin g0) :
    writtenSymbol (cmdCode cmd) m.val a.val = (write m cmd a).val := by
  cases cmd with
  | right => simp [writtenSymbol,cmdCode,write]
  | left => simp [writtenSymbol,cmdCode,write]
  | putRight v =>
    simp only [writtenSymbol,cmdCode,Nat.add_sub_cancel,write]
    by_cases ea : a = m <;> by_cases ev : v = m <;> simp_all [Fin.ext_iff] <;> omega
theorem code_motion (cmd : Cmd g0) (m a : Fin g0) :
    dir (cmdCode cmd) m.val a.val = dirCode (motion m cmd a) := by
  cases cmd with
  | right => rfl
  | left => by_cases ea : a = m <;> simp_all [dir,cmdCode,motion,dirCode,Fin.ext_iff]
  | putRight v => simp [dir,cmdCode,motion,dirCode]
theorem entry_lift (i : Option (Ins (Fin g0) (Fin q0))) :
    entryCode g0 (i.map liftIns) = entryCode g0 i := by cases i <;> rfl
theorem push_data (M : Ordinary g0 q0) (c : Cmd g0) :
    pushRaw (cmdCode c) (data M) = data (push M c) := by
  have low (s : Fin q0) : row (push M c) s.castSucc = row M s := by
    unfold row; apply List.map_congr_left
    intro a _
    change entryCode _ ((push M c).delta (P455EffectivePrefix.old s) a) = _
    rw [old_ins,entry_lift]
  have top : row (push M c) (Fin.last q0)=
      (List.range g0).map (fun a => instr g0 M.start.val (writtenSymbol (cmdCode c) M.marker.val a)
        (dir (cmdCode c) M.marker.val a)) := by
    unfold row
    rw [cols]; simp only [List.map_map,Function.comp_def]
    apply List.map_congr_left; intro a _
    change entryCode _ ((push M c).delta (head q0) a) = _
    rw [head_ins,code_write,code_motion]; rfl
  have content : rowData (push M c) = rowData M++
      (List.range g0).map (fun a => instr g0 M.start.val (writtenSymbol (cmdCode c) M.marker.val a)
        (dir (cmdCode c) M.marker.val a)) := by
    rw [rows_spec,rows_spec,List.finRange_succ_last]
    simp [List.flatMap_append,List.flatMap_map,Function.comp_def,low,top]
  exact congrArg (fun xs => (g0,q0+1,M.marker.val,M.blank.val,q0,xs)) content.symm
theorem install_data (M : Ordinary g0 q0) (cs : List (Cmd g0)) :
    (cs.map cmdCode).foldr pushRaw (data M) = data (install M cs).2 := by
  induction cs with
  | nil => rfl
  | cons c cs ih => simp only [List.map_cons,List.foldr_cons,ih,push_data,install]
theorem blank_self (M : Ordinary g0 q0) (A : Alphabet M) :
    blankRaw (selfBits M A) = data (diagonalInput M A).2 := by
  dsimp only [blankRaw]
  rw [raw_self]
  have eq := read_self M A
  rw [eq]
  change (script (A.bit false).val (A.bit true).val (selfBits M A)).foldr pushRaw (data M) = _
  rw [script_spec,install_data]
  rfl
end P455WriterProgram
end
section
namespace P455PureSemigroup
open P455Table P455TableSemantics P455BinaryTerms P455BinaryBasis
inductive Equational (G : Term → Term → Prop) : Term → Term → Prop
  | refl (x) : Equational G x x
  | symm : Equational G x y → Equational G y x
  | trans : Equational G x y → Equational G y z → Equational G x z
  | gen : G x y → Equational G x y
  | mul : Equational G x y → Equational G z t → Equational G (.mul x z) (.mul y t)
  | subst (f) : Equational G x y → Equational G (inst f x) (inst f y)
def assocPair : Term × Term :=
  (.mul (.mul (.var 0) (.var 1)) (.var 2),.mul (.var 0) (.mul (.var 1) (.var 2)))
def Basis (T : Matrix) := ∃ rules : List (Term × Term),
  (∀ u v, (u,v)∈rules → ValidTerm T u v) ∧
  ∀ u v, ValidTerm T u v → Equational (fun x y => (x,y)∈rules) u v
theorem forget {G} {u v} (p : Equational G u v) : Proof G u v := by
  induction p with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih ik => exact .trans ih ik
  | gen m => exact .gen m
  | mul _ _ ih ik => exact .mul ih ik
  | subst f _ ih => exact .subst f ih
theorem explicit_assoc (rs : List (Term × Term)) {u v}
    (p : Proof (fun x y => (x,y)∈rs) u v) :
    Equational (fun x y => (x,y)∈assocPair::rs) u v := by
  induction p with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih ik => exact .trans ih ik
  | gen m => exact .gen (List.mem_cons_of_mem _ m)
  | mul _ _ ih ik => exact .mul ih ik
  | subst f _ ih => exact .subst f ih
  | assoc x y z =>
    let f (i : Nat) := if i = 0 then x else if i = 1 then y else z
    have law : Equational (fun s t => (s,t)∈assocPair::rs) assocPair.1 assocPair.2 := .gen List.mem_cons_self
    exact .subst f law
theorem basis_iff {T : Matrix} (good : SemigroupTable T) :
    Basis T ↔ P455TableSemantics.HasBasis T := by
  rw [←basis_iff_words good]
  constructor
  · rintro ⟨rs,s,all⟩; exact ⟨rs,s,fun u v h => forget (all u v h)⟩
  · rintro ⟨rs,s,all⟩
    refine ⟨assocPair::rs,?_,fun u v h => explicit_assoc rs (all u v h)⟩
    intro u v mem
    rcases List.mem_cons.mp mem with first|old
    · cases first
      intro f bounded
      exact good.2.2 (f 0) (f 1) (f 2) (bounded 0) (bounded 1) (bounded 2)
    · exact s _ _ old
end P455PureSemigroup
end
section
namespace P455WriterTiles
open P455PaddedTiles
abbrev TileData := Bool × Bool × Bool × Bool × Bool × Bool × Nat × Nat × Nat × Nat
abbrev raw (p : Tile n) : TileData :=
  (p.left,p.right,p.top,p.bottom,p.oddRow,p.oddColumn,letter p.l,p.c.val,letter p.r,p.b.val)
def choices (xs : List X) (ys : List Y) : List (X × Y) :=
  xs.flatMap fun x => ys.map fun y => (x,y)
theorem map_choices (xs : List X) (ys : List Y) (f : X×Y → Z) :
    (choices xs ys).map f = xs.flatMap fun x => ys.map fun y => f (x,y) := by
  simp only [choices,List.map_flatMap,List.map_map,Function.comp_def]
theorem choicesRec {A X Y : Type} [Primcodable A] [Primcodable X] [Primcodable Y]
    {xs : A → List X} {ys : A → List Y} (hx : Primrec xs) (hy : Primrec ys) :
    Primrec fun a => choices (xs a) (ys a) := by
  apply Primrec.list_flatMap hx
  apply Primrec₂.mk
  apply Primrec.list_map (hy.comp Primrec.fst)
  exact (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂
def options (n : Nat) := 0 :: (List.range n).map Nat.succ
def pool (n : Nat) : List TileData :=
  let b := [false,true]
  let s := List.range n
  let o := options n
  choices b (choices b (choices b (choices b (choices b (choices b (choices o (choices s (choices o s))))))))
theorem optionsRec : Primrec options :=
  Primrec.list_cons.comp (.const 0) (Primrec.list_map Primrec.list_range (Primrec.succ.comp Primrec.snd).to₂)
theorem poolRec : Primrec pool := by
  have b : Primrec (fun _ : Nat => [false,true]) := Primrec.const _
  have o := optionsRec
  have s := Primrec.list_range
  exact choicesRec b (choicesRec b (choicesRec b (choicesRec b (choicesRec b (choicesRec b
    (choicesRec o (choicesRec s (choicesRec o s))))))))
theorem map_raw (n : Nat) : ((P455Enum.tiles n).list.map raw) = pool n := by
  have op : options n = (P455Enum.options (P455Enum.fins n)).list.map letter := by
    simp only [options,P455Enum.options,P455Enum.fins,List.map_cons,List.map_map,letter]
    rw [←p455MapFinRange,List.map_map]
    rfl
  unfold pool
  rw [op,←p455MapFinRange]
  simp only [P455Enum.tiles,P455Enum.bools,P455Enum.fins,choices,List.map_flatMap,List.map_map,
    List.flatMap_map,List.flatMap_assoc,Function.comp_def,raw]
def tokenN (n k : Nat) := digit (n+1) k
def rawCode (n : Nat) (p : TileData) :=
  p.1 :: p.2.1 :: p.2.2.1 :: p.2.2.2.1 :: p.2.2.2.2.1 :: p.2.2.2.2.2.1 ::
    (tokenN n p.2.2.2.2.2.2.1 ++ (tokenN n (p.2.2.2.2.2.2.2.1+1) ++
      (tokenN n p.2.2.2.2.2.2.2.2.1 ++ tokenN n (p.2.2.2.2.2.2.2.2.2+1))))
theorem code_raw (p : Tile n) : rawCode n (raw p) = code p := rfl
def eligible (D : MachineData) (p : TileData) : Prop :=
  let (left,right,top,bottom,oddRow,oddColumn,l,c,r,b) := p
  update D l c r = some b ∧ left = decide (l = 0) ∧ right = decide (r = 0) ∧ marker D c = left ∧
  (left = true → oddColumn = false) ∧ (top = true → oddRow = false ∧ c = initial D left) ∧
  (bottom = true → left = true → c = accept D)
instance eligibleDec (D : MachineData) (p : TileData) : Decidable (eligible D p) := by
  unfold eligible; infer_instance
theorem eligible_raw {D : MachineData} {M : MachineTable n} (h : Models D M) (p : Tile n) :
    eligible D (raw p) ↔ Admitted M p := by
  have none (s : Option (Fin n)) : decide (letter s = 0) = s.isNone := by
    cases s <;> simp [letter]
  have step : (M.next p.l p.c p.r).map Fin.val = some p.b.val ↔ M.next p.l p.c p.r = some p.b := by
    cases e : M.next p.l p.c p.r <;> simp [Fin.ext_iff]
  simp only [eligible,raw,Admitted,h.step,h.marks,h.start,h.final,step,Fin.ext_iff]
  simp only [none p.l, none p.r]
def tags (D : MachineData) := ((pool (size D)).filter (eligible D)).map (rawCode (size D))
theorem tags_correct {D : MachineData} {M : MachineTable n} (h : Models D M) :
    tags D = P455Enum.tags M := by
  unfold tags P455Enum.tags
  rw [h.dim,←map_raw,List.filter_map,List.map_map]
  have same : ((P455Enum.tiles n).list.filter (fun p => decide (eligible D (raw p)))) =
      ((P455Enum.tiles n).list.filter (Admitted M)) := by
    apply List.filter_congr
    intro p _
    exact Bool.eq_iff_iff.mpr (by simpa using eligible_raw h p)
  simpa only [Function.comp_def,code_raw] using congrArg (List.map code) same
end P455WriterTiles
end
section
namespace P455WriterProgram
open P455EffectiveMachine P455MachineLocal P455MachineCleanup
theorem flat_lookup {A B : Type} (f : A → List B) (k : Nat) (len : ∀ x, (f x).length = k)
    (xs : List A) (i j : Nat) (hi : i < xs.length) (hj : j < k) :
    (xs.flatMap f)[i*k+j]? = (f xs[i])[j]? := by
  induction xs generalizing i with
  | nil => simp at hi
  | cons x xs ih =>
    cases i with
    | zero => simp only [List.flatMap_cons,Nat.zero_mul,Nat.zero_add,List.getElem_cons_zero]
              exact List.getElem?_append_left (by simpa [len] using hj)
    | succ i =>
      have hi' : i < xs.length := by simpa using hi
      simp only [List.flatMap_cons,Nat.succ_mul,List.getElem_cons_succ]
      rw [List.getElem?_append_right (by rw [len]; omega),len]
      rw [show i*k+k+j-k = i*k+j by omega]; exact ih i hi'
theorem stored (M : Ordinary ng nq) (z : Fin nq) (a : Fin ng) :
    (entries (data M)).getD (z.val*ng+a.val) 0 = entryCode ng (M.delta z a) := by
  change (rowData M).getD _ 0 = _
  rw [List.getD_eq_getElem?_getD,rows_spec,flat_lookup (row M) ng (by intro; simp [row])
       _ _ _ (by simp) a.isLt]
  simp only [row,List.getElem_finRange,List.getElem?_map]
  rw [List.getElem?_eq_getElem (by simp)]
  simp
abbrev Triple := Nat × Nat × Nat
def numIns (i : Ins (Fin ng) (Fin nq)) : Triple := (i.state.val,i.symbol.val,dirCode i.dir)
def unpack (ng k : Nat) : Triple := (((k-1)/3)/ng, ((k-1)/3)%ng, (k-1)%3)
theorem unpack_some (i : Ins (Fin ng) (Fin nq)) : unpack ng (entryCode ng (some i)) = numIns i := by
  have hp : 0 < ng := by have := i.symbol.isLt; omega
  have hd : dirCode i.dir < 3 := by cases i.dir <;> decide
  have hp₁ : (1+3*(ng*i.state.val+i.symbol.val)+dirCode i.dir)-1 = 3*(ng*i.state.val+i.symbol.val)+dirCode i.dir := by omega
  simp [unpack,entryCode,hp₁,Nat.mul_add_div (by decide : 0 < 3),Nat.div_eq_of_lt hd,Nat.mul_add_mod,
    Nat.mod_eq_of_lt hd,Nat.mul_add_div hp,Nat.div_eq_of_lt i.symbol.isLt,Nat.mod_eq_of_lt i.symbol.isLt,numIns]
def normalizedIns (m : Raw) (z a : Nat) : Triple :=
  if z < q m then
    let k := (entries m).getD (z*g m+a) 0
    if k = 0 then (q m,a,1) else unpack (g m) k
  else if z = q m ∧ a≠marker m then (q m,a,0) else (q m+1,a,1)
theorem normalizedIns_spec (M : Ordinary ng nq) (z : Fin (nq+2)) (a : Fin ng) :
    normalizedIns (data M) z.val a.val = numIns (trans M z a) := by
  by_cases h : z.val < nq
  · let s : Fin nq := ⟨z.val,h⟩
    have E := stored M s a
    change (entries (data M)).getD (z.val*ng+a.val) 0 = _ at E
    simp only [normalizedIns,P455MachineCleanup.trans,q,data,g,if_pos h,dif_pos h] at *
    simp only [E, Nat.not_le_of_lt h, false_implies, and_true]
    cases e : M.delta s a with
    | none =>
      simp [s] at e
      simp [e,entryCode,numIns,cleanState,dirCode]
      exact fun bad => (Nat.not_le_of_lt h bad).elim
    | some i =>
      have N : entryCode ng (some i)≠0 := by simp [entryCode] <;> omega
      rw [if_neg N,unpack_some]
      simp [s] at e
      simp [e,numIns,extend,old]
      exact fun bad => (Nat.not_le_of_lt h bad).elim
  · by_cases k : z.val = nq <;> by_cases e : a = M.marker <;>
      simp [normalizedIns,data,P455MachineCleanup.trans,q,g,marker,entries,h,k,e,Fin.ext_iff.mp, numIns,cleanState,acceptState,dirCode,← Fin.ext_iff]
end P455WriterProgram
end
section
namespace P455WriterProgram
namespace Cert
open Primrec
variable {X : Type} [Primcodable X]
theorem g' : Primrec g := Primrec.fst
theorem q' : Primrec q := Primrec.fst.comp Primrec.snd
theorem marker' : Primrec marker := Primrec.fst.comp (Primrec.snd.comp Primrec.snd)
theorem blank' : Primrec blank := Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp Primrec.snd))
theorem start' : Primrec start := Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp Primrec.snd)))
theorem entries' : Primrec entries := Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp Primrec.snd)))
theorem get (l : X → List Nat) (hl : Primrec l) (n : Nat) : Primrec fun x => (l x).getD n 0 :=
  (Primrec.list_getD 0).comp hl (Primrec.const n)
theorem incHead' : Primrec incHead :=
  Primrec.list_cons.comp (Primrec.nat_add.comp (get _ Primrec.id 0) (Primrec.const 1)) Primrec.list_tail
theorem readBits' : Primrec readBits := by
  apply Primrec.list_foldr (h:=fun (_ : List Bool) (p : Bool × List Nat) => bif p.1 then incHead p.2 else 0::p.2)
    (Primrec.id (α:=List Bool)) (Primrec.const ([] : List Nat))
  exact (Primrec.cond (Primrec.fst.comp Primrec.snd) (incHead'.comp (Primrec.snd.comp Primrec.snd))
    (Primrec.list_cons.comp (Primrec.const 0) (Primrec.snd.comp Primrec.snd))).to₂
theorem drop' (n : Nat) : Primrec fun l : List Nat => l.drop n := by
  induction n with
  | zero => exact Primrec.id
  | succ n ih => exact (Primrec.list_tail.comp ih).of_eq fun l => List.tail_drop
theorem raw' : Primrec raw :=
  (get _ Primrec.id 2).pair ((get _ Primrec.id 3).pair ((get _ Primrec.id 4).pair
    ((get _ Primrec.id 5).pair ((get _ Primrec.id 6).pair (drop' 7)))))
theorem ones : Primrec fun n : Nat => List.replicate n (1 : Nat) :=
  (Primrec.list_map Primrec.list_range (Primrec₂.const 1)).of_eq (fun _ => by simp [List.map_const'])
theorem script' {w : X → List Bool} {a b : X → Nat} (ha : Primrec a) (hb : Primrec b) (hw : Primrec w) :
    Primrec fun x => script (a x) (b x) (w x) :=
  Primrec.list_cons.comp (Primrec.const 0) (Primrec.list_append.comp
    (Primrec.list_map hw (Primrec.nat_add.comp (Primrec.cond Primrec.snd (hb.comp Primrec.fst)
      (ha.comp Primrec.fst)) (Primrec.const 2)).to₂)
    (ones.comp (Primrec.nat_add.comp (Primrec.list_length.comp hw) (Primrec.const 1))))
theorem written' {c m a : X → Nat} (hc : Primrec c) (hm : Primrec m) (ha : Primrec a) :
    Primrec fun x => writtenSymbol (c x) (m x) (a x) :=
  Primrec.ite ((Primrec.nat_lt.comp hc (Primrec.const 2)).or
    ((Primrec.eq.comp ha hm).or (Primrec.eq.comp (Primrec.nat_sub.comp hc (Primrec.const 2)) hm))) ha
    (Primrec.nat_sub.comp hc (Primrec.const 2))
theorem dir' {c m a : X → Nat} (hc : Primrec c) (hm : Primrec m) (ha : Primrec a) :
    Primrec fun x => dir (c x) (m x) (a x) :=
  Primrec.ite (Primrec.eq.comp hc (Primrec.const 1))
    (Primrec.ite (Primrec.eq.comp ha hm) (Primrec.const 1) (Primrec.const 0)) (Primrec.const 2)
theorem instr' {ng z a d : X → Nat} (hg : Primrec ng) (hz : Primrec z) (ha : Primrec a) (hd : Primrec d) :
    Primrec fun x => instr (ng x) (z x) (a x) (d x) :=
  Primrec.nat_add.comp (Primrec.nat_add.comp (Primrec.const 1)
    (Primrec.nat_mul.comp (Primrec.const 3) (Primrec.nat_add.comp (Primrec.nat_mul.comp hg hz) ha))) hd
theorem push' : Primrec₂ pushRaw := by
  apply Primrec₂.mk
  have m : Primrec fun p : Nat × Raw => p.2 := Primrec.snd
  have aux : Primrec fun p : (Nat × Raw) × Nat => p.1.2 := m.comp Primrec.fst
  have c : Primrec fun p : (Nat × Raw) × Nat => p.1.1 := Primrec.fst.comp Primrec.fst
  exact (g'.comp m).pair ((Primrec.nat_add.comp (q'.comp m) (Primrec.const 1)).pair
    ((marker'.comp m).pair ((blank'.comp m).pair ((q'.comp m).pair
      (Primrec.list_append.comp (entries'.comp m) (Primrec.list_map (Primrec.list_range.comp (g'.comp m))
        (instr' (g'.comp aux) (start'.comp aux) (written' c (marker'.comp aux) Primrec.snd)
          (dir' c (marker'.comp aux) Primrec.snd)).to₂))))))
theorem blankRaw' : Primrec blankRaw := by
  apply Primrec.list_foldr (h:=fun (_ : List Bool) (p : Nat × Raw) => pushRaw p.1 p.2)
    (script' (get _ readBits' 0) (get _ readBits' 1) Primrec.id) (raw'.comp readBits')
  exact (push'.comp (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.snd)).to₂
end Cert
end P455WriterProgram
end
section
namespace P455WriterEdge
open P455Witness
variable {X : Type} [Primcodable X]
def nodeCode : Node ≃ Nat × Nat × List Bool where
  toFun x := (x.owner,x.mate,x.tag)
  invFun p := ⟨p.1,p.2.1,p.2.2⟩
  left_inv := by intro x; cases x; rfl
  right_inv := by rintro ⟨owner,mate,tag⟩; rfl
instance : Primcodable Node := Primcodable.ofEquiv _ nodeCode
theorem nodeCodeRec : Primrec nodeCode := Primrec.of_equiv
theorem ownerRec : Primrec Node.owner := (Primrec.fst.comp nodeCodeRec)
theorem mateRec : Primrec Node.mate := (Primrec.fst.comp (Primrec.snd.comp nodeCodeRec))
theorem tagRec : Primrec Node.tag := (Primrec.snd.comp (Primrec.snd.comp nodeCodeRec))
theorem mkNodeRec {x0 : X → Nat} {x1 : X → Nat} {x2 : X → List Bool}
    (h0 : Primrec x0) (h1 : Primrec x1) (h2 : Primrec x2) :
    Primrec (fun u => Node.mk (x0 u) (x1 u) (x2 u)) :=
  (Primrec.of_equiv_symm (e:=nodeCode)).comp (h0.pair (h1.pair h2))
def dirCode : Dir ≃ Bool × Bool where
  toFun | .right => (false,false) | .left => (false,true) | .down => (true,false) | .up => (true,true)
  invFun | (false,false) => .right | (false,true) => .left | (true,false) => .down | (true,true) => .up
  left_inv := by intro d; cases d <;> rfl
  right_inv := by rintro ⟨a,b⟩; cases a <;> cases b <;> rfl
instance : Primcodable Dir := Primcodable.ofEquiv _ dirCode
theorem dirCodeRec : Primrec dirCode := Primrec.of_equiv
def funcCode : FunctionalityCertificate ≃ Node × Bool × Node × Node × Dir × Bool where
  toFun x := (x.anchor,x.bit,x.b,x.c,x.dir,x.distinguishMate)
  invFun p := ⟨p.1,p.2.1,p.2.2.1,p.2.2.2.1,p.2.2.2.2.1,p.2.2.2.2.2⟩
  left_inv := by intro x; cases x; rfl
  right_inv := by rintro ⟨anchor,bit,b,c,dir,distinguishMate⟩; rfl
instance : Primcodable FunctionalityCertificate := Primcodable.ofEquiv _ funcCode
theorem funcCodeRec : Primrec funcCode := Primrec.of_equiv
theorem funcAnchorRec : Primrec FunctionalityCertificate.anchor := (Primrec.fst.comp funcCodeRec)
theorem funcBitRec : Primrec FunctionalityCertificate.bit := (Primrec.fst.comp (Primrec.snd.comp funcCodeRec))
theorem funcBRec : Primrec FunctionalityCertificate.b := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp funcCodeRec)))
theorem funcCRec : Primrec FunctionalityCertificate.c := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp funcCodeRec))))
theorem funcDirRec : Primrec FunctionalityCertificate.dir := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp funcCodeRec)))))
theorem funcDistinguishMateRec : Primrec FunctionalityCertificate.distinguishMate := (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp funcCodeRec)))))
theorem mkFuncRec {x0 : X → Node} {x1 : X → Bool} {x2 : X → Node} {x3 : X → Node} {x4 : X → Dir} {x5 : X → Bool}
    (h0 : Primrec x0) (h1 : Primrec x1) (h2 : Primrec x2) (h3 : Primrec x3) (h4 : Primrec x4) (h5 : Primrec x5) :
    Primrec (fun u => FunctionalityCertificate.mk (x0 u) (x1 u) (x2 u) (x3 u) (x4 u) (x5 u)) :=
  (Primrec.of_equiv_symm (e:=funcCode)).comp (h0.pair (h1.pair (h2.pair (h3.pair (h4.pair h5)))))
def edgeCode : EdgeCertificate ≃ Node × Node × Node × Node × Node × Node × Node where
  toFun x := (x.a,x.b,x.right,x.left,x.down,x.up,x.diagonal)
  invFun p := ⟨p.1,p.2.1,p.2.2.1,p.2.2.2.1,p.2.2.2.2.1,p.2.2.2.2.2.1,p.2.2.2.2.2.2⟩
  left_inv := by intro x; cases x; rfl
  right_inv := by rintro ⟨a,b,right,left,down,up,diagonal⟩; rfl
instance : Primcodable EdgeCertificate := Primcodable.ofEquiv _ edgeCode
theorem edgeCodeRec : Primrec edgeCode := Primrec.of_equiv
theorem edgeARec : Primrec EdgeCertificate.a := (Primrec.fst.comp edgeCodeRec)
theorem edgeBRec : Primrec EdgeCertificate.b := (Primrec.fst.comp (Primrec.snd.comp edgeCodeRec))
theorem edgeRightRec : Primrec EdgeCertificate.right := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp edgeCodeRec)))
theorem edgeLeftRec : Primrec EdgeCertificate.left := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp edgeCodeRec))))
theorem edgeDownRec : Primrec EdgeCertificate.down := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp edgeCodeRec)))))
theorem edgeUpRec : Primrec EdgeCertificate.up := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp edgeCodeRec))))))
theorem edgeDiagonalRec : Primrec EdgeCertificate.diagonal := (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp edgeCodeRec))))))
theorem mkEdgeRec {x0 : X → Node} {x1 : X → Node} {x2 : X → Node} {x3 : X → Node} {x4 : X → Node} {x5 : X → Node} {x6 : X → Node}
    (h0 : Primrec x0) (h1 : Primrec x1) (h2 : Primrec x2) (h3 : Primrec x3) (h4 : Primrec x4) (h5 : Primrec x5) (h6 : Primrec x6) :
    Primrec (fun u => EdgeCertificate.mk (x0 u) (x1 u) (x2 u) (x3 u) (x4 u) (x5 u) (x6 u)) :=
  (Primrec.of_equiv_symm (e:=edgeCode)).comp (h0.pair (h1.pair (h2.pair (h3.pair (h4.pair (h5.pair h6))))))
theorem poolRec {w : X → List Nat} {ts : X → List (List Bool)} (hw : Primrec w) (ht : Primrec ts) :
    Primrec (fun x => P455CatalogueBounds.pool (w x) (ts x)) := by
  apply Primrec.list_flatMap hw
  apply Primrec₂.mk
  apply Primrec.list_flatMap (hw.comp Primrec.fst)
  apply Primrec₂.mk
  apply Primrec.list_map (ht.comp (Primrec.fst.comp Primrec.fst))
  exact (mkNodeRec (Primrec.snd.comp (Primrec.fst.comp Primrec.fst)) (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂
end P455WriterEdge
end
section
namespace P455WriterTiles
open P455PaddedTiles
variable {A : Type} [Primcodable A]
theorem replicateRec {B : Type} [Primcodable B] {n : A → Nat} {v : A → B}
    (hn : Primrec n) (hv : Primrec v) : Primrec fun a => List.replicate (n a) (v a) :=
  (Primrec.list_map (Primrec.list_range.comp hn) (hv.comp Primrec.fst).to₂).of_eq
    (fun a => by simp [List.map_const'])
theorem tokenRec {n k : A → Nat} (hn : Primrec n) (hk : Primrec k) :
    Primrec fun a => tokenN (n a) (k a) :=
  Primrec.list_append.comp (replicateRec hk (.const true))
    (replicateRec (Primrec.nat_sub.comp (Primrec.succ.comp hn) hk) (.const false))
theorem rawCodeRec : Primrec₂ rawCode := by
  let A := Nat × TileData
  have n : Primrec fun a : A => a.1 := Primrec.fst
  have t := Primrec.snd (α := Nat) (β := TileData)
  have t1 := Primrec.snd.comp t
  have t2 := Primrec.snd.comp t1
  have t3 := Primrec.snd.comp t2
  have t4 := Primrec.snd.comp t3
  have t5 := Primrec.snd.comp t4
  have t6 := Primrec.snd.comp t5
  have t7 := Primrec.snd.comp t6
  have t8 := Primrec.snd.comp t7
  apply Primrec₂.mk
  apply Primrec.list_cons.comp (Primrec.fst.comp t)
  apply Primrec.list_cons.comp (Primrec.fst.comp t1)
  apply Primrec.list_cons.comp (Primrec.fst.comp t2)
  apply Primrec.list_cons.comp (Primrec.fst.comp t3)
  apply Primrec.list_cons.comp (Primrec.fst.comp t4)
  apply Primrec.list_cons.comp (Primrec.fst.comp t5)
  exact Primrec.list_append.comp (tokenRec n (Primrec.fst.comp t6))
    (Primrec.list_append.comp (tokenRec n (Primrec.succ.comp (Primrec.fst.comp t7)))
      (Primrec.list_append.comp (tokenRec n (Primrec.fst.comp t8)) (tokenRec n (Primrec.succ.comp (Primrec.snd.comp t8)))))
theorem impliesRec {p q : A → Prop} [DecidablePred p] [DecidablePred q]
    (hp : PrimrecPred p) (hq : PrimrecPred q) : PrimrecPred fun a => p a → q a := by
  apply (PrimrecPred.or (PrimrecPred.not hp) hq).of_eq
  intro a
  simp [imp_iff_not_or]
theorem eligibleRec : Primrec₂ (fun d t => decide (eligible d t)) := by
  let A := MachineData × TileData
  have d := Primrec.fst (α := MachineData) (β := TileData)
  have v := Primrec.snd.comp d
  have v2 := Primrec.snd.comp v
  have v3 := Primrec.snd.comp v2
  have v4 := Primrec.snd.comp v3
  have n := Primrec.fst.comp d
  have t := Primrec.snd (α := MachineData) (β := TileData)
  have t1 := Primrec.snd.comp t
  have t2 := Primrec.snd.comp t1
  have t3 := Primrec.snd.comp t2
  have t4 := Primrec.snd.comp t3
  have t5 := Primrec.snd.comp t4
  have t6 := Primrec.snd.comp t5
  have t7 := Primrec.snd.comp t6
  have t8 := Primrec.snd.comp t7
  have leftFlag := Primrec.fst.comp t
  have rightFlag := Primrec.fst.comp t1
  have top := Primrec.fst.comp t2
  have bottom := Primrec.fst.comp t3
  have row := Primrec.fst.comp t4
  have col := Primrec.fst.comp t5
  have l := Primrec.fst.comp t6
  have c := Primrec.fst.comp t7
  have r := Primrec.fst.comp t8
  have b := Primrec.snd.comp t8
  let L (x : A) := x.2.1 = true
  have hl : PrimrecPred L := Primrec.eq.comp leftFlag (.const true)
  have init := Primrec.ite hl (Primrec.fst.comp v3) (Primrec.fst.comp v2)
  have ix := Primrec.nat_add.comp (Primrec.nat_mul.comp (Primrec.nat_add.comp (Primrec.nat_mul.comp l n) c)
    (Primrec.succ.comp n)) r
  have next := Primrec.option_getD.comp (Primrec.list_getElem?.comp (Primrec.snd.comp v4) ix) (.const none)
  have mark := Primrec.option_getD.comp (Primrec.list_getElem?.comp (Primrec.fst.comp v) c) (.const false)
  apply Primrec₂.mk
  unfold eligible
  exact (PrimrecPred.and (Primrec.eq.comp next (Primrec.option_some.comp b)) <|
    PrimrecPred.and (Primrec.eq.comp leftFlag (Primrec.eq.comp l (.const 0)).decide) <|
    PrimrecPred.and (Primrec.eq.comp rightFlag (Primrec.eq.comp r (.const 0)).decide) <|
    PrimrecPred.and (Primrec.eq.comp mark leftFlag) <|
    PrimrecPred.and (impliesRec hl (Primrec.eq.comp col (.const false))) <|
    PrimrecPred.and (impliesRec (Primrec.eq.comp top (.const true))
      (PrimrecPred.and (Primrec.eq.comp row (.const false)) (Primrec.eq.comp c init)))
      (impliesRec (Primrec.eq.comp bottom (.const true)) (impliesRec hl (Primrec.eq.comp c (Primrec.fst.comp v4))))).decide
theorem tagsRec : Primrec tags :=
  Primrec.list_map (P455GraphPrim.filter (poolRec.comp Primrec.fst) eligibleRec)
    (rawCodeRec.comp (Primrec.fst.comp Primrec.fst) Primrec.snd).to₂
end P455WriterTiles
end
section
namespace P455WriterProgram
open P455EffectiveMachine P455MachineLocal P455MachineCleanup P455MachineTable P455PaddedTiles
def act (m : Raw) (v : Nat) : Option Triple :=
  if 0 < v/(g m) then some (normalizedIns m (v/(g m)-1) (v%(g m))) else none
def send (ng sym d : Nat) (i : Triple) := ng*(if i.2.2 = d then i.1+1 else 0)+sym
def output (ng sym : Nat) (left right : Bool) : Option Triple → Option Triple → Option Triple → Option Nat
  | none,none,none => some sym
  | some i,none,none => some (send ng sym 2 i)
  | none,none,some i => some (send ng sym 0 i)
  | none,some i,none => if (i.2.2 = 0 ∧ left = true) ∨ (i.2.2 = 2 ∧ right = true) then none
                        else some (send ng i.2.1 1 i)
  | _,_,_ => none
def localValue (m : Raw) (l : Option Nat) (c : Nat) (r : Option Nat) :=
  output (g m) (c%(g m)) l.isNone r.isNone (l.bind (act m)) (act m c) (r.bind (act m))
theorem act_spec (M : Ordinary ng nq) (v : Fin (ng*((nq+2)+1))) :
    act (data M) v.val = (action (normalized M).delta (dec (normalized M) v)).map numIns := by
  unfold act action dec
  by_cases h : 0 < v.val/ng
  · simp only [data,g,h,if_pos,dif_pos,Option.map_some]
    apply congrArg some
    have pos : 0 < ng := by have := M.marker.isLt; omega
    have bound : v.val/ng < (nq+2)+1 := (Nat.div_lt_iff_lt_mul pos).mpr (Nat.mul_comm ng _ ▸ v.isLt)
    exact normalizedIns_spec M ⟨v.val/ng-1,by omega⟩ ⟨v.val%ng,Nat.mod_lt _ pos⟩
  · simp [data,g,h]
theorem opt_act (M : Ordinary ng nq) (v : Option (Fin (ng*((nq+2)+1)))) :
    (v.map Fin.val).bind (act (data M)) = ((v.map (dec (normalized M))).bind (action (normalized M).delta)).map numIns := by
  cases v with
  | none => rfl
  | some c => exact act_spec M c
theorem send_spec (a : Fin ng) (i : Ins (Fin ng) (Fin ns)) (d : Direction) :
    send ng a.val (dirCode d) (numIns i) = (enc ⟨a,sends i d⟩).val := by
  obtain ⟨z,b,e⟩:=i
  cases e <;> cases d <;> simp [send,numIns,sends,enc,headIndex,dirCode]
theorem output_spec (delta : Fin ns → Fin ng → Ins (Fin ng) (Fin ns))
    (l : Option (C ng ns)) (c : C ng ns) (r : Option (C ng ns)) :
    output ng c.sym.val l.isNone r.isNone ((l.bind (action delta)).map numIns)
      ((action delta c).map numIns) ((r.bind (action delta)).map numIns) =
      ((update delta l c r).map enc).map Fin.val := by
  unfold update
  cases e₁ : l.bind (action delta) with
  | none =>
    cases e₂ : action delta c with
    | none =>
      cases e₃ : r.bind (action delta) with
      | none => simp [output,enc,headIndex]
      | some i => exact congrArg some (send_spec c.sym i .left)
    | some i =>
      cases e₃ : r.bind (action delta) with
      | some j => rfl
      | none =>
        have dl : (numIns i).2.2 = 0 ↔ i.dir=.left := by cases h : i.dir <;> simp [numIns,h,dirCode]
        have dr : (numIns i).2.2 = 2 ↔ i.dir=.right := by cases h : i.dir <;> simp [numIns,h,dirCode]
        change (if ((numIns i).2.2 = 0 ∧ l.isNone = true) ∨ ((numIns i).2.2 = 2 ∧ r.isNone = true) then none else some (send ng i.symbol.val 1 (numIns i))) = _
        by_cases e : (i.dir=.left ∧ l.isNone = true) ∨ (i.dir=.right ∧ r.isNone = true)
        · simp only [dl,dr,e,if_true]; rfl
        · simp only [dl,dr,e,if_false]
          exact congrArg some (send_spec i.symbol i .stay)
  | some i =>
    cases e₂ : action delta c with
    | some j => cases r.bind (action delta) <;> rfl
    | none =>
      cases e₃ : r.bind (action delta) with
      | none => exact congrArg some (send_spec c.sym i .right)
      | some j => rfl
theorem localValue_spec (M : Ordinary ng nq) (l : Option (Fin (ng*((nq+2)+1)))) (c : Fin (ng*((nq+2)+1)))
    (r : Option (Fin (ng*((nq+2)+1)))) :
    localValue (data M) (l.map Fin.val) c.val (r.map Fin.val) = ((compile (normalized M)).next l c r).map Fin.val := by
  unfold localValue
  rw [opt_act,opt_act,act_spec]
  have em {A B : Type} (f : A → B) (o : Option A) : (o.map f).isNone = o.isNone := by cases o <;> rfl
  simpa only [em, data, g, dec, compile] using (output_spec (normalized M).delta
    (l.map (dec (normalized M))) (dec (normalized M) c) (r.map (dec (normalized M))))
end P455WriterProgram
end
