namespace P455SlotSaturation
open P455Witness P455Paths P455ContactLift P455OriginalWalk P455CrossedSupport
open P455SlotProduct P455SourceFamilies P455SourceTheorem P455MarkedPath
open P455DefectRename Problem455.Slots
abbrev noMark : Marking := fun _ _ => False
theorem pull_walk {r allow mark u v} (mv : P455Closure.Move r allow noMark u v)
    (t : Nat) (p : List Step) (w : Walk r allow mark v t p) : Walk r allow mark u t p := by
  have w0 : Walk r allow noMark v t p := remark_walk t p w
  apply remark_walk (mark := noMark) t p
  clear w
  induction p generalizing t with
  | nil => trivial
  | cons bc tail ih => exact ⟨(query_invariant mv _).mpr w0.1, ih _ w0.2⟩
theorem uniform_variant {r allow mark u v x y}
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u v)
    (uf : UniformSlots r allow mark u x y) : UniformSlots r allow mark v x y := by
  apply path.transport uf
  intro w z mv old t near i slot b occ
  have pull {s} (h : Near r allow mark z s t 6) : Near r allow mark w s t 6 := by
    obtain ⟨p,wa,ep,len⟩ := h
    exact ⟨p,pull_walk mv s p wa,ep,len⟩
  exact (mv.count_eq b).symm.trans (old t (near.imp pull pull) i slot b ((mv.slot_iff t i b slot).mpr occ))
end P455SlotSaturation
end
section
namespace P455EdgeProduct
open P455Witness P455Paths P455EdgeSource P455EdgeProjection P455PortReflection P455CertificateReach
open P455DefectRename P455SlotProduct Problem455.Slots
open P455FirstRewrite (Model)
abbrev W := List Nat
def words (r : Nat) := Problem455Finite.wordsUpTo (List.range 14) (14*r)
def marks (a b c d : Nat) (x y : Nat) := (x = a ∧ y = b) ∨ (x = c ∧ y = d)
structure Index (r : Nat) (allow : Tag → Prop) (ts : Tiles) where
  num : Fin (words r).length
  a : Fin 14
  b : Fin 14
  c : Fin 14
  d : Fin 14
  cap : P455Closure.Cap r ((words r).get num)
  test : ∃ e : EdgeCertificate, e.a.owner = a.val ∧ e.a.mate = b.val ∧
    e.b.owner = c.val ∧ e.b.mate = d.val ∧
    (∀ x : Nat, x ∈ (words r).get num ↔ x ∈ names ts e) ∧
    Holds r allow (marks a b c d) ((words r).get num) (e.query ts)
def Index.T (i : Index r allow ts) := (words r).get i.num
def Index.R (i : Index r allow ts) := rules r allow (marks i.a i.b i.c i.d)
abbrev Carrier (r : Nat) (allow : Tag → Prop) (ts : Tiles) :=
  (i : Index r allow ts) → P455Quotient.Q i.R i.T
def product (r : Nat) (allow : Tag → Prop) (ts : Tiles) : Model (Carrier r allow ts) where
  op := fun u v i => P455Quotient.mul i.R i.cap (u i) (v i)
  unit := fun i => P455Quotient.ofWord i.R i.T []
  assoc := fun u v w => funext (fun i => P455Quotient.mul_assoc i.R i.cap (u i) (v i) (w i))
  oneL := fun u => funext (fun i => (P455Quotient.unit_laws i.R i.cap (u i)).1)
  oneR := fun u => funext (fun i => (P455Quotient.unit_laws i.R i.cap (u i)).2)
theorem observed {r allow ts u w} (valid : (product r allow ts).Valid u w)
    (i : Index r allow ts) (h : Nat → W) :
    P455Quotient.ofWord i.R i.T (u.flatMap h) = P455Quotient.ofWord i.R i.T (w.flatMap h) := by
  let val : Nat → Carrier r allow ts := fun x j => P455Quotient.ofWord j.R j.T (h x)
  have comp (z : W) : (product r allow ts).eval val z i = P455Quotient.ofWord i.R i.T (z.flatMap h) := by
    induction z with
    | nil => rfl
    | cons a z ih =>
      change P455Quotient.mul i.R i.cap (val a i) _ = _
      rw [ih]; rfl
  exact (comp u).symm.trans ((congrFun (valid val) i).trans (comp w))
theorem names_send (f : Nat → Nat) (ts : Tiles) (e : EdgeCertificate) :
    names ts (sendEdge f e) = (names ts e).map f := by
  cases rr : ts.right e.a.tag <;> cases dd : ts.bottom e.a.tag <;>
    cases ll : ts.left e.a.tag <;> cases uu : ts.top e.a.tag <;>
    simp [names,nodes,candidates,sendEdge,sendNode,roles,rr,dd,ll,uu,List.filter_cons]
theorem endpoint_observed {r allow mark ts u w} (cap : P455Closure.Cap r u)
    (valid : (product r allow ts).Valid u w) (e : EdgeCertificate)
    (ok : Holds r allow mark u (e.query ts)) :
    select [e.a.owner,e.a.mate] u = select [e.a.owner,e.a.mate] w ∧
    select [e.b.owner,e.b.mate] u = select [e.b.owner,e.b.mate] w := by
  let keep := names ts e
  let T := template ts e u
  let f := keep.idxOf
  obtain ⟨ct,namesT,cert⟩ := canonical_edge cap ts e ok
  have hr : 0 < r := by have h : e.a.tag.length + 16 = r := ok.1.2.1; omega
  have exactT (x : Nat) : x ∈ T ↔ x ∈ names ts (sendEdge f e) := by
    rw [names_send]
    constructor
    · intro h; obtain ⟨z,hz,rfl⟩ := List.mem_map.mp h
      exact List.mem_map_of_mem (kept hz)
    · intro h; obtain ⟨z,hz,rfl⟩ := List.mem_map.mp h
      apply List.mem_map_of_mem
      apply List.count_pos_iff.mp
      change 0 < (select keep u).count z
      rw [P455DefectProjection.select_count keep u z hz,saturated cap ts e ok hz]
      exact hr
  have low (a : Nat) (h : a ∈ keep) : f a < 14 :=
    Nat.lt_of_lt_of_le (List.idxOf_lt_length_of_mem h) (names_bound ts e)
  have ao := covered (ts := ts) (e := e) .anchor e.a.owner (by simp [roles])
  have am := covered (ts := ts) (e := e) .anchor e.a.mate (by simp [roles])
  have bo := covered (ts := ts) (e := e) .successor e.b.owner (by simp [roles])
  have bm := covered (ts := ts) (e := e) .successor e.b.mate (by simp [roles])
  let a : Fin 14 := ⟨_,low _ ao⟩
  let b : Fin 14 := ⟨_,low _ am⟩
  let c : Fin 14 := ⟨_,low _ bo⟩
  let d : Fin 14 := ⟨_,low _ bm⟩
  have lowT (x : Nat) (h : x ∈ T) := (namesT x h).1
  obtain ⟨j,eq⟩ := List.get_of_mem (Problem455Finite.covered (List.range 14) _ T
    (capped_length _ T ct lowT) (fun x h => List.mem_range.mpr (lowT x h)))
  let i : Index r allow ts := ⟨j,a,b,c,d,eq.symm ▸ ct,sendEdge f e,rfl,rfl,rfl,rfl,
    eq.symm ▸ exactT,eq.symm ▸ cert⟩
  have comp := observed valid i (image keep)
  rw [image_word,image_word] at comp
  have sameT : T = i.T := eq.symm
  change P455Quotient.ofWord i.R i.T T = _ at comp
  rw [sameT] at comp
  have good : P455Quotient.Good i.R i.T i.T := ⟨_,.refl _,[],[],by simp⟩
  have path := ((P455Quotient.same_nonzero_class i.R good).mp comp).2
  have recover (x y : Nat) (hx : x ∈ keep) (hy : y ∈ keep) (markPair : marks a b c d (f x) (f y)) :
      select [x,y] u = select [x,y] w := by
    have pr := path.transport (P := fun z => select [f x,f y] i.T = select [f x,f y] z) rfl
      (fun mv old => old.trans (mv.marked_proj _ _ markPair))
    rw [← sameT] at pr
    change select [keep.idxOf x,keep.idxOf y] ((select keep u).map keep.idxOf) = _ at pr
    rw [← binary_select_map keep u hx hy,← binary_select_map keep w hx hy] at pr
    have k (z : W) (j : Nat) (mem : j ∈ select [x,y] z) : j ∈ keep := by
      rcases (by simpa using kept mem : j = x ∨ j = y) with rfl|rfl <;> assumption
    simpa only [decode_map (k u),decode_map (k w)] using congrArg (List.map (decode keep)) pr
  exact ⟨recover _ _ ao am (.inl ⟨rfl,rfl⟩),recover _ _ bo bm (.inr ⟨rfl,rfl⟩)⟩
end P455EdgeProduct
end
section
namespace P455PaddedWord
open P455PaddedPorts P455PaddedMatchings P455RectangleRank
abbrev W := List Nat
def matching (h w : Nat) : Nat → List Block
  | 0 => horizontal h w false
  | 1 => horizontal h w true
  | 2 => vertical h w false
  | 3 => vertical h w true
  | _+4 => wrap (w*h)
def portChunks (h w n : Nat) :=
  (List.range n).flatMap fun k => letters (matching h w k)
def tagPhase (t : Nat) (tag : Nat → List Bool) (k : Nat) :=
  (List.range t).flatMap (mutableCell fun i => (tag i)[k]?.getD false)
def columnCells (h w : Nat) := (List.range h).flatMap fun y => (List.range w).map (idAt w y)
def suffix (h w k : Nat) (tag : Nat → List Bool) : W :=
  (List.range k).flatMap (tagPhase (w*h) tag) ++ (columnCells h w).flatMap roles
def middle (h w k : Nat) (tag : Nat → List Bool) : W := portChunks h w 5 ++ suffix h w k tag
def tail (t : Nat) : W := (List.range t).flatMap (mutableCell (constant false))
theorem matching_unique {h w : Nat} (size : 1 < w*h) (k : Nat) :
    ((matching h w k).flatMap cells).Nodup := by
  cases k with
  | zero => exact horizontal_unique ..
  | succ k => cases k with
    | zero => exact horizontal_unique ..
    | succ k => cases k with
      | zero => exact vertical_unique ..
      | succ k => cases k with
        | zero => exact vertical_unique ..
        | succ k => exact wrap_unique size
theorem matching_cells {h w : Nat} (size : 1 < w*h) (k i : Nat) :
    i∈(matching h w k).flatMap cells ↔ i < w*h := by
  cases k with
  | zero => exact horizontal_cells ..
  | succ k => cases k with
    | zero => exact horizontal_cells ..
    | succ k => cases k with
      | zero => exact vertical_cells ..
      | succ k => cases k with
        | zero => exact vertical_cells ..
        | succ k => exact wrap_cells size i
theorem columns_eq (h w : Nat) :
    columnCells h w = (horizontal h w false).flatMap cells := by
  change _ = (lines h w false (idAt w)).flatMap cells
  simp [columnCells,lines,List.flatMap_assoc,line_cells]
theorem columns_unique (h w : Nat) : (columnCells h w).Nodup := by
  rw [columns_eq]; exact horizontal_unique ..
theorem columns_cells (h w i : Nat) : i∈columnCells h w ↔ i < w*h := by
  rw [columns_eq]; exact horizontal_cells ..
end P455PaddedWord
end
section
namespace P455RetainedVariant
open P455Witness P455Paths P455CrossedSupport P455SlotSaturation P455Compression
open Problem455.Slots
theorem near_move {r allow mark u v} (mv : P455Closure.Move r allow noMark u v) (a t J : Nat) :
    Near r allow mark u a t J ↔ Near r allow mark v a t J := by
  constructor
  · rintro ⟨p,w,e,len⟩; exact ⟨p,pull_walk mv.symm _ _ w,e,len⟩
  · rintro ⟨p,w,e,len⟩; exact ⟨p,pull_walk mv _ _ w,e,len⟩
theorem needed_move {r allow mark u v} (mv : P455Closure.Move r allow noMark u v) (x y b : Nat) :
    Needed r allow mark u x y b ↔ Needed r allow mark v x y b := by
  have ball (t) : InBall r allow mark u x y t ↔ InBall r allow mark v x y t :=
    or_congr (near_move mv x t 6) (near_move mv y t 6)
  apply or_congr (ball b)
  constructor
  · rintro ⟨t,i,nb,sl,oc⟩; exact ⟨t,i,(ball t).mp nb,sl,(mv.slot_iff t i b sl).mp oc⟩
  · rintro ⟨t,i,nb,sl,oc⟩; exact ⟨t,i,(ball t).mpr nb,sl,(mv.slot_iff t i b sl).mpr oc⟩
theorem same_retained {r allow mark u v} (mv : P455Closure.Move r allow noMark u v) (x y : Nat) :
    (retained r allow mark u x y).Perm (retained r allow mark v x y) := by
  classical
  have perm : u.Perm v := List.perm_iff_count.mpr mv.count_eq
  unfold retained
  have pred : (fun b => decide (Needed r allow mark u x y b)) =
              (fun b => decide (Needed r allow mark v x y b)) := by
    funext b; simp [(needed_move mv x y b : Needed r allow mark u x y b ↔ _)]
  rw [pred]
  exact perm.filter _
theorem sum_perm {s t : W} (h : s.Perm t) : s.sum = t.sum := by
  induction h with
  | nil => rfl
  | cons _ _ ih => simp [ih]
  | swap => simp [List.sum_cons]; omega
  | trans _ _ ih jh => exact ih.trans jh
theorem pieces_perm (w : W) {s t : W} (perm : s.Perm t) : pieces s w = pieces t w := by
  induction w with
  | nil => rfl
  | cons a w ih =>
    by_cases h : a ∈ s
    · simp [pieces,h,perm.mem_iff.mp h,ih]
    · have ht : a ∉ t := fun m => h (perm.mem_iff.mpr m)
      simp [pieces,h,ht,ih]
theorem small_congr_names (w : W) {s t : W} (perm : s.Perm t) : small w s = small w t := by
  simp only [small,base,sum_perm perm,pieces_perm w perm]
theorem retained_remark {r allow mark mark' u x y} :
    retained r allow mark u x y = retained r allow mark' u x y := by
  classical
  have near (a b : Nat) (m m' : Marking) (h : Near r allow m u a b 6) : Near r allow m' u a b 6 := by
    obtain ⟨p,w,ep,len⟩ := h
    exact ⟨p,P455SourceFamilies.remark_walk a p w,ep,len⟩
  have ball (b : Nat) (m m' : Marking) (h : InBall r allow m u x y b) : InBall r allow m' u x y b :=
    h.imp (near _ _ _ _) (near _ _ _ _)
  have need (a : Nat) (m m' : Marking) (h : Needed r allow m u x y a) : Needed r allow m' u x y a := by
    rcases h with h|⟨t,i,h,hi,occ⟩
    · exact .inl (ball _ _ _ h)
    · exact .inr ⟨t,i,ball _ _ _ h,hi,occ⟩
  unfold retained
  apply List.filter_congr
  intro b _
  simp [show Needed r allow mark u x y b ↔ Needed r allow mark' u x y b from ⟨need _ _ _,need _ _ _⟩]
end P455RetainedVariant
end
section
namespace P455ProfileComponent
open P455Witness P455Closure P455SlotProduct P455SlotSaturation Problem455.Slots
abbrev W := List Nat
theorem profile_support (a b : Nat) (tag : Tag) (bit : Bool) {z : Nat}
    (m : z ∈ profile a b tag bit) : z = a ∨ z = b := by
  rw [← profile_eq] at m
  obtain ⟨c,_,rfl⟩ := List.mem_map.mp m
  cases c <;> simp
theorem profile_length (a b : Nat) (tag : Tag) (bit : Bool) :
    (profile a b tag bit).length = 2 * (tag.length + 16) := by
  cases bit <;> simp [profile,pair,profile_prefix_length] <;> omega
theorem profile_cap {a b : Nat} (ne : a ≠ b) (tag : Tag) (bit : Bool) :
    Cap (tag.length + 16) (profile a b tag bit) := by
  intro x
  have tagct (x : Nat) : (tag.flatMap (pair a b)).count x ≤ tag.length := by
    induction tag with
    | nil => simp
    | cons f tag ih =>
      cases f <;> by_cases xa : a = x <;> by_cases xb : b = x <;>
        simp [List.flatMap_cons,pair,List.count_cons,beq_iff_eq,xa,xb,ne,Ne.symm ne] at * <;> omega
  have cp := tagct x
  cases bit <;> by_cases xa : a = x <;> by_cases xb : b = x <;>
    simp [profile,profilePrefix,pair,List.replicate_succ,List.count_cons,beq_iff_eq,xa,xb,ne,Ne.symm ne] at * <;> omega
def frame (a b : Nat) (tag : Tag) : Frame Nat :=
  ⟨a,[],[],b,tag,(fixedPhases tag).map (fun token => ([],token)),[],[],[]⟩
theorem frame_core (a b : Nat) (tag : Tag) (bit : Bool) :
    (frame a b tag).core bit = profile a b tag bit := by
  have md (ls : List Bool) : (ls.map (fun token => (([] : W),token))).flatMap
      (fun e => e.1 ++ (if e.2 then [b] else [a])) = ls.map (fun k => if k then b else a) := by
    induction ls with
    | nil => rfl
    | cons c ls ih => cases c <;> simp [List.flatMap_cons, ih] at *
  rw [← profile_eq]
  cases bit <;> simp [Frame.core,Frame.early,Frame.mid,Frame.pair,Frame.p,Frame.q,frame,
    Frame.profileWord,Frame.profileBits,md,phasePair,List.append_assoc]
theorem forward {r allow a b tag} (ne : a ≠ b) (length : tag.length+16 = r)
    (allowed : allow tag) (bit : Bool) :
    Move r allow noMark (profile a b tag bit) (profile a b tag (!bit)) := by
  let f := frame a b tag
  have cp : Cap r (profile a b tag bit) := length ▸ profile_cap ne tag bit
  have cf : Cap r ([] ++ f.core bit ++ []) := by simpa [f,frame_core] using cp
  refine ⟨f,bit,[],[],f.valid_of_capped_shape (by change r = 16+tag.length; omega) allowed
     (by simp [f,frame,List.map_map,Function.comp_def]) (by simp [f,frame,Frame.p])
     (by simp [f,frame,Frame.q]) (by simpa [f,frame,Frame.p,Frame.q] using ne)
     (by simp [noMark]) bit [] [] cf,by simp [f,frame_core],by simp [f,frame_core],cp⟩
theorem variants {r allow a b tag} (ne : a ≠ b) (length : tag.length+16 = r)
    (allowed : allow tag) (bit : Bool) (u : W) :
    P455Quotient.Variant (rules r allow noMark) (profile a b tag bit) u ↔
      ∃ v : Bool, u = profile a b tag v := by
  constructor
  · intro path
    have supp (x : Nat) (inU : x ∈ u) : x = a ∨ x = b := by
      have ct := P455Quotient.count_walk (rules r allow noMark) path x
      exact profile_support a b tag bit (List.count_pos_iff.mp (ct ▸ List.count_pos_iff.mpr inU))
    have selfU : select [a,b] u = u := by apply List.filter_eq_self.mpr; simpa using supp
    have selfT : select [a,b] (profile a b tag bit) = profile a b tag bit := by
      apply List.filter_eq_self.mpr
      intro x h; simpa using profile_support a b tag bit h
    have typed' := path.transport (P := fun z => typed z a b tag) ⟨bit,selfT⟩
      (fun mv yes => (mv.typed_iff a b tag ne length).mp yes)
    simpa [typed,selfU] using typed'
  · rintro ⟨v,rfl⟩
    cases bit <;> cases v
    · exact .refl _
    · exact .snoc (.refl _) (forward ne length allowed false)
    · exact .snoc (.refl _) (forward ne length allowed true)
    · exact .refl _
end P455ProfileComponent
end
section
namespace P455GridRows
open P455Witness P455Paths Problem455.Slots
structure Laws (ts : Tiles) : Prop where
  horiz : ∀ a b, ts.horizontal a b →
    ts.right a = false ∧ ts.left b = false ∧ ts.top a = ts.top b ∧
    ts.bottom a = ts.bottom b ∧ ts.oddRow a = ts.oddRow b ∧ ts.oddColumn b= !ts.oddColumn a
  vert : ∀ a b, ts.vertical a b →
    ts.bottom a = false ∧ ts.top b = false ∧ ts.left b = ts.left a ∧
    ts.right b = ts.right a ∧ ts.oddColumn b = ts.oddColumn a ∧ ts.oddRow b= !ts.oddRow a
def Arrow (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) (ts : Tiles) (e : EdgeCertificate) :=
  Holds r allow mark w (typedNode e.a) ∧ Holds r allow mark w (typedNode e.b) ∧
  Holds r allow mark w (localCert ts e) ∧ Holds r allow mark w (chosenSuccessor ts e)
def Functional (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) (ts : Tiles) (a : Node) :=
  ∀ (d : Dir) (b c : Node), Holds r allow mark w (neighbor ts a b d) →
    Holds r allow mark w (neighbor ts a c d) → b = c
private theorem active {r allow mark w q b} (h : Holds r allow mark w (flagQ (!b) q))
    (off : b = false) : Holds r allow mark w q := by simpa only [off,Bool.not_false,flagQ,if_true] using h
theorem descend_pair {r allow mark w ts} (law : Laws ts) (x y : EdgeCertificate)
    (hX : Holds r allow mark w (localCert ts x)) (hY : Holds r allow mark w (localCert ts y))
    (fx : Functional r allow mark w ts x.a) (fy : Functional r allow mark w ts y.a)
    (edge : Holds r allow mark w (rightward ts x.a y.a)) (nb : ts.bottom x.a.tag = false) :
    Holds r allow mark w (downward ts x.a x.down) ∧
    Holds r allow mark w (downward ts y.a y.down) ∧
    Holds r allow mark w (rightward ts x.down y.down) := by
  have lawH := law.horiz _ _ edge.1
  have nr := lawH.1
  have ny : ts.bottom y.a.tag = false := lawH.2.2.2.1.symm.trans nb
  have square : Holds r allow mark w (downward ts x.right x.diagonal) ∧
      Holds r allow mark w (rightward ts x.down x.diagonal) := by
    simpa [flagQ,nr,nb,Holds] using hX.2.2.2.2.1
  have toY := fx .right x.right y.a (active hX.1 nr) edge
  have downY := active hY.2.2.1 ny
  have d : x.diagonal = y.down := fy .down _ _ (toY ▸ square.1) downY
  exact ⟨active hX.2.2.1 nb,downY,d ▸ square.2⟩
theorem enters_down {r allow mark w ts} (e : EdgeCertificate) (arr : Arrow r allow mark w ts e)
    (endRow : endOfRow ts e.a = true) (notBottom : ts.bottom e.a.tag = false) : e.b = e.down := by
  have suc := arr.2.2.2
  simp only [chosenSuccessor,endRow,notBottom,Bool.and_false,Bool.false_eq_true,if_false,if_true] at suc
  exact suc.1.symm
private theorem goes_right {r allow mark w ts} (e : EdgeCertificate) (arr : Arrow r allow mark w ts e)
    (odd : ts.oddRow e.a.tag = false) (right : ts.right e.a.tag = false) :
    Holds r allow mark w (rightward ts e.a e.b) := by
  have endRow : endOfRow ts e.a = false := by simp [endOfRow,odd,right]
  have suc := arr.2.2.2
  simp only [chosenSuccessor,endRow,Bool.false_and,Bool.false_eq_true,if_false,odd] at suc
  exact suc.1 ▸ active arr.2.2.1.1 right
private theorem goes_left {r allow mark w ts} (e : EdgeCertificate) (arr : Arrow r allow mark w ts e)
    (odd : ts.oddRow e.a.tag = true) (left : ts.left e.a.tag = false) :
    Holds r allow mark w (rightward ts e.b e.a) := by
  have endRow : endOfRow ts e.a = false := by simp [endOfRow,odd,left]
  have suc := arr.2.2.2
  simp only [chosenSuccessor,endRow,Bool.false_and,Bool.false_eq_true,if_false,odd,if_true] at suc
  exact suc.1 ▸ active arr.2.2.1.2.1 left
theorem trace_row {r allow mark w ts} (law : Laws ts) (atCell : Nat → EdgeCertificate)
    (arrow : ∀ i, Arrow r allow mark w ts (atCell i))
    (continuous : ∀ i, (atCell i).b = (atCell (i+1)).a)
    (functional : ∀ i, Functional r allow mark w ts (atCell i).a)
    (row : Nat → Node) (n start : Nat) (odd : Bool)
    (init : (atCell start).a = row 0)
    (rowOdd : ∀ j, j ≤ n → ts.oddRow (row j).tag = odd)
    (links : ∀ j, j < n → Holds r allow mark w
      (if odd then rightward ts (row (j+1)) (row j) else rightward ts (row j) (row (j+1)))) :
    ∀ j, j ≤ n → (atCell (start+j)).a = row j := by
  intro j
  induction j with
  | zero => intro _; exact init
  | succ j ih =>
    intro le
    have here := ih (by omega)
    have p : ts.oddRow (atCell (start+j)).a.tag = odd := here ▸ rowOdd j (by omega)
    have one := links j (by omega)
    have eq : (atCell (start+j)).b = row (j+1) := by
      cases odd with
      | false =>
        have R : Holds r allow mark w (rightward ts (atCell (start+j)).a (row (j+1))) := here ▸ one
        have next := goes_right _ (arrow (start+j)) p (law.horiz _ _ R.1).1
        exact functional _ .right _ _ next R
      | true =>
        have L : Holds r allow mark w (rightward ts (row (j+1)) (atCell (start+j)).a) := here ▸ one
        have next := goes_left _ (arrow (start+j)) p (law.horiz _ _ L.1).2.1
        exact functional _ .left _ _ next L
    exact (continuous _).symm.trans eq
theorem lower_row {r allow mark w ts} (law : Laws ts) (atCell : Nat → EdgeCertificate)
    (arrow : ∀ i, Arrow r allow mark w ts (atCell i))
    (functional : ∀ i, Functional r allow mark w ts (atCell i).a)
    (index : Nat → Nat) (n : Nat)
    (edges : ∀ j, j < n → Holds r allow mark w (rightward ts (atCell (index j)).a (atCell (index (j+1))).a))
    (nonbottom : ∀ j, j ≤ n → ts.bottom (atCell (index j)).a.tag = false) :
    (∀ j, j ≤ n → Holds r allow mark w (downward ts (atCell (index j)).a (atCell (index j)).down)) ∧
    (∀ j, j < n → Holds r allow mark w (rightward ts (atCell (index j)).down (atCell (index (j+1))).down)) := by
  refine ⟨fun j hj => active (arrow (index j)).2.2.1.2.2.1 (nonbottom _ hj),?_⟩
  intro j hj
  exact (descend_pair law _ _ (arrow _).2.2.1 (arrow _).2.2.1
    (functional _) (functional _) (edges j hj) (nonbottom j (by omega))).2.2
private theorem idx_lt (a b : Event) (ls : List Event) (nd : ls.Nodup)
    (sub : [a,b].Sublist ls) : ls.idxOf a < ls.idxOf b := by
  induction ls with
  | nil => cases sub
  | cons x ls ih =>
    obtain ⟨fresh,distinct⟩ := List.nodup_cons.mp nd
    cases sub with
    | cons _ sub =>
      have hitA : a ∈ ls := sub.subset (by simp)
      have hitB : b ∈ ls := sub.subset (by simp)
      have xa : x ≠ a := fun eq => fresh (eq ▸ hitA)
      have xb : x ≠ b := fun eq => fresh (eq ▸ hitB)
      simpa only [List.idxOf_cons,cond_eq_if,beq_iff_eq,if_neg xa,if_neg xb,
        if_neg (Ne.symm xa),if_neg (Ne.symm xb),Nat.add_lt_add_iff_right] using ih distinct sub
    | cons_cons _ sub =>
      have hit : b ∈ ls := sub.subset List.mem_cons_self
      have ab : a ≠ b := fun eq => fresh (eq ▸ hit)
      simp [List.idxOf_cons,cond_eq_if,beq_iff_eq,ab,Ne.symm ab]
def position (w : W) (a : Node) := (events w).idxOf (a.owner,0)
def Return (ts : Tiles) (e : EdgeCertificate) :=
  endOfRow ts e.a && ts.bottom e.a.tag
theorem forward_increases {r allow mark w ts} (e : EdgeCertificate)
    (arr : Arrow r allow mark w ts e) (forward : Return ts e = false) :
    position w e.a < position w e.b := by
  have h := arr.2.2.2
  change (endOfRow ts e.a && ts.bottom e.a.tag) = false at forward
  simp only [chosenSuccessor,forward,Bool.false_eq_true,if_false] at h
  exact idx_lt _ _ _ (stamp_unique _ _) h.2.2
theorem later_return {r allow mark w ts} (atCell : Nat → EdgeCertificate)
    (arrow : ∀ i, Arrow r allow mark w ts (atCell i))
    (continuous : ∀ i, (atCell i).b = (atCell (i+1)).a) (start : Nat) :
    ∃ offset, Return ts (atCell (start+offset)) = true := by
  apply Classical.byContradiction
  intro none
  have forward (j) : Return ts (atCell (start+j)) = false := by
    cases e : Return ts (atCell (start+j)) with
    | false => rfl
    | true => exact (none ⟨j,e⟩).elim
  have grows (j) : j ≤ position w (atCell (start+j)).a := by
    induction j with
    | zero => exact Nat.zero_le _
    | succ j ih =>
      have inc := forward_increases _ (arrow _) (forward j)
      rw [continuous] at inc
      exact Nat.lt_of_le_of_lt ih inc
  have impossible := grows ((events w).length+1)
  have bound (z : Event) : (events w).idxOf z ≤ (events w).length := by
    by_cases h : z ∈ events w
    · exact Nat.le_of_lt (List.idxOf_lt_length_of_mem h)
    · exact Nat.le_of_eq (List.idxOf_eq_length h)
  have c := bound ((atCell (start+((events w).length+1))).a.owner,0)
  unfold position at impossible
  omega
theorem return_target {r allow mark w ts} (e : EdgeCertificate) (arr : Arrow r allow mark w ts e)
    (back : Return ts e = true) :
    ts.top e.b.tag = true ∧ ts.left e.b.tag = true ∧ ts.oddRow e.b.tag = false ∧ ts.oddColumn e.b.tag = false := by
  have h := arr.2.2.2
  change (endOfRow ts e.a && ts.bottom e.a.tag) = true at back
  simp only [chosenSuccessor,back,if_true] at h
  simpa [and_assoc,P455Witness.Holds] using h.1
def column (n : Nat) (odd : Bool) (j : Nat) := if odd then n-j else j
theorem advance_row {r allow mark w ts} (law : Laws ts) (atCell : Nat → EdgeCertificate)
    (arrow : ∀ i, Arrow r allow mark w ts (atCell i))
    (continuous : ∀ i, (atCell i).b = (atCell (i+1)).a)
    (functional : ∀ i, Functional r allow mark w ts (atCell i).a)
    (index : Nat → Nat) (n : Nat) (odd : Bool)
    (edges : ∀ j, j < n → Holds r allow mark w (rightward ts (atCell (index j)).a (atCell (index (j+1))).a))
    (nonbottom : ∀ j, j ≤ n → ts.bottom (atCell (index j)).a.tag = false)
    (parity : ∀ j, j ≤ n → ts.oddRow (atCell (index j)).a.tag = odd)
    (left : ts.left (atCell (index 0)).a.tag = true) (right : ts.right (atCell (index n)).a.tag = true) :
    let last := column n (!odd) 0
    let start := index last+1
    ∀ j, j ≤ n → (atCell (start+column n (!odd) j)).a = (atCell (index j)).down := by
  let last := column n (!odd) 0
  let start := index last+1
  let row (j : Nat) := (atCell (index (column n (!odd) j))).down
  have lastBound : last ≤ n := by cases odd <;> simp [last,column]
  have ending : endOfRow ts (atCell (index last)).a = true := by
    rw [endOfRow,parity last lastBound]
    cases odd <;> simp_all only [last,column,Bool.not_false,Bool.not_true,if_true,
      Bool.false_eq_true,if_false,Nat.sub_zero]
  obtain ⟨v,h⟩ := lower_row law atCell arrow functional index n edges nonbottom
  have init : (atCell start).a = row 0 :=
    (continuous _).symm.trans (enters_down _ (arrow _) ending (nonbottom _ lastBound))
  have rowOdd (j) (le : j ≤ n) : ts.oddRow (row j).tag= !odd := by
    have c : column n (!odd) j ≤ n := by cases odd <;> simp [column,le,Nat.sub_le]
    exact (law.vert _ _ (v _ c).1).2.2.2.2.2.trans (congrArg Bool.not (parity _ c))
  have adjacent (j) (le : j < n) : Holds r allow mark w
      (if !odd then rightward ts (row (j+1)) (row j) else rightward ts (row j) (row (j+1))) := by
    cases odd with
    | true => exact h j le
    | false =>
      have u := h (n-(j+1)) (by omega)
      have ix : n-(j+1)+1 = n-j := by omega
      simpa only [row,column,Bool.not_false,if_true,ix] using u
  have trace := trace_row law atCell arrow continuous functional row n start (!odd) init rowOdd adjacent
  dsimp only
  intro j le
  have c : column n (!odd) j ≤ n := by cases odd <;> simp [column,le,Nat.sub_le]
  have twice : column n (!odd) (column n (!odd) j) = j := by cases odd <;> simp [column] <;> omega
  simpa only [row,twice,start,last] using trace (column n (!odd) j) c
end P455GridRows
end
section
namespace P455CatalogueBounds
open P455Witness P455Paths P455CertificateReach P455EdgeProjection Problem455.Slots
abbrev W := List Nat
def canonical (ts : Tiles) (e : EdgeCertificate) : EdgeCertificate :=
  ⟨e.a,e.b,if ts.right e.a.tag then e.a else e.right,
    if ts.left e.a.tag then e.a else e.left,if ts.bottom e.a.tag then e.a else e.down,
    if ts.top e.a.tag then e.a else e.up,
    if ts.right e.a.tag || ts.bottom e.a.tag then e.a else e.diagonal⟩
theorem query_canonical (ts : Tiles) (e : EdgeCertificate) :
    (canonical ts e).query ts = e.query ts := by
  cases rr : ts.right e.a.tag <;> cases ll : ts.left e.a.tag <;>
    cases dd : ts.bottom e.a.tag <;> cases uu : ts.top e.a.tag <;> cases oo : ts.oddRow e.a.tag <;>
      simp [canonical,EdgeCertificate.query,localCert,chosenSuccessor,endOfRow,flagQ,rr,ll,dd,uu,oo]
theorem names_canonical (ts : Tiles) (e : EdgeCertificate) : names ts (canonical ts e) = names ts e := by
  cases rr : ts.right e.a.tag <;> cases ll : ts.left e.a.tag <;>
    cases dd : ts.bottom e.a.tag <;> cases uu : ts.top e.a.tag <;>
      simp [canonical,names,nodes,candidates,rr,ll,dd,uu,List.filter_cons]
def fields (e : EdgeCertificate) := [e.a,e.b,e.right,e.left,e.down,e.up,e.diagonal]
theorem original_active (ts : Tiles) (e : EdgeCertificate) {a : Node}
    (h : a∈fields (canonical ts e)) : Active ts e a := by
  simp only [fields,canonical,List.mem_cons,List.not_mem_nil,or_false] at h
  rcases h with eq|eq|eq|eq|eq|eq|eq <;> rw [eq]
  · exact .anchor
  · exact .successor
  · cases f : ts.right e.a.tag <;> simp only [f,Bool.false_eq_true,if_false,if_true]
    · exact .right f
    · exact .anchor
  · cases f : ts.left e.a.tag <;> simp only [f,Bool.false_eq_true,if_false,if_true]
    · exact .left f
    · exact .anchor
  · cases f : ts.bottom e.a.tag <;> simp only [f,Bool.false_eq_true,if_false,if_true]
    · exact .down f
    · exact .anchor
  · cases f : ts.top e.a.tag <;> simp only [f,Bool.false_eq_true,if_false,if_true]
    · exact .up f
    · exact .anchor
  · cases rr : ts.right e.a.tag <;> cases dd : ts.bottom e.a.tag <;>
      simp only [rr,dd,Bool.or_false,Bool.or_true,Bool.false_eq_true,if_false,if_true]
    · exact .diagonal rr dd
    all_goals exact .anchor
def pool (w : W) (tags : List Tag) := w.flatMap (fun x => w.flatMap (fun y => tags.map (Node.mk x y)))
theorem record_in_pool {r allow mark w} (tags : List Tag) (finiteTags : ∀ t,allow t → t ∈ tags)
    (node : Node) (valid : Holds r allow mark w (typedNode node)) : node ∈ pool w tags := by
  obtain ⟨_,_,yes,bit,pr⟩ := valid
  have mem (z : Nat) (side : z = node.owner ∨ z = node.mate) : z∈w := by
    have m : z ∈ select [node.owner,node.mate] w := by
      rw [pr]; rcases side with rfl|rfl <;> simp [profile,profilePrefix]
    exact (List.mem_filter.mp m).1
  exact List.mem_flatMap.mpr ⟨node.owner,mem _ (.inl rfl),List.mem_flatMap.mpr
    ⟨node.mate,mem _ (.inr rfl),List.mem_map.mpr ⟨node.tag,finiteTags _ yes,rfl⟩⟩⟩
theorem bounded_edge {r allow mark ts w} (cap : P455Closure.Cap r w)
    (tags : List Tag) (finiteTags : ∀ t,allow t → t∈tags) (e : EdgeCertificate)
    (read : Holds r allow mark w (e.query ts)) :
    ∃ c : EdgeCertificate, c.a = e.a ∧ c.b = e.b ∧ names ts c = names ts e ∧
      Holds r allow mark w (c.query ts) ∧ ∀ n ∈ fields c, n ∈ pool w tags := by
  exact ⟨canonical ts e,rfl,rfl,names_canonical ..,(query_canonical ts e) ▸ read,
    fun n mem => record_in_pool tags finiteTags n (active_owner cap ts e read (original_active ts e mem)).2⟩
theorem bounded_functionality {r allow ts mark w} (tags : List Tag)
    (finiteTags : ∀ t,allow t → t∈tags) (f : FunctionalityCertificate)
    (ok : Holds r allow mark w (f.query ts)) :
    f.anchor ∈ pool w tags ∧ f.b ∈ pool w tags ∧ f.c ∈ pool w tags := by
  exact ⟨record_in_pool tags finiteTags _ (marked_typed ok.1),
    record_in_pool tags finiteTags _ (neighbor_target_record ok.2.1),
    record_in_pool tags finiteTags _ (neighbor_target_record ok.2.2.1)⟩
end P455CatalogueBounds
end
section
namespace P455PaddedWord
open P455PaddedMatchings P455PaddedPorts P455RectangleRank Problem455.Slots
private theorem cell_role {i a : Nat} (h : a∈roles i) : a = owner i ∨ a = mate i := by simpa [roles] using h
theorem absent_other {i j a : Nat} (r : a∈roles i) (different : i≠j) : a∉roles j := by
  intro m; have p := cell_role r; have q := cell_role m; unfold owner mate at p q; omega
private theorem range_count (i t : Nat) : (List.range t).count i = (if i < t then 1 else 0) := by
  by_cases h : i < t
  · simp [h,count_one List.nodup_range (List.mem_range.mpr h)]
  · simp [h,List.count_eq_zero.mpr (fun m=>h (List.mem_range.mp m))]
private theorem weighted (f : Nat → List Nat) (i a v : Nat) (s : List Nat)
    (w : ∀ j,(f j).count a = (if j = i then v else 0)) : (s.flatMap f).count a = v*s.count i := by
  induction s with
  | nil => simp
  | cons j s ih =>
    by_cases e : j = i
    · subst j; simp [List.flatMap_cons,List.count_append,w,ih,List.count_cons,Nat.mul_add,Nat.add_comm]
    · simp [List.flatMap_cons,List.count_append,w,ih,List.count_cons,e,Ne.symm e]
theorem private_counts (i a : Nat) (role : a∈roles i) (t : Nat) :
    ((List.range t).flatMap privateCell).count a = if i < t then 3 else 0 := by
  have ne : owner i≠mate i := by unfold owner mate; omega
  have ct (j : Nat) : (privateCell j).count a = if j = i then 3 else 0 := by
    by_cases e : j = i
    · subst j; rcases cell_role role with rfl|rfl <;> simp [privateCell,List.count_cons,ne,Ne.symm ne]
    · have no := absent_other role (Ne.symm e)
      have no' : a∉privateCell j := by simpa [roles,privateCell,or_assoc,or_left_comm,or_comm] using no
      simp [List.count_eq_zero.mpr no',e]
  rw [weighted _ _ _ _ _ ct,range_count]; split <;> simp
theorem mutable_counts (i a : Nat) (role : a∈roles i) (bits : Nat → Bool) (t : Nat) :
    ((List.range t).flatMap (mutableCell bits)).count a = if i < t then 1 else 0 := by
  have ne : owner i≠mate i := by unfold owner mate; omega
  have ct (j : Nat) : (mutableCell bits j).count a = if j = i then 1 else 0 := by
    by_cases e : j = i
    · subst j; rcases cell_role role with rfl|rfl <;> cases b : bits i <;> simp [mutableCell,b,List.count_cons,ne,Ne.symm ne]
    · have no := absent_other role (Ne.symm e)
      have no' : a∉mutableCell bits j := by cases b : bits j <;> simpa [roles,mutableCell,b,or_comm] using no
      simp [List.count_eq_zero.mpr no',e]
  rw [weighted _ _ _ _ _ ct,range_count,Nat.one_mul]
theorem port_count {h w : Nat} (size : 1 < w*h) (q i a : Nat) (role : a∈roles i) :
    (letters (matching h w q)).count a = if i < w*h then 2 else 0 := by
  rw [letters,count_role _ i a (cell_role role),count_phase]
  by_cases e : i < w*h
  · simp [e,count_one (matching_unique size q) ((matching_cells size q i).mpr e)]
  · simp [e,List.count_eq_zero.mpr (fun m=> e ((matching_cells size q i).mp m))]
private theorem count_uniform (xs : List Nat) (a v : Nat) (f : Nat → List Nat)
    (each : ∀ j∈xs,(f j).count a = v) : (xs.flatMap f).count a = xs.length*v := by
  induction xs with
  | nil => simp
  | cons j t ih =>
    simp [List.flatMap_cons,List.count_append,each j List.mem_cons_self,
      ih (fun x hx=>each x (List.mem_cons_of_mem _ hx)),Nat.add_mul,Nat.add_comm]
theorem chunks_count {h w : Nat} (size : 1 < w*h) (q i a : Nat) (role : a∈roles i) :
    (portChunks h w q).count a = q*(if i < w*h then 2 else 0) := by
  unfold portChunks
  rw [count_uniform _ _ _ _ (fun j _ => port_count size j i a role),List.length_range]
theorem suffix_count {h w k : Nat} (tag : Nat → List Bool) (i a : Nat) (role : a∈roles i) :
    (suffix h w k tag).count a = if i < w*h then k+1 else 0 := by
  unfold suffix
  have ct (j : Nat) : (tagPhase (w*h) tag j).count a = if i < w*h then 1 else 0 := mutable_counts i a role _ _
  rw [List.count_append,count_uniform (List.range k) a _ (tagPhase (w*h) tag) (fun j _ => ct j),
    List.length_range,count_role _ i a (cell_role role)]
  by_cases e : i < w*h
  · simp [e,count_one (columns_unique h w) ((columns_cells h w i).mpr e)]
  · simp [e,List.count_eq_zero.mpr (fun m=> e ((columns_cells h w i).mp m))]
theorem word_count {h w k : Nat} (size : 1 < w*h) (tag : Nat → List Bool) (bits : Nat → Bool)
    (i a : Nat) (role : a∈roles i) :
    (word (w*h) (middle h w k tag) (tail (w*h)) bits).count a = if i < w*h then k+16 else 0 := by
  simp only [word,middle,tail,List.count_append,private_counts i a role,chunks_count size 5 i a role,
    suffix_count tag i a role,mutable_counts i a role]
  split <;> omega
theorem capped {h w k : Nat} (size : 1 < w*h) (tag : Nat → List Bool) (bits : Nat → Bool) :
    P455Quotient.Cap (k+16) (word (w*h) (middle h w k tag) (tail (w*h)) bits) := by
  intro a
  have role : a∈roles (a/2) := by simp only [roles,List.mem_cons,List.not_mem_nil,or_false,owner,mate]; omega
  rw [word_count size tag bits _ a role]
  split <;> omega
end P455PaddedWord
end
section
namespace P455SingletonEvaluation
open P455Witness P455ContactLift P455CrossedSupport P455SourceFamilies P455SourceTheorem
open P455MarkedPath P455SlotSaturation P455SlotProduct P455RetainedVariant P455Compression
open P455Uncrossed P455PortReflection P455EdgeSource Problem455.Slots
abbrev W := List Nat
def Matches (n : Node) (x y : Nat) :=
  (n.owner = x ∧ n.mate = y) ∨ (n.owner = y ∧ n.mate = x)
def MarksOnly (mark : Marking) (c : Certificate) :=
  ∀ a b, mark a b → ∃ s : Bool, Matches (markedRecord c s) a b
theorem pick_cross {c h mark x y} (only : MarksOnly mark c)
    (hit : ∃ a ∈ h x, ∃ b ∈ h y, mark a b ∨ mark b a) :
    ∃ s, Crosses (markedRecord c s) h x y := by
  obtain ⟨a,ax,b,by',ab|ba⟩ := hit
  · obtain ⟨s,⟨p,q⟩|⟨p,q⟩⟩ := only a b ab
    · exact ⟨s,.inl ⟨p ▸ ax,q ▸ by'⟩⟩
    · exact ⟨s,.inr ⟨p ▸ by',q ▸ ax⟩⟩
  · obtain ⟨s,⟨p,q⟩|⟨p,q⟩⟩ := only b a ba
    · exact ⟨s,.inr ⟨p ▸ by',q ▸ ax⟩⟩
    · exact ⟨s,.inl ⟨p ▸ ax,q ▸ by'⟩⟩
def Violation (r : Nat) (allow : Tag → Prop) (ts : Tiles) (w : W) (x y : Nat) :=
  ∃ (c : Certificate) (s : Bool), Matches (markedRecord c s) x y ∧
    Holds r allow (sourceMarks id c) w (c.query r ts)
theorem changed_anchor (c : Certificate) (s : Bool) (d : Nat → Nat) :
    markedRecord (transferred d c) s = sendNode d (markedRecord c s) := by
  cases c <;> cases s <;> rfl
theorem reindexed_marks (c : Certificate) (d : Nat → Nat) :
    sourceMarks id (transferred d c) = sourceMarks d c := by cases c <;> rfl
theorem compare_uniform {r allow mark T} (capT : P455Quotient.Cap r T)
    (ts : Tiles) (c : Certificate) (only : MarksOnly mark c)
    (tester : Holds r allow mark T (c.query r ts))
    (f : P455Closure.Frame Nat) (l k : W) (x y : Nat) (hp : f.p = [x]) (hq : f.q = [y])
    (fv : f.Valid r allow noMark) (capF : P455Closure.Cap r (side f l k false))
    (u₀ : W) (uf : UniformSlots r allow mark u₀ x y)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (side f l k false))
    (cmp : Compressed r (side f l k false))
    (val : Nat → P455Quotient.Q (rules r allow mark) T)
    (diff : P455Quotient.eval (rules r allow mark) capT val (ruleWord r allow noMark (side f l k false) x y) ≠
      P455Quotient.eval (rules r allow mark) capT val (ruleWord r allow noMark (side f l k true) x y)) :
    ∃ b : Bool, Violation r allow ts (side f l k b) x y := by
  let u := side f l k
  let R := rules r allow mark
  let names := retained r allow noMark (u false) x y
  have mv : P455Closure.Move r allow noMark (u false) (u true) := ⟨f,false,l,k,fv,rfl,rfl,capF⟩
  have cbit (b : Bool) : P455Closure.Cap r (u b) := by cases b; exact capF; exact mv.cap_right
  have fc (b : Bool) : ClosedFlip r allow (u b) x y := ⟨f,b,l,k,hp,hq,fv,rfl⟩
  obtain ⟨hr,cx,cy,_⟩ := flip_counts capF (fc false)
  have hi : 0 < r := by omega
  have hx : x ∈ names := mem_retained.mpr ⟨List.count_pos_iff.mp (cx.symm ▸ hi),.inl (.inl (P455Paths.near_self ..))⟩
  have hy : y ∈ names := mem_retained.mpr ⟨List.count_pos_iff.mp (cy.symm ▸ hi),.inl (.inr (P455Paths.near_self ..))⟩
  obtain ⟨g,L,K,gp,gq,gv,both,_⟩ := P455CompressedFrame.canonical_pair f l k names hx hy hp hq fv false capF
  have perm (b : Bool) : names.Perm (retained r allow noMark (u b) x y) := by
    cases b
    · exact List.Perm.refl _
    · exact same_retained mv x y
  have eq0 (b : Bool) : ruleWord r allow noMark (u b) x y = side g L K b :=
    (small_congr_names _ (perm b).symm).trans (both b)
  have eqm (b : Bool) : ruleWord r allow mark (u b) x y = side g L K b := by
    unfold ruleWord; rw [retained_remark (mark' := noMark)]; exact eq0 b
  have neq : P455Quotient.eval R capT val (side g L K false) ≠ P455Quotient.eval R capT val (side g L K true) := by
    rw [← eq0,← eq0]; exact diff
  obtain ⟨b,live,⟨h,represent⟩,_⟩ := difference_live_representatives capT g L K val neq
  have reps := fun a ha => (represent a ha).2
  have nd : P455Quotient.eval R capT val (side g L K b) ≠ P455Quotient.eval R capT val (side g L K (!b)) := by
    cases b
    · exact neq
    · exact Ne.symm neq
  obtain ⟨s,cs⟩ := pick_cross only (difference_crosses capT g L K b x y gp gq gv val h reps nd)
  let v := ruleWord r allow mark (u b) x y
  have repv : ∀ a ∈ v, P455Quotient.ofWord R T (h a) = val a := by rw [show v = _ from eqm b]; exact reps
  have livev : P455Quotient.eval R capT val v ≠ P455Quotient.zero R T := by rw [show v = _ from eqm b]; exact live
  have pb : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (u b) := by
    cases b; exact path; exact .snoc path mv
  have cb : Compressed r (u b) := by
    cases b
    · exact cmp
    · intro a z link
      exact cmp a z ((Problem455BlockBridge.move_link mv a z).mpr link)
  obtain ⟨_,_,_,_,_,_,_,_,_,_,read,_⟩ := crossed_gadget capT (u b) (cbit b) x y (fc b)
    (uniform_variant pb uf) h val repv livev ts c tester s false cs
  let names' := retained r allow mark (u b) x y
  obtain ⟨_,ax,ay,_⟩ := flip_counts (cbit b) (fc b)
  have eqNames : names.Perm names' := by
    change names.Perm (retained r allow mark (u b) x y)
    rw [retained_remark (mark' := noMark)]; exact perm b
  have xcnt : v.count x = r := (counts_retained _ _ _ (eqNames.mem_iff.mp hx)).trans ax
  have ycnt : v.count y = r := (counts_retained _ _ _ (eqNames.mem_iff.mp hy)).trans ay
  have ev := P455Quotient.eval_rep R capT val v h repv
  have good := (P455Quotient.nonzero_iff R).mp (ev ▸ livev)
  have cap := P455Quotient.good_cap R capT good
  let d := donor v h r
  refine ⟨b,transferred d c,s,?_,?_⟩
  · rw [changed_anchor]
    rcases cs with ⟨o,m⟩|⟨o,m⟩
    · exact .inl ⟨donor_eq hi cap ⟨xcnt,o⟩,donor_eq hi cap ⟨ycnt,m⟩⟩
    · exact .inr ⟨donor_eq hi cap ⟨ycnt,o⟩,donor_eq hi cap ⟨xcnt,m⟩⟩
  · rw [reindexed_marks]; exact read cb
end P455SingletonEvaluation
end
section
namespace P455GridAssembly
open P455GridRows P455Witness Problem455.Slots
abbrev W := List Nat
structure Rectangle (allow : Tag → Prop) (ts : Tiles) where
  height : Nat
  width : Nat
  tile : Nat → Nat → Tag
  allowed : ∀ i j, i ≤ height → j ≤ width → allow (tile i j)
  horiz : ∀ i j, i ≤ height → j < width → ts.horizontal (tile i j) (tile i (j+1))
  vert : ∀ i j, i < height → j ≤ width → ts.vertical (tile i j) (tile (i+1) j)
  left : ∀ i j, i ≤ height → j ≤ width → (ts.left (tile i j) = true ↔ j = 0)
  right : ∀ i j, i ≤ height → j ≤ width → (ts.right (tile i j) = true ↔ j = width)
  top : ∀ i j, i ≤ height → j ≤ width → (ts.top (tile i j) = true ↔ i = 0)
  bottom : ∀ i j, i ≤ height → j ≤ width → (ts.bottom (tile i j) = true ↔ i = height)
structure Row {r : Nat} {allow : Tag → Prop} {mark : Marking} {w : W} (ts : Tiles)
    (c : Nat → EdgeCertificate) (s n : Nat) (odd : Bool) : Prop where
  parity : ∀ j, j ≤ n → ts.oddRow (c (s+column n odd j)).a.tag = odd
  left : ts.left (c (s+column n odd 0)).a.tag = true
  right : ts.right (c (s+column n odd n)).a.tag = true
  links : ∀ j, j < n → Holds r allow mark w
    (rightward ts (c (s+column n odd j)).a (c (s+column n odd (j+1))).a)
private theorem min_bounded (p : Nat → Prop) (j : Nat) (yes : p j) :
    ∃ a, p a ∧ ∀ b, b < a → ¬ p b := by
  induction j using Nat.strongRecOn with
  | ind j ih =>
    by_cases e : ∃ k, k < j ∧ p k
    · obtain ⟨k,lt,ok⟩ := e
      exact ih k lt ok
    · exact ⟨j,yes,fun b lt pb => e ⟨b,lt,pb⟩⟩
private theorem right_step {r allow mark w ts} (c : Nat → EdgeCertificate)
    (arr : ∀ i, Arrow r allow mark w ts (c i)) (cont : ∀ i,(c i).b = (c (i+1)).a)
    (i : Nat) (p : ts.oddRow (c i).a.tag = false) (q : ts.right (c i).a.tag = false) :
    Holds r allow mark w (rightward ts (c i).a (c (i+1)).a) := by
  have ending : endOfRow ts (c i).a = false := by simp [endOfRow,p,q]
  have hs := (arr i).2.2.2
  simp only [chosenSuccessor,ending,Bool.false_and,Bool.false_eq_true,if_false,p] at hs
  have h := (arr i).2.2.1.1
  simp only [q,Bool.not_false,flagQ,if_true] at h
  rw [← cont, ← hs.1]
  exact h
private theorem first_row {r allow mark w ts} (law : Laws ts) (c : Nat → EdgeCertificate)
    (arr : ∀ i, Arrow r allow mark w ts (c i)) (cont : ∀ i,(c i).b = (c (i+1)).a)
    (s : Nat) (left : ts.left (c s).a.tag = true) (par : ts.oddRow (c s).a.tag = false) :
    ∃ n, @Row r allow mark w ts c s n false := by
  obtain ⟨j,ret⟩ := later_return c arr cont s
  have parity (a) (before : ∀ k, k < a → ts.right (c (s+k)).a.tag≠true) :
      ts.oddRow (c (s+a)).a.tag = false := by
    induction a with
    | zero => simpa using par
    | succ a ih =>
      have p := ih (fun k lt => before k (by omega))
      have q : ts.right (c (s+a)).a.tag = false := by
        have n := before a (by omega)
        cases b : ts.right (c (s+a)).a.tag <;> simp_all
      have step := right_step c arr cont (s+a) p q
      exact (law.horiz _ _ step.1).2.2.2.2.1.symm.trans p
  have hasRight : ∃ a, ts.right (c (s+a)).a.tag = true := by
    apply Classical.byContradiction; intro missing
    have noR (a) : ts.right (c (s+a)).a.tag≠true := fun ok => missing ⟨a,ok⟩
    have p := parity j (fun k _ => noR k)
    have q : ts.right (c (s+j)).a.tag = false := by
      cases b : ts.right (c (s+j)).a.tag <;> simp_all
    simp [Return,endOfRow,p,q] at ret
  obtain ⟨a,ha⟩ := hasRight
  obtain ⟨n,last,prior⟩ := min_bounded (fun i => ts.right (c (s+i)).a.tag = true) a ha
  refine ⟨n,?_,?_,?_,?_⟩
  · intro k le; exact parity k (fun b lt => prior b (by omega))
  · simpa [column] using left
  · exact last
  · intro k lt
    have p := parity k (fun b lb => prior b (by omega))
    have q : ts.right (c (s+k)).a.tag = false := by
      have off := prior k lt
      cases b : ts.right (c (s+k)).a.tag <;> simp_all
    exact right_step c arr cont (s+k) p q
private theorem row_const (n : Nat) (f : Nat → Bool) (step : ∀ j, j < n → f j = f (j+1)) :
    ∀ j, j ≤ n → f j = f 0 := by
  intro j
  induction j with
  | zero => simp
  | succ j ih => intro le; exact (step j (by omega)).symm.trans (ih (by omega))
private theorem next_row {r allow mark w ts} (law : Laws ts) (c : Nat → EdgeCertificate)
    (arr : ∀ i, Arrow r allow mark w ts (c i)) (cont : ∀ i,(c i).b = (c (i+1)).a)
    (funct : ∀ i, Functional r allow mark w ts (c i).a)
    {s n odd} (row : @Row r allow mark w ts c s n odd)
    (nonbottom : ∀ j, j ≤ n → ts.bottom (c (s+column n odd j)).a.tag = false) :
    @Row r allow mark w ts c (s+n+1) n (!odd) ∧
    ∀ j, j ≤ n → Holds r allow mark w
      (downward ts (c (s+column n odd j)).a (c ((s+n+1)+column n (!odd) j)).a) := by
  let ix (j : Nat) := s+column n odd j
  have tr := advance_row law c arr cont funct ix n odd row.links nonbottom row.parity row.left row.right
  have en : ix (column n (!odd) 0) = s+n := by cases odd <;> simp [ix,column]
  simp only [en] at tr
  obtain ⟨vs,hs⟩ := lower_row law c arr funct ix n row.links nonbottom
  have down (j : Nat) (le : j ≤ n) : Holds r allow mark w
      (downward ts (c (ix j)).a (c ((s+n+1)+column n (!odd) j)).a) := by
    rw [tr j le]; exact vs j le
  refine ⟨⟨?_,?_,?_,?_⟩,down⟩
  · intro j le
    exact (law.vert _ _ (down j le).1).2.2.2.2.2.trans (congrArg Bool.not (row.parity _ le))
  · exact (law.vert _ _ (down 0 (by omega)).1).2.2.1.trans row.left
  · exact (law.vert _ _ (down n (by omega)).1).2.2.2.1.trans row.right
  · intro j lt; rw [tr j (by omega),tr (j+1) (by omega)]; exact hs _ lt
private structure Strip (allow : Tag → Prop) (ts : Tiles) (n : Nat) (first : Nat → Tag) where
  h : Nat
  t : Nat → Nat → Tag
  head : ∀ j, j ≤ n → t 0 j = first j
  ok : ∀ i j, i ≤ h → j ≤ n → allow (t i j)
  horizontal : ∀ i j, i ≤ h → j < n → ts.horizontal (t i j) (t i (j+1))
  vertical : ∀ i j, i < h → j ≤ n → ts.vertical (t i j) (t (i+1) j)
  l : ∀ i j, i ≤ h → j ≤ n → (ts.left (t i j) = true ↔ j = 0)
  r : ∀ i j, i ≤ h → j ≤ n → (ts.right (t i j) = true ↔ j = n)
  b : ∀ i j, i ≤ h → j ≤ n → (ts.bottom (t i j) = true ↔ i = h)
  noTop : ∀ i j, 0 < i → i ≤ h → j ≤ n → ts.top (t i j) = false
private theorem build {r allow mark w ts} (law : Laws ts) (c : Nat → EdgeCertificate)
    (arr : ∀ i, Arrow r allow mark w ts (c i)) (cont : ∀ i,(c i).b = (c (i+1)).a)
    (funct : ∀ i, Functional r allow mark w ts (c i).a)
    (J : Nat) (ret : Return ts (c J) = true) (fuel : Nat) :
    ∀ s n odd, s ≤ J → J-s ≤ fuel → @Row r allow mark w ts c s n odd →
    Nonempty (Strip allow ts n (fun j => (c (s+column n odd j)).a.tag)) := by
  induction fuel using Nat.strongRecOn with
  | ind fuel ih =>
    intro s n odd bound time row
    let tag (j : Nat) := (c (s+column n odd j)).a.tag
    have ok (j : Nat) : allow (tag j) := (arr _).1.2.2.1
    have H (j) (lt : j < n) : ts.horizontal (tag j) (tag (j+1)) := (row.links j lt).1
    have L (j) (le : j ≤ n) : ts.left (tag j) = true ↔ j = 0 := by
      cases j with
      | zero => simp [tag,row.left]
      | succ j => simp [(law.horiz _ _ (H j (by omega))).2.1]
    have R (j) (le : j ≤ n) : ts.right (tag j) = true ↔ j = n := by
      by_cases eq : j = n
      · subst j; simp [tag,row.right]
      · have lt : j < n := by omega
        simp [(law.horiz _ _ (H j lt)).1,eq]
    have B := row_const n (fun j => ts.bottom (tag j)) (fun j lt => (law.horiz _ _ (H j lt)).2.2.2.1)
    cases bot : ts.bottom (tag 0) with
    | true =>
      refine ⟨⟨0,fun _ => tag,fun _ _ => rfl,fun _ j _ _ => ok j,
        fun _ j _ lt => H j lt,fun _ _ lt _ => by omega,fun _ j _ => L j,
        fun _ j _ => R j,?_,fun _ _ pos le _ => by omega⟩⟩
      intro i j il jl
      have bi := (B j jl).trans bot
      simp [bi,Nat.le_zero.mp il]
    | false =>
      have nonbottom (j : Nat) (le : j ≤ n) : ts.bottom (tag j) = false := (B j le).trans bot
      have nextLe : s+n+1 ≤ J := by
        apply Classical.byContradiction; intro short
        have small : J-s ≤ n := by omega
        let j := column n odd (J-s)
        have inRow : j ≤ n := by cases odd <;> simp [j,column,small,Nat.sub_le]
        have atJ : s+column n odd j = J := by cases odd <;> simp [j,column] <;> omega
        have off := nonbottom j inRow
        change ts.bottom (c (s+column n odd j)).a.tag = false at off
        rw [atJ] at off
        simp [Return,off] at ret
      obtain ⟨low,V⟩ := next_row law c arr cont funct row nonbottom
      obtain ⟨below⟩ := ih (J-(s+n+1)) (by omega) (s+n+1) n (!odd) nextLe (by omega) low
      let t : Nat → Nat → Tag
        | 0 => tag
        | i+1 => below.t i
      refine ⟨⟨below.h+1,t,fun _ _ => rfl,?_,?_,?_,?_,?_,?_,?_⟩⟩
      · intro i j le jl; cases i with
        | zero => exact ok j
        | succ i => exact below.ok i j (by omega) jl
      · intro i j le jl; cases i with
        | zero => exact H j jl
        | succ i => exact below.horizontal i j (by omega) jl
      · intro i j lt jl; cases i with
        | zero =>
          change ts.vertical (tag j) (below.t 0 j)
          rw [below.head _ jl]; exact (V j jl).1
        | succ i => exact below.vertical i j (by omega) jl
      · intro i j le jl; cases i with
        | zero => exact L j jl
        | succ i => exact below.l i j (by omega) jl
      · intro i j le jl; cases i with
        | zero => exact R j jl
        | succ i => exact below.r i j (by omega) jl
      · intro i j le jl; cases i with
        | zero => change ts.bottom (tag j) = true ↔ _; simp [nonbottom j jl]
        | succ i => exact (below.b i j (by omega) jl).trans (by omega)
      · intro i j pos le jl
        cases i with
        | zero => omega
        | succ i =>
          cases i with
          | zero =>
            change ts.top (below.t 0 j) = false
            rw [below.head _ jl]; exact (law.vert _ _ (V j jl).1).2.1
          | succ i => exact below.noTop _ j (by omega) (by omega) jl
theorem rectangle_of_trace {r allow mark w ts} (law : Laws ts) (c : Nat → EdgeCertificate)
    (arr : ∀ i, Arrow r allow mark w ts (c i)) (cont : ∀ i,(c i).b = (c (i+1)).a)
    (funct : ∀ i, Functional r allow mark w ts (c i).a) : Nonempty (Rectangle allow ts) := by
  obtain ⟨k,ret⟩ := later_return c arr cont 0
  simp only [Nat.zero_add] at ret
  have start := return_target _ (arr k) ret
  rw [cont] at start
  let s := k+1
  obtain ⟨n,row⟩ := first_row law c arr cont s start.2.1 start.2.2.1
  obtain ⟨off,ending⟩ := later_return c arr cont s
  have tops := row_const n (fun j => ts.top (c (s+j)).a.tag)
    (fun j lt => (law.horiz _ _ (row.links j lt).1).2.2.1)
  obtain ⟨box⟩ := build law c arr cont funct (s+off) ending off s n false (by omega) (by omega) row
  refine ⟨⟨box.h,n,box.t,box.ok,box.horizontal,box.vertical,box.l,box.r,?_,box.b⟩⟩
  intro i j le jl
  cases i with
  | zero =>
    rw [box.head j jl]
    have same := (tops j jl).trans (by simpa [s] using start.1)
    simpa [column] using (show ts.top (c (s+j)).a.tag = true ↔ 0 = 0 from by simp [same])
  | succ i => simp [box.noTop _ j (by omega) le jl]
end P455GridAssembly
end
