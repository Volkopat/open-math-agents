namespace P455Structural
open P455Witness P455Quotient P455Closure P455Uncrossed Problem455.Slots
open P455SourceFamilies P455FirstTesters
private theorem image_edge (h : Nat → W) (x a b : Nat)
    (pos : 0 < Problem455Swap.bigram a b (h x)) (u : W) :
    u.count x ≤ Problem455Swap.bigram a b (u.flatMap h) := by
  induction u with
  | nil => simp [Problem455Swap.bigram]
  | cons z u ih =>
    simp only [List.flatMap_cons,Problem455Swap.bigram_append]
    by_cases e : z = x
    · subst z; simp [List.count_cons]; omega
    · simp [List.count_cons,e]; omega
private theorem singleton_in_template {r : Nat} {T p q u : W} {h : Nat → W} {x : Nat}
    (eq : T = p ++ u.flatMap h ++ q) (cap : P455Closure.Cap r T) (cmp : Compressed r T)
    (cx : u.count x = r) (nonempty : h x ≠ []) : ∃ a, h x = [a] := by
  cases z : h x with
  | nil => exact False.elim (nonempty z)
  | cons a t =>
    cases t with
    | nil => exact ⟨a,rfl⟩
    | cons b t =>
      have pair : 0 < Problem455Swap.bigram a b (h x) := by
        rw [z]; simp [Problem455Swap.bigram,Problem455Swap.hit] <;> omega
      have base := image_edge h x a b pair u
      have low : r ≤ Problem455Swap.bigram a b T := by
        rw [eq,Problem455Swap.bigram_append,Problem455Swap.bigram_append]; omega
      have top := Problem455Swap.out_bound a b (b+1) (by omega) T
      rw [Problem455BlockBridge.occ_count] at top
      have high := cap a
      exact False.elim (cmp a b (by unfold Problem455Swap.Link; omega))
private theorem image_count {r : Nat} (h : Nat → W) (u : W) (x a : Nat)
    (c : u.count x = r) (img : h x = [a]) : r ≤ (u.flatMap h).count a := by
  have h := P455DonorInterval.split_contributions h u x a
  simp [img,c] at h
  omega
theorem structural_factor {r T allow} (cap : P455Closure.Cap r T) (cmp : Compressed r T)
    (stest : Structural T r allow) (f : Frame Nat) (l k : W) (bit : Bool) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (h : Nat → W) (fac : Factor ((side f l k bit).flatMap h) T) :
    (side f l k bit).flatMap h = (side f l k (!bit)).flatMap h := by
  obtain ⟨pre,post,eq⟩ := fac
  have eqCore : T = (pre ++ l.flatMap h) ++ (f.core bit).flatMap h ++ (k.flatMap h ++ post) := by
    simpa [side,List.flatMap_append,List.append_assoc] using eq
  have count (z : Nat) (role : z = x ∨ z = y) : (f.core bit).count z = r := by
    have has : z ∈ f.p ∨ z ∈ f.q := by simpa [hp,hq] using role
    have orig := valid.2.2.2.2.2.2.2 z has
    cases bit with
    | false => exact orig
    | true => exact (f.count_core z true).trans orig
  have commute : h x ++ h y = h y ++ h x := by
    by_cases nx : h x = []
    · simp [nx]
    by_cases ny : h y = []
    · simp [ny]
    obtain ⟨a,ax⟩ := singleton_in_template eqCore cap cmp (count x (.inl rfl)) nx
    obtain ⟨b,by'⟩ := singleton_in_template eqCore cap cmp (count y (.inr rfl)) ny
    by_cases ab : a = b
    · simp [ax,by',ab]
    exfalso
    apply structural_excludes_closed stest
    let L := pre ++ l.flatMap h
    have fresh (z s : Nat) (kind : z = x ∨ z = y) (im : h z = [s]) : s ∉ L := by
      have bound := cap s
      rw [eqCore] at bound
      have ct := image_count h (f.core bit) z s (count z kind) im
      apply List.count_eq_zero.mp
      dsimp [L]
      simp only [List.count_append] at bound ⊢
      omega
    let tail := f.mid ++ f.beforeMutable ++ f.pair bit ++ f.beforeFinalP ++ f.p ++ f.beforeFinalQ ++ f.q
    have shape : f.core bit = f.early ++ tail := by simp [Frame.core,tail,List.append_assoc]
    refine ⟨ab,L,tail.flatMap h ++ (k.flatMap h ++ post),?_,fresh x a (.inl rfl) ax,fresh y b (.inr rfl) by'⟩
    rw [eqCore,shape]
    simp [L,Frame.early,hp,hq,List.flatMap_append,List.flatMap_cons,ax,by',List.append_assoc,early]
  cases bit <;>
    simp only [side,Frame.core,Frame.pair,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,
      Bool.false_eq_true,if_false,if_true,Bool.not_false,Bool.not_true,hp,hq,List.append_nil] <;>
    rw [commute]
private theorem plain_factor {r : Nat} {T u : W} (g : Good (plain r) T u) : Factor u T := by
  obtain ⟨v,walk,fac⟩ := g
  have e : T = v := by induction walk with
                      | refl => rfl
                      | snoc _ impossible _ => exact False.elim impossible
  exact e ▸ fac
theorem structural_eval {r T allow} (cap : P455Closure.Cap r T) (cmp : Compressed r T)
    (stest : Structural T r allow) (f : Frame Nat) (l k : W) (x y : Nat)
    (hp : f.p=[x]) (hq : f.q=[y]) (valid : f.Valid r allow (fun _ _ => False))
    (val : Nat → Q (plain r) T) :
    eval (plain r) cap val (side f l k false) = eval (plain r) cap val (side f l k true) := by
  classical
  apply Classical.byContradiction
  intro d
  let R := plain r
  have live : ∃ b : Bool, eval R cap val (side f l k b) ≠ zero R T := by
    by_cases nz : eval R cap val (side f l k false) ≠ zero R T
    · exact ⟨false,nz⟩
    · exact ⟨true,fun eq => d ((Classical.not_not.mp nz).trans eq.symm)⟩
  obtain ⟨b,nz⟩ := live
  let u := side f l k b
  have existsRep (a : Nat) (ha : a ∈ u) :=
    nonzero_representative R (val a) (live_inputs R cap val _ nz a ha)
  let h (a : Nat) := if yes : a ∈ u then (existsRep a yes).choose else []
  have rep (a) (mem : a ∈ u) : ofWord R T (h a) = val a := by
    simpa only [h,dif_pos mem] using (existsRep a mem).choose_spec.2
  have p455Original := eval_rep R cap val u h rep
  have separated := structural_factor cap cmp stest f l k b x y hp hq valid h
    (plain_factor ((nonzero_iff R).mp (p455Original ▸ nz)))
  have other := eval_rep R cap val (side f l k (!b)) h
    (fun a ha => rep a ((same_letters f l k b a).mpr ha))
  have done := p455Original.trans ((congrArg (ofWord R T) separated).trans other.symm)
  cases b
  · exact d done
  · exact d done.symm
end P455Structural
end
section
namespace P455PaddedPorts
open P455RectangleRank Problem455.Slots
abbrev W := List Nat
inductive Block where
  | single (i : Nat)
  | pair (i j : Nat)
  deriving DecidableEq
def cells : Block → W
  | .single i => [i]
  | .pair i j => [i,j]
def phase (bs : List Block) := bs.flatMap fun b => cells b ++ cells b
def roles (i : Nat) := [owner i,mate i]
def letters (bs : List Block) := (phase bs).flatMap roles
private theorem singleton_head {i j u : Nat} {p : W} (ne : i≠j)
    (eq : u :: u :: p = [i,j,i,j]) : False := by
  obtain ⟨rfl,e⟩ := List.cons.inj eq
  exact ne (List.cons.inj e).1
private theorem only_pair (bs : List Block) (i j : Nat) (ne : i≠j)
    (obs : select [i,j] (phase bs)=[i,j,i,j]) : Block.pair i j ∈ bs := by
  induction bs with
  | nil => simp [phase,select] at obs
  | cons b bs ih =>
    change select [i,j] ((cells b ++ cells b) ++ phase bs) = _ at obs
    rw [select_append,select_append] at obs
    cases b with
    | single u =>
      by_cases hu : u = i ∨ u = j
      · have su : select [i,j] [u]=[u] := by simp [select,hu]
        simp only [cells,su,List.cons_append,List.nil_append] at obs
        exact (singleton_head ne obs).elim
      · have su : select [i,j] [u]=[] := by simp [select,hu]
        simp only [cells,su,List.nil_append] at obs
        exact List.mem_cons_of_mem _ (ih obs)
    | pair u v =>
      by_cases hu : u = i ∨ u = j <;> by_cases hv : v = i ∨ v = j
      · have sv : select [i,j] [u,v]=[u,v] := by simp [select,hu,hv]
        simp only [cells,sv,List.cons_append,List.nil_append,List.cons.injEq] at obs
        obtain ⟨rfl,rfl,_⟩ := obs
        exact List.mem_cons_self
      · have sv : select [i,j] [u,v]=[u] := by simp [select,hu,hv]
        simp only [cells,sv,List.cons_append,List.nil_append] at obs
        exact (singleton_head ne obs).elim
      · have sv : select [i,j] [u,v]=[v] := by simp [select,hu,hv]
        simp only [cells,sv,List.cons_append,List.nil_append] at obs
        exact (singleton_head ne obs).elim
      · have sv : select [i,j] [u,v]=[] := by simp [select,hu,hv]
        simp only [cells,sv,List.nil_append] at obs
        exact List.mem_cons_of_mem _ (ih obs)
private theorem phase_mem (bs : List Block) (x : Nat) : x∈phase bs ↔ x∈bs.flatMap cells := by
  simp [phase,List.mem_flatMap]
private theorem pair_present {bs : List Block} (nd : (bs.flatMap cells).Nodup)
    (i j : Nat) (present : Block.pair i j ∈ bs) : select [i,j] (phase bs)=[i,j,i,j] := by
  obtain ⟨pre,post,eq⟩ := List.append_of_mem present
  subst bs
  change ((_ ++ (.pair i j :: post)).flatMap cells).Nodup at nd
  simp only [List.flatMap_append,List.flatMap_cons,cells,List.cons_append,List.nil_append] at nd
  have parts := List.pairwise_append.mp nd
  have hits (x : Nat) (m : x∈pre.flatMap cells) : x∉[i,j] := by
    intro e
    have no := parts.2.2 x m x (by simpa using List.mem_append_left (post.flatMap cells) e : x∈i::j::post.flatMap cells)
    exact no rfl
  have ends (x : Nat) (m : x∈post.flatMap cells) : x∉[i,j] := by
    have hi := (List.nodup_cons.mp parts.2.1).1
    have hj := (List.nodup_cons.mp (List.nodup_cons.mp parts.2.1).2).1
    intro e
    rcases (show x = i ∨ x = j by simpa using e) with rfl|rfl
    · exact hi (List.mem_cons_of_mem _ m)
    · exact hj m
  have s1 := select_nil [i,j] (phase pre) (fun x m => hits x ((phase_mem ..).mp m))
  have s2 := select_nil [i,j] (phase post) (fun x m => ends x ((phase_mem ..).mp m))
  change select [i,j] ((pre ++ .pair i j :: post).flatMap _) = _
  rw [List.flatMap_append,List.flatMap_cons,select_append]
  change select [i,j] (phase pre) ++ select [i,j] (([i,j] ++ [i,j]) ++ phase post) = _
  rw [s1,select_append,s2]
  simp [select]
theorem phase_exact {bs : List Block} (nd : (bs.flatMap cells).Nodup)
    (i j : Nat) (ne : i≠j) :
    select [i,j] (phase bs)=[i,j,i,j] ↔ Block.pair i j∈bs :=
  ⟨only_pair bs i j ne,pair_present nd i j⟩
private theorem roles_inj {s t : W} (eq : s.flatMap roles = t.flatMap roles) : s = t := by
  induction s generalizing t with
  | nil => cases t <;> simp_all [roles]
  | cons i s ih =>
    cases t with
    | nil => simp [roles] at eq
    | cons j t =>
      simp only [List.flatMap_cons,roles,List.cons_append,List.nil_append,List.cons.injEq] at eq
      have e : i = j := by have := eq.1; unfold owner at this; omega
      rw [e,ih eq.2.2]
private theorem role_selection (s : W) (i j : Nat) :
    select (roles i ++ roles j) (s.flatMap roles) = (select [i,j] s).flatMap roles := by
  induction s with
  | nil => rfl
  | cons a s ih =>
    by_cases h : a = i ∨ a = j
    · have kept : select (roles i ++ roles j) (roles a) = roles a := by
        rcases h with rfl|rfl <;> simp [roles,select]
      have er : select [i,j] (a::s) = a::select [i,j] s := by simp [select,h]
      simp only [List.flatMap_cons,select_append,kept,ih,er]
    · have hf : a≠i ∧ a≠j := by simpa using h
      have non : ∀ b∈roles a, b∉roles i ++ roles j := by
        intro b m n
        simp only [roles,List.cons_append,List.nil_append,List.mem_cons,List.not_mem_nil,or_false] at m n
        unfold owner mate at m n
        omega
      have erased := select_nil _ _ non
      have er : select [i,j] (a::s) = select [i,j] s := by simp [select,h]
      simp only [List.flatMap_cons,select_append,erased,ih,er,List.nil_append]
theorem literal_phase_exact {bs : List Block} (nd : (bs.flatMap cells).Nodup)
    (i j : Nat) (ne : i≠j) :
    select (roles i ++ roles j) (letters bs) =
      [owner i,mate i,owner j,mate j,owner i,mate i,owner j,mate j] ↔
      Block.pair i j∈bs := by
  unfold letters
  rw [role_selection,← phase_exact nd i j ne]
  change _ = [i,j,i,j].flatMap roles ↔ _
  exact ⟨roles_inj,congrArg (List.flatMap roles)⟩
end P455PaddedPorts
end
section
namespace P455EffectivePrefix
open P455EffectiveMachine P455MachineLocal P455MachineTable P455MachineCleanup
inductive Cmd (g : Nat) | right | left | putRight (v : Fin g)
structure Env (g : Nat) where
  tape : Nat → Fin g
  pos : Nat
def Env.start (env : Env g) (M : Ordinary g q) : Config g q := ⟨env.tape,env.pos,M.start⟩
def write (mark : Fin g) (cmd : Cmd g) (a : Fin g) :=
  match cmd with
  | .putRight v => if a = mark ∨ v = mark then a else v
  | _ => a
def motion (mark : Fin g) (cmd : Cmd g) (a : Fin g) : Direction :=
  match cmd with
  | .left => if a = mark then .stay else .left
  | _ => .right
def effect (mark : Fin g) (cmd : Cmd g) (env : Env g) : Env g :=
  let a := env.tape env.pos
  ⟨writeAt env.tape env.pos (write mark cmd a),dest (motion mark cmd a) env.pos⟩
theorem write_marker (mark : Fin g) (cmd : Cmd g) (a) :
    write mark cmd a = mark ↔ a = mark := by
  cases cmd <;> simp [write]
  split <;> simp_all
theorem safe_motion (mark : Fin g) (cmd : Cmd g) : motion mark cmd mark ≠ .left := by
  cases cmd <;> simp [motion]
def old (s : Fin q) : Fin (q+1) := ⟨s.val,by have := s.isLt; omega⟩
def head (q) : Fin (q+1) := ⟨q,by omega⟩
def liftIns (i : Ins (Fin g) (Fin q)) : Ins (Fin g) (Fin (q+1)) := ⟨old i.state,i.symbol,i.dir⟩
def push (M : Ordinary g q) (cmd : Cmd g) : Ordinary g (q+1) where
  marker := M.marker
  blank := M.blank
  blank_ne := M.blank_ne
  start := head q
  delta s a := if h : s.val < q then (M.delta ⟨s.val,h⟩ a).map liftIns
    else some ⟨old M.start,write M.marker cmd a,motion M.marker cmd a⟩
  keeps := by
    intro s a i eq
    split at eq
    next h =>
      cases e : M.delta ⟨s.val,h⟩ a with
      | none => simp [e] at eq
      | some j => rw [e] at eq; change some (liftIns j) = some i at eq; obtain rfl := Option.some.inj eq; exact M.keeps _ _ _ e
    next =>
      simp only [Option.some.injEq] at eq
      subst i; exact write_marker ..
  leftSafe := by
    intro s i eq
    split at eq
    next h =>
      cases e : M.delta ⟨s.val,h⟩ M.marker with
      | none => simp [e] at eq
      | some j => rw [e] at eq; change some (liftIns j) = some i at eq; obtain rfl := Option.some.inj eq; exact M.leftSafe _ _ e
    next =>
      simp only [Option.some.injEq] at eq
      subst i; exact safe_motion M.marker cmd
def liftConfig (c : Config g q) : Config g (q+1) := ⟨c.tape,c.pos,old c.state⟩
theorem old_ins (M : Ordinary g q) (cmd) (s a) :
    (push M cmd).delta (old s) a = (M.delta s a).map liftIns := by
  simp [push,old,s.isLt]
theorem head_ins (M : Ordinary g q) (cmd) (a) :
    (push M cmd).delta (head q) a = some ⟨old M.start,write M.marker cmd a,motion M.marker cmd a⟩ := by
  simp [push,head]
theorem once_old (M : Ordinary g q) (cmd) (c : Config g q) :
    once (push M cmd) (liftConfig c) = liftConfig (once M c) := by
  cases c with
  | mk tape pos s =>
    cases h : M.delta s (tape pos) <;> simp [once,instruction,liftConfig,old_ins,h,liftIns]
theorem after_one (M : Ordinary g q) (cmd) (e : Env g) (t) :
    follow (push M cmd) (e.start (push M cmd)) (t+1)=
      liftConfig (follow M ((effect M.marker cmd e).start M) t) := by
  induction t with
  | zero =>
    change once (push M cmd) ⟨e.tape,e.pos,head q⟩=_
    simp [once,instruction,head_ins,follow,liftConfig,effect,Env.start]
  | succ t ih => rw [follow,ih,once_old,follow]
theorem push_iff (M : Ordinary g q) (cmd) (e : Env g) :
    HALT (push M cmd) (e.start (push M cmd)) ↔ HALT M ((effect M.marker cmd e).start M) := by
  constructor
  · rintro ⟨t,fin⟩
    cases t with
    | zero =>
      change (push M cmd).delta (head q) (e.tape e.pos) = none at fin
      simp [head_ins] at fin
    | succ t =>
      refine ⟨t,?_⟩
      rw [after_one] at fin
      simp only [instruction,liftConfig,old_ins,Option.map_eq_none_iff] at fin
      exact fin
  · rintro ⟨t,fin⟩
    refine ⟨t+1,?_⟩
    rw [after_one]
    simpa only [instruction,liftConfig,old_ins,Option.map_eq_none_iff] using fin
def install (M : Ordinary g q) : List (Cmd g) → (s : Nat) × Ordinary g s
  | [] => ⟨q,M⟩
  | c::cs => let N := install M cs; ⟨N.1+1,push N.2 c⟩
theorem installed_marker (M : Ordinary g q) (cs) : (install M cs).2.marker = M.marker := by
  induction cs with
  | nil => rfl
  | cons c cs ih => exact ih
theorem installed_blank (M : Ordinary g q) (cs) : (install M cs).2.blank = M.blank := by
  induction cs with
  | nil => rfl
  | cons c cs ih => exact ih
def perform (mark : Fin g) (cs : List (Cmd g)) (e : Env g) := cs.foldl (fun z c => effect mark c z) e
theorem install_iff (M : Ordinary g q) (cs) (e : Env g) :
    HALT (install M cs).2 (e.start (install M cs).2) ↔ HALT M ((perform M.marker cs e).start M) := by
  induction cs generalizing e with
  | nil => rfl
  | cons c cs ih =>
    exact (push_iff (install M cs).2 c e).trans (by rw [installed_marker]; exact ih _)
end P455EffectivePrefix
end
section
namespace P455EffectiveChain
open P455EffectiveMachine P455MachineLocal P455MachineCleanup P455MachineTable
def left (r) (s : Fin q) : Fin (q+r) := ⟨s.val,by have := s.isLt; omega⟩
def right (q) (s : Fin r) : Fin (q+r) := ⟨q+s.val,by have := s.isLt; omega⟩
def insMap (f : Fin q → Fin r) (i : Ins (Fin g) (Fin q)) : Ins (Fin g) (Fin r) := ⟨f i.state,i.symbol,i.dir⟩
def rename (f : Fin q → Fin r) (c : Config g q) : Config g r := ⟨c.tape,c.pos,f c.state⟩
def seqDelta (W : Ordinary g q) (D : Ordinary g r) (s : Fin (q+r)) (a : Fin g) :
    Option (Ins (Fin g) (Fin (q+r))) :=
  if h : s.val < q then
    match W.delta ⟨s.val,h⟩ a with
    | some i => some (insMap (left r) i)
    | none => some ⟨right q D.start,a,.stay⟩
  else (D.delta ⟨s.val-q,by have := s.isLt; omega⟩ a).map (insMap (right q))
theorem left_delta (W : Ordinary g q) (D : Ordinary g r) (s a) :
    seqDelta W D (left r s) a = match W.delta s a with
    | some i => some (insMap (left r) i)
    | none => some ⟨right q D.start,a,.stay⟩ := by simp [seqDelta,left,s.isLt]
theorem right_delta (W : Ordinary g q) (D : Ordinary g r) (s a) :
    seqDelta W D (right q s) a = (D.delta s a).map (insMap (right q)) := by
  have h : ¬ q+s.val < q := by omega
  simp [seqDelta,right,h,Nat.add_sub_cancel_left]
def chain (W : Ordinary g q) (D : Ordinary g r) (mark : W.marker = D.marker) : Ordinary g (q+r) where
  marker := W.marker
  blank := W.blank
  blank_ne := W.blank_ne
  start := left r W.start
  delta := seqDelta W D
  keeps := by
    intro s a i eq
    by_cases h : s.val < q
    · let j : Fin q := ⟨s.val,h⟩
      have e : s = left r j := rfl
      rw [e,left_delta] at eq
      cases d : W.delta j a with
      | none => rw [d] at eq; obtain rfl := Option.some.inj eq; rfl
      | some z => rw [d] at eq; obtain rfl := Option.some.inj eq; exact W.keeps _ _ _ d
    · let j : Fin r := ⟨s.val-q,by have := s.isLt; omega⟩
      have e : s = right q j := Fin.ext (by dsimp [j,right]; omega)
      rw [e,right_delta] at eq
      cases d : D.delta j a with
      | none => simp [d] at eq
      | some z =>
        rw [d] at eq; obtain rfl := Option.some.inj eq
        exact mark ▸ D.keeps _ _ _ d
  leftSafe := by
    intro s i eq
    by_cases h : s.val < q
    · let j : Fin q := ⟨s.val,h⟩
      have e : s = left r j := rfl
      rw [e,left_delta] at eq
      cases d : W.delta j W.marker with
      | none => rw [d] at eq; obtain rfl := Option.some.inj eq; exact Direction.noConfusion
      | some z => rw [d] at eq; obtain rfl := Option.some.inj eq; exact W.leftSafe _ _ d
    · let j : Fin r := ⟨s.val-q,by have := s.isLt; omega⟩
      have e : s = right q j := Fin.ext (by dsimp [j,right]; omega)
      rw [e,right_delta,mark] at eq
      cases d : D.delta j D.marker with
      | none => simp [d] at eq
      | some z => rw [d] at eq; obtain rfl := Option.some.inj eq; exact D.leftSafe _ _ d
def liftAlphabet (W : Ordinary g q) (D : Ordinary g r) (mark) (A : Alphabet W) : Alphabet (chain W D mark) :=
  ⟨A.bit,A.away,A.ink,A.distinct⟩
def out (q) (ans : Fin r → Bool) (s : Fin (q+r)) : Bool :=
  if h : s.val < q then false else ans ⟨s.val-q,by have := s.isLt; omega⟩
theorem out_right (q) (ans : Fin r → Bool) (s) : out q ans (right q s) = ans s := by
  have h : ¬ q+s.val < q := by omega
  simp [out,right,h,Nat.add_sub_cancel_left]
theorem left_step (W : Ordinary g q) (D : Ordinary g r) (mark) (c : Config g q)
    (live : instruction W c≠none) :
    once (chain W D mark) (rename (left r) c) = rename (left r) (once W c) := by
  cases c with
  | mk tape pos s =>
    cases e : W.delta s (tape pos) with
    | none => exact False.elim (live e)
    | some i => simp [once,instruction,chain,rename,left_delta,e,insMap]
theorem shift_control (W : Ordinary g q) (D : Ordinary g r) (mark) (c : Config g q)
    (halt : instruction W c = none) :
    once (chain W D mark) (rename (left r) c) = rename (right q) ⟨c.tape,c.pos,D.start⟩ := by
  change W.delta c.state (c.tape c.pos) = none at halt
  simp [once,instruction,chain,rename,left_delta,halt,write_same,dest]
theorem right_step (W : Ordinary g q) (D : Ordinary g r) (mark) (c : Config g r) :
    once (chain W D mark) (rename (right q) c) = rename (right q) (once D c) := by
  cases c with
  | mk tape pos s => cases e : D.delta s (tape pos) <;> simp [once,instruction,chain,rename,right_delta,e,insMap]
theorem follows_left (W : Ordinary g q) (D : Ordinary g r) (mark) (c : Config g q) (t)
    (before : ∀ j, j < t → instruction W (follow W c j)≠none) :
    follow (chain W D mark) (rename (left r) c) t = rename (left r) (follow W c t) := by
  induction t with
  | zero => rfl
  | succ t ih =>
    rw [follow,ih (fun j h => before j (by omega)),left_step _ _ _ _ (before t (by omega)),follow]
theorem follows_right (W : Ordinary g q) (D : Ordinary g r) (mark) (c : Config g r) (t) :
    follow (chain W D mark) (rename (right q) c) t = rename (right q) (follow D c t) := by
  induction t with
  | zero => rfl
  | succ t ih => simp only [follow,ih,right_step]
theorem follow_add (M : Ordinary g q) (c : Config g q) (t k) :
    follow M c (t+k) = follow M (follow M c t) k := by
  induction k with
  | zero => rfl
  | succ k ih => exact congrArg (once M) ih
theorem earliest (P : Nat → Prop) (t : Nat) (hit : P t) : ∃ j, P j ∧ ∀ i, i < j → ¬P i := by
  induction t using Nat.strongRecOn with
  | ind t ih =>
    by_cases h : ∃ j, j < t ∧ P j
    · obtain ⟨j,lt,yes⟩ := h; exact ih j lt yes
    · exact ⟨t,hit,fun i lt yes => h ⟨i,lt,yes⟩⟩
def Delivers (W : Ordinary g q) (A : Alphabet W) (x : List Bool) (D : Ordinary g r)
    (B : Alphabet D) (y : List Bool) : Prop :=
  ∃ t, let c := follow W (inputConfig W A x) t
       instruction W c = none ∧ c.pos = 0 ∧ c.tape = inputTape D B y
def Answers (D : Ordinary g q) (B : Alphabet D) (ans : Fin q → Bool) (y : List Bool) (v : Bool) : Prop :=
  ∃ t, let c := follow D (inputConfig D B y) t
       instruction D c = none ∧ ans c.state = v
theorem answers_chain (W : Ordinary g q) (D : Ordinary g r) (mark : W.marker = D.marker)
    (A : Alphabet W) (B : Alphabet D) (ans : Fin r → Bool) {x y v}
    (produces : Delivers W A x D B y) (reads : Answers D B ans y v) :
    Answers (chain W D mark) (liftAlphabet W D mark A) (out q ans) x v := by
  obtain ⟨t,atT,pos,tape⟩ := produces
  obtain ⟨k,stopped,verdict⟩ := reads
  let c := inputConfig W A x
  let C := chain W D mark
  obtain ⟨j,atJ,before⟩ := earliest (fun i => instruction W (follow W c i) = none) t atT
  have eq : follow W c j = follow W c t := unique_halt W c atJ atT
  have env : (⟨(follow W c j).tape,(follow W c j).pos,D.start⟩ : Config g r) = inputConfig D B y := by
    rw [eq]; change (⟨(follow W (inputConfig W A x) t).tape,(follow W (inputConfig W A x) t).pos,D.start⟩ : Config g r) = _
    rw [pos,tape]; rfl
  let ini := inputConfig C (liftAlphabet W D mark A) x
  have ini_eq : ini = rename (left r) c := rfl
  have start : follow C ini (j+1) = rename (right q) (inputConfig D B y) := by
    rw [ini_eq,follow,follows_left _ _ _ _ _ before,shift_control _ _ _ _ atJ,env]
  have final : follow C ini (j+1+k) = rename (right q) (follow D (inputConfig D B y) k) := by
    rw [follow_add,start,follows_right]
  refine ⟨j+1+k,?_⟩
  change instruction C (follow C ini (j+1+k)) = none ∧ out q ans (follow C ini (j+1+k)).state = v
  rw [final]
  constructor
  · simpa only [instruction,C,chain,rename,right_delta,Option.map_eq_none_iff] using stopped
  · exact (out_right ..).trans verdict
end P455EffectiveChain
end
section
namespace P455MarkedPath
open P455Witness P455Paths P455ContactLift P455SourceFamilies P455SourceTheorem
open P455CrossedSupport P455OriginalWalk P455Compression
noncomputable def ruleWord (r : Nat) (allow : Tag → Prop) (mark : Marking) (u : W) (x y : Nat) :=
  small u (retained r allow mark u x y)
theorem crossed_gadget {r allow mark T} (capT : P455Quotient.Cap r T)
    (u : W) (capU : P455Closure.Cap r u) (x y : Nat) (flip : ClosedFlip r allow u x y)
    (uniform : UniformSlots r allow mark u x y)
    (h : Nat → W) (val : Nat → P455Quotient.Q (rules r allow mark) T)
    (reps : ∀ a ∈ ruleWord r allow mark u x y, P455Quotient.ofWord (rules r allow mark) T (h a) = val a)
    (live : P455Quotient.eval (rules r allow mark) capT val (ruleWord r allow mark u x y) ≠
            P455Quotient.zero (rules r allow mark) T)
    (ts : Tiles) (c : Certificate) (valid : Holds r allow mark T (c.query r ts))
    (second mate : Bool) (cross : Crosses (markedRecord c second) h x y) :
    let names := retained r allow mark u x y
    let v := ruleWord r allow mark u x y
    let d := donor v h r
    let a := startLabel c second mate
    ∃ seed z l k, (seed = x ∨ seed = y) ∧ Supplies v h r seed a ∧
      P455Quotient.Variant (rules r allow mark) T z ∧ z = l ++ v.flatMap h ++ k ∧
      Holds r allow mark z (c.query r ts) ∧ SourceEvidence r allow ts v h seed c ∧
      (Compressed r u → Holds r allow (sourceMarks d c) u ((transferred d c).query r ts)) ∧
      ∀ p : List Step, p.length ≤ 6 → Walk r allow mark z a p →
        Walk r allow mark u seed (relabel d p) ∧ endpoint seed (relabel d p) = d (endpoint a p) ∧
        (relabel d p).length = p.length ∧ d (endpoint a p) ∈ names ∧
        Supplies v h r (d (endpoint a p)) (endpoint a p) ∧ Supplies u h r (d (endpoint a p)) (endpoint a p) := by
  let names := retained r allow mark u x y
  let v := ruleWord r allow mark u x y
  let e := expand u names
  have exp : P455Retained.Expansion v e (fun a => a ∈ names) := canonical u names
  have orig : v.flatMap e = u := recover u names
  obtain ⟨hr,cx,cy,_⟩ := flip_counts capU flip
  have pos : 0 < r := by omega
  have hx : x ∈ u := List.count_pos_iff.mp (cx.symm ▸ pos)
  have hy : y ∈ u := List.count_pos_iff.mp (cy.symm ▸ pos)
  obtain ⟨seed,side,img⟩ := choose_seed c second mate cross
  have guard := actual_guard pos capU hx hy side uniform
  have ks := (guard seed (near_self _ _)).1
  have count : u.count seed = r := side.elim (fun eq => eq.symm ▸ cx) (fun eq => eq.symm ▸ cy)
  have start : Supplies v h r seed (startLabel c second mate) := ⟨(counts_retained u names seed ks).trans count,img⟩
  have cap : P455Closure.Cap r (v.flatMap e) := orig.symm ▸ capU
  have guard' : OriginalGuard r allow mark (v.flatMap e) (fun a => a ∈ names) seed 6 := orig.symm ▸ guard
  obtain ⟨z,l,k,path,eq,vw,ev,cmp,walks⟩ :=
    arbitrary_reps_original_gadget capT val v h reps live ts c valid second mate seed hr start exp cap guard'
  rw [orig] at cmp walks
  exact ⟨seed,z,l,k,side,start,path,eq,vw,ev,cmp,walks⟩
end P455MarkedPath
end
section
namespace P455SupportBound
open P455Witness P455Paths P455ContactGeometry P455CrossedSupport Problem455.Slots
open P455FirstRewrite (names mem_names names_distinct size_le)
noncomputable def occupants (u : W) (t i : Nat) : W := by
  classical
  exact (names u).filter (fun a => decide (occupies u t i a))
theorem mem_occupants {u : W} {t i a : Nat} : a ∈ occupants u t i ↔ occupies u t i a := by
  classical
  simp only [occupants,List.mem_filter,mem_names,decide_eq_true_eq,and_iff_right_iff_imp]
  rintro ⟨j,seen⟩
  exact stamped_mem_label _ _ (a,j) (seen.subset (by simp))
def Capacity (r : Nat) (allow : Tag → Prop) (mark : Marking) (u : W) (x y K : Nat) :=
  ∀ t, InBall r allow mark u x y t → ∀ i, slotStart i → (occupants u t i).length ≤ K
private def starts : W := [0,1,3,5,7,9,11]
private theorem in_starts (i : Nat) : i ∈ starts ↔ slotStart i := by simp [starts,slotStart]
private theorem flat_bound (u : W) (F : Nat → W) (K : Nat) (b : ∀ t ∈ u, (F t).length ≤ K) :
    (u.flatMap F).length ≤ u.length*K := by
  induction u with
  | nil => simp
  | cons a u ih =>
    have v := ih (fun t ht => b t (List.mem_cons_of_mem _ ht))
    have h := b a List.mem_cons_self
    simp only [List.flatMap_cons,List.length_append,List.length_cons,Nat.succ_mul]
    omega
noncomputable def next (r : Nat) (allow : Tag → Prop) (mark : Marking) (u : W) (x y t : Nat) : W := by
  classical
  exact if InBall r allow mark u x y t then starts.flatMap (occupants u t) else []
private theorem next_bound {r allow mark u x y K} (cap : Capacity r allow mark u x y K)
    (t : Nat) : (next r allow mark u x y t).length ≤ 7*K := by
  classical
  by_cases ball : InBall r allow mark u x y t
  · rw [next,if_pos ball]
    exact flat_bound starts (occupants u t) K (fun i hi => cap t ball i ((in_starts i).mp hi))
  · simp [next,ball]
private theorem next_slot {r allow mark u x y t i a} (ball : InBall r allow mark u x y t)
    (slot : slotStart i) (o : occupies u t i a) : a ∈ next r allow mark u x y t := by
  classical
  rw [next,if_pos ball]
  exact List.mem_flatMap.mpr ⟨i,(in_starts i).mpr slot,mem_occupants.mpr o⟩
def geometric (D : Nat) : Nat → Nat | 0 => 1 | j+1 => 1+D*geometric D j
private def explore (F : Nat → W) : Nat → Nat → W
  | 0, t => [t]
  | j+1, t => t :: (F t).flatMap (explore F j)
private theorem seed_mem (F : Nat → W) (j t : Nat) : t ∈ explore F j t := by
  cases j <;> exact List.mem_cons_self
private theorem explore_bound (F : Nat → W) (D : Nat) (bound : ∀ t, (F t).length ≤ D) (j t : Nat) :
    (explore F j t).length ≤ geometric D j := by
  induction j generalizing t with
  | zero => simp [geometric,explore]
  | succ j ih =>
    have s := flat_bound (F t) (explore F j) (geometric D j) (fun a _ => ih a)
    have b := Nat.mul_le_mul_right (geometric D j) (bound t)
    simp only [geometric,explore,List.length_cons]; omega
private theorem walked {r allow mark u x y} (source t : Nat) (seed : source = x ∨ source = y)
    (n j : Nat) (budget : n+j ≤ 6) (pre : Near r allow mark u source t n)
    (p : List Step) (walk : Walk r allow mark u t p) (len : p.length ≤ j) :
    endpoint t p ∈ explore (next r allow mark u x y) j t := by
  induction p generalizing t n j with
  | nil => exact seed_mem _ _ _
  | cons e p ih =>
    obtain ⟨a,c⟩ := e
    cases j with
    | zero => simp at len
    | succ j =>
      have ball : InBall r allow mark u x y t :=
        seed.elim (fun eq => .inl (eq ▸ near_mono pre (by omega))) (fun eq => .inr (eq ▸ near_mono pre (by omega)))
      obtain ⟨i,slot,occ⟩ := contact_slot walk.1
      have into := next_slot ball slot occ
      have more := near_trans pre (near_one c walk.1)
      have cont := ih a (n+1) j (by omega) more walk.2 (by simp_all)
      exact List.mem_cons_of_mem _ (List.mem_flatMap.mpr ⟨a,into,cont⟩)
theorem retained_bound {r allow mark u x y K} (cap : Capacity r allow mark u x y K) :
    (names (retained r allow mark u x y)).length ≤
      2*(1+7*K)*geometric (7*K) 6 := by
  let F := next r allow mark u x y
  let D := 7*K
  let ball := explore F 6 x ++ explore F 6 y
  let covered := ball ++ ball.flatMap F
  have all (b) (hb : InBall r allow mark u x y b) : b ∈ ball := by
    have mem (s) (origin : s = x ∨ s = y) (near : Near r allow mark u s b 6) : b ∈ explore F 6 s := by
      obtain ⟨p,wp,eq,len⟩ := near
      exact eq ▸ walked s s origin 0 6 (by decide) (near_self s 0) p wp len
    exact List.mem_append.mpr (hb.imp (mem x (.inl rfl)) (mem y (.inr rfl)))
  have included (a) (ha : a ∈ names (retained r allow mark u x y)) : a ∈ covered := by
    obtain ⟨_,needs⟩ := mem_retained.mp ((mem_names _ _).mp ha)
    unfold covered
    apply List.mem_append.mpr
    rcases needs with b | ⟨t,i,reach,slot,occ⟩
    · exact .inl (all a b)
    · exact .inr (List.mem_flatMap.mpr ⟨t,all t reach,next_slot reach slot occ⟩)
  have fb (a) : (F a).length ≤ D := next_bound cap a
  have count := size_le (names_distinct _) included
  have size : ball.length ≤ 2*geometric D 6 := by
    have bx := explore_bound F D fb 6 x
    have by' := explore_bound F D fb 6 y
    dsimp only [ball]; rw [List.length_append]; omega
  have more := flat_bound ball F D (fun t _ => fb t)
  have gross : covered.length ≤ ball.length*(1+D) := by
    dsimp only [covered]; rw [List.length_append,Nat.mul_add,Nat.mul_one]; omega
  have lim := Nat.mul_le_mul_right (1+D) size
  have fin := Nat.le_trans count (Nat.le_trans gross lim)
  simpa only [D,Nat.mul_assoc,Nat.mul_left_comm,Nat.mul_comm] using fin
theorem retained_bound_four {r allow mark u x y} (cap : Capacity r allow mark u x y 4) :
    (names (retained r allow mark u x y)).length ≤ 2*(1+28)*geometric 28 6 := retained_bound cap
theorem owner_absent (u : W) (t i : Nat) : ¬ occupies u t i t := by
  intro occ
  obtain ⟨j,hj⟩ := occ
  have mem : (t,i+1) ∈ events u := hj.mem (by simp)
  have b := (P455SlotOrigin.event_bounds (fun _ => 0) u t (i+1) mem).2
  obtain ⟨l,mid,k,cut,index,fresh⟩ := P455SlotOrigin.slot_cut u t i (by omega)
  have occ' : occupies u t i t := ⟨j,hj⟩
  rw [cut,←index] at occ'
  exact fresh ((P455SlotOrigin.occupies_at_cut l mid k t t fresh).mp occ')
theorem overflow_of_more {r allow mark u x y t i}
    (uniform : UniformSlots r allow mark u x y) (cmp : P455SourceFamilies.Compressed r u)
    (ball : InBall r allow mark u x y t) (slot : slotStart i)
    (p455Overflow : 4 < (occupants u t i).length) :
    ∃ xs, Holds r allow mark u (terminalSlot r t i (.overflow xs)) := by
  classical
  let xs := (occupants u t i).take 5
  have inside (a) (ha : a ∈ xs) : occupies u t i a :=
    mem_occupants.mp ((List.take_sublist _ _).subset ha)
  have nodup : xs.Nodup :=
    (names_distinct u).sublist (List.Sublist.trans (List.take_sublist _ _) List.filter_sublist)
  have uniq : (t::xs).Nodup := List.nodup_cons.mpr ⟨fun h => owner_absent u t i (inside t h),nodup⟩
  refine ⟨xs,List.length_take_of_le (by omega),
    (P455TerminalTransfer.block_separation _).mpr
      (uniq.imp (fun ne => P455SourceFamilies.compressed_separates cmp ne)),?_,True.intro⟩
  apply (allQ_iff _).mpr
  intro q mem
  obtain ⟨a,ha,rfl⟩ := List.mem_map.mp mem
  have occ := inside a ha
  exact ⟨uniform t ball i slot a occ,slot,occ⟩
theorem capacity_of_no_overflow {r allow mark u x y}
    (uniform : UniformSlots r allow mark u x y) (cmp : P455SourceFamilies.Compressed r u)
    (none : ∀ t, InBall r allow mark u x y t → ∀ i, slotStart i →
      ∀ xs, ¬ Holds r allow mark u (terminalSlot r t i (.overflow xs))) :
    Capacity r allow mark u x y 4 := by
  intro t ball i slot
  exact Nat.le_of_not_lt (fun h => by
    obtain ⟨xs,w⟩ := overflow_of_more uniform cmp ball slot h
    exact none t ball i slot xs w)
theorem bounded_step_of_capacity {A : Type} (M : P455FirstRewrite.Model A)
    {r allow mark} (f : P455Closure.Frame Nat) (l k : W) {x y : Nat}
    (hp : f.p = [x]) (hq : f.q = [y]) (valid : f.Valid r allow (fun _ _ => False))
    (b : Bool) (cap : P455Closure.Cap r (P455Uncrossed.side f l k b))
    (capacity : Capacity r allow mark (P455Uncrossed.side f l k b) x y 4)
    (semantic :
      let keep := retained r allow mark (P455Uncrossed.side f l k b) x y
      M.Valid (P455Compression.small (P455Uncrossed.side f l k b) keep)
        (P455Compression.small (P455Uncrossed.side f l k (!b)) keep)) :
    let N := 2*(1+28)*geometric 28 6
    P455FirstRewrite.Step (fun u v => M.Valid u v ∧ P455FirstRewrite.rank u v ≤ N+r*N+1)
      (P455Uncrossed.side f l k b) (P455Uncrossed.side f l k (!b)) := by
  let u := P455Uncrossed.side f l k b
  let keep := retained r allow mark u x y
  have flip : ClosedFlip r allow u x y := ⟨f,b,l,k,hp,hq,valid,rfl⟩
  obtain ⟨hr,cx,cy,_⟩ := flip_counts cap flip
  have hx : x ∈ keep := mem_retained.mpr
    ⟨List.count_pos_iff.mp (cx.symm ▸ (by omega : 0 < r)),.inl (.inl (near_self x 6))⟩
  have hy : y ∈ keep := mem_retained.mpr
    ⟨List.count_pos_iff.mp (cy.symm ▸ (by omega : 0 < r)),.inl (.inr (near_self y 6))⟩
  have step := P455SmallRank.bounded_step M f l k keep hx hy hp hq valid b cap semantic
  have small : (names keep).length ≤ 2*(1+28)*geometric 28 6 := retained_bound_four capacity
  have scaled := Nat.mul_le_mul_left r small
  obtain ⟨U,V,L,R,h,hyp,nu,nv,ne,src,dst⟩ := step
  refine ⟨U,V,L,R,h,?_,nu,nv,ne,src,dst⟩
  rcases hyp with ⟨val,rnk⟩|⟨val,rnk⟩
  · exact .inl ⟨val,by omega⟩
  · exact .inr ⟨val,by omega⟩
end P455SupportBound
end
section
namespace P455StructuralProduct
open P455Structural P455Witness P455Quotient P455Closure P455Uncrossed
open P455SourceFamilies P455FirstTesters P455FirstRewrite
def templates (r : Nat) := Problem455Finite.wordsUpTo (List.range 4) (4*r)
structure Index (r : Nat) (allow : Tag → Prop) where
  pos : Fin (templates r).length
  cap : P455Closure.Cap r ((templates r).get pos)
  cmp : Compressed r ((templates r).get pos)
  test : Structural ((templates r).get pos) r allow
def Index.T (i : Index r allow) := (templates r).get i.pos
abbrev Carrier (r : Nat) (allow : Tag → Prop) := (i : Index r allow) → Q (plain r) i.T
def product (r : Nat) (allow : Tag → Prop) : Model (Carrier r allow) where
  op := fun x y i => mul (plain r) i.cap (x i) (y i)
  unit := fun i => ofWord (plain r) i.T []
  assoc := fun x y z => funext (fun i => mul_assoc (plain r) i.cap (x i) (y i) (z i))
  oneL := fun x => funext (fun i => (unit_laws (plain r) i.cap (x i)).1)
  oneR := fun x => funext (fun i => (unit_laws (plain r) i.cap (x i)).2)
theorem coordinate (f : Nat → Carrier r allow) (w : List Nat) (i : Index r allow) :
    (product r allow).eval f w i = eval (plain r) i.cap (fun x => f x i) w := by
  induction w with
  | nil => rfl
  | cons x xs ih => exact congrArg (mul (plain r) i.cap (f x i)) ih
theorem identity {r allow} (f : Frame Nat) (l k : List Nat) (x y : Nat)
    (hp : f.p=[x]) (hq : f.q=[y]) (valid : f.Valid r allow (fun _ _ => False)) :
    (product r allow).Valid (side f l k false) (side f l k true) := by
  intro val
  funext i
  rw [coordinate,coordinate]
  exact structural_eval i.cap i.cmp i.test f l k x y hp hq valid _
end P455StructuralProduct
end
section
namespace P455PaddedMatchings
open P455PaddedPorts P455PaddedTiles
def idAt (w y x : Nat) := w*y + (if odd y then w-1-x else x)
private theorem offset_lt {w x : Nat} (y : Nat) (hx : x < w) :
    (if odd y then w-1-x else x) < w := by split <;> omega
theorem id_inj {w y x z q : Nat} (hx : x < w) (hq : q < w) (eq : idAt w y x = idAt w z q) :
    y = z ∧ x = q := by
  have wt : 0 < w := by omega
  have div := congrArg (· / w) eq
  simp only [idAt,Nat.mul_add_div wt,Nat.div_eq_of_lt (offset_lt y hx),
    Nat.div_eq_of_lt (offset_lt z hq),Nat.add_zero] at div
  subst z
  simp only [idAt,Nat.add_left_cancel_iff] at eq
  split at eq <;> omega
theorem id_bound {w h y x : Nat} (hy : y < h) (hx : x < w) : idAt w y x < w*h := by
  have le := Nat.mul_le_mul_left w (show y+1 ≤ h by omega)
  rw [Nat.mul_add,Nat.mul_one] at le
  have off := offset_lt y hx
  unfold idAt; omega
theorem id_covers {w h i : Nat} (lt : i < w*h) :
    ∃ y < h, ∃ x < w, idAt w y x = i := by
  have wpos : 0 < w := by
    cases w with
    | zero => simp at lt
    | succ => omega
  let y := i/w
  let j := i%w
  have jo : j < w := Nat.mod_lt _ wpos
  have ex := Nat.mod_add_div i w
  have yl : y < h := by
    by_cases e : y < h
    · exact e
    · have mul := Nat.mul_le_mul_left w (show h ≤ y by omega)
      change w*h ≤ w*(i/w) at mul
      omega
  refine ⟨y,yl,if odd y then w-1-j else j,offset_lt y jo,?_⟩
  unfold idAt
  by_cases e : odd y = true
  · simp [e]
    have z : w-1-(w-1-j) = j := by omega
    rw [z]
    dsimp [y,j]; omega
  · simp [e]
    dsimp [y,j]; omega
def pairs (f : Nat → Nat) (start : Nat) : Nat → List Block
  | 0 => []
  | 1 => [.single (f start)]
  | n+2 => .pair (f start) (f (start+1)) :: pairs f (start+2) n
def line (skip : Bool) (f : Nat → Nat) (size : Nat) :=
  if skip then match size with
    | 0 => []
    | k+1 => .single (f 0) :: pairs f 1 k
  else pairs f 0 size
private theorem pair_cells (f : Nat → Nat) (s n : Nat) :
    (pairs f s n).flatMap cells = (List.range' s n).map f := by
  induction n using Nat.strongRecOn generalizing s with
  | ind n ih =>
    cases n with
    | zero => rfl
    | succ n => cases n with
      | zero => rfl
      | succ n =>
        simp [pairs,cells,ih n (by omega) (s+2),List.range'_succ]
theorem line_cells (skip : Bool) (f : Nat → Nat) (n : Nat) :
    (line skip f n).flatMap cells = (List.range n).map f := by
  cases skip
  · simp [line,pair_cells,List.range_eq_range']
  · cases n with
    | zero => rfl
    | succ n => simp [line,cells,pair_cells,List.range_eq_range',List.range'_succ]
private theorem pair_edge (f : Nat → Nat) (s n a b : Nat) :
    Block.pair a b ∈ pairs f s n ↔
      ∃ k, k+1 < n ∧ k%2 = 0 ∧ a = f (s+k) ∧ b = f (s+k+1) := by
  induction n using Nat.strongRecOn generalizing s with
  | ind n ih =>
    cases n with
    | zero => simp [pairs]
    | succ n => cases n with
      | zero => simp [pairs]
      | succ n =>
        simp only [pairs,List.mem_cons,Block.pair.injEq]
        rw [ih n (by omega)]
        constructor
        · rintro (⟨ea,eb⟩|⟨k,lt,par,ea,eb⟩)
          · exact ⟨0,by omega,rfl,by simpa using ea,by simpa using eb⟩
          · exact ⟨k+2,by omega,by omega,by simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using ea,
              by simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using eb⟩
        · rintro ⟨k,lt,par,ea,eb⟩
          by_cases e : k = 0
          · subst k; exact .inl ⟨by simpa using ea,by simpa using eb⟩
          · have kk : s+2+(k-2) = s+k := by omega
            exact .inr ⟨k-2,by omega,by omega,by simpa only [kk] using ea,by simpa only [kk] using eb⟩
theorem line_edge (skip : Bool) (f : Nat → Nat) (size a b : Nat) :
    Block.pair a b ∈ line skip f size ↔
      ∃ k, k+1 < size ∧ odd k = skip ∧ a = f k ∧ b = f (k+1) := by
  cases skip
  · simp only [line,Bool.false_eq_true,if_false,pair_edge,Nat.zero_add]
    constructor
    · rintro ⟨k,lt,p,u,v⟩; exact ⟨k,lt,by simp [odd,p],u,v⟩
    · rintro ⟨k,lt,p,u,v⟩; exact ⟨k,lt,by simp [odd] at p; omega,u,v⟩
  · cases size with
    | zero => simp [line]
    | succ n =>
      simp only [line,if_true,List.mem_cons,Block.noConfusion,reduceCtorEq,false_or,pair_edge]
      constructor
      · rintro ⟨k,lt,p,u,v⟩
        refine ⟨k+1,by omega,?_,?_,?_⟩
        · simp [odd,show (k+1)%2 = 1 by omega]
        · simpa [Nat.add_comm] using u
        · simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using v
      · rintro ⟨k,lt,p,u,v⟩; simp [odd] at p
        exact ⟨k-1,by omega,by omega,by simpa [show 1+(k-1) = k by omega] using u,
          by simpa [show 1+(k-1) = k by omega] using v⟩
def lines (m n : Nat) (skip : Bool) (f : Nat → Nat → Nat) :=
  (List.range m).flatMap fun z=>line skip (f z) n
private theorem flatten_lines (m n : Nat) (skip : Bool) (f : Nat → Nat → Nat) :
    (lines m n skip f).flatMap cells = (List.range m).flatMap (fun z=>(List.range n).map (f z)) := by
  simp [lines,List.flatMap_assoc,line_cells]
theorem lines_unique (m n : Nat) (skip : Bool) (f : Nat → Nat → Nat)
    (inj : ∀ z < m, ∀ x < n, ∀ t < m, ∀ j < n, f z x = f t j → z = t ∧ x = j) :
    ((lines m n skip f).flatMap cells).Nodup := by
  rw [flatten_lines]
  apply List.pairwise_flatMap.mpr
  constructor
  · intro z hz
    apply List.pairwise_map.mpr
    exact List.nodup_range.imp_of_mem (fun hx hj ne eq => ne
      (inj z (List.mem_range.mp hz) _ (List.mem_range.mp hx) z (List.mem_range.mp hz) _ (List.mem_range.mp hj) eq).2)
  · apply List.nodup_range.imp_of_mem
    intro z t hz ht ne a ha b hb eq
    obtain ⟨x,hx,rfl⟩ := List.mem_map.mp ha
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hb
    exact ne (inj z (List.mem_range.mp hz) x (List.mem_range.mp hx) t (List.mem_range.mp ht) j (List.mem_range.mp hj) eq).1
def horizontal (h w : Nat) (skip : Bool) := lines h w skip (idAt w)
def vertical (h w : Nat) (skip : Bool) := lines w h skip (fun x y=>idAt w y x)
theorem horizontal_unique (h w : Nat) (skip : Bool) :
    ((horizontal h w skip).flatMap cells).Nodup :=
  lines_unique _ _ _ _ (fun _ _ _ hx _ _ _ hj eq=>id_inj hx hj eq)
theorem vertical_unique (h w : Nat) (skip : Bool) :
    ((vertical h w skip).flatMap cells).Nodup :=
  lines_unique _ _ _ _ (fun _ hx _ _ _ hj _ _ eq=>And.symm (id_inj hx hj eq))
theorem horizontal_cells (h w i : Nat) (skip : Bool) :
    i∈(horizontal h w skip).flatMap cells ↔ i < w*h := by
  rw [horizontal,flatten_lines]
  constructor
  · intro m; obtain ⟨y,hy,mx⟩ := List.mem_flatMap.mp m
    obtain ⟨x,hx,rfl⟩ := List.mem_map.mp mx
    exact id_bound (List.mem_range.mp hy) (List.mem_range.mp hx)
  · intro lt; obtain ⟨y,hy,x,hx,eq⟩ := id_covers lt
    exact List.mem_flatMap.mpr ⟨y,List.mem_range.mpr hy,List.mem_map.mpr ⟨x,List.mem_range.mpr hx,eq⟩⟩
theorem vertical_cells (h w i : Nat) (skip : Bool) :
    i∈(vertical h w skip).flatMap cells ↔ i < w*h := by
  rw [vertical,flatten_lines]
  constructor
  · intro m; obtain ⟨x,hx,my⟩ := List.mem_flatMap.mp m
    obtain ⟨y,hy,rfl⟩ := List.mem_map.mp my
    exact id_bound (List.mem_range.mp hy) (List.mem_range.mp hx)
  · intro lt; obtain ⟨y,hy,x,hx,eq⟩ := id_covers lt
    exact List.mem_flatMap.mpr ⟨x,List.mem_range.mpr hx,List.mem_map.mpr ⟨y,List.mem_range.mpr hy,eq⟩⟩
theorem horizontal_edge (h w a b : Nat) (skip : Bool) :
    Block.pair a b∈horizontal h w skip ↔
      ∃ y < h, ∃ x, x+1 < w ∧ odd x = skip ∧ a = idAt w y x ∧ b = idAt w y (x+1) := by
  simp [horizontal,lines,List.mem_flatMap,line_edge]
theorem vertical_edge (h w a b : Nat) (skip : Bool) :
    Block.pair a b∈vertical h w skip ↔
      ∃ x < w, ∃ y, y+1 < h ∧ odd y = skip ∧ a = idAt w y x ∧ b = idAt w (y+1) x := by
  simp [vertical,lines,List.mem_flatMap,line_edge]
def wrap (t : Nat) : List Block :=
  .pair (t-1) 0 :: ((List.range t).filter fun i=>0 < i && i < t-1).map Block.single
theorem wrap_edge (t a b : Nat) : Block.pair a b ∈ wrap t ↔ a = t-1 ∧ b = 0 := by
  simp [wrap,List.mem_map]
private theorem flatten_singles (xs : List Nat) : (xs.map Block.single).flatMap cells = xs := by
  induction xs with
  | nil => rfl
  | cons a xs ih => simp [cells,ih]
theorem wrap_unique {t : Nat} (ht : 1 < t) : ((wrap t).flatMap cells).Nodup := by
  simp only [wrap,List.flatMap_cons,cells,flatten_singles,List.cons_append,List.nil_append]
  simp [List.nodup_cons,show t-1≠0 by omega]
  exact List.Pairwise.filter _ List.nodup_range
theorem wrap_cells {t : Nat} (ht : 1 < t) (i : Nat) : i∈(wrap t).flatMap cells ↔ i < t := by
  simp only [wrap,List.flatMap_cons,cells,flatten_singles,List.cons_append,List.nil_append,List.mem_cons,List.mem_filter,
    List.mem_range,Bool.and_eq_true,decide_eq_true_eq]
  omega
end P455PaddedMatchings
end
