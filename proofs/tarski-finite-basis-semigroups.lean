namespace P455EffectiveQ
open P455Quotient Problem455Finite
abbrev W := List Nat
def words (u : W) := wordsUpTo u u.length
theorem subword {u v : W} (s : u.Sublist v) : u ∈ words v := covered v v.length u s.length_le s.subset
def factorB (u v : W) := (words v).any (fun l => (words v).any (fun t => decide (v = l++u++t)))
theorem factor_iff (u v : W) : factorB u v = true ↔ Factor u v := by
  simp only [factorB,List.any_eq_true,decide_eq_true_eq]
  constructor
  · rintro ⟨l,_,t,_,h⟩; exact ⟨l,t,h⟩
  · rintro ⟨l,t,rfl⟩
    exact ⟨l,subword ((List.sublist_append_left l u).trans (List.sublist_append_left _ t)),
      t,subword (List.sublist_append_right _ _),rfl⟩
def walkB (e : W → W → Bool) (u v : W) := P455EffectiveQReach.via e (words u) u v
theorem walk_iff (R : Rules Nat) (e : W → W → Bool) (ok : ∀ u v,e u v = true ↔ R.step u v)
    (u v : W) : walkB e u v = true ↔ Walk R.step u v := by
  constructor
  · exact P455EffectiveQReach.sound _ (fun x y => (ok x y).mp) _
  · intro path
    apply P455EffectiveQReach.complete _ (fun x y => (ok x y).mpr) _ _ path
    intro x reach
    have perm := List.perm_iff_count.mpr (count_walk R reach)
    exact covered _ _ _ (Nat.le_of_eq perm.length_eq.symm) (fun _ m => perm.mem_iff.mpr m)
def goodB (e : W → W → Bool) (T u : W) :=
  (words T).any fun v => walkB e T v && factorB u v
theorem good_iff (R : Rules Nat) (e : W → W → Bool) (ok : ∀ u v,e u v = true ↔ R.step u v)
    (T u : W) : goodB e T u = true ↔ Good R T u := by
  simp only [goodB,List.any_eq_true,Bool.and_eq_true,walk_iff R e ok,factor_iff]
  constructor
  · rintro ⟨v,_,p,f⟩; exact ⟨v,p,f⟩
  · rintro ⟨v,p,f⟩
    have pe := List.perm_iff_count.mpr (count_walk R p)
    exact ⟨v,covered _ _ _ (Nat.le_of_eq pe.length_eq.symm) (fun _ m => pe.mem_iff.mpr m),p,f⟩
def liveB (e : W → W → Bool) (T : W) : Raw Nat → Bool
  | none => false
  | some u => goodB e T u
def paired (e : W → W → Bool) (T : W) : Raw Nat → Raw Nat → Bool
  | some u,some v => goodB e T u && goodB e T v && walkB e u v
  | _,_ => false
def relB (e : W → W → Bool) (T : W) (a b : Raw Nat) :=
  ((!liveB e T a) && (!liveB e T b)) || paired e T a b
theorem rel_iff (R : Rules Nat) (e : W → W → Bool) (ok : ∀ u v,e u v = true ↔ R.step u v)
    (T : W) (a b : Raw Nat) : relB e T a b = true ↔ Rel R T a b := by
  have live (x : Raw Nat) : liveB e T x = true ↔ Live R T x := by
    cases x with
    | none => simp [liveB,Live]
    | some u => exact good_iff R e ok T u
  have no (x : Raw Nat) : (!liveB e T x) = true ↔ ¬Live R T x := by
    rw [←live]; cases liveB e T x <;> decide
  simp only [relB,Bool.or_eq_true,Bool.and_eq_true,no,P455Quotient.Rel]
  apply or_congr_right
  cases a <;> cases b <;> simp [paired,good_iff R e ok,walk_iff R e ok,and_assoc,Option.some.injEq]
def eqB (R : Rules Nat) (e : W → W → Bool) (ok : ∀ u v,e u v = true ↔ R.step u v)
    (T : W) (x y : Q R T) : Bool :=
  Quotient.liftOn₂ x y (relB e T) (by
    intro a b c d ac bd
    apply Bool.eq_iff_iff.mpr
    rw [rel_iff R e ok,rel_iff R e ok]
    exact ⟨fun ab => rel_trans R (rel_symm R ac) (rel_trans R ab bd),
           fun cd => rel_trans R ac (rel_trans R cd (rel_symm R bd))⟩)
theorem eq_iff (R : Rules Nat) (e : W → W → Bool) (ok : ∀ u v,e u v = true ↔ R.step u v)
    (T : W) (x y : Q R T) : eqB R e ok T x y = true ↔ x = y := by
  induction x,y using Quotient.inductionOn₂ with | _ a b =>
    exact (rel_iff R e ok T a b).trans ⟨fun h => Quotient.sound (s := setoid R T) h,fun h => Quotient.exact h⟩
def decEq (R : Rules Nat) (e : W → W → Bool) (ok : ∀ u v,e u v = true ↔ R.step u v)
    (T : W) : DecidableEq (Q R T) :=
  fun x y => decidable_of_bool _ (eq_iff R e ok T x y)
end P455EffectiveQ
end
section
namespace P455PaddedTiles
open P455Witness
structure Tile (n : Nat) where
  left : Bool
  right : Bool
  top : Bool
  bottom : Bool
  oddRow : Bool
  oddColumn : Bool
  l : Option (Fin n)
  c : Fin n
  r : Option (Fin n)
  b : Fin n
  deriving DecidableEq
def digit (n k : Nat) : Tag := List.replicate k true ++ List.replicate (n-k) false
def letter : Option (Fin n) → Nat
  | none => 0
  | some a => a.val+1
def token {n : Nat} (s : Option (Fin n)) := digit (n+1) (letter s)
def code (p : Tile n) : Tag :=
  p.left :: p.right :: p.top :: p.bottom :: p.oddRow :: p.oddColumn ::
    (token p.l ++ (token (some p.c) ++ (token p.r ++ token (some p.b))))
def widthCode (n : Nat) := 6+4*(n+1)
private theorem token_length (s : Option (Fin n)) : (token s).length = n+1 := by
  have lim : letter s ≤ n+1 := by cases s with
    | none => simp [letter]
    | some a => simp only [letter]; have := a.isLt; omega
  simp [token,digit]; omega
theorem code_length (p : Tile n) : (code p).length = widthCode n := by
  simp [code,widthCode,token_length]; omega
private theorem token_inj {a b : Option (Fin n)} (eq : token a = token b) : a = b := by
  have ct := congrArg (List.count true) eq
  have zero (k : Nat) : (List.replicate k false).count true = 0 := by
    apply List.count_eq_zero.mpr
    intro m
    have := List.eq_of_mem_replicate m
    contradiction
  simp [token,digit,zero] at ct
  cases a <;> cases b <;> simp_all [letter,Fin.ext_iff]
theorem code_inj {p q : Tile n} (eq : code p = code q) : p = q := by
  cases p with
  | mk l r t b row col ll cc rr bb =>
    cases q with
    | mk l' r' t' b' row' col' ll' cc' rr' bb' =>
      simp only [code,List.cons.injEq] at eq
      obtain ⟨rfl,rfl,rfl,rfl,rfl,rfl,eq⟩ := eq
      obtain ⟨e1,e⟩ := List.append_inj eq ((token_length _).trans (token_length _).symm)
      obtain ⟨e2,e⟩ := List.append_inj e ((token_length _).trans (token_length _).symm)
      obtain ⟨e3,e4⟩ := List.append_inj e ((token_length _).trans (token_length _).symm)
      have z1 := token_inj e1; have z2 := Option.some.inj (token_inj e2)
      have z3 := token_inj e3; have z4 := Option.some.inj (token_inj e4)
      subst_vars; rfl
structure MachineTable (n : Nat) where
  marker : Fin n → Bool
  initial : Bool → Fin n
  accept : Fin n
  distinct : initial true ≠ accept
  next : Option (Fin n) → Fin n → Option (Fin n) → Option (Fin n)
def Admitted (M : MachineTable n) (p : Tile n) :=
  M.next p.l p.c p.r = some p.b ∧
  p.left = p.l.isNone ∧ p.right = p.r.isNone ∧ M.marker p.c = p.left ∧
  (p.left = true → p.oddColumn = false) ∧
  (p.top = true → p.oddRow = false ∧ p.c = M.initial p.left) ∧
  (p.bottom = true → p.left = true → p.c = M.accept)
def allowed (M : MachineTable n) (tag : Tag) := ∃ p, code p = tag ∧ Admitted M p
def Horizontal (p q : Tile n) :=
  p.right = false ∧ q.left = false ∧ p.top = q.top ∧ p.bottom = q.bottom ∧
  p.oddRow = q.oddRow ∧ p.oddColumn≠q.oddColumn ∧ q.l = some p.c ∧ p.r = some q.c
def Vertical (p q : Tile n) :=
  p.bottom = false ∧ q.top = false ∧ p.left = q.left ∧ p.right = q.right ∧
  p.oddColumn = q.oddColumn ∧ p.oddRow≠q.oddRow ∧ p.b = q.c
def system (n : Nat) : Tiles where
  horizontal := fun x y => ∃ p q : Tile n, code p = x ∧ code q = y ∧ Horizontal p q
  vertical := fun x y => ∃ p q : Tile n, code p = x ∧ code q = y ∧ Vertical p q
  left := fun t => t[0]?.getD false
  right := fun t => t[1]?.getD false
  top := fun t => t[2]?.getD false
  bottom := fun t => t[3]?.getD false
  oddRow := fun t => t[4]?.getD false
  oddColumn := fun t => t[5]?.getD false
def leftAt (row : Nat → Fin n) (x : Nat) := if x = 0 then none else some (row (x-1))
def rightAt (row : Nat → Fin n) (w x : Nat) := if x+1 = w then none else some (row (x+1))
def odd (i : Nat) : Bool := decide (i%2 = 1)
structure Run (M : MachineTable n) (w s : Nat) where
  positive : 0 < w
  rows : Nat → Nat → Fin n
  start : ∀ x, x < w → rows 0 x = M.initial (decide (x = 0))
  marks : ∀ y, y ≤ s → ∀ x, x < w → M.marker (rows y x) = decide (x = 0)
  steps : ∀ y, y < s → ∀ x, x < w →
    M.next (leftAt (rows y) x) (rows y x) (rightAt (rows y) w x) = some (rows (y+1) x)
  accept : rows s 0 = M.accept
  stutter : ∀ x, x < w →
    M.next (leftAt (rows s) x) (rows s x) (rightAt (rows s) w x) = some (rows s x)
variable {n w s : Nat} {M : MachineTable n}
theorem positive_time (R : Run M w s) : 0 < s := by
  cases s with
  | zero =>
    have z := (R.start 0 R.positive).symm.trans R.accept
    exact False.elim (M.distinct (by simpa using z))
  | succ => omega
def tileAt (R : Run M w s) (extra y x : Nat) : Tile n where
  left := decide (x = 0)
  right := decide (x+1 = w)
  top := decide (y = 0)
  bottom := decide (y = s+extra)
  oddRow := odd y
  oddColumn := odd x
  l := leftAt (R.rows (min y s)) x
  c := R.rows (min y s) x
  r := rightAt (R.rows (min y s)) w x
  b := R.rows (min (y+1) s) x
theorem admits_tile (R : Run M w s) (extra y x : Nat) (hx : x < w) :
    Admitted M (tileAt R extra y x) := by
  refine ⟨?_,?_,?_,R.marks _ (Nat.min_le_right ..) _ hx,?_,?_,?_⟩
  · by_cases h : y < s
    · simpa [tileAt,Nat.min_eq_left (by omega : y ≤ s),Nat.min_eq_left (by omega : y+1 ≤ s)] using R.steps y h x hx
    · simpa [tileAt,Nat.min_eq_right (by omega : s ≤ y),Nat.min_eq_right (by omega : s ≤ y+1)] using R.stutter x hx
  · by_cases e : x = 0 <;> simp [tileAt,leftAt,e]
  · by_cases e : x+1 = w <;> simp [tileAt,rightAt,e]
  · intro h; have e : x = 0 := of_decide_eq_true h; simp [tileAt,odd,e]
  · intro h; have e : y = 0 := of_decide_eq_true h; simpa [tileAt,odd,e] using R.start x hx
  · intro a b
    have ey : y = s+extra := of_decide_eq_true a
    have ex : x = 0 := of_decide_eq_true b
    simpa [tileAt,ex,ey,Nat.min_eq_right (by omega : s ≤ s+extra)] using R.accept
private theorem opposite (x : Nat) : odd x ≠ odd (x+1) := by
  unfold odd
  by_cases e : x%2 = 1
  · have f : (x+1)%2 ≠ 1 := by omega
    simp [e,f]
  · have f : (x+1)%2 = 1 := by omega
    simp [e,f]
theorem horizontal (R : Run M w s) (extra y x : Nat) (hx : x+1 < w) :
    Horizontal (tileAt R extra y x) (tileAt R extra y (x+1)) := by
  refine ⟨?_,?_,rfl,rfl,rfl,opposite _,?_,?_⟩
  · simp [tileAt,show x+1≠w by omega]
  · simp [tileAt]
  · simp [tileAt,leftAt]
  · simp [tileAt,rightAt,show x+1≠w by omega]
theorem vertical (R : Run M w s) (extra y x : Nat) (hy : y < s+extra) :
    Vertical (tileAt R extra y x) (tileAt R extra (y+1) x) := by
  refine ⟨?_,?_,rfl,rfl,rfl,opposite _,rfl⟩
  · simp [tileAt,show y≠s+extra by omega]
  · simp [tileAt]
structure Rectangle (M : MachineTable n) (width height : Nat) where
  positiveW : 0 < width
  positiveH : 0 < height
  tag : Nat → Nat → Tag
  eligible : ∀ y, y < height → ∀ x, x < width → allowed M (tag y x)
  flags : ∀ y, y < height → ∀ x, x < width →
    (system n).left (tag y x) = decide (x = 0) ∧ (system n).right (tag y x) = decide (x+1 = width) ∧
    (system n).top (tag y x) = decide (y = 0) ∧ (system n).bottom (tag y x) = decide (y+1 = height) ∧
    (system n).oddRow (tag y x) = odd y ∧ (system n).oddColumn (tag y x) = odd x
  right : ∀ y, y < height → ∀ x, x+1 < width → (system n).horizontal (tag y x) (tag y (x+1))
  down : ∀ y, y+1 < height → ∀ x, x < width → (system n).vertical (tag y x) (tag (y+1) x)
def rectangle (R : Run M w s) (extra : Nat) : Rectangle M w (s+extra+1) where
  positiveW := R.positive
  positiveH := by omega
  tag := fun y x => code (tileAt R extra y x)
  eligible := fun y _ x hx => ⟨_,rfl,admits_tile R extra y x hx⟩
  flags := by
    intro y _ x _
    simp [system,code,tileAt]
  right := fun y _ x hx => ⟨_,_,rfl,rfl,horizontal R extra y x hx⟩
  down := fun y hy x _ => ⟨_,_,rfl,rfl,vertical R extra y x (by omega)⟩
theorem unbounded (R : Run M w s) (k : Nat) :
    ∃ h, 1 < h ∧ k < 2*(w*h) ∧ Nonempty (Rectangle M w h) := by
  have time := positive_time R
  let h := s+k+1
  have hw : 1 ≤ w := R.positive
  have size : h ≤ w*h := by simpa using Nat.mul_le_mul_right h hw
  exact ⟨h,by dsimp [h]; omega,by dsimp [h] at *; omega,⟨rectangle R k⟩⟩
end P455PaddedTiles
end
section
namespace P455Paths
open P455Witness Problem455.Slots
abbrev Step := Nat × ContactChoice
def Walk (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) (s : Nat) :
    List Step → Prop
  | [] => True
  | (b,c) :: rest => Holds r allow mark w (contact r s b c) ∧ Walk r allow mark w b rest
def endpoint (s : Nat) : List Step → Nat
  | [] => s
  | (b,_) :: rest => endpoint b rest
theorem route_iff {r allow mark w} (s : Nat) (p : List Step) (f : Nat → Query) :
    Holds r allow mark w (route r s p f) ↔
      Walk r allow mark w s p ∧ Holds r allow mark w (f (endpoint s p)) := by
  induction p generalizing s with
  | nil => simp [route, Walk, endpoint]
  | cons p ps ih => rcases p with ⟨b,c⟩; simp only [route,Holds,Walk,endpoint,ih,and_assoc]
def Near (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) (s b J : Nat) : Prop :=
  ∃ p, Walk r allow mark w s p ∧ endpoint s p = b ∧ p.length ≤ J
theorem near_self {r allow mark w} (s J : Nat) : Near r allow mark w s s J :=
  ⟨[],True.intro,rfl,Nat.zero_le _⟩
theorem near_one {r allow mark w s t} (c : ContactChoice)
    (hc : Holds r allow mark w (contact r s t c)) : Near r allow mark w s t 1 :=
  ⟨[(t,c)],⟨hc,True.intro⟩,rfl,Nat.le_refl _⟩
theorem near_mono {r allow mark w s b n m} (h : Near r allow mark w s b n) (le : n ≤ m) :
    Near r allow mark w s b m := by
  obtain ⟨p,v,e,len⟩ := h; exact ⟨p,v,e,Nat.le_trans len le⟩
theorem walk_append {r allow mark w} (a : Nat) (p q : List Step) :
    Walk r allow mark w a (p++q) ↔ Walk r allow mark w a p ∧ Walk r allow mark w (endpoint a p) q := by
  induction p generalizing a with
  | nil => simp [Walk,endpoint]
  | cons ab p ih => obtain ⟨b,c⟩ := ab; simp [Walk,endpoint,ih,and_assoc]
theorem endpoint_append (a : Nat) (p q : List Step) :
    endpoint a (p++q) = endpoint (endpoint a p) q := by
  induction p generalizing a with
  | nil => rfl
  | cons ab p ih => exact ih ab.1
theorem near_trans {r allow mark w a b c i j} (h : Near r allow mark w a b i)
    (g : Near r allow mark w b c j) : Near r allow mark w a c (i+j) := by
  obtain ⟨p,hp,ep,lp⟩ := h
  obtain ⟨q,hq,eq,lq⟩ := g
  exact ⟨p++q,(walk_append ..).mpr ⟨hp,ep.symm ▸ hq⟩,
         by rw [endpoint_append,ep,eq], by simp; omega⟩
abbrev V (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) := Holds r allow mark w
theorem allQ_iff {r allow mark w} (qs : List Query) :
    V r allow mark w (allQ qs) ↔ ∀ q ∈ qs, V r allow mark w q := by
  induction qs with
  | nil => simp [allQ,V,Holds]
  | cons x xs ih => change (_ ∧ V r allow mark w (allQ xs)) ↔ _; simp [ih]
theorem slot_route {r allow mark w} (s : SlotCertificate)
    (ok : V r allow mark w (s.query r)) :
    let a := if s.startAtMate then s.anchor.mate else s.anchor.owner
    s.steps.length ≤ 6 ∧ Walk r allow mark w a s.steps ∧
    V r allow mark w (terminalSlot r (endpoint a s.steps) s.terminalIndex s.defect) := by
  simp only [SlotCertificate.query,allQ,Holds,V] at ok
  exact ⟨ok.2.1,(route_iff ..).mp ok.2.2.1⟩
theorem record_counts {r allow mark w a b tag}
    (bound : P455Closure.Cap r w) (recProof : V r allow mark w (.record a b tag)) :
    w.count a = r ∧ w.count b = r := by
  obtain ⟨ne,hl,_,bit,eq⟩ := recProof
  have n := congrArg List.length eq
  simp only [length_select_pair a b ne,profile,List.length_append,profile_prefix_length] at n
  have ca := bound a; have cb := bound b
  cases bit <;> simp [pair] at n <;> omega
theorem record_pair {r allow mark w} {n : Node} (recProof : V r allow mark w (typedNode n)) :
    Near r allow mark w n.owner n.mate 1 ∧ Near r allow mark w n.mate n.owner 1 :=
  ⟨near_one (.record n.tag false) recProof, near_one (.record n.tag true) recProof⟩
private theorem stamp_lower (n : Nat → Nat) (w : W) (a i : Nat)
    (h : (a,i) ∈ stamp n w) : n a ≤ i := by
  induction w generalizing n with
  | nil => simp [stamp] at h
  | cons b w ih =>
    rcases List.mem_cons.mp h with he|hh
    · cases he; exact Nat.le_refl _
    · have z := ih (advance n [b]) hh; simp only [advance] at z; omega
theorem stamp_unique (n : Nat → Nat) (w : W) : (stamp n w).Nodup := by
  induction w generalizing n with
  | nil => simp [stamp]
  | cons a w ih =>
    apply List.nodup_cons.mpr
    refine ⟨fun bad => ?_, ih _⟩
    have low := stamp_lower (advance n [a]) w a (n a) bad
    simp [advance] at low <;> omega
theorem owner_early {r allow mark w} (a b : Node)
    (early : V r allow mark w (earlyDisjoint [a.owner,a.mate] [b.owner,b.mate])) :
    V r allow mark w (earlyDisjoint [a.owner] [b.owner]) := by
  rcases early with h|h
  · left; exact ⟨h.1,True.intro⟩
  · right; exact ⟨h.1,True.intro⟩
theorem owner_port {r allow mark w} (cap : P455Closure.Cap r w) (p : Fin 5) (a b : Node)
    (ok : V r allow mark w (orientedPort p a b)) :
    V r allow mark w (contact r a.owner b.owner (.port p false)) ∧
    V r allow mark w (contact r b.owner a.owner (.port p true)) := by
  obtain ⟨na,nb,early,order,_⟩ := ok
  let i := 3 + 2*p.val
  let pat := [(a.owner,i),(b.owner,i),(a.owner,i+1),(b.owner,i+1)]
  have sub : pat.Sublist [(a.owner,i),(a.mate,i),(b.owner,i),(b.mate,i),
            (a.owner,i+1),(a.mate,i+1),(b.owner,i+1),(b.mate,i+1)] := by
    exact .cons₂ _ (.cons _ (.cons₂ _ (.cons _ (.cons₂ _ (.cons _ (.cons₂ _ (List.nil_sublist _)))))))
  have obs : V r allow mark w (.order pat) :=
    ⟨fun e he => order.1 e (sub.subset he),sub.trans order.2⟩
  have nd := (stamp_unique (fun _ => 0) w).sublist obs.2
  have ne : a.owner ≠ b.owner := by
    intro eq
    have := (List.nodup_cons.mp nd).1
    exact this (by simp [eq])
  have xa := (record_counts cap na).1
  have xb := (record_counts cap nb).1
  have ed := owner_early a b early
  exact ⟨⟨ne,xa,xb,ed,obs,True.intro⟩,⟨Ne.symm ne,xb,xa,ed.symm,obs,True.intro⟩⟩
def Joined (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) (a b : Node) :=
  Near r allow mark w a.owner b.owner 1 ∧ Near r allow mark w b.owner a.owner 1
theorem port_joined {r allow mark w} (cap : P455Closure.Cap r w) (n : Nat) (hn : n < 5)
    {a b : Node} (ok : V r allow mark w (orientedPort n a b)) : Joined r allow mark w a b := by
  obtain ⟨f,g⟩ := owner_port cap ⟨n,hn⟩ a b ok
  exact ⟨near_one _ f,near_one _ g⟩
theorem right_paths {r allow mark w ts a b} (cap : P455Closure.Cap r w)
    (ok : V r allow mark w (rightward ts a b)) : Joined r allow mark w a b :=
  port_joined cap _ (by split <;> decide) ok.2.1
theorem down_paths {r allow mark w ts a b} (cap : P455Closure.Cap r w)
    (ok : V r allow mark w (downward ts a b)) : Joined r allow mark w a b :=
  port_joined cap _ (by split <;> decide) ok.2
theorem neighbor_paths {r allow mark w ts a b} (cap : P455Closure.Cap r w) (d : Dir)
    (ok : V r allow mark w (neighbor ts a b d)) : Joined r allow mark w a b := by
  cases d with
  | right => exact right_paths cap ok
  | left => exact (right_paths cap ok).symm
  | down => exact down_paths cap ok
  | up => exact (down_paths cap ok).symm
theorem neighbor_target_record {r allow mark w ts a b d}
    (ok : V r allow mark w (neighbor ts a b d)) : V r allow mark w (typedNode b) := by
  cases d with
  | right => exact ok.2.1.2.1
  | left => exact ok.2.1.1
  | down => exact ok.2.2.1
  | up => exact ok.2.1
theorem marked_typed {r allow mark w a bit} (m : V r allow mark w (markedNode a bit)) :
    V r allow mark w (typedNode a) := ⟨m.1,m.2.1,m.2.2.1,bit,m.2.2.2.2⟩
end P455Paths
end
section
namespace P455ContactGeometry
open Problem455.Slots P455Witness
theorem project_stamp (keep w : Word) (n n' : Nat → Nat)
    (agree : ∀ a ∈ keep, n a = n' a) :
    stamp n (select keep w) = (stamp n' w).filter (fun e => decide (e.1 ∈ keep)) := by
  induction w generalizing n n' with
  | nil => rfl
  | cons a w ih =>
    by_cases ha : a ∈ keep
    · simp only [select, List.filter_cons, decide_eq_true ha, if_true, stamp]
      rw [agree a ha]
      congr 1
      apply ih
      intro b hb
      simp [advance, agree b hb]
    · simp only [select, List.filter_cons, decide_eq_false ha, Bool.false_eq_true, if_false, stamp]
      apply ih
      intro b hb
      have ne : a ≠ b := fun e => ha (e ▸ hb)
      simp [advance, ne, Ne.symm ne, agree b hb]
theorem projected_events_sublist (keep w : Word) : (events (select keep w)).Sublist (events w) := by
  rw [events, project_stamp keep w (fun _ => 0) (fun _ => 0) (fun _ _ => rfl)]
  exact List.filter_sublist ..
private theorem profile_initial {a b : Nat} (ab : a ≠ b) (tag : Tag) (bit : Bool) :
    [(a,0),(a,1),(b,0),(a,2),(b,1),(b,2)].Sublist (events (profile a b tag bit)) := by
  have shape : ∃ t : Word, profile a b tag bit = [a,a,b,a,b,b] ++ t := by
    unfold profile profilePrefix
    simp only [List.append_assoc]
    exact ⟨_,rfl⟩
  obtain ⟨t,e⟩ := shape
  rw [e,events,stamp_append]
  have pre : stamp (fun _ => 0) [a,a,b,a,b,b] = [(a,0),(a,1),(b,0),(a,2),(b,1),(b,2)] := by
    simp [stamp,advance,ab,Ne.symm ab]
  rw [pre]
  exact List.sublist_append_left ..
private theorem record_geometry {z : Word} {a b : Nat} {tag : Tag}
    (ab : a ≠ b) (typ : typed z a b tag) :
    occupies z a 1 b ∧ occupies z b 0 a ∧ sees z [(a,1),(b,0)] := by
  obtain ⟨bit,eq⟩ := typ
  have initial := profile_initial ab tag bit
  rw [← eq] at initial
  have sub := initial.trans (projected_events_sublist [a,b] z)
  refine ⟨⟨0,?_⟩,⟨2,?_⟩,?_⟩
  · exact (List.Sublist.cons _ (.cons₂ _ (.cons₂ _ (.cons₂ _ (List.nil_sublist _))))).trans sub
  · exact (List.Sublist.cons _ (.cons _ (.cons₂ _ (.cons₂ _ (.cons₂ _ (List.nil_sublist _)))))).trans sub
  · exact (List.Sublist.cons _ (.cons₂ _ (.cons₂ _ (List.nil_sublist _)))).trans sub
theorem geometry {r allow mark z a b c} (hc : Holds r allow mark z (contact r a b c)) :
    (∃ i, slotStart i ∧ occupies z a i b) ∧
    (∃ i, 0 < i ∧ (sees z [(a,i),(b,0)] ∨ sees z [(b,i),(a,0)])) := by
  cases c with
  | record tag rev =>
    cases rev
    · obtain ⟨ab,_,_,typ⟩ := hc
      obtain ⟨slot,_,ord⟩ := record_geometry ab typ
      exact ⟨⟨1,by simp [slotStart],slot⟩,⟨1,by decide,.inl ord⟩⟩
    · obtain ⟨ba,_,_,typ⟩ := hc
      obtain ⟨_,slot,ord⟩ := record_geometry ba typ
      exact ⟨⟨0,by simp [slotStart],slot⟩,⟨1,by decide,.inr ord⟩⟩
  | port phase rev =>
    let i := 3+2*phase.val
    have hi : slotStart i := by have := phase.isLt; unfold i slotStart; omega
    have early : Holds r allow mark z (earlyDisjoint [a] [b]) := hc.2.2.2.1
    have ord : sees z [(a,2),(b,0)] ∨ sees z [(b,2),(a,0)] := by
      rcases early with e | e
      · exact .inl e.1.2
      · exact .inr e.1.2
    refine ⟨⟨i,hi,?_⟩,⟨2,by decide,ord⟩⟩
    cases rev
    · have seq : sees z [(a,i),(b,i),(a,i+1),(b,i+1)] := hc.2.2.2.2.1.2
      exact ⟨i,(List.Sublist.cons₂ _ (.cons₂ _ (.cons₂ _ (List.nil_sublist _)))).trans seq⟩
    · have seq : sees z [(b,i),(a,i),(b,i+1),(a,i+1)] := hc.2.2.2.2.1.2
      exact ⟨i+1,(List.Sublist.cons _ (.refl _)).trans seq⟩
theorem contact_slot {r allow mark z a b c} (hc : Holds r allow mark z (contact r a b c)) :
    ∃ i, slotStart i ∧ occupies z a i b := (geometry hc).1
theorem stamp_range (n : Nat → Nat) (w : Word) {a i : Nat} (h : (a,i) ∈ stamp n w) :
    n a ≤ i ∧ i < n a + w.count a := by
  induction w generalizing n with
  | nil => simp [stamp] at h
  | cons b w ih =>
    rcases List.mem_cons.mp h with head | tail
    · obtain ⟨rfl,rfl⟩ := Prod.mk.inj head
      simp [List.count_cons]
    · have z := ih _ tail
      by_cases e : b = a
      · subst b; simp [advance,List.count_cons] at z ⊢; omega
      · simp [advance,List.count_cons,e,Ne.symm e] at z ⊢; omega
private theorem impossible_order {z f t : Word} {a b i : Nat} (eq : z = f ++ t)
    (low : f.count a ≤ i) (positive : 0 < f.count b) : ¬ sees z [(a,i),(b,0)] := by
  intro e
  have h : [(a,i),(b,0)].Sublist (events f ++ stamp (advance (fun _ => 0) f) t) := by
    simpa only [sees, eq, events, stamp_append] using e
  have first : (a,i) ∉ events f := by
    intro mem
    have bad := (stamp_range (fun _ => 0) f mem).2
    simp only [Nat.zero_add] at bad
    omega
  have last : (b,0) ∉ stamp (advance (fun _ => 0) f) t := by
    intro mem
    have := stamp_range (advance (fun _ => 0) f) t mem
    simp [advance] at this
    omega
  have strip {α : Type} {x y : α} {l k : List α} (n : x ∉ l)
      (s : [x,y].Sublist (l ++ k)) : [x,y].Sublist k := by
    induction l with
    | nil => exact s
    | cons j l ih =>
      cases s with
      | cons _ rest => exact ih (fun e => n (by simp [e])) rest
      | cons_cons _ _ => exact (n (by simp)).elim
  exact last ((strip first h).subset (by simp))
private theorem first_split (x : Nat) (v : Word) (occ : x ∈ v) :
    ∃ l t, v = l ++ x :: t ∧ x ∉ l := by
  induction v with
  | nil => simp at occ
  | cons a v ih =>
    by_cases e : a = x
    · subst a; exact ⟨[],v,rfl,by simp⟩
    · obtain ⟨l,t,eq,nh⟩ := ih (by simpa [Ne.symm e] using occ)
      exact ⟨a::l,t,by simp [eq],by simp [e,Ne.symm e,nh]⟩
theorem same_image_no_early {r : Nat} {v : Word} {h : Nat → Word}
    {l t : Word} {x a b i : Nat} (hr : 0 < r)
    (bound : P455Closure.Cap r (l ++ v.flatMap h ++ t))
    (hx : v.count x = r) (ha : a ∈ h x) (hb : b ∈ h x) (hi : 0 < i) :
    ¬ sees (l ++ v.flatMap h ++ t) [(a,i),(b,0)] := by
  have px : x ∈ v := List.count_pos_iff.mp (hx ▸ hr)
  obtain ⟨pre,post,cut,avoid⟩ := first_split x v px
  have bounds (j : Nat) (mem : j ∈ h x) : (l ++ pre.flatMap h ++ h x).count j = 1 := by
    have bb := bound j
    simp only [List.count_append] at bb
    obtain ⟨one,exclusive,sat⟩ := P455DonorInterval.exclusive h v x j r hr hx mem (by omega)
    have fresh : j ∉ pre.flatMap h := by
      intro z
      obtain ⟨y,hy,yj⟩ := List.mem_flatMap.mp z
      exact exclusive y (by simp [cut,hy]) (fun e => avoid (e ▸ hy)) yj
    have left : l.count j = 0 := by omega
    simp [List.count_append,left,List.count_eq_zero.mpr fresh,one]
  have eq : l ++ v.flatMap h ++ t = (l ++ pre.flatMap h ++ h x) ++ (post.flatMap h ++ t) := by
    simp [cut,List.flatMap_append,List.append_assoc]
  exact impossible_order eq (by rw [bounds a ha]; omega) (by rw [bounds b hb]; decide)
theorem contact_excludes_image {r allow mark} {v : Word} {h : Nat → Word}
    {l t : Word} {x a b c} (hr : 0 < r)
    (bound : P455Closure.Cap r (l ++ v.flatMap h ++ t))
    (hx : v.count x = r) (ha : a ∈ h x)
    (hc : Holds r allow mark (l ++ v.flatMap h ++ t) (contact r a b c)) : b ∉ h x := by
  intro hb
  obtain ⟨i,hi,ord⟩ := (geometry hc).2
  rcases ord with ord | ord
  · exact same_image_no_early hr bound hx ha hb hi ord
  · exact same_image_no_early hr bound hx hb ha hi ord
end P455ContactGeometry
end
section
namespace P455ContactReflection
open Problem455.Slots P455Witness
def eventMap (d : Nat → Nat) (e : Event) : Event := (d e.1, e.2)
theorem select_stamped (keep w : W) (n n' : Nat → Nat)
    (eqn : ∀ a ∈ keep, n a = n' a) :
    (stamp n w).filter (fun e => decide (e.1 ∈ keep)) = stamp n' (select keep w) := by
  induction w generalizing n n' with
  | nil => rfl
  | cons a w ih =>
    by_cases ha : a ∈ keep
    · simp only [stamp, select, List.filter_cons, ha, decide_true, Bool.true_eq, if_true]
      rw [eqn a ha]
      congr 1
      apply ih
      intro b hb
      simp only [advance, eqn b hb]
    · simp only [stamp, select, List.filter_cons, ha, decide_false, Bool.false_eq_true, if_false]
      apply ih
      intro b hb
      have ab : a ≠ b := fun e => ha (e ▸ hb)
      simp [advance, eqn b hb, ab]
theorem sees_select (keep w : W) (pat : List Event) (support : ∀ e ∈ pat, e.1 ∈ keep)
    (seen : sees w pat) : sees (select keep w) pat := by
  have filtered := seen.filter (fun e => decide (e.1 ∈ keep))
  have self : pat.filter (fun e => decide (e.1 ∈ keep)) = pat := by
    apply List.filter_eq_self.mpr; simpa using support
  rw [self] at filtered
  unfold sees events at *
  rw [select_stamped keep w _ (fun _ => 0) (fun _ _ => rfl)] at filtered
  exact filtered
theorem select_sees (keep w : W) (pat : List Event) (seen : sees (select keep w) pat) :
    sees w pat := by
  unfold sees events at *
  rw [← select_stamped keep w (fun _ => 0) _ (fun _ _ => rfl)] at seen
  exact seen.trans (List.filter_sublist ..)
theorem stamp_map (d : Nat → Nat) (w keep : W) (n n' : Nat → Nat)
    (inside : ∀ a ∈ w, a ∈ keep) (dinj : ∀ a ∈ keep, ∀ b ∈ keep, d a = d b → a = b)
    (eqn : ∀ a ∈ keep, n a = n' (d a)) :
    (stamp n w).map (eventMap d) = stamp n' (w.map d) := by
  induction w generalizing n n' with
  | nil => rfl
  | cons a w ih =>
    have ha := inside a (by simp)
    simp only [stamp, List.map_cons, eventMap, eqn a ha, List.cons.injEq, true_and]
    apply ih _ _ (fun b hb => inside b (by simp [hb]))
    intro b hb
    by_cases eq : a = b
    · subst b; simp [advance,eqn a ha]
    · have ne : d a ≠ d b := fun e => eq (dinj a ha b hb e)
      simp [advance, eq, ne, eqn b hb]
theorem selected_donor_word {r : Nat} {v l k : W} {h : Nat → W}
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (keep : W) (d : Nat → Nat)
    (uniform : ∀ a ∈ keep, v.count (d a) = r ∧ a ∈ h (d a))
    (dinj : ∀ a ∈ keep, ∀ b ∈ keep, d a = d b → a = b) :
    (select keep (l ++ v.flatMap h ++ k)).map d = select (keep.map d) v := by
  have exclusive (a) (ha : a ∈ keep) :=
    P455DonorInterval.exclusive h v (d a) a r hr (uniform a ha).1 (uniform a ha).2
      (by have := cap a; simp only [List.count_append] at this; omega)
  have disjoint (a) (ha : a ∈ keep) := P455DonorInterval.enclosing_context
    (v.flatMap h) l k a r (exclusive a ha).2.2 (cap a)
  have sl := select_nil keep l (fun a hm ha => (disjoint a ha).1 hm)
  have sk := select_nil keep k (fun a hm ha => (disjoint a ha).2 hm)
  rw [select_append, select_append, sl, sk, List.nil_append, List.append_nil]
  have owner (x) (hx : x ∈ v) (a) (ha : a ∈ keep) (in_h : a ∈ h x) : d a = x := by
    by_cases eq : x = d a
    · exact eq.symm
    · exact ((exclusive a ha).2.1 x hx eq in_h).elim
  have per (x) (hx : x ∈ v) :
      (select keep (h x)).map d = select (keep.map d) [x] := by
    by_cases mem : x ∈ keep.map d
    · obtain ⟨a,ha,eq⟩ := List.mem_map.mp mem
      have all_a (b) (hb : b ∈ select keep (h x)) : b = a := by
        obtain ⟨in_h,keep_b⟩ := List.mem_filter.mp hb
        have kb : b ∈ keep := by simpa using keep_b
        exact dinj b kb a ha ((owner x hx b kb in_h).trans eq.symm)
      have ct : (select keep (h x)).count a = 1 := by
        rw [select, List.count_filter (by simpa using ha), ← eq, (exclusive a ha).1]
      have len := List.count_eq_length.mpr (fun b hb => (all_a b hb).symm)
      have one : select keep (h x) = List.replicate 1 a :=
        List.eq_replicate_iff.mpr ⟨len.symm.trans ct, all_a⟩
      rw [one]
      simp only [select, List.filter_cons, mem, decide_true, if_true, List.filter_nil, List.replicate_succ, List.replicate_zero, List.map_cons, List.map_nil, eq]
    · have none := select_nil keep (h x) (fun a in_h ha =>
        mem (List.mem_map.mpr ⟨a,ha,owner x hx a ha in_h⟩))
      rw [none]
      simp only [select, List.filter_cons, mem, decide_false, Bool.false_eq_true, if_false, List.filter_nil, List.map_nil]
  have fit (w : W) (sub : ∀ x ∈ w, x ∈ v) :
      (select keep (w.flatMap h)).map d = select (keep.map d) w := by
    induction w with
    | nil => rfl
    | cons a ws ih =>
      change (select keep (h a ++ ws.flatMap h)).map d = select (keep.map d) ([a] ++ ws)
      rw [select_append, List.map_append, select_append, per a (sub a (by simp)),
        ih (fun b hb => sub b (by simp [hb]))]
  exact fit v (fun _ hmem => hmem)
theorem reflect_order {r : Nat} {v l k : W} {h : Nat → W}
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (keep : W) (d : Nat → Nat)
    (uniform : ∀ a ∈ keep, v.count (d a) = r ∧ a ∈ h (d a))
    (dinj : ∀ a ∈ keep, ∀ b ∈ keep, d a = d b → a = b)
    (pat : List Event) (inside : ∀ e ∈ pat, e.1 ∈ keep)
    (seen : sees (l ++ v.flatMap h ++ k) pat) : sees v (pat.map (eventMap d)) := by
  have selected := sees_select keep _ pat inside seen
  apply select_sees (keep.map d)
  have named := selected.map (eventMap d)
  unfold sees events at *
  rw [stamp_map d _ keep _ (fun _ => 0)
    (fun a ha => by have := (List.mem_filter.mp ha).2; simpa using this) dinj (fun _ _ => rfl),
    selected_donor_word hr cap keep d uniform dinj] at named
  exact named
theorem map_profile (d : Nat → Nat) (a b : Nat) (tag : Tag) (bit : Bool) :
    (profile a b tag bit).map d = profile (d a) (d b) tag bit := by
  have bp (c : Bool) : (pair a b c).map d = pair (d a) (d b) c := by cases c <;> rfl
  have tp : (tag.flatMap (pair a b)).map d = tag.flatMap (pair (d a) (d b)) := by
    induction tag with
    | nil => rfl
    | cons c tag ih => simp [bp, ih]
  simp only [profile,profilePrefix,List.map_append,bp,tp]
  rfl
private theorem two_labels {r : Nat} {v l k : W} {h : Nat → W} {x y s t : Nat}
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (hx : v.count x = r) (hy : v.count y = r) (hxy : x ≠ y) (hs : s ∈ h x) (ht : t ∈ h y) :
    ∃ d : Nat → Nat, d s = x ∧ d t = y ∧
        (∀ a ∈ [s,t], v.count (d a) = r ∧ a ∈ h (d a)) ∧
        (∀ a ∈ [s,t], ∀ b ∈ [s,t], d a = d b → a = b) := by
  have hy' : y ∈ v := List.count_pos_iff.mp (by omega)
  have diff : s ≠ t := by
    intro eq
    have excl := P455DonorInterval.exclusive h v x s r hr hx hs
      (by have := cap s; simp only [List.count_append] at this; omega)
    exact excl.2.1 y hy' (Ne.symm hxy) (eq ▸ ht)
  let d := fun a => if a = s then x else y
  have p : d s = x := by simp [d]
  have q : d t = y := by simp [d, Ne.symm diff]
  refine ⟨d,p,q,?_,?_⟩
  · intro a mem
    simp only [List.mem_cons, List.not_mem_nil, or_false] at mem
    rcases mem with rfl | rfl
    · exact p.symm ▸ And.intro hx hs
    · exact q.symm ▸ And.intro hy ht
  · intro a ha b hb e
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> simp_all
theorem reflect_profile {r : Nat} {v l k : W} {h : Nat → W} {x y s t : Nat}
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (hx : v.count x = r) (hy : v.count y = r) (hxy : x ≠ y) (hs : s ∈ h x) (ht : t ∈ h y)
    (tag : Tag) (bit : Bool) (eq : select [s,t] (l ++ v.flatMap h ++ k) = profile s t tag bit) :
    select [x,y] v = profile x y tag bit := by
  obtain ⟨d,p,q,uniform,inj⟩ := two_labels hr cap hx hy hxy hs ht
  have e := selected_donor_word hr cap [s,t] d uniform inj
  rw [eq,map_profile] at e
  simpa only [List.map_cons,List.map_nil,p,q] using e.symm
theorem reflect_order_query {r : Nat} {v l k : W} {h : Nat → W}
    {allow : Tag → Prop} {mark : Marking}
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (keep : W) (d : Nat → Nat)
    (uniform : ∀ a ∈ keep, v.count (d a) = r ∧ a ∈ h (d a))
    (dinj : ∀ a ∈ keep, ∀ b ∈ keep, d a = d b → a = b)
    (pat : List Event) (inside : ∀ e ∈ pat, e.1 ∈ keep)
    (seen : Holds r allow mark (l ++ v.flatMap h ++ k) (.order pat)) :
    Holds r allow mark v (.order (pat.map (eventMap d))) := by
  obtain ⟨imm, order⟩ := seen
  refine ⟨?_, reflect_order hr cap keep d uniform dinj pat inside order⟩
  rintro e he
  obtain ⟨a,ha,rfl⟩ := List.mem_map.mp he
  exact imm a ha
theorem reflect_contact {r : Nat} {allow : Tag → Prop} {mark : Marking}
    {v l k : W} {h : Nat → W} {x y s t : Nat}
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (hx : v.count x = r) (hy : v.count y = r) (hxy : x ≠ y) (hs : s ∈ h x) (ht : t ∈ h y)
    (c : ContactChoice) :
    Holds r allow mark (l ++ v.flatMap h ++ k) (contact r s t c) →
      Holds r allow mark v (contact r x y c) := by
  cases c with
  | record tag rev =>
    cases rev
    · rintro ⟨_,len,code,bit,eq⟩
      exact ⟨hxy,len,code,bit,reflect_profile hr cap hx hy hxy hs ht tag bit eq⟩
    · rintro ⟨_,len,code,bit,eq⟩
      exact ⟨Ne.symm hxy,len,code,bit,reflect_profile hr cap hy hx (Ne.symm hxy) ht hs tag bit eq⟩
  | port phase rev =>
    obtain ⟨d,p,q,uniform,inj⟩ := two_labels hr cap hx hy hxy hs ht
    have orders := @reflect_order_query r v l k h allow mark hr cap [s,t] d uniform inj
    have left (i j : Nat) (sig : Holds r allow mark (l ++ v.flatMap h ++ k) (earlier s i t j)) :
        Holds r allow mark v (earlier x i y j) := by
      have o := orders [(s,i),(t,j)] (by simp) sig
      simpa [eventMap,p,q,earlier] using o
    have right (i j : Nat) (sig : Holds r allow mark (l ++ v.flatMap h ++ k) (earlier t i s j)) :
        Holds r allow mark v (earlier y i x j) := by
      have o := orders [(t,i),(s,j)] (by simp) sig
      simpa [eventMap,p,q,earlier] using o
    intro core
    obtain ⟨_,_,_,early,ordered,_⟩ := core
    refine ⟨hxy,hx,hy,?_,?_,True.intro⟩
    · rcases early with ⟨o,_⟩ | ⟨o,_⟩
      · exact Or.inl ⟨left 2 0 o,True.intro⟩
      · exact Or.inr ⟨right 2 0 o,True.intro⟩
    · let i := 3 + 2 * phase.val
      cases rev with
      | false =>
        have o := orders [(s,i),(t,i),(s,i+1),(t,i+1)] (by simp) ordered
        simpa [eventMap,p,q,i] using o
      | true =>
        have o := orders [(t,i),(s,i),(t,i+1),(s,i+1)] (by simp) ordered
        simpa [eventMap,p,q,i] using o
end P455ContactReflection
end
section
namespace P455TerminalTransfer
open Problem455.Slots P455Witness
def Lift (v : Word) (h : Nat → Word) (x i r : Nat) : SlotDefect → Prop
  | .deficient _ => False
  | .overflow xs => ∃ assign : Nat → Nat, xs.length = 5 ∧ (x :: xs.map assign).Nodup ∧
      ∀ a ∈ xs, occupies v x i (assign a) ∧ a ∈ h (assign a) ∧ v.count (assign a) = r
theorem holds_all {r allow mark z} (qs : List Query) :
    Holds r allow mark z (allQ qs) ↔ ∀ q ∈ qs, Holds r allow mark z q := by
  induction qs with
  | nil => simp [allQ,Holds]
  | cons q qs ih => simp [allQ,Holds,ih]
theorem block_separation {r allow mark z} (xs : List Nat) :
    Holds r allow mark z (differentBlocks xs) ↔
      xs.Pairwise (fun a b => ¬ Problem455Swap.SameBlock r z a b) := by
  induction xs with
  | nil => simp [differentBlocks,Holds]
  | cons a xs ih =>
    simp [differentBlocks,Holds,holds_all,ih,List.pairwise_cons]
theorem terminal (v : Word) (h : Nat → Word) (l k : Word) (x s i r : Nat)
    (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (hx : v.count x = r)
    (hs : s ∈ h x) (guard : ∀ y, occupies v x i y → v.count y = r) {allow mark}
    (d : SlotDefect)
    (obs : Holds r allow mark (l ++ v.flatMap h ++ k) (terminalSlot r s i d)) :
    Lift v h x i r d := by
  let z := l ++ v.flatMap h ++ k
  have capF : ∀ j, (v.flatMap h).count j ≤ r := by
    intro a
    have c := cap a
    simp only [List.count_append] at c
    omega
  have satZ (a y : Nat) (hy : v.count y = r) (ha : a ∈ h y) : z.count a = r := by
    have full := (P455DonorInterval.exclusive h v y a r hr hy ha (capF a)).2.2
    have c := cap a
    simp only [z,List.count_append] at *
    omega
  have common (y a b : Nat) (hy : v.count y = r) (ha : a ∈ h y) (hb : b ∈ h y) :
      Problem455Swap.SameBlock r z a b := by
    have capZ : Problem455Swap.cap r z := by
      intro c
      rw [Problem455BlockBridge.occ_count]
      exact cap c
    exact Problem455Swap.sameBlock_factor ⟨l,k,rfl⟩ capZ
      (Problem455SameDonor.sameDonor v h y hy capF a b ha hb)
  cases d with
  | deficient a =>
    obtain ⟨⟨_,occ⟩,bad⟩ := obs
    change z.count a < r at bad
    rcases P455SlotOrigin.supplier_or_boundary v h l k x s a i r hr cap hx hs occ guard with
        bnd | ⟨y,_,ay,hy,_⟩
    · have := satZ a x hx bnd
      omega
    · have := satZ a y hy ay
      omega
  | overflow xs =>
    change Holds r allow mark z (allQ _) at obs
    have ob := (holds_all _).mp obs
    have len : xs.length = 5 := ob (.fixed _) (by simp)
    have sep := (block_separation (s::xs)).mp (ob _ (by simp))
    obtain ⟨ownerSep,tailSep⟩ := List.pairwise_cons.mp sep
    have rest : ∀ a ∈ xs, occupies z s i a := by
      intro a ha
      have htest : Holds r allow mark z
          (allQ (xs.map fun a => .both (.count a r) (.slot s i a))) := ob _ (by simp)
      have hin := (holds_all _).mp htest (.both (.count a r) (.slot s i a)) (List.mem_map.mpr ⟨a,ha,rfl⟩)
      exact hin.2.2
    classical
    have supply (a : Nat) (ha : a ∈ xs) :
        ∃ y, occupies v x i y ∧ a ∈ h y ∧ v.count y = r ∧ x ≠ y :=
      P455SlotOrigin.supplier v h l k x s a i r hr cap hx hs
        (fun shared => ownerSep a ha (common x s a hx hs shared)) (rest a ha) guard
    let assign := fun a => if ha : a ∈ xs then (supply a ha).choose else x
    have spec (a : Nat) (ha : a ∈ xs) :
        occupies v x i (assign a) ∧ a ∈ h (assign a) ∧ v.count (assign a) = r ∧ x ≠ assign a := by
      simpa [assign,ha] using (supply a ha).choose_spec
    have nodup : (xs.map assign).Nodup := by
      apply List.pairwise_map.mpr
      apply tailSep.imp_of_mem
      intro a b ha hb distinct e
      have A := spec a ha
      have B := spec b hb
      exact distinct (common (assign a) a b A.2.2.1 A.2.1 (e ▸ B.2.1))
    refine ⟨assign,len,List.nodup_cons.mpr ⟨?_,nodup⟩,?_⟩
    · rintro member
      obtain ⟨a,ha,e⟩ := List.mem_map.mp member
      exact (spec a ha).2.2.2 e.symm
    · intro a ha
      have e := spec a ha
      exact ⟨e.1,e.2.1,e.2.2.1⟩
end P455TerminalTransfer
end
section
namespace P455EffectiveQMove
open P455Closure P455EffectiveQ
abbrev W := List Nat
def capB (r : Nat) (u : W) := u.all fun a => decide (u.count a ≤ r)
theorem cap_iff (r : Nat) (u : W) : capB r u = true ↔ Cap r u := by
  simp only [capB,List.all_eq_true,decide_eq_true_eq,Cap]
  constructor
  · intro h a; by_cases m : a∈u
    · exact h a m
    · simp [List.count_eq_zero_of_not_mem m]
  · exact fun h a _ => h a
def validB (r : Nat) (tags : List (List Bool)) (marks : Nat → Nat → Bool) (f : Frame Nat) :=
  decide (r = 16 + f.tag.length ∧ f.tag∈tags ∧ f.middle.map Prod.snd = fixedPhases f.tag ∧
    f.p.Nodup ∧ f.q.Nodup ∧ (∀ a∈f.p, a∉f.q) ∧
    (∀ a∈f.p, ∀ b∈f.q, marks a b = false ∧ marks b a = false) ∧
    (∀ a∈f.p++f.q,(f.core false).count a = r))
theorem valid_iff {tags marks allow mark} (tag_ok : ∀ t, t∈tags ↔ allow t)
    (mark_ok : ∀ a b,marks a b = true ↔ mark a b)
    (r : Nat) (f : Frame Nat) : validB r tags marks f = true ↔ f.Valid r allow mark := by
  have unmarked (a b) : marks a b = false ↔ ¬mark a b := by
    rw [←mark_ok]; cases marks a b <;> decide
  simp only [validB,decide_eq_true_eq,Frame.Valid,tag_ok,unmarked,List.mem_append]
def entries (u : W) := (words u).flatMap (fun g => [(g,false),(g,true)])
def frames (tags : List (List Bool)) (u : W) : List (Frame Nat) :=
  tags.flatMap fun t => u.flatMap fun a => (words u).flatMap fun p =>
  (words u).flatMap fun q => u.flatMap fun z =>
  (Problem455Finite.wordsUpTo (entries u) (fixedPhases t).length).flatMap fun es =>
  (words u).flatMap fun m => (words u).flatMap fun l =>
  (words u).map fun n => ⟨a,p,q,z,t,es,m,l,n⟩
private theorem left {u a b : W} (h : u.Sublist a) : u.Sublist (a++b) :=
  h.trans (List.sublist_append_left _ _)
private theorem right {u a b : W} (h : u.Sublist b) : u.Sublist (a++b) :=
  h.trans (List.sublist_append_right _ _)
theorem frame_mem {tags allow r mark} (tag_ok : ∀ t,t∈tags ↔ allow t)
    (f : Frame Nat) (b : Bool) (l t : W) (fv : f.Valid r allow mark) :
    f ∈ frames tags (l++f.core b++t) := by
  let u := l++f.core b++t
  have core : (f.core b).Sublist u := left (right (List.Sublist.refl _))
  have within (s : W) (hs : s.Sublist (f.core b)) : s.Sublist u := hs.trans core
  have early : f.early.Sublist u := within _ (left (left (left (left (left (left (left (.refl _))))))))
  have pp : f.p.Sublist u :=
    (show f.p.Sublist f.early from left (left (left (left (left (.refl _)))))).trans early
  have qq : f.q.Sublist u := (right (.refl _) : f.q.Sublist f.early).trans early
  have a : f.pHead∈u := pp.subset (by simp [Frame.p])
  have z : f.qLast∈u := qq.subset (by simp [Frame.q])
  have pt : f.pTail∈words u := subword ((List.sublist_cons_self ..).trans pp)
  have qi : f.qInit∈words u := subword ((List.sublist_append_left ..).trans qq)
  have mid : f.mid.Sublist u := within _ (left (left (left (left (left (left (right (.refl _))))))))
  have m : f.beforeMutable∈words u := subword (within _ (left (left (left (left (left (right (.refl _))))))))
  have p : f.beforeFinalP∈words u := subword (within _ (left (left (left (right (.refl _))))))
  have n : f.beforeFinalQ∈words u := subword (within _ (left (right (.refl _))))
  have es : f.middle ∈ Problem455Finite.wordsUpTo (entries u) (fixedPhases f.tag).length := by
    have sz := congrArg List.length fv.2.2.1
    apply Problem455Finite.covered _ _ _ (by simpa using Nat.le_of_eq sz)
    rintro ⟨g,v⟩ mem
    have item : g.Sublist f.mid := by
      let B := fun e : W×Bool => e.1 ++ (if e.2 then f.q else f.p)
      have item : (B (g,v)).Sublist ((f.middle.map B).flatten) :=
        List.sublist_flatten_of_mem (List.mem_map_of_mem mem)
      exact (List.sublist_append_left g _).trans (by simpa [Frame.mid,List.flatMap_def,B] using item)
    have gg := subword (item.trans mid)
    apply List.mem_flatMap.mpr
    exact ⟨g,gg,by cases v <;> simp⟩
  change f ∈ frames tags u
  simp only [frames,List.mem_flatMap,List.mem_map]
  exact ⟨f.tag,(tag_ok _).mpr fv.2.1,f.pHead,a,f.pTail,pt,f.qInit,qi,f.qLast,z,f.middle,es,
    f.beforeMutable,m,f.beforeFinalP,p,f.beforeFinalQ,n,rfl⟩
theorem min_length {r allow} {mark : Nat → Nat → Prop} {u v : W} (h : Move r allow mark u v) : r ≤ u.length := by
  obtain ⟨f,b,l,t,valid,rfl,_,_⟩ := h
  have sat := valid.2.2.2.2.2.2.2 f.pHead (.inl (by simp [Frame.p]))
  have count : (f.core b).count f.pHead = r := by
    cases b with
    | false => exact sat
    | true => exact (f.count_core f.pHead true).trans sat
  have len := List.count_le_length (a := f.pHead) (l := f.core b)
  simp only [List.length_append]
  omega
def moveB (r : Nat) (tags : List (List Bool)) (marks : Nat → Nat → Bool) (u v : W) :=
  decide (r ≤ u.length) && capB r u && (frames tags u).any fun f => validB r tags marks f && [false,true].any fun b =>
    (words u).any fun l => (words u).any fun t =>
      decide (u = l++f.core b++t ∧ v = l++f.core (!b)++t)
theorem move_iff {tags marks allow mark} (tag_ok : ∀ t,t∈tags ↔ allow t)
    (mark_ok : ∀ a b,marks a b = true ↔ mark a b)
    (r : Nat) (u v : W) : moveB r tags marks u v = true ↔ Move r allow mark u v := by
  simp only [moveB,Bool.and_eq_true,List.any_eq_true,decide_eq_true_eq,
    cap_iff,valid_iff tag_ok mark_ok]
  constructor
  · rintro ⟨⟨_,cap⟩,f,_,fv,b,_,l,_,t,_,src,dst⟩; exact ⟨f,b,l,t,fv,src,dst,cap⟩
  · intro h
    have len := min_length h
    obtain ⟨f,b,l,t,fv,rfl,rfl,cp⟩ := h
    exact ⟨⟨len,cp⟩,f,frame_mem tag_ok f b l t fv,fv,b,by cases b <;> simp,l,
      subword (left (left (.refl _))),t,subword (right (.refl _)),rfl,rfl⟩
end P455EffectiveQMove
end
section
namespace P455RealizerGraph
open P455EffectiveQ
variable {α : Type} [DecidableEq α]
def joinAt (k : α) (m : List (α × α)) := m ++ m.flatMap fun p =>
  if p.2 = k then m.filterMap (fun q => if q.1 = k then some (p.1,q.2) else none) else []
theorem mem_joinAt (k a b : α) (m : List (α × α)) :
    (a,b)∈joinAt k m ↔ (a,b)∈m ∨ ((a,k)∈m ∧ (k,b)∈m) := by
  simp only [joinAt,List.mem_append,List.mem_flatMap]
  apply or_congr_right
  constructor
  · rintro ⟨⟨x,y⟩,px,h⟩
    by_cases eq : y = k
    · subst y
      rw [if_pos rfl] at h
      obtain ⟨⟨z,w⟩,qz,h⟩ := List.mem_filterMap.mp h
      dsimp only at h
      split at h
      · rename_i hzk
        obtain ⟨hxa,hwb⟩ := Prod.mk.inj (Option.some.inj h)
        subst z; subst x; subst w
        exact ⟨px,qz⟩
      · contradiction
    · simp [eq] at h
  · rintro ⟨p,q⟩
    refine ⟨(a,k),p,?_⟩
    simp [List.mem_filterMap]
    exact q
def initial (domain : List α) (edge : α → α → Bool) := domain.flatMap fun a =>
  (domain.filter fun b => decide (a = b) || edge a b).map fun b => (a,b)
theorem mem_initial {domain : List α} (edge : α → α → Bool) {a b : α} (ha : a∈domain) (hb : b∈domain) :
    (a,b)∈initial domain edge ↔ a = b ∨ edge a b = true := by
  simp only [initial,List.mem_flatMap,List.mem_map,List.mem_filter,Bool.or_eq_true,decide_eq_true_eq,
    Prod.mk.injEq]
  constructor
  · rintro ⟨x,_,y,⟨_,e⟩,rfl,rfl⟩; exact e
  · intro h; exact ⟨a,ha,b,⟨hb,h⟩,rfl,rfl⟩
theorem mem_fold {domain : List α} (e : α → α → Bool) (pivots : List α)
    (hp : ∀ x∈pivots,x∈domain) {a b : α} (ha : a∈domain) (hb : b∈domain) :
    (a,b)∈pivots.foldr joinAt (initial domain e) ↔ P455EffectiveQReach.via e pivots a b = true := by
  induction pivots generalizing a b with
  | nil => simpa [P455EffectiveQReach.via] using mem_initial e ha hb
  | cons k ks ih =>
    have mem := hp k List.mem_cons_self
    have rest : ∀ x∈ks,x∈domain := fun x h => hp x (List.mem_cons_of_mem _ h)
    simp only [List.foldr_cons,mem_joinAt,P455EffectiveQReach.via,Bool.or_eq_true,Bool.and_eq_true,
      ih rest ha hb,ih rest ha mem,ih rest mem hb]
def walk (e : W → W → Bool) (u v : W) :=
  let pivots := words u
  decide ((u,v)∈pivots.foldr joinAt (initial (u::v::pivots) e))
theorem walk_eq (e : W → W → Bool) (u v : W) : walk e u v = walkB e u v := by
  apply Bool.eq_iff_iff.mpr
  simp only [walk,decide_eq_true_eq,walkB]
  exact mem_fold e _ (fun x h => by simp [h]) (by simp) (by simp)
end P455RealizerGraph
end
section
namespace P455PaddedTiles
open P455Witness
variable {n w h : Nat} {M : MachineTable n}
private theorem clip {v : Nat} (hv : 0 < v) (k : Nat) : min k (v-1) < v := by
  have := Nat.min_le_right k (v-1)
  omega
noncomputable def readTile (R : Rectangle M w h) (y x : Nat) : Tile n :=
  (R.eligible (min y (h-1)) (clip R.positiveH _) (min x (w-1)) (clip R.positiveW _)).choose
theorem read_tile_data (R : Rectangle M w h) (y x : Nat) (hy : y < h) (hx : x < w) :
    code (readTile R y x) = R.tag y x ∧ Admitted M (readTile R y x) := by
  have d := (R.eligible (min y (h-1)) (clip R.positiveH _) (min x (w-1)) (clip R.positiveW _)).choose_spec
  refine ⟨?_,d.2⟩
  change code (readTile R y x) = R.tag (min y (h-1)) (min x (w-1)) ∧ _ at d
  simpa only [Nat.min_eq_left (by omega : y ≤ h-1),Nat.min_eq_left (by omega : x ≤ w-1)] using d.1
private theorem read_flags (R : Rectangle M w h) (y x : Nat) (hy : y < h) (hx : x < w) :
    (readTile R y x).left = decide (x = 0) ∧ (readTile R y x).right = decide (x+1 = w) ∧
    (readTile R y x).top = decide (y = 0) ∧ (readTile R y x).bottom = decide (y+1 = h) := by
  have f := R.flags y hy x hx
  rw [← (read_tile_data R y x hy hx).1] at f
  exact ⟨f.1,f.2.1,f.2.2.1,f.2.2.2.1⟩
theorem read_horizontal (R : Rectangle M w h) (y x : Nat) (hy : y < h) (hx : x+1 < w) :
    Horizontal (readTile R y x) (readTile R y (x+1)) := by
  obtain ⟨a,b,pa,pb,H⟩ := R.right y hy x hx
  have ea := code_inj (pa.trans (read_tile_data R y x hy (by omega)).1.symm)
  have eb := code_inj (pb.trans (read_tile_data R y (x+1) hy hx).1.symm)
  simpa only [ea,eb] using H
theorem read_vertical (R : Rectangle M w h) (y x : Nat) (hy : y+1 < h) (hx : x < w) :
    Vertical (readTile R y x) (readTile R (y+1) x) := by
  obtain ⟨a,b,pa,pb,V⟩ := R.down y hy x hx
  have ea := code_inj (pa.trans (read_tile_data R y x (by omega) hx).1.symm)
  have eb := code_inj (pb.trans (read_tile_data R (y+1) x hy hx).1.symm)
  simpa only [ea,eb] using V
noncomputable def centers (R : Rectangle M w h) (y x : Nat) := (readTile R y x).c
theorem read_triple (R : Rectangle M w h) (y x : Nat) (hy : y < h) (hx : x < w) :
    (readTile R y x).l = leftAt (centers R y) x ∧
    (readTile R y x).r = rightAt (centers R y) w x := by
  have d := (read_tile_data R y x hy hx).2
  have f := read_flags R y x hy hx
  constructor
  · by_cases e : x = 0
    · have b := d.2.1.symm.trans f.1
      simp [e] at b
      simpa [leftAt,e] using b
    · have p := (read_horizontal R y (x-1) hy (by omega)).2.2.2.2.2.2.1
      simpa [leftAt,e,centers,show x-1+1 = x by omega] using p
  · by_cases e : x+1 = w
    · have b := d.2.2.1.symm.trans f.2.1
      simp [e] at b
      simpa [rightAt,e] using b
    · have p := (read_horizontal R y x hy (by omega)).2.2.2.2.2.2.2
      simpa [rightAt,e,centers] using p
structure AcceptingTrace (M : MachineTable n) (w s : Nat) where
  positive : 0 < w
  rows : Nat → Nat → Fin n
  start : ∀ x, x < w → rows 0 x = M.initial (decide (x = 0))
  marks : ∀ y, y ≤ s → ∀ x, x < w → M.marker (rows y x) = decide (x = 0)
  steps : ∀ y, y < s → ∀ x, x < w →
    M.next (leftAt (rows y) x) (rows y x) (rightAt (rows y) w x) = some (rows (y+1) x)
  accept : rows s 0 = M.accept
noncomputable def read_trace (R : Rectangle M w h) : AcceptingTrace M w (h-1) where
  positive := R.positiveW
  rows := centers R
  start := by
    intro x hx
    have d := (read_tile_data R 0 x R.positiveH hx).2
    have f := read_flags R 0 x R.positiveH hx
    exact ((d.2.2.2.2.2.1 (by simpa using f.2.2.1)).2).trans (congrArg M.initial f.1)
  marks := by
    intro y hy x hx
    have lt : y < h := by have := R.positiveH; omega
    exact (read_tile_data R y x lt hx).2.2.2.2.1.trans (read_flags R y x lt hx).1
  steps := by
    intro y hy x hx
    have lt : y < h := by omega
    have upd := (read_tile_data R y x lt hx).2.1
    have triple := read_triple R y x lt hx
    rw [triple.1,triple.2] at upd
    exact upd.trans (congrArg some (read_vertical R y x (by omega) hx).2.2.2.2.2.2)
  accept := by
    have hy : h-1 < h := by have := R.positiveH; omega
    have e : h-1+1 = h := by have := R.positiveH; omega
    have f := read_flags R (h-1) 0 hy R.positiveW
    exact (read_tile_data R (h-1) 0 hy R.positiveW).2.2.2.2.2.2.2
      (by simpa [e] using f.2.2.2) (by simpa using f.1)
end P455PaddedTiles
end
section
namespace P455CertificateReach
open P455Witness P455Paths
inductive Active (ts : Tiles) (e : EdgeCertificate) : Node → Prop
  | anchor : Active ts e e.a
  | successor : Active ts e e.b
  | right : ts.right e.a.tag = false → Active ts e e.right
  | left : ts.left e.a.tag = false → Active ts e e.left
  | down : ts.bottom e.a.tag = false → Active ts e e.down
  | up : ts.top e.a.tag = false → Active ts e e.up
  | diagonal : ts.right e.a.tag = false → ts.bottom e.a.tag = false → Active ts e e.diagonal
private theorem role_near {r allow mark w n label} (recProof : V r allow mark w (typedNode n))
    (role : label = n.owner ∨ label = n.mate) : Near r allow mark w n.owner label 1 := by
  rcases role with h|h
  · simpa [h] using (near_self (r := r) (allow := allow) (mark := mark) (w := w) n.owner 1)
  · exact h ▸ (record_pair recProof).1
theorem functionality_reach {r allow mark w} (cap : P455Closure.Cap r w)
    (ts : Tiles) (f : FunctionalityCertificate) (ok : V r allow mark w (f.query ts))
    {n : Node} {label : Nat} (node : n = f.anchor ∨ n = f.b ∨ n = f.c)
    (role : label = n.owner ∨ label = n.mate) : Near r allow mark w f.anchor.owner label 2 := by
  rcases node with h|h|h <;> subst n
  · exact near_mono (role_near (marked_typed ok.1) role) (by decide)
  · have port := ok.2.1
    exact near_trans (neighbor_paths cap f.dir port).1 (role_near (neighbor_target_record port) role)
  · have port := ok.2.2.1
    exact near_trans (neighbor_paths cap f.dir port).1 (role_near (neighbor_target_record port) role)
private theorem on_guard {r allow mark w b q} (hb : b = false)
    (h : V r allow mark w (flagQ (!b) q)) : V r allow mark w q := by
  simpa [flagQ,hb] using h
private theorem local_right {r allow mark w ts e} (h : V r allow mark w (localCert ts e))
    (b : ts.right e.a.tag = false) : V r allow mark w (rightward ts e.a e.right) :=
  on_guard b h.1
private theorem local_left {r allow mark w ts e} (h : V r allow mark w (localCert ts e))
    (b : ts.left e.a.tag = false) : V r allow mark w (rightward ts e.left e.a) :=
  on_guard b h.2.1
private theorem local_down {r allow mark w ts e} (h : V r allow mark w (localCert ts e))
    (b : ts.bottom e.a.tag = false) : V r allow mark w (downward ts e.a e.down) :=
  on_guard b h.2.2.1
private theorem local_up {r allow mark w ts e} (h : V r allow mark w (localCert ts e))
    (b : ts.top e.a.tag = false) : V r allow mark w (downward ts e.up e.a) :=
  on_guard b h.2.2.2.1
private theorem local_square {r allow mark w ts e} (h : V r allow mark w (localCert ts e))
    (b : ts.right e.a.tag = false) (d : ts.bottom e.a.tag = false) :
    V r allow mark w (downward ts e.right e.diagonal) ∧
    V r allow mark w (rightward ts e.down e.diagonal) := by
  have sq := h.2.2.2.2.1
  simpa [flagQ,b,d,V,Holds] using sq
theorem successor_joined {r allow mark w} {ts : Tiles} {e : EdgeCertificate} (cap : P455Closure.Cap r w)
    (ok : V r allow mark w (e.query ts)) : Joined r allow mark w e.a e.b := by
  have lc := ok.2.2.1
  have succ := ok.2.2.2.1
  unfold chosenSuccessor at succ
  dsimp only at succ
  split at succ
  next ret =>
    rcases succ.2.1 with f|b
    · exact port_joined cap 4 (by decide) f
    · exact (port_joined cap 4 (by decide) b).symm
  next noReturn =>
    have eq := succ.1
    cases row : endOfRow ts e.a with
    | true =>
      have bottom : ts.bottom e.a.tag = false := by simpa [row] using noReturn
      have target : e.down = e.b := by simpa [row,P455Witness.Holds] using eq
      exact target ▸ down_paths cap (local_down lc bottom)
    | false =>
      cases odd : ts.oddRow e.a.tag with
      | true =>
        have left : ts.left e.a.tag = false := by simpa [endOfRow,odd] using row
        have target : e.left = e.b := by simpa [row,odd,P455Witness.Holds] using eq
        exact target ▸ (right_paths cap (local_left lc left)).symm
      | false =>
        have right : ts.right e.a.tag = false := by simpa [endOfRow,odd] using row
        have target : e.right = e.b := by simpa [row,odd,P455Witness.Holds] using eq
        exact target ▸ right_paths cap (local_right lc right)
theorem active_owner {r allow mark w} (cap : P455Closure.Cap r w)
    (ts : Tiles) (e : EdgeCertificate) (ok : V r allow mark w (e.query ts))
    {n : Node} (active : Active ts e n) :
    Near r allow mark w e.a.owner n.owner 2 ∧ V r allow mark w (typedNode n) := by
  have lc := ok.2.2.1
  cases active with
  | anchor => exact ⟨near_self _ _,marked_typed ok.1⟩
  | successor => exact ⟨near_mono (successor_joined cap ok).1 (by decide),marked_typed ok.2.1⟩
  | right b =>
    have p := local_right lc b
    exact ⟨near_mono (right_paths cap p).1 (by decide),neighbor_target_record (d := .right) p⟩
  | left b =>
    have p := local_left lc b
    exact ⟨near_mono (right_paths cap p).2 (by decide),neighbor_target_record (d := .left) p⟩
  | down b =>
    have p := local_down lc b
    exact ⟨near_mono (down_paths cap p).1 (by decide),neighbor_target_record (d := .down) p⟩
  | up b =>
    have p := local_up lc b
    exact ⟨near_mono (down_paths cap p).2 (by decide),neighbor_target_record (d := .up) p⟩
  | diagonal rr dd =>
    have p := local_right lc rr
    have q := (local_square lc rr dd).1
    exact ⟨near_trans (right_paths cap p).1 (down_paths cap q).1,neighbor_target_record (d := .down) q⟩
theorem edge_reach {r allow mark w} (cap : P455Closure.Cap r w)
    (ts : Tiles) (e : EdgeCertificate) (ok : V r allow mark w (e.query ts))
    {n : Node} {label : Nat} (active : Active ts e n) (role : label = n.owner ∨ label = n.mate) :
    Near r allow mark w e.a.owner label 4 ∧ Near r allow mark w e.b.owner label 4 := by
  obtain ⟨reach,recProof⟩ := active_owner cap ts e ok active
  have first := near_trans reach (role_near recProof role)
  exact ⟨near_mono first (by decide),near_trans (successor_joined cap ok).2 first⟩
end P455CertificateReach
end
section
namespace P455ContactLift
open Problem455.Slots P455Witness P455Paths
def Supplies (v : W) (h : Nat → W) (r x s : Nat) := v.count x = r ∧ s ∈ h x
noncomputable def donor (v : W) (h : Nat → W) (r s : Nat) : Nat := by
  classical
  exact if hs : ∃ x, Supplies v h r x s then hs.choose else 0
theorem factor_cap {v l k : W} {h : Nat → W} {r : Nat}
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) : P455Closure.Cap r (v.flatMap h) := by
  intro s; have hs := cap s; simp only [List.count_append] at hs; omega
theorem donor_eq {v h r x s} (hr : 0 < r) (cap : P455Closure.Cap r (v.flatMap h))
    (supply : Supplies v h r x s) : donor v h r s = x := by
  classical
  have existsDonor : ∃ y, Supplies v h r y s := ⟨x,supply⟩
  have other := existsDonor.choose_spec
  have used : existsDonor.choose ∈ v := List.count_pos_iff.mp (other.1.symm ▸ hr)
  have exc := (P455DonorInterval.exclusive h v x s r hr supply.1 supply.2 (cap s)).2.1
  unfold donor; rw [dif_pos existsDonor]
  exact Classical.byContradiction (fun ne => exc _ used ne other.2)
def Guard (r : Nat) (allow : Tag → Prop) (mark : Marking) (v : W) (seed J : Nat) : Prop :=
  ∀ x, Near r allow mark v seed x J → ∀ i, slotStart i →
    ∀ y, occupies v x i y → v.count y = r
theorem contact_step {r allow mark v h l k x s t} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (sup : Supplies v h r x s)
    (guard : ∀ i, slotStart i → ∀ y, occupies v x i y → v.count y = r)
    (c : ContactChoice) (hc : Holds r allow mark (l ++ v.flatMap h ++ k) (contact r s t c)) :
    let y := donor v h r t
    Supplies v h r y t ∧ x ≠ y ∧ Holds r allow mark v (contact r x y c) := by
  obtain ⟨i,slot,occ⟩ := P455ContactGeometry.contact_slot hc
  have ext := P455ContactGeometry.contact_excludes_image hr cap sup.1 sup.2 hc
  obtain ⟨y,_,ht,hy,ne⟩ := P455SlotOrigin.supplier v h l k x s t i r hr cap sup.1 sup.2 ext occ (guard i slot)
  have g : Supplies v h r y t := ⟨hy,ht⟩
  have refl := P455ContactReflection.reflect_contact hr cap sup.1 hy ne sup.2 ht c hc
  simpa only [donor_eq hr (factor_cap cap) g] using And.intro g (And.intro ne refl)
def relabel (d : Nat → Nat) (p : List Step) := p.map fun bc => (d bc.1,bc.2)
theorem endpoint_relabel (d : Nat → Nat) (s : Nat) (p : List Step) :
    endpoint (d s) (relabel d p) = d (endpoint s p) := by
  induction p generalizing s with
  | nil => rfl
  | cons head p ih => exact ih head.1
theorem transfer_from {r allow mark v h l k seed J} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (guard : Guard r allow mark v seed J)
    (s : Nat) (p : List Step) (n : Nat) (sup : Supplies v h r (donor v h r s) s)
    (near : Near r allow mark v seed (donor v h r s) n) (bound : n+p.length ≤ J)
    (walk : Walk r allow mark (l ++ v.flatMap h ++ k) s p) :
    Walk r allow mark v (donor v h r s) (relabel (donor v h r) p) ∧
    Supplies v h r (donor v h r (endpoint s p)) (endpoint s p) := by
  induction p generalizing n s with
  | nil => exact ⟨True.intro,sup⟩
  | cons bc rest ih =>
    obtain ⟨b,c⟩ := bc
    have len : n+1+rest.length ≤ J := by simpa [Nat.add_assoc,Nat.add_comm 1 rest.length] using bound
    have g := guard _ (near_mono near (by omega))
    obtain ⟨next,_,edge⟩ := contact_step hr cap sup g c walk.1
    have more := near_trans near (near_one c edge)
    obtain ⟨tail,last⟩ := ih b (n+1) next more len walk.2
    exact ⟨⟨edge,tail⟩,last⟩
theorem lift_walk {r allow mark v h l k s seed J} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (start : Supplies v h r seed s)
    (guard : Guard r allow mark v seed J) (p : List Step) (bound : p.length ≤ J)
    (walk : Walk r allow mark (l ++ v.flatMap h ++ k) s p) :
    Walk r allow mark v seed (relabel (donor v h r) p) ∧
    Supplies v h r (donor v h r (endpoint s p)) (endpoint s p) := by
  have eq := donor_eq hr (factor_cap cap) start
  simpa only [eq] using transfer_from hr cap guard s p 0 (eq.symm ▸ start)
    (eq.symm ▸ near_self seed 0) (by simpa using bound) walk
theorem lift_near {r allow mark v h l k s seed J a n} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (start : Supplies v h r seed s)
    (guard : Guard r allow mark v seed J) (bound : n ≤ J)
    (near : Near r allow mark (l ++ v.flatMap h ++ k) s a n) :
    Supplies v h r (donor v h r a) a ∧ Near r allow mark v seed (donor v h r a) n := by
  obtain ⟨p,w,ep,len⟩ := near
  obtain ⟨sw,sup⟩ := lift_walk hr cap start guard p (Nat.le_trans len bound) w
  rw [ep] at sup
  refine ⟨sup,relabel (donor v h r) p,sw,?_,by simpa [relabel] using len⟩
  have eq := donor_eq hr (factor_cap cap) start
  rw [← eq,endpoint_relabel,ep]
end P455ContactLift
end
section
namespace P455PortReflection
open Problem455.Slots P455Witness P455ContactReflection P455ContactGeometry
def roles (a : Node) : W := [a.owner,a.mate]
def sendNode (d : Nat → Nat) (a : Node) : Node := ⟨d a.owner,d a.mate,a.tag⟩
def UniformOn (r : Nat) (v : W) (h : Nat → W) (d : Nat → Nat) (xs : W) :=
  ∀ a ∈ xs, v.count (d a) = r ∧ a ∈ h (d a)
theorem holds_all {r allow mark w} (xs : List Query) :
    Holds r allow mark w (allQ xs) ↔ ∀ q ∈ xs, Holds r allow mark w q := by
  induction xs with
  | nil => simp [allQ,Holds]
  | cons q qs ih => simp only [allQ,Holds,ih,List.forall_mem_cons]
theorem earlyBefore_iff {r allow mark w} (xs ys : W) :
    Holds r allow mark w (earlyBefore xs ys) ↔
    ∀ a ∈ xs, ∀ b ∈ ys, Holds r allow mark w (earlier a 2 b 0) := by
  simp only [earlyBefore,holds_all,List.mem_flatMap,List.mem_map]
  constructor
  · intro h a ha b hb
    exact h _ ⟨a,ha,b,hb,rfl⟩
  · rintro h _ ⟨a,ha,b,hb,rfl⟩
    exact h a ha b hb
section Uniform
variable {r : Nat} {v l k : W} {h : Nat → W} {d : Nat → Nat}
    {allow : Tag → Prop} {mark : Marking}
theorem record_roles_distinct (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (a : Node) (uniform : UniformOn r v h d (roles a))
    (recProof : Holds r allow mark (l ++ v.flatMap h ++ k) (typedNode a)) :
    d a.owner ≠ d a.mate := by
  intro eq
  obtain ⟨hx,hs⟩ := uniform a.owner (by simp [roles])
  obtain ⟨_,ht⟩ := uniform a.mate (by simp [roles])
  have nc := contact_excludes_image hr cap hx hs
    (c := .record a.tag false) (b := a.mate) recProof
  exact nc (eq ▸ ht)
theorem reflect_typedNode (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (a : Node) (uniform : UniformOn r v h d (roles a))
    (recProof : Holds r allow mark (l ++ v.flatMap h ++ k) (typedNode a)) :
    Holds r allow mark v (typedNode (sendNode d a)) := by
  obtain ⟨hx,hs⟩ := uniform a.owner (by simp [roles])
  obtain ⟨hy,ht⟩ := uniform a.mate (by simp [roles])
  exact reflect_contact hr cap hx hy (record_roles_distinct hr cap a uniform recProof)
    hs ht (.record a.tag false) recProof
theorem reflect_markedNode (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (a : Node) (bit : Bool) (uniform : UniformOn r v h d (roles a)) (sourceMark : Marking)
    (marked : sourceMark (d a.owner) (d a.mate) ∨ sourceMark (d a.mate) (d a.owner))
    (recProof : Holds r allow mark (l ++ v.flatMap h ++ k) (markedNode a bit)) :
    Holds r allow sourceMark v (markedNode (sendNode d a) bit) := by
  obtain ⟨ne,len,code,_,eq⟩ := recProof
  have rec' : Holds r allow mark (l ++ v.flatMap h ++ k) (typedNode a) :=
    ⟨ne,len,code,bit,eq⟩
  obtain ⟨hx,hs⟩ := uniform a.owner (by simp [roles])
  obtain ⟨hy,ht⟩ := uniform a.mate (by simp [roles])
  have diff := record_roles_distinct hr cap a uniform rec'
  exact ⟨diff,len,code,marked,reflect_profile hr cap hx hy diff hs ht a.tag bit eq⟩
theorem port_injective (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (a b : Node) (phase : Nat) (uniform : UniformOn r v h d (roles a ++ roles b))
    (port : Holds r allow mark (l ++ v.flatMap h ++ k) (orientedPort phase a b)) :
    ∀ s ∈ roles a ++ roles b, ∀ t ∈ roles a ++ roles b, d s = d t → s = t := by
  have each (n : Node) (uni : UniformOn r v h d (roles n))
      (recProof : Holds r allow mark (l ++ v.flatMap h ++ k) (typedNode n)) :
      ∀ z ∈ roles n, ∀ t ∈ roles n, d z = d t → z = t := by
    have distinct := record_roles_distinct hr cap n uni recProof
    intro z hz t ht eq
    simp [roles] at hz ht
    rcases hz with rfl | rfl <;> rcases ht with rfl | rfl <;> simp_all
  have ua : UniformOn r v h d (roles a) := fun x hx => uniform x (by simp [hx])
  have ub : UniformOn r v h d (roles b) := fun x hx => uniform x (by simp [hx])
  have cross (s) (hs : s ∈ roles a) (t) (ht : t ∈ roles b) : d s ≠ d t := by
    intro eq
    obtain ⟨hx,sa⟩ := ua s hs
    obtain ⟨_,tb⟩ := ub t ht
    rw [← eq] at tb
    have early : Holds r allow mark (l ++ v.flatMap h ++ k) (earlyDisjoint (roles a) (roles b)) :=
      port.2.2.1
    rcases early with e | e
    · exact same_image_no_early hr cap hx sa tb (by decide : 0 < 2)
        (((earlyBefore_iff _ _).mp e s hs t ht).2)
    · exact same_image_no_early hr cap hx tb sa (by decide : 0 < 2)
        (((earlyBefore_iff _ _).mp e t ht s hs).2)
  intro s hs t ht eq
  rcases List.mem_append.mp hs with hs | hs <;> rcases List.mem_append.mp ht with ht | ht
  · exact each a ua port.1 s hs t ht eq
  · exact (cross s hs t ht eq).elim
  · exact (cross t ht s hs eq.symm).elim
  · exact each b ub port.2.1 s hs t ht eq
theorem port_owner_order (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (a b : Node) (phase : Nat) (uniform : UniformOn r v h d (roles a ++ roles b))
    (port : Holds r allow mark (l ++ v.flatMap h ++ k) (orientedPort phase a b))
    (pat : List Event) (inside : ∀ e ∈ pat, e.1 ∈ roles a ++ roles b)
    (order : Holds r allow mark (l ++ v.flatMap h ++ k) (.order pat)) :
    Holds r allow mark v (.order (pat.map (eventMap d))) :=
  reflect_order_query hr cap _ d uniform (port_injective hr cap a b phase uniform port)
    pat inside order
theorem reflect_port (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (a b : Node) (phase : Nat) (uniform : UniformOn r v h d (roles a ++ roles b))
    (port : Holds r allow mark (l ++ v.flatMap h ++ k) (orientedPort phase a b)) :
    Holds r allow mark v (orientedPort phase (sendNode d a) (sendNode d b)) := by
  have ua : UniformOn r v h d (roles a) := fun x hx => uniform x (by simp [hx])
  have ub : UniformOn r v h d (roles b) := fun x hx => uniform x (by simp [hx])
  have transfer := port_owner_order hr cap a b phase uniform port
  have early (xs ys : W) (within : ∀ z ∈ xs ++ ys, z ∈ roles a ++ roles b)
      (order : Holds r allow mark (l ++ v.flatMap h ++ k) (earlyBefore xs ys)) :
      Holds r allow mark v (earlyBefore (xs.map d) (ys.map d)) := by
    apply (earlyBefore_iff _ _).mpr
    intro u hu v' hv
    obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hu
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hv
    have pat := transfer [(i,2),(j,0)] (by
      intro e he
      simp only [List.mem_cons,List.not_mem_nil,or_false] at he
      rcases he with rfl | rfl
      · exact within i (by simp [hi])
      · exact within j (by simp [hj]))
      ((earlyBefore_iff _ _).mp order i hi j hj)
    simpa [eventMap,earlier] using pat
  refine ⟨reflect_typedNode hr cap a ua port.1,reflect_typedNode hr cap b ub port.2.1,?_,?_,True.intro⟩
  · rcases port.2.2.1 with e | e
    · exact Or.inl (early (roles a) (roles b) (fun _ hz => hz) e)
    · exact Or.inr (early (roles b) (roles a) (fun z hz => by simpa [or_comm] using hz) e)
  · let i := 3+2*phase
    have pat := transfer [(a.owner,i),(a.mate,i),(b.owner,i),(b.mate,i),
      (a.owner,i+1),(a.mate,i+1),(b.owner,i+1),(b.mate,i+1)] (by simp [roles]) port.2.2.2.1
    simpa [eventMap, sendNode, i] using pat
theorem reflect_rightward (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (ts : Tiles) (a b : Node) (uniform : UniformOn r v h d (roles a ++ roles b))
    (dir : Holds r allow mark (l ++ v.flatMap h ++ k) (rightward ts a b)) :
    Holds r allow mark v (rightward ts (sendNode d a) (sendNode d b)) := by
  have order := port_owner_order hr cap a b _ uniform dir.2.1
    [(a.owner,13+a.tag.length),(b.owner,13+a.tag.length)] (by simp [roles]) dir.2.2.1
  exact ⟨dir.1,reflect_port hr cap a b _ uniform dir.2.1,
    by simpa [sendNode,eventMap,earlier] using order,True.intro⟩
theorem reflect_downward (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (ts : Tiles) (a b : Node) (uniform : UniformOn r v h d (roles a ++ roles b))
    (dir : Holds r allow mark (l ++ v.flatMap h ++ k) (downward ts a b)) :
    Holds r allow mark v (downward ts (sendNode d a) (sendNode d b)) :=
  ⟨dir.1,reflect_port hr cap a b _ uniform dir.2⟩
theorem reflect_neighbor (hr : 0 < r) (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k))
    (ts : Tiles) (a b : Node) (dir : Dir) (uniform : UniformOn r v h d (roles a ++ roles b))
    (port : Holds r allow mark (l ++ v.flatMap h ++ k) (neighbor ts a b dir)) :
    Holds r allow mark v (neighbor ts (sendNode d a) (sendNode d b) dir) := by
  have rev : UniformOn r v h d (roles b ++ roles a) := fun x hx =>
    uniform x (by simpa [or_comm] using hx)
  cases dir
  · exact reflect_rightward hr cap ts a b uniform port
  · exact reflect_rightward hr cap ts b a rev port
  · exact reflect_downward hr cap ts a b uniform port
  · exact reflect_downward hr cap ts b a rev port
end Uniform
def markFree : Query → Bool
  | .markedBit .. => false
  | .both x y | .either x y => markFree x && markFree y
  | _ => true
theorem remark {r w allow} {src dst : Marking} {q : Query} (free : markFree q = true)
    (holds : Holds r allow src w q) : Holds r allow dst w q := by
  induction q with
  | fixed | count | deficient | record | order | slot | separate => exact holds
  | markedBit => cases free
  | both x y hx hy =>
    have both := Bool.and_eq_true_iff.mp free
    exact ⟨hx both.1 holds.1, hy both.2 holds.2⟩
  | either x y hx hy =>
    have both := Bool.and_eq_true_iff.mp free
    exact holds.elim (fun a => Or.inl (hx both.1 a)) (fun b => Or.inr (hy both.2 b))
theorem free_neighbor (ts : Tiles) (a b : Node) (dir : Dir) :
    markFree (neighbor ts a b dir) = true := by cases dir <;> rfl
theorem neighbor_remark {r w allow} {src dst : Marking} {ts a b dir}
    (holds : Holds r allow src w (neighbor ts a b dir)) : Holds r allow dst w (neighbor ts a b dir) :=
  remark (free_neighbor ts a b dir) holds
end P455PortReflection
end
section
namespace P455GraphPrim
open P455EffectiveQ P455RealizerGraph
variable {A B C : Type} [Primcodable A] [Primcodable B] [Primcodable C]
theorem filter {l : A → List B} {p : A → B → Bool}
    (hl : Primrec l) (hp : Primrec₂ p) : Primrec fun a => (l a).filter (p a) := by
  have k : Primrec₂ (fun a (x : B) => if p a x then some x else none) :=
    (Primrec.ite (show PrimrecPred (fun z : A×B => p z.1 z.2 = true) by
      simpa [PrimrecPred, Primrec₂] using hp) (Primrec.option_some.comp Primrec.snd) (.const none)).to₂
  apply (Primrec.listFilterMap hl k).of_eq
  intro a
  induction l a with
  | nil => rfl
  | cons b bs ih => cases h : p a b <;> simp [h,ih]
theorem join [DecidableEq B] : Primrec₂ (@joinAt B _) := by
  apply Primrec₂.mk
  apply Primrec.list_append.comp Primrec.snd
  apply Primrec.list_flatMap Primrec.snd
  apply Primrec₂.mk
  apply Primrec.ite (Primrec.eq.comp (Primrec.snd.comp Primrec.snd) (Primrec.fst.comp Primrec.fst))
  · apply Primrec.listFilterMap (Primrec.snd.comp Primrec.fst)
    apply Primrec₂.mk
    apply Primrec.ite (Primrec.eq.comp (Primrec.fst.comp Primrec.snd) (Primrec.fst.comp (Primrec.fst.comp Primrec.fst)))
    · exact Primrec.option_some.comp (Primrec.pair (Primrec.fst.comp (Primrec.snd.comp Primrec.fst))
        (Primrec.snd.comp Primrec.snd))
    · exact .const none
  · exact .const []
theorem graphFold [DecidableEq B] {p : A → List B} {s : A → List (B×B)}
    (hp : Primrec p) (hs : Primrec s) : Primrec fun a => (p a).foldr joinAt (s a) := by
  exact Primrec.list_foldr (h := fun _ (ks : B × List (B×B)) => joinAt ks.1 ks.2) hp hs
    (((join.comp Primrec.fst Primrec.snd).comp Primrec.snd).to₂)
theorem wordsUpTo : Primrec₂ (@Problem455Finite.wordsUpTo B) := by
  let step (l : List B) (x : Nat × List (List B)) :=
    [] :: l.flatMap (fun a => x.2.map (List.cons a))
  have steprec : Primrec₂ step := by
    apply Primrec₂.mk
    apply Primrec.list_cons.comp (.const [])
    apply Primrec.list_flatMap Primrec.fst
    apply Primrec₂.mk
    apply Primrec.list_map (Primrec.snd.comp (Primrec.snd.comp Primrec.fst))
    exact (Primrec.list_cons.comp (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂
  apply (Primrec.nat_rec (Primrec.const [[]]) steprec).of_eq
  intro l n
  induction n with
  | zero => rfl
  | succ n ih => simp [Problem455Finite.wordsUpTo,step,ih]
theorem wordPool : Primrec words := (wordsUpTo.comp Primrec.id Primrec.list_length)
theorem initialized [DecidableEq B] {e : A → B → B → Bool}
    (he : Primrec (fun x : A×(B×B) => e x.1 x.2.1 x.2.2))
    {d : A → List B} (hd : Primrec d) :
    Primrec fun a => initial (d a) (e a) := by
  apply Primrec.list_flatMap hd
  apply Primrec₂.mk
  apply Primrec.list_map
  · apply filter (hd.comp Primrec.fst)
    apply Primrec₂.mk
    apply Primrec.or.comp
    · have same : PrimrecPred (fun z : (A × B) × B => z.1.2 = z.2) :=
        (Primrec.eq (α := B)).comp (Primrec.snd.comp Primrec.fst) Primrec.snd
      classical
      exact same.decide
    · exact he.comp (Primrec.pair (Primrec.fst.comp Primrec.fst)
        (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd))
  · exact (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂
theorem contains [DecidableEq B] {v : A → B} {xs : A → List B}
    (hv : Primrec v) (hx : Primrec xs) : Primrec fun a => decide (v a∈xs a) := by
  apply ((Primrec.nat_lt.comp (Primrec.list_idxOf.comp hv hx) (Primrec.list_length.comp hx)).decide).of_eq
  intro a; simp [List.idxOf_lt_length_iff]
theorem reachable {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {u v : A → W} (hu : Primrec u) (hv : Primrec v) :
    Primrec fun a => walkB (e a) (u a) (v a) := by
  have piv := wordPool.comp hu
  have dom := Primrec.list_cons.comp hu (Primrec.list_cons.comp hv piv)
  exact (contains (hu.pair hv) (graphFold piv (initialized he dom))).of_eq (fun a => by
    rw [←walk_eq (e a) (u a) (v a)]
    apply Bool.eq_iff_iff.mpr
    simp only [walk,decide_eq_true_eq])
theorem anyB {l : A → List B} {p : A → B → Bool} (hl : Primrec l) (hp : Primrec₂ p) :
    Primrec fun a => (l a).any (p a) := by
  apply (Primrec.list_foldr hl (Primrec.const false)
    (Primrec.or.comp (hp.comp Primrec.fst (Primrec.fst.comp Primrec.snd))
       (Primrec.snd.comp Primrec.snd)).to₂).of_eq
  intro a
  induction l a with
  | nil => rfl
  | cons b bs ih => simp [ih]
theorem factor {u v : A → W} (hu : Primrec u) (hv : Primrec v) : Primrec fun a => factorB (u a) (v a) := by
  apply anyB (wordPool.comp hv)
  apply Primrec₂.mk
  apply anyB (wordPool.comp (hv.comp Primrec.fst))
  apply Primrec₂.mk
  exact (Primrec.eq.comp (hv.comp (Primrec.fst.comp Primrec.fst))
    (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.snd.comp Primrec.fst)
      (hu.comp (Primrec.fst.comp Primrec.fst))) Primrec.snd)).decide
theorem good {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {t u : A → W} (ht : Primrec t) (hu : Primrec u) :
    Primrec fun a => goodB (e a) (t a) (u a) := by
  apply anyB (wordPool.comp ht)
  apply Primrec₂.mk
  exact Primrec.and.comp
    (reachable (A := A × W) (e := fun p => e p.1) (he.comp (Primrec.pair (Primrec.fst.comp Primrec.fst) Primrec.snd))
      (ht.comp Primrec.fst) Primrec.snd)
    (factor (hu.comp Primrec.fst) Primrec.snd)
end P455GraphPrim
end
section
namespace P455MachineTable
open P455MachineLocal P455PaddedTiles
structure TM (g q : Nat) where
  marker : Fin g
  blank : Fin g
  blank_ne : blank≠marker
  start : Fin q
  accept : Fin q
  distinct : start≠accept
  delta : Fin q → Fin g → Ins (Fin g) (Fin q)
  keeps : ∀ z a,(delta z a).symbol = marker ↔ a = marker
  leftSafe : ∀ z,(delta z marker).dir≠.left
  stationary : delta accept marker=⟨accept,marker,.stay⟩
abbrev C (g q : Nat) := Cell (Fin g) (Fin q)
def headIndex (p : Option (Fin q)) : Nat := match p with | none => 0 | some x => x.val+1
def enc (c : C g q) : Fin (g*(q+1)) :=
  ⟨g*headIndex c.head+c.sym.val,by
    have v := c.sym.isLt
    have z : headIndex c.head ≤ q := by cases hh : c.head with
      | none => simp [headIndex]
      | some s => change s.val + 1 ≤ q; exact s.isLt
    have m := Nat.mul_le_mul_left g z
    rw [Nat.mul_add,Nat.mul_one]; omega⟩
def dec (M : TM g q) (x : Fin (g*(q+1))) : C g q :=
  let h := x.val/g
  let symbol := x.val%g
  let head := if e : 0 < h then some (⟨h-1,by
    have gr := M.marker.isLt
    have pos : 0 < g := by omega
    have div := (Nat.div_lt_iff_lt_mul pos).mpr (calc x.val < g*(q+1) := x.isLt
                                                     _ = _ := Nat.mul_comm ..)
    dsimp [h] at *; omega⟩ : Fin q) else none
  ⟨⟨symbol,Nat.mod_lt _ (by have := M.marker.isLt; omega)⟩,head⟩
theorem dec_enc (M : TM g q) (c : C g q) : dec M (enc c) = c := by
  obtain ⟨s,h⟩ := c
  have gpos : 0 < g := by have := s.isLt; omega
  cases h with
  | none => simp [dec,enc,headIndex,Nat.div_eq_of_lt s.isLt,Nat.mod_eq_of_lt s.isLt]
  | some p =>
    simp [dec,enc,headIndex,Nat.mul_add_div gpos,Nat.div_eq_of_lt s.isLt,Nat.mul_add_mod,Nat.mod_eq_of_lt s.isLt]
theorem enc_inj (M : TM g q) {a b : C g q} (e : enc a = enc b) : a = b := by
  simpa [dec_enc] using congrArg (dec M) e
def compile (M : TM g q) : MachineTable (g*(q+1)) where
  marker := fun v=>decide ((dec M v).sym = M.marker)
  initial := fun left=>if left then enc ⟨M.marker,some M.start⟩ else enc ⟨M.blank,none⟩
  accept := enc ⟨M.marker,some M.accept⟩
  distinct := by
    intro eq
    have h := congrArg Cell.head (enc_inj M eq)
    exact M.distinct (Option.some.inj h)
  next := fun l c r => (update M.delta (l.map (dec M)) (dec M c) (r.map (dec M))).map enc
structure Config (g q : Nat) where
  tape : Nat → Fin g
  pos : Nat
  state : Fin q
def init (M : TM g q) : Config g q := ⟨(fun i=>if i = 0 then M.marker else M.blank),0,M.start⟩
def step (M : TM g q) (c : Config g q) : Config g q :=
  let ins := M.delta c.state (c.tape c.pos)
  ⟨writeAt c.tape c.pos ins.symbol,dest ins.dir c.pos,ins.state⟩
def run (M : TM g q) : Nat → Config g q
  | 0 => init M
  | t+1 => step M (run M t)
def row (M : TM g q) (t x : Nat) := enc (atCell (run M t).tape (run M t).pos (run M t).state x)
theorem marker_iff (M : TM g q) (t x : Nat) : (run M t).tape x = M.marker ↔ x = 0 := by
  induction t with
  | zero => by_cases e : x = 0 <;> simp [run,init,e,M.blank_ne]
  | succ t ih =>
    change writeAt _ _ _ x = M.marker ↔ x = 0
    by_cases e : x = (run M t).pos
    · rw [writeAt,if_pos e,M.keeps,←e]; exact ih
    · simpa [writeAt,e] using ih
theorem head_bound (M : TM g q) (t : Nat) : (run M t).pos ≤ t := by
  induction t with
  | zero => exact Nat.le_refl _
  | succ t ih =>
    change dest (_ : Ins (Fin g) (Fin q)).dir (run M t).pos ≤ t+1
    cases d : (M.delta (run M t).state ((run M t).tape (run M t).pos)).dir <;>
      simp [dest] <;> omega
theorem physical_safe {t w : Nat} (M : TM g q) (wide : t+1 < w) :
    ¬ exits (M.delta (run M t).state ((run M t).tape (run M t).pos)).dir w (run M t).pos := by
  intro bad
  rcases bad with ⟨left,at0⟩|⟨_,edge⟩
  · rw [at0,(marker_iff M t 0).mpr rfl] at left
    exact M.leftSafe _ left
  · have := head_bound M t; omega
theorem left_dec (M : TM g q) (t x : Nat) :
    (leftAt (row M t) x).map (dec M) = leftOf (atCell (run M t).tape (run M t).pos (run M t).state) x := by
  by_cases e : x = 0 <;> simp [leftAt,leftOf,e,row,dec_enc]
theorem right_dec (M : TM g q) (t x w : Nat) :
    (rightAt (row M t) w x).map (dec M) = rightOf (atCell (run M t).tape (run M t).pos (run M t).state) w x := by
  by_cases e : x+1 = w <;> simp [rightAt,rightOf,e,row,dec_enc]
theorem local_value (M : TM g q) (t w x : Nat) (head : (run M t).pos < w)
    (safe : ¬exits (M.delta (run M t).state ((run M t).tape (run M t).pos)).dir w (run M t).pos)
    (hx : x < w) :
    (compile M).next (leftAt (row M t) x) (row M t x) (rightAt (row M t) w x) = some (row M (t+1) x) := by
  change (update M.delta _ (dec M (enc _)) _).map enc = _
  rw [left_dec,right_dec,dec_enc,local_step _ _ _ _ _ head safe _ hx]
  rfl
end P455MachineTable
end
section
namespace P455Retained
open Problem455.Slots P455Witness P455Paths P455ContactLift
structure Expansion (v : W) (e : Nat → W) (kept : Nat → Prop) : Prop where
  literal : ∀ x ∈ v, kept x → e x = [x]
  gaps : ∀ g ∈ v, ¬ kept g → v.count g = 1 ∧ e g ≠ [] ∧ ∀ a ∈ e g, ¬ kept a
theorem Expansion.select_eq {v e kept} (exp : Expansion v e kept)
    (s keep : W) (sub : ∀ a ∈ s, a ∈ v) (hk : ∀ a ∈ keep, kept a) :
    select keep (s.flatMap e) = select keep s := by
  induction s with
  | nil => rfl
  | cons x xs ih =>
    have hx := sub x (by simp)
    have rs := ih (fun a ha => sub a (by simp [ha]))
    change select keep (e x ++ xs.flatMap e) = select keep ([x] ++ xs)
    rw [select_append,select_append,rs]
    by_cases keep_x : kept x
    · rw [exp.literal x hx keep_x]
    · have gap := exp.gaps x hx keep_x
      rw [select_nil keep (e x) (fun a ha ab => gap.2.2 a ha (hk a ab))]
      have no : x ∉ keep := fun h => keep_x (hk x h)
      simp [select,no]
theorem Expansion.count_eq {v e kept} (exp : Expansion v e kept)
    (s : W) (sub : ∀ a ∈ s, a ∈ v) (x : Nat) (hx : kept x) :
    (s.flatMap e).count x = s.count x := by
  have h := congrArg (List.count x) (exp.select_eq s [x] sub (by simpa using hx))
  simpa [select] using h
theorem Expansion.small_cap {v e kept r} (exp : Expansion v e kept) (hr : 1 < r)
    (cap : P455Closure.Cap r (v.flatMap e)) : P455Closure.Cap r v := by
  intro x
  by_cases use : x ∈ v
  · by_cases k : kept x
    · rw [← exp.count_eq v (fun _ h => h) x k]; exact cap x
    · rw [(exp.gaps x use k).1]; omega
  · rw [List.count_eq_zero.mpr use]; omega
theorem contact_counts {r allow mark v x y c} (cap : P455Closure.Cap r v)
    (h : Holds r allow mark v (contact r x y c)) : v.count x = r ∧ v.count y = r := by
  cases c with
  | record tag rev =>
    cases rev
    · exact record_counts cap h
    · exact (record_counts cap h).symm
  | port phase rev => exact ⟨h.2.1,h.2.2.1⟩
theorem Expansion.contact {v e kept r allow mark x y} (exp : Expansion v e kept) (hr : 1 < r)
    (cap : P455Closure.Cap r (v.flatMap e)) (c : ContactChoice)
    (edge : Holds r allow mark v (P455Witness.contact r x y c)) :
    Holds r allow mark (v.flatMap e) (P455Witness.contact r x y c) := by
  obtain ⟨xc,yc⟩ := contact_counts (exp.small_cap hr cap) edge
  have used (a) (count : v.count a = r) : kept a := by
    apply Classical.byContradiction
    intro k
    have hm : a ∈ v := List.count_pos_iff.mp (by omega)
    have := (exp.gaps a hm k).1; omega
  have xx := used x xc
  have yy := used y yc
  have eq (a b) (ha : kept a) (hb : kept b) : select [a,b] (v.flatMap e) = select [a,b] v :=
    exp.select_eq v [a,b] (fun _ h => h) (by simpa using And.intro ha hb)
  have ord (pat : List Event) (inside : ∀ a ∈ pat, a.1 ∈ [x,y])
      (old : Holds r allow mark v (.order pat)) : Holds r allow mark (v.flatMap e) (.order pat) := by
    refine ⟨old.1, P455ContactReflection.select_sees [x,y] _ pat ?_⟩
    rw [eq x y xx yy]
    exact P455ContactReflection.sees_select _ _ _ inside old.2
  cases c with
  | record tag rev =>
    cases rev with
    | false =>
      obtain ⟨ne,len,tag,bit,hp⟩ := edge
      exact ⟨ne,len,tag,bit,(eq x y xx yy).trans hp⟩
    | true =>
      obtain ⟨ne,len,tag,bit,hp⟩ := edge
      exact ⟨ne,len,tag,bit,(eq y x yy xx).trans hp⟩
  | port port rev =>
    obtain ⟨ne,_,_,early,order,_⟩ := edge
    refine ⟨ne,(exp.count_eq _ (fun _ h => h) x xx).trans xc,
      (exp.count_eq _ (fun _ h => h) y yy).trans yc,?_,?_,True.intro⟩
    · rcases early with l|rr
      · exact .inl ⟨ord _ (by simp) l.1,True.intro⟩
      · exact .inr ⟨ord _ (by simp) rr.1,True.intro⟩
    · cases rev <;> exact ord _ (by simp) order
theorem Expansion.walk {v e kept r allow mark} (exp : Expansion v e kept) (hr : 1 < r)
    (cap : P455Closure.Cap r (v.flatMap e)) (s : Nat) (p : List Step)
    (walk : Walk r allow mark v s p) : Walk r allow mark (v.flatMap e) s p := by
  induction p generalizing s with
  | nil => exact True.intro
  | cons step ps ih => exact ⟨exp.contact hr cap step.2 walk.1, ih _ walk.2⟩
theorem Expansion.near {v e kept r allow mark} (exp : Expansion v e kept) (hr : 1 < r)
    (cap : P455Closure.Cap r (v.flatMap e)) {s t J : Nat} (near : Near r allow mark v s t J) :
    Near r allow mark (v.flatMap e) s t J := by
  obtain ⟨p,h,ep,le⟩ := near
  exact ⟨p,exp.walk hr cap s p h,ep,le⟩
theorem Expansion.in_original_slot {v e kept} (exp : Expansion v e kept) (x i y : Nat) (kx : kept x)
    (ho : occupies v x i y) (a : Nat) (ha : a ∈ e y) : occupies (v.flatMap e) x i a := by
  obtain ⟨j,hj⟩ := ho
  have hm : (x,i+1) ∈ events v := hj.mem (by simp)
  have bound : i+1 < v.count x := by simpa using (P455SlotOrigin.event_bounds (fun _ => 0) _ x _ hm).2
  obtain ⟨L,I,R,cut,idx,cons⟩ := P455SlotOrigin.slot_cut v x i bound
  have hy : y ∈ I := by
    apply (P455SlotOrigin.occupies_at_cut L I R x y cons).mp
    rw [←cut,idx]; exact ⟨j,hj⟩
  have hI : (I.flatMap e).count x = I.count x := exp.count_eq I (fun a h => by simp [cut,h]) x kx
  have fresh : x ∉ I.flatMap e := List.count_eq_zero.mp (hI.trans (List.count_eq_zero.mpr cons))
  have pref := exp.count_eq L (fun a h => by simp [cut,h]) x kx
  have ex := exp.literal x (by simp [cut]) kx
  have expanded : v.flatMap e =
      (L.flatMap e) ++ [x] ++ I.flatMap e ++ [x] ++ R.flatMap e := by
    simp [cut,ex,List.flatMap_append]
  rw [expanded,←idx,←pref]
  exact (P455SlotOrigin.occupies_at_cut _ _ _ _ _ fresh).mpr (List.mem_flatMap.mpr ⟨y,hy,ha⟩)
theorem Expansion.slot_guard {v e kept r} (exp : Expansion v e kept)
    (x i : Nat) (kx : kept x)
    (p455Original : ∀ a, occupies (v.flatMap e) x i a → kept a ∧ (v.flatMap e).count a = r) :
    ∀ y, occupies v x i y → v.count y = r := by
  intro y ho
  obtain ⟨j,obs⟩ := ho
  have used : y ∈ v := stamped_mem_label _ _ (y,j) (obs.mem (by simp))
  by_cases ky : kept y
  · have mem : y ∈ e y := by rw [exp.literal y used ky]; simp
    have claim := (p455Original y (exp.in_original_slot x i y kx ⟨j,obs⟩ y mem)).2
    exact (exp.count_eq v (fun _ h => h) y ky).symm.trans claim
  · have gap := exp.gaps y used ky
    obtain ⟨a,ha⟩ : ∃ a, a ∈ e y := by
      cases he : e y with
      | nil => exact (gap.2.1 he).elim
      | cons a rest => exact ⟨a,by simp⟩
    exact (gap.2.2 a ha (p455Original a (exp.in_original_slot x i y kx ⟨j,obs⟩ a ha)).1).elim
theorem Expansion.guard {v e kept r allow mark seed J} (exp : Expansion v e kept)
    (hr : 1 < r) (cap : P455Closure.Cap r (v.flatMap e))
    (p455Original : ∀ x, Near r allow mark (v.flatMap e) seed x J →
      kept x ∧ ∀ i, slotStart i → ∀ y, occupies (v.flatMap e) x i y →
        kept y ∧ (v.flatMap e).count y = r) :
    Guard r allow mark v seed J := by
  intro x near i hi
  obtain ⟨kx,slots⟩ := p455Original x (exp.near hr cap near)
  exact exp.slot_guard x i kx (slots i hi)
end P455Retained
end
section
namespace P455SourceFamilies
open P455Witness P455Paths P455ContactLift P455PortReflection Problem455.Slots
def markNode (a : Node) : Marking := fun x y => x = a.owner ∧ y = a.mate
def picked (s : SlotCertificate) := if s.startAtMate then s.anchor.mate else s.anchor.owner
def sendDefect (d : Nat → Nat) : SlotDefect → SlotDefect
  | .deficient a => .deficient (d a)
  | .overflow xs => .overflow (xs.map d)
def sendSlot (d : Nat → Nat) (s : SlotCertificate) : SlotCertificate :=
  { s with anchor := sendNode d s.anchor, steps := relabel d s.steps, defect := sendDefect d s.defect }
def sendFunc (d : Nat → Nat) (f : FunctionalityCertificate) : FunctionalityCertificate :=
  { f with anchor := sendNode d f.anchor, b := sendNode d f.b, c := sendNode d f.c }
def Compressed (r : Nat) (v : W) := ∀ a b, ¬ Problem455Swap.Link r v a b
theorem compressed_separates {r v} (cmp : Compressed r v) {a b : Nat} (ne : a ≠ b) :
    ¬ Problem455Swap.SameBlock r v a b := by
  intro same
  have joined := same.2.2
  cases joined with
  | refl => exact ne rfl
  | extend _ adj => rcases adj with f|b <;> exact cmp _ _ (by assumption)
private theorem remark_contact {r allow mark src w a b} (c : ContactChoice)
    (obs : V r allow mark w (contact r a b c)) : V r allow src w (contact r a b c) := by
  apply remark _ obs
  cases c with
  | record tag rev => cases rev <;> rfl
  | port phase rev => rfl
theorem remark_walk {r allow mark src w} (a : Nat) (p : List Step)
    (h : Walk r allow mark w a p) : Walk r allow src w a p := by
  induction p generalizing a with
  | nil => exact True.intro
  | cons pair p ih => exact ⟨remark_contact pair.2 h.1,ih pair.1 h.2⟩
theorem valid_slot {r allow mark w o i} (d : SlotDefect)
    (q : V r allow mark w (terminalSlot r o i d)) : slotStart i := by
  cases d with
  | deficient a => exact q.1.1
  | overflow xs =>
    cases xs with
    | nil => have h : ([] : List Nat).length = 5 := q.1; contradiction
    | cons a _ => exact q.2.2.1.1.2.1
theorem rebuild_terminal_in {r v u h x i} (d : Nat → Nat) (a : SlotDefect)
    (slot : slotStart i) (cmp : Compressed r u)
    (unique : ∀ {a y}, Supplies v h r y a → d a = y)
    (inside : ∀ y, occupies v x i y → v.count y = r → occupies u x i y ∧ u.count y = r)
    {allow mark} (lifted : P455TerminalTransfer.Lift v h x i r a) :
    Holds r allow mark u (terminalSlot r x i (sendDefect d a)) := by
  cases a with
  | deficient s => exact lifted.elim
  | overflow xs =>
    obtain ⟨f,len,nd,spec⟩ := lifted
    have eq (a : Nat) (inxs : a∈xs) : d a = f a :=
      unique ⟨(spec a inxs).2.2,(spec a inxs).2.1⟩
    have maps : xs.map d = xs.map f := List.map_congr_left eq
    have bs : (x :: xs.map d).Pairwise (fun a b => ¬ Problem455Swap.SameBlock r u a b) := by
      rw [maps]; exact nd.imp (fun ne => compressed_separates cmp ne)
    refine ⟨by simpa [P455Witness.Holds] using len,(P455TerminalTransfer.block_separation _).mpr bs,?_,True.intro⟩
    apply (allQ_iff _).mpr
    intro q hq
    obtain ⟨z,hz,rfl⟩ := List.mem_map.mp hq
    obtain ⟨a,ha,rfl⟩ := List.mem_map.mp hz
    have sp := spec a ha
    have out := inside (f a) sp.1 sp.2.2
    exact eq a ha ▸ And.intro out.2 (And.intro slot out.1)
theorem rebuild_terminal {r v h x i} (d : Nat → Nat) (a : SlotDefect)
    (slot : slotStart i) (cmp : Compressed r v)
    (unique : ∀ {a y}, Supplies v h r y a → d a = y)
    {allow mark} (lifted : P455TerminalTransfer.Lift v h x i r a) :
    Holds r allow mark v (terminalSlot r x i (sendDefect d a)) :=
  rebuild_terminal_in d a slot cmp unique (fun _ o cnt => ⟨o,cnt⟩) lifted
def SlotResult (r : Nat) (allow : Tag → Prop) (v : W) (h : Nat → W) (seed : Nat)
    (s : SlotCertificate) : Prop :=
  let d := donor v h r
  let s' := sendSlot d s
  let m := markNode s'.anchor
  Holds r allow m v (markedNode s'.anchor s.bit) ∧
  Walk r allow m v seed s'.steps ∧
  P455TerminalTransfer.Lift v h (d (endpoint (picked s) s.steps)) s.terminalIndex r s.defect ∧
  (Compressed r v → Holds r allow m v (s'.query r))
theorem slot_source {r allow mark v h l k seed} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (s : SlotCertificate)
    (ok : V r allow mark (l ++ v.flatMap h ++ k) (s.query r))
    (start : Supplies v h r seed (picked s)) (guard : Guard r allow mark v seed 6) :
    SlotResult r allow v h seed s := by
  let d := donor v h r
  let m := markNode (sendNode d s.anchor)
  have seedEq : d (picked s) = seed := donor_eq hr (factor_cap cap) start
  have anch : V r allow mark (l ++ v.flatMap h ++ k) (markedNode s.anchor s.bit) := ok.1
  have ports := record_pair (marked_typed anch)
  have rolesU : UniformOn r v h d (roles s.anchor) := by
    intro u mem
    have links : Near r allow mark (l ++ v.flatMap h ++ k) (picked s) u 1 := by
      rcases (show u = s.anchor.owner ∨ u = s.anchor.mate by simpa [roles] using mem) with rfl|rfl
      · cases z : s.startAtMate <;> simp only [picked,z,Bool.false_eq_true,if_false,if_true]
        · exact near_self _ _
        · exact ports.2
      · cases z : s.startAtMate <;> simp only [picked,z,Bool.false_eq_true,if_false,if_true]
        · exact ports.1
        · exact near_self _ _
    exact (lift_near hr cap start guard (by decide : 1 ≤ 6) links).1
  have bit := reflect_markedNode hr cap s.anchor s.bit rolesU m (.inl ⟨rfl,rfl⟩) anch
  obtain ⟨len,outputWalk,terminal⟩ := slot_route s ok
  have walks := lift_walk hr cap start guard s.steps len outputWalk
  let endLabel := endpoint (picked s) s.steps
  have ext : Near r allow mark (l ++ v.flatMap h ++ k) (picked s) endLabel 6 :=
    ⟨s.steps,outputWalk,rfl,len⟩
  obtain ⟨en,towards⟩ := lift_near hr cap start guard (Nat.le_refl _) ext
  have slot := valid_slot s.defect terminal
  have g := guard (d endLabel) towards s.terminalIndex slot
  have lf := P455TerminalTransfer.terminal v h l k (d endLabel) endLabel s.terminalIndex r
    hr cap en.1 en.2 g s.defect terminal
  have sw : Walk r allow m v seed (relabel d s.steps) := remark_walk _ _ walks.1
  refine ⟨bit,sw,lf,?_⟩
  intro cmp
  have term : V r allow m v (terminalSlot r (d endLabel) s.terminalIndex (sendDefect d s.defect)) :=
    rebuild_terminal d s.defect slot cmp (fun hh => donor_eq hr (factor_cap cap) hh) lf
  have pickEq : picked (sendSlot d s) = d (picked s) := by
    cases z : s.startAtMate <;> simp [picked,sendSlot,sendNode,z]
  refine ⟨bit,by simpa [sendSlot,relabel,P455Witness.Holds] using len,?_,True.intro⟩
  apply (route_iff ..).mpr
  change Walk r allow m v (picked (sendSlot d s)) (relabel d s.steps) ∧
    V r allow m v (terminalSlot r (endpoint (picked (sendSlot d s)) (relabel d s.steps))
        s.terminalIndex (sendDefect d s.defect))
  rw [pickEq,endpoint_relabel]
  exact ⟨seedEq.symm ▸ sw,term⟩
def roleOf (b : Bool) (n : Node) := if b then n.mate else n.owner
def FuncResult (r : Nat) (allow : Tag → Prop) (ts : Tiles) (v : W) (h : Nat → W)
    (f : FunctionalityCertificate) : Prop :=
  let f' := sendFunc (donor v h r) f
  let m := markNode f'.anchor
  Holds r allow m v (markedNode f'.anchor f'.bit) ∧
  Holds r allow m v (neighbor ts f'.anchor f'.b f'.dir) ∧
  Holds r allow m v (neighbor ts f'.anchor f'.c f'.dir) ∧
  roleOf f'.distinguishMate f'.b ≠ roleOf f'.distinguishMate f'.c ∧
  (Compressed r v → Holds r allow m v (f'.query ts))
theorem functionality_source {r allow mark v h l k seed} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (ts : Tiles) (f : FunctionalityCertificate)
    (ok : V r allow mark (l ++ v.flatMap h ++ k) (f.query ts))
    (start : Supplies v h r seed f.anchor.owner) (guard : Guard r allow mark v seed 6) :
    FuncResult r allow ts v h f := by
  let d := donor v h r
  let m := markNode (sendNode d f.anchor)
  have supplies (n : Node) (use : n = f.anchor ∨ n = f.b ∨ n = f.c) : UniformOn r v h d (roles n) := by
    intro a ha
    have reach := P455CertificateReach.functionality_reach cap ts f ok use
      (show a = n.owner ∨ a = n.mate by simpa [roles] using ha)
    exact (lift_near hr cap start guard (by decide : 2 ≤ 6) reach).1
  have union (n : Node) (use : n = f.anchor ∨ n = f.b ∨ n = f.c) :
      UniformOn r v h d (roles f.anchor ++ roles n) := by
    intro a ha
    rcases List.mem_append.mp ha with h1|h2
    · exact supplies _ (.inl rfl) _ h1
    · exact supplies n use _ h2
  have bit := reflect_markedNode hr cap f.anchor f.bit (supplies _ (.inl rfl)) m (.inl ⟨rfl,rfl⟩) ok.1
  have b := neighbor_remark (dst := m) (reflect_neighbor hr cap ts f.anchor f.b f.dir (union _ (.inr (.inl rfl))) ok.2.1)
  have c := neighbor_remark (dst := m) (reflect_neighbor hr cap ts f.anchor f.c f.dir (union _ (.inr (.inr rfl))) ok.2.2.1)
  have rb (n : Node) : roleOf f.distinguishMate n ∈ roles n := by
    cases e : f.distinguishMate <;> simp [roleOf,roles,e]
  have sb := supplies f.b (.inr (.inl rfl)) _ (rb f.b)
  have sc := supplies f.c (.inr (.inr rfl)) _ (rb f.c)
  have neat : d (roleOf f.distinguishMate f.b) ≠ d (roleOf f.distinguishMate f.c) := by
    intro eq
    have same := Problem455SameDonor.sameDonor v h _ sb.1 (factor_cap cap) _ _ sb.2 (eq.symm ▸ sc.2)
    apply ok.2.2.2.1
    exact Problem455Swap.sameBlock_factor ⟨l,k,rfl⟩
      (fun a => by rw [Problem455BlockBridge.occ_count]; exact cap a) same
  have mapped (n : Node) : roleOf f.distinguishMate (sendNode d n) = d (roleOf f.distinguishMate n) := by
    cases f.distinguishMate <;> rfl
  have neq : roleOf f.distinguishMate (sendNode d f.b) ≠ roleOf f.distinguishMate (sendNode d f.c) := by
    simpa only [mapped] using neat
  exact ⟨bit,b,c,neq,fun cmp => ⟨bit,b,c,compressed_separates cmp neq,True.intro⟩⟩
end P455SourceFamilies
end
section
namespace P455EdgeSource
open P455Witness P455Paths P455CertificateReach P455PortReflection P455ContactReflection
open P455ContactLift
def sendEdge (d : Nat → Nat) (e : EdgeCertificate) : EdgeCertificate :=
  ⟨sendNode d e.a, sendNode d e.b, sendNode d e.right, sendNode d e.left,
    sendNode d e.down, sendNode d e.up, sendNode d e.diagonal⟩
def endpointMarks (d : Nat → Nat) (e : EdgeCertificate) (s t : Nat) : Prop :=
  (s = d e.a.owner ∧ t = d e.a.mate) ∨ (s = d e.b.owner ∧ t = d e.b.mate)
private theorem when_true {r allow mark w b q} (f : b = true → Holds r allow mark w q) :
    Holds r allow mark w (flagQ b q) := by
  cases b
  · exact True.intro
  · exact f rfl
private theorem read_guard {r allow mark w b q} (hb : b = true)
    (f : Holds r allow mark w (flagQ b q)) : Holds r allow mark w q := by simpa [flagQ,hb] using f
theorem endpoint_port {r allow mark w} (ts : Tiles) (e : EdgeCertificate)
    (ok : Holds r allow mark w (e.query ts)) :
    ∃ p, Holds r allow mark w (orientedPort p e.a e.b) ∨
         Holds r allow mark w (orientedPort p e.b e.a) := by
  have lc := ok.2.2.1
  have succ := ok.2.2.2.1
  unfold chosenSuccessor at succ
  dsimp only at succ
  split at succ
  next ret => exact ⟨4,succ.2.1⟩
  next noReturn =>
    have eq := succ.1
    cases row : endOfRow ts e.a with
    | true =>
      have down : ts.bottom e.a.tag = false := by simpa [row] using noReturn
      have target : e.down = e.b := by simpa [row,P455Witness.Holds] using eq
      have ok := read_guard (by simp [down]) lc.2.2.1
      exact ⟨_,.inl (target ▸ ok.2)⟩
    | false =>
      cases odd : ts.oddRow e.a.tag with
      | true =>
        have left : ts.left e.a.tag = false := by simpa [endOfRow,odd] using row
        have target : e.left = e.b := by simpa [row,odd,P455Witness.Holds] using eq
        have ok := read_guard (by simp [left]) lc.2.1
        exact ⟨_,.inr (target ▸ ok.2.1)⟩
      | false =>
        have right : ts.right e.a.tag = false := by simpa [endOfRow,odd] using row
        have target : e.right = e.b := by simpa [row,odd,P455Witness.Holds] using eq
        have ok := read_guard (by simp [right]) lc.1
        exact ⟨_,.inl (target ▸ ok.2.1)⟩
theorem edge_source {r allow mark v h l k d} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (ts : Tiles) (e : EdgeCertificate)
    (supply : ∀ n, Active ts e n → UniformOn r v h d (roles n))
    (ok : Holds r allow mark (l ++ v.flatMap h ++ k) (e.query ts)) :
    Holds r allow (endpointMarks d e) v ((sendEdge d e).query ts) := by
  have both {n m} (an : Active ts e n) (am : Active ts e m) :
      UniformOn r v h d (roles n ++ roles m) := by
    intro y hy
    rcases List.mem_append.mp hy with h|h
    · exact supply n an y h
    · exact supply m am y h
  have localRight (rr : ts.right e.a.tag = false) :=
    read_guard (by simp [rr]) ok.2.2.1.1
  have localLeft (ll : ts.left e.a.tag = false) :=
    read_guard (by simp [ll]) ok.2.2.1.2.1
  have localDown (dd : ts.bottom e.a.tag = false) :=
    read_guard (by simp [dd]) ok.2.2.1.2.2.1
  have localUp (uu : ts.top e.a.tag = false) :=
    read_guard (by simp [uu]) ok.2.2.1.2.2.2.1
  have localSq (rr : ts.right e.a.tag = false) (dd : ts.bottom e.a.tag = false) :=
    read_guard (by simp [rr,dd]) ok.2.2.1.2.2.2.2.1
  have hs : Holds r allow (endpointMarks d e) v (localCert ts (sendEdge d e)) := by
    refine ⟨when_true (fun b => ?_),when_true (fun b => ?_),when_true (fun b => ?_),
            when_true (fun b => ?_),when_true (fun b => ?_),True.intro⟩
    · have rr : ts.right e.a.tag = false := by simpa [sendEdge,sendNode] using b
      exact reflect_rightward hr cap ts _ _ (both .anchor (.right rr)) (localRight rr)
    · have ll : ts.left e.a.tag = false := by simpa [sendEdge,sendNode] using b
      exact reflect_rightward hr cap ts _ _ (both (.left ll) .anchor) (localLeft ll)
    · have dd : ts.bottom e.a.tag = false := by simpa [sendEdge,sendNode] using b
      exact reflect_downward hr cap ts _ _ (both .anchor (.down dd)) (localDown dd)
    · have uu : ts.top e.a.tag = false := by simpa [sendEdge,sendNode] using b
      exact reflect_downward hr cap ts _ _ (both (.up uu) .anchor) (localUp uu)
    · obtain ⟨rr,dd⟩ : ts.right e.a.tag = false ∧ ts.bottom e.a.tag = false := by
        simpa [sendEdge,sendNode] using b
      exact ⟨reflect_downward hr cap ts _ _ (both (.right rr) (.diagonal rr dd)) (localSq rr dd).1,
             reflect_rightward hr cap ts _ _ (both (.down dd) (.diagonal rr dd)) (localSq rr dd).2⟩
  have aBit := reflect_markedNode hr cap e.a true (supply _ .anchor) (endpointMarks d e)
    (Or.inl (Or.inl ⟨rfl,rfl⟩)) ok.1
  have bBit := reflect_markedNode hr cap e.b false (supply _ .successor) (endpointMarks d e)
    (Or.inl (Or.inr ⟨rfl,rfl⟩)) ok.2.1
  refine ⟨aBit,bBit,hs,?_,True.intro⟩
  have rel (pat) (mem : ∀ u ∈ pat, u.1 ∈ roles e.a ++ roles e.b) (ord :
      Holds r allow mark (l ++ v.flatMap h ++ k) (.order pat)) :
      Holds r allow mark v (.order (pat.map (eventMap d))) := by
    obtain ⟨p,forward|back⟩ := endpoint_port ts e ok
    · exact port_owner_order hr cap _ _ p (both .anchor .successor) forward pat mem ord
    · exact port_owner_order hr cap _ _ p (both .successor .anchor) back pat
        (fun u hu => by have := mem u hu; simpa [or_comm] using this) ord
  have suc := ok.2.2.2.1
  unfold chosenSuccessor at suc ⊢
  dsimp only [sendEdge,sendNode] at suc ⊢
  change Holds r allow _ v (if endOfRow ts e.a && ts.bottom e.a.tag then _ else _)
  split at suc
  next ret =>
    rw [if_pos ret]
    have ord := rel [(e.b.owner,0),(e.a.owner,0)] (by simp [roles]) suc.2.2.1
    refine ⟨suc.1,?_,ord,True.intro⟩
    rcases suc.2.1 with f|b
    · exact .inl (reflect_port hr cap _ _ _ (both .anchor .successor) f)
    · exact .inr (reflect_port hr cap _ _ _ (both .successor .anchor) b)
  next noReturn =>
    rw [if_neg noReturn]
    have ord := rel [(e.a.owner,0),(e.b.owner,0)] (by simp [roles]) suc.2
    refine ⟨?_,ord⟩
    change (if endOfRow ts e.a then sendNode d e.down else
      if ts.oddRow e.a.tag then sendNode d e.left else sendNode d e.right) = sendNode d e.b
    have eq := suc.1
    cases row : endOfRow ts e.a <;> cases parity : ts.oddRow e.a.tag <;>
      simp only [row,parity,Bool.false_eq_true,if_false,if_true] at eq ⊢ <;>
      exact congrArg (sendNode d) eq
theorem edge_source_of_seed {r allow mark v h l k seed J} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (ts : Tiles) (e : EdgeCertificate)
    (ok : Holds r allow mark (l ++ v.flatMap h ++ k) (e.query ts))
    (startAtSecond : Bool)
    (start : Supplies v h r seed (if startAtSecond then e.b.owner else e.a.owner))
    (guard : Guard r allow mark v seed J) (budget : 4 ≤ J) :
    Holds r allow (endpointMarks (donor v h r) e) v ((sendEdge (donor v h r) e).query ts) := by
  apply edge_source hr cap ts e _ ok
  intro n active y hy
  have role : y = n.owner ∨ y = n.mate := by simpa [roles] using hy
  obtain ⟨a,b⟩ := edge_reach cap ts e ok active role
  have near : Near r allow mark (l ++ v.flatMap h ++ k)
      (if startAtSecond then e.b.owner else e.a.owner) y 4 := by cases startAtSecond <;> assumption
  exact (lift_near hr cap start guard budget near).1
theorem edge_source_from_role {r allow mark v h l k seed J} (hr : 0 < r)
    (cap : P455Closure.Cap r (l ++ v.flatMap h ++ k)) (ts : Tiles) (e : EdgeCertificate)
    (ok : Holds r allow mark (l ++ v.flatMap h ++ k) (e.query ts))
    (atSecond atMate : Bool)
    (start : let a := if atSecond then e.b else e.a
             Supplies v h r seed (if atMate then a.mate else a.owner))
    (guard : Guard r allow mark v seed J) (budget : (if atMate then 5 else 4) ≤ J) :
    Holds r allow (endpointMarks (donor v h r) e) v ((sendEdge (donor v h r) e).query ts) := by
  cases atMate with
  | false =>
    cases atSecond
    · exact edge_source_of_seed hr cap ts e ok false start guard budget
    · exact edge_source_of_seed hr cap ts e ok true start guard budget
  | true =>
    apply edge_source hr cap ts e _ ok
    intro n active y hy
    have role : y = n.owner ∨ y = n.mate := by simpa [roles] using hy
    obtain ⟨a,b⟩ := edge_reach cap ts e ok active role
    cases atSecond
    · have step := (record_pair (marked_typed ok.1)).2
      exact (lift_near hr cap start guard budget (near_trans step a)).1
    · have step := (record_pair (marked_typed ok.2.1)).2
      exact (lift_near hr cap start guard budget (near_trans step b)).1
end P455EdgeSource
end
section
namespace P455ClassPrim
open P455EffectiveQ P455GraphPrim
variable {A : Type} [Primcodable A]
abbrev Raw := Option W
theorem live {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {T : A → W} {z : A → Raw} (ht : Primrec T) (hz : Primrec z) :
    Primrec fun a => liveB (e a) (T a) (z a) := by
  let h (a : A) (w : W) := goodB (e a) (T a) w
  have recProof : Primrec₂ h :=
    Primrec₂.mk (good (A := A × W) (e := fun q => e q.1)
      (he.comp (Primrec.pair (Primrec.fst.comp Primrec.fst) Primrec.snd))
      (ht.comp Primrec.fst) Primrec.snd)
  exact (Primrec.option_casesOn hz (Primrec.const false) recProof).of_eq
    (fun a => by cases z a <;> rfl)
theorem pairedRec {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {T : A → W} {x y : A → Raw} (ht : Primrec T) (hx : Primrec x) (hy : Primrec y) :
    Primrec fun a => paired (e a) (T a) (x a) (y a) := by
  let inside (a : A) (u v : W) := goodB (e a) (T a) u && goodB (e a) (T a) v && walkB (e a) u v
  have ep : Primrec (fun p : ((A×W)×W)×(W×W) => e p.1.1.1 p.2.1 p.2.2) :=
    he.comp (Primrec.pair (Primrec.fst.comp (Primrec.fst.comp Primrec.fst)) Primrec.snd)
  have rr : Primrec (fun p : (A×W)×W => inside p.1.1 p.1.2 p.2) :=
    Primrec.and.comp (Primrec.and.comp
      (good (A := (A×W)×W) (e := fun p => e p.1.1) ep (ht.comp (Primrec.fst.comp Primrec.fst))
        (Primrec.snd.comp Primrec.fst))
      (good (A := (A×W)×W) (e := fun p => e p.1.1) ep (ht.comp (Primrec.fst.comp Primrec.fst)) Primrec.snd))
      (reachable (A := (A×W)×W) (e := fun p => e p.1.1) ep (Primrec.snd.comp Primrec.fst) Primrec.snd)
  let tail (a : A) (u : W) : Bool := Option.casesOn (y a) false (inside a u)
  have tr : Primrec₂ tail := Primrec₂.mk
    (Primrec.option_casesOn (hy.comp Primrec.fst) (Primrec.const false) rr.to₂)
  exact (Primrec.option_casesOn hx (Primrec.const false) tr).of_eq
    (fun a => by cases x a <;> cases h : y a <;> simp [tail,inside,h,paired])
theorem relation {e : A → W → W → Bool} (he : Primrec (fun x : A×(W×W) => e x.1 x.2.1 x.2.2))
    {T : A → W} {x y : A → Raw} (ht : Primrec T) (hx : Primrec x) (hy : Primrec y) :
    Primrec fun a => relB (e a) (T a) (x a) (y a) :=
  Primrec.or.comp (Primrec.and.comp (Primrec.not.comp (live he ht hx)) (Primrec.not.comp (live he ht hy)))
    (pairedRec he ht hx hy)
end P455ClassPrim
end
section
namespace P455FramePrim
open P455Closure P455EffectiveQ P455GraphPrim
abbrev Tag := List Bool
abbrev Marks := List (Nat×Nat)
abbrev PairList := List (List Nat×Bool)
abbrev FrameData := Nat × W × W × Nat × Tag × PairList × W × W × W
def packing : Frame Nat ≃ FrameData where
  toFun f := (f.pHead,f.pTail,f.qInit,f.qLast,f.tag,f.middle,f.beforeMutable,f.beforeFinalP,f.beforeFinalQ)
  invFun d := ⟨d.1,d.2.1,d.2.2.1,d.2.2.2.1,d.2.2.2.2.1,d.2.2.2.2.2.1,d.2.2.2.2.2.2.1,
    d.2.2.2.2.2.2.2.1,d.2.2.2.2.2.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
instance framePrimcodable : Primcodable (Frame Nat) := Primcodable.ofEquiv _ packing
theorem pack : Primrec packing := Primrec.of_equiv
theorem unpack : Primrec packing.symm := Primrec.of_equiv_symm
variable {A B C : Type} [Primcodable A] [Primcodable B] [Primcodable C]
theorem allB {l : A → List B} {p : A → B → Bool} (hl : Primrec l) (hp : Primrec₂ p) :
    Primrec fun a => (l a).all (p a) := by
  apply (Primrec.not.comp (anyB hl (Primrec.not.comp₂ hp))).of_eq
  intro a; simp only [List.not_any_eq_all_not,Bool.not_not]
theorem countN {z : A → Nat} {l : A → W} (hz : Primrec z) (hl : Primrec l) :
    Primrec fun a => (l a).count (z a) := by
  apply (Primrec.list_length.comp (P455GraphPrim.filter hl
    ((Primrec.beq.comp Primrec.snd (hz.comp Primrec.fst)).to₂))).of_eq
  intro a
  simp [List.count_eq_countP,List.countP_eq_length_filter,BEq.comm]
theorem nodup {l : A → W} (hl : Primrec l) : Primrec fun a => decide (l a).Nodup := by
  apply (allB hl ((Primrec.eq.comp (countN Primrec.snd (hl.comp Primrec.fst)) (.const 1)).decide.to₂)).of_eq
  intro a
  apply Bool.eq_iff_iff.mpr
  simp only [List.all_eq_true,decide_eq_true_eq,List.nodup_iff_count_eq_one]
theorem singleton {v : A → B} (hv : Primrec v) : Primrec fun a => [v a] := Primrec.list_cons.comp hv (.const [])
theorem pairs : Primrec phasePair :=
  Primrec.list_cons.comp Primrec.id (singleton Primrec.not)
theorem phases : Primrec fixedPhases :=
  Primrec.list_append.comp (Primrec.list_append.comp (.const _) (Primrec.list_flatMap Primrec.id (pairs.comp₂ .right))) (.const _)
theorem pHead : Primrec (@Frame.pHead Nat) := (Primrec.fst.comp pack)
theorem pTail : Primrec (@Frame.pTail Nat) := (Primrec.fst.comp (Primrec.snd.comp pack))
theorem qInit : Primrec (@Frame.qInit Nat) := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp pack)))
theorem qLast : Primrec (@Frame.qLast Nat) := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp pack))))
theorem tag : Primrec (@Frame.tag Nat) := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp pack)))))
theorem middle : Primrec (@Frame.middle Nat) := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp pack))))))
theorem beforeMutable : Primrec (@Frame.beforeMutable Nat) := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp pack)))))))
theorem beforeFinalP : Primrec (@Frame.beforeFinalP Nat) := (Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp pack))))))))
theorem beforeFinalQ : Primrec (@Frame.beforeFinalQ Nat) := (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp pack))))))))
theorem p : Primrec (@Frame.p Nat) := Primrec.list_cons.comp pHead pTail
theorem q : Primrec (@Frame.q Nat) := Primrec.list_append.comp qInit (singleton qLast)
theorem early : Primrec (@Frame.early Nat) :=
  Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp
    (Primrec.list_append.comp p p) q) p) q) q
theorem mid : Primrec (@Frame.mid Nat) := Primrec.list_flatMap middle <| Primrec₂.mk <|
  Primrec.list_append.comp (Primrec.fst.comp Primrec.snd)
    (Primrec.ite (Primrec.eq.comp (Primrec.snd.comp Primrec.snd) (.const true))
       (q.comp Primrec.fst) (p.comp Primrec.fst))
theorem pairCore : Primrec₂ (@Frame.pair Nat) := Primrec₂.mk <|
  Primrec.ite (Primrec.eq.comp Primrec.snd (.const true))
    (Primrec.list_append.comp (q.comp Primrec.fst) (p.comp Primrec.fst))
    (Primrec.list_append.comp (p.comp Primrec.fst) (q.comp Primrec.fst))
theorem core : Primrec₂ (@Frame.core Nat) := Primrec₂.mk <|
  (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.list_append.comp (early.comp Primrec.fst) (mid.comp Primrec.fst)) (beforeMutable.comp Primrec.fst)) (pairCore.comp Primrec.fst Primrec.snd)) (beforeFinalP.comp Primrec.fst)) (p.comp Primrec.fst)) (beforeFinalQ.comp Primrec.fst)) (q.comp Primrec.fst))
end P455FramePrim
end
