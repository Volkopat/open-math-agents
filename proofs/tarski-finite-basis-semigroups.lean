namespace P455WriterObservations
open Problem455.Slots P455WriterProfiles
variable {A X : Type} [Primcodable A] [Primcodable X]
theorem selectRec {k w : A → List Nat} (hk : Primrec k) (hw : Primrec w) :
    Primrec fun a => select (k a) (w a) :=
  P455GraphPrim.filter hw ((P455CataloguePrim.mem'.comp Primrec.snd (hk.comp Primrec.fst)).decide.to₂)
def bump (a : Nat) (p : Event) : Event := (p.1, p.2 + if p.1 = a then 1 else 0)
theorem stamp_add (n f : Nat → Nat) (w : W) :
    stamp (fun i => n i + f i) w = (stamp n w).map (fun p => (p.1,p.2+f p.1)) := by
  induction w generalizing n with
  | nil => rfl
  | cons a w ih =>
    simp only [stamp,List.map_cons,List.cons.injEq,true_and]
    have eq : advance (fun i => n i+f i) [a] = fun i => advance n [a] i+f i := by
      funext i
      change (n i+f i)+[a].count i = (n i+[a].count i)+f i
      omega
    rw [eq,ih]
theorem events_cons (a : Nat) (w : W) : events (a::w) = (a,0)::(events w).map (bump a) := by
  unfold events
  simp only [stamp,List.cons.injEq,true_and]
  have eq : advance (fun _ => 0) [a] = fun i : Nat => 0+(if i = a then 1 else 0) := by
    funext i
    by_cases h : i = a <;> simp [advance,h,Ne.symm,BEq.comm]
  rw [eq,stamp_add]
  rfl
theorem eventsRec : Primrec events := by
  let h (_ : W) (p : Nat × List Event) := (p.1,0)::p.2.map (bump p.1)
  have hh : Primrec₂ h := by
    apply Primrec₂.mk
    apply Primrec.list_cons.comp (Primrec.pair (Primrec.fst.comp Primrec.snd) (.const 0))
    apply Primrec.list_map (Primrec.snd.comp Primrec.snd)
    apply Primrec₂.mk
    have letter := Primrec.fst.comp (Primrec.snd (α := (W×(Nat×List Event))) (β := Event))
    exact Primrec.pair letter (Primrec.nat_add.comp (Primrec.snd.comp Primrec.snd)
      (Primrec.ite (Primrec.eq.comp letter (Primrec.fst.comp (Primrec.snd.comp Primrec.fst))) (.const 1) (.const 0)))
  apply (Primrec.list_foldr (h:=h) (Primrec.id (α:=W)) (Primrec.const ([] : List Event)) hh).of_eq
  intro w
  induction w with
  | nil => rfl
  | cons a w ih =>
    rw [events_cons]
    exact congrArg (fun tail => (a,0)::tail.map (bump a)) ih
def subsequences (l : List X) :=
  l.foldr (fun x s => s ++ s.map (List.cons x)) [[]]
theorem mem_subsequences {α : Type} (s t : List α) : s∈subsequences t ↔ s.Sublist t := by
  induction t generalizing s with
  | nil => simp [subsequences]
  | cons a l ih =>
    change s∈subsequences l ++ (subsequences l).map (List.cons a) ↔ _
    simp only [List.mem_append,List.mem_map,ih,List.sublist_cons_iff]
    tauto
theorem subsequencesRec : Primrec (@subsequences X) := by
  let h (_ : List X) (p : X×List (List X)) := p.2 ++ p.2.map (List.cons p.1)
  apply Primrec.list_foldr (h:=h) (Primrec.id (α:=List X)) (Primrec.const [[]])
  apply Primrec₂.mk
  exact Primrec.list_append.comp (Primrec.snd.comp Primrec.snd)
    (Primrec.list_map (Primrec.snd.comp Primrec.snd)
      (Primrec.list_cons.comp (Primrec.fst.comp (Primrec.snd.comp Primrec.fst)) Primrec.snd).to₂)
theorem seesRec {w : A → W} {t : A → List Event} (hw : Primrec w) (ht : Primrec t) :
    Primrec fun x => decide (sees (w x) (t x)) := by
  have v := P455GraphPrim.anyB (subsequencesRec.comp (eventsRec.comp hw))
    ((Primrec.eq.comp (ht.comp (Primrec.fst (β := List Event))) Primrec.snd).decide.to₂)
  apply Primrec.of_eq v
  intro a
  apply Bool.eq_iff_iff.mpr
  simp [List.any_eq_true,sees,mem_subsequences]
  exact decide_eq_true_iff.symm
theorem bigramRec {w : A → W} {x y : A → Nat} (hw : Primrec w) (hx : Primrec x) (hy : Primrec y) :
    Primrec fun a => Problem455Swap.bigram (x a) (y a) (w a) := by
  let h (a : A) (p : Nat×W×Nat) :=
    Problem455Swap.hit (x a) (y a) (some p.1) p.2.1.head? + p.2.2
  have hh : Primrec₂ h := by
    apply Primrec₂.mk
    apply Primrec.nat_add.comp _ (Primrec.snd.comp (Primrec.snd.comp Primrec.snd))
    apply Primrec.ite _ (.const 1) (.const 0)
    exact PrimrecPred.and
      (Primrec.eq.comp (Primrec.option_some.comp (Primrec.fst.comp Primrec.snd)) (Primrec.option_some.comp (hx.comp Primrec.fst)))
      (Primrec.eq.comp (Primrec.list_head?.comp (Primrec.fst.comp (Primrec.snd.comp Primrec.snd))) (Primrec.option_some.comp (hy.comp Primrec.fst)))
  apply (Primrec.list_rec hw (.const 0) hh).of_eq
  intro a
  induction w a with
  | nil => rfl
  | cons b t ih => exact congrArg (fun acc => h a (b,t,acc)) ih
end P455WriterObservations
end
section
namespace P455WriterBinary
open P455PaddedTiles P455WriterTiles P455WriterProfiles
abbrev Key := Nat × Bool
abbrev words (r : Nat) : List (List Nat) := Problem455Finite.wordsUpTo [0,1] (2*r)
def atKey (r i : Nat) := (words r)[i]?.getD []
def key (i : P455BinaryProduct.Index r allow) : Key := (i.num.val,i.prof)
theorem key_inj : Function.Injective (@key r allow) := by
  rintro ⟨a,b,_,_⟩ ⟨c,d,_,_⟩ e
  change (a.val,b) = (c.val,d) at e
  obtain ⟨h,rfl⟩ := Prod.mk.inj e
  cases Fin.ext h
  rfl
def tests (r : Nat) (ts : Tags) (w : W) (prof : Bool) :=
  P455EffectiveQMove.capB r w &&
    decide (w = P455FirstTesters.power r ∨ 0 < w.count 0 ∧ 0 < w.count 1) &&
    decide (prof = isProfile r ts w)
def filtered (r : Nat) (ts : Tags) : List Key :=
  (choices (List.range (words r).length) [false,true]).filter (fun k => tests r ts (atKey r k.1) k.2)
def spec (r : Nat) (k : Key) : P455Packed.Spec :=
  (atKey r k.1, if k.2 then some [] else none)
def bin (r : Nat) (ts : Tags) := (P455Table.distinct (filtered r ts)).map (spec r)
theorem getAt (r : Nat) (i : Fin (words r).length) : atKey r i.val = (words r).get i := by
  simp [atKey,i.isLt]
theorem valid (M : MachineTable n) (r ts) (tEq : ts = P455Enum.tags M) (w : W) (b : Bool) :
    tests r ts w b = true ↔ P455Closure.Cap r w ∧
      (w = P455FirstTesters.power r ∨ 0 < w.count 0 ∧ 0 < w.count 1) ∧
      (b = true ↔ P455BinaryEquality.IsProfile r (allowed M) w) := by
  subst ts
  simp only [tests,Bool.and_eq_true,decide_eq_true_eq,P455EffectiveQMove.cap_iff,
    ←P455WriterProfiles.correct M r w,and_assoc]
  cases b <;> cases isProfile r (P455Enum.tags M) w <;> simp
private theorem attachKeys {n : Nat} (xs : List (Fin n × Bool)) :
    xs.attach.map (fun x => (x.val.1.val,x.val.2)) = xs.map (fun x => (x.1.val,x.2)) :=
  @List.attach_map_val (Fin n × Bool) Key xs (fun x => (x.1.val,x.2))
theorem raw_keys {n} (M : MachineTable n) (r : Nat) :
    (P455Enum.binary r M).list.map key = filtered r (P455Enum.tags M) := by
  let X := Fin (words r).length × Bool
  let K : X → Key := fun x => (x.1.val,x.2)
  let xs := choices (P455Enum.fins (words r).length).list P455Enum.bools.list
  have order : xs.map K = choices (List.range (words r).length) [false,true] := by
    unfold xs K
    rw [←p455MapFinRange]
    simp only [choices,P455Enum.fins,P455Enum.bools,List.map_flatMap,List.map_map,List.flatMap_map,Function.comp_def]
  unfold filtered
  rw [←order,List.filter_map]
  unfold P455Enum.binary
  simp only [P455Enum.Cover.map,P455Enum.coverSub,P455Enum.selectSub,List.map_map,Function.comp_def,key]
  rw [attachKeys]
  apply congrArg (List.map K)
  apply List.filter_congr
  intro a _
  apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq]
  rw [valid M r _ rfl]
  rw [show atKey r a.1.val = (words r).get a.1 from getAt r a.1]
theorem bin_correct (M : MachineTable n) (r : Nat) :
    bin r (P455Enum.tags M) = P455Packed.names (P455Encoded.useCover (P455Enum.binary r M)) P455Packed.binSpec := by
  unfold bin
  rw [←raw_keys,←P455CataloguePrim.map_distinct key key_inj,List.map_map]
  unfold P455Packed.names P455Encoded.useCover
  apply List.map_congr_left
  intro i _
  change (atKey r i.num.val,_) = _
  exact congrArg (fun w => (w, _)) (getAt r i.num)
variable {A : Type} [Primcodable A]
theorem wordsRec : Primrec words :=
  P455GraphPrim.wordsUpTo.comp (.const [0,1]) (Primrec.nat_mul.comp (.const 2) Primrec.id)
theorem atKeyRec : Primrec₂ atKey :=
  Primrec.option_getD.comp (Primrec.list_getElem?.comp (wordsRec.comp Primrec.fst) Primrec.snd) (.const [])
theorem testsRec {r : A → Nat} {ts : A → Tags} {w : A → W} {b : A → Bool}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) (hb : Primrec b) :
    Primrec fun a => tests (r a) (ts a) (w a) (b a) := by
  exact Primrec.and.comp (Primrec.and.comp (P455FrameProof.capCheck hr hw)
    (PrimrecPred.or (Primrec.eq.comp hw (replicateRec hr (.const 0)))
      (PrimrecPred.and (Primrec.nat_lt.comp (.const 0) (P455CataloguePrim.count'.comp hw (.const 0)))
        (Primrec.nat_lt.comp (.const 0) (P455CataloguePrim.count'.comp hw (.const 1))))).decide)
    (Primrec.eq.comp hb (isProfileRec hr ht hw)).decide
theorem binRec {r : A → Nat} {ts : A → Tags} (hr : Primrec r) (ht : Primrec ts) :
    Primrec fun a => bin (r a) (ts a) := by
  have hg := choicesRec (Primrec.list_range.comp (Primrec.list_length.comp (wordsRec.comp hr))) (.const [false,true])
  have k := Primrec.snd (α := A) (β := Key)
  have ha := Primrec.fst (α := A) (β := Key)
  have w := atKeyRec.comp (hr.comp ha) (Primrec.fst.comp k)
  have b := Primrec.snd.comp k
  have ft : Primrec₂ (fun a (k : Key) => tests (r a) (ts a) (atKey (r a) k.1) k.2) :=
    testsRec (hr.comp ha) (ht.comp ha) w b
  have f : Primrec (fun a => filtered (r a) (ts a)) := P455GraphPrim.filter hg ft
  exact Primrec.list_map (P455CataloguePrim.distinct'.comp f)
    (Primrec.pair w (Primrec.ite (Primrec.eq.comp b (.const true)) (.const (some [])) (.const none))).to₂
end P455WriterBinary
end
section
namespace P455WriterProgram.Cert
open Primrec
variable {X : Type} [Primcodable X]
theorem unpack' {ng k : X → Nat} (hg : Primrec ng) (hk : Primrec k) : Primrec fun x => unpack (ng x) (k x) := by
  have s := Primrec.nat_sub.comp hk (Primrec.const 1)
  have u := Primrec.nat_div.comp s (Primrec.const 3)
  exact (Primrec.nat_div.comp u hg).pair ((Primrec.nat_mod.comp u hg).pair (Primrec.nat_mod.comp s (Primrec.const 3)))
theorem normalized' {m : X → Raw} {z a : X → Nat} (hm : Primrec m) (hz : Primrec z) (ha : Primrec a) :
    Primrec (fun x => normalizedIns (m x) (z x) (a x)) := by
  have ng := g'.comp hm
  have nq := q'.comp hm
  have k := (Primrec.list_getD 0).comp (entries'.comp hm) (Primrec.nat_add.comp (Primrec.nat_mul.comp hz ng) ha)
  exact Primrec.ite (Primrec.nat_lt.comp hz nq)
    (Primrec.ite (Primrec.eq.comp k (Primrec.const 0)) (nq.pair (ha.pair (Primrec.const 1))) (unpack' ng k))
    (Primrec.ite ((Primrec.eq.comp hz nq).and ((Primrec.eq.comp ha (marker'.comp hm)).not))
      (nq.pair (ha.pair (Primrec.const 0))) ((Primrec.nat_add.comp nq (Primrec.const 1)).pair (ha.pair (Primrec.const 1))))
theorem act' {m : X → Raw} {v : X → Nat} (hm : Primrec m) (hv : Primrec v) :
    Primrec (fun x => act (m x) (v x)) := by
  have ng := g'.comp hm
  have h := Primrec.nat_div.comp hv ng
  exact Primrec.ite (Primrec.nat_lt.comp (Primrec.const 0) h)
    (Primrec.option_some.comp (normalized' hm (Primrec.nat_sub.comp h (Primrec.const 1)) (Primrec.nat_mod.comp hv ng)))
    (Primrec.const none)
theorem send' {ng a d : X → Nat} {i : X → Triple} (hg : Primrec ng) (ha : Primrec a) (hd : Primrec d) (hi : Primrec i) :
    Primrec (fun x => send (ng x) (a x) (d x) (i x)) :=
  Primrec.nat_add.comp (Primrec.nat_mul.comp hg (Primrec.ite
    (Primrec.eq.comp (Primrec.snd.comp (Primrec.snd.comp hi)) hd)
    (Primrec.nat_add.comp (Primrec.fst.comp hi) (Primrec.const 1)) (Primrec.const 0))) ha
def route (ng sym : Nat) (left right : Bool) (l c r : Option Triple) : Option Nat :=
  if l = none ∧ c = none ∧ r = none then some sym
  else if l≠none ∧ c = none ∧ r = none then some (send ng sym 2 (l.getD (0,0,0)))
  else if l = none ∧ c = none ∧ r≠none then some (send ng sym 0 (r.getD (0,0,0)))
  else if l = none ∧ c≠none ∧ r = none then
    let i := c.getD (0,0,0)
    if (i.2.2 = 0 ∧ left = true) ∨ (i.2.2 = 2 ∧ right = true) then none else some (send ng i.2.1 1 i)
  else none
theorem route_eq (n a : Nat) (b f : Bool) (l c r : Option Triple) :
    route n a b f l c r = output n a b f l c r := by cases l <;> cases c <;> cases r <;> rfl
theorem output' {ng a : X → Nat} {bl br : X → Bool} {l c r : X → Option Triple}
    (hg : Primrec ng) (ha : Primrec a) (hb : Primrec bl) (hf : Primrec br) (hl : Primrec l) (hc : Primrec c) (hr : Primrec r) :
    Primrec fun x => output (ng x) (a x) (bl x) (br x) (l x) (c x) (r x) := by
  have L := Primrec.eq.comp hl (Primrec.const none)
  have C := Primrec.eq.comp hc (Primrec.const none)
  have R := Primrec.eq.comp hr (Primrec.const none)
  have i := Primrec.option_getD.comp hc (Primrec.const (0,0,0))
  have D := Primrec.snd.comp (Primrec.snd.comp i)
  have rule : Primrec (fun x => route (ng x) (a x) (bl x) (br x) (l x) (c x) (r x)) :=
    Primrec.ite (L.and (C.and R)) (Primrec.option_some.comp ha) (Primrec.ite (L.not.and (C.and R))
    (Primrec.option_some.comp (send' hg ha (Primrec.const 2) (Primrec.option_getD.comp hl (Primrec.const (0,0,0)))))
    (Primrec.ite (L.and (C.and R.not))
    (Primrec.option_some.comp (send' hg ha (Primrec.const 0) (Primrec.option_getD.comp hr (Primrec.const (0,0,0)))))
    (Primrec.ite (L.and (C.not.and R)) (Primrec.ite
    (((Primrec.eq.comp D (Primrec.const 0)).and (Primrec.eq.comp hb (Primrec.const true))).or
    ((Primrec.eq.comp D (Primrec.const 2)).and (Primrec.eq.comp hf (Primrec.const true)))) (Primrec.const none)
    (Primrec.option_some.comp (send' hg (Primrec.fst.comp (Primrec.snd.comp i)) (Primrec.const 1) i))) (Primrec.const none))))
  exact rule.of_eq (fun _ => route_eq ..)
theorem isNone' {A : Type} [Primcodable A] : Primrec (@Option.isNone A) :=
  (Primrec.not.comp Primrec.option_isSome).of_eq fun o => by cases o <;> rfl
theorem localValue' {m : X → Raw} {l r : X → Option Nat} {c : X → Nat} (hm : Primrec m) (hl : Primrec l)
    (hc : Primrec c) (hr : Primrec r) : Primrec fun x => localValue (m x) (l x) (c x) (r x) :=
  output' (g'.comp hm) (Primrec.nat_mod.comp hc (g'.comp hm)) (isNone'.comp hl) (isNone'.comp hr)
    (Primrec.option_bind hl (act' (hm.comp Primrec.fst) Primrec.snd).to₂) (act' hm hc)
    (Primrec.option_bind hr (act' (hm.comp Primrec.fst) Primrec.snd).to₂)
theorem dimension' : Primrec dimension := Primrec.nat_mul.comp g'
  (Primrec.nat_add.comp (Primrec.nat_add.comp q' (Primrec.const 2)) (Primrec.const 1))
theorem neighbour' : Primrec neighbour := Primrec.ite (Primrec.eq.comp Primrec.id (Primrec.const 0))
  (Primrec.const none) (Primrec.option_some.comp (Primrec.nat_sub.comp Primrec.id (Primrec.const 1)))
theorem line' {m : X → Raw} {n l c : X → Nat} (hm : Primrec m) (hn : Primrec n) (hl : Primrec l) (hc : Primrec c) :
    Primrec fun x => line (m x) (n x) (l x) (c x) :=
  Primrec.list_map (Primrec.list_range.comp (Primrec.nat_add.comp hn (Primrec.const 1)))
  (localValue' (hm.comp Primrec.fst) (neighbour'.comp (hl.comp Primrec.fst)) (hc.comp Primrec.fst) (neighbour'.comp Primrec.snd)).to₂
theorem slab' {m : X → Raw} {n l : X → Nat} (hm : Primrec m) (hn : Primrec n) (hl : Primrec l) :
    Primrec fun x => slab (m x) (n x) (l x) :=
  Primrec.list_flatMap (Primrec.list_range.comp hn) (line' (hm.comp Primrec.fst) (hn.comp Primrec.fst) (hl.comp Primrec.fst) Primrec.snd).to₂
theorem grid' {m : X → Raw} {n : X → Nat} (hm : Primrec m) (hn : Primrec n) : Primrec fun x => grid (m x) (n x) :=
  Primrec.list_flatMap (Primrec.list_range.comp (Primrec.nat_add.comp hn (Primrec.const 1)))
  (slab' (hm.comp Primrec.fst) (hn.comp Primrec.fst) Primrec.snd).to₂
theorem machineData' : Primrec machineData := by
  have mark := Primrec.eq.comp (Primrec.nat_mod.comp (Primrec.snd (α:=Raw) (β:=Nat)) (g'.comp Primrec.fst)) (marker'.comp Primrec.fst)
  exact dimension'.pair ((Primrec.list_map (Primrec.list_range.comp dimension') mark.decide.to₂).pair (blank'.pair
    ((Primrec.nat_add.comp (Primrec.nat_mul.comp g' (Primrec.nat_add.comp start' (Primrec.const 1))) marker').pair
    ((Primrec.nat_add.comp (Primrec.nat_mul.comp g' (Primrec.nat_add.comp (Primrec.nat_add.comp q' (Primrec.const 1)) (Primrec.const 1))) marker').pair
    (grid' Primrec.id dimension')))))
theorem fromBits' : Primrec fromBits := machineData'.comp blankRaw'
end P455WriterProgram.Cert
end
section
namespace P455TableValidate
open P455Table P455TableSemantics
def rows (T : Matrix) := T.all fun row => decide (row.length = T.length) && row.all fun x => decide (x < T.length)
def assocB (T : Matrix) := (List.range T.length).all fun i => (List.range T.length).all fun j =>
  (List.range T.length).all fun k => decide (entry T (entry T i j) k = entry T i (entry T j k))
def unitB (T : Matrix) := (List.range T.length).any fun i => (List.range T.length).all fun j =>
  decide (entry T i j = j) && decide (entry T j i = j)
def valid (T : Matrix) := decide (0 < T.length) && rows T && assocB T && unitB T
def safe (T : Matrix) : Matrix := if valid T then T else [[0]]
theorem correct (T : Matrix) : valid T = true ↔ SemigroupTable T ∧ HasUnit T := by
  simp only [valid,SemigroupTable,HasUnit,rows,assocB,unitB,Bool.and_eq_true,decide_eq_true_eq,
    List.all_eq_true,List.any_eq_true,List.mem_range]
  constructor
  · rintro ⟨⟨⟨ne,r⟩,assoc⟩,u⟩; exact ⟨⟨ne,r,fun i j k hi hj hk => assoc i hi j hj k hk⟩,u⟩
  · rintro ⟨⟨ne,r,assoc⟩,u⟩; exact ⟨⟨⟨ne,r⟩,fun i hi j hj k hk => assoc i j k hi hj hk⟩,u⟩
theorem identity {T} (good : SemigroupTable T ∧ HasUnit T) : safe T = T := by simp [safe,(correct _).mpr good]
theorem monoid (T) : SemigroupTable (safe T) ∧ HasUnit (safe T) := by
  unfold safe; split
  next h => exact (correct _).mp h
  next => exact (correct _).mp (by decide)
theorem rowsRec : Primrec rows := by
  unfold rows
  apply P455FramePrim.allB Primrec.id
  apply Primrec₂.mk
  apply Primrec.and.comp (Primrec.eq.comp (Primrec.list_length.comp Primrec.snd)
    (Primrec.list_length.comp Primrec.fst)).decide
  apply P455FramePrim.allB Primrec.snd
  apply Primrec₂.mk
  exact (Primrec.nat_lt.comp Primrec.snd (Primrec.list_length.comp (Primrec.fst.comp Primrec.fst))).decide
theorem assocRec : Primrec assocB := by
  unfold assocB
  have n : Primrec fun T : Matrix => List.range T.length := Primrec.list_range.comp Primrec.list_length
  apply P455FramePrim.allB n
  apply Primrec₂.mk
  apply P455FramePrim.allB (n.comp Primrec.fst)
  apply Primrec₂.mk
  apply P455FramePrim.allB (n.comp (Primrec.fst.comp Primrec.fst))
  apply Primrec₂.mk
  refine (Primrec.eq.comp ?_ ?_).decide
  · apply P455NumericProductPrim.entry' ((Primrec.fst.comp Primrec.fst).comp Primrec.fst) _ Primrec.snd
    exact P455NumericProductPrim.entry' ((Primrec.fst.comp Primrec.fst).comp Primrec.fst)
      ((Primrec.snd.comp Primrec.fst).comp Primrec.fst) (Primrec.snd.comp Primrec.fst)
  · apply P455NumericProductPrim.entry' ((Primrec.fst.comp Primrec.fst).comp Primrec.fst)
      ((Primrec.snd.comp Primrec.fst).comp Primrec.fst)
    exact P455NumericProductPrim.entry' ((Primrec.fst.comp Primrec.fst).comp Primrec.fst) (Primrec.snd.comp Primrec.fst) Primrec.snd
theorem unitRec : Primrec unitB := by
  unfold unitB
  have n : Primrec fun T : Matrix => List.range T.length := Primrec.list_range.comp Primrec.list_length
  apply P455GraphPrim.anyB n
  apply Primrec₂.mk
  apply P455FramePrim.allB (n.comp Primrec.fst)
  apply Primrec₂.mk
  exact Primrec.and.comp (Primrec.eq.comp (P455NumericProductPrim.entry' (Primrec.fst.comp Primrec.fst)
    (Primrec.snd.comp Primrec.fst) Primrec.snd) Primrec.snd).decide (Primrec.eq.comp
    (P455NumericProductPrim.entry' (Primrec.fst.comp Primrec.fst) Primrec.snd (Primrec.snd.comp Primrec.fst)) Primrec.snd).decide
theorem validRec : Primrec valid :=
  Primrec.and.comp (Primrec.and.comp (Primrec.and.comp
    (Primrec.nat_lt.comp (Primrec.const 0) Primrec.list_length).decide rowsRec) assocRec) unitRec
theorem safeRec : Primrec safe :=
  Primrec.ite (Primrec.eq.comp validRec (Primrec.const true)) Primrec.id (Primrec.const [[0]])
end P455TableValidate
end
section
namespace P455BooleanReader
open P455MachineLocal P455MachineTable P455MachineCleanup P455EffectiveMachine
open P455EffectiveChain P455RelabeledChain P455Table P455TableSemantics
def delta (q a : Fin 4) : Option (Ins (Fin 4) (Fin 4)) :=
  if q = 0 then some ⟨1,a,.right⟩
  else if q = 1 then some ⟨if a = 3 then 3 else 2,a,.stay⟩ else none
def reader : Ordinary 4 4 where
  marker := 0
  blank := 1
  blank_ne := by decide
  start := 0
  delta := delta
  keeps := by
    intro s a i h
    unfold delta at h
    split at h
    · cases h; rfl
    · split at h
      · cases h; rfl
      · contradiction
  leftSafe := by
    intro s i h
    unfold delta at h
    split at h
    · cases h; decide
    · split at h
      · cases h; decide
      · contradiction
def bits : Alphabet reader where
  bit b := if b then 3 else 2
  ink b := by cases b <;> decide
  away b := by cases b <;> decide
  distinct := by decide
def ans (q : Fin 4) := decide (q = 3)
theorem reads_bit (b : Bool) : Answers reader bits ans [b] b := by
  cases b <;> exact ⟨2,rfl,rfl⟩
end P455BooleanReader
end
section
namespace P455StatementAudit
open P455Table P455TableSemantics P455BinaryTerms P455BinaryBasis P455PureSemigroup
def product (T : Matrix) (valid : SemigroupTable T) (a b : Fin T.length) : Fin T.length :=
  ⟨entry T a b,entry_lt valid a.isLt b.isLt⟩
def val {T : Matrix} (ok : SemigroupTable T) (f : Nat → Fin T.length) : Term → Fin T.length
  | .var x => f x
  | .mul s t => product T ok (val ok f s) (val ok f t)
theorem eval_fin {T : Matrix} (ok : SemigroupTable T) (f : Nat → Fin T.length) (s : Term) :
    (val ok f s).val = eval T (fun x => (f x).val) s := by
  induction s <;> simp_all [val,eval,product]
theorem assignments {T : Matrix} (ok : SemigroupTable T) (s t : Term) :
    ValidTerm T s t ↔ ∀ f : Nat → Fin T.length, val ok f s = val ok f t := by
  constructor
  · intro all f
    apply Fin.ext
    rw [eval_fin,eval_fin]
    exact all _ (fun x => (f x).isLt)
  · intro h f bounded
    let g (i : Nat) : Fin T.length := ⟨f i,bounded i⟩
    simpa only [eval_fin,g] using congrArg Fin.val (h g)
theorem substitution {T : Matrix} (ok : SemigroupTable T) (g : Nat → Term)
    (f : Nat → Fin T.length) (s : Term) :
    val ok f (inst g s) = val ok (fun x => val ok f (g x)) s := by
  induction s <;> simp_all [inst,val]
theorem soundness {T : Matrix} (ok : SemigroupTable T) {G : Term → Term → Prop}
    (laws : ∀ {a b}, G a b → ValidTerm T a b) {s t} (p : Equational G s t) :
    ValidTerm T s t := by
  apply (assignments ok _ _).mpr
  induction p with
  | refl => exact fun _ => rfl
  | gen h => exact (assignments ok _ _).mp (laws h)
  | symm _ ih => exact fun f => (ih f).symm
  | trans _ _ ih ik => exact fun f => (ih f).trans (ik f)
  | mul _ _ ih ik => intro f; simp only [val,ih f,ik f]
  | subst g _ ih => intro f; rw [substitution,substitution]; exact ih _
theorem exact_basis {T : Matrix} (ok : SemigroupTable T) :
    Basis T ↔ ∃ R : List (Term × Term), ∀ s t,
      (∀ f : Nat → Fin T.length, val ok f s = val ok f t) ↔
      Equational (fun u v => (u,v) ∈ R) s t := by
  constructor
  · rintro ⟨R,truth,complete⟩
    exact ⟨R,fun s t => ⟨fun h => complete s t ((assignments ok s t).mpr h),
      fun pf => (assignments ok s t).mp (soundness ok (fun h => truth _ _ h) pf)⟩⟩
  · rintro ⟨R,exactness⟩
    exact ⟨R,fun s t h => (assignments ok _ _).mpr ((exactness _ _).mpr (.gen h)),
      fun s t h => (exactness _ _).mp ((assignments ok s t).mp h)⟩
end P455StatementAudit
end
section
namespace P455WriterBlocks
open Problem455Swap P455WriterTiles P455WriterProfiles P455WriterObservations
def stable (r : Nat) (w s : W) :=
  (choices s w).all fun p => decide ((bigram p.1 p.2 w = r ∨ bigram p.2 p.1 w = r) → p.2∈s)
theorem stable_ok (r : Nat) (w s : W) : stable r w s = true ↔ P455Enum.stable r w s := by
  simp only [stable,P455Enum.stable,choices,List.all_eq_true,List.mem_flatMap,List.mem_map,decide_eq_true_eq,Link]
  constructor
  · intro h a i b j
    exact h (a,b) ⟨a,i,b,j,rfl⟩
  · rintro h _ ⟨a,i,b,j,rfl⟩
    exact h a i b j
def joined (r : Nat) (w : W) (x y : Nat) :=
  let v := x::w
  (Problem455Finite.wordsUpTo v v.length).all fun s => decide (x∈s → stable r w s = true → y∈s)
theorem joined_ok {r : Nat} (hr : 0 < r) (w : W) (x y : Nat) :
    joined r w x y = true ↔ Joined (Link r w) x y := by
  simp only [joined,List.all_eq_true,decide_eq_true_eq,stable_ok]
  constructor
  · intro closed
    classical
    let v := x::w
    let s := v.filter (fun a => decide (Joined (Link r w) x a))
    have mem {a} : a∈s ↔ a∈v ∧ Joined (Link r w) x a := by simp [s]
    have ins : s∈Problem455Finite.wordsUpTo v v.length :=
      Problem455Finite.covered _ _ _ (List.length_filter_le ..) (fun _ m => (mem.mp m).1)
    have st : P455Enum.stable r w s := fun _ ma _ mb ed =>
      mem.mpr ⟨List.mem_cons_of_mem _ mb,.extend (mem.mp ma).2 ed⟩
    exact (mem.mp (closed s ins (mem.mpr ⟨List.mem_cons_self,.refl _⟩) st)).2
  · intro path s _ start st
    induction path with
    | refl => exact start
    | extend p ed ih =>
      exact st _ ih _ (ed.elim (fun h => (P455Enum.linkNames hr h).2) (fun h => (P455Enum.linkNames hr h).1)) ed
def same (r : Nat) (w : W) (x y : Nat) := decide (w.count x = r ∧ w.count y = r) && joined r w x y
theorem same_ok {r : Nat} (hr : 0 < r) (w : W) (x y : Nat) : same r w x y = true ↔ SameBlock r w x y := by
  simp only [same,SameBlock,Problem455BlockBridge.occ_count,Bool.and_eq_true,decide_eq_true_eq,joined_ok hr,and_assoc]
variable {A : Type} [Primcodable A]
theorem stableRec {r : A → Nat} {w s : A → W} (hr : Primrec r) (hw : Primrec w) (hs : Primrec s) :
    Primrec fun a => stable (r a) (w a) (s a) := by
  apply P455FramePrim.allB (choicesRec hs hw)
  apply Primrec₂.mk
  have p := Primrec.snd (α := A) (β := Nat × Nat)
  have a := Primrec.fst.comp p
  have b := Primrec.snd.comp p
  have xy := Primrec.eq.comp (bigramRec (hw.comp Primrec.fst) a b) (hr.comp Primrec.fst)
  have yx := Primrec.eq.comp (bigramRec (hw.comp Primrec.fst) b a) (hr.comp Primrec.fst)
  exact (impliesRec (PrimrecPred.or xy yx) (P455CataloguePrim.mem'.comp b (hs.comp Primrec.fst))).decide
theorem joinedRec {r x y : A → Nat} {w : A → W} (hr : Primrec r) (hw : Primrec w) (hx : Primrec x) (hy : Primrec y) :
    Primrec fun a => joined (r a) (w a) (x a) (y a) := by
  have v := Primrec.list_cons.comp hx hw
  unfold joined
  apply P455FramePrim.allB (p := fun a s => decide (x a∈s → stable (r a) (w a) s = true → y a∈s)) (P455GraphPrim.wordsUpTo.comp v (Primrec.list_length.comp v))
  apply Primrec₂.mk
  have s := Primrec.snd (α := A) (β := W)
  exact (impliesRec (P455CataloguePrim.mem'.comp (hx.comp Primrec.fst) s)
    (impliesRec (Primrec.eq.comp (stableRec (hr.comp Primrec.fst) (hw.comp Primrec.fst) s) (.const true))
      (P455CataloguePrim.mem'.comp (hy.comp Primrec.fst) s))).decide
theorem sameRec {r x y : A → Nat} {w : A → W} (hr : Primrec r) (hw : Primrec w) (hx : Primrec x) (hy : Primrec y) :
    Primrec fun a => same (r a) (w a) (x a) (y a) :=
  Primrec.and.comp (PrimrecPred.and (Primrec.eq.comp (P455CataloguePrim.count'.comp hw hx) hr)
    (Primrec.eq.comp (P455CataloguePrim.count'.comp hw hy) hr)).decide (joinedRec hr hw hx hy)
end P455WriterBlocks
end
section
namespace P455WriterStructural
open P455WriterTiles P455WriterProfiles P455WriterObservations P455PaddedTiles
open P455Structural (Rec Edge Intrusion Width Overlap)
open Problem455.Slots
local instance (w : W) (p : List Event) : Decidable (sees w p) := P455Enum.seesD w p
def recordB (r : Nat) (ts : Tags) (w : W) (a b : Nat) :=
  decide (a≠b) && (choices ts [false,true]).any (fun tb =>
    decide (tb.1.length+16 = r ∧ select [a,b] w = profile a b tb.1 tb.2))
def edgeB (r : Nat) (ts : Tags) (w : W) (a b : Nat) :=
  recordB r ts w a b || recordB r ts w b a
theorem record_correct (M : MachineTable n) (r w a b) :
    recordB r (P455Enum.tags M) w a b = true ↔ Rec w r (allowed M) a b := by
  simp only [recordB,choices,List.any_eq_true,List.mem_flatMap,List.mem_map,Bool.and_eq_true,decide_eq_true_eq]
  constructor
  · rintro ⟨hne,_,⟨t,mt,bit,_,rfl⟩,le,eq⟩
    exact ⟨t,hne,le,P455Enum.mem_tags.mp mt,bit,eq⟩
  · rintro ⟨t,hne,le,mt,bit,eq⟩
    refine ⟨hne,(t,bit),⟨t,P455Enum.mem_tags.mpr mt,bit,?_,rfl⟩,le,eq⟩
    cases bit <;> simp
theorem edge_correct (M : MachineTable n) (r w a b) :
    edgeB r (P455Enum.tags M) w a b = true ↔ Edge w r (allowed M) a b := by
  simp only [edgeB,Bool.or_eq_true,record_correct,Edge]
def widthB (k : Nat) (w : W) := (Problem455Finite.wordsUpTo w k).any fun c => w.all fun x => decide (x∈c)
theorem width_correct (k : Nat) (w : W) : widthB k w = true ↔ Width k w := by
  simp only [widthB,List.any_eq_true,List.all_eq_true,decide_eq_true_eq]
  constructor
  · rintro ⟨c,m,h⟩
    exact ⟨c,P455Enum.words_bound _ _ m,h⟩
  · rintro ⟨c,lim,h⟩
    let t := c.filter fun x => x∈w
    have cover (x) (m : x∈w) : x∈t := by simp [t,h x m,m]
    exact ⟨t,Problem455Finite.covered _ _ t ((List.length_filter_le ..).trans lim)
      (fun _ m => of_decide_eq_true (List.mem_filter.mp m).2),cover⟩
def overlapB (r : Nat) (ts : Tags) (w : W) :=
  (choices w (choices w w)).any fun k =>
    decide (k.1≠k.2.1 ∧ k.1≠k.2.2 ∧ k.2.1≠k.2.2) &&
    edgeB r ts w k.1 k.2.1 && edgeB r ts w k.1 k.2.2
theorem overlap_correct (M : MachineTable n) (r w) :
    overlapB r (P455Enum.tags M) w = true ↔ Overlap w r (allowed M) := by
  simp only [overlapB,choices,List.any_eq_true,List.mem_flatMap,List.mem_map,Bool.and_eq_true,
    decide_eq_true_eq,edge_correct]
  constructor
  · rintro ⟨_,⟨o,_,_,⟨p,_,q,_,rfl⟩,rfl⟩,⟨⟨op,oq,pq⟩,ep⟩,eq⟩
    exact ⟨o,p,q,op,oq,pq,ep,eq⟩
  · rintro ⟨o,p,q,op,oq,pq,ep,eq⟩
    exact ⟨_,⟨o,(P455Enum.edge_names ep).1,_,⟨p,(P455Enum.edge_names ep).2,q,(P455Enum.edge_names eq).2,rfl⟩,rfl⟩,
      ⟨⟨op,oq,pq⟩,ep⟩,eq⟩
def intrusionB (r : Nat) (ts : Tags) (w : W) :=
  (choices w (choices w (events w))).any fun k =>
    decide (k.1≠k.2.1 ∧ k.2.2.1≠k.1 ∧ k.2.2.1≠k.2.1) &&
    recordB r ts w k.1 k.2.1 && decide (sees w [(k.1,0),k.2.2,(k.2.1,2)])
theorem intrusion_correct (M : MachineTable n) (r w) :
    intrusionB r (P455Enum.tags M) w = true ↔ Intrusion w r (allowed M) := by
  simp only [intrusionB,choices,List.any_eq_true,List.mem_flatMap,List.mem_map,Bool.and_eq_true,
    decide_eq_true_eq,record_correct]
  constructor
  · rintro ⟨_,⟨o,_,_,⟨p,_,e,_,rfl⟩,rfl⟩,⟨⟨op,zo,zp⟩,recProof⟩,s⟩
    exact ⟨o,p,e.1,e.2,op,zo,zp,recProof,s⟩
  · rintro ⟨o,p,z,j,op,zo,zp,recProof,s⟩
    exact ⟨_,⟨o,(P455Enum.rec_names recProof).1,_,⟨p,(P455Enum.rec_names recProof).2,(z,j),s.subset (by simp),rfl⟩,rfl⟩,
      ⟨⟨op,zo,zp⟩,recProof⟩,s⟩
def compressedB (r : Nat) (w : W) :=
  (choices w w).all fun p => decide (Problem455Swap.bigram p.1 p.2 w ≠ r)
theorem compressed_correct {r : Nat} (pos : 0 < r) (w : W) :
    compressedB r w = true ↔ P455SourceFamilies.Compressed r w := by
  simp only [compressedB,choices,List.all_eq_true,List.mem_flatMap,List.mem_map,decide_eq_true_eq]
  constructor
  · intro h a b link
    exact h (a,b) ⟨a,(P455Enum.linkNames pos link).1,b,(P455Enum.linkNames pos link).2,rfl⟩ link
  · rintro h _ ⟨a,_,b,_,rfl⟩
    exact h a b
end P455WriterStructural
end
section
namespace P455WriterEdge
open P455Witness P455PaddedTiles P455WriterTiles
abbrev Quad := Nat × Nat × Nat × Nat
abbrev Key := Nat × Quad
abbrev Predicate := List Nat → Quad → Bool
def quads := choices (List.range 14) (choices (List.range 14) (choices (List.range 14) (List.range 14)))
def atKey (r i : Nat) := (P455EdgeProduct.words r)[i]?.getD []
def key (i : P455EdgeProduct.Index r allow ts) : Key := (i.num.val,i.a.val,i.b.val,i.c.val,i.d.val)
theorem key_inj : Function.Injective (@key r allow ts) := by
  rintro ⟨j,a,b,c,d,_,_⟩ ⟨k,p,q,s,t,_,_⟩ he
  change (j.val,a.val,b.val,c.val,d.val) = (k.val,p.val,q.val,s.val,t.val) at he
  simp only [Prod.mk.injEq] at he
  obtain ⟨jEq,aEq,bEq,cEq,dEq⟩:=he
  cases Fin.ext jEq; cases Fin.ext aEq; cases Fin.ext bEq; cases Fin.ext cEq; cases Fin.ext dEq; rfl
def filtered (r : Nat) (ok : Predicate) :=
  (choices (List.range (P455EdgeProduct.words r).length) quads).filter fun k => ok (atKey r k.1) k.2
def asSpec (r : Nat) (k : Key) : P455Packed.Spec :=
  (atKey r k.1,some [(k.2.1,k.2.2.1),(k.2.2.2.1,k.2.2.2.2)])
def family (r : Nat) (ok : Predicate) := (P455Table.distinct (filtered r ok)).map (asSpec r)
def ValidKey (M : MachineTable n) (r : Nat) (w : List Nat) (k : Quad) : Prop :=
  P455Closure.Cap r w ∧ ∃ e : EdgeCertificate, e.a.owner = k.1 ∧ e.a.mate = k.2.1 ∧ e.b.owner = k.2.2.1 ∧ e.b.mate = k.2.2.2 ∧
    (∀ x, x∈w ↔ x∈P455EdgeProjection.names (system n) e) ∧
    Holds r (allowed M) (P455EdgeProduct.marks k.1 k.2.1 k.2.2.1 k.2.2.2) w (e.query (system n))
theorem getAt (r : Nat) (i : Fin (P455EdgeProduct.words r).length) : atKey r i.val = (P455EdgeProduct.words r).get i := by
  simp [atKey,i.isLt]
def vals (x : P455Enum.EdgeKey r) : Key := (x.1.val,x.2.1.val,x.2.2.1.val,x.2.2.2.1.val,x.2.2.2.2.val)
private theorem attachKeys (xs : List (P455Enum.EdgeKey r)) :
    xs.attach.map (fun x => vals x.val) = xs.map vals := List.attach_map_val ..
theorem filtered_correct (M : MachineTable n) (hr : 0 < r) (ok : Predicate)
    (correct : ∀ w k, ok w k = true ↔ ValidKey M r w k) :
    (P455Enum.edge hr M).list.map key = filtered r ok := by
  let nums := (P455Enum.fins 14).list
  let xs := choices (P455Enum.fins (P455EdgeProduct.words r).length).list (choices nums (choices nums (choices nums nums)))
  have ord : xs.map vals = choices (List.range (P455EdgeProduct.words r).length) quads := by
    unfold xs nums quads vals
    rw [←p455MapFinRange,←p455MapFinRange (n:=14)]
    simp only [choices,P455Enum.fins,List.map_flatMap,List.map_map,List.flatMap_map,Function.comp_def]
  unfold filtered
  rw [←ord,List.filter_map]
  unfold P455Enum.edge
  simp only [P455Enum.Cover.map,P455Enum.coverSub,P455Enum.selectSub,List.map_map,Function.comp_def,key]
  change (List.map (fun x => @vals r x.val) (List.attach (_ : List (P455Enum.EdgeKey r)))) = _
  rw [@attachKeys r]
  apply congrArg (List.map vals); apply List.filter_congr
  intro x _; apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq,correct,vals,getAt,ValidKey]
theorem family_correct (M : MachineTable n) (hr : 0 < r) (ok : Predicate)
    (correct : ∀ w k, ok w k = true ↔ ValidKey M r w k) :
    family r ok = P455Packed.names (P455Encoded.useCover (P455Enum.edge hr M)) P455Packed.twoSpec := by
  unfold family; rw [←filtered_correct M hr ok correct,←P455CataloguePrim.map_distinct key key_inj,List.map_map]
  unfold P455Packed.names P455Encoded.useCover
  apply List.map_congr_left; intro i _
  change (atKey r i.num.val,_) = _
  rw [getAt]; rfl
variable {A : Type} [Primcodable A]
theorem wordsRec : Primrec P455EdgeProduct.words :=
  P455GraphPrim.wordsUpTo.comp (.const (List.range 14)) (Primrec.nat_mul.comp (.const 14) Primrec.id)
theorem atKeyRec : Primrec₂ atKey :=
  Primrec.option_getD.comp (Primrec.list_getElem?.comp (wordsRec.comp Primrec.fst) Primrec.snd) (.const [])
theorem familyRec {r : A → Nat} {ok : A → Predicate} (hr : Primrec r)
    (h : Primrec (fun p : (A × List Nat) × Quad => ok p.1.1 p.1.2 p.2)) :
    Primrec fun x => family (r x) (ok x) := by
  have ks := choicesRec (Primrec.list_range.comp (Primrec.list_length.comp (wordsRec.comp hr))) (.const quads)
  have src := Primrec.fst (α:=A) (β:=Key)
  have k := Primrec.snd (α:=A) (β:=Key)
  have w := atKeyRec.comp (hr.comp src) (Primrec.fst.comp k)
  have z := Primrec.snd.comp k
  have f : Primrec (fun x => filtered (r x) (ok x)) := P455GraphPrim.filter ks (h.comp ((src.pair w).pair z)).to₂
  have t := Primrec.snd.comp z
  have u := Primrec.snd.comp t
  have ab := (Primrec.fst.comp z).pair (Primrec.fst.comp t)
  exact Primrec.list_map (P455CataloguePrim.distinct'.comp f) (w.pair (Primrec.option_some.comp
    (Primrec.list_cons.comp ab (Primrec.list_cons.comp u (.const []))))).to₂
end P455WriterEdge
end
section
namespace P455FoldWorld
open Turing P455MachineLocal P455MachineTable
def coord : Bool → Nat → Int
  | false,p => -(p : Int)
  | true,p => (p : Int)+1
def motion (s : Bool) (atMark : Bool) (dir : Turing.Dir) : Bool × Direction :=
  match s,dir with
  | false,.left => (false,.right)
  | false,.right => if atMark then (true,.stay) else (false,.left)
  | true,.right => (true,.right)
  | true,.left => if atMark then (false,.stay) else (true,.left)
theorem moves (s p d) :
    let m := motion s (decide (p = 0)) d
    coord m.1 (dest m.2 p) = coord s p + (if d=.right then 1 else -1) := by
  cases s <;> cases d <;> cases p <;> simp [coord,motion,dest]
  omega
structure World (Γ Q : Type) where
  store : Int → Γ
  side : Bool
  radius : Nat
  state : Q
def pos (w : World Γ Q) := coord w.side w.radius
def act (w : World Γ Q) (z : Q) (i : TM0.Stmt Γ) : World Γ Q :=
  match i with
  | .move d =>
    let m := motion w.side (decide (w.radius = 0)) d
    ⟨w.store,m.1,dest m.2 w.radius,z⟩
  | .write b => ⟨Function.update w.store (pos w) b,w.side,w.radius,z⟩
def packed (f : Int → Γ) (p : Nat) := (f (coord false p),f (coord true p))
def choose (side : Bool) (pair : Γ×Γ) := if side then pair.2 else pair.1
def put (side : Bool) (pair : Γ×Γ) (a : Γ) := if side then (pair.1,a) else (a,pair.2)
theorem choose_packed (s : Bool) (f : Int → Γ) (p) : choose s (packed f p) = f (coord s p) := by
  cases s <;> rfl
theorem put_packed (s : Bool) (f : Int → Γ) (p : Nat) (a) (j : Nat) :
    packed (Function.update f (coord s p) a) j=
      if j = p then put s (packed f p) a else packed f j := by
  by_cases e : j = p
  · subst j; cases s <;> simp [coord,put,packed,Function.update_apply] <;> intro h <;> omega
  · have same1 : - (j : Int) ≠ -(p : Int) := by omega
    have same2 : (j : Int)+1 ≠ (p : Int)+1 := by omega
    have cross1 : -(j : Int) ≠ (p : Int)+1 := by omega
    have cross2 : (j : Int)+1 ≠ -(p : Int) := by omega
    cases s <;> simp [coord,put,packed,e,Function.update_apply,same1,same2,cross1,cross2]
def Describes [Inhabited Γ] (w : World Γ Q) (c : TM0.Cfg Γ Q) :=
  w.state = c.q ∧ ∀ i : Int, c.Tape.nth i = w.store (pos w+i)
theorem act_describes [Inhabited Γ] {w : World Γ Q} {c : TM0.Cfg Γ Q} (h : Describes w c) (z : Q) (i : TM0.Stmt Γ) :
    Describes (act w z i) ⟨z,match i with | .move d => c.Tape.move d | .write b => c.Tape.write b⟩ := by
  cases i with
  | write b =>
    refine ⟨rfl,fun j => ?_⟩
    simp only [Tape.write_nth,act,pos,Function.update_apply]
    by_cases e : j = 0
    · simp [e]
    · have ne : coord w.side w.radius+j≠coord w.side w.radius := by omega
      simpa only [if_neg e,if_neg ne,pos] using h.2 j
  | move d =>
    refine ⟨rfl,fun j => ?_⟩
    have mv := moves w.side w.radius d
    cases d <;> simp only [Tape.move_left_nth,Tape.move_right_nth,act,pos] at *
    · rw [h.2]; congr 1; dsimp [pos] at *; omega
    · rw [h.2]; congr 1; dsimp [pos] at *; omega
end P455FoldWorld
end
section
namespace P455SemanticConsequence
open P455BinaryTerms P455PureSemigroup
def ev (mul : A → A → A) (f : Nat → A) : Term → A
  | .var i => f i
  | .mul s t => mul (ev mul f s) (ev mul f t)
def satisfies (mul : A → A → A) (s t : Term) :=
  ∀ f : Nat → A, ev mul f s = ev mul f t
def entails (R : Term → Term → Prop) (s t : Term) :=
  ∀ (A : Type) (mul : A → A → A), (∀ u v, R u v → satisfies mul u v) → satisfies mul s t
theorem ev_sub (mul : A → A → A) (f : Nat → A) (g : Nat → Term) (s : Term) :
    ev mul f (inst g s) = ev mul (fun i => ev mul f (g i)) s := by
  induction s <;> simp_all [inst,ev]
theorem sound {R s t} (h : Equational R s t) : entails R s t := by
  intro A mul models
  induction h with
  | refl => exact fun _ => rfl
  | gen g => exact models _ _ g
  | symm _ ih => exact fun f => (ih f).symm
  | trans _ _ ih ik => exact fun f => (ih f).trans (ik f)
  | mul _ _ ih ik => intro f; simp only [ev,ih f,ik f]
  | subst g _ ih => intro f; rw [ev_sub,ev_sub]; exact ih _
def relation (R : Term → Term → Prop) : Setoid Term where
  r := Equational R
  iseqv := ⟨fun t => .refl t, fun h => .symm h,fun h k => .trans h k⟩
abbrev Free (R) := Quotient (relation R)
def cls (R) (t : Term) : Free R := Quotient.mk _ t
def product (R) (a b : Free R) : Free R :=
  Quotient.liftOn₂ a b (fun u v => cls R (.mul u v))
    (fun _ _ _ _ h k => Quotient.sound (Equational.mul h k))
theorem ev_class (R) (g : Nat → Term) (t) :
    ev (product R) (fun i => cls R (g i)) t = cls R (inst g t) := by
  induction t <;> simp_all [ev,inst]; rfl
theorem free_model (R) (s t) (h : R s t) : satisfies (product R) s t := by
  intro f
  let g i := Classical.choose (Quotient.exists_rep (f i))
  have eq : f = fun i => cls R (g i) := funext fun i => (Classical.choose_spec (Quotient.exists_rep (f i))).symm
  rw [eq, ev_class, ev_class]
  exact Quotient.sound (Equational.subst g (.gen h))
theorem id_inst (t : Term) : inst Term.var t = t := by induction t <;> simp_all [inst]
theorem complete {R s t} (h : entails R s t) : Equational R s t := by
  have e := h (Free R) (product R) (free_model R) (fun i => cls R (.var i))
  have eq : cls R s = cls R t := by simpa only [ev_class,id_inst] using e
  exact Quotient.exact eq
theorem iff_semantic (R) (s t) : Equational R s t ↔ entails R s t := ⟨sound,complete⟩
theorem public_basis {T : P455Table.Matrix} (ok : P455TableSemantics.SemigroupTable T) :
    Basis T ↔ ∃ R : List (Term × Term), ∀ s t,
      (∀ f : Nat → Fin T.length, P455StatementAudit.val ok f s = P455StatementAudit.val ok f t) ↔
      entails (fun u v => (u,v) ∈ R) s t := by
  rw [P455StatementAudit.exact_basis ok]
  simp only [iff_semantic]
end P455SemanticConsequence
end
section
namespace P455WriterQueryLeaves
open P455WriterTiles P455WriterProfiles P455WriterObservations Problem455.Slots
open P455Witness (Query Holds Tag Marking)
abbrev Env := Nat × Tags × List (Nat×Nat) × W
structure ModelsEnv (e : Env) (r : Nat) (allow : Tag → Prop) (mark : Marking) (w : W) : Prop where
  lim : e.1 = r
  tags : ∀ t, t∈e.2.1 ↔ allow t
  marks : ∀ a b, (a,b)∈e.2.2.1 ↔ mark a b
  word : e.2.2.2 = w
  pos : 0 < r
def matched (e : Env) (a b : Nat) (t : Tag) (bit : Bool) :=
  decide (select [a,b] e.2.2.2 = profile a b t bit)
def good (e : Env) (a b : Nat) (t : Tag) := decide (a≠b ∧ t.length+16 = e.1 ∧ t∈e.2.1)
def record (e : Env) (a b : Nat) (t : Tag) := good e a b t && (matched e a b t false || matched e a b t true)
def marked (e : Env) (a b : Nat) (t : Tag) (bit : Bool) :=
  good e a b t && decide ((a,b)∈e.2.2.1 ∨ (b,a)∈e.2.2.1) && matched e a b t bit
def order (e : Env) (pat : List Event) :=
  pat.all (fun p => decide (p.2 ≠ e.1-2)) && decide (sees e.2.2.2 pat)
def separate (e : Env) (a b : Nat) := !(P455WriterBlocks.same e.1 e.2.2.2 a b)
def earlyBefore (e : Env) (xs ys : W) :=
  (choices xs ys).all fun p => order e [(p.1,2),(p.2,0)]
def earlyDisjoint (e : Env) (xs ys : W) := earlyBefore e xs ys || earlyBefore e ys xs
variable {e : Env} {r : Nat} {allow : Tag → Prop} {mark : Marking} {w : W}
theorem record_ok (h : ModelsEnv e r allow mark w) (a b t) :
    record e a b t = true ↔ Holds r allow mark w (.record a b t) := by
  simp only [record,good,matched,Bool.and_eq_true,Bool.or_eq_true,decide_eq_true_eq,h.lim,h.word,h.tags,Holds,typed]
  constructor
  · rintro ⟨⟨ne,len,ok⟩,u|v⟩
    · exact ⟨ne,len,ok,false,u⟩
    · exact ⟨ne,len,ok,true,v⟩
  · rintro ⟨ne,len,ok,bit,z⟩
    exact ⟨⟨ne,len,ok⟩,by cases bit <;> simp_all⟩
theorem marked_ok (h : ModelsEnv e r allow mark w) (a b t bit) :
    marked e a b t bit = true ↔ Holds r allow mark w (.markedBit a b t bit) := by
  simp only [marked,good,matched,Bool.and_eq_true,decide_eq_true_eq,h.lim,h.word,h.tags,h.marks,Holds,and_assoc]
theorem order_ok (h : ModelsEnv e r allow mark w) (pat) :
    order e pat = true ↔ Holds r allow mark w (.order pat) := by
  simp only [order,Bool.and_eq_true,List.all_eq_true,decide_eq_true_eq,h.lim,h.word,Holds]
theorem separate_ok (h : ModelsEnv e r allow mark w) (a b) :
    separate e a b = true ↔ Holds r allow mark w (.separate a b) := by
  simp only [separate,Bool.not_eq_true',Holds,h.lim,h.word,←P455WriterBlocks.same_ok h.pos]
  cases P455WriterBlocks.same r w a b <;> simp
theorem earlyBefore_ok (h : ModelsEnv e r allow mark w) (xs ys) :
    earlyBefore e xs ys = true ↔ Holds r allow mark w (P455Witness.earlyBefore xs ys) := by
  rw [P455PortReflection.earlyBefore_iff]
  simp only [earlyBefore,choices,List.all_eq_true,List.mem_flatMap,List.mem_map]
  constructor
  · intro t a ha b hb
    exact (order_ok h _).mp (t (a,b) ⟨a,ha,b,hb,rfl⟩)
  · rintro t _ ⟨a,ha,b,hb,rfl⟩
    exact (order_ok h _).mpr (t a ha b hb)
theorem earlyDisjoint_ok (h : ModelsEnv e r allow mark w) (xs ys) :
    earlyDisjoint e xs ys = true ↔ Holds r allow mark w (P455Witness.earlyDisjoint xs ys) := by
  simp only [earlyDisjoint,Bool.or_eq_true,earlyBefore_ok h,P455Witness.earlyDisjoint,Holds]
variable {A X : Type} [Primcodable A] [Primcodable X]
theorem memRec [DecidableEq X] {x : A → X} {l : A → List X} [inst : ∀ a, Decidable (x a∈l a)]
    (hx : Primrec x) (hl : Primrec l) : Primrec fun a => @decide _ (inst a) := by
  have v := P455GraphPrim.anyB hl
    ((Primrec.eq.comp (hx.comp (Primrec.fst (β := X))) Primrec.snd).decide.to₂)
  apply Primrec.of_eq v
  intro a
  apply Bool.eq_iff_iff.mpr
  simp [List.any_eq_true]
theorem limRec {f : A → Env} (hf : Primrec f) : Primrec fun x => (f x).1 := Primrec.fst.comp hf
theorem tagsRec {f : A → Env} (hf : Primrec f) : Primrec fun x => (f x).2.1 := Primrec.fst.comp (Primrec.snd.comp hf)
theorem marksRec {f : A → Env} (hf : Primrec f) : Primrec fun x => (f x).2.2.1 :=
  Primrec.fst.comp (Primrec.snd.comp (Primrec.snd.comp hf))
theorem wordRec {f : A → Env} (hf : Primrec f) : Primrec fun x => (f x).2.2.2 :=
  Primrec.snd.comp (Primrec.snd.comp (Primrec.snd.comp hf))
theorem matchedRec {f : A → Env} {a b : A → Nat} {t : A → Tag} {v : A → Bool}
    (hf : Primrec f) (ha : Primrec a) (hb : Primrec b) (ht : Primrec t) (hv : Primrec v) :
    Primrec fun x => matched (f x) (a x) (b x) (t x) (v x) :=
  (Primrec.eq.comp (selectRec (Primrec.list_cons.comp ha (Primrec.list_cons.comp hb (.const []))) (wordRec hf))
    (profileRec ha hb ht hv)).decide
theorem goodRec {f : A → Env} {a b : A → Nat} {t : A → Tag}
    (hf : Primrec f) (ha : Primrec a) (hb : Primrec b) (ht : Primrec t) :
    Primrec fun x => good (f x) (a x) (b x) (t x) :=
  (PrimrecPred.and (PrimrecPred.not (Primrec.eq.comp ha hb))
    (PrimrecPred.and (Primrec.eq.comp (Primrec.nat_add.comp (Primrec.list_length.comp ht) (.const 16)) (limRec hf))
      (memRec ht (tagsRec hf)).primrecPred)).decide
theorem recordRec {f : A → Env} {a b : A → Nat} {t : A → Tag}
    (hf : Primrec f) (ha : Primrec a) (hb : Primrec b) (ht : Primrec t) :
    Primrec fun x => record (f x) (a x) (b x) (t x) :=
  Primrec.and.comp (goodRec hf ha hb ht)
    (Primrec.or.comp (matchedRec hf ha hb ht (.const false)) (matchedRec hf ha hb ht (.const true)))
theorem markedRec {f : A → Env} {a b : A → Nat} {t : A → Tag} {v : A → Bool}
    (hf : Primrec f) (ha : Primrec a) (hb : Primrec b) (ht : Primrec t) (hv : Primrec v) :
    Primrec fun x => marked (f x) (a x) (b x) (t x) (v x) :=
  Primrec.and.comp (Primrec.and.comp (goodRec hf ha hb ht)
    (PrimrecPred.or (memRec (Primrec.pair ha hb) (marksRec hf)).primrecPred (memRec (Primrec.pair hb ha) (marksRec hf)).primrecPred).decide)
    (matchedRec hf ha hb ht hv)
theorem orderRec {f : A → Env} {p : A → List Event} (hf : Primrec f) (hp : Primrec p) :
    Primrec fun a => order (f a) (p a) := by
  apply Primrec.and.comp _ (seesRec (wordRec hf) hp)
  apply P455FramePrim.allB hp
  exact (PrimrecPred.not (Primrec.eq.comp (Primrec.snd.comp Primrec.snd)
    (Primrec.nat_sub.comp ((limRec hf).comp Primrec.fst) (.const 2)))).decide.to₂
theorem separateRec {f : A → Env} {a b : A → Nat} (hf : Primrec f) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => separate (f x) (a x) (b x) :=
  Primrec.not.comp (P455WriterBlocks.sameRec (limRec hf) (wordRec hf) ha hb)
theorem earlyBeforeRec {f : A → Env} {xs ys : A → W} (hf : Primrec f) (hx : Primrec xs) (hy : Primrec ys) :
    Primrec fun a => earlyBefore (f a) (xs a) (ys a) := by
  apply P455FramePrim.allB (choicesRec hx hy)
  apply Primrec₂.mk
  exact orderRec (hf.comp Primrec.fst) (Primrec.list_cons.comp
    (Primrec.pair (Primrec.fst.comp Primrec.snd) (.const 2))
    (Primrec.list_cons.comp (Primrec.pair (Primrec.snd.comp Primrec.snd) (.const 0)) (.const [])))
theorem earlyDisjointRec {f : A → Env} {xs ys : A → W} (hf : Primrec f) (hx : Primrec xs) (hy : Primrec ys) :
    Primrec fun a => earlyDisjoint (f a) (xs a) (ys a) :=
  Primrec.or.comp (earlyBeforeRec hf hx hy) (earlyBeforeRec hf hy hx)
end P455WriterQueryLeaves
end
section
namespace P455WriterStructural
open P455WriterTiles P455WriterProfiles P455WriterObservations
open Problem455.Slots
variable {A : Type} [Primcodable A]
theorem recordRec {r : A → Nat} {ts : A → Tags} {w : A → W} {a b : A → Nat}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => recordB (r x) (ts x) (w x) (a x) (b x) := by
  apply Primrec.and.comp (PrimrecPred.not (Primrec.eq.comp ha hb)).decide
  apply P455GraphPrim.anyB (choicesRec ht (.const [false,true]))
  apply Primrec₂.mk
  have t := Primrec.fst.comp (Primrec.snd (α := A) (β := List Bool × Bool))
  have v := Primrec.snd.comp (Primrec.snd (α := A) (β := List Bool × Bool))
  have k := Primrec.list_cons.comp ha (Primrec.list_cons.comp hb (.const []))
  exact (PrimrecPred.and (Primrec.eq.comp (Primrec.nat_add.comp (Primrec.list_length.comp t) (.const 16)) (hr.comp Primrec.fst))
    (Primrec.eq.comp ((selectRec k hw).comp Primrec.fst) (profileRec (ha.comp Primrec.fst) (hb.comp Primrec.fst) t v))).decide
theorem edgeRec {r : A → Nat} {ts : A → Tags} {w : A → W} {a b : A → Nat}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => edgeB (r x) (ts x) (w x) (a x) (b x) :=
  Primrec.or.comp (recordRec hr ht hw ha hb) (recordRec hr ht hw hb ha)
theorem widthRec {k : A → Nat} {w : A → W} (hk : Primrec k) (hw : Primrec w) :
    Primrec fun x => widthB (k x) (w x) := by
  apply P455GraphPrim.anyB (P455GraphPrim.wordsUpTo.comp hw hk)
  apply Primrec₂.mk
  apply P455FramePrim.allB (hw.comp Primrec.fst)
  exact (P455CataloguePrim.mem'.comp Primrec.snd (Primrec.snd.comp Primrec.fst)).decide.to₂
theorem overlapRec {r : A → Nat} {ts : A → Tags} {w : A → W}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) :
    Primrec fun x => overlapB (r x) (ts x) (w x) := by
  apply P455GraphPrim.anyB (choicesRec hw (choicesRec hw hw))
  apply Primrec₂.mk
  have base := Primrec.fst (α := A) (β := Nat × Nat × Nat)
  have args := Primrec.snd (α := A) (β := Nat × Nat × Nat)
  have a := Primrec.fst.comp args
  have b := Primrec.fst.comp (Primrec.snd.comp args)
  have c := Primrec.snd.comp (Primrec.snd.comp args)
  have ab := PrimrecPred.not (Primrec.eq.comp a b)
  have ac := PrimrecPred.not (Primrec.eq.comp a c)
  have bc := PrimrecPred.not (Primrec.eq.comp b c)
  exact Primrec.and.comp (Primrec.and.comp (PrimrecPred.and ab (PrimrecPred.and ac bc)).decide
    (edgeRec (hr.comp base) (ht.comp base) (hw.comp base) a b))
    (edgeRec (hr.comp base) (ht.comp base) (hw.comp base) a c)
theorem intrusionRec {r : A → Nat} {ts : A → Tags} {w : A → W}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) :
    Primrec fun x => intrusionB (r x) (ts x) (w x) := by
  apply P455GraphPrim.anyB (choicesRec hw (choicesRec hw (eventsRec.comp hw)))
  apply Primrec₂.mk
  have base := Primrec.fst (α := A) (β := Nat × Nat × Event)
  have args := Primrec.snd (α := A) (β := Nat × Nat × Event)
  have a := Primrec.fst.comp args
  have b := Primrec.fst.comp (Primrec.snd.comp args)
  have e := Primrec.snd.comp (Primrec.snd.comp args)
  have z := Primrec.fst.comp e
  have ab := PrimrecPred.not (Primrec.eq.comp a b)
  have za := PrimrecPred.not (Primrec.eq.comp z a)
  have zb := PrimrecPred.not (Primrec.eq.comp z b)
  have pattern := Primrec.list_cons.comp (Primrec.pair a (.const 0))
    (Primrec.list_cons.comp e (Primrec.list_cons.comp (Primrec.pair b (.const 2)) (.const [])))
  exact Primrec.and.comp (Primrec.and.comp (PrimrecPred.and ab (PrimrecPred.and za zb)).decide
    (recordRec (hr.comp base) (ht.comp base) (hw.comp base) a b)) (seesRec (hw.comp base) pattern)
theorem compressedRec {r : A → Nat} {w : A → W} (hr : Primrec r) (hw : Primrec w) :
    Primrec fun x => compressedB (r x) (w x) := by
  apply P455FramePrim.allB (choicesRec hw hw)
  apply Primrec₂.mk
  exact (PrimrecPred.not (Primrec.eq.comp
    (bigramRec (hw.comp Primrec.fst) (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.snd))
    (hr.comp Primrec.fst))).decide
end P455WriterStructural
end
section
namespace P455FoldMachine
open Turing P455MachineLocal P455MachineTable P455MachineCleanup P455FoldWorld
abbrev Sym (Γ : Type) := Option (Γ×Γ)
abbrev Ctrl (Γ Q : Type) := Q×Bool×(Γ×Γ)
abbrev Table (Γ Q : Type) := Q → Γ → Option (Q×TM0.Stmt Γ)
def emit (s : Ctrl Γ Q) (a : Sym Γ) (z : Q) (i : TM0.Stmt Γ) : Ins (Sym Γ) (Ctrl Γ Q) :=
  match i with
  | .move d =>
    let m := motion s.2.1 a.isNone d
    ⟨(z,m.1,s.2.2),a,m.2⟩
  | .write b =>
    let h := if a.isNone then put s.2.1 s.2.2 b else s.2.2
    ⟨(z,s.2.1,h),a.map (fun v => put s.2.1 v b),.stay⟩
def table (M : Table Γ Q) (s : Ctrl Γ Q) (a : Sym Γ) :=
  (M s.1 (choose s.2.1 (a.getD s.2.2))).map (fun (z,i) => emit s a z i)
theorem mark (s : Ctrl Γ Q) (a : Sym Γ) (z i) :
    (emit s a z i).symbol = none ↔ a = none := by
  cases i <;> cases a <;> simp [emit]
theorem safe (s : Ctrl Γ Q) (z i) : (emit s none z i).dir≠.left := by
  cases s with | mk q p =>
    obtain ⟨b,h⟩ := p
    cases i with
    | write => exact Direction.noConfusion
    | move d => cases d <;> cases b <;> exact Direction.noConfusion
variable [Inhabited Γ]
variable (aCode : Sym Γ ≃ Fin g) (sCode : Ctrl Γ Q ≃ Fin r)
def number (i : Ins (Sym Γ) (Ctrl Γ Q)) : Ins (Fin g) (Fin r) :=
  ⟨sCode i.state,aCode i.symbol,i.dir⟩
def machine (M : Table Γ Q) (start : Q) (header : Γ×Γ) : Ordinary g r where
  marker := aCode none
  blank := aCode (some (default,default))
  blank_ne := by
    intro h
    have hh : (some (default,default) : Sym Γ) = none := aCode.injective h
    cases hh
  start := sCode (start,false,header)
  delta z a := (table M (sCode.symm z) (aCode.symm a)).map (number aCode sCode)
  keeps := by
    intro z a i e
    rcases Option.map_eq_some_iff.mp e with ⟨j,h,rfl⟩
    rcases Option.map_eq_some_iff.mp h with ⟨⟨u,cmd⟩,_,rfl⟩
    change aCode _ = aCode none ↔ a = aCode none
    rw [aCode.injective.eq_iff,mark,Equiv.symm_apply_eq]
  leftSafe := by
    intro z i e
    simp only [Equiv.symm_apply_apply] at e
    rcases Option.map_eq_some_iff.mp e with ⟨j,h,rfl⟩
    rcases Option.map_eq_some_iff.mp h with ⟨⟨u,cmd⟩,_,rfl⟩
    exact safe (sCode.symm z) u cmd
def cell (f : Int → Γ) (p : Nat) : Sym Γ := if p = 0 then none else some (packed f p)
def control (w : World Γ Q) : Ctrl Γ Q := (w.state,w.side,packed w.store 0)
def physical (w : World Γ Q) : Config g r :=
  ⟨fun j => aCode (cell w.store j),w.radius,sCode (control w)⟩
omit [Inhabited Γ] in
theorem scanned (w : World Γ Q) :
    choose w.side ((cell w.store w.radius).getD (packed w.store 0)) = w.store (pos w) := by
  cases h : w.radius with
  | zero => simp [cell,choose_packed,pos,h]
  | succ p => simp [cell,choose_packed,pos,h]
theorem translated (M : Table Γ Q) (start : Q) (hdr : Γ×Γ) (w : World Γ Q) :
    instruction (machine aCode sCode M start hdr) (physical aCode sCode w)=
      (M w.state (w.store (pos w))).map (fun (z,i) =>
        number aCode sCode (emit (control w) (cell w.store w.radius) z i)) := by
  simp only [instruction,machine,physical,Equiv.symm_apply_apply,table,control,scanned,Option.map_map]
  rfl
theorem act_step (M : Table Γ Q) (start : Q) (hdr : Γ×Γ) (w : World Γ Q) (z i)
    (e : M w.state (w.store (pos w)) = some (z,i)) :
    once (machine aCode sCode M start hdr) (physical aCode sCode w)=
      physical aCode sCode (act w z i) := by
  rw [once,translated,e]
  have noneEq : (cell w.store w.radius).isNone = decide (w.radius = 0) := by
    cases w.radius <;> simp [cell]
  cases i with
  | move d =>
    simp [emit,number,physical,control,act,P455EffectiveMachine.write_same,noneEq]
  | write b =>
    have pp : pos w = coord w.side w.radius := rfl
    have head : packed (Function.update w.store (pos w) b) 0=
        (if (cell w.store w.radius).isNone then put w.side (packed w.store 0) b else packed w.store 0) := by
      rw [pp,put_packed,noneEq]
      by_cases h : w.radius = 0 <;> simp [h,eq_comm]
    have tp : writeAt (fun j=>aCode (cell w.store j)) w.radius
          (aCode ((cell w.store w.radius).map (fun v => put w.side v b))) =
        fun j => aCode (cell (Function.update w.store (pos w) b) j) := by
      funext j
      by_cases e : j = w.radius
      · subst j; by_cases h : w.radius = 0 <;> simp [writeAt,cell,h,pp,put_packed]
      · by_cases h : j = 0 <;> simp [writeAt,e,cell,h,pp,put_packed]
        omega
    change (⟨_,_,_⟩ : Config g r) = ⟨_,_,_⟩
    simp only [emit,number,physical,control,act,dest,head] at *
    congr 1
end P455FoldMachine
end
section
namespace P455WriterSlots
open P455Witness (Tag Holds Query Marking SlotDefect)
open P455WriterQueryLeaves P455WriterObservations P455WriterProfiles
open Problem455.Slots
def slot (e : Env) (o i a : Nat) :=
  decide (slotStart i) && (events e.2.2.2).any (fun p => decide (sees e.2.2.2 [(o,i),(a,p.2),(o,i+1)]))
def different (e : Env) : W → Bool
  | [] => true
  | a::t => t.all (separate e a) && different e t
def holes (e : Env) (o i : Nat) (xs : W) :=
  decide (xs.length = 5) && different e (o::xs) &&
    xs.all (fun a => decide (e.2.2.2.count a = e.1) && slot e o i a)
def terminal (e : Env) (o i : Nat) (defect : SlotDefect) : Bool :=
  match defect with
  | .deficient a => slot e o i a && decide (e.2.2.2.count a < e.1)
  | .overflow xs => holes e o i xs
variable {e : Env} {r : Nat} {allow : Tag → Prop} {mark : Marking} {w : W}
theorem slot_ok (h : ModelsEnv e r allow mark w) (o i a : Nat) :
    slot e o i a = true ↔ Holds r allow mark w (.slot o i a) := by
  simp only [slot,Bool.and_eq_true,decide_eq_true_eq,List.any_eq_true,h.word,Holds,occupies]
  apply and_congr_right
  intro _
  constructor
  · rintro ⟨p,_,s⟩; exact ⟨p.2,s⟩
  · rintro ⟨j,s⟩; exact ⟨(a,j),s.subset (by simp),s⟩
theorem different_ok (h : ModelsEnv e r allow mark w) (xs : W) :
    different e xs = true ↔ Holds r allow mark w (P455Witness.differentBlocks xs) := by
  induction xs with
  | nil => simp [different,P455Witness.differentBlocks,Holds]
  | cons a xs ih =>
    simp [different,P455Witness.differentBlocks,Holds,P455PortReflection.holds_all,List.all_eq_true,ih,separate_ok h]
theorem terminal_ok (h : ModelsEnv e r allow mark w) (o i d) :
    terminal e o i d = true ↔ Holds r allow mark w (P455Witness.terminalSlot r o i d) := by
  cases d with
  | deficient a => simp only [terminal,Bool.and_eq_true,slot_ok h,decide_eq_true_eq,h.word,h.lim,P455Witness.terminalSlot,Holds]
  | overflow xs =>
    simp [terminal,holes,Bool.and_eq_true,slot_ok h,decide_eq_true_eq,h.word,h.lim,different_ok h,List.all_eq_true,
      P455Witness.terminalSlot,P455PortReflection.holds_all,Holds,and_assoc]
variable {A : Type} [Primcodable A]
theorem slotRec {e : A → Env} {o i a : A → Nat} (he : Primrec e) (ho : Primrec o) (hi : Primrec i) (ha : Primrec a) :
    Primrec fun x => slot (e x) (o x) (i x) (a x) := by
  have fixed : Primrec fun x => decide (slotStart (i x)) := by
    have hit := memRec hi (Primrec.const [0,1,3,5,7,9,11])
    apply Primrec.of_eq hit
    intro x
    apply Bool.eq_iff_iff.mpr
    simp [slotStart]
    exact decide_eq_true_iff.symm
  apply Primrec.and.comp fixed
  apply P455GraphPrim.anyB (eventsRec.comp (wordRec he))
  apply Primrec₂.mk
  let cons := @Primrec.list_cons Event _
  have o' := ho.comp (Primrec.fst (β := Event))
  have i' := hi.comp (Primrec.fst (β := Event))
  exact seesRec ((wordRec he).comp Primrec.fst) (cons.comp (o'.pair i') (cons.comp
    (Primrec.pair (ha.comp Primrec.fst) (Primrec.snd.comp Primrec.snd))
    (cons.comp (o'.pair (Primrec.succ.comp i')) (.const []))))
theorem differentRec {e : A → Env} {l : A → W} (he : Primrec e) (hl : Primrec l) :
    Primrec fun x => different (e x) (l x) := by
  let h (x : A) (p : Nat×W×Bool) := p.2.1.all (separate (e x) p.1) && p.2.2
  have hh : Primrec₂ h := by
    apply Primrec₂.mk
    apply Primrec.and.comp _ (Primrec.snd.comp (Primrec.snd.comp Primrec.snd))
    apply P455FramePrim.allB (Primrec.fst.comp (Primrec.snd.comp Primrec.snd))
    exact (separateRec ((he.comp Primrec.fst).comp Primrec.fst) ((Primrec.fst.comp Primrec.snd).comp Primrec.fst) Primrec.snd).to₂
  apply (Primrec.list_rec hl (.const true) hh).of_eq
  intro x
  induction l x with
  | nil => rfl
  | cons a xs ih => exact congrArg (fun b => h x (a,xs,b)) ih
theorem holesRec {e : A → Env} {o i : A → Nat} {xs : A → W} (he : Primrec e) (ho : Primrec o)
    (hi : Primrec i) (hl : Primrec xs) : Primrec fun x => holes (e x) (o x) (i x) (xs x) := by
  apply Primrec.and.comp (Primrec.and.comp (Primrec.eq.comp (Primrec.list_length.comp hl) (.const 5)).decide
    (differentRec he (Primrec.list_cons.comp ho hl)))
  apply P455FramePrim.allB hl
  exact (Primrec.and.comp (Primrec.eq.comp (P455CataloguePrim.count'.comp ((wordRec he).comp Primrec.fst) Primrec.snd)
    ((limRec he).comp Primrec.fst)).decide (slotRec (he.comp Primrec.fst) (ho.comp Primrec.fst) (hi.comp Primrec.fst) Primrec.snd)).to₂
theorem terminalRec {e : A → Env} {o i : A → Nat} {d : A → SlotDefect}
    (he : Primrec e) (ho : Primrec o) (hi : Primrec i) (hd : Primrec d) :
    Primrec fun x => terminal (e x) (o x) (i x) (d x) := by
  let a (x : A) (z : Nat) := slot (e x) (o x) (i x) z && decide ((e x).2.2.2.count z < (e x).1)
  have ha : Primrec₂ a := Primrec.and.comp
    (slotRec (he.comp Primrec.fst) (ho.comp Primrec.fst) (hi.comp Primrec.fst) Primrec.snd)
    (Primrec.nat_lt.comp (P455CataloguePrim.count'.comp ((wordRec he).comp Primrec.fst) Primrec.snd) ((limRec he).comp Primrec.fst)).decide
  let b (x : A) (xs : W) := holes (e x) (o x) (i x) xs
  have hb : Primrec₂ b := holesRec (he.comp Primrec.fst) (ho.comp Primrec.fst) (hi.comp Primrec.fst) Primrec.snd
  apply (Primrec.sumCasesOn (defectCodeRec.comp hd) ha hb).of_eq
  intro x
  cases d x <;> rfl
end P455WriterSlots
end
section
namespace P455WriterSlots
open P455Witness (Tag Holds Marking ContactChoice)
open P455WriterQueryLeaves P455WriterProfiles Problem455.Slots
def portTest (e : Env) (a b : Nat) (p : Fin 5) (rev : Bool) :=
  let i := 3+2*p.val
  let x := if rev then b else a
  let y := if rev then a else b
  decide (a≠b ∧ e.2.2.2.count a = e.1 ∧ e.2.2.2.count b = e.1) && earlyDisjoint e [a] [b] &&
    order e [(x,i),(y,i),(x,i+1),(y,i+1)]
def contact (e : Env) (a b : Nat) : ContactChoice → Bool
  | .record t v => if v then record e b a t else record e a b t
  | .port p v => portTest e a b p v
theorem contact_ok {e : Env} {r : Nat} {allow : Tag → Prop} {mark : Marking} {w : W}
    (h : ModelsEnv e r allow mark w) (a b c) :
    contact e a b c = true ↔ Holds r allow mark w (P455Witness.contact r a b c) := by
  cases c with
  | record t v => cases v <;> simp [contact,P455Witness.contact,record_ok h]
  | port p v =>
    simp [contact,portTest,P455Witness.contact,Bool.and_eq_true,earlyDisjoint_ok h,order_ok h,
      h.lim,h.word,P455Witness.allQ,Holds,and_assoc]
variable {A : Type} [Primcodable A]
theorem portRec {e : A → Env} {a b : A → Nat} {p : A → Fin 5} {v : A → Bool}
    (he : Primrec e) (ha : Primrec a) (hb : Primrec b) (hp : Primrec p) (hv : Primrec v) :
    Primrec fun x => portTest (e x) (a x) (b x) (p x) (v x) := by
  have i := Primrec.nat_add.comp (.const 3) (Primrec.nat_mul.comp (.const 2) (Primrec.fin_val.comp hp))
  have cond := Primrec.eq.comp hv (.const true)
  have x := Primrec.ite cond hb ha
  have y := Primrec.ite cond ha hb
  let cons := @Primrec.list_cons Event _
  have pat := cons.comp (x.pair i) (cons.comp (y.pair i)
    (cons.comp (x.pair (Primrec.succ.comp i)) (cons.comp (y.pair (Primrec.succ.comp i)) (.const []))))
  exact Primrec.and.comp (Primrec.and.comp (PrimrecPred.and (PrimrecPred.not (Primrec.eq.comp ha hb))
      (PrimrecPred.and (Primrec.eq.comp (P455CataloguePrim.count'.comp (wordRec he) ha) (limRec he))
        (Primrec.eq.comp (P455CataloguePrim.count'.comp (wordRec he) hb) (limRec he)))).decide
    (earlyDisjointRec he (Primrec.list_cons.comp ha (.const [])) (Primrec.list_cons.comp hb (.const [])))) (orderRec he pat)
theorem contactRec {e : A → Env} {a b : A → Nat} {c : A → ContactChoice}
    (he : Primrec e) (ha : Primrec a) (hb : Primrec b) (hc : Primrec c) :
    Primrec fun x => contact (e x) (a x) (b x) (c x) := by
  let f (x : A) (p : Tag × Bool) := if p.2 then record (e x) (b x) (a x) p.1 else record (e x) (a x) (b x) p.1
  have hf : Primrec₂ f := Primrec.ite (Primrec.eq.comp (Primrec.snd.comp Primrec.snd) (.const true))
    (recordRec (he.comp Primrec.fst) (hb.comp Primrec.fst) (ha.comp Primrec.fst) (Primrec.fst.comp Primrec.snd))
    (recordRec (he.comp Primrec.fst) (ha.comp Primrec.fst) (hb.comp Primrec.fst) (Primrec.fst.comp Primrec.snd))
  let g (x : A) (p : Fin 5 × Bool) := portTest (e x) (a x) (b x) p.1 p.2
  have hg : Primrec₂ g := portRec (he.comp Primrec.fst) (ha.comp Primrec.fst) (hb.comp Primrec.fst)
    (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.snd)
  apply (Primrec.sumCasesOn (contactCodeRec.comp hc) hf hg).of_eq
  intro x
  cases c x <;> rfl
end P455WriterSlots
end
section
namespace P455WriterEdge
open P455Witness P455PaddedTiles P455WriterQueryLeaves
abbrev roles (a : Node) := [a.owner,a.mate]
def order2 (e : Env) (a i b j : Nat) := order e [(a,i),(b,j)]
def nodeRecord (e : Env) (a : Node) := record e a.owner a.mate a.tag
def nodeMarked (e : Env) (a : Node) (bit : Bool) := marked e a.owner a.mate a.tag bit
def port (e : Env) (p : Nat) (a b : Node) :=
  let i := 3+2*p
  nodeRecord e a && (nodeRecord e b && (P455WriterQueryLeaves.earlyDisjoint e (roles a) (roles b) &&
    order e [(a.owner,i),(a.mate,i),(b.owner,i),(b.mate,i),(a.owner,i+1),(a.mate,i+1),(b.owner,i+1),(b.mate,i+1)]))
theorem port_ok (h : ModelsEnv e r allow mark w) (p a b) :
    port e p a b = true ↔ Holds r allow mark w (orientedPort p a b) := by
  simp only [port,nodeRecord,Bool.and_eq_true,record_ok h,earlyDisjoint_ok h,order_ok h]
  change (_ ∧ (_ ∧ (_ ∧ _))) ↔ (_ ∧ (_ ∧ (_ ∧ (_ ∧ True))))
  exact Iff.intro (fun ⟨a,b,c,d⟩ => ⟨a,b,c,d,trivial⟩) (fun ⟨a,b,c,d,_⟩=>⟨a,b,c,d⟩)
def rightB (e : Env) (n : Nat) (a b : Node) :=
  P455WriterTiles.horizontal n a.tag b.tag && (port e (if (system n).oddColumn a.tag then 1 else 0) a b &&
    order2 e a.owner (13+a.tag.length) b.owner (13+a.tag.length))
def downB (e : Env) (n : Nat) (a b : Node) :=
  P455WriterTiles.vertical n a.tag b.tag && port e (if (system n).oddRow a.tag then 3 else 2) a b
def neighborB (e : Env) (n : Nat) (a b : Node) : Dir → Bool
  | .right => rightB e n a b | .left => rightB e n b a | .down => downB e n a b | .up => downB e n b a
theorem right_ok (h : ModelsEnv e r allow mark w) (n a b) : rightB e n a b = true ↔ Holds r allow mark w (rightward (system n) a b) := by
  simp only [rightB,order2,Bool.and_eq_true,P455WriterTiles.horizontal_correct,port_ok h,order_ok h]
  exact Iff.intro (fun ⟨a,b,c⟩=>⟨a,b,c,trivial⟩) (fun ⟨a,b,c,_⟩=>⟨a,b,c⟩)
theorem down_ok (h : ModelsEnv e r allow mark w) (n a b) : downB e n a b = true ↔ Holds r allow mark w (downward (system n) a b) := by
  simp only [downB,Bool.and_eq_true,P455WriterTiles.vertical_correct,port_ok h]; rfl
theorem neighbor_ok (h : ModelsEnv e r allow mark w) (n a b d) : neighborB e n a b d = true ↔ Holds r allow mark w (neighbor (system n) a b d) := by
  cases d with
  | right => exact right_ok h n a b
  | left => exact right_ok h n b a
  | down => exact down_ok h n a b
  | up => exact down_ok h n b a
def role (b : Bool) (a : Node) := if b then a.mate else a.owner
def funcB (e : Env) (n : Nat) (f : FunctionalityCertificate) :=
  nodeMarked e f.anchor f.bit && (neighborB e n f.anchor f.b f.dir && (neighborB e n f.anchor f.c f.dir &&
    separate e (role f.distinguishMate f.b) (role f.distinguishMate f.c)))
theorem func_ok (h : ModelsEnv e r allow mark w) (n f) : funcB e n f = true ↔ Holds r allow mark w (f.query (system n)) := by
  simp only [funcB,nodeMarked,Bool.and_eq_true,marked_ok h,neighbor_ok h,separate_ok h]
  exact Iff.intro (fun ⟨a,b,c,d⟩=>⟨a,b,c,d,trivial⟩) (fun ⟨a,b,c,d,_⟩=>⟨a,b,c,d⟩)
def funcAccept (e : Env) (n a b : Nat) :=
  (P455Enum.functionalities e.2.2.2 e.2.1).any fun f => decide (f.anchor.owner = a ∧ f.anchor.mate = b) && funcB e n f
theorem funcAccept_ok (M : MachineTable n) (h : ModelsEnv e r (allowed M) mark w) (tags : e.2.1 = P455Enum.tags M) (a b) :
    funcAccept e n a b = true ↔ ∃ f : FunctionalityCertificate, f.anchor.owner = a ∧ f.anchor.mate = b ∧ Holds r (allowed M) mark w (f.query (system n)) := by
  simp only [funcAccept,List.any_eq_true,Bool.and_eq_true,decide_eq_true_eq,func_ok h,h.word,tags]
  constructor
  · rintro ⟨f,_,⟨ha,hb⟩,hf⟩; exact ⟨f,ha,hb,hf⟩
  · rintro ⟨f,ha,hb,hf⟩; exact ⟨f,P455Enum.func_mem M f hf,⟨ha,hb⟩,hf⟩
end P455WriterEdge
end
section
namespace P455WriterStructural
open P455WriterTiles P455WriterProfiles P455PaddedTiles P455StructuralProduct
def wordAt (r i : Nat) := (templates r)[i]?.getD []
def test (r : Nat) (ts : Tags) (w : W) :=
  P455EffectiveQMove.capB r w && compressedB r w &&
    ((widthB 4 w && overlapB r ts w) || (widthB 3 w && intrusionB r ts w))
theorem test_correct {r : Nat} (pos : 0 < r) (M : MachineTable n) (w : W) :
    test r (P455Enum.tags M) w = true ↔ P455Closure.Cap r w ∧ P455SourceFamilies.Compressed r w ∧
      P455Structural.Structural w r (allowed M) := by
  simp only [test,Bool.and_eq_true,Bool.or_eq_true,P455EffectiveQMove.cap_iff,compressed_correct pos,
    width_correct,overlap_correct,intrusion_correct,P455Structural.Structural,and_assoc]
def indexKey (i : Index r allow) := i.pos.val
theorem key_injective : Function.Injective (@indexKey r allow) := by
  rintro ⟨i,_,_,_⟩ ⟨j,_,_,_⟩ h
  change i.val = j.val at h
  cases Fin.ext h
  rfl
def indices (r : Nat) (ts : Tags) :=
  (List.range (templates r).length).filter fun i => test r ts (wordAt r i)
theorem getWord (r : Nat) (i : Fin (templates r).length) : wordAt r i.val = (templates r).get i := by
  simp [wordAt,i.isLt]
private theorem attachIndices {n : Nat} (xs : List (Fin n)) :
    xs.attach.map (fun x => x.val.val) = xs.map Fin.val :=
  @List.attach_map_val (Fin n) Nat xs Fin.val
theorem indices_correct {r : Nat} (pos : 0 < r) (M : MachineTable n) :
    (P455Enum.structural pos M).list.map indexKey = indices r (P455Enum.tags M) := by
  unfold indices
  rw [←p455MapFinRange,List.filter_map]
  unfold P455Enum.structural
  simp only [P455Enum.Cover.map,P455Enum.coverSub,P455Enum.selectSub,List.map_map,Function.comp_def,indexKey]
  rw [attachIndices]
  apply congrArg (List.map Fin.val)
  apply List.filter_congr
  intro a _
  apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq,getWord,test_correct pos]
def structural (r : Nat) (ts : Tags) : List P455Packed.Spec :=
  (P455Table.distinct (indices r ts)).map fun i => (wordAt r i,none)
theorem structural_correct {r : Nat} (pos : 0 < r) (M : MachineTable n) :
    structural r (P455Enum.tags M) =
      P455Packed.names (P455Encoded.useCover (P455Enum.structural pos M)) P455Packed.structSpec := by
  unfold structural
  rw [←indices_correct pos,←P455CataloguePrim.map_distinct indexKey key_injective,List.map_map]
  unfold P455Packed.names P455Encoded.useCover
  apply List.map_congr_left
  intro i _
  change (wordAt r i.pos.val,none) = _
  rw [getWord]
  rfl
variable {A : Type} [Primcodable A]
theorem templatesRec : Primrec templates :=
  P455GraphPrim.wordsUpTo.comp (.const (List.range 4)) (Primrec.nat_mul.comp (.const 4) Primrec.id)
theorem wordAtRec : Primrec₂ wordAt :=
  Primrec.option_getD.comp (Primrec.list_getElem?.comp (templatesRec.comp Primrec.fst) Primrec.snd) (.const [])
theorem testRec {r : A → Nat} {ts : A → Tags} {w : A → W}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) :
    Primrec fun a => test (r a) (ts a) (w a) :=
  Primrec.and.comp (Primrec.and.comp (P455FrameProof.capCheck hr hw) (compressedRec hr hw))
    (Primrec.or.comp (Primrec.and.comp (widthRec (.const 4) hw) (overlapRec hr ht hw))
                    (Primrec.and.comp (widthRec (.const 3) hw) (intrusionRec hr ht hw)))
theorem structuralRec {r : A → Nat} {ts : A → Tags} (hr : Primrec r) (ht : Primrec ts) :
    Primrec fun a => structural (r a) (ts a) := by
  have ids := Primrec.list_range.comp (Primrec.list_length.comp (templatesRec.comp hr))
  have w := wordAtRec.comp (hr.comp (Primrec.fst (β := Nat))) Primrec.snd
  have valid : Primrec₂ (fun a i => test (r a) (ts a) (wordAt (r a) i)) :=
    testRec (hr.comp Primrec.fst) (ht.comp Primrec.fst) w
  have idx := P455GraphPrim.filter ids valid
  exact Primrec.list_map (P455CataloguePrim.distinct'.comp idx) (Primrec.pair w (.const none)).to₂
end P455WriterStructural
end
section
namespace P455FoldRun
open Turing P455MachineLocal P455MachineTable P455MachineCleanup P455EffectiveMachine
open P455WriterSweep P455FoldWorld P455FoldMachine
def Marked (flag : Γ → Bool) (w : World Γ Q) := ∀ p, flag (w.store p) = true ↔ p = 0
theorem survives (flag : Γ → Bool) (M : Table Γ Q) (w : World Γ Q)
    (guard : ∀ q a z b, M q a = some (z,.write b) → flag b = flag a)
    {z i} (step : M w.state (w.store (pos w)) = some (z,i)) (h : Marked flag w) :
    Marked flag (act w z i) := by
  cases i with
  | move d => exact h
  | write b =>
    intro p
    change flag (Function.update w.store (pos w) b p) = true ↔ p = 0
    by_cases eq : p = pos w
    · subst p; simpa [guard _ _ _ _ step] using h (pos w)
    · simpa [Function.update_of_ne eq] using h p
variable [Inhabited Γ] [Inhabited Q]
variable (aCode : Sym Γ ≃ Fin g) (sCode : Ctrl Γ Q ≃ Fin r)
theorem lift_reaches (M : TM0.Machine Γ Q) (header : Γ×Γ) (flag : Γ → Bool)
    (guard : ∀ q a z b, M q a = some (z,.write b) → flag b = flag a)
    {u v : TM0.Cfg Γ Q} (path : StateTransition.Reaches (TM0.step M) u v)
    (w₀ : World Γ Q) (d₀ : Describes w₀ u) (m₀ : Marked flag w₀) :
    ∃ w, Describes w v ∧ Marked flag w ∧
      reach (machine aCode sCode M default header)
        (physical aCode sCode w₀) (physical aCode sCode w) := by
  induction path with
  | refl => exact ⟨_,d₀,m₀,0,rfl⟩
  | @tail a b _ step ih =>
    obtain ⟨w,d,m,h⟩ := ih
    obtain ⟨q,T⟩ := a
    rcases Option.map_eq_some_iff.mp step with ⟨⟨z,i⟩,e,rfl⟩
    change M q T.head = some (z,i) at e
    have scan : T.head = w.store (pos w) := by simpa using d.2 0
    have exec : M w.state (w.store (pos w)) = some (z,i) := by rw [d.1,←scan]; exact e
    exact ⟨_,act_describes d z i,survives flag M w guard exec m,
      P455WriterSweep.trans h (single (act_step aCode sCode M default header w z i exec))⟩
end P455FoldRun
end
section
namespace P455FoldInput
open Turing P455MachineLocal P455MachineTable P455MachineCleanup P455EffectiveMachine
open P455FoldWorld P455FoldMachine
structure Wire (Γ : Type) [Inhabited Γ] where
  first : Γ
  second : Γ
  letter : Bool → Γ
  ink : ∀ b, letter b≠default
  distinct : letter false≠letter true
  flag : Γ → Bool
  flags : flag first = true ∧ flag second = false ∧ flag default = false ∧ ∀ b, flag (letter b) = false
variable [Inhabited Γ]
def stream (C : Wire Γ) (x : List Bool) := C.first::C.second::x.map C.letter
def layout (C : Wire Γ) (x : List Bool) : Int → Γ
  | .negSucc _ => default
  | .ofNat 0 => C.first
  | .ofNat 1 => C.second
  | .ofNat (i+2) => (x[i]?).elim default C.letter
theorem nth_stream (C : Wire Γ) (x : List Bool) (i : Int) :
    (Tape.mk₁ (stream C x)).nth i = layout C x i := by
  cases i with
  | negSucc n =>
    change (ListBlank.mk ([] : List Γ)).nth n = default
    simp [ListBlank.nth_mk]
  | ofNat n =>
    change (Tape.mk' _ (ListBlank.mk (stream C x))).nth (n : Int) = _
    rw [Tape.mk'_nth_nat,ListBlank.nth_mk,List.getI_eq_iget_getElem?]
    cases n with
    | zero => rfl
    | succ n =>
      cases n with
      | zero => rfl
      | succ n =>
        simp only [stream,List.getElem?_cons_succ,List.getElem?_map,layout]
        cases x[n]? <;> rfl
theorem marked (C : Wire Γ) (x : List Bool) (p : Int) :
    C.flag (layout C x p) = true ↔ p = 0 := by
  obtain ⟨one,two,b,all⟩ := C.flags
  cases p with
  | negSucc n => simp [layout,b]
  | ofNat n =>
    cases n with
    | zero => simp [layout,one]
    | succ n =>
      cases n with
      | zero => simp [layout,two]
      | succ n => cases e : x[n]? <;> simp [layout,e,b,all] <;> omega
def initWorld [Inhabited Q] (C : Wire Γ) (x : List Bool) : World Γ Q :=
  ⟨layout C x,false,0,default⟩
theorem describes_init [Inhabited Q] (C : Wire Γ) (x : List Bool) :
    Describes (initWorld (Q:=Q) C x) (TM0.init (stream C x)) := by
  refine ⟨rfl,fun i => ?_⟩
  simpa [TM0.init,initWorld,pos,coord] using nth_stream C x i
variable [Inhabited Q]
variable (aCode : Sym Γ ≃ Fin g) (sCode : Ctrl Γ Q ≃ Fin r)
def inputAlpha (M : Table Γ Q) (C : Wire Γ) :
    Alphabet (machine aCode sCode M default (C.first,C.second)) where
  bit b := aCode (some (default,C.letter b))
  away b eq := by
    have hh : (some (default,C.letter b) : Sym Γ) = none := aCode.injective eq
    cases hh
  ink b eq := C.ink b (congrArg Prod.snd (Option.some.inj (aCode.injective eq)))
  distinct eq := C.distinct (congrArg Prod.snd (Option.some.inj (aCode.injective eq)))
theorem cell_layout (M : Table Γ Q) (C : Wire Γ) (x : List Bool) :
    (fun j => aCode (cell (layout C x) j))=
      inputTape _ (inputAlpha aCode sCode M C) x := by
  funext j; cases j with
  | zero => rfl
  | succ j =>
    change aCode (some (packed (layout C x) (j+1))) = (x[j]?).elim (aCode (some (default,default)))
        (fun b => aCode (some (default,C.letter b)))
    have left : coord false (j+1) = Int.negSucc j := by simp [coord]; omega
    have right : coord true (j+1) = Int.ofNat (j+2) := by simp [coord]; omega
    simp only [packed,left,right,layout]
    cases x[j]? <;> rfl
theorem initial (M : Table Γ Q) (C : Wire Γ) (x : List Bool) :
    physical aCode sCode (initWorld (Q:=Q) C x)=
      inputConfig _ (inputAlpha aCode sCode M C) x := by
  change (⟨_,0,sCode (default,false,packed (layout C x) 0)⟩ : Config g r)=
    ⟨_,0,sCode (default,false,(C.first,C.second))⟩
  dsimp only [initWorld]
  rw [cell_layout aCode sCode M C x]
  rfl
end P455FoldInput
end
section
namespace P455WriterSlots
open P455Witness (Tag Holds Marking ContactChoice SlotCertificate)
open P455WriterQueryLeaves P455WriterProfiles P455WriterEdge
abbrev Step := Nat × ContactChoice
def visit (e : Env) (s : Nat×Bool) (b : Step) := (b.1, s.2 && contact e s.1 b.1 b.2)
def walk (e : Env) (s : Nat×Bool) (bs : List Step) := bs.foldl (visit e) s
def sat (e : Env) (s : SlotCertificate) :=
  let start := if s.startAtMate then s.anchor.mate else s.anchor.owner
  let last := walk e (start,true) s.steps
  marked e s.anchor.owner s.anchor.mate s.anchor.tag s.bit && decide (s.steps.length ≤ 6) &&
    last.2 && terminal e last.1 s.terminalIndex s.defect
variable {e : Env} {r : Nat} {allow : Tag → Prop} {mark : Marking} {w : W}
theorem walk_ok (h : ModelsEnv e r allow mark w) (s : Nat × Bool) (bs : List Step) (i d) :
    ((walk e s bs).2 = true ∧ terminal e (walk e s bs).1 i d = true) ↔
      s.2 = true ∧ Holds r allow mark w (P455Witness.route r s.1 bs (fun a => P455Witness.terminalSlot r a i d)) := by
  induction bs generalizing s with
  | nil => simp only [walk,List.foldl_nil,P455Witness.route,terminal_ok h]
  | cons b bs ih =>
    change (_ ∧ _) ↔ s.2 = true ∧ Holds r allow mark w (.both _ _)
    rw [show walk e s (b::bs) = walk e (visit e s b) bs by rfl,ih]
    simp only [visit,Holds,Bool.and_eq_true,contact_ok h,and_assoc]
theorem sat_ok (h : ModelsEnv e r allow mark w) (s : SlotCertificate) :
    sat e s = true ↔ Holds r allow mark w (s.query r) := by
  simp only [sat,Bool.and_eq_true,and_assoc,walk_ok h,true_and,marked_ok h,decide_eq_true_eq,
    P455Witness.SlotCertificate.query,P455Witness.allQ,Holds,P455Witness.markedNode,and_true]
variable {A : Type} [Primcodable A]
theorem walkRec {e : A → Env} {s : A → Nat×Bool} {bs : A → List Step}
    (he : Primrec e) (hs : Primrec s) (hb : Primrec bs) : Primrec fun a => walk (e a) (s a) (bs a) := by
  let step (a : A) (p : (Nat×Bool)×Step) := visit (e a) p.1 p.2
  apply Primrec.list_foldl (h:=step) hb hs
  apply Primrec₂.mk
  have p := Primrec.snd (α := A) (β := (Nat×Bool) × Step)
  have i := Primrec.fst.comp (Primrec.fst.comp p)
  have yes := Primrec.snd.comp (Primrec.fst.comp p)
  have j := Primrec.fst.comp (Primrec.snd.comp p)
  have c := Primrec.snd.comp (Primrec.snd.comp p)
  exact j.pair (Primrec.and.comp yes (contactRec (he.comp Primrec.fst) i j c))
theorem satRec {e : A → Env} {s : A → SlotCertificate} (he : Primrec e) (hs : Primrec s) :
    Primrec fun a => sat (e a) (s a) := by
  have z := slotCodeRec.comp hs
  have node := Primrec.fst.comp z
  have a := ownerRec.comp node
  have b := mateRec.comp node
  have tag := tagRec.comp node
  have tail1 := Primrec.snd.comp z
  have bit := Primrec.fst.comp tail1
  have tail2 := Primrec.snd.comp tail1
  have atMate := Primrec.fst.comp tail2
  have tail3 := Primrec.snd.comp tail2
  have steps := Primrec.fst.comp tail3
  have tail4 := Primrec.snd.comp tail3
  have i := Primrec.fst.comp tail4
  have d := Primrec.snd.comp tail4
  have start := Primrec.ite (Primrec.eq.comp atMate (.const true)) b a
  have last := walkRec he (start.pair (.const true)) steps
  exact Primrec.and.comp (Primrec.and.comp (Primrec.and.comp (markedRec he a b tag bit)
    (Primrec.nat_le.comp (Primrec.list_length.comp steps) (.const 6)).decide) (Primrec.snd.comp last))
    (terminalRec he (Primrec.fst.comp last) i d)
def slotAccept (e : Env) (a b : Nat) :=
  (P455Enum.slots e.2.2.2 e.2.1).any fun s =>
    decide (s.anchor.owner = a ∧ s.anchor.mate = b) && sat e s
theorem slotAcceptRec {e : A → Env} {a b : A → Nat} (he : Primrec e) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => slotAccept (e x) (a x) (b x) := by
  apply P455GraphPrim.anyB (slotsRec (wordRec he) (tagsRec he))
  apply Primrec₂.mk
  have s := Primrec.snd (α := A) (β := SlotCertificate)
  have node := Primrec.fst.comp (slotCodeRec.comp s)
  exact Primrec.and.comp (PrimrecPred.and (Primrec.eq.comp (ownerRec.comp node) (ha.comp Primrec.fst))
    (Primrec.eq.comp (mateRec.comp node) (hb.comp Primrec.fst))).decide (satRec (he.comp Primrec.fst) s)
theorem slotAccept_ok (M : P455PaddedTiles.MachineTable n) {e : Env} {r : Nat} {mark : Marking} {w : W}
    (h : ModelsEnv e r (P455PaddedTiles.allowed M) mark w) (ht : e.2.1 = P455Enum.tags M) (a b) :
    slotAccept e a b = true ↔ ∃ s : SlotCertificate, s.anchor.owner = a ∧ s.anchor.mate = b ∧
      Holds r (P455PaddedTiles.allowed M) mark w (s.query r) := by
  simp only [slotAccept,List.any_eq_true,Bool.and_eq_true,decide_eq_true_eq,sat_ok h,h.word,ht]
  constructor
  · rintro ⟨s,_,⟨ha,hb⟩,ok⟩; exact ⟨s,ha,hb,ok⟩
  · rintro ⟨s,ha,hb,ok⟩; exact ⟨s,P455Enum.slot_mem M s ok,⟨ha,hb⟩,ok⟩
end P455WriterSlots
end
section
namespace P455WriterEdge
open P455Witness P455PaddedTiles P455WriterQueryLeaves
def whenB (b p : Bool) := if b then p else true
def localB (env : Env) (n : Nat) (e : EdgeCertificate) :=
  let a := e.a
  let ts := system n
  whenB (!ts.right a.tag) (rightB env n a e.right) &&
    (whenB (!ts.left a.tag) (rightB env n e.left a) &&
    (whenB (!ts.bottom a.tag) (downB env n a e.down) &&
    (whenB (!ts.top a.tag) (downB env n e.up a) &&
     whenB (!ts.right a.tag && !ts.bottom a.tag) (downB env n e.right e.diagonal && rightB env n e.down e.diagonal))))
theorem local_ok (h : ModelsEnv env r allow mark w) (n) (e : EdgeCertificate) :
    localB env n e = true ↔ Holds r allow mark w (localCert (system n) e) := by
  have flag {v : Bool} {z : Query} (b : Bool) (hv : v = true ↔ Holds r allow mark w z) :
      whenB b v = true ↔ Holds r allow mark w (flagQ b z) := by cases b <;> simp [whenB,flagQ,Holds,hv]
  have diag : (downB env n e.right e.diagonal && rightB env n e.down e.diagonal) = true ↔
      Holds r allow mark w (.both (downward (system n) e.right e.diagonal) (rightward (system n) e.down e.diagonal)) := by
    simp only [Bool.and_eq_true,down_ok h,right_ok h]; rfl
  simp only [localB,Bool.and_eq_true,flag _ (right_ok h ..),flag _ (down_ok h ..),flag _ diag]
  simp only [localCert,allQ,Holds,and_true]
def chosenB (env : Env) (n : Nat) (e : EdgeCertificate) :=
  let a := e.a; let b := e.b; let ts := system n
  if endOfRow ts a && ts.bottom a.tag then
    (ts.top b.tag && ts.left b.tag && !ts.oddRow b.tag && !ts.oddColumn b.tag) &&
    ((port env 4 a b || port env 4 b a) && order2 env b.owner 0 a.owner 0)
  else
    let next := if endOfRow ts a then e.down else if ts.oddRow a.tag then e.left else e.right
    decide (next = b) && order2 env a.owner 0 b.owner 0
theorem chosen_ok (h : ModelsEnv env r allow mark w) (n) (e : EdgeCertificate) :
    chosenB env n e = true ↔ Holds r allow mark w (chosenSuccessor (system n) e) := by
  dsimp only [chosenB,chosenSuccessor]
  split <;> simp only [allQ,Holds,Bool.and_eq_true,Bool.or_eq_true,port_ok h,order2,order_ok h,
    earlier,decide_eq_true_eq,and_true]
def queryB (env : Env) (n : Nat) (e : EdgeCertificate) :=
  nodeMarked env e.a true && (nodeMarked env e.b false && (localB env n e && chosenB env n e))
theorem query_ok (h : ModelsEnv env r allow mark w) (n) (e : EdgeCertificate) :
    queryB env n e = true ↔ Holds r allow mark w (e.query (system n)) := by
  simp only [queryB,Bool.and_eq_true,nodeMarked,marked_ok h,local_ok h,chosen_ok h]
  simp only [EdgeCertificate.query,allQ,Holds,markedNode,and_true]
def sameNames (xs ys : List Nat) := xs.all (fun x => decide (x∈ys)) && ys.all (fun y => decide (y∈xs))
theorem same_ok (xs ys : List Nat) : sameNames xs ys = true ↔ ∀ x, x∈xs ↔ x∈ys := by
  simp only [sameNames,Bool.and_eq_true,List.all_eq_true,decide_eq_true_eq]
  exact ⟨fun ⟨f,g⟩ x => ⟨f x,g x⟩, fun h => ⟨fun x => (h x).1,fun y => (h y).2⟩⟩
def env (r : Nat) (ts : List (List Bool)) (w : List Nat) (k : Quad) : Env := (r,ts,[(k.1,k.2.1),(k.2.2.1,k.2.2.2)],w)
def tests (r n : Nat) (ts : List (List Bool)) (w : List Nat) (k : Quad) :=
  P455EffectiveQMove.capB r w && (P455Enum.certificates w ts).any fun e =>
    decide (e.a.owner = k.1 ∧ e.a.mate = k.2.1 ∧ e.b.owner = k.2.2.1 ∧ e.b.mate = k.2.2.2) &&
    (sameNames w (P455EdgeProjection.names (system n) e) && queryB (env r ts w k) n e)
theorem tests_ok (M : MachineTable n) (hr : 0 < r) (w k) :
    tests r n (P455Enum.tags M) w k = true ↔ ValidKey M r w k := by
  have h : ModelsEnv (env r (P455Enum.tags M) w k) r (allowed M)
      (P455EdgeProduct.marks k.1 k.2.1 k.2.2.1 k.2.2.2) w :=
    ⟨rfl,fun _ => P455Enum.mem_tags,fun _ _ => by rcases k with ⟨a,b,c,d⟩; simp [env,P455EdgeProduct.marks],rfl,hr⟩
  simp only [tests,Bool.and_eq_true,P455EffectiveQMove.cap_iff,List.any_eq_true,decide_eq_true_eq,
    same_ok,query_ok h,ValidKey]
  constructor
  · rintro ⟨cap,e,_,⟨a,b,c,d⟩,ns,hq⟩; exact ⟨cap,e,a,b,c,d,ns,hq⟩
  · rintro ⟨cap,e,a,b,c,d,ns,hq⟩
    obtain ⟨z,za,zb,ne,zq,hz⟩ := P455CatalogueBounds.bounded_edge cap (P455Enum.tags M)
      (fun _ ht => P455Enum.mem_tags.mpr ht) e hq
    exact ⟨cap,z,P455Enum.bounded_mem z hz,⟨za ▸ a,za ▸ b,zb ▸ c,zb ▸ d⟩,ne ▸ ns,zq⟩
def edges (r n : Nat) (ts : List (List Bool)) := family r (tests r n ts)
theorem edges_correct (M : MachineTable n) (hr : 0 < r) : edges r n (P455Enum.tags M)=
    P455Packed.names (P455Encoded.useCover (P455Enum.edge hr M)) P455Packed.twoSpec :=
  family_correct M hr _ (tests_ok M hr)
end P455WriterEdge
end
section
namespace P455WriterEdge
open P455Witness P455PaddedTiles P455WriterQueryLeaves
variable {A : Type} [Primcodable A]
theorem rolesRec : Primrec roles :=
  Primrec.list_cons.comp ownerRec (Primrec.list_cons.comp mateRec (.const []))
theorem order2Rec {e : A → Env} {a i b j : A → Nat} (he : Primrec e) (ha : Primrec a) (hi : Primrec i)
    (hb : Primrec b) (hj : Primrec j) : Primrec fun x => order2 (e x) (a x) (i x) (b x) (j x) :=
  orderRec he (Primrec.list_cons.comp (ha.pair hi) (Primrec.list_cons.comp (hb.pair hj) (.const [])))
theorem nodeRecordRec {e : A → Env} {a : A → Node} (he : Primrec e) (ha : Primrec a) :
    Primrec fun x => nodeRecord (e x) (a x) := recordRec he (ownerRec.comp ha) (mateRec.comp ha) (tagRec.comp ha)
theorem nodeMarkedRec {e : A → Env} {a : A → Node} {v : A → Bool} (he : Primrec e) (ha : Primrec a) (hv : Primrec v) :
    Primrec fun x => nodeMarked (e x) (a x) (v x) := markedRec he (ownerRec.comp ha) (mateRec.comp ha) (tagRec.comp ha) hv
theorem portRec {e : A → Env} {p : A → Nat} {a b : A → Node} (he : Primrec e) (hp : Primrec p) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => port (e x) (p x) (a x) (b x) := by
  have i := Primrec.nat_add.comp (.const 3) (Primrec.nat_mul.comp (.const 2) hp)
  have j := Primrec.nat_add.comp i (.const 1)
  have u := ownerRec.comp ha; have v := mateRec.comp ha; have y := ownerRec.comp hb; have z := mateRec.comp hb
  let cons := @Primrec.list_cons (Nat × Nat) _
  have upper := cons.comp (u.pair j) (cons.comp (v.pair j) (cons.comp (y.pair j) (cons.comp (z.pair j) (.const []))))
  have pat := cons.comp (u.pair i) (cons.comp (v.pair i) (cons.comp (y.pair i) (cons.comp (z.pair i) upper)))
  exact Primrec.and.comp (nodeRecordRec he ha) (Primrec.and.comp (nodeRecordRec he hb) (Primrec.and.comp
    (earlyDisjointRec he (rolesRec.comp ha) (rolesRec.comp hb)) (orderRec he pat)))
theorem flagRec (i : Nat) {a : A → Node} (ha : Primrec a) : Primrec fun x => (a x).tag[i]?.getD false :=
  Primrec.option_getD.comp (Primrec.list_getElem?.comp (tagRec.comp ha) (.const i)) (.const false)
theorem rightRec {e : A → Env} {n : A → Nat} {a b : A → Node} (he : Primrec e) (hn : Primrec n) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => rightB (e x) (n x) (a x) (b x) := by
  have t := tagRec.comp ha
  have i := Primrec.nat_add.comp (.const 13) (Primrec.list_length.comp t)
  exact Primrec.and.comp (P455WriterTiles.horizontalRec hn t (tagRec.comp hb)) (Primrec.and.comp
    (portRec he (Primrec.ite (Primrec.eq.comp (flagRec 5 ha) (.const true)) (.const 1) (.const 0)) ha hb)
    (order2Rec he (ownerRec.comp ha) i (ownerRec.comp hb) i))
theorem downRec {e : A → Env} {n : A → Nat} {a b : A → Node} (he : Primrec e) (hn : Primrec n) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => downB (e x) (n x) (a x) (b x) := Primrec.and.comp
    (P455WriterTiles.verticalRec hn (tagRec.comp ha) (tagRec.comp hb))
    (portRec he (Primrec.ite (Primrec.eq.comp (flagRec 4 ha) (.const true)) (.const 3) (.const 2)) ha hb)
def selectDir (d : Dir) (rt lt dn up : Bool) :=
  bif (dirCode d).1 then (bif (dirCode d).2 then up else dn) else (bif (dirCode d).2 then lt else rt)
theorem chosenDir (e : Env) (n : Nat) (a b : Node) (d : Dir) :
    selectDir d (rightB e n a b) (rightB e n b a) (downB e n a b) (downB e n b a) = neighborB e n a b d := by
  cases d <;> simp only [selectDir,dirCode,Equiv.coe_fn_mk,cond_true,cond_false,neighborB]
theorem neighborRec {e : A → Env} {n : A → Nat} {a b : A → Node} {d : A → Dir}
    (he : Primrec e) (hn : Primrec n) (ha : Primrec a) (hb : Primrec b) (hd : Primrec d) :
    Primrec fun x => neighborB (e x) (n x) (a x) (b x) (d x) := by
  have pair := dirCodeRec.comp hd
  have test : Primrec (fun x => selectDir (d x) (rightB (e x) (n x) (a x) (b x)) (rightB (e x) (n x) (b x) (a x))
       (downB (e x) (n x) (a x) (b x)) (downB (e x) (n x) (b x) (a x))) :=
    Primrec.cond (Primrec.fst.comp pair)
      (Primrec.cond (Primrec.snd.comp pair) (downRec he hn hb ha) (downRec he hn ha hb))
      (Primrec.cond (Primrec.snd.comp pair) (rightRec he hn hb ha) (rightRec he hn ha hb))
  exact test.of_eq (fun x => chosenDir (e x) (n x) (a x) (b x) (d x))
theorem roleRec {b : A → Bool} {a : A → Node} (hb : Primrec b) (ha : Primrec a) :
    Primrec fun x => role (b x) (a x) := Primrec.ite (Primrec.eq.comp hb (.const true)) (mateRec.comp ha) (ownerRec.comp ha)
theorem funcRec {e : A → Env} {n : A → Nat} {f : A → FunctionalityCertificate} (he : Primrec e) (hn : Primrec n) (hf : Primrec f) :
    Primrec fun x => funcB (e x) (n x) (f x) := by
  have a := funcAnchorRec.comp hf; have b := funcBRec.comp hf; have c := funcCRec.comp hf
  have d := funcDirRec.comp hf; have v := funcDistinguishMateRec.comp hf
  exact Primrec.and.comp (nodeMarkedRec he a (funcBitRec.comp hf)) (Primrec.and.comp (neighborRec he hn a b d)
    (Primrec.and.comp (neighborRec he hn a c d) (separateRec he (roleRec v b) (roleRec v c))))
theorem funcAcceptRec {e : A → Env} {n a b : A → Nat} (he : Primrec e) (hn : Primrec n) (ha : Primrec a) (hb : Primrec b) :
    Primrec fun x => funcAccept (e x) (n x) (a x) (b x) := by
  have F := Primrec.snd (α:=A) (β:=FunctionalityCertificate)
  have anc := funcAnchorRec.comp F
  exact P455GraphPrim.anyB (functionalitiesRec (wordRec he) (tagsRec he)) (Primrec.and.comp
    ((Primrec.eq.comp (ownerRec.comp anc) (ha.comp Primrec.fst)).and (Primrec.eq.comp (mateRec.comp anc) (hb.comp Primrec.fst))).decide
    (funcRec (he.comp Primrec.fst) (hn.comp Primrec.fst) F)).to₂
end P455WriterEdge
end
section
namespace P455FoldDelivery
open Turing P455MachineLocal P455MachineTable P455MachineCleanup P455EffectiveMachine P455EffectiveChain
open P455FoldWorld P455FoldMachine P455FoldRun P455FoldInput
theorem exact_delivery {Γ Q : Type} [Inhabited Γ] [Inhabited Q] [Fintype Γ] [Fintype Q]
    (M : TM0.Machine Γ Q) (C : Wire Γ)
    (guard : ∀ q a z b, M q a = some (z,.write b) → C.flag b = C.flag a)
    (f : List Bool → List Bool) (run : ∀ x, ∃ q, (⟨q,Tape.mk₁ (stream C (f x))⟩ : TM0.Cfg Γ Q) ∈
      StateTransition.eval (TM0.step M) (TM0.init (stream C x))) :
    ∃ (g r : Nat) (W : Ordinary g r) (A : Alphabet W), ∀ x, Delivers W A x W A (f x) := by
  classical
  let ac := Fintype.equivFin (Sym Γ)
  let sc := Fintype.equivFin (Ctrl Γ Q)
  let W := machine ac sc M default (C.first,C.second)
  let A := inputAlpha ac sc M C
  refine ⟨_,_,W,A,?_⟩
  intro x
  obtain ⟨q,last⟩ := run x
  obtain ⟨steps,halt⟩ := StateTransition.mem_eval.mp last
  obtain ⟨w,descr,mark,t,arrive⟩ := lift_reaches ac sc M (C.first,C.second) C.flag guard steps
    (initWorld C x) (describes_init C x) (marked C x)
  rw [initial ac sc M C] at arrive
  have eq (i : Int) : layout C (f x) i = w.store (pos w+i) :=
    (nth_stream C (f x) i).symm.trans (descr.2 i)
  have head : pos w = 0 := by
    apply (mark (pos w)).mp
    have he : C.first = w.store (pos w) := by simpa [layout] using eq 0
    rw [←he]; exact C.flags.1
  have rad : w.radius = 0 := by
    unfold pos at head
    cases e : w.side <;> simp [e,coord] at head <;> omega
  have storeEq : w.store = layout C (f x) := by
    funext i; simpa [head] using (eq i).symm
  have hM : M q (Tape.mk₁ (stream C (f x))).head = none := by
    change (M q _).map _ = none at halt
    exact Option.map_eq_none_iff.mp halt
  have scan := descr.2 0
  simp only [Tape.nth_zero,Int.add_zero] at scan
  have ended : M w.state (w.store (pos w)) = none := by rw [descr.1,←scan]; exact hM
  refine ⟨t,?_⟩
  change follow W (inputConfig W A x) t = physical ac sc w at arrive
  dsimp only
  rw [arrive]
  refine ⟨?_,rad,?_⟩
  · change instruction (machine ac sc M default (C.first,C.second)) (physical ac sc w) = none
    exact (translated ac sc (show P455FoldMachine.Table Γ Q from M) default (C.first,C.second) w).trans
      (congrArg (fun v => v.map (fun (z,i) => number ac sc (emit (control w) (cell w.store w.radius) z i))) ended)
  · change (fun j => ac (cell w.store j)) = inputTape _ _ _
    rw [storeEq]; exact cell_layout ac sc M C (f x)
end P455FoldDelivery
end
section
namespace P455WriterGuard
open P455WriterTiles (choices choicesRec)
open P455WriterQueryLeaves (Env ModelsEnv)
open P455PaddedTiles P455GuardProduct
open P455Witness (Tag Holds)
abbrev Key := Bool × Nat × Nat × Nat
def environment (r : Nat) (ts : List Tag) (w : List Nat) (a b : Nat) : Env := (r,ts,[(a,b)],w)
def checker (r n : Nat) (ts : List Tag) (w : List Nat) (k : Bool) (a b : Nat) :=
  let e := environment r ts w a b
  P455EffectiveQMove.capB r w && (if k then P455WriterEdge.funcAccept e n a b else P455WriterSlots.slotAccept e a b)
def ValidKey (r : Nat) (M : MachineTable n) (w : List Nat) (k : Bool) (a b : Nat) :=
  P455Closure.Cap r w ∧ ∃ g : Guard, g.isFunc = k ∧ g.anchor.owner = a ∧ g.anchor.mate = b ∧
    Holds r (allowed M) (P455SlotProduct.pairMark a b) w (g.query r (system n))
theorem checker_ok {r : Nat} (hr : 0 < r) (M : MachineTable n) (w k a b) :
    checker r n (P455Enum.tags M) w k a b = true ↔ ValidKey r M w k a b := by
  let e := environment r (P455Enum.tags M) w a b
  have h : ModelsEnv e r (allowed M) (P455SlotProduct.pairMark a b) w :=
    ⟨rfl,fun _ => P455Enum.mem_tags,fun _ _ => by simp [e,environment,P455SlotProduct.pairMark],rfl,hr⟩
  unfold checker ValidKey
  simp only [Bool.and_eq_true,P455EffectiveQMove.cap_iff]
  apply and_congr_right
  intro _
  cases k with
  | false =>
    change P455WriterSlots.slotAccept e a b = true ↔ _
    rw [P455WriterSlots.slotAccept_ok M h rfl]
    constructor
    · rintro ⟨s,ha,hb,ok⟩; exact ⟨.slot s,rfl,ha,hb,ok⟩
    · rintro ⟨s|f,k,ha,hb,ok⟩; exact ⟨s,ha,hb,ok⟩; cases k
  | true =>
    change P455WriterEdge.funcAccept e n a b = true ↔ _
    rw [P455WriterEdge.funcAccept_ok M h rfl]
    constructor
    · rintro ⟨f,ha,hb,ok⟩; exact ⟨.func f,rfl,ha,hb,ok⟩
    · rintro ⟨s|f,k,ha,hb,ok⟩; cases k; exact ⟨f,ha,hb,ok⟩
def wordAt (r : Nat) (kind : Bool) (i : Nat) := (words r kind)[i]?.getD []
def base (r : Nat) (k : Bool) := choices (List.range (words r k).length)
  (choices (List.range (width k)) (List.range (width k)))
def keys (r : Nat) : List Key := [false,true].flatMap fun k => (base r k).map (Prod.mk k)
def filtered (r n : Nat) (ts : List Tag) :=
  (keys r).filter fun k => checker r n ts (wordAt r k.1 k.2.1) k.1 k.2.2.1 k.2.2.2
def spec (r : Nat) (k : Key) : P455Packed.Spec := (wordAt r k.1 k.2.1,some [(k.2.2.1,k.2.2.2)])
def family (r n : Nat) (ts : List Tag) := (P455Table.distinct (filtered r n ts)).map (spec r)
def key (i : Index r allow ts) : Key := (i.kind,i.pos.val,i.a.val,i.b.val)
theorem key_inj : Function.Injective (@key r allow ts) := by
  rintro ⟨k,i,a,b,_,_⟩ ⟨k',i',a',b',_,_⟩ h
  change (k,i.val,a.val,b.val) = (k',i'.val,a'.val,b'.val) at h
  simp only [Prod.mk.injEq] at h
  obtain ⟨rfl,hi,ha,hb⟩ := h
  cases Fin.ext hi; cases Fin.ext ha; cases Fin.ext hb; rfl
def vals (x : P455Enum.GuardKey r) : Key := (x.1,x.2.1.val,x.2.2.1.val,x.2.2.2.val)
private theorem attachKeys (xs : List (P455Enum.GuardKey r)) :
    xs.attach.map (fun x => vals x.val) = xs.map vals := List.attach_map_val ..
theorem wordAt_get (r : Nat) (k : Bool) (i : Fin (words r k).length) :
    wordAt r k i.val = (words r k).get i := by simp [wordAt,i.isLt]
def coreKeys (r : Nat) : List (P455Enum.GuardKey r) :=
  (P455Enum.sigmaCover P455Enum.bools _ (fun k =>
    P455Enum.pairCover (P455Enum.fins (words r k).length) (P455Enum.pairCover (P455Enum.fins (width k)) (P455Enum.fins (width k))))).list
theorem key_order (r : Nat) : (coreKeys r).map vals = keys r := by
  have one (k : Bool) : ((P455Enum.pairCover (P455Enum.fins (words r k).length)
      (P455Enum.pairCover (P455Enum.fins (width k)) (P455Enum.fins (width k)))).list.map
        (fun p => @vals r ⟨k,p⟩)) = (base r k).map (Prod.mk k) := by
    unfold base vals
    rw [←p455MapFinRange,←p455MapFinRange (n:=width k)]
    simp only [P455Enum.pairCover,P455Enum.Cover.bind,P455Enum.fins,choices,List.map_flatMap,List.map_map,List.flatMap_map,Function.comp_def]
  unfold coreKeys keys
  simp only [P455Enum.sigmaCover,List.map_flatMap,List.map_map,Function.comp_def]
  exact congrArg (List.flatMap · [false,true]) (funext one)
theorem filtered_ok (M : MachineTable n) (hr : 0 < r) :
    (P455Enum.guard hr M).list.map key = filtered r n (P455Enum.tags M) := by
  unfold filtered
  rw [←key_order,List.filter_map]
  unfold P455Enum.guard
  simp only [P455Enum.Cover.map,P455Enum.coverSub,P455Enum.selectSub,List.map_map,Function.comp_def,key]
  change (List.map (fun x => @vals r x.val) (List.attach (_ : List (P455Enum.GuardKey r)))) = _
  rw [@attachKeys r]
  apply congrArg (List.map vals); apply List.filter_congr
  intro x _
  apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq,vals,wordAt_get,checker_ok hr,ValidKey]
theorem family_ok (M : MachineTable n) (hr : 0 < r) :
    family r n (P455Enum.tags M) = P455Packed.names (P455Encoded.useCover (P455Enum.guard hr M)) P455Packed.oneSpec := by
  unfold family
  rw [←filtered_ok M hr,←P455CataloguePrim.map_distinct key key_inj,List.map_map]
  unfold P455Packed.names P455Encoded.useCover
  apply List.map_congr_left
  intro i _
  change (wordAt r i.kind i.pos.val,_) = _
  rw [wordAt_get]
  rfl
end P455WriterGuard
end
section
namespace P455WriterEdge
open P455Witness P455PaddedTiles P455WriterQueryLeaves
variable {A : Type} [Primcodable A]
theorem whenRec {b p : A → Bool} (hb : Primrec b) (hp : Primrec p) : Primrec fun x => whenB (b x) (p x) :=
  Primrec.ite (Primrec.eq.comp hb (.const true)) hp (.const true)
theorem localRec {v : A → Env} {n : A → Nat} {f : A → EdgeCertificate} (hv : Primrec v) (hn : Primrec n) (hf : Primrec f) :
    Primrec fun x => localB (v x) (n x) (f x) := by
  have a := edgeARec.comp hf; have rt := edgeRightRec.comp hf; have dn := edgeDownRec.comp hf; have di := edgeDiagonalRec.comp hf
  have rightActive := Primrec.not.comp (flagRec 1 a); have bottom := Primrec.not.comp (flagRec 3 a)
  exact Primrec.and.comp (whenRec rightActive (rightRec hv hn a rt)) <|
    Primrec.and.comp (whenRec (Primrec.not.comp (flagRec 0 a)) (rightRec hv hn (edgeLeftRec.comp hf) a)) <|
    Primrec.and.comp (whenRec bottom (downRec hv hn a dn)) <|
    Primrec.and.comp (whenRec (Primrec.not.comp (flagRec 2 a)) (downRec hv hn (edgeUpRec.comp hf) a))
    (whenRec (Primrec.and.comp rightActive bottom) (Primrec.and.comp (downRec hv hn rt di) (rightRec hv hn dn di)))
theorem chosenRec {v : A → Env} {n : A → Nat} {f : A → EdgeCertificate} (hv : Primrec v) (_hn : Primrec n) (hf : Primrec f) :
    Primrec fun x => chosenB (v x) (n x) (f x) := by
  have a := edgeARec.comp hf; have b := edgeBRec.comp hf
  have odd := Primrec.eq.comp (flagRec 4 a) (.const true)
  have last := Primrec.ite odd (flagRec 0 a) (flagRec 1 a)
  have next := Primrec.ite (Primrec.eq.comp last (.const true)) (edgeDownRec.comp hf) (Primrec.ite odd (edgeLeftRec.comp hf) (edgeRightRec.comp hf))
  have corner := Primrec.and.comp (Primrec.and.comp (Primrec.and.comp (flagRec 2 b) (flagRec 0 b))
    (Primrec.not.comp (flagRec 4 b))) (Primrec.not.comp (flagRec 5 b))
  exact Primrec.ite (Primrec.eq.comp (Primrec.and.comp last (flagRec 3 a)) (.const true))
    (Primrec.and.comp corner (Primrec.and.comp (Primrec.or.comp (portRec hv (.const 4) a b) (portRec hv (.const 4) b a))
      (order2Rec hv (ownerRec.comp b) (.const 0) (ownerRec.comp a) (.const 0))))
    (Primrec.and.comp (Primrec.eq.comp next b).decide (order2Rec hv (ownerRec.comp a) (.const 0) (ownerRec.comp b) (.const 0)))
theorem queryRec {v : A → Env} {n : A → Nat} {f : A → EdgeCertificate} (hv : Primrec v) (hn : Primrec n) (hf : Primrec f) :
    Primrec fun x => queryB (v x) (n x) (f x) :=
  Primrec.and.comp (nodeMarkedRec hv (edgeARec.comp hf) (.const true)) (Primrec.and.comp
    (nodeMarkedRec hv (edgeBRec.comp hf) (.const false)) (Primrec.and.comp (localRec hv hn hf) (chosenRec hv hn hf)))
theorem namesRec {n : A → Nat} {f : A → EdgeCertificate} (_hn : Primrec n) (hf : Primrec f) :
    Primrec fun x => P455EdgeProjection.names (system (n x)) (f x) := by
  have a := edgeARec.comp hf; have b := edgeBRec.comp hf
  have rightActive := Primrec.not.comp (flagRec 1 a); have bottom := Primrec.not.comp (flagRec 3 a)
  let cons := @Primrec.list_cons (Node × Bool) _
  have fin := cons.comp ((edgeDiagonalRec.comp hf).pair (Primrec.and.comp rightActive bottom)) (.const [])
  have up := cons.comp ((edgeUpRec.comp hf).pair (Primrec.not.comp (flagRec 2 a))) fin
  have down := cons.comp ((edgeDownRec.comp hf).pair bottom) up
  have leftList := cons.comp ((edgeLeftRec.comp hf).pair (Primrec.not.comp (flagRec 0 a))) down
  have rest := cons.comp ((edgeRightRec.comp hf).pair rightActive) leftList
  have candidates := cons.comp (a.pair (.const true)) (cons.comp (b.pair (.const true)) rest)
  have active := P455GraphPrim.filter candidates (Primrec.snd.comp Primrec.snd).to₂
  have nodes := Primrec.list_map active (Primrec.fst.comp Primrec.snd).to₂
  exact Primrec.list_flatMap nodes (rolesRec.comp Primrec.snd).to₂
theorem sameRec {s t : A → List Nat} (hs : Primrec s) (ht : Primrec t) : Primrec fun x => sameNames (s x) (t x) :=
  Primrec.and.comp (P455FramePrim.allB hs (memRec Primrec.snd (ht.comp Primrec.fst)).to₂)
    (P455FramePrim.allB ht (memRec Primrec.snd (hs.comp Primrec.fst)).to₂)
theorem envRec {r : A → Nat} {ts : A → List (List Bool)} {w : A → List Nat} {k : A → Quad}
    (hr : Primrec r) (ht : Primrec ts) (hw : Primrec w) (hk : Primrec k) :
    Primrec fun x => env (r x) (ts x) (w x) (k x) := by
  have z := Primrec.snd.comp hk
  exact hr.pair (ht.pair ((Primrec.list_cons.comp ((Primrec.fst.comp hk).pair (Primrec.fst.comp z))
    (Primrec.list_cons.comp (Primrec.snd.comp z) (.const []))).pair hw))
theorem testsRec {r n : A → Nat} {ts : A → List (List Bool)} {w : A → List Nat} {k : A → Quad}
    (hr : Primrec r) (hn : Primrec n) (ht : Primrec ts) (hw : Primrec w) (hk : Primrec k) :
    Primrec fun x => tests (r x) (n x) (ts x) (w x) (k x) := by
  have p := Primrec.fst (α:=A) (β:=EdgeCertificate)
  have f := Primrec.snd (α:=A) (β:=EdgeCertificate)
  have a := edgeARec.comp f; have b := edgeBRec.comp f; have k := hk.comp p
  have z := Primrec.snd.comp k; have t := Primrec.snd.comp z
  have eqB := (Primrec.eq.comp (ownerRec.comp a) (Primrec.fst.comp k)).and <|
    (Primrec.eq.comp (mateRec.comp a) (Primrec.fst.comp z)).and <|
    (Primrec.eq.comp (ownerRec.comp b) (Primrec.fst.comp t)).and (Primrec.eq.comp (mateRec.comp b) (Primrec.snd.comp t))
  exact Primrec.and.comp (P455FrameProof.capCheck hr hw) (P455GraphPrim.anyB (certificatesRec hw ht) (Primrec.and.comp eqB.decide
    (Primrec.and.comp (sameRec (hw.comp p) (namesRec (hn.comp p) f)) (queryRec ((envRec hr ht hw hk).comp p) (hn.comp p) f))).to₂)
theorem edgesRec {r n : A → Nat} {ts : A → List (List Bool)} (hr : Primrec r) (hn : Primrec n) (ht : Primrec ts) :
    Primrec fun x => edges (r x) (n x) (ts x) := by
  apply familyRec hr
  have p := Primrec.fst.comp (Primrec.fst (α:=A × List Nat) (β:=Quad))
  exact testsRec (hr.comp p) (hn.comp p) (ht.comp p) (Primrec.snd.comp Primrec.fst) Primrec.snd
end P455WriterEdge
end
