namespace P455PaddedPorts
open P455RectangleRank Problem455.Slots
theorem count_one {ks : W} (nd : ks.Nodup) {a : Nat} (m : a∈ks) : ks.count a = 1 := by
  induction ks with
  | nil => simp at m
  | cons x ks ih =>
    obtain ⟨out,tail⟩ := List.nodup_cons.mp nd
    by_cases e : a = x
    · subst x; simp [List.count_cons,List.count_eq_zero.mpr out]
    · have z : a∈ks := by simpa [e] using m
      simp [List.count_cons,e,Ne.symm e,ih tail z]
theorem count_phase (bs : List Block) (c : Nat) :
    (phase bs).count c = 2*(bs.flatMap cells).count c := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    change ((cells b ++ cells b) ++ phase bs).count c = 2*((cells b) ++ bs.flatMap cells).count c
    simp only [List.count_append,ih]; omega
theorem count_role (s : W) (c a : Nat) (target : a = owner c ∨ a = mate c) :
    (s.flatMap roles).count a = s.count c := by
  induction s with
  | nil => rfl
  | cons k s ih =>
    simp only [List.flatMap_cons,List.count_append,ih]
    by_cases eq : k = c
    · subst k
      rcases target with rfl|rfl <;> simp [roles,List.count_cons,owner,mate] <;> omega
    · have non : a∉roles k := by
        unfold roles
        simp only [List.mem_cons,List.not_mem_nil,or_false]
        unfold owner mate at target ⊢; omega
      simp [List.count_eq_zero.mpr non,List.count_cons,eq,Ne.symm eq]
theorem indexed_window {ks pre mid post : W} {k : Nat} (nd : ks.Nodup)
    (before : ∀ a∈ks, pre.count a = k) (inside : ∀ a∈ks, mid.count a = 2) :
    sees (pre++mid++post) (stamp (fun _=>k) (ks++ks)) ↔ select ks mid = ks++ks := by
  let active (e : Event) := decide (e.1∈ks ∧ k ≤ e.2 ∧ e.2 < k+2)
  let zero : Nat → Nat := fun _=>0
  let p : Nat → Nat := fun a=>pre.count a
  let q : Nat → Nat := fun a=>pre.count a+mid.count a
  have whole : events (pre++mid++post) = stamp zero pre ++ (stamp p mid ++ stamp q post) := by
    simp only [List.append_assoc,events,stamp_append]
    have e : advance (fun _=>0) pre = p := by funext a; simp [advance,p]
    have f : advance p mid = q := by rfl
    rw [e,f]
  have none₁ : (stamp zero pre).filter active=[] := by
    apply List.filter_eq_nil_iff.mpr
    rintro ⟨a,i⟩ mem yes
    obtain ⟨m,lo,_⟩ := of_decide_eq_true yes
    have lim := (P455ContactGeometry.stamp_range zero pre mem).2
    change i < 0+pre.count a at lim
    have := before a m; omega
  have none₂ : (stamp q post).filter active=[] := by
    apply List.filter_eq_nil_iff.mpr
    rintro ⟨a,i⟩ mem yes
    obtain ⟨m,_,hi⟩ := of_decide_eq_true yes
    have lim := (P455ContactGeometry.stamp_range q post mem).1
    change pre.count a+mid.count a ≤ i at lim
    have := before a m; have := inside a m; omega
  have middle : (stamp p mid).filter active = stamp (fun _=>k) (select ks mid) := by
    rw [P455ContactGeometry.project_stamp ks mid (fun _=>k) p (fun a m => (before a m).symm)]
    apply List.filter_congr
    rintro ⟨a,i⟩ mem
    by_cases m : a∈ks
    · have lim := P455ContactGeometry.stamp_range p mid mem
      change pre.count a ≤ i ∧ i < pre.count a+mid.count a at lim
      have := before a m; have := inside a m
      simp [active,m,show k ≤ i by omega,show i < k+2 by omega]
    · simp [active,m]
  have observed : (events (pre++mid++post)).filter active = stamp (fun _=>k) (select ks mid) := by
    simp only [whole,List.filter_append,none₁,none₂,middle,List.append_nil,List.nil_append]
  have full : (stamp (fun _=>k) (ks++ks)).filter active = stamp (fun _=>k) (ks++ks) := by
    apply List.filter_eq_self.mpr
    rintro ⟨x,i⟩ m
    have mem := stamped_mem_label (fun _=>k) (ks++ks) _ m
    have mx : x∈ks := by simpa using mem
    have lim := P455ContactGeometry.stamp_range (fun _=>k) (ks++ks) m
    simp only [List.count_append,count_one nd mx] at lim
    exact decide_eq_true ⟨mx,lim.1,by omega⟩
  constructor
  · intro seq
    have sub := seq.filter active
    change ((stamp (fun _=>k) (ks++ks)).filter active).Sublist ((events (pre++mid++post)).filter active) at sub
    rw [full,observed] at sub
    have words := sub.map Prod.fst
    simp only [labels_of_stamp] at words
    have perm : (select ks mid).Perm (ks++ks) := by
      apply List.perm_iff_count.mpr
      intro a
      by_cases m : a∈ks
      · unfold select
        rw [List.count_filter (p:=fun e => decide (e ∈ ks)) (decide_eq_true m),List.count_append,inside a m,count_one nd m]
      · have no : a∉select ks mid := by simp [select,m]
        simp [List.count_eq_zero.mpr no,List.count_eq_zero.mpr m]
    exact (words.eq_of_length perm.length_eq.symm).symm
  · intro eq
    rw [←eq,←observed]
    exact List.filter_sublist ..
def portPattern (i j k : Nat) : List Event :=
  [(owner i,k),(mate i,k),(owner j,k),(mate j,k),
   (owner i,k+1),(mate i,k+1),(owner j,k+1),(mate j,k+1)]
theorem indexed_port_exact {bs : List Block} {pre post : W} {i j k : Nat} (ne : i≠j)
    (nd : (bs.flatMap cells).Nodup) (mi : i∈bs.flatMap cells) (mj : j∈bs.flatMap cells)
    (prefixCount : ∀ a∈roles i ++ roles j, pre.count a = k) :
    sees (pre++letters bs++post) (portPattern i j k) ↔ Block.pair i j∈bs := by
  let ks := roles i ++ roles j
  have dis : owner i≠mate i ∧ owner j≠mate j ∧ owner i≠owner j ∧ owner i≠mate j ∧
      mate i≠owner j ∧ mate i≠mate j := by unfold owner mate; omega
  have nod : ks.Nodup := by simp [ks,roles,dis.1,dis.2.1,dis.2.2.1,dis.2.2.2.1,dis.2.2.2.2.1,dis.2.2.2.2.2]
  have window (a) (used : a∈ks) : (letters bs).count a = 2 := by
    have ea : (a = owner i ∨ a = mate i) ∨ (a = owner j ∨ a = mate j) := by
      simpa only [ks,roles,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] using used
    rcases ea with ai|aj
    · rw [letters,count_role _ i a ai,count_phase,count_one nd mi]
    · rw [letters,count_role _ j a aj,count_phase,count_one nd mj]
  have ev : stamp (fun _=>k) (ks++ks) = portPattern i j k := by
    rw [stamp_append,stamp_at (fun _=>k) k ks nod (fun _ _ => rfl),
      stamp_at (advance (fun _=>k) ks) (k+1) ks nod (fun a m=>by simp [advance,count_one nod m])]
    rfl
  rw [← ev,indexed_window nod prefixCount window]
  exact literal_phase_exact nd i j ne
theorem oriented_port_iff {r : Nat} (hr : 16 ≤ r) (allow : P455Witness.Tag → Prop)
    (mark : P455Witness.Marking) (port : Fin 5) (tagI tagJ : P455Witness.Tag)
    {bs : List Block} {pre post : W} {i j : Nat} (ne : i≠j)
    (nd : (bs.flatMap cells).Nodup) (mi : i∈bs.flatMap cells) (mj : j∈bs.flatMap cells)
    (prefixCount : ∀ a∈roles i ++ roles j, pre.count a = 3+2*port.val) :
    let a : P455Witness.Node := ⟨owner i,mate i,tagI⟩
    let b : P455Witness.Node := ⟨owner j,mate j,tagJ⟩
    let H := P455Witness.Holds r allow mark (pre++letters bs++post)
    H (P455Witness.orientedPort port.val a b) ↔ H (P455Witness.typedNode a) ∧
      H (P455Witness.typedNode b) ∧ H (P455Witness.earlyDisjoint (roles i) (roles j)) ∧
      Block.pair i j∈bs := by
  dsimp only
  have obs := indexed_port_exact (post:=post) ne nd mi mj prefixCount
  constructor
  · rintro ⟨ta,tb,ear,ord,_⟩
    exact ⟨ta,tb,ear,obs.mp ord.2⟩
  · rintro ⟨ta,tb,ear,matchEdge⟩
    refine ⟨ta,tb,ear,⟨?_,obs.mpr matchEdge⟩,True.intro⟩
    intro e m
    have lt := port.isLt
    simp only [List.mem_cons,List.not_mem_nil,or_false] at m
    rcases m with h|h|h|h|h|h|h|h <;> rw [h] <;> dsimp <;> omega
end P455PaddedPorts
end
section
namespace P455EffectiveRelabel
open P455MachineLocal P455MachineCleanup P455MachineTable P455EffectiveMachine
open P455EffectiveChain
structure Emb (g h : Nat) where
  enc : Fin g → Fin h
  back : Fin h → Fin g
  undo : ∀ a, back (enc a) = a
theorem Emb.inj (e : Emb g h) (a b) : e.enc a = e.enc b ↔ a = b := by
  constructor
  · intro eq; simpa only [e.undo] using congrArg e.back eq
  · intro eq; rw [eq]
def mapped (e : Emb g h) (i : Ins (Fin g) (Fin q)) : Ins (Fin h) (Fin q) :=
  ⟨i.state,e.enc i.symbol,i.dir⟩
def expand (M : Ordinary g q) (e : Emb g h) : Ordinary h q where
  marker := e.enc M.marker
  blank := e.enc M.blank
  blank_ne := fun equ => M.blank_ne ((e.inj ..).mp equ)
  start := M.start
  delta s x := if x = e.enc (e.back x) then (M.delta s (e.back x)).map (mapped e) else none
  keeps := by
    intro s x i yes
    split at yes
    next right =>
      cases st : M.delta s (e.back x) with
      | none => simp [st] at yes
      | some z =>
        rw [st] at yes; obtain rfl := Option.some.inj yes
        change e.enc z.symbol = e.enc M.marker ↔ x = e.enc M.marker
        exact (e.inj ..).trans ((M.keeps _ _ _ st).trans
          ⟨fun eq => right.trans (congrArg e.enc eq), fun eq =>
            (e.inj ..).mp (right.symm.trans eq)⟩)
    next => contradiction
  leftSafe := by
    intro s i yes
    simp only [e.undo,if_true] at yes
    cases st : M.delta s M.marker with
    | none => simp [st] at yes
    | some z =>
      rw [st] at yes; obtain rfl := Option.some.inj yes
      exact M.leftSafe _ _ st
def alpha (M : Ordinary g q) (A : Alphabet M) (e : Emb g h) : Alphabet (expand M e) where
  bit b := e.enc (A.bit b)
  away b eq := A.away b ((e.inj ..).mp eq)
  ink b eq := A.ink b ((e.inj ..).mp eq)
  distinct eq := A.distinct ((e.inj ..).mp eq)
def conf (e : Emb g h) (c : Config g q) : Config h q := ⟨fun j => e.enc (c.tape j),c.pos,c.state⟩
theorem input_tape (M : Ordinary g q) (A : Alphabet M) (e : Emb g h) (w : List Bool) (j) :
    inputTape (expand M e) (alpha M A e) w j = e.enc (inputTape M A w j) := by
  cases j with
  | zero => rfl
  | succ j => cases eq : w[j]? <;> simp [inputTape,eq,expand,alpha]
theorem exp_instruction (M : Ordinary g q) (e : Emb g h) (c : Config g q) :
    instruction (expand M e) (conf e c) = (instruction M c).map (mapped e) := by
  simp [instruction,expand,conf,e.undo]
theorem exp_once (M : Ordinary g q) (e : Emb g h) (c : Config g q) :
    once (expand M e) (conf e c) = conf e (once M c) := by
  unfold once; rw [exp_instruction]
  cases st : instruction M c with
  | none => rfl
  | some z =>
    have tape : writeAt (conf e c).tape c.pos (e.enc z.symbol) = fun j=>e.enc (writeAt c.tape c.pos z.symbol j) := by
      funext j; by_cases eq : j = c.pos <;> simp [conf,writeAt,eq]
    exact congrArg (fun f => Config.mk f (dest z.dir c.pos) z.state) tape
theorem exp_run (M : Ordinary g q) (A : Alphabet M) (e : Emb g h) (w t) :
    follow (expand M e) (inputConfig (expand M e) (alpha M A e) w) t=
      conf e (follow M (inputConfig M A w) t) := by
  induction t with
  | zero =>
    exact congrArg (fun f => Config.mk f 0 M.start) (funext (input_tape M A e w))
  | succ t ih => simp only [follow,ih,exp_once]
theorem exp_answers (M : Ordinary g q) (A : Alphabet M) (e : Emb g h) {ans w b}
    (out : Answers M A ans w b) : Answers (expand M e) (alpha M A e) ans w b := by
  obtain ⟨t,stop,ok⟩ := out
  refine ⟨t,?_⟩
  simp only [exp_run]
  constructor
  · rw [exp_instruction,stop]; rfl
  · exact ok
def number (M : Ordinary g q) (A : Alphabet M) (base : Nat) (a : Fin g) :=
  if a = M.marker then 0 else if a = M.blank then 1 else if a = A.bit false then 2 else if a = A.bit true then 3 else base+a.val
def denumber (M : Ordinary g q) (A : Alphabet M) (base y : Nat) :=
  if y = 0 then M.marker else if y = 1 then M.blank else if y = 2 then A.bit false else if y = 3 then A.bit true
  else if h : y-base < g then (⟨y-base,h⟩ : Fin g) else M.blank
theorem number_lt (M : Ordinary g q) (A : Alphabet M) (lo : 4 ≤ base) (hi : base+g ≤ h) (a : Fin g) :
    number M A base a < h := by
  have small := a.isLt
  unfold number
  split <;> (first | omega | split <;> (first | omega | split <;> (first | omega | split <;> omega)))
theorem denumber_number (M : Ordinary g q) (A : Alphabet M) (lo : 4 ≤ base) (a : Fin g) :
    denumber M A base (number M A base a) = a := by
  unfold number
  split
  next eq => simp [denumber,eq]
  next =>
    split
    next eq => simp [denumber,eq]
    next =>
      split
      next eq => simp [denumber,eq]
      next =>
        split
        next eq => simp [denumber,eq]
        next =>
          have zero : base+a.val≠0 := by omega
          have one : base+a.val≠1 := by omega
          have two : base+a.val≠2 := by omega
          have three : base+a.val≠3 := by omega
          simp [denumber,zero,one,two,three,Nat.add_sub_cancel_left,a.isLt] <;> omega
def common (M : Ordinary g q) (A : Alphabet M) (lo : 4 ≤ base) (hi : base+g ≤ h) : Emb g h :=
  ⟨fun a => ⟨number M A base a,number_lt M A lo hi a⟩,fun a => denumber M A base a.val,denumber_number M A lo⟩
@[simp] theorem mark_number (M : Ordinary g q) (A : Alphabet M) (base) : number M A base M.marker = 0 := by
  simp [number]
@[simp] theorem blank_number (M : Ordinary g q) (A : Alphabet M) (base) : number M A base M.blank = 1 := by
  simp [number,M.blank_ne]
@[simp] theorem bit_number (M : Ordinary g q) (A : Alphabet M) (base) (b : Bool) :
    number M A base (A.bit b) = if b then 3 else 2 := by
  cases b <;> simp [number,A.away,A.ink,Ne.symm A.distinct]
end P455EffectiveRelabel
end
section
namespace P455SlotProduct
open P455Witness P455Paths P455SourceFamilies P455CrossedSupport Problem455.Slots
def pairMark (a b : Nat) : Marking := fun x y => x = a ∧ y = b
private theorem remove_count (w : W) (a : Nat) :
    (w.filter (· != a)).length + w.count a = w.length := by
  induction w with
  | nil => rfl
  | cons b t ih =>
    by_cases eq : a = b
    · subst b; simp [List.count_cons] at ih ⊢; omega
    · simp [List.count_cons,eq,Ne.symm eq,beq_iff_eq] at ih ⊢; omega
theorem capped_length {r : Nat} (k : Nat) (w : W) (cap : P455Closure.Cap r w)
    (names : ∀ x ∈ w, x < k) : w.length ≤ k*r := by
  induction k generalizing w with
  | zero => cases w with
            | nil => simp
            | cons x xs => exact False.elim (Nat.not_lt_zero _ (names x (by simp)))
  | succ k ih =>
    have cp : P455Closure.Cap r (w.filter (· != k)) :=
      fun x => Nat.le_trans (List.Sublist.count_le x List.filter_sublist) (cap x)
    have low := ih _ cp (fun x hx => by
      obtain ⟨mem,p⟩ := List.mem_filter.mp hx
      have h := names x mem
      have e : x ≠ k := by simpa [bne_iff_ne] using p
      omega)
    have ct := cap k
    have tot := remove_count w k
    rw [Nat.succ_mul]; omega
def image (keep : W) (a : Nat) : W := if a ∈ keep then [keep.idxOf a] else []
theorem image_word (keep w : W) :
    w.flatMap (image keep) = (select keep w).map keep.idxOf := by
  induction w with
  | nil => rfl
  | cons a t ih => by_cases h : a ∈ keep <;> simp [image,select,h,ih, List.flatMap_cons] at *
private theorem tag_map (x y : Nat) (t : Tag) :
    (t.flatMap P455Closure.phasePair).map (fun b => if b then y else x) = t.flatMap (pair x y) := by
  induction t with
  | nil => rfl
  | cons b t ih => cases b <;> simp [List.flatMap_cons,P455Closure.phasePair,pair,ih]
theorem profile_eq (x y : Nat) (t : Tag) (b : Bool) :
    P455Closure.Frame.profileWord x y t b = profile x y t b := by
  cases b <;> simp [P455Closure.Frame.profileWord,P455Closure.Frame.profileBits,
    P455Closure.fixedPhases,P455Closure.phasePair,profile,profilePrefix,pair,
    List.replicate_succ,tag_map,List.append_assoc]
theorem flip_anchor {r allow u x y} (cap : P455Closure.Cap r u)
    (flip : ClosedFlip r allow u x y) : ∃ tag bit,
    Holds r allow (markNode ⟨x,y,tag⟩) u (markedNode ⟨x,y,tag⟩ bit) := by
  obtain ⟨_,_,_,ne⟩ := flip_counts cap flip
  obtain ⟨f,b,l,k,hp,hq,ok,rfl⟩ := flip
  refine ⟨f.tag,b,ne,by change f.tag.length + 16 = r; have h := ok.1; omega,ok.2.1,.inl ⟨rfl,rfl⟩,?_⟩
  have h := f.cross_projection ok b l k cap x y (by simp [hp]) (by simp [hq])
  simpa [select,profile_eq] using h
end P455SlotProduct
end
section
namespace P455PaddedMatchings
open P455PaddedTiles
def rowEnd (w y x : Nat) : Prop := if odd y then x = 0 else x+1 = w
def Next (w y x v z : Nat) : Prop :=
  (odd y = false ∧ v = y ∧ z = x+1) ∨
  (odd y = true ∧ v = y ∧ z+1 = x) ∨
  (v = y+1 ∧ z = x ∧ rowEnd w y x)
theorem odd_succ (y : Nat) : odd (y+1)= !odd y := by
  by_cases e : y%2 = 1
  · simp [odd,e,show (y+1)%2≠1 by omega]
  · simp [odd,e,show (y+1)%2 = 1 by omega]
theorem first_id (w : Nat) : idAt w 0 0 = 0 := by simp [idAt,odd]
theorem end_id {w y x : Nat} (hx : x < w) (endRow : rowEnd w y x) :
    idAt w y x+1 = w*(y+1) := by
  cases par : odd y <;> simp [rowEnd,par] at endRow <;> simp [idAt,par,Nat.mul_add] <;> omega
theorem down_id {w y x : Nat} (hx : x < w) (endRow : rowEnd w y x) :
    idAt w (y+1) x = idAt w y x+1 := by
  rw [end_id hx endRow]
  cases par : odd y <;> simp [rowEnd,par] at endRow <;> simp [idAt,odd_succ,par] <;> omega
theorem stepping {w h i : Nat} (bound : i+1 < w*h) :
    ∃ y < h, ∃ x < w, ∃ v < h, ∃ z < w, idAt w y x = i ∧ idAt w v z = i+1 ∧ Next w y x v z := by
  obtain ⟨y,hy,x,hx,eq⟩ := id_covers (show i < w*h by omega)
  refine ⟨y,hy,x,hx,?_⟩
  by_cases b : rowEnd w y x
  · have jy : y+1 < h := by
      by_cases strict : y+1 < h
      · exact strict
      · have e : y+1 = h := by omega
        have endPos := end_id hx b
        rw [e,eq] at endPos; omega
    exact ⟨y+1,jy,x,hx,eq,(down_id hx b).trans (congrArg (·+1) eq),.inr (.inr ⟨rfl,rfl,b⟩)⟩
  · cases par : odd y with
    | false =>
      simp [rowEnd,par] at b
      refine ⟨y,hy,x+1,by omega,eq,?_,.inl ⟨par,rfl,rfl⟩⟩
      simp [idAt,par] at eq ⊢; omega
    | true =>
      simp [rowEnd,par] at b
      refine ⟨y,hy,x-1,by omega,eq,?_,.inr (.inl ⟨par,rfl,by omega⟩)⟩
      simp [idAt,par] at eq ⊢; omega
theorem last_cell {w h : Nat} (pos : 0 < w*h) :
    ∃ y < h, ∃ x < w, y+1 = h ∧ rowEnd w y x ∧ idAt w y x = w*h-1 := by
  have wy : 0 < w := by cases w with | zero => simp at pos | succ => omega
  have hy : 0 < h := by cases h with | zero => simp at pos | succ => omega
  let y := h-1
  let x := if odd y then 0 else w-1
  have hx : x < w := by dsimp [x]; split <;> omega
  have b : rowEnd w y x := by cases p : odd y <;> simp [rowEnd,x,p] <;> omega
  have e : y+1 = h := by dsimp [y]; omega
  have z := end_id hx b
  rw [e] at z
  exact ⟨y,by dsimp [y]; omega,x,hx,e,b,by omega⟩
def decodeRow (w i : Nat) := i/w
def decodeCol (w i : Nat) := if odd (decodeRow w i) then w-1-(i%w) else i%w
theorem decode_id {w y x : Nat} (hx : x < w) :
    decodeRow w (idAt w y x) = y ∧ decodeCol w (idAt w y x) = x := by
  have wt : 0 < w := by omega
  have off : (if odd y then w-1-x else x) < w := by split <;> omega
  have yr : decodeRow w (idAt w y x) = y := by
    simp [decodeRow,idAt,Nat.mul_add_div wt,Nat.div_eq_of_lt off]
  refine ⟨yr,?_⟩
  unfold decodeCol
  rw [yr]
  simp only [idAt,Nat.mul_add_mod,Nat.mod_eq_of_lt off]
  cases p : odd y <;> simp <;> omega
def tagAt (w : Nat) (tile : Nat → Nat → List Bool) (i : Nat) :=
  tile (decodeRow w i) (decodeCol w i)
theorem tag_id (tile : Nat → Nat → List Bool) {w y x : Nat} (hx : x < w) :
    tagAt w tile (idAt w y x) = tile y x := by simp [tagAt,(decode_id hx).1,(decode_id hx).2]
end P455PaddedMatchings
end
