namespace P455MarkedRank
open P455Witness P455SourceFamilies P455CrossedSupport P455SingletonEvaluation
open P455SlotSaturation P455ActualGuards P455Uncrossed P455Compression P455FirstRewrite
open P455FirstTesters P455SupportBound Problem455.Slots
abbrev W := List Nat
def model (r : Nat) (allow : Tag → Prop) (ts : Tiles) :=
  combine (P455GuardProduct.product r allow ts) (P455EdgeProduct.product r allow ts)
theorem eval_pair {A B : Type} (M : Model A) (N : Model B) (v : Nat → A × B) (w : W) :
    (combine M N).eval v w = (M.eval (fun a => (v a).1) w,N.eval (fun a => (v a).2) w) := by
  induction w with
  | nil => rfl
  | cons a w ih => change (_,_) = (_,_); rw [ih]; rfl
theorem valid_pair {A B : Type} (M : Model A) (N : Model B) (u v : W) :
    (combine M N).Valid u v ↔ M.Valid u v ∧ N.Valid u v := by
  constructor
  · intro h; refine ⟨valid_left M N h,?_⟩
    intro f
    have e := h (fun a => (M.unit,f a))
    simpa only [eval_pair,Prod.mk.injEq] using (congrArg Prod.snd e)
  · rintro ⟨m,n⟩ val
    rw [eval_pair,eval_pair,m,n]
theorem endpoint_feasible {r allow ts u w x y} (cap : P455Closure.Cap r u)
    (ident : (model r allow ts).Valid u w) (changed : select [x,y] u ≠ select [x,y] w) :
    ¬ EdgeViolation r allow ts u x y := by
  rintro ⟨e,s,match',read⟩
  have obs := P455EdgeProduct.endpoint_observed cap ((valid_pair ..).mp ident).2 e read
  have diff := matched_change _ match' changed
  cases s
  · exact diff obs.1
  · exact diff obs.2
theorem edge_eval {r allow ts} (v : Nat → P455EdgeProduct.Carrier r allow ts)
    (i : P455EdgeProduct.Index r allow ts) (w : W) :
    (P455EdgeProduct.product r allow ts).eval v w i = P455Quotient.eval i.R i.cap (fun a => v a i) w := by
  induction w with
  | nil => rfl
  | cons x _ ih => exact congrArg (P455Quotient.mul i.R i.cap (v x i)) ih
theorem edge_coordinate {r allow ts} (i : P455EdgeProduct.Index r allow ts) : ∃ c : Certificate,
    MarksOnly (P455EdgeProduct.marks i.a i.b i.c i.d) c ∧
    Holds r allow (P455EdgeProduct.marks i.a i.b i.c i.d) i.T (c.query r ts) := by
  obtain ⟨e,ea,eb,ec,ed,_,obs⟩ := i.test
  refine ⟨.edge e,?_,obs⟩
  intro a b h
  rcases h with h|h
  · exact ⟨false,.inl ⟨ea.trans h.1.symm,eb.trans h.2.symm⟩⟩
  · exact ⟨true,.inl ⟨ec.trans h.1.symm,ed.trans h.2.symm⟩⟩
def boundN := 2*(1+28)*geometric 28 6
def bound (r : Nat) := boundN + r*boundN + 1
theorem small_valid {r allow ts} (f : P455Closure.Frame Nat) (l k : W) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (fv : f.Valid r allow noMark)
    (capF : P455Closure.Cap r (side f l k false))
    (u₀ w : W) (cap₀ : P455Closure.Cap r u₀)
    (identity : (P455GuardProduct.product r allow ts).Valid u₀ w)
    (flip₀ : ClosedFlip r allow u₀ x y) (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (side f l k false))
    (cmp : Compressed r (side f l k false)) (feasible : ∀ b, ¬ EdgeViolation r allow ts (side f l k b) x y) :
    let keep := retained r allow noMark (side f l k false) x y
    (model r allow ts).Valid (small (side f l k false) keep) (small (side f l k true) keep) := by
  dsimp only
  apply (valid_pair ..).mpr
  constructor
  · intro val; funext i
    obtain ⟨c,only,test⟩ := P455LocalIdentity.guard_coordinate i
    rw [P455LocalIdentity.coordinate_eval,P455LocalIdentity.coordinate_eval]
    exact P455LocalIdentity.marked_equal i.cap ts c only test f l k x y hp hq fv capF
      u₀ w cap₀ identity flip₀ changed path cmp feasible _
  · intro val; funext i
    obtain ⟨c,only,test⟩ := edge_coordinate i
    rw [edge_eval,edge_eval]
    exact P455LocalIdentity.marked_equal i.cap ts c only test f l k x y hp hq fv capF
      u₀ w cap₀ identity flip₀ changed path cmp feasible _
end P455MarkedRank
end
section
namespace P455BinaryProduct
open P455Witness P455FirstRewrite P455FirstTesters P455BinaryEquality P455SlotSaturation
open P455Uncrossed Problem455.Slots
abbrev W := List Nat
structure Index (r : Nat) (allow : Tag → Prop) where
  num : Fin (Problem455Finite.wordsUpTo [0,1] (2*r)).length
  prof : Bool
  cap : P455Closure.Cap r ((Problem455Finite.wordsUpTo [0,1] (2*r)).get num)
  ok : let T := (Problem455Finite.wordsUpTo [0,1] (2*r)).get num
       (T = power r ∨ (0 < T.count 0 ∧ 0 < T.count 1)) ∧ (prof = true ↔ IsProfile r allow T)
def Index.T (i : Index r allow) := (Problem455Finite.wordsUpTo [0,1] (2*r)).get i.num
def Index.R (i : Index r allow) := if i.prof then rules r allow noMark else plain r
theorem Index.bound (i : Index r allow) : P455Quotient.Cap i.R.r i.T := by
  cases b : i.prof <;> simpa [Index.R,Index.T,b,plain,rules,Problem455Finite.rules,P455Quotient.Cap,P455Closure.Cap] using i.cap
abbrev Carrier (r : Nat) (allow : Tag → Prop) := (i : Index r allow) → P455Quotient.Q i.R i.T
def model (r : Nat) (allow : Tag → Prop) : Model (Carrier r allow) where
  op := fun x y i => P455Quotient.mul i.R i.bound (x i) (y i)
  unit := fun i => P455Quotient.ofWord i.R i.T []
  assoc := fun x y z => funext (fun i => P455Quotient.mul_assoc i.R i.bound (x i) (y i) (z i))
  oneL := fun x => funext (fun i => (P455Quotient.unit_laws i.R i.bound (x i)).1)
  oneR := fun x => funext (fun i => (P455Quotient.unit_laws i.R i.bound (x i)).2)
theorem eval_at (i : Index r allow) (v : Nat → Carrier r allow) (w : W) :
    (model r allow).eval v w i = P455Quotient.eval i.R i.bound (fun x => v x i) w := by
  induction w with
  | nil => rfl
  | cons a w ih => exact congrArg (P455Quotient.mul i.R i.bound (v a i)) ih
theorem empty_mark_eval {r allow T} (cap : P455Closure.Cap r T)
    (f : P455Closure.Frame Nat) (l k : W) (x y : Nat) (hp : f.p = [x]) (hq : f.q = [y])
    (fv : f.Valid r allow noMark) (val : Nat → P455Quotient.Q (rules r allow noMark) T) :
    P455Quotient.eval (rules r allow noMark) cap val (side f l k false) =
    P455Quotient.eval (rules r allow noMark) cap val (side f l k true) := by
  apply Classical.byContradiction
  intro diff
  obtain ⟨b,_,⟨h,rep⟩,_⟩ := difference_live_representatives cap f l k val diff
  have eq := uncrossed_eval cap f l k b x y hp hq fv val h (fun a m => (rep a m).2)
    (fun _ _ _ _ => ⟨id,id⟩)
  cases b
  · exact diff eq
  · exact diff eq.symm
theorem identity {r allow} (f : P455Closure.Frame Nat) (l k : W) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (fv : f.Valid r allow noMark) :
    (model r allow).Valid (side f l k false) (side f l k true) := by
  intro val; funext i; rw [eval_at,eval_at]
  have names : BinaryNames i.T := by
    intro a ha; have h := P455GuardSubproduct.letters (List.get_mem _ i.num) a ha
    simpa using h
  let w := side f l k
  have coord (R : P455Quotient.Rules Nat) (cap : P455Quotient.Cap R.r i.T)
      (eq : R = i.R) (any : ∀ v : Nat → P455Quotient.Q R i.T,
       P455Quotient.eval R cap v (w false) = P455Quotient.eval R cap v (w true)) :
      P455Quotient.eval i.R i.bound (fun x => val x i) (w false) =
        P455Quotient.eval i.R i.bound (fun x => val x i) (w true) := by subst R; exact any _
  cases bit : i.prof with
  | false =>
    apply coord (plain r) i.cap (by simp [Index.R,bit])
    exact plain_equal i.cap names (fun h => by have := i.ok.2.mpr h; simp_all) f l k x y hp hq fv
  | true =>
    apply coord (rules r allow noMark) i.cap (by simp [Index.R,bit])
    exact empty_mark_eval i.cap f l k x y hp hq fv
end P455BinaryProduct
end
section
namespace P455FullSingleton
open P455Witness P455SourceFamilies P455CrossedSupport P455ActualGuards
open P455MarkedRank P455Uncrossed P455Compression P455FirstRewrite
open P455FirstTesters P455SlotSaturation P455SupportBound Problem455.Slots
abbrev W := List Nat
def model (r : Nat) (allow : Tag → Prop) (ts : Tiles) :=
  combine (product r) (combine (P455MarkedRank.model r allow ts)
    (combine (P455BinaryProduct.model r allow) (P455StructuralProduct.product r allow)))
private theorem short {r : Nat} (hr : 0 < r) (i : P455FirstTesters.Index r) : i.val.length < 2*r := by
  rcases i.property with p|b
  · rw [p,power,List.length_replicate]; omega
  · have count {w : W} (names : ∀ x ∈ w, x = 0 ∨ x = 1) : w.length = w.count 0 + w.count 1 := by
      induction w with
      | nil => rfl
      | cons x t ih =>
        have tail := ih (fun a m => names a (List.mem_cons_of_mem _ m))
        rcases names x List.mem_cons_self with h|h <;> simp [h,tail,List.count_cons] <;> omega
    have len := count b.1
    have ac := b.2.1 0; have bc := b.2.1 1; have under := b.2.2.2.2
    omega
theorem primitive_identity {r allow} (f : P455Closure.Frame Nat) (l k : W) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (fv : f.Valid r allow noMark) :
    (product r).Valid (side f l k false) (side f l k true) := by
  have hr : 0 < r := by have := fv.1; omega
  intro val; funext i
  have eq (w : W) : (product r).eval val w i = P455Quotient.eval (plain r) i.cap (fun x => val x i) w := by
    induction w with
    | nil => rfl
    | cons a w ih => exact congrArg (P455Quotient.mul (plain r) i.cap (val a i)) ih
  rw [eq,eq]
  have binary : P455BinaryEquality.BinaryNames i.val := by
    rcases i.property with e|b
    · intro a m; rw [e] at m; exact .inl (List.eq_of_mem_replicate m)
    · exact b.1
  have notProf : ¬ P455BinaryEquality.IsProfile r allow i.val := by
    rintro ⟨a,b,t,bit,_,len,_,profileEq⟩
    have lt := short hr i
    rw [profileEq,P455ProfileComponent.profile_length,len] at lt; omega
  exact P455BinaryEquality.plain_equal i.cap binary notProf f l k x y hp hq fv _
theorem guard_valid {r allow ts u v} (valid : (model r allow ts).Valid u v) :
    (P455GuardProduct.product r allow ts).Valid u v :=
  ((valid_pair ..).mp (((valid_pair ..).mp ((valid_pair ..).mp valid).2).1)).1
theorem small_valid {r allow ts} (f : P455Closure.Frame Nat) (l k : W) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (fv : f.Valid r allow noMark)
    (capF : P455Closure.Cap r (side f l k false))
    (u₀ w : W) (cap₀ : P455Closure.Cap r u₀) (valid : (model r allow ts).Valid u₀ w)
    (flip₀ : ClosedFlip r allow u₀ x y) (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (side f l k false))
    (cmp : Compressed r (side f l k false)) (feasible : ∀ b, ¬ EdgeViolation r allow ts (side f l k b) x y) :
    let keep := retained r allow noMark (side f l k false) x y
    (model r allow ts).Valid (small (side f l k false) keep) (small (side f l k true) keep) := by
  let u := side f l k false
  let keep := retained r allow noMark u x y
  obtain ⟨lt,cx,cy,_⟩ := flip_counts capF (show ClosedFlip r allow u x y from ⟨f,false,l,k,hp,hq,fv,rfl⟩)
  have hx : x ∈ keep := mem_retained.mpr ⟨List.count_pos_iff.mp (cx.symm ▸ (by omega : 0 < r)),.inl (.inl (P455Paths.near_self ..))⟩
  have hy : y ∈ keep := mem_retained.mpr ⟨List.count_pos_iff.mp (cy.symm ▸ (by omega : 0 < r)),.inl (.inr (P455Paths.near_self ..))⟩
  obtain ⟨g,L,K,gp,gq,gv,both,_⟩ := P455CompressedFrame.canonical_pair f l k keep hx hy hp hq fv false capF
  change (model r allow ts).Valid (small (side f l k false) keep) (small (side f l k true) keep)
  have mark := P455MarkedRank.small_valid f l k x y hp hq fv capF u₀ w cap₀ (guard_valid valid)
    flip₀ changed path cmp feasible
  refine (valid_pair ..).mpr ⟨?_,(valid_pair ..).mpr ⟨mark,(valid_pair ..).mpr ⟨?_,?_⟩⟩⟩
  · rw [both,both]; exact primitive_identity g L K x y gp gq gv
  · rw [both,both]; exact P455BinaryProduct.identity g L K x y gp gq gv
  · rw [both,both]; exact P455StructuralProduct.identity g L K x y gp gq gv
theorem bounded_step {r allow ts} (f : P455Closure.Frame Nat) (l k : W) (x y : Nat)
    (hp : f.p = [x]) (hq : f.q = [y]) (fv : f.Valid r allow noMark)
    (capF : P455Closure.Cap r (side f l k false))
    (u₀ w : W) (cap₀ : P455Closure.Cap r u₀) (ident : (model r allow ts).Valid u₀ w)
    (flip₀ : ClosedFlip r allow u₀ x y) (changed : select [x,y] u₀ ≠ select [x,y] w)
    (path : P455Quotient.Walk (P455Closure.Move r allow noMark) u₀ (side f l k false))
    (cmp : Compressed r (side f l k false)) (feasible : ∀ b, ¬ EdgeViolation r allow ts (side f l k b) x y) :
    P455FirstRewrite.Step (fun a b => (model r allow ts).Valid a b ∧ rank a b ≤ bound r)
      (side f l k false) (side f l k true) := by
  apply bounded_step_of_capacity (model r allow ts) (mark := noMark) f l k hp hq fv false capF
  · exact capacity cap₀ (guard_valid ident) changed path flip₀ capF ⟨f,false,l,k,hp,hq,fv,rfl⟩ cmp
  · exact small_valid f l k x y hp hq fv capF u₀ w cap₀ ident flip₀ changed path cmp feasible
theorem no_basis_of_witnesses {r allow ts} (hr : 0 < r)
    (unbounded : ∀ k, ∃ U V D, RankWitness (model r allow ts) r U V D ∧ k < D.length)
    (basis : List (W × W)) (sound : ∀ u v, (u,v) ∈ basis → (model r allow ts).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (model r allow ts).Valid U V ∧ ¬ Derives (fun u v => (u,v) ∈ basis) U V :=
  first_change_no_finite_basis _ r hr unbounded basis sound
end P455FullSingleton
end
section
namespace P455FiniteModel
open P455FirstRewrite
def Covered (α : Type) := ∃ xs : List α, ∀ a, a ∈ xs
theorem from_codes {α β : Type} (f : α → β) (inj : ∀ a b, f a = f b → a = b)
    (xs : List β) (all : ∀ a, f a∈xs) : Covered α := by
  classical
  let pick (b : β) := if h : ∃ a, f a = b then [Classical.choose h] else []
  refine ⟨xs.flatMap pick,fun a => List.mem_flatMap.mpr ⟨f a,all a,?_⟩⟩
  have h : ∃ z, f z = f a := ⟨a,rfl⟩
  simp [pick,h,inj _ _ (Classical.choose_spec h)]
theorem fin (n : Nat) : Covered (Fin n) :=
  ⟨List.finRange n,fun a => by
    have h : a.val < (List.finRange n).length := by simp
    simpa using (List.getElem_mem (l := List.finRange n) h)⟩
theorem bool : Covered Bool := ⟨[false,true],fun b => by cases b <;> simp⟩
theorem sigma {ι : Type} {F : ι → Type} (base : Covered ι) (each : ∀ i, Covered (F i)) :
    Covered (Sigma F) := by
  obtain ⟨indices,all⟩ := base
  let vals (i) := Classical.choose (each i)
  refine ⟨indices.flatMap (fun i => (vals i).map (Sigma.mk i)),?_⟩
  rintro ⟨i,x⟩
  exact List.mem_flatMap.mpr ⟨i,all i,List.mem_map.mpr ⟨x,Classical.choose_spec (each i) x,rfl⟩⟩
theorem prod {α β : Type} (a : Covered α) (b : Covered β) : Covered (α×β) := by
  obtain ⟨xs,h⟩ := a; obtain ⟨ys,k⟩ := b
  exact ⟨xs.flatMap (fun x => ys.map (fun y => (x,y))),fun (x,y) =>
    List.mem_flatMap.mpr ⟨x,h x,List.mem_map.mpr ⟨y,k y,rfl⟩⟩⟩
theorem pi {ι : Type} {F : ι → Type} (base : Covered ι) (each : ∀ i, Covered (F i))
    (zero : ∀ i,F i) : Covered ((i : ι) → F i) := by
  classical
  obtain ⟨indices,all⟩ := base
  let set (f : (i : ι) → F i) (j : ι) (v : F j) := fun i : ι => if e : j = i then e ▸ v else f i
  have build (xs : List ι) : ∃ vs : List ((i : ι) → F i), ∀ f : (i : ι) → F i,
      ∃ g∈vs, ∀ i∈xs, g i = f i := by
    induction xs with
    | nil => exact ⟨[zero],fun _ => ⟨zero,by simp,by simp⟩⟩
    | cons j xs ih =>
      obtain ⟨gs,good⟩ := ih
      obtain ⟨ys,full⟩ := each j
      refine ⟨gs.flatMap (fun g => ys.map (set g j)),?_⟩
      intro f
      obtain ⟨g,mg,match'⟩ := good f
      refine ⟨set g j (f j),List.mem_flatMap.mpr ⟨g,mg,List.mem_map_of_mem (full _)⟩,?_⟩
      intro i mi
      by_cases e : j = i
      · subst i; simp [set]
      · simpa [set,e] using match' i ((List.mem_cons.mp mi).resolve_left (Ne.symm e))
  obtain ⟨gs,h⟩ := build indices
  refine ⟨gs,?_⟩; intro f
  obtain ⟨g,mg,agree⟩ := h f
  exact (funext (fun i => agree i (all i))) ▸ mg
theorem from_covered {α β : Type} (code : α → β) (inj : ∀ a b, code a = code b → a = b)
    (cov : Covered β) : Covered α := by
  obtain ⟨xs,h⟩ := cov
  exact from_codes code inj xs (fun _ => h _)
private theorem coordinate {ι : Type} (inds : Covered ι) (rs : ι → P455Quotient.Rules Nat)
    (ts : ι → List Nat) : Covered ((i : ι) → P455Quotient.Q (rs i) (ts i)) :=
  pi inds (fun i => ⟨_,Problem455Finite.carrier_complete (rs i) (ts i)⟩)
    (fun i => P455Quotient.zero (rs i) (ts i))
theorem primitive (r : Nat) : Covered (P455FirstTesters.Carrier r) :=
  coordinate (from_codes Subtype.val (fun _ _ => Subtype.ext) _ P455FirstTesters.index_covered) _ _
theorem binary (r allow) : Covered (P455BinaryProduct.Carrier r allow) := by
  apply coordinate (from_covered (fun i : P455BinaryProduct.Index r allow => (i.num,i.prof)) _ (prod (fin _) bool))
  intro i j; cases i; cases j; simp
theorem structural (r allow) : Covered (P455StructuralProduct.Carrier r allow) := by
  apply coordinate (from_covered (fun i : P455StructuralProduct.Index r allow => i.pos) _ (fin _))
  intro i j; cases i; cases j; simp
private abbrev GCode (r : Nat) := (k : Bool) ×
  (Fin (P455GuardProduct.words r k).length × Fin (P455GuardProduct.width k) × Fin (P455GuardProduct.width k))
theorem guard (r allow ts) : Covered (P455GuardProduct.Carrier r allow ts) := by
  let f (i : P455GuardProduct.Index r allow ts) : GCode r := ⟨i.kind,i.pos,i.a,i.b⟩
  apply coordinate (from_covered f _ (sigma bool (fun _ => prod (fin _) (prod (fin _) (fin _)))))
  intro i j eq
  cases i with
  | mk k i a b cp ok =>
    cases j with
    | mk m j c d cq oq =>
      obtain km : k = m := congrArg Sigma.fst eq
      subst m
      have e : (i,a,b) = (j,c,d) := eq_of_heq (Sigma.mk.inj eq).2
      simpa using e
theorem edge (r allow ts) : Covered (P455EdgeProduct.Carrier r allow ts) := by
  apply coordinate (from_covered
    (fun i : P455EdgeProduct.Index r allow ts => (i.num,i.a,i.b,i.c,i.d)) _
    (prod (fin _) (prod (fin _) (prod (fin _) (prod (fin _) (fin _))))))
  intro i j; cases i; cases j; simp
theorem fixed_product (r allow ts) :
    Covered (P455FirstTesters.Carrier r ×
      ((P455GuardProduct.Carrier r allow ts × P455EdgeProduct.Carrier r allow ts) ×
       (P455BinaryProduct.Carrier r allow × P455StructuralProduct.Carrier r allow))) :=
  prod (primitive r) (prod (prod (guard ..) (edge ..)) (prod (binary ..) (structural ..)))
end P455FiniteModel
end
section
namespace P455Prefix
open P455FirstRewrite P455FirstTesters P455Quotient
abbrev Word := List Nat
def dropName (x : Nat) (u : Word) := u.filter (· != x)
theorem overflow_unit {R : Rules Nat} {T : Word} (cap : Cap R.r T)
    (v : Nat → Q R T) (u : Word) (x : Nat) (many : R.r < u.count x)
    (live : eval R cap v u ≠ zero R T) : v x = ofWord R T [] := by
  classical
  have mem : x ∈ u := List.count_pos_iff.mp (by omega)
  have reps (z) (hz : z ∈ u) := nonzero_representative R (v z) (live_inputs R cap v u live z hz)
  let h : Nat → Word := fun z => if hz : z ∈ u then (reps z hz).choose else []
  have rep (z) (hz : z ∈ u) : ofWord R T (h z) = v z := by
    simpa [h,hz] using (reps z hz).choose_spec.2
  have g := (nonzero_iff R).mp ((eval_rep R cap v u h rep) ▸ live)
  have bounded := good_cap R cap g
  have empty : h x = [] := by
    cases e : h x with
    | nil => rfl
    | cons a t =>
      have c : 1 ≤ (h x).count a := by rw [e]; simp
      have l := Nat.mul_le_mul_left (u.count x) c
      have split := P455DonorInterval.split_contributions h u x a
      have b := bounded a
      simp only [Nat.mul_one] at l
      omega
  simpa [empty] using (rep x mem).symm
private theorem unit_drop {R : Rules Nat} {T : Word} (cap : Cap R.r T)
    (v : Nat → Q R T) (x : Nat) (unit : v x = ofWord R T []) (u : Word) :
    eval R cap v u = eval R cap v (dropName x u) := by
  induction u with
  | nil => rfl
  | cons a t ih =>
    by_cases e : a = x
    · subst a; simpa [dropName,eval,unit,(unit_laws R cap _).1] using ih
    · simpa [dropName,eval,e] using congrArg (mul R cap (v a)) ih
theorem overflow_coordinate {R : Rules Nat} {T : Word} (cap : Cap R.r T)
    (v : Nat → Q R T) {u w : Word} {x : Nat}
    (cu : R.r < u.count x) (cw : R.r < w.count x)
    (same : dropName x u = dropName x w) : eval R cap v u = eval R cap v w := by
  by_cases hu : v x = ofWord R T []
  · rw [unit_drop cap v x hu u, unit_drop cap v x hu w,same]
  · have z (a : Word) (c : R.r < a.count x) : eval R cap v a = zero R T :=
      Classical.byContradiction (fun nz => hu (overflow_unit cap v a x c nz))
    rw [z u cu,z w cw]
private theorem power_eval {r : Nat} (i : Index r) (v : Nat → Carrier r) (w : Word) :
    (product r).eval v w i = eval (plain r) i.cap (fun a => v a i) w := by
  induction w with
  | nil => rfl
  | cons a w ih => exact congrArg (mul (plain r) i.cap (v a i)) ih
theorem overflow_valid {r allow ts} {u w : Word} {x : Nat}
    (cu : r < u.count x) (cw : r < w.count x) (same : dropName x u = dropName x w) :
    (P455FullSingleton.model r allow ts).Valid u w := by
  apply (P455MarkedRank.valid_pair ..).mpr
  refine ⟨?_,(P455MarkedRank.valid_pair ..).mpr ⟨(P455MarkedRank.valid_pair ..).mpr ⟨?_,?_⟩,
    (P455MarkedRank.valid_pair ..).mpr ⟨?_,?_⟩⟩⟩
  · intro v; funext i; rw [power_eval,power_eval]
    exact overflow_coordinate i.cap _ cu cw same
  · intro v; funext i; rw [P455LocalIdentity.coordinate_eval,P455LocalIdentity.coordinate_eval]
    exact overflow_coordinate (R := i.R) (T := i.T) i.cap _ cu cw same
  · intro v; funext i; rw [P455MarkedRank.edge_eval,P455MarkedRank.edge_eval]
    exact overflow_coordinate (R := i.R) (T := i.T) i.cap _ cu cw same
  · intro v; funext i; rw [P455BinaryProduct.eval_at,P455BinaryProduct.eval_at]
    have capr : i.R.r = r := by
      cases h : i.prof <;> simp [P455BinaryProduct.Index.R,h,plain,P455Witness.rules,Problem455Finite.rules]
    exact overflow_coordinate i.bound _ (by simpa [capr] using cu) (by simpa [capr] using cw) same
  · intro v; funext i; rw [P455StructuralProduct.coordinate,P455StructuralProduct.coordinate]
    exact overflow_coordinate (R := plain r) (T := i.T) i.cap _ cu cw same
end P455Prefix
end
section
namespace P455ReductionBoundary
open P455Witness P455FirstRewrite P455CrossedSupport P455SourceFamilies P455SlotSaturation
open P455ActualGuards P455Uncrossed P455FullSingleton P455Schedule Problem455.Slots
abbrev W := List Nat
theorem sym_step {G : W → W → Prop} {u v} (st : Step G u v) : Step G v u := by
  obtain ⟨a,b,l,k,h,rule,an,bn,hn,lo,hi⟩ := st
  exact ⟨b,a,l,k,h,rule.symm,bn,an,hn,hi,lo⟩
structure Layout (r : Nat) (allow : Tag → Prop) (ts : Tiles) (U V A B : W) where
  x : Nat
  y : Nat
  f : P455Closure.Frame Nat
  l : W
  k : W
  bit : Bool
  hp : f.p = [x]
  hq : f.q = [y]
  frame : f.Valid r allow noMark
  cap : P455Closure.Cap r (side f l k false)
  anchor : ClosedFlip r allow U x y
  changed : select [x,y] U ≠ select [x,y] V
  path : P455Quotient.Walk (P455Closure.Move r allow noMark) U (side f l k bit)
  compressed : Compressed r (side f l k bit)
  legal : ∀ b, ¬ EdgeViolation r allow ts (side f l k b) x y
  fromWord : A = side f l k bit
  toWord : B = side f l k (!bit)
theorem Layout.step {r allow ts U V A B} (g : Layout r allow ts U V A B)
    (capU : P455Closure.Cap r U) (idUV : (model r allow ts).Valid U V) :
    Step (fun a b => (model r allow ts).Valid a b ∧ rank a b ≤ P455MarkedRank.bound r) A B := by
  have mv : P455Closure.Move r allow noMark (side g.f g.l g.k false) (side g.f g.l g.k true) :=
    ⟨g.f,false,g.l,g.k,g.frame,rfl,rfl,g.cap⟩
  have path0 : P455Quotient.Walk (P455Closure.Move r allow noMark) U (side g.f g.l g.k false) := by
    cases h : g.bit
    · simpa [h] using g.path
    · exact .snoc (by simpa [h] using g.path) mv.symm
  have cmp0 : Compressed r (side g.f g.l g.k false) := by
    cases h : g.bit
    · simpa [h] using g.compressed
    · have cmp := g.compressed; rw [h] at cmp
      exact fun a b link => cmp a b ((Problem455BlockBridge.move_link mv a b).mp link)
  have st := bounded_step g.f g.l g.k g.x g.y g.hp g.hq g.frame g.cap U V capU idUV g.anchor
    g.changed path0 cmp0 g.legal
  have transport {a b c d : W} {G : W → W → Prop} (h : a = c) (j : b = d) (s : Step G c d) :
      Step G a b := by subst c; subst d; exact s
  apply transport g.fromWord g.toWord
  cases g.bit
  · exact st
  · exact sym_step st
theorem rectangle_family_no_basis {r allow ts} (hr : 0 < r)
    (padding : ∀ k : Nat, ∃ (t : Nat) (middle tail : W), k < 2*t ∧
      (∀ x ∈ middle ++ tail, x < 2*t) ∧ P455Quotient.Cap r (P455RectangleRank.word t middle tail
        (P455RectangleRank.constant false)) ∧
      (model r allow ts).Valid (P455RectangleRank.word t middle tail (P455RectangleRank.constant false))
        (P455RectangleRank.word t middle tail (P455RectangleRank.constant true)) ∧
      (∀ w, (model r allow ts).Valid (P455RectangleRank.word t middle tail (P455RectangleRank.constant false)) w →
        ∃ b, w = P455RectangleRank.word t middle tail b) ∧
      (∀ b, (model r allow ts).Valid (P455RectangleRank.word t middle tail (P455RectangleRank.constant false))
        (P455RectangleRank.word t middle tail b) →
        (∀ i, i+1 < t → b i = true → b (i+1) = true) ∧ (0 < t → b (t-1) = true → b 0 = true)))
    (basis : List (W × W)) (sound : ∀ u v, (u,v) ∈ basis → (model r allow ts).Valid u v) :
    ∃ U V, U ≠ [] ∧ V ≠ [] ∧ (model r allow ts).Valid U V ∧ ¬ Derives (fun u v => (u,v) ∈ basis) U V := by
  apply no_basis_of_witnesses hr _ basis sound
  intro k
  obtain ⟨t,m,z,big,letters,cap,eq,all,edges⟩ := padding k
  exact ⟨_,_,_,P455RectangleRank.witness hr (by omega) m z letters cap eq all edges,by simpa using big⟩
end P455ReductionBoundary
end
section
namespace P455StructuralReflection
open P455Structural P455Witness P455SourceFamilies P455DefectRename P455SlotProduct
open P455FirstTesters P455FirstRewrite P455Quotient Problem455.Slots Problem455Swap
private theorem map_edge {r allow w a b} (f : Nat → Nat) (inj : Injects f)
    (edge : Edge w r allow a b) : Edge (w.map f) r allow (f a) (f b) := by
  rcases edge with ⟨tag,recProof⟩|⟨tag,recProof⟩
  · exact .inl ⟨tag,rename_record f inj recProof⟩
  · exact .inr ⟨tag,rename_record f inj recProof⟩
theorem rename_test {r allow w} (f : Nat → Nat) (inj : Injects f)
    (test : Structural w r allow) : Structural (w.map f) r allow := by
  have width {k} (ww : Width k w) : Width k (w.map f) := by
    obtain ⟨c,len,covers⟩ := ww
    refine ⟨c.map f,by simpa using len,?_⟩
    intro a m
    obtain ⟨b,mb,rfl⟩ := List.mem_map.mp m
    exact List.mem_map_of_mem (covers b mb)
  rcases test with ⟨ww,o,p,q,op,oq,pq,ep,eq⟩|⟨ww,o,p,z,j,op,zo,zp,⟨tag,recProof⟩,see⟩
  · exact .inl ⟨width ww,f o,f p,f q,fun h => op (inj h),fun h => oq (inj h),
      fun h => pq (inj h),map_edge f inj ep,map_edge f inj eq⟩
  · exact .inr ⟨width ww,f o,f p,f z,j,fun h => op (inj h),fun h => zo (inj h),
      fun h => zp (inj h),⟨tag,rename_record f inj recProof⟩,rename_sees f inj see⟩
private theorem bigram_map (f : Nat → Nat) (inj : Injects f) (x y : Nat) (w : List Nat) :
    bigram (f x) (f y) (w.map f) = bigram x y w := by
  induction w with
  | nil => rfl
  | cons a t ih =>
    cases t with
    | nil => simp [bigram,hit]
    | cons b t =>
      change hit _ _ (some (f a)) (some (f b)) + _ = hit _ _ (some a) (some b) + _
      have left : f a = f x ↔ a = x := ⟨fun e => inj e,congrArg f⟩
      have right : f b = f y ↔ b = y := ⟨fun e => inj e,congrArg f⟩
      simp only [hit,Option.some.injEq,left,right,← ih,List.map_cons]
theorem rename_compressed {r w} (hr : 0 < r) (f : Nat → Nat) (inj : Injects f)
    (cmp : Compressed r w) : Compressed r (w.map f) := by
  intro a b h
  have le := out_bound a b (b+1) (by omega) (w.map f)
  have ri := in_bound a (a+1) b (by omega) (w.map f)
  have up := tail_occ_le b (w.map f)
  simp only [Problem455BlockBridge.occ_count] at le ri up
  change bigram a b (w.map f) = r at h
  obtain ⟨x,_,rfl⟩ := List.mem_map.mp (List.count_pos_iff.mp (show 0 < (w.map f).count a by omega))
  obtain ⟨y,_,rfl⟩ := List.mem_map.mp (List.count_pos_iff.mp (show 0 < (w.map f).count b by omega))
  exact cmp x y ((bigram_map f inj x y w).symm.trans h)
theorem literal_projection {r allow ts u v} (hr : 0 < r) (cap : P455Closure.Cap r u)
    (ident : (P455FullSingleton.model r allow ts).Valid u v) (keep : List Nat) (width : keep.length ≤ 4)
    (test : Structural (select keep u) r allow) (cmp : Compressed r (select keep u)) :
    select keep u = select keep v := by
  let T := (select keep u).map keep.idxOf
  have eq : (select keep u).map (extend keep) = T := extend_map (fun _ mem => kept mem)
  have cp : P455Closure.Cap r T := eq ▸ cap_rename _ (extend_inj keep) (P455DefectProjection.select_cap keep cap)
  have st : Structural T r allow := eq ▸ rename_test _ (extend_inj keep) test
  have nc : Compressed r T := eq ▸ rename_compressed hr _ (extend_inj keep) cmp
  have low (x) (mem : x∈T) : x < 4 := by
    obtain ⟨a,ha,rfl⟩ := List.mem_map.mp mem
    exact Nat.lt_of_lt_of_le (List.idxOf_lt_length_of_mem (kept ha)) width
  have found := Problem455Finite.covered (List.range 4) (4*r) T (capped_length 4 T cp low)
    (fun x mem => List.mem_range.mpr (low x mem))
  obtain ⟨idx,pos⟩ := List.get_of_mem found
  let i : P455StructuralProduct.Index r allow := ⟨idx,pos.symm ▸ cp,pos.symm ▸ nc,pos.symm ▸ st⟩
  have iden := ((P455MarkedRank.valid_pair ..).mp
    (((P455MarkedRank.valid_pair ..).mp ((P455MarkedRank.valid_pair ..).mp ident).2).2)).2
  let vname (a : Nat) (j : P455StructuralProduct.Index r allow) := ofWord (plain r) j.T (image keep a)
  have observed := congrFun (iden vname) i
  rw [P455StructuralProduct.coordinate,P455StructuralProduct.coordinate] at observed
  have product (w : List Nat) : eval (plain r) i.cap (fun a => vname a i) w =
      ofWord (plain r) i.T ((select keep w).map keep.idxOf) :=
    (eval_rep _ _ _ _ (image keep) (fun _ _ => rfl)).trans (congrArg _ (image_word keep w))
  rw [product,product] at observed
  have sameT : i.T = T := pos
  rw [sameT] at observed
  have live : Good (plain r) T T := ⟨T,.refl _,[],[],by simp⟩
  have walk := ((same_nonzero_class _ live).mp observed).2
  have identical := walk.transport (P := fun w => T = w) rfl (fun bad _ => False.elim bad)
  exact (decode_map (fun _ mem => kept mem)).symm.trans
    ((congrArg (List.map (decode keep)) identical).trans (decode_map (fun _ mem => kept mem)))
end P455StructuralReflection
end
section
namespace P455Enum
open P455PaddedTiles P455Witness Problem455.Slots
structure Cover (α : Type) where
  list : List α
  mem : ∀ x, x ∈ list
def Cover.map (s : Cover α) (f : α → β) (sur : ∀ y, ∃ x, f x = y) : Cover β :=
  ⟨s.list.map f,fun y => let ⟨x,e⟩ := sur y; List.mem_map.mpr ⟨x,s.mem x,e⟩⟩
def Cover.bind (s : Cover α) (f : α → Cover β) (g : α → β → γ)
    (sur : ∀ y, ∃ a b, g a b = y) : Cover γ :=
  ⟨s.list.flatMap fun a => (f a).list.map (g a),fun y => by
    obtain ⟨a,b,e⟩ := sur y
    exact List.mem_flatMap.mpr ⟨a,s.mem a,List.mem_map.mpr ⟨b,(f a).mem b,e⟩⟩⟩
def selectSub (xs : List α) (p : α → Prop) [DecidablePred p] := (xs.filter p).attach.map
  (fun t => (⟨t.val,by simpa using (List.mem_filter.mp t.property).2⟩ : Subtype p))
theorem selectSub_full {xs : List α} {p : α → Prop} [DecidablePred p] (x : Subtype p)
    (m : x.val ∈ xs) : x ∈ selectSub xs p := by
  have yes : x.val ∈ xs.filter p := List.mem_filter.mpr ⟨m,decide_eq_true x.property⟩
  unfold selectSub
  apply List.mem_map.mpr
  exact ⟨⟨x.val,yes⟩,List.mem_attach ..,Subtype.ext rfl⟩
def bools : Cover Bool := ⟨[false,true],fun b=>by cases b <;> simp⟩
def fins (n : Nat) : Cover (Fin n) :=
  ⟨List.finRange n,fun a => by
    have h : a.val < (List.finRange n).length := by simp
    simpa using List.getElem_mem (l := List.finRange n) h⟩
def options (s : Cover α) : Cover (Option α) :=
  ⟨none::s.list.map some,fun x=>by cases x with
    | none => simp
    | some a => exact List.mem_cons_of_mem _ (List.mem_map_of_mem (s.mem a))⟩
def tiles (n : Nat) : Cover (Tile n) :=
  let bs := bools.list
  let plain := (fins n).list
  let opt := (options (fins n)).list
  ⟨(bs.flatMap fun a => (bs.flatMap fun b => (bs.flatMap fun c => (bs.flatMap fun d => (bs.flatMap fun e => (bs.flatMap fun f => (opt.flatMap fun l => (plain.flatMap fun v => (opt.flatMap fun r => (plain.map fun z => ⟨a,b,c,d,e,f,l,v,r,z⟩)))))))))), by
     intro p
     cases p with
     | mk a b c d e f l v r z =>
       simp only [List.mem_flatMap,List.mem_map]
       exact ⟨a,bools.mem _,b,bools.mem _,c,bools.mem _,d,bools.mem _,e,bools.mem _,f,bools.mem _,
          l,(options (fins n)).mem _,v,(fins n).mem _,r,(options (fins n)).mem _,z,(fins n).mem _,rfl⟩⟩
def search (s : List α) (p : α → Prop) [DecidablePred p]
    (bound : ∀ x, p x → x∈s) : Decidable (∃ x,p x) :=
  decidable_of_iff (∃ x∈s,p x) ⟨fun ⟨x,_,h⟩ => ⟨x,h⟩,fun ⟨x,h⟩ => ⟨x,bound x h,h⟩⟩
def Cover.existsD (s : Cover α) (p : α → Prop) [DecidablePred p] : Decidable (∃ x,p x) :=
  search s.list p (fun x _ => s.mem x)
instance admittedD (M : MachineTable n) (p : Tile n) : Decidable (Admitted M p) := by
  unfold Admitted; infer_instance
def tags (M : MachineTable n) := ((tiles n).list.filter (Admitted M)).map code
theorem mem_tags {M : MachineTable n} {tag} : tag∈tags M ↔ allowed M tag := by
  simp only [tags,List.mem_map,List.mem_filter,decide_eq_true_eq]
  exact ⟨fun ⟨p,⟨_,h⟩,e⟩=>⟨p,e,h⟩,fun ⟨p,e,h⟩=>⟨p,⟨(tiles n).mem p,h⟩,e⟩⟩
instance allowedD (M : MachineTable n) (t) : Decidable (allowed M t) :=
  decidable_of_iff _ mem_tags
instance horizontalD (n : Nat) (s t) : Decidable ((system n).horizontal s t) := by
  unfold system Horizontal
  exact @Cover.existsD _ (tiles n) _ (fun p => @Cover.existsD _ (tiles n) _ (fun q => inferInstance))
instance verticalD (n : Nat) (s t) : Decidable ((system n).vertical s t) := by
  unfold system Vertical
  exact @Cover.existsD _ (tiles n) _ (fun p => @Cover.existsD _ (tiles n) _ (fun q => inferInstance))
def capD (r : Nat) (w : List Nat) : Decidable (P455Closure.Cap r w) :=
  decidable_of_iff (∀ x∈w,w.count x ≤ r) ⟨fun h x => by
    by_cases m : x∈w
    · exact h x m
    · simp [List.count_eq_zero.mpr m],fun h x _ => h x⟩
def primitive (r : Nat) : Cover (P455FirstTesters.Index r) :=
  let xs := Problem455Finite.wordsUpTo [0,1] (2*r)
  letI : DecidablePred (fun w : List Nat => w = P455FirstTesters.power r ∨ P455FirstTesters.Binary r w) := fun w => by
    letI : Decidable (P455Quotient.Cap r w) := capD r w
    unfold P455FirstTesters.Binary
    infer_instance
  ⟨selectSub xs _,fun i => selectSub_full i (P455FirstTesters.index_covered i)⟩
end P455Enum
end
section
namespace P455Prefix
open P455FirstRewrite P455Compression P455Quotient
def gather (r x : Nat) (u : Word) := List.replicate (r+1) x ++ dropName x u
def Steps (r : Nat) (allow : P455Witness.Tag → Prop) (ts : P455Witness.Tiles) (u v : Word) :=
  (P455FullSingleton.model r allow ts).Valid u v ∧ rank u v ≤ 2*(r+2)+1
@[simp] theorem drop_mem (a x : Nat) (u : Word) : a ∈ dropName x u ↔ a ∈ u ∧ a ≠ x := by
  simp [dropName]
@[simp] theorem drop_count (a x : Nat) (u : Word) :
    (dropName x u).count a = if a = x then 0 else u.count a := by
  by_cases h : a = x
  · rw [if_pos h]; exact List.count_eq_zero.mpr (fun m => ((drop_mem ..).mp m).2 h)
  · simp [dropName,List.count_filter,h]
@[simp] theorem gather_drop (r x : Nat) (u : Word) :
    dropName x (gather r x u) = dropName x u := by
  simp [gather,dropName,List.filter_append,List.filter_filter]
@[simp] theorem gather_count (r x : Nat) (u : Word) : (gather r x u).count x = r+1 := by
  simp [gather]
private theorem code_len (n : Nat) (cs : List Piece) : (code n cs).length = cs.length := by
  induction cs generalizing n with
  | nil => rfl
  | cons p cs ih => cases p <;> simp [code,ih]
private theorem compact_length (x : Nat) :
    ∀ cs : List Piece, noTouch cs → (∀ p ∈ cs, good [x] p) →
      cs.length ≤ 2*(cs.flatMap body).count x+1
  | [],_,_ => by simp
  | .literal b :: cs,ok,g => by
    have bx : b = x := List.mem_singleton.mp (g _ List.mem_cons_self)
    have tail := compact_length x cs ok (fun p h => g _ (List.mem_cons_of_mem _ h))
    subst b
    simp [body,List.count_cons]; omega
  | [.gap a],_,_ => by simp [body]
  | .gap a :: .literal b :: cs,ok,g => by
    have bx : b = x := List.mem_singleton.mp (g (.literal b) (by simp))
    have tail := compact_length x cs ok (fun p h => g _ (by simp [h]))
    subst b
    simp [body,List.count_cons]; omega
  | .gap _ :: .gap _ :: _,ok,_ => False.elim ok
private theorem small_len (u : Word) (x : Nat) : (small u [x]).length ≤ 2*u.count x+1 := by
  have h := compact_length x (pieces [x] u) (maximal [x] u) (pieces_good [x] u)
  rw [decoded] at h
  simpa only [small,code_len] using h
private theorem expand_drop {s : Word} {e : Nat → Word} {x : Nat}
    (exp : P455Retained.Expansion s e (fun a => a ∈ [x])) :
    ∀ (t : Word), (∀ a ∈ t, a ∈ s) → (dropName x t).flatMap e = dropName x (t.flatMap e) := by
  intro t sub
  induction t with
  | nil => rfl
  | cons a t ih =>
    have inc (b) (h : b ∈ t) := sub b (List.mem_cons_of_mem _ h)
    have eq := ih inc
    have m := sub a List.mem_cons_self
    by_cases same : a = x
    · subst a
      simpa [dropName,List.filter_append,exp.literal x m (by simp)] using eq
    · have gap := exp.gaps a m (by simpa using same)
      have all : (e a).filter (· != x) = e a := List.filter_eq_self.mpr (fun b hb => by
        simpa using gap.2.2 b hb)
      simpa [dropName,List.filter_append,same,all] using congrArg (List.append (e a)) eq
private theorem map_reps (k x : Nat) (e : Nat → Word) (fixed : e x = [x]) :
    (List.replicate k x).flatMap e = List.replicate k x := by
  induction k with
  | zero => rfl
  | succ k ih => simp [List.replicate_succ,fixed,ih]
theorem gather_step {r allow ts x} (u : Word) (lo : r < u.count x) (hi : u.count x ≤ r+2) :
    Step (Steps r allow ts) u (gather r x u) := by
  let s := small u [x]
  let e := expand u [x]
  have cnt : s.count x = u.count x := counts_retained u [x] x (by simp)
  have xs : x ∈ s := List.count_pos_iff.mp (by omega)
  have expanded : s.flatMap e = u := recover u [x]
  have exp := canonical u [x]
  have fixed : e x = [x] := exp.literal x xs (by simp)
  have right : (gather r x s).flatMap e = gather r x u := by
    rw [gather,List.flatMap_append,map_reps _ _ _ fixed, expand_drop exp s (fun _ m => m),expanded]
    rfl
  have covers (a : Nat) (h : a ∈ gather r x s) : a ∈ s := by
    rcases List.mem_append.mp h with h|h
    · exact (List.eq_of_mem_replicate h) ▸ xs
    · exact ((drop_mem ..).mp h).1
  have rankBound : rank s (gather r x s) ≤ s.length := by
    apply size_le (names_distinct _)
    intro a ha
    exact (List.mem_append.mp ((mem_names ..).mp ha)).elim id (covers a)
  have short := small_len u x
  change s.length ≤ _ at short
  have valid := overflow_valid (allow := allow) (ts := ts) (x := x) (u := s) (w := gather r x s)
    (by omega : r < s.count x) (by simp) (gather_drop r x s).symm
  refine ⟨s,gather r x s,[],[],e,.inl ⟨valid,by omega⟩,fun h => ?_,?_,
    P455SmallRank.expansion_nonempty u [x],by simpa using expanded.symm,by simpa using right.symm⟩
  · simp [h] at xs
  · simp [gather,List.replicate_succ]
theorem context_step {G : Word → Word → Prop} {u v : Word} (p q : Word) (s : Step G u v) :
    Step G (p ++ u ++ q) (p ++ v ++ q) := by
  obtain ⟨a,b,l,t,h,rule,an,bn,hn,rfl,rfl⟩ := s
  exact ⟨a,b,p++l,t++q,h,rule,an,bn,hn,by simp [List.append_assoc],by simp [List.append_assoc]⟩
theorem context_derives {G : Word → Word → Prop} {u v : Word} (p q : Word) (s : Derives G u v) :
    Derives G (p ++ u ++ q) (p ++ v ++ q) := by
  induction s with
  | refl => exact .refl _
  | snoc _ step ih => exact .snoc ih (context_step p q step)
theorem gather_deduction {r allow ts x} (u : Word) (sat : r < u.count x) :
    Derives (Steps r allow ts) u (gather r x u) := by
  induction u with
  | nil => simp at sat
  | cons a t ih =>
    by_cases tail : r < t.count x
    · have path := context_derives [a] [] (ih tail)
      have low : r < (a :: gather r x t).count x := by simp [List.count_cons]; omega
      have high : (a :: gather r x t).count x ≤ r+2 := by simp [List.count_cons]; split <;> omega
      have step := gather_step (allow := allow) (ts := ts) _ low high
      have eq : gather r x (a::gather r x t) = gather r x (a::t) := by
        by_cases same : a = x <;> simp [gather,dropName,List.filter_append,List.filter_filter,same]
      exact (show Derives (Steps r allow ts) (a::t) (a::gather r x t) by simpa using path).snoc (eq ▸ step)
    · have high : (a :: t).count x ≤ r+2 := by simp only [List.count_cons]; split <;> omega
      exact .snoc (.refl _) (gather_step _ sat high)
end P455Prefix
end
