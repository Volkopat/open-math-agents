section
namespace P455CataloguePrim
variable {A B C : Type} [Primcodable A] [Primcodable B] [Primcodable C]
theorem filter' {f : A → List B} {p : A → B → Bool} (hf : Primrec f) (hp : Primrec₂ p) :
    Primrec (fun x => (f x).filter (p x)) := P455GraphPrim.filter hf hp
theorem count' [DecidableEq B] : Primrec₂ (fun (xs : List B) (a : B) => xs.count a) := by
  have f : Primrec (fun p : List B × B => (p.1.filter (fun a => a == p.2)).length) :=
    Primrec.list_length.comp (filter' Primrec.fst ((Primrec.beq.comp Primrec.snd (Primrec.snd.comp Primrec.fst)).to₂))
  exact f.of_eq (fun _ => by simp [List.count,List.countP_eq_length_filter])
theorem all' {f : A → List B} {p : A → B → Bool} (hf : Primrec f) (hp : Primrec₂ p) :
    Primrec (fun a => (f a).all (p a)) := by
  have h : Primrec (fun a => (f a).foldr (fun b t => p a b && t) true) :=
    Primrec.list_foldr hf (Primrec.const true) ((Primrec.and.comp
      (hp.comp Primrec.fst (Primrec.fst.comp Primrec.snd)) (Primrec.snd.comp Primrec.snd)).to₂)
  apply h.of_eq
  intro x
  generalize f x = l
  induction l with
  | nil => rfl
  | cons a l ih => simp [ih]
theorem mem' [DecidableEq B] : PrimrecRel (fun (a : B) (xs : List B) => a∈xs) := by
  have h := Primrec.nat_lt.comp (Primrec.const 0) (count'.comp (Primrec.snd (α:=B) (β:=List B)) Primrec.fst)
  exact h.of_eq (fun _ => by simp [List.count_pos_iff])
theorem distinct' [DecidableEq B] : Primrec (@P455Table.distinct B _) := by
  have h : Primrec (fun xs : List B => List.recOn (motive := fun _ => List B) xs ([] : List B) (fun a tail result =>
      if a∈tail then result else a::result)) :=
    Primrec.list_rec Primrec.id (Primrec.const [])
      ((Primrec.ite (mem'.comp (Primrec.fst.comp Primrec.snd) (Primrec.fst.comp (Primrec.snd.comp Primrec.snd)))
        (Primrec.snd.comp (Primrec.snd.comp Primrec.snd)) (Primrec.list_cons.comp (Primrec.fst.comp Primrec.snd)
          (Primrec.snd.comp (Primrec.snd.comp Primrec.snd)))).to₂)
  apply h.of_eq
  intro xs
  induction xs with
  | nil => rfl
  | cons a l ih => exact congrArg (fun acc => if a∈l then acc else a::acc) ih
theorem words' : Primrec₂ (@Problem455Finite.wordsUpTo B) := P455GraphPrim.wordsUpTo
abbrev W := List Nat
abbrev Spec := W × Option (List (Nat×Nat))
def accept (r : Nat) (w : W) : Bool :=
  decide (w = List.replicate r 0) ||
    ((w.all (fun a => decide (a = 0 ∨ a = 1))) &&
     (w.all (fun a => decide (w.count a ≤ r))) && decide (0 < w.count 0) &&
     decide (0 < w.count 1) && decide (w.count 0 < r ∨ w.count 1 < r))
theorem accepted (r : Nat) (w : W) : accept r w = true ↔ w = P455FirstTesters.power r ∨ P455FirstTesters.Binary r w := by
  have cap : (∀ a∈w,w.count a ≤ r) ↔ P455Quotient.Cap r w := by
    constructor
    · intro h a
      by_cases m : a∈w
      · exact h a m
      · simp [List.count_eq_zero.mpr m]
    · exact fun h a _ => h a
  simp [accept,P455FirstTesters.power,P455FirstTesters.Binary,List.all_eq_true,cap,and_assoc]
theorem accept' : Primrec₂ accept := by
  let F := Nat×W
  have p0 : Primrec (fun z : F => List.replicate z.1 0) :=
    (Primrec.list_map (Primrec.list_range.comp Primrec.fst) (Primrec₂.const (0:Nat))).of_eq (fun z=>by simp [List.map_const'])
  have names : Primrec (fun z : F => z.2.all (fun a => decide (a = 0 ∨ a = 1))) :=
    all' Primrec.snd ((PrimrecPred.or (Primrec.eq.comp (Primrec.snd (α:=F) (β:=Nat)) (Primrec.const 0))
      (Primrec.eq.comp Primrec.snd (Primrec.const 1))).decide.to₂)
  have cap : Primrec (fun z : F => z.2.all (fun a => decide (z.2.count a ≤ z.1))) :=
    all' Primrec.snd ((Primrec.nat_le.comp (count'.comp (Primrec.snd.comp Primrec.fst) Primrec.snd)
      (Primrec.fst.comp Primrec.fst)).decide.to₂)
  have c0 : Primrec (fun z : F => z.2.count 0) := count'.comp Primrec.snd (Primrec.const 0)
  have c1 : Primrec (fun z : F => z.2.count 1) := count'.comp Primrec.snd (Primrec.const 1)
  have lo := Primrec.or.comp (Primrec.nat_lt.comp c0 Primrec.fst).decide (Primrec.nat_lt.comp c1 Primrec.fst).decide
  exact Primrec.or.comp (Primrec.eq.comp Primrec.snd p0).decide (Primrec.and.comp (Primrec.and.comp
    (Primrec.and.comp (Primrec.and.comp names cap) (Primrec.nat_lt.comp (Primrec.const 0) c0).decide)
      (Primrec.nat_lt.comp (Primrec.const 0) c1).decide) (lo.of_eq (fun _=>by simp)))
def plain (r : Nat) := (Problem455Finite.wordsUpTo [0,1] (2*r)).filter (accept r)
theorem plain' : Primrec plain :=
  filter' (words'.comp (Primrec.const [0,1]) (Primrec.nat_mul.comp (Primrec.const 2) Primrec.id)) accept'
theorem actual (r : Nat) : (P455Enum.primitive r).list.map Subtype.val = plain r := by
  unfold P455Enum.primitive P455Enum.selectSub plain
  simp only [List.map_map,Function.comp_def,List.attach_map_val,List.attach_map_subtype_val]
  apply List.filter_congr
  intro a _
  apply Bool.eq_iff_iff.mpr
  simp [accepted]
theorem map_distinct {X Y : Type} [DecidableEq X] [DecidableEq Y] (f : X → Y) (inj : Function.Injective f)
    (s : List X) : (P455Table.distinct s).map f = P455Table.distinct (s.map f) := by
  induction s with
  | nil => rfl
  | cons x xs ih =>
    have mem : f x∈xs.map f ↔ x∈xs := by simp [inj.eq_iff]
    by_cases m : x∈xs <;> simp [P455Table.distinct,m,mem,ih]
def primitive (r : Nat) : List Spec :=
  (P455Table.distinct (P455Enum.primitive r).list).map (fun i => (i.val,none))
theorem primitive' : Primrec primitive := by
  have hs : Primrec (fun r => (P455Table.distinct (plain r)).map (fun w => (w,(none : Option (List (Nat×Nat)))))) :=
    Primrec.list_map (distinct'.comp plain') ((Primrec.snd.pair (Primrec.const none)).to₂)
  apply hs.of_eq
  intro r
  rw [←actual,←map_distinct Subtype.val Subtype.val_injective,List.map_map]
  rfl
end P455CataloguePrim
end
section
namespace P455NumericProduct
open P455Table P455FirstRewrite P455FirstTesters
def grid (n : Nat) (f : Nat → Nat → Nat) : Matrix :=
  (List.range n).map fun i => (List.range n).map fun j => f i j
def tensor (T U : Matrix) : Matrix :=
  let d := U.length
  grid (T.length*d) (fun i j => entry U (i%d) (j%d) + entry T (i/d) (j/d)*d)
def singleton : Matrix := [[0]]
def assemble (factors : List Matrix) : Matrix := factors.foldr tensor singleton
def pack (i : Fin n) (j : Fin m) : Fin (n*m) := ⟨j.val+i.val*m,by
  have h := Nat.mul_le_mul_right m i.isLt
  rw [Nat.succ_mul] at h
  have v := j.isLt; omega⟩
def major (hm : 0 < m) (k : Fin (n*m)) : Fin n := ⟨k.val/m,(Nat.div_lt_iff_lt_mul hm).mpr k.isLt⟩
def minor (hm : 0 < m) (k : Fin (n*m)) : Fin m := ⟨k.val%m,Nat.mod_lt _ hm⟩
theorem major_pack (hm : 0 < m) (i : Fin n) (j : Fin m) : major hm (pack i j) = i := by
  apply Fin.ext
  simp [major,pack,Nat.add_mul_div_right _ _ hm,Nat.div_eq_of_lt j.isLt]
theorem minor_pack (hm : 0 < m) (i : Fin n) (j : Fin m) : minor hm (pack i j) = j := by
  apply Fin.ext; simp [minor,pack,Nat.add_mul_mod_self_right,Nat.mod_eq_of_lt j.isLt]
theorem pack_parts (hm : 0 < m) (k : Fin (n*m)) : pack (major hm k) (minor hm k) = k := by
  apply Fin.ext
  change k.val%m+k.val/m*m = k.val
  rw [Nat.mul_comm (k.val/m) m,Nat.mod_add_div]
def positive (Y : FiniteOps) : 0 < Y.size := Nat.lt_of_le_of_lt (Nat.zero_le _) Y.one.isLt
def prodOps (X Y : FiniteOps) : FiniteOps :=
  ⟨X.size*Y.size,pack X.one Y.one,fun i j =>
    pack (X.mul (major (positive Y) i) (major (positive Y) j))
      (Y.mul (minor (positive Y) i) (minor (positive Y) j))⟩
def prodPresents {M : Model A} {N : Model B} {X Y} (p : Presents X M) (q : Presents Y N) :
    Presents (prodOps X Y) (combine M N) where
  decode k := (p.decode (major (positive Y) k),q.decode (minor (positive Y) k))
  inj i j eq := by
    have u := p.inj _ _ (congrArg Prod.fst eq)
    have v := q.inj _ _ (congrArg Prod.snd eq)
    have same : pack (major (positive Y) i) (minor (positive Y) i) =
        pack (major (positive Y) j) (minor (positive Y) j) := by rw [u,v]
    exact (pack_parts (positive Y) i).symm.trans
      (same.trans (pack_parts (positive Y) j))
  surj := by
    rintro ⟨a,b⟩
    obtain ⟨i,hi⟩ := p.surj a; obtain ⟨j,hj⟩ := q.surj b
    exact ⟨pack i j,by simp [major_pack,minor_pack,hi,hj]⟩
  one_eq := by simp [prodOps,major_pack,minor_pack,combine,p.one_eq,q.one_eq]
  mul_eq := by intro i j; simp [prodOps,major_pack,minor_pack,combine,p.mul_eq,q.mul_eq]
theorem tensor_matrix (X Y : FiniteOps) :
    tensor (matrix X) (matrix Y) = matrix (prodOps X Y) := by
  apply List.ext_getElem (by simp [tensor,grid,prodOps])
  intro i hi _
  have ib : i < X.size*Y.size := by simpa [tensor,grid] using hi
  let a : Fin (X.size*Y.size) := ⟨i,ib⟩
  apply List.ext_getElem (by simp [tensor,grid,matrix,prodOps])
  intro j hj _
  have jb : j < X.size*Y.size := by simpa [tensor,grid,matrix] using hj
  let b : Fin (X.size*Y.size) := ⟨j,jb⟩
  have l := matrix_entry X (major (positive Y) a) (major (positive Y) b)
  have r := matrix_entry Y (minor (positive Y) a) (minor (positive Y) b)
  simp only [major,minor,a,b] at l r
  simp only [tensor,grid,matrix_length,List.getElem_map,List.getElem_range]
  rw [l,r]
  simp only [matrix,List.getElem_map,List.getElem_finRange]
  rfl
def unitOps : FiniteOps := ⟨1,0,fun _ _ => 0⟩
def unitModel : Model Unit where
  op _ _ := ()
  unit := ()
  assoc _ _ _ := rfl
  oneL _ := rfl
  oneR _ := rfl
def unitPresents : Presents unitOps unitModel where
  decode _ := ()
  inj i j _ := Fin.ext (by have a := i.isLt; have b := j.isLt; change i.val < 1 at a; change j.val < 1 at b; omega)
  surj _ := ⟨⟨0,Nat.zero_lt_one⟩,rfl⟩
  one_eq := rfl
  mul_eq _ _ := rfl
def Represents (T : Matrix) (M : Model A) := ∃ X, T = matrix X ∧ Nonempty (Presents X M)
theorem represents_tensor {M : Model A} {N : Model B} {T U} (a : Represents T M) (b : Represents U N) :
    Represents (tensor T U) (combine M N) := by
  obtain ⟨X,rfl,⟨p⟩⟩ := a; obtain ⟨Y,rfl,⟨q⟩⟩ := b
  exact ⟨prodOps X Y,tensor_matrix _ _,⟨prodPresents p q⟩⟩
end P455NumericProduct
end
section
namespace P455BinaryTerms
open P455FirstRewrite P455Table P455TableSemantics
inductive Term where
  | var (i : Nat)
  | mul (s t : Term)
  deriving DecidableEq
def flat : Term → W
  | .var i => [i]
  | .mul s t => flat s ++ flat t
theorem nonempty (t : Term) : flat t≠[] := by induction t <;> simp_all [flat]
def fromHead (x : Nat) : W → Term
  | [] => .var x
  | y::w => .mul (.var x) (fromHead y w)
def fromWord : W → Term
  | [] => .var 0
  | x::xs => fromHead x xs
@[simp] theorem flat_head (x : Nat) (w : W) : flat (fromHead x w) = x::w := by
  induction w generalizing x with
  | nil => rfl
  | cons y ys ih => simp [fromHead,flat,ih]
theorem flat_from {w : W} (ne : w≠[]) : flat (fromWord w) = w := by
  cases w with | nil => contradiction | cons x xs => exact flat_head _ _
def inst (f : Nat → Term) : Term → Term
  | .var i => f i
  | .mul s t => .mul (inst f s) (inst f t)
theorem flat_inst (f : Nat → Term) (t : Term) :
    flat (inst f t) = (flat t).flatMap (fun i => flat (f i)) := by
  induction t <;> simp_all [inst,flat,List.flatMap_append]
inductive Proof (G : Term → Term → Prop) : Term → Term → Prop
  | refl (x) : Proof G x x
  | symm : Proof G x y → Proof G y x
  | trans : Proof G x y → Proof G y z → Proof G x z
  | gen : G x y → Proof G x y
  | mul : Proof G x y → Proof G z t → Proof G (.mul x z) (.mul y t)
  | subst (f) : Proof G x y → Proof G (inst f x) (inst f y)
  | assoc (x y z) : Proof G (.mul (.mul x y) z) (.mul x (.mul y z))
private theorem join (G) (a : Nat) (A : W) (b : Nat) (B : W) :
    Proof G (.mul (fromHead a A) (fromHead b B)) (fromHead a (A++b::B)) := by
  induction A generalizing a with
  | nil => exact .refl _
  | cons x xs ih => exact .trans (.assoc _ _ _) (.mul (.refl _) (ih x))
theorem norm (G) (x : Term) : Proof G x (fromWord (flat x)) := by
  induction x with
  | var x => exact .refl _
  | mul s t hs ht =>
    apply Proof.trans (.mul hs ht)
    obtain ⟨a,A,ea⟩ := List.exists_cons_of_ne_nil (nonempty s)
    obtain ⟨b,B,eb⟩ := List.exists_cons_of_ne_nil (nonempty t)
    simp only [flat,ea,eb,fromWord,List.cons_append]
    exact join G a A b B
theorem assoc_eq (G) {s t : Term} (e : flat s = flat t) : Proof G s t :=
  (norm G s).trans (e.symm ▸ (norm G t).symm)
def frame (l r : W) (t : Term) : Term :=
  let left := if l=[] then t else .mul (fromWord l) t
  if r=[] then left else .mul left (fromWord r)
theorem flat_frame (l r : W) (t : Term) : flat (frame l r t) = l++flat t++r := by
  by_cases a : l=[] <;> by_cases b : r=[] <;> simp [frame,a,b,flat,flat_from]
theorem proof_frame {G} (l r : W) {x y} (e : Proof G x y) :
    Proof G (frame l r x) (frame l r y) := by
  by_cases a : l=[] <;> by_cases b : r=[] <;> simp [frame,a,b] <;>
    first | exact e | exact .mul (.refl _) e | exact .mul e (.refl _)
          | exact .mul (.mul (.refl _) e) (.refl _)
theorem step_in_terms {G : W → W → Prop} {H} (rules : ∀ u v, G u v → Proof H (fromWord u) (fromWord v))
    {a b : W} (step : Step G a b) : Proof H (fromWord a) (fromWord b) := by
  obtain ⟨u,v,l,r,h,rule,un,vn,ne,rfl,rfl⟩ := step
  let f (i : Nat) := fromWord (h i)
  have fold (w : W) (wn : w≠[]) : flat (frame l r (inst f (fromWord w))) = l++w.flatMap h++r := by
    have ef : (fun i => flat (f i)) = h := funext fun i => flat_from (ne i)
    rw [flat_frame,flat_inst,flat_from wn,ef]
  have align (w : W) (wn : w≠[]) :
      Proof H (fromWord (l++w.flatMap h++r)) (frame l r (inst f (fromWord w))) := by
    have pos : l++w.flatMap h++r≠[] := by rw [←fold w wn]; exact nonempty _
    exact assoc_eq H ((flat_from pos).trans (fold w wn).symm)
  have middle : Proof H (fromWord u) (fromWord v) :=
    rule.elim (fun m => rules _ _ m) (fun m => (rules _ _ m).symm)
  exact (align u un).trans ((proof_frame l r (.subst f middle)).trans (align v vn).symm)
theorem words_to_terms {G : W → W → Prop} {H} (rules : ∀ u v, G u v → Proof H (fromWord u) (fromWord v))
    {a b : W} (path : Derives G a b) : Proof H (fromWord a) (fromWord b) := by
  induction path with
  | refl => exact .refl _
  | snoc _ e ih => exact ih.trans (step_in_terms rules e)
theorem terms_to_words {G : W → W → Prop} {H} (rules : ∀ u v, H u v → Derives G (flat u) (flat v))
    {a b} (path : Proof H a b) : Derives G (flat a) (flat b) := by
  induction path with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm (fun e => P455ReductionBoundary.sym_step e)
  | trans _ _ ih ik => exact ih.trans ik
  | gen e => exact rules _ _ e
  | @mul x y z t _ _ ih ik =>
    exact (by simpa using P455Prefix.context_derives [] (flat z) ih :
      Derives G (flat x++flat z) (flat y++flat z)).trans
      (by simpa [flat] using P455Prefix.context_derives (flat y) [] ik)
  | subst f _ ih =>
    simp only [flat_inst]
    exact P455Prefix.substitute_deduction _ (fun i => nonempty (f i)) ih
  | assoc x y z => simp [flat,List.append_assoc,P455Quotient.Walk.refl]
end P455BinaryTerms
end
