namespace P455StandardDecision
open P455MachineCleanup P455EffectiveMachine P455EffectiveChain P455RelabeledChain
open P455BooleanReader
theorem bit_decider {f : List Bool → Bool} (hf : Computable f) :
    ∃ (g q : Nat) (M : Ordinary g q) (A : Alphabet M) (ans : Fin q → Bool),
      ∀ x, Answers M A ans x (f x) := by
  have single : Computable (fun x => [f x]) :=
    Primrec.list_cons.to_comp.comp hf (Computable.const [])
  obtain ⟨g,r,W,A,writer⟩ := P455ComputableWriter.realizes single
  refine ⟨_,_,combined W A reader bits,inputs W A A reader bits,out r ans,?_⟩
  intro x
  exact answers_combined W A A reader bits ans (writer _) (reads_bit _)
def PromiseOn {α : Type} [Primcodable α] (representation : P455Table.Matrix → α) :=
  ∃ p : α →. Bool, Partrec p ∧ ∀ T, P455TableSemantics.SemigroupTable T →
    ∃ b ∈ p (representation T), (b = true ↔ P455PureSemigroup.Basis T)
theorem promise_of_encoding {α : Type} [Primcodable α] (representation : P455Table.Matrix → α)
    (tables : List Bool → P455Table.Matrix)
    (computes : Computable (fun x => representation (tables x)))
    (valid : ∀ x, P455TableSemantics.SemigroupTable (tables x))
    (correct : ∀ {g q} (M : Ordinary g q) (A : Alphabet M),
      P455PureSemigroup.Basis (tables (selfBits M A)) ↔ ¬SelfHalt M A) :
    ¬PromiseOn representation := by
  rintro ⟨p,hp,good⟩
  let bits x := representation (tables x)
  have total (x : List Bool) : (p (bits x)).Dom := by
    obtain ⟨b,hb,_⟩ := good _ (valid x)
    exact Part.dom_iff_mem.mpr ⟨_,hb⟩
  let f (x : List Bool) := (p (bits x)).get (total x)
  have hf : Computable f := (hp.comp computes).of_eq_tot
    (fun x => Part.get_mem (total x))
  have exact_result (x : List Bool) : f x = true ↔ P455PureSemigroup.Basis (tables x) := by
    obtain ⟨b,hb,claim⟩ := good _ (valid x)
    have same : f x = b := Part.mem_unique (Part.get_mem (total x)) hb
    rw [same]; exact claim
  obtain ⟨_,_,D,A,ans,run⟩ := bit_decider hf
  apply no_self_decider D A (fun q => !(ans q))
  intro g q M B
  let x := selfBits M B
  obtain ⟨t,stop,verdict⟩ := run x
  refine ⟨t,stop,?_⟩
  have hs := (exact_result x).trans (correct M B)
  change (!(ans (follow D (inputConfig D A x) t).state)) = true ↔ SelfHalt M B
  rw [verdict]
  classical
  cases eq : f x <;> simp_all
theorem numeric_promise (tables : List Bool → P455Table.Matrix)
    (computes : Computable tables) (valid : ∀ x, P455TableSemantics.SemigroupTable (tables x))
    (correct : ∀ {g q} (M : Ordinary g q) (A : Alphabet M),
      P455PureSemigroup.Basis (tables (selfBits M A)) ↔ ¬SelfHalt M A) :
    ¬PromiseOn (id : P455Table.Matrix → P455Table.Matrix) :=
  promise_of_encoding id tables computes valid correct
end P455StandardDecision
end
section
namespace P455Undecidability
open P455Table P455TableSemantics P455EffectiveMachine P455MachineCleanup
open P455PureSemigroup P455BinaryTerms P455CertifiedReduction
theorem catalogue_ok : Correct P455WriterCatalogue.build := by
  intro n M d h
  rw [P455WriterCatalogue.build_correct h,P455SerializePrim.as_of]
theorem no_matrix_promise_decider : ¬P455StandardDecision.PromiseOn (id : Matrix → Matrix) :=
  P455StandardDecision.numeric_promise (selfTable P455WriterCatalogue.build)
    (selfRec P455WriterCatalogue.buildRec).to_comp (fun x => (finite_monoid P455WriterCatalogue.build (P455WriterProgram.fromBits x)).1)
    (self_basis catalogue_ok)
theorem finite_semigroup_finite_basis_undecidable :
    ¬ ∃ p : Matrix →. Bool, Partrec p ∧ ∀ T (valid : SemigroupTable T),
      ∃ b ∈ p T, (b = true ↔ ∃ R : List (Term×Term), ∀ s t,
        (∀ a : Nat → Fin T.length, P455StatementAudit.val valid a s = P455StatementAudit.val valid a t) ↔
        P455SemanticConsequence.entails (fun u v => (u,v)∈R) s t) := by
  rintro ⟨p,hp,answers⟩
  apply no_matrix_promise_decider
  refine ⟨p,hp,?_⟩
  intro T valid
  obtain ⟨b,halt,spec⟩ := answers T valid
  exact ⟨b,halt,spec.trans (P455SemanticConsequence.public_basis valid).symm⟩
end P455Undecidability
end
namespace OMA.S_tarski_finite_basis_semigroups
private def toOld : Term → P455BinaryTerms.Term
  | .var n => .var n
  | .mul s t => .mul (toOld s) (toOld t)

private def fromOld : P455BinaryTerms.Term → Term
  | .var n => .var n
  | .mul s t => .mul (fromOld s) (fromOld t)

@[simp] private theorem old_new (t : Term) : fromOld (toOld t) = t := by
  induction t <;> simp_all [toOld, fromOld]

@[simp] private theorem new_old (t : P455BinaryTerms.Term) : toOld (fromOld t) = t := by
  induction t <;> simp_all [toOld, fromOld]

private theorem old_eval {A : Type} (op : A → A → A) (f : ℕ → A) (t : Term) :
    P455SemanticConsequence.ev op f (toOld t) = eval op f t := by
  induction t <;> simp_all [toOld, eval, P455SemanticConsequence.ev]

private theorem old_entry (T : Table) (i j : ℕ) : P455Table.entry T i j = entry T i j := by
  rfl

private theorem old_good (T : Table) (h : P455TableSemantics.SemigroupTable T) :
    IsSemigroupTable T := by
  simpa only [P455TableSemantics.SemigroupTable, IsSemigroupTable, old_entry] using h

private theorem old_table_eval (T : Table) (f : ℕ → ℕ) (t : Term) :
    P455BinaryBasis.eval T f (toOld t) = eval (entry T) f t := by
  induction t <;> simp_all [toOld, eval, P455BinaryBasis.eval, old_entry]

private theorem old_basis (T : Table) (good : P455TableSemantics.SemigroupTable T)
    (h : FinitelyBased T) :
    ∃ R : List (P455BinaryTerms.Term × P455BinaryTerms.Term), ∀ s t,
      (∀ f : ℕ → Fin T.length, P455StatementAudit.val good f s = P455StatementAudit.val good f t) ↔
      P455SemanticConsequence.entails (fun u v => (u,v) ∈ R) s t := by
  obtain ⟨R, laws⟩ := h
  let translate (e : Term × Term) := (toOld e.1, toOld e.2)
  refine ⟨R.map translate, ?_⟩
  intro s t
  rw [← P455StatementAudit.assignments good s t]
  have valid : P455BinaryBasis.ValidTerm T s t ↔ Holds T (fromOld s) (fromOld t) := by
    unfold P455BinaryBasis.ValidTerm Holds
    have hs (f : ℕ → ℕ) := old_table_eval T f (fromOld s)
    have ht (f : ℕ → ℕ) := old_table_eval T f (fromOld t)
    simp only [new_old] at hs ht
    simp only [hs, ht]
  rw [valid, laws]
  unfold Entails P455SemanticConsequence.entails P455SemanticConsequence.satisfies
  constructor
  · intro hn A op hm f
    have result := hn A op (fun e he g => by
      have hm' := hm (toOld e.1) (toOld e.2) (List.mem_map.mpr ⟨e, he, rfl⟩) g
      simpa only [old_eval] using hm') f
    simpa only [← old_eval, new_old] using result
  · intro hn A op hm f
    have result := hn A op (fun u v huv g => by
      obtain ⟨e, he, eq⟩ := List.mem_map.mp huv
      cases eq
      simpa only [translate, old_eval] using hm e he g) f
    rw [← old_eval op f (fromOld s), ← old_eval op f (fromOld t), new_old, new_old]
    exact result

private theorem basis_of_old (T : Table) (good : P455TableSemantics.SemigroupTable T)
    (h : ∃ R : List (P455BinaryTerms.Term × P455BinaryTerms.Term), ∀ s t,
      (∀ f : ℕ → Fin T.length, P455StatementAudit.val good f s = P455StatementAudit.val good f t) ↔
      P455SemanticConsequence.entails (fun u v => (u,v) ∈ R) s t) :
    FinitelyBased T := by
  obtain ⟨R, laws⟩ := h
  let translate (e : P455BinaryTerms.Term × P455BinaryTerms.Term) := (fromOld e.1, fromOld e.2)
  refine ⟨R.map translate, ?_⟩
  intro s t
  have valid : Holds T s t ↔ P455BinaryBasis.ValidTerm T (toOld s) (toOld t) := by
    unfold Holds P455BinaryBasis.ValidTerm
    simp only [old_table_eval]
  rw [valid, P455StatementAudit.assignments good, laws]
  unfold Entails P455SemanticConsequence.entails P455SemanticConsequence.satisfies
  constructor
  · intro hn A op hm f
    have result := hn A op (fun u v huv g => by
      have hm' := hm (fromOld u, fromOld v) (List.mem_map.mpr ⟨(u,v), huv, rfl⟩) g
      simpa only [← old_eval, new_old] using hm') f
    simpa only [old_eval] using result
  · intro hn A op hm f
    have result := hn A op (fun e he g => by
      obtain ⟨e', he', eq⟩ := List.mem_map.mp he
      cases eq
      simpa only [translate, ← old_eval, new_old] using hm e'.1 e'.2 he' g) f
    simpa only [old_eval] using result

theorem exact_target :
    ¬ ∃ p : Table →. Bool, Partrec p ∧
      ∀ T, IsSemigroupTable T → ∃ b ∈ p T, (b = true ↔ FinitelyBased T) := by
  intro ⟨p, hp, hs⟩
  apply P455Undecidability.finite_semigroup_finite_basis_undecidable
  refine ⟨p, hp, fun T good => ?_⟩
  obtain ⟨b, hb, claim⟩ := hs T (old_good T good)
  exact ⟨b, hb, claim.trans ⟨old_basis T good, basis_of_old T good⟩⟩

end OMA.S_tarski_finite_basis_semigroups

theorem OMA.solution : type_of% @OMA.S_tarski_finite_basis_semigroups.main := by
  exact OMA.S_tarski_finite_basis_semigroups.exact_target
