section
namespace P455MachineLocal
inductive Direction | left | stay | right
  deriving DecidableEq
structure Ins (A Q : Type) where
  state : Q
  symbol : A
  dir : Direction
  deriving DecidableEq
structure Cell (A Q : Type) where
  sym : A
  head : Option Q
  deriving DecidableEq
def action (d : Q → A → Ins A Q) (c : Cell A Q) := c.head.map fun q=>d q c.sym
def sends (i : Ins A Q) (toward : Direction) : Option Q := if i.dir = toward then some i.state else none
def update (d : Q → A → Ins A Q) (l : Option (Cell A Q)) (c : Cell A Q) (r : Option (Cell A Q)) :
    Option (Cell A Q) :=
  match l.bind (action d), action d c, r.bind (action d) with
  | none,none,none => some ⟨c.sym,none⟩
  | some a,none,none => some ⟨c.sym,sends a .right⟩
  | none,none,some a => some ⟨c.sym,sends a .left⟩
  | none,some a,none =>
    if (a.dir=.left ∧ l.isNone = true) ∨ (a.dir=.right ∧ r.isNone = true) then none
    else some ⟨a.symbol,sends a .stay⟩
  | _,_,_ => none
def atCell (tape : Nat → A) (p : Nat) (q : Q) (x : Nat) : Cell A Q :=
  ⟨tape x,if x = p then some q else none⟩
def leftOf (row : Nat → α) (x : Nat) := if x = 0 then none else some (row (x-1))
def rightOf (row : Nat → α) (w x : Nat) := if x+1 = w then none else some (row (x+1))
def exits (dir : Direction) (w p : Nat) : Prop :=
  (dir=.left ∧ p = 0) ∨ (dir=.right ∧ p+1 = w)
instance (dir : Direction) (w p : Nat) : Decidable (exits dir w p) := by unfold exits; infer_instance
def dest (dir : Direction) (p : Nat) : Nat :=
  match dir with | .left => p-1 | .stay => p | .right => p+1
def writeAt (tape : Nat → A) (p : Nat) (a : A) (x : Nat) := if x = p then a else tape x
private theorem center_action (d : Q → A → Ins A Q) (tape : Nat → A) (p : Nat) (q : Q) (x : Nat) :
    action d (atCell tape p q x) = if x = p then some (d q (tape p)) else none := by
  by_cases e : x = p <;> simp [action,atCell,e]
private theorem left_action (d : Q → A → Ins A Q) (tape : Nat → A) (p : Nat) (q : Q) (x : Nat) :
    (leftOf (atCell tape p q) x).bind (action d) =
      if x = p+1 then some (d q (tape p)) else none := by
  by_cases e : x = 0
  · subst x; simp [leftOf]
  · have eq : (x-1 = p) ↔ x = p+1 := by omega
    simp [leftOf,e,center_action,eq]
private theorem right_action (d : Q → A → Ins A Q) (tape : Nat → A) (p w : Nat) (hp : p < w) (q : Q) (x : Nat) :
    (rightOf (atCell tape p q) w x).bind (action d) =
      if x+1 = p then some (d q (tape p)) else none := by
  by_cases e : x+1 = w
  · simp [rightOf,e,show w≠p by omega]
  · simp [rightOf,e,center_action]
private theorem left_boundary (row : Nat → α) (x : Nat) : (leftOf row x).isNone = true ↔ x = 0 := by
  by_cases e : x = 0 <;> simp [leftOf,e]
private theorem right_boundary (row : Nat → α) (w x : Nat) : (rightOf row w x).isNone = true ↔ x+1 = w := by
  by_cases e : x+1 = w <;> simp [rightOf,e]
theorem defined_at_head (d : Q → A → Ins A Q) (tape : Nat → A) (w p : Nat) (q : Q) (hp : p < w) :
    update d (leftOf (atCell tape p q) p) (atCell tape p q p) (rightOf (atCell tape p q) w p) = none
      ↔ exits (d q (tape p)).dir w p := by
  unfold update
  rw [left_action,right_action _ _ _ _ hp,center_action]
  simp only [if_neg (show p≠p+1 by omega),if_neg (show p+1≠p by omega),if_pos rfl]
  simp only [left_boundary,right_boundary]
  change (if exits (d q (tape p)).dir w p then _ else _) = none ↔ _
  by_cases e : exits (d q (tape p)).dir w p <;> simp [e]
theorem local_step (d : Q → A → Ins A Q) (tape : Nat → A) (w p : Nat) (q : Q)
    (hp : p < w) (safe : ¬exits (d q (tape p)).dir w p) (x : Nat) (hx : x < w) :
    let i := d q (tape p)
    update d (leftOf (atCell tape p q) x) (atCell tape p q x) (rightOf (atCell tape p q) w x)=
      some (atCell (writeAt tape p i.symbol) (dest i.dir p) i.state x) := by
  dsimp only
  unfold update
  rw [left_action,right_action _ _ _ _ hp,center_action]
  by_cases cp : x = p
  · subst x
    simp only [if_neg (show p≠p+1 by omega),if_neg (show p+1≠p by omega),if_pos rfl]
    change (if ((d q (tape p)).dir=.left ∧ (leftOf (atCell tape p q) p).isNone = true) ∨
      ((d q (tape p)).dir=.right ∧ (rightOf (atCell tape p q) w p).isNone = true)
      then none else some (Cell.mk (d q (tape p)).symbol (sends (d q (tape p)) .stay))) = _
    simp only [left_boundary,right_boundary]
    change (if exits (d q (tape p)).dir w p then _ else _) = _
    rw [if_neg safe]
    cases dir : (d q (tape p)).dir with
    | left =>
      have pos : p≠0 := by simpa [exits,dir] using safe
      simp [sends,dir,atCell,writeAt,dest,show p≠p-1 by omega]
    | stay => simp [sends,dir,atCell,writeAt,dest]
    | right => simp [sends,dir,atCell,writeAt,dest]
  · by_cases l : x = p+1
    · have r : x+1≠p := by omega
      simp only [if_pos l,if_neg cp,if_neg r]
      cases dir : (d q (tape p)).dir <;>
        simp [sends,dir,atCell,writeAt,dest,cp,show x≠p-1 by omega,l,show p+1≠p-1 by omega]
    · by_cases r : x+1 = p
      · simp only [if_neg l,if_neg cp,if_pos r]
        cases dir : (d q (tape p)).dir <;>
          simp [sends,dir,atCell,writeAt,dest,cp,l,show x = p-1 by omega,show p-1≠p by omega,show p-1≠p+1 by omega]
      · simp only [if_neg l,if_neg cp,if_neg r]
        cases dir : (d q (tape p)).dir <;>
          simp [sends,dir,atCell,writeAt,dest,cp,l,show x≠p-1 by omega]
end P455MachineLocal
end
section
namespace P455Quotient
abbrev Word (α : Type) := List α
inductive Walk {α : Type} (s : α → α → Prop) : α → α → Prop
  | refl (a) : Walk s a a
  | snoc {a b c} : Walk s a b → s b c → Walk s a c
namespace Walk
theorem trans {s : α → α → Prop} (h : Walk s x y) (k : Walk s y z) : Walk s x z := by
  induction k with
  | refl => exact h
  | snoc _ step ih => exact .snoc ih step
theorem symm {s : α → α → Prop} (rev : ∀ {x y}, s x y → s y x) (h : Walk s x y) :
    Walk s y x := by
  induction h with
  | refl => exact .refl _
  | snoc _ step ih => exact (Walk.snoc (.refl _) (rev step)).trans ih
theorem transport {s : α → α → Prop} {P : α → Prop} (h : Walk s x y) (px : P x)
    (step : ∀ {u v}, s u v → P u → P v) : P y := by
  induction h with
  | refl => exact px
  | snoc _ move ih => exact step move ih
end Walk
section
variable {α : Type} [DecidableEq α]
def Cap (r : Nat) (u : (Word α)) : Prop := ∀ a : α, u.count a ≤ r
structure Rules (α : Type) [DecidableEq α] where
  r : Nat
  step : Word α → Word α → Prop
  reverse : ∀ {u v}, step u v → step v u
  counts : ∀ {u v}, step u v → ∀ a, u.count a = v.count a
  extend : ∀ {u v}, step u v → ∀ l t, Cap r (l ++ u ++ t) →
    step (l ++ u ++ t) (l ++ v ++ t)
variable (R : Rules α)
abbrev Variant (T v : (Word α)) := Walk R.step T v
def Factor (u v : (Word α)) := ∃ l t : Word α, v = l ++ u ++ t
def Good (T u : (Word α)) := ∃ v, Variant R T v ∧ Factor u v
theorem count_walk {u v : (Word α)} (h : Walk R.step u v) (a : α) : u.count a = v.count a := by
  induction h with
  | refl => rfl
  | snoc _ step ih => exact ih.trans (R.counts step a)
theorem contextual_walk {u v : (Word α)} (h : Walk R.step u v) (l t : Word α)
    (hc : Cap R.r (l ++ u ++ t)) : Walk R.step (l ++ u ++ t) (l ++ v ++ t) := by
  induction h with
  | refl => exact .refl _
  | snoc pre mv ih =>
    apply Walk.snoc ih (R.extend mv l t ?_)
    intro a
    have eq := count_walk R pre a
    have bound := hc a
    simp only [List.count_append] at *
    omega
theorem good_context {T u v : (Word α)} (hc : Cap R.r T) (h : Walk R.step u v)
    (l t : Word α) : Good R T (l ++ u ++ t) ↔ Good R T (l ++ v ++ t) := by
  suffices f : ∀ {x y}, Walk R.step x y → Good R T (l ++ x ++ t) → Good R T (l ++ y ++ t) from
    ⟨f h, f (h.symm R.reverse)⟩
  intro x y path ⟨variant, reach, left, right, eq⟩
  subst variant
  have bound : Cap R.r ((left ++ l) ++ x ++ (t ++ right)) := by
    intro a
    have e := count_walk R reach a
    simp only [List.count_append] at *
    have := hc a
    omega
  have ext := contextual_walk R path (left ++ l) (t ++ right) bound
  simp only [List.append_assoc] at reach ext ⊢
  exact ⟨_, reach.trans ext, left, right, by simp [List.append_assoc]⟩
theorem good_cap {T u : (Word α)} (hc : Cap R.r T) (h : Good R T u) : Cap R.r u := by
  obtain ⟨_, reach, l, t, rfl⟩ := h
  intro a
  have e := count_walk R reach a
  have b := hc a
  simp only [List.count_append] at e
  omega
theorem factor_good {T u v : (Word α)} (g : Good R T v) (f : Factor u v) : Good R T u := by
  obtain ⟨w, path, l, t, hw⟩ := g
  obtain ⟨l', t', hv⟩ := f
  exact ⟨w, path, l ++ l', t' ++ t, by simp [hw, hv, List.append_assoc]⟩
abbrev Raw (α : Type) := Option (Word α)
def mulRaw : Raw α → Raw α → Raw α
  | some u, some v => some (u ++ v)
  | _, _ => none
def Live (T : (Word α)) : Raw α → Prop
  | none => False
  | some u => Good R T u
def Rel (T : (Word α)) (x y : Raw α) : Prop :=
  (¬ Live R T x ∧ ¬ Live R T y) ∨
  ∃ u v : (Word α), x = some u ∧ y = some v ∧ Good R T u ∧ Good R T v ∧ Walk R.step u v
theorem rel_refl (T : (Word α)) (x : Raw α) : Rel R T x x := by
  by_cases h : Live R T x
  · cases x with
    | none => exact h.elim
    | some u => exact Or.inr ⟨u,u,rfl,rfl,h,h,.refl _⟩
  · exact Or.inl ⟨h,h⟩
theorem rel_symm {T : (Word α)} {x y : Raw α} : Rel R T x y → Rel R T y x := by
  rintro (⟨a,b⟩ | ⟨u,v,rfl,rfl,gu,gv,h⟩)
  · exact Or.inl ⟨b,a⟩
  · exact Or.inr ⟨v,u,rfl,rfl,gv,gu,h.symm R.reverse⟩
theorem rel_trans {T : (Word α)} {x y z : Raw α} : Rel R T x y → Rel R T y z → Rel R T x z := by
  rintro (⟨a,b⟩ | ⟨u,v,rfl,rfl,gu,gv,h⟩) k
  · rcases k with ⟨_,c⟩ | ⟨v,w,rfl,rfl,gv,_,_⟩
    · exact Or.inl ⟨a,c⟩
    · exact (b gv).elim
  · rcases k with ⟨b,_⟩ | ⟨v',w,e,rfl,_,gw,h'⟩
    · exact (b gv).elim
    · cases e
      exact Or.inr ⟨u,w,rfl,rfl,gu,gw,h.trans h'⟩
def setoid (T : (Word α)) : Setoid (Raw α) where
  r := Rel R T
  iseqv := ⟨rel_refl R T, rel_symm R, rel_trans R⟩
abbrev Q (T : (Word α)) := Quotient (setoid R T)
def context (l t : Word α) : Raw α → Raw α
  | none => none
  | some u => some (l ++ u ++ t)
theorem dead_context {T : (Word α)} {x : Raw α} (d : ¬ Live R T x) (l t : Word α) :
    ¬ Live R T (context l t x) := by
  cases x with
  | none => exact id
  | some u => exact fun g => d (factor_good R g ⟨l,t,rfl⟩)
theorem rel_context {T : (Word α)} (hc : Cap R.r T) {x y : Raw α} (h : Rel R T x y)
    (l t : Word α) : Rel R T (context l t x) (context l t y) := by
  rcases h with ⟨a,b⟩ | ⟨u,v,rfl,rfl,_,_,path⟩
  · exact Or.inl ⟨dead_context R a l t,dead_context R b l t⟩
  · have equiv := good_context R hc path l t
    by_cases gu : Good R T (l ++ u ++ t)
    · exact Or.inr ⟨_,_,rfl,rfl,gu,equiv.mp gu,contextual_walk R path l t (good_cap R hc gu)⟩
    · exact Or.inl ⟨gu,fun gv => gu (equiv.mpr gv)⟩
theorem mul_compat {T : (Word α)} (hc : Cap R.r T) {x y z t : Raw α}
    (h : Rel R T x y) (k : Rel R T z t) : Rel R T (mulRaw x z) (mulRaw y t) := by
  apply rel_trans R (y := mulRaw y z)
  · cases z with
    | none => cases x <;> cases y <;> exact rel_refl R _ _
    | some w =>
      have e := rel_context R hc h [] w
      cases x <;> cases y <;> exact e
  · cases y with
    | none => exact rel_refl R _ _
    | some w =>
      have e := rel_context R hc k w []
      cases z <;> cases t <;> simpa only [context, mulRaw, List.append_nil] using e
def cls (T : (Word α)) (x : Raw α) : Q R T := Quotient.mk _ x
def mul {T : (Word α)} (hc : Cap R.r T) (x y : Q R T) : Q R T :=
  Quotient.liftOn₂ x y (fun a b => cls R T (mulRaw a b))
    (fun _ _ _ _ h k => Quotient.sound (mul_compat R hc h k))
def zero (T : (Word α)) : Q R T := cls R T none
def ofWord (T u : (Word α)) : Q R T := cls R T (some u)
theorem mul_assoc {T : (Word α)} (hc : Cap R.r T) (x y z : Q R T) :
    mul R hc (mul R hc x y) z = mul R hc x (mul R hc y z) := by
  induction x using Quotient.inductionOn with | _ a =>
    induction y using Quotient.inductionOn with | _ b =>
      induction z using Quotient.inductionOn with | _ c =>
        change cls R T (mulRaw (mulRaw a b) c) = cls R T (mulRaw a (mulRaw b c))
        apply congrArg (cls R T)
        cases a <;> cases b <;> cases c <;> simp only [mulRaw, List.append_assoc]
theorem unit_laws {T : (Word α)} (hc : Cap R.r T) (q : Q R T) :
    mul R hc (ofWord R T []) q = q ∧ mul R hc q (ofWord R T []) = q := by
  refine Quotient.inductionOn
    (motive := fun a : Q R T => mul R hc (ofWord R T []) a = a ∧ mul R hc a (ofWord R T []) = a)
    q ?_
  intro a
  change cls R T (mulRaw (some []) a) = cls R T a ∧ cls R T (mulRaw a (some [])) = cls R T a
  cases a <;> simp only [mulRaw, List.nil_append, List.append_nil, and_self]
theorem absorbing {T : (Word α)} (hc : Cap R.r T) (q : Q R T) :
    mul R hc (zero R T) q = zero R T ∧ mul R hc q (zero R T) = zero R T := by
  induction q using Quotient.inductionOn with | _ a =>
    cases a <;> exact ⟨rfl,rfl⟩
theorem nonzero_iff {T u : (Word α)} : ofWord R T u ≠ zero R T ↔ Good R T u := by
  constructor
  · intro h
    by_cases good : Good R T u
    · exact good
    · exact (h (Quotient.sound (Or.inl ⟨good,id⟩ : Rel R T (some u) none))).elim
  · intro good eq
    have e : Rel R T (some u) none := Quotient.exact eq
    rcases e with ⟨bad,_⟩ | ⟨_,_,_,e,_,_,_⟩
    · exact bad good
    · contradiction
theorem same_nonzero_class {T u v : (Word α)} (g : Good R T u) :
    ofWord R T u = ofWord R T v ↔ Good R T v ∧ Walk R.step u v := by
  constructor
  · intro e
    have h : Rel R T (some u) (some v) := Quotient.exact e
    rcases h with ⟨bad,_⟩ | ⟨_,_,ea,eb,_,gv,path⟩
    · exact (bad g).elim
    · cases ea
      cases eb
      exact ⟨gv,path⟩
  · rintro ⟨gv,path⟩
    exact Quotient.sound (Or.inr ⟨u,v,rfl,rfl,g,gv,path⟩ : Rel R T (some u) (some v))
theorem nonzero_representative {T : (Word α)} (q : Q R T) (nz : q ≠ zero R T) :
    ∃ u, Good R T u ∧ ofWord R T u = q := by
  induction q using Quotient.inductionOn with | _ a =>
    cases a with
    | none => exact (nz rfl).elim
    | some u => exact ⟨u,(nonzero_iff R).mp nz,rfl⟩
def eval {T : (Word α)} (hc : Cap R.r T) (a : β → Q R T) : List β → Q R T
  | [] => ofWord R T []
  | x :: xs => mul R hc (a x) (eval hc a xs)
theorem eval_rep {T : (Word α)} (hc : Cap R.r T) (a : β → Q R T)
    (v : List β) (h : β → Word α) (reps : ∀ x ∈ v, ofWord R T (h x) = a x) :
    eval R hc a v = ofWord R T (v.flatMap h) := by
  induction v with
  | nil => rfl
  | cons x xs ih =>
    rw [eval, ← reps x (by simp), ih (fun y hy => reps y (by simp [hy]))]
    rfl
theorem arbitrary_representatives {T : (Word α)} (hc : Cap R.r T) (a : β → Q R T)
    (v : List β) (h : β → Word α) (reps : ∀ x ∈ v, ofWord R T (h x) = a x) :
    eval R hc a v ≠ zero R T ↔
    ∃ variant l t, Variant R T variant ∧ variant = l ++ v.flatMap h ++ t := by
  rw [eval_rep R hc a v h reps, nonzero_iff]
  constructor
  · rintro ⟨z,path,l,t,e⟩; exact ⟨z,l,t,path,e⟩
  · rintro ⟨z,l,t,path,e⟩; exact ⟨z,path,l,t,e⟩
theorem live_inputs {T : (Word α)} (hc : Cap R.r T) (a : β → Q R T)
    (v : List β) (nz : eval R hc a v ≠ zero R T) : ∀ x ∈ v, a x ≠ zero R T := by
  induction v with
  | nil => simp
  | cons y ys ih =>
    have yn : a y ≠ zero R T := fun h => nz (by rw [eval,h,(absorbing R hc _).1])
    have ns : eval R hc a ys ≠ zero R T := fun h => nz (by rw [eval,h,(absorbing R hc _).2])
    intro x hx
    rcases List.mem_cons.mp hx with e | hx
    · exact e ▸ yn
    · exact ih ns x hx
theorem designated {T : (Word α)} (hc : Cap R.r T) (a : β → Q R T) (v : List β)
    (h : β → Word α) (reps : ∀ x ∈ v, ofWord R T (h x) = a x)
    (nz : eval R hc a v ≠ zero R T) (P : Word α → Prop)
    (initial : P T) (one : ∀ {x y}, R.step x y → P x → P y) :
    ∃ variant l t, Variant R T variant ∧ variant = l ++ v.flatMap h ++ t ∧ P variant := by
  obtain ⟨z,l,t,path,eq⟩ := (arbitrary_representatives R hc a v h reps).mp nz
  exact ⟨z,l,t,path,eq,path.transport initial one⟩
end
end P455Quotient
end
section
namespace Problem455.Slots
abbrev Word := List Nat
abbrev Event := Nat × Nat
def advance (n : Nat → Nat) (w : Word) : Nat → Nat :=
  fun a => n a + w.count a
def stamp (n : Nat → Nat) : Word → List Event
  | [] => []
  | a :: w => (a, n a) :: stamp (advance n [a]) w
def events (w : Word) := stamp (fun _ => 0) w
theorem advance_append (n : Nat → Nat) (u v : Word) :
    advance (advance n u) v = advance n (u ++ v) := by
  funext a
  simp [advance, List.count_append, Nat.add_assoc]
theorem stamp_append (n : Nat → Nat) (u v : Word) :
    stamp n (u ++ v) = stamp n u ++ stamp (advance n u) v := by
  induction u generalizing n with
  | nil =>
    have hn : advance n [] = n := by funext a; simp [advance]
    simp [stamp, hn]
  | cons a u ih =>
    simp only [List.cons_append, stamp, ih]
    rw [advance_append]
    rfl
theorem stamp_at (n : Nat → Nat) (m : Nat) (u : Word)
    (nd : u.Nodup) (hm : ∀ a ∈ u, n a = m) :
    stamp n u = u.map (fun a => (a, m)) := by
  induction u generalizing n with
  | nil => rfl
  | cons a u ih =>
    obtain ⟨fresh, rest⟩ := List.nodup_cons.mp nd
    simp only [stamp, List.map_cons]
    rw [hm a (by simp), ih _ rest]
    intro b hb
    have hne : a ≠ b := by intro eq; exact fresh (eq ▸ hb)
    simp [advance, hne, Ne.symm hne, hm b (by simp [hb])]
structure Move (m : Nat) where
  pre : Word
  p : Word
  q : Word
  post : Word
  dp : p.Nodup
  dq : q.Nodup
  disjoint : ∀ a ∈ p, a ∉ q
  indexP : ∀ a ∈ p, pre.count a = m
  indexQ : ∀ a ∈ q, pre.count a = m
def before {m : Nat} (s : Move m) := s.pre ++ (s.p ++ (s.q ++ s.post))
def after {m : Nat} (s : Move m) := s.pre ++ (s.q ++ (s.p ++ s.post))
def tagged (m : Nat) (w : Word) : List Event := w.map (fun a => (a, m))
theorem move_events {m : Nat} (s : Move m) :
    ∃ lo hi : List Event,
      events (before s) = lo ++ (tagged m s.p ++ (tagged m s.q ++ hi)) ∧
      events (after s) = lo ++ (tagged m s.q ++ (tagged m s.p ++ hi)) := by
  let n := fun a => s.pre.count a
  have hn : advance (fun _ => 0) s.pre = n := by funext a; simp [advance, n]
  have hp : stamp n s.p = tagged m s.p := stamp_at _ _ _ s.dp s.indexP
  have hq : stamp n s.q = tagged m s.q := stamp_at _ _ _ s.dq s.indexQ
  have hp' : stamp (advance n s.q) s.p = tagged m s.p := by
    apply stamp_at _ _ _ s.dp
    intro a ha
    simp [advance, List.count_eq_zero.mpr (s.disjoint a ha), n, s.indexP a ha]
  have hq' : stamp (advance n s.p) s.q = tagged m s.q := by
    apply stamp_at _ _ _ s.dq
    intro a ha
    have fresh : a ∉ s.p := fun hp => s.disjoint a hp ha
    simp [advance, List.count_eq_zero.mpr fresh, n, s.indexQ a ha]
  have merge : advance (advance n s.p) s.q = advance (advance n s.q) s.p := by
    funext a
    simp [advance, Nat.add_right_comm]
  refine ⟨events s.pre, stamp (advance (advance n s.q) s.p) s.post, ?_, ?_⟩
  · simp only [events, before, stamp_append, hn]
    change _ ++ (stamp n s.p ++ (stamp (advance n s.p) s.q ++ _)) = _
    rw [hp, hq', merge]
  · simp only [events, after, stamp_append, hn]
    change _ ++ (stamp n s.q ++ (stamp (advance n s.q) s.p ++ _)) = _
    rw [hq, hp']
def select {α : Type} [DecidableEq α] (keep w : List α) : List α :=
  w.filter (fun e => decide (e ∈ keep))
theorem select_append {α : Type} [DecidableEq α] (keep u v : List α) :
    select keep (u ++ v) = select keep u ++ select keep v := List.filter_append ..
theorem select_nil {α : Type} [DecidableEq α] (keep w : List α)
    (h : ∀ a ∈ w, a ∉ keep) : select keep w = [] := by
  apply List.filter_eq_nil_iff.mpr
  simpa using h
theorem selected_swap {α : Type} [DecidableEq α] (keep lo p q hi : List α)
    (nc : (∀ a ∈ p, a ∉ keep) ∨ (∀ a ∈ q, a ∉ keep)) :
    select keep (lo ++ (p ++ (q ++ hi))) = select keep (lo ++ (q ++ (p ++ hi))) := by
  rcases nc with h | h
  · simp [select_append, select_nil keep p h]
  · simp [select_append, select_nil keep q h]
theorem protected_projection {m : Nat} (s : Move m) (keep : List Nat)
    (nc : (∀ a ∈ s.p, a ∉ keep) ∨ (∀ a ∈ s.q, a ∉ keep)) :
    select keep (before s) = select keep (after s) :=
  selected_swap keep _ _ _ _ nc
theorem observed_events {m : Nat} (s : Move m) (keep : List Event)
    (nc : (∀ a ∈ s.p, (a,m) ∉ keep) ∨ (∀ a ∈ s.q, (a,m) ∉ keep)) :
    select keep (events (before s)) = select keep (events (after s)) := by
  obtain ⟨lo, hi, h, h'⟩ := move_events s
  rw [h, h']
  apply selected_swap
  simpa [tagged] using nc
def sees (w : Word) (pattern : List Event) := pattern.Sublist (events w)
theorem sublist_select_self {α : Type} [DecidableEq α] (t w : List α) :
    t.Sublist (select t w) ↔ t.Sublist w := by
  constructor
  · intro h
    exact h.trans (List.filter_sublist ..)
  · intro h
    have hf := h.filter (fun x => decide (x ∈ t))
    have self : t.filter (fun x => decide (x ∈ t)) = t := by
      apply List.filter_eq_self.mpr
      simp
    rwa [self] at hf
theorem sees_invariant {m : Nat} (s : Move m) (t : List Event)
    (nc : (∀ a ∈ s.p, (a,m) ∉ t) ∨ (∀ a ∈ s.q, (a,m) ∉ t)) :
    sees (before s) t ↔ sees (after s) t := by
  unfold sees
  rw [← sublist_select_self t (events (before s)),
      ← sublist_select_self t (events (after s)), observed_events s t nc]
theorem immutable_pattern {m : Nat} (s : Move m) (t : List Event)
    (hm : ∀ e ∈ t, e.2 ≠ m) :
    sees (before s) t ↔ sees (after s) t := by
  apply sees_invariant
  left
  exact fun a _ he => hm (a,m) he rfl
theorem open_slot_event {m : Nat} (s : Move m) (owner i j : Nat) (e : Event)
    (hi : i ≠ m) (hj : j ≠ m) :
    sees (before s) [(owner,i),e,(owner,j)] ↔
      sees (after s) [(owner,i),e,(owner,j)] := by
  apply sees_invariant
  by_cases h : e.1 ∈ s.p
  · right
    intro a ha
    have diff : (a,m) ≠ e := by
      intro eq
      have : a = e.1 := congrArg Prod.fst eq
      exact s.disjoint e.1 h (this ▸ ha)
    simp [diff, Ne.symm hi, Ne.symm hj]
  · left
    intro a ha
    have diff : (a,m) ≠ e := by
      intro eq
      have : a = e.1 := congrArg Prod.fst eq
      exact h (this ▸ ha)
    simp [diff, Ne.symm hi, Ne.symm hj]
def slotStart (i : Nat) : Prop :=
  i = 0 ∨ i = 1 ∨ i = 3 ∨ i = 5 ∨ i = 7 ∨ i = 9 ∨ i = 11
def occupies (w : Word) (owner i a : Nat) : Prop :=
  ∃ j, sees w [(owner,i),(a,j),(owner,i+1)]
def pair (a b : Nat) (bit : Bool) : Word := if bit then [b,a] else [a,b]
def profilePrefix (a b : Nat) (tag : List Bool) : Word :=
  [a,a,b,a,b,b] ++ (List.replicate 5 [a,b,a,b]).flatten ++
    tag.flatMap (pair a b) ++ [a,b]
def profile (a b : Nat) (tag : List Bool) (bit : Bool) : Word :=
  profilePrefix a b tag ++ (pair a b bit ++ [a,b])
def typed (w : Word) (a b : Nat) (tag : List Bool) : Prop :=
  ∃ bit, select [a,b] w = profile a b tag bit
theorem tag_length (a b : Nat) (tag : List Bool) :
    (tag.flatMap (pair a b)).length = 2 * tag.length := by
  induction tag with
  | nil => rfl
  | cons bit t ih => cases bit <;> simp [pair, ih] <;> omega
theorem profile_prefix_length (a b : Nat) (tag : List Bool) :
    (profilePrefix a b tag).length = 2 * (14+tag.length) := by
  unfold profilePrefix
  simp only [List.length_append, tag_length]
  change 6 + 20 + (2*tag.length) + 2 = _
  omega
theorem length_select_pair (a b : Nat) (hab : a ≠ b) (w : Word) :
    (select [a,b] w).length = w.count a + w.count b := by
  induction w with
  | nil => rfl
  | cons c w ih =>
    unfold select at *
    simp at ih
    by_cases hca : c = a
    · subst c
      simp [List.count_cons, hab, Ne.symm hab, ih]; omega
    · by_cases hcb : c = b
      · subst c
        simp [List.count_cons, hab, Ne.symm hab, ih]; omega
      · simp [List.count_cons, hca, hcb, Ne.symm hca, Ne.symm hcb, ih]
theorem select_lone (a b : Nat) (w : Word) (hd : w.Nodup)
    (ha : a ∈ w) (hb : b ∉ w) :
    select [a,b] w = [a] := by
  induction w with
  | nil => simp at ha
  | cons c w ih =>
    obtain ⟨hc,ht⟩ := List.nodup_cons.mp hd
    by_cases hca : c = a
    · subst c
      have hnil : select [a,b] w = [] := by
        apply select_nil
        intro x hx
        simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
        exact ⟨fun e => hc (e ▸ hx),fun e => hb (by simp [e ▸ hx])⟩
      simpa [select, List.filter_cons] using congrArg (List.cons a) hnil
    · have hc' : c ≠ b := fun h => hb (by simp [h])
      have ha' : a ∈ w := by simpa [Ne.symm hca] using ha
      have hb' : b ∉ w := fun h => hb (by simp [h])
      simpa [select, hca, hc'] using ih ht ha' hb'
theorem select_pair_symm (a b : Nat) (w : Word) : select [b,a] w = select [a,b] w := by
  unfold select
  apply List.filter_congr
  intro x _
  simp [or_comm]
private theorem exchange_at_split (a b : Nat) (lo hi fixed tail : Word)
    (len : lo.length = fixed.length) (bit : Bool) :
    (∃ b', lo ++ (pair a b bit ++ hi) = fixed ++ (pair a b b' ++ tail)) →
    (∃ b', lo ++ (pair a b (!bit) ++ hi) = fixed ++ (pair a b b' ++ tail)) := by
  rintro ⟨old,h⟩
  have eqPre : lo = fixed := by
    have ht := congrArg (List.take lo.length) h
    simpa [len] using ht
  subst fixed
  have he := List.append_cancel_left h
  have eqHi : hi = tail := by
    have hd := congrArg (List.drop 2) he
    cases bit <;> cases old <;> simpa [pair] using hd
  exact ⟨!bit,by rw [eqHi]⟩
theorem type_forward {m : Nat} (s : Move m) (a b : Nat) (tag : List Bool)
    (hab : a ≠ b) (hm : m = 14 + tag.length) :
    typed (before s) a b tag → typed (after s) a b tag := by
  let keep := [a,b]
  by_cases hp : ∀ x ∈ s.p, x ∉ keep
  · intro e
    unfold typed at *
    rw [← protected_projection s [a,b] (.inl hp)]; exact e
  by_cases hq : ∀ x ∈ s.q, x ∉ keep
  · intro e
    unfold typed at *
    rw [← protected_projection s [a,b] (.inr hq)]; exact e
  have shape : (a ∈ s.p ∧ b ∈ s.q) ∨ (b ∈ s.p ∧ a ∈ s.q) := by
    by_cases hap : a ∈ s.p
    · left
      refine ⟨hap,?_⟩
      apply Classical.byContradiction
      intro hbn
      apply hq
      intro x hx
      simp only [keep, List.mem_cons, List.not_mem_nil, or_false, not_or]
      exact ⟨fun eq => s.disjoint a hap (eq ▸ hx), fun eq => hbn (eq ▸ hx)⟩
    · have hbp : b ∈ s.p := by
        apply Classical.byContradiction
        intro hbn
        apply hp
        intro x hx
        simp only [keep, List.mem_cons, List.not_mem_nil, or_false, not_or]
        exact ⟨fun eq => hap (eq ▸ hx), fun eq => hbn (eq ▸ hx)⟩
      right
      refine ⟨hbp,?_⟩
      apply Classical.byContradiction
      intro han
      apply hq
      intro x hx
      simp only [keep, List.mem_cons, List.not_mem_nil, or_false, not_or]
      exact ⟨fun eq => han (eq ▸ hx),fun eq => s.disjoint b hbp (eq ▸ hx)⟩
  obtain ⟨bit,hp1,hq1,ca,cb⟩ :
      ∃ bit : Bool, select [a,b] s.p ++ select [a,b] s.q = pair a b bit ∧
        select [a,b] s.q ++ select [a,b] s.p = pair a b (!bit) ∧
        s.pre.count a = m ∧ s.pre.count b = m := by
    rcases shape with ⟨pa,qb⟩ | ⟨pb,qa⟩
    · have p' := select_lone a b s.p s.dp pa (fun pb => s.disjoint b pb qb)
      have q' := select_lone b a s.q s.dq qb (s.disjoint a pa)
      rw [select_pair_symm] at q'
      exact ⟨false,by rw [p',q']; rfl,by rw [p',q']; rfl,s.indexP a pa,s.indexQ b qb⟩
    · have p' := select_lone b a s.p s.dp pb (fun pa => s.disjoint a pa qa)
      rw [select_pair_symm] at p'
      have q' := select_lone a b s.q s.dq qa (s.disjoint b pb)
      exact ⟨true,by rw [p',q']; rfl,by rw [p',q']; rfl,s.indexQ a qa,s.indexP b pb⟩
  have len : (select [a,b] s.pre).length = (profilePrefix a b tag).length := by
    rw [length_select_pair a b hab, ca, cb, hm, profile_prefix_length]; omega
  unfold typed before after profile
  simp only [select_append]
  rw [← List.append_assoc (select [a,b] s.p), hp1,
      ← List.append_assoc (select [a,b] s.q), hq1]
  exact exchange_at_split a b _ _ _ _ len bit
end Problem455.Slots
end
section
namespace P455Closure
universe u
variable {α : Type u} [DecidableEq α]
def Cap (r : Nat) (w : List α) : Prop := ∀ a, w.count a ≤ r
def phasePair (b : Bool) : List Bool := [b, !b]
def fixedPhases (tag : List Bool) : List Bool :=
  (List.replicate 5 [false,true,false,true]).flatten ++ tag.flatMap phasePair ++ phasePair false
structure Frame (α : Type u) where
  pHead : α
  pTail : List α
  qInit : List α
  qLast : α
  tag : List Bool
  middle : List (List α × Bool)
  beforeMutable : List α
  beforeFinalP : List α
  beforeFinalQ : List α
namespace Frame
variable (f : Frame α)
def p := f.pHead :: f.pTail
def q := f.qInit ++ [f.qLast]
def pair (b : Bool) := if b then f.q ++ f.p else f.p ++ f.q
def early := f.p ++ f.p ++ f.q ++ f.p ++ f.q ++ f.q
def mid := f.middle.flatMap fun e => e.1 ++ (if e.2 then f.q else f.p)
def core (b : Bool) := f.early ++ f.mid ++ f.beforeMutable ++ f.pair b ++
                        f.beforeFinalP ++ f.p ++ f.beforeFinalQ ++ f.q
def Valid (r : Nat) (Allowed : List Bool → Prop) (Mark : α → α → Prop) : Prop :=
  r = 16 + f.tag.length ∧ Allowed f.tag ∧ f.middle.map Prod.snd = fixedPhases f.tag ∧
  f.p.Nodup ∧ f.q.Nodup ∧ (∀ a ∈ f.p, a ∉ f.q) ∧
  (∀ a ∈ f.p, ∀ b ∈ f.q, ¬ Mark a b ∧ ¬ Mark b a) ∧
  (∀ a, a ∈ f.p ∨ a ∈ f.q → (f.core false).count a = r)
theorem count_core (a : α) (b : Bool) : (f.core b).count a = (f.core (!b)).count a := by
  cases b <;> simp [core, pair, List.count_append] <;> omega
omit [DecidableEq α] in
theorem core_starts (b : Bool) : ∃ tail, f.core b = f.pHead :: tail := by
  simp [core, early, p]
private theorem count_tag_pairs (tag : List Bool) (side : Bool) :
    (tag.flatMap phasePair).count side = tag.length := by
  induction tag with
  | nil => rfl
  | cons b bs ih =>
    cases b <;> cases side <;> simp_all [phasePair,List.count_cons,Nat.add_comm]
private theorem fixed_count (tag : List Bool) (side : Bool) :
    (fixedPhases tag).count side = 11 + tag.length := by
  cases side <;> simp [fixedPhases,count_tag_pairs,phasePair,List.count_cons,Nat.add_comm,
    List.replicate_succ] <;> omega
private theorem token_count_le (p q : List α) (a : α) (side : Bool)
    (has : 1 ≤ (if side then q else p).count a) (es : List (List α × Bool)) :
    (es.map Prod.snd).count side ≤
      (es.flatMap fun e => e.1 ++ (if e.2 then q else p)).count a := by
  induction es with
  | nil => simp
  | cons hd es ih =>
    obtain ⟨w,b⟩ := hd
    cases b <;> cases side <;>
      simp only [Bool.false_eq_true,if_false,if_true] at has <;>
      simp [List.count_cons] <;> omega
private theorem index_of_order {r : Nat} (hr : r = 16 + f.tag.length)
    (hmid : f.middle.map Prod.snd = fixedPhases f.tag) (bit : Bool) (l t : List α)
    (hc : Cap r (l ++ f.core bit ++ t)) (a : α) (ha : a ∈ f.p ∨ a ∈ f.q) :
    (l ++ f.early ++ f.mid ++ f.beforeMutable).count a = 14 + f.tag.length := by
  have hcap := hc a
  have hpq : 1 ≤ f.p.count a ∨ 1 ≤ f.q.count a := ha.imp List.count_pos_iff.mpr List.count_pos_iff.mpr
  have h1 : 11 + f.tag.length ≤ f.mid.count a := by
    rcases hpq with hp | hq
    · have h := token_count_le f.p f.q a false (by simpa using hp) f.middle
      simpa [hmid,fixed_count,mid] using h
    · have h := token_count_le f.p f.q a true (by simpa using hq) f.middle
      simpa [hmid,fixed_count,mid] using h
  have h2 : 3 ≤ f.early.count a := by simp [early]; omega
  have h3 : 1 ≤ (f.pair bit).count a := by cases bit <;> simp [pair] <;> omega
  simp only [core,List.count_append] at hcap ⊢
  omega
theorem mutable_index {r : Nat} {Allowed : List Bool → Prop} {Mark : α → α → Prop}
    (hf : f.Valid r Allowed Mark) (bit : Bool) (l t : List α)
    (hc : Cap r (l ++ f.core bit ++ t)) (a : α) (ha : a ∈ f.p ∨ a ∈ f.q) :
    (l ++ f.early ++ f.mid ++ f.beforeMutable).count a = 14 + f.tag.length := by
  exact f.index_of_order hf.1 hf.2.2.1 bit l t hc a ha
theorem saturation_of_order {r : Nat} (hr : r = 16 + f.tag.length)
    (hmid : f.middle.map Prod.snd = fixedPhases f.tag) (bit : Bool) (l t : List α)
    (hc : Cap r (l ++ f.core bit ++ t)) (a : α) (ha : a ∈ f.p ∨ a ∈ f.q) :
    (f.core false).count a = r := by
  have hc' : Cap r ([] ++ f.core false ++ []) := by
    intro z
    have hh := hc z
    have hd : (f.core bit).count z = (f.core false).count z := by
      cases bit with
      | false => rfl
      | true => exact f.count_core z true
    simp only [List.count_append,hd, List.count_nil] at *
    omega
  have idx := f.index_of_order hr hmid false [] [] hc' a ha
  have bound := hc' a
  have sup : 1 ≤ f.p.count a ∨ 1 ≤ f.q.count a :=
    ha.imp List.count_pos_iff.mpr List.count_pos_iff.mpr
  simp only [List.nil_append,List.append_nil] at idx bound
  simp only [core,pair,Bool.false_eq_true,if_false,List.count_append] at idx bound ⊢
  omega
theorem valid_of_capped_shape {r : Nat} {Allowed : List Bool → Prop} {Mark : α → α → Prop}
    (hr : r = 16 + f.tag.length) (ht : Allowed f.tag)
    (order : f.middle.map Prod.snd = fixedPhases f.tag)
    (dp : f.p.Nodup) (dq : f.q.Nodup) (apart : ∀ a ∈ f.p, a ∉ f.q)
    (unmarked : ∀ a ∈ f.p, ∀ b ∈ f.q, ¬ Mark a b ∧ ¬ Mark b a)
    (bit : Bool) (l t : List α) (hc : Cap r (l ++ f.core bit ++ t)) :
    f.Valid r Allowed Mark :=
  ⟨hr,ht,order,dp,dq,apart,unmarked,f.saturation_of_order hr order bit l t hc⟩
def profileBits (tag : List Bool) (bit : Bool) : List Bool :=
  [false,false,true,false,true,true] ++ fixedPhases tag ++ phasePair bit ++ phasePair false
def profileWord (x y : α) (tag : List Bool) (bit : Bool) : List α :=
  (profileBits tag bit).map (fun b => if b then y else x)
omit [DecidableEq α] in
private theorem middle_trace (p q : List α) {x y : α} (hx : x ∈ p) (hy : y ∈ q)
    (es : List (List α × Bool)) :
    ((es.map Prod.snd).map (fun b => if b then y else x)).Sublist
      (es.flatMap fun e => e.1 ++ if e.2 then q else p) := by
  induction es with
  | nil => exact .slnil
  | cons e es ih =>
    obtain ⟨w,b⟩ := e
    have one : [if b then y else x].Sublist (w ++ (if b then q else p)) := by
      apply List.sublist_append_of_sublist_right
      cases b <;> simp [hx,hy]
    exact one.append ih
omit [DecidableEq α] in
private theorem profile_trace (bit : Bool) (x y : α) (hx : x ∈ f.p) (hy : y ∈ f.q)
    (order : f.middle.map Prod.snd = fixedPhases f.tag) :
    (profileWord x y f.tag bit).Sublist (f.core bit) := by
  have px := List.singleton_sublist.mpr hx
  have qy := List.singleton_sublist.mpr hy
  have ea := ((((px.append px).append qy).append px).append qy).append qy
  have mi := middle_trace f.p f.q hx hy f.middle
  rw [order] at mi
  have swapped : ((phasePair bit).map (fun b => if b then y else x)).Sublist (f.pair bit) := by
    cases bit with
    | false => exact px.append qy
    | true => exact qy.append px
  have pref := (ea.append mi).append (List.nil_sublist f.beforeMutable)
  have whole := (((((pref.append swapped).append (List.nil_sublist f.beforeFinalP)).append px).append
    (List.nil_sublist f.beforeFinalQ)).append qy)
  simpa only [profileWord,profileBits,core,early,List.map_append,List.append_nil,
    phasePair,List.map_cons,List.map_nil,Bool.false_eq_true,if_false,if_true,
    List.append_assoc,List.cons_append,List.nil_append, mid, Bool.not_false] using whole
omit [DecidableEq α] in
private theorem pattern_length (x y : α) (tag : List Bool) (bit : Bool) :
    (profileWord x y tag bit).length = 2 * (16 + tag.length) := by
  have tl : (tag.flatMap phasePair).length = 2 * tag.length := by
    induction tag with
    | nil => rfl
    | cons b t ih => simp [phasePair,ih]; omega
  simp [profileWord,profileBits,fixedPhases,phasePair,List.replicate_succ,tl]
  omega
private theorem select_length (x y : α) (w : List α) :
    (w.filter (fun a => decide (a = x ∨ a = y))).length ≤ w.count x + w.count y := by
  induction w with
  | nil => simp
  | cons a as ih =>
    by_cases hx : a = x <;> by_cases hy : a = y <;>
      simp [hx,hy,List.count_cons,beq_iff_eq] at ih ⊢ <;> omega
theorem cross_projection {r : Nat} {Allowed : List Bool → Prop} {Mark : α → α → Prop}
    (hf : f.Valid r Allowed Mark) (bit : Bool) (l t : List α)
    (hc : Cap r (l ++ f.core bit ++ t)) (x y : α) (hx : x ∈ f.p) (hy : y ∈ f.q) :
    (l ++ f.core bit ++ t).filter (fun a => decide (a = x ∨ a = y)) =
      profileWord x y f.tag bit := by
  have tr := f.profile_trace bit x y hx hy hf.2.2.1
  have tr' : (profileWord x y f.tag bit).Sublist (l ++ f.core bit ++ t) :=
    List.sublist_append_of_sublist_left (List.sublist_append_of_sublist_right tr)
  let keep := fun (a : α) => decide (a = x ∨ a = y)
  have intact : (profileWord x y f.tag bit).filter keep = profileWord x y f.tag bit := by
    apply List.filter_eq_self.mpr
    intro a ha
    obtain ⟨b,_,rfl⟩ := List.mem_map.mp ha
    cases b <;> simp [keep]
  have tt := tr'.filter keep
  rw [intact] at tt
  apply Eq.symm
  apply tt.eq_of_length_le
  have h := select_length x y (l ++ f.core bit ++ t)
  have h1 := hc x
  have h2 := hc y
  have hr := hf.1
  change ((l ++ f.core bit ++ t).filter (fun a => decide (a = x ∨ a = y))).length ≤ _
  rw [pattern_length]
  omega
end Frame
def Move (r : Nat) (Allowed : List Bool → Prop) (Mark : α → α → Prop)
    (u v : List α) : Prop :=
  ∃ (f : Frame α) (b : Bool) (l t : List α),
    f.Valid r Allowed Mark ∧ u = l ++ f.core b ++ t ∧
    v = l ++ f.core (!b) ++ t ∧ Cap r u
variable {r : Nat} {Allowed : List Bool → Prop} {Mark : α → α → Prop} {u v : List α}
namespace Move
theorem count_eq (h : Move r Allowed Mark u v) (a : α) : u.count a = v.count a := by
  obtain ⟨f,b,l,t,_,hu,hv,_⟩ := h
  rw [hu,hv]
  simp only [List.count_append, f.count_core a b]
theorem cap_left (h : Move r Allowed Mark u v) : Cap r u := by
  obtain ⟨_,_,_,_,_,_,_,hc⟩ := h
  exact hc
theorem cap_right (h : Move r Allowed Mark u v) : Cap r v := by
  intro a
  rw [← h.count_eq]
  exact h.cap_left a
theorem symm (h : Move r Allowed Mark u v) : Move r Allowed Mark v u := by
  have hc := h.cap_right
  obtain ⟨f,b,l,t,hf,hu,hv,_⟩ := h
  exact ⟨f,!b,l,t,hf,hv,by simpa using hu,hc⟩
theorem extend_of_cap (h : Move r Allowed Mark u v) (l t : List α)
    (hc : Cap r (l ++ u ++ t)) : Move r Allowed Mark (l ++ u ++ t) (l ++ v ++ t) := by
  obtain ⟨f,b,i,j,hf,hu,hv,_⟩ := h
  refine ⟨f,b,l ++ i,j ++ t,hf,?_,?_,hc⟩ <;> simp [hu,hv,List.append_assoc]
end Move
end P455Closure
end
section
namespace Problem455Swap
abbrev Word := List Nat
def occ (a : Nat) : Word → Nat
  | [] => 0
  | b :: w => (if a = b then 1 else 0) + occ a w
def cap (r : Nat) (w : Word) : Prop := ∀ a, occ a w ≤ r
def hit (x y : Nat) (left right : Option Nat) : Nat :=
  if left = some x ∧ right = some y then 1 else 0
def bigram (x y : Nat) : Word → Nat
  | [] => 0
  | a :: w => hit x y (some a) w.head? + bigram x y w
def Link (r : Nat) (w : Word) (x y : Nat) : Prop := bigram x y w = r
theorem occ_append (a : Nat) (u v : Word) : occ a (u ++ v) = occ a u + occ a v := by
  induction u with
  | nil => simp [occ]
  | cons b u ih => simp [occ, ih, Nat.add_assoc]
theorem bigram_append (x y : Nat) (u v : Word) :
    bigram x y (u ++ v) = bigram x y u + bigram x y v + hit x y u.getLast? v.head? := by
  induction u with
  | nil => simp [bigram, hit]
  | cons a u ih =>
    cases u with
    | nil => simp [bigram, hit, Nat.add_comm]
    | cons b w =>
      change hit x y (some a) (some b) + bigram x y ((b :: w) ++ v) = _
      rw [ih]
      simp [bigram, List.getLast?_cons_cons, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
theorem out_bound (x y z : Nat) (hyz : y ≠ z) (w : Word) :
    bigram x y w + bigram x z w ≤ occ x w := by
  induction w with
  | nil => simp [bigram, occ]
  | cons a w ih =>
    simp only [bigram, occ]
    unfold hit
    split <;> split <;> split <;> simp_all <;> omega
theorem in_bound (x z y : Nat) (hxz : x ≠ z) (w : Word) :
    bigram x y w + bigram z y w ≤ occ y w.tail := by
  induction w with
  | nil => simp [bigram, occ]
  | cons a w ih =>
    cases w with
    | nil => simp [bigram, hit, occ]
    | cons b w =>
      change hit x y (some a) (some b) + bigram x y (b :: w) +
        (hit z y (some a) (some b) + bigram z y (b :: w)) ≤ occ y (b :: w)
      simp only [List.tail_cons] at ih
      simp only [occ]
      unfold hit
      split <;> split <;> split <;> simp_all <;> omega
theorem tail_occ_le (a : Nat) (w : Word) : occ a w.tail ≤ occ a w := by
  cases w <;> simp [occ]
def Factor (u w : Word) : Prop := ∃ l t, w = l ++ u ++ t
theorem factor_pos (x y : Nat) {u w : Word} (hu : Factor u w)
    (h : 0 < bigram x y u) : 0 < bigram x y w := by
  obtain ⟨l,t,rfl⟩ := hu
  rw [bigram_append, bigram_append]
  omega
def privatePhase (p q : Word) := p ++ p ++ q ++ p ++ q ++ q
private theorem private_boundaries {p q w : Word} {i j s t : Nat}
    (hf : Factor (privatePhase p q) w)
    (hp : p.head? = some i) (hq : q.head? = some j)
    (ep : p.getLast? = some s) (eq : q.getLast? = some t) :
    0 < bigram s i w ∧ 0 < bigram s j w ∧ 0 < bigram t i w ∧ 0 < bigram t j w := by
  have pn : p ≠ [] := by intro e; simp [e] at hp
  have qn : q ≠ [] := by intro e; simp [e] at hq
  refine ⟨factor_pos _ _ hf ?_, factor_pos _ _ hf ?_, factor_pos _ _ hf ?_, factor_pos _ _ hf ?_⟩ <;>
    simp only [privatePhase, bigram_append, List.getLast?_append, ep, eq, hp, hq] <;>
    simp [hit] <;> omega
private theorem safe_ends {p q w : Word} {i j s t x y r : Nat}
    (hc : cap r w) (hf : Factor (privatePhase p q) w)
    (hp : p.head? = some i) (hq : q.head? = some j)
    (ep : p.getLast? = some s) (eq : q.getLast? = some t)
    (hij : i ≠ j) (hst : s ≠ t) (hxy : Link r w x y) :
    x ≠ s ∧ x ≠ t ∧ y ≠ i ∧ y ≠ j := by
  obtain ⟨hsi,hsj,hti,htj⟩ := private_boundaries hf hp hq ep eq
  have outs (a : Nat) (hai : 0 < bigram a i w) (haj : 0 < bigram a j w) : x ≠ a := by
    intro h; subst a
    by_cases hy : y = i
    · subst y
      have b := out_bound x i j hij w
      have c := hc x
      unfold Link at hxy
      omega
    · have b := out_bound x y i hy w
      have c := hc x
      unfold Link at hxy
      omega
  have ins (a : Nat) (hsa : 0 < bigram s a w) (hta : 0 < bigram t a w) : y ≠ a := by
    intro h; subst a
    by_cases hx : x = s
    · subst x
      have b := in_bound s t y hst w
      have c := hc y
      have d := tail_occ_le y w
      unfold Link at hxy
      omega
    · have b := in_bound x s y hx w
      have c := hc y
      have d := tail_occ_le y w
      unfold Link at hxy
      omega
  exact ⟨outs s hsi hsj, outs t hti htj, ins i hsi hti, ins j hsj htj⟩
private theorem safe_count_swap {p q : Word} {i j s t x y : Nat} (l u : Word)
    (hp : p.head? = some i) (hq : q.head? = some j)
    (ep : p.getLast? = some s) (eq : q.getLast? = some t)
    (h : x ≠ s ∧ x ≠ t ∧ y ≠ i ∧ y ≠ j) :
    bigram x y (l ++ p ++ q ++ u) = bigram x y (l ++ q ++ p ++ u) := by
  obtain ⟨xs,xt,yi,yj⟩ := h
  simp only [bigram_append, List.getLast?_append, ep, eq, hp, hq]
  simp [hit, Ne.symm xs, Ne.symm xt, Ne.symm yi, Ne.symm yj]
  omega
theorem repeatedLink_swap {p q : Word} {i j s t r : Nat} (l u : Word)
    (hp : p.head? = some i) (hq : q.head? = some j)
    (ep : p.getLast? = some s) (eq : q.getLast? = some t)
    (hij : i ≠ j) (hst : s ≠ t)
    (hc : cap r (l ++ p ++ q ++ u))
    (hf : Factor (privatePhase p q) (l ++ p ++ q ++ u))
    (hg : Factor (privatePhase p q) (l ++ q ++ p ++ u)) (x y : Nat) :
    Link r (l ++ p ++ q ++ u) x y ↔ Link r (l ++ q ++ p ++ u) x y := by
  have hd : cap r (l ++ q ++ p ++ u) := by
    intro a
    have b := hc a
    simp only [occ_append] at b ⊢
    omega
  constructor
  · intro h
    have good := safe_ends hc hf hp hq ep eq hij hst h
    exact (safe_count_swap l u hp hq ep eq good).symm.trans h
  · intro h
    have good := safe_ends hd hg hp hq ep eq hij hst h
    exact (safe_count_swap l u hp hq ep eq good).trans h
inductive Joined (edges : Nat → Nat → Prop) : Nat → Nat → Prop where
  | refl (x) : Joined edges x x
  | extend {x y z} : Joined edges x y → (edges y z ∨ edges z y) → Joined edges x z
def SameBlock (r : Nat) (w : Word) (x y : Nat) : Prop :=
  occ x w = r ∧ occ y w = r ∧ Joined (Link r w) x y
theorem link_factor {r x y : Nat} {w u : Word} (f : Factor u w)
    (hc : cap r w) (h : Link r u x y) : Link r w x y := by
  have bound := out_bound x y (y+1) (by omega) w
  have ceil := hc x
  obtain ⟨l,t,rfl⟩ := f
  unfold Link at *
  rw [bigram_append, bigram_append] at bound ⊢
  omega
private theorem joined_of_imp {e d : Nat → Nat → Prop} {a b : Nat}
    (h : ∀ x y, e x y → d x y) (j : Joined e a b) : Joined d a b := by
  induction j with
  | refl => exact .refl _
  | extend walk last ih =>
    exact .extend ih (last.imp (h _ _) (h _ _))
theorem sameBlock_factor {r x y : Nat} {w u : Word} (f : Factor u w)
    (hc : cap r w) (h : SameBlock r u x y) : SameBlock r w x y := by
  obtain ⟨hx,hy,hj⟩ := h
  refine ⟨?_,?_,joined_of_imp (fun _ _ hh => link_factor f hc hh) hj⟩
  all_goals
    obtain ⟨l,t,rfl⟩ := f
    have bx := hc x
    have by' := hc y
    simp only [occ_append] at bx by' ⊢
    omega
end Problem455Swap
end
