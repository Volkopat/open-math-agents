import OMAStatements.S_mo_413085
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.DedekindDomain.Basic
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Data.Int.Order.Units
import Mathlib.RingTheory.Polynomial.RationalRoot
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.NormNum
import Mathlib.Algebra.Polynomial.Eval.Defs
import Mathlib.RingTheory.FiniteType
import Mathlib.Tactic.Linarith

/-!
All iterates lie in the Z-algebra generated by the finitely many real
coefficients. A finite-type Z-algebra cannot contain every rational number:
the Jacobson finite-type theorem would make Q module-finite over Z, which
would make 1/2 an algebraic integer. No restriction is imposed on the real
coefficients or on irrational intermediate values of the trajectory.
-/

namespace OMA.S_mo_413085

theorem int_jacobson : IsJacobsonRing ℤ := by
  apply isJacobsonRing_iff_prime_eq.mpr
  intro P hP
  by_cases h0 : P = ⊥
  · subst P
    apply le_antisymm _ Ideal.le_jacobson
    intro x hx
    have hu := Ideal.mem_jacobson_bot.mp hx x
    rw [Int.isUnit_iff] at hu
    have hx0 : x = 0 := by
      rcases hu with h | h
      · nlinarith [sq_nonneg x]
      · nlinarith [sq_nonneg x]
    simp [hx0]
  · let : P.IsMaximal := hP.isMaximal h0
    exact Ideal.jacobson_eq_self_of_isMaximal

theorem not_all_rat_mem [IsJacobsonRing ℤ]
    (S : Subalgebra ℤ ℝ) [Algebra.FiniteType ℤ S] :
    ¬ (∀ q : ℚ, (q : ℝ) ∈ S) := by
  intro h
  let f : ℚ →ₐ[ℤ] S :=
    { toFun := fun q => ⟨(q : ℝ), h q⟩
      map_zero' := by ext; simp
      map_one' := by ext; simp
      map_add' := by intros; ext; simp
      map_mul' := by intros; ext; simp
      commutes' := by intro z; ext; simp }
  have : Module.Finite ℤ ℚ :=
    finite_of_algHom_finiteType_of_isJacobsonRing f
  have hi : IsIntegral ℤ (1 / 2 : ℚ) := IsIntegral.of_finite ℤ _
  obtain ⟨z, hz⟩ := UniqueFactorizationMonoid.integer_of_integral hi
  have hz' : (z : ℚ) = 1 / 2 := hz
  have htwo : (2 : ℚ) * (z : ℚ) = 1 := by rw [hz']; norm_num
  have htwo' : (2 : ℤ) * z = 1 := by exact_mod_cast htwo
  omega

noncomputable def coefficientAlgebra (F : Finset (Polynomial ℝ)) : Subalgebra ℤ ℝ := by
  classical
  exact Algebra.adjoin ℤ (F.biUnion Polynomial.coeffs : Set ℝ)

lemma coefficientAlgebra_finiteType (F : Finset (Polynomial ℝ)) :
    Algebra.FiniteType ℤ (coefficientAlgebra F) := by
  classical
  exact Algebra.FiniteType.adjoin_of_finite (F.biUnion Polynomial.coeffs).finite_toSet

lemma coeff_mem (F : Finset (Polynomial ℝ)) (f : Polynomial ℝ) (hf : f ∈ F) (n : ℕ) :
    f.coeff n ∈ coefficientAlgebra F := by
  classical
  by_cases hz : f.coeff n = 0
  · rw [hz]
    exact (coefficientAlgebra F).zero_mem
  · apply Algebra.subset_adjoin
    exact Finset.mem_biUnion.mpr ⟨f, hf, Polynomial.coeff_mem_coeffs hz⟩

lemma eval_mem (F : Finset (Polynomial ℝ)) (f : Polynomial ℝ) (hf : f ∈ F)
    {x : ℝ} (hx : x ∈ coefficientAlgebra F) : f.eval x ∈ coefficientAlgebra F := by
  rw [Polynomial.eval_eq_sum, Polynomial.sum_def]
  apply (coefficientAlgebra F).sum_mem
  intro n _
  exact (coefficientAlgebra F).mul_mem (coeff_mem F f hf n)
    ((coefficientAlgebra F).pow_mem hx n)

lemma orbit_mem (F : Finset (Polynomial ℝ)) (p : ℕ → Polynomial ℝ)
    (hp : ∀ n, p n ∈ F) (n : ℕ) : orbit p n ∈ coefficientAlgebra F := by
  induction n with
  | zero => exact (coefficientAlgebra F).zero_mem
  | succ n ih => exact eval_mem F (p n) (hp n) ih

end OMA.S_mo_413085

open OMA.S_mo_413085 in
theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_413085.main) := by
  rintro ⟨F, p, hp, hcover⟩
  let : IsJacobsonRing ℤ := int_jacobson
  let : Algebra.FiniteType ℤ (coefficientAlgebra F) := coefficientAlgebra_finiteType F
  apply not_all_rat_mem (coefficientAlgebra F)
  intro q
  obtain ⟨n, hn⟩ := hcover q
  rw [← hn]
  exact orbit_mem F p hp n
