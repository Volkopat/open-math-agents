private structure Trial where
  x : Nat
  blue : Nat
  pos : Nat

private def trialCheck (s : Board) (get : Nat → Nat) (t : Trial) :=
  walk s (fun p => get p >>> 12) 40 (s.initial ||| row s t.x)
    (t.blue ||| cell s s.initial t.x) t.pos != 0

private theorem trial_sound {n c get s} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    (hrow : ∀ x < s.width, checkedRow n s x = true) (hinit : checkedInitial n s = true)
    (valid : ∀ p, validMove n (get p) = true) {t : Trial} (h : trialCheck s get t = true)
    (hb : Blue c t.blue) : c t.x = false := by
  cases hx : c t.x with
  | false => rfl
  | true =>
    have ht := @row_compatible n s c (geometry_ok hs hw) hrow
    have init := initial_compatible (geometry_ok hs hw) hinit
    have he := walk_ok (fun x => @ht x) (fun p => validMove_hit hs hw (valid p))
      40 (s.initial ||| row s t.x) _ t.pos (compatOr init (ht hx)) (blueOr hb (init t.x hx))
    simp [trialCheck,he] at h

private def accumulate (b : Nat) (t : Trial) :=
  if (t.blue &&& b) == t.blue then Nat.lor b (1 <<< t.x) else b

private theorem by_trials {n} (s : Board) (get : Nat → Nat) {k : Nat} (trial : Fin k → Trial)
    (hrow : ∀ x < s.width, checkedRow n s x = true) (hinit : checkedInitial n s = true)
    (valid : ∀ p, validMove n (get p) = true)
    (hchecks : ∀ i, trialCheck s get (trial i) = true) (finalMove : Nat)
    (hvalid : validMove n finalMove = true)
    (hfinal : ((finalMove >>> 12) &&& ((List.finRange k).map trial).foldl accumulate 0) =
      finalMove >>> 12) (c : Nat → Bool) (hs : ∀ x < n, c (n-1-x) = c x) : Wins n c := by
  by_contra hw
  have hb : Blue c (((List.finRange k).map trial).foldl accumulate 0) := by
    apply List.foldlRecOn (motive := Blue c)
    · exact blueZero c
    · intro b hb t ht
      obtain ⟨i,_,rfl⟩ := List.mem_map.mp ht
      unfold accumulate
      split
      · rename_i he
        exact blueOr hb (blueSingle (trial_sound hs hw hrow hinit valid (hchecks i)
          (blue_sub (beq_iff_eq.mp he) hb)))
      · exact hb
  obtain ⟨i,hi,hc⟩ := validMove_hit hs hw hvalid
  have hh := blue_sub hfinal hb i hi
  simp_all


