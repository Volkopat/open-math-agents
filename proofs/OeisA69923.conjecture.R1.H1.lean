import OMAReductions.R_OeisA69923_conjecture_R1

-- For every n from 1 to 250 the table below names an offset d that is at most the n-th prime and a
-- chain of Lucas certificates (a witness and the full factorisation of p - 1 for each large prime p)
-- showing that 2 ^ n + d is prime. Factors below one million are checked by trial division. The
-- whole table is verified by one kernel computation.

namespace OMA.A69923H1

/-- Square and multiply. The first natural number is fuel. -/
def pm (m : ℕ) : ℕ → ℕ → ℕ → ℕ → ℕ
  | 0, _, _, acc => acc
  | f + 1, b, e, acc =>
    if e = 0 then acc else pm m f (b * b % m) (e / 2) (if e % 2 = 1 then acc * b % m else acc)

theorem pm_spec (m : ℕ) : ∀ f b e acc : ℕ, e < 2 ^ f → pm m f b e acc % m = acc * b ^ e % m := by
  intro f
  induction f with
  | zero =>
    intro b e acc h
    have h0 : e = 0 := by simpa using h
    subst h0
    simp [pm]
  | succ f ih =>
    intro b e acc h
    rw [pow_succ] at h
    rw [pm]
    by_cases h0 : e = 0
    · subst h0
      simp
    · rw [if_neg h0]
      by_cases h1 : e % 2 = 1
      · rw [if_pos h1, ih _ _ _ (by omega)]
        obtain ⟨k, rfl⟩ : ∃ k, e = 2 * k + 1 := ⟨e / 2, by omega⟩
        have hk : (2 * k + 1) / 2 = k := by omega
        rw [hk]
        have e1 : acc * b * (b * b) ^ k = acc * b ^ (2 * k + 1) := by ring
        rw [← e1]
        exact Nat.ModEq.mul (Nat.mod_modEq _ _) ((Nat.mod_modEq _ _).pow _)
      · rw [if_neg h1, ih _ _ _ (by omega)]
        obtain ⟨k, rfl⟩ : ∃ k, e = 2 * k := ⟨e / 2, by omega⟩
        have hk : (2 * k) / 2 = k := by omega
        rw [hk]
        have e1 : acc * (b * b) ^ k = acc * b ^ (2 * k) := by ring
        rw [← e1]
        exact Nat.ModEq.mul (Nat.ModEq.refl _) ((Nat.mod_modEq _ _).pow _)

/-- Modular power. -/
def pw (m b e : ℕ) : ℕ := pm m e b e 1 % m

theorem pw_spec (m b e : ℕ) : pw m b e = b ^ e % m := by
  unfold pw
  rw [pm_spec m e b e 1 Nat.lt_two_pow_self, one_mul]

/-- Trial division from `d` upwards. The first natural number is fuel. -/
def trial (n : ℕ) : ℕ → ℕ → Bool
  | 0, d => decide (n < d * d)
  | f + 1, d => if n < d * d then true else if n % d = 0 then false else trial n f (d + 1)

theorem trial_sound (n : ℕ) :
    ∀ f d : ℕ, trial n f d = true → ∀ m, d ≤ m → m * m ≤ n → ¬ m ∣ n := by
  intro f
  induction f with
  | zero =>
    intro d h m hdm hmm _
    have h' : n < d * d := by simpa [trial] using h
    have : d * d ≤ m * m := Nat.mul_le_mul hdm hdm
    omega
  | succ f ih =>
    intro d h m hdm hmm hdvd
    rw [trial] at h
    by_cases h1 : n < d * d
    · have : d * d ≤ m * m := Nat.mul_le_mul hdm hdm
      omega
    · rw [if_neg h1] at h
      by_cases h2 : n % d = 0
      · rw [if_pos h2] at h
        exact absurd h (by decide)
      · rw [if_neg h2] at h
        rcases Nat.eq_or_lt_of_le hdm with rfl | hlt
        · apply h2
          obtain ⟨c, hc⟩ := hdvd
          rw [hc]
          exact Nat.mul_mod_right _ _
        · exact ih _ h m hlt hmm hdvd

theorem trial_complete (n : ℕ) (hn : n.Prime) :
    ∀ f d : ℕ, 2 ≤ d → n + 2 ≤ f + d → trial n f d = true := by
  intro f
  induction f with
  | zero =>
    intro d hd h
    have : d ≤ d * d := Nat.le_mul_self d
    simp only [trial, decide_eq_true_eq]
    omega
  | succ f ih =>
    intro d hd h
    rw [trial]
    by_cases h1 : n < d * d
    · rw [if_pos h1]
    · rw [if_neg h1]
      by_cases h2 : n % d = 0
      · exfalso
        have hdvd : d ∣ n := Nat.dvd_of_mod_eq_zero h2
        rcases (Nat.dvd_prime hn).mp hdvd with h3 | h3
        · omega
        · subst h3
          have : d * 2 ≤ d * d := Nat.mul_le_mul_left d hd
          omega
      · rw [if_neg h2]
        exact ih (d + 1) (by omega) (by omega)

/-- Primality by trial division. -/
def sp (n : ℕ) : Bool := decide (2 ≤ n) && trial n n 2

theorem sp_sound {n : ℕ} (h : sp n = true) : n.Prime := by
  simp only [sp, Bool.and_eq_true, decide_eq_true_eq] at h
  rw [Nat.prime_def_le_sqrt]
  exact ⟨h.1, fun m hm hs => trial_sound n n 2 h.2 m hm (Nat.le_sqrt.mp hs)⟩

theorem sp_complete {n : ℕ} (h : n.Prime) : sp n = true := by
  simp only [sp, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨h.two_le, trial_complete n h n 2 (Nat.le_refl 2) (by omega)⟩

/-- An upper bound for the number of primes below `k`. -/
def cnt : ℕ → ℕ
  | 0 => 0
  | k + 1 => cnt k + if sp k then 1 else 0

theorem count_le_cnt : ∀ k : ℕ, Nat.count Nat.Prime k ≤ cnt k := by
  intro k
  induction k with
  | zero => simp [cnt]
  | succ k ih =>
    rw [Nat.count_succ, cnt]
    by_cases hp : k.Prime
    · rw [if_pos hp, if_pos (sp_complete hp)]
      omega
    · rw [if_neg hp]
      split_ifs <;> omega

/-- A factor is accepted if it was certified earlier or is a small prime. -/
def okF (K : List ℕ) (q : ℕ) : Bool := K.contains q || (decide (q < 1000000) && sp q)

/-- One Lucas certificate: the prime, a witness, and the prime factors of the predecessor. -/
def stepOk (K : List ℕ) (e : ℕ × ℕ × List ℕ) : Bool :=
  decide (1 < e.1) && decide (e.2.2.prod = e.1 - 1) && decide (pw e.1 e.2.1 (e.1 - 1) = 1) &&
    e.2.2.all (fun q => okF K q && decide (pw e.1 e.2.1 ((e.1 - 1) / q) ≠ 1))

/-- Checks a chain of certificates and then the target `t`. -/
def run : List ℕ → List (ℕ × ℕ × List ℕ) → ℕ → Bool
  | K, [], t => okF K t
  | K, e :: L, t => stepOk K e && run (e.1 :: K) L t

theorem okF_sound {K : List ℕ} (hK : ∀ q ∈ K, q.Prime) {q : ℕ} (h : okF K q = true) :
    q.Prime := by
  simp only [okF, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, List.contains_iff_mem] at h
  rcases h with h1 | h2
  · exact hK q h1
  · exact sp_sound h2.2

theorem stepOk_sound {K : List ℕ} (hK : ∀ q ∈ K, q.Prime) {e : ℕ × ℕ × List ℕ}
    (h : stepOk K e = true) : e.1.Prime := by
  obtain ⟨p, a, qs⟩ := e
  simp only [stepOk, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨⟨⟨hp1, hprod⟩, hpow⟩, hall⟩ := h
  apply lucas_primality p (a : ZMod p)
  · rw [pw_spec] at hpow
    have h1 : ((a ^ (p - 1) : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by
      rw [ZMod.natCast_eq_natCast_iff', hpow, Nat.mod_eq_of_lt hp1]
    simpa using h1
  · intro q hq hqd
    rw [← hprod] at hqd
    obtain ⟨r, hr, hqr⟩ := (Nat.prime_iff.mp hq).dvd_prod_iff.mp hqd
    have hr' := hall r hr
    have hrp := okF_sound hK hr'.1
    have hqe : q = r := (Nat.prime_dvd_prime_iff_eq hq hrp).mp hqr
    have hr2 := hr'.2
    rw [← hqe] at hr2
    intro hc
    apply hr2
    rw [pw_spec]
    have h1 : ((a ^ ((p - 1) / q) : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by
      push_cast
      exact hc
    rw [ZMod.natCast_eq_natCast_iff'] at h1
    rw [h1, Nat.mod_eq_of_lt hp1]

theorem run_sound : ∀ (L : List (ℕ × ℕ × List ℕ)) (K : List ℕ) (t : ℕ),
    (∀ q ∈ K, q.Prime) → run K L t = true → t.Prime := by
  intro L
  induction L with
  | nil =>
    intro K t hK h
    exact okF_sound hK (by simpa [run] using h)
  | cons e L ih =>
    intro K t hK h
    rw [run, Bool.and_eq_true] at h
    refine ih (e.1 :: K) t ?_ h.2
    intro q hq
    rcases List.mem_cons.mp hq with rfl | hq
    · exact stepOk_sound hK h.1
    · exact hK q hq

/-- Checks the rows of a table for the exponents `n`, `n + 1`, and so on. -/
def checkAll : ℕ → List (ℕ × List (ℕ × ℕ × List ℕ)) → Bool
  | _, [] => true
  | n, x :: T => decide (cnt x.1 ≤ n - 1) && run [] x.2 (2 ^ n + x.1) && checkAll (n + 1) T

theorem checkAll_sound : ∀ (T : List (ℕ × List (ℕ × ℕ × List ℕ))) (n : ℕ),
    checkAll n T = true → ∀ m, n ≤ m → m < n + T.length →
      ∃ d, cnt d ≤ m - 1 ∧ (2 ^ m + d).Prime := by
  intro T
  induction T with
  | nil =>
    intro n _ m h1 h2
    simp at h2
    omega
  | cons x T ih =>
    intro n h m h1 h2
    rw [checkAll] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact ⟨x.1, h.1.1, run_sound _ _ _ (by simp) h.1.2⟩
    · refine ih (n + 1) h.2 m hlt ?_
      simp only [List.length_cons] at h2
      omega

