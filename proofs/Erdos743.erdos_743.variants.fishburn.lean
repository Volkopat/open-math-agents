def gr (k i : ℕ) : ℕ := (grL k).getD i 0
def tr (k j : ℕ) : ℕ := (trL k).getD j 0
def ce (k i j : ℕ) : ℕ := ((ceL k).getD i []).getD j 0
def lf (k j v : ℕ) : ℕ := ((lfL k).getD j []).getD v 0
def ng (k : ℕ) : ℕ := (grL k).length
def nt (k : ℕ) : ℕ := (trL k).length

/-- Check of one packing step: `m` a graph, `tm` a tree, `m'` the smaller graph, `e` the entry. -/
def chkE (m tm m' e : ℕ) : Bool :=
  ((List.range 9).all fun u => dg e (9 + dg e u) == u && dg e (27 + dg e (18 + u)) == u) &&
  ((List.range 9).all fun a => (List.range 9).all fun b =>
    !tb tm a b || tb m (dg e a) (dg e b)) &&
  ((List.range 9).all fun u => (List.range 9).all fun v =>
    !tb m' u v || (tb m (dg e (18 + u)) (dg e (18 + v)) &&
      !tb tm (dg e (9 + dg e (18 + u))) (dg e (9 + dg e (18 + v)))))

/-- Check of all packing steps from level `k + 1` to level `k`. -/
def chkLevel (k : ℕ) : Bool :=
  (List.range (ng (k + 1))).all fun i => (List.range (nt (k + 1))).all fun j =>
    decide (ce (k + 1) i j / 9 ^ 36 < ng k) &&
      chkE (gr (k + 1) i) (tr (k + 1) j) (gr k (ce (k + 1) i j / 9 ^ 36)) (ce (k + 1) i j)

/-- Check of the leaf table from trees on `k` vertices to trees on `k + 1` vertices. -/
def chkL (k : ℕ) : Bool :=
  (List.range (nt k)).all fun j => (List.range k).all fun v =>
    decide (lf k j v / 9 ^ 18 < nt (k + 1)) &&
    ((List.range 9).all fun u => dg (lf k j v) (9 + dg (lf k j v) u) == u) &&
    ((List.range (k + 1)).all fun u => decide (dg (lf k j v) u < k + 1)) &&
    ((List.range 9).all fun a => (List.range 9).all fun b =>
      !tb (tr k j) a b ||
        tb (tr (k + 1) (lf k j v / 9 ^ 18)) (dg (lf k j v) a) (dg (lf k j v) b)) &&
    tb (tr (k + 1) (lf k j v / 9 ^ 18)) (dg (lf k j v) v) (dg (lf k j v) k) &&
    tb (tr (k + 1) (lf k j v / 9 ^ 18)) (dg (lf k j v) k) (dg (lf k j v) v)

/-- The first graph of level `n` lives on the vertices `0, …, n - 1`. -/
def chkK (n : ℕ) : Bool :=
  (List.range 9).all fun u => (List.range 9).all fun v =>
    !tb (gr n 0) u v || (decide (u < n) && decide (v < n))

theorem all_range {n : ℕ} {p : ℕ → Bool} (h : (List.range n).all p = true) :
    ∀ u, u < n → p u = true := by
  intro u hu
  exact List.all_eq_true.mp h u (List.mem_range.mpr hu)

theorem all2 {n : ℕ} {p : ℕ → ℕ → Bool}
    (h : ((List.range n).all fun a => (List.range n).all fun b => p a b) = true) :
    ∀ a b, a < n → b < n → p a b = true := by
  intro a b ha hb
  exact all_range (all_range h a ha) b hb

theorem dg_lt (e i : ℕ) : dg e i < 9 := Nat.mod_lt _ (by norm_num)

theorem chkE_spec {m tm m' e : ℕ} (h : chkE m tm m' e = true) :
    (∀ u, u < 9 → dg e (9 + dg e u) = u ∧ dg e (27 + dg e (18 + u)) = u) ∧
    (∀ a b, a < 9 → b < 9 → tb tm a b = true → tb m (dg e a) (dg e b) = true) ∧
    (∀ u v, u < 9 → v < 9 → tb m' u v = true →
      tb m (dg e (18 + u)) (dg e (18 + v)) = true ∧
      tb tm (dg e (9 + dg e (18 + u))) (dg e (9 + dg e (18 + v))) = false) := by
  simp only [chkE, Bool.and_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨fun u hu => ?_, fun a b ha hb hab => ?_, fun u v hu hv huv => ?_⟩
  · have := all_range h1 u hu
    simpa using this
  · have := all2 h2 a b ha hb
    simpa [hab] using this
  · have := all2 h3 u v hu hv
    simpa [huv] using this

/-- Any trees `T 2, …, T k` pack edge-disjointly into the graph coded by `m`. -/
def Univ (k m : ℕ) : Prop :=
  ∀ T : (j : ℕ) → SimpleGraph (Fin j), (∀ j, 2 ≤ j → j ≤ k → (T j).IsTree) →
    ∃ f : (j : ℕ) → Fin j → ℕ,
      (∀ j, 2 ≤ j → j ≤ k → Function.Injective (f j) ∧ (∀ a, f j a < 9) ∧
          ∀ a b, (T j).Adj a b → tb m (f j a) (f j b) = true) ∧
      (∀ i j, 2 ≤ i → i < j → j ≤ k → ∀ a b x y, (T i).Adj a b → (T j).Adj x y →
          ¬ (f i a = f j x ∧ f i b = f j y))

/-- Every tree on `Fin k` embeds into one of the listed trees. -/
def Cl (k : ℕ) : Prop :=
  ∀ T : SimpleGraph (Fin k), T.IsTree → ∃ j, j < nt k ∧ ∃ g : Fin k → ℕ,
    Function.Injective g ∧ (∀ a, g a < k) ∧ ∀ a b, T.Adj a b → tb (tr k j) (g a) (g b) = true

theorem level_step (k : ℕ) (hk : 1 ≤ k) (hk9 : k + 1 ≤ 9) (hc : chkLevel k = true)
    (hcl : Cl (k + 1)) (ih : ∀ i, i < ng k → Univ k (gr k i)) :
    ∀ i, i < ng (k + 1) → Univ (k + 1) (gr (k + 1) i) := by
  intro i hi T hT
  obtain ⟨j, hj, g, hginj, hgk, hgadj⟩ := hcl (T (k + 1)) (hT (k + 1) (by omega) le_rfl)
  have hE := all_range (all_range hc i hi) j hj
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hE
  generalize ce (k + 1) i j = e at hE
  obtain ⟨hch, hE⟩ := hE
  obtain ⟨hperm, htree, hchild⟩ := chkE_spec hE
  obtain ⟨f', hf1, hf2⟩ := ih _ hch T (fun j h2 hjk => hT j h2 (by omega))
  have hφ : ∀ u v, u < 9 → v < 9 → dg e u = dg e v → u = v := by
    intro u v hu hv h
    have h1 := (hperm u hu).1
    have h2 := (hperm v hv).1
    rw [h] at h1
    omega
  have hσ : ∀ u v, u < 9 → v < 9 → dg e (18 + u) = dg e (18 + v) → u = v := by
    intro u v hu hv h
    have h1 := (hperm u hu).2
    have h2 := (hperm v hv).2
    rw [h] at h1
    omega
  have hg9 : ∀ a, g a < 9 := fun a => by have := hgk a; omega
  refine ⟨Function.update (fun j a => dg e (18 + f' j a)) (k + 1) (fun a => dg e (g a)), ?_, ?_⟩
  · intro j' h2 hj'
    rcases Nat.lt_or_ge j' (k + 1) with hlt | hge
    · have hne : j' ≠ k + 1 := by omega
      simp only [Function.update_of_ne hne]
      obtain ⟨hinj, hb, hadj⟩ := hf1 j' h2 (by omega)
      exact ⟨fun a b hab => hinj (hσ _ _ (hb a) (hb b) hab), fun a => dg_lt _ _,
        fun a b hab => (hchild _ _ (hb a) (hb b) (hadj a b hab)).1⟩
    · obtain rfl : j' = k + 1 := by omega
      simp only [Function.update_self]
      exact ⟨fun a b hab => hginj (hφ _ _ (hg9 a) (hg9 b) hab), fun a => dg_lt _ _,
        fun a b hab => htree _ _ (hg9 a) (hg9 b) (hgadj a b hab)⟩
  · rintro i' j' h2 hij hj' a b x y hab hxy ⟨h1, h2'⟩
    have hne : i' ≠ k + 1 := by omega
    simp only [Function.update_of_ne hne] at h1 h2'
    obtain ⟨hinji, hbi, hadji⟩ := hf1 i' h2 (by omega)
    rcases Nat.lt_or_ge j' (k + 1) with hlt | hge
    · have hne' : j' ≠ k + 1 := by omega
      simp only [Function.update_of_ne hne'] at h1 h2'
      obtain ⟨hinjj, hbj, hadjj⟩ := hf1 j' (by omega) (by omega)
      exact hf2 i' j' h2 hij (by omega) a b x y hab hxy
        ⟨hσ _ _ (hbi a) (hbj x) h1, hσ _ _ (hbi b) (hbj y) h2'⟩
    · obtain rfl : j' = k + 1 := by omega
      simp only [Function.update_self] at h1 h2'
      have hc2 := (hchild _ _ (hbi a) (hbi b) (hadji a b hab)).2
      rw [h1, h2', (hperm _ (hg9 x)).1, (hperm _ (hg9 y)).1, hgadj x y hxy] at hc2
      exact absurd hc2 (by simp)

theorem tree_comap {k : ℕ} {T : SimpleGraph (Fin (k + 1))} [DecidableRel T.Adj] (hT : T.IsTree)
    {l : Fin (k + 1)} (hl : T.degree l = 1) : (T.comap l.succAbove).IsTree := by
  refine ⟨?_, IsAcyclic.comap (SimpleGraph.Hom.comap l.succAbove T)
    Fin.succAbove_right_injective hT.isAcyclic⟩
  have hc := hT.connected.induce_compl_singleton_of_degree_eq_one hl
  let e : Fin k ≃ ({l}ᶜ : Set (Fin (k + 1))) := finSuccAboveEquiv l
  have iso : T.comap l.succAbove ≃g T.induce ({l}ᶜ : Set (Fin (k + 1))) :=
    ⟨e, by intro a b; exact Iff.rfl⟩
  exact iso.connected_iff.mpr hc

theorem cl_step (k : ℕ) (hk : 1 ≤ k) (hk9 : k + 1 ≤ 9) (hc : chkL k = true) (ih : Cl k) :
    Cl (k + 1) := by
  intro T hT
  classical
  have : Nontrivial (Fin (k + 1)) := Fin.nontrivial_iff_two_le.mpr (by omega)
  obtain ⟨l, hl⟩ := hT.exists_vert_degree_one_of_nontrivial
  obtain ⟨p, hp, hpu⟩ := degree_eq_one_iff_existsUnique_adj.mp hl
  obtain ⟨j, hj, g, hginj, hgk, hgadj⟩ := ih _ (tree_comap hT hl)
  obtain ⟨p', rfl⟩ := Fin.exists_succAbove_eq (T.ne_of_adj hp).symm
  have hE := all_range (all_range hc j hj) (g p') (hgk p')
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hE
  obtain ⟨⟨⟨⟨⟨hidx, hinv⟩, hbd⟩, hadj⟩, hvk⟩, hkv⟩ := hE
  generalize lf k j (g p') = e at hidx hinv hbd hadj hvk hkv
  have hρ : ∀ u v, u < 9 → v < 9 → dg e u = dg e v → u = v := by
    intro u v hu hv h
    have h1 := all_range hinv u hu
    have h2 := all_range hinv v hv
    simp only [beq_iff_eq] at h1 h2
    rw [h] at h1
    omega
  have hg9 : ∀ a, g a < 9 := fun a => by have := hgk a; omega
  refine ⟨e / 9 ^ 18, hidx,
    Fin.insertNth (α := fun _ => ℕ) l (dg e k) (fun y => dg e (g y)), ?_, ?_, ?_⟩
  · intro a b hab
    rcases Fin.eq_self_or_eq_succAbove l a with ha | ⟨a', ha⟩ <;>
      rcases Fin.eq_self_or_eq_succAbove l b with hb | ⟨b', hb⟩
    · rw [ha, hb]
    · rw [ha, hb, Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove] at hab
      have := hρ _ _ (by omega) (hg9 b') hab
      have := hgk b'
      omega
    · rw [ha, hb, Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove] at hab
      have := hρ _ _ (hg9 a') (by omega) hab
      have := hgk a'
      omega
    · rw [ha, hb, Fin.insertNth_apply_succAbove, Fin.insertNth_apply_succAbove] at hab
      rw [ha, hb, hginj (hρ _ _ (hg9 a') (hg9 b') hab)]
  · intro a
    rcases Fin.eq_self_or_eq_succAbove l a with ha | ⟨a', ha⟩
    · rw [ha, Fin.insertNth_apply_same]
      have := all_range hbd k (by omega)
      simpa using this
    · rw [ha, Fin.insertNth_apply_succAbove]
      have := all_range hbd (g a') (by have := hgk a'; omega)
      simpa using this
  · intro a b hab
    rcases Fin.eq_self_or_eq_succAbove l a with ha | ⟨a', ha⟩ <;>
      rcases Fin.eq_self_or_eq_succAbove l b with hb | ⟨b', hb⟩
    · rw [ha, hb] at hab
      exact absurd rfl (T.ne_of_adj hab)
    · rw [ha, hb] at hab
      have hb' : b' = p' := Fin.succAbove_right_injective (hpu _ hab)
      rw [ha, hb, Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove, hb']
      exact hkv
    · rw [ha, hb] at hab
      have ha' : a' = p' := Fin.succAbove_right_injective (hpu _ hab.symm)
      rw [ha, hb, Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove, ha']
      exact hvk
    · rw [ha, hb] at hab
      rw [ha, hb, Fin.insertNth_apply_succAbove, Fin.insertNth_apply_succAbove]
      have := all2 hadj (g a') (g b') (hg9 a') (hg9 b')
      simpa [hgadj a' b' hab] using this

theorem cl1 : Cl 1 := by
  intro T _
  refine ⟨0, by decide +kernel, fun a => a.val, Fin.val_injective, fun a => a.isLt,
    fun a b hab => ?_⟩
  exact absurd (Subsingleton.elim a b) (T.ne_of_adj hab)

theorem cl2 : Cl 2 := cl_step 1 (by norm_num) (by norm_num) (by decide +kernel) cl1
theorem cl3 : Cl 3 := cl_step 2 (by norm_num) (by norm_num) (by decide +kernel) cl2
theorem cl4 : Cl 4 := cl_step 3 (by norm_num) (by norm_num) (by decide +kernel) cl3
theorem cl5 : Cl 5 := cl_step 4 (by norm_num) (by norm_num) (by decide +kernel) cl4
theorem cl6 : Cl 6 := cl_step 5 (by norm_num) (by norm_num) (by decide +kernel) cl5
theorem cl7 : Cl 7 := cl_step 6 (by norm_num) (by norm_num) (by decide +kernel) cl6
theorem cl8 : Cl 8 := cl_step 7 (by norm_num) (by norm_num) (by decide +kernel) cl7
theorem cl9 : Cl 9 := cl_step 8 (by norm_num) (by norm_num) (by decide +kernel) cl8

theorem u1 : ∀ i, i < ng 1 → Univ 1 (gr 1 i) :=
  fun _ _ _ _ => ⟨fun _ _ => 0, fun j h2 h1 => by omega, fun i j h2 hij hj => by omega⟩

theorem u2 : ∀ i, i < ng 2 → Univ 2 (gr 2 i) :=
  level_step 1 (by norm_num) (by norm_num) (by decide +kernel) cl2 u1
theorem u3 : ∀ i, i < ng 3 → Univ 3 (gr 3 i) :=
  level_step 2 (by norm_num) (by norm_num) (by decide +kernel) cl3 u2
theorem u4 : ∀ i, i < ng 4 → Univ 4 (gr 4 i) :=
  level_step 3 (by norm_num) (by norm_num) (by decide +kernel) cl4 u3
theorem u5 : ∀ i, i < ng 5 → Univ 5 (gr 5 i) :=
  level_step 4 (by norm_num) (by norm_num) (by decide +kernel) cl5 u4
theorem u6 : ∀ i, i < ng 6 → Univ 6 (gr 6 i) :=
  level_step 5 (by norm_num) (by norm_num) (by decide +kernel) cl6 u5
theorem u7 : ∀ i, i < ng 7 → Univ 7 (gr 7 i) :=
  level_step 6 (by norm_num) (by norm_num) (by decide +kernel) cl7 u6
theorem u8 : ∀ i, i < ng 8 → Univ 8 (gr 8 i) :=
  level_step 7 (by norm_num) (by norm_num) (by decide +kernel) cl8 u7
theorem u9 : ∀ i, i < ng 9 → Univ 9 (gr 9 i) :=
  level_step 8 (by norm_num) (by norm_num) (by decide +kernel) cl9 u8

theorem univ_all (n : ℕ) (h2 : 2 ≤ n) (hn : n ≤ 9) : ∀ i, i < ng n → Univ n (gr n i) := by
  interval_cases n
  exacts [u2, u3, u4, u5, u6, u7, u8, u9]

theorem ng_pos : ∀ n, n ≤ 9 → 2 ≤ n → 0 < ng n := by decide +kernel

theorem chkK_ok : ∀ n, n ≤ 9 → chkK n = true := by decide +kernel

theorem tree_exists_adj {j : ℕ} {T : SimpleGraph (Fin j)} (hT : T.IsTree) (h2 : 2 ≤ j)
    (a : Fin j) : ∃ b, T.Adj a b := by
  have : Nontrivial (Fin j) := Fin.nontrivial_iff_two_le.mpr h2
  obtain ⟨c, hc⟩ := exists_ne a
  obtain ⟨w⟩ := hT.connected.preconnected a c
  cases w with
  | nil => exact absurd rfl hc
  | cons h _ => exact ⟨_, h⟩

theorem main (n : ℕ) (hn : n ≤ 9) (T : (k : ℕ) → SimpleGraph (Fin k))
    (hT : ∀ k ∈ Set.Icc 2 n, (T k).IsTree) : Erdos743.IsPacking n (Set.Icc 2 n) T := by
  rcases Nat.lt_or_ge n 2 with hlt | h2
  · have hF : ∀ k : Set.Icc 2 n, False := fun k => by
      obtain ⟨h1, h2⟩ := k.2
      omega
    exact ⟨fun k => (hF k).elim, fun k => (hF k).elim, fun k => (hF k).elim⟩
  · obtain ⟨f, hf1, hf2⟩ := univ_all n h2 hn 0 (ng_pos n hn h2) T (fun j h2' hj => hT j ⟨h2', hj⟩)
    have hK := chkK_ok n hn
    have hlt : ∀ j, 2 ≤ j → j ≤ n → ∀ a, f j a < n := by
      intro j h2' hj a
      obtain ⟨hinj, hb, hadj⟩ := hf1 j h2' hj
      obtain ⟨b, hab⟩ := tree_exists_adj (hT j ⟨h2', hj⟩) h2' a
      have := all2 hK (f j a) (f j b) (hb a) (hb b)
      simp only [hadj a b hab, Bool.not_true, Bool.false_or, Bool.and_eq_true,
        decide_eq_true_eq] at this
      exact this.1
    refine ⟨fun k a => ⟨f k a % n, Nat.mod_lt _ (by omega)⟩, fun k a b hab => ?_,
      fun k l hkl => ?_⟩
    · obtain ⟨h1, h2'⟩ := k.2
      have := Fin.mk.inj hab
      rw [Nat.mod_eq_of_lt (hlt _ h1 h2' a), Nat.mod_eq_of_lt (hlt _ h1 h2' b)] at this
      exact (hf1 _ h1 h2').1 this
    · obtain ⟨hk1, hk2⟩ := k.2
      obtain ⟨hl1, hl2⟩ := l.2
      rw [Set.disjoint_left]
      intro s he1 he2
      induction s using Sym2.ind with
      | _ u v =>
        rw [mem_edgeSet, map_adj'] at he1 he2
        obtain ⟨_, a, b, hab, rfl, rfl⟩ := he1
        obtain ⟨_, x, y, hxy, hx, hy⟩ := he2
        have e1 := Fin.mk.inj hx
        have e2 := Fin.mk.inj hy
        rw [Nat.mod_eq_of_lt (hlt _ hl1 hl2 _), Nat.mod_eq_of_lt (hlt _ hk1 hk2 _)] at e1 e2
        exact hf2 k l hk1 hkl hl2 a b x y hab hxy ⟨e1.symm, e2.symm⟩

end OMA743Fishburn

theorem OMA.solution : type_of% @Erdos743.erdos_743.variants.fishburn :=
  OMA743Fishburn.main
