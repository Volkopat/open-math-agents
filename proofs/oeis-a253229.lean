def succL (a b : ℕ) : List ℕ :=
  ((List.range 128).filter (fun c => Qb a b c && kap b c != 0)).map (kap b)

def K1 : Bool := (List.range 128).all fun a => (List.range 128).all fun b =>
  (Pb a b == (kap a b != 0)) && decide (kap a b < 278)

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem K1_ok : K1 = true := by decide +kernel

theorem K1_spec (a b : ℕ) (ha : a < 128) (hb : b < 128) :
    (Pb a b = true ↔ kap a b ≠ 0) ∧ kap a b < 278 := by
  have h := K1_ok
  unfold K1 at h
  rw [List.all_eq_true] at h
  have h2 := h a (List.mem_range.2 ha)
  rw [List.all_eq_true] at h2
  have h3 := h2 b (List.mem_range.2 hb)
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h3
  refine ⟨?_, h3.2⟩
  rw [h3.1]
  simp

def K2 (lo len : ℕ) : Bool := (List.range' lo len).all fun a => (List.range 128).all fun b =>
  !(Pb a b) || (List.insertionSort (· ≤ ·) (succL a b) == rows.getD (kap a b) [])

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem K2_0 : K2 0 16 = true := by decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem K2_1 : K2 16 16 = true := by decide +kernel

