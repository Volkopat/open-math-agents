import OMAStatements.S_oeis_a253229
import Mathlib

-- Proof of the conjectures in OEIS A253229 (statement by @marcusbuffett).
-- Method: a transfer on pairs of consecutive rows, each row of the array read as a 7-bit number
-- through finFunctionFinEquiv. WalkEng counts the arrays as walks with a memory of two rows (F m a b,
-- the number of valid arrays of m + 2 rows whose first two rows are a and b). The certificate gives
-- every pair of rows a class (kap; class 0 for the pairs that violate the horizontal condition) such
-- that the sorted list of classes of the live successors of a pair depends only on its class (rows);
-- the kernel checks this once for all pairs (K1, K2). Then F m a b = g m (kap a b) for class vectors
-- g, which satisfy the vector identity of the characteristic polynomial (x - 1)^3 (x - 2) from m = 4
-- on (checked once by K3, then propagated by linearity). The g.f. and the closed form follow from
-- the resulting recurrence and the first eight terms, which are computed from the class vectors.

namespace WalkEng

open Classical

def gv {k N : ℕ} (y : Fin k → Fin N) (i : ℕ) : ℕ := if h : i < k then (y ⟨i, h⟩ : ℕ) else 0

def VP (P : ℕ → ℕ → Bool) {k N : ℕ} (y : Fin k → Fin N) : Prop :=
  ∀ i, i + 1 < k → P (gv y i) (gv y (i + 1)) = true

def VQ (Q : ℕ → ℕ → ℕ → Bool) {k N : ℕ} (y : Fin k → Fin N) : Prop :=
  ∀ i, i + 2 < k → Q (gv y i) (gv y (i + 1)) (gv y (i + 2)) = true

theorem gv_zero {k N : ℕ} (z : Fin (k + 1) → Fin N) : gv z 0 = z 0 := by simp [gv]

theorem gv_one {k N : ℕ} (z : Fin (k + 2) → Fin N) : gv z 1 = z 1 := by simp [gv]

theorem gv_cons_zero {k N : ℕ} (a : Fin N) (z : Fin k → Fin N) :
    gv (Fin.cons a z : Fin (k + 1) → Fin N) 0 = a := by simp [gv]

theorem gv_cons_succ {k N : ℕ} (a : Fin N) (z : Fin k → Fin N) (i : ℕ) :
    gv (Fin.cons a z : Fin (k + 1) → Fin N) (i + 1) = gv z i := by
  unfold gv
  by_cases h : i < k
  · rw [dif_pos (by omega), dif_pos h]
    have : (⟨i + 1, by omega⟩ : Fin (k + 1)) = Fin.succ ⟨i, h⟩ := rfl
    rw [this, Fin.cons_succ]
  · rw [dif_neg (by omega), dif_neg h]

theorem VP_cons {k N : ℕ} (P : ℕ → ℕ → Bool) (a : Fin N) (z : Fin (k + 1) → Fin N) :
    VP P (Fin.cons a z : Fin (k + 2) → Fin N) ↔ P a (z 0) = true ∧ VP P z := by
  unfold VP
  constructor
  · intro h
    refine ⟨?_, fun i hi => ?_⟩
    · have := h 0 (by omega)
      rwa [gv_cons_zero, gv_cons_succ, gv_zero] at this
    · have := h (i + 1) (by omega)
      rwa [gv_cons_succ, gv_cons_succ] at this
  · rintro ⟨h0, h⟩ i hi
    rcases i with _ | i
    · rwa [gv_cons_zero, gv_cons_succ, gv_zero]
    · rw [gv_cons_succ, gv_cons_succ]; exact h i (by omega)

theorem VQ_cons {k N : ℕ} (Q : ℕ → ℕ → ℕ → Bool) (a : Fin N) (z : Fin (k + 2) → Fin N) :
    VQ Q (Fin.cons a z : Fin (k + 3) → Fin N) ↔ Q a (z 0) (z 1) = true ∧ VQ Q z := by
  unfold VQ
  constructor
  · intro h
    refine ⟨?_, fun i hi => ?_⟩
    · have := h 0 (by omega)
      rwa [gv_cons_zero, gv_cons_succ, gv_cons_succ, gv_zero, gv_one] at this
    · have := h (i + 1) (by omega)
      rwa [gv_cons_succ, gv_cons_succ, gv_cons_succ] at this
  · rintro ⟨h0, h⟩ i hi
    rcases i with _ | i
    · rwa [gv_cons_zero, gv_cons_succ, gv_cons_succ, gv_zero, gv_one]
    · rw [gv_cons_succ, gv_cons_succ, gv_cons_succ]; exact h i (by omega)

theorem sum_cons {k N : ℕ} (f : (Fin (k + 1) → Fin N) → ℕ) :
    ∑ y, f y = ∑ c : Fin N, ∑ z : Fin k → Fin N, f (Fin.cons c z) := by
  rw [← (Fin.consEquiv (fun _ : Fin (k + 1) => Fin N)).sum_comp, Fintype.sum_prod_type]
  rfl

/-- Walk counts with a memory of two rows. -/
def F (P : ℕ → ℕ → Bool) (Q : ℕ → ℕ → ℕ → Bool) (N : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, a, b => if P a b = true then 1 else 0
  | m + 1, a, b => if P a b = true then ∑ c : Fin N, (if Q a b c = true then F P Q N m b c else 0) else 0

theorem cnt (P : ℕ → ℕ → Bool) (Q : ℕ → ℕ → ℕ → Bool) (N : ℕ) :
    ∀ (m : ℕ) (a b : Fin N), (∑ y : Fin (m + 2) → Fin N,
      if VP P y ∧ VQ Q y ∧ y 0 = a ∧ y 1 = b then 1 else 0) = F P Q N m a b := by
  intro m
  induction m with
  | zero =>
    intro a b
    rw [sum_cons]
    simp only [sum_cons]
    have hv : ∀ (c d : Fin N) (e : Fin 0 → Fin N),
        (VP P (Fin.cons c (Fin.cons d e : Fin 1 → Fin N) : Fin 2 → Fin N) ↔ P c d = true) ∧
        VQ Q (Fin.cons c (Fin.cons d e : Fin 1 → Fin N) : Fin 2 → Fin N) := by
      intro c d e
      refine ⟨?_, fun i hi => by omega⟩
      rw [VP_cons]
      simp [VP]
    simp only [hv, true_and, Fin.cons_zero, Fin.cons_one, Finset.univ_unique, Finset.sum_singleton]
    simp only [F]
    rw [Finset.sum_eq_single a]
    · rw [Finset.sum_eq_single b]
      · simp
      · intro d _ hd; simp [hd]
      · simp
    · intro c _ hc; simp [hc]
    · simp
  | succ m ih =>
    intro a b
    rw [sum_cons]
    have step : ∀ (c : Fin N) (z : Fin (m + 2) → Fin N),
        (if VP P (Fin.cons c z : Fin (m + 3) → Fin N) ∧ VQ Q (Fin.cons c z : Fin (m + 3) → Fin N) ∧
          (Fin.cons c z : Fin (m + 3) → Fin N) 0 = a ∧ (Fin.cons c z : Fin (m + 3) → Fin N) 1 = b
          then 1 else 0) =
        if c = a then (if P a b = true then
          ∑ d : Fin N, (if Q a b d = true then
            (if VP P z ∧ VQ Q z ∧ z 0 = b ∧ z 1 = d then 1 else 0) else 0) else 0) else 0 := by
      intro c z
      rw [VP_cons, VQ_cons, Fin.cons_zero]
      have h1 : (Fin.cons c z : Fin (m + 3) → Fin N) 1 = z 0 := rfl
      rw [h1]
      by_cases hc : c = a
      · subst hc
        rw [if_pos rfl]
        by_cases hb : z 0 = b
        · rw [Finset.sum_eq_single (z 1)]
          · subst hb
            by_cases hP : P c (z 0) = true <;> by_cases hQ : Q c (z 0) (z 1) = true <;>
              simp [hP, hQ]
          · intro d _ hd; simp [hd.symm]
          · simp
        · simp only [hb, and_false, false_and, if_false]
          split_ifs <;> simp
      · simp [hc]
    simp only [step]
    rw [Finset.sum_eq_single a (fun c _ hc => by simp [hc]) (by simp)]
    simp only [if_true]
    simp only [F]
    split_ifs with hP
    · rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro d _
      split_ifs with hQ
      · exact ih b d
      · simp
    · simp

theorem total (P : ℕ → ℕ → Bool) (Q : ℕ → ℕ → ℕ → Bool) (N m : ℕ) :
    (∑ y : Fin (m + 2) → Fin N, if VP P y ∧ VQ Q y then 1 else 0) =
      ∑ a : Fin N, ∑ b : Fin N, F P Q N m a b := by
  calc (∑ y : Fin (m + 2) → Fin N, if VP P y ∧ VQ Q y then 1 else 0)
      = ∑ y : Fin (m + 2) → Fin N, ∑ a : Fin N, ∑ b : Fin N,
          (if VP P y ∧ VQ Q y ∧ y 0 = a ∧ y 1 = b then 1 else 0) := by
        apply Finset.sum_congr rfl
        intro y _
        rw [Finset.sum_eq_single (y 0), Finset.sum_eq_single (y 1)]
        · simp
        · intro d _ hd; simp [Ne.symm hd]
        · simp
        · intro c _ hc
          apply Finset.sum_eq_zero
          intro d _
          simp [Ne.symm hc]
        · simp
    _ = ∑ a : Fin N, ∑ y : Fin (m + 2) → Fin N, ∑ b : Fin N,
          (if VP P y ∧ VQ Q y ∧ y 0 = a ∧ y 1 = b then 1 else 0) := Finset.sum_comm
    _ = ∑ a : Fin N, ∑ b : Fin N, ∑ y : Fin (m + 2) → Fin N,
          (if VP P y ∧ VQ Q y ∧ y 0 = a ∧ y 1 = b then 1 else 0) :=
        Finset.sum_congr rfl (fun a _ => Finset.sum_comm)
    _ = ∑ a : Fin N, ∑ b : Fin N, F P Q N m a b := by simp only [cnt]

end WalkEng

namespace OMAA253229Cert

open WalkEng Classical

/-! ### Bits of a row -/

def bt (r j : ℕ) : ℕ := r / 2 ^ j % 2

/-- The horizontal condition on two consecutive rows r (above) and s (below). -/
def Pb (r s : ℕ) : Bool := (List.range 5).all fun j =>
  decide (min (bt r j) (bt s (j + 1)) + min (bt r (j + 2)) (bt s (j + 1)) ≤
    min (bt r (j + 1)) (bt s (j + 2)) + min (bt r (j + 1)) (bt s j))

/-- The vertical condition on three consecutive rows r, s, t. -/
def Qb (r s t : ℕ) : Bool := (List.range 6).all fun j =>
  decide (max (bt r j) (bt s (j + 1)) + max (bt s (j + 1)) (bt t j) ≤
    max (bt s j) (bt t (j + 1)) + max (bt r (j + 1)) (bt s j))

theorem bit_enc (u : Fin 7 → Fin 2) (j : Fin 7) : bt (finFunctionFinEquiv u : ℕ) j.val = (u j).val := by
  unfold bt
  rw [← finFunctionFinEquiv_symm_apply_val, Equiv.symm_apply_apply]

theorem hrow (u v : Fin 7 → Fin 2) :
    (∀ j j' j'' : Fin 7, j'.val = j.val + 1 → j''.val = j'.val + 1 →
      min ((u j).val : ℤ) ((v j').val : ℤ) - min ((u j').val : ℤ) ((v j).val : ℤ) ≤
        min ((u j').val : ℤ) ((v j'').val : ℤ) - min ((u j'').val : ℤ) ((v j').val : ℤ)) ↔
    Pb (finFunctionFinEquiv u) (finFunctionFinEquiv v) = true := by
  unfold Pb
  rw [List.all_eq_true]
  simp only [List.mem_range, decide_eq_true_eq]
  constructor
  · intro h j hj
    have := h ⟨j, by omega⟩ ⟨j + 1, by omega⟩ ⟨j + 2, by omega⟩ rfl rfl
    have e0 := bit_enc u ⟨j, by omega⟩
    have e1 := bit_enc u ⟨j + 1, by omega⟩
    have e2 := bit_enc u ⟨j + 2, by omega⟩
    have f0 := bit_enc v ⟨j, by omega⟩
    have f1 := bit_enc v ⟨j + 1, by omega⟩
    have f2 := bit_enc v ⟨j + 2, by omega⟩
    simp only at e0 e1 e2 f0 f1 f2
    rw [e0, e1, e2, f0, f1, f2]
    omega
  · intro h j j' j'' h1 h2
    have := h j.val (by omega)
    have e0 := bit_enc u j
    have e1 := bit_enc u j'
    have e2 := bit_enc u j''
    have f0 := bit_enc v j
    have f1 := bit_enc v j'
    have f2 := bit_enc v j''
    rw [h1] at e1 f1
    rw [h2, h1] at e2 f2
    rw [e0, e1, e2, f0, f1, f2] at this
    omega

theorem hrowV (u v w : Fin 7 → Fin 2) :
    (∀ j j' : Fin 7, j'.val = j.val + 1 →
      max ((u j).val : ℤ) ((v j').val : ℤ) - max ((u j').val : ℤ) ((v j).val : ℤ) ≤
        max ((v j).val : ℤ) ((w j').val : ℤ) - max ((v j').val : ℤ) ((w j).val : ℤ)) ↔
    Qb (finFunctionFinEquiv u) (finFunctionFinEquiv v) (finFunctionFinEquiv w) = true := by
  unfold Qb
  rw [List.all_eq_true]
  simp only [List.mem_range, decide_eq_true_eq]
  constructor
  · intro h j hj
    have := h ⟨j, by omega⟩ ⟨j + 1, by omega⟩ rfl
    have e0 := bit_enc u ⟨j, by omega⟩
    have e1 := bit_enc u ⟨j + 1, by omega⟩
    have f0 := bit_enc v ⟨j, by omega⟩
    have f1 := bit_enc v ⟨j + 1, by omega⟩
    have g0 := bit_enc w ⟨j, by omega⟩
    have g1 := bit_enc w ⟨j + 1, by omega⟩
    simp only at e0 e1 f0 f1 g0 g1
    rw [e0, e1, f0, f1, g0, g1]
    omega
  · intro h j j' h1
    have := h j.val (by omega)
    have e0 := bit_enc u j
    have e1 := bit_enc u j'
    have f0 := bit_enc v j
    have f1 := bit_enc v j'
    have g0 := bit_enc w j
    have g1 := bit_enc w j'
    rw [h1] at e1 f1 g1
    rw [e0, e1, f0, f1, g0, g1] at this
    omega

/-- The rows of an array, read as numbers. -/
def enc (n : ℕ) : (Fin (n + 1) → Fin 7 → Fin 2) ≃ (Fin (n + 1) → Fin (2 ^ 7)) :=
  Equiv.arrowCongr (Equiv.refl _) finFunctionFinEquiv

theorem gv_enc (n : ℕ) (x : Fin (n + 1) → Fin 7 → Fin 2) (i : ℕ) (hi : i < n + 1) :
    gv (enc n x) i = (finFunctionFinEquiv (x ⟨i, hi⟩) : ℕ) := by
  simp [gv, hi, enc]

theorem bridge (n : ℕ) : OMA.S_oeis_a253229.a n =
    ∑ y : Fin (n + 1) → Fin (2 ^ 7), if VP Pb y ∧ VQ Qb y then 1 else 0 := by
  unfold OMA.S_oeis_a253229.a
  rw [Finset.card_filter]
  refine Eq.trans ?_ ((enc n).sum_comp (fun y => if VP Pb y ∧ VQ Qb y then 1 else 0))
  apply Finset.sum_congr rfl
  intro x _
  apply if_congr _ rfl rfl
  apply and_congr
  · constructor
    · intro h i hi
      rw [gv_enc n x i (by omega), gv_enc n x (i + 1) hi, ← hrow]
      exact h ⟨i, by omega⟩ ⟨i + 1, hi⟩ rfl
    · intro h i i' hii
      rw [hrow]
      have := h i.val (by omega)
      rw [gv_enc n x i.val (by omega), gv_enc n x (i.val + 1) (by omega)] at this
      have e : (⟨i.val + 1, by omega⟩ : Fin (n + 1)) = i' := Fin.ext hii.symm
      rw [e] at this
      exact this
  · constructor
    · intro h i hi
      rw [gv_enc n x i (by omega), gv_enc n x (i + 1) (by omega), gv_enc n x (i + 2) hi, ← hrowV]
      exact h ⟨i, by omega⟩ ⟨i + 1, by omega⟩ ⟨i + 2, hi⟩ rfl rfl
    · intro h i i' i'' h1 h2
      rw [hrowV]
      have := h i.val (by omega)
      rw [gv_enc n x i.val (by omega), gv_enc n x (i.val + 1) (by omega),
        gv_enc n x (i.val + 2) (by omega)] at this
      have e1 : (⟨i.val + 1, by omega⟩ : Fin (n + 1)) = i' := Fin.ext h1.symm
      have e2 : (⟨i.val + 2, by omega⟩ : Fin (n + 1)) = i'' := Fin.ext (show i.val + 2 = i''.val by omega)
      rw [e1, e2] at this
      exact this

