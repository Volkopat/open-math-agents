theorem K2_5 : K2 80 16 = true := by decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem K2_6 : K2 96 16 = true := by decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem K2_7 : K2 112 16 = true := by decide +kernel


theorem K2_spec (a b : ℕ) (ha : a < 128) (hb : b < 128) (hP : Pb a b = true) :
    List.insertionSort (· ≤ ·) (succL a b) = rows.getD (kap a b) [] := by
  have h : ∃ lo len, K2 lo len = true ∧ lo ≤ a ∧ a < lo + len := by
    by_cases h0 : a < 16
    · exact ⟨0, 16, K2_0, by omega, by omega⟩
    by_cases h1 : a < 32
    · exact ⟨16, 16, K2_1, by omega, by omega⟩
    by_cases h2 : a < 48
    · exact ⟨32, 16, K2_2, by omega, by omega⟩
    by_cases h3 : a < 64
    · exact ⟨48, 16, K2_3, by omega, by omega⟩
    by_cases h4 : a < 80
    · exact ⟨64, 16, K2_4, by omega, by omega⟩
    by_cases h5 : a < 96
    · exact ⟨80, 16, K2_5, by omega, by omega⟩
