def C : ℕ → ℤ
  | 0 => 8836
  | 1 => 15776
  | 2 => 24964
  | 3 => 36000
  | n + 4 => 1 * C n - 2 * C (n + 1) + 2 * C (n + 3)

theorem C_rec (n : ℕ) : C (n + 4) = 1 * C n - 2 * C (n + 1) + 2 * C (n + 3) := by
  rw [C]

theorem C_P (n : ℕ) : C (n + 8) = 1 * C (n + 4) - 2 * C (n + 5) + 2 * C (n + 7) := by
  have h4 : C (n + 8) = 1 * C (n + 4) - 2 * C (n + 5) + 2 * C (n + 7) := C_rec (n + 4)
  linear_combination (1) * h4

theorem A_C : ∀ n, A (n + 3) = 1 * C n := by
  apply uniqP (fun n => A (n + 3)) (fun n => 1 * C n)
  · intro n
    exact A_rec (n + 3)
  · intro n
    rw [C_P]
    ring
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel

theorem aC (n : ℕ) : (a (n + 4) : ℤ) = C n := by
  rw [show (a (n + 4) : ℤ) = A (n + 3) from N_eq (n + 3), A_C]
  ring

theorem uniqp {K : Type} [CommRing K] (u v : ℕ → K)
    (hu : ∀ n, u (n + 4) = 1 * u n - 2 * u (n + 1) + 2 * u (n + 3))
    (hv : ∀ n, v (n + 4) = 1 * v n - 2 * v (n + 1) + 2 * v (n + 3))
    (h0 : u 0 = v 0) (h1 : u 1 = v 1) (h2 : u 2 = v 2) (h3 : u 3 = v 3) : ∀ n, u n = v n := by
  have key : ∀ n, u n = v n ∧ u (n + 1) = v (n + 1) ∧ u (n + 2) = v (n + 2) ∧ u (n + 3) = v (n + 3) := by
    intro n
    induction n with
    | zero => exact ⟨h0, h1, h2, h3⟩
    | succ n ih =>
      obtain ⟨a0, a1, a2, a3⟩ := ih
      refine ⟨a1, a2, a3, ?_⟩
      rw [show n + 1 + 3 = n + 4 from rfl, hu, hv, a0, a1, a3]
  exact fun n => (key n).1

theorem rec_k (k : ℕ) : (a (k + 8) : ℤ) = 2 * (a (k + 7) : ℤ) - 2 * (a (k + 5) : ℤ) + 1 * (a (k + 4) : ℤ) := by
  have e0 : (a (k + 8) : ℤ) = C (k + 4) := aC (k + 4)
  have e1 : (a (k + 7) : ℤ) = C (k + 3) := aC (k + 3)
  have e3 : (a (k + 5) : ℤ) = C (k + 1) := aC (k + 1)
  have e4 : (a (k + 4) : ℤ) = C (k) := aC (k)
  linear_combination e0 - (2) * e1 - (-2) * e3 - (1) * e4 + C_rec k

