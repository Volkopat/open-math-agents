theorem closed_n (n : ℕ) (hn : 4 ≤ n) : (a n : ℚ) = 2 * (553 + 25 * (-1 : ℚ) ^ n - 1088 * (n : ℚ) + 512 * (n : ℚ) ^ 2) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 4 := ⟨n - 4, by omega⟩
  have h := congrArg (Int.cast : ℤ → ℚ) (aC (k))
  push_cast at h
  have h2 := closedC k
  rw [show (a (k + 4) : ℚ) = ((C (k) : ℤ) : ℚ) from h]
  exact h2


