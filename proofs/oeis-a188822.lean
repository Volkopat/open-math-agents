  | 3 => 8836
  | 4 => 15776
  | 5 => 24964
  | 6 => 36000
  | 7 => 49284
  | n + 8 => 1 * A (n + 4) - 2 * A (n + 5) + 2 * A (n + 7)

theorem A_rec (n : ℕ) : A (n + 8) = 1 * A (n + 4) - 2 * A (n + 5) + 2 * A (n + 7) := by
  rw [A]

theorem U0 : (∑ s : R, if True then α 0 s else 0) = A 0 := by
