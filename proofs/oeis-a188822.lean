  | zero =>
    intro s
    rw [F_zero, B0]
    split_ifs <;> simp
  | succ n ih =>
    intro s
    rw [F_succ, ← T s n]
    push_cast
    apply Finset.sum_congr rfl
    intro t _
    split_ifs
    · exact ih t
    · rfl

