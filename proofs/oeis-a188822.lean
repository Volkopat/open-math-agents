theorem closedC : ∀ m : ℕ, ((C (m + 0) : ℤ) : ℚ) = 2 * (553 + 25 * (-1 : ℚ) ^ (m + 4) - 1088 * ((m + 4 : ℕ) : ℚ) + 512 * ((m + 4 : ℕ) : ℚ) ^ 2) := by
  apply uniqp (fun m : ℕ => ((C (m + 0) : ℤ) : ℚ)) (fun m : ℕ => 2 * (553 + 25 * (-1 : ℚ) ^ (m + 4) - 1088 * ((m + 4 : ℕ) : ℚ) + 512 * ((m + 4 : ℕ) : ℚ) ^ 2))
  · intro m
    have h := congrArg (Int.cast : ℤ → ℚ) (C_rec (m + 0))
    push_cast at h
    exact h
  · intro m
    push_cast
    ring
  · show ((C (0 + 0) : ℤ) : ℚ) = _
    rw [show C (0 + 0) = 8836 from by decide +kernel]
    norm_num
  · show ((C (1 + 0) : ℤ) : ℚ) = _
    rw [show C (1 + 0) = 15776 from by decide +kernel]
    norm_num
  · show ((C (2 + 0) : ℤ) : ℚ) = _
