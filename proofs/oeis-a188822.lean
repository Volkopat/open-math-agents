  | 0, s => look tab0 s
  | 1, s => look tab1 s
  | 2, s => look tab2 s
  | 3, s => look tab3 s
  | 4, s => look tab4 s
  | 5, s => look tab5 s
  | 6, s => look tab6 s
  | 7, s => look tab7 s
  | n + 8, s => 1 * α (n + 4) s - 2 * α (n + 5) s + 2 * α (n + 7) s

theorem α_rec (n : ℕ) (s : R) : α (n + 8) s = 1 * α (n + 4) s - 2 * α (n + 5) s + 2 * α (n + 7) s := by
  rw [α]

theorem uniqP {K : Type} [CommRing K] (u v : ℕ → K)
    (hu : ∀ n, u (n + 8) = 1 * u (n + 4) - 2 * u (n + 5) + 2 * u (n + 7))
    (hv : ∀ n, v (n + 8) = 1 * v (n + 4) - 2 * v (n + 5) + 2 * v (n + 7))
    (h0 : u 0 = v 0) (h1 : u 1 = v 1) (h2 : u 2 = v 2) (h3 : u 3 = v 3) (h4 : u 4 = v 4) (h5 : u 5 = v 5) (h6 : u 6 = v 6) (h7 : u 7 = v 7) : ∀ n, u n = v n := by
  have key : ∀ n, u n = v n ∧ u (n + 1) = v (n + 1) ∧ u (n + 2) = v (n + 2) ∧ u (n + 3) = v (n + 3) ∧ u (n + 4) = v (n + 4) ∧ u (n + 5) = v (n + 5) ∧ u (n + 6) = v (n + 6) ∧ u (n + 7) = v (n + 7) := by
    intro n
    induction n with
    | zero => exact ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩
    | succ n ih =>
      obtain ⟨a0, a1, a2, a3, a4, a5, a6, a7⟩ := ih
      refine ⟨a1, a2, a3, a4, a5, a6, a7, ?_⟩
      rw [show n + 1 + 7 = n + 8 from rfl, hu, hv, a4, a5, a7]
