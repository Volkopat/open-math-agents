lemma nodeChecked (i : Node) : checkNode i := allNumeric i (Nat.zero_le _) i.isLt
lemma edge_ok : ∀ i : Node, ∀ x y : Bool, (x=true → u i=true) → (y=true → v i=true) →
    u (child i x y) = u i ∧ v (child i x y) = v i ∧ q (child i x y) = go (q i) true x y := fun i => (nodeChecked i).1

lemma Vstep (n : ℕ) (i : Node) : V (n+1) i = next i (V n) := by
  have localEq (x y : Bool) (hx : x=true → u i=true) (hy : y=true → v i=true) :
      V n (child i x y) = iterate n (u i) (v i) (go (q i) true x y) := by
    obtain ⟨hu,hv,hq⟩ := edge_ok i x y hx hy; unfold V; rw [hu,hv,hq]
  change mix (u i) (v i) (iterate n (u i) (v i)) (q i) = next i (V n)
  unfold mix next
  have h00 := localEq false false (by simp) (by simp)
  cases hu : u i <;> cases hv : v i <;> simp only [pick, Bool.false_eq_true, ↓reduceIte]
  · simp only [localEq false false (by simp [hu]) (by simp [hv]), hu, hv]
  · simp only [localEq false false (by simp [hu]) (by simp [hv]), localEq false true (by simp [hu]) (by simp [hv]), hu, hv]
  · simp only [localEq false false (by simp [hu]) (by simp [hv]), localEq true false (by simp [hu]) (by simp [hv]), hu, hv]
  · simp only [localEq false false (by simp [hu]) (by simp [hv]), localEq false true (by simp [hu]) (by simp [hv]), localEq true false (by simp [hu]) (by simp [hv]), localEq true true (by simp [hu]) (by simp [hv]), hu, hv]

lemma layer0 : ∀ i : Node, layer 0 i = V 0 i := fun i => (nodeChecked i).2.1

lemma layerStep : ∀ k : Fin 11, ∀ i : Node, layer (k.val+1) i = next i (layer k.val) := fun k i => (nodeChecked i).2.2.1 k

lemma initial (k : ℕ) (hk : k≤11) : ∀ i, V k i=layer k i := by
  induction k with
  | zero => intro i; exact (layer0 i).symm
  | succ k ih =>
    intro i; rw [Vstep, show layer (k+1) i = next i (layer k) from layerStep ⟨k,by omega⟩ i, funext (ih (by omega))]

lemma layerRec : ∀ i : Node, layer 11 i =  7 * layer 10 i - 8 * layer 9 i - 28 * layer 8 i + 49 * layer 7 i - 7 * layer 6 i + 8 * layer 5 i + 28 * layer 4 i - 48 * layer 3 i := fun i => (nodeChecked i).2.2.2

lemma Vrec (n : ℕ) : ∀ i, V (n+11) i =  7 * V (n+10) i - 8 * V (n+9) i - 28 * V (n+8) i + 49 * V (n+7) i - 7 * V (n+6) i + 8 * V (n+5) i + 28 * V (n+4) i - 48 * V (n+3) i := by
  induction n with
  | zero =>
    intro i
    simp only [Nat.zero_add, initial 11 (by decide), initial 10 (by decide), initial 9 (by decide), initial 8 (by decide), initial 7 (by decide), initial 6 (by decide), initial 5 (by decide), initial 4 (by decide), initial 3 (by decide)]; exact layerRec i
  | succ n ih =>
    intro i
    simp only [Nat.succ_add,Vstep]
    unfold next
    cases h : u i <;> cases h' : v i <;> simp only [pick,Bool.false_eq_true, ↓reduceIte] <;>
      linarith only [ih (child i false false),ih (child i true false),ih (child i false true),ih (child i true true)]

lemma sampled (n : ℕ) : (a n : ℤ) = 4*V n 3 - 2*V n 2 - 2*V n 1 + V n 0 := by
  rw [a,sampled_eq n 33 rfl]; simp only [count_root]; rfl

def S (n : ℕ) : ℤ := a n
lemma recurrence (n : ℕ) : S (n+11) =  7 * S (n+10) - 8 * S (n+9) - 28 * S (n+8) + 49 * S (n+7) - 7 * S (n+6) + 8 * S (n+5) + 28 * S (n+4) - 48 * S (n+3) := by
  unfold S
  simp only [sampled,Vrec n]; ring

lemma base (n : Fin 11) : S n = (4*layer n 3 - 2*layer n 2 - 2*layer n 1 + layer n 0) := by
  unfold S; rw [sampled]; simp only [initial n (by omega : n.val≤11)]

