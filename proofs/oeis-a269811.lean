abbrev Node := Fin 321
def u (i : Node) := (coord i).testBit 10
def v (i : Node) := (coord i).testBit 11
def q (i : Node) := coord i % 1024
def child (i : Node) (x y : Bool) : Node :=
  ⟨(((edge i >>> (9*(2*x.toNat+y.toNat))) % 512) % 321), Nat.mod_lt _ (by decide)⟩
def layer (k : ℕ) (i : Node) : ℤ := sample (k*321+i.val)
def V (n : ℕ) (i : Node) := iterate n (u i) (v i) (q i)
def next (i : Node) (f : Node → ℤ) :=
  pick (v i) fun y => pick (u i) fun x => f (child i x y)


def checkNode (i : Node) : Prop :=
  (∀ x y : Bool, (x=true → u i=true) → (y=true → v i=true) →
    u (child i x y) = u i ∧ v (child i x y) = v i ∧ q (child i x y) = go (q i) true x y) ∧ layer 0 i = V 0 i ∧
  (∀ k : Fin 11, layer (k.val+1) i = next i (layer k.val)) ∧
  (layer 11 i =  7 * layer 10 i - 8 * layer 9 i - 28 * layer 8 i + 49 * layer 7 i - 7 * layer 6 i + 8 * layer 5 i + 28 * layer 4 i - 48 * layer 3 i)
instance (i : Node) : Decidable (checkNode i) := by unfold checkNode; infer_instance

def intervalOK (a b : ℕ) : Prop := ∀ i : Node, a ≤ i.val → i.val < b → checkNode i
def nodeOf (n : ℕ) : Node := ⟨n%321,Nat.mod_lt _ (by decide)⟩

lemma joinInterval (a b c : ℕ) (l : intervalOK a b) (r : intervalOK b c) : intervalOK a c := by
  intro i h j; by_cases hb : i.val<b
  · exact l i h hb
  · exact r i (by omega) j

lemma checkInterval (a b : ℕ) (h : ∀ i : Fin (b-a), checkNode (nodeOf (a+i.val))) : intervalOK a b := by
  intro i lo hi
  have e : nodeOf (a+(i.val-a))=i := by
    apply Fin.ext; change (a+(i.val-a))%321 = i.val
    rw [show a+(i.val-a)=i.val by omega,Nat.mod_eq_of_lt i.isLt]
  rw [←e]; exact h ⟨i.val-a,by omega⟩
