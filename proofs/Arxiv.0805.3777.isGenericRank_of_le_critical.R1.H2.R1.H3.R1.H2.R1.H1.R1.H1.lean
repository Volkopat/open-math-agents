import OMAReductions.R_Arxiv_0805_3777_isGenericRank_of_le_critical_R1_H2_R1_H3_R1_H2_R1_H1_R1
import Mathlib

/-! Packed natural-number products with separated tensor coordinates. -/

namespace OMA.TangentRadix

open Finset

def pack (base : ℕ) (digit : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => digit 0 + base * pack base (fun i => digit (i+1)) n

theorem pack_sum (base : ℕ) (digit : ℕ → ℕ) (n : ℕ) :
    pack base digit n = ∑ i : Fin n, digit i.val * base^i.val := by
  induction n generalizing digit with
  | zero => simp [pack]
  | succ n ih =>
      rw [pack, ih, Fin.sum_univ_succ]
      simp only [Fin.val_zero, pow_zero, mul_one, Fin.val_succ, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [pow_succ]
      ring

theorem digit_read {base n i : ℕ} (hb : 0 < base) (digit : ℕ → ℕ)
    (bounded : ∀ j < n, digit j < base) (hi : i < n) :
    pack base digit n / base^i % base = digit i := by
  induction n generalizing digit i with
  | zero => omega
  | succ n ih =>
      have h₀ := bounded 0 (by omega)
      have ht : ∀ j < n, digit (j+1) < base := fun j hj => bounded _ (by omega)
      cases i with
      | zero =>
          simp [pack, Nat.add_mod, Nat.mod_eq_of_lt h₀]
      | succ i =>
          rw [pack, pow_succ', ← Nat.div_div_eq_div_mul,
            Nat.add_mul_div_left _ _ hb, Nat.div_eq_of_lt h₀, zero_add]
          exact ih _ ht (by omega)

theorem pack_add (b n : ℕ) (f g : ℕ → ℕ) :
    pack b f n + pack b g n = pack b (fun i => f i + g i) n := by
  simp only [pack_sum, add_mul, Finset.sum_add_distrib]

theorem pack_smul (b n s : ℕ) (f : ℕ → ℕ) :
    s * pack b f n = pack b (fun i => s * f i) n := by
  simp only [pack_sum, Finset.mul_sum, mul_assoc]

abbrev Axes := Fin 3 × Fin 14 × Fin 22

def index (q : Axes) : ℕ := 308*q.1.val + 22*q.2.1.val + q.2.2.val

def xWord (base : ℕ) (f : Fin 3 → ℕ) : ℕ := ∑ i, f i * base^(308*i.val)

def yWord (base : ℕ) (f : Fin 14 → ℕ) : ℕ := ∑ j, f j * base^(22*j.val)

def zWord (base : ℕ) (f : Fin 22 → ℕ) : ℕ := ∑ k, f k * base^k.val

private theorem distribute3 {I J K : Type*} [Fintype I] [Fintype J] [Fintype K]
    (f : I → ℕ) (g : J → ℕ) (h : K → ℕ) :
    (∑ i, f i) * (∑ j, g j) * (∑ k, h k) = ∑ i, ∑ j, ∑ k, f i * g j * h k := by
  have hf : (∑ i, f i) * (∑ j, g j) = ∑ i, f i * (∑ j, g j) :=
    Finset.sum_mul _ _ _
  rw [hf, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  have hh : f i * (∑ j, g j) = ∑ j, f i * g j :=
    Finset.mul_sum _ _ _
  rw [hh, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  exact Finset.mul_sum _ _ _

theorem separable (base : ℕ) (x : Fin 3 → ℕ) (y : Fin 14 → ℕ) (z : Fin 22 → ℕ) :
    xWord base x * yWord base y * zWord base z =
      ∑ q : Axes, (x q.1 * y q.2.1 * z q.2.2) * base^(index q) := by
  rw [xWord, yWord, zWord, distribute3]
  simp only [index, Fintype.sum_prod_type, pow_add]
  refine Finset.sum_congr rfl (fun i _ =>
    Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ => ?_)))
  ac_rfl

abbrev XT := Fin 25 → Fin 3 → ℕ
abbrev YT := Fin 25 → Fin 14 → ℕ
abbrev ZT := Fin 25 → Fin 22 → ℕ

def coefficients (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) (q : Axes) : ℕ :=
  ∑ t, (u t q.1 * y t q.2.1 * z t q.2.2 + x t q.1 * v t q.2.1 * z t q.2.2 +
    x t q.1 * y t q.2.1 * w t q.2.2)

def packedProduct (base : ℕ) (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) : ℕ :=
  ∑ t, (xWord base (u t) * yWord base (y t) * zWord base (z t) +
    xWord base (x t) * yWord base (v t) * zWord base (z t) +
    xWord base (x t) * yWord base (y t) * zWord base (w t))

theorem packedProduct_eq (base : ℕ) (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) :
    packedProduct base x y z u v w =
      ∑ q : Axes, (coefficients x y z u v w q) * base^(index q) := by
  unfold packedProduct coefficients
  simp only [separable, ← Finset.sum_add_distrib]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro q _
  simp only [Finset.sum_mul, add_mul]

def rowIndex : Axes ≃ Fin 924 :=
  (Equiv.prodCongr (Equiv.refl (Fin 3)) (@finProdFinEquiv 14 22)).trans finProdFinEquiv

theorem rowIndex_val (q : Axes) : (rowIndex q).val = index q := by
  rcases q with ⟨i,j,k⟩
  change k.val + 22*j.val + 308*i.val = 308*i.val + 22*j.val + k.val
  omega

def rowCoeff (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) (q : ℕ) : ℕ :=
  coefficients x y z u v w (rowIndex.symm (Fin.ofNat 924 q))

theorem packed_rows (base : ℕ) (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) :
    packedProduct base x y z u v w = pack base (rowCoeff x y z u v w) 924 := by
  rw [packedProduct_eq, pack_sum, ← Equiv.sum_comp rowIndex]
  apply Finset.sum_congr rfl
  intro q _
  have hr : Fin.ofNat 924 (rowIndex q).val = rowIndex q := Fin.ext (Nat.mod_eq_of_lt (rowIndex q).isLt)
  rw [← rowIndex_val q, rowCoeff, hr, Equiv.symm_apply_apply]

theorem packed_digit (base : ℕ) (hb : 0 < base)
    (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT)
    (bound : ∀ q : Axes, coefficients x y z u v w q < base) (r : Fin 924) :
    packedProduct base x y z u v w / base^r.val % base =
      coefficients x y z u v w (rowIndex.symm r) := by
  rw [packed_rows]
  have hbound : ∀ j < 924, rowCoeff x y z u v w j < base := fun _ _ => bound _
  rw [digit_read hb (rowCoeff x y z u v w) hbound r.isLt]
  have hr : Fin.ofNat 924 r.val = r := Fin.ext (Nat.mod_eq_of_lt r.isLt)
  rw [rowCoeff, hr]

end OMA.TangentRadix

namespace OMA.TangentRadix

open Finset

theorem pack_congr (b n : ℕ) (f g : ℕ → ℕ) (h : ∀ i < n, f i = g i) :
    pack b f n = pack b g n := by
  simp only [pack_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [h i.val i.isLt]

theorem pack_lt (b n : ℕ) (f : ℕ → ℕ) (h : ∀ i < n, f i < b) :
    pack b f n < b^n := by
  induction n generalizing f with
  | zero => simp [pack]
  | succ n ih =>
      rw [pack, pow_succ']
      have ht := ih (fun i => f (i+1)) (fun i hi => h (i+1) (by omega))
      calc
        _ < b + b * pack b (fun i => f (i+1)) n :=
          Nat.add_lt_add_right (h 0 (by omega)) _
        _ = b * (pack b (fun i => f (i+1)) n + 1) := by ring
        _ ≤ _ := Nat.mul_le_mul_left _ (by omega)

theorem pack_read {b : ℕ} (hb : 0 < b) (n w : ℕ) (hw : w < b^n) :
    pack b (fun i => w / b^i % b) n = w := by
  induction n generalizing w with
  | zero => simpa [pack] using (show 0 = w by simp at hw; omega)
  | succ n ih =>
      rw [pack, pow_zero, Nat.div_one]
      have hq : w / b < b^n := (Nat.div_lt_iff_lt_mul hb).mpr (by simpa [pow_succ] using hw)
      have ht : pack b (fun i => w / b^(i+1) % b) n =
          pack b (fun i => (w/b) / b^i % b) n := by
        apply pack_congr
        intro i _
        rw [pow_succ', Nat.div_div_eq_div_mul]
      rw [ht, ih (w/b) hq, Nat.mod_add_div]

theorem and_read (s i a c : ℕ) :
    (a &&& c) / (2^s)^i % 2^s =
      (a / (2^s)^i % 2^s) &&& (c / (2^s)^i % 2^s) := by
  simp only [← pow_mul, ← Nat.shiftRight_eq_div_pow, Nat.shiftRight_and_distrib,
    Nat.and_mod_two_pow]

theorem pack_and (s n : ℕ) (f g : ℕ → ℕ)
    (hf : ∀ i < n, f i < 2^s) (hg : ∀ i < n, g i < 2^s) :
    (pack (2^s) f n &&& pack (2^s) g n) =
      pack (2^s) (fun i => f i &&& g i) n := by
  have hb : 0 < (2 : ℕ)^s := pow_pos (by decide) _
  let w := pack (2^s) f n &&& pack (2^s) g n
  have hw : w < (2^s)^n := Nat.and_le_right.trans_lt (pack_lt _ _ g hg)
  calc
    w = pack (2^s) (fun i => w / (2^s)^i % 2^s) n := (pack_read hb n _ hw).symm
    _ = _ := by
      apply pack_congr
      intro i hi
      rw [show w = _ from rfl, and_read, digit_read hb f hf hi, digit_read hb g hg hi]

theorem pack_sub (b n : ℕ) (f g : ℕ → ℕ) (h : ∀ i < n, g i ≤ f i) :
    pack b f n - pack b g n = pack b (fun i => f i - g i) n := by
  have eq : pack b (fun i => f i - g i) n + pack b g n = pack b f n := by
    rw [pack_add]
    apply pack_congr
    intro i hi
    exact Nat.sub_add_cancel (h i hi)
  rw [← eq, Nat.add_sub_cancel]

def geom (s n : ℕ) : ℕ := ((1 <<< (s*n)) - 1) / ((1 <<< s) - 1)

theorem geom_eq (s n : ℕ) (hs : 0 < s) :
    geom s n = pack (2^s) (fun _ => 1) n := by
  have hb : 1 < (2 : ℕ)^s := one_lt_pow₀ (by decide) (by omega)
  have hsum := geom_sum_mul_of_one_le (le_of_lt hb) n
  rw [geom, Nat.one_shiftLeft, Nat.one_shiftLeft, pow_mul, ← hsum,
    Nat.mul_div_cancel _ (by omega), pack_sum]
  simp only [one_mul]
  exact (Fin.sum_univ_eq_sum_range (fun i : ℕ => ((2 : ℕ)^s)^i) n).symm

theorem reduced_divides (d : ℕ) (hd : d < 65536) (h : d*52429 % 65536 ≤ 13107) :
    5 ∣ d := by
  let r := d*52429 % 65536
  have hmod : 5*r ≡ d [MOD 65536] := by
    calc
      5*r ≡ 5*(d*52429) [MOD 65536] := (Nat.mod_modEq _ _).mul_left 5
      _ = d*(5*52429) := by ring
      _ ≡ d*1 [MOD 65536] := (by decide : 5*52429 ≡ 1 [MOD 65536]).mul_left d
      _ = d := by rw [mul_one]
  have hr : 5*r < 65536 := by dsimp [r]; omega
  have eq : 5*r = d := by
    change 5*r % 65536 = d % 65536 at hmod
    rw [Nat.mod_eq_of_lt hr, Nat.mod_eq_of_lt hd] at hmod
    exact hmod
  exact ⟨r,eq.symm⟩

def flags (n word : ℕ) : Prop :=
  let g := geom 32 n
  let r := (word * 52429) &&& (65535*g)
  let f := 65536*g
  (((65536+13107)*g-r) &&& f) = f

theorem flags_sound (n : ℕ) (d : ℕ → ℕ) (hd : ∀ i < n, d i < 65536)
    (hc : flags n (pack (2^32) d n)) (i : ℕ) (hi : i < n) : 5 ∣ d i := by
  have h₁ : ∀ i < n, 52429 * d i < (2:ℕ)^32 := by
    intro i hi
    have := hd i hi
    norm_num
    omega
  have hbound (i : ℕ) : 52429 * d i % 65536 ≤ 65535 :=
    Nat.le_of_lt_succ (Nat.mod_lt _ (by decide))
  unfold flags at hc
  dsimp only at hc
  rw [geom_eq _ _ (by decide), mul_comm (pack _ d n) 52429, pack_smul, pack_smul, pack_smul, pack_smul,
    pack_and 32 _ _ _ h₁ (fun _ _ => by decide)] at hc
  have hmask (j : ℕ) : 52429*d j &&& 65535 = 52429*d j % 65536 :=
    Nat.and_two_pow_sub_one_eq_mod _ 16
  simp only [hmask] at hc
  rw [pack_sub _ n _ _ (fun j _ => by have := hbound j; omega)] at hc
  have hlt : ∀ i < n, 65536+13107 - 52429*d i % 65536 < (2:ℕ)^32 := by
    intro j _
    exact lt_of_le_of_lt (Nat.sub_le ..) (by decide)
  rw [pack_and 32 _ _ _ hlt (fun _ _ => by decide)] at hc
  have eq := congrArg (fun w : ℕ => w / (2^32)^i % (2^32)) hc
  rw [digit_read (by decide) _ (fun j hj => Nat.and_le_left.trans_lt (hlt j hj)) hi,
    digit_read (by decide) _ (fun _ _ => by decide) hi] at eq
  have hge : 65536 ≤ 65536+13107 - 52429*d i % 65536 := by
    calc _ = _ := eq.symm
         _ ≤ _ := Nat.and_le_left
  apply reduced_divides (d i) (hd i hi)
  rw [mul_comm (d i)]
  omega

end OMA.TangentRadix

namespace OMA.TangentRadix

private theorem read_mod (w bits off len : ℕ) (h : off+len ≤ bits) :
    w / 2^off % 2^len = (w % 2^bits) / 2^off % 2^len := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [← Nat.shiftRight_eq_div_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]
  by_cases hi : i < len
  · have hl : off+i < bits := by omega
    simp [hi, hl]
  · simp [hi]

def spread (w n step : ℕ) : ℕ :=
  (w * geom (step-3) n) &&& (7 * geom step n)

theorem spread_eq (w n step : ℕ) (hs : 3 ≤ step) (hpos : 0 < step-3)
    (hspace : 3*n ≤ step-3) (hw : w < 2^(3*n)) :
    spread w n step = pack (2^step) (fun i => w / 8^i % 8) n := by
  have hwb : w < 2^(step-3) :=
    hw.trans_le (Nat.pow_le_pow_right (by decide) hspace)
  have hb : 0 < (2:ℕ)^step := pow_pos (by decide) _
  have hb' : 0 < (2:ℕ)^(step-3) := pow_pos (by decide) _
  have h₇ : 7 < (2:ℕ)^step := lt_of_lt_of_le (by decide : 7 < (2:ℕ)^3)
    (Nat.pow_le_pow_right (by decide) hs)
  let wrep := w * geom (step-3) n
  let mask := 7 * geom step n
  have hwm : wrep = pack (2^(step-3)) (fun _ => w) n := by
    simp only [wrep, geom_eq _ _ hpos, pack_smul, mul_one]
  have hm : mask = pack (2^step) (fun _ => 7) n := by
    simp only [mask, geom_eq _ _ (by omega : 0 < step), pack_smul, mul_one]
  have hbound : (wrep &&& mask) < (2^step)^n :=
    Nat.and_le_right.trans_lt (hm.symm ▸ pack_lt _ _ _ (fun _ _ => h₇))
  change (wrep &&& mask) = _
  rw [← pack_read hb n _ hbound]
  apply pack_congr
  intro i hi
  rw [and_read, hm, digit_read hb _ (fun _ _ => h₇) hi]
  have hpow : (2:ℕ)^step = 2^(step-3) * 2^3 := by
    rw [← pow_add]
    congr 1
    omega
  have hdvd : (2:ℕ)^3 ∣ 2^step := pow_dvd_pow 2 hs
  change (wrep / (2^step)^i % 2^step &&& (2^3-1)) = _
  rw [Nat.and_two_pow_sub_one_eq_mod, Nat.mod_mod_of_dvd _ hdvd]
  have hsplit : ((2:ℕ)^step)^i = (2^(step-3))^i * 2^(3*i) := by
    rw [hpow, mul_pow, pow_mul]
  rw [hsplit, ← Nat.div_div_eq_div_mul]
  have hcut : 3*i+3 ≤ step-3 := by omega
  rw [read_mod _ _ _ _ hcut]
  have hread : wrep/(2^(step-3))^i % 2^(step-3) = w := by
    rw [hwm]
    exact digit_read hb' _ (fun _ _ => hwb) hi
  rw [hread, pow_mul]
  rfl

end OMA.TangentRadix

namespace OMA.TangentRadix

open Finset

def read (word i : ℕ) : ℕ := word / 8^i % 8

def slice (word start size : ℕ) : ℕ := (word / 8^start) % 2^(3*size)

theorem slice_read (word start size i : ℕ) (hi : i < size) :
    read (slice word start size) i = read word (start+i) := by
  have he : (8:ℕ)^i = 2^(3*i) := by rw [pow_mul]; rfl
  change (word / 8^start % 2^(3*size)) / 8^i % (2^3) = word / 8^(start+i) % (2^3)
  rw [he, ← read_mod _ _ _ _ (by omega : 3*i+3 ≤ 3*size), ← he,
    Nat.div_div_eq_div_mul, ← pow_add]

theorem slice_spread (w start n step : ℕ) (hs : 3 ≤ step)
    (hpos : 0 < step-3) (hspace : 3*n ≤ step-3) :
    spread (slice w start n) n step =
      pack (2^step) (fun i => read w (start+i)) n := by
  have hw : slice w start n < 2^(3*n) := Nat.mod_lt _ (pow_pos (by decide) _)
  rw [spread_eq _ _ _ hs hpos hspace hw]
  exact pack_congr _ _ _ _ fun i hi => slice_read w start n i hi

theorem pack_range (base : ℕ) (f : ℕ → ℕ) (n : ℕ) :
    pack base f n = ∑ i ∈ range n, f i * base^i := by
  rw [pack_sum]
  exact Fin.sum_univ_eq_sum_range (fun i : ℕ => f i * base^i) n

theorem pack_split (b m n : ℕ) (f : ℕ → ℕ) :
    pack b f (m+n) =
      pack b f m + b^m * pack b (fun i => f (m+i)) n := by
  simp only [pack_range, Finset.sum_range_add, Finset.mul_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  simp only [pow_add]
  ac_rfl

def axisX (w start : ℕ) : ℕ :=
  spread (slice w start 3) 3 (32*308)

def axisY (w start : ℕ) : ℕ :=
  spread (slice w start 14) 14 (32*22)

def axisZ (w start : ℕ) : ℕ :=
  spread (slice w start 8) 8 32 +
    2^256 * spread (slice w (start+8) 8) 8 32 +
    2^512 * spread (slice w (start+16) 6) 6 32

theorem axisX_eq (w s : ℕ) :
    axisX w s = xWord (2^32) (fun i => read w (s+i.val)) := by
  rw [axisX, slice_spread _ _ _ _ (by decide) (by decide) (by decide), pack_sum, xWord]
  apply Finset.sum_congr rfl
  intro i _
  rw [← pow_mul, ← pow_mul, Nat.mul_assoc]

theorem axisY_eq (w s : ℕ) :
    axisY w s = yWord (2^32) (fun i => read w (s+i.val)) := by
  rw [axisY, slice_spread _ _ _ _ (by decide) (by decide) (by decide), pack_sum, yWord]
  apply Finset.sum_congr rfl
  intro i _
  rw [← pow_mul, ← pow_mul, Nat.mul_assoc]

theorem axisZ_eq (w s : ℕ) :
    axisZ w s = zWord (2^32) (fun i => read w (s+i.val)) := by
  rw [axisZ, slice_spread w s 8 32 (by decide) (by decide) (by decide),
    slice_spread w (s+8) 8 32 (by decide) (by decide) (by decide),
    slice_spread w (s+16) 6 32 (by decide) (by decide) (by decide),
    zWord, ← pack_sum _ (fun i => read w (s+i)) 22,
    pack_split (2^32) 16 6 _, pack_split (2^32) 8 8 _]
  simp only [← Nat.add_assoc, ← pow_mul]

abbrev Words := ℕ → ℕ

def tangentTerm (X Y Z : Words) (v t : ℕ) : ℕ :=
  let x := axisX (X t) 0
  let y := axisY (Y t) 0
  let z := axisZ (Z t) 0
  let u' := axisX v (39*t)
  let v' := axisY v (39*t+3)
  let w' := axisZ v (39*t+17)
  u'*y*z + x*v'*z + x*y*w'

def fastProduct (X Y Z : Words) (v : ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => fastProduct X Y Z v n + tangentTerm X Y Z v n

def xAt (X : Words) (t : Fin 25) (i : Fin 3) : ℕ := read (X t.val) i.val
def yAt (Y : Words) (t : Fin 25) (i : Fin 14) : ℕ := read (Y t.val) i.val
def zAt (Z : Words) (t : Fin 25) (i : Fin 22) : ℕ := read (Z t.val) i.val
def uAt (v : ℕ) (t : Fin 25) (i : Fin 3) : ℕ := read v (39*t.val+i.val)
def vAt (v : ℕ) (t : Fin 25) (i : Fin 14) : ℕ := read v (39*t.val+3+i.val)
def wAt (v : ℕ) (t : Fin 25) (i : Fin 22) : ℕ := read v (39*t.val+17+i.val)

theorem fastProduct_eq (X Y Z : Words) (v : ℕ) :
    fastProduct X Y Z v 25 = packedProduct (2^32) (xAt X) (yAt Y) (zAt Z)
      (uAt v) (vAt v) (wAt v) := by
  have h (n : ℕ) : fastProduct X Y Z v n = ∑ t ∈ range n, tangentTerm X Y Z v t := by
    induction n with
    | zero => simp [fastProduct]
    | succ n ih => rw [fastProduct, Finset.sum_range_succ, ih]
  rw [h, ← Fin.sum_univ_eq_sum_range (tangentTerm X Y Z v) 25, packedProduct]
  apply Finset.sum_congr rfl
  intro t _
  simp only [tangentTerm, axisX_eq, axisY_eq, axisZ_eq, Nat.zero_add]
  rfl

end OMA.TangentRadix

namespace OMA.TangentRadix

open Finset

private theorem read_le (w i : ℕ) : read w i ≤ 7 :=
  Nat.le_of_lt_succ (Nat.mod_lt _ (by decide))

private theorem correction {n : ℕ} (r : Fin n) :
    pack (2^32) (fun i => if i = r.val then 4 else 0) n = 4*((2:ℕ)^32)^r.val := by
  rw [pack_sum]
  simp only [← Fin.ext_iff, ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]

private theorem coefficients_bound (X Y Z : Words) (word : ℕ) (a : Axes) :
    coefficients (xAt X) (yAt Y) (zAt Z) (uAt word) (vAt word) (wAt word) a ≤ 25725 := by
  unfold coefficients
  calc
    _ ≤ ∑ _ : Fin 25, 1029 := by
      apply Finset.sum_le_sum
      intro t _
      simp only [xAt, yAt, zAt, uAt, vAt, wAt]
      calc
        _ ≤ (7*7*7 + 7*7*7 + 7*7*7 : ℕ) := by
          gcongr <;> exact read_le _ _
        _ = _ := by decide
    _ = _ := by simp

private theorem checkBasisWindow {n : ℕ} (f : ℕ → ℕ) (bounded : ∀ i < n, f i ≤ 25725)
    (r : Fin n) (h : flags n (pack (2^32) f n + 4*((2:ℕ)^32)^r.val)) (i : Fin n) :
    (f i.val : ZMod 5) = if i = r then 1 else 0 := by
  rw [← correction r, pack_add] at h
  have hb j (hj : j < n) : f j + (if j = r.val then 4 else 0) < 65536 := by
    have h₁ : (if j = r.val then 4 else 0) ≤ 4 := by split <;> decide
    exact (Nat.add_le_add (bounded j hj) h₁).trans_lt (by decide)
  have hd := flags_sound n _ hb h i.val i.isLt
  have hz := (ZMod.natCast_eq_zero_iff _ 5).2 hd
  rw [Nat.cast_add] at hz
  by_cases hr : i = r
  · rw [if_pos (congrArg Fin.val hr)] at hz
    rw [if_pos hr]
    let c : ZMod 5 := f i.val
    have hsum : c + 4 = 0 := by simpa only [c, Nat.cast_ofNat] using hz
    change c = 1
    calc
      c = (c + 4) - 4 := (add_sub_cancel_right c 4).symm
      _ = 1 := by rw [hsum]; decide
  · have hval : i.val ≠ r.val := fun e => hr (Fin.ext e)
    simpa only [if_neg hval, Nat.cast_zero, add_zero, if_neg hr] using hz

theorem modularBasis (X Y Z : Words) (r : Fin 924) (word : ℕ)
    (h : flags 924 (fastProduct X Y Z word 25 + 4*((2:ℕ)^32)^r.val)) (q : Axes) :
    (coefficients (xAt X) (yAt Y) (zAt Z) (uAt word) (vAt word) (wAt word) q : ZMod 5) =
      if rowIndex q = r then 1 else 0 := by
  rw [fastProduct_eq, packed_rows] at h
  have hv := checkBasisWindow _
    (fun j _ => coefficients_bound X Y Z word (rowIndex.symm (Fin.ofNat 924 j)))
    r h (rowIndex q)
  have e : Fin.ofNat 924 (rowIndex q).val = rowIndex q :=
    Fin.ext (Nat.mod_eq_of_lt (rowIndex q).isLt)
  simpa only [rowCoeff, e, Equiv.symm_apply_apply] using hv

def topRow (r : Fin 824) : Fin 924 := Fin.castAdd 100 r
def tailRow (r : Fin 100) : Fin 924 := Fin.natAdd 824 r

theorem modularSuffix (X Y Z : Words) (r : Fin 100) (word : ℕ)
    (h : flags 100 (fastProduct X Y Z word 25 / ((2:ℕ)^32)^824 + 4*((2:ℕ)^32)^r.val))
    (q : Fin 100) :
    (coefficients (xAt X) (yAt Y) (zAt Z)
      (uAt word) (vAt word) (wAt word) (rowIndex.symm (tailRow q)) : ZMod 5) =
        if q = r then 1 else 0 := by
  let f := rowCoeff (xAt X) (yAt Y) (zAt Z) (uAt word) (vAt word) (wAt word)
  have hb j : f j ≤ 25725 :=
    coefficients_bound X Y Z word (rowIndex.symm (Fin.ofNat 924 j))
  have hword : fastProduct X Y Z word 25 = pack (2^32) f (824+100) := by
    rw [fastProduct_eq, packed_rows]
  rw [hword, pack_split _ 824 100,
    Nat.add_mul_div_left _ _ (pow_pos (by decide) _),
    Nat.div_eq_of_lt (pack_lt _ _ f (fun j _ => (hb j).trans_lt (by decide))),
    zero_add] at h
  have hv := checkBasisWindow _ (fun j _ => hb (824+j)) r h q
  have e : Fin.ofNat 924 (824+q.val) = tailRow q := Fin.ext <|
    Nat.mod_eq_of_lt (tailRow q).isLt
  simpa only [f, rowCoeff, e] using hv

end OMA.TangentRadix

namespace OMA.TangentRadix

open Finset Matrix

private theorem solveBlocks {L H V : Type*} [Fintype L] [Fintype H] [Fintype V]
    [DecidableEq L] [DecidableEq H] (A : Matrix (L ⊕ H) V (ZMod 5))
    (p : L → V → ZMod 5) (s : H → V → ZMod 5)
    (hp : ∀ i j, A.mulVec (p i) j = if j = .inl i then 1 else 0)
    (hs : ∀ i j, A.mulVec (s i) (.inr j) = if j = i then 1 else 0) :
    Function.Surjective A.mulVec := by
  intro T
  let u : V → ZMod 5 := ∑ i, T (.inr i) • s i
  have hu (j : H) : A.mulVec u (.inr j) = T (.inr j) := by
    simp only [u, Matrix.mulVec_sum, Matrix.mulVec_smul, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul, hs, mul_ite, mul_zero, mul_one,
      Finset.sum_ite_eq, Finset.mem_univ, if_true]
  let w : V → ZMod 5 := ∑ i, (T (.inl i) - A.mulVec u (.inl i)) • p i
  refine ⟨u+w, ?_⟩
  funext j
  rw [Matrix.mulVec_add, Pi.add_apply]
  cases j with
  | inl i =>
      simp only [w, Matrix.mulVec_sum, Matrix.mulVec_smul, Finset.sum_apply,
        Pi.smul_apply, smul_eq_mul, hp, Sum.inl.injEq, mul_ite, mul_zero, mul_one,
        Finset.sum_ite_eq, Finset.mem_univ, if_true]
      ring
  | inr i =>
      simp [w, hu, Matrix.mulVec_sum, Matrix.mulVec_smul, Finset.sum_apply, hp]

private theorem complexLift {I V : Type*} [Fintype I] [Fintype V] [DecidableEq I]
    (A : Matrix I V ℤ) (hs : Function.Surjective (A.map (fun z : ℤ => (z : ZMod 5))).mulVec) :
    Function.Surjective (A.map (fun z : ℤ => (z : ℂ))).mulVec := by
  let e (i : I) (j : I) : ZMod 5 := if j = i then 1 else 0
  choose b hb using fun i => hs (e i)
  let B : Matrix V I ℤ := Matrix.of fun v i => ((b i v).val : ℤ)
  have hmod : (A * B).map (fun z : ℤ => (z : ZMod 5)) = 1 := by
    ext i j
    simp only [Matrix.map_apply, Matrix.mul_apply, Int.cast_sum, Int.cast_mul, B,
      Matrix.of_apply, Int.cast_natCast, ZMod.natCast_zmod_val, Matrix.one_apply]
    exact congrFun (hb j) i
  have hdet : ((A * B).det : ZMod 5) = 1 := by
    rw [Int.cast_det, hmod, Matrix.det_one]
  have hInt : (A * B).det ≠ 0 := by
    intro h
    rw [h, Int.cast_zero] at hdet
    exact (by decide : (0 : ZMod 5) ≠ 1) hdet
  let AC := A.map fun z : ℤ => (z : ℂ)
  let BC := B.map fun z : ℤ => (z : ℂ)
  have hcast : ((A * B).det : ℂ) = (AC * BC).det := by
    rw [Int.cast_det]
    change ((A * B).map (Int.castRingHom ℂ)).det =
      (A.map (Int.castRingHom ℂ) * B.map (Int.castRingHom ℂ)).det
    rw [Matrix.map_mul]
  have hComplex : (AC * BC).det ≠ 0 := by
    rw [← hcast]
    exact Int.cast_ne_zero.mpr hInt
  have hUnit : IsUnit (AC*BC) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hComplex)
  intro T
  obtain ⟨v,hv⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hUnit T
  exact ⟨BC.mulVec v, (Matrix.mulVec_mulVec v AC BC).trans hv⟩

end OMA.TangentRadix

namespace OMA.TangentRadix

open Finset Matrix

abbrev Row := Fin 824 ⊕ Fin 100
abbrev Var := Fin 25 × (Fin 3 ⊕ Fin 14 ⊕ Fin 22)

def rowAxes : Row ≃ Axes :=
  (@finSumFinEquiv 824 100).trans rowIndex.symm

private theorem rowAxes_top (r : Fin 824) : rowIndex (rowAxes (.inl r)) = topRow r := by
  simp [rowAxes, topRow]
  rfl

private theorem rowAxes_tail (r : Fin 100) : rowAxes (.inr r) = rowIndex.symm (tailRow r) := by
  simp [rowAxes, tailRow]
  rfl

def entry (X Y Z : Words) (q : Axes) (j : Var) : ℕ :=
  match j.2 with
  | .inl i => if q.1 = i then yAt Y j.1 q.2.1 * zAt Z j.1 q.2.2 else 0
  | .inr (.inl i) => if q.2.1 = i then xAt X j.1 q.1 * zAt Z j.1 q.2.2 else 0
  | .inr (.inr i) => if q.2.2 = i then xAt X j.1 q.1 * yAt Y j.1 q.2.1 else 0

def mat (X Y Z : Words) : Matrix Row Var ℤ :=
  Matrix.of fun i j => (entry X Y Z (rowAxes i) j : ℤ)

private theorem mat_eval (R : Type*) [CommRing R] (X Y Z : Words)
    (v : Var → R) (r : Row) :
    ((mat X Y Z).map (fun z : ℤ => (z : R))).mulVec v r =
      ∑ t, (v (t,.inl (rowAxes r).1) *
          ((yAt Y t (rowAxes r).2.1 : R) * (zAt Z t (rowAxes r).2.2 : R)) +
        (xAt X t (rowAxes r).1 : R) *
          (v (t,.inr (.inl (rowAxes r).2.1)) * (zAt Z t (rowAxes r).2.2 : R)) +
        (xAt X t (rowAxes r).1 : R) *
          ((yAt Y t (rowAxes r).2.1 : R) * v (t,.inr (.inr (rowAxes r).2.2)))) := by
  simp only [Matrix.mulVec, dotProduct, Fintype.sum_prod_type, Fintype.sum_sum_type]
  apply Finset.sum_congr rfl
  intro t _
  simp only [mat, Matrix.map_apply, Matrix.of_apply, entry, Int.cast_ite, Int.cast_mul, Int.cast_zero, Int.cast_natCast,
    Nat.cast_ite, Nat.cast_mul, Nat.cast_zero, ite_mul, zero_mul, Finset.sum_ite_eq,
    Finset.mem_univ, if_true]
  ring

def asBasis (a : ℕ) (j : Var) : ZMod 5 :=
  match j.2 with
  | .inl i => uAt a j.1 i
  | .inr (.inl i) => vAt a j.1 i
  | .inr (.inr i) => wAt a j.1 i

private theorem basis_eval (X Y Z : Words) (w : ℕ) (r : Row) :
    ((mat X Y Z).map (fun z : ℤ => (z : ZMod 5))).mulVec (asBasis w) r =
      (coefficients (xAt X) (yAt Y) (zAt Z) (uAt w) (vAt w) (wAt w) (rowAxes r) : ZMod 5) := by
  rw [mat_eval]
  simp only [asBasis, coefficients, Nat.cast_sum, Nat.cast_add, Nat.cast_mul, mul_assoc, mul_left_comm]

theorem exactWitness (X Y Z : Words) (pre : Fin 824 → ℕ) (post : Fin 100 → ℕ)
    (hp : ∀ r, flags 924 (fastProduct X Y Z (pre r) 25 + 4*((2:ℕ)^32)^r.val))
    (hs : ∀ r, flags 100 (fastProduct X Y Z (post r) 25 / ((2:ℕ)^32)^824 +
      4*((2:ℕ)^32)^r.val)) :
    ∃ x : Fin 25 → Fin 3 → ℂ, ∃ y : Fin 25 → Fin 14 → ℂ, ∃ z : Fin 25 → Fin 22 → ℂ,
      ∀ T : Fin 3 → Fin 14 → Fin 22 → ℂ, ∃ u : Fin 25 → Fin 3 → ℂ,
        ∃ v : Fin 25 → Fin 14 → ℂ, ∃ w : Fin 25 → Fin 22 → ℂ, ∀ i j k,
          T i j k = ∑ t, (u t i*(y t j*z t k)+x t i*(v t j*z t k)+x t i*(y t j*w t k)) := by
  have pMod (r : Fin 824) (q : Row) :
      ((mat X Y Z).map (fun z : ℤ => (z : ZMod 5))).mulVec (asBasis (pre r)) q =
        if q = .inl r then 1 else 0 := by
    rw [basis_eval, modularBasis X Y Z (topRow r) (pre r) (hp r)]
    have he : rowIndex (rowAxes q) = topRow r ↔ q = .inl r := by
      rw [← rowAxes_top]
      exact ⟨fun h => rowAxes.injective (rowIndex.injective h), fun h => by rw [h]⟩
    simp only [he]
  have sMod (r q : Fin 100) :
      ((mat X Y Z).map (fun z : ℤ => (z : ZMod 5))).mulVec (asBasis (post r)) (.inr q) =
        if q = r then 1 else 0 := by
    rw [basis_eval, rowAxes_tail]
    exact modularSuffix X Y Z r (post r) (hs r) q
  have surj := complexLift (mat X Y Z)
    (solveBlocks _ (asBasis ∘ pre) (asBasis ∘ post) pMod sMod)
  refine ⟨fun t i => (xAt X t i : ℂ), fun t j => (yAt Y t j : ℂ), fun t k => (zAt Z t k : ℂ), ?_⟩
  intro T
  obtain ⟨v,hv⟩ := surj (fun r => T (rowAxes r).1 (rowAxes r).2.1 (rowAxes r).2.2)
  refine ⟨fun t i => v (t,.inl i), fun t j => v (t,.inr (.inl j)), fun t k => v (t,.inr (.inr k)), ?_⟩
  intro i j k
  have h := congrFun hv (rowAxes.symm (i,j,k))
  rw [mat_eval] at h
  simpa only [Equiv.apply_symm_apply] using h.symm

end OMA.TangentRadix

