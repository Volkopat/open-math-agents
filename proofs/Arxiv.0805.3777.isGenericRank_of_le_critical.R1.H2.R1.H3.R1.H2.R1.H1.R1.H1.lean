def nums (a : Array ℕ) : Words := fun i => a[i]!
def preWord (i : ℕ) : ℕ := decompress 975 supportMask prefixWords[i]!
def postWord (i : ℕ) : ℕ := decompress 975 suffixMask suffixWords[i]!

def preCheck (i : ℕ) : Prop :=
  flags 924 (fastProduct (nums X) (nums Y) (nums Z) (preWord i) 25 + 4*((2:ℕ)^32)^i)

def postCheck (i : ℕ) : Prop :=
  flags 100 (fastProduct (nums X) (nums Y) (nums Z) (postWord i) 25 / ((2:ℕ)^32)^824 +
    4*((2:ℕ)^32)^i)

