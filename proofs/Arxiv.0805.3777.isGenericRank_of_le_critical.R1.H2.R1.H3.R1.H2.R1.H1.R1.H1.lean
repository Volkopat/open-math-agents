def decompress : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 0
  | n+1, mask, word =>
      if mask % 2 = 1 then word % 5 + 8 * decompress n (mask / 2) (word / 5)
      else 8 * decompress n (mask / 2) word

