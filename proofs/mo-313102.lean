import OMAStatements.S_mo_313102

/-!
Adapted from @tox5tox5, merged PR #30109 (f5517a75727b30e7587c27286a39a1dcea32d8a4).
The product-range measurability API replaces the original section-by-section range split.

Proof of `OMA.S_mo_313102.main` (MathOverflow 313102): if `G` is generated by finitely many sets
and `(F_t)` is right-continuous, then `t ↦ G ⊗ F_t` is right-continuous. `G` is the σ-algebra of
the membership pattern `τ : Ω₁ → (Fin n → Bool)`, so `G ⊗ H` is the pull-back of `⊤ ⊗ H` under
`τ × id`. On `(Fin n → Bool) × Ω₂` a set is `⊤ ⊗ H`-measurable iff all its sections are in `H`; a
set in every `G ⊗ F_u` (`u > t`) has image whose sections lie in every `F_u`, hence in `F_t`.
-/

namespace OMA.P_mo_313102

open MeasureTheory OMA.S_mo_313102 Classical
open scoped NNReal

variable {Ω₁ Ω₂ : Type} {n : ℕ}

/-- The pattern of memberships of `ω` in the generating sets. -/
noncomputable def τ (s : Fin n → Set Ω₁) (ω : Ω₁) : Fin n → Bool := fun i => decide (ω ∈ s i)

lemma measurableSet_preimage_singleton (s : Fin n → Set Ω₁) (b : Fin n → Bool) :
    MeasurableSet[MeasurableSpace.generateFrom (Set.range s)] (τ s ⁻¹' {b}) := by
  have : τ s ⁻¹' {b} = ⋂ i, {ω | decide (ω ∈ s i) = b i} := by
    ext ω; simp [τ, funext_iff]
  rw [this]
  refine MeasurableSet.iInter fun i => ?_
  have hi : MeasurableSet[MeasurableSpace.generateFrom (Set.range s)] (s i) :=
    MeasurableSpace.measurableSet_generateFrom ⟨i, rfl⟩
  cases h : b i
  · have : {ω | decide (ω ∈ s i) = false} = (s i)ᶜ := by ext ω; simp
    rw [this]; exact hi.compl
  · have : {ω | decide (ω ∈ s i) = true} = s i := by ext ω; simp
    rw [this]; exact hi

/-- A finitely generated σ-algebra is the σ-algebra generated by the membership pattern. -/
lemma generateFrom_eq_comap (s : Fin n → Set Ω₁) :
    MeasurableSpace.generateFrom (Set.range s) = (⊤ : MeasurableSpace (Fin n → Bool)).comap (τ s) := by
  apply le_antisymm
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨i, rfl⟩
    exact ⟨{b | b i = true}, trivial, by ext ω; simp [τ]⟩
  · rintro t ⟨B, -, rfl⟩
    have : τ s ⁻¹' B = ⋃ b ∈ B, τ s ⁻¹' {b} := by ext ω; simp
    rw [this]
    exact MeasurableSet.biUnion B.to_countable fun b _ => measurableSet_preimage_singleton s b

/-- The product with a pulled-back σ-algebra is a pull-back of a product. -/
lemma prodSigma_comap (f : Ω₁ → Fin n → Bool) (H : MeasurableSpace Ω₂) :
    prodSigma ((⊤ : MeasurableSpace (Fin n → Bool)).comap f) H =
      (prodSigma (⊤ : MeasurableSpace (Fin n → Bool)) H).comap (Prod.map f id) := by
  simp only [prodSigma, MeasurableSpace.comap_sup, MeasurableSpace.comap_comp]
  rfl

/-- On a product whose first factor is finite and discrete, measurability is checked on sections. -/
lemma measurableSet_prodSigma_iff (H : MeasurableSpace Ω₂) (B : Set ((Fin n → Bool) × Ω₂)) :
    MeasurableSet[prodSigma (⊤ : MeasurableSpace (Fin n → Bool)) H] B ↔
      ∀ b, MeasurableSet[H] (Prod.mk b ⁻¹' B) := by
  let _ : MeasurableSpace (Fin n → Bool) := ⊤
  let _ : MeasurableSpace Ω₂ := H
  constructor
  · intro hB b
    exact measurable_prodMk_left hB
  · intro h
    have : B = ⋃ b, ({b} : Set (Fin n → Bool)) ×ˢ (Prod.mk b ⁻¹' B) := by
      ext ⟨b, y⟩; simp
    rw [this]
    exact MeasurableSet.iUnion fun b => (MeasurableSet.prod trivial (h b))

theorem solution :
    ∀ (Ω₁ Ω₂ : Type) (n : ℕ) (s : Fin n → Set Ω₁) (F : ℝ≥0 → MeasurableSpace Ω₂),
      Monotone F → (∀ t, F t = ⨅ u > t, F u) →
        let G : MeasurableSpace Ω₁ := MeasurableSpace.generateFrom (Set.range s)
        ∀ t, prodSigma G (F t) = ⨅ u > t, prodSigma G (F u) := by
  intro Ω₁ Ω₂ n s F hmono hrc G t
  simp only [G, generateFrom_eq_comap, prodSigma_comap]
  apply le_antisymm
  · refine le_iInf₂ fun u hu => MeasurableSpace.comap_mono ?_
    exact sup_le_sup le_rfl (MeasurableSpace.comap_mono (hmono hu.le))
  · intro E hE
    simp only [MeasurableSpace.measurableSet_iInf] at hE
    have hE' : ∀ u > t, ∃ B, MeasurableSet[prodSigma ⊤ (F u)] B ∧ Prod.map (τ s) id ⁻¹' B = E :=
      fun u hu => hE u hu
    obtain ⟨B₀, -, hB₀⟩ := hE' (t + 1) (by simp)
    refine ⟨Prod.map (τ s) id '' E, ?_, ?_⟩
    · rw [measurableSet_prodSigma_iff]
      intro b
      rw [hrc t, MeasurableSpace.measurableSet_iInf]
      intro u
      rw [MeasurableSpace.measurableSet_iInf]
      intro hu
      obtain ⟨B, hB, hBE⟩ := hE' u hu
      rw [← hBE, Set.image_preimage_eq_inter_range]
      have hR : MeasurableSet[prodSigma ⊤ (F u)] (Set.range (Prod.map (τ s) id)) := by
        rw [Set.range_prodMap, Set.range_id]
        exact @MeasurableSet.prod _ _ ⊤ (F u) _ _ trivial MeasurableSet.univ
      exact (measurableSet_prodSigma_iff (F u) _).mp (hB.inter hR) b
    · rw [← hB₀, Set.preimage_image_preimage]

end OMA.P_mo_313102

theorem OMA.solution : type_of% @OMA.S_mo_313102.main := OMA.P_mo_313102.solution
