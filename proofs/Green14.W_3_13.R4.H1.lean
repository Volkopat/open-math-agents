import OMAReductions.R_Green14_W_3_13_R4

/-! Refute both palindromic coloring instances with kernel-checked search trees.
The tree checker is adapted from ChaloupeMusic's W(3,14) proof in pull request 16761.
The search trees were generated for the 143- and 156-position instances. -/

namespace OMA.Palindromic13

def len (col : Bool) : ℕ := if col then 2 else 12

def fold (n x : ℕ) : ℕ := if 2 * x < n then x else n - 1 - x

def covered (n : ℕ) (col : Bool) (a d mask skip : ℕ) : Bool :=
  decide (0 < d) && decide (a + len col * d < n) &&
  (List.range (len col + 1)).all fun t =>
    Nat.beq (fold n (a + t * d)) skip || mask.testBit (fold n (a + t * d))

def pick (col : Bool) (R B : ℕ) : ℕ := if col then R else B

structure Stream where
  cur : ℕ
  rest : List ℕ

def next (s : Stream) : ℕ × Stream :=
  if Nat.beq s.cur 1 then
    match s.rest with
    | [] => (0, s)
    | x :: xs => (x % 524288, ⟨x / 524288, xs⟩)
  else (s.cur % 524288, ⟨s.cur / 524288, s.rest⟩)

def findFree (n a d mask : ℕ) : ℕ → ℕ
  | 0 => fold n a
  | t + 1 =>
    if mask.testBit (fold n (a + (t + 1) * d)) then findFree n a d mask t
    else fold n (a + (t + 1) * d)

def check (n : ℕ) (H : List (ℕ × ℕ)) : ℕ → ℕ → ℕ → Stream → Option Stream
  | 0 => fun _ _ _ => none
  | f + 1 => fun R B s =>
    let tk := (next s).1
    let s' := (next s).2
    let x := tk / 4
    let col := Nat.beq (x % 2) 1
    let a := x / 2 % 256
    let d := x / 512
    if tk % 4 = 3 then
      if H.any (fun p => Nat.beq p.1 R && Nat.beq p.2 B) then some s' else none
    else if tk % 4 = 0 then
      if covered n col a d (pick col R B) n then some s' else none
    else if tk % 4 = 1 then
      let w := findFree n a d (pick col R B) (len col)
      if covered n col a d (pick col R B) w then
        if col then check n H f R (B ||| 2 ^ w) s' else check n H f (R ||| 2 ^ w) B s'
      else none
    else
      match check n H f (R ||| 2 ^ x) B s' with
      | some s'' => check n H f R (B ||| 2 ^ x) s''
      | none => none

def Agrees (c : ℕ → Bool) (mask : ℕ) (val : Bool) : Prop :=
  ∀ i, mask.testBit i = true → c i = val

lemma agrees_add {c : ℕ → Bool} {mask w : ℕ} {val : Bool} (h : Agrees c mask val)
    (hw : c w = val) : Agrees c (mask ||| 2 ^ w) val := by
  intro i hi
  rw [Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq] at hi
  rcases hi with hi | rfl
  · exact h i hi
  · exact hw

def Free (n : ℕ) (c : ℕ → Bool) : Prop :=
  ∀ (col : Bool) (a d : ℕ), 0 < d → a + len col * d < n →
    ¬ ∀ t ≤ len col, c (fold n (a + t * d)) = col

def Goal (n R B : ℕ) : Prop :=
  ∀ c : ℕ → Bool, Free n c → Agrees c R true → Agrees c B false → False

lemma covered_false {n : ℕ} {c : ℕ → Bool} (hf : Free n c) {col : Bool} {a d R B skip : ℕ}
    (h : covered n col a d (pick col R B) skip = true)
    (hR : Agrees c R true) (hB : Agrees c B false)
    (hs : (∃ t ≤ len col, fold n (a + t * d) = skip) → c skip = col) : False := by
  unfold covered at h
  rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq,
    List.all_eq_true] at h
  obtain ⟨⟨hd, hb⟩, hall⟩ := h
  refine hf col a d hd hb (fun t ht => ?_)
  have h1 := hall t (List.mem_range.mpr (by omega))
  rw [Bool.or_eq_true] at h1
  rcases h1 with h1 | h1
  · have e := Nat.eq_of_beq_eq_true h1
    rw [e]
    exact hs ⟨t, ht, e⟩
  · cases col
    · exact hB _ h1
    · exact hR _ h1

lemma sound {n : ℕ} {c : ℕ → Bool} (hf : Free n c) (H : List (ℕ × ℕ))
    (hH : ∀ p ∈ H, Goal n p.1 p.2) :
    ∀ (f R B : ℕ) (s s' : Stream), check n H f R B s = some s' → Agrees c R true →
      Agrees c B false → False := by
  intro f
  induction f with
  | zero => intro R B s s' h; cases h
  | succ f ih =>
    intro R B s s' h hR hB
    simp only [check] at h
    generalize (next s).1 = tk at h
    generalize (next s).2 = s1 at h
    generalize Nat.beq (tk / 4 % 2) 1 = col at h
    generalize tk / 4 / 2 % 256 = a at h
    generalize tk / 4 / 512 = d at h
    by_cases h3 : tk % 4 = 3
    · rw [if_pos h3] at h
      split at h
      · rename_i hany
        obtain ⟨p, hp, he⟩ := List.any_eq_true.mp hany
        rw [Bool.and_eq_true] at he
        have e1 := Nat.eq_of_beq_eq_true he.1
        have e2 := Nat.eq_of_beq_eq_true he.2
        exact hH p hp c hf (e1 ▸ hR) (e2 ▸ hB)
      · cases h
    rw [if_neg h3] at h
    by_cases h0 : tk % 4 = 0
    · rw [if_pos h0] at h
      split at h
      · rename_i hcov
        refine covered_false hf hcov hR hB (fun ⟨t, ht, e⟩ => ?_)
        exfalso
        unfold covered at hcov
        rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at hcov
        have hb := hcov.1.2
        have : t * d ≤ len col * d := Nat.mul_le_mul_right d ht
        unfold fold at e
        split at e <;> omega
      · cases h
    rw [if_neg h0] at h
    by_cases h1 : tk % 4 = 1
    · rw [if_pos h1] at h
      split at h
      · rename_i hcov
        generalize findFree n a d (pick col R B) (len col) = w at h hcov
        have hw : c w = !col := by
          by_contra hne
          have : c w = col := by
            revert hne
            cases c w <;> cases col <;> simp
          exact covered_false hf hcov hR hB (fun _ => this)
        cases col
        · exact ih _ _ _ _ h (agrees_add hR hw) hB
        · exact ih _ _ _ _ h hR (agrees_add hB hw)
      · cases h
    rw [if_neg h1] at h
    split at h
    · rename_i s2 e2
      cases hv : c (tk / 4)
      · exact ih _ _ _ _ h hR (agrees_add hB hv)
      · exact ih _ _ _ _ e2 (agrees_add hR hv) hB
    · cases h

lemma zero_agrees (c : ℕ → Bool) (val : Bool) : Agrees c 0 val := by
  intro i hi
  rw [Nat.zero_testBit] at hi
  cases hi

lemma of_check {n R B f : ℕ} {s : Stream} (H : List (ℕ × ℕ))
    (hH : ∀ p ∈ H, Goal n p.1 p.2) (hp : (check n H f R B s).isSome = true) : Goal n R B := by
  intro c hf hR hB
  obtain ⟨s', hs⟩ := Option.isSome_iff_exists.mp hp
  exact sound hf H hH _ _ _ _ _ hs hR hB

lemma none_proved (n : ℕ) : ∀ p ∈ ([] : List (ℕ × ℕ)), Goal n p.1 p.2 :=
  fun _ hp => by cases hp

lemma palin {n : ℕ} (hp : Goal n 0 0) (c : ℕ → Bool) (sym : ∀ x < n, c (n - 1 - x) = c x) :
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 2 else 12) * d < n ∧
      ∀ t ≤ (if b then 2 else 12), c (a + t * d) = b := by
  by_contra hno
  have hf : Free n c := by
    intro col a d hd hb hall
    refine hno ⟨col, a, d, hd, hb, fun t ht => ?_⟩
    have h1 := hall t ht
    have : t * d ≤ len col * d := Nat.mul_le_mul_right d ht
    have hx : a + t * d < n := by omega
    unfold fold at h1
    split at h1
    · exact h1
    · rwa [sym _ hx] at h1
  exact hp c hf (zero_agrees c true) (zero_agrees c false)

