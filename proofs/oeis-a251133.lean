  decide +kernel

theorem cntL_2 : ∀ a < 3 ^ 5, a / 96 = 2 → ∀ c < 69,
    ((mem c).filter (fun x => ok (dec a) ∧ compat (dec a) (dec x))).length = Mt (cls (dec a)) c := by
  decide +kernel

theorem chunk_lt : ∀ a < 3 ^ 5, a / 96 < 3 := by decide +kernel

theorem cntL (a : ℕ) (ha : a < 3 ^ 5) : ∀ c < 69,
    ((mem c).filter (fun x => ok (dec a) ∧ compat (dec a) (dec x))).length = Mt (cls (dec a)) c := by
  have h := chunk_lt a ha
  generalize hq : a / 96 = q at h
  interval_cases q
  · exact cntL_0 a ha hq
  · exact cntL_1 a ha hq
  · exact cntL_2 a ha hq

theorem cnt (s : R) (c : ℕ) (hc : c < 69) :
    (Finset.univ.filter (fun t : R => cls t = c ∧ (ok s ∧ compat s t))).card = Mt (cls s) c := by
  rw [card_cls c hc (fun t => ok s ∧ compat s t)]
  have h := cntL (E s : ℕ) (E s).isLt c hc
  rw [dec_E] at h
  exact h


