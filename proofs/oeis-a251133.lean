/-- The line with digit code x. -/
def dec (x : ℕ) : R := fun i => ⟨x / 3 ^ (i : ℕ) % 3, Nat.mod_lt _ (by norm_num)⟩

theorem E_symm (a : Fin (3 ^ 5)) : E.symm a = dec a := by
