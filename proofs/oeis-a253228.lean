  have h := (row_ok (pc r s) (pc_lt r s)).2.2.1
  unfold step2 at h
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11⟩ := pc_digits r s
  rw [e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, pc_mod] at h
  rw [Bool.cond_eq_ite] at h
  simp only [Q_iff]
