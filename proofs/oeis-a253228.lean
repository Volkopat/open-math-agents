def relB (c : ℕ) : Bool := (bif QB (c / 64 / 32 % 2) (c / 64 / 16 % 2) (c / 64 / 8 % 2) (c / 64 / 4 % 2) (c / 64 / 2 % 2) (c / 64 % 2) (c % 64 / 32 % 2) (c % 64 / 16 % 2) (c % 64 / 8 % 2) (c % 64 / 4 % 2) (c % 64 / 2 % 2) (c % 64 % 2) then ((Tl (c / 64 / 32 % 2) (c / 64 / 16 % 2) (c / 64 / 8 % 2) (c / 64 / 4 % 2) (c / 64 / 2 % 2) (c / 64 % 2) (c % 64 / 32 % 2) (c % 64 / 16 % 2) (c % 64 / 8 % 2) (c % 64 / 4 % 2) (c % 64 / 2 % 2) (c % 64 % 2)).map (fun t => tab7 ((c % 64) * 64 + t))).sum else 0) + 9 * tab6 c + 2 * tab4 c == 5 * tab7 c + 7 * tab5 c

def rowB (c : ℕ) : Bool := step0 c && step1 c && step2 c && step3 c && step4 c && step5 c && step6 c && step7 c && relB c

