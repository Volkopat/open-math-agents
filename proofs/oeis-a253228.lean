def allB : Bool := (Ts (fun x => Ts (fun y => tab0 (x * 64 + y))) == 907) && (Ts (fun x => Ts (fun y => tab1 (x * 64 + y))) == 1775) && (Ts (fun x => Ts (fun y => tab2 (x * 64 + y))) == 1709) && (Ts (fun x => Ts (fun y => tab3 (x * 64 + y))) == 2543) && (Ts (fun x => Ts (fun y => tab4 (x * 64 + y))) == 3936) && (Ts (fun x => Ts (fun y => tab5 (x * 64 + y))) == 6414) && (Ts (fun x => Ts (fun y => tab6 (x * 64 + y))) == 11022) && (Ts (fun x => Ts (fun y => tab7 (x * 64 + y))) == 19851)

lemma all_ok : allB = true := by
  decide +kernel

lemma all_parts : (Ts (fun x => Ts (fun y => tab0 (x * 64 + y))) == 907) = true ∧ (Ts (fun x => Ts (fun y => tab1 (x * 64 + y))) == 1775) = true ∧ (Ts (fun x => Ts (fun y => tab2 (x * 64 + y))) == 1709) = true ∧ (Ts (fun x => Ts (fun y => tab3 (x * 64 + y))) == 2543) = true ∧ (Ts (fun x => Ts (fun y => tab4 (x * 64 + y))) == 3936) = true ∧ (Ts (fun x => Ts (fun y => tab5 (x * 64 + y))) == 6414) = true ∧ (Ts (fun x => Ts (fun y => tab6 (x * 64 + y))) == 11022) = true ∧ (Ts (fun x => Ts (fun y => tab7 (x * 64 + y))) == 19851) = true := by
  have h := all_ok
  unfold allB at h
  simp only [Bool.and_eq_true] at h
  exact ⟨h.1.1.1.1.1.1.1, h.1.1.1.1.1.1.2, h.1.1.1.1.1.2, h.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

lemma row_ok (c : ℕ) (hc : c < 4096) : step0 c = true ∧ step1 c = true ∧ step2 c = true ∧ step3 c = true ∧ step4 c = true ∧ step5 c = true ∧ step6 c = true ∧ step7 c = true ∧ relB c = true := by
  have h : rowB c = true := by
    by_cases h0 : c < 512
    · exact List.all_eq_true.mp chunk0_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h1 : c < 1024
    · exact List.all_eq_true.mp chunk1_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h2 : c < 1536
    · exact List.all_eq_true.mp chunk2_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h3 : c < 2048
    · exact List.all_eq_true.mp chunk3_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h4 : c < 2560
    · exact List.all_eq_true.mp chunk4_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h5 : c < 3072
    · exact List.all_eq_true.mp chunk5_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h6 : c < 3584
    · exact List.all_eq_true.mp chunk6_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    by_cases h7 : c < 4096
    · exact List.all_eq_true.mp chunk7_ok c (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    omega
  unfold rowB at h
  simp only [Bool.and_eq_true] at h
  exact ⟨h.1.1.1.1.1.1.1.1, h.1.1.1.1.1.1.1.2, h.1.1.1.1.1.1.2, h.1.1.1.1.1.2, h.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

lemma pc_digits (r s : Row) :
    (pc r s / 64 / 32 % 2) = (r 0).val ∧ (pc r s / 64 / 16 % 2) = (r 1).val ∧ (pc r s / 64 / 8 % 2) = (r 2).val ∧ (pc r s / 64 / 4 % 2) = (r 3).val ∧ (pc r s / 64 / 2 % 2) = (r 4).val ∧ (pc r s / 64 % 2) = (r 5).val ∧ (pc r s % 64 / 32 % 2) = (s 0).val ∧ (pc r s % 64 / 16 % 2) = (s 1).val ∧ (pc r s % 64 / 8 % 2) = (s 2).val ∧ (pc r s % 64 / 4 % 2) = (s 3).val ∧ (pc r s % 64 / 2 % 2) = (s 4).val ∧ (pc r s % 64 % 2) = (s 5).val := by
  rw [pc_div, pc_mod]
  exact ⟨dig0 r, dig1 r, dig2 r, dig3 r, dig4 r, dig5 r, dig0 s, dig1 s, dig2 s, dig3 s, dig4 s, dig5 s⟩

lemma W0f (r s : Row) : W 0 r s = t0 r s := by
  rw [W_zero]
  have h := (row_ok (pc r s) (pc_lt r s)).1
  unfold step0 at h
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11⟩ := pc_digits r s
  rw [e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11] at h
  rw [Bool.cond_eq_ite] at h
  simp only [Q_iff]
  exact (beq_iff_eq.mp h).symm

lemma W1f (r s : Row) : W 1 r s = t1 r s := by
  rw [W_succ]
  simp only [W0f, t0, pc]
  rw [bridge (fun t => tab0 (code s * 64 + t)) r s, Tn_list]
  have h := (row_ok (pc r s) (pc_lt r s)).2.1
  unfold step1 at h
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11⟩ := pc_digits r s
  rw [e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, pc_mod] at h
  rw [Bool.cond_eq_ite] at h
  simp only [Q_iff]
  exact (beq_iff_eq.mp h).symm

