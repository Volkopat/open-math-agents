  unfold Tn Tl sumK catK
  simp only [List.map_append, List.sum_append, N1_list]

lemma bridge (g : ℕ → ℕ) (r s : Row) :
    (∑ t : Row, if Ttrip r s t then g (code t) else 0) = Tn g (r 0).val (r 1).val (r 2).val (r 3).val (r 4).val (r 5).val (s 0).val (s 1).val (s 2).val (s 3).val (s 4).val (s 5).val := by
  rw [sum_row]
  simp only [Ttrip_explicit, V2_iff, code, Matrix.cons_val, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.tail_cons, Matrix.cons_val_succ]
  simp only [ite_and, Finset.sum_ite_irrel, Finset.sum_const_zero]
  unfold Tn N1 N2 N3 N4 N5
  simp only [Bool.cond_eq_ite, ← sumK_fin]

/-- The code of a pair of rows. -/
def pc (r s : Row) : ℕ := code r * 64 + code s

lemma pc_lt (r s : Row) : pc r s < 4096 := by
  unfold pc; have := code_lt r; have := code_lt s; nlinarith

lemma pc_div (r s : Row) : pc r s / 64 = code r := by
  unfold pc; have := code_lt s; omega

lemma pc_mod (r s : Row) : pc r s % 64 = code s := by
  unfold pc; have := code_lt s; omega

lemma total2 (g : ℕ → ℕ) :
    (∑ r : Row, ∑ s : Row, g (code r * 64 + code s)) = Ts (fun x => Ts (fun y => g (x * 64 + y))) := by
  have h : ∀ r : Row, (∑ s : Row, g (code r * 64 + code s)) = Ts (fun y => g (code r * 64 + y)) :=
    fun r => total (fun y => g (code r * 64 + y))
  simp only [h]
  exact total (fun x => Ts (fun y => g (x * 64 + y)))

