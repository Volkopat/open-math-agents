/-- The sum of g over the codes of the rows t with T r s t. -/
def Tn (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) : ℕ := sumK (fun x => N1 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 0 x x)

/-- The codes of the rows t with T r s t. -/
def Tl (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) : List ℕ := catK (fun x => M1 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 0 x x)

