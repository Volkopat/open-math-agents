import Mathlib

/-! The base clauses encode avoidance of a monochromatic quadruple. For each listed key an additional clause asks the crossing-edge assignment to differ from that key on at least one of its 56 bits. Kernel-checked resolution derives an empty clause from their conjunction. -/



namespace RamseyBridge

def edgeCode (a b : ℕ) (i j : Fin 16) : Sum Bool ℕ :=
  let u := i.val
  let v := j.val
  if v=15 then .inl (decide (u<7))
  else if v<7 then .inl (a.testBit (v*(v-1)/2+u))
  else if u<7 then .inr (8*u+(v-7))
  else .inl (!(b.testBit ((v-7)*(v-8)/2+(u-7))))

def paint (key : ℕ) : Sum Bool ℕ → Bool
  | .inl b => b
  | .inr v => key.testBit v

def quadEdges (a b : ℕ) (i j k l : Fin 16) : List (Sum Bool ℕ) :=
  [edgeCode a b i j, edgeCode a b i k, edgeCode a b i l,
   edgeCode a b j k, edgeCode a b j l, edgeCode a b k l]

def selectClause (sign : Bool) (es : List (Sum Bool ℕ)) : List (List (ℕ × Bool)) :=
  if es.any (fun e => match e with | .inl val => val == sign | .inr _ => false) then [] else
    [es.filterMap fun e => match e with | .inl _ => none | .inr v => some (v,sign)]

def ramseyCNF (a b : ℕ) : List (List (ℕ × Bool)) :=
  let vs := List.finRange 16
  vs.flatMap fun i => (vs.filter (i < ·)).flatMap fun j =>
    (vs.filter (j < ·)).flatMap fun k => (vs.filter (k < ·)).flatMap fun l =>
      [true,false].flatMap fun sign => selectClause sign (quadEdges a b i j k l)

lemma selectedSound (key : ℕ) (sign : Bool) (es : List (Sum Bool ℕ))
    (h : ∃ e ∈ es, paint key e = sign) :
    ∀ cl ∈ selectClause sign es, ∃ lit ∈ cl, key.testBit lit.1 = lit.2 := by
  intro cl hcl
  unfold selectClause at hcl
  split at hcl
  · simp at hcl
  · rename_i hn
    simp only [List.mem_singleton] at hcl
    subst cl
    obtain ⟨r | v, he, hp⟩ := h
    · change r = sign at hp
      subst r
      exact False.elim (hn (List.any_eq_true.mpr ⟨.inl sign, he, by simp⟩))
    · exact ⟨(v,sign), List.mem_filterMap.mpr ⟨Sum.inr v, he, rfl⟩, hp⟩

lemma paint_edge (a b key : ℕ) (i j : Fin 16) :
    paint key (edgeCode a b i j) =
      (if j.val=15 then decide (i.val<7)
       else if j.val<7 then a.testBit (j.val*(j.val-1)/2+i.val)
       else if i.val<7 then key.testBit (8*i.val+(j.val-7))
       else !(b.testBit ((j.val-7)*(j.val-8)/2+(i.val-7)))) := by
  unfold edgeCode
  dsimp only
  split <;> first | rfl | split <;> first | rfl | split <;> rfl

lemma cnfSound (a b key : ℕ)
    (h : ∀ i j k l : Fin 16, i<j → j<k → k<l →
      let E := fun (i j : Fin 16) => paint key (edgeCode a b i j)
      ¬(E i j = E i k ∧ E i j = E i l ∧ E i j = E j k ∧
        E i j = E j l ∧ E i j = E k l)) :
    ∀ cl ∈ ramseyCNF a b, ∃ lit ∈ cl, key.testBit lit.1 = lit.2 := by
  intro cl hcl
  unfold ramseyCNF at hcl
  simp only [List.mem_flatMap, List.mem_filter, decide_eq_true_eq] at hcl
  obtain ⟨i, _, j, ⟨_, hij⟩, k, ⟨_, hjk⟩, l, ⟨_, hkl⟩, s, _, hcl⟩ := hcl
  apply selectedSound key s _ _ cl hcl
  by_contra! h0
  have hsame (e) (he : e ∈ quadEdges a b i j k l) : paint key e = !s := by
    have hh := h0 e he
    cases s <;> cases hbit : paint key e <;> simp_all
  apply h i j k l hij hjk hkl
  dsimp only
  have h1 := hsame _ (by simp [quadEdges] : edgeCode a b i j ∈ _)
  have h2 := hsame _ (by simp [quadEdges] : edgeCode a b i k ∈ _)
  have h3 := hsame _ (by simp [quadEdges] : edgeCode a b i l ∈ _)
  have h4 := hsame _ (by simp [quadEdges] : edgeCode a b j k ∈ _)
  have h5 := hsame _ (by simp [quadEdges] : edgeCode a b j l ∈ _)
  have h6 := hsame _ (by simp [quadEdges] : edgeCode a b k l ∈ _)
  exact ⟨h1.trans h2.symm, h1.trans h3.symm, h1.trans h4.symm, h1.trans h5.symm, h1.trans h6.symm⟩

end RamseyBridge

namespace RamseyBridge

lemma cnfSoundRaw (a b key : ℕ)
    (h : let E (i j : Fin 16) : Bool :=
           let u := i.val
           let v := j.val
           if v=15 then decide (u<7)
           else if v<7 then a.testBit (v*(v-1)/2+u)
           else if u<7 then key.testBit (8*u+(v-7))
           else !(b.testBit ((v-7)*(v-8)/2+(u-7)))
         ∀ i j k l : Fin 16, i<j → j<k → k<l →
           ¬(E i j = E i k ∧ E i j = E i l ∧ E i j = E j k ∧
             E i j = E j l ∧ E i j = E k l)) :
    ∀ cl ∈ ramseyCNF a b, ∃ lit ∈ cl, key.testBit lit.1 = lit.2 := by
  apply cnfSound
  simpa only [paint_edge] using h

end RamseyBridge
namespace RamseyBridge

def blocking (x : Nat) : List (Nat × Bool) :=
  (List.range 56).map fun v => (v, !x.testBit v)

def extended (a b : Nat) (keys : List Nat) : List (List (Nat × Bool)) :=
  ramseyCNF a b ++ keys.map blocking

lemma blocking_sound (key x : Nat) (hkey : key < 2^56) (hx : x < 2^56)
    (hdiff : key ≠ x) : ∃ lit ∈ blocking x, key.testBit lit.1 = lit.2 := by
  have mismatch : ∃ i < 56, key.testBit i ≠ x.testBit i := by
    by_contra! h
    apply hdiff
    apply Nat.eq_of_testBit_eq
    intro i
    by_cases hi : i < 56
    · exact h i hi
    · have bound : (2:Nat)^56 ≤ 2^i := Nat.pow_le_pow_right (by decide) (by omega)
      rw [Nat.testBit_lt_two_pow (hkey.trans_le bound), Nat.testBit_lt_two_pow (hx.trans_le bound)]
  obtain ⟨i, hi, hne⟩ := mismatch
  refine ⟨(i, !x.testBit i), List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩, ?_⟩
  change key.testBit i = !x.testBit i
  cases hk : key.testBit i <;> cases hx' : x.testBit i <;> simp_all

lemma extended_sound (a b key : Nat) (keys : List Nat) (hkey : key < 2^56)
    (hkeys : ∀ x ∈ keys, x < 2^56) (hnot : key ∉ keys)
    (hs : ∀ cl ∈ ramseyCNF a b, ∃ lit ∈ cl, key.testBit lit.1 = lit.2) :
    ∀ cl ∈ extended a b keys, ∃ lit ∈ cl, key.testBit lit.1 = lit.2 := by
  intro cl hc
  rcases List.mem_append.mp hc with hc | hc
  · exact hs cl hc
  · obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hc
    exact blocking_sound key x hkey (hkeys x hx) (fun eq => hnot (eq ▸ hx))

end RamseyBridge

namespace RamseyTables

/-- Leaves hold eight entries. A mask entry is two 56-bit literal sets.
For variable-width entries, slot j in ends holds the bit offset of the end
of entry j in data. Each offset fits in 16 bits. -/
inductive Table where
  | fixed (data : Nat)
  | signed (data : Nat)
  | packed (ends data : Nat)
  | node (even odd : Table)

def Table.getBlock : Table → Nat → Nat → Nat
  | .fixed data, slot, block =>
    if block = 0 then (data >>> (112*slot)) &&& ((1 <<< 112)-1) else 0
  | .signed data, slot, block =>
    if block = 0 then
      let x := (data >>> (57*slot)) &&& ((1 <<< 57)-1)
      if x%2 = 0 then x/2 else (x/2) <<< 56
    else 0
  | .packed ends data, slot, block =>
    if block = 0 then
      let lo := if slot = 0 then 0 else (ends >>> (16*(slot-1))) &&& 65535
      let hi := (ends >>> (16*slot)) &&& 65535
      (data >>> lo) &&& ((1 <<< (hi-lo))-1)
    else 0
  | .node even odd, slot, block =>
    if block % 2 = 0 then even.getBlock slot (block/2) else odd.getBlock slot (block/2)

def Table.get (table : Table) (i : Nat) : Nat :=
  table.getBlock (i%8) (i/8)

end RamseyTables


namespace RamseyResolve
abbrev Masks := Nat × Nat
def Holds (key : Nat) (c : Masks) : Prop :=
  ∃ i, (c.1.testBit i = true ∧ key.testBit i = true) ∨ (c.2.testBit i = true ∧ key.testBit i = false)

def clear (m p : Nat) := m ^^^ (m &&& (1 <<< p))
def cutAt (p : Nat) (a b : Masks) : Masks :=
  (clear a.1 p ||| b.1, a.2 ||| clear b.2 p)
private theorem clear_other {m p i : Nat} (h : p ≠ i) :
    (clear m p).testBit i = m.testBit i := by
  simp [clear, Nat.one_shiftLeft, h]
private theorem cut_sound (p key : Nat) (a b : Masks)
    (ha : Holds key a) (hb : Holds key b) : Holds key (cutAt p a b) := by
  cases hp : key.testBit p with
  | false =>
    obtain ⟨i, ⟨hm,hk⟩ | ⟨hm,hk⟩⟩ := ha
    · have hn : p ≠ i := by rintro rfl; simp_all
      exact ⟨i, Or.inl ⟨by simp [cutAt, clear_other hn, hm], hk⟩⟩
    · exact ⟨i, Or.inr ⟨by simp [cutAt, hm], hk⟩⟩
  | true =>
    obtain ⟨i, ⟨hm,hk⟩ | ⟨hm,hk⟩⟩ := hb
    · exact ⟨i, Or.inl ⟨by simp [cutAt, hm], hk⟩⟩
    · have hn : p ≠ i := by rintro rfl; simp_all
      exact ⟨i, Or.inr ⟨by simp [cutAt, clear_other hn, hm], hk⟩⟩
/-- Resolve in the orientation supplied by the common positive and negative bits. -/
def resolve (a b : Masks) : Masks :=
  let common := a.1 &&& b.2
  if common = 0 then cutAt (a.2 &&& b.1).log2 b a
  else cutAt common.log2 a b
theorem resolve_sound {key : Nat} {a b : Masks}
    (ha : Holds key a) (hb : Holds key b) : Holds key (resolve a b) := by
  unfold resolve
  dsimp only
  split
  · exact cut_sound _ _ _ _ hb ha
  · exact cut_sound _ _ _ _ ha hb

def decode (bits code : Nat) : List Nat :=
  (List.range (if code = 0 then 0 else code.log2 / bits + 1)).map
    fun i => (code >>> (bits*i)) % (2^bits)

def taut : Masks := (1,1)
private theorem taut_sound (key : Nat) : Holds key taut := by
  refine ⟨0, ?_⟩
  cases h : key.testBit 0 <;> simp [taut]

/-- An invalid reference denotes a tautology. Only strictly earlier clauses can be used. -/
def fetch (db : Nat → Masks) (bound id : Nat) : Masks :=
  if 0 < id ∧ id ≤ bound then db (id-1) else taut
def derive (db : Nat → Masks) (bound : Nat) : List Nat → Masks
  | [] => taut
  | h :: hs => hs.foldl (fun acc id => resolve acc (fetch db bound id)) (fetch db bound h)

theorem derive_sound {key bound : Nat} {db : Nat → Masks}
    (hdb : ∀ i < bound, Holds key (db i)) (ids : List Nat) :
    Holds key (derive db bound ids) := by
  have fetched (id : Nat) : Holds key (fetch db bound id) := by
    unfold fetch
    split
    · exact hdb _ (by omega)
    · exact taut_sound _
  cases ids with
  | nil => exact taut_sound _
  | cons h hs =>
    suffices ∀ m, Holds key m →
        Holds key (hs.foldl (fun acc id => resolve acc (fetch db bound id)) m) from
      this _ (fetched _)
    induction hs with
    | nil => exact fun _ hm => hm
    | cons i l ih => exact fun _ hm => ih _ (resolve_sound hm (fetched i))

def block (db : Nat → Masks) (chains : Nat → Nat) (bits base start count : Nat) : Bool :=
  (List.range count).all fun offset =>
    let i := start + offset
    derive db (base+i) (decode bits (chains i)) == db (base+i)

theorem join {db : Nat → Masks} {chains : Nat → Nat} {w n s k : Nat}
    (hs : block db chains w n 0 s) (hk : block db chains w n s k) :
    block db chains w n 0 (s+k) := by
  simp only [block, List.all_eq_true, List.mem_range, Nat.zero_add] at *
  intro i hi
  by_cases h : i<s
  · exact hs _ h
  · have he : s+(i-s)=i := by omega
    simpa [he] using hk (i-s) (by omega)

theorem refute {key w n k : Nat} {db : Nat → Masks} {chains : Nat → Nat}
    (hp : 0<k) (hlast : db (n+k-1) = (0,0))
    (hi : ∀ i < n, Holds key (db i)) (checked : block db chains w n 0 k) : False := by
  simp only [block, List.all_eq_true, List.mem_range, Nat.zero_add, beq_iff_eq] at checked
  have alldb (j : Nat) (hj : j < n+k) : Holds key (db j) := by
    induction j using Nat.strong_induction_on with
    | h j ih =>
      by_cases hjn : j<n
      · exact hi _ hjn
      · have eqj : n+(j-n) = j := by omega
        have he := checked (j-n) (by omega)
        rw [eqj] at he
        rw [← he]
        exact derive_sound (fun i hi => ih i hi (by omega)) _
  have h := alldb (n+k-1) (by omega)
  rw [hlast] at h
  simp [Holds] at h

def unpackMasks (code : Nat) : Masks := (code % (2^56), code >>> 56)
end RamseyResolve

namespace RamseyResolve

def pack : List (Nat × Bool) → Masks
  | [] => (0,0)
  | (i, sign) :: rest =>
    let m := pack rest
    if sign then (m.1 ||| 2^i, m.2) else (m.1, m.2 ||| 2^i)

lemma pack_sound (key : Nat) (cl : List (Nat × Bool))
    (h : ∃ lit ∈ cl, key.testBit lit.1 = lit.2) : Holds key (pack cl) := by
  induction cl with
  | nil => simp at h
  | cons head tail ih =>
    obtain ⟨j, sign⟩ := head
    obtain ⟨lit, hmem, hs⟩ := h
    rcases List.mem_cons.mp hmem with heq | htail
    · subst lit
      refine ⟨j, ?_⟩
      cases sign
      · exact Or.inr ⟨by simp [pack, Nat.testBit_or], hs⟩
      · exact Or.inl ⟨by simp [pack, Nat.testBit_or], hs⟩
    · obtain ⟨v, hv | hv⟩ := ih ⟨lit, htail, hs⟩
      · refine ⟨v, Or.inl ⟨?_,hv.2⟩⟩
        cases sign <;> simp [pack, Nat.testBit_or, hv.1]
      · refine ⟨v, Or.inr ⟨?_,hv.2⟩⟩
        cases sign <;> simp [pack, Nat.testBit_or, hv.1]


private theorem initialRows (clauses : List (List (Nat × Bool))) (key n : Nat) (db : Nat → Masks)
    (h : ∀ cl ∈ clauses, ∃ lit ∈ cl, key.testBit lit.1 = lit.2)
    (heq : clauses.map pack = (List.range n).map db) :
    ∀ i < n, Holds key (db i) := by
  intro i hi
  have hm : db i ∈ (List.range n).map db :=
    List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩
  rw [← heq] at hm
  obtain ⟨cl, hcl, he⟩ := List.mem_map.mp hm
  rw [← he]
  exact pack_sound key cl (h _ hcl)


