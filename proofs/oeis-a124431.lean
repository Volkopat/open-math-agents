lemma S_sq : S * S = R := by
  have := bs_sq (R - 1) (by simp [R])
  unfold S; rw [this]; ring

noncomputable def DD : PowerSeries ℚ := 2 - 8 * X + 2 * X ^ 2
noncomputable def NN : PowerSeries ℚ := -1 + 4 * X - X ^ 2 + S
noncomputable def AA : PowerSeries ℚ := NN * DD⁻¹

lemma hA : AA * DD = NN := by
  unfold AA
  rw [mul_assoc, PowerSeries.inv_mul_cancel _ (by simp [DD]), mul_one]

lemma hdD : derivative ℚ DD = 4*X - 8 := by
  simp [DD] <;> ring
lemma hdR : derivative ℚ R = 4*X^3 - 12*X^2 + 4*X - 4 := by
  simp [R] <;> ring
lemma hdN : derivative ℚ NN = 4 - 2*X + (0) * S + (1) * derivative ℚ S := by
  simp [NN] <;> ring

lemma ode : ((-2) * X ^ 1 + (2) * X ^ 3) * AA + ((1) * X ^ 1 + (-4) * X ^ 2 + (2) * X ^ 3 + (-4) * X ^ 4 + (1) * X ^ 5) * derivative ℚ AA = ((1) * X ^ 1 + (-1) * X ^ 3 : PowerSeries ℚ) := by
  have r1 := hA
  have r2 : derivative ℚ AA * DD + AA * derivative ℚ DD = derivative ℚ NN := by
    have := congrArg (derivative ℚ) hA
    rw [Derivation.leibniz] at this
    simp only [smul_eq_mul] at this
    rw [← this]; ring
  have r4 := sqrt_ode S R S_sq
  have hK : (2 * R * DD ^ 2 : PowerSeries ℚ) ≠ 0 := by
    intro h
    have := congrArg constantCoeff h
    simp [R, DD] at this
  apply mul_left_cancel₀ hK
  rw [hdD, hdN] at r2
  rw [hdR] at r4
  unfold NN at r1
  unfold DD at r1 r2
  unfold R at r4
  unfold DD R
  linear_combination (-8*X^10 + 88*X^9 - 352*X^8 + 656*X^7 - 752*X^6 + 800*X^5 - 480*X^4 + 240*X^3 - 72*X^2 + 8*X) * r1 + (4*X^11 - 48*X^10 + 212*X^9 - 448*X^8 + 616*X^7 - 800*X^6 + 616*X^5 - 448*X^4 + 212*X^3 - 48*X^2 + 4*X) * r2 + (2*X^7 - 16*X^6 + 38*X^5 - 32*X^4 + 38*X^3 - 16*X^2 + 2*X) * r4

lemma ha (n : ℕ) : a n = coeff (n + 1) AA := rfl

lemma rec_a (k : ℕ) : (((k + 4 : ℕ) : ℚ) + 1) * a (k + 4) + (-4*((k + 4 : ℕ) : ℚ) - 2) * a (k + 3) + (2*((k + 4 : ℕ) : ℚ) - 2) * a (k + 2) + (10 - 4*((k + 4 : ℕ) : ℚ)) * a (k + 1) + (((k + 4 : ℕ) : ℚ) - 3) * a (k + 0) = 0 := by
  have h := congrArg (coeff (k + 5)) ode
  simp only [add_mul, sub_mul, neg_mul, one_mul, map_add, map_sub, map_neg, mul_assoc, cm2, cm3, cm4, cm5, cm8, cm12, cm14, coeff_X_pow_mul', coeff_derivative] at h
  simp [PowerSeries.coeff_X] at h
  simp only [ha]
  simp only [Nat.add_assoc, Nat.reduceAdd] at h ⊢
  push_cast at h ⊢
  linear_combination h

