    (((List.range (838+1)).filter (fun p => decide p.Prime)).reverse.foldr advance id 590237761) +
    (Nat.primesLE 838).card = 49332055 := by
  exact left_from_rows tab WheelTableA590.fast_correct ps145 (by decide) (by decide) last_row (show evalPhi tab ps145 590237761 = 49331910 from v145) (by decide +kernel)

