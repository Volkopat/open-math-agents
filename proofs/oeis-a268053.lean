  have v9 : a 9 = 1534144563898 := by
    have h : (a 9 : ℤ) = (62 : ℤ) * (a 8 : ℤ) + (-969 : ℤ) * (a 7 : ℤ) + (4568 : ℤ) * (a 6 : ℤ) + (-5740 : ℤ) * (a 5 : ℤ) := a_rec 4
