/-- Both of Barker's conjectures. -/
theorem conjecture :
    PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * ((1 - 2 * X) * (1 - 5 * X) * (1 - 14 * X) * (1 - 41 * X)) = X * (1 - 46 * X + 399 * X ^ 2 - 674 * X ^ 3) ∧
    ∀ n : ℕ, 1 ≤ n → (a n : ℚ) = (38745 * 2 ^ n + 127428 * 5 ^ n + 17425 * 2 ^ (2 + n) * 7 ^ n + 9800 * 41 ^ n) /
      2092230 :=
  ⟨gf, closed⟩

