  have v7 : a 7 = 915745002 := by
    have h : (a 7 : ℤ) = (62 : ℤ) * (a 6 : ℤ) + (-969 : ℤ) * (a 5 : ℤ) + (4568 : ℤ) * (a 4 : ℤ) + (-5740 : ℤ) * (a 3 : ℤ) := a_rec 2
    rw [v6, v5, v4, v3] at h
    omega
  have v8 : a 8 = 37450557314 := by
