import OMAReductions.R_Erdos422_erdos_422_variants_well_defined_R1_H2_R1

-- Hofstadter's Q-sequence stays well defined up to 30000: any function satisfying the guarded recurrence has
-- q n at most n for 512 <= n <= 30000.
-- Original proof: the values Q(1), ..., Q(30000) are packed in one numeral (15 bits each); the kernel checks,
-- in blocks of 3000 indices, that the table satisfies the recurrence with valid references and that each value is
-- at most its index; strong induction then identifies any solution of the recurrence with the table.
-- A verified range of an open problem, not progress on the general statement.

namespace OMA.E422

/-- The packed table of values. -/
def W : ℕ := 

/-- The table value at index `n` (zero at index zero). -/
def T (n : ℕ) : ℕ := (W >>> (15 * n)) % 32768

/-- The table satisfies the guarded recurrence at `n`, with value at most `n`. -/
def ok (n : ℕ) : Bool :=
  decide (0 < T (n - 1)) && decide (T (n - 1) < n) && decide (0 < T (n - 2)) &&
    decide (T (n - 2) < n) && (T n == T (n - T (n - 1)) + T (n - T (n - 2))) && decide (T n ≤ n)

def loop : ℕ → ℕ → Bool
  | 0, _ => true
  | f + 1, n => ok n && loop f (n + 1)

lemma loop_spec : ∀ (f n : ℕ), loop f n = true → ∀ m, n ≤ m → m < n + f → ok m = true := by
  intro f
  induction f with
  | zero => intro n _ m h1 h2; omega
  | succ f ih =>
    intro n h m h1 h2
    rw [loop, Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact h.1
    · exact ih (n + 1) h.2 m hlt (by omega)

set_option maxRecDepth 100000 in
theorem c0 : loop 3000 3 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c1 : loop 3000 3003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c2 : loop 3000 6003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c3 : loop 3000 9003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c4 : loop 3000 12003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c5 : loop 3000 15003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c6 : loop 3000 18003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c7 : loop 3000 21003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c8 : loop 3000 24003 = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem c9 : loop 2998 27003 = true := by decide +kernel

lemma ok_all (m : ℕ) (h3 : 3 ≤ m) (hN : m ≤ 30000) : ok m = true := by
  by_cases g0 : m < 3003
  · exact loop_spec _ _ c0 m (by omega) (by omega)
  by_cases g1 : m < 6003
  · exact loop_spec _ _ c1 m (by omega) (by omega)
  by_cases g2 : m < 9003
  · exact loop_spec _ _ c2 m (by omega) (by omega)
  by_cases g3 : m < 12003
  · exact loop_spec _ _ c3 m (by omega) (by omega)
  by_cases g4 : m < 15003
  · exact loop_spec _ _ c4 m (by omega) (by omega)
  by_cases g5 : m < 18003
  · exact loop_spec _ _ c5 m (by omega) (by omega)
  by_cases g6 : m < 21003
  · exact loop_spec _ _ c6 m (by omega) (by omega)
  by_cases g7 : m < 24003
  · exact loop_spec _ _ c7 m (by omega) (by omega)
  by_cases g8 : m < 27003
  · exact loop_spec _ _ c8 m (by omega) (by omega)
  exact loop_spec _ _ c9 m (by omega) (by omega)

lemma T1 : T 1 = 1 := by decide +kernel

lemma T2 : T 2 = 1 := by decide +kernel

theorem eq_table (q : ℕ → ℕ) (h1 : q 1 = 1) (h2 : q 2 = 1)
    (hrec : ∀ n : ℕ, 2 < n → q n =
      if 0 < q (n - 1) ∧ q (n - 1) < n ∧ 0 < q (n - 2) ∧ q (n - 2) < n then
        q (n - q (n - 1)) + q (n - q (n - 2)) else 0) :
    ∀ n : ℕ, 1 ≤ n → n ≤ 30000 → q n = T n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn1 hnN
    by_cases c1 : n = 1
    · subst c1; rw [h1, T1]
    by_cases c2 : n = 2
    · subst c2; rw [h2, T2]
    have hok := ok_all n (by omega) hnN
    simp only [ok, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hok
    obtain ⟨⟨⟨⟨⟨a0, a1⟩, b0⟩, b1⟩, e⟩, -⟩ := hok
    have i1 := ih (n - 1) (by omega) (by omega) (by omega)
    have i2 := ih (n - 2) (by omega) (by omega) (by omega)
    have i3 := ih (n - T (n - 1)) (by omega) (by omega) (by omega)
    have i4 := ih (n - T (n - 2)) (by omega) (by omega) (by omega)
    rw [hrec n (by omega), i1, i2, if_pos ⟨a0, a1, b0, b1⟩, i3, i4]
    exact e.symm

theorem range_bound (q : ℕ → ℕ) (h1 : q 1 = 1) (h2 : q 2 = 1)
    (hrec : ∀ n : ℕ, 2 < n → q n =
      if 0 < q (n - 1) ∧ q (n - 1) < n ∧ 0 < q (n - 2) ∧ q (n - 2) < n then
        q (n - q (n - 1)) + q (n - q (n - 2)) else 0)
    (n : ℕ) (hn : 512 ≤ n) (hN : n ≤ 30000) : q n ≤ n := by
  rw [eq_table q h1 h2 hrec n (by omega) hN]
  have hok := ok_all n (by omega) hN
  simp only [ok, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hok
  exact hok.2

end OMA.E422

theorem OMA.solution : OMA.R_Erdos422_erdos_422_variants_well_defined_R1_H2_R1.H1 := by
  intro q h1 h2 hrec n hn hN
  exact OMA.E422.range_bound q h1 h2 hrec n hn hN
