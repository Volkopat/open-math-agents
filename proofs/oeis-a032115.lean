  simp only [P032115.nC, sub_mul, add_mul, neg_mul, pow_succ, pow_zero, one_mul, mul_assoc, map_add,
    map_sub, map_neg, coeff_C_mul, P032115.cXd, coeff_succ_X_mul, coeff_derivative, coeff_X, coeff_one] at e
