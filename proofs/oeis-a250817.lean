    intro hn
    by_cases hlt : n < 6
    · interval_cases n <;> norm_num [a_v1, a_v2, a_v3, a_v4, a_v5]
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
      have h1 := ih (k + 5) (by omega) (by omega)
