theorem a_rec : ∀ m : ℕ, 6 ≤ m → (a m : ℤ) = 5 * (a (m - 1) : ℤ) - 10 * (a (m - 2) : ℤ) + 10 * (a (m - 3) : ℤ) - 5 * (a (m - 4) : ℤ) + (a (m - 5) : ℤ) := by
  intro m hm
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 6 := ⟨m - 6, by omega⟩
  rw [show k + 6 - 1 = k + 5 by omega, show k + 6 - 2 = k + 4 by omega, show k + 6 - 3 = k + 3 by omega, show k + 6 - 4 = k + 2 by omega, show k + 6 - 5 = k + 1 by omega]
  rw [a_eq (k + 6), a_eq (k + 5), a_eq (k + 4), a_eq (k + 3), a_eq (k + 2), a_eq (k + 1)]
  rw [up6 k, up5 k, up4 k, up3 k, up2 k, up1 k]
  push_cast
  ring

theorem gf_eq : PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) = G := by
  rw [G, PowerSeries.eq_mul_inv_iff_mul_eq (by simp)]
  set F' := PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ))
  have e1 : F' * ((1 - PowerSeries.X) ^ 5) = F' - PowerSeries.C (5 : ℚ) * (PowerSeries.X ^ 1 * F') + PowerSeries.C (10 : ℚ) * (PowerSeries.X ^ 2 * F') - PowerSeries.C (10 : ℚ) * (PowerSeries.X ^ 3 * F') + PowerSeries.C (5 : ℚ) * (PowerSeries.X ^ 4 * F') - PowerSeries.X ^ 5 * F' := by
    simp only [map_ofNat]
    ring
  have e2 : (PowerSeries.X * (4356 - 8045 * PowerSeries.X + 7630 * PowerSeries.X ^ 2 - 3644 * PowerSeries.X ^ 3 + 729 * PowerSeries.X ^ 4) : PowerSeries ℚ) = PowerSeries.C (4356 : ℚ) * PowerSeries.X ^ 1 - PowerSeries.C (8045 : ℚ) * PowerSeries.X ^ 2 + PowerSeries.C (7630 : ℚ) * PowerSeries.X ^ 3 - PowerSeries.C (3644 : ℚ) * PowerSeries.X ^ 4 + PowerSeries.C (729 : ℚ) * PowerSeries.X ^ 5 := by
    simp only [map_ofNat]
    ring
  rw [e1, e2]
  ext n
  simp only [F', map_sub, map_add, PowerSeries.coeff_C_mul, PowerSeries.coeff_mk, PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_X_pow]
  by_cases hn : n ≤ 5
  · interval_cases n <;> norm_num [a_v1, a_v2, a_v3, a_v4, a_v5]
  · obtain ⟨j, rfl⟩ : ∃ j, n = j + 6 := ⟨n - 6, by omega⟩
    have h := a_rec (j + 6) (by omega)
    rw [show j + 6 - 1 = j + 5 by omega, show j + 6 - 2 = j + 4 by omega, show j + 6 - 3 = j + 3 by omega, show j + 6 - 4 = j + 2 by omega, show j + 6 - 5 = j + 1 by omega] at h
    have q : (a (j + 6) : ℚ) = 5 * (a (j + 5) : ℚ) - 10 * (a (j + 4) : ℚ) + 10 * (a (j + 3) : ℚ) - 5 * (a (j + 2) : ℚ) + (a (j + 1) : ℚ) := by exact_mod_cast h
    simp
    linear_combination q

