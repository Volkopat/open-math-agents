      have q : (a (k + 6) : ℚ) = 5 * (a (k + 5) : ℚ) - 10 * (a (k + 4) : ℚ) + 10 * (a (k + 3) : ℚ) - 5 * (a (k + 2) : ℚ) + (a (k + 1) : ℚ) := by exact_mod_cast hr
