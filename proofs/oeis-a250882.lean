  decide +kernel

theorem recurrence (n : ℕ) (hn : 4 < n) : (a n : ℤ) = 4 * a (n - 1) - 6 * a (n - 2) + 4 * a (n - 3) - a (n - 4) := by
  obtain ⟨v1, v2, v3, v4, v5, v6⟩ := values
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
  rw [show m + 4 - 1 = m + 3 by omega, show m + 4 - 2 = m + 2 by omega, show m + 4 - 3 = m + 1 by omega, show m + 4 - 4 = m + 0 by omega]
  simp only [a_G]
  have e : ∑ s : Fin K, (G (m + 4) (κ s) : ℤ) = ∑ s : Fin K, (4 * (G (m + 3) (κ s) : ℤ) - 6 * (G (m + 2) (κ s) : ℤ) + 4 * (G (m + 1) (κ s) : ℤ) - (G (m + 0) (κ s) : ℤ)) :=
    Finset.sum_congr rfl (fun s _ => rec_class m (κ s))
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_neg_distrib, ← Finset.mul_sum] at e
  push_cast
  linarith [e]

theorem gf : PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) * (1 - X) ^ 4 = 2 * X * (18565 - 8726 * X + 8193 * X ^ 2 - 2048 * X ^ 3) := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) with hA
  have e1 : A * (1 - X) ^ 4 = A - C 4 * (A * X ^ 1) + C 6 * (A * X ^ 2) - C 4 * (A * X ^ 3) + C 1 * (A * X ^ 4) := by
    simp only [map_ofNat, map_one]; ring
  have e2 : (2 * X * (18565 - 8726 * X + 8193 * X ^ 2 - 2048 * X ^ 3) : ℚ⟦X⟧) = X ^ 1 * C 37130 - X ^ 2 * C 17452 + X ^ 3 * C 16386 - X ^ 4 * C 4096 := by
    simp only [map_ofNat, map_one]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℚ) else (a k : ℚ) := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, map_neg, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  obtain ⟨v1, v2, v3, v4, v5, v6⟩ := values
  rcases Nat.lt_or_ge n 5 with hn | hn
  · interval_cases n <;> simp [v1, v2, v3, v4, v5, v6] <;> norm_num
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 5 := ⟨n - 5, by omega⟩
    have h := recurrence (q + 5) (by omega)
    simp only [show q + 5 - 1 = q + 4 by omega, show q + 5 - 2 = q + 3 by omega, show q + 5 - 3 = q + 2 by omega, show q + 5 - 4 = q + 1 by omega] at h
    have h' : (a (q + 5) : ℚ) = 4 * a (q + 4) - 6 * a (q + 3) + 4 * a (q + 2) - a (q + 1) := by exact_mod_cast h
    simp only [show 1 ≤ q + 5 by omega, show q + 5 - 1 = q + 4 by omega, show 2 ≤ q + 5 by omega, show q + 5 - 2 = q + 3 by omega, show 3 ≤ q + 5 by omega, show q + 5 - 3 = q + 2 by omega, show 4 ≤ q + 5 by omega, show q + 5 - 4 = q + 1 by omega, show ¬ q + 5 = 0 by omega, show ¬ q + 5 = 1 by omega, show ¬ q + 5 = 2 by omega, show ¬ q + 5 = 3 by omega, show ¬ q + 5 = 4 by omega, show ¬ q + 5 = 0 by omega, show ¬ q + 4 = 0 by omega, show ¬ q + 3 = 0 by omega, show ¬ q + 2 = 0 by omega, show ¬ q + 1 = 0 by omega, if_true, if_false]
    rw [h']
    ring

