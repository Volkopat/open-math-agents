import OMAStatements.S_oeis_a250882

/-!
Proof of Barker's conjectures by a transfer matrix over the columns. A column is one of the 4^6 = 4096 maps
Fin 6 → Fin 4, and two consecutive columns are compatible when every 2 X 2 block between them satisfies
`blk`. The columns fall into 77 classes with the same number of compatible successors in every class (a
lumping of the transfer matrix), which is checked for every column by a pruned search over its
successors; the class counts satisfy the recurrence from 5 columns on.
-/

namespace OMA.S_oeis_a250882

open PowerSeries


section TMCore

/-- The total cost of a sequence of states: a cost per state and a cost per consecutive pair. -/
def pc {α : Type} (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (y : Fin (m + 1) → α) : ℕ :=
  (∑ i, h (y i)) + ∑ i : Fin m, d (y i.castSucc) (y i.succ)

theorem pc_cons {α : Type} (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (a : α) (z : Fin (m + 1) → α) :
    pc h d (m + 1) (Fin.cons a z) = h a + d a (z 0) + pc h d m z := by
  unfold pc
  rw [Fin.sum_univ_succ (f := fun i => h ((Fin.cons a z : Fin (m + 2) → α) i)),
    Fin.sum_univ_succ (f := fun i : Fin (m + 1) =>
      d ((Fin.cons a z : Fin (m + 2) → α) i.castSucc) ((Fin.cons a z : Fin (m + 2) → α) i.succ))]
  simp only [Fin.cons_zero, Fin.cons_succ, Fin.castSucc_zero, ← Fin.succ_castSucc]
  ring

/-- The number of sequences of m + 1 states starting at a with total cost c. -/
def cnt {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (a : α) (c : ℕ) :
    ℕ :=
  ∑ y : Fin (m + 1) → α, if y 0 = a ∧ pc h d m y = c then 1 else 0

theorem sum_cons_eq {α : Type} [Fintype α] [DecidableEq α] (m : ℕ) (f : (Fin (m + 2) → α) → ℕ) :
    ∑ y : Fin (m + 2) → α, f y = ∑ a : α, ∑ z : Fin (m + 1) → α, f (Fin.cons a z) := by
  rw [← (Fin.consEquiv fun _ => α).sum_comp, Fintype.sum_prod_type]
  rfl

theorem cnt_zero {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (a : α) (c : ℕ) :
    cnt h d 0 a c = if h a = c then 1 else 0 := by
  unfold cnt pc
  rw [← (Equiv.funUnique (Fin 1) α).symm.sum_comp, Finset.sum_eq_single a]
  · simp
  · intro b _ hb
    simp [hb]
  · simp

theorem cnt_succ {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (a : α)
    (c : ℕ) : cnt h d (m + 1) a c =
      ∑ b : α, if h a + d a b ≤ c then cnt h d m b (c - (h a + d a b)) else 0 := by
  unfold cnt
  rw [sum_cons_eq]
  simp only [Fin.cons_zero, pc_cons]
  rw [Finset.sum_eq_single a (fun b _ hb => by simp [hb]) (by simp)]
  simp only [true_and]
  rw [← Finset.sum_fiberwise Finset.univ (fun z : Fin (m + 1) → α => z 0)]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  split_ifs with hc
  · rw [Finset.sum_filter]
    refine Finset.sum_congr rfl (fun z _ => ?_)
    by_cases hz : z 0 = b
    · simp only [hz, true_and, if_true]
      congr 1
      apply propext
      omega
    · simp [hz]
  · apply Finset.sum_eq_zero
    intro z hz
    rw [Finset.mem_filter] at hz
    rw [hz.2]
    simp only [ite_eq_right_iff]
    omega

theorem cnt_succ0 {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (a : α) :
    cnt h d (m + 1) a 0 = ∑ b : α, if h a + d a b = 0 then cnt h d m b 0 else 0 := by
  rw [cnt_succ]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  by_cases hb : h a + d a b = 0
  · rw [if_pos (by omega), if_pos hb, hb]
  · rw [if_neg (by omega), if_neg hb]

theorem cnt_succ1 {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (a : α) :
    cnt h d (m + 1) a 1 = ∑ b : α, ((if h a + d a b = 0 then cnt h d m b 1 else 0) +
      (if h a + d a b = 1 then cnt h d m b 0 else 0)) := by
  rw [cnt_succ]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  rcases Nat.lt_trichotomy (h a + d a b) 1 with hb | hb | hb
  · have : h a + d a b = 0 := by omega
    rw [if_pos (by omega), if_pos this, if_neg (by omega), this]
    simp
  · rw [if_pos (by omega), if_neg (by omega), if_pos hb, hb]
    simp
  · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega)]

/-- Sequences of states by total cost: the sum over the first state. -/
theorem card_pc {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) (c : ℕ) :
    (Finset.univ.filter fun y : Fin (m + 1) → α => pc h d m y = c).card = ∑ a : α, cnt h d m a c := by
  rw [Finset.card_filter]
  unfold cnt
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun y _ => ?_)
  rw [Finset.sum_eq_single (y 0) (fun b _ hb => by simp [Ne.symm hb]) (by simp)]
  simp

/-- Reindexing the states along an equivalence. -/
theorem card_reindex {α β : Type} [Fintype α] [Fintype β] (e : α ≃ β) (m : ℕ)
    (P : (Fin (m + 1) → α) → Prop) [DecidablePred P] :
    (Finset.univ.filter P).card =
      (Finset.univ.filter fun y : Fin (m + 1) → β => P (fun i => e.symm (y i))).card := by
  rw [Finset.card_filter, Finset.card_filter]
  rw [← (Equiv.arrowCongr (Equiv.refl (Fin (m + 1))) e).symm.sum_comp]
  rfl

/-- Sequences of states with total cost at most one. -/
theorem card_pc_le_one {α : Type} [Fintype α] [DecidableEq α] (h : α → ℕ) (d : α → α → ℕ) (m : ℕ) :
    (Finset.univ.filter fun y : Fin (m + 1) → α => pc h d m y ≤ 1).card =
      ∑ a : α, (cnt h d m a 0 + cnt h d m a 1) := by
  rw [Finset.sum_add_distrib, ← card_pc, ← card_pc, Finset.card_filter, Finset.card_filter,
    Finset.card_filter, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun y _ => ?_)
  split_ifs <;> omega

end TMCore

section LumpCore

/-- Two columns satisfy the 2 X 2 block condition `P` at every pair of consecutive rows. -/
def chainR {V : ℕ} (P : Fin V → Fin V → Fin V → Fin V → Prop) (k : ℕ) (σ τ : Fin (k + 1) → Fin V) :
    Prop :=
  ∀ i : Fin k, P (σ i.castSucc) (τ i.castSucc) (σ i.succ) (τ i.succ)

instance chainR_dec {V : ℕ} (P : Fin V → Fin V → Fin V → Fin V → Prop) [∀ a b c d, Decidable (P a b c d)]
    (k : ℕ) (σ τ : Fin (k + 1) → Fin V) : Decidable (chainR P k σ τ) := by
  unfold chainR
  infer_instance

theorem chainR_cons {V : ℕ} (P : Fin V → Fin V → Fin V → Fin V → Prop) (k : ℕ)
    (σ : Fin (k + 2) → Fin V) (u : Fin V) (τ : Fin (k + 1) → Fin V) :
    chainR P (k + 1) σ (Fin.cons u τ) ↔ P (σ 0) u (σ 1) (τ 0) ∧ chainR P k (Fin.tail σ) τ := by
  unfold chainR
  rw [Fin.forall_fin_succ]
  have h1 : ∀ i : Fin k, (Fin.cons u τ : Fin (k + 2) → Fin V) i.succ.castSucc = τ i.castSucc := by
    intro i
    rw [← Fin.succ_castSucc, Fin.cons_succ]
  simp only [Fin.castSucc_zero, Fin.cons_zero, Fin.succ_zero_eq_one, h1, Fin.cons_succ, Fin.tail]
  have h2 : (Fin.cons u τ : Fin (k + 2) → Fin V) 1 = τ 0 := rfl
  rw [h2]
  simp only [Fin.succ_castSucc]

/-- The sum of `G` over the columns `τ` with first entry `v` that follow `σ`, by a pruned search. -/
def W {V : ℕ} (P : Fin V → Fin V → Fin V → Fin V → Prop) [∀ a b c d, Decidable (P a b c d)] :
    (k : ℕ) → (Fin (k + 1) → Fin V) → Fin V → ((Fin (k + 1) → Fin V) → ℕ) → ℕ
  | 0, _, v, G => G (fun _ => v)
  | k + 1, σ, v, G => ∑ w : Fin V,
      if P (σ 0) v (σ 1) w then W P k (Fin.tail σ) w (fun τ => G (Fin.cons v τ)) else 0

theorem W_eq {V : ℕ} (P : Fin V → Fin V → Fin V → Fin V → Prop) [∀ a b c d, Decidable (P a b c d)] :
    ∀ (k : ℕ) (σ : Fin (k + 1) → Fin V) (v : Fin V) (G : (Fin (k + 1) → Fin V) → ℕ),
      W P k σ v G = ∑ τ : Fin (k + 1) → Fin V, if τ 0 = v ∧ chainR P k σ τ then G τ else 0
  | 0, σ, v, G => by
    have hc : ∀ τ, chainR P 0 σ τ := fun τ i => i.elim0
    simp only [W, hc, and_true]
    rw [Finset.sum_eq_single (fun _ => v)]
    · simp
    · intro τ _ hτ
      rw [if_neg]
      intro h0
      apply hτ
      funext i
      rw [show i = 0 from Fin.ext (by have := i.isLt; omega), h0]
    · simp
  | k + 1, σ, v, G => by
    rw [W]
    symm
    rw [← (Fin.consEquiv fun _ => Fin V).sum_comp, Fintype.sum_prod_type]
    have hce : ∀ p : Fin V × (Fin (k + 1) → Fin V), (Fin.consEquiv fun _ => Fin V) p = Fin.cons p.1 p.2 :=
      fun p => rfl
    simp only [hce, Fin.cons_zero, chainR_cons]
    rw [Finset.sum_eq_single v (fun b _ hb => by simp [hb]) (by simp)]
    simp only [true_and]
    rw [← Finset.sum_fiberwise Finset.univ (fun τ : Fin (k + 1) → Fin V => τ 0)]
    refine Finset.sum_congr rfl (fun w _ => ?_)
    rw [W_eq P k (Fin.tail σ) w, Finset.sum_filter]
    split_ifs with hw
    · refine Finset.sum_congr rfl (fun τ _ => ?_)
      by_cases h0 : τ 0 = w
      · simp [h0, hw]
      · simp [h0]
    · apply Finset.sum_eq_zero
      intro τ _
      by_cases h0 : τ 0 = w
      · simp [h0, hw]
      · simp [h0]

/-- The digit extraction in base `B`. -/
theorem digit_sum (B : ℕ) (hB : 0 < B) : ∀ (L : ℕ) (f : Fin L → ℕ), (∀ q, f q < B) →
    ∀ q : Fin L, (∑ i, f i * B ^ (i : ℕ)) / B ^ (q : ℕ) % B = f q
  | 0, _, _, q => q.elim0
  | L + 1, f, hf, q => by
    rw [Fin.sum_univ_succ]
    have hs : ∑ i : Fin L, f i.succ * B ^ ((i.succ : Fin (L + 1)) : ℕ) =
        B * ∑ i : Fin L, f i.succ * B ^ (i : ℕ) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Fin.val_succ, pow_succ]
      ring
    rw [hs]
    simp only [Fin.val_zero, pow_zero, mul_one]
    refine Fin.cases ?_ (fun q => ?_) q
    · simp only [Fin.val_zero, pow_zero, Nat.div_one]
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hf 0)]
    · rw [Fin.val_succ, pow_succ', ← Nat.div_div_eq_div_mul]
      rw [show (f 0 + B * ∑ i : Fin L, f i.succ * B ^ (i : ℕ)) / B = ∑ i : Fin L, f i.succ * B ^ (i : ℕ) by
        rw [Nat.add_mul_div_left _ _ hB, Nat.div_eq_of_lt (hf 0), zero_add]]
      exact digit_sum B hB L (fun i => f i.succ) (fun i => hf i.succ) q

/-- Counting a function on the classes over the columns that follow `σ`. -/
theorem sum_classes {α : Type} [Fintype α] {L : ℕ} (κ : α → Fin L) (S : α → Prop) [DecidablePred S]
    (g : Fin L → ℕ) :
    (∑ t : α, if S t then g (κ t) else 0) =
      ∑ q : Fin L, (∑ t : α, if S t ∧ κ t = q then 1 else 0) * g q := by
  rw [← Finset.sum_fiberwise Finset.univ κ]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  rw [Finset.sum_filter, Finset.sum_mul]
  refine Finset.sum_congr rfl (fun t _ => ?_)
  by_cases h1 : κ t = q <;> by_cases h2 : S t <;> simp [h1, h2]

end LumpCore


/-- The block condition between a state and the next one, along the shared index. -/
def P (a b c d : Fin 4) : Prop := blk a b c d

instance : ∀ a b c d, Decidable (P a b c d) := fun a b c d => by unfold P; infer_instance

/-- The number of columns. -/
abbrev K : ℕ := 4 ^ 6

/-- Columns as numbers in base 4. -/
def E : (Fin 6 → Fin 4) ≃ Fin K := finFunctionFinEquiv

/-- Compatible consecutive columns. -/
def R (s t : Fin K) : Prop := chainR P 5 (E.symm s) (E.symm t)

instance : ∀ s t, Decidable (R s t) := fun s t => by unfold R; infer_instance

/-- The cost of a pair of columns: zero when compatible. -/
def dc (s t : Fin K) : ℕ := if R s t then 0 else 1

/-- No cost on single columns. -/
def hc (_ : Fin K) : ℕ := 0

theorem good_iff {n : ℕ} (x : Fin 6 → Fin (n + 1) → Fin 4) :
    good x ↔ ∀ j : Fin n, chainR P 5 (fun i => x i j.castSucc) (fun i => x i j.succ) := by
  unfold good chainR P
  exact forall_comm

theorem pc_zero {n : ℕ} (y : Fin (n + 1) → Fin K) :
    pc hc dc n y = 0 ↔ ∀ j : Fin n, R (y j.castSucc) (y j.succ) := by
  unfold pc hc dc
  simp only [Finset.sum_const_zero, zero_add, Finset.sum_eq_zero_iff, Finset.mem_univ, true_implies,
    ite_eq_left_iff, one_ne_zero, imp_false, not_not]

theorem a_eq (n : ℕ) : a n = ∑ s : Fin K, cnt hc dc n s 0 := by
  rw [← card_pc]
  unfold a
  rw [Finset.card_filter, Finset.card_filter, ← (Equiv.piComm fun (_ : Fin 6) (_ : Fin (n + 1)) => Fin 4).symm.sum_comp]
  rw [← (Equiv.arrowCongr (Equiv.refl (Fin (n + 1))) E).symm.sum_comp]
  refine Finset.sum_congr rfl (fun y _ => ?_)
  congr 1
  apply propext
  rw [good_iff, pc_zero]
  rfl

/-- The number of classes. -/
abbrev L : ℕ := 77

/-- The classes of the columns, 7 bits each. -/
def KAP : ℕ := 

/-- The class of a column. -/
def κ (s : Fin K) : Fin L := ⟨(KAP >>> (7 * s.val)) % 128 % L, Nat.mod_lt _ (by norm_num)⟩

