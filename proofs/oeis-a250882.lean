theorem succ_count (s : Fin K) (q : Fin L) :
    (∑ t : Fin K, if R s t ∧ κ t = q then 1 else 0) = Mf (κ s) q := by
  have h1 := check s
  simp only [W_eq] at h1
  rw [Finset.sum_comm] at h1
  have h2 : ∀ τ : Fin 6 → Fin 4, (∑ v : Fin 4, if τ 0 = v ∧ chainR P 5 (E.symm s) τ then
      B ^ ((κ (E τ) : Fin L) : ℕ) else 0) = if chainR P 5 (E.symm s) τ then B ^ ((κ (E τ) : Fin L) : ℕ) else 0 := by
    intro τ
    rw [Finset.sum_eq_single (τ 0) (fun b _ hb => by simp [Ne.symm hb]) (by simp)]
    simp
  simp only [h2] at h1
  rw [← E.symm.sum_comp] at h1
  simp only [Equiv.apply_symm_apply] at h1
  rw [show (∑ t : Fin K, if chainR P 5 (E.symm s) (E.symm t) then B ^ ((κ t : Fin L) : ℕ) else 0) =
    ∑ t : Fin K, if R s t then (fun q : Fin L => B ^ (q : ℕ)) (κ t) else 0 from rfl,
    sum_classes κ (fun t => R s t) (fun q : Fin L => B ^ (q : ℕ))] at h1
  unfold Mf
  rw [← h1, digit_sum B (by norm_num) L]
  intro q'
  calc (∑ t : Fin K, if R s t ∧ κ t = q' then 1 else 0) ≤ ∑ _t : Fin K, 1 :=
        Finset.sum_le_sum (fun t _ => by split_ifs <;> omega)
    _ < B := by simp [K, B]

/-- The counts of the lumped system. -/
def G : ℕ → Fin L → ℕ
  | 0, _ => 1
  | m + 1, p => ∑ q : Fin L, Mf p q * G m q

theorem G_succ (m : ℕ) (p : Fin L) : G (m + 1) p = ∑ q : Fin L, Mf p q * G m q := rfl

theorem cnt_G (m : ℕ) (s : Fin K) : cnt hc dc m s 0 = G m (κ s) := by
  induction m generalizing s with
  | zero => rw [cnt_zero]; rfl
  | succ m ih =>
    rw [cnt_succ0, G_succ]
    have e : ∀ t, (if hc s + dc s t = 0 then cnt hc dc m t 0 else 0) = if R s t then G m (κ t) else 0 := by
      intro t
      by_cases hr : R s t
      · rw [if_pos (by simp [hc, dc, hr]), if_pos hr, ih]
      · rw [if_neg (by simp [hc, dc, hr]), if_neg hr]
    simp only [e]
    rw [sum_classes]
    simp only [succ_count]

theorem a_G (n : ℕ) : a n = ∑ s : Fin K, G n (κ s) := by
  rw [a_eq]
  simp only [cnt_G]

