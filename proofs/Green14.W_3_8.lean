theorem OMA.solution : type_of% @Green14.W_3_8 := by
  apply le_antisymm (Nat.sInf_le OMA.VDW.forced)
  apply Green14.W_ge_succ_of_not_mem 3 8 57 ⟨_,OMA.VDW.forced⟩
  intro h
  rcases h (certificateColoring 57 coloring) with hr | hb
  · apply no_monoAP_of_hasAP_eq_false (k := 3) (color := false) (mask := red)
      (by decide) (by decide +kernel) ?_ hr
    intro i _ hi
    simpa [coloring] using hi
  · apply no_monoAP_of_hasAP_eq_false (k := 8) (color := true) (mask := blue)
      (by decide) (by decide +kernel) ?_ hb
    intro i hi hc
    change (((2^_ - 1 : Nat) ^^^ red).testBit i) = true
    rw [Nat.testBit_xor,Nat.testBit_two_pow_sub_one,decide_eq_true hi]
    simpa [coloring] using hc
