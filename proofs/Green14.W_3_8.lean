/-- One input needs only its start and difference. -/
private def coordinate (i : Nat) : Nat :=
  (coordinates[i/32]!.shiftRight (i%32*11)) % 2^11

private def specifiedInput (i : Nat) : Masks :=
  let e := coordinate i
  safeInput 58 8 (decide (i < 812)) (e%64) (e/64-1)

private def inputMask (i : Nat) : Masks :=
  let e := coordinate i
  let d := e/64
  let pos := i < 812
  let len := if pos then 3 else 8
  let bits := (((1 <<< (len*d))-1) / ((1 <<< d)-1)) <<< (e%64)
  if pos then (bits,0) else (0,bits)

set_option maxRecDepth 20000 in
private theorem inputsAgree : ∀ i : Fin 1024, inputMask i.val = specifiedInput i.val := by
  decide +kernel

