/-- (E - 1)^9 G = 0 from m = 3 on, on every state. -/
theorem G_rec (m : ℕ) : ∀ a b c : Fin 13, (G a b c (m + 12) : ℤ) = 9 * G a b c (m + 11) - 36 * G a b
    c (m + 10) + 84 * G a b c (m + 9) - 126 * G a b c (m + 8) + 126 * G a b c (m + 7) - 84 * G a b c
    (m + 6) + 36 * G a b c (m + 5) - 9 * G a b c (m + 4) + G a b c (m + 3) := by
  induction m with
  | zero =>
    intro a b c
    rw [G12, G11, G10, G9, G8, G7, G6, G5, G4, G3]
    revert a b c
    decide +kernel
  | succ m ih =>
    intro a b c
    rw [G_succ a b c (m + 12), G_succ a b c (m + 11), G_succ a b c (m + 10), G_succ a b c (m + 9),
      G_succ a b c (m + 8), G_succ a b c (m + 7), G_succ a b c (m + 6), G_succ a b c (m + 5), G_succ
      a b c (m + 4), G_succ a b c (m + 3)]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    split_ifs
    · exact ih _ _ _
    · simp

lemma T_vals : T 0 = 2197 ∧ T 1 = 5854 ∧ T 2 = 14586 ∧ T 3 = 33468 ∧ T 4 = 71088 ∧ T 5 = 141192 ∧ T
    6 = 264822 ∧ T 7 = 473031 ∧ T 8 = 810265 ∧ T 9 = 1338508 ∧ T 10 = 2142292 ∧ T 11 = 3334680 := by
  unfold T
