/-- The order-9 recurrence of T, for all m. -/
theorem T_rec (m : ℕ) : (T (m + 9) : ℤ) = 9 * T (m + 8) - 36 * T (m + 7) + 84 * T (m + 6) - 126 * T
    (m + 5) + 126 * T (m + 4) - 84 * T (m + 3) + 36 * T (m + 2) - 9 * T (m + 1) + T m := by
  rcases Nat.lt_or_ge m 3 with hm | hm
  · obtain ⟨v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11⟩ := T_vals
    interval_cases m <;> simp only [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11] <;> norm_num
  · obtain ⟨k, rfl⟩ : ∃ k, m = k + 3 := ⟨m - 3, by omega⟩
    unfold T
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl
      (fun c _ => ?_)))
    have h := G_rec k a b c
    rw [show k + 3 + 9 = k + 12 by omega, show k + 3 + 8 = k + 11 by omega, show k + 3 + 7 = k + 10
      by omega, show k + 3 + 6 = k + 9 by omega, show k + 3 + 5 = k + 8 by omega, show k + 3 + 4 =
      k + 7 by omega, show k + 3 + 3 = k + 6 by omega, show k + 3 + 2 = k + 5 by omega, show k + 3 +
      1 = k + 4 by omega]
    linarith

/-- Barker's recurrence, for n > 9. -/
theorem recurrence (n : ℕ) (hn : 9 < n) : (a n : ℤ) = 9 * a (n - 1) - 36 * a (n - 2) + 84 * a (n -
    3) - 126 * a (n - 4) + 126 * a (n - 5) - 84 * a (n - 6) + 36 * a (n - 7) - 9 * a (n - 8) + a
    (n - 9) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 10 := ⟨n - 10, by omega⟩
  rw [show k + 10 = (k + 9) + 1 from rfl, show k + 9 + 1 - 1 = (k + 8) + 1 by omega, show k + 9 +
    1 - 2 = (k + 7) + 1 by omega, show k + 9 + 1 - 3 = (k + 6) + 1 by omega, show k + 9 + 1 - 4 =
    (k + 5) + 1 by omega, show k + 9 + 1 - 5 = (k + 4) + 1 by omega, show k + 9 + 1 - 6 = (k + 3) +
    1 by omega, show k + 9 + 1 - 7 = (k + 2) + 1 by omega, show k + 9 + 1 - 8 = (k + 1) + 1 by
    omega, show k + 9 + 1 - 9 = k + 1 by omega]
  simp only [a_T]
  exact T_rec k

