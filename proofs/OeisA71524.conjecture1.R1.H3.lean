namespace A71524Data

def lowerCodes (shift : ℕ) : List ℕ := if shift = 0 then lowerCodes0 else lowerCodes1
def upperCodes (shift : ℕ) : List ℕ := if shift = 0 then upperCodes0 else upperCodes1

def row (shift i : ℕ) : List ℕ := unpack (i+1) ((lowerCodes shift)[i]?.getD 0)
def cols (shift : ℕ) : List (List ℕ) := columns (upperCodes shift)
def offset (shift : ℕ) : ℕ := if shift = 0 then 1 else 3

def want (shift i j : ℕ) : ℕ :=
  if A71524Prime.primeB ((2*permNat shift i+offset shift)^2+(2*j+2)^2) = true then 1 else 0

def rowValid (shift i : ℕ) : Bool := A71524Dot.checkCols 173 (row shift i) (want shift i) 0 (cols shift)

def lowerMat (shift : ℕ) : Matrix (Fin 200) (Fin 200) (ZMod 173) :=
  A71524Assembly.lower (fun i => row shift i.val)
def upperMat (shift : ℕ) : Matrix (Fin 200) (Fin 200) (ZMod 173) :=
  A71524Assembly.upper (cols shift)

lemma upperCodes_length (shift : ℕ) : (upperCodes shift).length = 200 := by
  unfold upperCodes
  split <;> rfl

lemma cols_length (shift : ℕ) : (cols shift).length = 200 := by
  rw [cols, columns_length, upperCodes_length]

lemma row_length (shift i : ℕ) : (row shift i).length = i+1 := by
  exact unpack_length _ _

lemma cols_index_length (shift : ℕ) (j : Fin 200) :
    ((cols shift)[j.val]?.getD []).length = j.val+1 := by
  apply columns_get_length
  rw [upperCodes_length]
  exact j.isLt

set_option maxRecDepth 100000 in
set_option maxHeartbeats 10000000 in
def diagonal0 : ∀ i : Fin 200, lowerMat 0 i i ≠ 0 ∧ upperMat 0 i i ≠ 0 := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 10000000 in
def diagonal1 : ∀ i : Fin 200, lowerMat 1 i i ≠ 0 ∧ upperMat 1 i i ≠ 0 := by
  decide +kernel

lemma want_cast (shift i j : ℕ) :
    (want shift i j : ZMod 173) =
      if ((2*permNat shift i+offset shift)^2+(2*j+2)^2).Prime then 1 else 0 := by
  simp only [want, A71524Prime.primeB_iff]
  split_ifs <;> rfl

lemma wanted_even :
    A71524Assembly.wanted (p:=173) (fun i : Fin 200 => want 0 i.val) =
      ((A71524Parity.evenBlock 200).map (fun x => (x : ZMod 173))).submatrix sigmaEven id := by
  ext i j
  change (want 0 i.val j.val : ZMod 173) = _
  rw [want_cast]
  simp only [Matrix.submatrix_apply, Matrix.map_apply, A71524Parity.evenBlock,
    sigmaEven_val, id_eq, offset, if_pos rfl]
  split_ifs <;> rfl

lemma wanted_odd :
    A71524Assembly.wanted (p:=173) (fun i : Fin 200 => want 1 i.val) =
      ((A71524Parity.oddBlock 200).map (fun x => (x : ZMod 173))).submatrix sigmaOdd id := by
  ext i j
  change (want 1 i.val j.val : ZMod 173) = _
  rw [want_cast]
  simp only [Matrix.submatrix_apply, Matrix.map_apply, A71524Parity.oddBlock,
    sigmaOdd_val, id_eq, offset, if_neg (by decide : ¬(1 : ℕ)=0)]
  split_ifs <;> rfl

def evenCertificate (hcheck : ∀ i : Fin 200, rowValid 0 i.val = true) :
    A71524Assembly.ModularLU (A71524Parity.evenBlock 200) 15 where
  perm := sigmaEven
  lower := lowerMat 0
  upper := upperMat 0
  fixes_tail := sigmaEven_tail
  product_eq := by
    rw [← wanted_even]
    exact A71524Assembly.matrix_eq_mul_of_triangular_lengths
      (fun i : Fin 200 => row 0 i.val) (cols 0) (fun i : Fin 200 => want 0 i.val)
      (cols_length 0) (fun i => (row_length 0 i.val).le)
      (fun j => (cols_index_length 0 j).le) hcheck
  is_lower := A71524Assembly.lower_triangular _ (fun i => (row_length 0 i.val).le)
  is_upper := A71524Assembly.upper_triangular _ (fun j => (cols_index_length 0 j).le)
  lower_diag := fun i => (diagonal0 i).1
  upper_diag := fun i => (diagonal0 i).2

def oddCertificate (hcheck : ∀ i : Fin 200, rowValid 1 i.val = true) :
    A71524Assembly.ModularLU (A71524Parity.oddBlock 200) 14 where
  perm := sigmaOdd
  lower := lowerMat 1
  upper := upperMat 1
  fixes_tail := sigmaOdd_tail
  product_eq := by
    rw [← wanted_odd]
    exact A71524Assembly.matrix_eq_mul_of_triangular_lengths
      (fun i : Fin 200 => row 1 i.val) (cols 1) (fun i : Fin 200 => want 1 i.val)
      (cols_length 1) (fun i => (row_length 1 i.val).le)
      (fun j => (cols_index_length 1 j).le) hcheck
  is_lower := A71524Assembly.lower_triangular _ (fun i => (row_length 1 i.val).le)
  is_upper := A71524Assembly.upper_triangular _ (fun j => (cols_index_length 1 j).le)
  lower_diag := fun i => (diagonal1 i).1
  upper_diag := fun i => (diagonal1 i).2

theorem conditional_solution
    (he : ∀ i : Fin 200, rowValid 0 i.val = true)
    (ho : ∀ i : Fin 200, rowValid 1 i.val = true) :
    OMA.R_OeisA71524_conjecture1_R1.H3 :=
  A71524Assembly.H3_of_two_certificates (evenCertificate he) (oddCertificate ho)

end A71524Data

