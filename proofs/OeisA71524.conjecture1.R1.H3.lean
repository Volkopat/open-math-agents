namespace A71524Prime

def noDivs (n : ℕ) : ℕ → ℕ → Bool
  | _, 0 => true
  | d, r+1 => (n % d != 0) && noDivs n (d+1) r

lemma noDivs_iff (n d r : ℕ) : noDivs n d r = true ↔
    ∀ m, d ≤ m → m < d+r → ¬m ∣ n := by
  induction r generalizing d with
  | zero =>
    simp only [noDivs, Nat.add_zero, true_iff]
    intro m hm hlt
    omega
  | succ r ih =>
    rw [noDivs, Bool.and_eq_true, bne_iff_ne, ih]
    constructor
    · rintro ⟨hd, hr⟩ m hm hmr
      by_cases hmd : m = d
      · subst m
        exact fun h => hd (Nat.mod_eq_zero_of_dvd h)
      · exact hr m (by omega) (by omega)
    · intro h
      constructor
      · intro hd
        exact h d le_rfl (by omega) (Nat.dvd_of_mod_eq_zero hd)
      · intro m hm hmr
        exact h m (by omega) (by omega)

def primeB (n : ℕ) : Bool := decide (2 ≤ n) && noDivs n 2 (Nat.sqrt n - 1)

lemma primeB_iff (n : ℕ) : primeB n = true ↔ n.Prime := by
  rw [primeB, Bool.and_eq_true, decide_eq_true_eq, noDivs_iff, Nat.prime_def_le_sqrt]
  constructor
  · rintro ⟨hn,h⟩
    have hs : 1 ≤ Nat.sqrt n := Nat.le_sqrt.mpr (by omega)
    exact ⟨hn, fun m hm hms => h m hm (by omega)⟩
  · rintro ⟨hn,h⟩
    have hs : 1 ≤ Nat.sqrt n := Nat.le_sqrt.mpr (by omega)
    exact ⟨hn, fun m hm hms => h m hm (by omega)⟩

end A71524Prime


namespace A71524Data

def unpack : Nat → Nat → List Nat
  | 0, _ => []
  | r+1, a => a % 173 :: unpack r (a / 173)

def columns (codes : List Nat) : List (List Nat) :=
  codes.zipIdx.map (fun (c,j) => unpack (j+1) c)

@[simp] theorem unpack_length (r a : Nat) : (unpack r a).length = r := by
  induction r generalizing a with
  | zero => rfl
  | succ r ih => simp [unpack, ih]

@[simp] theorem columns_length (codes : List Nat) : (columns codes).length = codes.length := by
  simp [columns]

theorem columns_get_length (codes : List Nat) (j : Nat) (hj : j < codes.length) :
    ((columns codes)[j]?.getD []).length = j+1 := by
  simp [columns, List.getElem?_zipIdx, List.getElem?_eq_getElem hj, unpack_length]

end A71524Data

