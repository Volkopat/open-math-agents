import OMAReductions.R_OeisA71524_conjecture1_R1
import Mathlib


namespace A71524LeadingLU
open Matrix

variable {R : Type*} {m N : ℕ}

def leading (h : m ≤ N) (A : Matrix (Fin N) (Fin N) R) : Matrix (Fin m) (Fin m) R :=
  A.submatrix (Fin.castLE h) (Fin.castLE h)

lemma leading_mul [Semiring R] (h : m ≤ N)
    (L U : Matrix (Fin N) (Fin N) R) (hL : L.IsLowerTriangular) :
    leading h (L*U) = leading h L * leading h U := by
  classical
  ext i j
  simp only [leading, Matrix.submatrix_apply, Matrix.mul_apply]
  let e : Fin m → Fin N := Fin.castLE h
  let f : Fin N → R := fun k => L (e i) k * U k (e j)
  change (∑ k : Fin N, f k) = ∑ k : Fin m, f (e k)
  symm
  calc
    _ = ∑ k ∈ Finset.univ.image e, f k := by
      rw [Finset.sum_image]
      intro a ha b hb he
      apply Fin.ext
      exact congrArg (fun z : Fin N => z.val) he
    _ = ∑ k : Fin N, f k := by
      apply Finset.sum_subset (Finset.subset_univ _)
      intro k hk hnot
      have hkm : m ≤ k.val := by
        by_contra hn
        apply hnot
        apply Finset.mem_image.mpr
        refine ⟨⟨k.val, by omega⟩, Finset.mem_univ _, ?_⟩
        apply Fin.ext
        rfl
      have hz : L (e i) k = 0 := hL (by
        change (e i).val < k.val
        change i.val < k.val
        omega)
      simp [f, hz]

lemma leading_lower [Zero R] (h : m ≤ N)
    (L : Matrix (Fin N) (Fin N) R) (hL : L.IsLowerTriangular) :
    (leading h L).IsLowerTriangular := by
  intro i j hij
  exact hL (by exact hij)

lemma leading_upper [Zero R] (h : m ≤ N)
    (U : Matrix (Fin N) (Fin N) R) (hU : U.IsUpperTriangular) :
    (leading h U).IsUpperTriangular := by
  intro i j hij
  exact hU (by exact hij)

lemma det_leading_LU_ne_zero [CommRing R] [IsDomain R] (h : m ≤ N)
    (A L U : Matrix (Fin N) (Fin N) R)
    (hA : A = L*U) (hL : L.IsLowerTriangular) (hU : U.IsUpperTriangular)
    (hLd : ∀ i, L i i ≠ 0) (hUd : ∀ i, U i i ≠ 0) :
    (leading h A).det ≠ 0 := by
  rw [hA, leading_mul h L U hL, Matrix.det_mul,
    Matrix.det_of_isLowerTriangular _ (leading_lower h L hL),
    Matrix.det_of_isUpperTriangular (leading_upper h U hU)]
  apply mul_ne_zero
  · exact Finset.prod_ne_zero_iff.mpr (fun i _ => hLd (Fin.castLE h i))
  · exact Finset.prod_ne_zero_iff.mpr (fun i _ => hUd (Fin.castLE h i))

end A71524LeadingLU


namespace A71524Prefix

def leading {R : Type*} {N m : ℕ} (hm : m ≤ N)
    (A : Matrix (Fin N) (Fin N) R) : Matrix (Fin m) (Fin m) R :=
  A.submatrix (Fin.castLE hm) (Fin.castLE hm)

lemma perm_lt_of_fix_tail {N b m : ℕ} (σ : Equiv.Perm (Fin N))
    (hfix : ∀ i : Fin N, b ≤ i.val → σ i = i) (hbm : b ≤ m)
    (i : Fin N) (hi : i.val < m) : (σ i).val < m := by
  by_contra h
  have ht : b ≤ (σ i).val := by omega
  have he : σ i = i := σ.injective (hfix (σ i) ht)
  rw [he] at h
  omega

noncomputable def restrictPerm {N b m : ℕ} (σ : Equiv.Perm (Fin N))
    (hfix : ∀ i : Fin N, b ≤ i.val → σ i = i) (hbm : b ≤ m) (hm : m ≤ N) :
    Equiv.Perm (Fin m) := by
  let f : Fin m → Fin m := fun i =>
    ⟨(σ (Fin.castLE hm i)).val, perm_lt_of_fix_tail σ hfix hbm _ i.isLt⟩
  apply Equiv.ofBijective f
  apply Finite.injective_iff_bijective.mp
  intro i j hij
  apply Fin.ext
  have hσ : σ (Fin.castLE hm i) = σ (Fin.castLE hm j) :=
    Fin.ext (congrArg (fun x : Fin m => x.val) hij)
  exact congrArg (fun x : Fin N => x.val) (σ.injective hσ)

lemma leading_permute {R : Type*} {N b m : ℕ} (A : Matrix (Fin N) (Fin N) R)
    (σ : Equiv.Perm (Fin N)) (hfix : ∀ i : Fin N, b ≤ i.val → σ i = i)
    (hbm : b ≤ m) (hm : m ≤ N) :
    leading hm (A.submatrix σ id) =
      (leading hm A).submatrix (restrictPerm σ hfix hbm hm) id := by
  ext i j
  rfl

theorem leading_det_ne_zero_of_permute {R : Type*} [CommRing R] {N b m : ℕ}
    (A : Matrix (Fin N) (Fin N) R) (σ : Equiv.Perm (Fin N))
    (hfix : ∀ i : Fin N, b ≤ i.val → σ i = i) (hbm : b ≤ m) (hm : m ≤ N)
    (hne : (leading hm (A.submatrix σ id)).det ≠ 0) :
    (leading hm A).det ≠ 0 := by
  intro hz
  apply hne
  rw [leading_permute A σ hfix hbm hm, Matrix.det_permute, hz, mul_zero]

theorem int_det_ne_zero_of_zmod {N p : ℕ} (A : Matrix (Fin N) (Fin N) ℤ)
    (hne : (A.map (fun x => (x : ZMod p))).det ≠ 0) : A.det ≠ 0 := by
  intro hz
  apply hne
  rw [← Int.cast_det, hz, Int.cast_zero]

end A71524Prefix



/-! Public parity helper copied from the registered R1 reduction. Credit: @Medrov, upstreamPR14054, commitf893ab34acb6699a5c611cd17bc1cb164d68bbbc.
The finite-range bridge below adds only the exact29..401 case bookkeeping. -/
namespace A71524Parity
open Matrix

theorem blocks (m : ℕ) :
    |OeisA71524.a (2*m)| = Matrix.det (fun (i j : Fin m) => if ((2*i.val+1)^2 + (2*j.val+2)^2).Prime then (1:ℤ) else 0) ^ 2 ∧
    |OeisA71524.a (2*m+1)| = Matrix.det (fun (i j : Fin m) => if ((2*i.val+3)^2 + (2*j.val+2)^2).Prime then (1:ℤ) else 0) ^ 2 := by
  let entry (i j : ℕ) : ℤ := if (i^2 + j^2).Prime then 1 else 0
  have entry_comm (i j : ℕ) : entry i j = entry j i := by simp [entry, add_comm]
  have entry_zero_of_even {i j : ℕ} (h : Even (i^2+j^2)) (hlt : 2 < i^2+j^2) :
      entry i j = 0 := by
    apply if_neg
    intro hp
    have := hp.even_iff.mp h
    omega
  have even_even (i j : ℕ) : entry (2*i+2) (2*j+2) = 0 := by
    refine entry_zero_of_even ?_ ?_
    · exact ⟨2*i^2+4*i+2*j^2+4*j+4, by ring⟩
    · have h : 2 ≤ (2*i+2) := by omega
      have hsq := Nat.pow_le_pow_left h 2
      omega
  have odd_odd (i j : ℕ) : entry (2*i+3) (2*j+1) = 0 := by
    refine entry_zero_of_even ?_ ?_
    · exact ⟨2*i^2+6*i+2*j^2+2*j+5, by ring⟩
    · have h : 3 ≤ (2*i+3) := by omega
      have hsq := Nat.pow_le_pow_left h 2
      omega
  let interleave (m : ℕ) : Fin m ⊕ Fin m ≃ Fin (2*m) := {
    toFun
      | .inl i => ⟨2*i.val, by omega⟩
      | .inr i => ⟨2*i.val+1, by omega⟩
    invFun i := if i.val % 2 = 0 then .inl ⟨i.val/2, by omega⟩ else .inr ⟨i.val/2, by omega⟩
    left_inv s := by cases s with
      | inl i => simp
      | inr i => simp; apply Fin.ext; dsimp; omega
    right_inv i := by
      by_cases h : i.val % 2 = 0
      · simp only [if_pos h]; apply Fin.ext; dsimp; omega
      · simp only [if_neg h]; apply Fin.ext; dsimp; omega }
  let cross (m shift : ℕ) : Matrix (Fin m) (Fin m) ℤ := fun i j =>
    entry (2*i.val + (2*shift+1)) (2*j.val+2)
  let raw (n : ℕ) : Matrix (Fin n) (Fin n) ℤ := fun i j => entry (i.val+1) (j.val+1)
  let surround (m : ℕ) : Fin m ⊕ (Fin 1 ⊕ Fin m) ≃ Option (Fin m ⊕ Fin m) := {
    toFun
      | .inl i => some (.inl i)
      | .inr (.inl _) => none
      | .inr (.inr j) => some (.inr j)
    invFun
      | none => .inr (.inl 0)
      | some (.inl i) => .inl i
      | some (.inr j) => .inr (.inr j)
    left_inv := by
      rintro (i | (j | k))
      · rfl
      · rw [Subsingleton.elim j 0]
      · rfl
    right_inv := by rintro (_ | (i | j)) <;> rfl }
  let around {m : ℕ} (e : Fin m ⊕ Fin m ≃ Fin (2*m)) :=
    ((surround m).trans e.optionCongr).trans (finSuccEquiv (2*m)).symm
  constructor
  ·
    let e := interleave m
    let f := (Equiv.sumComm (Fin m) (Fin m)).trans e
    let b := cross m 0
    let d : Matrix (Fin m) (Fin m) ℤ := fun i j => entry (2*i.val+1) (2*j.val+1)
    have hm : (raw (2*m)).submatrix e f = fromBlocks b d 0 b.transpose := by
      ext i j
      cases i with
      | inl i => cases j with
        | inl j => rfl
        | inr j => rfl
      | inr i => cases j with
        | inl j => exact even_even i.val j.val
        | inr j => exact entry_comm _ _
    change |(raw _).det| = b.det ^ 2
    rw [← abs_det_submatrix_equiv_equiv e f, hm, det_fromBlocks_zero₂₁, det_transpose,
      ← sq, abs_of_nonneg (sq_nonneg _)]
  ·
    let e := around ((Equiv.sumComm (Fin m) (Fin m)).trans (interleave m))
    let f := around (interleave m)
    let b := cross m 1
    let v : Matrix (Fin m) (Fin 1) ℤ := fun i _ => entry (2*i.val+2) 1
    let c : Matrix (Fin 1 ⊕ Fin m) (Fin m) ℤ := fun i j =>
      match i with
      | .inl _ => entry 1 (2*j.val+2)
      | .inr _ => 0
    have hm : (raw (2*m+1)).submatrix e f =
        fromBlocks b 0 c (fromBlocks 1 0 v b.transpose) := by
      ext i j
      rcases i with i | (i | i) <;> rcases j with j | (j | j)
      · rfl
      · exact odd_odd i.val 0
      · exact odd_odd i.val (j.val+1)
      · rfl
      · have : i = j := Subsingleton.elim _ _
        subst j
        change entry 1 1 = (1 : Matrix (Fin 1) (Fin 1) ℤ) i i
        simp [entry, Nat.prime_two]
      · exact (entry_comm _ _).trans (odd_odd j.val 0)
      · exact even_even i.val j.val
      · rfl
      · exact entry_comm _ _
    change |(raw _).det| = b.det ^ 2
    rw [← abs_det_submatrix_equiv_equiv e f, hm, det_fromBlocks_zero₁₂,
      det_fromBlocks_zero₁₂, det_one, one_mul, det_transpose, ← sq,
      abs_of_nonneg (sq_nonneg _)]



theorem finite_range_of_cross_blocks
    (he : ∀ m : ℕ, 15 ≤ m → m ≤ 200 →
      Matrix.det (fun (i j : Fin m) =>
        if ((2*i.val+1)^2 + (2*j.val+2)^2).Prime then (1:ℤ) else 0) ≠ 0)
    (ho : ∀ m : ℕ, 14 ≤ m → m ≤ 200 →
      Matrix.det (fun (i j : Fin m) =>
        if ((2*i.val+3)^2 + (2*j.val+2)^2).Prime then (1:ℤ) else 0) ≠ 0) :
    ∀ n : ℕ, 29 ≤ n → n ≤ 401 → OeisA71524.a n ≠ 0 := by
  intro n hn hu hz
  let m := n/2
  by_cases h : n % 2 = 0
  · have en : n = 2*m := by dsimp [m]; omega
    have hb := (blocks m).1
    rw [← en, hz, abs_zero] at hb
    exact pow_ne_zero 2 (he m (by dsimp [m]; omega) (by dsimp [m]; omega)) hb.symm
  · have en : n = 2*m+1 := by dsimp [m]; omega
    have hb := (blocks m).2
    rw [← en, hz, abs_zero] at hb
    exact pow_ne_zero 2 (ho m (by dsimp [m]; omega) (by dsimp [m]; omega)) hb.symm


def evenBlock (m : ℕ) : Matrix (Fin m) (Fin m) ℤ := fun i j =>
  if ((2*i.val+1)^2+(2*j.val+2)^2).Prime then 1 else 0

def oddBlock (m : ℕ) : Matrix (Fin m) (Fin m) ℤ := fun i j =>
  if ((2*i.val+3)^2+(2*j.val+2)^2).Prime then 1 else 0

lemma evenBlock_prefix {m : ℕ} (hm : m ≤ 200) :
    evenBlock m = (evenBlock 200).submatrix (Fin.castLE hm) (Fin.castLE hm) := rfl

lemma oddBlock_prefix {m : ℕ} (hm : m ≤ 200) :
    oddBlock m = (oddBlock 200).submatrix (Fin.castLE hm) (Fin.castLE hm) := rfl

/-- All hypotheses remain explicit; this is the registered finite-range target. -/
theorem to_H3
    (he : ∀ m : ℕ, 15 ≤ m → m ≤ 200 → (evenBlock m).det ≠ 0)
    (ho : ∀ m : ℕ, 14 ≤ m → m ≤ 200 → (oddBlock m).det ≠ 0) :
    OMA.R_OeisA71524_conjecture1_R1.H3 := by
  exact finite_range_of_cross_blocks he ho

end A71524Parity


namespace A71524Assembly

/-- A checked modular factorization; every needed condition is an explicit proof field. -/
structure ModularLU (A : Matrix (Fin 200) (Fin 200) ℤ) (b : ℕ) where
  perm : Equiv.Perm (Fin 200)
  lower : Matrix (Fin 200) (Fin 200) (ZMod 173)
  upper : Matrix (Fin 200) (Fin 200) (ZMod 173)
  fixes_tail : ∀ i, b ≤ i.val → perm i = i
  product_eq : (A.map (fun x => (x : ZMod 173))).submatrix perm id = lower*upper
  is_lower : lower.IsLowerTriangular
  is_upper : upper.IsUpperTriangular
  lower_diag : ∀ i, lower i i ≠ 0
  upper_diag : ∀ i, upper i i ≠ 0

lemma ModularLU.leading_det_ne_zero {A : Matrix (Fin 200) (Fin 200) ℤ} {b m : ℕ}
    (cert : ModularLU A b) (hbm : b ≤ m) (hm : m ≤ 200) :
    (A.submatrix (Fin.castLE hm) (Fin.castLE hm)).det ≠ 0 := by
  letI : Fact (Nat.Prime 173) := ⟨by norm_num⟩
  apply A71524Prefix.int_det_ne_zero_of_zmod (p := 173)
  change (A71524Prefix.leading hm (A.map (fun x => (x : ZMod 173)))).det ≠ 0
  apply A71524Prefix.leading_det_ne_zero_of_permute _ cert.perm cert.fixes_tail hbm hm
  exact A71524LeadingLU.det_leading_LU_ne_zero hm _ cert.lower cert.upper
    cert.product_eq cert.is_lower cert.is_upper cert.lower_diag cert.upper_diag

/-- Two fully checked factorizations settle precisely the registered finite interval. -/
theorem H3_of_two_certificates
    (evenCert : ModularLU (A71524Parity.evenBlock 200) 15)
    (oddCert : ModularLU (A71524Parity.oddBlock 200) 14) :
    OMA.R_OeisA71524_conjecture1_R1.H3 := by
  apply A71524Parity.to_H3
  · intro m hm hM
    rw [A71524Parity.evenBlock_prefix hM]
    exact evenCert.leading_det_ne_zero hm hM
  · intro m hm hM
    rw [A71524Parity.oddBlock_prefix hM]
    exact oddCert.leading_det_ne_zero hm hM

end A71524Assembly

namespace A71524Dot

def dot : List ℕ → List ℕ → ℕ
  | [], _ => 0
  | _, [] => 0
  | x::xs, y::ys => x*y + dot xs ys

lemma dot_cast_eq_sum {R : Type*} [Semiring R] (N : ℕ) (xs ys : List ℕ)
    (hx : xs.length ≤ N) (hy : ys.length ≤ N) :
    (dot xs ys : R) = ∑ k : Fin N,
      ((xs[k.val]?.getD 0 : ℕ) : R) * ((ys[k.val]?.getD 0 : ℕ) : R) := by
  induction N generalizing xs ys with
  | zero =>
    cases xs with
    | nil => simp [dot]
    | cons x xs => simp at hx
  | succ N ih =>
    cases xs with
    | nil => simp [dot]
    | cons x xs =>
      cases ys with
      | nil => simp [dot]
      | cons y ys =>
        have hx' : xs.length ≤ N := by simpa using hx
        have hy' : ys.length ≤ N := by simpa using hy
        simpa [dot, Fin.sum_univ_succ] using
          congrArg (fun z : R => (x:R)*(y:R)+z) (ih xs ys hx' hy')

lemma sum_eq_of_dot_mod {N p a : ℕ} (xs ys : List ℕ)
    (hx : xs.length ≤ N) (hy : ys.length ≤ N) (h : dot xs ys % p = a) :
    (∑ k : Fin N,
      ((xs[k.val]?.getD 0 : ℕ) : ZMod p) * ((ys[k.val]?.getD 0 : ℕ) : ZMod p)) = a := by
  rw [← dot_cast_eq_sum N xs ys hx hy, ← ZMod.natCast_mod (dot xs ys) p, h]

def checkCols (p : ℕ) (row : List ℕ) (want : ℕ → ℕ) : ℕ → List (List ℕ) → Bool
  | _, [] => true
  | j, col::cols => (dot row col % p == want j) && checkCols p row want (j+1) cols

lemma checkCols_spec (p : ℕ) (row : List ℕ) (want : ℕ → ℕ)
    (start : ℕ) (cols : List (List ℕ))
    (h : checkCols p row want start cols = true) :
    ∀ j : ℕ, j < cols.length → dot row (cols[j]?.getD []) % p = want (start+j) := by
  induction cols generalizing start with
  | nil => simp
  | cons col cols ih =>
    have hh : dot row col % p = want start ∧ checkCols p row want (start+1) cols = true := by
      simpa only [checkCols, Bool.and_eq_true, beq_iff_eq] using h
    intro j hj
    cases j with
    | zero => simpa using hh.1
    | succ j =>
      have hj' : j < cols.length := by simpa using hj
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using ih (start+1) hh.2 j hj'

lemma checkCols_sound {N p : ℕ} (row : List ℕ) (want : ℕ → ℕ)
    (cols : List (List ℕ)) (hlen : cols.length = N)
    (hrow : row.length ≤ N) (hcols : ∀ col ∈ cols, col.length ≤ N)
    (hcheck : checkCols p row want 0 cols = true) (j : Fin N) :
    (∑ k : Fin N,
      ((row[k.val]?.getD 0 : ℕ) : ZMod p) *
        (((cols[j.val]?.getD [])[k.val]?.getD 0 : ℕ) : ZMod p)) = (want j.val : ZMod p) := by
  have hj : j.val < cols.length := by simpa [hlen] using j.isLt
  have hmem : cols[j.val]?.getD [] ∈ cols := by
    rw [List.getElem?_eq_getElem hj, Option.getD_some]
    exact List.getElem_mem hj
  apply sum_eq_of_dot_mod row (cols[j.val]?.getD []) hrow (hcols _ hmem)
  simpa using checkCols_spec p row want 0 cols hcheck j.val hj

lemma checkCols_append (p : ℕ) (row : List ℕ) (want : ℕ → ℕ)
    (start : ℕ) (left right : List (List ℕ)) :
    checkCols p row want start (left++right) =
      (checkCols p row want start left &&
        checkCols p row want (start+left.length) right) := by
  induction left generalizing start with
  | nil => simp [checkCols]
  | cons col cols ih =>
    simp [checkCols, ih, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm, Bool.and_assoc]

end A71524Dot




namespace A71524Assembly

def lower {N p : ℕ} (rows : Fin N → List ℕ) : Matrix (Fin N) (Fin N) (ZMod p) :=
  fun i k => (rows i)[k.val]?.getD 0

def upper {N p : ℕ} (cols : List (List ℕ)) : Matrix (Fin N) (Fin N) (ZMod p) :=
  fun k j => (cols[j.val]?.getD [])[k.val]?.getD 0

def wanted {N p : ℕ} (want : Fin N → ℕ → ℕ) : Matrix (Fin N) (Fin N) (ZMod p) :=
  fun i j => want i j.val

theorem matrix_eq_mul {N p : ℕ} (rows : Fin N → List ℕ) (cols : List (List ℕ))
    (want : Fin N → ℕ → ℕ) (hlen : cols.length = N)
    (hrows : ∀ i, (rows i).length ≤ N) (hcols : ∀ col ∈ cols, col.length ≤ N)
    (hcheck : ∀ i, A71524Dot.checkCols p (rows i) (want i) 0 cols = true) :
    wanted (p:=p) want = lower rows * upper cols := by
  ext i j
  exact (A71524Dot.checkCols_sound (rows i) (want i) cols hlen (hrows i)
    hcols (hcheck i) j).symm

theorem lower_triangular {N p : ℕ} (rows : Fin N → List ℕ)
    (hlen : ∀ i, (rows i).length ≤ i.val+1) :
    (lower (p:=p) rows).IsLowerTriangular := by
  intro i j hij
  change i.val < j.val at hij
  have hz : (rows i)[j.val]? = none := List.getElem?_eq_none (by have := hlen i; omega)
  simp [lower, hz]

theorem upper_triangular {N p : ℕ} (cols : List (List ℕ))
    (hlen : ∀ j : Fin N, (cols[j.val]?.getD []).length ≤ j.val+1) :
    (upper (N:=N) (p:=p) cols).IsUpperTriangular := by
  intro i j hij
  change j.val < i.val at hij
  have hz : (cols[j.val]?.getD [])[i.val]? = none :=
    List.getElem?_eq_none (by have := hlen j; omega)
  simp [upper, hz]

/-- The indexed triangular bounds suffice for every length side condition. -/
theorem matrix_eq_mul_of_triangular_lengths {N p : ℕ}
    (rows : Fin N → List ℕ) (cols : List (List ℕ)) (want : Fin N → ℕ → ℕ)
    (hlen : cols.length = N) (hrows : ∀ i, (rows i).length ≤ i.val+1)
    (hcols : ∀ j : Fin N, (cols[j.val]?.getD []).length ≤ j.val+1)
    (hcheck : ∀ i, A71524Dot.checkCols p (rows i) (want i) 0 cols = true) :
    wanted (p:=p) want = lower rows * upper cols := by
  ext i j
  symm
  apply A71524Dot.sum_eq_of_dot_mod
  · have := hrows i
    have := i.isLt
    omega
  · have := hcols j
    have := j.isLt
    omega
  · simpa using A71524Dot.checkCols_spec p (rows i) (want i) 0 cols (hcheck i)
      j.val (by simpa [hlen] using j.isLt)

end A71524Assembly

namespace A71524Data

def permNat (shift i : Nat) : Nat :=
  ((if shift = 0 then [0,1,4,2,5,3,7,9,6,8,10,11,12,14,13]
    else [0,1,3,6,4,5,8,9,2,7,10,11,12,13])[i]?).getD i

def sigmaEven : Equiv.Perm (Fin 200) :=
  ((((((Equiv.swap 2 4).trans (Equiv.swap 2 5)).trans (Equiv.swap 2 3)).trans
    (Equiv.swap 6 7)).trans (Equiv.swap 6 9)).trans (Equiv.swap 6 8)).trans
    (Equiv.swap 13 14)

def sigmaOdd : Equiv.Perm (Fin 200) :=
  (((Equiv.swap 2 3).trans (Equiv.swap 2 6)).trans (Equiv.swap 2 8)).trans
    (Equiv.swap 7 9)

lemma swap_fix_tail {N b : ℕ} (a c i : Fin N) (ha : a.val < b) (hc : c.val < b)
    (hi : b ≤ i.val) : Equiv.swap a c i = i := by
  apply Equiv.swap_apply_of_ne_of_ne
  · intro h
    have := congrArg Fin.val h
    omega
  · intro h
    have := congrArg Fin.val h
    omega

theorem sigmaEven_tail (i : Fin 200) (hi : 15 ≤ i.val) : sigmaEven i = i := by
  dsimp only [sigmaEven, Equiv.trans_apply]
  rw [swap_fix_tail 2 4 i (by decide) (by decide) hi,
    swap_fix_tail 2 5 i (by decide) (by decide) hi,
    swap_fix_tail 2 3 i (by decide) (by decide) hi,
    swap_fix_tail 6 7 i (by decide) (by decide) hi,
    swap_fix_tail 6 9 i (by decide) (by decide) hi,
    swap_fix_tail 6 8 i (by decide) (by decide) hi,
    swap_fix_tail 13 14 i (by decide) (by decide) hi]

theorem sigmaOdd_tail (i : Fin 200) (hi : 14 ≤ i.val) : sigmaOdd i = i := by
  dsimp only [sigmaOdd, Equiv.trans_apply]
  rw [swap_fix_tail 2 3 i (by decide) (by decide) hi,
    swap_fix_tail 2 6 i (by decide) (by decide) hi,
    swap_fix_tail 2 8 i (by decide) (by decide) hi,
    swap_fix_tail 7 9 i (by decide) (by decide) hi]

theorem sigmaEven_prefix : ∀ j : Fin 15,
    (sigmaEven (Fin.castLE (by decide) j)).val = permNat 0 j.val := by
  decide +kernel

theorem sigmaOdd_prefix : ∀ j : Fin 14,
    (sigmaOdd (Fin.castLE (by decide) j)).val = permNat 1 j.val := by
  decide +kernel

theorem sigmaEven_val (i : Fin 200) : (sigmaEven i).val = permNat 0 i.val := by
  by_cases hi : i.val < 15
  · exact sigmaEven_prefix ⟨i.val, hi⟩
  · rw [sigmaEven_tail i (by omega)]
    simp only [permNat, if_pos rfl]
    rw [List.getElem?_eq_none (by change 15 ≤ i.val; omega)]
    rfl

theorem sigmaOdd_val (i : Fin 200) : (sigmaOdd i).val = permNat 1 i.val := by
  by_cases hi : i.val < 14
  · exact sigmaOdd_prefix ⟨i.val, hi⟩
  · rw [sigmaOdd_tail i (by omega)]
    simp only [permNat, if_neg (by decide : ¬(1 : ℕ)=0)]
    rw [List.getElem?_eq_none (by change 14 ≤ i.val; omega)]
    rfl

