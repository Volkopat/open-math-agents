import OMAReductions.R_OeisA38552_largestEven_lt_largestOdd_negFundDisc_R1
import Mathlib

-- Step OeisA38552.largestEven_lt_largestOdd_negFundDisc.R1.H2: hypothesis H2 of reduction OeisA38552.largestEven_lt_largestOdd_negFundDisc.R1
-- Credit: @Mapika
-- H2 := ∀ p q d : ℕ, p.Prime → q.Prime → 2 < q → Odd d → IsFundamentalDiscr (-(d : ℤ)) →     4 * q < d →     ∀ x y : ℤ, ¬ (q : ℤ) ∣ x →       x ^ 2 + (d : ℤ) * y ^ 2 = 4 * (q : ℤ) ^ p →       p ∣ classNumberOfDiscriminant (-(d : ℤ))

/-
A primitive solution of x^2 + d y^2 = 4 q^p forces p to divide the class number of Q(sqrt(-d)).

Work in K = Q[X]/(X^2 - D) with D = -d squarefree and negative, theta the root, and sigma the
automorphism theta -> -theta. Put pi = (x + y theta)/2. Then pi + sigma pi = x and
pi * sigma pi = q^p, so pi is integral, and the ideals (pi), (sigma pi) of the ring of
integers are coprime (q does not divide x) with product (q)^p. Unique factorisation of ideals
gives an ideal I with I^p = (pi). If I were principal, generated by alpha, then
alpha * sigma alpha = q; writing 2 alpha = t + c theta with integers t, c (here squarefreeness
of D is used) gives t^2 + d c^2 = 4 q, impossible for 4 q < d and q an odd prime. So the class
of I has order exactly p.
-/

open Polynomial NumberField

namespace OMA.CN

lemma isIntegral_of_quad {R : Type*} [CommRing R] (z : R) (s n : ℤ)
    (h : z ^ 2 - (s : R) * z + (n : R) = 0) : IsIntegral ℤ z := by
  refine ⟨X ^ 2 - C s * X + C n, by monicity!, ?_⟩
  simp only [eval₂_add, eval₂_sub, eval₂_mul, eval₂_pow, eval₂_X, eval₂_C]
  simpa using h

lemma rat_int_of_sq (D : ℤ) (hsq : Squarefree D) (r : ℚ) (m : ℤ)
    (h : (D : ℚ) * r ^ 2 = m) : ∃ c : ℤ, (c : ℚ) = r := by
  have hden : (r.den : ℚ) ≠ 0 := by exact_mod_cast r.den_nz
  have hr : r = (r.num : ℚ) / (r.den : ℚ) := (Rat.num_div_den r).symm
  have h2 : D * r.num ^ 2 = m * (r.den : ℤ) ^ 2 := by
    have h3 : (D : ℚ) * (r.num : ℚ) ^ 2 = m * (r.den : ℚ) ^ 2 := by
      rw [hr] at h
      field_simp at h
      linarith
    exact_mod_cast h3
  have hcop : IsCoprime ((r.den : ℤ) ^ 2) (r.num ^ 2) := by
    apply IsCoprime.pow
    rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_comm]
    have := r.reduced
    simpa [Int.gcd, Nat.Coprime] using this
  have hdvd : ((r.den : ℤ) ^ 2) ∣ D := by
    apply hcop.dvd_of_dvd_mul_right
    exact ⟨m, by linarith⟩
  have hu : IsUnit (r.den : ℤ) := hsq _ (by simpa [sq] using hdvd)
  have hden1 : r.den = 1 := by
    have := Int.isUnit_iff.mp hu
    omega
  exact ⟨r.num, by rw [hr, hden1]; simp⟩

section field
variable (D : ℤ)

lemma th_sq : AdjoinRoot.root (X ^ 2 - C (D : ℚ)) ^ 2
    = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) (D : ℚ) := by
  have h := AdjoinRoot.eval₂_root (X ^ 2 - C (D : ℚ))
  simp only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_C] at h
  exact sub_eq_zero.mp h

noncomputable def sg : AdjoinRoot (X ^ 2 - C (D : ℚ)) →+* AdjoinRoot (X ^ 2 - C (D : ℚ)) :=
  AdjoinRoot.lift (AdjoinRoot.of (X ^ 2 - C (D : ℚ))) (-(AdjoinRoot.root (X ^ 2 - C (D : ℚ))))
    (by simp only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_C, neg_sq, th_sq, sub_self])

lemma sg_root : sg D (AdjoinRoot.root (X ^ 2 - C (D : ℚ))) = -(AdjoinRoot.root (X ^ 2 - C (D : ℚ))) := by
  simp [sg]

lemma sg_of (r : ℚ) : sg D (AdjoinRoot.of (X ^ 2 - C (D : ℚ)) r) = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) r := by
  simp [sg]

lemma repr (z : AdjoinRoot (X ^ 2 - C (D : ℚ))) : ∃ a b : ℚ,
    z = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) a
      + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b * AdjoinRoot.root (X ^ 2 - C (D : ℚ)) := by
  obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective z
  have hm : (X ^ 2 - C (D : ℚ)).Monic := monic_X_pow_sub_C _ two_ne_zero
  have hdiv := modByMonic_add_div g (q := X ^ 2 - C (D : ℚ))
  have hdeg : (g %ₘ (X ^ 2 - C (D : ℚ))).natDegree ≤ 1 := by
    have h1 := natDegree_modByMonic_lt g hm (by
      intro h; have := congrArg natDegree h
      rw [natDegree_X_pow_sub_C, natDegree_one] at this; exact two_ne_zero this)
    rw [natDegree_X_pow_sub_C] at h1
    omega
  obtain ⟨a, b, hab⟩ := exists_eq_X_add_C_of_natDegree_le_one hdeg
  refine ⟨b, a, ?_⟩
  have : AdjoinRoot.mk (X ^ 2 - C (D : ℚ)) g
      = AdjoinRoot.mk (X ^ 2 - C (D : ℚ)) (g %ₘ (X ^ 2 - C (D : ℚ))) := by
    conv_lhs => rw [← hdiv]
    rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
  rw [this, hab]
  simp [add_comm]


lemma mul_sg (a b : ℚ) :
    (AdjoinRoot.of (X ^ 2 - C (D : ℚ)) a
      + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b * AdjoinRoot.root (X ^ 2 - C (D : ℚ)))
    * sg D (AdjoinRoot.of (X ^ 2 - C (D : ℚ)) a
      + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b * AdjoinRoot.root (X ^ 2 - C (D : ℚ)))
    = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) (a ^ 2 - D * b ^ 2) := by
  rw [map_add, map_mul, sg_of, sg_of, sg_root]
  have h := th_sq D
  simp only [map_sub, map_mul, map_pow]
  linear_combination (-(AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b) ^ 2) * h

lemma add_sg (a b : ℚ) :
    (AdjoinRoot.of (X ^ 2 - C (D : ℚ)) a
      + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b * AdjoinRoot.root (X ^ 2 - C (D : ℚ)))
    + sg D (AdjoinRoot.of (X ^ 2 - C (D : ℚ)) a
      + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b * AdjoinRoot.root (X ^ 2 - C (D : ℚ)))
    = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) (2 * a) := by
  rw [map_add, map_mul, sg_of, sg_of, sg_root]
  simp only [map_mul, map_ofNat]
  ring

variable [Fact (Irreducible (X ^ 2 - C (D : ℚ)))]

lemma int_of_of (r : ℚ) (h : IsIntegral ℤ (AdjoinRoot.of (X ^ 2 - C (D : ℚ)) r)) :
    ∃ n : ℤ, (n : ℚ) = r := by
  have h2 : IsIntegral ℤ r := by
    obtain ⟨P, hP, hr⟩ := h
    refine ⟨P, hP, ?_⟩
    apply (AdjoinRoot.of (X ^ 2 - C (D : ℚ))).injective
    rw [map_zero, ← hr, hom_eval₂]
    congr 1
  obtain ⟨n, hn⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2
  exact ⟨n, by simpa using hn⟩


lemma int_coords (hsq : Squarefree D) (z : AdjoinRoot (X ^ 2 - C (D : ℚ))) (hz : IsIntegral ℤ z) :
    ∃ (a b : ℚ) (t c : ℤ), z = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) a
      + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) b * AdjoinRoot.root (X ^ 2 - C (D : ℚ))
      ∧ (t : ℚ) = 2 * a ∧ (c : ℚ) = 2 * b := by
  obtain ⟨a, b, rfl⟩ := repr D z
  have hs := hz.add (map_isIntegral_int (sg D) hz)
  rw [add_sg] at hs
  obtain ⟨t, ht⟩ := int_of_of D _ hs
  have hm := hz.mul (map_isIntegral_int (sg D) hz)
  rw [mul_sg] at hm
  obtain ⟨n, hn⟩ := int_of_of D _ hm
  obtain ⟨c, hc⟩ := rat_int_of_sq D hsq (2 * b) (t ^ 2 - 4 * n) (by
    push_cast
    linear_combination (-((t : ℚ) + 2 * a)) * ht + 4 * hn)
  exact ⟨a, b, t, c, rfl, ht, hc⟩

lemma exists_norm (hD : D ≤ 0) (z : AdjoinRoot (X ^ 2 - C (D : ℚ))) :
    ∃ r : ℚ, 0 ≤ r ∧ AdjoinRoot.of (X ^ 2 - C (D : ℚ)) r = z * sg D z := by
  obtain ⟨a, b, rfl⟩ := repr D z
  have hD' : (D : ℚ) ≤ 0 := by exact_mod_cast hD
  have h0 : 0 ≤ a ^ 2 - D * b ^ 2 := by
    nlinarith [sq_nonneg a, sq_nonneg b, mul_nonneg (neg_nonneg.mpr hD') (sq_nonneg b)]
  exact ⟨a ^ 2 - D * b ^ 2, h0, (mul_sg D a b).symm⟩

lemma exists_int_norm (hD : D ≤ 0) (z : AdjoinRoot (X ^ 2 - C (D : ℚ))) (hz : IsIntegral ℤ z) :
    ∃ n : ℤ, 0 ≤ n ∧ AdjoinRoot.of (X ^ 2 - C (D : ℚ)) (n : ℚ) = z * sg D z := by
  obtain ⟨r, hr0, hr⟩ := exists_norm D hD z
  have hm := hz.mul (map_isIntegral_int (sg D) hz)
  rw [← hr] at hm
  obtain ⟨n, hn⟩ := int_of_of D _ hm
  refine ⟨n, ?_, by rw [hn, hr]⟩
  have : (0 : ℚ) ≤ n := by rw [hn]; exact hr0
  exact_mod_cast this

lemma no_generator (hD : D < 0) (hsq : Squarefree D) (p q : ℕ) (hp : p ≠ 0) (hq : q.Prime)
    (hq2 : 2 < q) (hlt : 4 * (q : ℤ) < -D)
    (α u v π : AdjoinRoot (X ^ 2 - C (D : ℚ))) (hα : IsIntegral ℤ α) (hu : IsIntegral ℤ u)
    (hv : IsIntegral ℤ v) (huv : u * v = 1)
    (hπ : π * sg D π = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) ((q : ℚ) ^ p))
    (h : α ^ p * u = π) : False := by
  have hinj := (AdjoinRoot.of (X ^ 2 - C (D : ℚ))).injective
  obtain ⟨nu, hnu0, hnu⟩ := exists_int_norm D hD.le u hu
  obtain ⟨nv, hnv0, hnv⟩ := exists_int_norm D hD.le v hv
  have huv1 : nu * nv = 1 := by
    have : AdjoinRoot.of (X ^ 2 - C (D : ℚ)) ((nu : ℚ) * nv)
        = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) 1 := by
      rw [map_mul, hnu, hnv, map_one]
      calc u * sg D u * (v * sg D v) = (u * v) * sg D (u * v) := by rw [map_mul]; ring
        _ = 1 := by rw [huv, map_one, mul_one]
    exact_mod_cast hinj this
  have hnu1 : nu = 1 := Int.eq_one_of_dvd_one hnu0 ⟨nv, huv1.symm⟩
  obtain ⟨a, b, t, c, hαeq, ht, hc⟩ := int_coords D hsq α hα
  have hNα : α * sg D α = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) (a ^ 2 - D * b ^ 2) := by
    rw [hαeq, mul_sg]
  have h1 : u * sg D u = 1 := by rw [← hnu, hnu1]; simp
  have hN : (a ^ 2 - D * b ^ 2) ^ p = (q : ℚ) ^ p := by
    apply hinj
    rw [← hπ, ← h, map_pow, ← hNα, map_mul, map_pow]
    calc (α * sg D α) ^ p = (α * sg D α) ^ p * (u * sg D u) := by rw [h1, mul_one]
      _ = α ^ p * u * (sg D α ^ p * sg D u) := by ring
  have hD' : (D : ℚ) ≤ 0 := by exact_mod_cast hD.le
  have hN0 : 0 ≤ a ^ 2 - D * b ^ 2 := by
    nlinarith [sq_nonneg a, sq_nonneg b, mul_nonneg (neg_nonneg.mpr hD') (sq_nonneg b)]
  have hNq : a ^ 2 - D * b ^ 2 = q := (pow_left_inj₀ hN0 (Nat.cast_nonneg q) hp).mp hN
  have hZ : t ^ 2 - D * c ^ 2 = 4 * (q : ℤ) := by
    have : ((t : ℚ)) ^ 2 - D * (c : ℚ) ^ 2 = 4 * (q : ℚ) := by
      rw [ht, hc, ← hNq]; ring
    exact_mod_cast this
  by_cases hc0 : c = 0
  · subst hc0
    have ht2 : t ^ 2 = 4 * (q : ℤ) := by linarith
    have hqp : Prime (q : ℤ) := Nat.prime_iff_prime_int.mp hq
    have hqt : (q : ℤ) ∣ t := hqp.dvd_of_dvd_pow ⟨4, by rw [ht2]; ring⟩
    obtain ⟨s, rfl⟩ := hqt
    have hq0 : (q : ℤ) ≠ 0 := hqp.ne_zero
    have h4 : (q : ℤ) * s ^ 2 = 4 := by
      apply mul_left_cancel₀ hq0
      linarith
    have hq4 : q ∣ 2 * 2 := by
      have : (q : ℤ) ∣ ((2 * 2 : ℕ) : ℤ) := ⟨s ^ 2, by rw [h4]; norm_num⟩
      exact_mod_cast this
    have hq2' : q ∣ 2 := (hq.dvd_mul.mp hq4).elim id id
    have := Nat.le_of_dvd (by norm_num) hq2'
    omega
  · have hc1 : 1 ≤ c ^ 2 := by
      have : 0 < c ^ 2 := by positivity
      linarith
    nlinarith [sq_nonneg t, mul_le_mul_of_nonneg_left hc1 (neg_nonneg.mpr hD.le)]


theorem key (hD : D < 0) (hsq : Squarefree D) (p q : ℕ) (hp : p.Prime) (hq : q.Prime)
    (hq2 : 2 < q) (hlt : 4 * (q : ℤ) < -D) (x y : ℤ) (hqx : ¬ (q : ℤ) ∣ x)
    (heq : x ^ 2 - D * y ^ 2 = 4 * (q : ℤ) ^ p) :
    p ∣ classNumber (AdjoinRoot (X ^ 2 - C (D : ℚ))) := by
  classical
  obtain ⟨π, hπdef⟩ : ∃ π : AdjoinRoot (X ^ 2 - C (D : ℚ)),
      π = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) ((x : ℚ) / 2)
        + AdjoinRoot.of (X ^ 2 - C (D : ℚ)) ((y : ℚ) / 2)
          * AdjoinRoot.root (X ^ 2 - C (D : ℚ)) := ⟨_, rfl⟩
  have hsum : π + sg D π = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) (x : ℚ) := by
    rw [hπdef, add_sg]; congr 1; ring
  have hprod : π * sg D π = AdjoinRoot.of (X ^ 2 - C (D : ℚ)) ((q : ℚ) ^ p) := by
    rw [hπdef, mul_sg]; congr 1
    have : (x : ℚ) ^ 2 - D * (y : ℚ) ^ 2 = 4 * (q : ℚ) ^ p := by exact_mod_cast heq
    linear_combination this / 4
  have hsum' : π + sg D π = ((x : ℤ) : AdjoinRoot (X ^ 2 - C (D : ℚ))) := by
    rw [hsum]; simp
  have hprod' : π * sg D π = (((q : ℤ) ^ p : ℤ) : AdjoinRoot (X ^ 2 - C (D : ℚ))) := by
    rw [hprod]; simp
  have hπint : IsIntegral ℤ π := by
    apply isIntegral_of_quad π x ((q : ℤ) ^ p)
    rw [← hsum', ← hprod']; ring
  have hπbint : IsIntegral ℤ (sg D π) := map_isIntegral_int (sg D) hπint
  obtain ⟨P, hP⟩ : ∃ P : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))),
      algebraMap (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) _ P = π := ⟨⟨π, hπint⟩, rfl⟩
  obtain ⟨Pb, hPb⟩ : ∃ Pb : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))),
      algebraMap (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) _ Pb = sg D π := ⟨⟨sg D π, hπbint⟩, rfl⟩
  have hPsum : P + Pb = ((x : ℤ) : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) := by
    apply RingOfIntegers.coe_injective
    rw [map_add, hP, hPb, hsum']
    exact (map_intCast _ x).symm
  have hPprod : P * Pb = ((q : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) ^ p) := by
    apply RingOfIntegers.coe_injective
    rw [map_mul, hP, hPb, hprod', map_pow, map_natCast]
    push_cast; rfl
  have hcop : Ideal.span {P} ⊔ Ideal.span {Pb} = ⊤ := by
    rw [Ideal.eq_top_iff_one]
    have hc : IsCoprime x ((q : ℤ) ^ p) := by
      apply IsCoprime.pow_right
      exact ((Nat.prime_iff_prime_int.mp hq).coprime_iff_not_dvd.mpr hqx).symm
    obtain ⟨a, b, hab⟩ := hc
    have h1 : (1 : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))))
        = (a : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) * (P + Pb)
          + (b : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) * (P * Pb) := by
      rw [hPsum, hPprod]; exact_mod_cast hab.symm
    rw [h1]
    have hPm : P ∈ Ideal.span {P} ⊔ Ideal.span {Pb} :=
      Ideal.mem_sup_left (Ideal.mem_span_singleton_self P)
    have hPbm : Pb ∈ Ideal.span {P} ⊔ Ideal.span {Pb} :=
      Ideal.mem_sup_right (Ideal.mem_span_singleton_self Pb)
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.add_mem _ hPm hPbm))
      (Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ hPm))
  have hmul : Ideal.span {P} * Ideal.span {Pb}
      = (Ideal.span {(q : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))))}) ^ p := by
    rw [Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_pow, hPprod]
  obtain ⟨I, hI⟩ := exists_associated_pow_of_mul_eq_pow
    (by rw [Ideal.gcd_eq_sup, hcop, ← Ideal.one_eq_top]; exact isUnit_one) hmul
  have hI' : I ^ p = Ideal.span {P} := associated_iff_eq.mp hI
  have hP0 : P ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hPprod
    exact pow_ne_zero p (Nat.cast_ne_zero.mpr hq.ne_zero) hPprod.symm
  have hI0 : I ≠ 0 := by
    intro h0
    rw [h0, zero_pow hp.ne_zero] at hI'
    exact hP0 (Ideal.span_singleton_eq_bot.mp hI'.symm)
  have hImem : I ∈ nonZeroDivisors (Ideal (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))))) :=
    mem_nonZeroDivisors_iff_ne_zero.mpr hI0
  have hSmem : Ideal.span {P} ∈ nonZeroDivisors (Ideal (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))))) :=
    mem_nonZeroDivisors_iff_ne_zero.mpr (fun h => hP0 (Ideal.span_singleton_eq_bot.mp h))
  have hgp : (ClassGroup.mk0 ⟨I, hImem⟩) ^ p = 1 := by
    have h2 : (⟨I, hImem⟩ : nonZeroDivisors (Ideal (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))))) ^ p
        = ⟨Ideal.span {P}, hSmem⟩ := Subtype.ext (by simpa using hI')
    rw [← map_pow, h2, ClassGroup.mk0_eq_one_iff]
    exact ⟨⟨P, rfl⟩⟩
  have hg1 : ClassGroup.mk0 ⟨I, hImem⟩ ≠ 1 := by
    intro h
    rw [ClassGroup.mk0_eq_one_iff] at h
    obtain ⟨α, hα⟩ := h.principal
    have h2 : Ideal.span {α ^ p} = Ideal.span {P} := by
      rw [← Ideal.span_singleton_pow, ← hI', hα]
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp h2
    refine no_generator D hD hsq p q hp.ne_zero hq hq2 hlt
      (algebraMap (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) _ α)
      (algebraMap (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) _ (u : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))))
      (algebraMap (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))) _
        ((u⁻¹ : (𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ))))ˣ) : 𝓞 (AdjoinRoot (X ^ 2 - C (D : ℚ)))))
      π (RingOfIntegers.isIntegral_coe _) (RingOfIntegers.isIntegral_coe _)
      (RingOfIntegers.isIntegral_coe _) ?_ hprod ?_
    · rw [← map_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, map_one]
    · rw [← map_pow, ← map_mul, hu, hP]
  have : Fact p.Prime := ⟨hp⟩
  have hord := orderOf_eq_prime hgp hg1
  unfold classNumber
  rw [← hord]
  exact orderOf_dvd_card

end field

