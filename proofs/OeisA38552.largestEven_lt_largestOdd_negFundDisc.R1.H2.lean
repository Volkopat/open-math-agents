theorem OMA.solution : OMA.R_OeisA38552_largestEven_lt_largestOdd_negFundDisc_R1.H2 := by
  intro p q d hp hq hq2 hodd hfund hlt x y hqx heq
  have hmod : Squarefree (-(d : ℤ)) := by
    rcases hfund with ⟨⟨k, hk⟩, -⟩ | ⟨-, -, h⟩
    · obtain ⟨m, hm⟩ := hodd
      omega
    · exact h
  have hd0 : (-(d : ℤ)) < 0 := by omega
  have hirr : Irreducible (X ^ 2 - C ((-(d : ℤ) : ℤ) : ℚ)) := by
    apply irreducible_of_degree_le_three_of_not_isRoot
    · rw [natDegree_X_pow_sub_C]; decide
    · intro r hr
      have h1 : r ^ 2 - ((-(d : ℤ) : ℤ) : ℚ) = 0 := by simpa [IsRoot] using hr
      have h2 : ((-(d : ℤ) : ℤ) : ℚ) < 0 := by exact_mod_cast hd0
      nlinarith [sq_nonneg r]
  unfold OeisA38552.classNumberOfDiscriminant
