/-- The steps satisfy the recurrence, on one period of the residues. -/
theorem drec_base : ∀ t : ℕ, t < 15 → (dv (t + 8) : ℤ) = (dv (t + 5) : ℤ) + (dv (t + 3) : ℤ) - (dv (t + 0) : ℤ) := by
  decide +kernel

theorem drec (t : ℕ) : (dv (t + 8) : ℤ) = (dv (t + 5) : ℤ) + (dv (t + 3) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 15 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 3, e 5, e 8]
  exact drec_base (t % 15) (Nat.mod_lt _ (by norm_num))

/-- The recurrence on its first 15 terms, by the kernel. -/
theorem recur_base : ∀ q : ℕ, q < 15 → (b (q + 11) : ℤ) = b (q + 8) + b (q + 6) - b (q + 3) := by
  decide +kernel

theorem b_recur (q : ℕ) : (b (q + 11) : ℤ) = b (q + 8) + b (q + 6) - b (q + 3) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 15 ∨ 15 ≤ q by omega) with hq | hq
    · exact recur_base q hq
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 15 := ⟨q - 15, by omega⟩
      have h0 : (b (v + 11) : ℤ) = b (v + 8) + b (v + 6) - b (v + 3) := ih (v + 0) (by omega)
      have s3 : b (v + 18) = b (v + 3) + dv (v + 0) := by
        have h := b_step (v + 3) (by omega)
        rw [show v + 3 + 15 = v + 18 by omega,
          show v + 3 - 3 = v + 0 by omega] at h
        exact h
      have s6 : b (v + 21) = b (v + 6) + dv (v + 3) := by
        have h := b_step (v + 6) (by omega)
        rw [show v + 6 + 15 = v + 21 by omega,
          show v + 6 - 3 = v + 3 by omega] at h
        exact h
      have s8 : b (v + 23) = b (v + 8) + dv (v + 5) := by
        have h := b_step (v + 8) (by omega)
        rw [show v + 8 + 15 = v + 23 by omega,
          show v + 8 - 3 = v + 5 by omega] at h
        exact h
      have s11 : b (v + 26) = b (v + 11) + dv (v + 8) := by
        have h := b_step (v + 11) (by omega)
        rw [show v + 11 + 15 = v + 26 by omega,
          show v + 11 - 3 = v + 8 by omega] at h
        exact h
      have hd := drec v
      show (b (v + 26) : ℤ) = b (v + 23) + b (v + 21) - b (v + 18)
      omega

/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 10 < n → (a n : ℤ) = a (n - 3) + a (n - 5) - a (n - 8) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 11 := ⟨n - 11, by omega⟩
  rw [show q + 11 - 3 = q + 8 by omega, show q + 11 - 5 = q + 6 by omega, show q + 11 - 8 = q + 3 by omega]
  simp only [a_eq_b]
  exact b_recur q

/-- The coefficients of the g.f. below 11, by the kernel. -/
theorem gf_base : ∀ n : ℕ, n < 11 → 1 * (b n : ℤ) - 1 * (if 3 ≤ n then (b (n - 3) : ℤ) else 0) - 1 * (if 5 ≤ n then (b (n - 5) : ℤ) else 0) + 1 * (if 8 ≤ n then (b (n - 8) : ℤ) else 0) = (if n = 0 then (1 : ℤ) else 0) + (if n = 1 then (1 : ℤ) else 0) * 4 + (if n = 2 then (1 : ℤ) else 0) * 9 + (if n = 3 then (1 : ℤ) else 0) * 13 + (if n = 4 then (1 : ℤ) else 0) * 15 + (if n = 5 then (1 : ℤ) else 0) * 15 + (if n = 6 then (1 : ℤ) else 0) * 10 + (if n = 7 then (1 : ℤ) else 0) * 5 + (if n = 8 then (1 : ℤ) else 0) * 2 - (if n = 9 then (1 : ℤ) else 0) * 1 - (if n = 10 then (1 : ℤ) else 0) * 1 := by
  decide +kernel

open PowerSeries in
/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * (X ^ 8 - X ^ 5 - X ^ 3 + 1) =
      (X + 1) ^ 2 * (X ^ 2 + 1) * (-X ^ 6 + X ^ 5 + 2 * X ^ 4 + X ^ 3 + 3 * X ^ 2 + 2 * X + 1) := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  have e1 : A * (X ^ 8 - X ^ 5 - X ^ 3 + 1) = C 1 * A - C 1 * (A * X ^ 3) - C 1 * (A * X ^ 5) + C 1 * (A * X ^ 8) := by
    simp only [map_one]
    ring
  have e2 : ((X + 1) ^ 2 * (X ^ 2 + 1) * (-X ^ 6 + X ^ 5 + 2 * X ^ 4 + X ^ 3 + 3 * X ^ 2 + 2 * X + 1) : ℚ⟦X⟧) = C 1 + X ^ 1 * C 4 + X ^ 2 * C 9 + X ^ 3 * C 13 + X ^ 4 * C 15 + X ^ 5 * C 15 + X ^ 6 * C 10 + X ^ 7 * C 5 + X ^ 8 * C 2 - X ^ 9 * C 1 - X ^ 10 * C 1 := by
    simp only [map_ofNat, map_one]
    ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = (b k : ℚ) := fun k => by rw [hA, coeff_mk, a_eq_b]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow',
    coeff_C, hc]
  rcases Nat.lt_or_ge n 11 with hn | hn
  · have h := congrArg (fun z : ℤ => (z : ℚ)) (gf_base n hn)
    push_cast at h
    linarith
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 11 := ⟨n - 11, by omega⟩
    have h : (b (q + 11) : ℤ) = b (q + 8) + b (q + 6) - b (q + 3) := b_recur (q + 0)
    have hq := congrArg (fun z : ℤ => (z : ℚ)) h
    push_cast at hq
    simp only [show q + 11 - 3 = q + 8 by omega, show q + 11 - 5 = q + 6 by omega, show q + 11 - 8 = q + 3 by omega, show 3 ≤ q + 11 by omega, show 5 ≤ q + 11 by omega, show 8 ≤ q + 11 by omega, show ¬ q + 11 = 0 by omega, show ¬ q + 11 = 1 by omega, show ¬ q + 11 = 2 by omega, show ¬ q + 11 = 3 by omega, show ¬ q + 11 = 4 by omega, show ¬ q + 11 = 5 by omega, show ¬ q + 11 = 6 by omega, show ¬ q + 11 = 7 by omega, show ¬ q + 11 = 8 by omega, show ¬ q + 11 = 9 by omega, show ¬ q + 11 = 10 by omega, if_true, if_false]
    linear_combination (1) * hq

