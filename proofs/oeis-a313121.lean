def smallL : List V := smallV.map Prod.fst

theorem smallV_ok : (smallV.all fun q => decide (F q.1 = q.2)) = true := by
  decide +kernel

/-- The potentials, packed: Ac = ATV - 3, Bc = BTV - 3. -/
def ATV (k : ℕ) : ℕ := ctabN 43477128 3 k

def ATN (k : ℕ) : ℤ := (ATV k : ℤ) - 3

def AT (i : Fin 10) : ℤ := ATN i.val

def BTV (k : ℕ) : ℕ := ctabN 651862017 3 k

def BTN (k : ℕ) : ℤ := (BTV k : ℤ) - 3

def BT (i : Fin 10) : ℤ := BTN i.val

theorem AB_eq : ∀ i : Fin 10, AT i = Ac i ∧ BT i = Bc i := by
  decide +kernel

/-- Some potential exceeds 7 at the box point ((a : ℤ) - 3, (b : ℤ) - 3, s), in natural
numbers: the negative terms moved across. -/
def bigNat (a b s : ℕ) : Bool :=
  (List.range 10).any fun i =>
    Nat.blt (11 + ATV i * 3 + 3 * a + BTV i * 3 + 3 * b)
      (ATV i * a + 9 + BTV i * b + 9 + cTV (i + 10 * s))

theorem big_pot (a b : ℕ) (s : Fin 8) (h : bigNat a b s.val = true) :
    (7 : ℤ) < F ((a : ℤ) - 3, (b : ℤ) - 3, s) := by
  obtain ⟨i, hi, hb⟩ := List.any_eq_true.1 h
  rw [List.mem_range] at hi
  have hl := (Nat.cast_lt (α := ℤ)).mpr (Nat.blt_eq.mp hb)
  have hp := le_F ((a : ℤ) - 3, (b : ℤ) - 3, s) ⟨i, hi⟩
  obtain ⟨eA, eB⟩ := AB_eq ⟨i, hi⟩
  have e3 := cT_eq s ⟨i, hi⟩
  simp only [pot] at hp
  rw [← eA, ← eB, ← e3] at hp
  simp only [AT, BT, ATN, BTN, cT, cTN] at hp
  push_cast at hl hp
  ring_nf at hl hp ⊢
  linarith

def smallOK : Bool :=
  (List.range 7).all fun a => (List.range 7).all fun b => (List.finRange 8).all fun s =>
    bigNat a b s.val || decide (((a : ℤ) - 3, (b : ℤ) - 3, s) ∈ smallL)

theorem smallOK_eq : smallOK = true := by
  decide +kernel

theorem small_mem (v : V) (hF : F v ≤ 7) : v ∈ smallL := by
  obtain ⟨x, y, s⟩ := v
  obtain ⟨hx1, hx2, hy1, hy2⟩ := small_box x y s hF
  have h := smallOK_eq
  unfold smallOK at h
  simp only [List.all_eq_true, List.mem_range, List.mem_finRange, forall_const] at h
  have h' := h (x + 3).toNat (by omega) (y + 3).toNat (by omega) s
  have ex : (((x + 3).toNat : ℕ) : ℤ) - 3 = x := by omega
  have ey : (((y + 3).toNat : ℕ) : ℤ) - 3 = y := by omega
  simp only [Bool.or_eq_true, decide_eq_true_eq] at h'
  rcases h' with h1 | h1
  · have := big_pot _ _ s h1
    rw [ex, ey] at this
    omega
  · rw [ex, ey] at h1
    exact h1

theorem cnt_small (n : ℤ) (hn : n ≤ 7) :
    cnt n = (((smallV.filter (fun q => decide (q.2 = n))).map Prod.fst).toFinset).card := by
  rw [cnt, ← Set.ncard_coe_finset]
  congr 1
  ext v
  have hv := smallV_ok
  simp only [List.all_eq_true, decide_eq_true_eq] at hv
  simp only [Set.mem_ofPred_eq, List.coe_toFinset, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · intro h
    obtain ⟨q, hq, rfl⟩ := List.mem_map.1 (small_mem v (by omega))
    exact ⟨q, ⟨hq, by rw [← hv q hq]; exact h⟩, rfl⟩
  · rintro ⟨q, ⟨hq, h2⟩, rfl⟩
    rw [hv q hq]
    exact h2

/-- The small spheres from 3 on, in closed form. -/
theorem small_ok : ∀ n : ℕ, 3 ≤ n → n < 8 →
    (((smallV.filter (fun q => decide (q.2 = (n : ℤ)))).map Prod.fst).toFinset).card = b n := by
  decide +kernel

/-! ## The coordination sequence

`a n` counts the level set F = n from n = 3 on (`a_eq_cnt`, from `a_eq_F`), and `small_vals`
lists the terms below 3. The terms from 3 to 7 are counted in `smallL`, those from 8 on
are S(n), and all agree with the closed form b (`a_eq_b`). The step from n to n + 15, the closed form
per residue (`a_closed`), the controls, the recurrence and the g.f. follow, their base cases checked by
the kernel on b. -/

theorem a_eq_cnt (n : ℕ) (hn : 3 ≤ n) : a n = cnt n := by
  rw [a_eq_F n hn, cnt]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq]
  have := F_nonneg v
  omega

theorem a_eq_S (n : ℕ) (hn : 8 ≤ n) : (a n : ℤ) = S n := by
  rw [a_eq_cnt n (by omega)]
  exact cnt_eq_S n (by exact_mod_cast hn)

theorem a_lt_R0 (n : ℕ) (hn : n < 3) : a n = b n := by
  have h : (List.range 3).map a = (List.range 3).map b := by
    rw [small_vals]
    decide +kernel
  exact List.map_inj_left.1 h n (List.mem_range.2 hn)

/-- The coordination sequence in closed form. -/
theorem a_eq_b (n : ℕ) : a n = b n := by
  rcases (show n < 3 ∨ (3 ≤ n ∧ n < 8) ∨ 8 ≤ n by omega) with h | ⟨h1, h2⟩ | h
  · exact a_lt_R0 n h
  · rw [a_eq_cnt n h1, cnt_small _ (by omega)]
    exact small_ok n h1 h2
  · have h1 := a_eq_S n h
    rw [S_eq_b n h] at h1
    exact_mod_cast h1

theorem dconst_base : ∀ r : ℕ, r < 15 → dtabV r = 72 := by
  decide +kernel
theorem dv_const : ∀ t : ℕ, dv t = 72 := by
  intro t
  rw [dv]
  exact dconst_base _ (Nat.mod_lt _ (by norm_num))

/-- The step a(n + 15) = a(n) + 72 for n ≥ 3. -/
theorem a_step (n : ℕ) (hn : 3 ≤ n) : a (n + 15) = a n + 72 := by
  rw [a_eq_b, a_eq_b, b_step n hn, dv_const]

/-- The steps and the values on one period, by the kernel. -/
theorem closed_vals : dv 0 = 72 ∧ tblV 0 = 14 ∧ dv 1 = 72 ∧ tblV 1 = 19 ∧ dv 2 = 72 ∧ tblV 2 = 25 ∧ dv 3 = 72 ∧ tblV 3 = 28 ∧ dv 4 = 72 ∧ tblV 4 = 33 ∧ dv 5 = 72 ∧ tblV 5 = 40 ∧ dv 6 = 72 ∧ tblV 6 = 42 ∧ dv 7 = 72 ∧ tblV 7 = 48 ∧ dv 8 = 72 ∧ tblV 8 = 54 ∧ dv 9 = 72 ∧ tblV 9 = 56 ∧ dv 10 = 72 ∧ tblV 10 = 63 ∧ dv 11 = 72 ∧ tblV 11 = 68 ∧ dv 12 = 72 ∧ tblV 12 = 71 ∧ dv 13 = 72 ∧ tblV 13 = 77 ∧ dv 14 = 72 ∧ tblV 14 = 82 := by
  decide +kernel

/-- The closed form per residue of n mod 15, for n ≥ 3. -/
theorem a_closed (k : ℕ) :
    a (15 * k + 3) = 72 * k + 14 ∧
    a (15 * k + 4) = 72 * k + 19 ∧
    a (15 * k + 5) = 72 * k + 25 ∧
    a (15 * k + 6) = 72 * k + 28 ∧
    a (15 * k + 7) = 72 * k + 33 ∧
    a (15 * k + 8) = 72 * k + 40 ∧
    a (15 * k + 9) = 72 * k + 42 ∧
    a (15 * k + 10) = 72 * k + 48 ∧
    a (15 * k + 11) = 72 * k + 54 ∧
    a (15 * k + 12) = 72 * k + 56 ∧
    a (15 * k + 13) = 72 * k + 63 ∧
    a (15 * k + 14) = 72 * k + 68 ∧
    a (15 * k + 15) = 72 * k + 71 ∧
    a (15 * k + 16) = 72 * k + 77 ∧
    a (15 * k + 17) = 72 * k + 82 := by
  obtain ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29⟩ := closed_vals
  simp only [a_eq_b]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [show 15 * k + 3 = 15 * k + (3 + 0) from rfl, b_res k 0 (by norm_num), c0, c1]
  · rw [show 15 * k + 4 = 15 * k + (3 + 1) from rfl, b_res k 1 (by norm_num), c2, c3]
