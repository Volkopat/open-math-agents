import OMAReductions.R_OeisA233566_conjecture_1_R1

/-!
Kernel verification of the positive terms in Sun's published finite table.
For every input the certificate gives a prime p and a list of prime factors
of n-p. Their product and totient are computed together. Trial division stops
as soon as the trial divisor exceeds the square root; running out of fuel
rejects a certificate. No conjectural primality test is used.
-/
namespace OMA.SunFinite

private def trial (n : ℕ) : ℕ → ℕ → Bool
  | 0, _ => false
  | k+1, d => if n < d*d then true else (n % d != 0) && trial n k (d+1)

private theorem trial_sound {n k d : ℕ} (h : trial n k d = true) :
    ∀ m, d ≤ m → m ≤ n.sqrt → ¬ m ∣ n := by
  induction k generalizing d with
  | zero => simp [trial] at h
  | succ k ih =>
    intro m hm hs
    by_cases hd : n < d*d
    · have := Nat.sqrt_lt.mpr hd
      omega
    · simp only [trial,if_neg hd,Bool.and_eq_true,bne_iff_ne] at h
      rcases eq_or_lt_of_le hm with rfl | hlt
      · exact fun hn => h.1 (Nat.mod_eq_zero_of_dvd hn)
      · exact ih h.2 _ hlt hs

private def test (n : ℕ) := decide (2 ≤ n) && trial n 820 2
private theorem prime_of_test {n : ℕ} (h : test n = true) : n.Prime := by
  simp only [test,Bool.and_eq_true,decide_eq_true_eq] at h
  exact Nat.prime_def_le_sqrt.mpr ⟨h.1,trial_sound h.2⟩

private def evalFactors : List ℕ → ℕ × ℕ
  | [] => (1,1)
  | p::ps =>
    let v := evalFactors ps
    (p*v.1, (if v.1 % p = 0 then p else p-1)*v.2)

private theorem eval_sound {ps : List ℕ} (h : ps.all test = true) :
    (evalFactors ps).1.totient = (evalFactors ps).2 := by
  induction ps with
  | nil => simp [evalFactors]
  | cons p ps ih =>
    simp only [List.all_cons,Bool.and_eq_true] at h
    have hp := prime_of_test h.1
    simp only [evalFactors]
    by_cases hd : (evalFactors ps).1 % p = 0
    · rw [if_pos hd,Nat.totient_mul_of_prime_of_dvd hp (Nat.dvd_of_mod_eq_zero hd),ih h.2]
    · rw [if_neg hd,Nat.totient_mul_of_prime_of_not_dvd hp (fun hdiv => hd (Nat.mod_eq_zero_of_dvd hdiv)),ih h.2]

private abbrev Witness := ℕ × List ℕ
private def check (n : ℕ) (w : Witness) : Bool :=
  let v := evalFactors w.2
  decide (w.1 < n ∧ w.1 + v.1 = n) && test w.1 && w.2.all test && test (w.1*v.2-1)

private theorem of_check {n : ℕ} {w : Witness} (h : check n w = true) : 0 < OeisA233566.a n := by
  simp only [check,Bool.and_eq_true,decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨hlt,hsum⟩,hp⟩,hf⟩,hq⟩ := h
  have hd : n-w.1 = (evalFactors w.2).1 := by omega
  apply Finset.card_pos.mpr
  refine ⟨w.1,Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hlt,prime_of_test hp,?_⟩⟩
  rw [hd,eval_sound hf]
  exact prime_of_test hq

private def Segment (lo hi : ℕ) : Prop := ∀ n, lo ≤ n → n < hi → 0 < OeisA233566.a n

private theorem fromTable (lo len : ℕ) (w : Array Witness)
    (ok : ∀ i : Fin len, check (lo+i.val) (w[i.val]?.getD (0,[])) = true) : Segment lo (lo+len) := by
  intro n hl hu
  have hi : n-lo < len := by omega
  have h := of_check (ok ⟨n-lo,hi⟩)
  simpa only [Fin.val_mk,Nat.add_sub_of_le hl] using h

private theorem join {a b c : ℕ} (hl : Segment a b) (hr : Segment b c) : Segment a c := by
  intro n hn hc
  by_cases h : n < b
  · exact hl _ hn h
  · exact hr _ (by omega) hc
