theorem floor_lem (x y m : ℤ) (hy : 0 < y) (h1 : 0 ≤ x - y * m) (h2 : x - y * m < y) :
    ⌊(x : ℚ) / (y : ℚ)⌋ = m := by
  have hy' : (0 : ℚ) < y := by exact_mod_cast hy
  have h1' : (0 : ℚ) ≤ (x : ℚ) - (y : ℚ) * (m : ℚ) := by exact_mod_cast h1
  have h2' : (x : ℚ) - (y : ℚ) * (m : ℚ) < (y : ℚ) := by exact_mod_cast h2
  rw [Int.floor_eq_iff]
  constructor
  · rw [le_div_iff₀ hy']
    linarith
  · rw [div_lt_iff₀ hy']
    linarith

theorem b_hom (n : ℕ) : b (n + 6) = -b n + b (n + 1) - b (n + 2) + b (n + 3) - 2 * b (n + 4) + 3 * b (n + 5) := by
  have h1 : b (n + 5) = b n + b (n + 2) + 2 * b (n + 4) + 1 := b_rec n
  have h2 : b (n + 6) = b (n + 1) + b (n + 3) + 2 * b (n + 5) + 1 := b_rec (n + 1)
  linarith

