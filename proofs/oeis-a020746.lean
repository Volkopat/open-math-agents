    have hd := dbound (DU n) (DU (n + 1)) (DU (n + 2)) (DU (n + 3)) (DU (n + 4)) (DU (n + 5)) (DU (n + 6)) (DU (n + 7)) (DU (n + 8)) (DU (n + 9))
    have hsq : DU n ^ 2 ≤ (3 / 10 * Uq n) ^ 2 := by
      have e2 : (3 / 10 * Uq n) ^ 2 = 9 / 100 * Uq n ^ 2 := by ring
      rw [e2]
      linarith [sq_nonneg (Uq n), hd, hV]
    obtain ⟨hw1, hw2⟩ := abs_le_of_sq_le_sq' hsq (by linarith)
    have e9 : 9 * ((b (n + 1) : ℚ) ^ 2 - (b n : ℚ) * (b (n + 2) : ℚ)) =
        DU n + Uq (n + 2) - 2 * Uq (n + 1) + Uq n := by
      unfold DU Uq
      ring
    have eb : 3 * (b n : ℚ) = Uq n - 1 := by
      unfold Uq
