    have h0 : (0 : ℚ) < (b n : ℚ) := by linarith
    have h1 : (0 : ℚ) ≤ (b (n + 1) : ℚ) ^ 2 - (b n : ℚ) * (b (n + 2) : ℚ) := by linarith
    have h2 : (b (n + 1) : ℚ) ^ 2 - (b n : ℚ) * (b (n + 2) : ℚ) < (b n : ℚ) := by linarith
