import OMAStatements.S_mo_109583
import Mathlib

/-!
# A concrete sigma algebra with no abstract Borel representation

Start with Lang's cylinder sigma algebra on the power set of a continuum-sized
index set. It separates points but is too small to be generated by a topology
on that carrier (Lang, 1986; see https://mathoverflow.net/questions/87838).

Replace each point by an entire column of copies. A measurable set has the same
measurable section on all but a small family of rows. Every singleton is now
measurable, so any abstract Borel representation would pull back to a generating
topology on the enlarged space. Taking eventual sections of its opens then gives
a generating topology on Lang's original space. The number of rows is chosen
large enough to take one exceptional family for each possible section.
-/

namespace BorelRepresentation

open Set Filter Cardinal MeasurableSpace
open scoped Cardinal Filter MeasureTheory

universe u

abbrev MS {X : Type u} (m : MeasurableSpace X) := {s : Set X // MeasurableSet[m] s}

/-- With all singletons measurable an abstract Borel representation induces an
actual generating topology on the original carrier. -/
lemma pullbackTopology {X Y : Type u} (m : MeasurableSpace X)
    (hs : ∀ x : X, MeasurableSet[m] {x}) (t : TopologicalSpace Y)
    (e : MS m ≃o MS (@borel Y t)) : ∃ t' : TopologicalSpace X, @borel X t' = m := by
  classical
  letI : MeasurableSpace X := m
  letI : MeasurableSpace Y := @borel Y t
  let z : MS m := ⟨∅, .empty⟩
  let z' : MS (@borel Y t) := ⟨∅, .empty⟩
  have ez : e z = z' := le_antisymm ((e.le_symm_apply).mp (show z ≤ e.symm z' from empty_subset _))
    (empty_subset _)
  let atom (x : X) : MS m := ⟨{x}, hs x⟩
  have hn (x : X) : (e (atom x)).val.Nonempty := by
    by_contra h
    have he : e (atom x) = e z := Subtype.ext ((not_nonempty_iff_eq_empty.mp h).trans
      (congrArg Subtype.val ez).symm)
    have := congrArg Subtype.val (e.injective he)
    simpa [atom, z] using this
  choose f hf using hn
  have trace (s : MS m) : f ⁻¹' (e s).val = s.val := by
    ext x
    change f x ∈ (e s).val ↔ x ∈ s.val
    refine ⟨fun hx => ?_, fun hx => e.monotone (show atom x ≤ s from singleton_subset_iff.mpr hx) (hf x)⟩
    by_contra h
    let v : MS (@borel Y t) := ⟨(e (atom x)).val ∩ (e s).val,
      (e (atom x)).property.inter (e s).property⟩
    have ha : e.symm v ≤ atom x := e.symm_apply_le.mpr (inter_subset_left)
    have hb : e.symm v ≤ s := e.symm_apply_le.mpr (inter_subset_right)
    have hz : e.symm v ≤ z := by
      intro b hmem
      have hbx : b = x := ha hmem
      exact (h (hbx ▸ hb hmem)).elim
    have hv : v ≤ z' := ez ▸ e.symm_apply_le.mp hz
    exact hv (show f x ∈ v.val from ⟨hf x, hx⟩)
  refine ⟨t.induced f, ?_⟩
  rw [borel_comap]
  apply le_antisymm
  · rintro s ⟨b, hb, rfl⟩
    let a := e.symm ⟨b, hb⟩
    have htrace := trace a
    have traceb : f ⁻¹' b = a.val := by simpa [a] using htrace
    rw [traceb]
    exact a.property
  · intro s h
    exact ⟨(e ⟨s,h⟩).val, (e ⟨s,h⟩).property, trace ⟨s,h⟩⟩

/-- Lang's small, point-separating product sigma algebra. -/
abbrev I := (𝔠 : Cardinal.{u}).out
abbrev Base := Set I.{u}
def cyl (i : I.{u}) : Set Base.{u} := {x | i ∈ x}
abbrev lang := generateFrom (range cyl.{u})

lemma lang_not_borel (t : TopologicalSpace Base.{u}) : @borel _ t ≠ lang := by
  classical
  intro he
  letI : MeasurableSpace Base.{u} := borel _
  haveI : BorelSpace Base.{u} := ⟨rfl⟩
  let code (x : Base.{u}) : MS lang := ⟨closure {x}, he ▸ isClosed_closure.measurableSet⟩
  have hinj : Function.Injective code := by
    intro x y h
    have hi : Inseparable x y := inseparable_iff_closure_eq.mpr (congrArg Subtype.val h)
    have same (s : Set Base.{u}) (hs : MeasurableSet[borel _] s) : x ∈ s ↔ y ∈ s := by
      induction s, hs using generateFrom_induction with
      | hC a ha _ => exact hi.mem_open_iff ha
      | empty => simp
      | compl a _ ih => exact not_congr ih
      | iUnion a _ ih => simp only [mem_iUnion]; exact exists_congr fun n => ih n
    ext i
    exact same (cyl i) (he ▸ measurableSet_generateFrom (mem_range_self i))
  have hsmall : #(MS lang.{u}) ≤ 𝔠 := by
    apply cardinal_measurableSet_le_continuum
    exact mk_range_le.trans (by simp [I])
  have hbig := (Cardinal.mk_le_of_injective hinj).trans hsmall
  simpa [Base, I, Cardinal.mk_set, not_le_of_gt (Cardinal.cantor (𝔠 : Cardinal.{u}))] using hbig

section Thickening

variable {X J : Type u} (F : Filter J) [CountableInterFilter F]

def row (s : Set (J × X)) (j : J) : Set X := (fun x => (j,x)) ⁻¹' s

/-- A set agrees, outside an exceptional family of rows, with a fixed
measurable set of the base. -/
abbrev thick (m : MeasurableSpace X) : MeasurableSpace (J × X) where
  MeasurableSet' s := ∃ a, MeasurableSet[m] a ∧ ∀ᶠ j in F, row s j = a
  measurableSet_empty := ⟨∅, .empty, .of_forall fun _ => rfl⟩
  measurableSet_compl := by
    rintro s ⟨a, ha, h⟩
    exact ⟨aᶜ, ha.compl, h.mono fun j hj => congrArg (·ᶜ) hj⟩
  measurableSet_iUnion := by
    intro s h
    choose a ha he using h
    refine ⟨⋃ n, a n, .iUnion ha, ((eventually_countable_forall).2 he).mono ?_⟩
    intro j hj
    simpa only [row, preimage_iUnion] using congrArg (fun f : ℕ → Set X => ⋃ n, f n) (funext hj)

lemma thick_singleton (m : MeasurableSpace X) (hF : ∀ a : J, ∀ᶠ j in F, j ≠ a)
    (p : J × X) : MeasurableSet[thick F m] {p} := by
  refine ⟨∅, .empty, (hF p.1).mono fun j hj => ?_⟩
  apply eq_empty_iff_forall_notMem.mpr
  intro x hx
  exact hj (congrArg Prod.fst (show (j,x) = p from hx))

variable {c : Cardinal.{u}} [CardinalInterFilter F c]

/-- Project the upstairs opens to their eventual rows. The cardinal
intersection property permits one representative for every member of an
arbitrary family of downstairs opens. -/
abbrev projected (t : TopologicalSpace (J × X)) (hc : #(Set X) < c) : TopologicalSpace X where
  IsOpen a := ∃ s : Set (J × X), IsOpen s ∧ ∀ᶠ j in F, row s j = a
  isOpen_univ := ⟨univ, isOpen_univ, .of_forall fun _ => rfl⟩
  isOpen_inter := by
    rintro a b ⟨s, hs, he⟩ ⟨v, hv, hf⟩
    exact ⟨s ∩ v, hs.inter hv, (he.and hf).mono fun j h =>
      congrArg₂ (· ∩ ·) h.1 h.2⟩
  isOpen_sUnion := by
    intro S h
    choose v hv he using fun a : S => h a.1 a.2
    refine ⟨⋃ a, v a, isOpen_iUnion hv,
      ((eventually_cardinal_forall ((mk_set_le S).trans_lt hc)).2 he).mono ?_⟩
    intro j hj
    ext x
    simp only [row, mem_preimage, mem_iUnion, mem_sUnion]
    exact ⟨fun ⟨a, ha⟩ => ⟨a.1, a.2, (hj a) ▸ (show x ∈ row (v a) j from ha)⟩,
      fun ⟨a, ha, hx⟩ => ⟨⟨a,ha⟩, show x ∈ row (v ⟨a,ha⟩) j by rw [hj]; exact hx⟩⟩

lemma projected_borel [F.NeBot] (m : MeasurableSpace X) (t : TopologicalSpace (J × X))
    (hc : #(Set X) < c) (ht : @borel _ t = thick F m) :
    @borel _ (projected F t hc) = m := by
  let T := projected F t hc
  have hopen (s : Set (J × X)) (hs : IsOpen s) : MeasurableSet[thick F m] s :=
    ht ▸ measurableSet_generateFrom hs
  apply le_antisymm
  · apply generateFrom_le
    rintro a ⟨s, hs, ha⟩
    obtain ⟨b, hb, he⟩ := hopen s hs
    obtain ⟨j, hj₁, hj₂⟩ := (he.and ha).exists
    exact (hj₁.symm.trans hj₂) ▸ hb
  · have hle : @borel _ t ≤ thick F (@borel _ T) := by
      apply generateFrom_le
      intro s hs
      obtain ⟨a, _, he⟩ := hopen s hs
      exact ⟨a, measurableSet_generateFrom (show @IsOpen _ T a from ⟨s, hs, he⟩), he⟩
    intro a ha
    let s : Set (J × X) := Prod.snd ⁻¹' a
    have hs : MeasurableSet[thick F m] s := ⟨a, ha, .of_forall fun _ => rfl⟩
    obtain ⟨b, hb, he⟩ := hle s (ht ▸ hs)
    obtain ⟨_, heq⟩ := he.exists
    exact (show a = b from heq) ▸ hb

end Thickening

lemma failure : ¬ ∀ (X : Type u) (m : MeasurableSpace X),
    ∃ (Y : Type u) (t : TopologicalSpace Y), Nonempty (MS m ≃o MS (@borel Y t)) := by
  classical
  intro hall
  let d := max ℵ₀ #(Set Base.{u})
  let c := Order.succ d
  have hc : c.IsRegular := isRegular_succ (le_max_left _ _)
  let J := c.out
  let F := cocardinal J hc
  have hf : #(Set Base.{u}) < c := (le_max_right _ _).trans_lt (Order.lt_succ _)
  letI : CountableInterFilter F := CardinalInterFilter.toCountableInterFilter F
    ((le_max_left _ _).trans_lt (Order.lt_succ d) : ℵ₀ < c)
  haveI : F.NeBot := by
    have hh := (cocardinal_inf_principal_neBot_iff (α := J) (hreg := hc) (s := univ)).2
      (show c ≤ #(univ : Set J) by simp [J])
    simpa [F] using hh
  obtain ⟨Y, t, ⟨e⟩⟩ := hall (J × Base) (thick F lang)
  obtain ⟨t', ht'⟩ := pullbackTopology _ (thick_singleton F lang (fun a => eventually_cocardinal_ne (hreg := hc) a)) t e
  exact lang_not_borel _ (projected_borel F lang t' hf ht')

end BorelRepresentation

theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_109583.main) :=
  BorelRepresentation.failure
