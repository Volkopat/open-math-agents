import OMAReductions.R_Erdos967_erdos_967_variants_finite_R1

-- Step Erdos967.erdos_967.variants.finite.R1.H3
-- Credit: @LordMike
-- A common zero z of two coprime rational polynomials in m variables has transcendence degree at
-- most m - 2. Take a largest set I of indices on which z is algebraically independent; every
-- coordinate is algebraic over the field generated by the z_i with i in I. If I is everything,
-- evaluation at z is injective and P = Q = 0. If I misses exactly one index j, view P and Q as
-- polynomials in x_j over R = Q[x_i, i ≠ j]; evaluation embeds R and its fraction field K in the
-- complex numbers. An irreducible factor d of P vanishing at z is nonconstant, so primitive, and
-- irreducible over K by the Gauss lemma. Either d divides Q over K, hence over R (Gauss), against
-- coprimality, or a Bezout identity a d + b Q = 1 over K evaluates to 0 = 1.

namespace OMA.E967FH3

/-- An embedding of a domain in the complex numbers extends to its fraction field. -/
lemma exists_lift {R' : Type} [CommRing R'] [IsDomain R'] (ψ : R' →+* ℂ)
    (hψ : Function.Injective ψ) :
    ∃ Ψ : FractionRing R' →+* ℂ, Ψ.comp (algebraMap R' (FractionRing R')) = ψ := by
  refine ⟨IsFractionRing.lift (A := R') (K := FractionRing R') (g := ψ) hψ, ?_⟩
  apply RingHom.ext
  intro x
  rw [RingHom.comp_apply]
  exact IsFractionRing.lift_algebraMap hψ x

/-- The one-variable core over a unique factorisation domain embedded in the complex numbers. -/
lemma core {R' : Type} [CommRing R'] [IsDomain R'] [UniqueFactorizationMonoid R']
    (ψ : R' →+* ℂ) (hψ : Function.Injective ψ) (y : ℂ) (P Q : Polynomial R')
    (hrel : IsRelPrime P Q) (hP : P.eval₂ ψ y = 0) (hQ : Q.eval₂ ψ y = 0) : False := by
  classical
  let _ : GCDMonoid R' := UniqueFactorizationMonoid.toGCDMonoid R'
  have hP0 : P ≠ 0 := by
    rintro rfl
    have hu := isRelPrime_zero_left.mp hrel
    obtain ⟨r, hr, rfl⟩ := Polynomial.isUnit_iff.mp hu
    rw [Polynomial.eval₂_C] at hQ
    exact hr.ne_zero (hψ (by rw [hQ, map_zero]))
  obtain ⟨f, hirr, hassoc⟩ := WfDvdMonoid.exists_factors P hP0
  have hprod : (f.prod).eval₂ ψ y = 0 := by
    obtain ⟨c, hc⟩ := hassoc.symm.dvd
    rw [hc, Polynomial.eval₂_mul, hP, zero_mul]
  obtain ⟨d, hdf, hd0⟩ : ∃ d ∈ f, d.eval₂ ψ y = 0 := by
    have h := hprod
    rw [← Polynomial.coe_eval₂RingHom, map_multiset_prod, Multiset.prod_eq_zero_iff] at h
    obtain ⟨d, hd, hd0⟩ := Multiset.mem_map.mp h
    exact ⟨d, hd, hd0⟩
  have hd := hirr d hdf
  have hdP : d ∣ P := (Multiset.dvd_prod hdf).trans hassoc.dvd
  have hdeg : d.natDegree ≠ 0 := by
    intro h0
    have hC := Polynomial.eq_C_of_natDegree_eq_zero h0
    rw [hC, Polynomial.eval₂_C] at hd0
    have hc0 : d.coeff 0 = 0 := hψ (by rw [hd0, map_zero])
    apply hd.ne_zero
    rw [hC, hc0, map_zero]
  have hprim := hd.isPrimitive hdeg
  obtain ⟨Ψ, hΨ⟩ := exists_lift ψ hψ
  have hmap : ∀ F : Polynomial R', (F.map (algebraMap R' (FractionRing R'))).eval₂ Ψ y =
      F.eval₂ ψ y := by
    intro F
    rw [Polynomial.eval₂_map, hΨ]
  have hirrK := (hprim.irreducible_iff_irreducible_map_fraction_map
    (K := FractionRing R')).mp hd
  rcases dvd_or_isCoprime _ (Q.map (algebraMap R' (FractionRing R'))) hirrK with h | h
  · have hdQ : d ∣ Q := (hprim.dvd_iff_fraction_map_dvd_fraction_map (FractionRing R')).mpr h
    exact hd.not_isUnit (hrel hdP hdQ)
  · obtain ⟨a, b, hab⟩ := h
    have h1 := congrArg (Polynomial.eval₂ Ψ y) hab
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul, hmap, hmap, hd0, hQ,
      mul_zero, mul_zero, add_zero, Polynomial.eval₂_one] at h1
    exact zero_ne_one h1

/-- Evaluation of a polynomial in `Option S` variables through `optionEquivLeft`. -/
lemma bridge0 {m : ℕ} (z : Fin m → ℂ) (j : Fin m) (F : MvPolynomial (Option {b // b ≠ j}) ℚ) :
    Polynomial.aevalTower (MvPolynomial.aeval (fun s : {b // b ≠ j} => z s)) (z j)
      (MvPolynomial.optionEquivLeft ℚ {b // b ≠ j} F) =
      MvPolynomial.aeval (fun o : Option {b // b ≠ j} => o.elim (z j) (fun s => z s)) F := by
  induction F using MvPolynomial.induction_on with
  | C a => rw [MvPolynomial.optionEquivLeft_C, Polynomial.aevalTower_C]; simp
  | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
  | mul_X p i hp =>
    rw [map_mul, map_mul, map_mul, hp]
    congr 1
    cases i with
    | none => rw [MvPolynomial.optionEquivLeft_X_none, Polynomial.aevalTower_X]; simp
    | some s => rw [MvPolynomial.optionEquivLeft_X_some, Polynomial.aevalTower_C]; simp

/-- Evaluation at `z` after singling out the variable `x_j`. -/
lemma bridge {m : ℕ} (z : Fin m → ℂ) (j : Fin m) (F : MvPolynomial (Fin m) ℚ) :
    Polynomial.eval₂ ((MvPolynomial.aeval (fun s : {b // b ≠ j} => z s) :
        MvPolynomial {b // b ≠ j} ℚ →ₐ[ℚ] ℂ) : MvPolynomial {b // b ≠ j} ℚ →+* ℂ) (z j)
      (MvPolynomial.optionEquivLeft ℚ {b // b ≠ j}
        (MvPolynomial.rename (Equiv.optionSubtypeNe j).symm F)) = MvPolynomial.aeval z F := by
  have h := bridge0 z j (MvPolynomial.rename (Equiv.optionSubtypeNe j).symm F)
  rw [MvPolynomial.aeval_rename] at h
  have hz : (fun o : Option {b // b ≠ j} => o.elim (z j) (fun s => z s)) ∘
      (Equiv.optionSubtypeNe j).symm = z := by
    funext i
    rw [Function.comp_apply]
    by_cases hij : i = j
    · subst hij
      rw [Equiv.optionSubtypeNe_symm_self]
      rfl
    · rw [Equiv.optionSubtypeNe_symm_of_ne hij]
      rfl
  rw [hz] at h
  exact h

/-- Coprimality is preserved by ring isomorphisms. -/
lemma relPrime_map {A B : Type} [CommRing A] [CommRing B] (e : A ≃+* B) {a b : A}
    (h : IsRelPrime a b) : IsRelPrime (e a) (e b) := by
  intro d hda hdb
  have h1 : e.symm d ∣ a := by simpa using map_dvd e.symm hda
  have h2 : e.symm d ∣ b := by simpa using map_dvd e.symm hdb
  have h3 := (h h1 h2).map e
  simpa using h3

/-- The case where `z` is algebraically independent away from the index `j`. -/
lemma final {m : ℕ} (z : Fin m → ℂ) (j : Fin m)
    (hind : AlgebraicIndependent ℚ (fun s : {b // b ≠ j} => z s))
    (P Q : MvPolynomial (Fin m) ℚ) (hrel : IsRelPrime P Q)
    (hP : MvPolynomial.aeval z P = 0) (hQ : MvPolynomial.aeval z Q = 0) : False := by
  have hψ : Function.Injective ((MvPolynomial.aeval (fun s : {b // b ≠ j} => z s) :
      MvPolynomial {b // b ≠ j} ℚ →ₐ[ℚ] ℂ) : MvPolynomial {b // b ≠ j} ℚ →+* ℂ) :=
    algebraicIndependent_iff_injective_aeval.mp hind
  have h1 := relPrime_map
    (MvPolynomial.renameEquiv ℚ (Equiv.optionSubtypeNe j).symm).toRingEquiv hrel
  have h2 := relPrime_map (MvPolynomial.optionEquivLeft ℚ {b // b ≠ j}).toRingEquiv h1
  exact core _ hψ (z j) _ _ h2 ((bridge z j P).trans hP) ((bridge z j Q).trans hQ)

/-- A largest set of indices on which `z` is algebraically independent. -/
lemma exists_max {m : ℕ} (z : Fin m → ℂ) :
    ∃ I : Finset (Fin m), AlgebraicIndepOn ℚ z (I : Set (Fin m)) ∧
      ∀ J : Finset (Fin m), AlgebraicIndepOn ℚ z (J : Set (Fin m)) → J.card ≤ I.card := by
  classical
  have hne : (Finset.univ.filter
      (fun J : Finset (Fin m) => AlgebraicIndepOn ℚ z (J : Set (Fin m)))).Nonempty := by
    refine ⟨∅, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩⟩
    rw [Finset.coe_empty]
    exact algebraicIndependent_empty_type
  obtain ⟨I, hI, hmax⟩ := Finset.exists_max_image _ Finset.card hne
  exact ⟨I, (Finset.mem_filter.mp hI).2,
    fun J hJ => hmax J (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hJ⟩)⟩

/-- Every coordinate is algebraic over the field generated by a largest independent set. -/
lemma alg_of_max {m : ℕ} (z : Fin m → ℂ) (I : Finset (Fin m))
    (hI : AlgebraicIndepOn ℚ z (I : Set (Fin m)))
    (hmax : ∀ J : Finset (Fin m), AlgebraicIndepOn ℚ z (J : Set (Fin m)) → J.card ≤ I.card)
    (l : Fin m) :
    IsAlgebraic (IntermediateField.adjoin ℚ (z '' (I : Set (Fin m)))) (z l) := by
  open IntermediateField.algebraAdjoinAdjoin in
  classical
  by_cases hl : l ∈ I
  · exact isAlgebraic_algebraMap (⟨z l, IntermediateField.subset_adjoin ℚ _ ⟨l, hl, rfl⟩⟩ :
      IntermediateField.adjoin ℚ (z '' (I : Set (Fin m))))
  · by_contra hna
    have htr : Transcendental (Algebra.adjoin ℚ (z '' (I : Set (Fin m)))) (z l) := by
      intro ha
      exact hna ((IsFractionRing.isAlgebraic_iff (Algebra.adjoin ℚ (z '' (I : Set (Fin m))))
        (IntermediateField.adjoin ℚ (z '' (I : Set (Fin m)))) ℂ).mp ha)
    have h1 := hI.insert htr
    rw [← Finset.coe_insert] at h1
    have h2 := hmax _ h1
    rw [Finset.card_insert_of_notMem hl] at h2
    omega

end OMA.E967FH3

theorem OMA.solution : OMA.R_Erdos967_erdos_967_variants_finite_R1.H3 := by
  intro m z P Q hrel hP hQ
  obtain ⟨I, hI, hmax⟩ := OMA.E967FH3.exists_max z
  refine ⟨I, ?_, OMA.E967FH3.alg_of_max z I hI hmax⟩
  by_contra hcard
  by_cases hall : ∀ j, j ∈ I
  · have hind : AlgebraicIndependent ℚ z :=
      AlgebraicIndepOn.univ.mp (hI.mono (fun j _ => hall j))
    have hinj := algebraicIndependent_iff_injective_aeval.mp hind
    have hP0 : P = 0 := hinj (by rw [hP, map_zero])
    have hQ0 : Q = 0 := hinj (by rw [hQ, map_zero])
    subst hP0 hQ0
    exact not_isUnit_zero (isRelPrime_zero_left.mp hrel)
  · push Not at hall
    obtain ⟨j, hj⟩ := hall
    have hsub : ∀ i, i ≠ j → i ∈ I := by
      intro i hij
      by_contra hi
      have hs : I ⊆ (Finset.univ.erase i).erase j := by
        intro a ha
        simp only [Finset.mem_erase, Finset.mem_univ, and_true]
        exact ⟨fun h => hj (h ▸ ha), fun h => hi (h ▸ ha)⟩
      have h1 := Finset.card_le_card hs
      rw [Finset.card_erase_of_mem (Finset.mem_erase.mpr ⟨hij.symm, Finset.mem_univ _⟩),
        Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin] at h1
      have h2 := i.isLt
      have h3 := j.isLt
      have h4 := Fin.val_ne_of_ne hij
      omega
    have hind : AlgebraicIndependent ℚ (fun s : {b // b ≠ j} => z s) :=
      hI.mono (s := {b | b ≠ j}) (fun i hi => hsub i hi)
    exact OMA.E967FH3.final z j hind P Q hrel hP hQ
