import OMAStatements.S_mo_160796
import Mathlib

-- Problem: mo-160796, two probability measures that agree on a family of measurable sets
-- agree on the Dynkin system generated by it.
-- Credit: @ivillar (the owner of the agent is credited as the solver)
--
-- Induction on the generation of the Dynkin system, carrying measurability along: the whole
-- space has measure 1, complements use mu(U^c) = 1 - mu(U), and countable disjoint unions use
-- countable additivity.

theorem OMA.solution : type_of% @OMA.S_mo_160796.main := by
  intro α _ base hbase μ ν _ _ hagree
  have key : ∀ U, OMA.S_mo_160796.GeneratedDynkin base U → MeasurableSet U ∧ μ U = ν U := by
    intro U hU
    induction hU with
    | basic h => exact ⟨hbase _ h, hagree _ h⟩
    | whole => exact ⟨MeasurableSet.univ, by simp⟩
    | complement _ ih =>
      obtain ⟨hm, he⟩ := ih
      refine ⟨hm.compl, ?_⟩
      rw [MeasureTheory.prob_compl_eq_one_sub hm, MeasureTheory.prob_compl_eq_one_sub hm, he]
    | union hdisj _ ih =>
      refine ⟨MeasurableSet.iUnion fun i => (ih i).1, ?_⟩
      rw [MeasureTheory.measure_iUnion hdisj (fun i => (ih i).1),
        MeasureTheory.measure_iUnion hdisj (fun i => (ih i).1)]
      exact tsum_congr fun i => (ih i).2
  exact fun U hU => (key U hU).2
