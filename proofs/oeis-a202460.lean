/-- Barker's recurrence, for n > 10. -/
theorem recurrence (n : ℕ) (hn : 10 < n) : (a n : ℤ) = 10 * a (n - 1) - 45 * a (n - 2) + 120 * a
    (n - 3) - 210 * a (n - 4) + 252 * a (n - 5) - 210 * a (n - 6) + 120 * a (n - 7) - 45 * a (n -
    8) + 10 * a (n - 9) - a (n - 10) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 11 := ⟨n - 11, by omega⟩
  rw [show k + 11 = (k + 10) + 1 from rfl, show k + 10 + 1 - 1 = (k + 9) + 1 by omega, show k + 10 +
    1 - 2 = (k + 8) + 1 by omega, show k + 10 + 1 - 3 = (k + 7) + 1 by omega, show k + 10 + 1 - 4 =
    (k + 6) + 1 by omega, show k + 10 + 1 - 5 = (k + 5) + 1 by omega, show k + 10 + 1 - 6 = (k +
    4) + 1 by omega, show k + 10 + 1 - 7 = (k + 3) + 1 by omega, show k + 10 + 1 - 8 = (k + 2) + 1
    by omega, show k + 10 + 1 - 9 = (k + 1) + 1 by omega, show k + 10 + 1 - 10 = k + 1 by omega]
  simp only [a_T]
  exact T_rec k

