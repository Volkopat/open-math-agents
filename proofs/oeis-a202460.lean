theorem G_rec (m : ℕ) : ∀ a b c : Fin 14, (G a b c (m + 13) : ℤ) = 10 * G a b c (m + 12) - 45 * G a
    b c (m + 11) + 120 * G a b c (m + 10) - 210 * G a b c (m + 9) + 252 * G a b c (m + 8) - 210 * G
    a b c (m + 7) + 120 * G a b c (m + 6) - 45 * G a b c (m + 5) + 10 * G a b c (m + 4) - G a b c
    (m + 3) := by
  induction m with
