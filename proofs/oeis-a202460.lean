/-- Barker's g.f., as A(x) (1 - x)^10 = N(x) in Z[[x]]. -/
theorem gf : PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 10 =
    X * (2744 - 19376 * X + 64812 * X ^ 2 - 131502 * X ^ 3 + 175860 * X ^ 4 - 159456 * X ^ 5 +
      97542 * X ^ 6 - 38691 * X ^ 7 + 9010 * X ^ 8 - 937 * X ^ 9) := by
  set A : ℤ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) with hA
  have e1 : A * (1 - X) ^ 10 =
      A - C 10 * (A * X ^ 1) + C 45 * (A * X ^ 2) - C 120 * (A * X ^ 3) + C 210 * (A * X ^ 4) - C
        252 * (A * X ^ 5) + C 210 * (A * X ^ 6) - C 120 * (A * X ^ 7) + C 45 * (A * X ^ 8) - C 10 *
        (A * X ^ 9) + A * X ^ 10 := by
    simp only [map_ofNat]; ring
  have e2 : (X * (2744 - 19376 * X + 64812 * X ^ 2 - 131502 * X ^ 3 + 175860 * X ^ 4 - 159456 * X ^
    5 + 97542 * X ^ 6 - 38691 * X ^ 7 + 9010 * X ^ 8 - 937 * X ^ 9) : ℤ⟦X⟧) =
      X ^ 1 * C 2744 - X ^ 2 * C 19376 + X ^ 3 * C 64812 - X ^ 4 * C 131502 + X ^ 5 * C 175860 - X ^
        6 * C 159456 + X ^ 7 * C 97542 - X ^ 8 * C 38691 + X ^ 9 * C 9010 - X ^ 10 * C 937 := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℤ) else a k := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  have v := values
  rcases Nat.lt_or_ge n 11 with hn | hn
  · interval_cases n <;> simp_all
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 11 := ⟨n - 11, by omega⟩
    have h := recurrence (q + 11) (by omega)
    simp only [show q + 11 - 1 = q + 10 by omega, show q + 11 - 2 = q + 9 by omega, show q + 11 -
      3 = q + 8 by omega, show q + 11 - 4 = q + 7 by omega, show q + 11 - 5 = q + 6 by omega, show
      q + 11 - 6 = q + 5 by omega, show q + 11 - 7 = q + 4 by omega, show q + 11 - 8 = q + 3 by
      omega, show q + 11 - 9 = q + 2 by omega, show q + 11 - 10 = q + 1 by omega] at h ⊢
    simp only [show ¬ q + 11 = 0 by omega, show ¬ q + 10 = 0 by omega, show ¬ q + 9 = 0 by omega,
      show ¬ q + 8 = 0 by omega, show ¬ q + 7 = 0 by omega, show ¬ q + 6 = 0 by omega, show ¬ q +
      5 = 0 by omega, show ¬ q + 4 = 0 by omega, show ¬ q + 3 = 0 by omega, show ¬ q + 2 = 0 by
      omega, show ¬ q + 1 = 0 by omega, show 1 ≤ q + 11 by omega, show 2 ≤ q + 11 by omega, show 3 ≤
      q + 11 by omega, show 4 ≤ q + 11 by omega, show 5 ≤ q + 11 by omega, show 6 ≤ q + 11 by omega,
      show 7 ≤ q + 11 by omega, show 8 ≤ q + 11 by omega, show 9 ≤ q + 11 by omega, show 10 ≤ q + 11
      by omega, show ¬ q + 11 = 1 by omega, show ¬ q + 11 = 2 by omega, show ¬ q + 11 = 3 by omega,
      show ¬ q + 11 = 4 by omega, show ¬ q + 11 = 5 by omega, show ¬ q + 11 = 6 by omega, show ¬ q +
      11 = 7 by omega, show ¬ q + 11 = 8 by omega, show ¬ q + 11 = 9 by omega, show ¬ q + 11 = 10 by
      omega, if_true, if_false]
    rw [h]
    ring

/-- Hardin's empirical formula, for n >= 1. -/
theorem empirical (n : ℕ) (hn : 1 ≤ n) : (a n : ℚ) = 1 / 60480 * n ^ 9 + 1 / 672 * n ^ 8 + 163 /
    3360 * n ^ 7 + 119 / 144 * n ^ 6 + 24221 / 2880 * n ^ 5 + 15553 / 288 * n ^ 4 + 1671487 / 7560 *
    n ^ 3 + 282325 / 504 * n ^ 2 + 404227 / 420 * n + 937 := by
  obtain ⟨w1, w2, w3, w4, w5, w6, w7, w8, w9, w10⟩ := values
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 11 with h7 | h7
    · interval_cases n
      · rw [w1]; norm_num
      · rw [w2]; norm_num
      · rw [w3]; norm_num
      · rw [w4]; norm_num
      · rw [w5]; norm_num
      · rw [w6]; norm_num
      · rw [w7]; norm_num
      · rw [w8]; norm_num
      · rw [w9]; norm_num
      · rw [w10]; norm_num
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + 11 := ⟨n - 11, by omega⟩
      have h := recurrence (k + 11) (by omega)
      simp only [show k + 11 - 1 = k + 10 by omega, show k + 11 - 2 = k + 9 by omega, show k + 11 -
        3 = k + 8 by omega, show k + 11 - 4 = k + 7 by omega, show k + 11 - 5 = k + 6 by omega, show
        k + 11 - 6 = k + 5 by omega, show k + 11 - 7 = k + 4 by omega, show k + 11 - 8 = k + 3 by
        omega, show k + 11 - 9 = k + 2 by omega, show k + 11 - 10 = k + 1 by omega] at h
      have h' : (a (k + 11) : ℚ) = 10 * a (k + 10) - 45 * a (k + 9) + 120 * a (k + 8) - 210 * a (k +
          7) + 252 * a (k + 6) - 210 * a (k + 5) + 120 * a (k + 4) - 45 * a (k + 3) + 10 * a (k +
          2) - a (k + 1) := by exact_mod_cast h
      rw [h', ih (k + 10) (by omega) (by omega), ih (k + 9) (by omega) (by omega), ih (k + 8) (by
        omega) (by omega), ih (k + 7) (by omega) (by omega), ih (k + 6) (by omega) (by omega), ih
        (k + 5) (by omega) (by omega), ih (k + 4) (by omega) (by omega), ih (k + 3) (by omega) (by
        omega), ih (k + 2) (by omega) (by omega), ih (k + 1) (by omega) (by omega)]
      push_cast
      ring

