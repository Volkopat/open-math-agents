theorem rec_class (m : ℕ) (p : Fin L) : (G (m + 5) p : ℤ) = 5 * (G (m + 4) p : ℤ) - 10 * (G (m + 3) p : ℤ) + 10 * (G (m + 2) p : ℤ) - 5 * (G (m + 1) p : ℤ) + (G (m + 0) p : ℤ) := by
  induction m generalizing p with
  | zero =>
    simp only [Nat.zero_add, G0, G1, G2, G3, G4, G5]
    revert p
    decide +kernel
  | succ m ih =>
    rw [show m + 1 + 5 = m + 5 + 1 by omega, show m + 1 + 4 = m + 4 + 1 by omega, show m + 1 + 3 = m + 3 + 1 by omega, show m + 1 + 2 = m + 2 + 1 by omega, show m + 1 + 1 = m + 1 + 1 by omega, show m + 1 + 0 = m + 0 + 1 by omega]
    rw [G_succ (m + 5) p, G_succ (m + 4) p, G_succ (m + 3) p, G_succ (m + 2) p, G_succ (m + 1) p, G_succ (m + 0) p]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    linear_combination ((Mf p q : ℕ) : ℤ) * ih q

