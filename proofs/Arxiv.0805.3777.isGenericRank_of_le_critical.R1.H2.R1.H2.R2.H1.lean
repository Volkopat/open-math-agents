import OMAReductions.R_Arxiv_0805_3777_isGenericRank_of_le_critical_R1_H2_R1_H2_R2
import Mathlib

/-! Packed natural-number products with separated tensor coordinates. -/

namespace OMA.TangentBinaryRadix

open Finset

def pack (base : ℕ) (digit : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => digit 0 + base * pack base (fun i => digit (i+1)) n

theorem pack_sum (base : ℕ) (digit : ℕ → ℕ) (n : ℕ) :
    pack base digit n = ∑ i : Fin n, digit i.val * base^i.val := by
  induction n generalizing digit with
  | zero => simp [pack]
  | succ n ih =>
      rw [pack, ih, Fin.sum_univ_succ]
      simp only [Fin.val_zero, pow_zero, mul_one, Fin.val_succ, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [pow_succ]
      ring

theorem digit_read {base n i : ℕ} (hb : 0 < base) (digit : ℕ → ℕ)
    (bounded : ∀ j < n, digit j < base) (hi : i < n) :
    pack base digit n / base^i % base = digit i := by
  induction n generalizing digit i with
  | zero => omega
  | succ n ih =>
      have h₀ := bounded 0 (by omega)
      have ht : ∀ j < n, digit (j+1) < base := fun j hj => bounded _ (by omega)
      cases i with
      | zero =>
          simp [pack, Nat.add_mod, Nat.mod_eq_of_lt h₀]
      | succ i =>
          rw [pack, pow_succ', ← Nat.div_div_eq_div_mul,
            Nat.add_mul_div_left _ _ hb, Nat.div_eq_of_lt h₀, zero_add]
          exact ih _ ht (by omega)

theorem pack_add (b n : ℕ) (f g : ℕ → ℕ) :
    pack b f n + pack b g n = pack b (fun i => f i + g i) n := by
  simp only [pack_sum, add_mul, Finset.sum_add_distrib]

theorem pack_smul (b n s : ℕ) (f : ℕ → ℕ) :
    s * pack b f n = pack b (fun i => s * f i) n := by
  simp only [pack_sum, Finset.mul_sum, mul_assoc]

abbrev Axes := Fin 7 × Fin 9 × Fin 9

def index (q : Axes) : ℕ := 81*q.1.val + 9*q.2.1.val + q.2.2.val

def xWord (base : ℕ) (f : Fin 7 → ℕ) : ℕ := ∑ i, f i * base^(81*i.val)

def yWord (base : ℕ) (f : Fin 9 → ℕ) : ℕ := ∑ j, f j * base^(9*j.val)

def zWord (base : ℕ) (f : Fin 9 → ℕ) : ℕ := ∑ k, f k * base^k.val

private theorem distribute3 {I J K : Type*} [Fintype I] [Fintype J] [Fintype K]
    (f : I → ℕ) (g : J → ℕ) (h : K → ℕ) :
    (∑ i, f i) * (∑ j, g j) * (∑ k, h k) = ∑ i, ∑ j, ∑ k, f i * g j * h k := by
  have hf : (∑ i, f i) * (∑ j, g j) = ∑ i, f i * (∑ j, g j) :=
    Finset.sum_mul _ _ _
  rw [hf, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  have hh : f i * (∑ j, g j) = ∑ j, f i * g j :=
    Finset.mul_sum _ _ _
  rw [hh, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  exact Finset.mul_sum _ _ _

theorem separable (base : ℕ) (x : Fin 7 → ℕ) (y : Fin 9 → ℕ) (z : Fin 9 → ℕ) :
    xWord base x * yWord base y * zWord base z =
      ∑ q : Axes, (x q.1 * y q.2.1 * z q.2.2) * base^(index q) := by
  rw [xWord, yWord, zWord, distribute3]
  simp only [index, Fintype.sum_prod_type, pow_add]
  refine Finset.sum_congr rfl (fun i _ =>
    Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ => ?_)))
  ac_rfl

abbrev XT := Fin 25 → Fin 7 → ℕ
abbrev YT := Fin 25 → Fin 9 → ℕ
abbrev ZT := Fin 25 → Fin 9 → ℕ

def coefficients (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) (q : Axes) : ℕ :=
  ∑ t, (u t q.1 * y t q.2.1 * z t q.2.2 + x t q.1 * v t q.2.1 * z t q.2.2 +
    x t q.1 * y t q.2.1 * w t q.2.2)

def packedProduct (base : ℕ) (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) : ℕ :=
  ∑ t, (xWord base (u t) * yWord base (y t) * zWord base (z t) +
    xWord base (x t) * yWord base (v t) * zWord base (z t) +
    xWord base (x t) * yWord base (y t) * zWord base (w t))

theorem packedProduct_eq (base : ℕ) (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) :
    packedProduct base x y z u v w =
      ∑ q : Axes, (coefficients x y z u v w q) * base^(index q) := by
  unfold packedProduct coefficients
  simp only [separable, ← Finset.sum_add_distrib]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro q _
  simp only [Finset.sum_mul, add_mul]

def rowIndex : Axes ≃ Fin 567 :=
  (Equiv.prodCongr (Equiv.refl (Fin 7)) (@finProdFinEquiv 9 9)).trans finProdFinEquiv

theorem rowIndex_val (q : Axes) : (rowIndex q).val = index q := by
  rcases q with ⟨i,j,k⟩
  change k.val + 9*j.val + 81*i.val = 81*i.val + 9*j.val + k.val
  omega

def rowCoeff (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) (q : ℕ) : ℕ :=
  coefficients x y z u v w (rowIndex.symm (Fin.ofNat 567 q))

theorem packed_rows (base : ℕ) (x : XT) (y : YT) (z : ZT) (u : XT) (v : YT) (w : ZT) :
    packedProduct base x y z u v w = pack base (rowCoeff x y z u v w) 567 := by
  rw [packedProduct_eq, pack_sum, ← Equiv.sum_comp rowIndex]
  apply Finset.sum_congr rfl
  intro q _
  have hr : Fin.ofNat 567 (rowIndex q).val = rowIndex q := Fin.ext (Nat.mod_eq_of_lt (rowIndex q).isLt)
  rw [← rowIndex_val q, rowCoeff, hr, Equiv.symm_apply_apply]

end OMA.TangentBinaryRadix

namespace OMA.TangentBinaryRadix

open Finset

theorem pack_congr (b n : ℕ) (f g : ℕ → ℕ) (h : ∀ i < n, f i = g i) :
    pack b f n = pack b g n := by
  simp only [pack_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [h i.val i.isLt]

theorem pack_lt (b n : ℕ) (f : ℕ → ℕ) (h : ∀ i < n, f i < b) :
    pack b f n < b^n := by
  induction n generalizing f with
  | zero => simp [pack]
  | succ n ih =>
      rw [pack, pow_succ']
      have ht := ih (fun i => f (i+1)) (fun i hi => h (i+1) (by omega))
      calc
        _ < b + b * pack b (fun i => f (i+1)) n :=
          Nat.add_lt_add_right (h 0 (by omega)) _
        _ = b * (pack b (fun i => f (i+1)) n + 1) := by ring
        _ ≤ _ := Nat.mul_le_mul_left _ (by omega)

theorem pack_read {b : ℕ} (hb : 0 < b) (n w : ℕ) (hw : w < b^n) :
    pack b (fun i => w / b^i % b) n = w := by
  induction n generalizing w with
  | zero => simpa [pack] using (show 0 = w by simp at hw; omega)
  | succ n ih =>
      rw [pack, pow_zero, Nat.div_one]
      have hq : w / b < b^n := (Nat.div_lt_iff_lt_mul hb).mpr (by simpa [pow_succ] using hw)
      have ht : pack b (fun i => w / b^(i+1) % b) n =
          pack b (fun i => (w/b) / b^i % b) n := by
        apply pack_congr
        intro i _
        rw [pow_succ', Nat.div_div_eq_div_mul]
      rw [ht, ih (w/b) hq, Nat.mod_add_div]

theorem and_read (s i a c : ℕ) :
    (a &&& c) / (2^s)^i % 2^s =
      (a / (2^s)^i % 2^s) &&& (c / (2^s)^i % 2^s) := by
  simp only [← pow_mul, ← Nat.shiftRight_eq_div_pow, Nat.shiftRight_and_distrib,
    Nat.and_mod_two_pow]

theorem pack_and (s n : ℕ) (f g : ℕ → ℕ)
    (hf : ∀ i < n, f i < 2^s) (hg : ∀ i < n, g i < 2^s) :
    (pack (2^s) f n &&& pack (2^s) g n) =
      pack (2^s) (fun i => f i &&& g i) n := by
  have hb : 0 < (2 : ℕ)^s := pow_pos (by decide) _
  let w := pack (2^s) f n &&& pack (2^s) g n
  have hw : w < (2^s)^n := Nat.and_le_right.trans_lt (pack_lt _ _ g hg)
  calc
    w = pack (2^s) (fun i => w / (2^s)^i % 2^s) n := (pack_read hb n _ hw).symm
    _ = _ := by
      apply pack_congr
      intro i hi
      rw [show w = _ from rfl, and_read, digit_read hb f hf hi, digit_read hb g hg hi]

def geom (s n : ℕ) : ℕ := ((1 <<< (s*n)) - 1) / ((1 <<< s) - 1)

theorem geom_eq (s n : ℕ) (hs : 0 < s) :
    geom s n = pack (2^s) (fun _ => 1) n := by
  have hb : 1 < (2 : ℕ)^s := one_lt_pow₀ (by decide) (by omega)
  have hsum := geom_sum_mul_of_one_le (le_of_lt hb) n
  rw [geom, Nat.one_shiftLeft, Nat.one_shiftLeft, pow_mul, ← hsum,
    Nat.mul_div_cancel _ (by omega), pack_sum]
  simp only [one_mul]
  exact (Fin.sum_univ_eq_sum_range (fun i : ℕ => ((2 : ℕ)^s)^i) n).symm

end OMA.TangentBinaryRadix

namespace OMA.TangentBinaryRadix

private theorem read_mod (w bits off len : ℕ) (h : off+len ≤ bits) :
    w / 2^off % 2^len = (w % 2^bits) / 2^off % 2^len := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [← Nat.shiftRight_eq_div_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]
  by_cases hi : i < len
  · have hl : off+i < bits := by omega
    simp [hi, hl]
  · simp [hi]

def spread (w n step : ℕ) : ℕ :=
  (w * geom (step-3) n) &&& (7 * geom step n)

theorem spread_eq (w n step : ℕ) (hs : 3 ≤ step) (hpos : 0 < step-3)
    (hspace : 3*n ≤ step-3) (hw : w < 2^(3*n)) :
    spread w n step = pack (2^step) (fun i => w / 8^i % 8) n := by
  have hwb : w < 2^(step-3) :=
    hw.trans_le (Nat.pow_le_pow_right (by decide) hspace)
  have hb : 0 < (2:ℕ)^step := pow_pos (by decide) _
  have hb' : 0 < (2:ℕ)^(step-3) := pow_pos (by decide) _
  have h₇ : 7 < (2:ℕ)^step := lt_of_lt_of_le (by decide : 7 < (2:ℕ)^3)
    (Nat.pow_le_pow_right (by decide) hs)
  let wrep := w * geom (step-3) n
  let mask := 7 * geom step n
  have hwm : wrep = pack (2^(step-3)) (fun _ => w) n := by
    simp only [wrep, geom_eq _ _ hpos, pack_smul, mul_one]
  have hm : mask = pack (2^step) (fun _ => 7) n := by
    simp only [mask, geom_eq _ _ (by omega : 0 < step), pack_smul, mul_one]
  have hbound : (wrep &&& mask) < (2^step)^n :=
    Nat.and_le_right.trans_lt (hm.symm ▸ pack_lt _ _ _ (fun _ _ => h₇))
  change (wrep &&& mask) = _
  rw [← pack_read hb n _ hbound]
  apply pack_congr
  intro i hi
  rw [and_read, hm, digit_read hb _ (fun _ _ => h₇) hi]
  have hpow : (2:ℕ)^step = 2^(step-3) * 2^3 := by
    rw [← pow_add]
    congr 1
    omega
  have hdvd : (2:ℕ)^3 ∣ 2^step := pow_dvd_pow 2 hs
  change (wrep / (2^step)^i % 2^step &&& (2^3-1)) = _
  rw [Nat.and_two_pow_sub_one_eq_mod, Nat.mod_mod_of_dvd _ hdvd]
  have hsplit : ((2:ℕ)^step)^i = (2^(step-3))^i * 2^(3*i) := by
    rw [hpow, mul_pow, pow_mul]
  rw [hsplit, ← Nat.div_div_eq_div_mul]
  have hcut : 3*i+3 ≤ step-3 := by omega
  rw [read_mod _ _ _ _ hcut]
  have hread : wrep/(2^(step-3))^i % 2^(step-3) = w := by
    rw [hwm]
    exact digit_read hb' _ (fun _ _ => hwb) hi
  rw [hread, pow_mul]
  rfl

end OMA.TangentBinaryRadix

namespace OMA.TangentBinaryRadix

open Finset

def read (word i : ℕ) : ℕ := word / 8^i % 8

def slice (word start size : ℕ) : ℕ := (word / 8^start) % 2^(3*size)

theorem slice_read (word start size i : ℕ) (hi : i < size) :
    read (slice word start size) i = read word (start+i) := by
  have he : (8:ℕ)^i = 2^(3*i) := by rw [pow_mul]; rfl
  change (word / 8^start % 2^(3*size)) / 8^i % (2^3) = word / 8^(start+i) % (2^3)
  rw [he, ← read_mod _ _ _ _ (by omega : 3*i+3 ≤ 3*size), ← he,
    Nat.div_div_eq_div_mul, ← pow_add]

theorem slice_spread (w start n step : ℕ) (hs : 3 ≤ step)
    (hpos : 0 < step-3) (hspace : 3*n ≤ step-3) :
    spread (slice w start n) n step =
      pack (2^step) (fun i => read w (start+i)) n := by
  have hw : slice w start n < 2^(3*n) := Nat.mod_lt _ (pow_pos (by decide) _)
  rw [spread_eq _ _ _ hs hpos hspace hw]
  exact pack_congr _ _ _ _ fun i hi => slice_read w start n i hi

def axisX (w start : ℕ) : ℕ :=
  spread (slice w start 7) 7 (32*81)

def axisY (w start : ℕ) : ℕ :=
  spread (slice w start 9) 9 (32*9)

def axisZ (w start : ℕ) : ℕ := spread (slice w start 9) 9 32

theorem axisX_eq (w s : ℕ) :
    axisX w s = xWord (2^32) (fun i => read w (s+i.val)) := by
  rw [axisX, slice_spread _ _ _ _ (by decide) (by decide) (by decide), pack_sum, xWord]
  apply Finset.sum_congr rfl
  intro i _
  rw [← pow_mul, ← pow_mul, Nat.mul_assoc]

theorem axisY_eq (w s : ℕ) :
    axisY w s = yWord (2^32) (fun i => read w (s+i.val)) := by
  rw [axisY, slice_spread _ _ _ _ (by decide) (by decide) (by decide), pack_sum, yWord]
  apply Finset.sum_congr rfl
  intro i _
  rw [← pow_mul, ← pow_mul, Nat.mul_assoc]

theorem axisZ_eq (w s : ℕ) :
    axisZ w s = zWord (2^32) (fun i => read w (s+i.val)) := by
  rw [axisZ, slice_spread _ _ _ _ (by decide) (by decide) (by decide), pack_sum, zWord]

abbrev Words := ℕ → ℕ

def tangentTerm (X Y Z : Words) (v t : ℕ) : ℕ :=
  let x := axisX (X t) 0
  let y := axisY (Y t) 0
  let z := axisZ (Z t) 0
  let u' := axisX v (25*t)
  let v' := axisY v (25*t+7)
  let w' := axisZ v (25*t+16)
  u'*y*z + x*v'*z + x*y*w'

def fastProduct (X Y Z : Words) (v : ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => fastProduct X Y Z v n + tangentTerm X Y Z v n

def xAt (X : Words) (t : Fin 25) (i : Fin 7) : ℕ := read (X t.val) i.val
def yAt (Y : Words) (t : Fin 25) (i : Fin 9) : ℕ := read (Y t.val) i.val
def zAt (Z : Words) (t : Fin 25) (i : Fin 9) : ℕ := read (Z t.val) i.val
def uAt (v : ℕ) (t : Fin 25) (i : Fin 7) : ℕ := read v (25*t.val+i.val)
def vAt (v : ℕ) (t : Fin 25) (i : Fin 9) : ℕ := read v (25*t.val+7+i.val)
def wAt (v : ℕ) (t : Fin 25) (i : Fin 9) : ℕ := read v (25*t.val+16+i.val)

theorem fastProduct_eq (X Y Z : Words) (v : ℕ) :
    fastProduct X Y Z v 25 = packedProduct (2^32) (xAt X) (yAt Y) (zAt Z)
      (uAt v) (vAt v) (wAt v) := by
  have h (n : ℕ) : fastProduct X Y Z v n = ∑ t ∈ range n, tangentTerm X Y Z v t := by
    induction n with
    | zero => simp [fastProduct]
    | succ n ih => rw [fastProduct, Finset.sum_range_succ, ih]
  rw [h, ← Fin.sum_univ_eq_sum_range (tangentTerm X Y Z v) 25, packedProduct]
  apply Finset.sum_congr rfl
  intro t _
  simp only [tangentTerm, axisX_eq, axisY_eq, axisZ_eq, Nat.zero_add]
  rfl

end OMA.TangentBinaryRadix

namespace OMA.TangentBinaryRadix

open Finset

private theorem read_le (w i : ℕ) : read w i ≤ 7 :=
  Nat.le_of_lt_succ (Nat.mod_lt _ (by decide))

private theorem correction (r : Fin 567) :
    pack (2^32) (fun i => if i = r.val then 1 else 0) 567 = ((2:ℕ)^32)^r.val := by
  rw [pack_sum]
  simp only [← Fin.ext_iff, ite_mul, zero_mul, one_mul, Finset.sum_ite_eq',
    Finset.mem_univ, if_true]

private theorem coefficients_bound (X Y Z : Words) (word : ℕ) (a : Axes) :
    coefficients (xAt X) (yAt Y) (zAt Z) (uAt word) (vAt word) (wAt word) a ≤ 25725 := by
  unfold coefficients
  calc
    _ ≤ ∑ _ : Fin 25, 1029 := by
      apply Finset.sum_le_sum
      intro t _
      simp only [xAt, yAt, zAt, uAt, vAt, wAt]
      calc
        _ ≤ (7*7*7 + 7*7*7 + 7*7*7 : ℕ) := by
          gcongr <;> exact read_le _ _
        _ = _ := by decide
    _ = _ := by simp

def verified (word r : ℕ) : Prop := word &&& geom 32 567 = ((2:ℕ)^32)^r

theorem modularBasis (X Y Z : Words) (r : Fin 567) (word : ℕ)
    (h : verified (fastProduct X Y Z word 25) r.val) (q : Axes) :
    (coefficients (xAt X) (yAt Y) (zAt Z) (uAt word) (vAt word) (wAt word) q : ZMod 2) =
      if rowIndex q = r then 1 else 0 := by
  let f := rowCoeff (xAt X) (yAt Y) (zAt Z) (uAt word) (vAt word) (wAt word)
  have hb j (hj : j < 567) : f j < (2:ℕ)^32 :=
    (coefficients_bound X Y Z word (rowIndex.symm (Fin.ofNat 567 j))).trans_lt (by decide)
  unfold verified at h
  rw [fastProduct_eq, packed_rows, geom_eq _ _ (by decide), ← correction r,
    pack_and 32 567 f _ hb (fun _ _ => by decide)] at h
  let i := rowIndex q
  have e := congrArg (fun t : ℕ => t / ((2:ℕ)^32)^i.val % 2^32) h
  have hc : ∀ j < 567, f j &&& 1 < (2:ℕ)^32 :=
    fun j hj => Nat.and_le_left.trans_lt (hb j hj)
  have hd : ∀ j < 567, (if j = r.val then 1 else 0) < (2:ℕ)^32 := by
    intro j _
    split <;> decide
  rw [digit_read (by decide) _ hc i.isLt, digit_read (by decide) _ hd i.isLt,
    show f i.val &&& 1 = f i.val % 2 from Nat.and_two_pow_sub_one_eq_mod _ 1] at e
  have eq := congrArg (fun a : ℕ => (a : ZMod 2)) e
  have hfin : Fin.ofNat 567 i.val = i := Fin.ext (Nat.mod_eq_of_lt i.isLt)
  simpa only [ZMod.natCast_mod, Nat.cast_ite, Nat.cast_one, Nat.cast_zero, ← Fin.ext_iff,
    f, rowCoeff, hfin, i, Equiv.symm_apply_apply] using eq

end OMA.TangentBinaryRadix

namespace OMA.TangentBinaryRadix

open Finset Matrix

private theorem complexLift {I V : Type*} [Fintype I] [Fintype V] [DecidableEq I]
    (A : Matrix I V ℤ) (b : I → V → ZMod 2)
    (hb : ∀ i j, (A.map (fun z : ℤ => (z : ZMod 2))).mulVec (b i) j =
      if j = i then 1 else 0) :
    Function.Surjective (A.map (fun z : ℤ => (z : ℂ))).mulVec := by
  let B : Matrix V I ℤ := Matrix.of fun v i => ((b i v).val : ℤ)
  have hmod : (A * B).map (fun z : ℤ => (z : ZMod 2)) = 1 := by
    ext i j
    simp only [Matrix.map_apply, Matrix.mul_apply, Int.cast_sum, Int.cast_mul, B,
      Matrix.of_apply, Int.cast_natCast, ZMod.natCast_zmod_val, Matrix.one_apply]
    exact hb j i
  have hdet : ((A * B).det : ZMod 2) = 1 := by
    rw [Int.cast_det, hmod, Matrix.det_one]
  have hInt : (A * B).det ≠ 0 := by
    intro h
    rw [h, Int.cast_zero] at hdet
    exact (by decide : (0 : ZMod 2) ≠ 1) hdet
  let AC := A.map fun z : ℤ => (z : ℂ)
  let BC := B.map fun z : ℤ => (z : ℂ)
  have hcast : ((A * B).det : ℂ) = (AC * BC).det := by
    rw [Int.cast_det]
    change ((A * B).map (Int.castRingHom ℂ)).det =
      (A.map (Int.castRingHom ℂ) * B.map (Int.castRingHom ℂ)).det
    rw [Matrix.map_mul]
  have hComplex : (AC * BC).det ≠ 0 := by
    rw [← hcast]
    exact Int.cast_ne_zero.mpr hInt
  have hUnit : IsUnit (AC*BC) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hComplex)
  intro T
  obtain ⟨v,hv⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hUnit T
  exact ⟨BC.mulVec v, (Matrix.mulVec_mulVec v AC BC).trans hv⟩

end OMA.TangentBinaryRadix

namespace OMA.TangentBinaryRadix

open Finset Matrix

abbrev Row := Fin 567
abbrev Var := Fin 25 × (Fin 7 ⊕ Fin 9 ⊕ Fin 9)

def rowAxes : Row ≃ Axes := rowIndex.symm

def entry (X Y Z : Words) (q : Axes) (j : Var) : ℕ :=
  match j.2 with
  | .inl i => if q.1 = i then yAt Y j.1 q.2.1 * zAt Z j.1 q.2.2 else 0
  | .inr (.inl i) => if q.2.1 = i then xAt X j.1 q.1 * zAt Z j.1 q.2.2 else 0
  | .inr (.inr i) => if q.2.2 = i then xAt X j.1 q.1 * yAt Y j.1 q.2.1 else 0

def mat (X Y Z : Words) : Matrix Row Var ℤ :=
  Matrix.of fun i j => (entry X Y Z (rowAxes i) j : ℤ)

private theorem mat_eval (R : Type*) [CommRing R] (X Y Z : Words)
    (v : Var → R) (r : Row) :
    ((mat X Y Z).map (fun z : ℤ => (z : R))).mulVec v r =
      ∑ t, (v (t,.inl (rowAxes r).1) *
          ((yAt Y t (rowAxes r).2.1 : R) * (zAt Z t (rowAxes r).2.2 : R)) +
        (xAt X t (rowAxes r).1 : R) *
          (v (t,.inr (.inl (rowAxes r).2.1)) * (zAt Z t (rowAxes r).2.2 : R)) +
        (xAt X t (rowAxes r).1 : R) *
          ((yAt Y t (rowAxes r).2.1 : R) * v (t,.inr (.inr (rowAxes r).2.2)))) := by
  simp only [Matrix.mulVec, dotProduct, Fintype.sum_prod_type, Fintype.sum_sum_type]
  apply Finset.sum_congr rfl
  intro t _
  simp only [mat, Matrix.map_apply, Matrix.of_apply, entry, Int.cast_ite, Int.cast_mul, Int.cast_zero, Int.cast_natCast,
    Nat.cast_ite, Nat.cast_mul, Nat.cast_zero, ite_mul, zero_mul, Finset.sum_ite_eq,
    Finset.mem_univ, if_true]
  ring

def asBasis (a : ℕ) (j : Var) : ZMod 2 :=
  match j.2 with
  | .inl i => uAt a j.1 i
  | .inr (.inl i) => vAt a j.1 i
  | .inr (.inr i) => wAt a j.1 i

private theorem basis_eval (X Y Z : Words) (w : ℕ) (r : Row) :
    ((mat X Y Z).map (fun z : ℤ => (z : ZMod 2))).mulVec (asBasis w) r =
      (coefficients (xAt X) (yAt Y) (zAt Z) (uAt w) (vAt w) (wAt w) (rowAxes r) : ZMod 2) := by
  rw [mat_eval]
  simp only [asBasis, coefficients, Nat.cast_sum, Nat.cast_add, Nat.cast_mul, mul_assoc, mul_left_comm]

private def sample (f : ℕ → ℕ) (t i : ℕ) : Fin 1135 :=
  ⟨read (f t) i, (read_le _ _).trans_lt (by decide)⟩

theorem exactWitness (X Y Z : Words) (pre : Fin 567 → ℕ)
    (hp : ∀ r, verified (fastProduct X Y Z (pre r) 25) r.val) :
    ∃ x : Fin 25 → Fin 7 → Fin 1135, ∃ y z : Fin 25 → Fin 9 → Fin 1135,
      ∀ T : Fin 7 → Fin 9 → Fin 9 → ℂ, ∃ u : Fin 25 → Fin 7 → ℂ,
        ∃ v w : Fin 25 → Fin 9 → ℂ, ∀ i j k,
          T i j k = ∑ t, (u t i*(((y t j).val : ℂ)*((z t k).val : ℂ))+
              ((x t i).val : ℂ)*(v t j*((z t k).val : ℂ))+
              ((x t i).val : ℂ)*(((y t j).val : ℂ)*w t k)) := by
  have modEq (r q : Fin 567) :
      ((mat X Y Z).map (fun z : ℤ => (z : ZMod 2))).mulVec (asBasis (pre r)) q =
        if q = r then 1 else 0 := by
    rw [basis_eval, modularBasis X Y Z r (pre r) (hp r)]
    simp [rowAxes]
  have surj := complexLift (mat X Y Z) (asBasis ∘ pre) modEq
  refine ⟨fun t i => sample X t.val i.val, fun t j => sample Y t.val j.val,
    fun t k => sample Z t.val k.val, ?_⟩
  intro T
  obtain ⟨v,hv⟩ := surj (fun r => T (rowAxes r).1 (rowAxes r).2.1 (rowAxes r).2.2)
  refine ⟨fun t i => v (t,.inl i), fun t j => v (t,.inr (.inl j)), fun t k => v (t,.inr (.inr k)), ?_⟩
  intro i j k
  have h := congrFun hv (rowIndex (i,j,k))
  rw [mat_eval] at h
  simpa only [rowAxes, Equiv.symm_apply_apply, sample, xAt, yAt, zAt] using h.symm

end OMA.TangentBinaryRadix

