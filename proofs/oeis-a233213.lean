import OMAStatements.S_oeis_a233213

/-!
Proof of Barker's conjectures for OEIS A233213, by a transfer computation over the rows.

The continuation counts N (adapted from the merged proof of oeis-a233107 by @jleguina) satisfy,
on every state that a row can lead to, the recurrence of the polynomial x (x - 1) (x - 49) (x - 441).
Each row step is factored into four cell steps (st3, st2, st1, st0), so the kernel checks the
tables of N_1 .. N_4 through small intermediate tables instead of summing over all 1296 rows.
The tables were computed by a script and are checked by the kernel.
-/

namespace OMA.S_oeis_a233213

open PowerSeries

/-- The continuations by m rows of the scan from the row p with flags s1 s2. -/
def N (p : Fin 4 → Fin 6) (s1 s2 : Bool) (m : ℕ) : ℕ :=
  ∑ y : Fin m → Fin 4 → Fin 6, if ok p s1 s2 (List.ofFn y) = true then 1 else 0

theorem sum_cons {α : Type} [Fintype α] (m : ℕ) (f : List α → ℕ) :
    ∑ x : Fin (m + 1) → α, f (List.ofFn x) = ∑ c : α, ∑ y : Fin m → α, f (c :: List.ofFn y) := by
  rw [← (Fin.consEquiv fun _ => α).sum_comp]
  rw [Fintype.sum_prod_type (f := fun p : α × (Fin m → α) =>
    f (List.ofFn ((Fin.consEquiv fun _ => α) p)))]
  simp [List.ofFn_succ]

theorem N_zero (p : Fin 4 → Fin 6) (s1 s2 : Bool) : N p s1 s2 0 = 1 := by
  simp [N, ok]

theorem N_succ (p : Fin 4 → Fin 6) (s1 s2 : Bool) (m : ℕ) :
    N p s1 s2 (m + 1) = ∑ c : Fin 4 → Fin 6,
      if (antiOk p c && rowOk c s1 s2) = true then N c (seen1 c s1) (seen2 c s2) m else 0 := by
  have h := sum_cons m (fun l => if ok p s1 s2 l = true then 1 else 0)
  unfold N
  rw [h]
  apply Finset.sum_congr rfl
  intro c _
  by_cases hc : (antiOk p c && rowOk c s1 s2) = true
  · rw [if_pos hc]
    apply Finset.sum_congr rfl
    intro y _
    simp only [ok, hc, Bool.true_and]
  · rw [if_neg hc]
    apply Finset.sum_eq_zero
    intro y _
    have hc' := Bool.eq_false_iff.mpr hc
    have hk : ok p s1 s2 (c :: List.ofFn y) = false := by
      simp only [ok, hc', Bool.false_and]
    simp [hk]

theorem a_succ (n : ℕ) : a (n + 1) = ∑ c : Fin 4 → Fin 6,
    if (decide (c 0 = 0) && rowOk c false false) = true then
      N c (seen1 c false) (seen2 c false) n else 0 := by
  have h := sum_cons n (fun l => if valid l = true then 1 else 0)
  unfold a
  rw [Finset.card_filter, h]
  apply Finset.sum_congr rfl
  intro c _
  by_cases hc : (decide (c 0 = 0) && rowOk c false false) = true
  · rw [if_pos hc]
    unfold N
    apply Finset.sum_congr rfl
    intro y _
    simp only [valid, hc, Bool.true_and]
  · rw [if_neg hc]
    apply Finset.sum_eq_zero
    intro y _
    have hc' := Bool.eq_false_iff.mpr hc
    have hk : valid (c :: List.ofFn y) = false := by
      simp only [valid, hc', Bool.false_and]
    simp [hk]

/-! The row sums, one cell at a time. -/

abbrev F5 := Fin 6 → Fin 6 → Fin 6 → Bool → Bool → ℕ
abbrev F4 := Fin 6 → Fin 6 → Bool → Bool → ℕ

def up1 (s : Bool) (c : Fin 6) : Bool := s || decide (c = 1)
def up2 (s : Bool) (c : Fin 6) : Bool := s || decide (c = 2)
def nz (a b : Fin 6) : Bool := decide (a.val + b.val ≠ 5)

def st3 (F : F5) : F4 := fun d1 d2 v1 v2 =>
  ∑ d3 : Fin 6, if (nz d2 d3 && cellOk d3 v1 v2) = true then F d1 d2 d3 (up1 v1 d3) (up2 v2 d3) else 0
def st2 (G : F4) : F4 := fun q3 d1 u1 u2 =>
  ∑ d2 : Fin 6, if (nz q3 d2 && nz d1 d2 && cellOk d2 u1 u2) = true then G d1 d2 (up1 u1 d2) (up2 u2 d2) else 0
def st1 (H : F4) : F5 := fun q2 q3 d0 t1 t2 =>
  ∑ d1 : Fin 6, if (nz q2 d1 && nz d0 d1 && cellOk d1 t1 t2) = true then H q3 d1 (up1 t1 d1) (up2 t2 d1) else 0
def st0 (K : F5) : F5 := fun q1 q2 q3 s1 s2 =>
  ∑ d0 : Fin 6, if (nz q1 d0 && cellOk d0 s1 s2) = true then K q2 q3 d0 (up1 s1 d0) (up2 s2 d0) else 0
def fr2 (G : F4) (d1 : Fin 6) (u1 u2 : Bool) : ℕ :=
  ∑ d2 : Fin 6, if (nz d1 d2 && cellOk d2 u1 u2) = true then G d1 d2 (up1 u1 d2) (up2 u2 d2) else 0
def first (F : F5) : ℕ :=
  ∑ d1 : Fin 6, if (nz 0 d1 && cellOk d1 false false) = true then
    fr2 (st3 F) d1 (up1 false d1) (up2 false d1) else 0

theorem sum_pi4 (g : (Fin 4 → Fin 6) → ℕ) :
    ∑ c, g c = ∑ d0 : Fin 6, ∑ d1 : Fin 6, ∑ d2 : Fin 6, ∑ d3 : Fin 6, g ![d0, d1, d2, d3] := by
  let e : Fin 6 × Fin 6 × Fin 6 × Fin 6 ≃ (Fin 4 → Fin 6) :=
    { toFun := fun x => ![x.1, x.2.1, x.2.2.1, x.2.2.2]
      invFun := fun f => (f 0, f 1, f 2, f 3)
      left_inv := fun x => rfl
      right_inv := fun f => by
        funext j
        fin_cases j <;> rfl }
  rw [← e.sum_comp]
  simp only [Fintype.sum_prod_type]
  rfl

theorem cond_eq (p : Fin 4 → Fin 6) (s1 s2 : Bool) (d0 d1 d2 d3 : Fin 6) :
    (antiOk p ![d0, d1, d2, d3] && rowOk ![d0, d1, d2, d3] s1 s2) =
      ((nz (p 1) d0 && cellOk d0 s1 s2) &&
        ((nz (p 2) d1 && nz d0 d1 && cellOk d1 (up1 s1 d0) (up2 s2 d0)) &&
          ((nz (p 3) d2 && nz d1 d2 && cellOk d2 (up1 (up1 s1 d0) d1) (up2 (up2 s2 d0) d1)) &&
            (nz d2 d3 && cellOk d3 (up1 (up1 (up1 s1 d0) d1) d2) (up2 (up2 (up2 s2 d0) d1) d2))))) := by
  rw [Bool.eq_iff_iff]
  simp [antiOk, rowOk, horizOk, nz, up1, up2, Fin.forall_fin_succ]
  tauto

theorem seen1_eq (s1 : Bool) (d0 d1 d2 d3 : Fin 6) :
    seen1 ![d0, d1, d2, d3] s1 = up1 (up1 (up1 (up1 s1 d0) d1) d2) d3 := by
  rw [Bool.eq_iff_iff]; simp [seen1, up1, Fin.exists_fin_succ]; tauto

theorem seen2_eq (s2 : Bool) (d0 d1 d2 d3 : Fin 6) :
    seen2 ![d0, d1, d2, d3] s2 = up2 (up2 (up2 (up2 s2 d0) d1) d2) d3 := by
  rw [Bool.eq_iff_iff]; simp [seen2, up2, Fin.exists_fin_succ]; tauto

theorem rowOk_eq (s1 s2 : Bool) (d0 d1 d2 d3 : Fin 6) :
    rowOk ![d0, d1, d2, d3] s1 s2 =
      (cellOk d0 s1 s2 &&
        ((nz d0 d1 && cellOk d1 (up1 s1 d0) (up2 s2 d0)) &&
          ((nz d1 d2 && cellOk d2 (up1 (up1 s1 d0) d1) (up2 (up2 s2 d0) d1)) &&
            (nz d2 d3 && cellOk d3 (up1 (up1 (up1 s1 d0) d1) d2) (up2 (up2 (up2 s2 d0) d1) d2))))) := by
  rw [Bool.eq_iff_iff]
  simp [rowOk, horizOk, nz, up1, up2, Fin.forall_fin_succ]
  tauto

theorem row_sum (F : F5) (p : Fin 4 → Fin 6) (s1 s2 : Bool) :
    (∑ c : Fin 4 → Fin 6, if (antiOk p c && rowOk c s1 s2) = true then
      F (c 1) (c 2) (c 3) (seen1 c s1) (seen2 c s2) else 0) =
      st0 (st1 (st2 (st3 F))) (p 1) (p 2) (p 3) s1 s2 := by
  rw [sum_pi4]
  simp only [cond_eq, seen1_eq, seen2_eq, st0, st1, st2, st3, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.cons_val_zero, Matrix.head_cons, Matrix.tail_cons, Bool.and_eq_true, ite_and, Finset.sum_ite_irrel,
    Finset.sum_const_zero]

theorem first_sum (F : F5) :
    (∑ c : Fin 4 → Fin 6, if (decide (c 0 = 0) && rowOk c false false) = true then
      F (c 1) (c 2) (c 3) (seen1 c false) (seen2 c false) else 0) = first F := by
  rw [sum_pi4, Fin.sum_univ_succ]
  have hz : ∀ i : Fin 5, (∑ d1 : Fin 6, ∑ d2 : Fin 6, ∑ d3 : Fin 6,
      if (decide (![i.succ, d1, d2, d3] 0 = 0) && rowOk ![i.succ, d1, d2, d3] false false) = true then
        F (![i.succ, d1, d2, d3] 1) (![i.succ, d1, d2, d3] 2) (![i.succ, d1, d2, d3] 3)
          (seen1 ![i.succ, d1, d2, d3] false) (seen2 ![i.succ, d1, d2, d3] false) else 0) = 0 := by
    intro i
    simp [Fin.succ_ne_zero]
  rw [Finset.sum_eq_zero (fun i _ => hz i), add_zero]
  have h0 : cellOk 0 false false = true := by decide
  have h1 : up1 false 0 = false := by decide
  have h2 : up2 false 0 = false := by decide
  simp only [rowOk_eq, seen1_eq, seen2_eq, first, fr2, st3, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_zero, Matrix.head_cons, Matrix.tail_cons, h0, h1, h2, decide_true,
    Bool.true_and, Bool.and_eq_true, ite_and, Finset.sum_ite_irrel, Finset.sum_const_zero]

/-! Tables, packed as 40-bit fields of one numeral, computed by a script and checked by the kernel. -/

def look (t i : ℕ) : ℕ := (t >>> (40 * i)) % 1099511627776
def i5 (q1 q2 q3 : Fin 6) (s1 s2 : Bool) : ℕ :=
  (((q1.val * 6 + q2.val) * 6 + q3.val) * 2 + s1.toNat) * 2 + s2.toNat
def i4 (a b : Fin 6) (s1 s2 : Bool) : ℕ := ((a.val * 6 + b.val) * 2 + s1.toNat) * 2 + s2.toNat

/-- The continuation counts by no row. -/
def T0 : F5 := fun _ _ _ _ _ => 1

/-- st3 of the table of N_0. -/
def U3_0 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st2 of U3_0. -/
def U2_0 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st1 of U2_0. -/
def U1_0 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- The continuation counts by 1 rows. -/
def T1 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- st3 of the table of N_1. -/
def U3_1 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st2 of U3_1. -/
def U2_1 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st1 of U2_1. -/
def U1_1 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- The continuation counts by 2 rows. -/
def T2 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- st3 of the table of N_2. -/
def U3_2 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st2 of U3_2. -/
def U2_2 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st1 of U2_2. -/
def U1_2 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- The continuation counts by 3 rows. -/
def T3 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- st3 of the table of N_3. -/
def U3_3 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st2 of U3_3. -/
def U2_3 : F4 := fun a b s1 s2 => look  (i4 a b s1 s2)

/-- st1 of U2_3. -/
def U1_3 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- The continuation counts by 4 rows. -/
def T4 : F5 := fun q1 q2 q3 s1 s2 => look  (i5 q1 q2 q3 s1 s2)

/-- The states that a row can lead to. -/
def reach (q1 q2 q3 : Fin 6) (s1 s2 : Bool) : Bool :=
  decide ((0xfc88c0cc880c888088880888c088cc000000cc88c0cc880c8880888808880000000c88cc888880888808888088000000808888088888888880888808000000880888808888088888cc88c0000000888088880888c088cc0c88cc000000cc880c888088880888c088cc0c88cf >>> i5 q1 q2 q3 s1 s2) % 2 = 1)

theorem e3_0 : st3 T0 = U3_0 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e2_0 : st2 U3_0 = U2_0 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e1_0 : st1 U2_0 = U1_0 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem e0_0 : st0 U1_0 = T1 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem step_0 : st0 (st1 (st2 (st3 T0))) = T1 := by
  rw [e3_0, e2_0, e1_0, e0_0]

theorem e3_1 : st3 T1 = U3_1 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e2_1 : st2 U3_1 = U2_1 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e1_1 : st1 U2_1 = U1_1 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem e0_1 : st0 U1_1 = T2 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem step_1 : st0 (st1 (st2 (st3 T1))) = T2 := by
  rw [e3_1, e2_1, e1_1, e0_1]

theorem e3_2 : st3 T2 = U3_2 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e2_2 : st2 U3_2 = U2_2 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e1_2 : st1 U2_2 = U1_2 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem e0_2 : st0 U1_2 = T3 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem step_2 : st0 (st1 (st2 (st3 T2))) = T3 := by
  rw [e3_2, e2_2, e1_2, e0_2]

theorem e3_3 : st3 T3 = U3_3 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e2_3 : st2 U3_3 = U2_3 := by
  funext a b s1 s2; revert a b s1 s2; decide +kernel
theorem e1_3 : st1 U2_3 = U1_3 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem e0_3 : st0 U1_3 = T4 := by
  funext a b c s1 s2; revert a b c s1 s2; decide +kernel
theorem step_3 : st0 (st1 (st2 (st3 T3))) = T4 := by
  rw [e3_3, e2_3, e1_3, e0_3]

/-! The continuation counts N_1 .. N_4, from the tables. -/

theorem N_next (m : ℕ) (A B : F5) (hA : ∀ p s1 s2, N p s1 s2 m = A (p 1) (p 2) (p 3) s1 s2)
    (h : st0 (st1 (st2 (st3 A))) = B) (p : Fin 4 → Fin 6) (s1 s2 : Bool) :
    N p s1 s2 (m + 1) = B (p 1) (p 2) (p 3) s1 s2 := by
  rw [N_succ]
  simp only [hA]
  rw [row_sum, h]

theorem N0 (p : Fin 4 → Fin 6) (s1 s2 : Bool) : N p s1 s2 0 = T0 (p 1) (p 2) (p 3) s1 s2 :=
  N_zero p s1 s2
theorem N1 : ∀ p s1 s2, N p s1 s2 1 = T1 (p 1) (p 2) (p 3) s1 s2 := N_next 0 T0 T1 N0 step_0
theorem N2 : ∀ p s1 s2, N p s1 s2 2 = T2 (p 1) (p 2) (p 3) s1 s2 := N_next 1 T1 T2 N1 step_1
theorem N3 : ∀ p s1 s2, N p s1 s2 3 = T3 (p 1) (p 2) (p 3) s1 s2 := N_next 2 T2 T3 N2 step_2
theorem N4 : ∀ p s1 s2, N p s1 s2 4 = T4 (p 1) (p 2) (p 3) s1 s2 := N_next 3 T3 T4 N3 step_3

theorem reach_cells : ∀ (s1 s2 : Bool) (d0 d1 d2 d3 : Fin 6),
    (cellOk d0 s1 s2 &&
        ((nz d0 d1 && cellOk d1 (up1 s1 d0) (up2 s2 d0)) &&
          ((nz d1 d2 && cellOk d2 (up1 (up1 s1 d0) d1) (up2 (up2 s2 d0) d1)) &&
            (nz d2 d3 && cellOk d3 (up1 (up1 (up1 s1 d0) d1) d2) (up2 (up2 (up2 s2 d0) d1) d2))))) = true →
    reach d1 d2 d3 (up1 (up1 (up1 (up1 s1 d0) d1) d2) d3) (up2 (up2 (up2 (up2 s2 d0) d1) d2) d3) = true := by
  decide +kernel

/-- Every admissible row leads to a state of `reach`, whatever the flags before it. -/
theorem reach_step (s1 s2 : Bool) (c : Fin 4 → Fin 6) (hc : rowOk c s1 s2 = true) :
    reach (c 1) (c 2) (c 3) (seen1 c s1) (seen2 c s2) = true := by
  have hc4 : c = ![c 0, c 1, c 2, c 3] := by
    funext j; fin_cases j <;> rfl
  have h := reach_cells s1 s2 (c 0) (c 1) (c 2) (c 3)
  rw [← rowOk_eq, ← seen1_eq, ← seen2_eq, ← hc4] at h
  exact h hc

theorem base : ∀ (q1 q2 q3 : Fin 6) (s1 s2 : Bool), reach q1 q2 q3 s1 s2 = true →
    T4 q1 q2 q3 s1 s2 + 22099 * T2 q1 q2 q3 s1 s2 = 491 * T3 q1 q2 q3 s1 s2 + 21609 * T1 q1 q2 q3 s1 s2 := by
  decide +kernel

/-- The recurrence of the continuation counts, on every state of `reach`. -/
theorem N_rec (m : ℕ) : ∀ (p : Fin 4 → Fin 6) (s1 s2 : Bool), reach (p 1) (p 2) (p 3) s1 s2 = true →
    (N p s1 s2 (m + 4) : ℤ) =
      491 * N p s1 s2 (m + 3) - 22099 * N p s1 s2 (m + 2) + 21609 * N p s1 s2 (m + 1) := by
  induction m with
  | zero =>
    intro p s1 s2 hr
    rw [N4, N3, N2, N1]
    have h := base (p 1) (p 2) (p 3) s1 s2 hr
    omega
  | succ m ih =>
    intro p s1 s2 hr
    rw [N_succ p s1 s2 (m + 4), N_succ p s1 s2 (m + 3), N_succ p s1 s2 (m + 2),
      N_succ p s1 s2 (m + 1)]
    push_cast
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    split_ifs with hc
    · rw [Bool.and_eq_true] at hc
      exact ih _ _ _ (reach_step s1 s2 c hc.2)
    · simp

/-! The sequence. -/

theorem a_first (n : ℕ) (A : F5) (hA : ∀ p s1 s2, N p s1 s2 n = A (p 1) (p 2) (p 3) s1 s2) :
    a (n + 1) = first A := by
  rw [a_succ]
  simp only [hA]
  rw [first_sum]

theorem values : a 1 = 23 ∧ a 2 = 7222 ∧ a 3 = 3054973 ∧ a 4 = 1340889772 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [a_first 0 T0 N0]; decide +kernel
  · rw [a_first 1 T1 N1]; decide +kernel
  · rw [a_first 2 T2 N2]; decide +kernel
  · rw [a_first 3 T3 N3]; decide +kernel

/-- The recurrence of a, for n >= 5. -/
theorem a_rec5 (m : ℕ) :
    (a (m + 5) : ℤ) = 491 * a (m + 4) - 22099 * a (m + 3) + 21609 * a (m + 2) := by
  rw [a_succ (m + 4), a_succ (m + 3), a_succ (m + 2), a_succ (m + 1)]
  push_cast
  rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib,
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun c _ => ?_)
  split_ifs with hc
  · rw [Bool.and_eq_true] at hc
    exact N_rec m _ _ _ (reach_step false false c hc.2)
  · simp

/-- The recurrence of a, for n >= 4. -/
theorem a_rec (m : ℕ) :
    (a (m + 4) : ℚ) = 491 * a (m + 3) - 22099 * a (m + 2) + 21609 * a (m + 1) := by
  cases m with
  | zero =>
    obtain ⟨v1, v2, v3, v4⟩ := values
    rw [v1, v2, v3, v4]; norm_num
  | succ m =>
    have h := a_rec5 m
    have h' : (a (m + 5) : ℚ) = 491 * a (m + 4) - 22099 * a (m + 3) + 21609 * a (m + 2) := by
      exact_mod_cast h
    simpa [add_assoc] using h'

/-- Barker's closed form, for n >= 1. -/
theorem closed (n : ℕ) (hn : 1 ≤ n) : (a n : ℚ) = (2205 + 486 * 49 ^ n + 125 * 441 ^ n) / 3528 := by
  obtain ⟨v1, v2, v3, v4⟩ := values
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 4 with h4 | h4
    · interval_cases n
      · rw [v1]; norm_num
      · rw [v2]; norm_num
      · rw [v3]; norm_num
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
      rw [a_rec m, ih (m + 3) (by omega) (by omega), ih (m + 2) (by omega) (by omega),
        ih (m + 1) (by omega) (by omega)]
      ring

/-- Barker's g.f., as A(x) (1 - x)(1 - 49x)(1 - 441x) = x(23 - 4071x + 17248x^2). -/
theorem gf_mul : gf * ((1 - X) * (1 - 49 * X) * (1 - 441 * X)) =
    X * (23 - 4071 * X + 17248 * X ^ 2) := by
