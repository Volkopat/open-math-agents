namespace OMA.Helpers

/-- Repeated squaring modulo `m`. -/
def rsq (m : Nat) : Nat → Nat → Nat
  | 0, x => x
  | f+1, x => rsq m f (x * x % m)

theorem rsq_cast (m : Nat) : ∀ f x, ((rsq m f x : ℕ) : ZMod m) = (x : ZMod m) ^ (2 ^ f)
  | 0, x => by simp [rsq]
  | f+1, x => by
    rw [rsq, rsq_cast m f, ZMod.natCast_mod, Nat.cast_mul, pow_succ, pow_mul', pow_two]

/-- Binary modular exponentiation with fuel. -/
def pmod (m : Nat) : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, acc => acc
  | f+1, b, e, acc => pmod m f (b * b % m) (e / 2) (if e % 2 = 1 then acc * b % m else acc)

theorem pmod_cast (m : Nat) : ∀ f b e acc, e < 2 ^ f →
    ((pmod m f b e acc : ℕ) : ZMod m) = (acc : ZMod m) * (b : ZMod m) ^ e
  | 0, b, e, acc, h => by
      have he : e = 0 := by simpa using h
      subst he
      simp [pmod]
  | f+1, b, e, acc, h => by
      have h2 : e / 2 < 2 ^ f := by rw [pow_succ] at h; omega
      rw [pmod, pmod_cast m f _ _ _ h2]
      have he : e = 2 * (e / 2) + e % 2 := (Nat.div_add_mod e 2).symm
      split_ifs with hb
      · rw [ZMod.natCast_mod, ZMod.natCast_mod, Nat.cast_mul, Nat.cast_mul]
        conv_rhs => rw [he, hb]
        ring
      · have hb0 : e % 2 = 0 := by omega
        rw [ZMod.natCast_mod, Nat.cast_mul]
        conv_rhs => rw [he, hb0]
        ring

/-- Lucas certificate for `k * 2 ^ n + 1` with base `a` (the prime factors of `k * 2 ^ n`
are `2` and `k`). -/
def wit (k n a : Nat) : Bool :=
  (rsq (k * 2 ^ n + 1) (n - 1) (pmod (k * 2 ^ n + 1) 19 a k 1) == k * 2 ^ n) &&
  (rsq (k * 2 ^ n + 1) n a % (k * 2 ^ n + 1) != 1)

theorem wit_sound (k n a : ℕ) (hk : k.Prime) (hk19 : k < 2 ^ 19) (hn : 1 ≤ n)
    (h : wit k n a = true) : (k * 2 ^ n + 1).Prime := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨N, hN⟩ : ∃ N, N = k * 2 ^ (m + 1) + 1 := ⟨_, rfl⟩
  simp only [wit, Bool.and_eq_true, beq_iff_eq, bne_iff_ne, ne_eq, Nat.add_sub_cancel,
    ← hN] at h
  obtain ⟨h1, h2⟩ := h
  rw [← hN]
  have hk2 : 2 ≤ k := hk.two_le
  have hp2 : 2 ≤ 2 ^ (m + 1) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (m + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hkp : 4 ≤ k * 2 ^ (m + 1) := by nlinarith
  have hN5 : 5 ≤ N := by omega
  have hN1 : N - 1 = k * 2 ^ (m + 1) := by omega
  have hc : ((k * 2 ^ (m + 1) : ℕ) : ZMod N) = -1 := by
    have h0 : ((k * 2 ^ (m + 1) + 1 : ℕ) : ZMod N) = 0 := by
      rw [← hN]
      exact ZMod.natCast_self N
    push_cast at h0 ⊢
    linear_combination h0
  have c1 : (a : ZMod N) ^ (k * 2 ^ m) = -1 := by
    have := congrArg (fun x : ℕ => (x : ZMod N)) h1
    rw [rsq_cast, pmod_cast _ _ _ _ _ (by simpa using hk19), hc, Nat.cast_one, one_mul,
      ← pow_mul] at this
    exact this
  have hne : (-1 : ZMod N) ≠ 1 := by
    intro h
    have h2' : ((2 : ℕ) : ZMod N) = 0 := by
      push_cast
      linear_combination -h
    rw [ZMod.natCast_eq_zero_iff] at h2'
    have := Nat.le_of_dvd (by norm_num) h2'
    omega
  apply lucas_primality N (a : ZMod N)
  · rw [hN1, pow_succ, ← mul_assoc, pow_mul, c1]
    norm_num
  · intro q hq hqd
    rw [hN1] at hqd ⊢
    rcases (Nat.Prime.dvd_mul hq).1 hqd with hqk | hq2
    · have hqk' : q = k := (Nat.prime_dvd_prime_iff_eq hq hk).1 hqk
      subst hqk'
      rw [Nat.mul_div_cancel_left _ hq.pos]
      intro hone
      apply h2
      have h3 : ((rsq N (m + 1) a : ℕ) : ZMod N) = ((1 : ℕ) : ZMod N) := by
        rw [rsq_cast, hone, Nat.cast_one]
      rw [ZMod.natCast_eq_natCast_iff'] at h3
      rw [h3]
      exact Nat.mod_eq_of_lt (by omega)
    · have hq2' : q = 2 := (Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1
        (hq.dvd_of_dvd_pow hq2)
      subst hq2'
      rw [pow_succ, ← mul_assoc, Nat.mul_div_cancel _ (by norm_num), c1]
      exact hne

/-- Trial division by `d, d + 2, d + 4, ...` (fuel `f`). -/
def td (j : Nat) : Nat → Nat → Bool
  | 0, _ => false
  | f+1, d => (decide (d < j) && j % d == 0) || td j f (d + 2)

theorem td_sound (j : ℕ) : ∀ f d, 2 ≤ d → td j f d = true → ¬ j.Prime
  | 0, d, _, h => by simp [td] at h
  | f+1, d, hd, h => by
    simp only [td, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    rcases h with ⟨h1, h2⟩ | h
    · exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero h2) hd h1
    · exact td_sound j f (d + 2) (by omega) h

def npB (j : Nat) : Bool :=
  decide (j < 2) || (decide (2 < j) && j % 2 == 0) || td j 300 3

theorem npB_sound (j : ℕ) (h : npB j = true) : ¬ j.Prime := by
  simp only [npB, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  rcases h with (h | ⟨h1, h2⟩) | h
  · intro hp
    have := hp.two_le
    omega
  · exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero h2) (le_refl 2) h1
  · exact td_sound j 300 3 (by norm_num) h

