theorem OMA.solution : OMA.R_SierpinskiNumber_prime_sierpinski_problem_R1_H1_R1.H1 := by
  intro k hk hp hexc hhard
  have hP : OMA.Helpers.P k := by
    rcases Nat.lt_or_ge k 271128 with h | h
    · exact OMA.Helpers.allP k h
    · have h' : k = 271128 := by omega
      subst h'
      exact absurd hp (OMA.Helpers.npB_sound 271128 (by decide +kernel))
  rcases hP hp with h | h
  · exact h
  · exfalso
    rcases OMA.Helpers.excAll_sub k h with h' | h'
    · exact hexc h'
    · exact hhard h'
