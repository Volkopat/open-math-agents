/-- A prime `j` has a small Sierpinski witness or is one of the listed exceptions. -/
def P (j : ℕ) : Prop := j.Prime → (∃ n ≤ 1200, (j * 2 ^ n + 1).Prime) ∨ j ∈ excAll

def eok (p n a : Nat) : Bool :=
  if n = 0 then decide (p ∈ excAll)
  else (decide (n ≤ 1200) && decide (p < 2 ^ 19) && wit p n a)

theorem eok_sound (p n a : ℕ) (h : eok p n a = true) : P p := by
  intro hp
  unfold eok at h
  split_ifs at h with hn
  · exact Or.inr (by simpa using h)
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inl ⟨n, h.1.1, wit_sound p n a hp h.1.2 (by omega) h.2⟩

/-- The first number from `k` on that `npB` does not reject (fuel `f`). -/
def nx : ℕ → ℕ → ℕ
  | 0, k => k
  | f+1, k => if npB k then nx f (k + 1) else k

theorem nx_sound : ∀ f k i, k ≤ i → i < nx f k → ¬ i.Prime
  | 0, k, i, h1, h2 => by simp only [nx] at h2; omega
  | f+1, k, i, h1, h2 => by
    simp only [nx] at h2
    split_ifs at h2 with h
    · rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · exact npB_sound _ h
      · exact nx_sound f (k + 1) i hlt h2
    · omega

/-- Walk through the primes: each entry is the Sierpinski exponent of the next prime
(`0` for a listed exception); the Lucas base is searched. -/
def go : Nat → List Nat → Option Nat
  | k, [] => some k
  | k, n :: l =>
    if [3, 2, 5, 7, 11, 13, 17, 19, 23, 29, 31].any (eok (nx 128 k) n) then go (nx 128 k + 1) l
    else none

theorem go_sound : ∀ (l : List Nat) (k k' : Nat), go k l = some k' →
    (∀ j < k, P j) → ∀ j < k', P j
  | [], k, k', h, hk => by
    simp only [go, Option.some.injEq] at h
    subst h
    exact hk
  | n :: l, k, k', h, hk => by
    simp only [go] at h
    split_ifs at h with hc
    obtain ⟨a, -, ha⟩ := List.any_eq_true.mp hc
    apply go_sound l _ _ h
    intro j hj
    rcases Nat.lt_or_ge j k with h1 | h1
    · exact hk j h1
    rcases Nat.lt_or_ge j (nx 128 k) with h2 | h2
    · intro hp
      exact absurd hp (nx_sound _ _ _ h1 h2)
    have : j = nx 128 k := by omega
    subst this
    exact eok_sound _ _ _ ha

/-- Base-8 varint nibbles. -/
def dec : ℕ → ℕ → ℕ → ℕ → List ℕ
  | 0, _, _, _ => []
  | f+1, z, m, y =>
    if y % 16 < 8 then (z + y % 16 * m) :: dec f 0 1 (y / 16)
    else dec f (z + (y % 16 - 8) * m) (8 * m) (y / 16)

