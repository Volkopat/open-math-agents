noncomputable section

def decay (c x : ℝ) : ℝ := exp (-c * log x ^ (1 / 10 : ℝ))
lemma decay_pos (c x : ℝ) : 0 < decay c x := exp_pos _
lemma exp_log_half_eq_sqrt {x : ℝ} (hx : 0 < x) : exp (log x / 2) = √x := by rw [← log_sqrt hx.le, exp_log (sqrt_pos.2 hx)]
lemma sqrt_le_decay_eventually {c : ℝ} (hc : 0 < c) : ∀ᶠ x : ℝ in atTop, 1 ≤ x * decay c x ∧ √x ≤ x * decay c x ∧ √x * log x ≤ 4 * (x * decay c x) := by
 have hlog := tendsto_log_atTop.eventually_ge_atTop (max 1 ((4 * c) ^ 2))
 filter_upwards [hlog, eventually_gt_atTop 0] with x hL hx
 have hL1 : 1 ≤ log x := (le_max_left _ _).trans hL
 have hL0 : 0 ≤ log x := zero_le_one.trans hL1
 have hs : 4 * c ≤ √(log x) := le_sqrt_of_sq_le ((le_max_right _ _).trans hL)
 have hcL : c * log x ^ (1 / 10 : ℝ) ≤ log x / 4 := by
  have hpow : log x ^ (1 / 10 : ℝ) ≤ √(log x) := by
   rw [sqrt_eq_rpow]
   exact rpow_le_rpow_of_exponent_le hL1 (by norm_num)
  calc
   _ ≤ c * √(log x) := mul_le_mul_of_nonneg_left hpow hc.le
   _ = (4 * c * √(log x)) / 4 := by ring
   _ ≤ (√(log x) * √(log x)) / 4 := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hs (sqrt_nonneg _)) (by norm_num)
   _ = _ := by rw [mul_self_sqrt hL0]
 have hE : exp (3 * log x / 4) ≤ x * decay c x := by
  calc
   _ ≤ exp (log x + (-c * log x ^ (1 / 10 : ℝ))) := by
    apply exp_le_exp.mpr
    linarith
   _ = _ := by rw [exp_add, exp_log hx]; rfl
 have h1 : 1 ≤ exp (3 * log x / 4) := one_le_exp_iff.mpr (by positivity)
 have h2 : √x ≤ exp (3 * log x / 4) := by
  rw [← exp_log_half_eq_sqrt hx]
  exact exp_le_exp.mpr (by linarith)
 have h3 : √x * log x ≤ 4 * exp (3 * log x / 4) := by
  have hh : log x ≤ 4 * exp (log x / 4) := by linarith [add_one_le_exp (log x / 4)]
  calc
   _ ≤ √x * (4 * exp (log x / 4)) := mul_le_mul_of_nonneg_left hh (sqrt_nonneg _)
   _ = _ := by
    rw [← exp_log_half_eq_sqrt hx, show 3 * log x / 4 = log x / 2 + log x / 4 by ring, exp_add]
    ring
 exact ⟨h1.trans hE, h2.trans hE, h3.trans (mul_le_mul_of_nonneg_left hE (by norm_num))⟩
lemma quantitative_theta : ∃ c > 0, (fun x : ℝ => θ x - x) =O[atTop] fun x => x * decay c x := by
 obtain ⟨c, hc, hpsi⟩ := PNTPort.MediumPNT
 obtain ⟨B, hB, hbound⟩ := hpsi.exists_pos
 refine ⟨c, hc, IsBigO.of_bound (B + 8) ?_⟩
 filter_upwards [hbound.bound, sqrt_le_decay_eventually hc, eventually_ge_atTop 2] with x hpsi hsmall hx
 have hright : 0 ≤ x * decay c x := by linarith [hsmall.1]
 have hp : ‖ψ x - x‖ ≤ B * (x * decay c x) := by
  change ‖ψ x - x‖ ≤ B * ‖x * decay c x‖ at hpsi
  simpa only [norm_of_nonneg hright] using hpsi
 have hpt : ‖ψ x - θ x‖ ≤ 2 * (√x * log x) := by simpa only [norm_eq_abs, mul_assoc] using Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log (by linarith : 1 ≤ x)
 rw [norm_of_nonneg hright]
 calc
  _ = ‖(ψ x - x) - (ψ x - θ x)‖ := by congr 1; ring
  _ ≤ ‖ψ x - x‖ + ‖ψ x - θ x‖ := norm_sub_le _ _
  _ ≤ B * (x * decay c x) + 2 * (√x * log x) := add_le_add hp hpt
  _ ≤ _ := by linarith [hsmall.2.2]
lemma decay_mono {c a b : ℝ} (hc : 0 ≤ c) (ha : 1 ≤ a) (hab : a ≤ b) : decay c b ≤ decay c a := by
 have hlog := log_le_log (zero_lt_one.trans_le ha) hab
 have hpow := rpow_le_rpow (log_nonneg ha) hlog (by norm_num : (0 : ℝ) ≤ 1 / 10)
 exact exp_le_exp.mpr (by nlinarith)
lemma decay_sqrt_le {c x : ℝ} (hc : 0 ≤ c) (hx : 1 ≤ x) : decay c (√x) ≤ decay (c / 2) x := by
 have hz := log_nonneg hx
 have hr : (1 / 2 : ℝ) ≤ (1 / 2 : ℝ) ^ (1 / 10 : ℝ) := by simpa using rpow_le_rpow_of_exponent_ge (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (1 / 2 : ℝ) ≤ 1) (by norm_num : (1 / 10 : ℝ) ≤ 1)
 have hlog : (1 / 2) * log x ^ (1 / 10 : ℝ) ≤ log (√x) ^ (1 / 10 : ℝ) := by
  rw [log_sqrt (zero_le_one.trans hx),
   show log x / 2 = (1 / 2) * log x by ring,
   mul_rpow (show (0 : ℝ) ≤ 1 / 2 by norm_num) hz]
  exact mul_le_mul_of_nonneg_right hr (rpow_nonneg hz _)
 unfold decay
 apply exp_le_exp.mpr
 have h := mul_le_mul_of_nonneg_left hlog hc
 linarith
def err (t : ℝ) : ℝ := (θ t - t) / (t * log t ^ 2)
lemma θ_intervalIntegrable {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) : IntervalIntegrable (fun t => θ t / (t * log t ^ 2)) volume a b := by
 rw [intervalIntegrable_iff_integrableOn_Icc_of_le hab]
 apply (Chebyshev.integrableOn_theta_div_id_mul_log_sq b).mono_set
 exact Set.Icc_subset_Icc_left ha
lemma lin_intervalIntegrable {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) : IntervalIntegrable (fun t => t / (t * log t ^ 2)) volume a b := by
 rw [intervalIntegrable_iff_integrableOn_Icc_of_le hab]
 apply ContinuousOn.integrableOn_Icc
 intro t ht
 have ht' : 2 ≤ t := ha.trans ht.1
 have ht0 : 0 < t := by linarith
 have hlog : 0 < log t := log_pos (by linarith)
 exact ContinuousAt.continuousWithinAt (by fun_prop (disch := positivity))
lemma err_intervalIntegrable {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) : IntervalIntegrable err volume a b := by
 change IntervalIntegrable (fun t => (θ t - t) / (t * log t ^ 2)) volume a b
 simpa only [sub_div, Pi.sub_apply] using (θ_intervalIntegrable ha hab).sub (lin_intervalIntegrable ha hab)
lemma primeCounting_sub_li {x : ℝ} (hx : 2 ≤ x) : (Nat.primeCounting ⌊x⌋₊ : ℝ) - ∫ t in 2..x, (log t)⁻¹ = (θ x - x) / log x + (∫ t in 2..x, err t) + 2 / log 2 := by
 have h := _root_.integral_log_inv 2 x (by norm_num) hx
 have hint : (∫ t in 2..x, t / (t * log t ^ 2)) = ∫ t in 2..x, (log t ^ 2)⁻¹ := by
  refine intervalIntegral.integral_congr (fun t ht => ?_)
  rw [Set.uIcc_of_le hx] at ht
  have ht0 : 0 < t := by linarith [ht.1]
  have htlog : 0 < log t := log_pos (by linarith [ht.1])
  field_simp
 rw [Chebyshev.primeCounting_eq_theta_div_log_add_integral hx, h]
 unfold err
 simp_rw [sub_div]
 rw [intervalIntegral.integral_sub (θ_intervalIntegrable (le_refl _) hx) (lin_intervalIntegrable (le_refl _) hx), hint]
 ring
lemma err_norm_integral_le {a b d : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) (hd : 0 ≤ d) (h : ∀ t ∈ Set.Icc a b, ‖θ t - t‖ ≤ t * d) : ‖∫ t in a..b, err t‖ ≤ (d / log 2 ^ 2) * (b - a) := by
 rw [← abs_of_nonneg (sub_nonneg.mpr hab)]
 apply intervalIntegral.norm_integral_le_of_norm_le_const
 intro t ht
 rw [Set.uIoc_of_le hab] at ht
 have htt : 2 ≤ t := ha.trans ht.1.le
 have ht0 : 0 < t := by linarith
 have hlog2 : 0 < log 2 := log_pos (by norm_num)
 have hlog : log 2 ≤ log t := log_le_log (by norm_num) htt
 have hs : log 2 ^ 2 ≤ log t ^ 2 := by nlinarith
 have hlogt : 0 < log t := hlog2.trans_le hlog
 have hdpos : 0 < t * log t ^ 2 := by positivity
 rw [err, norm_div, norm_of_nonneg hdpos.le]
 calc
  _ ≤ (t * d) / (t * log t ^ 2) := div_le_div_of_nonneg_right (h t ⟨ht.1.le, ht.2⟩) hdpos.le
  _ = d / log t ^ 2 := by field_simp
  _ ≤ _ := div_le_div_of_nonneg_left hd (by positivity) hs
lemma theta_crude {t : ℝ} (ht : 0 ≤ t) : ‖θ t - t‖ ≤ t * (1 + log 4) := by
 calc
  _ ≤ ‖θ t‖ + ‖t‖ := norm_sub_le _ _
  _ = θ t + t := by rw [norm_of_nonneg (Chebyshev.theta_nonneg _), norm_of_nonneg ht]
  _ ≤ _ := by linarith [Chebyshev.theta_le_log4_mul_x ht]
lemma primeCounting_sub_li_isBigO : ∃ c > 0, (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) - ∫ u in 2..x, (log u)⁻¹) =O[atTop] fun x => x * exp (-c * (log x) ^ (1 / 10 : ℝ)) := by
 obtain ⟨c, hc, htheta⟩ := quantitative_theta
 obtain ⟨B, hB, htheta⟩ := htheta.exists_pos
 obtain ⟨a, ha⟩ := eventually_atTop.1 htheta.bound
 have hlog2 : 0 < log 2 := log_pos (by norm_num)
 let C₁ := B / log 2
 let C₂ := (1 + log 4) / log 2 ^ 2
 let C₃ := B / log 2 ^ 2
 let C₄ := 2 / log 2
 refine ⟨c / 2, by positivity, IsBigO.of_bound (C₁ + C₂ + C₃ + C₄) ?_⟩
 filter_upwards [eventually_ge_atTop (max 4 (a ^ 2)), sqrt_le_decay_eventually (show 0 < c / 2 by positivity)] with x hx hsmall
 have hx4 := (le_max_left _ _).trans hx
 have hxa := (le_max_right _ _).trans hx
 have hx2 : 2 ≤ x := by linarith
 have hx0 : 0 < x := by linarith
 have hs2 : 2 ≤ √x := le_sqrt_of_sq_le (by norm_num; exact hx4)
 have hsa : a ≤ √x := le_sqrt_of_sq_le hxa
 have hsx : √x ≤ x := sqrt_le_self_iff.mpr (Or.inr (by linarith))
 let Z := x * decay (c / 2) x
 have hZ : 0 ≤ Z := mul_nonneg hx0.le (decay_pos _ _).le
 have hZ1 : 1 ≤ Z := hsmall.1
 have hnorm (t : ℝ) (hts : √x ≤ t) : ‖θ t - t‖ ≤ B * (t * decay (c / 2) x) := by
  have ht0 : 0 ≤ t := (sqrt_nonneg _).trans hts
  have hta := hsa.trans hts
  have hc' : 0 ≤ c := hc.le
  have hmono := decay_mono hc' ((by norm_num : (1 : ℝ) ≤ 2).trans hs2) hts
  have hdec := hmono.trans (decay_sqrt_le hc' (by linarith : 1 ≤ x))
  calc
   _ ≤ B * (t * decay c t) := by simpa [norm_of_nonneg (mul_nonneg ht0 (decay_pos _ _).le)] using ha t hta
   _ ≤ _ := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hdec ht0) hB.le
 have hterm₁ : ‖(θ x - x) / log x‖ ≤ C₁ * Z := by
  have hlogx : 0 < log x := log_pos (by linarith)
  rw [norm_div, norm_of_nonneg hlogx.le]
  calc
   _ ≤ (B * Z) / log x := div_le_div_of_nonneg_right (hnorm x hsx) hlogx.le
   _ ≤ (B * Z) / log 2 := div_le_div_of_nonneg_left (mul_nonneg hB.le hZ) hlog2 (log_le_log (by norm_num) hx2)
   _ = _ := by dsimp [C₁]; ring
 have hterm₂ : ‖∫ t in 2..√x, err t‖ ≤ C₂ * Z := by
  have hh := err_norm_integral_le (le_refl _) hs2 (show 0 ≤ 1 + log 4 by positivity) (fun t ht => theta_crude (by linarith [ht.1]))
  have hC₂ : 0 ≤ C₂ := by dsimp [C₂]; positivity
  exact hh.trans (mul_le_mul_of_nonneg_left (by linarith [hsmall.2.1]) hC₂)
 have hterm₃ : ‖∫ t in √x..x, err t‖ ≤ C₃ * Z := by
  have hh := err_norm_integral_le hs2 hsx (show 0 ≤ B * decay (c / 2) x from mul_nonneg hB.le (decay_pos _ _).le) (fun t ht => by simpa only [mul_assoc, mul_left_comm] using hnorm t ht.1)
  have hC : 0 ≤ B * decay (c / 2) x / log 2 ^ 2 := by
   have := decay_pos (c / 2) x
   positivity
  calc
   _ ≤ (B * decay (c / 2) x / log 2 ^ 2) * (x - √x) := hh
   _ ≤ (B * decay (c / 2) x / log 2 ^ 2) * x := mul_le_mul_of_nonneg_left (sub_le_self _ (sqrt_nonneg _)) hC
   _ = _ := by dsimp [C₃, Z]; ring
 have hterm₄ : ‖2 / log 2‖ ≤ C₄ * Z := by
  rw [show (2 : ℝ) / log 2 = C₄ by rfl, norm_of_nonneg (by dsimp [C₄]; positivity)]
  exact le_mul_of_one_le_right (by dsimp [C₄]; positivity) hZ1
 change ‖(Nat.primeCounting ⌊x⌋₊ : ℝ) - ∫ u in 2..x, (log u)⁻¹‖ ≤ (C₁ + C₂ + C₃ + C₄) * ‖Z‖
 rw [primeCounting_sub_li hx2, norm_of_nonneg hZ, ← intervalIntegral.integral_add_adjacent_intervals (err_intervalIntegrable (le_refl _) hs2) (err_intervalIntegrable hs2 hsx)]
 calc
  _ ≤ ‖(θ x - x) / log x‖ + (‖∫ t in 2..√x, err t‖ + ‖∫ t in √x..x, err t‖) + ‖2 / log 2‖ := (norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add le_rfl (norm_add_le _ _))) le_rfl)
  _ ≤ _ := by nlinarith

/-- The prime number theorem with error term, in the form used by the Erdős 454 long-chord step:
`π(x) - li(x) = O(x exp(-c (log x)^(1/10)))` for some `c > 0`. -/
theorem piLi_bound : ∃ c > 0, (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) - ∫ u in (2 : ℝ)..x, (Real.log u)⁻¹)
    =O[atTop] fun x => x * Real.exp (-c * (Real.log x) ^ (1 / 10 : ℝ)) :=
  primeCounting_sub_li_isBigO

end

end PNTBridge

end PNT_QuantitativeBridge

/-
Long-chord argument (namespace Chords454). With a = p(n - i), b = p(n), c = p(n + i), where
p = Nat.nth Prime and pi(a), pi(b), pi(c) = n - i + 1, n + 1, n + i + 1, the prime number theorem with
error term (PiLi, supplied by the bridge lemma above) gives li(c) - li(b) and li(b) - li(a) equal to i up
to an error that is o(n / (log n)^5) uniformly for 2 <= x <= 10 n log n. Two-sided second-order bounds
for the logarithmic integral (LiTaylor, from 1 - 1/t <= log t) then give c + a - 2b at least of order
i^2 / n >= n / (log2 n)^4, which exceeds any fixed B for large n.

Lean formalization, November 27, 2026, for sobrien032, by Claude models: Claude Opus 5.5 ported the
prime number theorem block above; Claude Fable 5.2 proved the bounds for the logarithmic integral
(LiTaylor); Claude Opus 5.5 proved the long-chord estimate from PiLi and LiTaylor; Claude Opus 5.5
assembled this file.
-/

namespace Chords454

open Filter Real

/-- The prime number theorem with error term: `π(x) - li(x) = O(x exp(-c (log x)^(1/10)))`,
where `li(x)` is the integral of `1 / log u` from 2 to `x`. -/
def PiLi : Prop :=
  ∃ c > 0, (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) - ∫ u in (2 : ℝ)..x, (Real.log u)⁻¹)
    =O[atTop] fun x => x * Real.exp (-c * (Real.log x) ^ (1 / 10 : ℝ))

/-- Second-order bounds for the logarithmic integral on `[a, b]` with `2 ≤ a ≤ b`: the integral of
`1 / log u` lies between `(b - a) / log b + (b - a)^2 / (2 b log^2 b)` and
`(b - a) / log a - (b - a)^2 / (2 b log^2 b)`. -/
def LiTaylor : Prop :=
  ∀ a b : ℝ, 2 ≤ a → a ≤ b →
    (b - a) / Real.log b + (b - a) ^ 2 / (2 * b * Real.log b ^ 2) ≤ ∫ u in a..b, (Real.log u)⁻¹ ∧
    ∫ u in a..b, (Real.log u)⁻¹ ≤ (b - a) / Real.log a - (b - a) ^ 2 / (2 * b * Real.log b ^ 2)

/-
Erdős 454 long-chord step H1, part T.

Second-order bounds for the logarithmic integral: `Chords454.liTaylor_holds : Chords454.LiTaylor`.

For `1 < a ≤ u ≤ b` the elementary inequality `1 - 1 / t ≤ log t` gives the two pointwise bounds
`1 / log b + (b - u) / (b log^2 b) ≤ 1 / log u ≤ 1 / log a - (u - a) / (b log^2 b)`,
and both sides are integrated over `[a, b]` with explicit antiderivatives.
-/

namespace T

/-- For `0 < x` and `0 < y`, `(y - x) / y ≤ log y - log x` (from `1 - t⁻¹ ≤ log t` at
`t = y / x`). -/
theorem log_sub_log_ge {x y : ℝ} (hx : 0 < x) (hy : 0 < y) :
    (y - x) / y ≤ Real.log y - Real.log x := by
  have h := Real.one_sub_inv_le_log_of_pos (div_pos hy hx)
  rw [Real.log_div hy.ne' hx.ne'] at h
  have e : 1 - (y / x)⁻¹ = (y - x) / y := by
    field_simp
  rw [e] at h
  exact h

/-- The tangent line of `1 / log` at the right endpoint `b`, with the slope bounded through
`log b - log u ≥ (b - u) / b`, lies below the graph on `(1, b]`. -/
theorem lower_pt {u b : ℝ} (hu : 1 < u) (hub : u ≤ b) :
    1 / Real.log b + (b - u) / (b * Real.log b ^ 2) ≤ (Real.log u)⁻¹ := by
  have hu0 : 0 < u := by linarith
  have hb0 : 0 < b := by linarith
  have hlu : 0 < Real.log u := Real.log_pos hu
  have hlb : 0 < Real.log b := Real.log_pos (lt_of_lt_of_le hu hub)
  have h1 : (b - u) / b ≤ Real.log b - Real.log u := log_sub_log_ge hu0 hb0
  have h2 : (b - u) / (b * Real.log b ^ 2) ≤ (Real.log b - Real.log u) / Real.log b ^ 2 := by
    rw [← div_div]
    exact div_le_div_of_nonneg_right h1 (sq_nonneg _)
  have h3 : 1 / Real.log b + (Real.log b - Real.log u) / Real.log b ^ 2 ≤ (Real.log u)⁻¹ := by
    rw [← sub_nonneg]
    have e : (Real.log u)⁻¹ - (1 / Real.log b + (Real.log b - Real.log u) / Real.log b ^ 2)
        = (Real.log b - Real.log u) ^ 2 / (Real.log u * Real.log b ^ 2) := by
      field_simp
      ring
    rw [e]
    exact div_nonneg (sq_nonneg _) (mul_pos hlu (pow_pos hlb 2)).le
  linarith

/-- The upper bound on `[a, b]`: `1 / log u ≤ 1 / log a - (u - a) / (b log^2 b)`, from
`log u - log a ≥ (u - a) / u ≥ (u - a) / b` and `log a * log u ≤ log^2 b`. -/
theorem upper_pt {a u b : ℝ} (ha : 1 < a) (hau : a ≤ u) (hub : u ≤ b) :
    (Real.log u)⁻¹ ≤ 1 / Real.log a - (u - a) / (b * Real.log b ^ 2) := by
  have ha0 : 0 < a := by linarith
  have hu0 : 0 < u := by linarith
  have hla : 0 < Real.log a := Real.log_pos ha
  have hlu : 0 < Real.log u := Real.log_pos (lt_of_lt_of_le ha hau)
  have hlau : Real.log a ≤ Real.log u := Real.log_le_log ha0 hau
  have hlub : Real.log u ≤ Real.log b := Real.log_le_log hu0 hub
  have hlb : 0 < Real.log b := lt_of_lt_of_le hlu hlub
  have h1 : (u - a) / u ≤ Real.log u - Real.log a := log_sub_log_ge ha0 hu0
  have h0 : (u - a) / b ≤ (u - a) / u := div_le_div_of_nonneg_left (by linarith) hu0 hub
  have h4 : Real.log a * Real.log u ≤ Real.log b ^ 2 := by
    rw [sq]
    exact mul_le_mul (hlau.trans hlub) hlub hlu.le hlb.le
  have h2 : (u - a) / (b * Real.log b ^ 2)
      ≤ (Real.log u - Real.log a) / (Real.log a * Real.log u) := by
    rw [← div_div]
    exact div_le_div₀ (by linarith) (by linarith) (mul_pos hla hlu) h4
  have e : (Real.log u - Real.log a) / (Real.log a * Real.log u)
      = 1 / Real.log a - (Real.log u)⁻¹ := by
    field_simp
  linarith

/-- Antiderivative of the lower linear bound. -/
theorem hasDerivAt_lower (b x : ℝ) :
    HasDerivAt (fun u : ℝ => u / Real.log b - (b - u) ^ 2 / (2 * b * Real.log b ^ 2))
      (1 / Real.log b + (b - x) / (b * Real.log b ^ 2)) x := by
  have h1 : HasDerivAt (fun u : ℝ => u / Real.log b) (1 / Real.log b) x :=
    (hasDerivAt_id' x).div_const _
  have h2 := (((hasDerivAt_id' x).const_sub b).fun_pow 2).div_const (2 * b * Real.log b ^ 2)
  refine (h1.fun_sub h2).congr_deriv ?_
  simp only [Nat.cast_ofNat, Nat.reduceSub, pow_one]
  ring

/-- Antiderivative of the upper linear bound. -/
theorem hasDerivAt_upper (a b x : ℝ) :
    HasDerivAt (fun u : ℝ => u / Real.log a - (u - a) ^ 2 / (2 * b * Real.log b ^ 2))
      (1 / Real.log a - (x - a) / (b * Real.log b ^ 2)) x := by
  have h1 : HasDerivAt (fun u : ℝ => u / Real.log a) (1 / Real.log a) x :=
    (hasDerivAt_id' x).div_const _
  have h2 := (((hasDerivAt_id' x).sub_const a).fun_pow 2).div_const (2 * b * Real.log b ^ 2)
  refine (h1.fun_sub h2).congr_deriv ?_
  simp only [Nat.cast_ofNat, Nat.reduceSub, pow_one]
  ring

/-- `1 / log` is interval integrable on `[a, b]` when `1 < a ≤ b`. -/
theorem inv_log_integrable {a b : ℝ} (ha : 1 < a) (hab : a ≤ b) :
    IntervalIntegrable (fun u : ℝ => (Real.log u)⁻¹) MeasureTheory.volume a b := by
  apply ContinuousOn.intervalIntegrable_of_Icc hab
  refine ContinuousOn.inv₀ (Real.continuousOn_log.mono ?_) ?_
  · intro x hx
    have hx0 : x ≠ 0 := by linarith [hx.1]
    exact hx0
  · intro x hx
    exact (Real.log_pos (by linarith [hx.1])).ne'

end T

theorem liTaylor_holds : LiTaylor := by
  intro a b ha hab
  have ha1 : 1 < a := by linarith
  have hint := T.inv_log_integrable ha1 hab
  constructor
  · have hlin : IntervalIntegrable
        (fun u : ℝ => 1 / Real.log b + (b - u) / (b * Real.log b ^ 2)) MeasureTheory.volume a b :=
      Continuous.intervalIntegrable (by fun_prop) a b
    have hval : ∫ u in a..b, (1 / Real.log b + (b - u) / (b * Real.log b ^ 2))
        = (b - a) / Real.log b + (b - a) ^ 2 / (2 * b * Real.log b ^ 2) := by
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => T.hasDerivAt_lower b x) hlin]
      ring
    rw [← hval]
    exact intervalIntegral.integral_mono_on hab hlin hint
      (fun u hu => T.lower_pt (by linarith [hu.1]) hu.2)
  · have hlin : IntervalIntegrable
        (fun u : ℝ => 1 / Real.log a - (u - a) / (b * Real.log b ^ 2)) MeasureTheory.volume a b :=
      Continuous.intervalIntegrable (by fun_prop) a b
    have hval : ∫ u in a..b, (1 / Real.log a - (u - a) / (b * Real.log b ^ 2))
        = (b - a) / Real.log a - (b - a) ^ 2 / (2 * b * Real.log b ^ 2) := by
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => T.hasDerivAt_upper a b x) hlin]
      ring
    rw [← hval]
    exact intervalIntegral.integral_mono_on hab hint hlin
      (fun u hu => T.upper_pt ha1 hu.1 hu.2)

/-
# Erdős 454 H1, part G: long chords from the prime number theorem

With a = p(n - i), b = p(n), c = p(n + i) and π(a), π(b), π(c) = n - i + 1, n + 1, n + i + 1,
the Taylor bounds for the logarithmic integral on [a, b] and [b, c] and the error term of the
prime number theorem give c + a - 2b ≥ log b · n / (10240 (log n)^5) ≥ B for every chord with
n ≤ i (log₂ n)², once n is large.
-/

namespace G

open Filter Real

/-- The remainder `π(⌊x⌋₊) - li(x)` in the prime number theorem. -/
noncomputable def R (x : ℝ) : ℝ :=
  (Nat.primeCounting ⌊x⌋₊ : ℝ) - ∫ u in (2 : ℝ)..x, (Real.log u)⁻¹

theorem prime_eq : (_root_.Prime : ℕ → Prop) = Nat.Prime :=
  funext fun _ => propext Nat.prime_iff.symm

theorem pc_nth (m : ℕ) : Nat.primeCounting (Nat.nth Nat.Prime m) = m + 1 :=
  Nat.count_nth_succ_of_infinite Nat.infinite_setOfPred_prime m

theorem one_le_log {n : ℕ} (hn : 3 ≤ n) : 1 ≤ Real.log n := by
  have h3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [Real.le_log_iff_exp_le (by linarith)]
  have h := Real.exp_one_lt_d9
  norm_num at h
  linarith

theorem ii {s t : ℝ} (hs : 2 ≤ s) (ht : 2 ≤ t) :
    IntervalIntegrable (fun u => (Real.log u)⁻¹) MeasureTheory.volume s t := by
  apply ContinuousOn.intervalIntegrable
  have h2 : ∀ u ∈ Set.uIcc s t, 2 ≤ u := by
    intro u hu
    rcases Set.mem_uIcc.mp hu with h | h <;> linarith [h.1]
  refine ContinuousOn.inv₀ (Real.continuousOn_log.mono ?_) ?_
  · intro u hu
    have := h2 u hu
    exact (show (0 : ℝ) < u by linarith).ne'
  · intro u hu
    exact (Real.log_pos (by linarith [h2 u hu])).ne'

theorem li_bounds (hT : LiTaylor) {x : ℝ} (hx : 2 ≤ x) :
    (x - 2) / Real.log x ≤ ∫ u in (2 : ℝ)..x, (Real.log u)⁻¹ ∧
    ∫ u in (2 : ℝ)..x, (Real.log u)⁻¹ ≤ 2 * (x - 2) := by
  have hl : 0 < Real.log x := Real.log_pos (by linarith)
  have h := hT 2 x le_rfl hx
  have hq : 0 ≤ (x - 2) ^ 2 / (2 * x * Real.log x ^ 2) :=
    div_nonneg (sq_nonneg _) (mul_nonneg (mul_nonneg zero_le_two (by linarith)) (sq_nonneg _))
  have h2 := Real.log_two_gt_d9
  norm_num at h2
  refine ⟨by linarith [h.1], ?_⟩
  have h3 : (x - 2) / Real.log 2 ≤ 2 * (x - 2) := by
    rw [div_le_iff₀ (by linarith)]
    nlinarith
  linarith [h.2]

theorem R_est (hP : PiLi) (hT : LiTaylor) {ε : ℝ} (hε : 0 < ε) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ x : ℝ, 2 ≤ x → |R x| ≤ ε * x / Real.log x ^ 6 + M := by
  obtain ⟨c, hc, hO⟩ := hP
  obtain ⟨K, hK⟩ := hO.bound
  have hK1 : 0 < max K 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  have h1 := (isLittleO_pow_exp_pos_mul_atTop 60 hc).def (div_pos hε hK1)
  have h2 : Tendsto (fun x : ℝ => Real.log x ^ (1 / 10 : ℝ)) atTop atTop :=
    (tendsto_rpow_atTop (by norm_num)).comp Real.tendsto_log_atTop
  obtain ⟨X0, hX0⟩ := Filter.eventually_atTop.mp (hK.and (h2.eventually h1))
  have hX3 : 3 ≤ max X0 3 := le_max_right _ _
  refine ⟨3 * max X0 3 + 1, by linarith, fun x hx => ?_⟩
  have hlx : 0 < Real.log x := Real.log_pos (by linarith)
  have hx0 : 0 ≤ x := by linarith
  by_cases hxX : max X0 3 ≤ x
  · obtain ⟨hA, hB⟩ := hX0 x (le_trans (le_max_left _ _) hxX)
    have hs0 : 0 ≤ Real.log x ^ (1 / 10 : ℝ) := Real.rpow_nonneg hlx.le _
    have hs60 : (Real.log x ^ (1 / 10 : ℝ)) ^ 60 = Real.log x ^ 6 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hlx.le]; norm_num
    have hB' : Real.log x ^ 6 ≤ ε / max K 1 * Real.exp (c * Real.log x ^ (1 / 10 : ℝ)) := by
      have h0 : ‖(Real.log x ^ (1 / 10 : ℝ)) ^ 60‖ ≤
          ε / max K 1 * ‖Real.exp (c * Real.log x ^ (1 / 10 : ℝ))‖ := hB
      rw [Real.norm_of_nonneg (by positivity), hs60,
        Real.norm_of_nonneg (Real.exp_pos _).le] at h0
      exact h0
    have hA' : |R x| ≤ max K 1 * (x * Real.exp (-c * Real.log x ^ (1 / 10 : ℝ))) := by
      have h0 : ‖R x‖ ≤ K * ‖x * Real.exp (-c * Real.log x ^ (1 / 10 : ℝ))‖ := hA
      rw [Real.norm_eq_abs, Real.norm_of_nonneg (by positivity)] at h0
      exact le_trans h0 (mul_le_mul_of_nonneg_right (le_max_left _ _) (by positivity))
    have key : |R x| * Real.log x ^ 6 ≤ ε * x := by
      calc |R x| * Real.log x ^ 6
          ≤ (max K 1 * (x * Real.exp (-c * Real.log x ^ (1 / 10 : ℝ)))) *
              (ε / max K 1 * Real.exp (c * Real.log x ^ (1 / 10 : ℝ))) :=
            mul_le_mul hA' hB' (by positivity) (by positivity)
        _ = ε * x * (Real.exp (-c * Real.log x ^ (1 / 10 : ℝ)) *
              Real.exp (c * Real.log x ^ (1 / 10 : ℝ))) := by
            field_simp
        _ = ε * x := by rw [← Real.exp_add]; ring_nf; simp
    have h5 : |R x| ≤ ε * x / Real.log x ^ 6 := by
      rw [le_div_iff₀ (by positivity)]; exact key
    linarith
  · have hxX' : x < max X0 3 := not_le.mp hxX
    have hli := li_bounds hT hx
    have hpc : (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ x + 1 := by
      have h1 : Nat.primeCounting ⌊x⌋₊ ≤ ⌊x⌋₊ + 1 := Nat.count_le _
      have h2 : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx0
      have h3 : (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ (⌊x⌋₊ : ℝ) + 1 := by exact_mod_cast h1
      linarith
    have hpc0 : (0 : ℝ) ≤ Nat.primeCounting ⌊x⌋₊ := Nat.cast_nonneg _
    have hli0 : 0 ≤ (x - 2) / Real.log x := div_nonneg (by linarith) hlx.le
    have hR : |R x| ≤ 3 * max X0 3 + 1 := by
      unfold R
      rw [abs_le]
      constructor <;> linarith [hli.1, hli.2]
    have : 0 ≤ ε * x / Real.log x ^ 6 := by positivity
    linarith

theorem ev_log5 : ∀ᶠ n : ℕ in atTop, Real.log n ^ 5 ≤ Real.sqrt n := by
  have h := (isLittleO_log_rpow_rpow_atTop (5 : ℝ) (by norm_num : (0 : ℝ) < 1 / 2)).def one_pos
  filter_upwards [tendsto_natCast_atTop_atTop.eventually (h.and (eventually_ge_atTop 1))]
    with n hn
  obtain ⟨h1, h2⟩ := hn
  have hl : 0 ≤ Real.log n := Real.log_nonneg h2
  rw [Real.norm_of_nonneg (Real.rpow_nonneg hl _),
    Real.norm_of_nonneg (Real.rpow_nonneg (by positivity) _), one_mul, Real.rpow_ofNat] at h1
  rw [Real.sqrt_eq_rpow]
  exact h1

theorem ev_sqrt_ge (S : ℝ) : ∀ᶠ n : ℕ in atTop, S ≤ Real.sqrt n := by
  filter_upwards [eventually_ge_atTop ⌈S ^ 2⌉₊] with n hn
  calc S ≤ |S| := le_abs_self S
    _ = Real.sqrt (S ^ 2) := (Real.sqrt_sq_eq_abs S).symm
    _ ≤ Real.sqrt n := Real.sqrt_le_sqrt (le_trans (Nat.le_ceil _) (by exact_mod_cast hn))

theorem R_unif (hP : PiLi) (hT : LiTaylor) {δ : ℝ} (hδ : 0 < δ) :
    ∀ᶠ n : ℕ in atTop, ∀ x : ℝ, 2 ≤ x → x ≤ 10 * n * Real.log n →
      |R x| ≤ δ * n / Real.log n ^ 5 := by
  obtain ⟨M, hM0, hM⟩ := R_est hP hT (by positivity : (0 : ℝ) < δ / 1280)
  filter_upwards [ev_log5, ev_sqrt_ge (2 * M / δ), eventually_ge_atTop 3] with n h5 hS hn3
  intro x hx2 hxY
  have hn3' : (3 : ℝ) ≤ n := by exact_mod_cast hn3
  have hL1 : 1 ≤ Real.log n := one_le_log hn3
  have hs0 : 0 < Real.sqrt n := Real.sqrt_pos.mpr (by linarith)
  have hss : Real.sqrt n * Real.sqrt n = n := Real.mul_self_sqrt (by linarith)
  have hL5 : 0 < Real.log n ^ 5 := by positivity
  have hlx : 0 < Real.log x := Real.log_pos (by linarith)
  have hx0 : 0 ≤ x := by linarith
  have hmain : δ / 1280 * x / Real.log x ^ 6 ≤ δ * n / (2 * Real.log n ^ 5) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    rcases le_or_gt x (Real.sqrt n) with hxs | hxs
    · have h2 := Real.log_two_gt_d9
      norm_num at h2
      have hlog2 : (69 / 100 : ℝ) ≤ Real.log x :=
        le_trans (by linarith) (Real.log_le_log (by norm_num) hx2)
      have h6 : (1 : ℝ) / 10 ≤ Real.log x ^ 6 :=
        le_trans (by norm_num) (pow_le_pow_left₀ (by norm_num) hlog2 6)
      calc δ / 1280 * x * (2 * Real.log n ^ 5)
          ≤ δ / 1280 * Real.sqrt n * (2 * Real.sqrt n) := by gcongr
        _ = δ * n / 640 := by linear_combination (δ / 640) * hss
        _ ≤ δ * n * (1 / 10) := by
            have : 0 ≤ δ * n := by positivity
            linarith
        _ ≤ δ * n * Real.log x ^ 6 := by gcongr
    · have hlx2 : Real.log n / 2 < Real.log x := by
        have := Real.log_lt_log hs0 hxs
        rwa [Real.log_sqrt (by linarith)] at this
      have h6 : (Real.log n / 2) ^ 6 ≤ Real.log x ^ 6 :=
        pow_le_pow_left₀ (by positivity) hlx2.le 6
      calc δ / 1280 * x * (2 * Real.log n ^ 5)
          ≤ δ / 1280 * (10 * n * Real.log n) * (2 * Real.log n ^ 5) := by gcongr
        _ = δ * n * (Real.log n / 2) ^ 6 := by ring
        _ ≤ δ * n * Real.log x ^ 6 := by gcongr
  have hM' : M ≤ δ * n / (2 * Real.log n ^ 5) := by
    rw [le_div_iff₀ (by positivity)]
    have h2M : 2 * M ≤ Real.sqrt n * δ := by
      have := hS
      rwa [div_le_iff₀ hδ] at this
    calc M * (2 * Real.log n ^ 5) = (2 * M) * Real.log n ^ 5 := by ring
      _ ≤ (Real.sqrt n * δ) * Real.log n ^ 5 := mul_le_mul_of_nonneg_right h2M hL5.le
      _ ≤ (Real.sqrt n * δ) * Real.sqrt n := mul_le_mul_of_nonneg_left h5 (by positivity)
      _ = δ * n := by linear_combination δ * hss
  calc |R x| ≤ δ / 1280 * x / Real.log x ^ 6 + M := hM x hx2
    _ ≤ δ * n / (2 * Real.log n ^ 5) + δ * n / (2 * Real.log n ^ 5) := add_le_add hmain hM'
    _ = δ * n / Real.log n ^ 5 := by ring

theorem p2n_le (hT : LiTaylor) {n : ℕ} (hn : 3 ≤ n)
    (hYlog : Real.log (10 * n * Real.log n) ≤ 2 * Real.log n)
    (hRY : |R (10 * n * Real.log n)| ≤ n) :
    (Nat.nth Nat.Prime (2 * n) : ℝ) ≤ 10 * n * Real.log n := by
  have hn3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  have hL1 : 1 ≤ Real.log n := one_le_log hn
  have hY30 : 30 ≤ 10 * (n : ℝ) * Real.log n := by nlinarith
  have hlY : 0 < Real.log (10 * n * Real.log n) := Real.log_pos (by linarith)
  have hli := (li_bounds hT (by linarith : (2 : ℝ) ≤ 10 * n * Real.log n)).1
  have h1 : (10 * n * Real.log n - 2) / (2 * Real.log n) ≤
      (10 * n * Real.log n - 2) / Real.log (10 * n * Real.log n) :=
    div_le_div_of_nonneg_left (by linarith) hlY hYlog
  have h2 : (10 * n * Real.log n - 2) / (2 * Real.log n) = 5 * n - 1 / Real.log n := by
    field_simp; ring
  have h3 : 1 / Real.log n ≤ 1 := by rw [div_le_one (by linarith)]; exact hL1
  have hpi : (Nat.primeCounting ⌊10 * n * Real.log n⌋₊ : ℝ) =
      (∫ u in (2 : ℝ)..(10 * n * Real.log n), (Real.log u)⁻¹) + R (10 * n * Real.log n) := by
    unfold R; ring
  have hRY' := (abs_le.mp hRY).1
  have h4 : (2 * n : ℝ) < Nat.primeCounting ⌊10 * n * Real.log n⌋₊ := by
    rw [hpi]; linarith
  have h5 : 2 * n < Nat.primeCounting ⌊10 * n * Real.log n⌋₊ := by exact_mod_cast h4
  have h6 : Nat.nth Nat.Prime (2 * n) < ⌊10 * n * Real.log n⌋₊ + 1 :=
    Nat.nth_lt_of_lt_count h5
  have h7 : Nat.nth Nat.Prime (2 * n) ≤ ⌊10 * n * Real.log n⌋₊ := Nat.lt_succ_iff.mp h6
  calc (Nat.nth Nat.Prime (2 * n) : ℝ) ≤ (⌊10 * n * Real.log n⌋₊ : ℝ) := by exact_mod_cast h7
    _ ≤ 10 * n * Real.log n := Nat.floor_le (by linarith)

/-- The real-variable heart of the argument: the two Taylor bounds, the error bounds and the chord
length give c + a - 2b ≥ B. Here N, L, I stand for n, log n, i and lb, lc for log b, log c. -/
theorem chord_real {a b c N L I B Ra Rb Rc lb lc : ℝ}
    (hL1 : 1 ≤ L) (hN : 0 < N) (hI : 0 < I)
    (ha : 0 < a) (hab : a ≤ b) (hbc : b ≤ c)
    (hlb : L ≤ lb) (hlc0 : 0 < lc) (hlc : lc ≤ 2 * L) (hcY : c ≤ 10 * N * L)
    (hTab : (b - a) / lb + (b - a) ^ 2 / (2 * b * lb ^ 2) ≤ I - Rb + Ra)
    (hTbc : I - Rc + Rb ≤ (c - b) / lb - (c - b) ^ 2 / (2 * c * lc ^ 2))
    (hRa : |Ra| ≤ 1 / 40960 * N / L ^ 5) (hRb : |Rb| ≤ 1 / 40960 * N / L ^ 5)
    (hRc : |Rc| ≤ 1 / 40960 * N / L ^ 5)
    (hi4 : N ≤ 4 * L ^ 2 * I) (hB : B * (10240 * L ^ 4) ≤ N) :
    2 * b + B ≤ c + a := by
  have hL0 : 0 < L := by linarith
  have hL0' : L ≠ 0 := hL0.ne'
  have hlb0 : 0 < lb := by linarith
  have hb0 : 0 < b := by linarith
  have hc0 : 0 < c := by linarith
  have hRa' := abs_le.mp hRa
  have hRb' := abs_le.mp hRb
  have hRc' := abs_le.mp hRc
  have hη_le : 1 / 40960 * N / L ^ 5 ≤ I / 4 := by
    rw [div_le_iff₀ (by positivity)]
    have h25 : L ^ 2 ≤ L ^ 5 := pow_le_pow_right₀ hL1 (by norm_num)
    have h1 : L ^ 2 * I ≤ L ^ 5 * I := mul_le_mul_of_nonneg_right h25 hI.le
    have h2 : 0 ≤ L ^ 5 * I := by positivity
    linarith
  have hQ0 : 0 ≤ (c - b) ^ 2 / (2 * c * lc ^ 2) := by positivity
  have hcb : I / 2 * lb ≤ c - b := by
    have : I / 2 ≤ (c - b) / lb := by linarith [hRb'.1, hRc'.2]
    rwa [le_div_iff₀ hlb0] at this
  have hv : (b - a) / lb ≤ I + 2 * (1 / 40960 * N / L ^ 5) := by
    have : 0 ≤ (b - a) ^ 2 / (2 * b * lb ^ 2) := by positivity
    linarith [hRa'.2, hRb'.1]
  have hQ2 : 2 * (1 / 10240 * N / L ^ 5) ≤ (c - b) ^ 2 / (2 * c * lc ^ 2) := by
    have e1 : 2 * c * lc ^ 2 ≤ 80 * N * L ^ 3 := by
      have h1 : lc ^ 2 ≤ (2 * L) ^ 2 := pow_le_pow_left₀ hlc0.le hlc 2
      calc 2 * c * lc ^ 2 ≤ 2 * (10 * N * L) * (2 * L) ^ 2 := by gcongr
        _ = 80 * N * L ^ 3 := by ring
    have e2 : I ^ 2 * L ^ 2 / 4 ≤ (c - b) ^ 2 := by
      have h1 : I / 2 * L ≤ c - b :=
        le_trans (mul_le_mul_of_nonneg_left hlb (by positivity)) hcb
      calc I ^ 2 * L ^ 2 / 4 = (I / 2 * L) ^ 2 := by ring
        _ ≤ (c - b) ^ 2 := pow_le_pow_left₀ (by positivity) h1 2
    have e3 : N ^ 2 ≤ 16 * L ^ 4 * I ^ 2 := by
      calc N ^ 2 ≤ (4 * L ^ 2 * I) ^ 2 := pow_le_pow_left₀ hN.le hi4 2
        _ = 16 * L ^ 4 * I ^ 2 := by ring
    rw [le_div_iff₀ (by positivity)]
    calc 2 * (1 / 10240 * N / L ^ 5) * (2 * c * lc ^ 2)
        ≤ 2 * (1 / 10240 * N / L ^ 5) * (80 * N * L ^ 3) := by gcongr
      _ = N ^ 2 / (64 * L ^ 2) := by field_simp; ring
      _ ≤ 16 * L ^ 4 * I ^ 2 / (64 * L ^ 2) := by gcongr
      _ = I ^ 2 * L ^ 2 / 4 := by field_simp; ring
      _ ≤ (c - b) ^ 2 := e2
  have hfinal : 1 / 10240 * N / L ^ 5 * lb ≤ c + a - 2 * b := by
    have h3 : (c - b) / lb - (b - a) / lb = (c + a - 2 * b) / lb := by ring
    have h4e : 4 * (1 / 40960 * N / L ^ 5) = 1 / 10240 * N / L ^ 5 := by ring
    have h4 : 1 / 10240 * N / L ^ 5 ≤ (c + a - 2 * b) / lb := by
      linarith [hRa'.2, hRb'.1, hRb'.2, hRc'.2]
    rwa [le_div_iff₀ hlb0] at h4
  have hB' : B ≤ 1 / 10240 * N / L ^ 5 * lb := by
    have h1 : B ≤ 1 / 10240 * N / L ^ 4 := by
      rw [le_div_iff₀ (by positivity)]; linarith [hB]
    have h2 : 1 / 10240 * N / L ^ 4 = 1 / 10240 * N / L ^ 5 * L := by
      field_simp
    have h3 : 1 / 10240 * N / L ^ 5 * L ≤ 1 / 10240 * N / L ^ 5 * lb :=
      mul_le_mul_of_nonneg_left hlb (by positivity)
    linarith
  linarith

theorem core (hT : LiTaylor) {n B : ℕ} (hn : 3 ≤ n)
    (hYlog : Real.log (10 * n * Real.log n) ≤ 2 * Real.log n)
    (herr : ∀ x : ℝ, 2 ≤ x → x ≤ 10 * n * Real.log n →
      |R x| ≤ 1 / 40960 * n / Real.log n ^ 5)
    (hB : (B : ℝ) * (10240 * Real.log n ^ 4) ≤ n)
    {i : ℕ} (hi : 0 < i) (hin : i < n) (hlog : n ≤ i * Nat.log 2 n ^ 2) :
    2 * Nat.nth Nat.Prime n + B ≤ Nat.nth Nat.Prime (n + i) + Nat.nth Nat.Prime (n - i) := by
  have hmono := Nat.nth_strictMono Nat.infinite_setOfPred_prime
  have hn3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  have hL1 : 1 ≤ Real.log n := one_le_log hn
  have hi0 : (0 : ℝ) < i := by exact_mod_cast hi
  -- the prime number theorem remainder at a natural number
  have hRnat : ∀ m : ℕ,
      R m = (Nat.primeCounting m : ℝ) - ∫ u in (2 : ℝ)..(m : ℝ), (Real.log u)⁻¹ := by
    intro m; unfold R; rw [Nat.floor_natCast]
  have hπa : (Nat.primeCounting (Nat.nth Nat.Prime (n - i)) : ℝ) = n - i + 1 := by
    rw [pc_nth]; push_cast [Nat.cast_sub hin.le]; ring
  have hπb : (Nat.primeCounting (Nat.nth Nat.Prime n) : ℝ) = n + 1 := by
    rw [pc_nth]; push_cast; ring
  have hπc : (Nat.primeCounting (Nat.nth Nat.Prime (n + i)) : ℝ) = n + i + 1 := by
    rw [pc_nth]; push_cast; ring
  have ha2 : 2 ≤ Nat.nth Nat.Prime (n - i) := (Nat.prime_nth_prime _).two_le
  have hab : Nat.nth Nat.Prime (n - i) ≤ Nat.nth Nat.Prime n := hmono.monotone (Nat.sub_le n i)
  have hbc : Nat.nth Nat.Prime n ≤ Nat.nth Nat.Prime (n + i) :=
    hmono.monotone (Nat.le_add_right n i)
  have hnb : n + 2 ≤ Nat.nth Nat.Prime n := Nat.add_two_le_nth_prime n
  have hc2n : Nat.nth Nat.Prime (n + i) ≤ Nat.nth Nat.Prime (2 * n) := hmono.monotone (by omega)
  have hY2 : (2 : ℝ) ≤ 10 * n * Real.log n := by nlinarith
  have hRY : |R (10 * n * Real.log n)| ≤ n := by
    refine le_trans (herr _ hY2 le_rfl) ?_
    rw [div_le_iff₀ (by positivity)]
    have : (1 : ℝ) ≤ Real.log n ^ 5 := one_le_pow₀ hL1
    nlinarith
  have hp2n := p2n_le hT hn hYlog hRY
  -- the chord length against Nat.log 2 n
  have hk : ((Nat.log 2 n : ℕ) : ℝ) ≤ 2 * Real.log n := by
    have h1 : 2 ^ Nat.log 2 n ≤ n := Nat.pow_log_le_self 2 (by omega)
    have h2 : ((2 : ℝ)) ^ Nat.log 2 n ≤ (n : ℝ) := by exact_mod_cast h1
    have h3 := Real.log_le_log (by positivity) h2
    rw [Real.log_pow] at h3
    have h4 := Real.log_two_gt_d9
    norm_num at h4
    have hk0 : (0 : ℝ) ≤ Nat.log 2 n := Nat.cast_nonneg _
    have h5 : (Nat.log 2 n : ℝ) * (1 / 2) ≤ (Nat.log 2 n : ℝ) * Real.log 2 :=
      mul_le_mul_of_nonneg_left (by linarith) hk0
    linarith
  have hi4 : (n : ℝ) ≤ 4 * Real.log n ^ 2 * i := by
    have h1 : (n : ℝ) ≤ i * (Nat.log 2 n : ℝ) ^ 2 := by exact_mod_cast hlog
    have h2 : (Nat.log 2 n : ℝ) ^ 2 ≤ (2 * Real.log n) ^ 2 :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) hk 2
    have h3 : (i : ℝ) * (Nat.log 2 n : ℝ) ^ 2 ≤ i * (2 * Real.log n) ^ 2 :=
      mul_le_mul_of_nonneg_left h2 hi0.le
    linarith
  set a := Nat.nth Nat.Prime (n - i) with ha
  set b := Nat.nth Nat.Prime n with hb
  set c := Nat.nth Nat.Prime (n + i) with hc
  have ha2' : (2 : ℝ) ≤ a := by exact_mod_cast ha2
  have hab' : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hbc' : (b : ℝ) ≤ c := by exact_mod_cast hbc
  have hnb' : (n : ℝ) + 2 ≤ b := by exact_mod_cast hnb
  have hcY : (c : ℝ) ≤ 10 * n * Real.log n := le_trans (by exact_mod_cast hc2n) hp2n
  have hbY : (b : ℝ) ≤ 10 * n * Real.log n := le_trans hbc' hcY
  have haY : (a : ℝ) ≤ 10 * n * Real.log n := le_trans hab' hbY
  -- splitting the logarithmic integral
  have hs1 := intervalIntegral.integral_add_adjacent_intervals (ii (le_refl (2 : ℝ)) ha2')
    (ii ha2' (by linarith : (2 : ℝ) ≤ b))
  have hs2 := intervalIntegral.integral_add_adjacent_intervals
    (ii (le_refl (2 : ℝ)) (by linarith : (2 : ℝ) ≤ b))
    (ii (by linarith) (by linarith : (2 : ℝ) ≤ c))
  have hIab : ∫ u in (a : ℝ)..(b : ℝ), (Real.log u)⁻¹ = i - R b + R a := by
    rw [hRnat a, hRnat b, hπa, hπb]; linarith
  have hIbc : ∫ u in (b : ℝ)..(c : ℝ), (Real.log u)⁻¹ = i - R c + R b := by
    rw [hRnat b, hRnat c, hπb, hπc]; linarith
  have hTab := (hT a b ha2' hab').1
  have hTbc := (hT b c (by linarith) hbc').2
  rw [hIab] at hTab
  rw [hIbc] at hTbc
  have hlb : Real.log n ≤ Real.log b := Real.log_le_log (by linarith) (by linarith)
  have hc0 : (0 : ℝ) < c := by linarith
  have hlc0 : 0 < Real.log c := Real.log_pos (by linarith)
  have hlc : Real.log c ≤ 2 * Real.log n := le_trans (Real.log_le_log hc0 hcY) hYlog
  have hfin : (2 * b + B : ℝ) ≤ c + a :=
    chord_real hL1 (by linarith) hi0 (by linarith) hab' hbc' hlb hlc0 hlc hcY
      hTab hTbc (herr a ha2' haY) (herr b (by linarith) hbY) (herr c (by linarith) hcY) hi4 hB
  exact_mod_cast hfin

end G

theorem h1_of_parts (hP : PiLi) (hT : LiTaylor) : OMA.R_Erdos454_erdos_454_R1.H1 := by
  intro B
  rw [G.prime_eq]
  filter_upwards [G.R_unif hP hT (by norm_num : (0 : ℝ) < 1 / 40960), G.ev_log5,
    G.ev_sqrt_ge (10240 * B + 10), Filter.eventually_ge_atTop 3] with n hR h5 hS hn3
  intro i hi hin hlog
  have hn3' : (3 : ℝ) ≤ n := by exact_mod_cast hn3
  have hL1 := G.one_le_log hn3
  have hss : Real.sqrt n * Real.sqrt n = n := Real.mul_self_sqrt (by positivity)
  have hB0 : (0 : ℝ) ≤ B := Nat.cast_nonneg _
  have hs10 : 10 ≤ Real.sqrt n := by linarith
  have hL5 : Real.log n ≤ Real.log n ^ 5 := le_self_pow₀ hL1 (by norm_num)
  have hL45 : Real.log n ^ 4 ≤ Real.log n ^ 5 := pow_le_pow_right₀ hL1 (by norm_num)
  have hYlog : Real.log (10 * n * Real.log n) ≤ 2 * Real.log n := by
    have h10 : 10 * Real.log n ≤ n := by
      calc 10 * Real.log n ≤ 10 * Real.sqrt n := by linarith
        _ ≤ Real.sqrt n * Real.sqrt n :=
          mul_le_mul_of_nonneg_right hs10 (Real.sqrt_nonneg _)
        _ = n := hss
    have h2 : 10 * (n : ℝ) * Real.log n ≤ (n : ℝ) ^ 2 := by nlinarith
    calc Real.log (10 * n * Real.log n) ≤ Real.log ((n : ℝ) ^ 2) :=
          Real.log_le_log (mul_pos (mul_pos (by norm_num) (by linarith)) (by linarith)) h2
      _ = 2 * Real.log n := by rw [Real.log_pow]; norm_num
  have hB : (B : ℝ) * (10240 * Real.log n ^ 4) ≤ n := by
    calc (B : ℝ) * (10240 * Real.log n ^ 4) = (10240 * B) * Real.log n ^ 4 := by ring
      _ ≤ Real.sqrt n * Real.log n ^ 4 :=
          mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ ≤ Real.sqrt n * Real.sqrt n :=
          mul_le_mul_of_nonneg_left (le_trans hL45 h5) (Real.sqrt_nonneg _)
      _ = n := hss
  exact G.core hT hn3 hYlog hR hB hi hin hlog

end Chords454

theorem OMA.solution : OMA.R_Erdos454_erdos_454_R1.H1 :=
  Chords454.h1_of_parts PNTBridge.piLi_bound Chords454.liTaylor_holds
