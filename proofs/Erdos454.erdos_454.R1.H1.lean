  have hL : 1 < Real.log T ^ n₁ := Real.one_lt_rpow (logt_gt_one hT.le) n₁_pos
  have ha : A / Real.log T ^ n₁ < 1 / 2 := (div_lt_iff₀ (by linarith)).2 (by nlinarith [hA.2])
