  obtain ⟨Cint, Cintpos, Cinthyp⟩ := log_pow_over_xsq_integral_bounded n₂ n₂_pos
  refine ⟨Cint * CM * Cζ, by positivity, fun X hX ε hε hε1 T hT ↦ ?_⟩
