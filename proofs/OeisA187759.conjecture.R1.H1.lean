def inM (y : ℕ) : Bool := Nat.beq (((Mb.getD (y / 1000) 0) >>> (y % 1000)) % 2) 1

def centreOK (y : ℕ) : Bool := !(inM y) || isCentre y

/-- Checks `centreOK` on `[lo, lo + 2 ^ k)` by halving, so the recursion depth is only `k`. -/
def allM (lo : ℕ) : ℕ → Bool
  | 0 => centreOK lo
  | k + 1 => allM lo k && allM (lo + 2 ^ k) k

theorem allM_spec : ∀ k lo, allM lo k = true → ∀ y, lo ≤ y → y < lo + 2 ^ k → centreOK y = true := by
  intro k
  induction k with
  | zero => intro lo h y h1 h2; simp only [pow_zero] at h2; have : y = lo := by omega
            subst this; exact h
  | succ k ih =>
    intro lo h y h1 h2
    simp only [allM, Bool.and_eq_true] at h
    rw [pow_succ] at h2
    rcases Nat.lt_or_ge y (lo + 2 ^ k) with hl | hl
    · exact ih lo h.1 y h1 hl
    · exact ih (lo + 2 ^ k) h.2 y hl (by omega)

