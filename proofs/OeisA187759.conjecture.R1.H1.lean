theorem OMA.solution : OMA.R_OeisA187759_conjecture_R1.H1 := by
  intro n hn hle hnot
  have hg := A187759Aux.goodN_ok n hn hle
  have hfind : A187759Aux.findX n A187759Aux.C = true := by
    simp only [A187759Aux.goodN, Bool.or_eq_true, Nat.beq_eq] at hg
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hnot
    rcases hg with (((h | h) | h) | h) | h
    · exact absurd h hnot.1
    · exact absurd h hnot.2.1
    · exact absurd h hnot.2.2.1
    · exact absurd h hnot.2.2.2
    · exact h
  obtain ⟨x, hxC, hx1, hx2, hin⟩ := A187759Aux.findX_spec n _ hfind
  have hc : A187759Aux.isCentre x = true := List.all_eq_true.mp A187759Aux.C_ok x hxC
  have hcy : A187759Aux.isCentre (n - x) = true :=
    A187759Aux.inM_centre (n - x) (by omega) hin
  simp only [A187759Aux.isCentre, Bool.and_eq_true] at hc hcy
  have hp1 := A187759Aux.isPrimeB_spec _ hc.1
  have hp2 := A187759Aux.isPrimeB_spec _ hc.2
  have hy1 := A187759Aux.isPrimeB_spec _ hcy.1
  have hy2 := A187759Aux.isPrimeB_spec _ hcy.2
  unfold OeisA187759.a
  have hmem : x ∈ Finset.Icc 1 ((n - 1) / 2) := Finset.mem_Icc.mpr ⟨hx1, hx2⟩
  refine lt_of_lt_of_le ?_ (Finset.single_le_sum (fun i _ => Nat.zero_le _) hmem)
  simp only
  rw [if_pos ⟨hp1, hp2, hy1, hy2⟩]
  exact Nat.one_pos
