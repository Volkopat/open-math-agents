theorem inM_centre (y : ℕ) (hy : y < 20480) (h : inM y = true) : isCentre y = true := by
  have : centreOK y = true := by
    apply allM_spec 11 (2048 * (y / 2048)) (M_all _ (by omega)) y
    · have := Nat.div_mul_le_self y 2048
      omega
    · have := Nat.lt_div_mul_add (a := y) (b := 2048) (by norm_num)
      norm_num
      omega
  simp only [centreOK, Bool.or_eq_true, Bool.not_eq_true'] at this
  rcases this with h1 | h1
  · rw [h] at h1; exact absurd h1 (by decide)
  · exact h1

def findX (n : ℕ) : List ℕ → Bool
  | [] => false
  | x :: xs => (Nat.ble 1 x && Nat.ble x ((n - 1) / 2) && inM (n - x)) || findX n xs

theorem findX_spec (n : ℕ) : ∀ L, findX n L = true → ∃ x ∈ L, 1 ≤ x ∧ x ≤ (n - 1) / 2 ∧
    inM (n - x) = true := by
  intro L
  induction L with
  | nil => intro h; simp [findX] at h
  | cons x xs ih =>
    intro h
    simp only [findX, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq] at h
    rcases h with ⟨⟨h1, h2⟩, h3⟩ | h
    · exact ⟨x, List.mem_cons_self .., h1, h2, h3⟩
    · obtain ⟨y, hy, rest⟩ := ih h
      exact ⟨y, List.mem_cons_of_mem _ hy, rest⟩

def goodN (n : ℕ) : Bool :=
  Nat.beq n 211 || Nat.beq n 226 || Nat.beq n 541 || Nat.beq n 701 || findX n C

def allRange (lo : ℕ) : ℕ → Bool
  | 0 => goodN lo
  | k + 1 => allRange lo k && allRange (lo + 2 ^ k) k

theorem allRange_spec : ∀ k lo, allRange lo k = true → ∀ n, lo ≤ n → n < lo + 2 ^ k →
    goodN n = true := by
  intro k
  induction k with
  | zero => intro lo h n h1 h2; simp only [pow_zero] at h2; have : n = lo := by omega
            subst this; exact h
  | succ k ih =>
    intro lo h n h1 h2
    simp only [allRange, Bool.and_eq_true] at h
    rw [pow_succ] at h2
    rcases Nat.lt_or_ge n (lo + 2 ^ k) with hl | hl
    · exact ih lo h.1 n h1 hl
    · exact ih (lo + 2 ^ k) h.2 n hl (by omega)

