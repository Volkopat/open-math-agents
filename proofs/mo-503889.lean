import OMAStatements.S_mo_503889

/-!
# Full ramification of a degree-27 polynomial over a 3-adic field

The question gives the change of variables y = (x⁹−t²)/3. Adding t x³
to y reveals an element of valuation 119/351 over the 3-adic rationals.
Its powers have distinct valuations modulo the integers through degree 350.
The tower law then gives degree 27 over the field generated by t.
Tim Dokchitser reported a Magma computation of irreducibility in the comments.
Source: Learner, https://mathoverflow.net/questions/503889 (CC BY-SA 4.0).
Credit: @connoranderson
-/

namespace Ramified
open IsUltrametricDist

private lemma large_sum {L : Type*} [NormedField L] [IsUltrametricDist L] {a b : L}
    (h : ‖b‖ < ‖a‖) : ‖a+b‖ = ‖a‖ := by
  rw [norm_add_eq_max_of_norm_ne_norm h.ne', max_eq_left h.le]

private lemma large_sub {L : Type*} [NormedField L] [IsUltrametricDist L] {a b : L}
    (h : ‖b‖ < ‖a‖) : ‖a-b‖ = ‖a‖ := by
  rw [sub_eq_add_neg, large_sum (by simpa using h : ‖-b‖ < ‖a‖)]

private lemma small_sub {L : Type*} [NormedField L] [IsUltrametricDist L] {a b : L}
    (h : ‖a‖ < ‖b‖) : ‖a-b‖ = ‖b‖ := by
  rw [← norm_neg, neg_sub, large_sub h]

private lemma element_norm {L : Type*} [NormedField L] [IsUltrametricDist L]
    {u : ℝ} (hu : 0 < u) (hu1 : u < 1) (hthree : ‖(3:L)‖ = u^351)
    {t x y : L} (ht : t^13=3) (hx : x^9=t^2+3*y) (hy : y^3=3*x-t^5) :
    ‖y+t*x^3‖ = u^119 := by
  have pw {i j : ℕ} (h : i < j) : u^j < u^i :=
    pow_lt_pow_right_of_lt_one₀ hu hu1 h
  have htn : ‖t‖ = u^27 := by
    apply (pow_left_inj₀ (norm_nonneg _) (by positivity) (by decide : (13:ℕ) ≠ 0)).mp
    rw [← norm_pow, ht, hthree, ← pow_mul]
  have h3lt : ‖(3:L)‖ < 1 := hthree ▸ pow_lt_one₀ hu.le hu1 (by decide)
  have tlt : ‖t‖ < 1 := htn ▸ pow_lt_one₀ hu.le hu1 (by decide)
  have hdiff : x^9-t^2 = 3*y := by rw [hx]; ring
  have xle : ‖x‖ ≤ 1 := by
    by_contra! h
    have hxl : 1 ≤ ‖x‖^9 := one_le_pow₀ h.le
    have hs : ‖t^2‖ < ‖x^9‖ := by
      rw [norm_pow, norm_pow]
      exact (pow_lt_one₀ (norm_nonneg _) tlt (by decide)).trans_le hxl
    have e := large_sub hs
    rw [hdiff, norm_mul, norm_pow] at e
    have hyn : ‖y‖^3 ≤ ‖x‖ := by
      rw [← norm_pow, hy, sub_eq_add_neg]
      apply (norm_add_le_max _ _).trans
      rw [norm_mul, norm_neg, norm_pow]
      exact max_le (mul_le_of_le_one_left (norm_nonneg _) h3lt.le)
        ((pow_le_one₀ (norm_nonneg _) tlt.le).trans h.le)
    have x9 : ‖x‖ ≤ ‖x‖^9 := by
      simpa using (pow_le_pow_right₀ h.le (by decide : 1 ≤ 9))
    have ylt : ‖x‖^9 < ‖y‖ := by
      rw [← e]
      exact mul_lt_of_lt_one_left (by
        by_contra! hn
        have zz := le_antisymm hn (norm_nonneg y)
        rw [zz, mul_zero] at e
        linarith) h3lt
    have y1 : 1 ≤ ‖y‖ := hxl.trans ylt.le
    have yc : ‖y‖ ≤ ‖y‖^3 := by
      simpa using (pow_le_pow_right₀ y1 (by decide : 1 ≤ 3))
    exact (lt_irrefl _ (x9.trans_lt ylt |>.trans_le (yc.trans hyn)))
  have hyN : ‖y‖ = u^45 := by
    have hlt : ‖(3:L)*x‖ < ‖t^5‖ := by
      rw [norm_mul, hthree, norm_pow, htn, ← pow_mul]
      exact (mul_le_of_le_one_right (by positivity) xle).trans_lt (pw (by decide))
    apply (pow_left_inj₀ (norm_nonneg _) (by positivity) (by decide : (3:ℕ) ≠ 0)).mp
    rw [← norm_pow, hy, small_sub hlt, norm_pow, htn, ← pow_mul, ← pow_mul]
  have hxN : ‖x‖ = u^6 := by
    have hlt : ‖(3:L)*y‖ < ‖t^2‖ := by
      rw [norm_mul, hthree, hyN, ← pow_add, norm_pow, htn, ← pow_mul]
      exact pw (by decide)
    apply (pow_left_inj₀ (norm_nonneg _) (by positivity) (by decide : (9:ℕ) ≠ 0)).mp
    rw [← norm_pow, hx, large_sum hlt, norm_pow, htn, ← pow_mul, ← pow_mul]
  let z := y+t*x^3
  have hzle : ‖z‖ ≤ u^45 := by
    apply (norm_add_le_max _ _).trans
    rw [hyN, norm_mul, norm_pow, htn, hxN, ← pow_mul, ← pow_add]
    exact max_le le_rfl le_rfl
  have cube : z^3 = 3*(x+(t^3*y+t*x^3*y*z)) := by
    dsimp [z]
    linear_combination hy + t^3*hx
  have s : ‖t^3*y+t*x^3*y*z‖ < ‖x‖ := by
    apply (norm_add_le_max _ _).trans_lt
    rw [hxN]
    apply max_lt
    · rw [norm_mul, norm_pow, htn, hyN, ← pow_mul, ← pow_add]
      exact pw (by decide)
    · simp only [norm_mul, norm_pow, htn, hxN, hyN]
      calc
        _ ≤ u^27*(u^6)^3*u^45*u^45 := by gcongr
        _ < u^6 := by rw [← pow_mul, ← pow_add, ← pow_add, ← pow_add]; exact pw (by decide)
  change ‖z‖ = u^119
  apply (pow_left_inj₀ (norm_nonneg _) (by positivity) (by decide : (3:ℕ) ≠ 0)).mp
  rw [← norm_pow, cube, norm_mul, large_sum s, hthree, hxN, ← pow_add, ← pow_mul]

end Ramified

namespace Ramified
open IsUltrametricDist

private lemma largest_nonzero {L ι : Type*} [NormedField L] [IsUltrametricDist L] [Fintype ι]
    {f : ι → L} (hsum : ∑ i, f i = 0)
    (hdist : ∀ i j, f i ≠ 0 → f j ≠ 0 → ‖f i‖ = ‖f j‖ → i = j) (i : ι) : f i = 0 := by
  classical
  by_contra hn
  obtain ⟨j, _, hj⟩ := Finset.univ.exists_max_image (fun l => ‖f l‖) ⟨i, Finset.mem_univ _⟩
  have hjp : 0 < ‖f j‖ := (norm_pos_iff.mpr hn).trans_le (hj i (Finset.mem_univ _))
  let s := Finset.univ.erase j
  have sumval : (∑ l ∈ s, f l) = -f j := by
    have he := Finset.sum_erase_add (s := Finset.univ) f (Finset.mem_univ j)
    change (∑ l ∈ Finset.univ.erase j, f l) = -f j
    rw [hsum] at he
    exact eq_neg_of_add_eq_zero_left he
  have low : ‖∑ l ∈ s, f l‖ < ‖f j‖ := by
    rcases s.eq_empty_or_nonempty with h | h
    · simpa [h] using hjp
    · obtain ⟨a, ha, he⟩ := exists_norm_finsetSum_le_of_nonempty h f
      refine he.trans_lt ((hj a (Finset.mem_univ _)).lt_of_ne ?_)
      intro heq
      have ha' : f a ≠ 0 := norm_pos_iff.mp (heq ▸ hjp)
      exact (Finset.mem_erase.mp ha).1 (hdist a j ha' (norm_pos_iff.mp hjp) heq)
  rw [sumval, norm_neg] at low
  exact low.false

private lemma independent_powers {z : PadicAlgCl 3} (hz : ‖z‖^351 = (3:ℝ)^(-119:ℤ)) :
    LinearIndependent ℚ_[3] (fun i : Fin 351 => z^i.val) := by
  have zn : z ≠ 0 := by
    intro h
    have nz : (3:ℝ)^(-119:ℤ) ≠ 0 := by positivity
    exact nz (by simpa only [h, norm_zero, zero_pow (by decide : (351:ℕ) ≠ 0)] using hz.symm)
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  let f := fun i : Fin 351 => g i • z^i.val
  have val (j : Fin 351) (h : g j ≠ 0) :
      ‖f j‖^351 = (3:ℝ)^(-351*(g j).valuation-119*(j.val:ℤ)) := by
    simp only [f, norm_smul, norm_pow, mul_pow, Padic.norm_eq_zpow_neg_valuation h]
    norm_num only [Nat.cast_ofNat]
    rw [← pow_mul, Nat.mul_comm j.val 351, pow_mul, hz]
    rw [← zpow_natCast ((3:ℝ)^(-(g j).valuation)) 351, ← zpow_mul,
      ← zpow_natCast ((3:ℝ)^(-119:ℤ)) j.val, ← zpow_mul, ← zpow_add₀ (by norm_num)]
    congr 1
    ring
  have hi := largest_nonzero (f := f) hg (fun a b ha hb hab => by
    have an : g a ≠ 0 := by rintro h; exact ha (by simp [f, h])
    have bn : g b ≠ 0 := by rintro h; exact hb (by simp [f, h])
    have h := congrArg (fun x : ℝ => x^351) hab
    change ‖f a‖^351 = ‖f b‖^351 at h
    rw [val a an, val b bn, zpow_right_inj₀ (by norm_num : (0:ℝ) < 3) (by norm_num)] at h
    apply Fin.ext
    have rel : (a.val:ℤ)-b.val = 351*(59*((g b).valuation-(g a).valuation)-
        20*((a.val:ℤ)-b.val)) := by linarith
    have : (351:ℤ) ∣ (a.val:ℤ)-b.val := ⟨_, rel⟩
    omega) i
  exact (smul_eq_zero.mp hi).resolve_right (pow_ne_zero _ zn)

end Ramified

namespace Ramified
open Polynomial IntermediateField OMA.S_mo_503889

private lemma norm_parameter {t x : PadicAlgCl 3} (ht : t^13 = 3)
    (hx : (x^9-t^2)^3 - 3^4*x + 3^3*t^5 = 0) :
    ‖(x^9-t^2)/3+t*x^3‖^351 = (3:ℝ)^(-119:ℤ) := by
  let u : ℝ := (3:ℝ)^(-(1/351:ℝ))
  have up : 0 < u := Real.rpow_pos_of_pos (by norm_num) _
  have ul : u < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by norm_num)
  have uh : u^351 = (3:ℝ)⁻¹ := by
    dsimp [u]
    rw [← Real.rpow_mul_natCast (by norm_num : (0:ℝ) ≤ 3)]
    norm_num
  have h3 : ‖(3 : PadicAlgCl 3)‖ = u^351 := by
    rw [uh]
    calc
      ‖(3 : PadicAlgCl 3)‖ = ‖(3 : ℚ_[3])‖ := by
        simpa only [map_ofNat] using (norm_algebraMap' (PadicAlgCl 3) (3:ℚ_[3]))
      _ = _ := by simpa only [Nat.cast_ofNat] using (Padic.norm_p (p := 3))
  have h := element_norm up ul h3 ht (x := x) (y := (x^9-t^2)/3) (by ring) (by linear_combination hx / 27)
  rw [h, ← pow_mul, Nat.mul_comm 119 351, pow_mul, uh]
  norm_num

private lemma eqn_monic_degree (t : PadicAlgCl 3) :
    (equation t).Monic ∧ (equation t).natDegree = 27 := by
  unfold equation
  constructor
  · monicity!
  · compute_degree!

private lemma root_degree (t x : PadicAlgCl 3) (ht : t^13=3)
    (hx : (x^9-t^2)^3 - 3^4*x + 3^3*t^5 = 0) :
    27 ≤ (minpoly (Base t) x).natDegree := by
  let K := Base t
  let L := K⟮x⟯
  have ti : IsIntegral ℚ_[3] t := Algebra.IsIntegral.isIntegral t
  have xi : IsIntegral K x := (Algebra.IsIntegral.isIntegral (R := ℚ_[3]) x).tower_top
  let : FiniteDimensional ℚ_[3] K := adjoin.finiteDimensional ti
  let : FiniteDimensional K L := adjoin.finiteDimensional xi
  let : FiniteDimensional ℚ_[3] L := Module.Finite.trans K L
  have td : Module.finrank ℚ_[3] K ≤ 13 := by
    rw [show Module.finrank ℚ_[3] K = (minpoly ℚ_[3] t).natDegree from adjoin.finrank ti]
    have leq := minpoly.min ℚ_[3] t (monic_X_pow_sub_C (3 : ℚ_[3]) (by decide : 13 ≠ 0))
      (by simp [ht, map_ofNat])
    simpa using natDegree_le_natDegree leq
  let X' : L := ⟨x, mem_adjoin_simple_self K x⟩
  let T' : L := algebraMap K L (generator t)
  let Z : L := (X'^9-T'^2)/3 + T'*X'^3
  have zco : (Z : PadicAlgCl 3) = (x^9-t^2)/3+t*x^3 := by rfl
  have li : LinearIndependent ℚ_[3] (fun i : Fin 351 => Z^i.val) := by
    apply LinearIndependent.of_comp (L.val.toLinearMap.restrictScalars ℚ_[3])
    exact independent_powers (norm_parameter ht hx)
  have low : 351 ≤ Module.finrank ℚ_[3] L := by simpa using li.fintype_card_le_finrank
  rw [← Module.finrank_mul_finrank ℚ_[3] K L] at low
  have xdim : Module.finrank K L = (minpoly K x).natDegree := adjoin.finrank xi
  change 27 ≤ (minpoly K x).natDegree
  rw [← xdim]
  nlinarith [Nat.mul_le_mul_right (Module.finrank K L) td]

theorem irreducible_equation (t : PadicAlgCl 3) (ht : t^13 = 3) : Irreducible (equation t) := by
  obtain ⟨mon, deg⟩ := eqn_monic_degree t
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_aeval_eq_zero (PadicAlgCl 3) (equation t) (by
    rw [degree_eq_natDegree mon.ne_zero, deg]; decide)
  have eqx : (x^9-t^2)^3-3^4*x+3^3*t^5=0 := by
    simpa [equation, generator, map_ofNat] using hx
  have xi : IsIntegral (Base t) x := ⟨equation t, mon, hx⟩
  have e := eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic xi) mon
    (minpoly.dvd (Base t) x hx) (by rw [deg]; exact root_degree t x ht eqx)
  rw [e]
  exact minpoly.irreducible xi

end Ramified

theorem OMA.solution : type_of% @OMA.S_mo_503889.main := Ramified.irreducible_equation
