namespace D5Arctan

def good (n : ℕ) (z : ℤ × ℤ) : Bool :=
  let e := 4*n
  let p := z.1.natAbs
  let b := z.2.natAbs
  let q := b / p
  let r := b % p
  decide (e < p ∧ e*(q+1) < r ∧ r+e*(q+2) < p)

lemma integer_window {p b e q r : ℤ} (he : 0 ≤ e) (hp : e < p)
    (hb : b = q*p+r) (hr : e*(q+1) < r) (hs : r+e*(q+2) < p)
    (t : ℤ) : ¬ |b-t*p| ≤ e*(1+t) := by
  intro h
  by_cases ht : t ≤ q
  · have hprod := mul_nonneg (show 0 ≤ q-t by omega) (show 0 ≤ p+e by omega)
    have hbound := (le_abs_self (b-t*p)).trans h
    nlinarith
  · have hprod := mul_nonneg (show 0 ≤ t-q-1 by omega) (show 0 ≤ p-e by omega)
    have hbound := (neg_le_abs (b-t*p)).trans h
    nlinarith

lemma good_excludes {n : ℕ} {z : ℤ × ℤ} (h : good n z = true) (m : ℤ) :
    ¬ |z.2-m*z.1| ≤ 4*(n:ℤ)*(1+|m|) := by
  have hc : 4*n < z.1.natAbs ∧
      4*n*(z.2.natAbs/z.1.natAbs+1) < z.2.natAbs%z.1.natAbs ∧
      z.2.natAbs%z.1.natAbs+4*n*(z.2.natAbs/z.1.natAbs+2) < z.1.natAbs :=
    of_decide_eq_true h
  obtain ⟨hp, hr, hs⟩ := hc
  have hpi : 4*(n:ℤ) < |z.1| := by
    rw [← Int.natCast_natAbs z.1]
    exact_mod_cast hp
  have hri : 4*(n:ℤ)*((z.2.natAbs/z.1.natAbs:ℕ)+1) <
      (z.2.natAbs%z.1.natAbs:ℕ) := by exact_mod_cast hr
  have hsi : ((z.2.natAbs%z.1.natAbs:ℕ):ℤ)+
      4*(n:ℤ)*((z.2.natAbs/z.1.natAbs:ℕ)+2) < |z.1| := by
    rw [← Int.natCast_natAbs z.1]
    exact_mod_cast hs
  have hb : |z.2| = ((z.2.natAbs/z.1.natAbs:ℕ):ℤ)*|z.1|+
      (z.2.natAbs%z.1.natAbs:ℕ) := by
    rw [← Int.natCast_natAbs z.2, ← Int.natCast_natAbs z.1]
    have hd : z.2.natAbs = (z.2.natAbs/z.1.natAbs)*z.1.natAbs+z.2.natAbs%z.1.natAbs := by
      simpa only [Nat.mul_comm] using (Nat.div_add_mod z.2.natAbs z.1.natAbs).symm
    exact_mod_cast hd
  intro hw
  have hrev : abs (|z.2| - |m| * |z.1|) ≤ |z.2-m*z.1| := by
    simpa only [abs_mul] using abs_abs_sub_abs_le_abs_sub z.2 (m*z.1)
  exact integer_window (by omega) hpi hb hri hsi |m| (hrev.trans hw)


def step (k : ℕ) (z : ℤ × ℤ) : ℤ × ℤ :=
  (z.1 / (k:ℤ) - z.2, z.1 + z.2 / (k:ℤ))

def scan : ℕ → ℕ → (ℤ × ℤ) → (ℤ × ℤ) → Bool
  | _, 0, z, last => decide (z = last)
  | a, c+1, z, last =>
    let next := step (a+1) z
    good (a+1) next && scan (a+1) c next last

lemma scan_sound (w : ℕ → ℤ × ℤ) (ws : ∀ j, w (j+1) = step (j+1) (w j))
    {a c : ℕ} {z last : ℤ × ℤ} (ha : w a = z) (hc : scan a c z last = true) :
    w (a+c) = last ∧ ∀ n, a < n → n ≤ a+c → good n (w n) = true := by
  induction c generalizing a z with
  | zero =>
    have hz : z = last := of_decide_eq_true hc
    constructor
    · simpa using ha.trans hz
    · intro n hn hle
      omega
  | succ c ih =>
    have hh : good (a+1) (step (a+1) z) = true ∧
        scan (a+1) c (step (a+1) z) last = true := Bool.and_eq_true_iff.mp hc
    have hnext : w (a+1) = step (a+1) z := by rw [ws, ha]
    obtain ⟨hfinal,hall⟩ := ih hnext hh.2
    constructor
    · convert hfinal using 1; congr 1; omega
    · intro n hn hle
      by_cases h : n = a+1
      · rw [h, hnext]
        exact hh.1
      · exact hall n (by omega) (by omega)

def w : ℕ → ℤ × ℤ := Nat.rec ((2:ℤ)^60,0) (fun j z => step (j+1) z)

lemma fixed_sound {a c : ℕ} {z last : ℤ × ℤ} (ha : w a = z)
    (hc : scan a c z last = true) :
    w (a+c) = last ∧ ∀ n, a < n → n ≤ a+c → good n (w n) = true :=
  scan_sound w (fun _ => rfl) ha hc

lemma join {P : ℕ → Prop} {a b c : ℕ}
    (hab : ∀ n, a < n → n ≤ b → P n) (hbc : ∀ n, b < n → n ≤ c → P n) :
    ∀ n, a < n → n ≤ c → P n := by
  intro n hn hle
  by_cases h : n ≤ b
  · exact hab n hn h
  · exact hbc n (by omega) hle


def R (a b : ℕ) (last : ℤ × ℤ) : Prop :=
  w b = last ∧ ∀ n, a < n → n ≤ b → good n (w n) = true


