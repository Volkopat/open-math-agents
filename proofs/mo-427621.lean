import OMAStatements.S_mo_427621

/-!
For the numerical semigroup generated by 5, 6, and 13, take n = 2.
The left set contains 19, while every element of the right set is at most 18.
-/
namespace OMA.MO427621

open OMA.S_mo_427621

private def carrier (x : ℕ) : Prop :=
  x = 0 ∨ x = 5 ∨ x = 6 ∨ x = 10 ∨ x = 11 ∨ x = 12 ∨ x = 13 ∨ 15 ≤ x

private def semigroup : AddSubmonoid ℕ where
  carrier := {x | carrier x}
  zero_mem' := Or.inl rfl
  add_mem' := by
    intro x y hx hy
    change carrier x at hx
    change carrier y at hy
    change carrier (x + y)
    unfold carrier at *
    omega

private def T : Set ℕ := sStar semigroup

private theorem cofinite : ((semigroup : Set ℕ)ᶜ).Finite := by
  apply (Set.finite_Iio 15).subset
  intro x hx
  change ¬ carrier x at hx
  change x < 15
  by_contra! h
  exact hx (by unfold carrier; omega)

private theorem five : 5 ∈ T := ⟨by change carrier 5; simp [carrier], by decide⟩
private theorem six : 6 ∈ T := ⟨by change carrier 6; simp [carrier], by decide⟩
private theorem thirteen : 13 ∈ T := ⟨by change carrier 13; simp [carrier], by decide⟩

private theorem zero : 0 ∈ nsum T 0 := rfl

private theorem cons {k x y : ℕ} (hx : x ∈ nsum T k) (hy : y ∈ T) :
    x + y ∈ nsum T (k + 1) := ⟨x, hx, y, hy, rfl⟩

private theorem minimal {k x : ℕ} (hx : x ∈ nsum T k) : 5 * k ≤ x := by
  induction k generalizing x with
  | zero => simp
  | succ k ih =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    have hmin := ih ha
    change carrier b ∧ b ≠ 0 at hb
    unfold carrier at hb
    omega

private theorem absorb {k x y : ℕ} (hx : x ∈ nsum T (k + 1)) (hy : y ∈ semigroup) :
    x + y ∈ nsum T (k + 1) := by
  obtain ⟨u, hu, v, hv, rfl⟩ := hx
  refine ⟨u, hu, v + y, ⟨semigroup.add_mem hv.1 hy, ?_⟩, by omega⟩
  exact fun h => hv.2 (by omega)

private theorem four_base (r : Fin 5) : 20 + r.val ∈ nsum T 4 := by
  fin_cases r
  · have h := cons (cons (cons (cons zero five) five) five) five
    exact h
  · have h := cons (cons (cons (cons zero five) five) five) six
    exact h
  · have h := cons (cons (cons (cons zero five) five) six) six
    exact h
  · have h := cons (cons (cons (cons zero five) six) six) six
    exact h
  · have h := cons (cons (cons (cons zero six) six) six) six
    exact h

private theorem four_tail {x : ℕ} (hx : 20 ≤ x) : x ∈ nsum T 4 := by
  let r : Fin 5 := ⟨(x - 20) % 5, Nat.mod_lt _ (by decide)⟩
  let q := (x - 20) / 5
  have hq : 5 * q ∈ semigroup := by
    have h := semigroup.nsmul_mem five.1 q
    simpa [nsmul_eq_mul, mul_comm] using h
  have hsum : 20 + r.val + 5 * q = x := by dsimp [r, q]; omega
  exact hsum ▸ absorb (four_base r) hq

private theorem nineteen_not_three : 19 ∉ nsum T 3 := by
  rintro ⟨u, ⟨v, ⟨w, hw, a, ha, hwa⟩, b, hb, hvb⟩, c, hc, huc⟩
  change w = 0 at hw
  change carrier a ∧ a ≠ 0 at ha
  change carrier b ∧ b ≠ 0 at hb
  change carrier c ∧ c ≠ 0 at hc
  unfold carrier at ha hb hc
  omega

theorem disproof : ¬ (type_of% @OMA.S_mo_427621.main) := by
  intro h
  have hx := h semigroup cofinite 2 (by decide)
  change sSup (nsum T 2 \ nsum T 4) ≤ sSup (nsum T 3 \ nsum T 4) at hx
  have hbounded : BddAbove (nsum T 2 \ nsum T 4) :=
    ⟨19, fun x hx => by
      by_contra! he
      exact hx.2 (four_tail (by omega))⟩
  have hleft : 19 ≤ sSup (nsum T 2 \ nsum T 4) := by
    apply le_csSup hbounded
    refine ⟨cons (cons zero six) thirteen, fun hfour => ?_⟩
    have := minimal hfour
    omega
  have hright : sSup (nsum T 3 \ nsum T 4) ≤ 18 := by
    apply csSup_le
    · refine ⟨18, cons (cons (cons zero six) six) six, fun hfour => ?_⟩
      have := minimal hfour
      omega
    · intro x hx
      by_contra! he
      by_cases hnineteen : x = 19
      · exact nineteen_not_three (hnineteen ▸ hx.1)
      · exact hx.2 (four_tail (by omega))
  omega

end OMA.MO427621

theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_427621.main) := OMA.MO427621.disproof
