private theorem trial_sound {n c get s v0} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    (hrow : ∀ x < s.width, checkedRow n s x = true) (hinit : checkedInitial n s = true)
    (valid : ∀ p, validMove n (get p) = true) (hv0 : Compatible s c v0) {t : Trial}
    (h : trialCheck s get v0 t = true) (hb : Blue c t.blue) : c t.x = false := by
  cases hx : c t.x with
  | false => rfl
  | true =>
    have ht := @row_compatible n s c (geometry_ok hs hw) hrow
    have init := initial_compatible (geometry_ok hs hw) hinit
    have base := compatOr hv0 init
    have he := walk_ok (fun x => @ht x) (fun p => validMove_hit hs hw (valid p))
      120 (v0 ||| s.initial ||| row s t.x) _ t.pos (compatOr base (ht hx)) (blueOr hb (base t.x hx))
    simp [trialCheck,he] at h

private def accumulate (b : Nat) (t : Trial) :=
  if (t.blue &&& b) == t.blue then Nat.lor b (1 <<< t.x) else b

private theorem by_trials {n} (s : Board) (get : Nat → Nat) {k : Nat} (trial : Fin k → Trial)
    (hrow : ∀ x < s.width, checkedRow n s x = true) (hinit : checkedInitial n s = true)
    (valid : ∀ p, validMove n (get p) = true) (v0 b0 : Nat)
    (hchecks : ∀ i, trialCheck s get v0 (trial i) = true) (finalMove : Nat)
    (hvalid : validMove n finalMove = true)
    (hfinal : ((finalMove >>> 12) &&& ((List.finRange k).map trial).foldl accumulate b0) =
      finalMove >>> 12) (c : Nat → Bool) (hs : ∀ x < n, c (n-1-x) = c x)
    (seed : ¬ Wins n c → Compatible s c v0 ∧ Blue c b0) : Wins n c := by
  by_contra hw
  obtain ⟨hv0, hb0⟩ := seed hw
  have hb : Blue c (((List.finRange k).map trial).foldl accumulate b0) := by
    apply List.foldlRecOn (motive := Blue c)
    · exact hb0
    · intro b hb t ht
      obtain ⟨i,_,rfl⟩ := List.mem_map.mp ht
      unfold accumulate
      split
      · rename_i he
        exact blueOr hb (blueSingle (trial_sound hs hw hrow hinit valid hv0 (hchecks i)
          (blue_sub (beq_iff_eq.mp he) hb)))
      · exact hb
  obtain ⟨i,hi,hc⟩ := validMove_hit hs hw hvalid
  have hh := blue_sub hfinal hb i hi
  simp_all

