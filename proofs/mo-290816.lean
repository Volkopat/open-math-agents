private theorem fastCheck : ∀ g : Fin 64, canonical g.val = fastCanonical g.val := by decide

private theorem mask_bound (a b c d : ℕ) : mask a b c d < 64 := by
  unfold mask
  have bit (p : Prop) [Decidable p] (n : ℕ) : (if p then 0 else n) ≤ n := by split <;> omega
  have h₁ := bit (a.Coprime b) 1
  have h₂ := bit (a.Coprime c) 2
  have h₃ := bit (a.Coprime d) 4
  have h₄ := bit (b.Coprime c) 8
  have h₅ := bit (b.Coprime d) 16
  have h₆ := bit (c.Coprime d) 32
  omega

private theorem fast_mask (a b c d : ℕ) :
    canonical (mask a b c d) = fastCanonical (mask a b c d) :=
  fastCheck ⟨_, mask_bound a b c d⟩

private theorem coprime_period {a m x y : ℕ} (ha : a ∣ (a.gcd m) ^ 10)
    (hxy : x ≡ y [MOD m]) : a.Coprime x ↔ a.Coprime y := by
  let g := a.gcd m
  have compare (v : ℕ) : a.Coprime v ↔ g.Coprime v := by
    constructor
    · exact fun h => h.coprime_dvd_left (Nat.gcd_dvd_left _ _)
    · exact fun h => (h.pow_left 10).coprime_dvd_left ha
  rw [compare, compare]
  have he : x % g = y % g := hxy.of_dvd (Nat.gcd_dvd_right _ _)
  rw [Nat.Coprime, Nat.Coprime, Nat.gcd_rec g x, Nat.gcd_rec g y, he]

private theorem mask_period {a b c m x y : ℕ}
    (ha : a ∣ (a.gcd m) ^ 10) (hb : b ∣ (b.gcd m) ^ 10) (hc : c ∣ (c.gcd m) ^ 10)
    (hxy : x ≡ y [MOD m]) : mask a b c x = mask a b c y := by
  simp only [mask, coprime_period ha hxy, coprime_period hb hxy, coprime_period hc hxy]

private structure Triple where
  a : ℕ
  b : ℕ
  c : ℕ

private def Triple.total (t : Triple) : ℕ := t.a + t.b + t.c

private structure FourParts where
  a : ℕ
  b : ℕ
  c : ℕ
  d : ℕ

private def Good (g n : ℕ) (p : FourParts) : Prop :=
  0 < p.a ∧ 0 < p.b ∧ 0 < p.c ∧ 0 < p.d ∧ p.a + p.b + p.c + p.d = n ∧
    fastCanonical (mask p.a p.b p.c p.d) = g

private instance (g n : ℕ) (p : FourParts) : Decidable (Good g n p) := by
  unfold Good
  infer_instance

private def Valid (m g r : ℕ) (t : Triple) (u : FourParts) : Prop :=
  0 < t.a ∧ 0 < t.b ∧ 0 < t.c ∧
  t.a ∣ (t.a.gcd m)^10 ∧ t.b ∣ (t.b.gcd m)^10 ∧ t.c ∣ (t.c.gcd m)^10 ∧
  t.total < 312 + r + m ∧
  fastCanonical (mask t.a t.b t.c ((312+r+m)-t.total)) = g ∧
  (t.total < 312 + r ∨ Good g (312+r) u)

private instance (m g r : ℕ) (t : Triple) (u : FourParts) : Decidable (Valid m g r t u) := by
  unfold Valid
  infer_instance

private def Realizes (n g : ℕ) : Prop :=
  ∃ a b c d : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ 0 < d ∧ a+b+c+d = n ∧
    canonical (mask a b c d) = g

private theorem good_sound {g n : ℕ} {p : FourParts} (h : Good g n p) : Realizes n g := by
  obtain ⟨ha, hb, hc, hd, ht, hg⟩ := h
  exact ⟨p.a, p.b, p.c, p.d, ha, hb, hc, hd, ht, (fast_mask _ _ _ _).trans hg⟩

private theorem extend {m g r n : ℕ} {t : Triple} {u : FourParts} (hv : Valid m g r t u)
    (hn : n ≡ 312 + r + m [MOD m]) (hnt : t.total < n) : Realizes n g := by
  obtain ⟨ha,hb,hc,hA,hB,hC,ht,hg,_⟩ := hv
  let d := n - t.total
  let d₀ := (312 + r + m) - t.total
  have hd : 0 < d := by dsimp [d]; omega
  have he : d ≡ d₀ [MOD m] := hn.sub_right hnt.le ht.le
  have hmask := mask_period hA hB hC he
  refine ⟨t.a,t.b,t.c,d,ha,hb,hc,hd,?_,?_⟩
  · exact Nat.add_sub_of_le hnt.le
  · rw [hmask, fast_mask]
    exact hg

private theorem period_cover {m g : ℕ} (hm : 0 < m) (data : Fin m → Triple)
    (exceptions : Fin m → FourParts) (valid : ∀ r : Fin m, Valid m g r.val (data r) (exceptions r))
    (n : ℕ) (hn : 312 ≤ n) : Realizes n g := by
  let r : Fin m := ⟨(n-312) % m, Nat.mod_lt _ hm⟩
  let t := data r
  have hnform : n = 312 + r.val + m * ((n-312)/m) := by
    have eq := Nat.mod_add_div (n-312) m
    change r.val + _ = n-312 at eq
    omega
  have hmod : n ≡ 312 + r.val + m [MOD m] := by
    change n % m = (312 + r.val + m) % m
    rw [hnform]
    simp
  have hv := valid r
  by_cases hzero : (n-312)/m = 0
  · have hex : n = 312 + r.val := by simpa [hzero] using hnform
    rcases hv.2.2.2.2.2.2.2.2 with hlt | hgood
    · exact extend hv hmod (by omega)
    · rw [hex]
      exact good_sound hgood
  · have hpos : 1 ≤ (n-312)/m := Nat.pos_of_ne_zero hzero
    have bound : m ≤ m*((n-312)/m) := by simpa using Nat.mul_le_mul_left m hpos
    exact extend hv hmod (by have ht := hv.2.2.2.2.2.2.1; omega)


private def readTriple (table : Array ℕ) (r : ℕ) : Triple :=
  let word := table[r / 64]?.getD 0
  let code := (word >>> (30 * (r % 64))) % (2^30)
  ⟨code % 1024, (code / 1024) % 1024, code / (1024^2)⟩

private def blank (_ : ℕ) : FourParts := ⟨0, 0, 0, 0⟩

private theorem append_range (P : ℕ → Prop) {a b : ℕ}
    (left : ∀ i : Fin a, P i.val) (right : ∀ i : Fin b, P (a + i.val)) :
    ∀ i : Fin (a+b), P i.val := by
  intro i
  by_cases hi : i.val < a
  · exact left ⟨i.val, hi⟩
  · have hib : i.val-a < b := by have h := i.isLt; omega
    let j : Fin b := ⟨i.val-a, hib⟩
    have hj : a+j.val = i.val := by dsimp [j]; omega
    exact hj ▸ right j

