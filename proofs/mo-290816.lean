private theorem cycle_cases {a b c d : ℕ}
    (h : canonical (mask a b c d) = canonical 30) :
    Cycle a b c d ∨ Cycle a c b d ∨ Cycle a d b c := by
  have hc : canonical 30 = 30 := by decide
  rw [fast_mask, hc] at h
  have hval := cycle_codes ⟨_, mask_bound a b c d⟩ h
  unfold mask at hval
  unfold Cycle
  split_ifs at hval <;> simp_all [Nat.coprime_comm] <;>
    exact ⟨by assumption, by assumption⟩

private theorem swap_first {a b c d : ℕ} (h : Cycle a b c d) : Cycle b a c d := by
  obtain ⟨hab,hcd,hac,had,hbc,hbd⟩ := h
  exact ⟨hab.symm,hcd,hbc,hbd,hac,had⟩

private theorem swap_last {a b c d : ℕ} (h : Cycle a b c d) : Cycle a b d c := by
  obtain ⟨hab,hcd,hac,had,hbc,hbd⟩ := h
  exact ⟨hab,hcd.symm,had,hac,hbd,hbc⟩

private theorem swap_pairs {a b c d : ℕ} (h : Cycle a b c d) : Cycle c d a b := by
  obtain ⟨hab,hcd,hac,had,hbc,hbd⟩ := h
  exact ⟨hcd,hab,fun h => hac h.symm,fun h => hbc h.symm,
    fun h => had h.symm,fun h => hbd h.symm⟩

private theorem normalize_pairs {a b c d : ℕ} (h : Cycle a b c d) :
    Cycle (min a b) (max a b) (min c d) (max c d) := by
  rcases le_total a b with hab | hba
  · rw [min_eq_left hab, max_eq_right hab]
    rcases le_total c d with hcd | hdc
    · simpa only [min_eq_left hcd,max_eq_right hcd] using h
    · simpa only [min_eq_right hdc,max_eq_left hdc] using swap_last h
  · rw [min_eq_right hba,max_eq_left hba]
    rcases le_total c d with hcd | hdc
    · simpa only [min_eq_left hcd,max_eq_right hcd] using swap_first h
    · simpa only [min_eq_right hdc,max_eq_left hdc] using swap_last (swap_first h)

private theorem ordered {n a b c d : ℕ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d)
    (sum : a+b+c+d = n) (hcyc : Cycle a b c d) :
    ∃ x y z w : ℕ, 0 < x ∧ x ≤ y ∧ x ≤ z ∧ z ≤ w ∧ x+y+z+w = n ∧ Cycle x y z w := by
  let A := min a b
  let B := max a b
  let C := min c d
  let D := max c d
  have hAB : A ≤ B := (min_le_left _ _).trans (le_max_left _ _)
  have hCD : C ≤ D := (min_le_left _ _).trans (le_max_left _ _)
  have apos : 0 < A := lt_min ha hb
  have cpos : 0 < C := lt_min hc hd
  have base : Cycle A B C D := normalize_pairs hcyc
  have eqAB : A+B = a+b := min_add_max _ _
  have eqCD : C+D = c+d := min_add_max _ _
  rcases le_total A C with h | h
  · exact ⟨A,B,C,D,apos,hAB,h,hCD,by omega,base⟩
  · exact ⟨C,D,A,B,cpos,hCD,h,hAB,by omega,swap_pairs base⟩

private theorem checkA_sound {a b c d : ℕ} (hh : checkA a = true)
    (hab : a ≤ b) (hac : a ≤ c) (hcd : c ≤ d) (hsum : a+b+c+d = 311)
    (hcyc : Cycle a b c d) : False := by
  have hb : b-a < 312-4*a := by omega
  have hb' := (List.all_eq_true.mp hh) _ (List.mem_range.mpr hb)
  rw [Nat.add_sub_of_le hab] at hb'
  unfold checkB at hb'
  rw [if_pos hcyc.1] at hb'
  have hc : c-a < (311-a-b)/2 + 1 - a := by omega
  have hc' := (List.all_eq_true.mp hb') _ (List.mem_range.mpr hc)
  rw [Nat.add_sub_of_le hac, show 311-a-b-c = d by omega] at hc'
  simp [hcyc] at hc'

private theorem excluded_of_checks (checks : ∀ a : Fin 78, 0 < a.val → checkA a.val = true) :
    ¬ represented 311 30 := by
  rintro ⟨a,b,c,d,ha,hb,hc,hd,hsum,hgraph⟩
  have ho : ∃ x y z w : ℕ,
      0 < x ∧ x ≤ y ∧ x ≤ z ∧ z ≤ w ∧ x+y+z+w = 311 ∧ Cycle x y z w := by
    rcases cycle_cases hgraph with h | h | h
    · exact ordered ha hb hc hd hsum h
    · exact ordered ha hc hb hd (by omega) h
    · exact ordered ha hd hb hc (by omega) h
  obtain ⟨x,y,z,w,hx,hxy,hxz,hzw,hs,hcyc⟩ := ho
  have hlt : x < 78 := by omega
  exact checkA_sound (checks ⟨x,hlt⟩ hx) hxy hxz hzw hs hcyc

