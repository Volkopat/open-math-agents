private def Cycle (a b c d : ℕ) : Prop :=
  a.Coprime b ∧ c.Coprime d ∧ ¬a.Coprime c ∧ ¬a.Coprime d ∧ ¬b.Coprime c ∧ ¬b.Coprime d

private instance (a b c d : ℕ) : Decidable (Cycle a b c d) := by
  unfold Cycle
  infer_instance

private def checkB (a b : ℕ) : Bool :=
  if a.Coprime b then
    (List.range ((311-a-b)/2 + 1 - a)).all fun k =>
      !decide (Cycle a b (a+k) (311-a-b-(a+k)))
  else true

private def checkA (a : ℕ) : Bool :=
  (List.range (312 - 4*a)).all fun k => checkB a (a+k)


