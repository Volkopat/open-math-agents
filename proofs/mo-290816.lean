private def fastCanonical (g : ℕ) : ℕ :=
  #[0, 1, 1, 3, 1, 3, 3, 7, 1, 3, 3, 11, 12, 13, 13, 15,
    1, 3, 12, 13, 3, 11, 13, 15, 3, 7, 13, 15, 13, 15, 30, 31,
    1, 12, 3, 13, 3, 13, 11, 15, 3, 13, 7, 15, 13, 30, 15, 31,
    3, 13, 13, 30, 7, 15, 15, 31, 11, 15, 15, 31, 15, 31, 31, 63][g]?.getD 64

