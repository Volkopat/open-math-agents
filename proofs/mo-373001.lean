import OMAStatements.S_mo_373001
import Mathlib

/-!
# MathOverflow 373001: a commutator power twisting a generating pair

Witness: the simple group `A_7`, with `a = (0 3)(4 6)` of order 2, the 7-cycle
`b = (0 4 2 3 1 6 5)` and `r = 3`.  The two conjugation identities are checked by
computation.  Generation: the subgroup `H` generated by `a, b` contains elements of
orders 7, 5, 4, 3, so `420 ∣ |H|` and the index of `H` is at most 6.  The action of
`A_7` on the cosets of `H` is a homomorphism into a group of order at most `720 < 2520`,
so its kernel (the normal core of `H`) is nontrivial, hence everything by simplicity.
-/

namespace OMA.MO373001

open Equiv Equiv.Perm

/-- `(0 3)(4 6)` -/
def pa : Perm (Fin 7) := swap 0 3 * swap 4 6

/-- the 7-cycle `0 → 4 → 2 → 3 → 1 → 6 → 5 → 0` -/
def pb : Perm (Fin 7) := swap 0 4 * swap 4 2 * swap 2 3 * swap 3 1 * swap 1 6 * swap 6 5

set_option maxRecDepth 100000 in
theorem pa_mem : pa ∈ alternatingGroup (Fin 7) := by
  rw [mem_alternatingGroup]; decide

set_option maxRecDepth 100000 in
theorem pb_mem : pb ∈ alternatingGroup (Fin 7) := by
  rw [mem_alternatingGroup]; decide

abbrev G : Type := alternatingGroup (Fin 7)

def a : G := ⟨pa, pa_mem⟩
def b : G := ⟨pb, pb_mem⟩

theorem dvd_card_of_mem (H : Subgroup G) (x : G) (hx : x ∈ H) (n : ℕ)
    (h : orderOf (x : Perm (Fin 7)) = n) : n ∣ Nat.card H := by
  rw [← h, Subgroup.orderOf_coe, ← Subgroup.orderOf_mk x hx]
  exact orderOf_dvd_natCard _

set_option maxRecDepth 100000 in
theorem order_b : orderOf ((b : G) : Perm (Fin 7)) = 7 := by
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  show orderOf pb = 7
  exact orderOf_eq_prime (by decide) (by decide)

set_option maxRecDepth 100000 in
theorem order_w5 : orderOf ((a * b ^ 3 : G) : Perm (Fin 7)) = 5 := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  show orderOf (pa * pb ^ 3) = 5
  exact orderOf_eq_prime (by decide) (by decide)

set_option maxRecDepth 100000 in
theorem order_w3 : orderOf ((a * b * a * b ^ 3 : G) : Perm (Fin 7)) = 3 := by
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  show orderOf (pa * pb * pa * pb ^ 3) = 3
  exact orderOf_eq_prime (by decide) (by decide)

set_option maxRecDepth 100000 in
theorem order_w4 :
    orderOf ((a * b * a * b ^ 2 * a * b ^ 4 : G) : Perm (Fin 7)) = 4 := by
  have : Fact (Nat.Prime 2) := ⟨by norm_num⟩
  show orderOf (pa * pb * pa * pb ^ 2 * pa * pb ^ 4) = 2 ^ (1 + 1)
  exact orderOf_eq_prime_pow (by decide) (by decide)

theorem index_le (n i : ℕ) (h7 : 7 ∣ n) (h5 : 5 ∣ n) (h4 : 4 ∣ n) (h3 : 3 ∣ n)
    (hi : i * n = 2520) : i ≤ 6 := by
  have h35 : 7 * 5 ∣ n := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h7 h5
  have h140 : 7 * 5 * 4 ∣ n := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h35 h4
  have h420 : 7 * 5 * 4 * 3 ∣ n := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h140 h3
  obtain ⟨k, rfl⟩ := h420
  have h6 : i * k = 6 :=
    Nat.eq_of_mul_eq_mul_left (show 0 < 420 by norm_num) (by linarith)
  exact Nat.le_of_dvd (by norm_num) (Dvd.intro k h6)

/-- the commutator, at the level of permutations -/
def pc : Perm (Fin 7) := pa⁻¹ * pb⁻¹ * pa * pb

set_option maxRecDepth 100000 in
theorem conj_a : pc ^ 3 * pa * (pc ^ 3)⁻¹ = pa := by decide

set_option maxRecDepth 100000 in
theorem conj_b : pc ^ 3 * pb * (pc ^ 3)⁻¹ = pa * pb := by decide

set_option maxRecDepth 100000 in
theorem pa_sq : pa ^ 2 = 1 := by decide

set_option maxRecDepth 100000 in
theorem pa_ne : pa ≠ 1 := by decide

theorem card_G : Nat.card G = 2520 := by
  rw [nat_card_alternatingGroup]
  simp [Nat.factorial]

theorem closure_eq_top : Subgroup.closure {a, b} = (⊤ : Subgroup G) := by
  set H : Subgroup G := Subgroup.closure {a, b} with hH
  have ha : a ∈ H := Subgroup.subset_closure (by simp)
  have hb : b ∈ H := Subgroup.subset_closure (by simp)
  have h7 : 7 ∣ Nat.card H := dvd_card_of_mem H b hb 7 order_b
  have h5 : 5 ∣ Nat.card H :=
    dvd_card_of_mem H _ (H.mul_mem ha (H.pow_mem hb 3)) 5 order_w5
  have h3 : 3 ∣ Nat.card H :=
    dvd_card_of_mem H _
      (H.mul_mem (H.mul_mem (H.mul_mem ha hb) ha) (H.pow_mem hb 3)) 3 order_w3
  have h4 : 4 ∣ Nat.card H :=
    dvd_card_of_mem H _
      (H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem ha hb) ha) (H.pow_mem hb 2)) ha)
        (H.pow_mem hb 4)) 4 order_w4
  have hle : H.index ≤ 6 :=
    index_le (Nat.card H) H.index h7 h5 h4 h3 (by rw [Subgroup.index_mul_card, card_G])
  have : IsSimpleGroup G := alternatingGroup.isSimpleGroup (by simp)
  rcases (inferInstance : H.normalCore.Normal).eq_bot_or_eq_top with hbot | htop
  · exfalso
    have hinj : Function.Injective (MulAction.toPermHom G (G ⧸ H)) := by
      rw [← MonoidHom.ker_eq_bot_iff, ← Subgroup.normalCore_eq_ker]
      exact hbot
    have hcard := Nat.card_le_card_of_injective _ hinj
    rw [card_G, Nat.card_perm] at hcard
    have hfac : (Nat.card (G ⧸ H)).factorial ≤ (6 : ℕ).factorial :=
      Nat.factorial_le hle
    have : (6 : ℕ).factorial = 720 := by decide
    omega
  · exact top_le_iff.mp (htop ▸ H.normalCore_le)

end OMA.MO373001

open OMA.MO373001 in
theorem OMA.solution : type_of% @OMA.S_mo_373001.main := by
  refine ⟨G, inferInstance, inferInstance, alternatingGroup.isSimpleGroup (by simp),
    a, b, 3, ?_, closure_eq_top, ?_⟩
  · have h2 : orderOf a = 2 := by
      have : Fact (Nat.Prime 2) := ⟨by norm_num⟩
      exact orderOf_eq_prime (Subtype.ext pa_sq) (fun h => pa_ne (congrArg Subtype.val h))
    rw [h2]; norm_num
  · show (a⁻¹ * b⁻¹ * a * b) ^ (3 : ℤ) * a * ((a⁻¹ * b⁻¹ * a * b) ^ (3 : ℤ))⁻¹ = a ∧
      (a⁻¹ * b⁻¹ * a * b) ^ (3 : ℤ) * b * ((a⁻¹ * b⁻¹ * a * b) ^ (3 : ℤ))⁻¹ = a * b
    rw [show (3 : ℤ) = ((3 : ℕ) : ℤ) from rfl, zpow_natCast]
    exact ⟨Subtype.ext conj_a, Subtype.ext conj_b⟩
