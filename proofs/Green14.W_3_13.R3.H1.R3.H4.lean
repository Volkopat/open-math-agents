private def bases : Array Nat := #[0x1041041041041041041,0x1001001001001001001001001001001001001,0x1000040001000040001000040001000040001000040001000040001,0x1000001000001000001000001000001000001000001000001000001000001000001000001,0x1000000040000001000000040000001000000040000001000000040000001000000040000001000000040000001,0x1000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001,0x1000000000040000000001000000000040000000001000000000040000000001000000000040000000001000000000040000000001000000000040000000001,0x1000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001,0x1000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001,0x1000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001,0x1000000000000000040000000000000001000000000000000040000000000000001000000000000000040000000000000001000000000000000040000000000000001000000000000000040000000000000001000000000000000040000000000000001,0x1000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001,0x1000000000000000000040000000000000000001000000000000000000040000000000000000001000000000000000000040000000000000000001000000000000000000040000000000000000001000000000000000000040000000000000000001000000000000000000040000000000000000001]
private def pointIndex (x : Nat) : Nat := ( >>> (8*((x ^^^ (x-1))%347))) % 256
private def slotIndex (x : Nat) : Nat := ( >>> (12*((x ^^^ (x-1))%4139))) % 4096
private def slots (N : Nat) : Nat :=
  (List.range 14).foldl (fun s d => if 0<d ∧ 12*d<N then
    s ||| ((((1 <<< (6*(N-12*d)))-1)/63) <<< (6*(160*(d-1)+12*d))) else s) 0
private def high (N : Nat) : Nat := slots N <<< 5
private def fieldMask (N : Nat) : Nat := slots N * 63
private def pattern (N i : Nat) : Nat :=
  let d := i/160+1
  let e := i%160
  if d ≤ 13 ∧ 12*d ≤ e ∧ e<N then bases[d-1]! <<< (6*(e-12*d)) else bases[0]!
private def sumCounts (N a red : Nat) := ((a+red)*convolution) &&& fieldMask N
private def chooseSlot (N a red : Nat) : Nat :=
  let rc := (red*convolution) &&& fieldMask N
  let ac := sumCounts N a red-rc
  let h := high N
  let sl := slots N
  let counts := ac ||| ((h ^^^ ((h-rc) &&& h)) >>> 1)
  let c2 := (h+2*sl-counts) &&& h
  if c2 != 0 then slotIndex c2 else
  let c3 := (h+3*sl-counts) &&& h
  if c3 != 0 then slotIndex c3 else
  let c4 := (h+4*sl-counts) &&& h
  if c4 != 0 then slotIndex c4 else
  let c5 := (h+5*sl-counts) &&& h
  if c5 != 0 then slotIndex c5 else
  let c6 := (h+6*sl-counts) &&& h
  if c6 != 0 then slotIndex c6 else
  let c7 := (h+7*sl-counts) &&& h
  if c7 != 0 then slotIndex c7 else
  let c8 := (h+8*sl-counts) &&& h
  if c8 != 0 then slotIndex c8 else
  let c9 := (h+9*sl-counts) &&& h
  if c9 != 0 then slotIndex c9 else
  let c10 := (h+10*sl-counts) &&& h
  if c10 != 0 then slotIndex c10 else
  let c11 := (h+11*sl-counts) &&& h
  if c11 != 0 then slotIndex c11 else
  let c12 := (h+12*sl-counts) &&& h
  if c12 != 0 then slotIndex c12 else
  let c13 := (h+13*sl-counts) &&& h
  if c13 != 0 then slotIndex c13 else
  0
private def forced (N a red : Nat) : Nat :=
  let sums := sumCounts N a red
  let h := high N
  let z := (h-sums) &&& h
  if z != 0 then slotIndex z else
    let o := (h+slots N-sums) &&& h
    if o != 0 then slotIndex o else 100000
private def tapeBit (tape : Array Nat) (i : Nat) : Bool :=
  ((tape[i/256]?.getD 0 >>> (i%256)) % 2) = 1
private def unary (tape : Array Nat) : Nat → Nat → Nat × Nat
  | 0,i => (0,i)
  | k+1,i => if tapeBit tape i then
      let r := unary tape k (i+1)
      (r.1+1,r.2)
    else (0,i+1)
private def smallWord (tape : Array Nat) : Nat → Nat → Nat
  | 0,_ => 0
  | k+1,i => (if tapeBit tape i then 1 else 0)+2*smallWord tape k (i+1)
private def readTape (tape : Array Nat) (i : Nat) : Nat × Nat :=
  let r := unary tape 16 i
  if r.1 = 15 then (8+smallWord tape 8 r.2,r.2+8) else r
private def nthPoint : Nat → Nat → Nat
  | 0,rest => pointIndex rest
  | k+1,rest => nthPoint k (rest ^^^ (1 <<< (6*pointIndex rest)))
private def branch (N rank : Nat) (s : State) : Nat :=
  nthPoint rank (pattern N (chooseSlot N s.1.2 s.2) &&& s.1.2)
private def boardMask (red : Nat) (place : Nat → Nat) :=
  (List.range 160).foldl (fun z i => if red.testBit i then z ||| (1 <<< place i) else z) 0
private def fromBits (red allow : Nat) : State :=
  let oddMask := 0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  let evenMask := 0x5555555555555555555555555555555555555555
  ((⟨boardMask red (fun i => 6*(159-i)),boardMask red (fun i => 12*i),
     boardMask (red &&& evenMask) (fun i => 6*(i/2)),boardMask (red &&& oddMask) (fun i => 6*(i/2))⟩,
    boardMask allow (fun i => 6*i)),boardMask red (fun i => 6*i))
private abbrev B (N red allow : Nat) := Closed (pattern N) (fromBits red allow)
private theorem C {N red allow : Nat} (tape : Array Nat)
    (leaves : Array {s // Closed (pattern N) s})
    (h : run (pattern N) (fun s => forced N s.1.2 s.2) pointIndex (branch N)
      (readTape tape) leaves 165 0 (fromBits red allow) ≠ 0) : B N red allow :=
  run_sound _ _ _ _ _ _ _ _ _ h
private def P {N red allow : Nat} (h : B N red allow) : {s // Closed (pattern N) s} :=
  ⟨fromBits red allow,h⟩
private abbrev I := GreenCoverage.CoreImpossible
private lemma base_bit : ∀ d : Fin 14, 0 < d.val → ∀ t : Fin 13,
    bases[d.val-1]!.testBit (6*(t.val*d.val)) = true := by decide +kernel
private lemma pattern_hits {N : Nat} (hN : 13 ≤ N) (hmax : N ≤ 160)
    {R : Nat → Prop}
    (meet : ∀ a d,0<d → a+12*d<N → ∃ i : Fin 13,R (a+i.val*d)) : Hits (pattern N) R := by
  have get {a d : Nat} (hd : 0<d) (he : a+12*d<N) :
      ∃ z,(bases[d-1]! <<< (6*a)).testBit (6*z) = true ∧ R z := by
    obtain ⟨t,ht⟩ := meet a d hd he
    refine ⟨a+t.val*d,?_,ht⟩
    simpa [Nat.testBit_shiftLeft,Nat.mul_add,Nat.le_add_right] using
      base_bit ⟨d,by omega⟩ hd t
  intro i
  dsimp only [pattern]
  split
  · apply get <;> omega
  · simpa using get (a:=0) (d:=1) (by decide) (by omega)
private def seedState (A p d e : Nat) : State :=
  leftStep (leftStep (leftStep ((⟨0,0,0,0⟩,A),0) p) (p+d)) (p+d+e)
private lemma core_of_closed (N p d e A : Nat) (hN : 13 ≤ N) (hmax : N ≤ 160)
    (bits : ∀ x : Fin 160,x.val<N → ¬ (p<x.val ∧ x.val<p+d) →
      ¬ (p+d<x.val ∧ x.val<p+d+e) → A.testBit (6*x.val) = true)
    (hc : Closed (pattern N) (seedState A p d e)) : GreenCoverage.CoreImpossible N p d e := by
  intro R bound tr meet rp rq rv gap₁ gap₂
  have bound' (x : Nat) (hx : R x) : x ≤ 159 := by have := bound x hx;omega
  have hit := pattern_hits hN hmax meet
  let s₀ : State := ((⟨0,0,0,0⟩,A),0)
  have hs₀ : Good R s₀.1.1 := by intro x y _ _ _;simp [s₀,forbidden]
  have ha₀ : ∀ x,R x → s₀.1.2.testBit (6*x) = true := by
    intro x hx
    apply bits ⟨x,by have := bound' x hx;omega⟩ (bound x hx)
    · rintro ⟨hp,hq⟩;exact gap₁ x hp hq hx
    · rintro ⟨hq,hv⟩;exact gap₂ x hq hv hx
  have step (s : State) (z : Nat) (hz : R z) (hs : Good R s.1.1)
      (ha : ∀ x,R x → s.1.2.testBit (6*x) = true) :
      Good R (leftStep s z).1.1 ∧ ∀ x,R x → (leftStep s z).1.2.testBit (6*x) = true :=
    ⟨join_good hs (mark_good tr hz (bound' z hz)),add_safe hs ha hz⟩
  obtain ⟨hs₁,ha₁⟩ := step s₀ p rp hs₀ ha₀
  obtain ⟨hs₂,ha₂⟩ := step (leftStep s₀ p) (p+d) rq hs₁ ha₁
  obtain ⟨hs₃,ha₃⟩ := step (leftStep (leftStep s₀ p) (p+d)) (p+d+e) rv hs₂ ha₂
  exact hc R bound' tr hit hs₃ ha₃
private def strip (n : Nat) : Nat := ((1 <<< (6*n))-1)/63
private def initialMask (N p d e : Nat) : Nat :=
  strip N ^^^ ((strip (d-1) <<< (6*(p+1))) ||| (strip (e-1) <<< (6*(p+d+1))))
private abbrev SeedCheck (N p d e : Nat) (gate : {s // Closed (pattern N) s}) : Prop :=
  13 ≤ N ∧ N ≤ 160 ∧
  (∀ x : Fin 160,x.val<N → ¬ (p<x.val ∧ x.val<p+d) →
    ¬ (p+d<x.val ∧ x.val<p+d+e) → (initialMask N p d e).testBit (6*x.val) = true) ∧
  run (pattern N) (fun s => forced N s.1.2 s.2) pointIndex (branch N)
    (readTape #[0x7fff]) #[gate] 165 0 (seedState (initialMask N p d e) p d e) ≠ 0
private def coreCert (N p d e : Nat) (gate : {s // Closed (pattern N) s})
    (h : SeedCheck N p d e gate) : GreenCoverage.CoreImpossible N p d e :=
  core_of_closed N p d e (initialMask N p d e) h.1 h.2.1 h.2.2.1
    (run_sound _ _ _ _ _ _ _ _ _ h.2.2.2)
