/-! A kernel-checked bundle of cropped coloring obstructions. Packed marking adapts MrSeizy's R3 verifier; crop certificates, unary search traces and bounded chunks are new. -/
namespace GreenCoverage
def CoreImpossible (N p d e : ℕ) : Prop :=
  ∀ R : ℕ → Prop, (∀ x, R x → x < N) →
    (∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False) →
    (∀ a d, 0 < d → a+12*d < N → ∃ i : Fin 13, R (a+i.val*d)) →
    R p → R (p+d) → R (p+d+e) →
    (∀ x, p<x → x<p+d → ¬R x) →
    (∀ x, p+d<x → x<p+d+e → ¬R x) → False

end GreenCoverage
namespace GreenProof
private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (6*(159-q)), 1 <<< (12*q),
    if q%2=0 then 1 <<< (6*(q/2)) else 0,
    if q%2=1 then 1 <<< (6*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (12*p)) >>> 954) ||| (s.dbl >>> (6*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (6*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (6*t) = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 159) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (6*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 159) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (6*x) = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (6*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (6*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]


private abbrev State := (Marks × Nat) × Nat
private def leftStep (s : State) (p : Nat) : State :=
  (addRed s.1.1 s.1.2 p,s.2 ||| (1 <<< (6*p)))
private def erase (a p : Nat) := a ^^^ (a &&& (1 <<< (6*p)))
private def rightStep (s : State) (p : Nat) : State := ((s.1.1,erase s.1.2 p),s.2)
private lemma erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x,R x → a.testBit (6*x) = true) (hp : ¬ R p) :
    ∀ x,R x → (erase a p).testBit (6*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase,Nat.testBit_xor,ha t ht,Nat.shiftLeft_eq,hne]
private def Hits (pat : Nat → Nat) (R : Nat → Prop) :=
  ∀ i,∃ t,(pat i).testBit (6*t) = true ∧ R t
private def Closed (pat : Nat → Nat) (s : State) := Bad (Hits pat) s.1
private def matchGate (pat : Nat → Nat) (leaves : Array {s // Closed pat s})
    (i : Nat) (s : State) : Bool :=
  match leaves[i]? with
  | none => false
  | some v => v.val == s
private lemma gate_sound (pat : Nat → Nat) (leaves : Array {s // Closed pat s})
    (k : Nat) (s : State) (h : matchGate pat leaves k s = true) : Closed pat s := by
  unfold matchGate at h
  split at h
  · contradiction
  · rename_i v _
    exact (beq_iff_eq.mp h) ▸ v.property
private def run (pat : Nat → Nat) (force : State → Nat) (point : Nat → Nat)
    (branch : Nat → State → Nat) (read : Nat → Nat × Nat)
    (leaves : Array {s // Closed pat s}) : Nat → Nat → State → Nat
  | 0,_,_ => 0
  | fuel+1,i,s =>
    let op := read i
    if op.1 ≥ 8 && matchGate pat leaves (op.1-8) s then op.2+1 else
      let slot := force s
      if slot < 100000 then
        let rest := pat slot &&& s.1.2
        if rest = 0 then i+1 else
          let p := point rest
          if rest = 1 <<< (6*p) then run pat force point branch read leaves fuel i (leftStep s p) else 0
      else if op.1 < 8 then
        let p := branch op.1 s
        let next := run pat force point branch read leaves fuel op.2 (leftStep s p)
        if next = 0 then 0 else run pat force point branch read leaves fuel (next-1) (rightStep s p)
      else 0
private lemma run_sound (pat : Nat → Nat) (force : State → Nat) (point : Nat → Nat)
    (branch : Nat → State → Nat) (read : Nat → Nat × Nat)
    (leaves : Array {s // Closed pat s}) (fuel i : Nat) (s : State)
    (hw : run pat force point branch read leaves fuel i s ≠ 0) : Closed pat s := by
  induction fuel generalizing i s with
  | zero => simp [run] at hw
  | succ fuel ih =>
    simp only [run] at hw
    split at hw
    · rename_i he
      exact gate_sound pat leaves _ s (Bool.and_eq_true_iff.mp he).2
    · intro R bound hn hit hs ha
      split at hw
      · let slot := force s
        obtain ⟨t,hbit,ht⟩ := hit slot
        have hr : (pat slot &&& s.1.2).testBit (6*t) = true := by simp [hbit,ha t ht]
        split at hw
        · rename_i hz
          change pat slot &&& s.1.2 = 0 at hz
          simp [hz] at hr
        · split at hw
          · rename_i hsingle
            let p := point (pat slot &&& s.1.2)
            change pat slot &&& s.1.2 = 1 <<< (6*p) at hsingle
            rw [hsingle,Nat.shiftLeft_eq,one_mul,Nat.testBit_two_pow] at hr
            have hp : R p := (show t = p by have := of_decide_eq_true hr;omega) ▸ ht
            exact ih _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · contradiction
      · split at hw
        · split at hw
          · contradiction
          · rename_i hleft
            by_cases hp : R (branch (read i).1 s)
            · exact ih _ _ hleft R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
            · exact ih _ _ hw R bound hn hit hs (erase_safe ha hp)
        · contradiction
