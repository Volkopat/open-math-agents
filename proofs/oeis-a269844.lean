private theorem prime_sum_log_bounds {x : ℕ} {s : Finset ℕ}
    (hs : s ⊆ Nat.primesBelow (x + 1)) {b : ℝ} (hb : 0 < b) (hlog : 0 ≤ Real.log b) :
    (∑ p ∈ s, Real.log (p : ℝ)) ≤ (s.card : ℝ) * Real.log (x : ℝ) ∧
    (s.card : ℝ) * Real.log b ≤ (∑ p ∈ s, Real.log (p : ℝ)) + b * Real.log b := by
  classical
  have hp1 (p : ℕ) (hp : p ∈ s) : 1 ≤ p := (Nat.one_lt_of_mem_primesBelow (hs hp)).le
  have hsmall : ((s.filter fun p : ℕ => (p : ℝ) ≤ b).card : ℝ) ≤ b := by
    have hsub : (s.filter fun p : ℕ => (p : ℝ) ≤ b) ⊆ Finset.Icc 1 ⌊b⌋₊ := by
      intro p hp
      obtain ⟨hm, hle⟩ := Finset.mem_filter.mp hp
      exact Finset.mem_Icc.mpr ⟨hp1 p hm, Nat.le_floor hle⟩
    have hc : (s.filter fun p : ℕ => (p : ℝ) ≤ b).card ≤ ⌊b⌋₊ := by
      simpa using Finset.card_le_card hsub
    exact (Nat.cast_le.mpr hc).trans (Nat.floor_le hb.le)
  constructor
  · calc
      _ ≤ ∑ _p ∈ s, Real.log (x : ℝ) := by
        apply Finset.sum_le_sum
        intro p hp
        have hp' : p ≤ x := Nat.le_of_lt_succ (Nat.lt_of_mem_primesBelow (hs hp))
        exact Real.log_le_log (by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one (hp1 p hp)))
          (by exact_mod_cast hp')
      _ = _ := by simp
  · calc
      _ = ∑ _p ∈ s, Real.log b := by simp
      _ ≤ ∑ p ∈ s, (Real.log (p : ℝ) + if (p : ℝ) ≤ b then Real.log b else 0) := by
        apply Finset.sum_le_sum
        intro p hp
        split_ifs with h
        · linarith [Real.log_nonneg (show 1 ≤ (p : ℝ) by exact_mod_cast hp1 p hp)]
        · simpa using Real.log_le_log hb (le_of_not_ge h)
      _ = (∑ p ∈ s, Real.log (p : ℝ)) +
          ((s.filter fun p : ℕ => (p : ℝ) ≤ b).card : ℝ) * Real.log b := by
        rw [Finset.sum_add_distrib, ← Finset.sum_filter]
        simp
      _ ≤ _ := by gcongr

private theorem count_of_theta_limit (s : ℕ → Finset ℕ) (hs : ∀ x, s x ⊆ Nat.primesBelow (x + 1))
    {c : ℝ} (ht : Tendsto (fun x : ℕ => (∑ p ∈ s x, Real.log (p : ℝ)) / (x : ℝ))
      atTop (𝓝 c)) :
    Tendsto (fun x : ℕ => ((s x).card : ℝ) * Real.log (x : ℝ) / (x : ℝ)) atTop (𝓝 c) := by
  let L (x : ℕ) := Real.log (x : ℝ)
  let b (x : ℕ) := (x : ℝ) / (L x)^2
  let r (x : ℕ) := Real.log (b x) / L x
  have hL : Tendsto L atTop atTop := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hll : Tendsto (fun x : ℕ => Real.log (L x) / L x) atTop (𝓝 0) :=
    Real.isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp hL
  have hr : Tendsto r atTop (𝓝 1) := by
    have hh : Tendsto (fun x : ℕ => 1 - 2 * (Real.log (L x) / L x)) atTop (𝓝 1) := by
      simpa using (tendsto_const_nhds (x := (1 : ℝ))).sub
        ((tendsto_const_nhds (x := (2 : ℝ))).mul hll)
    apply hh.congr'
    filter_upwards [eventually_ge_atTop 2] with x hx
    have hx' : 1 < (x : ℝ) := by exact_mod_cast (show 1 < x by omega)
    have hl : L x ≠ 0 := (Real.log_pos hx').ne'
    dsimp only [r, b, L]
    rw [Real.log_div (by linarith) (pow_ne_zero _ hl), Real.log_pow]
    dsimp only [L] at hl
    field_simp
    <;> ring
  have hinv : Tendsto (fun x : ℕ => (L x)⁻¹) atTop (𝓝 0) := tendsto_inv_atTop_zero.comp hL
  have hu : Tendsto
      (fun x : ℕ => ((∑ p ∈ s x, Real.log (p : ℝ)) / (x : ℝ)) / r x + (L x)⁻¹)
      atTop (𝓝 c) := by
    simpa using (ht.div hr one_ne_zero).add hinv
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' ht hu
  · filter_upwards [eventually_ge_atTop 2] with x hx
    have H := (prime_sum_log_bounds (hs x) (b := 1) zero_lt_one (by simp)).1
    exact div_le_div_of_nonneg_right H (Nat.cast_nonneg x)
  · filter_upwards [eventually_ge_atTop 2, hr.eventually (lt_mem_nhds (by norm_num : (0 : ℝ) < 1))] with x hx hrx
    have hx' : 1 < (x : ℝ) := by exact_mod_cast (show 1 < x by omega)
    have hx0 : 0 < (x : ℝ) := by linarith
    have hLx : 0 < L x := Real.log_pos hx'
    have hbx : 0 < b x := div_pos hx0 (sq_pos_of_pos hLx)
    have hD : 0 < Real.log (b x) := (div_pos_iff_of_pos_right hLx).mp hrx
    have H := (prime_sum_log_bounds (hs x) hbx hD.le).2
    change (s x).card * L x / (x : ℝ) ≤ _
    calc
      _ = ((s x).card * Real.log (b x) / (x : ℝ)) / r x := by
        dsimp only [r]
        field_simp [hLx.ne', hD.ne', hx0.ne']
      _ ≤ (((∑ p ∈ s x, Real.log (p : ℝ)) + b x * Real.log (b x)) / (x : ℝ)) / r x :=
        div_le_div_of_nonneg_right (div_le_div_of_nonneg_right H hx0.le) hrx.le
      _ = _ := by
        dsimp only [r]
        rw [add_div, add_div]
        congr 1
        change (((x : ℝ) / (L x)^2) * Real.log (b x) / x) / (Real.log (b x) / L x) = _
        field_simp [hLx.ne', hD.ne', hx0.ne']
        <;> ring

theorem pi_ap_log {q a : ℕ} (hq : 0 < q) (ha : Nat.Coprime a q) :
    Tendsto (fun x : ℕ =>
      (((Nat.primesBelow (x + 1)).filter (fun p => p % q = a % q)).card : ℝ) *
        Real.log (x : ℝ) / (x : ℝ)) atTop (𝓝 (1 / (q.totient : ℝ))) := by
  exact count_of_theta_limit _ (fun _ => Finset.filter_subset _ _) (theta_ap_tendsto hq ha)

end A269844.PNTA

namespace A269844

open Filter Topology

theorem pnt_log :
    Tendsto (fun x : ℕ => (Nat.primeCounting x : ℝ) * Real.log (x : ℝ) / (x : ℝ)) atTop (𝓝 1) := by
  simpa [← Nat.primesLE_card_eq_primeCounting, Nat.primesLE, Nat.mod_one] using
    (PNTA.pi_ap_log (q := 1) (a := 1) (by decide) (by decide))

theorem pnt_ap_ratio {q a : ℕ} (hq : 0 < q) (ha : Nat.Coprime a q) :
    Tendsto (fun x : ℕ =>
        ((((Nat.primesBelow (x + 1)).filter (fun p => p % q = a % q)).card : ℕ) : ℝ) /
          (Nat.primeCounting x : ℝ))
      atTop (𝓝 (1 / (q.totient : ℝ))) := by
  have h := (PNTA.pi_ap_log hq ha).div pnt_log one_ne_zero
  rw [div_one] at h
  apply h.congr'
  filter_upwards [eventually_ge_atTop 2] with x hx
  have hx' : 1 < (x : ℝ) := by exact_mod_cast (show 1 < x by omega)
  have hl := (Real.log_pos hx').ne'
  have hx0 : (x : ℝ) ≠ 0 := by linarith
  dsimp
  by_cases hc : (x.primeCounting : ℝ) = 0
  · simp [hc]
  · field_simp [hc, hl, hx0]

end A269844

