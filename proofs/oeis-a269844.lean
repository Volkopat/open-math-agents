open scoped Nat
open BrunTitchmarsh

noncomputable def roughInterval (t : ℕ) (y z : ℝ) : Finset ℕ := by
  classical
  exact (Finset.Icc (Nat.ceil (t : ℝ)) (Nat.floor ((t : ℝ) + y))).filter
    (fun n ↦ ∀ p : ℕ, p.Prime → (p : ℝ) ≤ z → ¬ p ∣ n)

theorem roughInterval_card_le (t : ℕ) (ht : 0 < t) (y z : ℝ) (hy : 0 < y)
    (hz : 1 < z) :
    ((roughInterval t y z).card : ℝ) ≤
      2 * y / Real.log z + 5 * z * (1 + Real.log z) ^ 3 := by
  rw [roughInterval, ← BrunTitchmarsh.siftedSum_eq_card (t : ℝ) y z hz.le]
  exact BrunTitchmarsh.siftedSum_le _ _ _ (by exact_mod_cast ht) hy hz

theorem primeSquare_count_le_of_cover (x ℓ a : ℕ) (hℓ : ℓ.Prime) (hx : 0 < x)
    (z : ℝ) (hz : 1 < z) (t u : ℕ) (ht : 0 < t) (hu : 0 < u)
    (cover : ∀ k : ℕ, (ℓ ^ 2 * k + a % ℓ ^ 2).Prime →
      Nat.floor z < ℓ ^ 2 * k + a % ℓ ^ 2 →
      (∀ p : ℕ, p.Prime → p ≤ Nat.floor z → ¬ p ∣ k + t) ∨
      (∀ p : ℕ, p.Prime → p ≤ Nat.floor z → ¬ p ∣ k + u)) :
    ((((Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2)).card : ℕ) : ℝ) ≤
      4 * ((x : ℝ) / (ℓ : ℝ) ^ 2) / Real.log z + 11 * z * (1 + Real.log z) ^ 3 := by
  classical
  let y : ℝ := (x : ℝ) / (ℓ : ℝ) ^ 2
  let r := a % ℓ ^ 2
  let liftP (v n : ℕ) := ℓ ^ 2 * (n - v) + r
  let small := Finset.Icc 1 (Nat.floor z)
  have hℓR : 0 < (ℓ : ℝ) := by exact_mod_cast hℓ.pos
  have hy : 0 < y := div_pos (by exact_mod_cast hx) (sq_pos_of_pos hℓR)
  have sub : (Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2) ⊆
      (small ∪ (roughInterval t y z).image (liftP t)) ∪
        (roughInterval u y z).image (liftP u) := by
    intro p hp
    obtain ⟨hp', ha⟩ := Finset.mem_filter.mp hp
    have hprime : p.Prime := by
      have := Nat.mem_primesBelow.mp hp'
      tauto
    have hpx : p ≤ x := by
      have hm := Nat.mem_primesBelow.mp hp'
      have : p < x + 1 := by tauto
      omega
    by_cases hs : p ≤ Nat.floor z
    · exact Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_Icc.mpr ⟨hprime.one_le, hs⟩))
    let k := p / ℓ ^ 2
    have hpk : ℓ ^ 2 * k + r = p := by
      change ℓ ^ 2 * (p / ℓ ^ 2) + a % ℓ ^ 2 = p
      rw [← ha, Nat.div_add_mod]
    have hky : (k : ℝ) ≤ y := by
      apply (le_div_iff₀ (sq_pos_of_pos hℓR)).mpr
      have h : k * ℓ ^ 2 ≤ x := by
        calc
          k * ℓ ^ 2 = ℓ ^ 2 * k := Nat.mul_comm ..
          _ ≤ ℓ ^ 2 * k + r := Nat.le_add_right ..
          _ = p := hpk
          _ ≤ x := hpx
      exact_mod_cast h
    have memImage (v : ℕ) (hg : ∀ q : ℕ, q.Prime → q ≤ Nat.floor z → ¬ q ∣ k + v) :
        p ∈ (roughInterval v y z).image (liftP v) := by
      apply Finset.mem_image.mpr
      refine ⟨k + v, Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨?_, ?_⟩, ?_⟩, ?_⟩
      · simp
      · apply Nat.le_floor
        push_cast
        linarith
      · intro q hq hqz
        exact hg q hq (Nat.le_floor hqz)
      · simpa [liftP] using hpk
    have hlarge : Nat.floor z < ℓ ^ 2 * k + a % ℓ ^ 2 := by
      change Nat.floor z < ℓ ^ 2 * k + r
      omega
    rcases cover k (by simpa only [← hpk] using hprime) hlarge with H | H
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ (memImage t H))
    · exact Finset.mem_union_right _ (memImage u H)
  have hcard := Finset.card_le_card sub
  have hc : ((Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2)).card ≤
      small.card + (roughInterval t y z).card + (roughInterval u y z).card := by
    have h₁ := Finset.card_union_le (small ∪ (roughInterval t y z).image (liftP t))
      ((roughInterval u y z).image (liftP u))
    have h₂ := Finset.card_union_le small ((roughInterval t y z).image (liftP t))
    have h₃ := Finset.card_image_le (s := roughInterval t y z) (f := liftP t)
    have h₄ := Finset.card_image_le (s := roughInterval u y z) (f := liftP u)
    omega
  have hs : (small.card : ℝ) ≤ z := by
    simpa [small, Nat.card_Icc] using (Nat.floor_le (le_trans (by norm_num) hz.le))
  have hone : 1 ≤ (1 + Real.log z) ^ 3 := one_le_pow₀ (by linarith [Real.log_nonneg hz.le])
  have herr := le_mul_of_one_le_right (le_trans (by norm_num : (0:ℝ) ≤ 1) hz.le) hone
  have hcardR :
      ((((Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2)).card : ℕ) : ℝ) ≤
      (small.card : ℝ) + ((roughInterval t y z).card : ℝ) + ((roughInterval u y z).card : ℝ) :=
    by exact_mod_cast hc
  change _ ≤ 4 * y / Real.log z + _
  calc
    _ ≤ (small.card : ℝ) + ((roughInterval t y z).card : ℝ) +
        ((roughInterval u y z).card : ℝ) := hcardR
    _ ≤ z * (1 + Real.log z) ^ 3 + (2 * y / Real.log z + 5 * z * (1 + Real.log z) ^ 3) +
        (2 * y / Real.log z + 5 * z * (1 + Real.log z) ^ 3) :=
      add_le_add (add_le_add (hs.trans herr) (roughInterval_card_le t ht y z hy hz))
        (roughInterval_card_le u hu y z hy hz)
    _ = _ := by ring

theorem primeSquare_count_le (x ℓ a : ℕ) (hℓ : ℓ.Prime) (hx : 0 < x)
    (z : ℝ) (hz : 1 < z) :
    ((((Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2)).card : ℕ) : ℝ) ≤
      4 * ((x : ℝ) / (ℓ : ℝ) ^ 2) / Real.log z + 11 * z * (1 + Real.log z) ^ 3 := by
  obtain ⟨t, u, ht, hu, hcover⟩ := shifted_sieve_cover ℓ (a % ℓ ^ 2) (Nat.floor z) hℓ
  exact primeSquare_count_le_of_cover x ℓ a hℓ hx z hz t u ht hu hcover

