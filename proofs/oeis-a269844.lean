open scoped BigOperators

/-- Every large prime value of the linear polynomial gives a survivor in one
of two translated ordinary interval sieves with the same level. -/
theorem shifted_sieve_cover (ℓ a K : ℕ) (hℓ : ℓ.Prime) :
    ∃ t u : ℕ, 0 < t ∧ 0 < u ∧ ∀ k : ℕ, (ℓ ^ 2 * k + a).Prime →
      K < ℓ ^ 2 * k + a →
      ((∀ p : ℕ, p.Prime → p ≤ K → ¬p ∣ k + t) ∨
        (∀ p : ℕ, p.Prime → p ≤ K → ¬p ∣ k + u)) := by
  classical
  let S := (Finset.range (K + 1)).filter (fun p : ℕ => p.Prime ∧ p ≠ ℓ)
  let M := ∏ p ∈ S, p
  have hM : 0 < M :=
    Finset.prod_pos fun p hp => ((Finset.mem_filter.mp hp).2.1).pos
  have hellM : ¬ℓ ∣ M := by
    intro h
    obtain ⟨p, hp, hdiv⟩ := hℓ.prime.exists_mem_finset_dvd
      (show ℓ ∣ ∏ p ∈ S, p from h)
    obtain ⟨_, hprime, hne⟩ := Finset.mem_filter.mp hp
    exact hne ((Nat.prime_dvd_prime_iff_eq hℓ hprime).mp hdiv).symm
  have hcop : Nat.Coprime M (ℓ ^ 2) :=
    ((hℓ.coprime_iff_not_dvd.mpr hellM).pow_left 2).symm
  obtain ⟨c, hc, hzero⟩ := Nat.chineseRemainder hcop a 0
  obtain ⟨v, rfl⟩ := Nat.modEq_zero_iff_dvd.mp hzero
  have step (w : ℕ) (hw : ℓ ^ 2 * w ≡ a [MOD M]) :
      ℓ ^ 2 * (w + M) ≡ a [MOD M] := by
    apply Nat.ModEq.trans _ hw
    simp [Nat.ModEq, Nat.mul_add]
  let t := v + M
  let u := t + M
  have ht : ℓ ^ 2 * t ≡ a [MOD M] := step v hc
  have hu : ℓ ^ 2 * u ≡ a [MOD M] := step t ht
  refine ⟨t, u, by dsimp [t]; omega, by dsimp [u]; omega, ?_⟩
  intro k hprime hlarge
  have avoid (w : ℕ) (hw : ℓ ^ 2 * w ≡ a [MOD M]) (p : ℕ)
      (hp : p.Prime) (hK : p ≤ K) (hne : p ≠ ℓ) : ¬p ∣ k + w := by
    intro hd
    have hpM : p ∣ M := Finset.dvd_prod_of_mem _ (show p ∈ S from
      Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp, hne⟩)
    have hcong : ℓ ^ 2 * (k + w) ≡ ℓ ^ 2 * k + a [MOD p] := by
      rw [Nat.mul_add]
      exact (Nat.ModEq.refl _).add (Nat.ModEq.of_dvd hpM hw)
    have hz : ℓ ^ 2 * (k + w) ≡ 0 [MOD p] :=
      Nat.modEq_zero_iff_dvd.mpr (dvd_mul_of_dvd_right hd _)
    have heq := (hprime.dvd_iff_eq hp.ne_one).mp
      (Nat.modEq_zero_iff_dvd.mp (hcong.symm.trans hz))
    omega
  by_cases htbad : ℓ ∣ k + t
  · right
    intro p hp hK
    by_cases heq : p = ℓ
    · subst p
      intro hd
      have htotal : ℓ ∣ (k + t) + M := by simpa [u, Nat.add_assoc] using hd
      apply hellM
      simpa using Nat.dvd_sub htotal htbad
    · exact avoid u hu p hp hK heq
  · left
    intro p hp hK
    by_cases heq : p = ℓ
    · simpa [heq] using htbad
    · exact avoid t ht p hp hK heq

end A269844.BTB

