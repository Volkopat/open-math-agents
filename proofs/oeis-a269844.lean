theorem bt_prime_square :
    ∃ C : ℝ, 0 < C ∧ ∃ x₀ : ℕ, ∀ x : ℕ, x₀ ≤ x → ∀ ℓ : ℕ, ℓ.Prime → ℓ ^ 4 ≤ x →
      ∀ a : ℕ, Nat.Coprime a ℓ →
        ((((Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2)).card : ℕ) : ℝ) ≤
          C * (x : ℝ) / ((ℓ : ℝ) ^ 2 * Real.log (x : ℝ)) := by
  refine ⟨16 + 1056 * Real.exp 1, by positivity, 2, ?_⟩
  intro x hx ℓ hℓ hℓx a _
  apply BTB.interval_bound_to_log_bound
  · exact_mod_cast (show 1 < x by omega)
  · exact_mod_cast hℓ.pos
  · exact_mod_cast hℓx
  · exact BTB.primeSquare_count_le x ℓ a hℓ (by omega)

