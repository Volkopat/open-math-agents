theorem theta_ap_tendsto {q a : ℕ} (hq : 0 < q) (ha : Nat.Coprime a q) :
    Tendsto (fun x : ℕ => (∑ p ∈ (Nat.primesBelow (x + 1)).filter
        (fun p => p % q = a % q), Real.log (p : ℝ)) / (x : ℝ))
      atTop (𝓝 (1 / (q.totient : ℝ))) := by
  have hcop : Nat.Coprime (a % q) q := by
    change (a % q).gcd q = 1
    rw [← Nat.gcd_rec, Nat.gcd_comm]
    exact ha
  have h := chebyshev_asymptotic_pnt hq hcop (Nat.mod_lt _ hq)
  have htot : (q.totient : ℝ) ≠ 0 := by exact_mod_cast (Nat.totient_pos.mpr hq).ne'
  have hratio := (Asymptotics.isEquivalent_iff_tendsto_one
    (by filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx using div_ne_zero hx.ne' htot)).mp h
  have hnat := hratio.comp (tendsto_natCast_atTop_atTop (R := ℝ))
  have hscaled := hnat.mul (tendsto_const_nhds (x := (q.totient : ℝ)⁻¹))
  convert hscaled using 1
  · ext x
    simp only [Function.comp_apply, Pi.div_apply, Nat.floor_natCast, div_div_eq_mul_div,
      Finset.sum_filter]
    have hs : Nat.primesBelow (x + 1) = (Finset.Iic x).filter Nat.Prime := by
      ext p
      simp [Nat.primesBelow]
    rw [hs, Finset.sum_filter]
    field_simp
  · simp [one_div]

end A269844.PNTA

