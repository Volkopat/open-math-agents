namespace A269844

open Filter Topology
open scoped BigOperators

def HA : Prop := ∀ q a : ℕ, 0 < q → Nat.Coprime a q →
    Tendsto (fun x : ℕ =>
        ((((Nat.primesBelow (x + 1)).filter (fun p => p % q = a % q)).card : ℕ) : ℝ) /
          (Nat.primeCounting x : ℝ))
      atTop (𝓝 (1 / (q.totient : ℝ)))

def HP : Prop :=
  Tendsto (fun x : ℕ => (Nat.primeCounting x : ℝ) * Real.log (x : ℝ) / (x : ℝ)) atTop (𝓝 1)

def HB : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∃ x₀ : ℕ, ∀ x : ℕ, x₀ ≤ x → ∀ ℓ : ℕ, ℓ.Prime → ℓ ^ 4 ≤ x →
    ∀ a : ℕ, Nat.Coprime a ℓ →
      ((((Nat.primesBelow (x + 1)).filter (fun p => p % ℓ ^ 2 = a % ℓ ^ 2)).card : ℕ) : ℝ) ≤
        C * (x : ℝ) / ((ℓ : ℝ) ^ 2 * Real.log (x : ℝ))

namespace MirC

def IsLayer (q : ℕ) (P : ℕ → Prop) (d : ℝ) : Prop :=
  ∃ S : Finset ℕ, (∀ a ∈ S, a < q ∧ a.Coprime q) ∧
    (∀ n, n % q ∈ S ↔ P n) ∧ (S.card : ℝ) / (q.totient : ℝ) = d

theorem layer_limit (hA : HA) {q : ℕ} {P : ℕ → Prop} [DecidablePred P]
    {d : ℝ} (hq : 0 < q) (hl : IsLayer q P d) :
    Tendsto (fun x : ℕ => ((((Nat.primesBelow (x+1)).filter P).card : ℕ) : ℝ) /
      (Nat.primeCounting x : ℝ)) atTop (𝓝 d) := by
  classical
  obtain ⟨S, hS, hP, rfl⟩ := hl
  have hlim := tendsto_finsetSum S (fun a ha => hA q a hq (hS a ha).2)
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one_div] at hlim
  apply hlim.congr
  intro x
  rw [← Finset.sum_div, ← Nat.cast_sum]
  congr 2
  have hf := Finset.sum_card_fiberwise_eq_card_filter (Nat.primesBelow (x+1)) S (· % q)
  convert hf using 1
  · apply Finset.sum_congr rfl
    intro a ha
    rw [Nat.mod_eq_of_lt (hS a ha).1]
  · congr 1
    ext n
    simp only [Finset.mem_filter, hP]

theorem layer_mul {q r : ℕ} {P R : ℕ → Prop} {d e : ℝ}
    (hq : 0 < q) (hr : 0 < r) (hc : q.Coprime r)
    (hP : IsLayer q P d) (hR : IsLayer r R e) :
    IsLayer (q*r) (fun n => P n ∧ R n) (d*e) := by
  classical
  obtain ⟨S, hS, hp, rfl⟩ := hP
  obtain ⟨T, hT, ht, rfl⟩ := hR
  let U := (Finset.range (q*r)).filter fun n => n%q ∈ S ∧ n%r ∈ T
  have hU (n : ℕ) : n ∈ U ↔ n < q*r ∧ n%q ∈ S ∧ n%r ∈ T := by simp [U]
  have hcU : U.card = S.card*T.card := by
    rw [← Finset.card_product]
    apply Finset.card_bij (fun n _ => (n%q,n%r))
    · intro n hn
      exact Finset.mem_product.mpr ((hU n).mp hn).2
    · intro a ha b hb h
      have hq' : a ≡ b [MOD q] := congrArg Prod.fst h
      have hr' : a ≡ b [MOD r] := congrArg Prod.snd h
      have hqr := Nat.mod_lcm hq' hr'
      rw [hc.lcm_eq_mul] at hqr
      exact hqr.eq_of_lt_of_lt ((hU a).mp ha).1 ((hU b).mp hb).1
    · rintro ⟨a,b⟩ hab
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hab
      let z := Nat.chineseRemainder hc a b
      have hqa : z.val%q = a := Eq.trans z.property.1 (Nat.mod_eq_of_lt (hS a ha).1)
      have hrb : z.val%r = b := Eq.trans z.property.2 (Nat.mod_eq_of_lt (hT b hb).1)
      refine ⟨z.val, (hU _).mpr ⟨Nat.chineseRemainder_lt_mul hc a b hq.ne' hr.ne', ?_, ?_⟩, ?_⟩
      · rwa [hqa]
      · rwa [hrb]
      · simp [hqa, hrb]
  refine ⟨U, ?_, ?_, ?_⟩
  · intro n hn
    obtain ⟨hlt, hs, ht'⟩ := (hU n).mp hn
    exact ⟨hlt, Nat.coprime_mul_iff_right.mpr ⟨by simpa using (hS _ hs).2,
      by simpa using (hT _ ht').2⟩⟩
  · intro n
    rw [hU]
    simp [Nat.mod_lt _ (Nat.mul_pos hq hr),
      Nat.mod_mod_of_dvd n (dvd_mul_right q r), Nat.mod_mod_of_dvd n (dvd_mul_left r q), hp, ht]
  · rw [hcU, Nat.totient_mul hc]
    push_cast
    ring

def outerRule (n : ℕ) : Prop := n % 8 = 3 ∨ n % 8 = 5

def primeRule (l n : ℕ) : Prop :=
  (n % l^2).Coprime (l^2) ∧ n % l^2 ≠ 1 ∧ n % l^2 ≠ l^2-1

theorem layer_eight : IsLayer 8 outerRule (1 / 2) := by
  refine ⟨{3,5}, ?_, ?_, ?_⟩
  · intro a ha
    simp only [Finset.mem_insert, Finset.mem_singleton] at ha
    rcases ha with rfl | rfl <;> decide
  · intro n
    simp [outerRule]
  · norm_num [show Nat.totient 8 = 4 from by decide]

theorem layer_square {l : ℕ} (hl : l.Prime) (ho : 2 < l) :
    IsLayer (l^2) (primeRule l) (1 - 2 / ((l:ℝ)*((l:ℝ)-1))) := by
  classical
  let q := l^2
  have hq : 2 < q := by dsimp [q]; nlinarith
  let U := (Finset.range q).filter fun a => q.Coprime a
  let S := (U.erase 1).erase (q-1)
  have hU (a : ℕ) : a ∈ U ↔ a < q ∧ q.Coprime a := by simp [U]
  have h1 : 1 ∈ U := (hU _).mpr ⟨by omega, by simp⟩
  have h2 : q-1 ∈ U.erase 1 := Finset.mem_erase.mpr ⟨by omega, (hU _).mpr ⟨by omega,
    (Nat.coprime_self_sub_right (by omega : 1 ≤ q)).mpr (by simp)⟩⟩
  have hcard : S.card = q.totient - 1 - 1 := by
    rw [show S = (U.erase 1).erase (q-1) from rfl, Finset.card_erase_of_mem h2,
      Finset.card_erase_of_mem h1]
    rfl
  refine ⟨S, ?_, ?_, ?_⟩
  · intro n hn
    have hh := (hU n).mp (Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hn))
    exact ⟨hh.1,hh.2.symm⟩
  · intro n
    change n%q ∈ (U.erase 1).erase (q-1) ↔ _
    simp only [Finset.mem_erase, hU, Nat.mod_lt n (by omega : 0 < q), true_and]
    change _ ↔ (n%q).Coprime q ∧ n%q ≠ 1 ∧ n%q ≠ q-1
    rw [show q.Coprime (n%q) ↔ (n%q).Coprime q from Nat.coprime_comm]
    tauto
  · rw [hcard]
    change (((l^2).totient - 1 - 1 : ℕ) : ℝ) / ((l^2).totient : ℝ) = _
    rw [Nat.totient_prime_pow_succ hl 1]
    simp only [pow_one]
    have hlt : 2 ≤ l*(l-1) := by
      have := Nat.le_mul_of_pos_left (l-1) (by omega : 0<l)
      omega
    rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega), Nat.cast_mul,
      Nat.cast_sub (by omega)]
    push_cast
    have hp : (2:ℝ) < l := by exact_mod_cast ho
    have hne : (l:ℝ)-1 ≠ 0 := by linarith
    have hn : (l:ℝ) ≠ 0 := by linarith
    field_simp [hne,hn]
    ring

def layerMod (s : Finset ℕ) : ℕ := 8 * ∏ l ∈ s, l^2

theorem layerMod_pos (s : Finset ℕ) (hs : ∀ l ∈ s, Nat.Prime l ∧ 2 < l) : 0 < layerMod s :=
  Nat.mul_pos (by decide) (Finset.prod_pos (fun l hl => pow_pos (hs l hl).1.pos 2))

theorem layer_family (s : Finset ℕ) (hs : ∀ l ∈ s, Nat.Prime l ∧ 2 < l) :
    IsLayer (layerMod s) (fun n => outerRule n ∧ ∀ l ∈ s, primeRule l n)
      ((1/2:ℝ) * ∏ l ∈ s, (1 - 2 / ((l:ℝ)*((l:ℝ)-1)))) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa [layerMod] using layer_eight
  | @insert l s hl ih =>
    have hi := hs l (Finset.mem_insert_self _ _)
    have hj (j : ℕ) (hj : j ∈ s) := hs j (Finset.mem_insert_of_mem hj)
    have hco : (layerMod s).Coprime (l^2) := by
      apply Nat.coprime_mul_iff_left.mpr
      constructor
      · exact Nat.coprime_pow_primes 3 2 Nat.prime_two hi.1 (by omega)
      · exact Nat.coprime_prod_left_iff.mpr fun j h => Nat.coprime_pow_primes 2 2
          (hj j h).1 hi.1 (fun e => hl (e ▸ h))
    have h := layer_mul (layerMod_pos s hj) (pow_pos hi.1.pos 2) hco (ih hj)
      (layer_square hi.1 hi.2)
    convert h using 1
    · simp [layerMod, Finset.prod_insert hl, Nat.mul_comm, Nat.mul_left_comm]
    · funext n
      simp only [Finset.forall_mem_insert]
      apply propext
      tauto
    · rw [Finset.prod_insert hl]
      ring

open Classical in
theorem finite_density (hA : HA) (s : Finset ℕ) (hs : ∀ l ∈ s, Nat.Prime l ∧ 2 < l) :
    Tendsto (fun x : ℕ =>
      ((((Nat.primesBelow (x+1)).filter (fun n => outerRule n ∧ ∀ l ∈ s, primeRule l n)).card
      : ℕ) : ℝ) / (Nat.primeCounting x : ℝ)) atTop
      (𝓝 ((1/2:ℝ) * ∏ l ∈ s, (1 - 2 / ((l:ℝ)*((l:ℝ)-1))))) :=
  layer_limit hA (layerMod_pos s hs) (layer_family s hs)

def cutRule (s : Finset ℕ) (n : ℕ) : Prop :=
  3 < n ∧ outerRule n ∧ ∀ l ∈ s, n % l^2 ≠ 1 ∧ n % l^2 ≠ l^2-1

open Classical in
theorem finite_density_cut (hA : HA) (s : Finset ℕ) (hs : ∀ l ∈ s, Nat.Prime l ∧ 2 < l) :
    Tendsto (fun x : ℕ =>
      ((((Nat.primesBelow (x+1)).filter (cutRule s)).card : ℕ) : ℝ) /
        (Nat.primeCounting x : ℝ)) atTop
      (𝓝 ((1/2:ℝ) * ∏ l ∈ s, (1 - 2 / ((l:ℝ)*((l:ℝ)-1))))) := by
  classical
  let K : ℕ := 4 + s.sup id
  let P := fun n : ℕ => outerRule n ∧ ∀ l ∈ s, primeRule l n
  have he (n : ℕ) (hn : n.Prime) (hk : K ≤ n) : P n ↔ cutRule s n := by
    have hk3 : 3 < n := by dsimp [K] at hk; omega
    constructor
    · intro h
      exact ⟨hk3,h.1,fun l hl => (h.2 l hl).2⟩
    · rintro ⟨_,ho,hall⟩
      refine ⟨ho, fun l hl => ⟨?_, hall l hl⟩⟩
      have hlk : l ≤ s.sup id := Finset.le_sup (f := id) hl
      have hne : n ≠ l := by dsimp [K] at hk; omega
      exact (ZMod.coprime_mod_iff_coprime n (l^2)).mpr (((Nat.coprime_primes hn (hs l hl).1).mpr hne).pow_right 2)
  let A := fun x : ℕ => (Nat.primesBelow (x+1)).filter P
  let B := fun x : ℕ => (Nat.primesBelow (x+1)).filter (cutRule s)
  have hcard (x : ℕ) : (A x).card ≤ (B x).card + K ∧ (B x).card ≤ (A x).card + K := by
    have incl (F G : ℕ → Prop) [DecidablePred F] [DecidablePred G]
        (hh : ∀ n, n.Prime → K ≤ n → F n → G n) :
        ((Nat.primesBelow (x+1)).filter F).card ≤
          ((Nat.primesBelow (x+1)).filter G).card + K := by
      have hsub : (Nat.primesBelow (x+1)).filter F ⊆
          (Nat.primesBelow (x+1)).filter G ∪ Finset.range K := by
        intro n h
        obtain ⟨hn,hF⟩ := Finset.mem_filter.mp h
        by_cases hk : K ≤ n
        · exact Finset.mem_union_left _ (Finset.mem_filter.mpr
            ⟨hn,hh n (Nat.mem_primesBelow.mp hn).2 hk hF⟩)
        · exact Finset.mem_union_right _ (Finset.mem_range.mpr (by omega))
      exact (Finset.card_le_card hsub).trans (by simpa using
        (Finset.card_union_le ((Nat.primesBelow (x+1)).filter G) (Finset.range K)))
    exact ⟨incl P (cutRule s) (fun n hn hk => (he n hn hk).mp),
      incl (cutRule s) P (fun n hn hk => (he n hn hk).mpr)⟩
  have hK : Tendsto (fun x : ℕ => (K : ℝ) / (Nat.primeCounting x : ℝ)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_natCast_atTop_atTop.comp Nat.tendsto_primeCounting)
  have hd := finite_density hA s hs
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le (by simpa using hd.sub hK)
    (by simpa using hd.add hK)
  · intro x
    change (↑(A x).card : ℝ) / _ - ↑K / _ ≤ (↑(B x).card : ℝ) / _
    rw [sub_le_iff_le_add, ← add_div]
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    exact_mod_cast (hcard x).1
  · intro x
    change (↑(B x).card : ℝ) / _ ≤ (↑(A x).card : ℝ) / _ + ↑K / _
    rw [← add_div]
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    exact_mod_cast (hcard x).2

def tailClass (x l a : ℕ) : Finset ℕ :=
  (Nat.primesBelow (x+1)).filter fun p => p % l^2 = a % l^2

def tailIndices (D x : ℕ) : Finset ℕ :=
  (Finset.range (x+2)).filter fun l => D < l ∧ l.Prime ∧ l^2 ≤ x+1

def tailRows (D x : ℕ) : Finset ℕ :=
  (tailIndices D x).biUnion fun l => tailClass x l 1 ∪ tailClass x l (l^2-1)

theorem tailClass_card (x l a : ℕ) :
    (tailClass x l a).card ≤ x / l^2 + 1 := by
  have hi : (tailClass x l a).card ≤ (Finset.range (x / l^2 + 1)).card := by
    apply Finset.card_le_card_of_injOn (fun p : ℕ => p / l^2)
    · intro p hp
      have hp' := (Finset.mem_filter.mp hp).1
      have hp'' : p < x+1 := (Nat.mem_primesBelow.mp hp').1
      exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Nat.div_le_div_right (by omega)))
    · intro p hp q hq he
      have hm := (Finset.mem_filter.mp hp).2.trans (Finset.mem_filter.mp hq).2.symm
      have e := Nat.mod_add_div p (l^2)
      change p / l^2 = q / l^2 at he
      rw [hm, he, Nat.mod_add_div] at e
      exact e.symm
  simpa using hi

noncomputable def tailWeight (l : ℕ) : ℝ := 1 / (l:ℝ)^(3/2:ℝ)

theorem tailWeight_nonneg (l : ℕ) : 0 ≤ tailWeight l := by
  unfold tailWeight
  positivity

theorem tailWeight_summable : Summable tailWeight :=
  Real.summable_one_div_nat_rpow.mpr (by norm_num)

theorem tailClass_weight {x l a : ℕ} {C : ℝ} (hx : 2 ≤ x) (hl : l.Prime)
    (hlx : l^2 ≤ x+1) (hC : 0 ≤ C)
    (hb : l^4 ≤ x → (tailClass x l a).card ≤
      C * (x : ℝ) / ((l : ℝ)^2 * Real.log (x : ℝ))) :
    (tailClass x l a).card * (Real.log (x:ℝ) / (x:ℝ)) ≤ (C+32) * tailWeight l := by
  have hxl : (1 : ℝ) < x := by exact_mod_cast (show 1 < x by omega)
  have hx0 : 0 < (x:ℝ) := by linarith
  have hl1 : (1:ℝ) ≤ l := by exact_mod_cast (show 1 ≤ l from hl.pos)
  have hl0 : 0 < (l:ℝ) := by linarith
  have hlog : 0 < Real.log (x:ℝ) := Real.log_pos hxl
  have hscale : 0 ≤ Real.log (x:ℝ) / (x:ℝ) := by positivity
  have hw := tailWeight_nonneg l
  by_cases h : l^4 ≤ x
  · calc
      _ ≤ (C * (x:ℝ) / ((l:ℝ)^2 * Real.log (x:ℝ))) * (Real.log (x:ℝ) / (x:ℝ)) :=
        mul_le_mul_of_nonneg_right (hb h) hscale
      _ = C * (1 / (l:ℝ)^2) := by field_simp
      _ ≤ C * tailWeight l := by
        apply mul_le_mul_of_nonneg_left _ hC
        unfold tailWeight
        apply one_div_le_one_div_of_le (by positivity)
        rw [← Real.rpow_natCast]
        apply Real.rpow_le_rpow_of_exponent_le hl1
        norm_num
      _ ≤ _ := by nlinarith
  · have hlarge : (x : ℝ) ≤ (l : ℝ)^4 := by exact_mod_cast (show x ≤ l^4 by omega)
    have hlogs : Real.log (x:ℝ) ≤ 4 * Real.log (l:ℝ) := by
      simpa [Real.log_pow] using Real.log_le_log hx0 hlarge
    have hlogs' := Real.log_le_rpow_div (x := (l:ℝ)) (ε := (1/2:ℝ)) hl0.le (by norm_num)
    have hlogs'' : Real.log (x:ℝ) ≤ 8 * (l:ℝ) ^ (1/2:ℝ) := by linarith
    have hdiv : ((x / l^2 : ℕ):ℝ) * (l:ℝ)^2 ≤ x := by
      exact_mod_cast Nat.div_mul_le_self x (l^2)
    have hclass : ((tailClass x l a).card : ℝ) ≤ ((x / l^2:ℕ):ℝ) + 1 := by
      exact_mod_cast tailClass_card x l a
    have hlsq : (l:ℝ)^2 ≤ x+1 := by exact_mod_cast hlx
    have hcount : ((tailClass x l a).card : ℝ) ≤ 4 * (x:ℝ) / (l:ℝ)^2 := by
      apply (le_div_iff₀ (by positivity)).2
      have hmul := mul_le_mul_of_nonneg_right hclass (sq_nonneg (l:ℝ))
      nlinarith
    have hsplit : (l:ℝ)^(1/2:ℝ) * (l:ℝ)^(3/2:ℝ) = (l:ℝ)^2 := by
      rw [← Real.rpow_add hl0]
      norm_num
    calc
      _ ≤ (4 * (x:ℝ) / (l:ℝ)^2) * (Real.log (x:ℝ) / (x:ℝ)) :=
        mul_le_mul_of_nonneg_right hcount hscale
      _ = (4 / (l:ℝ)^2) * Real.log (x:ℝ) := by field_simp
      _ ≤ (4 / (l:ℝ)^2) * (8 * (l:ℝ)^(1/2:ℝ)) :=
        mul_le_mul_of_nonneg_left hlogs'' (by positivity)
      _ = 32 * tailWeight l := by
        unfold tailWeight
        field_simp
        nlinarith [hsplit]
      _ ≤ _ := by nlinarith [mul_nonneg hC hw]

theorem tail_coprime_neg (l : ℕ) (hl : l.Prime) : (l^2-1).Coprime l := by
  apply Nat.Coprime.symm
  apply hl.coprime_iff_not_dvd.mpr
  intro hd
  have hs : l ∣ l^2 := dvd_pow_self l (by decide : 2 ≠ 0)
  have hu : l ∣ (l^2-1)+1 := by
    convert hs using 1
    have hp := hl.pos
    have : 0 < l^2 := pow_pos hp _
    omega
  exact hl.not_dvd_one ((Nat.dvd_add_iff_right hd).mpr hu)

noncomputable def tailRemainder (D : ℕ) : ℝ :=
  (∑' l, tailWeight l) - ∑ l ∈ Finset.range D, tailWeight l

theorem tailRemainder_tendsto : Tendsto tailRemainder atTop (𝓝 0) := by
  unfold tailRemainder
  have hh := (tendsto_const_nhds (x := ∑' l, tailWeight l)).sub tailWeight_summable.hasSum.tendsto_sum_nat
  rw [sub_self] at hh
  exact hh

theorem tailRows_weight {x D : ℕ} {C : ℝ} (hx : 2 ≤ x) (hC : 0 ≤ C)
    (hb : ∀ l : ℕ, l.Prime → l^4 ≤ x → ∀ a : ℕ, Nat.Coprime a l →
      (tailClass x l a).card ≤ C*(x:ℝ)/((l:ℝ)^2 * Real.log (x:ℝ))) :
    (tailRows D x).card * (Real.log (x:ℝ)/(x:ℝ)) ≤ 2*(C+32)*tailRemainder D := by
  let s := tailIndices D x
  let u := fun l => tailClass x l 1 ∪ tailClass x l (l^2-1)
  let w := Real.log (x:ℝ) / (x:ℝ)
  have hlog : 0 ≤ Real.log (x:ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ x by omega))
  have hw : 0 ≤ w := div_nonneg hlog (by positivity)
  have hrow : ∀ l ∈ s, ((u l).card : ℝ)*w ≤ 2*(C+32)*tailWeight l := by
    intro l hm
    obtain ⟨_, hl, hlx⟩ := (Finset.mem_filter.mp hm).2
    have ha := tailClass_weight (a := 1) hx hl hlx hC (fun h => hb l hl h 1 (Nat.coprime_one_left _))
    have hbb := tailClass_weight (a := l^2-1) hx hl hlx hC
      (fun h => hb l hl h _ (tail_coprime_neg _ hl))
    have hcard : ((u l).card : ℝ) ≤ (tailClass x l 1).card + ((tailClass x l (l^2-1)).card : ℝ) := by
      exact_mod_cast Finset.card_union_le (tailClass x l 1) (tailClass x l (l^2-1))
    have hc := mul_le_mul_of_nonneg_right hcard hw
    change ((tailClass x l 1).card : ℝ)*w ≤ _ at ha
    change ((tailClass x l (l^2-1)).card : ℝ)*w ≤ _ at hbb
    nlinarith
  have hcard : ((tailRows D x).card : ℝ) ≤ ∑ l ∈ s, ((u l).card : ℝ) := by
    exact_mod_cast (Finset.card_biUnion_le : (s.biUnion u).card ≤ ∑ l ∈ s, (u l).card)
  have hsum : ∑ l ∈ s, tailWeight l ≤ tailRemainder D := by
    apply le_sub_iff_add_le.mpr
    have hd : Disjoint s (Finset.range D) := by
      apply Finset.disjoint_left.mpr
      intro l hl hD
      have h1 := (Finset.mem_filter.mp hl).2.1
      have h2 := Finset.mem_range.mp hD
      omega
    rw [← Finset.sum_union hd]
    exact tailWeight_summable.sum_le_tsum _ (fun l _ => tailWeight_nonneg l)
  calc
    _ ≤ (∑ l ∈ s, ((u l).card : ℝ))*w := mul_le_mul_of_nonneg_right hcard hw
    _ = ∑ l ∈ s, ((u l).card : ℝ)*w := Finset.sum_mul ..
    _ ≤ ∑ l ∈ s, 2*(C+32)*tailWeight l := Finset.sum_le_sum hrow
    _ = 2*(C+32)*(∑ l ∈ s, tailWeight l) := (Finset.mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hsum (by positivity)

theorem tailRows_small (hP : HP) (hB : HB) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ D : ℕ in atTop, ∀ᶠ x : ℕ in atTop,
      ((tailRows D x).card : ℝ) / (Nat.primeCounting x : ℝ) < ε := by
  obtain ⟨C, hc, x₀, hB⟩ := hB
  have hr : Tendsto (fun D => 2*(C+32)*tailRemainder D) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds (x := 2*(C+32))).mul tailRemainder_tendsto
  filter_upwards [hr.eventually_lt_const (show 0 < ε/2 by linarith)] with D hD
  have hp' := (show Tendsto _ _ _ from hP).eventually_const_lt (show (1/2:ℝ) < 1 by norm_num)
  filter_upwards [hp', eventually_ge_atTop x₀, eventually_ge_atTop 2] with x hp h0 hx
  have hpos : (0:ℝ) < x := by exact_mod_cast (show 0 < x by omega)
  have hl : 0 < Real.log (x:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < x by omega))
  let w := Real.log (x:ℝ) / (x:ℝ)
  have hw : 0 < w := div_pos hl hpos
  change (1/2:ℝ) < (Nat.primeCounting x : ℝ) * Real.log (x:ℝ) / (x:ℝ) at hp
  rw [mul_div_assoc] at hp
  change (1/2:ℝ) < (Nat.primeCounting x : ℝ) * w at hp
  have hpi : 0 < (Nat.primeCounting x : ℝ) :=
    pos_of_mul_pos_left (lt_trans (by norm_num : (0:ℝ)<1/2) hp) hw.le
  have ht := tailRows_weight (D:=D) hx hc.le (hB x h0)
  apply (div_lt_iff₀ hpi).mpr
  apply (mul_lt_mul_iff_left₀ hw).mp
  calc
    _ ≤ 2 * (C+32) * tailRemainder D := ht
    _ < ε / 2 := hD
    _ < ε * (Nat.primeCounting x : ℝ) * w := by
      simpa [mul_assoc, div_eq_mul_inv] using mul_lt_mul_of_pos_left hp hε

def oddPrimesThrough (D : ℕ) : Finset ℕ :=
  ((D + 1).primesBelow).filter (2 < ·)

noncomputable def localDensity (D : ℕ) : ℝ :=
  (1 / 2 : ℝ) * ∏ p ∈ oddPrimesThrough D,
    (1 - 2 / ((p : ℝ) * ((p : ℝ) - 1)))

theorem local_factor_identity {u : ℝ} (hu : 1 < u) :
    (1 - 1 / (u - 1) ^ 2) * (1 - 1 / u ^ 2) = 1 - 2 / (u * (u - 1)) := by
  have h₁ : u - 1 ≠ 0 := by linarith
  have h₂ : u ≠ 0 := by linarith
  field_simp
  ring

theorem twin_factor_multipliable :
    Multipliable (fun p : {n : ℕ // n.Prime ∧ 2 < n} =>
      1 - 1 / ((p.val : ℝ) - 1) ^ 2) := by
  let f : {n : ℕ // n.Prime ∧ 2 < n} → ℕ := fun p => p.val - 1
  have hf : Function.Injective f := by
    intro p q h
    apply Subtype.ext
    have hp := p.property.2
    have hq := q.property.2
    change p.val - 1 = q.val - 1 at h
    omega
  have hs := (Real.summable_one_div_nat_pow.mpr (by decide : 1 < 2)).comp_injective hf
  apply (Real.multipliable_one_add_of_summable hs.neg).congr
  intro p
  have hpos : 1 ≤ p.val := by have := p.property.2; omega
  simp [f, Nat.cast_sub hpos, sub_eq_add_neg]

theorem twin_factor_limit :
    Tendsto (fun D : ℕ => ∏ p ∈ oddPrimesThrough D, (1 - 1 / ((p : ℝ) - 1) ^ 2))
      atTop (𝓝 OMA.S_oeis_a269844.twinPrimeConstant) := by
  classical
  let s : Set ℕ := {p | p.Prime ∧ 2 < p}
  let f : ℕ → ℝ := fun p => 1 - 1 / ((p : ℝ) - 1) ^ 2
  have h : HasProd (f ∘ ((↑) : s → ℕ)) OMA.S_oeis_a269844.twinPrimeConstant :=
    twin_factor_multipliable.hasProd
  have hh := (hasProd_subtype_iff_mulIndicator.mp h).tendsto_prod_nat.comp
    (show Tendsto (fun n : ℕ => n + 1) atTop atTop from tendsto_atTop.2 fun b => (eventually_ge_atTop b).mono fun n hn => by omega)
  convert hh using 1
  funext D
  change (∏ p ∈ oddPrimesThrough D, f p) = ∏ p ∈ Finset.range (D+1), s.mulIndicator f p
  simp [oddPrimesThrough, Nat.primesBelow, Finset.filter_filter, Finset.prod_filter,
    s, Set.mulIndicator]
  apply Finset.prod_congr rfl
  intro p hp
  by_cases hmem : p.Prime ∧ 2 < p <;> simp [hmem]

theorem euler_square_factor_limit :
    Tendsto (fun D : ℕ => ∏ p ∈ (D+1).primesBelow, (1 - 1 / (p : ℝ)^2))
      atTop (𝓝 (6 / Real.pi^2)) := by
  have he := riemannZeta_eulerProduct (s := (2:ℂ)) (by norm_num)
  rw [riemannZeta_two] at he
  have h₀ : (Real.pi : ℂ)^2 / 6 ≠ 0 := by exact div_ne_zero (pow_ne_zero _ (by exact_mod_cast Real.pi_ne_zero)) (by norm_num)
  have hi := (he.inv₀ h₀).comp (show Tendsto (fun n : ℕ => n + 1) atTop atTop from tendsto_atTop.2 fun b => (eventually_ge_atTop b).mono fun n hn => by omega)
  apply tendsto_ofReal_iff.mp
  simpa [Function.comp_def, Complex.cpow_neg, Complex.cpow_two, Finset.prod_inv_distrib,
    Complex.ofReal_prod, one_div, inv_div] using hi

theorem odd_square_factor_limit :
    Tendsto (fun D : ℕ => ∏ p ∈ oddPrimesThrough D, (1 - 1 / (p : ℝ)^2))
      atTop (𝓝 (8 / Real.pi^2)) := by
  classical
  have h := euler_square_factor_limit.const_mul (4 / 3 : ℝ)
  rw [show 8 / Real.pi^2 = (4/3:ℝ) * (6 / Real.pi^2) by ring]
  apply h.congr'
  filter_upwards [eventually_ge_atTop 2] with D hD
  have hmem : 2 ∈ (D + 1).primesBelow := Nat.mem_primesBelow.mpr ⟨by omega, Nat.prime_two⟩
  have hset : oddPrimesThrough D = ((D + 1).primesBelow).erase 2 := by
    ext p
    simp only [oddPrimesThrough, Finset.mem_erase, Finset.mem_filter]
    constructor
    · rintro ⟨hp,hl⟩
      exact ⟨by omega, hp⟩
    · rintro ⟨hn,hp⟩
      exact ⟨hp, lt_of_le_of_ne (Nat.two_le_of_mem_primesBelow hp) hn.symm⟩
  rw [hset, ← Finset.mul_prod_erase _ _ hmem]
  norm_num
  ring

theorem localDensity_limit :
    Tendsto localDensity atTop (𝓝 (4 * OMA.S_oeis_a269844.twinPrimeConstant / Real.pi^2)) := by
  have h := (twin_factor_limit.mul odd_square_factor_limit).const_mul (1/2:ℝ)
  convert h using 1
  · funext D
    dsimp only [localDensity]
    rw [← Finset.prod_mul_distrib]
    congr 1
    apply Finset.prod_congr rfl
    intro p hp
    apply (local_factor_identity _).symm
    have := (Finset.mem_filter.mp hp).2
    exact_mod_cast (show 1 < p by omega)
  · congr 1
    ring


theorem residue_pair {l k : ℕ} (hl : l.Prime) (hodd : 2 < l) :
    ((2*k+1) % l^2 = 1 ↔ l^2 ∣ k) ∧
    ((2*k+1) % l^2 = l^2-1 ↔ l^2 ∣ k+1) := by
  have hq : 1 < l^2 := by nlinarith
  have hc : Nat.Coprime (l^2) 2 :=
    ((Nat.coprime_primes hl Nat.prime_two).2 (by omega)).pow_left 2
  have hp : (2*k+1) % l^2 = 1 ↔ (2*k+1) ≡ 1 [MOD l^2] := by
    simp [Nat.ModEq, Nat.mod_eq_of_lt hq]
  have hm : (2*k+1) % l^2 = l^2-1 ↔ (2*k+1) ≡ l^2-1 [MOD l^2] := by
    simp [Nat.ModEq, Nat.mod_eq_of_lt (show l^2-1 < l^2 by omega)]
  rw [hp, hm, Nat.add_modEq_right_iff, hc.dvd_mul_left]
  refine ⟨Iff.rfl, ?_⟩
  have Hz : l^2-1+1 ≡ 0 [MOD l^2] := by
    rw [show l^2-1+1 = l^2 by omega]
    exact Nat.modulus_modEq_zero
  have He : 2*k+1+1 = 2*(k+1) := by omega
  constructor
  · intro h
    have := (h.add_right 1).trans Hz
    rwa [He, Nat.modEq_zero_iff_dvd, hc.dvd_mul_left] at this
  · intro h
    have hz : 2*k+1+1 ≡ 0 [MOD l^2] := by
      rwa [He, Nat.modEq_zero_iff_dvd, hc.dvd_mul_left]
    exact Nat.ModEq.add_right_cancel' 1 (hz.trans Hz.symm)

theorem squarefree_pair_iff (k : ℕ) :
    Squarefree k ∧ Squarefree (k+1) ↔
    ((2*k+1)%8 = 3 ∨ (2*k+1)%8 = 5) ∧
    ∀ l : ℕ, l.Prime → 2 < l →
      (2*k+1)%l^2 ≠ 1 ∧ (2*k+1)%l^2 ≠ l^2-1 := by
  rw [Nat.squarefree_iff_prime_squarefree, Nat.squarefree_iff_prime_squarefree]
  constructor
  · rintro ⟨hk, hk'⟩
    have h₀ := hk 2 Nat.prime_two
    have h₁ := hk' 2 Nat.prime_two
    refine ⟨by omega, fun l hl ho => ?_⟩
    obtain ⟨hr,hs⟩ := residue_pair (k := k) hl ho
    exact And.intro
      (fun h => hk l hl (by simpa [pow_two] using hr.mp h))
      (fun h => hk' l hl (by simpa [pow_two] using hs.mp h))
  · rintro ⟨hm, h⟩
    constructor
    · intro l hl
      by_cases he : l = 2
      · subst l; omega
      have ho : 2 < l := lt_of_le_of_ne hl.two_le (Ne.symm he)
      simpa [pow_two] using (mt (residue_pair (k := k) hl ho).1.mpr (h l hl ho).1)
    · intro l hl
      by_cases he : l = 2
      · subst l; omega
      have ho : 2 < l := lt_of_le_of_ne hl.two_le (Ne.symm he)
      simpa [pow_two] using (mt (residue_pair (k := k) hl ho).2.mpr (h l hl ho).2)

theorem local_characterization {p : ℕ} (hp : p.Prime) (hp' : 3 < p) :
    (∃ k : ℕ, p = k + (k+1) ∧ Squarefree k ∧ Squarefree (k+1)) ↔
    (p%8 = 3 ∨ p%8 = 5) ∧
    ∀ l : ℕ, l.Prime → 2 < l → p%l^2 ≠ 1 ∧ p%l^2 ≠ l^2-1 := by
  constructor
  · rintro ⟨k, he, h⟩
    rw [show p = 2*k+1 by omega]
    exact (squarefree_pair_iff k).mp h
  · intro h
    have hodd := hp.eq_two_or_odd
    have he : p = 2*(p/2)+1 := by omega
    refine ⟨p/2, by omega, (squarefree_pair_iff _).mpr ?_⟩
    simpa only [← he] using h

theorem density_of_approximation {f : ℕ → ℝ} {g : ℕ → ℕ → ℝ} {c : ℕ → ℝ} {L : ℝ}
    (hfinite : ∀ D, Tendsto (g D) atTop (𝓝 (c D)))
    (hconstant : Tendsto c atTop (𝓝 L))
    (herr : ∀ ε : ℝ, 0 < ε → ∀ᶠ D in atTop, ∀ᶠ x in atTop, |f x - g D x| < ε) :
    Tendsto f atTop (𝓝 L) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨D, hD, he⟩ := ((Metric.tendsto_nhds.mp hconstant (ε/3) (by linarith)).and
    (herr (ε/3) (by linarith))).exists
  filter_upwards [Metric.tendsto_nhds.mp (hfinite D) (ε/3) (by linarith), he] with x hx hx'
  rw [Real.dist_eq] at hD hx ⊢
  rw [abs_lt] at hD hx hx' ⊢
  constructor <;> linarith [hD.1,hD.2,hx.1,hx.2,hx'.1,hx'.2]

open Classical in
noncomputable def termRows (x : ℕ) : Finset ℕ :=
  (Nat.primesBelow (x+1)).filter fun p =>
    3 < p ∧ ∃ k : ℕ, p = k + (k+1) ∧ Squarefree k ∧ Squarefree (k+1)

open Classical in
noncomputable def cutRows (D x : ℕ) : Finset ℕ :=
  (Nat.primesBelow (x+1)).filter (cutRule (oddPrimesThrough D))

theorem oddThrough_iff {D l : ℕ} :
    l ∈ oddPrimesThrough D ↔ l.Prime ∧ 2 < l ∧ l ≤ D := by
  simp only [oddPrimesThrough, Finset.mem_filter, Nat.mem_primesBelow]
  constructor
  · rintro ⟨⟨h₁,h₂⟩,h₃⟩
    exact ⟨h₂,h₃,by omega⟩
  · rintro ⟨h₁,h₂,h₃⟩
    exact ⟨⟨by omega,h₁⟩,h₂⟩

theorem termRows_subset (D x : ℕ) : termRows x ⊆ cutRows D x := by
  classical
  intro p hp
  obtain ⟨hpx, hp', hterm⟩ := Finset.mem_filter.mp hp
  obtain ⟨ho, hl⟩ := (local_characterization (Nat.prime_of_mem_primesBelow hpx) hp').mp hterm
  exact Finset.mem_filter.mpr ⟨hpx, hp', ho, fun l hm =>
    hl l (oddThrough_iff.mp hm).1 (oddThrough_iff.mp hm).2.1⟩

theorem cutRows_subset (D x : ℕ) : cutRows D x ⊆ termRows x ∪ tailRows D x := by
  classical
  intro p hp
  obtain ⟨hpx, hp', ho, hfinite⟩ := Finset.mem_filter.mp hp
  by_cases ht : p ∈ termRows x
  · exact Finset.mem_union_left _ ht
  apply Finset.mem_union_right
  have hall : ¬ ∀ l : ℕ, l.Prime → 2 < l → p%l^2 ≠ 1 ∧ p%l^2 ≠ l^2-1 := by
    intro h
    exact ht (Finset.mem_filter.mpr ⟨hpx, hp',
      (local_characterization (Nat.prime_of_mem_primesBelow hpx) hp').mpr ⟨ho,h⟩⟩)
  push Not at hall
  obtain ⟨l, hl, hl', hbad⟩ := hall
  have hres : p%l^2 = 1 ∨ p%l^2 = l^2-1 := by tauto
  have hD : D < l := by
    by_contra! h
    have := hfinite l (oddThrough_iff.mpr ⟨hl,hl',h⟩)
    tauto
  have hpx' := Nat.lt_of_mem_primesBelow hpx
  have hq : l^2 ≤ x+1 := by
    by_contra! hn
    rw [Nat.mod_eq_of_lt (show p < l^2 by omega)] at hres
    omega
  have hq' : 1 < l^2 := by nlinarith
  apply Finset.mem_biUnion.mpr
  refine ⟨l, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by nlinarith), hD, hl, hq⟩, ?_⟩
  rcases hres with h | h
  · exact Finset.mem_union_left _ (Finset.mem_filter.mpr
      ⟨hpx, h.trans (Nat.mod_eq_of_lt hq').symm⟩)
  · exact Finset.mem_union_right _ (Finset.mem_filter.mpr
      ⟨hpx, h.trans (Nat.mod_eq_of_lt (show l^2-1 < l^2 by omega)).symm⟩)

theorem density_error (D x : ℕ) :
    |(OMA.S_oeis_a269844.count x : ℝ) / (Nat.primeCounting x : ℝ) -
      ((cutRows D x).card : ℝ) / (Nat.primeCounting x : ℝ)| ≤
    ((tailRows D x).card : ℝ) / (Nat.primeCounting x : ℝ) := by
  have hlow := Finset.card_le_card (termRows_subset D x)
  have hhigh := (Finset.card_le_card (cutRows_subset D x)).trans
    (Finset.card_union_le (termRows x) (tailRows D x))
  change |((termRows x).card : ℝ) / _ - _| ≤ _
  have hdiv : ((termRows x).card : ℝ) / (Nat.primeCounting x : ℝ) ≤
      ((cutRows D x).card : ℝ) / (Nat.primeCounting x : ℝ) :=
    div_le_div_of_nonneg_right (by exact_mod_cast hlow) (Nat.cast_nonneg _)
  rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr hdiv), sub_le_iff_le_add, ← add_div]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact_mod_cast (show (cutRows D x).card ≤ (tailRows D x).card + (termRows x).card by omega)

end MirC

open MirC

theorem main_of (hA : HA) (hP : HP) (hB : HB) : type_of% @OMA.S_oeis_a269844.main := by
  classical
  apply density_of_approximation (c := localDensity)
    (g := fun D x => ((cutRows D x).card : ℝ) / (Nat.primeCounting x : ℝ))
  · intro D
    exact finite_density_cut hA (oddPrimesThrough D)
      (fun l hl => ⟨(oddThrough_iff.mp hl).1, (oddThrough_iff.mp hl).2.1⟩)
  · exact localDensity_limit
  · intro ε hε
    filter_upwards [tailRows_small hP hB hε] with D hD
    filter_upwards [hD] with x hx
    exact (density_error D x).trans_lt hx

end A269844

theorem OMA.solution : type_of% @OMA.S_oeis_a269844.main :=
  A269844.main_of (fun _ _ hq ha => A269844.pnt_ap_ratio hq ha) A269844.pnt_log
    A269844.bt_prime_square
