/-- Absorb the two interval-sieve errors with the uniform choice of level X^(1/4). -/
theorem interval_bound_to_log_bound (X L N : ℝ) (hX : 1 < X) (hL : 0 < L)
    (hLX : L ^ 4 ≤ X)
    (hs : ∀ z : ℝ, 1 < z →
      N ≤ 4 * (X / L ^ 2) / Real.log z + 11 * z * (1 + Real.log z) ^ 3) :
    N ≤ (16 + 1056 * Real.exp 1) * X / (L ^ 2 * Real.log X) := by
  let t := Real.log X / 4
  let z := Real.exp t
  have hlog := Real.log_pos hX
  have ht : 0 < t := by dsimp [t]; positivity
  have hz : 1 < z := Real.one_lt_exp_iff.mpr ht
  have hz0 : 0 ≤ z := by linarith
  have hz4 : z ^ 4 = X := by
    rw [show z ^ 4 = Real.exp (4 * t) by exact (Real.exp_nat_mul t 4).symm]
    rw [show 4 * t = Real.log X by dsimp [t]; ring]
    exact Real.exp_log (by linarith)
  have hLz : L ^ 2 ≤ z ^ 2 := by
    by_contra! h
    have hh : (z ^ 2) ^ 2 < (L ^ 2) ^ 2 := by gcongr
    nlinarith only [hh, hz4, hLX]
  have hm : z ^ 2 ≤ X / L ^ 2 := by
    apply (le_div_iff₀ (by positivity)).2
    calc
      z ^ 2 * L ^ 2 ≤ z ^ 2 * z ^ 2 := by gcongr
      _ = X := by nlinarith only [hz4]
  have hp := Real.pow_div_factorial_le_exp (1 + t) (show 0 ≤ 1 + t by linarith) 4
  rw [Real.exp_add] at hp
  norm_num [Nat.factorial] at hp
  have ht4 : (1 + t) ^ 3 * t ≤ (1 + t) ^ 4 := by
    calc
      _ ≤ (1 + t) ^ 3 * (1 + t) := by
        gcongr
        linarith
      _ = _ := by ring
  have he : z * ((1 + t) ^ 3 * t) ≤ (24 * Real.exp 1) * (X / L ^ 2) := by
    calc
      _ ≤ z * (24 * (Real.exp 1 * z)) := by
        apply mul_le_mul_of_nonneg_left _ hz0
        dsimp [z]
        linarith only [hp, ht4]
      _ = (24 * Real.exp 1) * z ^ 2 := by ring
      _ ≤ _ := by gcongr
  specialize hs z hz
  rw [show Real.log z = t from Real.log_exp t] at hs
  have hNt := mul_le_mul_of_nonneg_right hs ht.le
  rw [add_mul, div_mul_cancel₀ _ ht.ne'] at hNt
  calc
    N ≤ (4 + 264 * Real.exp 1) * (X / L ^ 2) / t := by
      apply (le_div_iff₀ ht).2
      linarith only [hNt, he]
    _ = _ := by
      dsimp [t]
      field_simp
      ring

