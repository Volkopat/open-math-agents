-- Credit: @nnkostov

namespace CarterKellerSL3

open Filter Matrix

section ElementaryMatrices

variable {S : Type*} [CommRing S]

/- Typed 3x3 transvection matrix so Fin 3 indices never default to ℕ. -/
abbrev tvM (i j : Fin 3) (c : S) : Matrix (Fin 3) (Fin 3) S :=
  Matrix.transvection i j c

/- Elementary transvection as an element of `SL(3, S)`. -/
def tv (i j : Fin 3) (h : i ≠ j) (c : S) : SpecialLinearGroup (Fin 3) S :=
  ⟨tvM i j c, Matrix.det_transvection_of_ne i j h c⟩

@[simp]
lemma tv_coe (i j : Fin 3) (h : i ≠ j) (c : S) :
    ((tv i j h c : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) = tvM i j c := rfl

lemma tv_zero (i j : Fin 3) (h : i ≠ j) : tv i j h (0 : S) = 1 := by
  ext a b
  simp [tv, tvM]

lemma tv_mul (i j : Fin 3) (h : i ≠ j) (a b : S) :
    tv i j h a * tv i j h b = tv i j h (a + b) := by
  apply Subtype.ext
  change tvM i j a * tvM i j b = tvM i j (a + b)
  exact Matrix.transvection_mul_transvection_same i j h a b

lemma tv_inv (i j : Fin 3) (h : i ≠ j) (c : S) :
    (tv i j h c)⁻¹ = tv i j h (-c) := by
  apply inv_eq_of_mul_eq_one_right
  rw [tv_mul, add_neg_cancel, tv_zero]

/- The elementary subgroup `E_3(S) ≤ SL(3, S)` generated by transvections. -/
def E3 (S : Type*) [CommRing S] : Subgroup (SpecialLinearGroup (Fin 3) S) :=
  Subgroup.closure { g | ∃ (i j : Fin 3) (h : i ≠ j) (c : S), g = tv i j h c }

lemma tv_mem_E3 (i j : Fin 3) (h : i ≠ j) (c : S) : tv i j h c ∈ E3 S :=
  Subgroup.subset_closure ⟨i, j, h, c, rfl⟩

lemma list_prod_transvection_mem_E3 (l : List (Fin 3 × Fin 3 × S))
    (hne : ∀ e ∈ l, e.1 ≠ e.2.1) (g : SpecialLinearGroup (Fin 3) S)
    (hg : (g : Matrix (Fin 3) (Fin 3) S) =
      (l.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod) :
    g ∈ E3 S := by
  induction l generalizing g with
  | nil =>
    have hg1 : g = 1 := by
      apply Subtype.ext
      simpa using hg
    rw [hg1]
    exact Subgroup.one_mem _
  | cons e t ih =>
    have he : e.1 ≠ e.2.1 := hne e (by simp)
    have ht : ∀ x ∈ t, x.1 ≠ x.2.1 := fun x hx => hne x (by simp [hx])
    let T : SpecialLinearGroup (Fin 3) S := (tv e.1 e.2.1 he e.2.2)⁻¹ * g
    have hT : (T : Matrix (Fin 3) (Fin 3) S) =
        (t.map fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod := by
      have hinv : ((tv e.1 e.2.1 he e.2.2)⁻¹ : SpecialLinearGroup (Fin 3) S).1 *
          (tv e.1 e.2.1 he e.2.2).1 = 1 := by
        change (((tv e.1 e.2.1 he e.2.2)⁻¹ * tv e.1 e.2.1 he e.2.2 :
          SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) = 1
        rw [inv_mul_cancel]
        rfl
      calc (T : Matrix (Fin 3) (Fin 3) S)
          = ((tv e.1 e.2.1 he e.2.2)⁻¹ : SpecialLinearGroup (Fin 3) S).1 *
              (g : Matrix (Fin 3) (Fin 3) S) := rfl
        _ = ((tv e.1 e.2.1 he e.2.2)⁻¹ : SpecialLinearGroup (Fin 3) S).1 *
              ((tv e.1 e.2.1 he e.2.2).1 *
                (t.map fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod) := by
              rw [hg, List.map_cons, List.prod_cons, tv_coe]
        _ = (t.map fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod := by
              rw [← Matrix.mul_assoc, hinv, Matrix.one_mul]
    have hg_eq : g = tv e.1 e.2.1 he e.2.2 * T := by simp [T]
    rw [hg_eq]
    exact Subgroup.mul_mem _ (tv_mem_E3 e.1 e.2.1 he e.2.2) (ih ht T hT)

lemma transvection_list_inv (l : List (Fin 3 × Fin 3 × S)) (hne : ∀ e ∈ l, e.1 ≠ e.2.1) :
    ((l.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod) *
      (((l.reverse.map fun e => (e.1, e.2.1, -e.2.2)).map
        fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod) = 1 := by
  induction l with
  | nil => simp
  | cons e t ih =>
    have he : e.1 ≠ e.2.1 := hne e (by simp)
    have ht : ∀ x ∈ t, x.1 ≠ x.2.1 := fun x hx => hne x (by simp [hx])
    simp only [List.map_cons, List.prod_cons, List.reverse_cons, List.map_append,
      List.prod_append, List.map_nil, List.prod_nil, mul_one]
    calc Matrix.transvection e.1 e.2.1 e.2.2 *
          (t.map fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod *
          (((t.reverse.map fun x => (x.1, x.2.1, -x.2.2)).map
            fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod *
            Matrix.transvection e.1 e.2.1 (-e.2.2))
        = Matrix.transvection e.1 e.2.1 e.2.2 *
            ((t.map fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod *
              ((t.reverse.map fun x => (x.1, x.2.1, -x.2.2)).map
                fun x => Matrix.transvection x.1 x.2.1 x.2.2).prod) *
            Matrix.transvection e.1 e.2.1 (-e.2.2) := by
          simp only [Matrix.mul_assoc]
      _ = Matrix.transvection e.1 e.2.1 e.2.2 * 1 * Matrix.transvection e.1 e.2.1 (-e.2.2) := by
          rw [ih ht]
      _ = Matrix.transvection e.1 e.2.1 e.2.2 * Matrix.transvection e.1 e.2.1 (-e.2.2) := by
          rw [Matrix.mul_one]
      _ = 1 := by
          rw [Matrix.transvection_mul_transvection_same e.1 e.2.1 he, add_neg_cancel,
            Matrix.transvection_zero]

lemma mem_E3_iff_list (g : SpecialLinearGroup (Fin 3) S) :
    g ∈ E3 S ↔ ∃ l : List (Fin 3 × Fin 3 × S),
      (∀ e ∈ l, e.1 ≠ e.2.1) ∧
      (g : Matrix (Fin 3) (Fin 3) S) =
        (l.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod := by
  constructor
  · intro hg
    refine Subgroup.closure_induction
      (p := fun (x : SpecialLinearGroup (Fin 3) S) _ => ∃ l : List (Fin 3 × Fin 3 × S),
        (∀ e ∈ l, e.1 ≠ e.2.1) ∧
        (x : Matrix (Fin 3) (Fin 3) S) =
          (l.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod)
      ?_ ?_ ?_ ?_ hg
    · rintro _ ⟨i, j, hij, c, rfl⟩
      exact ⟨[(i, j, c)], by simp [hij], by simp [tv, tvM]⟩
    · exact ⟨[], by simp, by rfl⟩
    · rintro x y _ _ ⟨l₁, h₁, hx⟩ ⟨l₂, h₂, hy⟩
      refine ⟨l₁ ++ l₂, ?_, ?_⟩
      · intro e he
        rcases List.mem_append.mp he with h | h
        · exact h₁ e h
        · exact h₂ e h
      · change (x : Matrix (Fin 3) (Fin 3) S) * (y : Matrix (Fin 3) (Fin 3) S) = _
        rw [hx, hy, List.map_append, List.prod_append]
    · rintro x _ ⟨l, hl, hx⟩
      let l' := l.reverse.map fun e => (e.1, e.2.1, -e.2.2)
      refine ⟨l', ?_, ?_⟩
      · intro e he
        rcases List.mem_map.mp he with ⟨e₀, he₀, rfl⟩
        exact hl e₀ (List.mem_reverse.mp he₀)
      · have hprod : (x : Matrix (Fin 3) (Fin 3) S) *
            (l'.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod = 1 := by
          rw [hx]
          exact transvection_list_inv l hl
        have hleft : ((x⁻¹ : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) *
            (x : Matrix (Fin 3) (Fin 3) S) = 1 := by
          change ((x⁻¹ * x : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) = 1
          rw [inv_mul_cancel]
          rfl
        calc ((x⁻¹ : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S)
            = ((x⁻¹ : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) * 1 :=
              (Matrix.mul_one _).symm
          _ = ((x⁻¹ : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) *
                ((x : Matrix (Fin 3) (Fin 3) S) *
                  (l'.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod) := by
              rw [hprod]
          _ = (((x⁻¹ : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) *
                (x : Matrix (Fin 3) (Fin 3) S)) *
                (l'.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod := by
              rw [Matrix.mul_assoc]
          _ = (l'.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod := by
              rw [hleft, Matrix.one_mul]
  · rintro ⟨l, hne, hg⟩
    exact list_prod_transvection_mem_E3 l hne g hg

/- Helper to build an element of `SL(2, S)` from four entries. -/
def mkSL2 (a b c d : S) (h : a * d - b * c = 1) : SpecialLinearGroup (Fin 2) S :=
  ⟨!![a, b; c, d], by simpa [Matrix.det_fin_two] using h⟩

@[simp] lemma mkSL2_00 (a b c d : S) (h : a * d - b * c = 1) :
    ((mkSL2 a b c d h : SpecialLinearGroup (Fin 2) S) : Matrix (Fin 2) (Fin 2) S) 0 0 = a := rfl
@[simp] lemma mkSL2_01 (a b c d : S) (h : a * d - b * c = 1) :
    ((mkSL2 a b c d h : SpecialLinearGroup (Fin 2) S) : Matrix (Fin 2) (Fin 2) S) 0 1 = b := rfl
@[simp] lemma mkSL2_10 (a b c d : S) (h : a * d - b * c = 1) :
    ((mkSL2 a b c d h : SpecialLinearGroup (Fin 2) S) : Matrix (Fin 2) (Fin 2) S) 1 0 = c := rfl
@[simp] lemma mkSL2_11 (a b c d : S) (h : a * d - b * c = 1) :
    ((mkSL2 a b c d h : SpecialLinearGroup (Fin 2) S) : Matrix (Fin 2) (Fin 2) S) 1 1 = d := rfl

lemma sl2_det_eq (M : SpecialLinearGroup (Fin 2) S) :
    (M : Matrix (Fin 2) (Fin 2) S) 0 0 * (M : Matrix (Fin 2) (Fin 2) S) 1 1 -
      (M : Matrix (Fin 2) (Fin 2) S) 0 1 * (M : Matrix (Fin 2) (Fin 2) S) 1 0 = 1 := by
  have h := M.2
  rwa [Matrix.det_fin_two] at h

/- Upper-left block embedding `ι : SL(2, S) →* SL(3, S)`. -/
def iotaMat (M : Matrix (Fin 2) (Fin 2) S) : Matrix (Fin 3) (Fin 3) S :=
  !![M 0 0, M 0 1, 0;
     M 1 0, M 1 1, 0;
     0,     0,     1]

lemma det_iotaMat (M : Matrix (Fin 2) (Fin 2) S) : (iotaMat M).det = M.det := by
  rw [Matrix.det_fin_three, Matrix.det_fin_two]
  simp only [iotaMat, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.cons_val_fin_one, Matrix.cons_val]
  ring

def iota : SpecialLinearGroup (Fin 2) S →* SpecialLinearGroup (Fin 3) S where
  toFun M := ⟨iotaMat M.1, by rw [det_iotaMat, M.2]⟩
  map_one' := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  map_mul' A B := by
    ext i j
    change iotaMat (A.1 * B.1) i j = (iotaMat A.1 * iotaMat B.1) i j
    rw [Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;>
      simp [iotaMat, Matrix.mul_apply, Fin.sum_univ_two]

@[simp]
lemma iota_val (M : SpecialLinearGroup (Fin 2) S) : (iota M).1 = iotaMat M.1 := rfl

lemma iota_tv01 (c : S) :
    iota (mkSL2 1 c 0 1 (by ring)) = tv 0 1 (by decide) c := by
  ext i j
  change iotaMat !![1, c; 0, 1] i j = tvM 0 1 c i j
  rw [tvM, Matrix.transvection]
  fin_cases i <;> fin_cases j <;> simp [iotaMat]

lemma iota_tv10 (c : S) :
    iota (mkSL2 1 0 c 1 (by ring)) = tv 1 0 (by decide) c := by
  ext i j
  change iotaMat !![1, 0; c, 1] i j = tvM 1 0 c i j
  rw [tvM, Matrix.transvection]
  fin_cases i <;> fin_cases j <;> simp [iotaMat]

/- Signed transposition `S01 = !![0, 1, 0; -1, 0, 0; 0, 0, 1] ∈ E3 S`. -/
def S01 : SpecialLinearGroup (Fin 3) S :=
  tv 0 1 (by decide) 1 * tv 1 0 (by decide) (-1) * tv 0 1 (by decide) 1

lemma S01_mem_E3 : (S01 : SpecialLinearGroup (Fin 3) S) ∈ E3 S :=
  Subgroup.mul_mem _ (Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)) (tv_mem_E3 _ _ _ _)

lemma S01_eq_iota :
    (S01 : SpecialLinearGroup (Fin 3) S) = iota (mkSL2 0 1 (-1) 0 (by ring)) := by
  ext i j
  change ((tvM 0 1 (1 : S) * tvM 1 0 (-1 : S)) * tvM 0 1 (1 : S)) i j = iotaMat !![0, 1; -1, 0] i j
  simp only [tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;> simp [iotaMat]

/- Signed transposition `S12 = !![1, 0, 0; 0, 0, 1; 0, -1, 0] ∈ E3 S`. -/
def S12 : SpecialLinearGroup (Fin 3) S :=
  tv 1 2 (by decide) 1 * tv 2 1 (by decide) (-1) * tv 1 2 (by decide) 1

lemma S12_mem_E3 : (S12 : SpecialLinearGroup (Fin 3) S) ∈ E3 S :=
  Subgroup.mul_mem _ (Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)) (tv_mem_E3 _ _ _ _)

lemma S12_val :
    ((S12 : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) =
      !![1, 0, 0; 0, 0, 1; 0, -1, 0] := by
  ext i j
  change ((tvM 1 2 (1 : S) * tvM 2 1 (-1 : S)) * tvM 1 2 (1 : S)) i j = _
  simp only [tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;> simp

lemma S12_inv_val :
    (((S12 : SpecialLinearGroup (Fin 3) S)⁻¹ : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) =
      !![1, 0, 0; 0, 0, -1; 0, 1, 0] := by
  let Q : SpecialLinearGroup (Fin 3) S := ⟨!![1, 0, 0; 0, 0, -1; 0, 1, 0], by
    rw [Matrix.det_fin_three]; simp⟩
  have h : (S12 : SpecialLinearGroup (Fin 3) S)⁻¹ = Q := by
    apply inv_eq_of_mul_eq_one_right
    ext i j
    change ((S12 : SpecialLinearGroup (Fin 3) S).1 * Q.1) i j = (1 : Matrix (Fin 3) (Fin 3) S) i j
    rw [S12_val]
    simp only [Q, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp
  rw [h]

/- Stable range condition `SR2` for a commutative ring `S`. -/
def HasSR2 (S : Type*) [CommRing S] : Prop :=
  ∀ a b c : S, (∃ u v w : S, u * a + v * b + w * c = 1) → b ≠ 0 →
    ∃ t : S, IsCoprime (a + t * c) b

lemma sr2_reduction (hSR2 : HasSR2 S) (A : SpecialLinearGroup (Fin 3) S) :
    ∃ L R : SpecialLinearGroup (Fin 3) S, L ∈ E3 S ∧ R ∈ E3 S ∧
      ∃ M : SpecialLinearGroup (Fin 2) S, A = L * iota M * R := by
  have hunim : ∃ u v w : S, u * A.1 0 2 + v * A.1 1 2 + w * A.1 2 2 = 1 := by
    have hmul : (A⁻¹ : SpecialLinearGroup (Fin 3) S).1 * A.1 = 1 := by
      change ((A⁻¹ * A : SpecialLinearGroup (Fin 3) S) : Matrix (Fin 3) (Fin 3) S) = 1
      rw [inv_mul_cancel]; rfl
    have h22 := congrFun (congrFun hmul 2) 2
    rw [Matrix.mul_apply, Fin.sum_univ_three] at h22
    exact ⟨(A⁻¹ : SpecialLinearGroup (Fin 3) S).1 2 0,
      (A⁻¹ : SpecialLinearGroup (Fin 3) S).1 2 1,
      (A⁻¹ : SpecialLinearGroup (Fin 3) S).1 2 2, by simpa using h22⟩
  have hstep1 : ∃ L₁ : SpecialLinearGroup (Fin 3) S, L₁ ∈ E3 S ∧
      IsCoprime ((L₁ * A : SpecialLinearGroup (Fin 3) S).1 0 2)
        ((L₁ * A : SpecialLinearGroup (Fin 3) S).1 1 2) := by
    by_cases hb : A.1 1 2 = 0
    · rcases hunim with ⟨u, v, w, huvw⟩
      rw [hb, mul_zero, add_zero] at huvw
      refine ⟨tv 1 2 (by decide) 1, tv_mem_E3 _ _ _ _, ⟨u, w, ?_⟩⟩
      have h0 : ((tv 1 2 (by decide) (1 : S) * A : SpecialLinearGroup (Fin 3) S).1) 0 2 = A.1 0 2 := by
        change (tvM 1 2 (1 : S) * A.1) 0 2 = A.1 0 2
        exact Matrix.transvection_mul_apply_of_ne (1 : Fin 3) 2 0 2 (by decide) 1 A.1
      have h1 : ((tv 1 2 (by decide) (1 : S) * A : SpecialLinearGroup (Fin 3) S).1) 1 2 = A.1 2 2 := by
        change (tvM 1 2 (1 : S) * A.1) 1 2 = A.1 2 2
        rw [tvM, Matrix.transvection_mul_apply_same, hb, zero_add, one_mul]
      rw [h0, h1]
      exact huvw
    · obtain ⟨t, ht⟩ := hSR2 (A.1 0 2) (A.1 1 2) (A.1 2 2) hunim hb
      refine ⟨tv 0 2 (by decide) t, tv_mem_E3 _ _ _ _, ?_⟩
      have h0 : ((tv 0 2 (by decide) t * A : SpecialLinearGroup (Fin 3) S).1) 0 2 =
          A.1 0 2 + t * A.1 2 2 := by
        change (tvM 0 2 t * A.1) 0 2 = _
        exact Matrix.transvection_mul_apply_same (0 : Fin 3) 2 2 t A.1
      have h1 : ((tv 0 2 (by decide) t * A : SpecialLinearGroup (Fin 3) S).1) 1 2 = A.1 1 2 := by
        change (tvM 0 2 t * A.1) 1 2 = _
        exact Matrix.transvection_mul_apply_of_ne (0 : Fin 3) 2 1 2 (by decide) t A.1
      rw [h0, h1]
      exact ht
  obtain ⟨L₁, hL₁, hcop⟩ := hstep1
  let A₁ : SpecialLinearGroup (Fin 3) S := L₁ * A
  obtain ⟨x, y, hxy⟩ := hcop
  let a' := A₁.1 0 2
  let b' := A₁.1 1 2
  let c' := A₁.1 2 2
  let L₂ : SpecialLinearGroup (Fin 3) S :=
    tv 2 0 (by decide) ((1 - c') * x) * tv 2 1 (by decide) ((1 - c') * y)
  have hL₂ : L₂ ∈ E3 S := Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  let A₂ : SpecialLinearGroup (Fin 3) S := L₂ * A₁
  have hA₂_val : A₂.1 = tvM 2 0 ((1 - c') * x) * (tvM 2 1 ((1 - c') * y) * A₁.1) := by
    change (tvM 2 0 ((1 - c') * x) * tvM 2 1 ((1 - c') * y)) * A₁.1 = _
    rw [Matrix.mul_assoc]
  have hA₂_02 : A₂.1 0 2 = a' := by
    rw [hA₂_val, tvM, tvM, Matrix.transvection_mul_apply_of_ne (2 : Fin 3) 0 0 2 (by decide),
      Matrix.transvection_mul_apply_of_ne (2 : Fin 3) 1 0 2 (by decide)]
  have hA₂_12 : A₂.1 1 2 = b' := by
    rw [hA₂_val, tvM, tvM, Matrix.transvection_mul_apply_of_ne (2 : Fin 3) 0 1 2 (by decide),
      Matrix.transvection_mul_apply_of_ne (2 : Fin 3) 1 1 2 (by decide)]
  have hA₂_22 : A₂.1 2 2 = 1 := by
    rw [hA₂_val, tvM, tvM, Matrix.transvection_mul_apply_same, Matrix.transvection_mul_apply_same,
      Matrix.transvection_mul_apply_of_ne (2 : Fin 3) 1 0 2 (by decide)]
    have hxy' : x * a' + y * b' = 1 := hxy
    calc c' + (1 - c') * y * b' + (1 - c') * x * a'
        = c' + (1 - c') * (x * a' + y * b') := by ring
      _ = c' + (1 - c') * 1 := by rw [hxy']
      _ = 1 := by ring
  let L₃ : SpecialLinearGroup (Fin 3) S :=
    tv 0 2 (by decide) (-a') * tv 1 2 (by decide) (-b')
  have hL₃ : L₃ ∈ E3 S := Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  let A₃ : SpecialLinearGroup (Fin 3) S := L₃ * A₂
  have hA₃_val : A₃.1 = tvM 0 2 (-a') * (tvM 1 2 (-b') * A₂.1) := by
    change (tvM 0 2 (-a') * tvM 1 2 (-b')) * A₂.1 = _
    rw [Matrix.mul_assoc]
  have hA₃_02 : A₃.1 0 2 = 0 := by
    rw [hA₃_val, tvM, tvM, Matrix.transvection_mul_apply_same,
      Matrix.transvection_mul_apply_of_ne (1 : Fin 3) 2 0 2 (by decide),
      Matrix.transvection_mul_apply_of_ne (1 : Fin 3) 2 2 2 (by decide), hA₂_02, hA₂_22]
    ring
  have hA₃_12 : A₃.1 1 2 = 0 := by
    rw [hA₃_val, tvM, tvM, Matrix.transvection_mul_apply_of_ne (0 : Fin 3) 2 1 2 (by decide),
      Matrix.transvection_mul_apply_same, hA₂_12, hA₂_22]
    ring
  have hA₃_22 : A₃.1 2 2 = 1 := by
    rw [hA₃_val, tvM, tvM, Matrix.transvection_mul_apply_of_ne (0 : Fin 3) 2 2 2 (by decide),
      Matrix.transvection_mul_apply_of_ne (1 : Fin 3) 2 2 2 (by decide), hA₂_22]
  let r₀ := A₃.1 2 0
  let r₁ := A₃.1 2 1
  let R₄ : SpecialLinearGroup (Fin 3) S :=
    tv 2 0 (by decide) (-r₀) * tv 2 1 (by decide) (-r₁)
  have hR₄ : R₄ ∈ E3 S := Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  let A₄ : SpecialLinearGroup (Fin 3) S := A₃ * R₄
  have hA₄_val : A₄.1 = (A₃.1 * tvM 2 0 (-r₀)) * tvM 2 1 (-r₁) := by
    change A₃.1 * (tvM 2 0 (-r₀) * tvM 2 1 (-r₁)) = _
    rw [Matrix.mul_assoc]
  have hA₄_02 : A₄.1 0 2 = 0 := by
    rw [hA₄_val, tvM, tvM, Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 1 0 2 (by decide),
      Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 0 0 2 (by decide), hA₃_02]
  have hA₄_12 : A₄.1 1 2 = 0 := by
    rw [hA₄_val, tvM, tvM, Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 1 1 2 (by decide),
      Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 0 1 2 (by decide), hA₃_12]
  have hA₄_22 : A₄.1 2 2 = 1 := by
    rw [hA₄_val, tvM, tvM, Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 1 2 2 (by decide),
      Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 0 2 2 (by decide), hA₃_22]
  have hA₄_20 : A₄.1 2 0 = 0 := by
    rw [hA₄_val, tvM, tvM, Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 1 2 0 (by decide),
      Matrix.mul_transvection_apply_same, hA₃_22]
    ring
  have hA₄_21 : A₄.1 2 1 = 0 := by
    rw [hA₄_val, tvM, tvM, Matrix.mul_transvection_apply_same,
      Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 0 2 1 (by decide),
      Matrix.mul_transvection_apply_of_ne (2 : Fin 3) 0 2 2 (by decide), hA₃_22]
    ring
  have hdetM : A₄.1 0 0 * A₄.1 1 1 - A₄.1 0 1 * A₄.1 1 0 = 1 := by
    have hdet := A₄.2
    rw [Matrix.det_fin_three] at hdet
    rw [hA₄_02, hA₄_12, hA₄_22, hA₄_20, hA₄_21] at hdet
    linear_combination hdet
  let M : SpecialLinearGroup (Fin 2) S := mkSL2 (A₄.1 0 0) (A₄.1 0 1) (A₄.1 1 0) (A₄.1 1 1) hdetM
  have hA₄_eq : A₄ = iota M := by
    ext i j
    change A₄.1 i j = iotaMat M.1 i j
    fin_cases i <;> fin_cases j <;>
      simp [M, iotaMat, mkSL2, hA₄_02, hA₄_12, hA₄_22, hA₄_20, hA₄_21]
  refine ⟨(L₃ * L₂ * L₁)⁻¹, R₄⁻¹,
    Subgroup.inv_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hL₃ hL₂) hL₁),
    Subgroup.inv_mem _ hR₄, M, ?_⟩
  rw [← hA₄_eq]
  simp only [A₄, A₃, A₂, A₁]
  group

/- Steinberg commutator identities and conjugation of transvections by `iota M`. -/
lemma steinberg_01 (t : S) :
    tv 0 1 (by decide) t =
      tv 0 2 (by decide) t * tv 2 1 (by decide) 1 *
      tv 0 2 (by decide) (-t) * tv 2 1 (by decide) (-1) := by
  ext i j
  change tvM 0 1 t i j =
    (((tvM 0 2 t * tvM 2 1 (1 : S)) * tvM 0 2 (-t)) * tvM 2 1 (-1 : S)) i j
  simp only [tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;> simp

lemma steinberg_10 (t : S) :
    tv 1 0 (by decide) t =
      tv 1 2 (by decide) t * tv 2 0 (by decide) 1 *
      tv 1 2 (by decide) (-t) * tv 2 0 (by decide) (-1) := by
  ext i j
  change tvM 1 0 t i j =
    (((tvM 1 2 t * tvM 2 0 (1 : S)) * tvM 1 2 (-t)) * tvM 2 0 (-1 : S)) i j
  simp only [tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;> simp

lemma iota_inv_val (M : SpecialLinearGroup (Fin 2) S) :
    ((iota M)⁻¹ : SpecialLinearGroup (Fin 3) S).1 =
      !![M.1 1 1, -M.1 0 1, 0;
         -M.1 1 0, M.1 0 0, 0;
         0, 0, 1] := by
  have hdet := sl2_det_eq M
  let N : SpecialLinearGroup (Fin 2) S :=
    mkSL2 (M.1 1 1) (-M.1 0 1) (-M.1 1 0) (M.1 0 0) (by linear_combination hdet)
  have hinv : (iota M)⁻¹ = iota N := by
    apply inv_eq_of_mul_eq_one_right
    rw [← map_mul]
    have hMN : M * N = 1 := by
      ext i j
      change (M.1 * N.1) i j = (1 : Matrix (Fin 2) (Fin 2) S) i j
      rw [Matrix.mul_apply, Fin.sum_univ_two]
      fin_cases i <;> fin_cases j <;> simp [N, mkSL2]
      · linear_combination hdet
      · ring
      · ring
      · linear_combination hdet
    rw [hMN, map_one]
  rw [hinv]
  rfl

lemma conj_iota_tv_mem_E3 (M : SpecialLinearGroup (Fin 2) S)
    (i j : Fin 3) (hij : i ≠ j) (t : S) :
    iota M * tv i j hij t * (iota M)⁻¹ ∈ E3 S := by
  have h02 : ∀ u : S, iota M * tv 0 2 (by decide) u * (iota M)⁻¹ ∈ E3 S := by
    intro u
    have heq : iota M * tv 0 2 (by decide) u * (iota M)⁻¹ =
        tv 0 2 (by decide) (M.1 0 0 * u) * tv 1 2 (by decide) (M.1 1 0 * u) := by
      have hdet := sl2_det_eq M
      ext a b
      change (((iota M).1 * tvM 0 2 u) * ((iota M)⁻¹ : SpecialLinearGroup (Fin 3) S).1) a b =
        (tvM 0 2 (M.1 0 0 * u) * tvM 1 2 (M.1 1 0 * u)) a b
      rw [iota_val, iota_inv_val]
      simp only [iotaMat, tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
      fin_cases a <;> fin_cases b <;> simp <;> (first | ring1 | linear_combination hdet)
    rw [heq]
    exact Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  have h12 : ∀ u : S, iota M * tv 1 2 (by decide) u * (iota M)⁻¹ ∈ E3 S := by
    intro u
    have heq : iota M * tv 1 2 (by decide) u * (iota M)⁻¹ =
        tv 0 2 (by decide) (M.1 0 1 * u) * tv 1 2 (by decide) (M.1 1 1 * u) := by
      have hdet := sl2_det_eq M
      ext a b
      change (((iota M).1 * tvM 1 2 u) * ((iota M)⁻¹ : SpecialLinearGroup (Fin 3) S).1) a b =
        (tvM 0 2 (M.1 0 1 * u) * tvM 1 2 (M.1 1 1 * u)) a b
      rw [iota_val, iota_inv_val]
      simp only [iotaMat, tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
      fin_cases a <;> fin_cases b <;> simp <;> (first | ring1 | linear_combination hdet)
    rw [heq]
    exact Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  have h20 : ∀ u : S, iota M * tv 2 0 (by decide) u * (iota M)⁻¹ ∈ E3 S := by
    intro u
    have heq : iota M * tv 2 0 (by decide) u * (iota M)⁻¹ =
        tv 2 0 (by decide) (M.1 1 1 * u) * tv 2 1 (by decide) (-M.1 0 1 * u) := by
      have hdet := sl2_det_eq M
      ext a b
      change (((iota M).1 * tvM 2 0 u) * ((iota M)⁻¹ : SpecialLinearGroup (Fin 3) S).1) a b =
        (tvM 2 0 (M.1 1 1 * u) * tvM 2 1 (-M.1 0 1 * u)) a b
      rw [iota_val, iota_inv_val]
      simp only [iotaMat, tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
      fin_cases a <;> fin_cases b <;> simp <;> (first | ring1 | linear_combination hdet)
    rw [heq]
    exact Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  have h21 : ∀ u : S, iota M * tv 2 1 (by decide) u * (iota M)⁻¹ ∈ E3 S := by
    intro u
    have heq : iota M * tv 2 1 (by decide) u * (iota M)⁻¹ =
        tv 2 0 (by decide) (-M.1 1 0 * u) * tv 2 1 (by decide) (M.1 0 0 * u) := by
      have hdet := sl2_det_eq M
      ext a b
      change (((iota M).1 * tvM 2 1 u) * ((iota M)⁻¹ : SpecialLinearGroup (Fin 3) S).1) a b =
        (tvM 2 0 (-M.1 1 0 * u) * tvM 2 1 (M.1 0 0 * u)) a b
      rw [iota_val, iota_inv_val]
      simp only [iotaMat, tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
      fin_cases a <;> fin_cases b <;> simp <;> (first | ring1 | linear_combination hdet)
    rw [heq]
    exact Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) (tv_mem_E3 _ _ _ _)
  fin_cases i <;> fin_cases j <;> dsimp only
  · exact absurd rfl hij
  · change iota M * tv 0 1 (by decide) t * (iota M)⁻¹ ∈ E3 S
    rw [steinberg_01]
    have hsplit : iota M * (tv 0 2 (by decide) t * tv 2 1 (by decide) 1 *
        tv 0 2 (by decide) (-t) * tv 2 1 (by decide) (-1)) * (iota M)⁻¹ =
        (iota M * tv 0 2 (by decide) t * (iota M)⁻¹) *
        (iota M * tv 2 1 (by decide) 1 * (iota M)⁻¹) *
        (iota M * tv 0 2 (by decide) (-t) * (iota M)⁻¹) *
        (iota M * tv 2 1 (by decide) (-1) * (iota M)⁻¹) := by group
    rw [hsplit]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (h02 t) (h21 1)) (h02 (-t))) (h21 (-1))
  · exact h02 t
  · change iota M * tv 1 0 (by decide) t * (iota M)⁻¹ ∈ E3 S
    rw [steinberg_10]
    have hsplit : iota M * (tv 1 2 (by decide) t * tv 2 0 (by decide) 1 *
        tv 1 2 (by decide) (-t) * tv 2 0 (by decide) (-1)) * (iota M)⁻¹ =
        (iota M * tv 1 2 (by decide) t * (iota M)⁻¹) *
        (iota M * tv 2 0 (by decide) 1 * (iota M)⁻¹) *
        (iota M * tv 1 2 (by decide) (-t) * (iota M)⁻¹) *
        (iota M * tv 2 0 (by decide) (-1) * (iota M)⁻¹) := by group
    rw [hsplit]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (h12 t) (h20 1)) (h12 (-t))) (h20 (-1))
  · exact absurd rfl hij
  · exact h12 t
  · exact h20 t
  · exact h21 t
  · exact absurd rfl hij

lemma E3_normal_of_SR2 (hSR2 : HasSR2 S) : (E3 S).Normal := by
  constructor
  intro e he g
  obtain ⟨L, R, hL, hR, M, rfl⟩ := sr2_reduction hSR2 g
  have hconj : (L * iota M * R) * e * (L * iota M * R)⁻¹ =
      L * (iota M * (R * e * R⁻¹) * (iota M)⁻¹) * L⁻¹ := by group
  rw [hconj]
  have hRe : R * e * R⁻¹ ∈ E3 S :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ hR he) (Subgroup.inv_mem _ hR)
  have hM : iota M * (R * e * R⁻¹) * (iota M)⁻¹ ∈ E3 S := by
    refine Subgroup.closure_induction
      (p := fun x _ => iota M * x * (iota M)⁻¹ ∈ E3 S) ?_ ?_ ?_ ?_ hRe
    · rintro _ ⟨i, j, hij, c, rfl⟩
      exact conj_iota_tv_mem_E3 M i j hij c
    · simp only [mul_one, mul_inv_cancel]
      exact Subgroup.one_mem _
    · intro x y _ _ hx hy
      have hxy : iota M * (x * y) * (iota M)⁻¹ =
          (iota M * x * (iota M)⁻¹) * (iota M * y * (iota M)⁻¹) := by group
      rw [hxy]
      exact Subgroup.mul_mem _ hx hy
    · intro x _ hx
      have hxi : iota M * x⁻¹ * (iota M)⁻¹ = (iota M * x * (iota M)⁻¹)⁻¹ := by group
      rw [hxi]
      exact Subgroup.inv_mem _ hx
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hL hM) (Subgroup.inv_mem _ hL)

end ElementaryMatrices

section IntegerSR2AndGen

/- Stable range `SR2` in `ℤ` via the prime-factor trick. -/
lemma sr2_int : HasSR2 ℤ := by
  intro a b c ⟨u, v, w, huvw⟩ hb
  let S : Finset ℕ := b.natAbs.primeFactors.filter fun p => ¬ ((p : ℤ) ∣ a)
  let t : ℤ := ∏ p ∈ S, (p : ℤ)
  refine ⟨t, ?_⟩
  rw [Int.isCoprime_iff_nat_coprime]
  refine Nat.coprime_of_dvd' fun p hp hpa hpb => ?_
  exfalso
  have hpbZ : (p : ℤ) ∣ b := Int.natCast_dvd.mpr hpb
  have hpaZ : (p : ℤ) ∣ a + t * c := Int.natCast_dvd.mpr hpa
  have hp_mem_pf : p ∈ b.natAbs.primeFactors :=
    Nat.mem_primeFactors.mpr ⟨hp, hpb, Int.natAbs_ne_zero.mpr hb⟩
  by_cases ha : (p : ℤ) ∣ a
  · have hp_not_dvd_t : ¬ ((p : ℤ) ∣ t) := by
      intro hdvd
      have hprimeZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
      obtain ⟨q, hqS, hpq⟩ := (hprimeZ.dvd_finsetProd_iff (fun r : ℕ => (r : ℤ))).mp hdvd
      have hq_mem : q ∈ b.natAbs.primeFactors := (Finset.mem_filter.mp hqS).1
      have hq_not_a : ¬ ((q : ℤ) ∣ a) := (Finset.mem_filter.mp hqS).2
      have hq_prime : q.Prime := Nat.prime_of_mem_primeFactors hq_mem
      have hpqN : p ∣ q := Int.natCast_dvd_natCast.mp hpq
      have hpeq : p = q := (Nat.prime_dvd_prime_iff_eq hp hq_prime).mp hpqN
      exact hq_not_a (hpeq ▸ ha)
    have hptc : (p : ℤ) ∣ t * c := by
      have := dvd_sub hpaZ ha
      simpa using this
    have hpc : (p : ℤ) ∣ c := by
      have hprimeZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
      exact (hprimeZ.dvd_or_dvd hptc).resolve_left hp_not_dvd_t
    have hp1 : (p : ℤ) ∣ 1 := by
      rw [← huvw]
      exact dvd_add (dvd_add (dvd_mul_of_dvd_right ha u) (dvd_mul_of_dvd_right hpbZ v))
        (dvd_mul_of_dvd_right hpc w)
    exact hp.not_dvd_one (Int.natCast_dvd_natCast.mp hp1)
  · have hpS : p ∈ S := Finset.mem_filter.mpr ⟨hp_mem_pf, ha⟩
    have hpt : (p : ℤ) ∣ t := Finset.dvd_prod_of_mem (fun q : ℕ => (q : ℤ)) hpS
    have hpa' : (p : ℤ) ∣ a := by
      have := dvd_sub hpaZ (dvd_mul_of_dvd_left hpt c)
      simpa using this
    exact ha hpa'

/- Every `SL(2, ℤ)` matrix embeds into `E3 ℤ` via Euclidean division. -/
lemma iota_sl2_int_mem_E3 (M : SpecialLinearGroup (Fin 2) ℤ) : iota M ∈ E3 ℤ := by
  suffices h : ∀ n : ℕ, ∀ A : SpecialLinearGroup (Fin 2) ℤ, (A.1 0 1).natAbs = n → iota A ∈ E3 ℤ by
    exact h (M.1 0 1).natAbs M rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro A hA
    by_cases h01 : A.1 0 1 = 0
    · have hdet := sl2_det_eq A
      rw [h01, zero_mul, sub_zero] at hdet
      have h00_cases : A.1 0 0 = 1 ∨ A.1 0 0 = -1 := by
        have h1 : A.1 0 0 ∣ 1 := ⟨A.1 1 1, hdet.symm⟩
        exact Int.isUnit_iff.mp (isUnit_of_dvd_one h1)
      rcases h00_cases with h1 | hm1
      · have h11 : A.1 1 1 = 1 := by rw [h1, one_mul] at hdet; exact hdet
        have hAeq : A = mkSL2 1 0 (A.1 1 0) 1 (by ring) := by
          ext i j; fin_cases i <;> fin_cases j <;> simp [mkSL2, h1, h01, h11]
        rw [hAeq, iota_tv10]
        exact tv_mem_E3 _ _ _ _
      · have h11 : A.1 1 1 = -1 := by
          have : -(A.1 1 1) = 1 := by simpa [hm1] using hdet
          omega
        let negI : SpecialLinearGroup (Fin 2) ℤ := mkSL2 (-1) 0 0 (-1) (by ring)
        let J : SpecialLinearGroup (Fin 2) ℤ := mkSL2 (0 : ℤ) 1 (-1) 0 (by ring)
        have hnegI_mem : iota negI ∈ E3 ℤ := by
          have hsq : iota negI = S01 * S01 := by
            rw [S01_eq_iota, ← map_mul]
            congr 1
            ext i j
            change negI.1 i j = (J.1 * J.1) i j
            rw [Matrix.mul_apply, Fin.sum_univ_two]
            fin_cases i <;> fin_cases j <;> simp [negI, J, mkSL2]
          rw [hsq]
          exact Subgroup.mul_mem _ S01_mem_E3 S01_mem_E3
        have hAeq : A = negI * mkSL2 1 0 (-A.1 1 0) 1 (by ring) := by
          ext i j
          change A.1 i j = (negI.1 * (mkSL2 (1 : ℤ) 0 (-A.1 1 0) 1 (by ring)).1) i j
          rw [Matrix.mul_apply, Fin.sum_univ_two]
          fin_cases i <;> fin_cases j <;> simp [negI, mkSL2, hm1, h01, h11]
        rw [hAeq, map_mul, iota_tv10]
        exact Subgroup.mul_mem _ hnegI_mem (tv_mem_E3 _ _ _ _)
    · let q : ℤ := A.1 0 0 / A.1 0 1
      let E₁ : SpecialLinearGroup (Fin 2) ℤ := mkSL2 (1 : ℤ) 0 (-q) 1 (by ring)
      let E₂ : SpecialLinearGroup (Fin 2) ℤ := mkSL2 (0 : ℤ) 1 (-1) 0 (by ring)
      let E : SpecialLinearGroup (Fin 2) ℤ := E₁ * E₂
      have hE_mem : iota E ∈ E3 ℤ := by
        rw [map_mul, iota_tv10, ← S01_eq_iota]
        exact Subgroup.mul_mem _ (tv_mem_E3 _ _ _ _) S01_mem_E3
      let A' : SpecialLinearGroup (Fin 2) ℤ := A * E
      have hA'_01 : A'.1 0 1 = A.1 0 0 % A.1 0 1 := by
        have hmul : A'.1 0 1 = A.1 0 0 - q * A.1 0 1 := by
          change (A.1 * (E₁.1 * E₂.1)) 0 1 = _
          simp [Matrix.mul_apply, Fin.sum_univ_two, E₁, E₂, mkSL2]
          ring
        rw [hmul]
        have hdiv := Int.mul_ediv_add_emod (A.1 0 0) (A.1 0 1)
        have hq : A.1 0 1 * q + A.1 0 0 % A.1 0 1 = A.1 0 0 := hdiv
        linarith
      have hlt : (A'.1 0 1).natAbs < n := by
        rw [hA'_01, ← hA]
        have hmod_nonneg : 0 ≤ A.1 0 0 % A.1 0 1 := Int.emod_nonneg (A.1 0 0) h01
        have hmod_lt : A.1 0 0 % A.1 0 1 < ((A.1 0 1).natAbs : ℤ) := Int.emod_lt (A.1 0 0) h01
        omega
      have hA'_mem : iota A' ∈ E3 ℤ := ih (A'.1 0 1).natAbs hlt A' rfl
      have hA_eq : iota A = iota A' * (iota E)⁻¹ := by
        simp [A', map_mul]
      rw [hA_eq]
      exact Subgroup.mul_mem _ hA'_mem (Subgroup.inv_mem _ hE_mem)

lemma E3_int_eq_top (A : SpecialLinearGroup (Fin 3) ℤ) : A ∈ E3 ℤ := by
  obtain ⟨L, R, hL, hR, M, rfl⟩ := sr2_reduction sr2_int A
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hL (iota_sl2_int_mem_E3 M)) hR

end IntegerSR2AndGen

noncomputable section UltrapowerRing

abbrev U : Ultrafilter ℕ := hyperfilter ℕ
abbrev R : Type := Filter.Germ (U : Filter ℕ) ℤ

lemma eventually_ge_U (N : ℕ) : ∀ᶠ n in (U : Filter ℕ), N ≤ n := by
  have hcof : {n : ℕ | N ≤ n} ∈ (cofinite : Filter ℕ) := by
    rw [mem_cofinite]
    have hsub : {n : ℕ | N ≤ n}ᶜ ⊆ {n : ℕ | n < N} := fun n hn => by
      simp only [Set.mem_compl_iff, Set.mem_ofPred_eq, not_le] at hn
      exact hn
    exact (Set.finite_lt_nat N).subset hsub
  exact Filter.hyperfilter_le_cofinite hcof

lemma germ_coe_eq {f g : ℕ → ℤ} : ((f : R) = (g : R)) ↔ ∀ᶠ n in (U : Filter ℕ), f n = g n :=
  Filter.Germ.coe_eq

lemma germ_zero : ((fun _ : ℕ => (0 : ℤ)) : R) = 0 := rfl
lemma germ_one : ((fun _ : ℕ => (1 : ℤ)) : R) = 1 := rfl
lemma germ_add (f g : ℕ → ℤ) : (f : R) + (g : R) = ((fun n => f n + g n) : R) := rfl
lemma germ_sub (f g : ℕ → ℤ) : (f : R) - (g : R) = ((fun n => f n - g n) : R) := rfl
lemma germ_mul (f g : ℕ → ℤ) : (f : R) * (g : R) = ((fun n => f n * g n) : R) := rfl
lemma germ_neg (f : ℕ → ℤ) : -(f : R) = ((fun n => -(f n)) : R) := rfl

lemma germ_pow (f : ℕ → ℤ) (k : ℕ) : (f : R) ^ k = ((fun n => (f n) ^ k) : R) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [pow_succ, ih, germ_mul]
    congr 1
    funext n
    exact (pow_succ (f n) k).symm

lemma germ_ne_zero_iff {f : ℕ → ℤ} : ((f : R) ≠ 0) ↔ ∀ᶠ n in (U : Filter ℕ), f n ≠ 0 := by
  rw [ne_eq, ← germ_zero, germ_coe_eq, ← U.eventually_not]

lemma germ_isCoprime_iff {f g : ℕ → ℤ} :
    IsCoprime (f : R) (g : R) ↔ ∀ᶠ n in (U : Filter ℕ), IsCoprime (f n) (g n) := by
  constructor
  · rintro ⟨x, y, hxy⟩
    induction x using Filter.Germ.inductionOn with
    | h fx =>
      induction y using Filter.Germ.inductionOn with
      | h fy =>
        rw [germ_mul, germ_mul, germ_add, ← germ_one, germ_coe_eq] at hxy
        exact hxy.mono fun n hn => ⟨fx n, fy n, hn⟩
  · intro hev
    classical
    let fx : ℕ → ℤ := fun n => if h : IsCoprime (f n) (g n) then h.choose else 0
    let fy : ℕ → ℤ := fun n => if h : IsCoprime (f n) (g n) then h.choose_spec.choose else 0
    refine ⟨(fx : R), (fy : R), ?_⟩
    rw [germ_mul, germ_mul, germ_add, ← germ_one, germ_coe_eq]
    exact hev.mono fun n hn => by
      simp only [fx, fy, dif_pos hn]
      exact hn.choose_spec.choose_spec

lemma germ_dvd_iff {f g : ℕ → ℤ} :
    ((f : R) ∣ (g : R)) ↔ ∀ᶠ n in (U : Filter ℕ), f n ∣ g n := by
  constructor
  · rintro ⟨k, hk⟩
    induction k using Filter.Germ.inductionOn with
    | h fk =>
      rw [germ_mul, germ_coe_eq] at hk
      exact hk.mono fun n hn => ⟨fk n, hn⟩
  · intro hev
    classical
    let fk : ℕ → ℤ := fun n => if h : f n ∣ g n then h.choose else 0
    refine ⟨(fk : R), ?_⟩
    rw [germ_mul, germ_coe_eq]
    exact hev.mono fun n hn => by
      simp only [fk, dif_pos hn]
      exact hn.choose_spec

/- Lift `SR2` from `ℤ` to the ultrapower `R`. -/
lemma sr2_R : HasSR2 R := by
  intro a b c huvw hb
  induction a using Filter.Germ.inductionOn with
  | h fa =>
    induction b using Filter.Germ.inductionOn with
    | h fb =>
      induction c using Filter.Germ.inductionOn with
      | h fc =>
        rcases huvw with ⟨u, v, w, heq⟩
        induction u using Filter.Germ.inductionOn with
        | h fu =>
          induction v using Filter.Germ.inductionOn with
          | h fv =>
            induction w using Filter.Germ.inductionOn with
            | h fw =>
              have h1 : ∀ᶠ n in (U : Filter ℕ),
                  fu n * fa n + fv n * fb n + fw n * fc n = 1 := by
                simpa only [germ_mul, germ_add, ← germ_one, germ_coe_eq] using heq
              have h2 : ∀ᶠ n in (U : Filter ℕ), fb n ≠ 0 := germ_ne_zero_iff.mp hb
              classical
              let ft : ℕ → ℤ := fun n =>
                if h : (∃ u' v' w' : ℤ, u' * fa n + v' * fb n + w' * fc n = 1) ∧ fb n ≠ 0 then
                  (sr2_int (fa n) (fb n) (fc n) h.1 h.2).choose
                else 0
              refine ⟨(ft : R), ?_⟩
              rw [germ_mul, germ_add, germ_isCoprime_iff]
              exact (h1.and h2).mono fun n ⟨hn1, hn2⟩ => by
                have hcond : (∃ u' v' w' : ℤ, u' * fa n + v' * fb n + w' * fc n = 1) ∧ fb n ≠ 0 :=
                  ⟨⟨fu n, fv n, fw n, hn1⟩, hn2⟩
                simp only [ft, dif_pos hcond]
                exact (sr2_int (fa n) (fb n) (fc n) hcond.1 hcond.2).choose_spec

lemma sr1_R (a c b : R) (hac : IsCoprime a c) (hb : b ≠ 0) :
    ∃ t : R, IsCoprime (a + t * c) b := by
  rcases hac with ⟨u, w, huw⟩
  exact sr2_R a b c ⟨u, 0, w, by simpa using huw⟩ hb

instance E3_R_normal : (E3 R).Normal := E3_normal_of_SR2 sr2_R

/- Gap-sequence reduction from bounded elementary generation of `SL(3, ℤ)` to a surjection onto `C`. -/
def IsTransvProd (k : ℕ) (A : SpecialLinearGroup (Fin 3) ℤ) : Prop :=
  ∃ l : List (Fin 3 × Fin 3 × ℤ),
    l.length ≤ k ∧
    (∀ e ∈ l, e.1 ≠ e.2.1) ∧
    (A : Matrix (Fin 3) (Fin 3) ℤ) =
      (l.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod

lemma isTransvProd_mono {k₁ k₂ : ℕ} (h : k₁ ≤ k₂) {A : SpecialLinearGroup (Fin 3) ℤ}
    (hA : IsTransvProd k₁ A) : IsTransvProd k₂ A := by
  rcases hA with ⟨l, hlen, hne, hprod⟩
  exact ⟨l, hlen.trans h, hne, hprod⟩

lemma isTransvProd_mul {k₁ k₂ : ℕ} {A B : SpecialLinearGroup (Fin 3) ℤ}
    (hA : IsTransvProd k₁ A) (hB : IsTransvProd k₂ B) :
    IsTransvProd (k₁ + k₂) (A * B) := by
  rcases hA with ⟨l₁, hlen₁, hne₁, hprod₁⟩
  rcases hB with ⟨l₂, hlen₂, hne₂, hprod₂⟩
  refine ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · rw [List.length_append]; omega
  · intro e he
    rcases List.mem_append.mp he with h | h
    · exact hne₁ e h
    · exact hne₂ e h
  · change (A : Matrix (Fin 3) (Fin 3) ℤ) * (B : Matrix (Fin 3) (Fin 3) ℤ) = _
    rw [hprod₁, hprod₂, List.map_append, List.prod_append]

lemma exists_gap_tuple (hunb : ∀ N : ℕ, ∃ A : SpecialLinearGroup (Fin 3) ℤ, ¬ IsTransvProd N A)
    (n : ℕ) : ∀ m : ℕ,
    ∃ (f : Fin m → SpecialLinearGroup (Fin 3) ℤ) (K : ℕ),
      (∀ i, IsTransvProd K (f i)) ∧
      (∀ i j : Fin m, i < j → ¬ IsTransvProd n ((f i)⁻¹ * f j)) := by
  intro m
  induction m with
  | zero =>
    exact ⟨Fin.elim0, 0, fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  | succ m ih =>
    obtain ⟨f, K, hK, hgap⟩ := ih
    obtain ⟨A, hA_not⟩ := hunb (K + n)
    obtain ⟨lA, hneA, hprodA⟩ := (mem_E3_iff_list A).mp (E3_int_eq_top A)
    have hA_tp : IsTransvProd lA.length A := ⟨lA, le_rfl, hneA, hprodA⟩
    refine ⟨Fin.snoc f A, max K lA.length, ?_, ?_⟩
    · intro i
      refine Fin.lastCases ?_ ?_ i
      · rw [Fin.snoc_last]
        exact isTransvProd_mono (le_max_right K lA.length) hA_tp
      · intro j
        rw [Fin.snoc_castSucc]
        exact isTransvProd_mono (le_max_left K lA.length) (hK j)
    · intro i j hij
      refine Fin.lastCases ?_ ?_ j hij
      · intro hij_last
        have hi_lt : i.val < m := hij_last
        let i₀ : Fin m := ⟨i.val, hi_lt⟩
        have hi_eq : i = i₀.castSucc := Fin.ext rfl
        rw [hi_eq, Fin.snoc_castSucc, Fin.snoc_last]
        intro hbad
        have hmul := isTransvProd_mul (hK i₀) hbad
        rw [mul_inv_cancel_left] at hmul
        exact hA_not hmul
      · intro j₀ hij'
        have hi_lt : i.val < m := lt_trans hij' j₀.isLt
        let i₀ : Fin m := ⟨i.val, hi_lt⟩
        have hi_eq : i = i₀.castSucc := Fin.ext rfl
        rw [hi_eq, Fin.snoc_castSucc, Fin.snoc_castSucc]
        exact hgap i₀ j₀ hij'

/- Lift a sequence of `SL(3, ℤ)` matrices to `SL(3, R)`. -/
def sl3Lift (seq : ℕ → SpecialLinearGroup (Fin 3) ℤ) : SpecialLinearGroup (Fin 3) R :=
  ⟨Matrix.of fun i j => ((fun n => (seq n).1 i j) : R), by
    rw [Matrix.det_fin_three]
    simp only [Matrix.of_apply, germ_mul, germ_add, germ_sub, ← germ_one, germ_coe_eq]
    exact Eventually.of_forall fun n => by
      have h := (seq n).2
      rw [Matrix.det_fin_three] at h
      exact h⟩

lemma sl3Lift_mul_inv (seq₁ seq₂ : ℕ → SpecialLinearGroup (Fin 3) ℤ) :
    (sl3Lift seq₁)⁻¹ * sl3Lift seq₂ = sl3Lift (fun n => (seq₁ n)⁻¹ * seq₂ n) := by
  have hmul : sl3Lift seq₁ * sl3Lift (fun n => (seq₁ n)⁻¹ * seq₂ n) = sl3Lift seq₂ := by
    ext i j
    change ((sl3Lift seq₁).1 * (sl3Lift (fun n => (seq₁ n)⁻¹ * seq₂ n)).1) i j = (sl3Lift seq₂).1 i j
    rw [Matrix.mul_apply, Fin.sum_univ_three]
    simp only [sl3Lift, Matrix.of_apply, germ_mul, germ_add, germ_coe_eq]
    exact Eventually.of_forall fun n => by
      have h := congrFun (congrFun (show ((seq₁ n * ((seq₁ n)⁻¹ * seq₂ n) :
          SpecialLinearGroup (Fin 3) ℤ).1) = (seq₂ n).1 by rw [mul_inv_cancel_left]) i) j
      change ((seq₁ n).1 * ((seq₁ n)⁻¹ * seq₂ n).1) i j = (seq₂ n).1 i j at h
      rw [Matrix.mul_apply, Fin.sum_univ_three] at h
      exact h
  exact (eq_inv_mul_of_mul_eq hmul).symm

lemma transvection_list_lift (l : List (Fin 3 × Fin 3 × R)) :
    ∃ lseq : ℕ → List (Fin 3 × Fin 3 × ℤ),
      (∀ n, (lseq n).length = l.length) ∧
      ((∀ e ∈ l, e.1 ≠ e.2.1) → ∀ n, ∀ e ∈ lseq n, e.1 ≠ e.2.1) ∧
      ∀ a b : Fin 3,
        (l.map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod a b =
          ((fun n => ((lseq n).map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod a b) : R) := by
  induction l with
  | nil =>
    refine ⟨fun _ => [], fun _ => rfl, fun _ _ e h => by simp at h, fun a b => ?_⟩
    simp only [List.map_nil, List.prod_nil]
    fin_cases a <;> fin_cases b <;> rfl
  | cons e t ih =>
    obtain ⟨tseq, htlen, htne, htprod⟩ := ih
    rcases e with ⟨i, j, c⟩
    induction c using Filter.Germ.inductionOn with
    | h fc =>
      refine ⟨fun n => (i, j, fc n) :: tseq n, fun n => by simp [htlen n], ?_, ?_⟩
      · intro hne n e' he'
        rcases List.mem_cons.mp he' with rfl | hmem
        · exact hne (i, j, (fc : R)) (by simp)
        · exact htne (fun x hx => hne x (by simp [hx])) n e' hmem
      · intro a b
        simp only [List.map_cons, List.prod_cons]
        rw [Matrix.mul_apply, Fin.sum_univ_three]
        have htv : ∀ k : Fin 3, Matrix.transvection i j (fc : R) a k =
            ((fun n => Matrix.transvection i j (fc n) a k) : R) := by
          intro k
          simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
          split_ifs <;> rfl
        rw [htv 0, htv 1, htv 2, htprod 0 b, htprod 1 b, htprod 2 b]
        simp only [germ_mul, germ_add, germ_coe_eq]
        exact Eventually.of_forall fun n => by
          rw [Matrix.mul_apply, Fin.sum_univ_three]

lemma bounded_gen_of_surj_fin24
    (hsurj : ∃ φ : Fin 8 × Fin 3 → SpecialLinearGroup (Fin 3) R ⧸ E3 R, Function.Surjective φ) :
    OMA.R_Green100_green_100_variants_operator_norm_R1_H1_R1_H1_R1.H1 := by
  by_contra hnot
  have hunb : ∀ N : ℕ, ∃ A : SpecialLinearGroup (Fin 3) ℤ, ¬ IsTransvProd N A := by
    intro N
    by_contra hall
    push Not at hall
    exact hnot ⟨N, hall⟩
  have hex : ∀ n : ℕ, ∃ f : Fin 25 → SpecialLinearGroup (Fin 3) ℤ,
      ∀ i j : Fin 25, i < j → ¬ IsTransvProd n ((f i)⁻¹ * f j) := fun n => by
    obtain ⟨f, _, _, hgap⟩ := exists_gap_tuple hunb n 25
    exact ⟨f, hgap⟩
  choose B hB using hex
  let g : Fin 25 → SpecialLinearGroup (Fin 3) R := fun j => sl3Lift (fun n => B n j)
  let qmap : Fin 25 → SpecialLinearGroup (Fin 3) R ⧸ E3 R :=
    fun j => QuotientGroup.mk (g j)
  have hlt_ne : ∀ i j : Fin 25, i < j → qmap i ≠ qmap j := by
    intro i j hlt hij
    have hmem : (g i)⁻¹ * g j ∈ E3 R := QuotientGroup.eq.mp hij
    obtain ⟨l, hl_ne, hl_prod⟩ := (mem_E3_iff_list _).mp hmem
    obtain ⟨lseq, hlseq_len, hlseq_ne, hlseq_prod⟩ := transvection_list_lift l
    have hlift : ((g i)⁻¹ * g j : SpecialLinearGroup (Fin 3) R) =
        sl3Lift (fun n => (B n i)⁻¹ * B n j) := sl3Lift_mul_inv _ _
    have hentry : ∀ a b : Fin 3, ∀ᶠ n in (U : Filter ℕ),
        (((B n i)⁻¹ * B n j : SpecialLinearGroup (Fin 3) ℤ).1) a b =
          ((lseq n).map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod a b := by
      intro a b
      have h1 : (((g i)⁻¹ * g j : SpecialLinearGroup (Fin 3) R).1) a b =
          ((fun n => (((B n i)⁻¹ * B n j : SpecialLinearGroup (Fin 3) ℤ).1) a b) : R) := by
        rw [hlift]; rfl
      have h2 : (((g i)⁻¹ * g j : SpecialLinearGroup (Fin 3) R).1) a b =
          ((fun n => ((lseq n).map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod a b) : R) := by
        rw [hl_prod, hlseq_prod]
      exact germ_coe_eq.mp (h1.symm.trans h2)
    have hall_entries : ∀ᶠ n in (U : Filter ℕ), ∀ a b : Fin 3,
        (((B n i)⁻¹ * B n j : SpecialLinearGroup (Fin 3) ℤ).1) a b =
          ((lseq n).map fun e => Matrix.transvection e.1 e.2.1 e.2.2).prod a b := by
      rw [Filter.eventually_all]
      intro a
      rw [Filter.eventually_all]
      exact fun b => hentry a b
    have hcomb := hall_entries.and (eventually_ge_U l.length)
    obtain ⟨n, hmat, hn_ge⟩ := hcomb.exists
    have htp : IsTransvProd n ((B n i)⁻¹ * B n j) :=
      ⟨lseq n, by rw [hlseq_len n]; exact hn_ge, hlseq_ne hl_ne n, Matrix.ext hmat⟩
    exact hB n i j hlt htp
  have hinj : Function.Injective qmap := by
    intro i j hij
    rcases lt_trichotomy i j with hlt | rfl | hgt
    · exact absurd hij (hlt_ne i j hlt)
    · rfl
    · exact absurd hij.symm (hlt_ne j i hgt)
  obtain ⟨φ, hφ⟩ := hsurj
  obtain ⟨ψ, hψ⟩ := hφ.hasRightInverse
  have hcomp_inj : Function.Injective (ψ ∘ qmap) := by
    intro i j hij
    apply hinj
    have := congrArg φ hij
    simpa [Function.comp_apply, hψ (qmap i), hψ (qmap j)] using this
  have hcard := Fintype.card_le_of_injective (ψ ∘ qmap) hcomp_inj
  simp at hcard

end UltrapowerRing

noncomputable section MennickeSymbol

abbrev C : Type := SpecialLinearGroup (Fin 3) R ⧸ E3 R

def π : SpecialLinearGroup (Fin 3) R →* C := QuotientGroup.mk' (E3 R)

lemma π_eq_one_of_mem {g : SpecialLinearGroup (Fin 3) R} (hg : g ∈ E3 R) : π g = 1 :=
  (QuotientGroup.eq_one_iff g).mpr hg

lemma π_tv (i j : Fin 3) (h : i ≠ j) (c : R) : π (tv i j h c) = 1 :=
  π_eq_one_of_mem (tv_mem_E3 i j h c)

lemma π_iota_eq_of_first_row (M₁ M₂ : SpecialLinearGroup (Fin 2) R)
    (h00 : M₁.1 0 0 = M₂.1 0 0) (h01 : M₁.1 0 1 = M₂.1 0 1) :
    π (iota M₁) = π (iota M₂) := by
  have hdet₁ := sl2_det_eq M₁
  have hdet₂ := sl2_det_eq M₂
  rw [← h00, ← h01] at hdet₂
  let t : R := M₂.1 1 0 * M₁.1 1 1 - M₂.1 1 1 * M₁.1 1 0
  have hrel : iota M₂ = tv 1 0 (by decide) t * iota M₁ := by
    ext i j
    change iotaMat M₂.1 i j = (tvM 1 0 t * iotaMat M₁.1) i j
    simp only [iotaMat, tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp [t]
    · exact h00.symm
    · exact h01.symm
    · linear_combination -M₂.1 1 0 * hdet₁ + M₁.1 1 0 * hdet₂
    · linear_combination -M₂.1 1 1 * hdet₁ + M₁.1 1 1 * hdet₂
  have := congrArg π hrel
  rw [map_mul, π_tv, one_mul] at this
  exact this.symm

/- Mennicke symbol `men a b h ∈ C` for coprime `a, b : R`. -/
def men (a b : R) (h : IsCoprime a b) : C :=
  π (iota (mkSL2 a b (-h.choose_spec.choose) h.choose (by
    have hspec := h.choose_spec.choose_spec
    linear_combination hspec)))

lemma men_eq_of_det {a b c d : R} (hdet : a * d - b * c = 1) (h : IsCoprime a b) :
    men a b h = π (iota (mkSL2 a b c d hdet)) := by
  unfold men
  exact π_iota_eq_of_first_row _ _ rfl rfl

lemma exists_men_eq (x : C) : ∃ (a b : R) (h : IsCoprime a b), x = men a b h := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (E3 R) x
  obtain ⟨L, R', hL, hR', M, rfl⟩ := sr2_reduction sr2_R g
  have hdet := sl2_det_eq M
  have hcop : IsCoprime (M.1 0 0) (M.1 0 1) := ⟨M.1 1 1, -M.1 1 0, by linear_combination hdet⟩
  refine ⟨M.1 0 0, M.1 0 1, hcop, ?_⟩
  rw [men_eq_of_det hdet hcop]
  have hMeq : mkSL2 (M.1 0 0) (M.1 0 1) (M.1 1 0) (M.1 1 1) hdet = M := by
    ext i j; fin_cases i <;> fin_cases j <;> rfl
  rw [hMeq]
  change π (L * iota M * R') = π (iota M)
  rw [map_mul, map_mul, π_eq_one_of_mem hL, π_eq_one_of_mem hR', one_mul, mul_one]

lemma men_add_right {a b : R} (t : R) (h : IsCoprime a b) (h' : IsCoprime a (b + t * a)) :
    men a (b + t * a) h' = men a b h := by
  obtain ⟨d, y, hdy⟩ := id h
  let c := -y
  have hdet : a * d - b * c = 1 := by linear_combination hdy
  have hdet' : a * (d + t * c) - (b + t * a) * c = 1 := by linear_combination hdet
  rw [men_eq_of_det hdet h, men_eq_of_det hdet' h']
  have hmul : mkSL2 a (b + t * a) c (d + t * c) hdet' =
      mkSL2 a b c d hdet * mkSL2 1 t 0 1 (by ring) := by
    ext i j
    change (mkSL2 a (b + t * a) c (d + t * c) hdet').1 i j =
      ((mkSL2 a b c d hdet).1 * (mkSL2 1 t 0 1 (by ring)).1) i j
    rw [Matrix.mul_apply, Fin.sum_univ_two]
    fin_cases i <;> fin_cases j <;> simp [mkSL2] <;> ring
  rw [hmul, map_mul, map_mul, iota_tv01, π_tv, mul_one]

lemma men_add_left {a b : R} (t : R) (h : IsCoprime a b) (h' : IsCoprime (a + t * b) b) :
    men (a + t * b) b h' = men a b h := by
  obtain ⟨d, y, hdy⟩ := id h
  let c := -y
  have hdet : a * d - b * c = 1 := by linear_combination hdy
  have hdet' : (a + t * b) * d - b * (c + t * d) = 1 := by linear_combination hdet
  rw [men_eq_of_det hdet h, men_eq_of_det hdet' h']
  have hmul : mkSL2 (a + t * b) b (c + t * d) d hdet' =
      mkSL2 a b c d hdet * mkSL2 1 0 t 1 (by ring) := by
    ext i j
    change (mkSL2 (a + t * b) b (c + t * d) d hdet').1 i j =
      ((mkSL2 a b c d hdet).1 * (mkSL2 1 0 t 1 (by ring)).1) i j
    rw [Matrix.mul_apply, Fin.sum_univ_two]
    fin_cases i <;> fin_cases j <;> simp [mkSL2] <;> ring
  rw [hmul, map_mul, map_mul, iota_tv10, π_tv, mul_one]

lemma men_eq_of_dvd_right {a b₁ b₂ : R} (hdvd : a ∣ (b₂ - b₁))
    (h₁ : IsCoprime a b₁) (h₂ : IsCoprime a b₂) :
    men a b₂ h₂ = men a b₁ h₁ := by
  rcases hdvd with ⟨t, ht⟩
  have hb₂ : b₂ = b₁ + t * a := by linear_combination ht
  subst hb₂
  exact men_add_right t h₁ h₂

lemma men_eq_of_dvd_left {a₁ a₂ b : R} (hdvd : b ∣ (a₂ - a₁))
    (h₁ : IsCoprime a₁ b) (h₂ : IsCoprime a₂ b) :
    men a₂ b h₂ = men a₁ b h₁ := by
  rcases hdvd with ⟨t, ht⟩
  have ha₂ : a₂ = a₁ + t * b := by linear_combination ht
  subst ha₂
  exact men_add_left t h₁ h₂

/- MS2a: `men a b₁ * men a b₂ = men a (b₁ * b₂)` via the explicit 4-transvection 3x3 identity. -/
lemma men_mul_right {a b₁ b₂ : R} (h₁ : IsCoprime a b₁) (h₂ : IsCoprime a b₂) :
    men a b₁ h₁ * men a b₂ h₂ = men a (b₁ * b₂) (h₁.mul_right h₂) := by
  obtain ⟨d₁, y₁, hdy₁⟩ := id h₁
  obtain ⟨d₂, y₂, hdy₂⟩ := id h₂
  let c₁ := -y₁
  let c₂ := -y₂
  have hdet₁ : a * d₁ - b₁ * c₁ = 1 := by linear_combination hdy₁
  have hdet₂ : a * d₂ - b₂ * c₂ = 1 := by linear_combination hdy₂
  have hdet₃ : a * (d₂ - c₂ * d₁ * b₂) - (b₁ * b₂) * (-c₁ * c₂) = 1 := by
    linear_combination hdet₂ - c₂ * b₂ * hdet₁
  rw [men_eq_of_det hdet₁ h₁, men_eq_of_det hdet₂ h₂, men_eq_of_det hdet₃ (h₁.mul_right h₂)]
  let A₁ : SpecialLinearGroup (Fin 3) R := iota (mkSL2 a b₁ c₁ d₁ hdet₁)
  let A₂ : SpecialLinearGroup (Fin 3) R := iota (mkSL2 a b₂ c₂ d₂ hdet₂)
  let P : SpecialLinearGroup (Fin 3) R := S01 * S12
  have hP_mem : P ∈ E3 R := Subgroup.mul_mem _ S01_mem_E3 S12_mem_E3
  have hP_val : P.1 = !![0, 0, 1; -1, 0, 0; 0, -1, 0] := by
    ext i j
    change ((S01 : SpecialLinearGroup (Fin 3) R).1 * (S12 : SpecialLinearGroup (Fin 3) R).1) i j = _
    rw [S01_eq_iota, iota_val, S12_val]
    simp only [iotaMat, mkSL2, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp
  have hP_inv_val : (P⁻¹ : SpecialLinearGroup (Fin 3) R).1 = !![0, -1, 0; 0, 0, -1; 1, 0, 0] := by
    let Q : SpecialLinearGroup (Fin 3) R := ⟨!![0, -1, 0; 0, 0, -1; 1, 0, 0], by
      rw [Matrix.det_fin_three]; simp⟩
    have hinv : P⁻¹ = Q := by
      apply inv_eq_of_mul_eq_one_right
      ext i j
      change (P.1 * Q.1) i j = (1 : Matrix (Fin 3) (Fin 3) R) i j
      rw [hP_val]
      simp only [Q, Matrix.mul_apply, Fin.sum_univ_three]
      fin_cases i <;> fin_cases j <;> simp
    rw [hinv]
  let A₂' : SpecialLinearGroup (Fin 3) R := P * A₂ * P⁻¹
  have hA₂'_val : A₂'.1 = !![1, 0, 0; 0, a, b₂; 0, c₂, d₂] := by
    ext i j
    change ((P.1 * A₂.1) * (P⁻¹ : SpecialLinearGroup (Fin 3) R).1) i j = _
    rw [hP_val, hP_inv_val]
    have hA₂_val : A₂.1 = iotaMat !![a, b₂; c₂, d₂] := rfl
    rw [hA₂_val]
    simp only [iotaMat, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp
  let W : SpecialLinearGroup (Fin 3) R := A₁ * A₂'
  let W₄ : SpecialLinearGroup (Fin 3) R :=
    tv 2 1 (by decide) (-c₂) * W *
    tv 0 1 (by decide) (-b₁) * tv 1 0 (by decide) (-c₁) * tv 1 2 (by decide) (-d₁ * b₂)
  have hW_val : W.1 = !![a, b₁ * a, b₁ * b₂; c₁, d₁ * a, d₁ * b₂; 0, c₂, d₂] := by
    ext i j
    change (A₁.1 * A₂'.1) i j = _
    have hA₁_val : A₁.1 = iotaMat !![a, b₁; c₁, d₁] := rfl
    rw [hA₁_val, hA₂'_val]
    simp only [iotaMat, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp
  have hW₄_val : W₄.1 = !![a, 0, b₁ * b₂; 0, 1, 0; -c₁ * c₂, 0, d₂ - c₂ * d₁ * b₂] := by
    ext i j
    change ((((tvM 2 1 (-c₂) * W.1) * tvM 0 1 (-b₁)) *
      tvM 1 0 (-c₁)) * tvM 1 2 (-d₁ * b₂)) i j = _
    rw [hW_val]
    simp only [tvM, Matrix.transvection, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp [-mul_eq_zero] <;>
      (first
        | ring1
        | linear_combination -c₁ * hdet₁
        | linear_combination hdet₁
        | linear_combination -d₁ * b₂ * hdet₁
        | linear_combination c₂ * c₁ * hdet₁
        | linear_combination -c₂ * hdet₁
        | linear_combination c₂ * d₁ * b₂ * hdet₁)
  have hconj : S12 * W₄ * S12⁻¹ = iota (mkSL2 a (b₁ * b₂) (-c₁ * c₂) (d₂ - c₂ * d₁ * b₂) hdet₃) := by
    ext i j
    change (((S12 : SpecialLinearGroup (Fin 3) R).1 * W₄.1) *
      ((S12 : SpecialLinearGroup (Fin 3) R)⁻¹ : SpecialLinearGroup (Fin 3) R).1) i j =
      iotaMat (mkSL2 a (b₁ * b₂) (-c₁ * c₂) (d₂ - c₂ * d₁ * b₂) hdet₃).1 i j
    rw [S12_val, S12_inv_val, hW₄_val]
    simp only [iotaMat, mkSL2, Matrix.mul_apply, Fin.sum_univ_three]
    fin_cases i <;> fin_cases j <;> simp
  have hπW₄ : π (S12 * W₄ * S12⁻¹) = π A₁ * π A₂ := by
    simp only [W₄, W, A₂', map_mul, map_inv, π_tv, π_eq_one_of_mem S12_mem_E3,
      π_eq_one_of_mem hP_mem, one_mul, mul_one, inv_one]
  rw [← hconj, hπW₄]

lemma men_one_left (b : R) (h : IsCoprime 1 b) : men 1 b h = 1 := by
  rw [men_eq_of_det (c := 0) (d := 1) (by ring) h, iota_tv01, π_tv]

lemma men_one_right (a : R) (h : IsCoprime a 1) : men a 1 h = 1 := by
  have h1 : men a 1 h = men (a + (1 - a) * 1) 1 (by simpa using isCoprime_one_left) :=
    (men_add_left (1 - a) h (by simpa using isCoprime_one_left)).symm
  rw [h1]
  have ha : a + (1 - a) * 1 = 1 := by ring
  simpa [ha] using men_one_left 1 isCoprime_one_left

lemma men_unit_right (a : R) (u : Rˣ) (h : IsCoprime a (u : R)) : men a (u : R) h = 1 := by
  have hval : a + ((1 - a) * (u⁻¹ : Rˣ)) * (u : R) = 1 := by
    calc a + ((1 - a) * (u⁻¹ : Rˣ)) * (u : R)
        = a + (1 - a) * ((u⁻¹ : Rˣ) * (u : R) : R) := by ring
      _ = a + (1 - a) * 1 := by rw [Units.inv_mul]
      _ = 1 := by ring
  have h1 := (men_add_left ((1 - a) * (u⁻¹ : Rˣ)) h (by rw [hval]; exact isCoprime_one_left)).symm
  rw [h1]
  simpa [hval] using men_one_left (u : R) isCoprime_one_left

lemma men_unit_left (u : Rˣ) (b : R) (h : IsCoprime (u : R) b) : men (u : R) b h = 1 := by
  have hval : b + ((1 - b) * (u⁻¹ : Rˣ)) * (u : R) = 1 := by
    calc b + ((1 - b) * (u⁻¹ : Rˣ)) * (u : R)
        = b + (1 - b) * ((u⁻¹ : Rˣ) * (u : R) : R) := by ring
      _ = b + (1 - b) * 1 := by rw [Units.inv_mul]
      _ = 1 := by ring
  have h1 := (men_add_right ((1 - b) * (u⁻¹ : Rˣ)) h (by rw [hval]; exact isCoprime_one_right)).symm
  rw [h1]
  simpa [hval] using men_one_right (u : R) isCoprime_one_right

lemma men_neg_one_right (a : R) (h : IsCoprime a (-1)) : men a (-1) h = 1 :=
  men_unit_right a (-1 : Rˣ) h

/- Symmetry: `men a b = men b a`. -/
lemma men_symm {a b : R} (h : IsCoprime a b) : men a b h = men b a h.symm := by
  have h1 : IsCoprime a (b + (-1) * a) := by simpa using h.add_mul_right_right (-1)
  have h3 : IsCoprime b (b + (-1) * a) := by
    have htmp : IsCoprime b (-a + 1 * b) := h.symm.neg_right.add_mul_right_right 1
    have heq : -a + 1 * b = b + (-1) * a := by ring
    rwa [heq] at htmp
  have h2 : IsCoprime (a + 1 * (b + (-1) * a)) (b + (-1) * a) := by
    have heq : a + 1 * (b + (-1) * a) = b := by ring
    rwa [heq]
  have h5 : IsCoprime b (-a) := h.symm.neg_right
  have h4 : IsCoprime b ((b + (-1) * a) + (-1) * b) := by
    have heq : (b + (-1) * a) + (-1) * b = -a := by ring
    rwa [heq]
  calc men a b h
      = men a (b + (-1) * a) h1 := (men_add_right (-1) h h1).symm
    _ = men (a + 1 * (b + (-1) * a)) (b + (-1) * a) h2 := (men_add_left 1 h1 h2).symm
    _ = men b (b + (-1) * a) h3 := by
        have : a + 1 * (b + (-1) * a) = b := by ring
        congr 1
    _ = men b ((b + (-1) * a) + (-1) * b) h4 := (men_add_right (-1) h3 h4).symm
    _ = men b (-a) h5 := by
        have : (b + (-1) * a) + (-1) * b = -a := by ring
        congr 1
    _ = men b ((-1) * a) (isCoprime_one_right.neg_right.mul_right h.symm) := by
        congr 1; ring
    _ = men b (-1) isCoprime_one_right.neg_right * men b a h.symm :=
        (men_mul_right isCoprime_one_right.neg_right h.symm).symm
    _ = 1 * men b a h.symm := by rw [men_neg_one_right]
    _ = men b a h.symm := one_mul _

/- MS2b: `men (a₁ * a₂) b = men a₁ b * men a₂ b`. -/
lemma men_mul_left {a₁ a₂ b : R} (h₁ : IsCoprime a₁ b) (h₂ : IsCoprime a₂ b) :
    men a₁ b h₁ * men a₂ b h₂ = men (a₁ * a₂) b (h₁.mul_left h₂) := by
  rw [men_symm h₁, men_symm h₂, men_mul_right h₁.symm h₂.symm, men_symm (h₁.mul_left h₂)]

lemma men_pow_left {a b : R} (h : IsCoprime a b) (k : ℕ) :
    men (a ^ k) b (h.pow_left) = (men a b h) ^ k := by
  induction k with
  | zero =>
    simpa [pow_zero] using men_one_left b isCoprime_one_left
  | succ k ih =>
    have hmul : a ^ (k + 1) = a ^ k * a := pow_succ a k
    calc men (a ^ (k + 1)) b h.pow_left
        = men (a ^ k * a) b (h.pow_left.mul_left h) := by congr 1
      _ = men (a ^ k) b h.pow_left * men a b h := (men_mul_left h.pow_left h).symm
      _ = (men a b h) ^ k * men a b h := by rw [ih]
      _ = (men a b h) ^ (k + 1) := (pow_succ _ k).symm

lemma men_inv_of_det {a b c d : R} (hdet : a * d - b * c = 1)
    (hab : IsCoprime a b) (hac : IsCoprime a c) :
    men a c hac = (men a b hab)⁻¹ := by
  apply eq_inv_of_mul_eq_one_right
  rw [men_mul_right hab hac]
  have hbc : b * c = (-1) + d * a := by linear_combination -hdet
  have h1 : men a (b * c) (hab.mul_right hac) =
      men a ((-1) + d * a) (by rw [← hbc]; exact hab.mul_right hac) := by
    congr 1
  rw [h1, men_add_right d isCoprime_one_right.neg_right, men_neg_one_right]

/- `C` is abelian, via `sr1_R` and 1-line CRT. -/
lemma C_mul_comm (x y : C) : x * y = y * x := by
  obtain ⟨a₁, b₁, h₁, rfl⟩ := exists_men_eq x
  obtain ⟨a₂, b₂, h₂, rfl⟩ := exists_men_eq y
  by_cases ha₁ : a₁ = 0
  · subst ha₁
    obtain ⟨u, v, huv⟩ := id h₁
    simp only [mul_zero, zero_add] at huv
    have hu : IsUnit b₁ := isUnit_iff_exists_inv.mpr ⟨v, by rw [mul_comm]; exact huv⟩
    have hm : men 0 b₁ h₁ = 1 := by
      have := men_unit_right 0 hu.unit (by simpa [hu.unit_spec] using h₁)
      simpa [hu.unit_spec] using this
    rw [hm, one_mul, mul_one]
  · obtain ⟨t, ht⟩ := sr1_R a₂ b₂ a₁ h₂ ha₁
    let a₂' := a₂ + t * b₂
    have h₂' : IsCoprime a₂' b₂ := by simpa [a₂', add_comm] using h₂.add_mul_left_left t
    have hy : men a₂ b₂ h₂ = men a₂' b₂ h₂' := (men_add_left t h₂ h₂').symm
    obtain ⟨u, v, huv⟩ := ht.symm
    let z : R := b₂ * (u * a₁) + b₁ * (v * a₂')
    have hz1 : a₁ ∣ (z - b₁) := ⟨(b₂ - b₁) * u, by
      have hv : v * a₂' = 1 - u * a₁ := by linear_combination huv
      calc z - b₁ = b₂ * (u * a₁) + b₁ * (v * a₂') - b₁ := rfl
        _ = b₂ * (u * a₁) + b₁ * (1 - u * a₁) - b₁ := by rw [hv]
        _ = a₁ * ((b₂ - b₁) * u) := by ring⟩
    have hz2 : a₂' ∣ (z - b₂) := ⟨(b₁ - b₂) * v, by
      have hu : u * a₁ = 1 - v * a₂' := by linear_combination huv
      calc z - b₂ = b₂ * (u * a₁) + b₁ * (v * a₂') - b₂ := rfl
        _ = b₂ * (1 - v * a₂') + b₁ * (v * a₂') - b₂ := by rw [hu]
        _ = a₂' * ((b₁ - b₂) * v) := by ring⟩
    have hcop1 : IsCoprime a₁ z := by
      rcases hz1 with ⟨k, hk⟩
      have : z = b₁ + k * a₁ := by linear_combination hk
      rw [this]; exact h₁.add_mul_right_right k
    have hcop2 : IsCoprime a₂' z := by
      rcases hz2 with ⟨k, hk⟩
      have : z = b₂ + k * a₂' := by linear_combination hk
      rw [this]; exact h₂'.add_mul_right_right k
    have hx_eq : men a₁ b₁ h₁ = men a₁ z hcop1 := (men_eq_of_dvd_right hz1 h₁ hcop1).symm
    have hy_eq : men a₂ b₂ h₂ = men a₂' z hcop2 := hy.trans (men_eq_of_dvd_right hz2 h₂' hcop2).symm
    rw [hx_eq, hy_eq, men_mul_left hcop1 hcop2, men_mul_left hcop2 hcop1]
    congr 1
    ring

/- Centralizer square lemma: if `f I + g M ∈ SL(2, R)` and `b ∣ (f + g a - 1)`, then `men ((f + g a)^2) c = 1`. -/
lemma men_centralizer_sq {a b c d f g : R}
    (hdetM : a * d - b * c = 1)
    (hdetN : (f + g * a) * (f + g * d) - (g * b) * (g * c) = 1)
    (hb : b ∣ (f + g * a - 1))
    (hxc2 : IsCoprime ((f + g * a) ^ 2) c) :
    men ((f + g * a) ^ 2) c hxc2 = 1 := by
  let x := f + g * a
  have hxgc : IsCoprime x (g * c) := ⟨f + g * d, -(g * b), by linear_combination hdetN⟩
  have hxgb : IsCoprime x (g * b) := ⟨f + g * d, -(g * c), by linear_combination hdetN⟩
  have hxg : IsCoprime x g := hxgc.of_mul_right_left
  have hxc : IsCoprime x c := hxgc.of_mul_right_right
  have hxb : IsCoprime x b := hxgb.of_mul_right_right
  have hg_dvd : g ∣ (x ^ 2 - 1) := by
    refine ⟨f * (a - d) + g * (a ^ 2 - 1), ?_⟩
    simp only [x]
    linear_combination hdetN - g ^ 2 * hdetM
  have hx_g_sq : (men x g hxg) ^ 2 = 1 := by
    rw [← men_pow_left hxg 2]
    have h1 : men (x ^ 2) g hxg.pow_left = men 1 g isCoprime_one_left :=
      men_eq_of_dvd_left (by simpa [sub_eq_add_neg] using hg_dvd) isCoprime_one_left hxg.pow_left
    rw [h1, men_one_left]
  have hx_b : men x b hxb = 1 := by
    have h1 : men x b hxb = men 1 b isCoprime_one_left :=
      men_eq_of_dvd_left hb isCoprime_one_left hxb
    rw [h1, men_one_left]
  have hx_gb_sq : (men x (g * b) hxgb) ^ 2 = 1 := by
    rw [← men_mul_right hxg hxb, hx_b, mul_one, hx_g_sq]
  have hx_gc_inv : men x (g * c) hxgc = (men x (g * b) hxgb)⁻¹ :=
    men_inv_of_det hdetN hxgb hxgc
  have hx_gc_sq : (men x (g * c) hxgc) ^ 2 = 1 := by
    rw [hx_gc_inv, inv_pow, hx_gb_sq, inv_one]
  change men (x ^ 2) c hxc2 = 1
  rw [men_pow_left hxc 2]
  have hsplit : (men x (g * c) hxgc) ^ 2 = (men x g hxg) ^ 2 * (men x c hxc) ^ 2 := by
    rw [← men_mul_right hxg hxc]
    have hcomm := C_mul_comm (men x g hxg) (men x c hxc)
    calc (men x g hxg * men x c hxc) ^ 2
        = (men x g hxg * men x c hxc) * (men x g hxg * men x c hxc) := sq _
      _ = men x g hxg * (men x c hxc * men x g hxg) * men x c hxc := by group
      _ = men x g hxg * (men x g hxg * men x c hxc) * men x c hxc := by rw [← hcomm]
      _ = (men x g hxg) ^ 2 * (men x c hxc) ^ 2 := by rw [sq, sq]; group
  rw [hsplit, hx_g_sq, one_mul] at hx_gc_sq
  exact hx_gc_sq

end MennickeSymbol

section Exponent24

/- Self-contained CRT over a `Finset` in `ℤ`. -/
lemma crt_finset {ι : Type*} [DecidableEq ι] (s : Finset ι) (m : ι → ℕ) (a : ι → ℤ)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → Nat.Coprime (m i) (m j)) :
    ∃ x : ℤ, ∀ i ∈ s, x ≡ a i [ZMOD (m i : ℤ)] := by
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert i s hi ih =>
    have hcop_s : ∀ j ∈ s, ∀ k ∈ s, j ≠ k → Nat.Coprime (m j) (m k) := fun j hj k hk hne =>
      hcop j (Finset.mem_insert_of_mem hj) k (Finset.mem_insert_of_mem hk) hne
    obtain ⟨x₀, hx₀⟩ := ih hcop_s
    let P : ℕ := ∏ j ∈ s, m j
    have hmiP : Nat.Coprime (m i) P :=
      Nat.Coprime.prod_right fun j hj =>
        hcop i (Finset.mem_insert_self i s) j (Finset.mem_insert_of_mem hj) (fun h => hi (h ▸ hj))
    have hcopZ : IsCoprime (m i : ℤ) (P : ℤ) :=
      Int.isCoprime_iff_nat_coprime.mpr (by simpa using hmiP)
    obtain ⟨u, v, huv⟩ := hcopZ
    refine ⟨x₀ * (u * (m i : ℤ)) + a i * (v * (P : ℤ)), fun k hk => ?_⟩
    rcases Finset.mem_insert.mp hk with hki | hks
    · rw [hki, Int.modEq_iff_dvd]
      refine ⟨(a i - x₀) * u, ?_⟩
      have hvP : v * (P : ℤ) = 1 - u * (m i : ℤ) := by linear_combination huv
      calc a i - (x₀ * (u * (m i : ℤ)) + a i * (v * (P : ℤ)))
          = a i - (x₀ * (u * (m i : ℤ)) + a i * (1 - u * (m i : ℤ))) := by rw [hvP]
        _ = (m i : ℤ) * ((a i - x₀) * u) := by ring
    · have hmkP : (m k : ℤ) ∣ (P : ℤ) :=
        Int.natCast_dvd_natCast.mpr (Finset.dvd_prod_of_mem m hks)
      have hcong : x₀ * (u * (m i : ℤ)) + a i * (v * (P : ℤ)) ≡ x₀ [ZMOD (m k : ℤ)] := by
        rw [Int.modEq_iff_dvd]
        have huM : u * (m i : ℤ) = 1 - v * (P : ℤ) := by linear_combination huv
        have hdiff : x₀ - (x₀ * (u * (m i : ℤ)) + a i * (v * (P : ℤ))) =
            (P : ℤ) * ((x₀ - a i) * v) := by
          rw [huM]; ring
        rw [hdiff]
        exact dvd_mul_of_dvd_left hmkP _
      exact hcong.trans (hx₀ k hks)

/- Nonnegative powers of `M ∈ SL(2, ℤ)` lie in `ℤ·I + ℤ·M` by Cayley-Hamilton. -/
lemma sl2_pow_linear (M : Matrix (Fin 2) (Fin 2) ℤ) (hdet : M.det = 1) (k : ℕ) :
    ∃ f g : ℤ, M ^ k = f • (1 : Matrix (Fin 2) (Fin 2) ℤ) + g • M := by
  have hch : M * M = (M 0 0 + M 1 1) • M - (1 : Matrix (Fin 2) (Fin 2) ℤ) := by
    rw [Matrix.det_fin_two] at hdet
    ext i j
    rw [Matrix.mul_apply, Fin.sum_univ_two]
    simp only [Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
    fin_cases i <;> fin_cases j <;> simp only [↓reduceIte, Fin.zero_eta, Fin.mk_one,
      Fin.isValue, Fin.reduceEq, sub_zero]
    · linear_combination -hdet
    · ring
    · ring
    · linear_combination -hdet
  induction k with
  | zero => exact ⟨1, 0, by simp⟩
  | succ k ih =>
    rcases ih with ⟨f, g, hfg⟩
    refine ⟨-g, f + g * (M 0 0 + M 1 1), ?_⟩
    rw [pow_succ, hfg, add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hch]
    ext i j
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
    ring

/- Modulo the `(1, 0)` entry `c`, `(M^k) 0 0 ≡ a^k (mod c)`. -/
lemma sl2_pow_mod_c (a b c d : ℤ) (k : ℕ) :
    ((!![a, b; c, d] : Matrix (Fin 2) (Fin 2) ℤ) ^ k) 0 0 ≡ a ^ k [ZMOD c] ∧
    ((!![a, b; c, d] : Matrix (Fin 2) (Fin 2) ℤ) ^ k) 1 0 ≡ 0 [ZMOD c] := by
  let M : Matrix (Fin 2) (Fin 2) ℤ := !![a, b; c, d]
  induction k with
  | zero => simp [Int.ModEq.refl]
  | succ k ih =>
    rcases ih with ⟨h00, h10⟩
    rw [pow_succ, pow_succ]
    constructor
    · change (M ^ k * M) 0 0 ≡ a ^ k * a [ZMOD c]
      rw [Matrix.mul_apply, Fin.sum_univ_two]
      have hMc : M 1 0 ≡ 0 [ZMOD c] := by
        change c ≡ 0 [ZMOD c]
        exact Int.modEq_zero_iff_dvd.mpr dvd_rfl
      have hMa : M 0 0 = a := rfl
      rw [hMa]
      simpa using (h00.mul_right a).add (hMc.mul_left ((M ^ k) 0 1))
    · change (M ^ k * M) 1 0 ≡ 0 [ZMOD c]
      rw [Matrix.mul_apply, Fin.sum_univ_two]
      have hMc : M 1 0 ≡ 0 [ZMOD c] := Int.modEq_zero_iff_dvd.mpr dvd_rfl
      have hMa : M 0 0 = a := rfl
      rw [hMa]
      simpa using (h10.mul_right a).add (hMc.mul_left ((M ^ k) 1 1))

/- Modulo the `(0, 1)` entry `b`, `(M^k) 0 0 ≡ a^k (mod b)`. -/
lemma sl2_pow_mod_b (a b c d : ℤ) (k : ℕ) :
    ((!![a, b; c, d] : Matrix (Fin 2) (Fin 2) ℤ) ^ k) 0 0 ≡ a ^ k [ZMOD b] ∧
    ((!![a, b; c, d] : Matrix (Fin 2) (Fin 2) ℤ) ^ k) 0 1 ≡ 0 [ZMOD b] := by
  let M : Matrix (Fin 2) (Fin 2) ℤ := !![a, b; c, d]
  induction k with
  | zero => simp [Int.ModEq.refl]
  | succ k ih =>
    rcases ih with ⟨h00, h01⟩
    rw [pow_succ, pow_succ]
    constructor
    · change (M ^ k * M) 0 0 ≡ a ^ k * a [ZMOD b]
      rw [Matrix.mul_apply, Fin.sum_univ_two]
      have hMa : M 0 0 = a := rfl
      rw [hMa]
      simpa using (h00.mul_right a).add (h01.mul_right (M 1 0))
    · change (M ^ k * M) 0 1 ≡ 0 [ZMOD b]
      rw [Matrix.mul_apply, Fin.sum_univ_two]
      have hMb : M 0 1 ≡ 0 [ZMOD b] := Int.modEq_zero_iff_dvd.mpr dvd_rfl
      simpa using (hMb.mul_left ((M ^ k) 0 0)).add (h01.mul_right (M 1 1))

lemma dvd_12_of_no_bad_prime_pow {d : ℕ} (hd : 0 < d)
    (h8 : ¬ (8 ∣ d)) (h9 : ¬ (9 ∣ d)) (hge5 : ∀ p : ℕ, p.Prime → 5 ≤ p → ¬ (p ∣ d)) :
    d ∣ 12 := by
  have hd0 : d ≠ 0 := Nat.ne_of_gt hd
  have h12 : (12 : ℕ) ≠ 0 := by decide
  rw [← Nat.factorization_le_iff_dvd hd0 h12]
  intro p
  by_cases hp : p.Prime
  · have h235 : p = 2 ∨ p = 3 ∨ 5 ≤ p := by
      have hp2 := hp.two_le
      by_cases h2 : p = 2
      · exact Or.inl h2
      · by_cases h3 : p = 3
        · exact Or.inr (Or.inl h3)
        · have h4 : p ≠ 4 := fun h => by subst h; exact absurd hp (by decide)
          omega
    rcases h235 with rfl | rfl | h5
    · have hf12 : (12 : ℕ).factorization 2 = 2 := by
        rw [show (12 : ℕ) = 2 ^ 2 * 3 ^ 1 by norm_num,
          Nat.factorization_mul (by decide) (by decide), Finsupp.add_apply,
          Nat.Prime.factorization_pow Nat.prime_two,
          Nat.Prime.factorization_pow Nat.prime_three]
        simp
      rw [hf12]
      by_contra hgt
      have hge3 : 3 ≤ d.factorization 2 := by omega
      have h23 : 2 ^ 3 ∣ d := (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_two hd0).mpr hge3
      exact h8 h23
    · have hf12 : (12 : ℕ).factorization 3 = 1 := by
        rw [show (12 : ℕ) = 2 ^ 2 * 3 ^ 1 by norm_num,
          Nat.factorization_mul (by decide) (by decide), Finsupp.add_apply,
          Nat.Prime.factorization_pow Nat.prime_two,
          Nat.Prime.factorization_pow Nat.prime_three]
        simp
      rw [hf12]
      by_contra hgt
      have hge2 : 2 ≤ d.factorization 3 := by omega
      have h32 : 3 ^ 2 ∣ d := (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_three hd0).mpr hge2
      exact h9 h32
    · have hf0 : d.factorization p = 0 :=
        Nat.factorization_eq_zero_of_not_dvd (hge5 p hp h5)
      rw [hf0]
      exact Nat.zero_le _
  · rw [Nat.factorization_eq_zero_of_not_prime d hp]
    exact Nat.zero_le _

lemma prime_pow_dvd_lcm_iff {p e u v : ℕ} (hp : p.Prime) (hu : u ≠ 0) (hv : v ≠ 0) :
    p ^ e ∣ Nat.lcm u v ↔ p ^ e ∣ u ∨ p ^ e ∣ v := by
  have hlcm0 : Nat.lcm u v ≠ 0 := Nat.lcm_ne_zero hu hv
  rw [hp.pow_dvd_iff_le_factorization hlcm0, hp.pow_dvd_iff_le_factorization hu,
    hp.pow_dvd_iff_le_factorization hv, Nat.factorization_lcm hu hv, Finsupp.sup_apply]
  exact le_sup_iff

/- Two-prime Dirichlet trick in `ℤ`. -/
lemma two_prime_dirichlet (a b : ℤ) (hab : IsCoprime a b) (ha : a ≠ 0) (N : ℕ) (hN : 0 < N) :
    ∃ (k : ℤ) (α₂ : ℕ), 0 < α₂ ∧ Nat.gcd N α₂ ∣ 12 ∧ (b + k * a) ∣ (a ^ α₂ - 1) := by
  let q : ℕ := a.natAbs
  have hq : 0 < q := Int.natAbs_pos.mpr ha
  have h6N : (6 * N : ℤ) ≠ 0 := by omega
  obtain ⟨t₀, ht₀⟩ := sr2_int b (6 * N : ℤ) a (by
    obtain ⟨u, v, huv⟩ := hab
    exact ⟨v, 0, u, by linear_combination huv⟩) h6N
  let b₀ : ℤ := b + t₀ * a
  have hb₀_q : IsCoprime b₀ (q : ℤ) := by
    have : IsCoprime b₀ a := by simpa [b₀, add_comm] using hab.symm.add_mul_left_left t₀
    exact Int.isCoprime_iff_nat_coprime.mpr (by
      rw [Int.natAbs_natCast]; exact Int.isCoprime_iff_nat_coprime.mp this)
  let P : Finset ℕ := (6 * N).primeFactors
  let ex : ℕ → ℕ := fun r => if r = 2 then 3 else if r = 3 then 2 else 1
  let mp : ℕ → ℕ := fun r => r ^ ex r
  have hchoice : ∀ r ∈ P, ∃ x : ℤ,
      IsCoprime x (mp r : ℤ) ∧ ¬ ((mp r : ℤ) ∣ (x - 1)) ∧ ¬ ((mp r : ℤ) ∣ (x - b₀)) := by
    intro r hr
    have hrp : r.Prime := Nat.prime_of_mem_primeFactors hr
    by_cases h2 : r = 2
    · subst h2
      have hmp : (mp 2 : ℤ) = 8 := by decide
      rw [hmp]
      by_cases h3 : (8 : ℤ) ∣ (3 - b₀)
      · refine ⟨5, by decide, by decide, fun h5 => ?_⟩
        have hdiff : (8 : ℤ) ∣ ((5 - b₀) - (3 - b₀)) := dvd_sub h5 h3
        norm_num at hdiff
      · exact ⟨3, by decide, by decide, h3⟩
    · by_cases h3 : r = 3
      · subst h3
        have hmp : (mp 3 : ℤ) = 9 := by decide
        rw [hmp]
        by_cases h2b : (9 : ℤ) ∣ (2 - b₀)
        · refine ⟨4, by decide, by decide, fun h4 => ?_⟩
          have hdiff : (9 : ℤ) ∣ ((4 - b₀) - (2 - b₀)) := dvd_sub h4 h2b
          norm_num at hdiff
        · exact ⟨2, by decide, by decide, h2b⟩
      · have hr5 : 5 ≤ r := by
          have hr2 := hrp.two_le
          have hr4 : r ≠ 4 := fun h => by subst h; exact absurd hrp (by decide)
          omega
        have hmp : (mp r : ℤ) = (r : ℤ) := by
          simp [mp, ex, h2, h3]
        rw [hmp]
        have hcop2 : IsCoprime (2 : ℤ) (r : ℤ) := by
          rw [Int.isCoprime_iff_nat_coprime]
          exact (hrp.coprime_iff_not_dvd.mpr fun hd => by
            have := Nat.le_of_dvd (by decide) hd; omega).symm
        have hcop3 : IsCoprime (3 : ℤ) (r : ℤ) := by
          rw [Int.isCoprime_iff_nat_coprime]
          exact (hrp.coprime_iff_not_dvd.mpr fun hd => by
            have := Nat.le_of_dvd (by decide) hd; omega).symm
        have hnd21 : ¬ ((r : ℤ) ∣ (2 - 1)) := by
          intro h
          have : r ∣ 1 := Int.natCast_dvd_natCast.mp (by simpa using h)
          exact hrp.not_dvd_one this
        have hnd31 : ¬ ((r : ℤ) ∣ (3 - 1)) := by
          intro h
          have : r ∣ 2 := Int.natCast_dvd_natCast.mp (by simpa using h)
          have := Nat.le_of_dvd (by decide) this
          omega
        by_cases h2b : (r : ℤ) ∣ (2 - b₀)
        · refine ⟨3, hcop3, hnd31, fun h3b => ?_⟩
          have hdiff : (r : ℤ) ∣ ((3 - b₀) - (2 - b₀)) := dvd_sub h3b h2b
          have hr1 : r ∣ 1 := Int.natCast_dvd_natCast.mp (by simpa using hdiff)
          exact hrp.not_dvd_one hr1
        · exact ⟨2, hcop2, hnd21, h2b⟩
  classical
  let xr : ℕ → ℤ := fun r => if h : r ∈ P then (hchoice r h).choose else 1
  have hxr_spec : ∀ r ∈ P, IsCoprime (xr r) (mp r : ℤ) ∧
      ¬ ((mp r : ℤ) ∣ (xr r - 1)) ∧ ¬ ((mp r : ℤ) ∣ (xr r - b₀)) := fun r hr => by
    simp only [xr, dif_pos hr]
    exact (hchoice r hr).choose_spec
  have hmp_cop : ∀ i ∈ P, ∀ j ∈ P, i ≠ j → Nat.Coprime (mp i) (mp j) := by
    intro i hi j hj hne
    have hip := Nat.prime_of_mem_primeFactors hi
    have hjp := Nat.prime_of_mem_primeFactors hj
    have hcop_ij : Nat.Coprime i j := (Nat.coprime_primes hip hjp).mpr hne
    exact (hcop_ij.pow_left (ex i)).pow_right (ex j)
  obtain ⟨X, hX⟩ := crt_finset P mp xr hmp_cop
  let M : ℕ := ∏ r ∈ P, mp r
  have hM_pos : 0 < M := Finset.prod_pos fun r hr =>
    Nat.pow_pos (Nat.prime_of_mem_primeFactors hr).pos
  have hX_cop_M : IsCoprime X (M : ℤ) := by
    have hMcast : (M : ℤ) = ∏ r ∈ P, (mp r : ℤ) := Nat.cast_prod mp P
    rw [hMcast]
    refine IsCoprime.prod_right fun r hr => ?_
    have hcong := hX r hr
    obtain ⟨k, hk⟩ := Int.modEq_iff_dvd.mp hcong.symm
    have hXeq : X = xr r + (mp r : ℤ) * k := by linear_combination hk
    rw [hXeq]
    exact (hxr_spec r hr).1.add_mul_left_left k
  obtain ⟨p₁, hp₁_gt, hp₁_prime, hp₁_mod⟩ :=
    Nat.forall_exists_prime_gt_and_zmodEq (max M q) (Nat.ne_of_gt hM_pos) hX_cop_M
  have hp₁_gt_q : q < p₁ := lt_of_le_of_lt (le_max_right M q) hp₁_gt
  have hp₁_cop_M : IsCoprime (p₁ : ℤ) (M : ℤ) := by
    obtain ⟨k, hk⟩ := Int.modEq_iff_dvd.mp hp₁_mod.symm
    have heq : (p₁ : ℤ) = X + (M : ℤ) * k := by linear_combination hk
    rw [heq]
    exact hX_cop_M.add_mul_left_left k
  have hp₁_cop_q : IsCoprime (p₁ : ℤ) (q : ℤ) := by
    rw [Int.isCoprime_iff_nat_coprime]
    exact hp₁_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd hq h; omega
  have hp₁_cop_Mq : IsCoprime (p₁ : ℤ) ((M * q : ℕ) : ℤ) := by
    push_cast
    exact hp₁_cop_M.mul_right hp₁_cop_q
  have hb₀_cop_M : IsCoprime b₀ (M : ℤ) := by
    have hMcast : (M : ℤ) = ∏ r ∈ P, (mp r : ℤ) := Nat.cast_prod mp P
    rw [hMcast]
    refine IsCoprime.prod_right fun r hr => ?_
    have hr_dvd : (r : ℤ) ∣ (6 * N : ℤ) :=
      Int.natCast_dvd_natCast.mpr (Nat.dvd_of_mem_primeFactors hr)
    have hcop_r : IsCoprime b₀ (r : ℤ) := by
      rcases hr_dvd with ⟨c, hc⟩
      obtain ⟨u₀, v₀, huv₀⟩ := id ht₀
      exact ⟨u₀, v₀ * c, by linear_combination huv₀ - v₀ * hc⟩
    have hpow_r : IsCoprime b₀ ((r : ℤ) ^ ex r) := hcop_r.pow_right
    simpa [mp] using hpow_r
  have hb₀_cop_Mq : IsCoprime b₀ ((M * q : ℕ) : ℤ) := by
    push_cast
    exact hb₀_cop_M.mul_right hb₀_q
  obtain ⟨u, v, huv⟩ := hp₁_cop_Mq
  let Y : ℤ := u * b₀
  have hu_cop : IsCoprime u ((M * q : ℕ) : ℤ) := ⟨(p₁ : ℤ), v, by linear_combination huv⟩
  have hY_cop : IsCoprime Y ((M * q : ℕ) : ℤ) := hu_cop.mul_left hb₀_cop_Mq
  obtain ⟨p₂, hp₂_gt, hp₂_prime, hp₂_mod⟩ :=
    Nat.forall_exists_prime_gt_and_zmodEq (max p₁ q) (Nat.ne_of_gt (Nat.mul_pos hM_pos hq)) hY_cop
  have hp₁_lt_p₂ : p₁ < p₂ := lt_of_le_of_lt (le_max_left p₁ q) hp₂_gt
  have hp₂_gt_q : q < p₂ := lt_of_le_of_lt (le_max_right p₁ q) hp₂_gt
  have hp₁p₂_mod_Mq : ((p₁ : ℤ) * (p₂ : ℤ)) ≡ b₀ [ZMOD ((M * q : ℕ) : ℤ)] := by
    have h1 : (p₁ : ℤ) * (p₂ : ℤ) ≡ (p₁ : ℤ) * Y [ZMOD ((M * q : ℕ) : ℤ)] :=
      hp₂_mod.mul_left (p₁ : ℤ)
    have h2 : (p₁ : ℤ) * Y ≡ b₀ [ZMOD ((M * q : ℕ) : ℤ)] := by
      rw [Int.modEq_iff_dvd]
      refine ⟨v * b₀, ?_⟩
      simp only [Y]
      linear_combination -b₀ * huv
    exact h1.trans h2
  have ha_dvd_prod : a ∣ ((p₁ : ℤ) * (p₂ : ℤ) - b) := by
    have hq_dvd_Mq : (q : ℤ) ∣ ((M * q : ℕ) : ℤ) :=
      Int.natCast_dvd_natCast.mpr (dvd_mul_left q M)
    have hq_dvd1 : (q : ℤ) ∣ ((p₁ : ℤ) * (p₂ : ℤ) - b₀) :=
      dvd_trans hq_dvd_Mq (Int.modEq_iff_dvd.mp hp₁p₂_mod_Mq.symm)
    have ha_dvd1 : a ∣ ((p₁ : ℤ) * (p₂ : ℤ) - b₀) :=
      dvd_trans (Int.dvd_natAbs_self (a := a)) hq_dvd1
    have ha_dvd2 : a ∣ (b₀ - b) := ⟨t₀, by simp only [b₀]; ring⟩
    simpa using dvd_add ha_dvd1 ha_dvd2
  obtain ⟨k, hk⟩ := ha_dvd_prod
  have hbk : b + k * a = (p₁ : ℤ) * (p₂ : ℤ) := by linear_combination -hk
  let α₂ : ℕ := Nat.lcm (p₁ - 1) (p₂ - 1)
  have hp₁_sub : 0 < p₁ - 1 := Nat.sub_pos_of_lt hp₁_prime.one_lt
  have hp₂_sub : 0 < p₂ - 1 := Nat.sub_pos_of_lt hp₂_prime.one_lt
  have hα₂_pos : 0 < α₂ := Nat.pos_of_ne_zero (Nat.lcm_ne_zero (Nat.ne_of_gt hp₁_sub) (Nat.ne_of_gt hp₂_sub))
  have hno_bad : ∀ r ∈ P, ¬ (mp r ∣ (p₁ - 1)) ∧ ¬ (mp r ∣ (p₂ - 1)) := by
    intro r hr
    have hmp_dvd_M : (mp r : ℤ) ∣ (M : ℤ) :=
      Int.natCast_dvd_natCast.mpr (Finset.dvd_prod_of_mem mp hr)
    have hp₁_mod_r : (p₁ : ℤ) ≡ xr r [ZMOD (mp r : ℤ)] :=
      (hp₁_mod.of_dvd hmp_dvd_M).trans (hX r hr)
    constructor
    · intro hdiv
      have h1 : (mp r : ℤ) ∣ ((p₁ : ℤ) - 1) := by
        have := Int.natCast_dvd_natCast.mpr hdiv
        rwa [Nat.cast_sub hp₁_prime.one_lt.le, Nat.cast_one] at this
      have h2 : (mp r : ℤ) ∣ (xr r - (p₁ : ℤ)) := Int.modEq_iff_dvd.mp hp₁_mod_r
      have h3 : (mp r : ℤ) ∣ (xr r - 1) := by simpa using dvd_add h2 h1
      exact (hxr_spec r hr).2.1 h3
    · intro hdiv
      have h1 : (mp r : ℤ) ∣ ((p₂ : ℤ) - 1) := by
        have := Int.natCast_dvd_natCast.mpr hdiv
        rwa [Nat.cast_sub hp₂_prime.one_lt.le, Nat.cast_one] at this
      have hmp_dvd_Mq : (mp r : ℤ) ∣ ((M * q : ℕ) : ℤ) :=
        dvd_trans hmp_dvd_M (Int.natCast_dvd_natCast.mpr (dvd_mul_right M q))
      have hprod_r : (p₁ : ℤ) * (p₂ : ℤ) ≡ b₀ [ZMOD (mp r : ℤ)] :=
        hp₁p₂_mod_Mq.of_dvd hmp_dvd_Mq
      have hp₂_1 : (p₂ : ℤ) ≡ 1 [ZMOD (mp r : ℤ)] := (Int.modEq_iff_dvd.mpr h1).symm
      have hxr_b₀ : xr r ≡ b₀ [ZMOD (mp r : ℤ)] :=
        calc xr r ≡ (p₁ : ℤ) [ZMOD (mp r : ℤ)] := hp₁_mod_r.symm
          _ = (p₁ : ℤ) * 1 := (mul_one _).symm
          _ ≡ (p₁ : ℤ) * (p₂ : ℤ) [ZMOD (mp r : ℤ)] := hp₂_1.symm.mul_left (p₁ : ℤ)
          _ ≡ b₀ [ZMOD (mp r : ℤ)] := hprod_r
      exact (hxr_spec r hr).2.2 (Int.modEq_iff_dvd.mp hxr_b₀.symm)
  have hgcd_dvd12 : Nat.gcd N α₂ ∣ 12 := by
    refine dvd_12_of_no_bad_prime_pow (Nat.gcd_pos_of_pos_left α₂ hN) ?_ ?_ ?_
    · intro h8
      have h2P : 2 ∈ P := Nat.mem_primeFactors.mpr ⟨Nat.prime_two,
        ⟨3 * N, by ring⟩, by omega⟩
      have h8l : 2 ^ 3 ∣ α₂ := dvd_trans h8 (Nat.gcd_dvd_right N α₂)
      rcases (prime_pow_dvd_lcm_iff Nat.prime_two (Nat.ne_of_gt hp₁_sub) (Nat.ne_of_gt hp₂_sub)).mp h8l with h | h
      · exact (hno_bad 2 h2P).1 h
      · exact (hno_bad 2 h2P).2 h
    · intro h9
      have h3P : 3 ∈ P := Nat.mem_primeFactors.mpr ⟨Nat.prime_three,
        ⟨2 * N, by ring⟩, by omega⟩
      have h9l : 3 ^ 2 ∣ α₂ := dvd_trans h9 (Nat.gcd_dvd_right N α₂)
      rcases (prime_pow_dvd_lcm_iff Nat.prime_three (Nat.ne_of_gt hp₁_sub) (Nat.ne_of_gt hp₂_sub)).mp h9l with h | h
      · exact (hno_bad 3 h3P).1 h
      · exact (hno_bad 3 h3P).2 h
    · intro r hrp hr5 hrd
      have hrN : r ∣ N := dvd_trans hrd (Nat.gcd_dvd_left N α₂)
      have hrP : r ∈ P := Nat.mem_primeFactors.mpr ⟨hrp, dvd_mul_of_dvd_right hrN 6, by omega⟩
      have hrl : r ^ 1 ∣ α₂ := by simpa using dvd_trans hrd (Nat.gcd_dvd_right N α₂)
      have hmp_r : mp r = r ^ 1 := by
        have h2 : r ≠ 2 := by omega
        have h3 : r ≠ 3 := by omega
        simp [mp, ex, h2, h3]
      rcases (prime_pow_dvd_lcm_iff hrp (Nat.ne_of_gt hp₁_sub) (Nat.ne_of_gt hp₂_sub)).mp hrl with h | h
      · exact (hno_bad r hrP).1 (hmp_r ▸ h)
      · exact (hno_bad r hrP).2 (hmp_r ▸ h)
  have hfermat : (b + k * a) ∣ (a ^ α₂ - 1) := by
    rw [hbk]
    have ha_cop_p1 : IsCoprime a (p₁ : ℤ) := by
      rw [Int.isCoprime_iff_nat_coprime]
      exact (hp₁_prime.coprime_iff_not_dvd.mpr fun h => by
        have := Nat.le_of_dvd hq h; omega).symm
    have ha_cop_p2 : IsCoprime a (p₂ : ℤ) := by
      rw [Int.isCoprime_iff_nat_coprime]
      exact (hp₂_prime.coprime_iff_not_dvd.mpr fun h => by
        have := Nat.le_of_dvd hq h; omega).symm
    have hd1 : (p₁ : ℤ) ∣ (a ^ α₂ - 1) := by
      obtain ⟨m₁, hm₁⟩ := Nat.dvd_lcm_left (p₁ - 1) (p₂ - 1)
      have hf := Int.ModEq.pow_card_sub_one_eq_one hp₁_prime ha_cop_p1
      have hpow : a ^ α₂ ≡ 1 [ZMOD (p₁ : ℤ)] := by
        rw [show α₂ = (p₁ - 1) * m₁ from hm₁, pow_mul]
        simpa [one_pow] using hf.pow m₁
      exact Int.modEq_iff_dvd.mp hpow.symm
    have hd2 : (p₂ : ℤ) ∣ (a ^ α₂ - 1) := by
      obtain ⟨m₂, hm₂⟩ := Nat.dvd_lcm_right (p₁ - 1) (p₂ - 1)
      have hf := Int.ModEq.pow_card_sub_one_eq_one hp₂_prime ha_cop_p2
      have hpow : a ^ α₂ ≡ 1 [ZMOD (p₂ : ℤ)] := by
        rw [show α₂ = (p₂ - 1) * m₂ from hm₂, pow_mul]
        simpa [one_pow] using hf.pow m₂
      exact Int.modEq_iff_dvd.mp hpow.symm
    have hcop_p12 : IsCoprime (p₁ : ℤ) (p₂ : ℤ) :=
      Int.isCoprime_iff_nat_coprime.mpr (by
        simpa using (Nat.coprime_primes hp₁_prime hp₂_prime).mpr (Nat.ne_of_lt hp₁_lt_p₂))
    exact hcop_p12.mul_dvd hd1 hd2
  exact ⟨k, α₂, hα₂_pos, hgcd_dvd12, hfermat⟩

/- Integer witness for `x ^ 24 = 1`. -/
lemma exp24_witness_int (a b : ℤ) (hab : IsCoprime a b) (ha : a ≠ 0) (hb : b ≠ 0) :
    ∃ c d b' d₂ f₁ g₁ f₂ g₂ : ℤ,
      a * d - b * c = 1 ∧
      a * d₂ - b' * c = 1 ∧
      (f₁ + g₁ * a) * (f₁ + g₁ * d) - (g₁ * b) * (g₁ * c) = 1 ∧
      (f₂ + g₂ * a) * (f₂ + g₂ * d₂) - (g₂ * b') * (g₂ * c) = 1 ∧
      b ∣ (f₁ + g₁ * a - 1) ∧
      b' ∣ (f₂ + g₂ * a - 1) ∧
      c ∣ ((f₁ + g₁ * a) ^ 2 - a ^ 24 * (f₂ + g₂ * a) ^ 2) := by
  obtain ⟨d, y, hdy⟩ := id hab
  let c : ℤ := -y
  have hdet₁ : a * d - b * c = 1 := by linear_combination hdy
  let α₁ : ℕ := Nat.totient b.natAbs
  have hα₁_pos : 0 < α₁ := Nat.totient_pos.mpr (Int.natAbs_pos.mpr hb)
  obtain ⟨k, α₂, hα₂_pos, hgcd12, hb'_dvd⟩ := two_prime_dirichlet a b hab ha α₁ hα₁_pos
  let b' : ℤ := b + k * a
  let d₂ : ℤ := d + k * c
  have hdet₂ : a * d₂ - b' * c = 1 := by simp only [b', d₂]; linear_combination hdet₁
  obtain ⟨m, hm⟩ := hgcd12
  have hbez := Nat.gcd_eq_gcd_ab α₁ α₂
  let u : ℤ := (m : ℤ) * Nat.gcdA α₁ α₂
  let v : ℤ := (m : ℤ) * Nat.gcdB α₁ α₂
  have h12 : (12 : ℤ) = (α₁ : ℤ) * u + (α₂ : ℤ) * v := by
    have hmZ : (12 : ℤ) = (Nat.gcd α₁ α₂ : ℤ) * (m : ℤ) := by exact_mod_cast hm
    rw [hmZ, hbez]
    simp only [u, v]
    ring
  let K : ℤ := ((u.natAbs + v.natAbs + 1 : ℕ) : ℤ)
  let s₁Z : ℤ := u + K * (α₂ : ℤ)
  let s₂Z : ℤ := -v + K * (α₁ : ℤ)
  have hs₁_nonneg : 0 ≤ s₁Z := by
    have hK : (u.natAbs : ℤ) ≤ K := by omega
    have hu_ge : -(u.natAbs : ℤ) ≤ u := by
      rw [Int.natCast_natAbs]; exact neg_abs_le u
    have hKα : (u.natAbs : ℤ) ≤ K * (α₂ : ℤ) := by nlinarith
    linarith
  have hs₂_nonneg : 0 ≤ s₂Z := by
    have hK : (v.natAbs : ℤ) ≤ K := by omega
    have hv_le : v ≤ (v.natAbs : ℤ) := by
      rw [Int.natCast_natAbs]; exact le_abs_self v
    have hKα : (v.natAbs : ℤ) ≤ K * (α₁ : ℤ) := by nlinarith
    linarith
  let s₁ : ℕ := s₁Z.toNat
  let s₂ : ℕ := s₂Z.toNat
  have hlin : α₁ * s₁ = 12 + α₂ * s₂ := by
    zify
    rw [Int.toNat_of_nonneg hs₁_nonneg, Int.toNat_of_nonneg hs₂_nonneg]
    simp only [s₁Z, s₂Z]
    linear_combination -h12
  let M₁ : Matrix (Fin 2) (Fin 2) ℤ := !![a, b; c, d]
  let M₂ : Matrix (Fin 2) (Fin 2) ℤ := !![a, b'; c, d₂]
  have hM₁_det : M₁.det = 1 := by rw [Matrix.det_fin_two]; exact hdet₁
  have hM₂_det : M₂.det = 1 := by rw [Matrix.det_fin_two]; exact hdet₂
  obtain ⟨f₁, g₁, hpow₁⟩ := sl2_pow_linear M₁ hM₁_det (α₁ * s₁)
  obtain ⟨f₂, g₂, hpow₂⟩ := sl2_pow_linear M₂ hM₂_det (α₂ * s₂)
  have hdetN₁ : (f₁ + g₁ * a) * (f₁ + g₁ * d) - (g₁ * b) * (g₁ * c) = 1 := by
    have h := congrArg Matrix.det hpow₁
    rw [Matrix.det_pow, hM₁_det, one_pow, Matrix.det_fin_two] at h
    simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
      Fin.isValue, ↓reduceIte, Fin.reduceEq, mul_one, mul_zero, zero_add, M₁,
      Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one] at h
    exact h.symm
  have hdetN₂ : (f₂ + g₂ * a) * (f₂ + g₂ * d₂) - (g₂ * b') * (g₂ * c) = 1 := by
    have h := congrArg Matrix.det hpow₂
    rw [Matrix.det_pow, hM₂_det, one_pow, Matrix.det_fin_two] at h
    simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
      Fin.isValue, ↓reduceIte, Fin.reduceEq, mul_one, mul_zero, zero_add, M₂,
      Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one] at h
    exact h.symm
  have h00_1 : (M₁ ^ (α₁ * s₁)) 0 0 = f₁ + g₁ * a := by
    rw [hpow₁]
    simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
      Fin.isValue, ↓reduceIte, mul_one, M₁, Matrix.of_apply, Matrix.cons_val_zero]
  have h00_2 : (M₂ ^ (α₂ * s₂)) 0 0 = f₂ + g₂ * a := by
    rw [hpow₂]
    simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
      Fin.isValue, ↓reduceIte, mul_one, M₂, Matrix.of_apply, Matrix.cons_val_zero]
  have hb_dvd1 : b ∣ (f₁ + g₁ * a - 1) := by
    have hmod_b := (sl2_pow_mod_b a b c d (α₁ * s₁)).1
    rw [h00_1] at hmod_b
    have ha_cop_b : IsCoprime a (b.natAbs : ℤ) :=
      Int.isCoprime_iff_nat_coprime.mpr (by
        rw [Int.natAbs_natCast]; exact Int.isCoprime_iff_nat_coprime.mp hab)
    have heuler : a ^ α₁ ≡ 1 [ZMOD (b.natAbs : ℤ)] := by
      have : NeZero b.natAbs := ⟨Int.natAbs_ne_zero.mpr hb⟩
      have hu : IsUnit (a : ZMod b.natAbs) := by
        rwa [ZMod.coe_int_isUnit_iff_isCoprime, isCoprime_comm]
      have hpowu := ZMod.pow_totient hu.unit
      have hcast : ((a ^ α₁ : ℤ) : ZMod b.natAbs) = ((1 : ℤ) : ZMod b.natAbs) := by
        push_cast
        rw [← hu.unit_spec, ← Units.val_pow_eq_pow_val, hpowu, Units.val_one]
      exact (ZMod.intCast_eq_intCast_iff _ _ _).mp hcast
    have heuler_b : a ^ (α₁ * s₁) ≡ 1 [ZMOD b] := by
      have h1 : a ^ (α₁ * s₁) ≡ 1 [ZMOD (b.natAbs : ℤ)] := by
        rw [pow_mul]
        simpa [one_pow] using heuler.pow s₁
      exact h1.of_dvd (Int.dvd_natAbs_self (a := b))
    exact Int.modEq_iff_dvd.mp (hmod_b.trans heuler_b).symm
  have hb'_dvd2 : b' ∣ (f₂ + g₂ * a - 1) := by
    have hmod_b' := (sl2_pow_mod_b a b' c d₂ (α₂ * s₂)).1
    rw [h00_2] at hmod_b'
    have hpow_b' : a ^ (α₂ * s₂) ≡ 1 [ZMOD b'] := by
      have h1 : a ^ α₂ ≡ 1 [ZMOD b'] := (Int.modEq_iff_dvd.mpr hb'_dvd).symm
      rw [pow_mul]
      simpa [one_pow] using h1.pow s₂
    exact Int.modEq_iff_dvd.mp (hmod_b'.trans hpow_b').symm
  have hc_dvd : c ∣ ((f₁ + g₁ * a) ^ 2 - a ^ 24 * (f₂ + g₂ * a) ^ 2) := by
    have hmc1 := (sl2_pow_mod_c a b c d (α₁ * s₁)).1
    have hmc2 := (sl2_pow_mod_c a b' c d₂ (α₂ * s₂)).1
    rw [h00_1] at hmc1
    rw [h00_2] at hmc2
    have h12_mod : f₁ + g₁ * a ≡ a ^ 12 * (f₂ + g₂ * a) [ZMOD c] := by
      calc f₁ + g₁ * a ≡ a ^ (α₁ * s₁) [ZMOD c] := hmc1
        _ = a ^ 12 * a ^ (α₂ * s₂) := by rw [hlin, pow_add]
        _ ≡ a ^ 12 * (f₂ + g₂ * a) [ZMOD c] := hmc2.symm.mul_left (a ^ 12)
    have hsq : (f₁ + g₁ * a) ^ 2 ≡ (a ^ 12 * (f₂ + g₂ * a)) ^ 2 [ZMOD c] := h12_mod.pow 2
    have hrhs : (a ^ 12 * (f₂ + g₂ * a)) ^ 2 = a ^ 24 * (f₂ + g₂ * a) ^ 2 := by ring
    rw [hrhs] at hsq
    exact Int.modEq_iff_dvd.mp hsq.symm
  exact ⟨c, d, b', d₂, f₁, g₁, f₂, g₂, hdet₁, hdet₂, hdetN₁, hdetN₂, hb_dvd1, hb'_dvd2, hc_dvd⟩

/- Every element of `C` satisfies `x ^ 24 = 1`. -/
lemma C_pow_24 (x : C) : x ^ 24 = 1 := by
  obtain ⟨a, b, hab, rfl⟩ := exists_men_eq x
  by_cases ha : a = 0
  · subst ha
    obtain ⟨u, v, huv⟩ := id hab
    simp only [mul_zero, zero_add] at huv
    have hu : IsUnit b := isUnit_iff_exists_inv.mpr ⟨v, by rw [mul_comm]; exact huv⟩
    have hm : men 0 b hab = 1 := by
      have := men_unit_right 0 hu.unit (by simpa [hu.unit_spec] using hab)
      simpa [hu.unit_spec] using this
    rw [hm, one_pow]
  · by_cases hb : b = 0
    · subst hb
      obtain ⟨u, v, huv⟩ := id hab
      simp only [mul_zero, add_zero] at huv
      have hu : IsUnit a := isUnit_iff_exists_inv.mpr ⟨u, by rw [mul_comm]; exact huv⟩
      have hm : men a 0 hab = 1 := by
        have := men_unit_left hu.unit 0 (by simpa [hu.unit_spec] using hab)
        simpa [hu.unit_spec] using this
      rw [hm, one_pow]
    · induction a using Filter.Germ.inductionOn with
      | h fa =>
        induction b using Filter.Germ.inductionOn with
        | h fb =>
          have hcop : ∀ᶠ n in (U : Filter ℕ), IsCoprime (fa n) (fb n) := germ_isCoprime_iff.mp hab
          have ha' : ∀ᶠ n in (U : Filter ℕ), fa n ≠ 0 := germ_ne_zero_iff.mp ha
          have hb' : ∀ᶠ n in (U : Filter ℕ), fb n ≠ 0 := germ_ne_zero_iff.mp hb
          have hev := (hcop.and ha').and hb'
          classical
          let P := fun n => IsCoprime (fa n) (fb n) ∧ fa n ≠ 0 ∧ fb n ≠ 0
          let wit : ∀ n, P n → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun n hn =>
            let h1 := exp24_witness_int (fa n) (fb n) hn.1 hn.2.1 hn.2.2
            (h1.choose,
             h1.choose_spec.choose,
             h1.choose_spec.choose_spec.choose,
             h1.choose_spec.choose_spec.choose_spec.choose,
             h1.choose_spec.choose_spec.choose_spec.choose_spec.choose,
             h1.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose,
             h1.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose,
             h1.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose)
          let get : ℕ → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun n =>
            if h : P n then wit n h else (0, 0, 0, 0, 0, 0, 0, 0)
          let c : R := ((fun n => (get n).1) : R)
          let d : R := ((fun n => (get n).2.1) : R)
          let b' : R := ((fun n => (get n).2.2.1) : R)
          let d₂ : R := ((fun n => (get n).2.2.2.1) : R)
          let f₁ : R := ((fun n => (get n).2.2.2.2.1) : R)
          let g₁ : R := ((fun n => (get n).2.2.2.2.2.1) : R)
          let f₂ : R := ((fun n => (get n).2.2.2.2.2.2.1) : R)
          let g₂ : R := ((fun n => (get n).2.2.2.2.2.2.2) : R)
          have hP : ∀ᶠ n in (U : Filter ℕ), P n := hev.mono fun n ⟨⟨h1, h2⟩, h3⟩ => ⟨h1, h2, h3⟩
          have hspec : ∀ᶠ n in (U : Filter ℕ),
              let w := get n
              fa n * w.2.1 - fb n * w.1 = 1 ∧
              fa n * w.2.2.2.1 - w.2.2.1 * w.1 = 1 ∧
              (w.2.2.2.2.1 + w.2.2.2.2.2.1 * fa n) * (w.2.2.2.2.1 + w.2.2.2.2.2.1 * w.2.1) -
                (w.2.2.2.2.2.1 * fb n) * (w.2.2.2.2.2.1 * w.1) = 1 ∧
              (w.2.2.2.2.2.2.1 + w.2.2.2.2.2.2.2 * fa n) * (w.2.2.2.2.2.2.1 + w.2.2.2.2.2.2.2 * w.2.2.2.1) -
                (w.2.2.2.2.2.2.2 * w.2.2.1) * (w.2.2.2.2.2.2.2 * w.1) = 1 ∧
              fb n ∣ (w.2.2.2.2.1 + w.2.2.2.2.2.1 * fa n - 1) ∧
              w.2.2.1 ∣ (w.2.2.2.2.2.2.1 + w.2.2.2.2.2.2.2 * fa n - 1) ∧
              w.1 ∣ ((w.2.2.2.2.1 + w.2.2.2.2.2.1 * fa n) ^ 2 -
                (fa n) ^ 24 * (w.2.2.2.2.2.2.1 + w.2.2.2.2.2.2.2 * fa n) ^ 2) :=
            hP.mono fun n hn => by
              simp only [get, dif_pos hn, wit]
              exact (exp24_witness_int (fa n) (fb n) hn.1 hn.2.1 hn.2.2).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec
          have hdet1 : (fa : R) * d - (fb : R) * c = 1 := by
            simp only [c, d, germ_mul, germ_sub, ← germ_one, germ_coe_eq]
            exact hspec.mono fun n h => h.1
          have hdet2 : (fa : R) * d₂ - b' * c = 1 := by
            simp only [c, b', d₂, germ_mul, germ_sub, ← germ_one, germ_coe_eq]
            exact hspec.mono fun n h => h.2.1
          have hdetN1 : (f₁ + g₁ * (fa : R)) * (f₁ + g₁ * d) - (g₁ * (fb : R)) * (g₁ * c) = 1 := by
            simp only [c, d, f₁, g₁, germ_mul, germ_add, germ_sub, ← germ_one, germ_coe_eq]
            exact hspec.mono fun n h => h.2.2.1
          have hdetN2 : (f₂ + g₂ * (fa : R)) * (f₂ + g₂ * d₂) - (g₂ * b') * (g₂ * c) = 1 := by
            simp only [c, b', d₂, f₂, g₂, germ_mul, germ_add, germ_sub, ← germ_one, germ_coe_eq]
            exact hspec.mono fun n h => h.2.2.2.1
          have hbdvd1 : (fb : R) ∣ (f₁ + g₁ * (fa : R) - 1) := by
            simp only [f₁, g₁, germ_mul, germ_add, ← germ_one, germ_sub, germ_dvd_iff]
            exact hspec.mono fun n h => h.2.2.2.2.1
          have hbdvd2 : b' ∣ (f₂ + g₂ * (fa : R) - 1) := by
            simp only [b', f₂, g₂, germ_mul, germ_add, ← germ_one, germ_sub, germ_dvd_iff]
            exact hspec.mono fun n h => h.2.2.2.2.2.1
          have hcdvd : c ∣ ((f₁ + g₁ * (fa : R)) ^ 2 - (fa : R) ^ 24 * (f₂ + g₂ * (fa : R)) ^ 2) := by
            simp only [c, f₁, g₁, f₂, g₂, germ_mul, germ_add, germ_pow, germ_sub, germ_dvd_iff]
            exact hspec.mono fun n h => h.2.2.2.2.2.2
          have hac : IsCoprime (fa : R) c := ⟨d, -(fb : R), by linear_combination hdet1⟩
          have hcop_y2' : IsCoprime (f₂ + g₂ * (fa : R)) c :=
            ⟨f₂ + g₂ * d₂, -(g₂ * b' * g₂), by linear_combination hdetN2⟩
          have hcop_y2 : IsCoprime ((f₂ + g₂ * (fa : R)) ^ 2) c := hcop_y2'.pow_left
          have hcop_y1' : IsCoprime (f₁ + g₁ * (fa : R)) c :=
            ⟨f₁ + g₁ * d, -(g₁ * (fb : R) * g₁), by linear_combination hdetN1⟩
          have hcop_y1 : IsCoprime ((f₁ + g₁ * (fa : R)) ^ 2) c := hcop_y1'.pow_left
          have hsq1 := men_centralizer_sq hdet1 hdetN1 hbdvd1 hcop_y1
          have hsq2 := men_centralizer_sq hdet2 hdetN2 hbdvd2 hcop_y2
          have hpow24 : (men (fa : R) c hac) ^ 24 = 1 := by
            calc (men (fa : R) c hac) ^ 24
                = men ((fa : R) ^ 24) c hac.pow_left := (men_pow_left hac 24).symm
              _ = men ((fa : R) ^ 24) c hac.pow_left *
                    men ((f₂ + g₂ * (fa : R)) ^ 2) c hcop_y2 := by rw [hsq2, mul_one]
              _ = men ((fa : R) ^ 24 * (f₂ + g₂ * (fa : R)) ^ 2) c
                    (hac.pow_left.mul_left hcop_y2) := men_mul_left hac.pow_left hcop_y2
              _ = men ((f₁ + g₁ * (fa : R)) ^ 2) c hcop_y1 :=
                    (men_eq_of_dvd_left hcdvd (hac.pow_left.mul_left hcop_y2) hcop_y1).symm
              _ = 1 := hsq1
          have hinv : men (fa : R) c hac = (men (fa : R) (fb : R) hab)⁻¹ :=
            men_inv_of_det hdet1 hab hac
          rw [hinv, inv_pow, inv_eq_one] at hpow24
          exact hpow24

end Exponent24

section QuotientBound

/- Dirichlet + cyclic `(ZMod h)ˣ` lemma in `ℤ` for `p = 2`. -/
lemma dirichlet_cyclic_2 (a₁ a₂ y : ℤ) (ha₁ : a₁ ≠ 0) (ha₂ : a₂ ≠ 0)
    (hy : IsCoprime y (a₁ * a₂)) :
    ∃ h α : ℤ, (a₁ * a₂) ∣ (h - y) ∧ IsCoprime α h ∧ IsCoprime a₁ h ∧ IsCoprime a₂ h ∧
      (h ∣ (a₁ - α ^ 2) ∨ h ∣ (a₂ - α ^ 2) ∨ h ∣ (a₁ * a₂ - α ^ 2)) := by
  let q : ℕ := (a₁ * a₂).natAbs
  have hq : 0 < q := Int.natAbs_pos.mpr (mul_ne_zero ha₁ ha₂)
  have hyq : IsCoprime y (q : ℤ) :=
    Int.isCoprime_iff_nat_coprime.mpr (by
      rw [Int.natAbs_natCast]; exact Int.isCoprime_iff_nat_coprime.mp hy)
  obtain ⟨p, hp_gt, hp_prime, hp_mod⟩ :=
    Nat.forall_exists_prime_gt_and_zmodEq q (Nat.ne_of_gt hq) hyq
  have : Fact p.Prime := ⟨hp_prime⟩
  have ha₁_lt : a₁.natAbs < p := lt_of_le_of_lt
    (by simpa [q, Int.natAbs_mul] using Nat.le_mul_of_pos_right a₁.natAbs (Int.natAbs_pos.mpr ha₂)) hp_gt
  have ha₂_lt : a₂.natAbs < p := lt_of_le_of_lt
    (by simpa [q, Int.natAbs_mul] using Nat.le_mul_of_pos_left a₂.natAbs (Int.natAbs_pos.mpr ha₁)) hp_gt
  have ha₁_cop : IsCoprime a₁ (p : ℤ) := by
    rw [Int.isCoprime_iff_nat_coprime]
    exact (hp_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd (Int.natAbs_pos.mpr ha₁) h; omega).symm
  have ha₂_cop : IsCoprime a₂ (p : ℤ) := by
    rw [Int.isCoprime_iff_nat_coprime]
    exact (hp_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd (Int.natAbs_pos.mpr ha₂) h; omega).symm
  have hu₁ : IsUnit (a₁ : ZMod p) := (ZMod.coe_int_isUnit_iff_isCoprime a₁ p).mpr ha₁_cop.symm
  have hu₂ : IsUnit (a₂ : ZMod p) := (ZMod.coe_int_isUnit_iff_isCoprime a₂ p).mpr ha₂_cop.symm
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
  obtain ⟨k₁, hk₁⟩ := hg hu₁.unit
  obtain ⟨k₂, hk₂⟩ := hg hu₂.unit
  have hdiv_hy : (a₁ * a₂) ∣ ((p : ℤ) - y) :=
    dvd_trans (Int.dvd_natAbs_self (a := a₁ * a₂)) (Int.modEq_iff_dvd.mp hp_mod.symm)
  have hlift_unit : ∀ u : (ZMod p)ˣ, ∃ α : ℤ, IsCoprime α (p : ℤ) ∧ (α : ZMod p) = (u : ZMod p) := by
    intro u
    refine ⟨((u : ZMod p).val : ℤ), ?_, by simp⟩
    have hu_nz : (u : ZMod p) ≠ 0 := Units.ne_zero u
    have hval_pos : 0 < (u : ZMod p).val := Nat.pos_of_ne_zero fun h => hu_nz ((ZMod.val_eq_zero _).mp h)
    have hval_lt : (u : ZMod p).val < p := ZMod.val_lt (u : ZMod p)
    rw [Int.isCoprime_iff_nat_coprime]
    exact (hp_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd hval_pos h; omega).symm
  by_cases h1 : k₁ % 2 = 0
  · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ (k₁ / 2))
    refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inl ?_⟩
    have hu : hu₁.unit = (g ^ (k₁ / 2)) ^ 2 := by
      rw [← hk₁, ← zpow_natCast, ← _root_.zpow_mul]
      congr 1; omega
    have hmod : (a₁ : ZMod p) = ((α ^ 2 : ℤ) : ZMod p) := by
      push_cast
      rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, IsUnit.unit_spec]
    exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm
  · by_cases h2 : k₂ % 2 = 0
    · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ (k₂ / 2))
      refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inr (Or.inl ?_)⟩
      have hu : hu₂.unit = (g ^ (k₂ / 2)) ^ 2 := by
        rw [← hk₂, ← zpow_natCast, ← _root_.zpow_mul]
        congr 1; omega
      have hmod : (a₂ : ZMod p) = ((α ^ 2 : ℤ) : ZMod p) := by
        push_cast
        rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, IsUnit.unit_spec]
      exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm
    · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ ((k₁ + k₂) / 2))
      refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inr (Or.inr ?_)⟩
      have hu : hu₁.unit * hu₂.unit = (g ^ ((k₁ + k₂) / 2)) ^ 2 := by
        rw [← hk₁, ← hk₂, ← _root_.zpow_add, ← zpow_natCast, ← _root_.zpow_mul]
        congr 1; omega
      have hmod : ((a₁ * a₂ : ℤ) : ZMod p) = ((α ^ 2 : ℤ) : ZMod p) := by
        push_cast
        rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, Units.val_mul,
          IsUnit.unit_spec, IsUnit.unit_spec]
      exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm

/- Dirichlet + cyclic `(ZMod h)ˣ` lemma in `ℤ` for `p = 3`. -/
lemma dirichlet_cyclic_3 (a₁ a₂ y : ℤ) (ha₁ : a₁ ≠ 0) (ha₂ : a₂ ≠ 0)
    (hy : IsCoprime y (a₁ * a₂)) :
    ∃ h α : ℤ, (a₁ * a₂) ∣ (h - y) ∧ IsCoprime α h ∧ IsCoprime a₁ h ∧ IsCoprime a₂ h ∧
      (h ∣ (a₁ - α ^ 3) ∨ h ∣ (a₂ - α ^ 3) ∨ h ∣ (a₁ * a₂ - α ^ 3) ∨ h ∣ (a₁ * a₂ ^ 2 - α ^ 3)) := by
  let q : ℕ := (a₁ * a₂).natAbs
  have hq : 0 < q := Int.natAbs_pos.mpr (mul_ne_zero ha₁ ha₂)
  have hyq : IsCoprime y (q : ℤ) :=
    Int.isCoprime_iff_nat_coprime.mpr (by
      rw [Int.natAbs_natCast]; exact Int.isCoprime_iff_nat_coprime.mp hy)
  obtain ⟨p, hp_gt, hp_prime, hp_mod⟩ :=
    Nat.forall_exists_prime_gt_and_zmodEq q (Nat.ne_of_gt hq) hyq
  have : Fact p.Prime := ⟨hp_prime⟩
  have ha₁_lt : a₁.natAbs < p := lt_of_le_of_lt
    (by simpa [q, Int.natAbs_mul] using Nat.le_mul_of_pos_right a₁.natAbs (Int.natAbs_pos.mpr ha₂)) hp_gt
  have ha₂_lt : a₂.natAbs < p := lt_of_le_of_lt
    (by simpa [q, Int.natAbs_mul] using Nat.le_mul_of_pos_left a₂.natAbs (Int.natAbs_pos.mpr ha₁)) hp_gt
  have ha₁_cop : IsCoprime a₁ (p : ℤ) := by
    rw [Int.isCoprime_iff_nat_coprime]
    exact (hp_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd (Int.natAbs_pos.mpr ha₁) h; omega).symm
  have ha₂_cop : IsCoprime a₂ (p : ℤ) := by
    rw [Int.isCoprime_iff_nat_coprime]
    exact (hp_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd (Int.natAbs_pos.mpr ha₂) h; omega).symm
  have hu₁ : IsUnit (a₁ : ZMod p) := (ZMod.coe_int_isUnit_iff_isCoprime a₁ p).mpr ha₁_cop.symm
  have hu₂ : IsUnit (a₂ : ZMod p) := (ZMod.coe_int_isUnit_iff_isCoprime a₂ p).mpr ha₂_cop.symm
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
  obtain ⟨k₁, hk₁⟩ := hg hu₁.unit
  obtain ⟨k₂, hk₂⟩ := hg hu₂.unit
  have hdiv_hy : (a₁ * a₂) ∣ ((p : ℤ) - y) :=
    dvd_trans (Int.dvd_natAbs_self (a := a₁ * a₂)) (Int.modEq_iff_dvd.mp hp_mod.symm)
  have hlift_unit : ∀ u : (ZMod p)ˣ, ∃ α : ℤ, IsCoprime α (p : ℤ) ∧ (α : ZMod p) = (u : ZMod p) := by
    intro u
    refine ⟨((u : ZMod p).val : ℤ), ?_, by simp⟩
    have hu_nz : (u : ZMod p) ≠ 0 := Units.ne_zero u
    have hval_pos : 0 < (u : ZMod p).val := Nat.pos_of_ne_zero fun h => hu_nz ((ZMod.val_eq_zero _).mp h)
    have hval_lt : (u : ZMod p).val < p := ZMod.val_lt (u : ZMod p)
    rw [Int.isCoprime_iff_nat_coprime]
    exact (hp_prime.coprime_iff_not_dvd.mpr fun h => by
      have := Nat.le_of_dvd hval_pos h; omega).symm
  by_cases h1 : k₁ % 3 = 0
  · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ (k₁ / 3))
    refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inl ?_⟩
    have hu : hu₁.unit = (g ^ (k₁ / 3)) ^ 3 := by
      rw [← hk₁, ← zpow_natCast, ← _root_.zpow_mul]
      congr 1; omega
    have hmod : (a₁ : ZMod p) = ((α ^ 3 : ℤ) : ZMod p) := by
      push_cast
      rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, IsUnit.unit_spec]
    exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm
  · by_cases h2 : k₂ % 3 = 0
    · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ (k₂ / 3))
      refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inr (Or.inl ?_)⟩
      have hu : hu₂.unit = (g ^ (k₂ / 3)) ^ 3 := by
        rw [← hk₂, ← zpow_natCast, ← _root_.zpow_mul]
        congr 1; omega
      have hmod : (a₂ : ZMod p) = ((α ^ 3 : ℤ) : ZMod p) := by
        push_cast
        rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, IsUnit.unit_spec]
      exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm
    · by_cases h3 : (k₁ + k₂) % 3 = 0
      · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ ((k₁ + k₂) / 3))
        refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inr (Or.inr (Or.inl ?_))⟩
        have hu : hu₁.unit * hu₂.unit = (g ^ ((k₁ + k₂) / 3)) ^ 3 := by
          rw [← hk₁, ← hk₂, ← _root_.zpow_add, ← zpow_natCast, ← _root_.zpow_mul]
          congr 1; omega
        have hmod : ((a₁ * a₂ : ℤ) : ZMod p) = ((α ^ 3 : ℤ) : ZMod p) := by
          push_cast
          rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, Units.val_mul,
            IsUnit.unit_spec, IsUnit.unit_spec]
        exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm
      · obtain ⟨α, hα_cop, hα_eq⟩ := hlift_unit (g ^ ((k₁ + 2 * k₂) / 3))
        refine ⟨(p : ℤ), α, hdiv_hy, hα_cop, ha₁_cop, ha₂_cop, Or.inr (Or.inr (Or.inr ?_))⟩
        have hu : hu₁.unit * hu₂.unit ^ 2 = (g ^ ((k₁ + 2 * k₂) / 3)) ^ 3 := by
          rw [← hk₁, ← hk₂, ← zpow_natCast (g ^ k₂) 2, ← _root_.zpow_mul, ← _root_.zpow_add,
            ← zpow_natCast, ← _root_.zpow_mul]
          congr 1
          have hr1 : k₁ % 3 = 1 ∨ k₁ % 3 = 2 := by omega
          have hr2 : k₂ % 3 = 1 ∨ k₂ % 3 = 2 := by omega
          rcases hr1 with h1' | h1' <;> rcases hr2 with h2' | h2' <;> omega
        have hmod : ((a₁ * a₂ ^ 2 : ℤ) : ZMod p) = ((α ^ 3 : ℤ) : ZMod p) := by
          push_cast
          rw [hα_eq, ← Units.val_pow_eq_pow_val, ← hu, Units.val_mul,
            Units.val_pow_eq_pow_val, IsUnit.unit_spec, IsUnit.unit_spec]
        exact Int.modEq_iff_dvd.mp ((ZMod.intCast_eq_intCast_iff _ _ _).mp hmod).symm

/- Common-numerator Mennicke representation of any two non-trivial elements of `C`. -/
lemma pair_common_num (x₁ x₂ : C) (hx₁ : x₁ ≠ 1) (hx₂ : x₂ ≠ 1) :
    ∃ (a₁ a₂ y : R) (h₁ : IsCoprime a₁ y) (h₂ : IsCoprime a₂ y),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ x₁ = men a₁ y h₁ ∧ x₂ = men a₂ y h₂ := by
  obtain ⟨a₁, b₁, h₁, rfl⟩ := exists_men_eq x₁
  obtain ⟨a₂, b₂, h₂, rfl⟩ := exists_men_eq x₂
  have ha₁ : a₁ ≠ 0 := by
    intro h0; subst h0
    obtain ⟨u, v, huv⟩ := id h₁
    simp only [mul_zero, zero_add] at huv
    exact hx₁ (men_unit_right 0 (isUnit_iff_exists_inv.mpr ⟨v, by rw [mul_comm]; exact huv⟩).unit h₁)
  obtain ⟨t, ht⟩ := sr1_R a₂ b₂ a₁ h₂ ha₁
  let a₂' := a₂ + t * b₂
  have h₂' : IsCoprime a₂' b₂ := by simpa [a₂', add_comm] using h₂.add_mul_left_left t
  have hx₂_eq : men a₂ b₂ h₂ = men a₂' b₂ h₂' := (men_add_left t h₂ h₂').symm
  have ha₂' : a₂' ≠ 0 := by
    intro h0
    rw [hx₂_eq] at hx₂
    have h₂'' : IsCoprime (0 : R) b₂ := by rwa [h0] at h₂'
    obtain ⟨u, v, huv⟩ := id h₂''
    simp only [mul_zero, zero_add] at huv
    have h1 := men_unit_right 0 (isUnit_iff_exists_inv.mpr ⟨v, by rw [mul_comm]; exact huv⟩).unit h₂''
    exact hx₂ (by simpa [h0] using h1)
  obtain ⟨u, v, huv⟩ := ht.symm
  let y : R := b₂ * (u * a₁) + b₁ * (v * a₂')
  have hy1 : a₁ ∣ (y - b₁) := ⟨(b₂ - b₁) * u, by
    have hv : v * a₂' = 1 - u * a₁ := by linear_combination huv
    calc y - b₁ = b₂ * (u * a₁) + b₁ * (v * a₂') - b₁ := rfl
      _ = b₂ * (u * a₁) + b₁ * (1 - u * a₁) - b₁ := by rw [hv]
      _ = a₁ * ((b₂ - b₁) * u) := by ring⟩
  have hy2 : a₂' ∣ (y - b₂) := ⟨(b₁ - b₂) * v, by
    have hu : u * a₁ = 1 - v * a₂' := by linear_combination huv
    calc y - b₂ = b₂ * (u * a₁) + b₁ * (v * a₂') - b₂ := rfl
      _ = b₂ * (1 - v * a₂') + b₁ * (v * a₂') - b₂ := by rw [hu]
      _ = a₂' * ((b₁ - b₂) * v) := by ring⟩
  have hcop1 : IsCoprime a₁ y := by
    rcases hy1 with ⟨k, hk⟩
    have : y = b₁ + k * a₁ := by linear_combination hk
    rw [this]; exact h₁.add_mul_right_right k
  have hcop2 : IsCoprime a₂' y := by
    rcases hy2 with ⟨k, hk⟩
    have : y = b₂ + k * a₂' := by linear_combination hk
    rw [this]; exact h₂'.add_mul_right_right k
  exact ⟨a₁, a₂', y, hcop1, hcop2, ha₁, ha₂',
    (men_eq_of_dvd_right hy1 h₁ hcop1).symm,
    hx₂_eq.trans (men_eq_of_dvd_right hy2 h₂' hcop2).symm⟩

/- For any two `x₁, x₂ : C`, one of `x₁, x₂, x₁ * x₂` is a square. -/
lemma C_mod_sq (x₁ x₂ : C) :
    (∃ w : C, x₁ = w ^ 2) ∨ (∃ w : C, x₂ = w ^ 2) ∨ (∃ w : C, x₁ * x₂ = w ^ 2) := by
  by_cases hx₁ : x₁ = 1
  · exact Or.inl ⟨1, by simp [hx₁]⟩
  by_cases hx₂ : x₂ = 1
  · exact Or.inr (Or.inl ⟨1, by simp [hx₂]⟩)
  obtain ⟨a₁, a₂, y, h₁, h₂, ha₁, ha₂, rfl, rfl⟩ := pair_common_num x₁ x₂ hx₁ hx₂
  have hy_prod : IsCoprime y (a₁ * a₂) := h₁.symm.mul_right h₂.symm
  induction a₁ using Filter.Germ.inductionOn with
  | h f₁ =>
    induction a₂ using Filter.Germ.inductionOn with
    | h f₂ =>
      induction y using Filter.Germ.inductionOn with
      | h fy =>
        have hev1 : ∀ᶠ n in (U : Filter ℕ), f₁ n ≠ 0 := germ_ne_zero_iff.mp ha₁
        have hev2 : ∀ᶠ n in (U : Filter ℕ), f₂ n ≠ 0 := germ_ne_zero_iff.mp ha₂
        have hev3 : ∀ᶠ n in (U : Filter ℕ), IsCoprime (fy n) (f₁ n * f₂ n) := by
          rw [germ_mul, germ_isCoprime_iff] at hy_prod
          exact hy_prod
        classical
        let P := fun n => f₁ n ≠ 0 ∧ f₂ n ≠ 0 ∧ IsCoprime (fy n) (f₁ n * f₂ n)
        have hP : ∀ᶠ n in (U : Filter ℕ), P n :=
          ((hev1.and hev2).and hev3).mono fun n ⟨⟨h1, h2⟩, h3⟩ => ⟨h1, h2, h3⟩
        let fh : ℕ → ℤ := fun n =>
          if h : P n then (dirichlet_cyclic_2 (f₁ n) (f₂ n) (fy n) h.1 h.2.1 h.2.2).choose else 1
        let fα : ℕ → ℤ := fun n =>
          if h : P n then (dirichlet_cyclic_2 (f₁ n) (f₂ n) (fy n) h.1 h.2.1 h.2.2).choose_spec.choose else 1
        let h : R := (fh : R)
        let α : R := (fα : R)
        have hspec : ∀ᶠ n in (U : Filter ℕ),
            (f₁ n * f₂ n) ∣ (fh n - fy n) ∧
            IsCoprime (fα n) (fh n) ∧ IsCoprime (f₁ n) (fh n) ∧ IsCoprime (f₂ n) (fh n) ∧
            (fh n ∣ (f₁ n - (fα n) ^ 2) ∨ fh n ∣ (f₂ n - (fα n) ^ 2) ∨
              fh n ∣ (f₁ n * f₂ n - (fα n) ^ 2)) :=
          hP.mono fun n hn => by
            simp only [fh, fα, dif_pos hn]
            exact (dirichlet_cyclic_2 (f₁ n) (f₂ n) (fy n) hn.1 hn.2.1 hn.2.2).choose_spec.choose_spec
        have hdiv_prod : ((f₁ : R) * (f₂ : R)) ∣ (h - (fy : R)) := by
          simp only [h, germ_mul, germ_sub, germ_dvd_iff]
          exact hspec.mono fun n hn => hn.1
        have hcop_α : IsCoprime α h := germ_isCoprime_iff.mpr (hspec.mono fun n hn => hn.2.1)
        have hcop_1 : IsCoprime (f₁ : R) h := germ_isCoprime_iff.mpr (hspec.mono fun n hn => hn.2.2.1)
        have hcop_2 : IsCoprime (f₂ : R) h := germ_isCoprime_iff.mpr (hspec.mono fun n hn => hn.2.2.2.1)
        have hm1 : men (f₁ : R) (fy : R) h₁ = men (f₁ : R) h hcop_1 :=
          (men_eq_of_dvd_right (dvd_trans (dvd_mul_right _ _) hdiv_prod) h₁ hcop_1).symm
        have hm2 : men (f₂ : R) (fy : R) h₂ = men (f₂ : R) h hcop_2 :=
          (men_eq_of_dvd_right (dvd_trans (dvd_mul_left _ _) hdiv_prod) h₂ hcop_2).symm
        have hdisj : ∀ᶠ n in (U : Filter ℕ),
            fh n ∣ (f₁ n - (fα n) ^ 2) ∨ fh n ∣ (f₂ n - (fα n) ^ 2) ∨
              fh n ∣ (f₁ n * f₂ n - (fα n) ^ 2) :=
          hspec.mono fun n hn => hn.2.2.2.2
        rw [U.eventually_or, U.eventually_or] at hdisj
        rcases hdisj with hd1 | hd2 | hd3
        · left
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm1, ← men_pow_left hcop_α 2]
          have hd1' : h ∣ ((f₁ : R) - α ^ 2) := by
            simp only [h, α, germ_pow, germ_sub, germ_dvd_iff]; exact hd1
          exact men_eq_of_dvd_left hd1' hcop_α.pow_left hcop_1
        · right; left
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm2, ← men_pow_left hcop_α 2]
          have hd2' : h ∣ ((f₂ : R) - α ^ 2) := by
            simp only [h, α, germ_pow, germ_sub, germ_dvd_iff]; exact hd2
          exact men_eq_of_dvd_left hd2' hcop_α.pow_left hcop_2
        · right; right
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm1, hm2, men_mul_left hcop_1 hcop_2, ← men_pow_left hcop_α 2]
          have hd3' : h ∣ ((f₁ : R) * (f₂ : R) - α ^ 2) := by
            simp only [h, α, germ_mul, germ_pow, germ_sub, germ_dvd_iff]; exact hd3
          exact men_eq_of_dvd_left hd3' hcop_α.pow_left (hcop_1.mul_left hcop_2)

/- For any two `x₁, x₂ : C`, one of `x₁, x₂, x₁ * x₂, x₁ * x₂ ^ 2` is a cube. -/
lemma C_mod_cube (x₁ x₂ : C) :
    (∃ w : C, x₁ = w ^ 3) ∨ (∃ w : C, x₂ = w ^ 3) ∨
      (∃ w : C, x₁ * x₂ = w ^ 3) ∨ (∃ w : C, x₁ * x₂ ^ 2 = w ^ 3) := by
  by_cases hx₁ : x₁ = 1
  · exact Or.inl ⟨1, by simp [hx₁]⟩
  by_cases hx₂ : x₂ = 1
  · exact Or.inr (Or.inl ⟨1, by simp [hx₂]⟩)
  obtain ⟨a₁, a₂, y, h₁, h₂, ha₁, ha₂, rfl, rfl⟩ := pair_common_num x₁ x₂ hx₁ hx₂
  have hy_prod : IsCoprime y (a₁ * a₂) := h₁.symm.mul_right h₂.symm
  induction a₁ using Filter.Germ.inductionOn with
  | h f₁ =>
    induction a₂ using Filter.Germ.inductionOn with
    | h f₂ =>
      induction y using Filter.Germ.inductionOn with
      | h fy =>
        have hev1 : ∀ᶠ n in (U : Filter ℕ), f₁ n ≠ 0 := germ_ne_zero_iff.mp ha₁
        have hev2 : ∀ᶠ n in (U : Filter ℕ), f₂ n ≠ 0 := germ_ne_zero_iff.mp ha₂
        have hev3 : ∀ᶠ n in (U : Filter ℕ), IsCoprime (fy n) (f₁ n * f₂ n) := by
          rw [germ_mul, germ_isCoprime_iff] at hy_prod
          exact hy_prod
        classical
        let P := fun n => f₁ n ≠ 0 ∧ f₂ n ≠ 0 ∧ IsCoprime (fy n) (f₁ n * f₂ n)
        have hP : ∀ᶠ n in (U : Filter ℕ), P n :=
          ((hev1.and hev2).and hev3).mono fun n ⟨⟨h1, h2⟩, h3⟩ => ⟨h1, h2, h3⟩
        let fh : ℕ → ℤ := fun n =>
          if h : P n then (dirichlet_cyclic_3 (f₁ n) (f₂ n) (fy n) h.1 h.2.1 h.2.2).choose else 1
        let fα : ℕ → ℤ := fun n =>
          if h : P n then (dirichlet_cyclic_3 (f₁ n) (f₂ n) (fy n) h.1 h.2.1 h.2.2).choose_spec.choose else 1
        let h : R := (fh : R)
        let α : R := (fα : R)
        have hspec : ∀ᶠ n in (U : Filter ℕ),
            (f₁ n * f₂ n) ∣ (fh n - fy n) ∧
            IsCoprime (fα n) (fh n) ∧ IsCoprime (f₁ n) (fh n) ∧ IsCoprime (f₂ n) (fh n) ∧
            (fh n ∣ (f₁ n - (fα n) ^ 3) ∨ fh n ∣ (f₂ n - (fα n) ^ 3) ∨
              fh n ∣ (f₁ n * f₂ n - (fα n) ^ 3) ∨ fh n ∣ (f₁ n * (f₂ n) ^ 2 - (fα n) ^ 3)) :=
          hP.mono fun n hn => by
            simp only [fh, fα, dif_pos hn]
            exact (dirichlet_cyclic_3 (f₁ n) (f₂ n) (fy n) hn.1 hn.2.1 hn.2.2).choose_spec.choose_spec
        have hdiv_prod : ((f₁ : R) * (f₂ : R)) ∣ (h - (fy : R)) := by
          simp only [h, germ_mul, germ_sub, germ_dvd_iff]
          exact hspec.mono fun n hn => hn.1
        have hcop_α : IsCoprime α h := germ_isCoprime_iff.mpr (hspec.mono fun n hn => hn.2.1)
        have hcop_1 : IsCoprime (f₁ : R) h := germ_isCoprime_iff.mpr (hspec.mono fun n hn => hn.2.2.1)
        have hcop_2 : IsCoprime (f₂ : R) h := germ_isCoprime_iff.mpr (hspec.mono fun n hn => hn.2.2.2.1)
        have hm1 : men (f₁ : R) (fy : R) h₁ = men (f₁ : R) h hcop_1 :=
          (men_eq_of_dvd_right (dvd_trans (dvd_mul_right _ _) hdiv_prod) h₁ hcop_1).symm
        have hm2 : men (f₂ : R) (fy : R) h₂ = men (f₂ : R) h hcop_2 :=
          (men_eq_of_dvd_right (dvd_trans (dvd_mul_left _ _) hdiv_prod) h₂ hcop_2).symm
        have hdisj : ∀ᶠ n in (U : Filter ℕ),
            fh n ∣ (f₁ n - (fα n) ^ 3) ∨ fh n ∣ (f₂ n - (fα n) ^ 3) ∨
              fh n ∣ (f₁ n * f₂ n - (fα n) ^ 3) ∨ fh n ∣ (f₁ n * (f₂ n) ^ 2 - (fα n) ^ 3) :=
          hspec.mono fun n hn => hn.2.2.2.2
        rw [U.eventually_or, U.eventually_or, U.eventually_or] at hdisj
        rcases hdisj with hd1 | hd2 | hd3 | hd4
        · left
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm1, ← men_pow_left hcop_α 3]
          have hd1' : h ∣ ((f₁ : R) - α ^ 3) := by
            simp only [h, α, germ_pow, germ_sub, germ_dvd_iff]; exact hd1
          exact men_eq_of_dvd_left hd1' hcop_α.pow_left hcop_1
        · right; left
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm2, ← men_pow_left hcop_α 3]
          have hd2' : h ∣ ((f₂ : R) - α ^ 3) := by
            simp only [h, α, germ_pow, germ_sub, germ_dvd_iff]; exact hd2
          exact men_eq_of_dvd_left hd2' hcop_α.pow_left hcop_2
        · right; right; left
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm1, hm2, men_mul_left hcop_1 hcop_2, ← men_pow_left hcop_α 3]
          have hd3' : h ∣ ((f₁ : R) * (f₂ : R) - α ^ 3) := by
            simp only [h, α, germ_mul, germ_pow, germ_sub, germ_dvd_iff]; exact hd3
          exact men_eq_of_dvd_left hd3' hcop_α.pow_left (hcop_1.mul_left hcop_2)
        · right; right; right
          refine ⟨men α h hcop_α, ?_⟩
          rw [hm1, hm2, ← men_pow_left hcop_2 2, men_mul_left hcop_1 hcop_2.pow_left,
            ← men_pow_left hcop_α 3]
          have hd4' : h ∣ ((f₁ : R) * (f₂ : R) ^ 2 - α ^ 3) := by
            simp only [h, α, germ_mul, germ_pow, germ_sub, germ_dvd_iff]; exact hd4
          exact men_eq_of_dvd_left hd4' hcop_α.pow_left
            (hcop_1.mul_left hcop_2.pow_left)

/- Abstract finite-quotient surjection for any abelian group of exponent dividing 24. -/
lemma surj_fin24_of_commGroup {G : Type*} [CommGroup G]
    (h24 : ∀ x : G, x ^ 24 = 1)
    (hsq : ∀ x₁ x₂ : G, (∃ w : G, x₁ = w ^ 2) ∨ (∃ w : G, x₂ = w ^ 2) ∨ (∃ w : G, x₁ * x₂ = w ^ 2))
    (hcb : ∀ x₁ x₂ : G, (∃ w : G, x₁ = w ^ 3) ∨ (∃ w : G, x₂ = w ^ 3) ∨
      (∃ w : G, x₁ * x₂ = w ^ 3) ∨ (∃ w : G, x₁ * x₂ ^ 2 = w ^ 3)) :
    ∃ φ : Fin 8 × Fin 3 → G, Function.Surjective φ := by
  have h2 : ∃ u₂ : G, ∀ x : G, ∃ (r : Fin 2) (w : G), x = u₂ ^ (r : ℕ) * w ^ 2 := by
    by_cases hall : ∀ x : G, ∃ w : G, x = w ^ 2
    · refine ⟨1, fun x => ?_⟩
      obtain ⟨w, hw⟩ := hall x
      exact ⟨0, w, by simpa using hw⟩
    · push Not at hall
      obtain ⟨u₂, hu₂⟩ := hall
      refine ⟨u₂, fun x => ?_⟩
      rcases hsq u₂ x with ⟨w, hw⟩ | ⟨w, hw⟩ | ⟨w, hw⟩
      · exact absurd hw (hu₂ w)
      · exact ⟨0, w, by simpa using hw⟩
      · refine ⟨1, u₂⁻¹ * w, ?_⟩
        rw [show ((1 : Fin 2) : ℕ) = 1 from rfl, pow_one, mul_pow, inv_pow, ← hw]
        group
  have h8 : ∃ u₂ : G, ∀ x : G, ∃ (r : Fin 8) (w : G), x = u₂ ^ (r : ℕ) * w ^ 8 := by
    obtain ⟨u₂, hu₂⟩ := h2
    refine ⟨u₂, fun x => ?_⟩
    obtain ⟨r₀, w₁, hw₁⟩ := hu₂ x
    obtain ⟨r₁, w₂, hw₂⟩ := hu₂ w₁
    obtain ⟨r₂, w₃, hw₃⟩ := hu₂ w₂
    refine ⟨⟨r₀.1 + 2 * r₁.1 + 4 * r₂.1, by omega⟩, w₃, ?_⟩
    rw [hw₁, hw₂, hw₃, mul_pow, mul_pow, mul_pow, ← pow_mul, ← pow_mul, ← pow_mul, ← pow_mul,
      ← pow_mul]
    have h1 : u₂ ^ r₀.1 * (u₂ ^ (r₁.1 * 2) * (u₂ ^ (r₂.1 * (2 * 2)) * w₃ ^ (2 * (2 * 2)))) =
        (u₂ ^ r₀.1 * u₂ ^ (r₁.1 * 2) * u₂ ^ (r₂.1 * (2 * 2))) * w₃ ^ 8 := by
      simp only [mul_assoc]
    rw [h1, ← pow_add, ← pow_add]
    congr 2; dsimp only; omega
  have h3 : ∃ u₃ : G, ∀ x : G, ∃ (d : Fin 3) (v : G), x = u₃ ^ (d : ℕ) * v ^ 3 := by
    by_cases hall : ∀ x : G, ∃ w : G, x = w ^ 3
    · refine ⟨1, fun x => ?_⟩
      obtain ⟨w, hw⟩ := hall x
      exact ⟨0, w, by simpa using hw⟩
    · push Not at hall
      obtain ⟨u₃, hu₃⟩ := hall
      refine ⟨u₃, fun x => ?_⟩
      rcases hcb u₃ x with ⟨w, hw⟩ | ⟨w, hw⟩ | ⟨w, hw⟩ | ⟨w, hw⟩
      · exact absurd hw (hu₃ w)
      · exact ⟨0, w, by simpa using hw⟩
      · refine ⟨2, u₃⁻¹ * w, ?_⟩
        rw [show ((2 : Fin 3) : ℕ) = 2 from rfl, mul_pow, inv_pow, ← hw]
        group
      · refine ⟨1, u₃⁻¹ * x⁻¹ * w ^ 2, ?_⟩
        rw [show ((1 : Fin 3) : ℕ) = 1 from rfl, pow_one, mul_pow, mul_pow, inv_pow, inv_pow,
          ← pow_mul, show 2 * 3 = 3 * 2 by rfl, pow_mul, ← hw, mul_pow, ← pow_mul]
        calc x = (u₃ * (u₃ ^ 3)⁻¹ * u₃ ^ 2) * ((x ^ 3)⁻¹ * x ^ (2 * 2)) := by group
          _ = u₃ * ((u₃ ^ 3)⁻¹ * (x ^ 3)⁻¹ * (u₃ ^ 2 * x ^ (2 * 2))) := by ac_rfl
  obtain ⟨u₂, hu₂⟩ := h8
  obtain ⟨u₃, hu₃⟩ := h3
  refine ⟨fun p => u₂ ^ (p.1 : ℕ) * u₃ ^ (8 * (p.2 : ℕ)), fun x => ?_⟩
  obtain ⟨r, w, hw⟩ := hu₂ x
  obtain ⟨d, v, hv⟩ := hu₃ w
  refine ⟨(r, d), ?_⟩
  rw [hw, hv, mul_pow, ← pow_mul, ← pow_mul, show 3 * 8 = 24 by rfl, h24, mul_one,
    mul_comm (d : ℕ) 8]

lemma C_exists_surj_fin24 : ∃ φ : Fin 8 × Fin 3 → C, Function.Surjective φ := by
  let _ : CommGroup C := { (inferInstance : Group C) with mul_comm := C_mul_comm }
  exact surj_fin24_of_commGroup C_pow_24 C_mod_sq C_mod_cube

