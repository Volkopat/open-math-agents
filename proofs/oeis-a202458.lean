/-- The order-8 recurrence of T, for all m. -/
theorem T_rec (m : ℕ) : (T (m + 8) : ℤ) = 8 * T (m + 7) - 28 * T (m + 6) + 56 * T (m + 5) - 70 * T
    (m + 4) + 56 * T (m + 3) - 28 * T (m + 2) + 8 * T (m + 1) - T m := by
  rcases Nat.lt_or_ge m 3 with hm | hm
  · obtain ⟨v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10⟩ := T_vals
    interval_cases m <;> simp only [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10] <;> norm_num
  · obtain ⟨k, rfl⟩ : ∃ k, m = k + 3 := ⟨m - 3, by omega⟩
    unfold T
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl
      (fun c _ => ?_)))
    have h := G_rec k a b c
    rw [show k + 3 + 8 = k + 11 by omega, show k + 3 + 7 = k + 10 by omega, show k + 3 + 6 = k + 9
      by omega, show k + 3 + 5 = k + 8 by omega, show k + 3 + 4 = k + 7 by omega, show k + 3 + 3 =
      k + 6 by omega, show k + 3 + 2 = k + 5 by omega, show k + 3 + 1 = k + 4 by omega]
    linarith

/-- Barker's recurrence, for n > 8. -/
theorem recurrence (n : ℕ) (hn : 8 < n) : (a n : ℤ) = 8 * a (n - 1) - 28 * a (n - 2) + 56 * a (n -
    3) - 70 * a (n - 4) + 56 * a (n - 5) - 28 * a (n - 6) + 8 * a (n - 7) - a (n - 8) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 9 := ⟨n - 9, by omega⟩
  rw [show k + 9 = (k + 8) + 1 from rfl, show k + 8 + 1 - 1 = (k + 7) + 1 by omega, show k + 8 + 1 -
    2 = (k + 6) + 1 by omega, show k + 8 + 1 - 3 = (k + 5) + 1 by omega, show k + 8 + 1 - 4 = (k +
    4) + 1 by omega, show k + 8 + 1 - 5 = (k + 3) + 1 by omega, show k + 8 + 1 - 6 = (k + 2) + 1 by
    omega, show k + 8 + 1 - 7 = (k + 1) + 1 by omega, show k + 8 + 1 - 8 = k + 1 by omega]
  simp only [a_T]
  exact T_rec k

