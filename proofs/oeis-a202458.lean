/-- The 12 good rows. -/
def R : Fin 12 → Fin 7 → Bool :=
  ![![false, false, false, false, false, false, false],
    ![false, false, false, false, false, false, true],
    ![false, false, false, false, false, true, false],
    ![false, false, false, false, false, true, true],
    ![false, false, false, false, true, false, false],
    ![false, false, false, false, true, false, true],
    ![false, false, false, false, true, true, false],
    ![false, false, false, false, true, true, true],
    ![false, false, false, true, true, true, true],
    ![false, false, true, true, true, true, true],
    ![false, true, true, true, true, true, true],
    ![true, true, true, true, true, true, true]]

lemma rowR : ∀ r : Fin 7 → Bool, windowsOK (List.ofFn r) = true ↔ ∃ c, R c = r := by
  decide +kernel

lemma R_inj : Function.Injective R := by
  decide +kernel

/-- The column condition on four consecutive rows. -/
def step4 (r0 r1 r2 r3 : Fin 7 → Bool) : Bool :=
  decide (∀ j, win (r0 j) (r1 j) (r2 j) ≤ win (r1 j) (r2 j) (r3 j))

/-- The column condition along a list of rows. -/
def chain : List (Fin 7 → Bool) → Bool
  | r0 :: r1 :: r2 :: r3 :: rest => step4 r0 r1 r2 r3 && chain (r1 :: r2 :: r3 :: rest)
  | _ => true

theorem windows_map : ∀ l : List (Fin 7 → Bool),
    (∀ j, windowsOK (l.map fun r => r j) = true) ↔ chain l = true
  | r0 :: r1 :: r2 :: r3 :: rest => by
    have ih := windows_map (r1 :: r2 :: r3 :: rest)
    simp only [List.map_cons] at ih ⊢
    simp only [windowsOK, chain, step4, Bool.and_eq_true, decide_eq_true_eq] at ih ⊢
    rw [← ih]
    constructor
    · intro h
      exact ⟨fun j => (h j).1, fun j => (h j).2⟩
    · rintro ⟨h1, h2⟩ j
      exact ⟨h1 j, h2 j⟩
  | [] => by simp [windowsOK, chain]
  | [_] => by simp [windowsOK, chain]
  | [_, _] => by simp [windowsOK, chain]
  | [_, _, _] => by simp [windowsOK, chain]

theorem good_iff {r : ℕ} (x : Fin r → Fin 7 → Bool) :
    good x = true ↔ (∀ i, ∃ c, R c = x i) ∧ chain (List.ofFn x) = true := by
  unfold good
  rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq, ← windows_map]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun i => (rowR (x i)).1 (h1 i), fun j => ?_⟩
    rw [List.map_ofFn]
    exact h2 j
  · rintro ⟨h1, h2⟩
    refine ⟨fun i => (rowR (x i)).2 (h1 i), fun j => ?_⟩
    have := h2 j
    rwa [List.map_ofFn] at this

/-- The column condition on codes of rows. -/
def step4C (a b c d : Fin 12) : Bool := step4 (R a) (R b) (R c) (R d)

/-- The column condition along a list of codes. -/
def chainC : List (Fin 12) → Bool
  | a :: b :: c :: d :: rest => step4C a b c d && chainC (b :: c :: d :: rest)
  | _ => true

theorem chain_map : ∀ l : List (Fin 12), chain (l.map R) = chainC l
  | a :: b :: c :: d :: rest => by
    simp only [List.map_cons, chain, chainC, step4C]
    rw [← List.map_cons, ← List.map_cons, ← List.map_cons, chain_map (b :: c :: d :: rest)]
  | [] => rfl
  | [_] => rfl
  | [_, _] => rfl
  | [_, _, _] => rfl

/-- The count over codes of rows. -/
theorem a_codes (n : ℕ) :
    a n = (Finset.univ.filter fun y : Fin (n + 2) → Fin 12 => chainC (List.ofFn y) = true).card := by
  symm
  unfold a
  apply Finset.card_bij (fun y _ => fun i => R (y i))
  · intro y hy
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hy ⊢
    rw [good_iff]
    refine ⟨fun i => ⟨y i, rfl⟩, ?_⟩
    rw [show List.ofFn (fun i => R (y i)) = (List.ofFn y).map R by rw [List.map_ofFn]; rfl, chain_map]
    exact hy
  · intro y₁ _ y₂ _ h
    funext i
    exact R_inj (congrFun h i)
  · intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
    rw [good_iff] at hx
    obtain ⟨h1, h2⟩ := hx
    choose y hy using h1
    refine ⟨y, ?_, funext hy⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [← chain_map, show (List.ofFn y).map R = List.ofFn x by rw [List.map_ofFn]; exact congrArg _ (funext hy)]
    exact h2

theorem sum_cons (m : ℕ) (f : List (Fin 12) → ℕ) :
    ∑ x : Fin (m + 1) → Fin 12, f (List.ofFn x) = ∑ c : Fin 12, ∑ y : Fin m → Fin 12, f (c :: List.ofFn y) := by
  rw [← (Fin.consEquiv fun _ => Fin 12).sum_comp, Fintype.sum_prod_type]
  simp [List.ofFn_succ]

/-- The continuations by m rows of the column condition from the rows a, b, c. -/
def G (a b c : Fin 12) (m : ℕ) : ℕ :=
  ∑ y : Fin m → Fin 12, if chainC (a :: b :: c :: List.ofFn y) = true then 1 else 0

theorem G_zero (a b c : Fin 12) : G a b c 0 = 1 := by
  simp [G, chainC]

theorem G_succ (a b c : Fin 12) (m : ℕ) :
    G a b c (m + 1) = ∑ d : Fin 12, if step4C a b c d = true then G b c d m else 0 := by
  unfold G
  rw [sum_cons m (fun l => if chainC (a :: b :: c :: l) = true then 1 else 0)]
  apply Finset.sum_congr rfl
  intro d _
  by_cases hd : step4C a b c d = true
  · rw [if_pos hd]
    apply Finset.sum_congr rfl
    intro y _
    simp only [chainC, hd, Bool.true_and]
  · rw [if_neg hd]
    apply Finset.sum_eq_zero
    intro y _
    have hd' := Bool.eq_false_iff.mpr hd
    simp [chainC, hd']

/-- The total count over the first three rows. -/
def T (m : ℕ) : ℕ := ∑ a : Fin 12, ∑ b : Fin 12, ∑ c : Fin 12, G a b c m

theorem a_T (m : ℕ) : a (m + 1) = T m := by
  rw [a_codes, Finset.card_filter]
  rw [show m + 1 + 2 = (m + 2) + 1 from rfl, sum_cons (m + 2) (fun l => if chainC l = true then 1 else 0)]
  unfold T G
  apply Finset.sum_congr rfl
  intro a _
  rw [sum_cons (m + 1) (fun l => if chainC (a :: l) = true then 1 else 0)]
  apply Finset.sum_congr rfl
  intro b _
  rw [sum_cons m (fun l => if chainC (a :: b :: l) = true then 1 else 0)]

/-- A window comparison: the first bit forces the other three. -/
lemma win_le (b0 b1 b2 b3 : Bool) :
    win b0 b1 b2 ≤ win b1 b2 b3 ↔ (b0 = true → b1 = true ∧ b2 = true ∧ b3 = true) := by
  revert b0 b1 b2 b3
  decide

/-- The 1-set of row a lies in that of row b. -/
def subT (a b : Fin 12) : Bool := (([[true, true, true, true, true, true, true, true, true, true, true, true], [false, true, false, true, false, true, false, true, true, true, true, true], [false, false, true, true, false, false, true, true, true, true, true, true], [false, false, false, true, false, false, false, true, true, true, true, true], [false, false, false, false, true, true, true, true, true, true, true, true], [false, false, false, false, false, true, false, true, true, true, true, true], [false, false, false, false, false, false, true, true, true, true, true, true], [false, false, false, false, false, false, false, true, true, true, true, true], [false, false, false, false, false, false, false, false, true, true, true, true], [false, false, false, false, false, false, false, false, false, true, true, true], [false, false, false, false, false, false, false, false, false, false, true, true], [false, false, false, false, false, false, false, false, false, false, false, true]] : List (List Bool)).getD a.val []).getD b.val false

lemma subT_eq : ∀ a b : Fin 12, subT a b = decide (∀ j, R a j = true → R b j = true) := by
  decide +kernel

lemma step4C_eq (a b c d : Fin 12) : step4C a b c d = (subT a b && subT a c && subT a d) := by
  rw [subT_eq, subT_eq, subT_eq]
  unfold step4C step4
  simp only [win_le]
  rw [Bool.eq_iff_iff]
  simp only [Bool.and_eq_true, decide_eq_true_eq]
  constructor
  · intro h
    exact ⟨⟨fun j hj => (h j hj).1, fun j hj => (h j hj).2.1⟩, fun j hj => (h j hj).2.2⟩
  · rintro ⟨⟨h1, h2⟩, h3⟩ j hj
    exact ⟨h1 j hj, h2 j hj, h3 j hj⟩

/-- A table lookup. -/
def look (t : List (List (List ℕ))) (a b c : Fin 12) : ℕ := ((t.getD a.val []).getD b.val []).getD c.val 0

