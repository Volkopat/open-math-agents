/-- Barker's g.f., as A(x) (1 - x)^8 = N(x) in Z[[x]]. -/
theorem gf : PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 8 =
    X * (1728 - 9687 * X + 24626 * X ^ 2 - 36022 * X ^ 3 + 32318 * X ^ 4 - 17650 * X ^ 5 + 5408 * X
      ^ 6 - 715 * X ^ 7) := by
  set A : ℤ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) with hA
  have e1 : A * (1 - X) ^ 8 =
      A - C 8 * (A * X ^ 1) + C 28 * (A * X ^ 2) - C 56 * (A * X ^ 3) + C 70 * (A * X ^ 4) - C 56 *
        (A * X ^ 5) + C 28 * (A * X ^ 6) - C 8 * (A * X ^ 7) + A * X ^ 8 := by
    simp only [map_ofNat]; ring
  have e2 : (X * (1728 - 9687 * X + 24626 * X ^ 2 - 36022 * X ^ 3 + 32318 * X ^ 4 - 17650 * X ^ 5 +
    5408 * X ^ 6 - 715 * X ^ 7) : ℤ⟦X⟧) =
      X ^ 1 * C 1728 - X ^ 2 * C 9687 + X ^ 3 * C 24626 - X ^ 4 * C 36022 + X ^ 5 * C 32318 - X ^
        6 * C 17650 + X ^ 7 * C 5408 - X ^ 8 * C 715 := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℤ) else a k := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  have v := values
  rcases Nat.lt_or_ge n 9 with hn | hn
  · interval_cases n <;> simp_all
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 9 := ⟨n - 9, by omega⟩
    have h := recurrence (q + 9) (by omega)
    simp only [show q + 9 - 1 = q + 8 by omega, show q + 9 - 2 = q + 7 by omega, show q + 9 - 3 =
      q + 6 by omega, show q + 9 - 4 = q + 5 by omega, show q + 9 - 5 = q + 4 by omega, show q + 9 -
      6 = q + 3 by omega, show q + 9 - 7 = q + 2 by omega, show q + 9 - 8 = q + 1 by omega] at h ⊢
    simp only [show ¬ q + 9 = 0 by omega, show ¬ q + 8 = 0 by omega, show ¬ q + 7 = 0 by omega, show
      ¬ q + 6 = 0 by omega, show ¬ q + 5 = 0 by omega, show ¬ q + 4 = 0 by omega, show ¬ q + 3 = 0
      by omega, show ¬ q + 2 = 0 by omega, show ¬ q + 1 = 0 by omega, show 1 ≤ q + 9 by omega, show
      2 ≤ q + 9 by omega, show 3 ≤ q + 9 by omega, show 4 ≤ q + 9 by omega, show 5 ≤ q + 9 by omega,
      show 6 ≤ q + 9 by omega, show 7 ≤ q + 9 by omega, show 8 ≤ q + 9 by omega, show ¬ q + 9 = 1 by
      omega, show ¬ q + 9 = 2 by omega, show ¬ q + 9 = 3 by omega, show ¬ q + 9 = 4 by omega, show ¬
      q + 9 = 5 by omega, show ¬ q + 9 = 6 by omega, show ¬ q + 9 = 7 by omega, show ¬ q + 9 = 8 by
      omega, if_true, if_false]
    rw [h]
    ring

/-- Hardin's empirical formula, for n >= 1. -/
theorem empirical (n : ℕ) (hn : 1 ≤ n) : (a n : ℚ) = 1 / 840 * n ^ 7 + 3 / 40 * n ^ 6 + 47 / 30 * n
    ^ 5 + 16 * n ^ 4 + 10847 / 120 * n ^ 3 + 11557 / 40 * n ^ 2 + 258737 / 420 * n + 715 := by
  obtain ⟨w1, w2, w3, w4, w5, w6, w7, w8⟩ := values
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 9 with h7 | h7
    · interval_cases n
      · rw [w1]; norm_num
      · rw [w2]; norm_num
      · rw [w3]; norm_num
      · rw [w4]; norm_num
      · rw [w5]; norm_num
      · rw [w6]; norm_num
      · rw [w7]; norm_num
      · rw [w8]; norm_num
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + 9 := ⟨n - 9, by omega⟩
      have h := recurrence (k + 9) (by omega)
      simp only [show k + 9 - 1 = k + 8 by omega, show k + 9 - 2 = k + 7 by omega, show k + 9 - 3 =
        k + 6 by omega, show k + 9 - 4 = k + 5 by omega, show k + 9 - 5 = k + 4 by omega, show k +
        9 - 6 = k + 3 by omega, show k + 9 - 7 = k + 2 by omega, show k + 9 - 8 = k + 1 by omega] at h
      have h' : (a (k + 9) : ℚ) = 8 * a (k + 8) - 28 * a (k + 7) + 56 * a (k + 6) - 70 * a (k + 5) +
          56 * a (k + 4) - 28 * a (k + 3) + 8 * a (k + 2) - a (k + 1) := by exact_mod_cast h
      rw [h', ih (k + 8) (by omega) (by omega), ih (k + 7) (by omega) (by omega), ih (k + 6) (by
        omega) (by omega), ih (k + 5) (by omega) (by omega), ih (k + 4) (by omega) (by omega), ih
        (k + 3) (by omega) (by omega), ih (k + 2) (by omega) (by omega), ih (k + 1) (by omega) (by
        omega)]
      push_cast
      ring

