/-- Shifting a factorial. -/
lemma fsh (E : ℕ) : ∀ j : ℕ, ((E + j).factorial : ℚ)
    = (∏ i ∈ Finset.range j, ((E : ℚ) + (i : ℚ) + 1)) * (E.factorial : ℚ)
  | 0 => by simp
  | j + 1 => by
    rw [show E + (j + 1) = (E + j) + 1 from rfl, Nat.factorial_succ, Finset.prod_range_succ]
    push_cast
    rw [fsh E j]
    ring

/-- The summand in factorial form, as a function of k and t = n - k. -/
noncomputable def Φ (k t : ℕ) : ℚ :=
  (1 : ℚ) ^ k * (1 : ℚ) ^ t * ((4 * k + 4 * t + 2).factorial : ℚ)
    / (((k).factorial : ℚ) * ((3 * k + 4 * t + 2).factorial : ℚ)) * ((3 * k + 4 * t).factorial : ℚ)
    / (((t).factorial : ℚ) * ((3 * k + 3 * t).factorial : ℚ))

/-- The summand of the sequence. -/
def F (n k : ℕ) : ℤ :=
  (1 : ℤ) ^ k * (1 : ℤ) ^ (n - k) * ((4 * n + 2).choose k : ℤ) * ((4 * n - k).choose (n - k) : ℤ)

lemma a_eq (n : ℕ) : a n = ∑ k ∈ Finset.range (n + 1), F n k := by
  unfold a
  apply Finset.sum_congr rfl
  intro k _
  unfold F
  ring

lemma F_eq (k t : ℕ) : (F (k + t) k : ℚ) = Φ k t := by
  have h1 : ((4 * (k + t) + 2).choose k : ℚ)
      = ((4 * k + 4 * t + 2).factorial : ℚ) / ((k.factorial : ℚ) * ((3 * k + 4 * t + 2).factorial : ℚ)) := by
    rw [Nat.cast_choose ℚ (by omega : k ≤ 4 * (k + t) + 2)]
    rw [show 4 * (k + t) + 2 - k = 3 * k + 4 * t + 2 from by omega,
      show 4 * (k + t) + 2 = 4 * k + 4 * t + 2 from by ring]
  have h2 : ((4 * (k + t) - k).choose (k + t - k) : ℚ)
      = ((3 * k + 4 * t).factorial : ℚ) / ((t.factorial : ℚ) * ((3 * k + 3 * t).factorial : ℚ)) := by
    rw [Nat.add_sub_cancel_left, show 4 * (k + t) - k = 3 * k + 4 * t from by omega]
    rw [Nat.cast_choose ℚ (by omega : t ≤ 3 * k + 4 * t)]
    rw [show 3 * k + 4 * t - t = 3 * k + 3 * t from by omega]
  unfold F Φ
  push_cast
  rw [h1, h2, Nat.add_sub_cancel_left]
  ring


