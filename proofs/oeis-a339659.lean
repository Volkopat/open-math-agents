/-- Each listed graph has the listed degree multiset. -/
theorem W_deg : ∀ w ∈ W, (Finset.univ.val.map fun v => (gr w.2).degree v) = (w.1 : Multiset ℕ) := by
  decide +kernel

theorem W_shape : ∀ w ∈ W, w.1.length = 6 ∧ (∀ x ∈ w.1, 1 ≤ x) ∧ Even w.1.sum := by
  decide +kernel

/-- The degree multisets of the witness graphs. -/
def T : Finset (Multiset ℕ) := (W.map fun w => (w.1 : Multiset ℕ)).toFinset

/-- The 71 degree multisets are pairwise distinct. -/
theorem T_card : T.card = 71 := by decide +kernel

theorem sub : (T : Set (Multiset ℕ)) ⊆
    {m : Multiset ℕ | Multiset.card m = 6 ∧ (∀ x ∈ m, 1 ≤ x) ∧ Even m.sum ∧ IsGraphical 6 m} := by
  intro m hm
  rw [Finset.mem_coe, T, List.mem_toFinset, List.mem_map] at hm
  obtain ⟨w, hw, rfl⟩ := hm
  obtain ⟨h1, h2, h3⟩ := W_shape w hw
  rw [Set.mem_ofPred_eq]
  exact ⟨by simpa using h1, fun x hx => h2 x (by simpa using hx), by simpa using h3, gr w.2, inferInstance,
    W_deg w hw⟩

/-- The set counted by `colSum 6` is finite: every degree is at most 5. -/
theorem fin6 : {m : Multiset ℕ | Multiset.card m = 6 ∧ (∀ x ∈ m, 1 ≤ x) ∧ Even m.sum ∧ IsGraphical 6 m}.Finite := by
  apply (Set.finite_range fun f : Fin 6 → Fin 6 => Finset.univ.val.map fun v => (f v : ℕ)).subset
  rintro m ⟨-, -, -, G, inst, hG⟩
  exact ⟨fun v => ⟨G.degree v, by simpa using G.degree_lt_card_verts v⟩, by simpa using hG⟩

/-- Column 6 of A339659 sums to at least 71. -/
theorem col6 : 71 ≤ colSum 6 := by
  unfold colSum
  calc 71 = T.card := T_card.symm
    _ = (T : Set (Multiset ℕ)).ncard := (Set.ncard_coe_finset T).symm
    _ ≤ _ := Set.ncard_le_ncard sub fin6

end OMA.A339659Proof

/-- The conjecture fails at column 6: its sum is at least 71 (it is 71), while `A304787(5) = 67`. -/
theorem OMA.disproof : ¬ (type_of% @OMA.S_oeis_a339659.main) := by
  intro h
  have h6 := h 6 (by norm_num)
  rw [show (6 : ℕ) - 1 = 5 from rfl, OMA.A339659Proof.A304787_five] at h6
  have h71 := OMA.A339659Proof.col6
  omega
