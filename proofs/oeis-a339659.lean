/-! ### `A304787 5 = 67` -/

/-- `(1 + Y)^c = 1 + c Y + Y^2 S` for some polynomial `S`. -/
theorem split (Y : ℕ[X]) (c : ℕ) : ∃ S : ℕ[X], (1 + Y) ^ c = 1 + C c * Y + Y ^ 2 * S := by
  induction c with
  | zero => exact ⟨0, by simp⟩
  | succ c ih =>
    obtain ⟨S, hS⟩ := ih
    refine ⟨C c + S + Y * S, ?_⟩
    rw [pow_succ, hS, map_add, map_one]
    ring

/-- Multiplying by `(1 + X^j)^c` does not change the coefficients below degree `j`. -/
theorem coeff_lt (p : ℕ[X]) (j c m : ℕ) (hm : m < j) : (p * (1 + X ^ j) ^ c).coeff m = p.coeff m := by
  obtain ⟨S, hS⟩ := split (X ^ j) c
  rw [hS, show p * (1 + C c * X ^ j + (X ^ j) ^ 2 * S) = p + X ^ j * (C c * p + X ^ j * (p * S)) by ring,
    coeff_add, coeff_X_pow_mul', if_neg (show ¬ (j ≤ m) by omega), add_zero]

/-- For `j ≤ m < 2j`, multiplying by `(1 + X^j)^c` adds `c` times the coefficient of degree `m - j`. -/
theorem coeff_ge (p : ℕ[X]) (j c m k : ℕ) (hk : k + j = m) (hm : m < 2 * j) :
    (p * (1 + X ^ j) ^ c).coeff m = p.coeff m + c * p.coeff k := by
  obtain ⟨S, hS⟩ := split (X ^ j) c
  rw [hS, show p * (1 + C c * X ^ j + (X ^ j) ^ 2 * S) = p + C c * (p * X ^ j) + X ^ j * X ^ j * (p * S) by ring,
    coeff_add, coeff_add, coeff_C_mul, coeff_mul_X_pow', if_pos (show j ≤ m by omega), ← pow_add,
    coeff_X_pow_mul', if_neg (show ¬ (j + j ≤ m) by omega), add_zero, show m - j = k by omega]

theorem prod5 (f : ℕ → ℕ[X]) : ∏ j ∈ Finset.Icc 1 5, f j = f 1 * f 2 * f 3 * f 4 * f 5 := by
  rw [Finset.prod_Icc_succ_top (show 1 ≤ 4 + 1 by norm_num), Finset.prod_Icc_succ_top (show 1 ≤ 3 + 1 by norm_num),
    Finset.prod_Icc_succ_top (show 1 ≤ 2 + 1 by norm_num), Finset.prod_Icc_succ_top (show 1 ≤ 1 + 1 by norm_num),
    Finset.Icc_self, Finset.prod_singleton]

/-- The product defining `A304787 5`, with the Catalan exponents 1, 2, 5, 14, 42. -/
theorem prod5' : (∏ j ∈ Finset.Icc 1 5, (1 + X ^ j : ℕ[X]) ^ (Nat.choose (2 * j) j / (j + 1))) =
    (1 + X ^ 1) ^ 1 * (1 + X ^ 2) ^ 2 * (1 + X ^ 3) ^ 5 * (1 + X ^ 4) ^ 14 * (1 + X ^ 5) ^ 42 := by
  rw [prod5]
  rfl

theorem q0 : ((1 + X ^ 1 : ℕ[X]) ^ 1 * (1 + X ^ 2) ^ 2) =
    1 + X + X ^ 2 + X ^ 2 + X ^ 3 + X ^ 3 + X ^ 4 + X ^ 5 := by ring

/-- `A304787 5 = 42 + 14 + 10 + 1 = 67`. -/
theorem A304787_five : A304787 5 = 67 := by
  unfold A304787
  rw [prod5', coeff_ge _ 5 42 5 0 (by norm_num) (by norm_num), coeff_ge _ 4 14 5 1 (by norm_num) (by norm_num),
    coeff_lt _ 4 14 0 (by norm_num), coeff_ge _ 3 5 5 2 (by norm_num) (by norm_num), coeff_lt _ 3 5 1 (by norm_num),
    coeff_lt _ 3 5 0 (by norm_num), q0]
  simp only [coeff_add, coeff_one, coeff_X, coeff_X_pow]
  decide

