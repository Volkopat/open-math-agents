private structure FormulaPair (P : Prop) where
  smaller : CNF Nat
  larger : CNF Nat
  eq : P = (smaller.Unsat ∧ larger.Unsat)

private def cnfs : FormulaPair OMA.R_Erdos982_erdos_982_R1.H1 := by
  unfold OMA.R_Erdos982_erdos_982_R1.H1
  exact ⟨_, _, rfl⟩

private structure Pieces (f : CNF Nat) where
  atom : Type
  enc : atom → Nat
  eqv : List (CNF.Clause atom)
  ord : List (CNF.Clause atom)
  cls : List (CNF.Clause atom)
  side : List (CNF.Clause atom)
  acute : List (CNF.Clause atom)
  eq : f = (⟨(eqv ++ ord ++ cls ++ side ++ acute).toArray⟩ : CNF atom).relabel enc

private def pieces10 : Pieces cnfs.larger := by
  exact ⟨_, _, _, _, _, _, _, rfl⟩

private structure Blocks {α : Type} (clauses : List (CNF.Clause α)) where
  index : Type
  indices : List index
  make : index → List (CNF.Clause α)
  eq : clauses = indices.flatMap make

private def eqv10 : Blocks pieces10.eqv := by
  exact ⟨_, _, _, rfl⟩

private def class10 : Blocks pieces10.cls := by
  exact ⟨_, _, _, rfl⟩

private def side10 : Blocks pieces10.side := by
  exact ⟨_, _, _, rfl⟩

private structure Order {α : Type} (clauses : List (CNF.Clause α)) where
  comparisons : List (CNF.Clause α)
  chains : List (CNF.Clause α)
  eq : clauses = comparisons ++ chains

private def order10 : Order pieces10.ord := by
  exact ⟨_, _, rfl⟩

private def comparisons10 : Blocks order10.comparisons := by
  exact ⟨_, _, _, rfl⟩

private def chains10 : Blocks order10.chains := by
  exact ⟨_, _, _, rfl⟩

private def number (p : Nat) {α : Type} {ls : List (CNF.Clause α)}
    (blocks : Blocks ls) (enc : α → Nat) : List Clause :=
  ((blocks.indices[p]?).toList.flatMap blocks.make).map (CNF.Clause.relabel enc)

private theorem number_mem_block (p : Nat) {α : Type} {ls : List (CNF.Clause α)}
    (blocks : Blocks ls) (enc : α → Nat) {c : Clause} (hc : c ∈ number p blocks enc) :
    ∃ d ∈ ls, CNF.Clause.relabel enc d = c := by
  obtain ⟨d, hd, he⟩ := List.mem_map.mp hc
  refine ⟨d, ?_, he⟩
  rw [blocks.eq]
  obtain ⟨i, hi, hm⟩ := List.mem_flatMap.mp hd
  exact List.mem_flatMap.mpr ⟨i, List.mem_of_getElem? (Option.mem_toList.mp hi), hm⟩

private def sourceBlock (family group : Nat) : List Clause :=
  match family with
  | 0 => number group eqv10 pieces10.enc
  | 1 => number group comparisons10 pieces10.enc
  | 2 => number group chains10 pieces10.enc
  | 3 => number group class10 pieces10.enc
  | 4 => number group side10 pieces10.enc
  | _ => pieces10.acute.map (CNF.Clause.relabel pieces10.enc)

private theorem within {c : Clause} (cgen : ∃ d ∈
    pieces10.eqv ++ pieces10.ord ++ pieces10.cls ++ pieces10.side ++ pieces10.acute,
    CNF.Clause.relabel pieces10.enc d = c) : c ∈ cnfs.larger.clauses := by
  rw [pieces10.eq]
  obtain ⟨d, hd, he⟩ := cgen
  exact Array.mem_map.mpr ⟨d, by simpa using hd, he⟩

private theorem sourceBlock_mem (family group : Nat) {c : Clause}
    (hc : c ∈ sourceBlock family group) : c ∈ cnfs.larger.clauses := by
  apply within
  unfold sourceBlock at hc
  split at hc
  · obtain ⟨d, hd, hd'⟩ := number_mem_block _ _ _ hc
    exact ⟨d, by simp [hd], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := number_mem_block _ _ _ hc
    exact ⟨d, by simp [order10.eq, hd], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := number_mem_block _ _ _ hc
    exact ⟨d, by simp [order10.eq, hd], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := number_mem_block _ _ _ hc
    exact ⟨d, by simp [hd], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := number_mem_block _ _ _ hc
    exact ⟨d, by simp [hd], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := List.mem_map.mp hc
    exact ⟨d, by simp [hd], hd'⟩

private structure Triples {α : Type} (base : List (CNF.Clause α)) where
  coord : Type
  values : List coord
  make : coord → coord → coord → List (CNF.Clause α)
  eq : base = values.flatMap fun p => values.flatMap fun q => values.flatMap fun r => make p q r

private def eqvTriples : Triples pieces10.eqv := by exact ⟨_, _, _, rfl⟩
private def lessTriples : Triples order10.chains := by exact ⟨_, _, _, rfl⟩

private def tripleRow {α : Type} {base : List (CNF.Clause α)}
    (t : Triples base) (i j k : Nat) : List (CNF.Clause α) :=
  match t.values[i]?, t.values[j]?, t.values[k]? with
  | some x, some y, some z => t.make x y z
  | _, _, _ => []

private theorem tripleRow_mem {α : Type} {base : List (CNF.Clause α)}
    (t : Triples base) (i j k : Nat) {c : CNF.Clause α} (h : c ∈ tripleRow t i j k) : c ∈ base := by
  rw [t.eq]
  unfold tripleRow at h
  split at h
  · rename_i x y z h1 h2 h3
    exact List.mem_flatMap.mpr ⟨x, List.mem_of_getElem? h1,
      List.mem_flatMap.mpr ⟨y, List.mem_of_getElem? h2,
        List.mem_flatMap.mpr ⟨z, List.mem_of_getElem? h3, h⟩⟩⟩
  · simp at h

private structure Pairs {α : Type} (base : List (CNF.Clause α)) where
  coord : Type
  values : List coord
  make : coord → coord → List (CNF.Clause α)
  eq : base = values.flatMap fun p => values.flatMap fun q => make p q

private def pairComparisons : Pairs order10.comparisons := by exact ⟨_, _, _, rfl⟩

private def pairRow {α : Type} {base : List (CNF.Clause α)}
    (t : Pairs base) (i j : Nat) : List (CNF.Clause α) :=
  match t.values[i]?, t.values[j]? with
  | some x, some y => t.make x y
  | _, _ => []

private theorem pairRow_mem {α : Type} {base : List (CNF.Clause α)}
    (t : Pairs base) (i j : Nat) {c : CNF.Clause α} (h : c ∈ pairRow t i j) : c ∈ base := by
  rw [t.eq]
  unfold pairRow at h
  split at h
  · rename_i x y h1 h2
    exact List.mem_flatMap.mpr ⟨x, List.mem_of_getElem? h1,
      List.mem_flatMap.mpr ⟨y, List.mem_of_getElem? h2, h⟩⟩
  · simp at h

private structure Quads {α : Type} (base : List (CNF.Clause α)) where
  coord : Type
  values : List coord
  make : coord → coord → coord → coord → List (CNF.Clause α)
  eq : base = values.flatMap fun p => values.flatMap fun q => values.flatMap fun r =>
    values.flatMap fun s => make p q r s

private def sideQuads : Quads pieces10.side := by exact ⟨_, _, _, rfl⟩

private def quadRow {α : Type} {base : List (CNF.Clause α)}
    (t : Quads base) (i j k l : Nat) : List (CNF.Clause α) :=
  match t.values[i]?, t.values[j]?, t.values[k]?, t.values[l]? with
  | some w, some x, some y, some z => t.make w x y z
  | _, _, _, _ => []

private theorem quadRow_mem {α : Type} {base : List (CNF.Clause α)}
    (t : Quads base) (i j k l : Nat) {c : CNF.Clause α} (h : c ∈ quadRow t i j k l) : c ∈ base := by
  rw [t.eq]
  unfold quadRow at h
  split at h
  · rename_i w x y z h1 h2 h3 h4
    exact List.mem_flatMap.mpr ⟨w, List.mem_of_getElem? h1,
      List.mem_flatMap.mpr ⟨x, List.mem_of_getElem? h2,
        List.mem_flatMap.mpr ⟨y, List.mem_of_getElem? h3,
          List.mem_flatMap.mpr ⟨z, List.mem_of_getElem? h4, h⟩⟩⟩⟩
  · simp at h

private def selectConcrete (family i j k l : Nat) : Option Clause :=
  match family with
  | 0 => (tripleRow eqvTriples i j k)[0]?.map (CNF.Clause.relabel pieces10.enc)
  | 1 => (pairRow pairComparisons i j)[k]?.map (CNF.Clause.relabel pieces10.enc)
  | 2 => (tripleRow lessTriples i j k)[0]?.map (CNF.Clause.relabel pieces10.enc)
  | 4 => (quadRow sideQuads i j k l)[0]?.map (CNF.Clause.relabel pieces10.enc)
  | f => (sourceBlock f i)[j]?

private theorem selected_concrete_mem (family i j k l : Nat) {c : Clause}
    (he : selectConcrete family i j k l = some c) : c ∈ cnfs.larger.clauses := by
  unfold selectConcrete at he
  split at he
  · obtain ⟨d, hd, hd'⟩ := Option.map_eq_some_iff.mp he
    have hm := tripleRow_mem eqvTriples i j k (List.mem_of_getElem? hd)
    exact within ⟨d, by simp [hm], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := Option.map_eq_some_iff.mp he
    have hm := pairRow_mem pairComparisons i j (List.mem_of_getElem? hd)
    exact within ⟨d, by simp [order10.eq, hm], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := Option.map_eq_some_iff.mp he
    have hm := tripleRow_mem lessTriples i j k (List.mem_of_getElem? hd)
    exact within ⟨d, by simp [order10.eq, hm], hd'⟩
  · obtain ⟨d, hd, hd'⟩ := Option.map_eq_some_iff.mp he
    have hm := quadRow_mem sideQuads i j k l (List.mem_of_getElem? hd)
    exact within ⟨d, by simp [hm], hd'⟩
  · exact sourceBlock_mem _ _ (List.mem_of_getElem? he)

private def pairByRank (table rank : Nat) : Nat := (table >>> (8 * rank)) &&& 255

private def pairRank (p : Nat) : Nat :=
  let i := p / 10
  let j := p % 10
  9 * i - (i * (i - 1)) / 2 + (j - i - 1)

private def movePair (table r : Nat) (reverse : Bool) (p : Nat) : Nat :=
  pairRank (pairCode r reverse (pairByRank table p))

private def moveMask (r : Nat) (reverse : Bool) (m : Nat) : Nat :=
  (List.range 10).foldl (fun acc u =>
    if m.testBit u then acc ||| (1 <<< move r reverse u) else acc) 0

private def subsetRank (mask : Nat) : List Nat → Nat → Nat
  | [], _ => 0
  | _, 0 => 0
  | v :: rest, k + 1 =>
      if mask.testBit v then subsetRank mask rest k
      else rest.length.choose k + subsetRank mask rest (k + 1)

private def shapeSource (table r : Nat) (reverse : Bool) (shape : Nat) : Option Clause :=
  let family := shape &&& 7
  let x := (shape >>> 3) &&& 63
  let y := (shape >>> 9) &&& 63
  let z := (shape >>> 15) &&& 63
  let w := (shape >>> 21) &&& 63
  let v := move r reverse x
  let subset := moveMask r reverse (shape >>> 9)
  let mv := move r reverse
  let pair := movePair table r reverse
  match family with
  | 0 => selectConcrete 0 (pair x) (pair y) (pair z) 0
  | 1 => selectConcrete 1 (pair x) (pair y) z 0
  | 2 => selectConcrete 2 (pair x) (pair y) (pair z) 0
  | 3 => selectConcrete 3 v (subsetRank subset ((List.range 10).filter (· != v)) 5) 0 0
  | 4 => selectConcrete 4 v (mv y) (mv z) (mv w)
  | 5 =>
    let yp := if reverse then y ^^^ 2 else y
    let i := if x = 10 then 40 + subsetRank subset (List.range 10) 4 else 4 * v + yp
    selectConcrete 5 0 i 0 0
  | _ => none

private theorem shapeSource_mem (table r : Nat) (reverse : Bool) (shape : Nat) {c : Clause}
    (he : shapeSource table r reverse shape = some c) : c ∈ cnfs.larger.clauses := by
  dsimp only [shapeSource] at he
  split at he
  · exact selected_concrete_mem _ _ _ _ _ he
  · exact selected_concrete_mem _ _ _ _ _ he
  · exact selected_concrete_mem _ _ _ _ _ he
  · exact selected_concrete_mem _ _ _ _ _ he
  · exact selected_concrete_mem _ _ _ _ _ he
  · exact selected_concrete_mem _ _ _ _ _ he
  · simp at he

private def original (data : PackedTree) (i : Nat) : Nat :=
  match getPacked data 9 (i / 16) with
  | none => 0
  | some (words, _) => mask16 (words >>> (16 * (i % 16)))

private def moveLiteral (data : PackedTree) (r : Nat) (reverse : Bool) (x : Lit) : Lit :=
  (moveAtom r reverse (original data x.1), x.2)

private def rootChecked (table : Nat) (vars : PackedTree) (get : Nat → Option Clause)
    (j r : Nat) (reverse : Bool) (shape : Nat) : Bool :=
  match get j with
  | none => false
  | some c =>
      if shape &&& 7 = 6 then
        let v := (shape >>> 3) &&& 63
        decide (v < 10) &&
          (c.any fun x => decide (original vars x.1 = 20000 + v ∧ x.2 = (5).testBit v))
      else
