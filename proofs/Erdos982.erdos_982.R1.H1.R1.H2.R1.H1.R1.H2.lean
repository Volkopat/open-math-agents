        | none => false
        | some d => d.all fun x => (c.map (moveLiteral vars r reverse)).contains x

private theorem rootChecked_sound (table : Nat) (vars : PackedTree) (get : Nat → Option Clause)
    (j r : Nat) (reverse : Bool) (shape : Nat) (a : Nat → Bool) (hf : cnfs.larger.eval a = true)
    (canonical : ∀ i < 10, a (20000 + move r reverse i) = (5).testBit i)
    {c : Clause} (hc : get j = some c) (valid : rootChecked table vars get j r reverse shape = true) :
    satisfied (fun v => a (moveAtom r reverse (original vars v))) c := by
  simp only [rootChecked, hc] at valid
  split at valid
  · obtain ⟨bound, seen⟩ := Bool.and_eq_true_iff.mp valid
    obtain ⟨x, hx, both⟩ := List.any_eq_true.mp seen
    obtain ⟨hindex, htruth⟩ := of_decide_eq_true both
    have hv : (shape >>> 3) &&& 63 < 10 := of_decide_eq_true bound
    refine ⟨x, hx, ?_⟩
    change a (moveAtom r reverse (original vars x.1)) = x.2
    rw [hindex, htruth, move_acute r reverse _ hv]
    exact canonical _ hv
  · split at valid
    · simp at valid
    · rename_i d hd
      have hm := shapeSource_mem _ _ _ _ hd
      have hmodel := Array.all_eq_true_iff_forall_mem.mp hf d hm
      obtain ⟨x, hx, hassign⟩ := List.any_eq_true.mp hmodel
      have hcontains := List.all_eq_true.mp valid x hx
      obtain ⟨lit, hl, hrot⟩ := List.mem_map.mp (List.contains_iff_mem.mp hcontains)
      subst x
      refine ⟨lit, hl, ?_⟩
      simpa [moveLiteral] using hassign

private def readShapes : Nat → Nat → List Nat
  | 0, _ => []
  | n + 1, t => (t &&& 268435455) :: readShapes n (t >>> 28)

private def checkedRoots (table : Nat) (vars : PackedTree) (get : Nat → Option Clause) :
    Nat → List Nat → Bool
  | _, [] => true
  | start, shape :: rest =>
    ((List.range 10).all fun r =>
      rootChecked table vars get start r false shape &&
      rootChecked table vars get start r true shape) &&
      checkedRoots table vars get (start + 1) rest

private theorem rootBlock_sound (table : Nat) (vars : PackedTree) (get : Nat → Option Clause)
    (r : Nat) (hr : r < 10) (reverse : Bool) (a : Nat → Bool) (hf : cnfs.larger.eval a = true)
    (canonical : ∀ i < 10, a (20000 + move r reverse i) = (5).testBit i)
    (start : Nat) (shapes : List Nat) (checked : checkedRoots table vars get start shapes = true)
    (known : prefixSound (fun v => a (moveAtom r reverse (original vars v))) get start) :
    prefixSound (fun v => a (moveAtom r reverse (original vars v))) get (start + shapes.length) := by
  induction shapes generalizing start with
  | nil => simpa using known
  | cons shape remaining ih =>
    simp only [checkedRoots, Bool.and_eq_true_iff] at checked
    have checkBoth := List.all_eq_true.mp checked.1 r (List.mem_range.mpr hr)
    have check : rootChecked table vars get start r reverse shape = true := by
      obtain ⟨cf, ct⟩ := Bool.and_eq_true_iff.mp checkBoth
      cases reverse
      · exact cf
      · exact ct
    have step : prefixSound (fun v => a (moveAtom r reverse (original vars v))) get (start + 1) := by
      intro j hj c hc
      by_cases prior : j < start
      · exact known j prior c hc
      have e : j = start := by omega
      subst j
      exact rootChecked_sound table vars get start r reverse shape a hf canonical hc check
    have done := ih (start + 1) checked.2 step
    have arith : start + (shape :: remaining).length = start + 1 + remaining.length := by simp; omega
    rwa [arith]

