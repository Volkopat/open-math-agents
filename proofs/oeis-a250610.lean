lemma base : ∀ s : St, comb R Lc 0 s = 0 := by
  have h : (List.range 256).all (fun a => decide ((2 : ℤ) * ((V0.getD a 0 : ℕ) : ℤ) + (-7 : ℤ) * ((V1.getD a 0 : ℕ) : ℤ) + (9 : ℤ) * ((V2.getD a 0 : ℕ) : ℤ) + (-5 : ℤ) * ((V3.getD a 0 : ℕ) : ℤ) + (1 : ℤ) * ((V4.getD a 0 : ℕ) : ℤ) = 0)) = true := by decide +kernel
  intro s
  obtain ⟨a, ha, rfl⟩ := dec_surj s
  have h1 := of_decide_eq_true (List.all_eq_true.1 h a (List.mem_range.2 ha))
  simp only [Lc, comb]
  rw [hV0 a ha, hV1 a ha, hV2 a ha, hV3 a ha, hV4 a ha]
  linarith

lemma rec_tot (n : ℕ) (hn : 0 ≤ n) : combA R Lc n = 0 := by
  rw [combA_eq]
