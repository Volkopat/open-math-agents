/-- The block condition on natural numbers, as a Boolean function. -/
def blkb (a b c d : ℕ) : Bool :=
  decide (d + a ≥ b + c) && decide (d + a ≥ c + b)

lemma blk_iff : ∀ a b c d : Fin 2,
    OMA.S_oeis_a250610.Blk a b c d ↔ blkb a b c d = true := by decide +kernel

/-- The relation `R` on the codes. -/
def Rb (x y : ℕ) : Bool :=
  ((((((blkb (x / 2 ^ (0 : ℕ) % 2) (x / 2 ^ (1 : ℕ) % 2) (y / 2 ^ (0 : ℕ) % 2) (y / 2 ^ (1 : ℕ) % 2) &&
    blkb (x / 2 ^ (1 : ℕ) % 2) (x / 2 ^ (2 : ℕ) % 2) (y / 2 ^ (1 : ℕ) % 2) (y / 2 ^ (2 : ℕ) % 2)) &&
    blkb (x / 2 ^ (2 : ℕ) % 2) (x / 2 ^ (3 : ℕ) % 2) (y / 2 ^ (2 : ℕ) % 2) (y / 2 ^ (3 : ℕ) % 2)) &&
    blkb (x / 2 ^ (3 : ℕ) % 2) (x / 2 ^ (4 : ℕ) % 2) (y / 2 ^ (3 : ℕ) % 2) (y / 2 ^ (4 : ℕ) % 2)) &&
    blkb (x / 2 ^ (4 : ℕ) % 2) (x / 2 ^ (5 : ℕ) % 2) (y / 2 ^ (4 : ℕ) % 2) (y / 2 ^ (5 : ℕ) % 2)) &&
    blkb (x / 2 ^ (5 : ℕ) % 2) (x / 2 ^ (6 : ℕ) % 2) (y / 2 ^ (5 : ℕ) % 2) (y / 2 ^ (6 : ℕ) % 2)) &&
    blkb (x / 2 ^ (6 : ℕ) % 2) (x / 2 ^ (7 : ℕ) % 2) (y / 2 ^ (6 : ℕ) % 2) (y / 2 ^ (7 : ℕ) % 2))

lemma R_iff (x y : ℕ) : R (dec x) (dec y) ↔ Rb x y = true := by
  simp only [Rb, Bool.and_eq_true]
  constructor
  · intro h
    exact ⟨⟨⟨⟨⟨⟨(blk_iff _ _ _ _).1 (h ⟨0, by norm_num⟩), (blk_iff _ _ _ _).1 (h ⟨1, by norm_num⟩)⟩, (blk_iff _ _ _ _).1 (h ⟨2, by norm_num⟩)⟩, (blk_iff _ _ _ _).1 (h ⟨3, by norm_num⟩)⟩, (blk_iff _ _ _ _).1 (h ⟨4, by norm_num⟩)⟩, (blk_iff _ _ _ _).1 (h ⟨5, by norm_num⟩)⟩, (blk_iff _ _ _ _).1 (h ⟨6, by norm_num⟩)⟩
  · intro h i
    fin_cases i
    · exact (blk_iff _ _ _ _).2 h.1.1.1.1.1.1
    · exact (blk_iff _ _ _ _).2 h.1.1.1.1.1.2
    · exact (blk_iff _ _ _ _).2 h.1.1.1.1.2
    · exact (blk_iff _ _ _ _).2 h.1.1.1.2
    · exact (blk_iff _ _ _ _).2 h.1.1.2
    · exact (blk_iff _ _ _ _).2 h.1.2
    · exact (blk_iff _ _ _ _).2 h.2

lemma hT : ∀ a < 256, ∀ b < 256, decide (R (dec a) (dec b)) = bit (Tm.getD a 0) b := by
  have h : (List.range 256).all (fun a => (List.range 256).all
      (fun b => Rb a b == bit (Tm.getD a 0) b)) = true := by decide +kernel
  intro a ha b hb
  have h1 := List.all_eq_true.1 h a (List.mem_range.2 ha)
  have h2 := List.all_eq_true.1 h1 b (List.mem_range.2 hb)
  rw [← beq_iff_eq.1 h2]
  cases hb : Rb a b
  · exact decide_eq_false (fun h => by rw [(R_iff a b).1 h] at hb; cases hb)
  · exact decide_eq_true ((R_iff a b).2 hb)

