    have hne_sr1 : sa ≠ r1a := fun h => hsr1 (Fin.succAbove_right_injective h)
    by_cases hsame : r1a = zg ra
    ·
     rw [show V' (zg r) = V r1a from rfl, show V' r = V ra from rfl, show V' s = V sa from rfl, hsame]
     exact hC.strict_left ra sa hne_sr (by rwa [← hsame])
    ·
     have hra : ra = zaf d := by
      ext
      have h1 : r.1 < m' := r.2
      have hd1 : d.1 < m' + 1 := d.2
      change (d.succAbove r).1 = (d.1 + (m' + 1) - 1) % (m' + 1)
      by_cases hr_lt : r.1 < d.1
      ·
       have hr_val : (d.succAbove r).1 = r.1 := by
        rw [Fin.succAbove_of_castSucc_lt _ _ (by show r.1 < d.1; exact hr_lt)]; rfl
       by_cases hlt2 : r.1 + 1 < d.1
       ·
        exfalso; apply hsame; ext
        have hcs : (zg r).1 = r.1 + 1 := Nat.mod_eq_of_lt (by omega)
        have hv1 : (d.succAbove (zg r)).1 = r.1 + 1 := by
         rw [Fin.succAbove_of_castSucc_lt _ _ (by show (zg r).1 < d.1; omega)]; exact hcs
        change (d.succAbove (zg r)).1 = ((d.succAbove r).1 + 1) % (m' + 1)
        rw [hv1, hr_val, Nat.mod_eq_of_lt (by omega)]
       ·
        have hd_eq : r.1 + 1 = d.1 := by omega
        rw [hr_val]
        have : d.1 + (m' + 1) - 1 = r.1 + (m' + 1) := by omega
        rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
      ·
       have hr_val : (d.succAbove r).1 = r.1 + 1 := by
        rw [Fin.succAbove_of_le_castSucc _ _ (by show d.1 ≤ r.1; omega)]; rfl
       by_cases hr1_lt : r.1 + 1 < m'
       ·
        exfalso; apply hsame; ext
        have hcs : (zg r).1 = r.1 + 1 := Nat.mod_eq_of_lt hr1_lt
        have hv1 : (d.succAbove (zg r)).1 = r.1 + 2 := by
         rw [Fin.succAbove_of_le_castSucc _ _ (by show d.1 ≤ (zg r).1; omega)]; dsimp [Fin.succ]; omega
        change (d.succAbove (zg r)).1 = ((d.succAbove r).1 + 1) % (m' + 1)
