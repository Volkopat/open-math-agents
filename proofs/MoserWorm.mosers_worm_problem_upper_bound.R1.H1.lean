      have h1 := hC.strict_left ra sa hne_sr (by rw [hsucc_ra]; exact hsa_d)
      rw [hsucc_ra] at h1; exact h1
     have hBCS : 0 < det3 B C S := by
      have h1 := hC.strict_left d sa hsa_d (by rwa [← hr1a])
      rwa [← hr1a] at h1
     change 0 < det3 A C S
     by_contra hle; push Not at hle
     set D := det3 A B C
     let α : ℝ := det3 B C S / D
     let β : ℝ := det3 A B S / D
     have hα : 0 < α := div_pos hBCS hD
     have hβ : 0 < β := div_pos hABS hD
     have h1ab : 0 ≤ 1 - α - β := by
      have hq := zib A B C S
      have hDne : D ≠ 0 := ne_of_gt hD
      have heq : 1 - α - β = -det3 A C S / D := by
       dsimp [α, β]; field_simp [hDne]; linarith
      rw [heq]; exact div_nonneg (by linarith) hD.le
     have hcomb1 : S.1 = (1 - α - β) * B.1 + α * A.1 + β * C.1 := by
      have hDne : D ≠ 0 := ne_of_gt hD
      dsimp [α, β, D, det3, zh, sub2] at hDne ⊢
      field_simp [hDne]; ring
     have hcomb2 : S.2 = (1 - α - β) * B.2 + α * A.2 + β * C.2 := by
      have hDne : D ≠ 0 := ne_of_gt hD
      dsimp [α, β, D, det3, zh, sub2] at hDne ⊢
      field_simp [hDne]; ring
     obtain ⟨u, hu⟩ := hExt sa
     have huA : dot2 A u < dot2 S u := hu ra hne_sr.symm
     have huB : dot2 B u < dot2 S u := hu d hsa_d.symm
     have huC : dot2 C u < dot2 S u := hu r1a hne_sr1.symm
     have hdot : dot2 S u = (1 - α - β) * dot2 B u + α * dot2 A u + β * dot2 C u := by
      dsimp [dot2]; rw [hcomb1, hcomb2]; ring
     nlinarith
   obtain ⟨a', ha'⟩ := Fin.exists_succAbove_eq hda.symm
   obtain ⟨b', hb'⟩ := Fin.exists_succAbove_eq hdb.symm
   obtain ⟨c', hc'⟩ := Fin.exists_succAbove_eq hdc.symm
   have hab' : a' < b' := (Fin.succAbove_lt_succAbove_iff (p := d)).mp (by rwa [ha', hb'])
   have hbc' : b' < c' := (Fin.succAbove_lt_succAbove_iff (p := d)).mp (by rwa [hb', hc'])
