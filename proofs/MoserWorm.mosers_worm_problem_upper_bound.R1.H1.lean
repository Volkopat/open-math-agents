      rw [hr1a]; intro h
      have := zbi d d
      rw [h, za3, zero_add, Nat.mod_eq_of_lt (by omega)] at this; omega
     have hD : 0 < det3 A B C := by
      have h1 := hC.strict_left ra r1a hrc_ne (by rw [hsucc_ra]; exact hcd_ne)
      rw [hsucc_ra] at h1; exact h1
