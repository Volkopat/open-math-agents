    have hnn : 0 ≤ zac P iT (Fin.last m) := Finset.sum_nonneg fun _ _ => Real.sqrt_nonneg _
    linarith
   linarith
  set a1 : ℝ := xE - (P iL1).1
  set a2 : ℝ := xE - (P iL2).1
  have ha1_pos : 0 < a1 := by linarith
  let r : ℝ := a1 / y1
  have hr_pos : 0 < r := div_pos ha1_pos hy1_pos
  have ha1_eq : a1 = r * y1 := by dsimp [r]; exact (div_mul_cancel₀ _ (ne_of_gt hy1_pos)).symm
  have ha2_eq : a2 = r * y2 := by
   dsimp [a2, r, a1, xE]
   field_simp [ne_of_gt hy1_pos, ne_of_gt hdy_pos]; ring
  let L2' : V2 := ((P iL2).1, -y2)
  have hd_TL2 : zt (P iT) L2' = zt (P iT) (P iL2) := by
   unfold zt zn ze L2'; rw [hT_y]; congr 1; ring
  have htri : zt (P iL1) L2' ≤ zt (P iL1) (P iT) + zt (P iT) L2' := by
   unfold zt zn ze
   have hab : 0 ≤ ((P iL1).1 - (P iT).1) ^ 2 + ((P iL1).2 - (P iT).2) ^ 2 := by positivity
   have hbc : 0 ≤ ((P iT).1 - L2'.1) ^ 2 + ((P iT).2 - L2'.2) ^ 2 := by positivity
   rw [← Real.sqrt_sq (by positivity : 0 ≤ Real.sqrt (((P iL1).1 - (P iT).1) ^ 2 + ((P iL1).2 - (P iT).2) ^ 2) +
     Real.sqrt (((P iT).1 - L2'.1) ^ 2 + ((P iT).2 - L2'.2) ^ 2))]
   apply Real.sqrt_le_sqrt
   have hcs : ((P iL1).1 - (P iT).1) * ((P iT).1 - L2'.1) + ((P iL1).2 - (P iT).2) * ((P iT).2 - L2'.2) ≤
     Real.sqrt (((P iL1).1 - (P iT).1) ^ 2 + ((P iL1).2 - (P iT).2) ^ 2) *
     Real.sqrt (((P iT).1 - L2'.1) ^ 2 + ((P iT).2 - L2'.2) ^ 2) := by
    simpa [dot2, zn, ze] using
     (@zcq ((P iL1).1 - (P iT).1, (P iL1).2 - (P iT).2) ((P iT).1 - L2'.1, (P iT).2 - L2'.2))
   have hsq1 := Real.sq_sqrt hab; have hsq2 := Real.sq_sqrt hbc
   nlinarith
  have hL1L2'_lt : zt (P iL1) L2' < zt (P iL1) E := by
   have h1 := hDistSub hL1_lt_T.le
   have h2 := hDistSub hT_lt_L2.le
   have h3 : zac P iL1 iT + zac P iT iL2 + zac P iL2 (Fin.last m) = zac P iL1 (Fin.last m) := by
    rw [hSubAdd hL1_lt_T.le hT_lt_L2.le, hSubAdd (hL1_lt_T.le.trans hT_lt_L2.le) (Fin.le_last iL2)]
   have hnn : 0 ≤ zac P iL2 (Fin.last m) := Finset.sum_nonneg fun _ _ => Real.sqrt_nonneg _
   linarith
  have hL1L2'_sq : ((P iL1).1 - L2'.1) ^ 2 + ((P iL1).2 - L2'.2) ^ 2 <
    ((P iL1).1 - E.1) ^ 2 + ((P iL1).2 - E.2) ^ 2 := by
   unfold zt zn ze at hL1L2'_lt
   exact (Real.sqrt_lt_sqrt_iff (by positivity)).mp hL1L2'_lt
  have hy2_pos : 0 < y2 := by
   by_contra hle; push Not at hle
   have hy20 : y2 = 0 := le_antisymm hle (hy_nn iL2)
   have hL2E : L2' = E := by
    apply Prod.ext
    · dsimp [L2', E]; rw [show (P iL2).1 = xE - a2 by dsimp [a2]; ring, ha2_eq, hy20]; ring
    · dsimp [L2', E]; linarith
   rw [hL2E] at hL1L2'_lt; exact lt_irrefl _ hL1L2'_lt
  have hr_gt_one : 1 < r := by
   have heq1 : (P iL1).1 - L2'.1 = r * (y2 - y1) := by dsimp [L2']; linarith only [ha1_eq, ha2_eq]
   have heq2 : (P iL1).2 - L2'.2 = y1 + y2 := by dsimp [L2', y1]; ring
   have heq3 : (P iL1).1 - E.1 = -r * y1 := by dsimp [E]; linarith only [ha1_eq]
   have heq4 : (P iL1).2 - E.2 = y1 := by dsimp [E, y1]; ring
   rw [heq1, heq2, heq3, heq4] at hL1L2'_sq
   have hr2 : 1 < r ^ 2 := by
    nlinarith only [hL1L2'_sq, mul_pos hy1_pos hy2_pos, sq_nonneg (r * y2), sq_nonneg y2]
   nlinarith only [hr2, hr_pos]
  set d0 : ℝ := xE - (P iM).1
  have hd0_ge : r * h ≤ d0 := by
   have hleM : zh (sub2 (P iL2) (P iL1)) (sub2 (P iM) (P iL1)) ≤ 0 := by
    by_cases hm1 : kM = k1.castSucc
    · dsimp [iM, iL1]; rw [hm1]; unfold zh sub2; linarith
    ·
     by_cases hm2 : kM = k1.succ
     · dsimp [iM, iL2]; rw [hm2]; unfold zh sub2; linarith
     · exact le_of_lt (hW.strict_right k1 kM hm1 hm2)
   have hrel : zh (sub2 (P iL2) (P iL1)) (sub2 (P iM) (P iL1)) =
     (y1 - y2) * (r * h - d0) := by
    have hx1 : (P iL1).1 = xE - r * y1 := by linarith [ha1_eq]
    have hx2 : (P iL2).1 = xE - r * y2 := by linarith [ha2_eq]
    have hxM : (P iM).1 = xE - d0 := by dsimp [d0]; ring
    unfold zh sub2
    rw [hx1, hx2, hxM, hMy]
    change (xE - r * y2 - (xE - r * y1)) * (h - y1) - (y2 - y1) * (xE - d0 - (xE - r * y1)) = _
    ring
   rw [hrel] at hleM
   nlinarith only [hleM, hdy_pos]
  have hd0_gt_h : h < d0 := by nlinarith only [hd0_ge, hr_gt_one, hh_pos]
  let den := Real.sqrt (d0 ^ 2 + h ^ 2)
  have hden_pos : 0 < den := Real.sqrt_pos.mpr (by positivity)
  let q : V2 := (h / den, -d0 / den)
  have hq_unit : ze q = 1 := by
   unfold ze q
   have hsq : den ^ 2 = d0 ^ 2 + h ^ 2 := Real.sq_sqrt (by positivity)
   field_simp [ne_of_gt hden_pos]; linarith only [hsq]
  have hq1 := zb0 (a := P iM) (b := P iT) hq_unit
  have hq2 := zb0 (a := P iT) (b := L2') hq_unit
  have hq_sum : dot2 (sub2 (P iT) (P iM)) q + dot2 (sub2 L2' (P iT)) q =
    (2 * d0 * h + y2 * (d0 - r * h)) / den := by
   have hx2 : L2'.1 = xE - r * y2 := by dsimp [L2']; linarith only [ha2_eq]
   have hxM : (P iM).1 = xE - d0 := by dsimp [d0]; ring
   unfold dot2 sub2 q
   rw [hx2, hxM, hMy]
   dsimp [L2']
   field_simp [ne_of_gt hden_pos]; ring
  have hsqrt2_le : Real.sqrt 2 * h ≤ (2 * d0 * h) / den := by
   rw [le_div_iff₀ hden_pos]
   have hsq : (Real.sqrt 2 * h * den) ^ 2 ≤ (2 * d0 * h) ^ 2 := by
    have hden2 : den ^ 2 = d0 ^ 2 + h ^ 2 := Real.sq_sqrt (by positivity)
    have h2sq : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hcalc : (Real.sqrt 2 * h * den) ^ 2 = 2 * h ^ 2 * (d0 ^ 2 + h ^ 2) := by
     calc (Real.sqrt 2 * h * den) ^ 2 = Real.sqrt 2 ^ 2 * h ^ 2 * den ^ 2 := by ring
      _ = 2 * h ^ 2 * (d0 ^ 2 + h ^ 2) := by rw [h2sq, hden2]
    rw [hcalc]
    have hd0_sq : h ^ 2 ≤ d0 ^ 2 := by nlinarith only [hd0_gt_h, hh_pos]
    nlinarith only [hd0_sq, sq_pos_of_pos hh_pos]
   have hlhs_nn : 0 ≤ Real.sqrt 2 * h * den :=
    mul_nonneg (mul_nonneg (Real.sqrt_nonneg 2) hh_pos.le) hden_pos.le
   have hrhs_nn : 0 ≤ 2 * d0 * h := by nlinarith only [hd0_gt_h, hh_pos]
   nlinarith only [hsq, hlhs_nn, hrhs_nn]
  have hdiag : Real.sqrt 2 * h ≤ zt (P iM) (P iT) + zt (P iT) (P iL2) := by
   rw [← hd_TL2]
   have hpos_extra : 0 ≤ y2 * (d0 - r * h) / den :=
    div_nonneg (mul_nonneg hy2_pos.le (by linarith only [hd0_ge])) hden_pos.le
   have hadd : (2 * d0 * h) / den ≤ (2 * d0 * h + y2 * (d0 - r * h)) / den := by
    rw [add_div]; linarith only [hpos_extra]
   linarith only [hq1, hq2, hq_sum, hsqrt2_le, hadd]
  have hFM_ge : h ≤ zac P iF iM := by
   have := hVert hFM.le; rw [hF_y, hMy, sub_zero, abs_of_pos hh_pos] at this; exact this
  have hMT_ge : zt (P iM) (P iT) ≤ zac P iM iT := hDistSub hMT.le
  have hTL2_ge : zt (P iT) (P iL2) ≤ zac P iT iL2 := hDistSub hT_lt_L2.le
  have htot : zac P iF iM + zac P iM iT + zac P iT iL2 = zac P iF iL2 := by
   rw [hSubAdd hFM.le hMT.le, hSubAdd (hFM.le.trans hMT.le) hT_lt_L2.le]
  have hle := hSubLe iF iL2
  nlinarith only [hFM_ge, hMT_ge, hTL2_ge, hdiag, htot, hle]
lemma zb5 {K m n : ℕ} {W : Fin (m + 1) → Fin (n + 1)}
  (h3 : zu W) {f : Fin K → Fin (m + 1)} (hf : Monotone f)
  (hK : 0 < K) :
  zu (W ∘ f) := by
 obtain ⟨a, b, hab, hp1, hp2, hp3⟩ := h3
 let k0 : Fin K := ⟨0, hK⟩
 let kl : Fin K := ⟨K - 1, by omega⟩
 by_cases hab_eq : a = b
 ·
  subst hab_eq
  refine ⟨kl, kl, le_rfl, ?_, fun i j h1 h2 h3 => by
   have : i = j := le_antisymm h2 (h3.trans h1); rw [this],
   fun i j h1 h2 => by
   have hi : i = kl := le_antisymm (Fin.le_iff_val_le_val.mpr (by have := i.2; dsimp [kl]; omega)) h1
   have hj : j = kl := le_antisymm (Fin.le_iff_val_le_val.mpr (by have := j.2; dsimp [kl]; omega)) (h1.trans h2)
   rw [hi, hj]⟩
  intro i j hij _
  by_cases hfa : f j ≤ a
  · exact hp1 (f i) (f j) (hf hij) hfa
  ·
   by_cases hfi : a ≤ f i
   · exact hp3 (f i) (f j) hfi (hf hij)
   · exact (hp3 a (f j) le_rfl (le_of_not_ge hfa)).trans (hp1 (f i) a (le_of_not_ge hfi) le_rfl)
 ·
  have hab_lt : a < b := lt_of_le_of_ne hab hab_eq
  let SL := Finset.univ.filter (fun i : Fin K => f i ≤ a)
  let SR := Finset.univ.filter (fun i : Fin K => b ≤ f i)
  have hL_dec : ∀ i j : Fin K, i ≤ j → f j ≤ a → W (f j) ≤ W (f i) :=
   fun i j hij hj => hp1 (f i) (f j) (hf hij) hj
  have hM_inc : ∀ i j : Fin K, i ≤ j → a ≤ f i → f j ≤ b → W (f i) ≤ W (f j) :=
   fun i j hij hi hj => hp2 (f i) (f j) hi (hf hij) hj
  have hR_dec : ∀ i j : Fin K, i ≤ j → b ≤ f i → W (f j) ≤ W (f i) :=
   fun i j hij hi => hp3 (f i) (f j) hi (hf hij)
  by_cases hSL : SL.Nonempty
  ·
   by_cases hSR : SR.Nonempty
   ·
    let iL := SL.max' hSL
    let iR := SR.min' hSR
    have hiL_le : f iL ≤ a := (Finset.mem_filter.mp (Finset.max'_mem SL hSL)).2
    have hiR_ge : b ≤ f iR := (Finset.mem_filter.mp (Finset.min'_mem SR hSR)).2
    have hiL_lt_iR : iL < iR := by
     by_contra hge; push Not at hge
     have h1 := hf hge
     exact not_lt_of_ge (hiR_ge.trans (h1.trans hiL_le)) hab_lt
    have hgt_iL : ∀ i : Fin K, iL < i → a < f i := by
     intro i hi; by_contra hle; push Not at hle
     have hm : i ≤ iL := Finset.le_max' SL i (by simp [SL, hle])
     exact not_le_of_gt hi hm
    have hlt_iR : ∀ i : Fin K, i < iR → f i < b := by
     intro i hi; by_contra hge; push Not at hge
     have hm : iR ≤ i := Finset.min'_le SR i (by simp [SR, hge])
