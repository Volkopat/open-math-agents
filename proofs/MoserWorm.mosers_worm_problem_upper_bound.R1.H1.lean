  have hmod : (a.1 + d) % (m + 1) = a.1 + d - (m + 1) := by
   have hsp : a.1 + d = (a.1 + d - (m + 1)) + (m + 1) := by omega
   conv_lhs => rw [hsp]; rw [Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
  rw [hmod]
  have : a.1 + d - (m + 1) + (m + 1) - a.1 = d := by omega
  rw [this, Nat.mod_eq_of_lt hd]
lemma zr {m : ℕ} (a : Fin (m + 1)) (d : ℕ) (hd : d < m + 1) :
  zc a (z6 a d) = (m + 1 - d) % (m + 1) := by
