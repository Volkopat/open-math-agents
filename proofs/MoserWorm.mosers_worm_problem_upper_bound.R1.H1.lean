abbrev ZRad := ℤ × ℤ
abbrev zf6 := ZRad × ZRad
def zgn (x y : ZRad) : ZRad := (x.1 + y.1, x.2 + y.2)
def zf9 (u v : zf6) : zf6 := (zgn u.1 v.1, zgn u.2 v.2)
def zdq (x y : ZRad) : ZRad := (x.1 * y.1 + S0Z * x.2 * y.2, x.1 * y.2 + x.2 * y.1)
def zc2 (u : zf6) : ZRad := zgn (zdq u.1 u.1) (zdq u.2 u.2)
def zc4 (x : ZRad) : ℤ :=
 1000 * x.1 + (if 0 ≤ x.2 then 790927 * x.2 else 790926 * x.2)
def zag : Fin 12 → zf6
 | 0  => ((0, 0), (-D12, 0))
 | 1  => ((0, MuN * S0Z * 197), (0, -MuN * S0Z * 766))
 | 2  => ((MuD * S0Z * 301804, 0), (MuD * S0Z * 77618, 0))
 | 3  => ((0, 2 * MuN * 197 * 547947), (0, 2 * MuN * 197 * 301804))
 | 4  => ((0, MuN * (3 * 197 * S0Z - 4 * 197 ^ 3)), (0, MuN * (4 * 766 ^ 3 - 3 * 766 * S0Z)))
 | 5  => ((MuD * S0Z * 301804, 0), (MuD * S0Z * 547947, 0))
 | 6  => ((-MuD * S0Z * 301804, 0), (MuD * S0Z * 547947, 0))
 | 7  => ((0, -MuN * (3 * 197 * S0Z - 4 * 197 ^ 3)), (0, MuN * (4 * 766 ^ 3 - 3 * 766 * S0Z)))
 | 8  => ((0, -2 * MuN * 197 * 547947), (0, 2 * MuN * 197 * 301804))
 | 9  => ((-MuD * S0Z * 301804, 0), (MuD * S0Z * 77618, 0))
 | 10 => ((0, -MuN * S0Z * 197), (0, -MuN * S0Z * 766))
 | 11 => ((0, 0), (-D12, 0))
def zcn (L : List (Fin 12)) : zf6 :=
 L.foldl (fun acc j => zf9 acc (zag j)) ((0, 0), (0, 0))
def zhz : Bool :=
 zcn (List.finRange 12) == ((0, 0), (0, 0))
lemma zhf : zhz = true := by decide
def zdo (l r : ℕ) : Bool :=
 let L := (List.finRange 12).filter (fun k => l ≤ k.1 && k.1 ≤ r)
 zc4 (zc2 (zcn L)) * (25000 * 25000) < 1000 * 27131 * 27131 * D12 * D12
def zh0 : Bool :=
 ((List.range 4).all fun i => (List.range (4 - i)).all fun d => zdo (1 + i) (1 + i + d)) &&
 ((List.range 4).all fun i => (List.range (4 - i)).all fun d => zdo (7 + i) (7 + i + d)) &&
 ((List.range 11).all fun r => zdo 0 r)
lemma zg9 : zh0 = true := by decide
def P0Z : ℤ := 766
def C0Z : ℤ := 197
def zbp : ℤ := 301804
def zdy : ℤ := 547947
def zci : ℤ := 77618
def DW : ℤ := 125000 * 301804
def zdj : ℤ := 120819 * 625565
def STEP : ℤ := 754510
def QT : ℤ := 1024 * 778463
def TMAX : ℤ := 98500 * 1024
def zby : ℤ := 100000000
def zbk : ℤ := 10000000
def zfy : ℤ := zbk * zbk
def zgb : ℤ := 100000000000
def zin : ℤ := 126433971
def zio : ℤ := 126433972
def zff : ℤ := DW * zby * zgb
def zfg : ℤ := DW * S0Z
abbrev Iv := ℤ × ℤ
abbrev Box := Iv × Iv
def zcy (a b : ℤ) : ℤ := a / b
def zdr (a b : ℤ) : ℤ := -((-a) / b)
def zh8 (a b : Iv) : Iv := (a.1 + b.1, a.2 + b.2)
def zeo (a b : Box) : Box := (zh8 a.1 b.1, zh8 a.2 b.2)
def zfe (c : ℤ) (a : Iv) : Iv := if 0 ≤ c then (c * a.1, c * a.2) else (c * a.2, c * a.1)
def ivMul (a b : Iv) : Iv :=
 let p1 := a.1 * b.1; let p2 := a.1 * b.2; let p3 := a.2 * b.1; let p4 := a.2 * b.2
 (min (min p1 p2) (min p3 p4), max (max p1 p2) (max p3 p4))
def zim (a : Iv) : ℤ := max (a.1 * a.1) (a.2 * a.2)
def zb1 (b : Box) : ℤ := zim b.1 + zim b.2
def zhb (A B : ℤ) : Iv × Iv :=
 let qt2 := QT * QT
 let da := qt2 + A * A
 let db := qt2 + B * B
 let caLo := zcy ((qt2 - A * A) * zby) da
 let caHi := zdr ((qt2 - A * A) * zby) da
 let cbLo := zcy ((qt2 - B * B) * zby) db
 let cbHi := zdr ((qt2 - B * B) * zby) db
 let cLo := min caLo cbLo
 let cHi := if A ≤ 0 && 0 ≤ B then zby else max caHi cbHi
 let sLo := zcy (2 * A * QT * zby) da
 let sHi := zdr (2 * B * QT * zby) db
 ((cLo, cHi), (sLo, sHi))
def zdl (w cc sc : ℤ) (cIv sIv : Iv) : Iv :=
 let lin := zh8 (zfe cc cIv) (zfe sc sIv)
 let num := ivMul (zfe w lin) (zin, zio)
 (zcy (num.1 * zbk) zff, zdr (num.2 * zbk) zff)
def zcp (w fn : ℤ) : Iv :=
 let val := w * fn * zbk
 (zcy val zfg, zdr val zfg)
def upIv (w : ℤ) : Iv :=
 let val := w * zbk
 (zcy val DW, zdr val DW)
def zhs (w : ℤ) : Iv :=
 let val := -w * zbk
 (zcy val DW, zdr val DW)
