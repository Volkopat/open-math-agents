theorem zhq {m : ℕ} (P : Fin (m + 1) → V2)
  (e : Fin (m + 1) ≃ Fin (m + 1))
  (hC : zae (m + 1) (P ∘ e))
  (hDetCyc : ∀ {a b c : Fin (m + 1)},
   0 < zc a b → zc a b < zc a c →
   0 < det3 (P (e a)) (P (e b)) (P (e c)))
  (hDeq : ∀ k (hk : k ≤ m),
   ∃ L : Fin (m + 1),
    (∀ j : Fin (m + 1), j.1 ≤ k ↔ zc L (e.symm j) ≤ k) ∧
    (e.symm ⟨k, by omega⟩ = L ∨ zc L (e.symm ⟨k, by omega⟩) = k))
  (hdM_lo : 2 ≤ zc (e.symm 0) (e.symm (Fin.last m)))
  (hdM_hi : zc (e.symm 0) (e.symm (Fin.last m)) ≤ m - 1) :
  let v0 := e.symm 0
  let vm := e.symm (Fin.last m)
  let dM := zc v0 vm
  (∃ iF : ℕ, iF < dM ∧ ∃ vM : Fin (m + 1),
   let F := z0 v0 iF; let T := zg F
   e F < e vM ∧ e vM < e T ∧ (0 < (e F).1 ∨ (e T).1 < m) ∧
   0 < det3 (P (e F)) (P (e T)) (P (e vM)) ∧
   ∀ s : Fin (m + 1), det3 (P (e F)) (P (e T)) (P (e s)) ≤ det3 (P (e F)) (P (e T)) (P (e vM))) ∨
