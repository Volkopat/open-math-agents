   have : b.1 + m - a.1 = (b.1 - a.1) + m := by omega
   rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)] at h
   omega
  ·
   rw [Nat.mod_eq_of_lt (by omega)] at h
   omega
 · rintro rfl; exact za3 a
lemma zam {m : ℕ} {a b : Fin m} (h : a.1 ≤ b.1) : zc a b = b.1 - a.1 := by
 unfold zc
