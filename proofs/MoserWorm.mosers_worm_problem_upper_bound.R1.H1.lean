   have hExt' : ∀ i : Fin m', ∃ u : V2, ∀ j : Fin m', j ≠ i → dot2 (V' j) u < dot2 (V' i) u := by
    intro i
    obtain ⟨u, hu⟩ := hExt (d.succAbove i)
    exact ⟨u, fun j hji => hu (d.succAbove j) (fun h => hji (Fin.succAbove_right_injective h))⟩
