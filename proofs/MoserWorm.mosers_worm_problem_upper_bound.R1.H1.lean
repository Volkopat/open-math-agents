    ext k; simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.ext_iff]
    dsimp [kc]; omega
   have hnot : kc ∉ Finset.univ.filter (fun k : Fin m => cur + 1 ≤ k.1 ∧ k.1 ≤ last) := by
    simp [kc]
   have hacc' : zek
     (∑ k ∈ Finset.univ.filter (fun k : Fin m => cur ≤ k.1 ∧ k.1 ≤ last), (v k).1,
      ∑ k ∈ Finset.univ.filter (fun k : Fin m => cur ≤ k.1 ∧ k.1 ≤ last), (v k).2)
