       s ^ 2 * (dx ^ 2 + dy ^ 2) := by dsimp [dx, dy]; ring
  have e2 : (((1 - s) * (P i.castSucc).1 + s * (P i.succ).1) - (P i.succ).1) ^ 2 +
       (((1 - s) * (P i.castSucc).2 + s * (P i.succ).2) - (P i.succ).2) ^ 2 =
       (1 - s) ^ 2 * (dx ^ 2 + dy ^ 2) := by dsimp [dx, dy]; ring
