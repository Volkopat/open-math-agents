lemma zdc {m : ℕ} (v : Fin m → V2) (at_ : List Box)
  (lo hi last : ℕ) (skip : Nat → Bool)
  (hv : ∀ k : Fin m, zek (v k) (at_.getD k.1 ((0, 0), (0, 0))) (zbk : ℝ))
  (hlo : lo ≤ hi) (hlast : hi < last) (hlastm : last < m)
  (hok : zcb at_ lo hi last skip = true) :
  ∀ l : ℕ, lo ≤ l → l ≤ hi → skip l = false →
   ze (∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ last), (v k).1,
        ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ last), (v k).2) ≤ 1 := by
 have hbase : zek
   (∑ k ∈ Finset.univ.filter (fun k : Fin m => hi + 1 ≤ k.1 ∧ k.1 ≤ last), (v k).1,
    ∑ k ∈ Finset.univ.filter (fun k : Fin m => hi + 1 ≤ k.1 ∧ k.1 ≤ last), (v k).2)
   (zfr at_ (hi + 1) last) (zbk : ℝ) := by
