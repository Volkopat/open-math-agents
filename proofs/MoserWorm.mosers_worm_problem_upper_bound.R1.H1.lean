        ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ r), (v k).2) ≤ 1 := by
 have hL : ∀ (fuelL start : ℕ), start + fuelL = hi + 1 →
   zav.loopL at_ hi skip start fuelL = true →
   ∀ l r : ℕ, start ≤ l → l ≤ r → r ≤ hi → skip l r = false →
    ze (∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ r), (v k).1,
         ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ r), (v k).2) ≤ 1 := by
  intro fuelL
  induction fuelL with
  | zero => intro start hst _ l r h1 h2 h3; omega
  | succ fuelL' ih =>
