  0 < z7 (eL (p - 1)) ∧ z7 (eU (q - 1)) < 0 ∧
  (∀ i j : ℕ, i < p → j < q → z7 (eL i) ≤ z7 (eU j) → 0 ≤ zh (eL i) (eU j)) ∧
