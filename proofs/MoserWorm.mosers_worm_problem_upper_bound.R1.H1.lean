   simpa [V', ha', hb', hc'] using hres
lemma zbb {m : ℕ} (V : Fin m → V2) (hC : zae m V)
  (hExt : ∀ i : Fin m, ∃ u : V2, ∀ j : Fin m, j ≠ i → dot2 (V j) u < dot2 (V i) u)
  {a b c : Fin m} (h1 : 0 < zc a b) (h2 : zc a b < zc a c) :
  0 < det3 (V a) (V b) (V c) := by
 have hab : a ≠ b := fun h => by subst h; simp [za3] at h1
 have hac : a ≠ c := fun h => by subst h; simp [za3] at h2
 have hbc : b ≠ c := fun h => by subst h; omega
 have hord : (a < b ∧ b < c) ∨ (b < c ∧ c < a) ∨ (c < a ∧ a < b) := by
  by_cases h1' : a.1 ≤ b.1 <;> by_cases h2' : a.1 ≤ c.1
  ·
   rw [zam h1'] at h1 h2; rw [zam h2'] at h2
   left; exact ⟨by show a.1 < b.1; omega, by show b.1 < c.1; omega⟩
  ·
   rw [zam h1'] at h1 h2; rw [zal (by omega)] at h2
   right; right; exact ⟨by show c.1 < a.1; omega, by show a.1 < b.1; omega⟩
  ·
   rw [zal (by omega)] at h1 h2; rw [zam h2'] at h2
   omega
  ·
   rw [zal (by omega)] at h1 h2; rw [zal (by omega)] at h2
   right; left; exact ⟨by show b.1 < c.1; omega, by show c.1 < a.1; omega⟩
 rcases hord with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
 · exact zd5 m V hC hExt a b c h1 h2
 · rw [zh1]; exact zd5 m V hC hExt b c a h1 h2
 · rw [zh1, zh1]; exact zd5 m V hC hExt c a b h1 h2
lemma zfb {m : ℕ} (V : Fin m → V2) (hC : zae m V)
  (hExt : ∀ i : Fin m, ∃ u : V2, ∀ j : Fin m, j ≠ i → dot2 (V j) u < dot2 (V i) u)
  {a b c d : Fin m}
  (h1 : 0 < zc a b) (h2 : zc a b < zc a c) (h3 : zc a c < zc a d) :
  za1 (V a) (V c) (V b) (V d) := by
 have habc : 0 < det3 (V a) (V b) (V c) := zbb V hC hExt h1 h2
 have hacd : 0 < det3 (V a) (V c) (V d) := zbb V hC hExt (lt_trans h1 h2) h3
 have habd : 0 < det3 (V a) (V b) (V d) := zbb V hC hExt h1 (lt_trans h2 h3)
 have hbcd : 0 < det3 (V b) (V c) (V d) := by
  have hbc_d : zc b c = zc a c - zc a b := by
   have h := za0 a b c
   rcases lt_or_ge (zc a b + zc b c) m with hl | hg
   · rw [Nat.mod_eq_of_lt hl] at h; omega
   ·
    rw [zba (zab a b) (zab b c) hg] at h
    have := zab b c; omega
  have hbd_d : zc b d = zc a d - zc a b := by
   have h := za0 a b d
   rcases lt_or_ge (zc a b + zc b d) m with hl | hg
   · rw [Nat.mod_eq_of_lt hl] at h; omega
   ·
    rw [zba (zab a b) (zab b d) hg] at h
    have := zab b d; omega
  exact zbb V hC hExt (by omega) (by omega)
 set D := det3 (V a) (V b) (V c) + det3 (V a) (V c) (V d)
 have hD : 0 < D := by linarith
 have hq := zib (V a) (V b) (V c) (V d)
 let t : ℝ := det3 (V a) (V b) (V d) / D
 let s : ℝ := det3 (V a) (V b) (V c) / D
 refine ⟨t, s, div_pos habd hD, (div_lt_one hD).mpr (by linarith),
  div_pos habc hD, (div_lt_one hD).mpr (by linarith), ?_⟩
 have hDne : D ≠ 0 := ne_of_gt hD
 apply Prod.ext <;>
 (dsimp [t, s, add2, zas]; field_simp [hDne]; dsimp [D, det3, zh, sub2]; ring)
lemma zeh {a b c d : V2} (h : za1 a b c d) :
  za1 c d a b := by
 obtain ⟨t, s, ht0, ht1, hs0, hs1, heq⟩ := h
 exact ⟨s, t, hs0, hs1, ht0, ht1, heq.symm⟩
lemma zda {a b c d : V2} (h : za1 a b c d) :
  za1 a b d c := by
 obtain ⟨t, s, ht0, ht1, hs0, hs1, heq⟩ := h
 refine ⟨t, 1 - s, ht0, ht1, by linarith, by linarith, ?_⟩
 rw [heq]; apply Prod.ext <;> dsimp [add2, zas] <;> ring
lemma zh7 {a b c d : V2} (h : za1 a b c d) :
  za1 b a c d :=
 zeh (zda (zeh h))
theorem zdf {m : ℕ} (P : Fin (m + 1) → V2)
  (e : Fin (m + 1) ≃ Fin (m + 1))
  (hC : zae (m + 1) (P ∘ e))
  (hExt : ∀ i : Fin (m + 1), ∃ u : V2, ∀ j : Fin (m + 1), j ≠ i → dot2 (P (e j)) u < dot2 (P (e i)) u)
  (hNoCross : ∀ i j : Fin m, i.1 + 1 < j.1 →
   ¬ za1 (P i.castSucc) (P i.succ) (P j.castSucc) (P j.succ)) :
  ∀ k (hk : k ≤ m),
   ∃ L : Fin (m + 1),
    (∀ j : Fin (m + 1), j.1 ≤ k ↔ zc L (e.symm j) ≤ k) ∧
    (e.symm ⟨k, by omega⟩ = L ∨ zc L (e.symm ⟨k, by omega⟩) = k) := by
 let V : Fin (m + 1) → V2 := P ∘ e
 let p := e.symm
 have hVp : ∀ j : Fin (m + 1), V (p j) = P j := fun j => by simp [V, p]
 intro k
 induction k with
 | zero =>
  intro _
  refine ⟨e.symm 0, ?_, Or.inl rfl⟩
  intro j
  constructor
  · intro hj; have h0 : j = 0 := Fin.ext (by change j.1 = 0; omega); rw [h0, za3]
  ·
   intro hj
   have h0 : e.symm j = e.symm 0 := ((zbs (e.symm 0) (e.symm j)).mp (Nat.eq_zero_of_le_zero hj)).symm
   have hj0 : j = 0 := e.symm.injective h0; rw [hj0]; simp
 | succ k ih =>
  intro hk
  obtain ⟨L, hInt, hEnd⟩ := ih (by omega)
  set u := e.symm ⟨k + 1, by omega⟩
  set cur := e.symm ⟨k, by omega⟩
  have hu_out : k < zc L u := by
   by_contra hle; push Not at hle
   have h := (hInt ⟨k + 1, by omega⟩).mpr hle
   simp at h
  have hu_lt : zc L u < m + 1 := zab L u
  by_cases hR : zc L u = k + 1
  ·
   refine ⟨L, ?_, Or.inr hR⟩
   intro j
   constructor
   ·
    intro hj
    by_cases hjk : j.1 ≤ k
    · exact ((hInt j).mp hjk).trans (by omega)
    ·
     have heq : j = ⟨k + 1, by omega⟩ := Fin.ext (by dsimp; omega)
     rw [heq]; exact le_of_eq hR
   ·
    intro hj
    by_cases hjk : zc L (e.symm j) ≤ k
    · exact ((hInt j).mpr hjk).trans (by omega)
    ·
     have heq : zc L (e.symm j) = zc L u := by omega
     have hpj : e.symm j = u := zcr L (e.symm j) u heq
     have hj_eq : j = ⟨k + 1, by omega⟩ := e.symm.injective hpj
     rw [hj_eq]
  ·
   by_cases hL : zc L u = m
   ·
    refine ⟨u, ?_, Or.inl rfl⟩
    have hu_pred : u = zaf L := by
     apply zcr L
     have h1 : zc L (zaf L) = m := by
      have h3 := zbi L (zaf L)
      rw [zc8, za3] at h3
      have hlt := zab L (zaf L)
      by_cases h0 : zc L (zaf L) + 1 < m + 1
      · rw [Nat.mod_eq_of_lt h0] at h3; omega
      · omega
     omega
    intro j
    have hstep : zc u (e.symm j) = (zc L (e.symm j) + 1) % (m + 1) := by
     rw [hu_pred]; exact zfw L (e.symm j)
    constructor
    ·
     intro hj
     by_cases hjk : j.1 ≤ k
     ·
      have hle := (hInt j).mp hjk
      have hlt : zc L (e.symm j) + 1 < m + 1 := by omega
      rw [hstep, Nat.mod_eq_of_lt hlt]; omega
     ·
      have heq : j = ⟨k + 1, by omega⟩ := Fin.ext (by dsimp; omega)
      rw [heq, za3]; exact Nat.zero_le _
    ·
     intro hj
     by_cases hj0 : zc u (e.symm j) = 0
     ·
      have hpj : e.symm j = u := ((zbs u (e.symm j)).mp hj0).symm
      have hjeq : j = ⟨k + 1, by omega⟩ := e.symm.injective hpj
      rw [hjeq]
     ·
      have hlt := zab L (e.symm j)
      by_cases hLm : zc L (e.symm j) = m
      · rw [hLm, Nat.mod_self] at hstep; omega
      ·
       have hlt1 : zc L (e.symm j) + 1 < m + 1 := by omega
       rw [Nat.mod_eq_of_lt hlt1] at hstep
       have hle : zc L (e.symm j) ≤ k := by omega
       exact ((hInt j).mpr hle).trans (by omega)
   ·
    exfalso
    have hu_mid1 : k + 1 < zc L u := by omega
    have hu_mid2 : zc L u < m := by omega
    let w1 : Fin (m + 1) := ⟨(L.1 + k + 1) % (m + 1), Nat.mod_lt _ (by omega)⟩
    let w2 : Fin (m + 1) := zaf L
    have hw1_d : zc L w1 = k + 1 := by
     dsimp only [zc, w1]
     have hLlt : L.1 < m + 1 := L.2
     by_cases h1 : L.1 + k + 1 < m + 1
     ·
      rw [Nat.mod_eq_of_lt h1]
      have : L.1 + k + 1 + (m + 1) - L.1 = (k + 1) + (m + 1) := by omega
      rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
     ·
      have hmod : (L.1 + k + 1) % (m + 1) = L.1 + k + 1 - (m + 1) := by
       have hsplit : L.1 + k + 1 = (L.1 + k + 1 - (m + 1)) + (m + 1) := by omega
       conv_lhs => rw [hsplit]
       rw [Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
      rw [hmod]
      have : L.1 + k + 1 - (m + 1) + (m + 1) - L.1 = k + 1 := by omega
      rw [this, Nat.mod_eq_of_lt (by omega)]
    have hw2_d : zc L w2 = m := by
     have h3 := zbi L (zaf L)
     rw [zc8, za3] at h3
     have hlt := zab L (zaf L)
     by_cases h0 : zc L (zaf L) + 1 < m + 1
     · rw [Nat.mod_eq_of_lt h0] at h3; omega
     · show zc L (zaf L) = m; omega
    let t1 := e w1
    let t2 := e w2
    have ht1_ge : k + 2 ≤ t1.1 := by
     have hnotk : ¬ t1.1 ≤ k := by
      intro hle
      have := (hInt t1).mp hle
      simp [t1, p, hw1_d] at this
     have hne : t1.1 ≠ k + 1 := by
      intro heq
      have : w1 = u := by
       have h1 : p t1 = w1 := by simp [t1, p]
       rw [← h1]; congr 1; exact Fin.ext heq
      rw [this] at hw1_d; omega
     omega
    have ht2_ge : k + 2 ≤ t2.1 := by
     have hnotk : ¬ t2.1 ≤ k := by
      intro hle
      have := (hInt t2).mp hle
      have hm_le : m ≤ k := by simpa [t2, p, hw2_d] using this
      omega
     have hne : t2.1 ≠ k + 1 := by
      intro heq
      have : w2 = u := by
       have h1 : p t2 = w2 := by simp [t2, p]
       rw [← h1]; congr 1; exact Fin.ext heq
      rw [this] at hw2_d; omega
     omega
    let side (j : Fin (m + 1)) : Bool := decide (zc L (p j) < zc L u)
    have hs1 : side t1 = true := by simp [side, t1, p, hw1_d, hu_mid1]
    have hs2 : side t2 = false := by simp [side, t2, p, hw2_d]; omega
    have hex_step : ∃ r : Fin m, k + 2 ≤ r.1 ∧ side r.castSucc ≠ side r.succ := by
     have hchange : ∀ (a b : Fin (m + 1)), a.1 ≤ b.1 → k + 2 ≤ a.1 → side a ≠ side b →
       ∃ r : Fin m, a.1 ≤ r.1 ∧ r.1 < b.1 ∧ side r.castSucc ≠ side r.succ := by
      intro a b hab ha hne
      obtain ⟨d, hd⟩ : ∃ d, b.1 = a.1 + d := ⟨b.1 - a.1, by omega⟩
      induction d generalizing b with
      | zero =>
       have : a = b := Fin.ext (by omega)
       exact absurd rfl (by rwa [this] at hne)
      | succ d ihd =>
       have hb_lt : b.1 < m + 1 := b.2
       let prev : Fin (m + 1) := ⟨a.1 + d, by omega⟩
       by_cases hsp : side prev = side b
       ·
        obtain ⟨r, hr1, hr2, hrs⟩ := ihd prev (by dsimp [prev]; omega) (by rw [hsp]; exact hne) (by rfl)
        exact ⟨r, hr1, by dsimp [prev] at hr2; omega, hrs⟩
       ·
        refine ⟨⟨a.1 + d, by omega⟩, by dsimp; omega, by dsimp; omega, ?_⟩
        have hc1 : (⟨a.1 + d, by omega⟩ : Fin m).castSucc = prev := Fin.ext rfl
        have hc2 : (⟨a.1 + d, by omega⟩ : Fin m).succ = b := Fin.ext (by simp; omega)
        rw [hc1, hc2]; exact hsp
     rcases le_or_gt t1.1 t2.1 with h12 | h21
     ·
      obtain ⟨r, hr1, _, hrs⟩ := hchange t1 t2 h12 ht1_ge (by rw [hs1, hs2]; decide)
      exact ⟨r, by omega, hrs⟩
     ·
      obtain ⟨r, hr1, _, hrs⟩ := hchange t2 t1 (by omega) ht2_ge (by rw [hs1, hs2]; decide)
      exact ⟨r, by omega, hrs⟩
    obtain ⟨r, hr_ge, hrs⟩ := hex_step
    have hr_c_gt : k < zc L (p r.castSucc) := by
     by_contra hle; push Not at hle
     have := (hInt r.castSucc).mpr hle; simp at this; omega
    have hr_s_gt : k < zc L (p r.succ) := by
     by_contra hle; push Not at hle
     have := (hInt r.succ).mpr hle; simp at this; omega
    have hr_c_ne : zc L (p r.castSucc) ≠ zc L u := by
     intro heq
     have hp := zcr L _ _ heq
     have := congrArg Fin.val (p.injective hp); simp at this; omega
    have hr_s_ne : zc L (p r.succ) ≠ zc L u := by
     intro heq
     have hp := zcr L _ _ heq
     have := congrArg Fin.val (p.injective hp); simp at this; omega
    have hcur_le : zc L cur ≤ k := by
     rcases hEnd with h | h
     · change cur = L at h; rw [h, za3]; omega
     · exact le_of_eq h
    have hcross : za1 (V cur) (V u) (V (p r.castSucc)) (V (p r.succ)) := by
     have hord_cross : ∀ x y : Fin (m + 1),
       k < zc L x → zc L x < zc L u →
       zc L u < zc L y →
       za1 (V cur) (V u) (V x) (V y) := by
      intro x y hx1 hx2 hy1
      have hcur_d : ∀ z : Fin (m + 1), zc L cur ≤ zc L z →
        zc cur z = zc L z - zc L cur := by
       intro z hz
       have h := za0 L cur z
       rcases lt_or_ge (zc L cur + zc cur z) (m + 1) with hl | hg
       · rw [Nat.mod_eq_of_lt hl] at h; omega
       ·
        rw [zba (zab L cur) (zab cur z) hg] at h
        have := zab cur z; omega
      have dx := hcur_d x (by omega)
      have du := hcur_d u (by omega)
      have dy := hcur_d y (by omega)
      exact zfb V hC hExt (by omega) (by omega) (by omega)
     rcases hsc : side r.castSucc with _ | _
     ·
      have hss : side r.succ = true := by
       cases h : side r.succ <;> simp_all
      simp only [side, decide_eq_false_iff_not, not_lt] at hsc
      simp only [side, decide_eq_true_eq] at hss
      exact zda (hord_cross (p r.succ) (p r.castSucc) hr_s_gt hss (by omega))
     ·
      have hss : side r.succ = false := by
       cases h : side r.succ <;> simp_all
      simp only [side, decide_eq_true_eq] at hsc
      simp only [side, decide_eq_false_iff_not, not_lt] at hss
      exact hord_cross (p r.castSucc) (p r.succ) hr_c_gt hsc (by omega)
    have hk_fin : (⟨k, by omega⟩ : Fin m).castSucc = ⟨k, by omega⟩ := Fin.ext rfl
    have hk_succ : (⟨k, by omega⟩ : Fin m).succ = ⟨k + 1, by omega⟩ := Fin.ext rfl
    have hnc := hNoCross ⟨k, by omega⟩ r (by simp; omega)
    rw [hk_fin, hk_succ] at hnc
    rw [hVp, hVp, hVp, hVp] at hcross
    exact hnc hcross
theorem zh5 {m : ℕ} (P : Fin (m + 1) → V2)
  (e : Fin (m + 1) ≃ Fin (m + 1))
  (hC : zae (m + 1) (P ∘ e))
  (hExt : ∀ i : Fin (m + 1), ∃ u : V2, ∀ j : Fin (m + 1), j ≠ i → dot2 (P (e j)) u < dot2 (P (e i)) u)
  (hNoCross : ∀ i j : Fin m, i.1 + 1 < j.1 →
   ¬ za1 (P i.castSucc) (P i.succ) (P j.castSucc) (P j.succ)) :
  let v0 := e.symm 0
  let vm := e.symm (Fin.last m)
  let dM := zc v0 vm
  (∀ x y : Fin (m + 1), zc v0 x < zc v0 y → zc v0 y ≤ dM → e x < e y) ∧
  (∀ x y : Fin (m + 1), dM ≤ zc v0 x → zc v0 x < zc v0 y → e y < e x) := by
 intro v0 vm dM
 have hDeq := zdf P e hC hExt hNoCross
 have hstep : ∀ (x y : Fin (m + 1)), x ≠ y →
   ((zc v0 x < zc v0 y ∧ zc v0 y ≤ dM) → e x < e y) ∧
   ((dM ≤ zc v0 x ∧ zc v0 x < zc v0 y) → e y < e x) := by
  intro x y hxy
  constructor
  ·
   intro ⟨h1, h2⟩
   by_cases hym : y = vm
   ·
    subst hym
    have hlt : (e x).1 < m := by
     have hne : e x ≠ Fin.last m := fun h => hxy (e.injective (by simp [vm, h]))
     have hle := Nat.le_of_lt_succ (e x).2
     have : (e x).1 ≠ m := fun h => hne (Fin.ext h)
     omega
    show (e x).1 < (e vm).1; simp [vm]; exact hlt
   ·
    have hk : (e y).1 < m := by
     have hne : e y ≠ Fin.last m := fun h => hym (e.injective (by simp [vm, h]))
     have : (e y).1 ≠ m := fun h => hne (Fin.ext h)
     have := (e y).2; omega
    obtain ⟨L, hInt, hEnd⟩ := hDeq (e y).1 (by omega)
    have hy_eq : e.symm ⟨(e y).1, by omega⟩ = y := by
     have : (⟨(e y).1, by omega⟩ : Fin (m + 1)) = e y := Fin.ext rfl
     rw [this]; simp
    rw [hy_eq] at hEnd
    have hv0_in : zc L v0 ≤ (e y).1 := by
     have h0 := (hInt 0).mp (Nat.zero_le _)
     simpa [v0] using h0
    have hvm_out : (e y).1 < zc L vm := by
     by_contra hle; push Not at hle
     have h := (hInt (Fin.last m)).mpr hle
     simp [vm] at h; omega
    have hLvm_eq : zc L v0 + dM = zc L vm := by
     have h := za0 L v0 vm
     rcases lt_or_ge (zc L v0 + dM) (m + 1) with hl | hg
     · rw [Nat.mod_eq_of_lt hl] at h; exact h
     ·
      rw [zba (zab L v0) (zab v0 vm) hg] at h
      have hdM_lt : dM < m + 1 := zab v0 vm
      omega
    have hLx : zc L x = zc L v0 + zc v0 x := by
     have h := za0 L v0 x
     have hlt : zc L v0 + zc v0 x < m + 1 := by
      have := zab L vm; omega
     rw [Nat.mod_eq_of_lt hlt] at h; exact h.symm
    have hLy : zc L y = zc L v0 + zc v0 y := by
     have h := za0 L v0 y
     have hlt : zc L v0 + zc v0 y < m + 1 := by
      have := zab L vm; omega
     rw [Nat.mod_eq_of_lt hlt] at h; exact h.symm
    have hLy_le : zc L y ≤ (e y).1 := by
     rcases hEnd with h | h
     · rw [h, za3]; omega
     · omega
    have hLx_le : zc L x ≤ (e y).1 := by omega
    have hex_le : (e x).1 ≤ (e y).1 := by
     have := (hInt (e x)).mpr (by simpa using hLx_le)
     exact this
    have hne_val : (e x).1 ≠ (e y).1 := fun h => hxy (e.injective (Fin.ext h))
    show (e x).1 < (e y).1; omega
  ·
   intro ⟨h1, h2⟩
   by_cases hxm : x = vm
   ·
    subst hxm
    have hlt : (e y).1 < m := by
     have hne : e y ≠ Fin.last m := fun h => hxy (e.injective (by simp [vm, h])).symm
     have : (e y).1 ≠ m := fun h => hne (Fin.ext h)
     have := (e y).2; omega
    show (e y).1 < (e vm).1; simp [vm]; exact hlt
   ·
    have hk : (e x).1 < m := by
     have hne : e x ≠ Fin.last m := fun h => hxm (e.injective (by simp [vm, h]))
     have : (e x).1 ≠ m := fun h => hne (Fin.ext h)
     have := (e x).2; omega
    obtain ⟨L, hInt, hEnd⟩ := hDeq (e x).1 (by omega)
    have hx_eq : e.symm ⟨(e x).1, by omega⟩ = x := by
     have : (⟨(e x).1, by omega⟩ : Fin (m + 1)) = e x := Fin.ext rfl
     rw [this]; simp
    rw [hx_eq] at hEnd
    have hv0_in : zc L v0 ≤ (e x).1 := by
     simpa [v0] using (hInt 0).mp (Nat.zero_le _)
    have hvm_out : (e x).1 < zc L vm := by
     by_contra hle; push Not at hle
     have h := (hInt (Fin.last m)).mpr hle
     simp [vm] at h; omega
    have hLvm_eq : zc L v0 + dM = zc L vm := by
     have h := za0 L v0 vm
     rcases lt_or_ge (zc L v0 + dM) (m + 1) with hl | hg
     · rw [Nat.mod_eq_of_lt hl] at h; exact h
     ·
      rw [zba (zab L v0) (zab v0 vm) hg] at h
      have hdM_lt : dM < m + 1 := zab v0 vm
      omega
    have hLx_le : zc L x ≤ (e x).1 := by
     rcases hEnd with h | h
     · rw [h, za3]; omega
     · omega
    have hwrap_x : m + 1 ≤ zc L v0 + zc v0 x := by
     by_contra hlt; push Not at hlt
     have h := za0 L v0 x
     rw [Nat.mod_eq_of_lt hlt] at h; omega
    have hLx : zc L x = zc L v0 + zc v0 x - (m + 1) := by
     have h := za0 L v0 x
     rw [zba (zab L v0) (zab v0 x) hwrap_x] at h; exact h.symm
    have hLy : zc L y = zc L v0 + zc v0 y - (m + 1) := by
     have h := za0 L v0 y
     rw [zba (zab L v0) (zab v0 y) (by omega)] at h; exact h.symm
    have hLy_lt : zc L y < zc L v0 := by
     have := zab v0 y; omega
    have hey_le : (e y).1 ≤ (e x).1 := by
     exact (hInt (e y)).mpr (by simpa using (by omega : zc L y ≤ (e x).1))
    have hne_val : (e y).1 ≠ (e x).1 := fun h => hxy (e.injective (Fin.ext h)).symm
    show (e y).1 < (e x).1; omega
 exact ⟨fun x y h1 h2 => (hstep x y (fun h => by subst h; omega)).1 ⟨h1, h2⟩,
     fun x y h1 h2 => (hstep x y (fun h => by subst h; omega)).2 ⟨h1, h2⟩⟩
def zd (v : V2) : ℝ := v.1 / (zn v + v.2)
lemma zbz {r : ℝ} (hr : 0 < r) (v : V2) :
  zd (zas r v) = zd v := by
 unfold zd zas zn ze
 have hsq : (r * v.1) ^ 2 + (r * v.2) ^ 2 = r ^ 2 * (v.1 ^ 2 + v.2 ^ 2) := by ring
 rw [hsq, Real.sqrt_mul (sq_nonneg r), Real.sqrt_sq hr.le]
 have hmul : r * Real.sqrt (v.1 ^ 2 + v.2 ^ 2) + r * v.2 =
   r * (Real.sqrt (v.1 ^ 2 + v.2 ^ 2) + v.2) := by ring
 rw [hmul, mul_div_mul_left _ _ (ne_of_gt hr)]
lemma zc6 {u : V2} (hu : ze u = 1) (hpos : 0 < 1 + u.2) :
  u.1 = 2 * zd u / (1 + zd u ^ 2) ∧
  u.2 = (1 - zd u ^ 2) / (1 + zd u ^ 2) := by
 have hn : zn u = 1 := by unfold zn; rw [hu, Real.sqrt_one]
 have hcw : zd u = u.1 / (1 + u.2) := by unfold zd; rw [hn]
 have hne : 1 + u.2 ≠ 0 := ne_of_gt hpos
 have h1c : 1 + zd u ^ 2 = 2 / (1 + u.2) := by
  rw [hcw]; field_simp [hne]; unfold ze at hu; nlinarith
 have h1c_ne : 1 + zd u ^ 2 ≠ 0 := by positivity
 constructor
 · rw [h1c, hcw]; field_simp [hne]
 · rw [h1c, hcw]; field_simp [hne]; unfold ze at hu; nlinarith
lemma zdi {u v : V2} (hu : ze u = 1) (hv : ze v = 1)
  (hup : 0 < 1 + u.2) (hvp : 0 < 1 + v.2) :
  zh v u =
   2 * (zd v - zd u) * (1 + zd u * zd v) /
   ((1 + zd u ^ 2) * (1 + zd v ^ 2)) := by
 have ⟨hu1, hu2⟩ := zc6 hu hup
 have ⟨hv1, hv2⟩ := zc6 hv hvp
 have h1 : 1 + zd u ^ 2 ≠ 0 := by positivity
 have h2 : 1 + zd v ^ 2 ≠ 0 := by positivity
 unfold zh
 rw [hu1, hu2, hv1, hv2]
 field_simp [h1, h2]; ring
private lemma zan {u : V2} (hup : 0 < zn u + u.2) : 0 < zn u := by
 have h2 : |u.2| ≤ zn u := by
  unfold zn ze
  rw [← Real.sqrt_sq_eq_abs]; exact Real.sqrt_le_sqrt (by nlinarith [sq_nonneg u.1])
 linarith [le_abs_self u.2]
private lemma zbf {u : V2} (hup : 0 < zn u + u.2) :
  let u' := zas (1 / zn u) u
  ze u' = 1 ∧ 0 < 1 + u'.2 := by
 have hun : 0 < zn u := zan hup
 have hne : zn u ≠ 0 := ne_of_gt hun
 constructor
 ·
  unfold ze zas
  have hsq : zn u ^ 2 = ze u := Real.sq_sqrt (by unfold ze; positivity)
  unfold ze at hsq; field_simp [hne]; linarith
 ·
  dsimp [zas]
  have : 1 + 1 / zn u * u.2 = (zn u + u.2) / zn u := by field_simp [hne]
  rw [this]; exact div_pos hup hun
lemma zev {u v : V2}
  (hup : 0 < zn u + u.2) (hvp : 0 < zn v + v.2)
  (hcr : 0 < zh v u)
  (hno : ¬ (0 < u.1 ∧ v.1 < 0)) :
  zd u < zd v := by
 have hun : 0 < zn u := zan hup
 have hvn : 0 < zn v := zan hvp
 let u' := zas (1 / zn u) u
 let v' := zas (1 / zn v) v
 have ⟨hu'1, hu'p⟩ := zbf hup
 have ⟨hv'1, hv'p⟩ := zbf hvp
 have hcw_u : zd u' = zd u := zbz (div_pos one_pos hun) u
 have hcw_v : zd v' = zd v := zbz (div_pos one_pos hvn) v
 have hcr' : 0 < zh v' u' := by
  have heq : zh v' u' = zh v u / (zn v * zn u) := by
   unfold zh u' v' zas; field_simp [ne_of_gt hun, ne_of_gt hvn]
  rw [heq]; exact div_pos hcr (mul_pos hvn hun)
 rw [zdi hu'1 hv'1 hu'p hv'p, hcw_u, hcw_v] at hcr'
 have hden : 0 < (1 + zd u ^ 2) * (1 + zd v ^ 2) := by positivity
 have hnum : 0 < 2 * (zd v - zd u) * (1 + zd u * zd v) := by
  rwa [div_pos_iff_of_pos_right hden] at hcr'
 by_contra hge; push Not at hge
 have hneg : 1 + zd u * zd v < 0 := by nlinarith
 have hmul : zd u * zd v < 0 := by linarith
 have hupos : 0 < zd u := by nlinarith
 have hvneg : zd v < 0 := by nlinarith
 have hu1 : 0 < u.1 := by
  unfold zd at hupos; exact (div_pos_iff_of_pos_right hup).mp hupos
 have hv1 : v.1 < 0 := by
  unfold zd at hvneg; exact (div_neg_iff.mp hvneg).elim (fun h => by linarith) (fun h => h.1)
 exact hno ⟨hu1, hv1⟩
lemma zbt {u v : V2}
  (hup : 0 < zn u + u.2) (hvp : 0 < zn v + v.2)
  (hlt : zd u < zd v)
  (hcr : zh v u ≤ 0) :
  u.1 < 0 ∧ 0 < v.1 := by
 have hun : 0 < zn u := zan hup
 have hvn : 0 < zn v := zan hvp
 let u' := zas (1 / zn u) u
 let v' := zas (1 / zn v) v
 have ⟨hu'1, hu'p⟩ := zbf hup
 have ⟨hv'1, hv'p⟩ := zbf hvp
 have hcw_u : zd u' = zd u := zbz (div_pos one_pos hun) u
 have hcw_v : zd v' = zd v := zbz (div_pos one_pos hvn) v
 have hcr' : zh v' u' ≤ 0 := by
  have heq : zh v' u' = zh v u / (zn v * zn u) := by
   unfold zh u' v' zas; field_simp [ne_of_gt hun, ne_of_gt hvn]
  rw [heq]; exact div_nonpos_of_nonpos_of_nonneg hcr (mul_pos hvn hun).le
 rw [zdi hu'1 hv'1 hu'p hv'p, hcw_u, hcw_v] at hcr'
 have hden : 0 < (1 + zd u ^ 2) * (1 + zd v ^ 2) := by positivity
 have hnum' : 2 * (zd v - zd u) * (1 + zd u * zd v) ≤ 0 := by
  have := (div_le_iff₀ hden).mp hcr'; linarith
 have hprod : 1 + zd u * zd v ≤ 0 := by nlinarith
 have hcu_neg : zd u < 0 := by nlinarith
 have hcv_pos : 0 < zd v := by nlinarith
 constructor
 · unfold zd at hcu_neg; exact (div_neg_iff.mp hcu_neg).elim (fun h => by linarith) (fun h => h.1)
 · unfold zd at hcv_pos; exact (div_pos_iff_of_pos_right hvp).mp hcv_pos
structure zbe (m : ℕ) (W : Fin (m + 1) → V2) : Prop where
 hm : 2 ≤ m
 hy0 : (W 0).2 = 0
 hym : (W (Fin.last m)).2 = 0
 hx : (W 0).1 < (W (Fin.last m)).1
 hy_nn : ∀ k : Fin (m + 1), 0 ≤ (W k).2
 strict_right : ∀ j : Fin m, ∀ k : Fin (m + 1),
  k ≠ j.castSucc → k ≠ j.succ →
  zh (sub2 (W j.succ) (W j.castSucc)) (sub2 (W k) (W j.castSucc)) < 0
def outN {m : ℕ} (W : Fin (m + 1) → V2) (j : Fin m) : V2 :=
 (-(sub2 (W j.succ) (W j.castSucc)).2, (sub2 (W j.succ) (W j.castSucc)).1)
lemma zea {m : ℕ} (W : Fin (m + 1) → V2) (j : Fin m) (x : V2) :
  dot2 (sub2 x (W j.castSucc)) (outN W j) =
   zh (sub2 (W j.succ) (W j.castSucc)) (sub2 x (W j.castSucc)) := by
 unfold outN dot2 zh sub2; dsimp; ring
lemma zcv {m : ℕ} (W : Fin (m + 1) → V2) (j : Fin m) :
  dot2 (W j.succ) (outN W j) = dot2 (W j.castSucc) (outN W j) := by
 have h : dot2 (sub2 (W j.succ) (W j.castSucc)) (outN W j) = 0 := by
  rw [zea]; unfold zh sub2; ring
 unfold dot2 sub2 at h; unfold dot2; linarith
lemma zdm {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  (j : Fin m) (k : Fin (m + 1)) (hk1 : k ≠ j.castSucc) (hk2 : k ≠ j.succ) :
  dot2 (W k) (outN W j) < dot2 (W j.castSucc) (outN W j) := by
 have h := hW.strict_right j k hk1 hk2
 rw [← zea] at h
 unfold dot2 sub2 at h; unfold dot2; linarith
lemma zdn {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  (j : Fin m) (k : Fin (m + 1)) :
  dot2 (W k) (outN W j) ≤ dot2 (W j.castSucc) (outN W j) := by
 by_cases h1 : k = j.castSucc
 · subst h1; exact le_rfl
 ·
  by_cases h2 : k = j.succ
  · subst h2; exact le_of_eq (zcv W j)
  · exact le_of_lt (zdm hW j k h1 h2)
lemma za8 {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W) (j : Fin m) :
  0 < zn (outN W j) + (outN W j).2 := by
 have hex : ∃ r : Fin (m + 1), (W r).2 = 0 ∧ r ≠ j.castSucc ∧ r ≠ j.succ := by
  by_cases h0 : (0 : Fin (m + 1)) ≠ j.castSucc
  ·
   refine ⟨0, hW.hy0, h0, ?_⟩
   intro h; have := congrArg Fin.val h; simp at this
  ·
   push Not at h0
   have hj0 : j.1 = 0 := by have := congrArg Fin.val h0; simp at this; omega
   refine ⟨Fin.last m, hW.hym, ?_, ?_⟩
   · intro h; have := congrArg Fin.val h; simp at this; have := hW.hm; omega
   · intro h; have := congrArg Fin.val h; simp at this; have := hW.hm; omega
 obtain ⟨r, hry, hr1, hr2⟩ := hex
 have hlt := zdm hW j r hr1 hr2
 have hnz : outN W j ≠ (0, 0) := by
  intro h0; rw [h0] at hlt; simp [dot2] at hlt
 have hnp : 0 < zn (outN W j) := by
  unfold zn ze; apply Real.sqrt_pos.mpr
  by_contra hle; push Not at hle
  have h1 : (outN W j).1 = 0 := by nlinarith [sq_nonneg (outN W j).1, sq_nonneg (outN W j).2]
  have h2 : (outN W j).2 = 0 := by nlinarith [sq_nonneg (outN W j).1, sq_nonneg (outN W j).2]
  exact hnz (Prod.ext h1 h2)
 by_contra hle; push Not at hle
 have hsq : zn (outN W j) ^ 2 = (outN W j).1 ^ 2 + (outN W j).2 ^ 2 := by
  unfold zn ze; exact Real.sq_sqrt (by positivity)
 have hx0 : (outN W j).1 = 0 := by nlinarith [sq_nonneg (outN W j).1]
 have hyneg : (outN W j).2 < 0 := by linarith
 unfold dot2 at hlt
 rw [hx0, hry] at hlt
 nlinarith [hW.hy_nn j.castSucc]
lemma zcg {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {j1 j2 : Fin m} (h12 : j1 < j2) :
  zd (outN W j1) < zd (outN W j2) := by
 have hadj : ∀ j : Fin m, (hj : j.1 + 1 < m) →
   zd (outN W j) < zd (outN W ⟨j.1 + 1, hj⟩) := by
  intro j hj
  let j' : Fin m := ⟨j.1 + 1, hj⟩
  have hcr : 0 < zh (outN W j') (outN W j) := by
   have h1 : j'.succ ≠ j.castSucc := by intro h; have := congrArg Fin.val h; simp [j'] at this; omega
   have h2 : j'.succ ≠ j.succ := by intro h; have := congrArg Fin.val h; simp [j'] at this
   have hlt := hW.strict_right j j'.succ h1 h2
   have heq : zh (outN W j') (outN W j) =
     -zh (sub2 (W j.succ) (W j.castSucc)) (sub2 (W j'.succ) (W j.castSucc)) := by
    have hmid : j'.castSucc = j.succ := Fin.ext rfl
    unfold outN zh sub2; rw [hmid]; dsimp; ring
   linarith
  apply zev (za8 hW j) (za8 hW j') hcr
  rintro ⟨hu1, hv1⟩
  let D := zh (outN W j') (outN W j)
  let lam := -(outN W j').1 / D
  let mu := (outN W j).1 / D
  have hlam : 0 < lam := div_pos (by linarith) hcr
  have hmu : 0 < mu := div_pos hu1 hcr
  have hDne : (outN W j').1 * (outN W j).2 - (outN W j').2 * (outN W j).1 ≠ 0 := ne_of_gt hcr
  have hcomb1 : lam * (outN W j).1 + mu * (outN W j').1 = 0 := by
   dsimp [lam, mu, D, zh]; field_simp [hDne]; ring
  have hcomb2 : lam * (outN W j).2 + mu * (outN W j').2 = -1 := by
   dsimp [lam, mu, D, zh]; field_simp [hDne]; ring
  have hle1 : dot2 (W 0) (outN W j) ≤ dot2 (W j.succ) (outN W j) := by
   rw [zcv]; exact zdn hW j 0
  have hmid : j'.castSucc = j.succ := Fin.ext rfl
  have hlt2 : dot2 (W 0) (outN W j') < dot2 (W j.succ) (outN W j') := by
   rw [← hmid]
   exact zdm hW j' 0 (by intro h; have := congrArg Fin.val h; simp [j'] at this)
    (by intro h; have := congrArg Fin.val h; simp [j'] at this)
  have hdot : dot2 (sub2 (W 0) (W j.succ)) (0, -1) =
    lam * (dot2 (W 0) (outN W j) - dot2 (W j.succ) (outN W j)) +
    mu * (dot2 (W 0) (outN W j') - dot2 (W j.succ) (outN W j')) := by
   unfold dot2 sub2
   linear_combination ((W 0).1 - (W j.succ).1) * hcomb1.symm +
    ((W 0).2 - (W j.succ).2) * hcomb2.symm
  have hneg : dot2 (sub2 (W 0) (W j.succ)) (0, -1) < 0 := by nlinarith
  unfold dot2 sub2 at hneg; rw [hW.hy0] at hneg
  linarith [hW.hy_nn j.succ]
 obtain ⟨d, hd⟩ : ∃ d, j2.1 = j1.1 + d + 1 := ⟨j2.1 - j1.1 - 1, by show j2.1 = _; have : j1.1 < j2.1 := h12; omega⟩
 induction d generalizing j2 with
 | zero =>
  have h2eq : j2 = ⟨j1.1 + 1, by omega⟩ := Fin.ext (by omega)
  rw [h2eq]; exact hadj j1 (by omega)
 | succ d ihd =>
  have hj2_lt : j2.1 < m := j2.2
  let mid : Fin m := ⟨j1.1 + d + 1, by omega⟩
  have hmid_val : mid.1 = j1.1 + d + 1 := rfl
  have h1 := ihd (j2 := mid) (by show j1.1 < mid.1; omega) hmid_val
  have h2 : j2 = ⟨mid.1 + 1, by omega⟩ := Fin.ext (by dsimp; omega)
  rw [h2]
  exact lt_trans h1 (hadj mid (by omega))
lemma zhe {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u : V2} (hup : 0 < zn u + u.2)
  {k : Fin (m + 1)} (hk : k.1 < m)
  (hatt : dot2 (W k) u = supp W u) :
  zd u ≤ zd (outN W ⟨k.1, hk⟩) := by
 let j : Fin m := ⟨k.1, hk⟩
 have hjk : j.castSucc = k := Fin.ext rfl
 have hcr : zh u (outN W j) ≤ 0 := by
  have hle : dot2 (W j.succ) u ≤ dot2 (W j.castSucc) u := by
   rw [hjk, hatt]; exact zo W u j.succ
  have heq : zh u (outN W j) = dot2 (W j.succ) u - dot2 (W j.castSucc) u := by
   unfold zh outN dot2 sub2; dsimp; ring
  linarith
 by_contra hlt; push Not at hlt
 have ⟨ho1, hu1⟩ := zbt (za8 hW j) hup hlt hcr
 have hex : ∃ r : Fin (m + 1), (W r).2 = 0 ∧ r ≠ j.castSucc ∧ r ≠ j.succ := by
  by_cases h0 : (0 : Fin (m + 1)) ≠ j.castSucc
  · exact ⟨0, hW.hy0, h0, by intro h; have := congrArg Fin.val h; simp at this⟩
  ·
   push Not at h0
   have hj0 : j.1 = 0 := by have := congrArg Fin.val h0; simp at this; omega
   exact ⟨Fin.last m, hW.hym,
    by intro h; have := congrArg Fin.val h; simp at this; have := hW.hm; omega,
    by intro h; have := congrArg Fin.val h; simp at this; have := hW.hm; omega⟩
 obtain ⟨r, hry, hr1, hr2⟩ := hex
 have hlt_o : dot2 (W r) (outN W j) < dot2 (W k) (outN W j) := by
  rw [← hjk]; exact zdm hW j r hr1 hr2
 have hle_u : dot2 (W r) u ≤ dot2 (W k) u := by rw [hatt]; exact zo W u r
 by_cases hcr0 : zh u (outN W j) = 0
 ·
  have hlam : 0 < u.1 / (-(outN W j).1) := div_pos hu1 (by linarith)
  set lam := u.1 / (-(outN W j).1)
  have hu_eq1 : u.1 = -lam * (outN W j).1 := by
   dsimp [lam]; field_simp [ne_of_lt ho1]
  have hu_eq2 : u.2 = -lam * (outN W j).2 := by
   unfold zh at hcr0
   have hne : (outN W j).1 ≠ 0 := ne_of_lt ho1
   dsimp [lam]; field_simp [hne]; linarith
  have hdot_u : dot2 (W r) u - dot2 (W k) u =
    -lam * (dot2 (W r) (outN W j) - dot2 (W k) (outN W j)) := by
   unfold dot2; rw [hu_eq1, hu_eq2]; ring
  nlinarith
 ·
  have hcr_neg : zh u (outN W j) < 0 := lt_of_le_of_ne hcr hcr0
  set D := -zh u (outN W j)
  have hD : 0 < D := by linarith
  let lam := u.1 / D
  let mu := -(outN W j).1 / D
  have hlam : 0 < lam := div_pos hu1 hD
  have hmu : 0 < mu := div_pos (by linarith) hD
  have hDne : D ≠ 0 := ne_of_gt hD
  have hcomb1 : lam * (outN W j).1 + mu * u.1 = 0 := by
   dsimp [lam, mu]; field_simp [hDne]; dsimp [D, zh]; ring
  have hcomb2 : lam * (outN W j).2 + mu * u.2 = -1 := by
   dsimp [lam, mu]; field_simp [hDne]; dsimp [D, zh]; ring
  have hdot : dot2 (sub2 (W r) (W k)) (0, -1) =
    lam * (dot2 (W r) (outN W j) - dot2 (W k) (outN W j)) +
    mu * (dot2 (W r) u - dot2 (W k) u) := by
   unfold dot2 sub2
   linear_combination ((W r).1 - (W k).1) * hcomb1.symm + ((W r).2 - (W k).2) * hcomb2.symm
  have hneg : dot2 (sub2 (W r) (W k)) (0, -1) < 0 := by nlinarith
  unfold dot2 sub2 at hneg; rw [hry] at hneg
  linarith [hW.hy_nn k]
lemma zhd {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u : V2} (hup : 0 < zn u + u.2)
  {k : Fin (m + 1)} (hk : 0 < k.1)
  (hatt : dot2 (W k) u = supp W u) :
  zd (outN W ⟨k.1 - 1, by omega⟩) ≤ zd u := by
 let j : Fin m := ⟨k.1 - 1, by omega⟩
 have hjk : j.succ = k := Fin.ext (by dsimp [j]; omega)
 have hcr : zh (outN W j) u ≤ 0 := by
  have hle : dot2 (W j.castSucc) u ≤ dot2 (W j.succ) u := by
   rw [hjk, hatt]; exact zo W u j.castSucc
  have heq : zh (outN W j) u = dot2 (W j.castSucc) u - dot2 (W j.succ) u := by
   unfold zh outN dot2 sub2; dsimp; ring
  linarith
 by_contra hlt; push Not at hlt
 have ⟨hu1, ho1⟩ := zbt hup (za8 hW j) hlt hcr
 have hex : ∃ r : Fin (m + 1), (W r).2 = 0 ∧ r ≠ j.castSucc ∧ r ≠ j.succ := by
  by_cases h0 : (0 : Fin (m + 1)) ≠ j.castSucc
  · exact ⟨0, hW.hy0, h0, by intro h; have := congrArg Fin.val h; simp at this⟩
  ·
   push Not at h0
   have hj0 : j.1 = 0 := by have := congrArg Fin.val h0; simp at this; omega
   exact ⟨Fin.last m, hW.hym,
    by intro h; have := congrArg Fin.val h; simp at this; have := hW.hm; omega,
    by intro h; have := congrArg Fin.val h; simp at this; have := hW.hm; omega⟩
 obtain ⟨r, hry, hr1, hr2⟩ := hex
 have hlt_o : dot2 (W r) (outN W j) < dot2 (W k) (outN W j) := by
  rw [← hjk, zcv]; exact zdm hW j r hr1 hr2
 have hle_u : dot2 (W r) u ≤ dot2 (W k) u := by rw [hatt]; exact zo W u r
 by_cases hcr0 : zh (outN W j) u = 0
 ·
  set lam := (-u.1) / (outN W j).1
  have hlam : 0 < lam := div_pos (by linarith) ho1
  have hu_eq1 : u.1 = -lam * (outN W j).1 := by
   dsimp [lam]; field_simp [ne_of_gt ho1]
  have hu_eq2 : u.2 = -lam * (outN W j).2 := by
   unfold zh at hcr0
   dsimp [lam]; field_simp [ne_of_gt ho1]; linarith
  have hdot_u : dot2 (W r) u - dot2 (W k) u =
    -lam * (dot2 (W r) (outN W j) - dot2 (W k) (outN W j)) := by
   unfold dot2; rw [hu_eq1, hu_eq2]; ring
  nlinarith
 ·
  have hcr_neg : zh (outN W j) u < 0 := lt_of_le_of_ne hcr hcr0
  set D := -zh (outN W j) u
  have hD : 0 < D := by linarith
  let lam := (-u.1) / D
  let mu := (outN W j).1 / D
  have hlam : 0 < lam := div_pos (by linarith) hD
  have hmu : 0 < mu := div_pos ho1 hD
  have hDne : D ≠ 0 := ne_of_gt hD
  have hcomb1 : lam * (outN W j).1 + mu * u.1 = 0 := by
   dsimp [lam, mu]; field_simp [hDne]; dsimp [D, zh]; ring
  have hcomb2 : lam * (outN W j).2 + mu * u.2 = -1 := by
   dsimp [lam, mu]; field_simp [hDne]; dsimp [D, zh]; ring
  have hdot : dot2 (sub2 (W r) (W k)) (0, -1) =
    lam * (dot2 (W r) (outN W j) - dot2 (W k) (outN W j)) +
    mu * (dot2 (W r) u - dot2 (W k) u) := by
   unfold dot2 sub2
   linear_combination ((W r).1 - (W k).1) * hcomb1.symm + ((W r).2 - (W k).2) * hcomb2.symm
  have hneg : dot2 (sub2 (W r) (W k)) (0, -1) < 0 := by nlinarith
  unfold dot2 sub2 at hneg; rw [hry] at hneg
  linarith [hW.hy_nn k]
lemma zaw {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u v : V2} (hup : 0 < zn u + u.2) (hvp : 0 < zn v + v.2)
  (hlt : zd u < zd v)
  {a b : Fin (m + 1)} (ha : dot2 (W a) u = supp W u) (hb : dot2 (W b) v = supp W v) :
  a ≤ b := by
 by_contra hba; push Not at hba
 have hb_lt : b.1 < m := by have := a.2; have : b.1 < a.1 := hba; omega
 have ha_pos : 0 < a.1 := by have : b.1 < a.1 := hba; omega
 have h1 := zhe hW hvp hb_lt hb
 have h2 := zhd hW hup ha_pos ha
 have h3 : zd (outN W ⟨b.1, hb_lt⟩) ≤ zd (outN W ⟨a.1 - 1, by omega⟩) := by
  have : b.1 ≤ a.1 - 1 := by have : b.1 < a.1 := hba; omega
  rcases eq_or_lt_of_le this with heq | hlt'
  ·
   have : (⟨b.1, hb_lt⟩ : Fin m) = ⟨a.1 - 1, by omega⟩ := Fin.ext heq
   rw [this]
  · exact le_of_lt (zcg hW (by show b.1 < a.1 - 1; exact hlt'))
 linarith
def zap {m : ℕ} (W : Fin (m + 1) → V2) (u : V2) : Fin (m + 1) :=
 (Finset.univ.filter (fun k => dot2 (W k) u = supp W u)).min' (by
  obtain ⟨k, hk⟩ := zb4 W u
  exact ⟨k, by simp [hk]⟩)
def zaq {m : ℕ} (W : Fin (m + 1) → V2) (u : V2) : Fin (m + 1) :=
 (Finset.univ.filter (fun k => dot2 (W k) u = supp W u)).max' (by
  obtain ⟨k, hk⟩ := zb4 W u
  exact ⟨k, by simp [hk]⟩)
lemma zai {m : ℕ} (W : Fin (m + 1) → V2) (u : V2) :
  dot2 (W (zap W u)) u = supp W u := by
 unfold zap
 exact (Finset.mem_filter.mp
  (Finset.min'_mem (Finset.univ.filter (fun k => dot2 (W k) u = supp W u)) _)).2
lemma zak {m : ℕ} (W : Fin (m + 1) → V2) (u : V2) :
  dot2 (W (zaq W u)) u = supp W u := by
 unfold zaq
 exact (Finset.mem_filter.mp
  (Finset.max'_mem (Finset.univ.filter (fun k => dot2 (W k) u = supp W u)) _)).2
lemma zcz {m : ℕ} (W : Fin (m + 1) → V2) (u : V2) {k : Fin (m + 1)}
  (hk : dot2 (W k) u = supp W u) : zap W u ≤ k :=
 Finset.min'_le _ k (by simp [hk])
lemma zcj {m : ℕ} (W : Fin (m + 1) → V2) (u : V2) {k : Fin (m + 1)}
  (hk : dot2 (W k) u = supp W u) : k ≤ zaq W u :=
 Finset.le_max' _ k (by simp [hk])
private lemma zbu {u v : V2}
  (hup : 0 < zn u + u.2) (hvp : 0 < zn v + v.2)
  (heq : zd u = zd v) :
  ∃ r : ℝ, 0 < r ∧ v = zas r u := by
 have hun : 0 < zn u := zan hup
 have hvn : 0 < zn v := zan hvp
 let u' := zas (1 / zn u) u
 let v' := zas (1 / zn v) v
 have ⟨hu'1, hu'p⟩ := zbf hup
 have ⟨hv'1, hv'p⟩ := zbf hvp
 have ⟨hu1, hu2⟩ := zc6 hu'1 hu'p
 have ⟨hv1, hv2⟩ := zc6 hv'1 hv'p
 rw [zbz (div_pos one_pos hun)] at hu1 hu2
 rw [zbz (div_pos one_pos hvn)] at hv1 hv2
 rw [heq] at hu1 hu2
 refine ⟨zn v / zn u, div_pos hvn hun, ?_⟩
 apply Prod.ext
 ·
  have : v'.1 = u'.1 := by linarith
  dsimp [u', v', zas] at this ⊢; field_simp [ne_of_gt hun, ne_of_gt hvn] at this ⊢; linarith
 ·
  have : v'.2 = u'.2 := by linarith
  dsimp [u', v', zas] at this ⊢; field_simp [ne_of_gt hun, ne_of_gt hvn] at this ⊢; linarith
lemma zbg {m : ℕ} (W : Fin (m + 1) → V2) {u : V2} {r : ℝ} (hr : 0 < r)
  (k : Fin (m + 1)) :
  dot2 (W k) (zas r u) = supp W (zas r u) ↔ dot2 (W k) u = supp W u := by
 have hsupp : supp W (zas r u) = r * supp W u := by
  apply le_antisymm
  ·
   rw [supp, Finset.sup'_le_iff]; intro i _
   have := zo W u i; dsimp [dot2, zas] at *; nlinarith
  ·
   obtain ⟨i, hi⟩ := zb4 W u
   have := zo W (zas r u) i; dsimp [dot2, zas] at *; nlinarith
 have hdot : dot2 (W k) (zas r u) = r * dot2 (W k) u := by dsimp [dot2, zas]; ring
 rw [hdot, hsupp]
 constructor
 · intro h; exact mul_left_cancel₀ (ne_of_gt hr) h
 · intro h; rw [h]
lemma za6 {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u v : V2} (hup : 0 < zn u + u.2) (hvp : 0 < zn v + v.2)
  (hle : zd u ≤ zd v) :
  zap W u ≤ zap W v := by
 rcases eq_or_lt_of_le hle with heq | hlt
 ·
  obtain ⟨r, hr, rfl⟩ := zbu hup hvp heq
  apply zcz
  exact (zbg W hr (zap W (zas r u))).mp (zai W (zas r u))
 · exact zaw hW hup hvp hlt (zai W u) (zai W v)
lemma za9 {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u v : V2} (hup : 0 < zn u + u.2) (hvp : 0 < zn v + v.2)
  (hle : zd u ≤ zd v) :
  zaq W u ≤ zaq W v := by
 rcases eq_or_lt_of_le hle with heq | hlt
 ·
  obtain ⟨r, hr, rfl⟩ := zbu hup hvp heq
  apply zcj
  exact (zbg W hr (zaq W u)).mpr (zak W u)
 · exact zaw hW hup hvp hlt (zak W u) (zak W v)
lemma zha {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u : V2} (hup : 0 < zn u + u.2) (j : Fin m)
  (hle : zd u ≤ zd (outN W j)) :
  zap W u ≤ j.castSucc := by
 rcases eq_or_lt_of_le hle with heq | hlt
 ·
  obtain ⟨r, hr, hvu⟩ := zbu hup (za8 hW j) heq
  apply zcz
  have hatt_o : dot2 (W j.castSucc) (outN W j) = supp W (outN W j) := by
   apply le_antisymm (zo W (outN W j) j.castSucc)
   rw [supp, Finset.sup'_le_iff]; intro i _; exact zdn hW j i
  rw [hvu] at hatt_o
  exact (zbg W hr j.castSucc).mp hatt_o
 ·
  have hatt_o : dot2 (W j.castSucc) (outN W j) = supp W (outN W j) := by
   apply le_antisymm (zo W (outN W j) j.castSucc)
   rw [supp, Finset.sup'_le_iff]; intro i _; exact zdn hW j i
  exact zaw hW hup (za8 hW j) hlt (zai W u) hatt_o
lemma zgm {m : ℕ} {W : Fin (m + 1) → V2} (hW : zbe m W)
  {u : V2} (hup : 0 < zn u + u.2) (j : Fin m)
  (hle : zd (outN W j) ≤ zd u) :
  j.succ ≤ zaq W u := by
 have hatt_o : dot2 (W j.succ) (outN W j) = supp W (outN W j) := by
  rw [zcv]
  apply le_antisymm (zo W (outN W j) j.castSucc)
  rw [supp, Finset.sup'_le_iff]; intro i _; exact zdn hW j i
 rcases eq_or_lt_of_le hle with heq | hlt
 ·
  obtain ⟨r, hr, huv⟩ := zbu (za8 hW j) hup heq
  apply zcj
  rw [huv]
  exact (zbg W hr j.succ).mpr hatt_o
 · exact zaw hW (za8 hW j) hup hlt hatt_o (zak W u)
def zat (n : ℕ) (P : Fin (n + 1) → V2) : Prop :=
 z5 P ∧
 (∀ M ≤ n, ∀ Q : Fin (M + 1) → V2, z5 Q → zp P ≤ zp Q) ∧
 (∀ M < n, ∀ Q : Fin (M + 1) → V2, z5 Q → zp P < zp Q)
lemma zie {cr sr : ℝ} (hcs : cr ^ 2 + sr ^ 2 = 1) (fl : Bool) (sh u v : V2) :
  zt (zao cr sr fl sh u) (zao cr sr fl sh v) = zt u v := by
 unfold zt zn ze zao add2
 cases fl
 ·
  dsimp [zdp, rot2]; congr 1
  linear_combination ((u.1 - v.1) ^ 2 + (u.2 - v.2) ^ 2) * hcs
 ·
  dsimp [zdp, rot2]; congr 1
  linear_combination ((u.1 - v.1) ^ 2 + (u.2 - v.2) ^ 2) * hcs
lemma zck {n : ℕ} {cr sr : ℝ} (hcs : cr ^ 2 + sr ^ 2 = 1) (fl : Bool) (sh : V2)
  (P : Fin (n + 1) → V2) :
  zp (fun i => zao cr sr fl sh (P i)) = zp P := by
 unfold zp
 refine Finset.sum_congr rfl fun i _ => zie hcs fl sh _ _
lemma zd4 {n : ℕ} {cr sr : ℝ} (hcs : cr ^ 2 + sr ^ 2 = 1) (fl : Bool) (sh : V2)
  {P : Fin (n + 1) → V2} (hEsc : z5 P) :
  z5 (fun i => zao cr sr fl sh (P i)) := by
 intro u hu
 let w : V2 := rot2 cr (-sr) (if fl then zdp u else u)
 have hw : ze w = 1 := by
  cases fl <;> (dsimp [w, ze, rot2, zdp] at hu ⊢; linear_combination (u.1 ^ 2 + u.2 ^ 2) * hcs + hu)
 have hsupp : ∀ v : V2,
   supp (fun i => zao cr sr fl sh (P i)) v =
   supp P (rot2 cr (-sr) (if fl then zdp v else v)) + dot2 sh v := by
  intro v
  have hdot : ∀ x : V2, dot2 (zao cr sr fl sh x) v =
    dot2 x (rot2 cr (-sr) (if fl then zdp v else v)) + dot2 sh v := by
   intro x; cases fl <;> (dsimp [zao, add2, zdp, rot2, dot2]; ring)
  apply le_antisymm
  ·
   rw [supp, Finset.sup'_le_iff]; intro i _
   rw [hdot]; linarith [zo P (rot2 cr (-sr) (if fl then zdp v else v)) i]
  ·
   obtain ⟨i, hi⟩ := zb4 P (rot2 cr (-sr) (if fl then zdp v else v))
   have h2 := zo (fun j => zao cr sr fl sh (P j)) v i
   rw [hdot, hi] at h2; exact h2
 have hbal : 2 * c0 * dot2 sh u + dot2 sh (n1 u) + dot2 sh (n2 u) = 0 := by
  dsimp [dot2, n1, n2]; ring
 rw [hsupp u, hsupp (n1 u), hsupp (n2 u)]
 have h1 : rot2 cr (-sr) (if fl then zdp (n1 u) else n1 u) =
   if fl then n2 w else n1 w := by
  cases fl <;> (apply Prod.ext <;> dsimp [w, rot2, zdp, n1, n2] <;> ring)
 have h2 : rot2 cr (-sr) (if fl then zdp (n2 u) else n2 u) =
   if fl then n1 w else n2 w := by
  cases fl <;> (apply Prod.ext <;> dsimp [w, rot2, zdp, n1, n2] <;> ring)
 rw [h1, h2]
 have he := hEsc w hw
 cases fl <;> (dsimp [w] at he ⊢; linarith)
lemma zde {n : ℕ} {cr sr : ℝ} (hcs : cr ^ 2 + sr ^ 2 = 1) (fl : Bool) (sh : V2)
  {P : Fin (n + 1) → V2} (hMin : zat n P) :
  zat n (fun i => zao cr sr fl sh (P i)) := by
 refine ⟨zd4 hcs fl sh hMin.1, ?_, ?_⟩
 · intro M hM Q hQ; rw [zck hcs fl sh P]; exact hMin.2.1 M hM Q hQ
 · intro M hM Q hQ; rw [zck hcs fl sh P]; exact hMin.2.2 M hM Q hQ
lemma cross2_isoMap {cr sr : ℝ} (hcs : cr ^ 2 + sr ^ 2 = 1) (fl : Bool) (sh a b c : V2) :
  zh (sub2 (zao cr sr fl sh b) (zao cr sr fl sh a))
      (sub2 (zao cr sr fl sh c) (zao cr sr fl sh a)) =
  (if fl then -1 else 1) * zh (sub2 b a) (sub2 c a) := by
 cases fl
 ·
  dsimp [zao, add2, sub2, zdp, rot2, zh]
  linear_combination ((b.1 - a.1) * (c.2 - a.2) - (b.2 - a.2) * (c.1 - a.1)) * hcs
 ·
  dsimp [zao, add2, sub2, zdp, rot2, zh]
  linear_combination (-(b.1 - a.1) * (c.2 - a.2) + (b.2 - a.2) * (c.1 - a.1)) * hcs
lemma zd9 {m1 m2 : ℕ} {P : Fin (m1 + 1) → V2} {Q : Fin (m2 + 1) → V2}
  (hEsc : z5 P) (hsupp : ∀ u : V2, supp P u ≤ supp Q u) :
  z5 Q := by
 intro u hu
 have h1 := hEsc u hu
 have hc0 : 0 ≤ 2 * c0 := by
  have : 0 < sqS := Real.sqrt_pos.mpr (by norm_num [S0])
  unfold c0; positivity
 have hu1 := hsupp u
 have hu2 := hsupp (n1 u)
 have hu3 := hsupp (n2 u)
 nlinarith
private lemma zcq {u v : V2} : dot2 u v ≤ zn u * zn v := by
 unfold dot2 zn ze
 have h1 : 0 ≤ u.1 ^ 2 + u.2 ^ 2 := by positivity
 have h2 : 0 ≤ v.1 ^ 2 + v.2 ^ 2 := by positivity
 have hcs : (u.1 * v.1 + u.2 * v.2) ^ 2 ≤ (u.1 ^ 2 + u.2 ^ 2) * (v.1 ^ 2 + v.2 ^ 2) := by
  nlinarith [sq_nonneg (u.1 * v.2 - u.2 * v.1)]
 have hsq : (Real.sqrt (u.1 ^ 2 + u.2 ^ 2) * Real.sqrt (v.1 ^ 2 + v.2 ^ 2)) ^ 2 =
   (u.1 ^ 2 + u.2 ^ 2) * (v.1 ^ 2 + v.2 ^ 2) := by
  rw [mul_pow, Real.sq_sqrt h1, Real.sq_sqrt h2]
 have hnn : 0 ≤ Real.sqrt (u.1 ^ 2 + u.2 ^ 2) * Real.sqrt (v.1 ^ 2 + v.2 ^ 2) := by positivity
 nlinarith
private lemma zb0 {a b q : V2} (hq : ze q = 1) :
  dot2 (sub2 b a) q ≤ zt a b := by
 have h1 : dot2 (sub2 b a) q ≤ zn (sub2 b a) * zn q := zcq
 have hq1 : zn q = 1 := by unfold zn; rw [hq, Real.sqrt_one]
 have hn : zn (sub2 b a) = zt a b := by
  unfold zt zn ze sub2; congr 1; ring
 rw [hq1, hn, mul_one] at h1; exact h1
private lemma zes {m : ℕ} (P : Fin (m + 1) → V2) (k : Fin (m + 1)) (E : V2) :
  let Q : Fin (k.1 + 1 + 1) → V2 := fun j => if h : j.1 ≤ k.1 then P ⟨j.1, by omega⟩ else E
  zp Q = zac P 0 k + zt (P k) E := by
 intro Q
 unfold zp zac
 rw [Fin.sum_univ_castSucc]
 have hlast : zt (Q (Fin.last k.1).castSucc) (Q (Fin.last k.1).succ) = zt (P k) E := by
  have h1 : (Fin.last k.1).castSucc.1 ≤ k.1 := by simp [Fin.last]
  have h2 : ¬ (Fin.last k.1).succ.1 ≤ k.1 := by simp [Fin.last]
  have hq1 : Q (Fin.last k.1).castSucc = P k := by
   dsimp only [Q]; rw [dif_pos h1]; rfl
  have hq2 : Q (Fin.last k.1).succ = E := by
   dsimp only [Q]; rw [dif_neg h2]
  rw [hq1, hq2]
 rw [hlast]
 congr 1
 refine Finset.sum_bij (fun (i : Fin k.1) _ => (⟨i.1, by have := i.2; have := k.2; omega⟩ : Fin m)) ?_ ?_ ?_ ?_
 · intro i _; simp only [Finset.mem_filter, Finset.mem_univ, true_and]; exact ⟨Nat.zero_le _, i.2⟩
 · intro a _ b _ h; exact Fin.ext (by simpa using congrArg Fin.val h)
 ·
  intro j hj
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj
  exact ⟨⟨j.1, hj.2⟩, Finset.mem_univ _, Fin.ext rfl⟩
 ·
  intro i _
  have h1 : i.castSucc.castSucc.1 ≤ k.1 := by have := i.2; dsimp; omega
  have h2 : i.castSucc.succ.1 ≤ k.1 := by have := i.2; dsimp; omega
  have hq1 : Q i.castSucc.castSucc = P (⟨i.1, by have := i.2; have := k.2; omega⟩ : Fin m).castSucc := by
   dsimp only [Q]; rw [dif_pos h1]; rfl
  have hq2 : Q i.castSucc.succ = P (⟨i.1, by have := i.2; have := k.2; omega⟩ : Fin m).succ := by
   dsimp only [Q]; rw [dif_pos h2]; rfl
  rw [hq1, hq2]
theorem zdu {m : ℕ} (P : Fin (m + 1) → V2)
  (hMin : zat m P)
  (W : Fin (m + 1) ≃ Fin (m + 1))
  (hW : zbe m (P ∘ W))
  (kM : Fin (m + 1)) (h : ℝ) (hh_pos : 0 < h)
  (hMy : (P (W kM)).2 = h)
  (hy_le : ∀ i : Fin (m + 1), (P i).2 ≤ h)
  (hFM : W 0 < W kM) (hMT : W kM < W (Fin.last m))
  (hT_lt : (W (Fin.last m)).1 < m)
  (k1 : Fin m)
  (hk1_eq : (W k1.castSucc).1 + 1 = (W (Fin.last m)).1)
  (hk1_lt : k1.succ ≠ Fin.last m)
  (hVisited : ∀ k : Fin (m + 1), k ≤ k1.castSucc ↔ (W k).1 ≤ (W k1.castSucc).1)
  (hDet_F_L1_S : ∀ k : Fin (m + 1), k1.castSucc < k →
   0 < det3 (P (W k1.castSucc)) (P (W 0)) (P (W k)))
  (hL2_le_L1 : (P (W k1.succ)).2 ≤ (P (W k1.castSucc)).2)
  (hSubAdd : ∀ {i j k : Fin (m + 1)}, i ≤ j → j ≤ k → zac P i j + zac P j k = zac P i k)
  (hSubLe : ∀ i j : Fin (m + 1), zac P i j ≤ zp P)
  (hSub0 : zac P 0 (Fin.last m) = zp P)
  (hDistSub : ∀ {i j : Fin (m + 1)}, i ≤ j → zt (P i) (P j) ≤ zac P i j) :
  (1 + Real.sqrt 2) * h ≤ zp P := by
 set iF := W 0
 set iM := W kM
 set iT := W (Fin.last m)
 set iL1 := W k1.castSucc
 set iL2 := W k1.succ
 have hF_y : (P iF).2 = 0 := hW.hy0
 have hT_y : (P iT).2 = 0 := hW.hym
 have hFT_x : (P iF).1 < (P iT).1 := hW.hx
 have hy_nn : ∀ i : Fin (m + 1), 0 ≤ (P i).2 := fun i => by
  have := hW.hy_nn (W.symm i); simpa using this
 have hL1_lt_T : iL1 < iT := by show iL1.1 < iT.1; omega
 have hM_le_L1 : iM ≤ iL1 := by
  have : iM.1 < iT.1 := hMT
  show iM.1 ≤ iL1.1; omega
 have hF_lt_L1 : iF < iL1 := lt_of_lt_of_le hFM hM_le_L1
 have hT_lt_L2 : iT < iL2 := by
  have h1 : iL1.1 < iL2.1 := by
   by_contra hle; push Not at hle
   have hk := (hVisited k1.succ).mpr hle
   have : k1.succ.1 ≤ k1.castSucc.1 := hk
   simp at this
  have hne : iL2 ≠ iT := fun h => hk1_lt (W.injective h)
  have hne_val : iL2.1 ≠ iT.1 := fun h => hne (Fin.ext h)
  show iT.1 < iL2.1; omega
 have hVert : ∀ {i j : Fin (m + 1)}, i ≤ j → |(P j).2 - (P i).2| ≤ zac P i j := by
  intro i j hij
  have h1 : (P j).2 - (P i).2 ≤ zt (P i) (P j) := by
   simpa [dot2, sub2] using zb0 (a := P i) (b := P j) (q := (0, 1)) (by norm_num [ze])
  have h2 : -((P j).2 - (P i).2) ≤ zt (P i) (P j) := by
   simpa [dot2, sub2] using zb0 (a := P i) (b := P j) (q := (0, -1)) (by norm_num [ze])
  have h3 := hDistSub hij
  rw [abs_le]; constructor <;> linarith
 rcases eq_or_lt_of_le hL2_le_L1 with hpar | hy2_lt_y1
 ·
  have hy1_eq_h : (P iL1).2 = h := by
   have hne1 : (0 : Fin (m + 1)) ≠ k1.castSucc := fun h => by
    have := congrArg W h; exact ne_of_lt hF_lt_L1 this
   have hne2 : (0 : Fin (m + 1)) ≠ k1.succ := fun h => by
    have := congrArg W h; exact ne_of_lt (hF_lt_L1.trans (hL1_lt_T.trans hT_lt_L2)) this
   have hlt0 := hW.strict_right k1 0 hne1 hne2
   dsimp [Function.comp, zh, sub2] at hlt0
   rw [hF_y, hpar] at hlt0
   have hdx_pos : 0 < (P iL2).1 - (P iL1).1 := by
    have : 0 ≤ (P iL1).2 := hy_nn iL1
    nlinarith
   have hleM : zh (sub2 (P iL2) (P iL1)) (sub2 (P iM) (P iL1)) ≤ 0 := by
    by_cases hm1 : kM = k1.castSucc
    · dsimp [iM, iL1]; rw [hm1]; unfold zh sub2; linarith
    ·
     by_cases hm2 : kM = k1.succ
     · dsimp [iM, iL2]; rw [hm2]; unfold zh sub2; linarith
     · exact le_of_lt (hW.strict_right k1 kM hm1 hm2)
   dsimp [zh, sub2] at hleM
   rw [hMy, hpar] at hleM
   have hge : h ≤ (P iL1).2 := by nlinarith
   exact le_antisymm (hy_le iL1) hge
  have h1 : h ≤ zac P iF iL1 := by
   have := hVert hF_lt_L1.le; rw [hF_y, hy1_eq_h, sub_zero, abs_of_pos hh_pos] at this; exact this
  have h2 : h ≤ zac P iL1 iT := by
   have := hVert hL1_lt_T.le; rw [hT_y, hy1_eq_h, zero_sub, abs_neg, abs_of_pos hh_pos] at this; exact this
  have h3 : h ≤ zac P iT iL2 := by
   have := hVert hT_lt_L2.le; rw [hT_y, hpar, hy1_eq_h, sub_zero, abs_of_pos hh_pos] at this; exact this
  have hsum : zac P iF iL1 + zac P iL1 iT + zac P iT iL2 = zac P iF iL2 := by
   rw [hSubAdd hF_lt_L1.le hL1_lt_T.le, hSubAdd (hF_lt_L1.le.trans hL1_lt_T.le) hT_lt_L2.le]
  have hsqrt2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).2 (by norm_num)
  have hle := hSubLe iF iL2
  nlinarith
 ·
  set y1 := (P iL1).2
  set y2 := (P iL2).2
  have hy1_pos : 0 < y1 := by linarith [hy_nn iL2]
  have hdy_pos : 0 < y1 - y2 := by linarith
  let xE : ℝ := (P iL1).1 + y1 * ((P iL2).1 - (P iL1).1) / (y1 - y2)
  let E : V2 := (xE, 0)
  have hT_lt_xE : (P iT).1 < xE := by
   have hne1 : Fin.last m ≠ k1.castSucc := fun h => by
    have := congrArg W h; exact ne_of_gt hL1_lt_T this
   have hne2 : Fin.last m ≠ k1.succ := fun h => by
    have := congrArg W h; exact ne_of_lt hT_lt_L2 this
   have hltT := hW.strict_right k1 (Fin.last m) hne1 hne2
   dsimp [Function.comp, zh, sub2] at hltT
   rw [hT_y] at hltT
   dsimp [xE]
   have h1 : ((P iT).1 - (P iL1).1) * (y1 - y2) < y1 * ((P iL2).1 - (P iL1).1) := by linarith
   have h2 : (P iT).1 - (P iL1).1 < y1 * ((P iL2).1 - (P iL1).1) / (y1 - y2) :=
    (lt_div_iff₀ hdy_pos).mpr h1
   linarith
  have hF_lt_xE : (P iF).1 < xE := lt_trans hFT_x hT_lt_xE
  let QE : Fin (iL1.1 + 1 + 1) → V2 :=
   fun j => if h : j.1 ≤ iL1.1 then P ⟨j.1, by omega⟩ else E
  have hQE_supp : ∀ u : V2, supp P u ≤ supp QE u := by
   intro u
   rw [supp, Finset.sup'_le_iff]
   intro j _
   by_cases hj : j.1 ≤ iL1.1
   ·
    have hjeq : P j = QE ⟨j.1, by omega⟩ := by
     dsimp only [QE]; rw [dif_pos hj]
    rw [hjeq]; exact zo QE u ⟨j.1, by omega⟩
   ·
    set k := W.symm j
    have hk_gt : k1.castSucc < k := by
     by_contra hle; push Not at hle
     have h1 := (hVisited k).mp hle
     have h2 : W k = j := W.apply_symm_apply j
     rw [h2] at h1; exact hj h1
    set F := P iF; set L1 := P iL1; set S := P j
    have hS_eq : S = P (W k) := by dsimp [S, k]; rw [W.apply_symm_apply]
    have hD : 0 < det3 F E L1 := by
     dsimp [det3, zh, sub2, F, E, L1]
     rw [hF_y]; nlinarith
    have hd_FES : 0 ≤ det3 F E S := by
     dsimp [det3, zh, sub2, F, E, S]
     rw [hF_y]; nlinarith [hy_nn j]
    have hd_L1FS : 0 < det3 L1 F S := by
     rw [hS_eq]; exact hDet_F_L1_S k hk_gt
    have hd_EL1S : 0 ≤ det3 E L1 S := by
     have hle_cr : zh (sub2 (P iL2) L1) (sub2 S L1) ≤ 0 := by
      rw [hS_eq]
      by_cases h2 : k = k1.succ
      · dsimp [iL2]; rw [h2]; unfold zh sub2; linarith
      · exact le_of_lt (hW.strict_right k1 k (ne_of_gt hk_gt) h2)
     have hrel : det3 E L1 S = -(y1 / (y1 - y2)) * zh (sub2 (P iL2) L1) (sub2 S L1) := by
      have hdy_ne : (P iL1).2 - (P iL2).2 ≠ 0 := ne_of_gt hdy_pos
      dsimp [det3, zh, sub2, E, xE, L1, y1, y2]
      field_simp [hdy_ne]; ring
     rw [hrel]
     have hpos_f : 0 < y1 / (y1 - y2) := div_pos hy1_pos hdy_pos
     nlinarith
    set D := det3 F E L1
    let α := det3 E L1 S / D
    let β := det3 L1 F S / D
    let γ := det3 F E S / D
    have hα : 0 ≤ α := div_nonneg hd_EL1S hD.le
    have hβ : 0 ≤ β := div_nonneg hd_L1FS.le hD.le
    have hγ : 0 ≤ γ := div_nonneg hd_FES hD.le
    have hsum1 : α + β + γ = 1 := by
     have hDne : D ≠ 0 := ne_of_gt hD
     dsimp [α, β, γ, D, det3, zh, sub2] at hDne ⊢
     field_simp [hDne]; ring
    have hS1 : S.1 = α * F.1 + β * E.1 + γ * L1.1 := by
     have hDne : D ≠ 0 := ne_of_gt hD
     dsimp [α, β, γ, D, det3, zh, sub2] at hDne ⊢
     field_simp [hDne]; ring
    have hS2 : S.2 = α * F.2 + β * E.2 + γ * L1.2 := by
     have hDne : D ≠ 0 := ne_of_gt hD
     dsimp [α, β, γ, D, det3, zh, sub2] at hDne ⊢
     field_simp [hDne]; ring
    have hFu : dot2 F u ≤ supp QE u := by
     have hF_in : F = QE ⟨iF.1, by have : iF.1 < iL1.1 := hF_lt_L1; omega⟩ := by
      dsimp [QE, F]; split_ifs with h
      · rfl
      · exact absurd (le_of_lt hF_lt_L1) h
     rw [hF_in]; exact zo QE u _
    have hEu : dot2 E u ≤ supp QE u := by
     have hE_in : E = QE (Fin.last (iL1.1 + 1)) := by
      dsimp [QE]; split_ifs with h
      · simp [Fin.last] at h
      · rfl
     rw [hE_in]; exact zo QE u _
    have hL1u : dot2 L1 u ≤ supp QE u := by
     have hL1_in : L1 = QE ⟨iL1.1, by omega⟩ := by
      dsimp [QE, L1]; split_ifs with h
      · rfl
      · exact absurd le_rfl h
     rw [hL1_in]; exact zo QE u _
    have hdot : dot2 S u = α * dot2 F u + β * dot2 E u + γ * dot2 L1 u := by
     dsimp [dot2]; rw [hS1, hS2]; ring
    change dot2 S u ≤ supp QE u
    have h1 : α * dot2 F u ≤ α * supp QE u := mul_le_mul_of_nonneg_left hFu hα
    have h2 : β * dot2 E u ≤ β * supp QE u := mul_le_mul_of_nonneg_left hEu hβ
    have h3 : γ * dot2 L1 u ≤ γ * supp QE u := mul_le_mul_of_nonneg_left hL1u hγ
    have h4 : α * supp QE u + β * supp QE u + γ * supp QE u = supp QE u := by
     linear_combination supp QE u * hsum1
    linarith
  have hQE_esc : z5 QE := zd9 hMin.1 hQE_supp
  have hQE_lt : zp P < zp QE := hMin.2.2 (iL1.1 + 1) (by omega) QE hQE_esc
  have hQE_len : zp QE = zac P 0 iL1 + zt (P iL1) E := zes P iL1 E
  have hSplitP : zac P 0 iL1 + zac P iL1 (Fin.last m) = zp P := by
   rw [hSubAdd (Fin.zero_le iL1) (Fin.le_last iL1), hSub0]
  have hTail_lt_E : zac P iL1 (Fin.last m) < zt (P iL1) E := by linarith
  have hL1_lt_xE : (P iL1).1 < xE := by
   by_contra hge; push Not at hge
   let Pf : V2 := ((P iL1).1, 0)
   let QP : Fin (iL1.1 + 1 + 1) → V2 :=
    fun j => if h : j.1 ≤ iL1.1 then P ⟨j.1, by omega⟩ else Pf
   have hQP_supp : ∀ u : V2, supp QE u ≤ supp QP u := by
    intro u
    rw [supp, Finset.sup'_le_iff]
    intro j _
    by_cases hj : j.1 ≤ iL1.1
    ·
     have heq : QE j = QP j := by dsimp [QE, QP]; rw [dif_pos hj, dif_pos hj]
     rw [heq]; exact zo QP u j
    ·
     have hjeq : QE j = E := by dsimp [QE]; rw [dif_neg hj]
     rw [hjeq]
     have hFL1 : (P iF).1 < (P iL1).1 := lt_of_lt_of_le hF_lt_xE hge
     let t : ℝ := (xE - (P iF).1) / ((P iL1).1 - (P iF).1)
     have ht0 : 0 ≤ t := div_nonneg (by linarith) (by linarith)
     have ht1 : t ≤ 1 := (div_le_one (by linarith)).mpr (by linarith)
     have hE1 : E.1 = (1 - t) * (P iF).1 + t * Pf.1 := by
      dsimp [t, E, Pf]; field_simp [ne_of_gt (sub_pos.mpr hFL1)]; ring
     have hE2 : E.2 = (1 - t) * (P iF).2 + t * Pf.2 := by
      dsimp [E, Pf]; rw [hF_y]; ring
     have hFu : dot2 (P iF) u ≤ supp QP u := by
      have hF_in : P iF = QP ⟨iF.1, by have : iF.1 < iL1.1 := hF_lt_L1; omega⟩ := by
       dsimp [QP]; split_ifs with h
       · rfl
       · exact absurd (le_of_lt hF_lt_L1) h
      rw [hF_in]; exact zo QP u _
     have hPfu : dot2 Pf u ≤ supp QP u := by
      have hPf_in : Pf = QP (Fin.last (iL1.1 + 1)) := by
       dsimp [QP]; split_ifs with h
       · simp [Fin.last] at h
       · rfl
      rw [hPf_in]; exact zo QP u _
     have hdot : dot2 E u = (1 - t) * dot2 (P iF) u + t * dot2 Pf u := by
      dsimp [dot2]; conv_lhs => rw [hE1, hE2]
