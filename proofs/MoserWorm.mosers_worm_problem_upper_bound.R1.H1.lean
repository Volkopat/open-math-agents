  set ik := k - jk
  have hLvm : zc L v0 + dM = zc L vm := by
   have hadd : (zc L v0 + zc v0 vm) % (m + 1) = zc L vm := by
    dsimp [zc]
    have hL' : L.1 < m + 1 := L.2; have hv' : v0.1 < m + 1 := v0.2; have hvm' : vm.1 < m + 1 := vm.2
    have h1 : ((v0.1 + (m + 1) - L.1) % (m + 1) + (vm.1 + (m + 1) - v0.1) % (m + 1)) % (m + 1) =
      ((v0.1 + (m + 1) - L.1) + (vm.1 + (m + 1) - v0.1)) % (m + 1) := (Nat.add_mod _ _ _).symm
    rw [h1]
    have h2 : (v0.1 + (m + 1) - L.1) + (vm.1 + (m + 1) - v0.1) = (vm.1 + (m + 1) - L.1) + (m + 1) := by omega
    rw [h2, Nat.add_mod_right]
   have hltL : zc L v0 < m + 1 := Nat.mod_lt _ (by omega)
   have hltM : dM < m + 1 := Nat.mod_lt _ (by omega)
   rcases lt_or_ge (zc L v0 + dM) (m + 1) with hl | hg
   · rw [Nat.mod_eq_of_lt hl] at hadd; exact hadd
   ·
    have hmod : (zc L v0 + dM) % (m + 1) = zc L v0 + dM - (m + 1) := by
     have hsp : zc L v0 + dM = (zc L v0 + dM - (m + 1)) + (m + 1) := by omega
     conv_lhs => rw [hsp]; rw [Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
