     have hWkM : W kM = e vM := W.apply_symm_apply (e vM)
     have hdet_iso : ∀ a b c : V2,
       det3 (zao cr sr false sh a) (zao cr sr false sh b) (zao cr sr false sh c) =
       det3 a b c := fun a b c => by
      dsimp [det3, zh, sub2, zao, add2, rot2]
      linear_combination ((b.1 - a.1) * (c.2 - a.2) - (b.2 - a.2) * (c.1 - a.1)) * hcs
     have hkM_att : dot2 ((P' ∘ W) kM) (0, 1) = supp (P' ∘ W) (0, 1) := by
      rw [zi]
      apply le_antisymm (zo P' (0, 1) (W kM))
      rw [supp, Finset.sup'_le_iff]; intro i _
      have hle := hDetMax (e.symm i)
      rw [e.apply_symm_apply] at hle
      have h1 := hdet_iso (P (e F)) (P (e (zg F))) (P i)
      have h2 := hdet_iso (P (e F)) (P (e (zg F))) (P (e vM))
      have hy0 : (P' (e F)).2 = 0 := by rw [← hW0]; exact hW.hy0
      have hym : (P' (e (zg F))).2 = 0 := by rw [← hWm]; exact hW.hym
      have hdx : (P' (e F)).1 < (P' (e (zg F))).1 := by rw [← hW0, ← hWm]; exact hW.hx
      have hd1 : det3 (P' (e F)) (P' (e (zg F))) (P' i) =
        ((P' (e (zg F))).1 - (P' (e F)).1) * (P' i).2 := by
       unfold det3 zh sub2; rw [hy0, hym]; ring
      have hd2 : det3 (P' (e F)) (P' (e (zg F))) (P' (e vM)) =
        ((P' (e (zg F))).1 - (P' (e F)).1) * (P' (e vM)).2 := by
       unfold det3 zh sub2; rw [hy0, hym]; ring
      dsimp [Function.comp, dot2]; rw [hWkM]
      nlinarith [h1, h2, hd1, hd2, hle, hdx]
     have hR := zd8 P' hMin' bt hbt qt hqt W hW h3W kM hkM_att
      (by rw [hW0, hWkM]; exact hFM)
      (by rw [hWkM, hWm]; exact hMT)
      (by rw [hW0, hWm]; exact hNonTerm)
     rwa [zck hcs false sh P] at hR
    ·
     have hjF' : jF < N + 1 - dM := by rwa [← hdM_eq]
     set T := z6 v0 (jF + 1)
     set F := zg T
     have hFeq : F = z6 v0 jF := by
      ext; dsimp [F, T, zg, z6]
      rw [Nat.mod_eq_of_lt (by omega : jF + 1 < N + 1), Nat.mod_eq_of_lt (by omega : jF < N + 1)]
      rw [za7]
      have : v0.1 + (N + 1) - (jF + 1) + 1 = v0.1 + (N + 1) - jF := by omega
      rw [this]
     obtain ⟨cr, sr, sh, hcs, hW0, hWm, hW⟩ := zdg P e hC T
     set P' : Fin (N + 1) → V2 := fun i => zao cr sr true sh (P i)
     let W : Fin (N + 1) ≃ Fin (N + 1) :=
      {
       toFun := fun k => e (z0 F k.1)
       invFun := fun i => ⟨zc F (e.symm i), zab _ _⟩
       left_inv := by
        intro k; ext; change zc F (e.symm (e (z0 F k.1))) = k.1
        rw [e.symm_apply_apply]; exact zl F k.1 k.2
       right_inv := by
        intro i; change e (z0 F (zc F (e.symm i))) = i
        suffices h : z0 F (zc F (e.symm i)) = e.symm i by rw [h, e.apply_symm_apply]
        ext; dsimp [z0, zc]
        set x := (e.symm i).1; have hx := (e.symm i).2; have hF := F.2
        rw [Nat.add_mod F.1, Nat.mod_mod, ← Nat.add_mod]
        have : F.1 + (x + (N + 1) - F.1) = x + (N + 1) := by omega
        rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt hx] }
     have h3W : zu W := by
      have h := zdz e hBit1 hBit2 jF hjF
      dsimp only at h
      simpa [W, hFeq] using h
     have hMin' : zat N P' := zde hcs true sh hMin
     let kM := W.symm (e vM)
     have hWkM : W kM = e vM := W.apply_symm_apply (e vM)
     have hdet_iso : ∀ a b c : V2,
       det3 (zao cr sr true sh a) (zao cr sr true sh b) (zao cr sr true sh c) =
       -det3 a b c := fun a b c => by
      dsimp [det3, zh, sub2, zao, add2, rot2, zdp]
      linear_combination -((b.1 - a.1) * (c.2 - a.2) - (b.2 - a.2) * (c.1 - a.1)) * hcs
     have hkM_att : dot2 ((P' ∘ W) kM) (0, 1) = supp (P' ∘ W) (0, 1) := by
      rw [zi]
      apply le_antisymm (zo P' (0, 1) (W kM))
      rw [supp, Finset.sup'_le_iff]; intro i _
      have hle := hDetMax (e.symm i)
      rw [e.apply_symm_apply] at hle
      have h1 := hdet_iso (P (e F)) (P (e T)) (P i)
      have h2 := hdet_iso (P (e F)) (P (e T)) (P (e vM))
      have hsw1 : -det3 (P (e F)) (P (e T)) (P i) = det3 (P (e T)) (P (e F)) (P i) := by
       unfold det3 zh sub2; ring
      have hsw2 : -det3 (P (e F)) (P (e T)) (P (e vM)) = det3 (P (e T)) (P (e F)) (P (e vM)) := by
       unfold det3 zh sub2; ring
      have hy0 : (P' (e F)).2 = 0 := by rw [← hW0]; exact hW.hy0
      have hym : (P' (e T)).2 = 0 := by rw [← hWm]; exact hW.hym
      have hdx : (P' (e F)).1 < (P' (e T)).1 := by rw [← hW0, ← hWm]; exact hW.hx
      have hd1 : det3 (P' (e F)) (P' (e T)) (P' i) =
        ((P' (e T)).1 - (P' (e F)).1) * (P' i).2 := by
       unfold det3 zh sub2; rw [hy0, hym]; ring
      have hd2 : det3 (P' (e F)) (P' (e T)) (P' (e vM)) =
        ((P' (e T)).1 - (P' (e F)).1) * (P' (e vM)).2 := by
       unfold det3 zh sub2; rw [hy0, hym]; ring
      dsimp [Function.comp, dot2]; rw [hWkM]
      nlinarith [h1, h2, hsw1, hsw2, hd1, hd2, hle, hdx]
     have hR := zd8 P' hMin' bt hbt qt hqt W hW h3W kM hkM_att
      (by rw [hW0, hWkM]; exact hFM)
      (by rw [hWkM, hWm]; exact hMT)
      (by rw [hW0, hWm]; exact hNonTerm)
     rwa [zck hcs true sh P] at hR
end
end MoserWormH1


