   have h1 : ((v0.1 + (m + 1) - L.1) % (m + 1) + (x.1 + (m + 1) - v0.1) % (m + 1)) % (m + 1) =
     ((v0.1 + (m + 1) - L.1) + (x.1 + (m + 1) - v0.1)) % (m + 1) := (Nat.add_mod _ _ _).symm
   rw [h1]
   have h2 : (v0.1 + (m + 1) - L.1) + (x.1 + (m + 1) - v0.1) = (x.1 + (m + 1) - L.1) + (m + 1) := by omega
