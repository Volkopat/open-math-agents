lemma zez {n : ℕ} (ι : Fin 15 → Fin (n + 1))
  (h3 : zu ι)
  (hFZ2 : ι 0 ≤ ι 5) (hFM : ι 0 < ι 6) (hMT : ι 6 < ι 14)
  (hFU : ι 0 < ι 7) (hUT : ι 7 < ι 14) (hTV : ι 14 < ι 8)
  (t : Fin (n + 1)) :
  let S := Finset.univ.filter (fun k : Fin 15 => t ≤ ι k)
  S = ∅ ∨ S = Finset.univ ∨
