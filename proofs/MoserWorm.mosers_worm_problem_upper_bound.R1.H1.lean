       rw [Fin.succAbove_of_le_castSucc _ _ (by show d.1 ≤ (zg r).1; omega)]
       dsimp [Fin.succ]; rw [hcs, Nat.mod_eq_of_lt (by omega)]
      ·
       have hpred : (d.1 + (m' + 1) - 1) % (m' + 1) = d.1 - 1 := by
        have : d.1 + (m' + 1) - 1 = (d.1 - 1) + (m' + 1) := by omega
        rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
       rw [hpred] at hr_eq
       have hr_d : r.1 = d.1 - 1 := by
        by_cases hlt : r.1 < d.1
        ·
         rw [Fin.succAbove_of_castSucc_lt _ _ (by show r.1 < d.1; exact hlt)] at hr_eq
         dsimp [Fin.castSucc] at hr_eq; exact hr_eq
        ·
         rw [Fin.succAbove_of_le_castSucc _ _ (by show d.1 ≤ r.1; omega)] at hr_eq
         dsimp [Fin.succ] at hr_eq; omega
       by_cases hdm : d.1 < m'
       ·
        have hcs : (zg r).1 = d.1 := by dsimp [zg]; rw [show r.1 + 1 = d.1 by omega, Nat.mod_eq_of_lt hdm]
        rw [Fin.succAbove_of_le_castSucc _ _ (by show d.1 ≤ (zg r).1; omega)]
        dsimp [Fin.succ]; rw [hcs, Nat.mod_eq_of_lt (by omega)]
       ·
        have hdeq : d.1 = m' := by omega
        have hcs : (zg r).1 = 0 := by dsimp [zg]; rw [show r.1 + 1 = m' by omega, Nat.mod_self]
        rw [Fin.succAbove_of_castSucc_lt _ _ (by show (zg r).1 < d.1; omega)]
        dsimp [Fin.castSucc]; rw [hcs, hdeq, Nat.mod_self]
     set A := V ra; set B := V d; set C := V r1a; set S := V sa
     have hsa_d : sa ≠ d := Fin.succAbove_ne d s
     have hsucc_ra : zg ra = d := by rw [hra, zc8]
     have hrc_ne : r1a ≠ ra := by
      intro h
      have h1 : zg (zg ra) = ra := by rw [hsucc_ra, ← hr1a, h]
      have hd2 := zbi ra (zg ra)
      rw [h1, za3] at hd2
      have hd1 : zc ra (zg ra) = 1 := by
       rw [zbi, za3, zero_add, Nat.mod_eq_of_lt (by omega)]
      rw [hd1, Nat.mod_eq_of_lt (by omega)] at hd2; omega
