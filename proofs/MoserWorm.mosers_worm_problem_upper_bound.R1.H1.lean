     dsimp [P0', sub2, dot2] at *; linarith
    ·
     obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty (fun j => dot2 (P0 j) v)
     change supp P0 v = dot2 (P0 i) v at hi
     have h2 := zo P0' v i
     dsimp [P0', sub2, dot2] at hi h2 ⊢; linarith
   rw [hst u, hst (n1 u), hst (n2 u)]
   have hbal : 2 * c0 * dot2 (P0 0) u + dot2 (P0 0) (n1 u) + dot2 (P0 0) (n2 u) = 0 := by
    dsimp [dot2, n1, n2]; ring
   linarith [hEsc0 u hu]
 obtain ⟨Qmin, hQminS, hQmin⟩ := hCompS.exists_isMinOn hSne (zej n0).continuousOn
 let Lmin : ℝ := zp Qmin
 have hAllGe : ∀ (M : ℕ) (hM : M ≤ n0) (Q : Fin (M + 1) → V2), z5 Q → Lmin ≤ zp Q := by
  intro M hM Q hEQ
  by_cases hQL : zp Q ≤ L0
  ·
   let Q' : Fin (n0 + 1) → V2 := fun i => sub2 (zcl hM Q i) (zcl hM Q 0)
   have hQ'len : zp Q' = zp Q := by
    have h1 : zp Q' = zp (zcl hM Q) := by
     unfold zp zt zn ze Q' sub2; congr 1; ext i; congr 1; ring
    rw [h1, zhg]
   have hQ'S : Q' ∈ S := by
    refine ⟨by apply Prod.ext <;> dsimp [Q', sub2] <;> ring, by linarith, ?_⟩
    intro u hu
    have hst : ∀ v, supp Q' v = supp Q v - dot2 (zcl hM Q 0) v := by
     intro v
     rw [← zic hM Q v]
     apply le_antisymm
     ·
      rw [supp, Finset.sup'_le_iff]; intro i _
      have := zo (zcl hM Q) v i
      dsimp [Q', sub2, dot2] at *; linarith
     ·
      obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty
       (fun j => dot2 (zcl hM Q j) v)
      change supp (zcl hM Q) v = dot2 (zcl hM Q i) v at hi
      have h2 := zo Q' v i
      dsimp [Q', sub2, dot2] at hi h2 ⊢; linarith
    rw [hst u, hst (n1 u), hst (n2 u)]
    have hbal : 2 * c0 * dot2 (zcl hM Q 0) u + dot2 (zcl hM Q 0) (n1 u) +
      dot2 (zcl hM Q 0) (n2 u) = 0 := by dsimp [dot2, n1, n2]; ring
    linarith [hEQ u hu]
   have hle : Lmin ≤ zp Q' := hQmin hQ'S
   linarith
  · linarith [hQminS.2.1]
 have hexN : ∃ N : ℕ, ∃ P : Fin (N + 1) → V2, z5 P ∧ zp P = Lmin :=
  ⟨n0, Qmin, hQminS.2.2, rfl⟩
 let N := Nat.find hexN
 have hN_le : N ≤ n0 := Nat.find_min' hexN ⟨Qmin, hQminS.2.2, rfl⟩
 obtain ⟨P, hPEsc, hPLen⟩ := Nat.find_spec hexN
 refine ⟨N, P, hPEsc, by linarith [hQminS.2.1], ?_, ?_⟩
 ·
  intro M hMN Q hQE
  rw [hPLen]; exact hAllGe M (hMN.trans hN_le) Q hQE
 ·
  intro M hMN Q hQE
  have hge : zp P ≤ zp Q := by rw [hPLen]; exact hAllGe M (hMN.le.trans hN_le) Q hQE
  rcases lt_or_eq_of_le hge with hlt | heq
  · exact hlt
  ·
   exfalso
   exact Nat.find_min hexN hMN ⟨Q, hQE, by linarith⟩
lemma zgv {N : ℕ} (P : Fin (N + 2) → V2) (k : Fin (N + 2)) :
  zp (fun i : Fin (N + 1) => P (k.succAbove i)) ≤ zp P := by
 unfold zp
 by_cases hk0 : k = 0
 ·
  subst hk0
  have hsum : ∑ i : Fin N, zt (P ((0 : Fin (N + 2)).succAbove i.castSucc))
    (P ((0 : Fin (N + 2)).succAbove i.succ)) =
    ∑ i : Fin N, zt (P i.succ.castSucc) (P i.succ.succ) := by
   refine Finset.sum_congr rfl fun i _ => ?_
   simp [Fin.succAbove_zero]
  rw [hsum, Fin.sum_univ_succ]
  have h0 := zcd (P (Fin.castSucc 0)) (P (Fin.succ 0))
  linarith
 ·
  by_cases hkl : k = Fin.last (N + 1)
  ·
   subst hkl
   have hsum : ∑ i : Fin N, zt (P ((Fin.last (N + 1)).succAbove i.castSucc))
     (P ((Fin.last (N + 1)).succAbove i.succ)) =
     ∑ i : Fin N, zt (P i.castSucc.castSucc) (P i.castSucc.succ) := by
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [Fin.succAbove_last]
   rw [hsum, Fin.sum_univ_castSucc]
   have hl := zcd (P (Fin.last N).castSucc) (P (Fin.last N).succ)
   linarith
  ·
   have hkpos : 0 < k.1 := Nat.pos_of_ne_zero (fun h => hk0 (Fin.ext h))
   have hklt : k.1 < N + 1 := Nat.lt_of_le_of_ne (Nat.le_of_lt_succ k.2) (fun h => hkl (Fin.ext h))
   let i0 : Fin N := ⟨k.1 - 1, by omega⟩
   let j1 : Fin (N + 1) := ⟨k.1 - 1, by omega⟩
   let j2 : Fin (N + 1) := ⟨k.1, by omega⟩
   have hj12 : j1 ≠ j2 := fun h => by have := congrArg Fin.val h; dsimp [j1, j2] at this; omega
   rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i0)]
   have hrhs : ∑ j : Fin (N + 1), zt (P j.castSucc) (P j.succ) =
     (zt (P j1.castSucc) (P j1.succ) + zt (P j2.castSucc) (P j2.succ)) +
     ∑ j ∈ (Finset.univ.erase j1).erase j2, zt (P j.castSucc) (P j.succ) := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j1)]
    have hj2_mem : j2 ∈ Finset.univ.erase j1 := Finset.mem_erase.mpr ⟨hj12.symm, Finset.mem_univ _⟩
    rw [← Finset.add_sum_erase _ _ hj2_mem]
    ring
   rw [hrhs]
   have htri : zt (P (k.succAbove i0.castSucc)) (P (k.succAbove i0.succ)) ≤
     zt (P j1.castSucc) (P j1.succ) + zt (P j2.castSucc) (P j2.succ) := by
    have h1 : k.succAbove i0.castSucc = j1.castSucc := by
     rw [Fin.succAbove_of_castSucc_lt]
     · ext; simp [i0, j1]
     · show i0.castSucc.1 < k.1; dsimp [i0]; omega
    have h2 : k.succAbove i0.succ = j2.succ := by
     rw [Fin.succAbove_of_le_castSucc]
     · ext; simp [i0, j2]; omega
     · show k.1 ≤ i0.succ.1; dsimp [i0]; omega
    have h3 : j1.succ = j2.castSucc := Fin.ext (by simp [j1, j2]; omega)
    rw [h1, h2, h3]
    exact zbc _ _ _
   have hj1v : j1.1 = k.1 - 1 := rfl
   have hj2v : j2.1 = k.1 := rfl
   have hi0v : i0.1 = k.1 - 1 := rfl
   have hrest_eq : ∑ i ∈ Finset.univ.erase i0,
      zt (P (k.succAbove i.castSucc)) (P (k.succAbove i.succ)) =
     ∑ j ∈ (Finset.univ.erase j1).erase j2, zt (P j.castSucc) (P j.succ) := by
    refine Finset.sum_bij (fun i _ => if i.1 < k.1 - 1 then ⟨i.1, by omega⟩ else ⟨i.1 + 1, by omega⟩)
     ?_ ?_ ?_ ?_
    ·
     intro i hi
     have hne : i.1 ≠ k.1 - 1 := fun h => (Finset.mem_erase.mp hi).1 (Fin.ext (by rw [hi0v]; exact h))
     simp only [Finset.mem_erase, Finset.mem_univ, and_true]
     constructor <;> intro h <;> have hv := congrArg Fin.val h
     · rw [hj2v] at hv; split_ifs at hv <;> simp at hv <;> omega
     · rw [hj1v] at hv; split_ifs at hv <;> simp at hv <;> omega
    ·
     intro a ha b hb h
     have hna : a.1 ≠ k.1 - 1 := fun h0 => (Finset.mem_erase.mp ha).1 (Fin.ext (by rw [hi0v]; exact h0))
     have hnb : b.1 ≠ k.1 - 1 := fun h0 => (Finset.mem_erase.mp hb).1 (Fin.ext (by rw [hi0v]; exact h0))
     have hv := congrArg Fin.val h
     ext; split_ifs at hv <;> simp at hv <;> omega
    ·
     intro j hj
     simp only [Finset.mem_erase, Finset.mem_univ, and_true] at hj
     have hn2 : j.1 ≠ k.1 := fun h => hj.1 (Fin.ext (by rw [hj2v]; exact h))
     have hn1 : j.1 ≠ k.1 - 1 := fun h => hj.2 (Fin.ext (by rw [hj1v]; exact h))
     by_cases hlt : j.1 < k.1 - 1
     ·
      refine ⟨⟨j.1, by omega⟩, ?_, ?_⟩
      ·
       simp only [Finset.mem_erase, Finset.mem_univ, and_true]
       intro h; have hv := congrArg Fin.val h; rw [hi0v] at hv; simp at hv; omega
      · ext; simp [hlt]
     ·
      refine ⟨⟨j.1 - 1, by omega⟩, ?_, ?_⟩
      ·
       simp only [Finset.mem_erase, Finset.mem_univ, and_true]
       intro h; have hv := congrArg Fin.val h; rw [hi0v] at hv; simp at hv; omega
      · ext; split_ifs with h' <;> simp at h' ⊢ <;> omega
    ·
     intro i hi
     have hne : i.1 ≠ k.1 - 1 := fun h0 => (Finset.mem_erase.mp hi).1 (Fin.ext (by rw [hi0v]; exact h0))
     split_ifs with hlt
     ·
      have h1 : k.succAbove i.castSucc = (⟨i.1, by omega⟩ : Fin (N + 1)).castSucc := by
       rw [Fin.succAbove_of_castSucc_lt]; · rfl
       · show i.castSucc.1 < k.1; simp; omega
      have h2 : k.succAbove i.succ = (⟨i.1, by omega⟩ : Fin (N + 1)).succ := by
       rw [Fin.succAbove_of_castSucc_lt]; · rfl
       · show i.succ.1 < k.1; simp; omega
      rw [h1, h2]
     ·
      have h1 : k.succAbove i.castSucc = (⟨i.1 + 1, by omega⟩ : Fin (N + 1)).castSucc := by
       rw [Fin.succAbove_of_le_castSucc]; · ext; simp
       · show k.1 ≤ i.castSucc.1; simp; omega
      have h2 : k.succAbove i.succ = (⟨i.1 + 1, by omega⟩ : Fin (N + 1)).succ := by
       rw [Fin.succAbove_of_le_castSucc]; · ext; simp
       · show k.1 ≤ i.succ.1; simp; omega
      rw [h1, h2]
   linarith
lemma ze1 {N : ℕ} (P : Fin (N + 1) → V2) (hEsc : z5 P) (hN : N ≤ 1) :
  1 ≤ zp P := by
 interval_cases N
 ·
  have h1 := hEsc (1, 0) (by norm_num [ze])
  have hsup : ∀ v, supp P v = dot2 (P 0) v := by
   intro v; unfold supp; simp [Fin.eq_zero]
  rw [hsup, hsup, hsup] at h1
  have hbal : 2 * c0 * dot2 (P 0) (1, 0) + dot2 (P 0) (n1 (1, 0)) + dot2 (P 0) (n2 (1, 0)) = 0 := by
   dsimp [dot2, n1, n2]; ring
  linarith [zbm]
 ·
  let d : V2 := sub2 (P 1) (P 0)
  let L : ℝ := zt (P 0) (P 1)
  have hlen : zp P = L := by
   unfold zp; simp [Fin.sum_univ_one, L]
  rw [hlen]
  by_cases hL : L = 0
  ·
   have h0 : P 1 = P 0 := by
    unfold L zt zn ze at hL
    have hsq : ((P 0).1 - (P 1).1) ^ 2 + ((P 0).2 - (P 1).2) ^ 2 = 0 := by
     have := (Real.sqrt_eq_zero (by positivity)).mp hL; exact this
    apply Prod.ext <;> nlinarith [sq_nonneg ((P 0).1 - (P 1).1), sq_nonneg ((P 0).2 - (P 1).2)]
   have h1 := hEsc (1, 0) (by norm_num [ze])
   have hsup : ∀ v, supp P v = dot2 (P 0) v := by
    intro v; apply le_antisymm
    ·
     rw [supp, Finset.sup'_le_iff]; intro i _; fin_cases i
     · exact le_rfl
     · change dot2 (P 1) v ≤ dot2 (P 0) v; rw [h0]
    · exact zo P v 0
   rw [hsup, hsup, hsup] at h1
   have hbal : 2 * c0 * dot2 (P 0) (1, 0) + dot2 (P 0) (n1 (1, 0)) + dot2 (P 0) (n2 (1, 0)) = 0 := by
    dsimp [dot2, n1, n2]; ring
   linarith [zbm]
  ·
   have hLpos : 0 < L := lt_of_le_of_ne (zcd _ _) (Ne.symm hL)
   let e : V2 := (d.1 / L, d.2 / L)
   have he : ze e = 1 := by
    unfold ze e d L zt zn ze sub2
    have hsq := Real.sq_sqrt (by positivity : 0 ≤ ((P 0).1 - (P 1).1) ^ 2 + ((P 0).2 - (P 1).2) ^ 2)
    have hne : Real.sqrt (((P 0).1 - (P 1).1) ^ 2 + ((P 0).2 - (P 1).2) ^ 2) ≠ 0 := hL
    field_simp; nlinarith
   let u : V2 := rot2 e.1 e.2 (s0, c0)
   have hu : ze u = 1 := by
    unfold ze u rot2 at *
    have hcs := zad
    nlinarith [he]
   have hdu : dot2 d u = L * s0 := by
    have h1 : d.1 = L * e.1 ∧ d.2 = L * e.2 := by
     dsimp [e]; constructor <;> field_simp [hL]
    dsimp [dot2, u, rot2]; rw [h1.1, h1.2]
    unfold ze at he; linear_combination L * s0 * he
   have hdn1 : dot2 d (n1 u) = 0 := by
    have h1 : d.1 = L * e.1 ∧ d.2 = L * e.2 := by
     dsimp [e]; constructor <;> field_simp [hL]
    dsimp [dot2, n1, u, rot2]; rw [h1.1, h1.2]
    have hcs := zad
    nlinarith
   have hdn2 : dot2 d (n2 u) = -L * rho0 := by
    have h1 : d.1 = L * e.1 ∧ d.2 = L * e.2 := by
     dsimp [e]; constructor <;> field_simp [hL]
    dsimp [dot2, n2, u, rot2]; rw [h1.1, h1.2]
    have h2sc := zep
    unfold ze at he; linear_combination -L * (2 * s0 * c0) * he - L * h2sc
   have hsup_eq : ∀ v, supp P v = max (dot2 (P 0) v) (dot2 (P 0) v + dot2 d v) := by
    intro v
    have hP1 : dot2 (P 1) v = dot2 (P 0) v + dot2 d v := by dsimp [dot2, d, sub2]; ring
    unfold supp
    have huniv : (Finset.univ : Finset (Fin 2)) = {0, 1} := by decide
    simp [huniv, hP1]
   have hEscU := hEsc u hu
   rw [hsup_eq u, hsup_eq (n1 u), hsup_eq (n2 u), hdu, hdn1, hdn2] at hEscU
   rw [max_eq_right (by nlinarith [hLpos, zb8]),
     max_eq_left (by linarith),
     max_eq_left (by nlinarith [hLpos, zbm])] at hEscU
   have hbal : 2 * c0 * dot2 (P 0) u + dot2 (P 0) (n1 u) + dot2 (P 0) (n2 u) = 0 := by
    dsimp [dot2, n1, n2]; ring
   have h2sc := zep
   nlinarith [zbm]
theorem zeu {N : ℕ} (P : Fin (N + 2) → V2)
  (hEsc : z5 P)
  (hMinN : ∀ (M : ℕ), M < N + 1 → ∀ (Q : Fin (M + 1) → V2), z5 Q → zp P < zp Q) :
  ∀ k : Fin (N + 2), ∃ u : V2, ∀ j ≠ k, dot2 (P j) u < dot2 (P k) u := by
 intro k
 by_contra hno
 push_neg at hno
 let Q : Fin (N + 1) → V2 := fun i => P (k.succAbove i)
 have hsup : ∀ v, supp P v ≤ supp Q v := by
  intro v
  rw [supp, Finset.sup'_le_iff]
  intro i _
  by_cases hik : i = k
  ·
   subst hik
   obtain ⟨j, hjk, hle⟩ := hno v
   obtain ⟨i', hi'⟩ := Fin.exists_succAbove_eq hjk
   have := zo Q v i'
   dsimp [Q] at this; rw [hi'] at this; linarith
  ·
   obtain ⟨i', hi'⟩ := Fin.exists_succAbove_eq hik
   have := zo Q v i'
   dsimp [Q] at this; rw [hi'] at this; exact this
 have hQEsc : z5 Q := zgd hsup hEsc
 have hQLen : zp Q ≤ zp P := zgv P k
 have hlt := hMinN N (Nat.lt_succ_self N) Q hQEsc
 linarith
lemma zgy {N : ℕ} (P : Fin (N + 2) → V2)
  (hExt : ∀ k, ∃ u : V2, ∀ j ≠ k, dot2 (P j) u < dot2 (P k) u) :
  Function.Injective P := by
 intro i j hij
 by_contra hne
 obtain ⟨u, hu⟩ := hExt i
 have := hu j (Ne.symm hne)
 rw [hij] at this; linarith
lemma zbv {N : ℕ} (P : Fin (N + 2) → V2)
  (hExt : ∀ k, ∃ u : V2, ∀ j ≠ k, dot2 (P j) u < dot2 (P k) u)
  {a b c : Fin (N + 2)} (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
  zh (sub2 (P b) (P a)) (sub2 (P c) (P a)) ≠ 0 := by
 intro hzero
 have hba : sub2 (P b) (P a) ≠ (0, 0) := by
  intro h
  have heq : P b = P a := Prod.ext (by dsimp [sub2] at h; linarith [congrArg Prod.fst h])
                   (by dsimp [sub2] at h; linarith [congrArg Prod.snd h])
  exact hab (zgy P hExt heq).symm
 have hnorm : 0 < ze (sub2 (P b) (P a)) := by
  unfold ze
  by_contra hle; push Not at hle
  exact hba (Prod.ext (by nlinarith [sq_nonneg (sub2 (P b) (P a)).2])
            (by nlinarith [sq_nonneg (sub2 (P b) (P a)).1]))
 let t : ℝ := dot2 (sub2 (P c) (P a)) (sub2 (P b) (P a)) / ze (sub2 (P b) (P a))
 have hca : sub2 (P c) (P a) = zas t (sub2 (P b) (P a)) := by
  have hne := ne_of_gt hnorm
  apply Prod.ext
  ·
   dsimp [t, zas, dot2, ze, zh, sub2] at *
   field_simp [hne]; linear_combination -((P b).2 - (P a).2) * hzero
  ·
   dsimp [t, zas, dot2, ze, zh, sub2] at *
   field_simp [hne]; linear_combination ((P b).1 - (P a).1) * hzero
 have hrel_gen : ∀ u : V2, dot2 (P c) u - dot2 (P a) u = t * (dot2 (P b) u - dot2 (P a) u) := by
  intro u
  have h1 : (P c).1 - (P a).1 = t * ((P b).1 - (P a).1) := congrArg Prod.fst hca
  have h2 : (P c).2 - (P a).2 = t * ((P b).2 - (P a).2) := congrArg Prod.snd hca
  dsimp [dot2]
  linear_combination u.1 * h1 + u.2 * h2
 rcases le_or_gt t 0 with ht0 | ht0
 ·
  obtain ⟨u, hu⟩ := hExt a
  have hb := hu b hab.symm
  have hc := hu c hac.symm
  have hrel := hrel_gen u
  nlinarith
 ·
  rcases le_or_gt t 1 with ht1 | ht1
  ·
   obtain ⟨u, hu⟩ := hExt c
   have ha := hu a hac
   have hb := hu b hbc
   have hrel := hrel_gen u
   nlinarith
  ·
   obtain ⟨u, hu⟩ := hExt b
   have ha := hu a hab
   have hc := hu c hbc.symm
   have hrel := hrel_gen u
   nlinarith
def zaz {n : ℕ} (i j : Fin n) (hij : i.1 < j.1) (k : Fin (n + 1)) : Fin (n + 1) :=
 if h : i.1 + 1 ≤ k.1 ∧ k.1 ≤ j.1 then
  ⟨i.1 + 1 + j.1 - k.1, by omega⟩
 else k
lemma zhk {n : ℕ} (i j : Fin n) (hij : i.1 < j.1) (k : Fin (n + 1)) :
  zaz i j hij (zaz i j hij k) = k := by
 unfold zaz
 by_cases h : i.1 + 1 ≤ k.1 ∧ k.1 ≤ j.1
 · rw [dif_pos h, dif_pos (by simp; omega)]; ext; simp; omega
 · rw [dif_neg h, dif_neg h]
lemma zh2 {n : ℕ} (P : Fin (n + 1) → V2) (i j : Fin n) (hij : i.1 < j.1) (v : V2) :
  supp (fun k => P (zaz i j hij k)) v = supp P v := by
 apply le_antisymm
 · rw [supp, Finset.sup'_le_iff]; intro k _; exact zo P v _
 ·
  rw [supp, Finset.sup'_le_iff]; intro k _
  have h := zo (fun m => P (zaz i j hij m)) v (zaz i j hij k)
  rwa [zhk] at h
lemma zg6 {n : ℕ} (P : Fin (n + 1) → V2) (i j : Fin n) (hij : i.1 < j.1) :
  zp (fun k => P (zaz i j hij k)) +
   (zt (P i.castSucc) (P i.succ) + zt (P j.castSucc) (P j.succ)) =
  zp P +
   (zt (P i.castSucc) (P j.castSucc) + zt (P i.succ) (P j.succ)) := by
 unfold zp
 have hij_ne : i ≠ j := fun h => by rw [h] at hij; exact lt_irrefl _ hij
 rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
 have hj_mem : j ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨hij_ne.symm, Finset.mem_univ _⟩
 rw [← Finset.add_sum_erase _ _ hj_mem]
 conv_rhs =>
  rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
  rw [← Finset.add_sum_erase _ _ hj_mem]
 have hi_c : zaz i j hij i.castSucc = i.castSucc := by
  unfold zaz; rw [dif_neg]; simp
 have hi_s : zaz i j hij i.succ = j.castSucc := by
  unfold zaz; rw [dif_pos (by simp; omega)]; ext; simp
 have hj_c : zaz i j hij j.castSucc = i.succ := by
  unfold zaz; rw [dif_pos (by simp; omega)]; ext; simp
 have hj_s : zaz i j hij j.succ = j.succ := by
  unfold zaz; rw [dif_neg]; simp
 dsimp only
 rw [hi_c, hi_s, hj_c, hj_s]
