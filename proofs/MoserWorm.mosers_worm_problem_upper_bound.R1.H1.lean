lemma ze6 (a b : V2) (hne : a ≠ b) :
  ∃ cr sr : ℝ, cr ^ 2 + sr ^ 2 = 1 ∧
   rot2 cr sr (sub2 b a) = (zt a b, 0) ∧ 0 < zt a b := by
 have hd_pos : 0 < zt a b := by
  unfold zt zn ze; apply Real.sqrt_pos.mpr
  by_contra hle; push Not at hle
  have h1 : a.1 - b.1 = 0 := by nlinarith [sq_nonneg (a.1 - b.1), sq_nonneg (a.2 - b.2)]
  have h2 : a.2 - b.2 = 0 := by nlinarith [sq_nonneg (a.1 - b.1), sq_nonneg (a.2 - b.2)]
  exact hne (Prod.ext (by linarith) (by linarith))
 let L := zt a b
 let cr := (b.1 - a.1) / L
 let sr := -(b.2 - a.2) / L
 have hLsq : L ^ 2 = (b.1 - a.1) ^ 2 + (b.2 - a.2) ^ 2 := by
  dsimp [L, zt, zn, ze]
  rw [Real.sq_sqrt (by positivity)]; ring
 have hLne : L ≠ 0 := ne_of_gt hd_pos
 refine ⟨cr, sr, ?_, ?_, hd_pos⟩
 · dsimp [cr, sr]; field_simp [hLne]; linarith
 ·
  apply Prod.ext
  · dsimp [rot2, sub2, cr, sr]; field_simp [hLne]; linarith
  · dsimp [rot2, sub2, cr, sr]; field_simp [hLne]; ring
private lemma za7 (x m : ℕ) : (x % m + 1) % m = (x + 1) % m := by
 rw [Nat.add_mod (x % m) 1 m, Nat.mod_mod, ← Nat.add_mod]
lemma zhv (cr sr : ℝ) (fl : Bool) (sh u v : V2) :
  sub2 (zao cr sr fl sh u) (zao cr sr fl sh v) =
  if fl then zdp (rot2 cr sr (sub2 u v)) else rot2 cr sr (sub2 u v) := by
 cases fl <;> (apply Prod.ext <;> dsimp [zao, add2, sub2, zdp, rot2] <;> ring)
