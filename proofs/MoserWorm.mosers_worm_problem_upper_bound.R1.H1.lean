def zar (c : Cal1) : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ :=
 let s0 : ℤ := (c.k0 : ℤ) * STEP; let s1 : ℤ := (c.k1 : ℤ) * STEP
 let s2 : ℤ := (c.k2 : ℤ) * STEP; let s3 : ℤ := (c.k3 : ℤ) * STEP
 let s4 : ℤ := (c.k4 : ℤ) * STEP
 let rem : ℤ := zdj - (s0 + s1 + s2 + s3 + s4)
 let w0 := if c.idx == 0 then rem else s0
 let w1 := if c.idx == 1 then rem else s1
 let w2 := if c.idx == 2 then rem else s2
 let w3 := if c.idx == 3 then rem else s3
 let w4 := if c.idx == 4 then rem else s4
 (w0, w1, w2, w3, w4, (c.df : ℤ) * STEP, (c.nu : ℤ) * STEP)
def za2 (c : Cal2) : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ × ℤ :=
 let s0 : ℤ := (c.k0 : ℤ) * STEP; let s1 : ℤ := (c.k1 : ℤ) * STEP
 let s2 : ℤ := (c.k2 : ℤ) * STEP; let s3 : ℤ := (c.k3 : ℤ) * STEP
 let s4 : ℤ := (c.k4 : ℤ) * STEP; let s5 : ℤ := (c.k5 : ℤ) * STEP
 let rem : ℤ := zdj - (s0 + s1 + s2 + s3 + s4 + s5)
 let w0 := if c.idx == 0 then rem else s0
 let w1 := if c.idx == 1 then rem else s1
 let w2 := if c.idx == 2 then rem else s2
 let w3 := if c.idx == 3 then rem else s3
 let w4 := if c.idx == 4 then rem else s4
 let w5 := if c.idx == 5 then rem else s5
 (w0, w1, w2, w3, w4, w5, (c.df : ℤ) * STEP, (c.ru : ℤ) * STEP, (c.lw : ℤ) * STEP)
def zf8 (c : Cal1) : Bool :=
 let (w0, w1, w2, w3, w4, df, nu) := zar c
 c.idx < 5 && 0 ≤ w0 && 0 ≤ w1 && 0 ≤ w2 && 0 ≤ w3 && 0 ≤ w4 &&
 w0 + w1 + w2 + w3 + w4 == zdj &&
 0 ≤ df && df ≤ w0 + w1 && 0 ≤ nu && nu ≤ w4
def zf7 (c : Cal2) : Bool :=
 let (w0, w1, w2, w3, w4, w5, df, ru, lw) := za2 c
 c.idx < 6 && 0 ≤ w0 && 0 ≤ w1 && 0 ≤ w2 && 0 ≤ w3 && 0 ≤ w4 && 0 ≤ w5 &&
 w0 + w1 + w2 + w3 + w4 + w5 == zdj &&
 0 ≤ df && df ≤ w0 + w1 && 0 ≤ ru && ru ≤ w4 && 0 ≤ lw && lw ≤ w5
def zhu (A B : ℤ) (c : Cal1) : List Box :=
 let (w0, w1, w2, w3, w4, df, nu) := zar c
 let (cIv, sIv) := zhb A B
 [
  ((0, 0), zhs df),
  (zcp w2 (-zbp), zcp w2 (-zdy)),
  (zcp w3 (-zbp), zcp w3 (-zci)),
  (zdl w4 (-2 * C0Z) 0 cIv sIv, zdl w4 0 (-2 * C0Z) cIv sIv),
  (zcp w1 (-zbp), zcp w1 zci),
  (zcp w0 (-zbp), zcp w0 zdy),
  ((0, 0), zh8 (upIv w2) (upIv w3)),
  (zdl nu C0Z (-P0Z) cIv sIv, zdl nu P0Z C0Z cIv sIv),
  (zdl (w4 - nu) C0Z (-P0Z) cIv sIv, zdl (w4 - nu) P0Z C0Z cIv sIv),
  (zcp w1 zbp, zcp w1 zdy),
  (zcp w0 zbp, zcp w0 zci),
  (zcp w2 zbp, zcp w2 (-zci)),
  (zcp w3 zbp, zcp w3 (-zdy)),
  (zdl w4 C0Z P0Z cIv sIv, zdl w4 (-P0Z) C0Z cIv sIv),
  ((0, 0), zhs (w0 + w1 - df))
 ]
def zht (AR BR AL BL : ℤ) (c : Cal2) : List Box :=
 let (w0, w1, w2, w3, w4, w5, df, ru, lw) := za2 c
 let (cr, sr) := zhb AR BR
 let (cl, sl) := zhb AL BL
 [
  ((0, 0), zhs df),
  (zdl w5 (-C0Z) (-P0Z) cl sl, zdl w5 (-P0Z) C0Z cl sl),
  (zcp w2 (-zbp), zcp w2 (-zdy)),
  (zcp w3 (-zbp), zcp w3 (-zci)),
  (zdl w4 (-2 * C0Z) 0 cr sr, zdl w4 0 (-2 * C0Z) cr sr),
  (zcp w1 (-zbp), zcp w1 zci),
  (zcp w0 (-zbp), zcp w0 zdy),
  (zdl lw (-C0Z) P0Z cl sl, zdl lw P0Z C0Z cl sl),
  (zdl (w5 - lw) (-C0Z) P0Z cl sl, zdl (w5 - lw) P0Z C0Z cl sl),
  ((0, 0), zh8 (upIv w2) (upIv w3)),
  (zdl ru C0Z (-P0Z) cr sr, zdl ru P0Z C0Z cr sr),
  (zdl (w4 - ru) C0Z (-P0Z) cr sr, zdl (w4 - ru) P0Z C0Z cr sr),
  (zcp w1 zbp, zcp w1 zdy),
  (zcp w0 zbp, zcp w0 zci),
  (zdl w5 (2 * C0Z) 0 cl sl, zdl w5 0 (-2 * C0Z) cl sl),
  (zcp w2 zbp, zcp w2 (-zci)),
  (zcp w3 zbp, zcp w3 (-zdy)),
  (zdl w4 C0Z P0Z cr sr, zdl w4 (-P0Z) C0Z cr sr),
  ((0, 0), zhs (w0 + w1 - df))
 ]
def zav (at_ : List Box) (lo hi : Nat) (skip : Nat → Nat → Bool) : Bool :=
 let rec loopL (l : Nat) (fuelL : Nat) : Bool :=
  match fuelL with
  | 0 => true
  | fuelL' + 1 =>
   let rec loopR (r : Nat) (acc : Box) (fuelR : Nat) : Bool :=
    match fuelR with
    | 0 => true
    | fuelR' + 1 =>
     let acc' := zeo acc (at_.getD r ((0, 0), (0, 0)))
     if !skip l r && !(zb1 acc' < zfy) then false
     else loopR (r + 1) acc' fuelR'
   if loopR l ((0, 0), (0, 0)) (hi + 1 - l) then loopL (l + 1) fuelL' else false
 loopL lo (hi + 1 - lo)
def zfr (at_ : List Box) (lo hi : Nat) : Box :=
 let rec go (i : Nat) (acc : Box) (fuel : Nat) : Box :=
  match fuel with
  | 0 => acc
  | fuel' + 1 => go (i + 1) (zeo acc (at_.getD i ((0, 0), (0, 0)))) fuel'
 go lo ((0, 0), (0, 0)) (hi + 1 - lo)
def zcb (at_ : List Box) (lo hi last : Nat) (skip : Nat → Bool) : Bool :=
 let base := zfr at_ (hi + 1) last
 let rec go (l : Nat) (acc : Box) (fuel : Nat) : Bool :=
  match fuel with
  | 0 => true
  | fuel' + 1 =>
   let acc' := zeo acc (at_.getD l ((0, 0), (0, 0)))
   if !skip l && !(zb1 acc' < zfy) then false
   else go (l - 1) acc' fuel'
 go hi base (hi + 1 - lo)
def zhy (A B : ℤ) (c : Cal1) (constr : List (Nat × Nat)) : Bool :=
 if !zf8 c then false
 else
  let at_ := zhu A B c
  let skip1 (l r : Nat) : Bool := constr.any fun (p, q) => !(l ≤ p && p ≤ r) && (l ≤ q && q ≤ r)
  let skip2 (l : Nat) : Bool := constr.any fun (p, q) => l ≤ p && q < l
  let skip3 (l r : Nat) : Bool := constr.any fun (p, q) => (l ≤ p && p ≤ r) && !(l ≤ q && q ≤ r)
  zav at_ 1 4 skip1 &&
  zcb at_ 1 8 14 skip2 &&
  zav at_ 8 13 skip3
def zgr (AR BR AL BL : ℤ) (c : Cal2) : Bool :=
 if !zf7 c then false
 else
  let at_ := zht AR BR AL BL c
  zav at_ 1 7 (fun _ _ => false) &&
  zcb at_ 8 11 18 (fun _ => false) &&
  zav at_ 11 17 (fun _ _ => false)
inductive CalTree1
 | L (c : Cal1)
 | S (p q : Nat) (l r : CalTree1)
inductive BinTree1
 | L (t : CalTree1)
 | B (l r : BinTree1)
inductive QuadTree2
 | K
 | L (c : Cal2)
 | Q (q00 q01 q10 q11 : QuadTree2)
def zfs (A B : ℤ) (constr : List (Nat × Nat)) : CalTree1 → Bool
 | .L c => zhy A B c constr
 | .S p q l r => p < 15 && q < 15 && zfs A B ((p, q) :: constr) l && zfs A B ((q, p) :: constr) r
def zay (A B : ℤ) : BinTree1 → Bool
 | .L t => zfs A B [] t
 | .B l r =>
  let M := (A + B) / 2
  2 * M == A + B && zay A M l && zay M B r
def zw (AR BR AL BL : ℤ) : QuadTree2 → Bool
 | .K => BL ≤ AR
 | .L c => zgr AR BR AL BL c
 | .Q q00 q01 q10 q11 =>
  let MR := (AR + BR) / 2
  let ML := (AL + BL) / 2
  2 * MR == AR + BR && 2 * ML == AL + BL &&
  zw AR MR AL ML q00 &&
  zw AR MR ML BL q01 &&
  zw MR BR AL ML q10 &&
  zw MR BR ML BL q11
private abbrev l1 (a b c d e f g h : Nat) : BinTree1 := .L (.L ⟨a,b,c,d,e,f,g,h⟩)
private abbrev s8 (a b c d e f g : Nat) : BinTree1 := .L (.S 8 13 (.L ⟨4,a,b,0,0,0,c,d⟩) (.L ⟨4,e,0,0,0,0,f,g⟩))
private abbrev u1 (a b c d e : Nat) : QuadTree2 := .L ⟨1,a,0,b,0,c,d,e,c,0⟩
private abbrev u4 (a b c d e f : Nat) : QuadTree2 := .L ⟨4,a,b,0,0,0,c,d,e,f⟩
private abbrev u2 (a b c d e f g h i j : Nat) : QuadTree2 := .L ⟨a,b,c,d,e,f,g,h,i,j⟩
private lemma qB {A B M : ℤ} {l r : BinTree1} (hl : zay A M l = true) (hr : zay M B r = true)
  (hM : (A + B) / 2 = M := by decide) (h2 : 2 * M = A + B := by decide) :
  zay A B (.B l r) = true := by simp [zay, hM, h2, hl, hr]
private lemma qK {AR BR AL BL : ℤ} (h : BL ≤ AR := by decide) :
  zw AR BR AL BL .K = true := by simp [zw, h]
private lemma qQ {AR BR AL BL MR ML : ℤ} {a b c d : QuadTree2}
  (ha : zw AR MR AL ML a = true) (hb : zw AR MR ML BL b = true)
  (hc : zw MR BR AL ML c = true) (hd : zw MR BR ML BL d = true)
  (hMR : (AR + BR) / 2 = MR := by decide) (hML : (AL + BL) / 2 = ML := by decide)
  (h2R : 2 * MR = AR + BR := by decide) (h2L : 2 * ML = AL + BL := by decide) :
  zw AR BR AL BL (.Q a b c d) = true := by
 simp [zw, hMR, hML, h2R, h2L, ha, hb, hc, hd]
