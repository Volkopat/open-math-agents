  ·
   have hmod : (a.1 + (m + 1) - d) % (m + 1) = a.1 + (m + 1) - d := Nat.mod_eq_of_lt (by omega)
   rw [hmod]
   have : a.1 + (m + 1) - d + (m + 1) - a.1 = (m + 1 - d) + (m + 1) := by omega
