   0 < det3 (P (e T)) (P (e F)) (P (e vM)) ∧
   ∀ s : Fin (m + 1), det3 (P (e T)) (P (e F)) (P (e s)) ≤ det3 (P (e T)) (P (e F)) (P (e vM))) := by
