    acc (zbk : ℝ) →
   zcb.go at_ skip cur acc fuel = true →
   ∀ l : ℕ, cur + 1 - fuel ≤ l → l ≤ cur → skip l = false →
    ze (∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ last), (v k).1,
         ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ last), (v k).2) ≤ 1 := by
  intro fuel
