 ·
  rw [zam hab, zam hbc, zam hac]
  rw [show b.1 - a.1 + (c.1 - b.1) = c.1 - a.1 by omega, Nat.mod_eq_of_lt (by omega)]
 · omega
 ·
  rw [zam hab, zal (by omega), zam hac]
  rw [show b.1 - a.1 + (c.1 + m - b.1) = (c.1 - a.1) + m by omega, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
 ·
  rw [zam hab, zal (by omega), zal (by omega)]
  rw [show b.1 - a.1 + (c.1 + m - b.1) = c.1 + m - a.1 by omega, Nat.mod_eq_of_lt (by omega)]
 ·
  rw [zal (by omega), zam hbc, zam hac]
  rw [show b.1 + m - a.1 + (c.1 - b.1) = (c.1 - a.1) + m by omega, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
 ·
  rw [zal (by omega), zam hbc, zal (by omega)]
  rw [show b.1 + m - a.1 + (c.1 - b.1) = c.1 + m - a.1 by omega, Nat.mod_eq_of_lt (by omega)]
 · omega
 ·
  rw [zal (by omega), zal (by omega), zal (by omega)]
  rw [show b.1 + m - a.1 + (c.1 + m - b.1) = (c.1 + m - a.1) + m by omega, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
lemma zd5 : ∀ (m : ℕ) (V : Fin m → V2),
  zae m V →
  (∀ i : Fin m, ∃ u : V2, ∀ j : Fin m, j ≠ i → dot2 (V j) u < dot2 (V i) u) →
  ∀ a b c : Fin m, a < b → b < c → 0 < det3 (V a) (V b) (V c) := by
 intro m
 induction m with
 | zero => intro V hC; exact absurd hC.hm (by omega)
 | succ m' ih =>
  intro V hC hExt a b c hab hbc
  by_cases hm3 : m' + 1 = 3
  ·
   have hab' : a.1 < b.1 := hab
   have hbc' : b.1 < c.1 := hbc
   have hc' : c.1 < m' + 1 := c.2
   have ha0 : a = ⟨0, by omega⟩ := Fin.ext (by dsimp; omega)
   have hb1 : b = ⟨1, by omega⟩ := Fin.ext (by dsimp; omega)
   have hc2 : c = ⟨2, by omega⟩ := Fin.ext (by dsimp; omega)
