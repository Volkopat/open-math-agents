lemma zgf {m : ℕ} {P : Fin (m + 1) → V2} {W : Fin (m + 1) ≃ Fin (m + 1)}
  (hW : zbe m (P ∘ W)) :
  let P' : Fin (m + 1) → V2 := fun i => zaa (P i.rev)
  let W' : Fin (m + 1) ≃ Fin (m + 1) :=
   (Fin.revPerm.trans W).trans Fin.revPerm
  zbe m (P' ∘ W') := by
 intro P' W'
 have hcomp : ∀ k : Fin (m + 1), (P' ∘ W') k = zaa (P (W k.rev)) := fun k => by
  simp [P', W']
 refine ⟨hW.hm, ?_, ?_, ?_, ?_, ?_⟩
 · rw [hcomp, Fin.rev_zero]; simpa [zaa] using hW.hym
 · rw [hcomp, Fin.rev_last]; simpa [zaa] using hW.hy0
 ·
  rw [hcomp, hcomp, Fin.rev_zero, Fin.rev_last]
  have h := hW.hx; dsimp [Function.comp, zaa] at h ⊢; linarith
 · intro k; rw [hcomp]; simpa [zaa] using hW.hy_nn k.rev
 ·
  intro j k hk1 hk2
  rw [hcomp, hcomp, hcomp]
  let j' : Fin m := j.rev
  have h1 : j.castSucc.rev = j'.succ := by ext; simp [j', Fin.rev]; omega
  have h2 : j.succ.rev = j'.castSucc := by ext; simp [j', Fin.rev]
  rw [h1, h2]
  have hne1 : k.rev ≠ j'.castSucc := fun h => hk2 (Fin.rev_injective (by rw [h, h2]))
  have hne2 : k.rev ≠ j'.succ := fun h => hk1 (Fin.rev_injective (by rw [h, h1]))
  have hlt := hW.strict_right j' k.rev hne1 hne2
  dsimp [Function.comp, zh, sub2, zaa] at hlt ⊢
  linarith
