       ·
        have hcs : (zg r).1 = 0 := by dsimp [zg]; rw [show r.1 + 1 = m' by omega, Nat.mod_self]
        by_cases hd0 : d.1 = 0
        · rw [hr_val, hd0]; simp [Nat.mod_eq_of_lt (by omega : m' < m' + 1)]; omega
        ·
         exfalso; apply hsame; ext
