 ·
  rw [ha]
  have h1 : (0 + m - 1) % m = m - 1 := by simp [Nat.mod_eq_of_lt (by omega : m - 1 < m)]
  rw [h1]
  have h2 : b.1 + m - (m - 1) = b.1 + 1 := by omega
  have h3 : b.1 + m - 0 = b.1 + m := by omega
