  have e2 : (((1 - t) * (P j.castSucc).1 + t * (P j.succ).1) - (P j.succ).1) ^ 2 +
       (((1 - t) * (P j.castSucc).2 + t * (P j.succ).2) - (P j.succ).2) ^ 2 =
