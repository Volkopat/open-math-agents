   have hQP_esc : z5 QP :=
    zd9 hMin.1 (fun u => (hQE_supp u).trans (hQP_supp u))
   have hQP_lt : zp P < zp QP := hMin.2.2 (iL1.1 + 1) (by omega) QP hQP_esc
   have hQP_len : zp QP = zac P 0 iL1 + zt (P iL1) Pf := zes P iL1 Pf
   have hd_Pf : zt (P iL1) Pf = y1 := by
    unfold zt zn ze Pf
    rw [sub_self, zero_pow two_ne_zero, zero_add, sub_zero]
    exact Real.sqrt_sq hy1_pos.le
