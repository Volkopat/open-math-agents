private lemma zgt {m : ℕ} (v : Fin m → V2) (at_ : List Box)
  (hv : ∀ k : Fin m, zek (v k) (at_.getD k.1 ((0, 0), (0, 0))) (zbk : ℝ)) :
  ∀ (fuel i : ℕ) (acc : Box) (u : V2),
   i + fuel ≤ m →
   zek u acc (zbk : ℝ) →
   zek (u.1 + ∑ k ∈ Finset.univ.filter (fun k : Fin m => i ≤ k.1 ∧ k.1 < i + fuel), (v k).1,
       u.2 + ∑ k ∈ Finset.univ.filter (fun k : Fin m => i ≤ k.1 ∧ k.1 < i + fuel), (v k).2)
    (zfr.go at_ i acc fuel) (zbk : ℝ) := by
 intro fuel
 induction fuel with
 | zero =>
  intro i acc u _ hu
  have hfilt : Finset.univ.filter (fun k : Fin m => i ≤ k.1 ∧ k.1 < i + 0) = ∅ := by
   ext k; simp
  rw [hfilt, Finset.sum_empty]
  simpa [zfr.go] using hu
 | succ fuel' ih =>
  intro i acc u hbound hu
  have hi : i < m := by omega
  let k0 : Fin m := ⟨i, hi⟩
  have hacc' : zek (u.1 + (v k0).1, u.2 + (v k0).2)
    (zeo acc (at_.getD i ((0, 0), (0, 0)))) (zbk : ℝ) :=
   zfi hu (hv k0)
  have hih := ih (i + 1) (zeo acc (at_.getD i ((0, 0), (0, 0))))
   (u.1 + (v k0).1, u.2 + (v k0).2) (by omega) hacc'
  have hfilt : Finset.univ.filter (fun k : Fin m => i ≤ k.1 ∧ k.1 < i + (fuel' + 1)) =
    insert k0 (Finset.univ.filter (fun k : Fin m => i + 1 ≤ k.1 ∧ k.1 < i + 1 + fuel')) := by
   ext k; simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.ext_iff]
   dsimp [k0]; omega
  have hnot : k0 ∉ Finset.univ.filter (fun k : Fin m => i + 1 ≤ k.1 ∧ k.1 < i + 1 + fuel') := by
   simp [k0]
  rw [hfilt, Finset.sum_insert hnot, Finset.sum_insert hnot]
  have hadd1 : u.1 + ((v k0).1 + ∑ k ∈ Finset.univ.filter (fun k : Fin m => i + 1 ≤ k.1 ∧ k.1 < i + 1 + fuel'), (v k).1) =
    u.1 + (v k0).1 + ∑ k ∈ Finset.univ.filter (fun k : Fin m => i + 1 ≤ k.1 ∧ k.1 < i + 1 + fuel'), (v k).1 := by ring
  have hadd2 : u.2 + ((v k0).2 + ∑ k ∈ Finset.univ.filter (fun k : Fin m => i + 1 ≤ k.1 ∧ k.1 < i + 1 + fuel'), (v k).2) =
    u.2 + (v k0).2 + ∑ k ∈ Finset.univ.filter (fun k : Fin m => i + 1 ≤ k.1 ∧ k.1 < i + 1 + fuel'), (v k).2 := by ring
  rw [hadd1, hadd2]
  exact hih
private lemma zdv {m : ℕ} (v : Fin m → V2) (at_ : List Box)
  (skip : Nat → Nat → Bool)
  (hv : ∀ k : Fin m, zek (v k) (at_.getD k.1 ((0, 0), (0, 0))) (zbk : ℝ))
  (l : ℕ) :
  ∀ (fuelR r : ℕ) (acc : Box),
   l ≤ r → r + fuelR ≤ m →
   zek (∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r), (v k).1,
       ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r), (v k).2) acc (zbk : ℝ) →
   zav.loopL.loopR at_ skip l r acc fuelR = true →
   ∀ j : ℕ, r ≤ j → j < r + fuelR → skip l j = false →
    ze (∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ j), (v k).1,
         ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ j), (v k).2) ≤ 1 := by
 intro fuelR
 induction fuelR with
 | zero => intro r acc _ _ _ _ j hj1 hj2; omega
 | succ fuelR' ih =>
  intro r acc hlr hrm hacc hok j hj1 hj2 hskip
  have hr : r < m := by omega
  let kr : Fin m := ⟨r, hr⟩
  have hfilt_next : Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r + 1) =
    insert kr (Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r)) := by
   ext k; simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.ext_iff]
   dsimp [kr]; omega
  have hnot : kr ∉ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r) := by simp [kr]
  have hacc' : zek
    (∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r + 1), (v k).1,
     ∑ k ∈ Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r + 1), (v k).2)
    (zeo acc (at_.getD r ((0, 0), (0, 0)))) (zbk : ℝ) := by
   rw [hfilt_next, Finset.sum_insert hnot, Finset.sum_insert hnot]
   have htmp := zfi hacc (hv kr)
   simpa [add_comm] using htmp
  unfold zav.loopL.loopR at hok
  dsimp only at hok
  cases hbad : (!skip l r && !(zb1 (zeo acc (at_.getD r ((0, 0), (0, 0)))) < zfy))
  ·
   rw [hbad] at hok
   rcases eq_or_lt_of_le hj1 with rfl | hlt
   ·
    have hlt_norm : zb1 (zeo acc (at_.getD r ((0, 0), (0, 0)))) < zfy := by
     simp only [hskip, Bool.not_false, Bool.true_and, Bool.not_eq_false', decide_eq_true_eq] at hbad
     exact hbad
    have hfilt_eq : Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 ≤ r) =
      Finset.univ.filter (fun k : Fin m => l ≤ k.1 ∧ k.1 < r + 1) := by
     ext k; simp only [Finset.mem_filter, Finset.mem_univ, true_and]; omega
    rw [hfilt_eq]
    exact zet hacc' hlt_norm
   · exact ih (r + 1) _ (by omega) (by omega) hacc' (by simpa using hok) j (by omega) (by omega) hskip
  · rw [hbad] at hok; simp at hok
lemma zbo {m : ℕ} (v : Fin m → V2) (at_ : List Box)
  (lo hi : ℕ) (skip : Nat → Nat → Bool)
  (hv : ∀ k : Fin m, zek (v k) (at_.getD k.1 ((0, 0), (0, 0))) (zbk : ℝ))
  (hhi : hi < m)
