    have h1 : y1 ≤ zac P iL1 iT := by
     have := hVert hL1_lt_T.le; rw [hT_y, zero_sub, abs_neg, abs_of_pos hy1_pos] at this; exact this
    have h2 : zac P iL1 iT + zac P iT (Fin.last m) = zac P iL1 (Fin.last m) :=
