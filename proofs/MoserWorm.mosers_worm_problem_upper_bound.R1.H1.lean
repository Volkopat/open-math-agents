  ·
   have hm4 : 4 ≤ m' + 1 := by have := hC.hm; omega
   have hex_d : ∃ d : Fin (m' + 1), d ≠ a ∧ d ≠ b ∧ d ≠ c := by
    by_contra hall; push Not at hall
    have hsub : (Finset.univ : Finset (Fin (m' + 1))) ⊆ {a, b, c} := by
     intro x _
