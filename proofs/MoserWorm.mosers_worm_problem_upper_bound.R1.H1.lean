lemma zct {m : ℕ} (V : Fin (m + 1) → V2)
  (hC : zae (m + 1) V)
  (vM : Fin (m + 1)) (u : V2)
  (hPred : dot2 (V (zaf vM)) u ≤ dot2 (V vM) u)
  (hSucc : dot2 (V (zg vM)) u ≤ dot2 (V vM) u) :
  ∀ s : Fin (m + 1), dot2 (V s) u ≤ dot2 (V vM) u := by
 have hm3 : 3 ≤ m + 1 := hC.hm
 have hsp : zg (zaf vM) = vM := by
  ext; dsimp [zg, zaf]
  have hv : vM.1 < m + 1 := vM.2
  by_cases h0 : vM.1 = 0
  · rw [h0]; simp [Nat.mod_eq_of_lt (by omega : m < m + 1)]
  ·
   have h1 : (vM.1 + m) % (m + 1) = vM.1 - 1 := by
    have : vM.1 + m = (vM.1 - 1) + (m + 1) := by omega
    rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
   rw [h1, Nat.sub_add_cancel (by omega), Nat.mod_eq_of_lt hv]
 have hne_pc : zg vM ≠ zaf vM := by
  intro h; have := congrArg Fin.val h; dsimp [zg, zaf] at this
  have hv : vM.1 < m + 1 := vM.2
  by_cases h0 : vM.1 = 0
  · rw [h0] at this; simp [Nat.mod_eq_of_lt (by omega : 1 < m + 1), Nat.mod_eq_of_lt (by omega : m < m + 1)] at this; omega
  ·
   have h1 : (vM.1 + m) % (m + 1) = vM.1 - 1 := by
    have : vM.1 + m = (vM.1 - 1) + (m + 1) := by omega
    rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
   rw [h1] at this
   by_cases h2 : vM.1 + 1 < m + 1
   · rw [Nat.mod_eq_of_lt h2] at this; omega
   ·
    have h2' : vM.1 + 1 = m + 1 := by omega
    rw [h2', Nat.mod_self] at this; omega
 have hne_cm : zg vM ≠ vM := by
  intro h; have := congrArg Fin.val h; dsimp [zg] at this
  have hv : vM.1 < m + 1 := vM.2
  by_cases h2 : vM.1 + 1 < m + 1
  · rw [Nat.mod_eq_of_lt h2] at this; omega
  ·
   have h2' : vM.1 + 1 = m + 1 := by omega
   rw [h2', Nat.mod_self] at this; omega
 intro s
 by_cases hsM : s = vM
 · rw [hsM]
 by_cases hsP : s = zaf vM
 · rw [hsP]; exact hPred
 by_cases hsC : s = zg vM
 · rw [hsC]; exact hSucc
 set A := V (zaf vM); set B := V vM; set C := V (zg vM); set S := V s
 have hD : 0 < det3 A B C := by
  have h := hC.strict_left (zaf vM) (zg vM) hne_pc (by rw [hsp]; exact hne_cm)
  rw [hsp] at h; exact h
 have hABS : 0 < det3 A B S := by
  have h := hC.strict_left (zaf vM) s hsP (by rw [hsp]; exact hsM)
  rw [hsp] at h; exact h
 have hBCS : 0 < det3 B C S := hC.strict_left vM s hsM hsC
 set D := det3 A B C
 let lam := det3 B C S / D
 let mu := det3 A B S / D
 have hlam : 0 < lam := div_pos hBCS hD
 have hmu : 0 < mu := div_pos hABS hD
 have hDne : D ≠ 0 := ne_of_gt hD
 have hx : S.1 - B.1 = lam * (A.1 - B.1) + mu * (C.1 - B.1) := by
  dsimp [lam, mu]; field_simp [hDne]; dsimp [D, det3, zh, sub2]; ring
 have hy : S.2 - B.2 = lam * (A.2 - B.2) + mu * (C.2 - B.2) := by
  dsimp [lam, mu]; field_simp [hDne]; dsimp [D, det3, zh, sub2]; ring
 have hdot : dot2 S u - dot2 B u = lam * (dot2 A u - dot2 B u) + mu * (dot2 C u - dot2 B u) := by
  unfold dot2
  calc S.1 * u.1 + S.2 * u.2 - (B.1 * u.1 + B.2 * u.2)
    = (S.1 - B.1) * u.1 + (S.2 - B.2) * u.2 := by ring
   _ = (lam * (A.1 - B.1) + mu * (C.1 - B.1)) * u.1 + (lam * (A.2 - B.2) + mu * (C.2 - B.2)) * u.2 := by
     rw [hx, hy]
   _ = lam * (A.1 * u.1 + A.2 * u.2 - (B.1 * u.1 + B.2 * u.2)) +
     mu * (C.1 * u.1 + C.2 * u.2 - (B.1 * u.1 + B.2 * u.2)) := by ring
 nlinarith only [hdot, hlam, hmu, hPred, hSucc]
lemma za5 {u v : V2} (hu : 0 < zn u + u.1) (hv : 0 < zn v + v.1) :
  let nu := zn u; let nv := zn v
  zh u v =
   (nu + u.1) * (nv + v.1) * (z7 v - z7 u) * (1 + z7 u * z7 v) / 2 := by
 intro nu nv
 have hnu_sq : nu ^ 2 = u.1 ^ 2 + u.2 ^ 2 := Real.sq_sqrt (by unfold ze; positivity)
 have hnv_sq : nv ^ 2 = v.1 ^ 2 + v.2 ^ 2 := Real.sq_sqrt (by unfold ze; positivity)
 have hu_ne : nu + u.1 ≠ 0 := ne_of_gt hu
 have hv_ne : nv + v.1 ≠ 0 := ne_of_gt hv
 have hu1 : 2 * u.1 = (1 - z7 u ^ 2) * (nu + u.1) := by
  dsimp [z7, nu] at hu_ne hnu_sq ⊢; field_simp [hu_ne]; nlinarith only [hnu_sq]
 have hu2 : u.2 = z7 u * (nu + u.1) := by
  dsimp [z7, nu] at hu_ne ⊢; field_simp [hu_ne]
 have hv1 : 2 * v.1 = (1 - z7 v ^ 2) * (nv + v.1) := by
  dsimp [z7, nv] at hv_ne hnv_sq ⊢; field_simp [hv_ne]; nlinarith only [hnv_sq]
 have hv2 : v.2 = z7 v * (nv + v.1) := by
  dsimp [z7, nv] at hv_ne ⊢; field_simp [hv_ne]
 unfold zh
 linear_combination (v.2 / 2) * hu1 - (u.2 / 2) * hv1 +
  ((1 - z7 u ^ 2) * (nu + u.1) / 2) * hv2 -
  ((1 - z7 v ^ 2) * (nv + v.1) / 2) * hu2
lemma zc9 {u v : V2}
  (hu : 0 < zn u + u.1) (hv : 0 < zn v + v.1)
  (hcr : 0 < zh u v) (hno : ¬ (0 < u.2 ∧ v.2 < 0)) :
  z7 u < z7 v := by
 have hid := za5 hu hv
 have hprod : 0 < (z7 v - z7 u) * (1 + z7 u * z7 v) := by
  have hden : 0 < (zn u + u.1) * (zn v + v.1) / 2 := by positivity
  nlinarith only [hid, hcr, hden]
 by_contra hle; push Not at hle
 have hdiff : z7 v - z7 u ≤ 0 := by linarith
 have h1ab : 1 + z7 u * z7 v < 0 := by nlinarith only [hprod, hdiff]
 have hneg : z7 u * z7 v < 0 := by linarith
 have hsu : 0 < z7 u := by nlinarith only [hneg, hle]
 have hsv : z7 v < 0 := by nlinarith only [hneg, hle]
 have hu2 : 0 < u.2 := by
  unfold z7 at hsu; exact (div_pos_iff_of_pos_right hu).mp hsu
 have hv2 : v.2 < 0 := by
  unfold z7 at hsv
  by_contra hge; push Not at hge
  exact not_le_of_gt hsv (div_nonneg hge hv.le)
 exact hno ⟨hu2, hv2⟩
