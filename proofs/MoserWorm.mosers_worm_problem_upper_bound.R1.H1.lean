  have h1 : (a.1 + m - 1) % m = a.1 - 1 := by
   have : a.1 + m - 1 = (a.1 - 1) + m := by omega
   rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
  rw [h1]
  have h2 : b.1 + m - (a.1 - 1) = (b.1 + m - a.1) + 1 := by omega
  rw [h2, Nat.add_mod (b.1 + m - a.1) 1 m, Nat.add_mod ((b.1 + m - a.1) % m) 1 m,
   Nat.mod_mod (b.1 + m - a.1) m]
lemma zcr {m : ℕ} (a b c : Fin m) (h : zc a b = zc a c) : b = c := by
 ext
 by_cases hab : a.1 ≤ b.1 <;> by_cases hac : a.1 ≤ c.1
 · rw [zam hab, zam hac] at h; omega
 · rw [zam hab, zal (by omega)] at h; omega
 · rw [zal (by omega), zam hac] at h; omega
 · rw [zal (by omega), zal (by omega)] at h; omega
lemma za0 {m : ℕ} (a b c : Fin m) :
