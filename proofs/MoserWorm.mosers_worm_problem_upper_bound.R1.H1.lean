 conv_lhs => rw [this]
 rw [Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
lemma zbi {m : ℕ} (a b : Fin m) :
  zc a (zg b) = (zc a b + 1) % m := by
 have hm : 0 < m := Nat.pos_of_ne_zero (by intro h; subst h; exact Fin.elim0 a)
