def multiplier (n : ℕ) : ℕ :=
  ((blocks.getD ((n - 2) / 100) 0) >>> (7 * ((n - 2) % 100))) % 128

/-- A common factor with 1000! detects every possible small divisor in this range. -/
def isPrimeCert (p : ℕ) : Bool :=
  if p ≤ 1000 then trialPrime p else
    decide (p ≤ 1000000 ∧ p.gcd (Nat.factorial 1000) = 1)

theorem prime_of_cert {p : ℕ} (h : isPrimeCert p = true) : p.Prime := by
  unfold isPrimeCert at h
  split at h
  · exact prime_of_trial h
  · obtain ⟨hmax, hg⟩ := of_decide_eq_true h
    apply Nat.prime_def_le_sqrt.mpr
    refine ⟨by omega, ?_⟩
    intro d hd hs hdp
    have hsq := Nat.le_sqrt.mp hs
    have hsmall : d ≤ 1000 := by nlinarith
    have hdf := Nat.dvd_factorial (by omega : 0 < d) hsmall
    have hgcd := Nat.dvd_gcd hdp hdf
    rw [hg, Nat.dvd_one] at hgcd
    omega

def hasWitness (n : ℕ) : Bool :=
  let p := n * multiplier n + 1
  decide (p < n ^ 2) && isPrimeCert p

theorem bound_of_witness {n : ℕ} (h : hasWitness n = true) :
    OeisA34694.a n < n ^ 2 := by
  simp only [hasWitness, Bool.and_eq_true, decide_eq_true_eq] at h
  apply lt_of_le_of_lt _ h.1
  apply Nat.sInf_le
  exact ⟨prime_of_cert h.2, ⟨multiplier n, by simp⟩⟩

end OMA.SmallPrime


set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
theorem OMA.solution : OMA.R_OeisA34694_conjecture_R1.H1 := by
  intro n hn htop
  apply OMA.SmallPrime.bound_of_witness
  let block := (n - 2) / 100
  have hb : block ≤ 99 := by dsimp [block]; omega
  have check : ((List.range' (2 + 100 * block) 100).all OMA.SmallPrime.hasWitness) = true := by
    generalize block = b at hb ⊢
    interval_cases b <;> decide +kernel
  apply List.all_eq_true.mp check
  simp only [List.mem_range'_1]
  dsimp [block]
  omega
