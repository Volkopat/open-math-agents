import OMAReductions.R_Arxiv_0805_3777_isGenericRank_of_le_critical_R1_H2_R1_H2_R1
import Mathlib

namespace OMA.TangentSquareWitness

open Matrix Finset

def bitValue (R : Type*) [Zero R] [One R] (b : Bool) : R := if b then 1 else 0

theorem castBit (R : Type*) [Ring R] (b : Bool) :
    ((bitValue ℤ b : ℤ) : R) = bitValue R b := by
  cases b <;> simp [bitValue]

theorem xorBit (a b : Bool) :
    bitValue (ZMod 2) (a ^^ b) = bitValue (ZMod 2) a + bitValue (ZMod 2) b := by
  cases a <;> cases b <;> decide +kernel

def multiply (col : ℕ → ℕ) (word : ℕ) : ℕ → ℕ
  | 0 => 0
  | i + 1 => multiply col word i ^^^ (if word.testBit i then col i else 0)

theorem multiplyBit (col : ℕ → ℕ) (word row n : ℕ) :
    bitValue (ZMod 2) ((multiply col word n).testBit row) =
      ∑ j ∈ range n, bitValue (ZMod 2) ((col j).testBit row) *
        bitValue (ZMod 2) (word.testBit j) := by
  induction n with
  | zero => simp [multiply, bitValue]
  | succ n ih =>
      rw [multiply, Nat.testBit_xor, xorBit, ih, Finset.sum_range_succ]
      cases h : word.testBit n <;> simp [bitValue]

def pack (pred : ℕ → Bool) (i : ℕ) : ℕ → ℕ
  | 0 => 0
  | n + 1 => Nat.bit (pred i) (pack pred (i + 1) n)

theorem packBit (p : ℕ → Bool) (offset n i : ℕ) (hi : i < n) :
    (pack p offset n).testBit i = p (offset + i) := by
  induction n generalizing offset i with
  | zero => omega
  | succ n ih =>
      cases i with
      | zero => rw [pack, Nat.testBit_bit_zero, Nat.add_zero]
      | succ i =>
          rw [pack, Nat.testBit_bit_succ, ih (offset + 1) i (by omega)]
          congr 1
          omega

def intA (col : ℕ → ℕ) : Matrix (Fin 448) (Fin 506) ℤ :=
  Matrix.of fun i j => bitValue ℤ ((col j.val).testBit i.val)

def intB (inv : ℕ → ℕ) : Matrix (Fin 506) (Fin 448) ℤ :=
  Matrix.of fun i j => bitValue ℤ ((inv j.val).testBit i.val)

theorem productModTwo (col inv : ℕ → ℕ)
    (certificate : ∀ j : Fin 448, multiply col (inv j.val) 506 = 1 <<< j.val) :
    (intA col * intB inv).map (fun z : ℤ => (z : ZMod 2)) = 1 := by
  ext i j
  simp only [Matrix.map_apply, Matrix.mul_apply, Int.cast_sum, Int.cast_mul,
    intA, intB, Matrix.of_apply, castBit, Matrix.one_apply]
  rw [Fin.sum_univ_eq_sum_range (fun x : ℕ =>
    bitValue (ZMod 2) ((col x).testBit i.val) *
      bitValue (ZMod 2) ((inv j.val).testBit x))]
  rw [← multiplyBit, certificate j, Nat.one_shiftLeft, Nat.testBit_two_pow]
  by_cases h : i = j
  · subst j
    simp [bitValue]
  · have hn : j.val ≠ i.val := fun e => h (Fin.ext e.symm)
    simp [bitValue, h, hn]

theorem complexSurjective (col inv : ℕ → ℕ)
    (certificate : ∀ j : Fin 448, multiply col (inv j.val) 506 = 1 <<< j.val) :
    Function.Surjective ((intA col).map (fun z : ℤ => (z : ℂ))).mulVec := by
  let A := intA col
  let B := intB inv
  have htwo : ((A * B).det : ZMod 2) = 1 := by
    rw [Int.cast_det, productModTwo col inv certificate, Matrix.det_one]
  have hInt : (A * B).det ≠ 0 := by
    intro hz
    rw [hz, Int.cast_zero] at htwo
    exact zero_ne_one htwo
  let AC := A.map fun z : ℤ => (z : ℂ)
  let BC := B.map fun z : ℤ => (z : ℂ)
  have hcast : ((A * B).det : ℂ) = (AC * BC).det := by
    rw [Int.cast_det]
    change ((A * B).map (Int.castRingHom ℂ)).det =
      (A.map (Int.castRingHom ℂ) * B.map (Int.castRingHom ℂ)).det
    rw [Matrix.map_mul]
  have hComplex : (AC * BC).det ≠ 0 := by
    rw [← hcast]
    exact Int.cast_ne_zero.mpr hInt
  have hUnit : IsUnit (AC * BC) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hComplex)
  intro T
  obtain ⟨v, hv⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hUnit T
  exact ⟨BC.mulVec v, (Matrix.mulVec_mulVec v AC BC).trans hv⟩

end OMA.TangentSquareWitness

namespace OMA.TangentSquareWitness

open Matrix Finset

abbrev TensorRow := Fin 7 × Fin 8 × Fin 8
abbrev Variation := Fin 7 ⊕ (Fin 8 ⊕ Fin 8)

def rowIndex : TensorRow ≃ Fin 448 :=
  (Equiv.prodCongr (Equiv.refl (Fin 7)) (@finProdFinEquiv 8 8)).trans finProdFinEquiv

def variationIndex : Variation ≃ Fin 23 :=
  (Equiv.sumCongr (Equiv.refl (Fin 7)) (@finSumFinEquiv 8 8)).trans finSumFinEquiv

def columnIndex : (Fin 22 × Variation) ≃ Fin 506 :=
  (Equiv.prodCongr (Equiv.refl (Fin 22)) variationIndex).trans finProdFinEquiv

theorem rowIndex_val (i : Fin 7) (j k : Fin 8) :
    (rowIndex (i, j, k)).val = 64 * i.val + 8 * j.val + k.val := by
  change k.val + 8 * j.val + 64 * i.val = _
  omega

theorem columnIndex_u (t : Fin 22) (u : Fin 7) :
    (columnIndex (t, .inl u)).val = 23 * t.val + u.val := by
  change u.val + 23 * t.val = _
  omega

theorem columnIndex_v (t : Fin 22) (v : Fin 8) :
    (columnIndex (t, .inr (.inl v))).val = 23 * t.val + 7 + v.val := by
  change (7 + v.val) + 23 * t.val = _
  omega

theorem columnIndex_w (t : Fin 22) (w : Fin 8) :
    (columnIndex (t, .inr (.inr w))).val = 23 * t.val + 15 + w.val := by
  change (7 + (8 + w.val)) + 23 * t.val = _
  omega

def coeff (X Y Z : ℕ → ℕ) (t s v : ℕ) : Bool :=
  let i := v / 64
  let j := (v / 8) % 8
  let k := v % 8
  if s < 7 then decide (i = s) && (Y t).testBit j && (Z t).testBit k
  else if s < 15 then decide (j = s - 7) && (X t).testBit i && (Z t).testBit k
  else decide (k = s - 15) && (X t).testBit i && (Y t).testBit j

theorem columnBits (A X Y Z : ℕ → ℕ)
    (linked : ∀ d : Fin 506, pack (coeff X Y Z (d.val / 23) (d.val % 23)) 0 448 = A d.val)
    (i : Fin 7) (j k : Fin 8) (t : Fin 22) (s : Variation) :
    (A (columnIndex (t, s)).val).testBit (rowIndex (i, j, k)).val =
      match s with
      | .inl u => decide (i = u) && (Y t.val).testBit j.val && (Z t.val).testBit k.val
      | .inr (.inl v) => decide (j = v) && (X t.val).testBit i.val && (Z t.val).testBit k.val
      | .inr (.inr w) => decide (k = w) && (X t.val).testBit i.val && (Y t.val).testBit j.val := by
  let d := columnIndex (t, s)
  let q := rowIndex (i, j, k)
  rw [← linked d, packBit _ 0 448 q.val q.isLt, Nat.zero_add]
  have hj := j.isLt
  have hk := k.isLt
  have h₁ : q.val / 64 = i.val := by rw [show q.val = _ from rowIndex_val i j k]; omega
  have h₂ : (q.val / 8) % 8 = j.val := by rw [show q.val = _ from rowIndex_val i j k]; omega
  have h₃ : q.val % 8 = k.val := by rw [show q.val = _ from rowIndex_val i j k]; omega
  simp only [coeff, h₁, h₂, h₃]
  dsimp only [d]
  rcases s with u | (v | w)
  · have hu := u.isLt
    have head : (columnIndex (t, .inl u)).val / 23 = t.val := by rw [columnIndex_u]; omega
    have hcval : (columnIndex (t, .inl u)).val % 23 = u.val := by rw [columnIndex_u]; omega
    simp [head, hcval, hu, Fin.ext_iff]
  · have hv := v.isLt
    have head : (columnIndex (t, .inr (.inl v))).val / 23 = t.val := by rw [columnIndex_v]; omega
    have hcval : (columnIndex (t, .inr (.inl v))).val % 23 = 7 + v.val := by rw [columnIndex_v]; omega
    rw [head, hcval, if_neg (by omega), if_pos (by omega)]
    simp [Fin.ext_iff]
  · have hw := w.isLt
    have head : (columnIndex (t, .inr (.inr w))).val / 23 = t.val := by rw [columnIndex_w]; omega
    have hcval : (columnIndex (t, .inr (.inr w))).val % 23 = 15 + w.val := by rw [columnIndex_w]; omega
    rw [head, hcval, if_neg (by omega), if_neg (by omega)]
    simp [Fin.ext_iff]

def sample (D : ℕ → ℕ) (t j : ℕ) : Fin 897 :=
  ⟨if (D t).testBit j then 1 else 0, by split <;> decide⟩

theorem sample_cast (D : ℕ → ℕ) (t j : ℕ) :
    ((sample D t j).val : ℂ) = bitValue ℂ ((D t).testBit j) := by
  change (((if (D t).testBit j then 1 else 0 : ℕ) : ℂ)) = _
  cases (D t).testBit j <;> simp [bitValue]

theorem bitAnd (a b : Bool) : bitValue ℂ (a && b) = bitValue ℂ a * bitValue ℂ b := by
  cases a <;> cases b <;> simp [bitValue]

theorem bitDecide {p : Prop} [Decidable p] :
    bitValue ℂ (decide p) = if p then 1 else 0 := by
  by_cases hp : p <;> simp [bitValue, hp]

theorem tensorWitness (A B X Y Z : ℕ → ℕ)
    (certificate : ∀ j : Fin 448, multiply A (B j.val) 506 = 1 <<< j.val)
    (linked : ∀ d : Fin 506, pack (coeff X Y Z (d.val / 23) (d.val % 23)) 0 448 = A d.val) :
    ∃ x : Fin 22 → Fin 7 → Fin 897,
    ∃ y z : Fin 22 → Fin 8 → Fin 897,
      ∀ T : Fin 7 → Fin 8 → Fin 8 → ℂ,
        ∃ u : Fin 22 → Fin 7 → ℂ,
        ∃ v w : Fin 22 → Fin 8 → ℂ,
          ∀ i j k,
            T i j k = ∑ t, (u t i * (((y t j).val : ℂ) * ((z t k).val : ℂ)) +
              ((x t i).val : ℂ) * (v t j * ((z t k).val : ℂ)) +
              ((x t i).val : ℂ) * (((y t j).val : ℂ) * w t k)) := by
  let x (t : Fin 22) (i : Fin 7) := sample X t.val i.val
  let y (t : Fin 22) (j : Fin 8) := sample Y t.val j.val
  let z (t : Fin 22) (k : Fin 8) := sample Z t.val k.val
  refine ⟨x, y, z, ?_⟩
  intro T
  let U (v : Fin 448) : ℂ :=
    let f := rowIndex.symm v
    T f.1 f.2.1 f.2.2
  obtain ⟨vec, hvec⟩ := complexSurjective A B certificate U
  let u (t : Fin 22) (i : Fin 7) := vec (columnIndex (t, .inl i))
  let v (t : Fin 22) (j : Fin 8) := vec (columnIndex (t, .inr (.inl j)))
  let w (t : Fin 22) (k : Fin 8) := vec (columnIndex (t, .inr (.inr k)))
  refine ⟨u, v, w, ?_⟩
  intro i j k
  let row := rowIndex (i,j,k)
  have hT : U row = T i j k := by simp [U,row]
  have heq := hT.symm.trans (congrFun hvec row).symm
  have hx : ∀ t i, ((x t i).val : ℂ) = bitValue ℂ ((X t.val).testBit i.val) :=
    fun t i => sample_cast X t.val i.val
  have hy : ∀ t j, ((y t j).val : ℂ) = bitValue ℂ ((Y t.val).testBit j.val) :=
    fun t j => sample_cast Y t.val j.val
  have hz : ∀ t k, ((z t k).val : ℂ) = bitValue ℂ ((Z t.val).testBit k.val) :=
    fun t k => sample_cast Z t.val k.val
  calc
    T i j k = ∑ s : Fin 506, bitValue ℂ ((A s.val).testBit row.val) * vec s := by
      simpa only [intA, mulVec, dotProduct, Matrix.map_apply, Matrix.of_apply, castBit]
        using heq
    _ = _ := by
      rw [← Equiv.sum_comp columnIndex]
      simp only [Fintype.sum_prod_type, Fintype.sum_sum_type]
      apply Finset.sum_congr rfl
      intro t _
      simp only [row, columnBits A X Y Z linked, bitAnd, bitDecide, ite_mul, one_mul, zero_mul,
        Finset.sum_ite_eq, Finset.mem_univ, if_true, hx, hy, hz, u, v, w]
      ring

end OMA.TangentSquareWitness

