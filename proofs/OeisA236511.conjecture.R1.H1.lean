private def quadStart (i : ℕ) : ℕ := (0x10f738345b608d911aab05440c9efa4c5aa56ff290992f7493be46791f5e8f5cc7a3232c9126b8584c1b0a0cb3041081d3c0b920335 >>> (17*(i%25))) % 131072

private theorem quadSound (i : ℕ) :
    let p := quadStart i
    p.Prime ∧ (p+2).Prime ∧ (p+6).Prime ∧ (p+8).Prime := by
  let j : Fin 25 := ⟨i%25,Nat.mod_lt _ (by decide)⟩
  have tab : ∀ u : Fin 25, let p := quadStart u.val
      (primeFlag p && primeFlag (p+2) && primeFlag (p+6) && primeFlag (p+8)) = true := by
    decide +kernel
  have eq : quadStart j.val = quadStart i := by simp [j,quadStart]
  have h := tab j
  dsimp only at h ⊢
  rw [eq] at h
  simp only [Bool.and_eq_true_iff] at h
  exact ⟨primeFlag_sound h.1.1.1,primeFlag_sound h.1.1.2,primeFlag_sound h.1.2,primeFlag_sound h.2⟩

private def phi : ℕ → ℕ → ℕ
  | 0, n => n.totient
  | fuel+1, n =>
    if n = 1 then 1 else
    let p := factorHint n
    if p = 0 then (if primeFlag n then n-1 else n.totient)
    else
      let q := n / p
      if primeFlag p && p*q == n then (if q % p = 0 then p else p-1) * phi fuel q
      else n.totient

private theorem phi_sound (fuel n : ℕ) : phi fuel n = n.totient := by
  induction fuel generalizing n with
  | zero => rfl
  | succ fuel ih =>
    by_cases hn : n = 1
    · simp [hn,phi]
    simp only [phi, if_neg hn]
    split
    · split
      · rename_i hP
        exact (Nat.totient_prime (primeFlag_sound hP)).symm
      · rfl
    · split
      · rename_i checked
        obtain ⟨pp,he⟩ := Bool.and_eq_true_iff.mp checked
        have eq := beq_iff_eq.mp he
        rw [ih]
        split
        · rename_i hd
          have hh := Nat.totient_mul_of_prime_of_dvd (primeFlag_sound pp) (Nat.dvd_of_mod_eq_zero hd)
          rw [eq] at hh
          exact hh.symm
        · rename_i hd
          have hh := Nat.totient_mul_of_prime_of_not_dvd (primeFlag_sound pp)
            (fun hdiv => hd (Nat.mod_eq_zero_of_dvd hdiv))
          rw [eq] at hh
          exact hh.symm
      · rfl

private def row (n : ℕ) : Bool :=
  let code := witness (n-1076)
  let k := code / 32
  decide (1 ≤ k ∧ k < n) &&
    (3 * phi 16 k + phi 16 (n-k) - 1 == quadStart (code % 32))

private theorem row_sound {n : ℕ} (h : row n = true) : 0 < OeisA236511.a n := by
  let code := witness (n-1076)
  let k := code / 32
  change (decide (1 ≤ k ∧ k < n) &&
    (3 * phi 16 k + phi 16 (n-k) - 1 == quadStart (code % 32))) = true at h
  obtain ⟨bounds,parts⟩ := Bool.and_eq_true_iff.mp h
  have eq := beq_iff_eq.mp parts
  rw [phi_sound, phi_sound] at eq
  obtain ⟨hk,hkn⟩ := of_decide_eq_true bounds
  obtain ⟨ha,hb,hc,hd⟩ := quadSound (code%32)
  unfold OeisA236511.a
  apply Finset.sum_pos' (fun _ _ => Nat.zero_le _)
  refine ⟨k, Finset.mem_Ico.mpr ⟨hk,hkn⟩, ?_⟩
  simp only [eq,ha,hb,hc,hd,and_self,if_true,Nat.zero_lt_one]

private def scan (n : ℕ) : ℕ → Bool
  | 0 => true
  | m+1 => row (n+m) && scan n m

private theorem scan_sound {n m i : ℕ} (h : scan n m = true) (lo : n ≤ i) (hi : i < n+m) :
    0 < OeisA236511.a i := by
  induction m with
  | zero => omega
  | succ m ih =>
    obtain ⟨last,prev⟩ := Bool.and_eq_true_iff.mp h
    by_cases e : i = n+m
    · exact e ▸ row_sound last
    · exact ih prev (by omega)

private def Band (a b : ℕ) : Prop := ∀ n, a ≤ n → n < b → 0 < OeisA236511.a n

private theorem joinBands {a b c : ℕ} (left : Band a b) (right : Band b c) : Band a c := by
  intro n lo hi
  by_cases h : n < b
  · exact left n lo h
  · exact right n (by omega) hi

private theorem checkedBand (a len : ℕ) (h : scan a len = true) : Band a (a+len) :=
  fun _ lo hi => scan_sound h lo hi

