private abbrev Witness := List ℕ × List ℕ
private def check (n : ℕ) (w : Witness) : Bool :=
  let u := evalFactors w.1
  let v := evalFactors w.2
  decide (1 ≤ u.1 ∧ u.1 < n-2 ∧ u.1 + v.1 = n) && w.1.all test && w.2.all test &&
    decide (u.2 + v.2 / 2 + 1 ∈ indices)

private theorem of_check {n : ℕ} {w : Witness} (h : check n w = true) : 0 < OeisA236097.a n := by
  simp only [check,Bool.and_eq_true,decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨hlo,hhi,hs⟩,h₁⟩,h₂⟩,hg⟩ := h
  let k := (evalFactors w.1).1
  have hk : k ∈ Finset.Ico 1 (n-2) := Finset.mem_Ico.mpr ⟨hlo,hhi⟩
  have hd : n-k = (evalFactors w.2).1 := by dsimp [k]; omega
  have hp : GoodIndex (k.totient + (n-k).totient / 2 + 1) := by
    rw [hd,show k.totient = (evalFactors w.1).2 from eval_sound h₁,eval_sound h₂]
    exact validIndex hg
  letI (z : ℕ) : Decidable (GoodIndex z) := by unfold GoodIndex; infer_instance
  let f (i : ℕ) : ℕ := if GoodIndex (i.totient + (n-i).totient/2+1) then 1 else 0
  change 0 < ∑ i ∈ Finset.Ico 1 (n-2), f i
  have hl : f k ≤ ∑ i ∈ Finset.Ico 1 (n-2), f i :=
    Finset.single_le_sum (f := f) (fun _ _ => Nat.zero_le _) hk
  simpa [f,hp] using hl

private def Segment (lo hi : ℕ) : Prop := ∀ n, lo ≤ n → n < hi → 0 < OeisA236097.a n

private theorem fromTable (lo len : ℕ) (w : Array Witness)
    (ok : ∀ i : Fin len, check (lo+i.val) (w[i.val]?.getD ([],[])) = true) : Segment lo (lo+len) := by
  intro n hl hu
  have hi : n-lo < len := by omega
  have h := of_check (ok ⟨n-lo,hi⟩)
  simpa only [Fin.val_mk,Nat.add_sub_of_le hl] using h

private theorem join {a b c : ℕ} (hl : Segment a b) (hr : Segment b c) : Segment a c := by
  intro n hn hc
  by_cases h : n < b
  · exact hl _ hn h
  · exact hr _ (by omega) hc
