import OMAReductions.R_OeisA236097_conjecture_R1

/-!
Witnesses for Sun's published range 32 through 10000. Prime ranks are
verified by counting primes in disjoint intervals using exact trial division.
The two totients used in every split are evaluated on certified prime factors.
-/
namespace OMA.SunFinite

private def trial (n : ℕ) : ℕ → ℕ → Bool
  | 0, d => decide (n < d*d)
  | k+1, d => if n < d*d then true else (n % d != 0) && trial n k (d+1)

private theorem trial_sound {n k d : ℕ} (h : trial n k d = true) :
    ∀ m, d ≤ m → m ≤ n.sqrt → ¬ m ∣ n := by
  induction k generalizing d with
  | zero =>
    have ht : n.sqrt < d := Nat.sqrt_lt.mpr (by simpa [trial] using h)
    intro m hm hs; omega
  | succ k ih =>
    intro m hm hs
    by_cases hd : n < d*d
    · have := Nat.sqrt_lt.mpr hd
      omega
    · simp only [trial,if_neg hd,Bool.and_eq_true,bne_iff_ne] at h
      rcases eq_or_lt_of_le hm with rfl | hlt
      · exact fun hn => h.1 (Nat.mod_eq_zero_of_dvd hn)
      · exact ih h.2 _ hlt hs

private def test (n : ℕ) := decide (2 ≤ n) && trial n 820 2
private theorem prime_of_test {n : ℕ} (h : test n = true) : n.Prime := by
  simp only [test,Bool.and_eq_true,decide_eq_true_eq] at h
  exact Nat.prime_def_le_sqrt.mpr ⟨h.1,trial_sound h.2⟩

private def evalFactors : List ℕ → ℕ × ℕ
  | [] => (1,1)
  | p::ps =>
    let v := evalFactors ps
    (p*v.1, (if v.1 % p = 0 then p else p-1)*v.2)

private theorem eval_sound {ps : List ℕ} (h : ps.all test = true) :
    (evalFactors ps).1.totient = (evalFactors ps).2 := by
  induction ps with
  | nil => simp [evalFactors]
  | cons p ps ih =>
    simp only [List.all_cons,Bool.and_eq_true] at h
    have hp := prime_of_test h.1
    simp only [evalFactors]
    by_cases hd : (evalFactors ps).1 % p = 0
    · rw [if_pos hd,Nat.totient_mul_of_prime_of_dvd hp (Nat.dvd_of_mod_eq_zero hd),ih h.2]
    · rw [if_neg hd,Nat.totient_mul_of_prime_of_not_dvd hp (fun hdiv => hd (Nat.mod_eq_zero_of_dvd hdiv)),ih h.2]

private theorem trial_complete {n : ℕ} (hp : n.Prime) (k d : ℕ) (hd : 2 ≤ d)
    (hb : n.sqrt < d+k) : trial n k d = true := by
  induction k generalizing d with
  | zero =>
    simp only [Nat.add_zero] at hb
    simp [trial,Nat.sqrt_lt.mp hb]
  | succ k ih =>
    by_cases hh : n < d*d
    · simp [trial,hh]
    have hs : d ≤ n.sqrt := Nat.le_sqrt.mpr (by omega)
    have nd := (Nat.prime_def_le_sqrt.mp hp).2 d hd hs
    have hn : n % d ≠ 0 := fun h => nd (Nat.dvd_of_mod_eq_zero h)
    simp [trial,hh,hn,ih (d+1) (by omega) (by omega)]

private theorem test_iff {n : ℕ} (h : n ≤ 21000) : test n = true ↔ n.Prime := by
  refine ⟨prime_of_test,fun hp => ?_⟩
  have hb : n.sqrt < 822 := Nat.sqrt_lt.mpr (by omega)
  simp [test,hp.two_le,trial_complete hp 820 2 (by decide) hb]

private def countBlock (a : ℕ) : ℕ → ℕ
  | 0 => 0
  | k+1 => countBlock a k + if test (a+k) then 1 else 0

private theorem countBlock_ok (a k : ℕ) (h : a+k ≤ 21000) :
    Nat.count Nat.Prime (a+k) = Nat.count Nat.Prime a + countBlock a k := by
  induction k with
  | zero => simp [countBlock]
  | succ k ih =>
    rw [Nat.add_succ,Nat.count_succ,ih (by omega)]
    simp only [countBlock,test_iff (n := a+k) (by omega),Nat.add_assoc]

private def GoodIndex (p : ℕ) := p.Prime ∧
  (Nat.nth Nat.Prime (p-1)-p-1).Prime ∧ (Nat.nth Nat.Prime (p-1)-p+1).Prime

private theorem goodOfRank {p q : ℕ} (hr : Nat.count Nat.Prime q = p-1)
    (hq : test q = true) (hp : test p = true) (hm : test (q-p-1) = true)
    (hh : test (q-p+1) = true) : GoodIndex p := by
  have hn := Nat.nth_count (prime_of_test hq)
  rw [hr] at hn
  unfold GoodIndex
  rw [hn]
  exact ⟨prime_of_test hp,prime_of_test hm,prime_of_test hh⟩
