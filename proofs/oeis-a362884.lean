def row (k i : ℕ) := (table.getD (k%32) []).getD i []
def jet (k i : ℕ) : Jet :=
  let r := row k i
  ⟨(r.getD 0 0 : ℕ), fun j => (r.getD (j.val+1) 0 : ℕ), r.getD 5 0⟩
def val (k i : ℕ) := (row k i).getD 6 0
def width (i : Fin 4) : ℕ := if i = 0 ∨ i = 3 then 6 else 7

abbrev BallOK (k : ℕ) : Prop :=
  (∀ i j : Fin 4, (jet k i).slope j = if j=i then (2:ℤ)^(width i) else 0) ∧
  (∀ i : Fin 11, ValOK (jet k i) (val k i) ∧
    (val k i : ℤ) = DyadicRecurrence.companionVal (11*k+i) ∧
    StepOK (jet k i) (jet k (i+1)) (jet k (i+2)) (jet k (i+3)) (jet k (i+4)) (val k i)) ∧
  (∀ i : Fin 4, width i ≤ (jet k (11+i)).prec ∧ width i ≤ (jet k (11+i)).linOrd ∧
    (2:ℤ)^(width i) ∣ (jet k (11+i)).center-(jet (k+1) i).center)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 1500000 in
theorem checked (k : Fin 32) : BallOK k := by
  fin_cases k <;> decide +kernel

private theorem period {k j : ℕ} (h : k%32=j%32) (n : ℕ) : jet k n = jet j n := by
  simp [jet,row,h]

private theorem integral_difference {x : ℚ} {e : ℕ} (h : Good e x) :
    Good 0 (x/2^e) := by
  by_cases hz : x=0
  · exact Or.inl (by simp [hz])
  apply Or.inr
  have he := h.resolve_left hz
  have h2 : padicValRat 2 (2:ℚ)=1 := padicValRat.self (by decide : 1<2)
  rw [padicValRat.div hz (by positivity),padicValRat.pow,h2,mul_one]
  omega

private theorem run_window (k : Fin 32) (f : ℕ → ℚ)
    (seed : ∀ i : Fin 4, Good (width i) (f i-(jet k i).center))
    (pos : ∀ i, f i ≠ 0)
    (hrec : ∀ i, f (i+4)*f i=(f (i+1)+1)*(f (i+2)+1)*(f (i+3)+1)) :
    (∀ i : Fin 11, padicValRat 2 (f i) = DyadicRecurrence.companionVal (11*k.val+i)) ∧
    ∀ i : Fin 4, Good (width i) (f (11+i)-(jet (k.val+1) i).center) := by
  let u (i : Fin 4) := (f i - (jet k i).center)/2^(width i)
  have hu (i) : Good 0 (u i) := integral_difference (seed i)
  obtain ⟨hinit,hstep,hend⟩ := checked k
  have initial (i : Fin 4) : Valid u (jet k i) (f i) := by
    apply Or.inl
    have he : (jet k i).linear u = ((2:ℤ)^(width i) : ℤ) * u i := by
      unfold Jet.linear
      rw [Finset.sum_eq_single i]
      · rw [hinit,if_pos rfl]
      · intro j _ hj; simp [hinit i j,hj]
      · simp
    simp only [Jet.eval,he,u,Int.cast_pow,Int.cast_ofNat]
    field_simp
    <;> ring
  have run (n : ℕ) (hn : n < 15) : Valid u (jet k n) (f n) := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      by_cases hi : n < 4
      · exact initial ⟨n,hi⟩
      obtain ⟨j, rfl⟩ : ∃ j, n = j+4 := ⟨n-4,by omega⟩
      let t : Fin 11 := ⟨j,by omega⟩
      exact advance hu (hstep t).2.2 (hstep t).1
        (ih j (by omega) (by omega)) (ih (j+1) (by omega) (by omega))
        (ih (j+2) (by omega) (by omega)) (ih (j+3) (by omega) (by omega))
        (pos j) (hrec j)
  constructor
  · intro i
    exact (jet_val hu (hstep i).1 (run i (by omega)) (pos i)).trans (hstep i).2.1
  · intro i
    have a := down (run (11+i) (by omega)) (hend i).1
    have b := down (lin_good hu (jet k (11+i))) (hend i).2.1
    have c := of_int_dvd (hend i).2.2
    have h := gadd (gadd a b) c
    convert h using 1 <;> simp only [Jet.eval,Int.cast_sub] <;> ring

theorem whole_sequence : ∀ n, padicValRat 2 (DyadicRecurrence.y n) =
    DyadicRecurrence.companionVal n := by
  let f := DyadicRecurrence.y
  have hn (i) : f i ≠ 0 := by
    have bpos (j : ℕ) : 0 < DyadicRecurrence.b j :=
      div_pos (DyadicRecurrence.apos _) (by norm_num)
    exact (mul_pos (mul_pos (bpos _) (bpos _)) (bpos _)).ne'
  let phase (k : ℕ) : Fin 32 := ⟨k%32,Nat.mod_lt _ (by decide)⟩
  have recurs (k j : ℕ) : f (11*k+(j+4))*f (11*k+j) =
      (f (11*k+(j+1))+1)*(f (11*k+(j+2))+1)*(f (11*k+(j+3))+1) := by
    simpa only [Nat.add_assoc] using DyadicRecurrence.y_step (11*k+j)
  have start (k : ℕ) : ∀ i : Fin 4, Good (width i) (f (11*k+i)-(jet (phase k) i).center) := by
    induction k with
    | zero =>
      intro i
      apply Or.inl
      fin_cases i <;> decide +kernel
    | succ k ih =>
      intro i
      have h := (run_window (phase k) (fun j => f (11*k+j)) ih (fun j => hn _) (recurs k)).2 i
      have he : jet ((phase k).val+1) i = jet (phase (k+1)) i := period (by dsimp [phase]; omega) _
      simpa only [he,Nat.mul_succ,Nat.add_assoc] using h
  intro n
  let k := n/11
  let i : Fin 11 := ⟨n%11,Nat.mod_lt _ (by decide)⟩
  have h := (run_window (phase k) (fun j => f (11*k+j)) (start k) (fun j => hn _) (recurs k)).1 i
  have he : 11*k+i.val = n := Nat.div_add_mod n 11
  rw [he] at h
  have hmod : (11*(phase k).val+i.val)%44 = n%44 := by dsimp [phase,k,i]; omega
  simpa only [DyadicRecurrence.companionVal,hmod] using h

end AffineCertificate

theorem OMA.solution : type_of% @OMA.S_oeis_a362884.main :=
  DyadicRecurrence.result_from_companion AffineCertificate.whole_sequence
