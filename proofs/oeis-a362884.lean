import OMAStatements.S_oeis_a362884

-- Credit: @siddsg7
/-! Both conjectures for A362884 follow from the exact period-44 pattern of its
2-adic valuations. Put b(n)=a(n)/4 and y(n)=b(n)b(n+1)b(n+2). The eight-term
polynomial recurrence for b excludes odd denominators, and the valuation of y gives
the sum of three consecutive valuations of b. Two initial valuations then fix them all.

Mercio gave the polynomial recurrence and proposed following 11-step 2-adic neighborhoods
for the companion sequence A276175 (https://math.stackexchange.com/questions/1905063).
The companion valuation pattern was identified in Sil's A276175 formalization
(https://github.com/TheSil/mse_1905063, commit 2e5b1c397ae89af800c4aee585a9d0eac982d962).

The independent certificate below uses 32 neighborhoods, each advanced by 11 terms.
A row stores an integer center, four linear coefficients, a precision, and a valuation.
The initial perturbations have 2-adic orders at least 6, 7, 7, and 6, respectively.
Cross-multiplication bounds the error of each affine approximation before cancellation.
The last four rows of each neighborhood land in the next, and the last neighborhood
returns to the first. Every divisibility test in the table is decided by the Lean kernel. -/

namespace DyadicRecurrence
open OMA.S_oeis_a362884

def b (n : ℕ) : ℚ := a n / 4

theorem apos (n : ℕ) : 0 < a n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    match n with
    | 0 | 1 | 2 | 3 => norm_num [a]
    | n + 4 =>
      rw [a]
      have h0 := ih n (by omega)
      have h1 := ih (n+1) (by omega)
      have h2 := ih (n+2) (by omega)
      have h3 := ih (n+3) (by omega)
      positivity

theorem exchange (n : ℕ) : b n * b (n+4) = b (n+1) * b (n+2) * b (n+3) + 1 := by
  simp only [b, a.eq_5]
  field_simp [(apos n).ne']
  ring

private theorem polynomial_update {r s t u v w x y z : ℚ} (hv : v ≠ 0)
    (h0 : r*v = s*t*u+1) (h1 : s*w = t*u*v+1) (h2 : t*x = u*v*w+1)
    (h3 : u*y = v*w*x+1) (h4 : v*z = w*x*y+1) :
    z = r*w*x*y - ((t*u)+(u*w)+(w*x)) -
      v*((t*u)*(u*w)+(t*u)*(w*x)+(u*w)*(w*x)) - v^2*((t*u)*(u*w)*(w*x)) := by
  have H : s*t*u*(w*x*y) = (t*u*v+1)*(u*v*w+1)*(v*w*x+1) := by
    rw [← h1, ← h2, ← h3]
    ring
  apply mul_left_cancel₀ hv
  linear_combination h4 - H - w*x*y*h0

/-- Every normalized term belongs to every subring containing its first eight terms. -/
theorem ring_of_eight (R : Subring ℚ) (h : ∀ i < 8, b i ∈ R) (n : ℕ) : b n ∈ R := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n < 8
    · exact h n hn
    · obtain ⟨j, rfl⟩ : ∃ j, n = j+8 := ⟨n-8, by omega⟩
      have hv : b (j+4) ≠ 0 := (div_pos (apos _) (by norm_num : (0:ℚ) < 4)).ne'
      rw [polynomial_update hv (exchange j) (exchange (j+1)) (exchange (j+2))
          (exchange (j+3)) (exchange (j+4))]
      have mem (i : ℕ) (hi : i < 8) : b (j+i) ∈ R := ih _ (by omega)
      have m0 := ih j (by omega)
      have m2 := mem 2 (by omega)
      have m3 := mem 3 (by omega)
      have m4 := mem 4 (by omega)
      have m5 := mem 5 (by omega)
      have m6 := mem 6 (by omega)
      have m7 := mem 7 (by omega)
      exact R.sub_mem (R.sub_mem (R.sub_mem
        (R.mul_mem (R.mul_mem (R.mul_mem m0 m5) m6) m7)
        (R.add_mem (R.add_mem (R.mul_mem m2 m3) (R.mul_mem m3 m5)) (R.mul_mem m5 m6)))
        (R.mul_mem m4 (R.add_mem (R.add_mem (R.mul_mem (R.mul_mem m2 m3) (R.mul_mem m3 m5))
          (R.mul_mem (R.mul_mem m2 m3) (R.mul_mem m5 m6)))
          (R.mul_mem (R.mul_mem m3 m5) (R.mul_mem m5 m6)))))
        (R.mul_mem (R.pow_mem m4 2)
          (R.mul_mem (R.mul_mem (R.mul_mem m2 m3) (R.mul_mem m3 m5)) (R.mul_mem m5 m6)))

def dyadics : Subring ℚ :=
  Subring.closure {(1 / 2 : ℚ)}

theorem every_term_dyadic (n : ℕ) : a n ∈ dyadics := by
  have half : (1 / 2 : ℚ) ∈ dyadics := Subring.subset_closure (Set.mem_singleton _)
  have h : ∀ i < 8, b i ∈ dyadics := by
    intro i hi
    interval_cases i <;> norm_num [b, a] <;> exact half
  have hb := ring_of_eight dyadics h n
  have hn : a n = 4 * b n := by unfold b; ring
  rw [hn]
  exact dyadics.mul_mem (show (4 : ℚ) ∈ dyadics by norm_num) hb

theorem dyadic_rep {x : ℚ} (hx : x ∈ dyadics) :
    ∃ (k : ℕ) (z : ℤ), x * 2^k = z := by
  induction hx using Subring.closure_induction with
  | mem y hy =>
    obtain rfl := Set.mem_singleton_iff.mp hy
    exact ⟨1, 1, by norm_num⟩
  | zero => exact ⟨0, 0, by norm_num⟩
  | one => exact ⟨0, 1, by norm_num⟩
  | neg x _ ih =>
    obtain ⟨k,z,h⟩ := ih
    exact ⟨k,-z,by push_cast; linear_combination -h⟩
  | add x y _ _ ihx ihy =>
    obtain ⟨k,z,h⟩ := ihx
    obtain ⟨l,w,g⟩ := ihy
    refine ⟨k+l,z*2^l+w*2^k,?_⟩
    push_cast
    rw [pow_add, ← h, ← g]
    ring
  | mul x y _ _ ihx ihy =>
    obtain ⟨k,z,h⟩ := ihx
    obtain ⟨l,w,g⟩ := ihy
    refine ⟨k+l,z*w,?_⟩
    push_cast
    rw [pow_add, ← h, ← g]
    ring

lemma dyadic_conclusion {x : ℚ} (hx : x ∈ dyadics) (hn : x ≠ 0)
    (h0 : 0 ≤ padicValRat 2 x) (h6 : padicValRat 2 x < 6) :
    ∃ z : ℤ, x = z ∧ ¬ (64 : ℤ) ∣ z := by
  obtain ⟨k,z,h⟩ := dyadic_rep hx
  have hv := congrArg (padicValRat 2) h
  rw [padicValRat.mul hn (by positivity), padicValRat.pow, padicValRat.of_int] at hv
  have h2 : padicValRat 2 (2 : ℚ) = 1 := padicValRat.self (by decide : 1 < 2)
  rw [h2, mul_one] at hv
  obtain ⟨w,hw⟩ := (padicValInt_dvd_iff (p := 2) k z).mpr (Or.inr (by omega))
  have hw' : x = (w:ℚ) := by
    rw [hw] at h
    push_cast at h
    apply mul_right_cancel₀ (pow_ne_zero k (by norm_num : (2:ℚ) ≠ 0))
    simpa [mul_comm] using h
  refine ⟨w,hw',?_⟩
  intro hd
  obtain H | H := (padicValInt_dvd_iff (p := 2) 6 w).mp (by norm_num at *; exact hd)
  · exact hn (by simp [hw', H])
  · rw [hw', padicValRat.of_int] at h6
    omega

def y (n : ℕ) := b n * b (n+1) * b (n+2)

lemma y_step (n : ℕ) : y (n+4) * y n =
    (y (n+1)+1) * (y (n+2)+1) * (y (n+3)+1) := by
  change _ = (b (n+1)*b (n+2)*b (n+3)+1) * (b (n+2)*b (n+3)*b (n+4)+1) *
    (b (n+3)*b (n+4)*b (n+5)+1)
  rw [← exchange n, ← exchange (n+1), ← exchange (n+2)]
  unfold y
  ring

def companionVal (i : ℕ) : ℤ :=
  ([0,0,0,0,3,2,1,0,2,3,4,0,0,0,0,3,2,1,0,2,3,4,
    0,0,0,0,4,3,2,0,1,2,3,0,0,0,0,4,3,2,0,1,2,3] : List ℤ).getD (i%44) 0

def normalizedVal (i : ℕ) : ℤ :=
  ([-1,2,-1,-1,2,-1,2,1,-2,1,3,-1,2,-1,-1,2,-1,2,1,-2,1,3,
    -1,2,-1,-1,2,-1,3,1,-2,1,2,-1,2,-1,-1,2,-1,3,1,-2,1,2] : List ℤ).getD (i%44) 0

lemma word_balance (n : ℕ) : companionVal n =
    normalizedVal n + normalizedVal (n+1) + normalizedVal (n+2) := by
  have b : ∀ i : Fin 44, companionVal i = normalizedVal i +
      normalizedVal (i.val+1) + normalizedVal (i.val+2) := by decide +kernel
  have h := b ⟨n%44, Nat.mod_lt _ (by decide)⟩
  simpa only [companionVal, normalizedVal, Nat.mod_mod,
    Nat.mod_add_mod] using h

lemma normval_b (H : ∀ n, padicValRat 2 (y n) = companionVal n) :
    ∀ n, padicValRat 2 (b n) = normalizedVal n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    match n with
    | 0 => decide +kernel
    | 1 => decide +kernel
    | n+2 =>
      have nonz (i : ℕ) : b i ≠ 0 := (div_pos (apos i) (by norm_num : (0:ℚ)<4)).ne'
      have h := H n
      rw [y, padicValRat.mul (mul_ne_zero (nonz _) (nonz _)) (nonz _),
        padicValRat.mul (nonz _) (nonz _), word_balance,
        ih n (by omega), ih (n+1) (by omega)] at h
      omega

theorem result_from_companion (H : ∀ n, padicValRat 2 (y n) = companionVal n) :
    type_of% @OMA.S_oeis_a362884.main := by
  intro n
  have h := normval_b H n
  have bounds : ∀ i : Fin 44, -2 ≤ normalizedVal i ∧ normalizedVal i ≤ 3 := by decide +kernel
  have hi := bounds ⟨n%44, Nat.mod_lt _ (by decide)⟩
  simp only [normalizedVal, Nat.mod_mod] at hi
  change -2 ≤ normalizedVal n ∧ normalizedVal n ≤ 3 at hi
  have hz : a n = 4 * b n := by unfold b; ring
  have hv : padicValRat 2 (a n) = 2 + normalizedVal n := by
    have hb : b n ≠ 0 := (div_pos (apos n) (by norm_num : (0:ℚ)<4)).ne'
    rw [hz, padicValRat.mul (by norm_num : (4:ℚ) ≠ 0) hb, h]
    have : padicValRat 2 (4 : ℚ) = 2 := by decide +kernel
    rw [this]
  exact dyadic_conclusion (every_term_dyadic n) (apos n).ne' (by omega) (by omega)

end DyadicRecurrence

namespace AffineCertificate

/-- The rational number is divisible by 2^m in the localization at 2. -/
def Good (m : ℕ) (x : ℚ) : Prop := x = 0 ∨ (m : ℤ) ≤ padicValRat 2 x

private theorem down {i j : ℕ} {x : ℚ} (h : Good j x) (hij : i ≤ j) : Good i x := by
  rcases h with h | h
  · exact Or.inl h
  · exact Or.inr (by omega)

private theorem gadd {m : ℕ} {x y : ℚ} (hx : Good m x) (hy : Good m y) :
    Good m (x+y) := by
  rcases hx with rfl | hx
  · simpa using hy
  rcases hy with rfl | hy
  · rw [add_zero]; exact Or.inr hx
  by_cases h : x+y=0
  · exact Or.inl h
  · exact Or.inr (le_trans (le_min hx hy) (padicValRat.min_le_padicValRat_add h))

private theorem gneg {m : ℕ} {x : ℚ} (h : Good m x) : Good m (-x) := by
  simpa [Good] using h

private theorem gmul {m n : ℕ} {x y : ℚ} (hx : Good m x) (hy : Good n y) :
    Good (m+n) (x*y) := by
  by_cases h : x*y=0
  · exact Or.inl h
  obtain ⟨hn,hm⟩ := mul_ne_zero_iff.mp h
  rw [Good,padicValRat.mul hn hm]
  exact Or.inr (by have := hx.resolve_left hn; have := hy.resolve_left hm; omega)

private theorem val_equal {x : ℚ} {c : ℤ} {w : ℕ} (hn : x ≠ 0)
    (hc : c ≠ 0) (hval : padicValInt 2 c = w)
    (h : Good (w+1) (x-c)) : padicValRat 2 x = w := by
  have hcq : (c:ℚ) ≠ 0 := by exact_mod_cast hc
  have hvc : padicValRat 2 (c:ℚ) = w := by simp [hval]
  rcases h with h | h
  · simpa [sub_eq_zero.mp h] using hvc
  by_cases he : x-c=0
  · simpa [sub_eq_zero.mp he] using hvc
  have hs : (c:ℚ)+(x-c) ≠ 0 := by simpa only [add_sub_cancel] using hn
  have hh := padicValRat.add_eq_of_lt hs hcq he (show padicValRat 2 (c:ℚ)<padicValRat 2 (x-c) by omega)
  simpa [hvc] using hh

private theorem of_int_dvd {m : ℕ} {a : ℤ} (h : (2:ℤ)^m ∣ a) : Good m (a:ℚ) := by
  rcases (padicValInt_dvd_iff (p:=2) m a).mp h with he | hv
  · exact Or.inl (by simp [he])
  · exact Or.inr (by simpa using hv)

def orderCap : ℕ → ℤ → ℕ
  | 0, _ => 0
  | k+1, a => if a%2=0 then orderCap k (a/2)+1 else 0

private theorem cap_dvd (k : ℕ) (a : ℤ) : 2^(orderCap k a) ∣ a := by
  induction k generalizing a with
  | zero => simp [orderCap]
  | succ k ih =>
    simp only [orderCap]
    split_ifs with h
    · obtain ⟨t,ht⟩ := ih (a/2)
      refine ⟨t,?_⟩
      rw [pow_succ]
      have ha : a = 2*(a/2) := by omega
      calc a = 2 * (a/2) := ha
           _ = 2 * (2 ^ orderCap k (a/2) * t) := congrArg (2 * ·) ht
           _ = _ := by ring
    · simp

structure Jet where
  center : ℤ
  slope : Fin 4 → ℤ
  prec : ℕ

def Jet.linear (j : Jet) (u : Fin 4 → ℚ) := ∑ i, (j.slope i : ℚ) * u i
def Jet.eval (j : Jet) (u : Fin 4 → ℚ) := (j.center : ℚ) + j.linear u
def Jet.linOrd (j : Jet) : ℕ :=
  min (min (orderCap 35 (j.slope 0)) (orderCap 35 (j.slope 1)))
    (min (orderCap 35 (j.slope 2)) (orderCap 35 (j.slope 3)))
def Jet.lo (j : Jet) := min j.prec (min (orderCap 35 j.center) j.linOrd)
def Valid (u : Fin 4 → ℚ) (j : Jet) (x : ℚ) := Good j.prec (x-j.eval u)

private theorem lin_good {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i)) (j : Jet) :
    Good j.linOrd (j.linear u) := by
  have h (i : Fin 4) : Good j.linOrd ((j.slope i:ℚ)*u i) := by
    have hi : j.linOrd ≤ orderCap 35 (j.slope i) := by
      fin_cases i
      · change j.linOrd ≤ orderCap 35 (j.slope 0); unfold Jet.linOrd; omega
      · change j.linOrd ≤ orderCap 35 (j.slope 1); unfold Jet.linOrd; omega
      · change j.linOrd ≤ orderCap 35 (j.slope 2); unfold Jet.linOrd; omega
      · change j.linOrd ≤ orderCap 35 (j.slope 3); unfold Jet.linOrd; omega
    simpa only [Nat.add_zero] using gmul (down (of_int_dvd (cap_dvd 35 _)) hi) (hu i)
  simpa only [Jet.linear,Fin.sum_univ_four] using gadd (gadd (gadd (h 0) (h 1)) (h 2)) (h 3)

private theorem eval_good {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i)) (j : Jet) :
    Good j.lo (j.eval u) := by
  apply gadd
  · exact down (of_int_dvd (cap_dvd 35 j.center)) (by simp only [Jet.lo]; omega)
  · exact down (lin_good hu j) (by simp only [Jet.lo]; omega)

private theorem low {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i)) {j : Jet} {x : ℚ}
    (h : Valid u j x) : Good j.lo x := by
  have := gadd (down h (show j.lo ≤ j.prec from min_le_left _ _)) (eval_good hu j)
  simpa using this

def addOne (j : Jet) : Jet := {j with center := j.center+1}

private theorem addOne_valid {u : Fin 4 → ℚ} {j : Jet} {x : ℚ} (h : Valid u j x) :
    Valid u (addOne j) (x+1) := by
  change Good j.prec ((x+1)-((j.center+1 : ℤ) + j.linear u))
  change Good j.prec (x-((j.center:ℚ)+j.linear u)) at h
  push_cast
  convert h using 1 <;> ring

def mulJet (a b : Jet) : Jet where
  center := a.center*b.center
  slope i := a.center*b.slope i + b.center*a.slope i
  prec := min (a.prec+b.lo) (min (a.lo+b.prec) (a.linOrd+b.linOrd))

private theorem mul_valid {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i)) {a b : Jet} {x y : ℚ}
    (hx : Valid u a x) (hy : Valid u b y) : Valid u (mulJet a b) (x*y) := by
  let m := (mulJet a b).prec
  have h1 : Good m ((x-a.eval u)*y) := down (gmul hx (low hu hy)) (by simp only [m,mulJet]; omega)
  have h2 : Good m (a.eval u*(y-b.eval u)) := down (gmul (eval_good hu a) hy) (by simp only [m,mulJet]; omega)
  have h3 : Good m (a.linear u*b.linear u) := down (gmul (lin_good hu a) (lin_good hu b))
    (by simp only [m,mulJet]; omega)
  have hh := gadd (gadd h1 h2) h3
  change Good m _
  convert hh using 1 <;> simp [Jet.eval, Jet.linear, mulJet, Fin.sum_univ_four] <;> ring


abbrev CoeffClose (m : ℕ) (a b : Jet) : Prop :=
  (2:ℤ)^m ∣ a.center-b.center ∧ ∀ i, (2:ℤ)^m ∣ a.slope i-b.slope i

private theorem coeff_close {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i)) {a b : Jet} {m : ℕ}
    (h : CoeffClose m a b) : Good m (a.eval u-b.eval u) := by
  have h0 := of_int_dvd h.1
  have hh (i : Fin 4) : Good m (((a.slope i-b.slope i : ℤ):ℚ) * u i) := by
    simpa only [Nat.add_zero] using gmul (of_int_dvd (h.2 i)) (hu i)
  have H := gadd h0 (gadd (gadd (gadd (hh 0) (hh 1)) (hh 2)) (hh 3))
  convert H using 1 <;> simp [Jet.eval,Jet.linear,Fin.sum_univ_four] <;> ring

abbrev ValOK (j : Jet) (w : ℕ) : Prop :=
  (2:ℤ)^w ∣ j.center ∧ ¬ (2:ℤ)^(w+1) ∣ j.center ∧ w+1 ≤ j.prec ∧ w+1 ≤ j.linOrd

private theorem jet_val {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i)) {j : Jet} {x : ℚ}
    {w : ℕ} (ok : ValOK j w) (h : Valid u j x) (hn : x ≠ 0) : padicValRat 2 x = w := by
  obtain ⟨h1,h2,hp,hl⟩ := ok
  have hc : j.center ≠ 0 := fun e => h2 (by rw [e]; exact dvd_zero _)
  have ha := ((padicValInt_dvd_iff (p:=2) w _).mp h1).resolve_left hc
  have hb : ¬ w+1 ≤ padicValInt 2 j.center := by
    intro hh
    exact h2 ((padicValInt_dvd_iff (p:=2) (w+1) _).mpr (Or.inr hh))
  apply val_equal hn hc (by omega)
  have H := gadd (down h hp) (down (lin_good hu j) hl)
  convert H using 1 <;> simp only [Jet.eval] <;> ring

def exactJet (j : Jet) : Jet := {j with prec := 35}
def leftJet (a z : Jet) := mulJet a (exactJet z)
def rightJet (b c d : Jet) := mulJet (mulJet (addOne b) (addOne c)) (addOne d)

abbrev StepOK (a b c d z : Jet) (w : ℕ) : Prop :=
  z.prec+w ≤ (leftJet a z).prec ∧ z.prec+w ≤ (rightJet b c d).prec ∧
    CoeffClose (z.prec+w) (rightJet b c d) (leftJet a z)

private theorem advance {u : Fin 4 → ℚ} (hu : ∀ i, Good 0 (u i))
    {a b c d z : Jet} {A B C D Z : ℚ} {w : ℕ}
    (ok : StepOK a b c d z w) (hv : ValOK a w)
    (ha : Valid u a A) (hb : Valid u b B) (hc : Valid u c C) (hd : Valid u d D)
    (hn : A ≠ 0) (hr : Z*A = (B+1)*(C+1)*(D+1)) : Valid u z Z := by
  have HL : Valid u (leftJet a z) (A*z.eval u) := by
    apply mul_valid hu ha
    exact Or.inl (sub_self _)
  have HR : Valid u (rightJet b c d) ((B+1)*(C+1)*(D+1)) :=
    mul_valid hu (mul_valid hu (addOne_valid hb) (addOne_valid hc)) (addOne_valid hd)
  have H := gadd (gadd (down HR ok.2.1) (coeff_close hu ok.2.2)) (gneg (down HL ok.1))
  have H' : Good (z.prec+w) (A*(Z-z.eval u)) := by
    rw [← hr] at H
    convert H using 1 <;> ring
  by_cases hz : Z-z.eval u = 0
  · exact Or.inl hz
  have hl := H'.resolve_left (mul_ne_zero hn hz)
  rw [padicValRat.mul hn hz, jet_val hu hv ha hn] at hl
  exact Or.inr (by omega)

