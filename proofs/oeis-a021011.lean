theorem window (n : ℕ) : 0 < b n ∧ -b n < 2 * (b (n + 1) ^ 2 - b n * b (n + 2)) ∧
    2 * (b (n + 1) ^ 2 - b n * b (n + 2)) ≤ b n := by
  rcases Nat.lt_or_ge n 30 with hn | hn
  · exact early n hn
  · obtain ⟨hp, -, hV⟩ := invar n hn
    have hd := dbound (DU n) (DU (n + 1)) (DU (n + 2)) (DU (n + 3)) (DU (n + 4)) (DU (n + 5)) (DU (n + 6)) (DU (n + 7)) (DU (n + 8)) (DU (n + 9)) (DU (n + 10)) (DU (n + 11)) (DU (n + 12)) (DU (n + 13)) (DU (n + 14))
    have hsq0 : 4 * DU n ^ 2 < Uq n ^ 2 := by linarith [pow_pos hp 2, hd, hV]
    have hsq : (2 * DU n) ^ 2 < Uq n ^ 2 := by
      have e2 : (2 * DU n) ^ 2 = 4 * DU n ^ 2 := by ring
      rw [e2]
      exact hsq0
    obtain ⟨hw1, hw2⟩ := abs_lt_of_sq_lt_sq' hsq hp.le
    have eD : DU n = (b (n + 1) : ℚ) ^ 2 - (b n : ℚ) * (b (n + 2) : ℚ) := rfl
    have eU : Uq n = (b n : ℚ) := rfl
    rw [eD] at hw1 hw2
    rw [eU] at hp hw1 hw2
    refine ⟨by exact_mod_cast hp, by exact_mod_cast hw1, by exact_mod_cast hw2.le⟩

theorem ceil_lem (x y m : ℤ) (hy : 0 < y) (h1 : -y < 2 * (x - y * m)) (h2 : 2 * (x - y * m) ≤ y) :
    ⌈(x : ℚ) / (y : ℚ) - 1 / 2⌉ = m := by
  have hy' : (0 : ℚ) < y := by exact_mod_cast hy
  have h1' : -(y : ℚ) < 2 * ((x : ℚ) - (y : ℚ) * (m : ℚ)) := by exact_mod_cast h1
  have h2' : 2 * ((x : ℚ) - (y : ℚ) * (m : ℚ)) ≤ (y : ℚ) := by exact_mod_cast h2
  rw [Int.ceil_eq_iff]
  constructor
  · have h3 : (m : ℚ) - 1 / 2 < (x : ℚ) / (y : ℚ) := by
      rw [lt_div_iff₀ hy']
      linarith
    linarith
  · have h3 : (x : ℚ) / (y : ℚ) ≤ (m : ℚ) + 1 / 2 := by
      rw [div_le_iff₀ hy']
      linarith
    linarith

