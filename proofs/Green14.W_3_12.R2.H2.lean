theorem OMA.solution : OMA.R_Green14_W_3_12_R2.H2 := by
  intro r hr
  change Mono r
  by_contra hn
  have tf := triple_free hn
  have bound : ∀ x, Red r x → x ≤ 134 := fun x hx => by have := hx.1; omega
  rcases hr with ⟨h66,h68⟩ | ⟨h66,h68,h67⟩
  · have r66 : Red r 66 := ⟨by decide,h66⟩
    have r68 : Red r 68 := ⟨by decide,h68⟩
    refine roots.1 (Red r) bound tf (hit_all hn) ?_ ?_
    · change Good (Red r) (join (mark 66) (mark 68))
      exact join_good (mark_good tf r66 (by decide)) (mark_good tf r68 (by decide))
    · intro x hx
      have b : ∀ i : Fin 135, i.val ≠ 64 → i.val ≠ 67 → i.val ≠ 70 →
          (0x7fffffffffffffffb6ffffffffffffffff : ℕ).testBit i.val = true := by decide +kernel
      exact b ⟨x,hx.1⟩ (by rintro rfl; exact tf 64 2 (by decide) hx r66 r68)
        (by rintro rfl; exact tf 66 1 (by decide) r66 hx r68)
        (by rintro rfl; exact tf 66 2 (by decide) r66 r68 hx)
  · have r67 : Red r 67 := ⟨by decide,h67⟩
    refine roots.2 (Red r) bound tf (hit_all hn) ?_ ?_
    · change Good (Red r) (mark 67)
      exact mark_good tf r67 (by decide)
