import OMAReductions.R_Green14_W_3_12_R2

/-! Finite search for the two remaining middle patterns on the 135 positions.
A red point has color false: red points contain no three-term progression and
meet every twelve-term progression. Coordinate masks give the points that a new
red point forbids, forced windows are found by shifts, and a tape of split
positions, with gates to earlier subtrees, shows that every branch closes. -/

namespace OMA.W312H2
private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  red : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (134-q), 1 <<< (2*q),
    if q%2=0 then 1 <<< (q/2) else 0,
    if q%2=1 then 1 <<< (q/2) else 0, 1 <<< q⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od, s.red ||| t.red⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (2*p)) >>> 134) ||| (s.dbl >>> p) |||
    ((if p%2=0 then s.ev else s.od) <<< ((p+1)/2))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit t = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 134) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< p))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 134) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit x = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit x = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit x = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

-- Every twelve-term progression inside the positions meets R.
private def Hits (R : Nat → Prop) :=
  ∀ d a, 0 < d → a + 11*d < 135 → ∃ i, i ≤ 11 ∧ R (a + i*d)

private def AllBad : List (Marks × Nat) → Prop
  | [] => True
  | s :: ss => Bad Hits s ∧ AllBad ss

private def gate : List (Marks × Nat) → Nat → Marks × Nat → Bool
  | [], _, _ => false
  | l :: _, 0, s => l == s
  | _ :: ls, k+1, s => gate ls k s

private lemma gate_sound : ∀ (leaves : List (Marks × Nat)), AllBad leaves →
    ∀ k s, gate leaves k s = true → Bad Hits s
  | [], _, _, _, h => by simp [gate] at h
  | l :: _, hl, 0, s, h => by
    simp only [gate] at h
    exact (beq_iff_eq.mp h) ▸ hl.1
  | _ :: ls, hl, k+1, s, h => gate_sound ls hl.2 k s (by simpa [gate] using h)

/- The checker below uses the primitive `Nat` operations and `Bool` branches
directly, which the kernel evaluates much faster than the operator classes. -/

private theorem cond_beq {α : Type} (c k : Nat) (A B : α) :
    (bif Nat.beq c k then A else B) = if c = k then A else B := by
  cases hb : Nat.beq c k
  · simp [Nat.ne_of_beq_eq_false hb]
  · simp [Nat.eq_of_beq_eq_true hb]

private def markF (q : Nat) : Marks :=
  ⟨Nat.shiftLeft 1 (Nat.sub 134 q), Nat.shiftLeft 1 (Nat.mul 2 q),
    bif Nat.beq (Nat.mod q 2) 0 then Nat.shiftLeft 1 (Nat.div q 2) else 0,
    bif Nat.beq (Nat.mod q 2) 1 then Nat.shiftLeft 1 (Nat.div q 2) else 0, Nat.shiftLeft 1 q⟩

private theorem markF_eq (q : Nat) : markF q = mark q := by
  simp only [markF, mark, cond_beq]
  rfl

private def joinF (s t : Marks) : Marks :=
  ⟨Nat.lor s.rev t.rev, Nat.lor s.dbl t.dbl, Nat.lor s.ev t.ev, Nat.lor s.od t.od,
    Nat.lor s.red t.red⟩

private def forbiddenF (s : Marks) (p : Nat) : Nat :=
  Nat.lor (Nat.lor (Nat.shiftRight (Nat.shiftLeft s.rev (Nat.mul 2 p)) 134) (Nat.shiftRight s.dbl p))
    (Nat.shiftLeft (bif Nat.beq (Nat.mod p 2) 0 then s.ev else s.od) (Nat.div (Nat.add p 1) 2))

private def addRedF (s : Marks) (a p : Nat) : Marks × Nat :=
  (joinF s (markF p), Nat.lor (Nat.xor a (Nat.land a (forbiddenF s p))) (Nat.shiftLeft 1 p))

private theorem addRedF_eq (s : Marks) (a p : Nat) : addRedF s a p = addRed s a p := by
  have hf : forbiddenF s p = forbidden s p := by
    simp only [forbiddenF, forbidden, cond_beq]
    rfl
  simp only [addRedF, hf, markF_eq]
  rfl

-- Highest set bit by binary search (0 for 0).
private def ilogStep (k : Nat) (x : Nat × Nat) : Nat × Nat :=
  bif Nat.beq (Nat.shiftRight x.1 k) 0 then x else (Nat.shiftRight x.1 k, Nat.add x.2 k)

private def ilog (n : Nat) : Nat :=
  (ilogStep 1 (ilogStep 2 (ilogStep 4 (ilogStep 8 (ilogStep 16 (ilogStep 32
    (ilogStep 64 (ilogStep 128 (n,0))))))))).2

-- Starts of the twelve-term windows of difference d inside the 135 positions.
private def validMask (d : Nat) : Nat := Nat.sub (Nat.shiftLeft 1 (Nat.sub 135 (Nat.mul 11 d))) 1

-- The bits of h count nonempty windows, and the bits of m indicate
-- windows with two available points or with a red point already marked.
-- Starts outside the returned mask are the windows the checker looks at.
private def startMask (red allow d : Nat) : Nat :=
  let h2 := Nat.lor allow (Nat.shiftRight allow d)
  let h4 := Nat.lor h2 (Nat.shiftRight h2 (Nat.mul 2 d))
  let h8 := Nat.lor h4 (Nat.shiftRight h4 (Nat.mul 4 d))
  let h12 := Nat.lor h8 (Nat.shiftRight h4 (Nat.mul 8 d))
  bif Nat.beq (Nat.xor (validMask d) (Nat.land (validMask d) h12)) 0 then
    let m2 := Nat.lor (Nat.lor red (Nat.shiftRight red d)) (Nat.land allow (Nat.shiftRight allow d))
    let m4 := Nat.lor (Nat.lor m2 (Nat.shiftRight m2 (Nat.mul 2 d)))
      (Nat.land h2 (Nat.shiftRight h2 (Nat.mul 2 d)))
    let m8 := Nat.lor (Nat.lor m4 (Nat.shiftRight m4 (Nat.mul 4 d)))
      (Nat.land h4 (Nat.shiftRight h4 (Nat.mul 4 d)))
    Nat.lor (Nat.lor m8 (Nat.shiftRight m4 (Nat.mul 8 d)))
      (Nat.land h8 (Nat.shiftRight h4 (Nat.mul 8 d)))
  else h12

private def lowbit (u : Nat) : Nat := Nat.land u (Nat.xor u (Nat.sub u 1))

-- The union of the windows of difference d starting at the bits of u.
private def spread (d u : Nat) : Nat :=
  let s2 := Nat.lor u (Nat.shiftLeft u (Nat.mul 1 d))
  let s4 := Nat.lor s2 (Nat.shiftLeft s2 (Nat.mul 2 d))
  let s8 := Nat.lor s4 (Nat.shiftLeft s4 (Nat.mul 4 d))
  Nat.lor s8 (Nat.shiftLeft s8 (Nat.mul 4 d))

private def probeR (s : Marks × Nat) (rest : Nat) : Nat :=
  bif Nat.beq rest 0 then 1 else
    bif Nat.beq (Nat.land rest (Nat.sub rest 1)) 0 && Nat.beq (Nat.land rest s.1.red) 0 &&
      Nat.beq rest (Nat.shiftLeft 1 (ilog rest))
    then Nat.add (ilog rest) 2 else 0

private def probeU (s : Marks × Nat) (d u : Nat) : Nat :=
  bif Nat.beq u 0 then 0 else probeR s (Nat.land (spread d u) s.2)

-- One forced-window test: 1 means an empty window, p+2 means p is forced red.
private def probe (s : Marks × Nat) (d : Nat) : Nat :=
  probeU s d (lowbit (Nat.xor (validMask d) (Nat.land (validMask d) (startMask s.1.red s.2 d))))

private lemma spread_step {x a d n : Nat} (h : ∀ i < n, x.testBit (a + i*d) = true) (m : Nat)
    (hm : m ≤ n) : ∀ i < n + m, (Nat.lor x (Nat.shiftLeft x (Nat.mul m d))).testBit (a + i*d) = true := by
  intro i hi
  change (x ||| x <<< (m*d)).testBit (a + i*d) = true
  rw [Nat.testBit_or, Bool.or_eq_true]
  by_cases hin : i < n
  · exact Or.inl (h i hin)
  · right
    have hmi : m ≤ i := by omega
    have hle : m*d ≤ i*d := Nat.mul_le_mul_right d hmi
    rw [Nat.testBit_shiftLeft]
    simp only [Bool.and_eq_true, decide_eq_true_eq]
    refine ⟨by omega, ?_⟩
    have e : a + i*d - m*d = a + (i-m)*d := by rw [Nat.sub_mul]; omega
    rw [e]
    exact h (i-m) (by omega)

private lemma spread_bit {d u a : Nat} (hu : u.testBit a = true) :
    ∀ i < 12, (spread d u).testBit (a + i*d) = true := by
  have h1 : ∀ i < 1, u.testBit (a + i*d) = true := by
    intro i hi
    have : i = 0 := by omega
    subst this
    simpa using hu
  exact spread_step (spread_step (spread_step (spread_step h1 1 le_rfl) 2 le_rfl) 4 le_rfl) 4
    (by omega)

private lemma start_bit {e M a : Nat}
    (h : (lowbit (Nat.xor (validMask e) (Nat.land (validMask e) M))).testBit a = true) :
    a + 11*e < 135 := by
  change ((validMask e ^^^ (validMask e &&& M)) &&& _).testBit a = true at h
  rw [Nat.testBit_and, Bool.and_eq_true, Nat.testBit_xor, Nat.testBit_and] at h
  have hv : (validMask e).testBit a = true := by
    cases hva : (validMask e).testBit a <;> simp_all
  change (1 <<< (135 - 11*e) - 1).testBit a = true at hv
  rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow_sub_one] at hv
  have := of_decide_eq_true hv
  omega

private lemma probe_sound {R : Nat → Prop} (hit : Hits R) {s : Marks × Nat}
    (ha : ∀ x, R x → s.2.testBit x = true) {e v : Nat} (he1 : 1 ≤ e) (hv : probe s e = v)
    (h0 : v ≠ 0) : 2 ≤ v ∧ R (v-2) := by
  unfold probe probeU at hv
  generalize startMask s.1.red s.2 e = M at hv
  generalize hu : lowbit (Nat.xor (validMask e) (Nat.land (validMask e) M)) = u at hv
  cases hu0 : Nat.beq u 0
  · simp only [hu0, cond_false] at hv
    obtain ⟨a, hua⟩ := Nat.exists_testBit_of_ne_zero (Nat.ne_of_beq_eq_false hu0)
    have hlt := start_bit (hu ▸ hua)
    obtain ⟨i, hi, hR⟩ := hit e a (by omega) hlt
    have hsp := spread_bit (d := e) hua i (by omega)
    have hrest : (Nat.land (spread e u) s.2).testBit (a+i*e) = true := by
      change ((spread e u) &&& s.2).testBit _ = true
      simp [Nat.testBit_and, hsp, ha _ hR]
    generalize Nat.land (spread e u) s.2 = rest at hrest hv
    unfold probeR at hv
    cases h1 : Nat.beq rest 0
    · cases h2 : (Nat.beq (Nat.land rest (Nat.sub rest 1)) 0 && Nat.beq (Nat.land rest s.1.red) 0 &&
          Nat.beq rest (Nat.shiftLeft 1 (ilog rest)))
      · simp only [h1, h2, cond_false] at hv
        omega
      · simp only [h1, h2, cond_false, cond_true] at hv
        simp only [Bool.and_eq_true] at h2
        have hpow : rest = 1 <<< ilog rest := Nat.eq_of_beq_eq_true h2.2
        rw [hpow, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hrest
        have he' : ilog rest = a + i*e := of_decide_eq_true hrest
        subst hv
        change 2 ≤ ilog rest + 2 ∧ R (ilog rest + 2 - 2)
        refine ⟨by omega, ?_⟩
        rw [Nat.add_sub_cancel, he']
        exact hR
    · have : rest = 0 := Nat.eq_of_beq_eq_true h1
      simp [this] at hrest
  · simp only [hu0, cond_true] at hv
    exact absurd hv.symm h0

private def orElse (v w : Nat) : Nat := bif Nat.beq v 0 then w else v

private def scan (s : Marks × Nat) : Nat :=
  orElse (probe s 1) (orElse (probe s 2) (orElse (probe s 3) (orElse (probe s 4)
    (orElse (probe s 5) (orElse (probe s 6) (orElse (probe s 7) (orElse (probe s 8)
    (orElse (probe s 9) (orElse (probe s 10) (orElse (probe s 11) 0))))))))))

private lemma orElse_spec {s : Marks × Nat} {v w : Nat} (hv : ∃ e, 1 ≤ e ∧ probe s e = v)
    (hw : w ≠ 0 → ∃ e, 1 ≤ e ∧ probe s e = w) :
    orElse v w ≠ 0 → ∃ e, 1 ≤ e ∧ probe s e = orElse v w := by
  unfold orElse
  rw [cond_beq]
  split
  · exact hw
  · exact fun _ => hv

private lemma scan_spec (s : Marks × Nat) : scan s ≠ 0 → ∃ e, 1 ≤ e ∧ probe s e = scan s :=
  orElse_spec ⟨1,by decide,rfl⟩ (orElse_spec ⟨2,by decide,rfl⟩ (orElse_spec ⟨3,by decide,rfl⟩ (orElse_spec ⟨4,by decide,rfl⟩ (orElse_spec ⟨5,by decide,rfl⟩ (orElse_spec ⟨6,by decide,rfl⟩ (orElse_spec ⟨7,by decide,rfl⟩ (orElse_spec ⟨8,by decide,rfl⟩ (orElse_spec ⟨9,by decide,rfl⟩ (orElse_spec ⟨10,by decide,rfl⟩ (orElse_spec ⟨11,by decide,rfl⟩ (fun h => absurd rfl h)))))))))))

private def word (tape : Nat) (i : Nat) := Nat.mod (Nat.shiftRight tape i) 256

private def walk (leaves : List (Marks × Nat)) (tape : Nat) :
    Nat → Nat → Marks × Nat → Nat
  | 0, _, _ => 0
  | gas+1, i, s =>
    let v := scan s
    bif Nat.beq v 1 then i else
    bif Nat.beq v 0 then
      let p := word tape i
      bif Nat.blt p 135 then
        let next := walk leaves tape gas (Nat.add i 8) (addRedF s.1 s.2 p)
        bif Nat.beq next 0 then 0 else
          walk leaves tape gas next (s.1, Nat.xor s.2 (Nat.land s.2 (Nat.shiftLeft 1 p)))
      else bif gate leaves (Nat.sub p 135) s then Nat.add i 8 else 0
    else walk leaves tape gas i (addRedF s.1 s.2 (Nat.sub v 2))

private lemma walk_sound {tape : Nat} (leaves : List (Marks × Nat)) (hl0 : AllBad leaves)
    (g i : Nat) (s : Marks × Nat) (hw : walk leaves tape g i s ≠ 0) : Bad Hits s := by
  induction g generalizing i s with
  | zero => simp [walk] at hw
  | succ g ih =>
    intro R bound hn hit hs ha
    simp only [walk] at hw
    cases h1 : Nat.beq (scan s) 1
    · simp only [h1, cond_false] at hw
      cases h0 : Nat.beq (scan s) 0
      · simp only [h0, cond_false] at hw
        have h0' := Nat.ne_of_beq_eq_false h0
        obtain ⟨e,he1,he⟩ := scan_spec s h0'
        obtain ⟨-,hp⟩ := probe_sound hit ha he1 he h0'
        rw [addRedF_eq] at hw
        exact ih _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
      · simp only [h0, cond_true] at hw
        cases hb : Nat.blt (word tape i) 135
        · simp only [hb, cond_false] at hw
          cases hg : gate leaves (word tape i - 135) s
          · simp [hg] at hw
          · exact gate_sound leaves hl0 _ s hg R bound hn hit hs ha
        · simp only [hb, cond_true] at hw
          cases hl : Nat.beq (walk leaves tape g (Nat.add i 8) (addRedF s.1 s.2 (word tape i))) 0
          · simp only [hl, cond_false] at hw
            have hleft := Nat.ne_of_beq_eq_false hl
            rw [addRedF_eq] at hleft
            let p := word tape i
            by_cases hp : R p
            · exact ih _ _ hleft R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
            · apply ih _ _ hw R bound hn hit hs
              intro t ht
              have ne : p ≠ t := fun e => hp (e ▸ ht)
              change (s.2 ^^^ (s.2 &&& (1 <<< p))).testBit t = true
              simp [Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, ne]
          · simp [hl] at hw
    · have h1' : scan s = 1 := Nat.eq_of_beq_eq_true h1
      obtain ⟨e,he1,he⟩ := scan_spec s (by omega)
      have := probe_sound hit ha he1 he (by omega)
      omega

private lemma certify {s : Marks × Nat} (tape : Nat) (leaves : List (Marks × Nat))
    (hl : AllBad leaves) (h : walk leaves tape 145 1 s ≠ 0) : Bad Hits s :=
  walk_sound leaves hl 145 1 s h

