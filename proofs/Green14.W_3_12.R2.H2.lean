private lemma of_not_false {b : Bool} (h : b = false → False) : b = true := by
  cases b <;> simp_all

private def Mono (r : ℕ → Bool) : Prop :=
  ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2)*d < 135 ∧
    ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b

private def Red (r : ℕ → Bool) (x : ℕ) := x < 135 ∧ r x = false

private lemma triple_free {r : ℕ → Bool} (hn : ¬ Mono r) : NoTriple (Red r) := by
  intro a d hd h₀ h₁ h₂
  apply hn
  refine ⟨false,a,d,hd,by change a+2*d < 135; exact h₂.1,?_⟩
  intro t ht
  change t ≤ 2 at ht
  rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with e|e|e
  · simpa [e] using h₀.2
  · simpa [e] using h₁.2
  · simpa [e] using h₂.2

private lemma hit_all {r : ℕ → Bool} (hn : ¬ Mono r) : Hits (Red r) := by
  intro d a hd hb
  by_contra! bad
  apply hn
  refine ⟨true,a,d,hd,by change a+11*d < 135; omega,?_⟩
  intro t ht
  change t ≤ 11 at ht
  have hmul := Nat.mul_le_mul_right d ht
  apply of_not_false
  intro hf
  exact bad t ht ⟨by omega,hf⟩

end OMA.W312H2

