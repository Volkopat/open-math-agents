private theorem allCert (q : ℕ) (hq : q < 40) :
    (List.range 128).all (fun r => flag (q*128+r) (row q r)) = true := by
  interval_cases q
  · exact cert0
  · exact cert1
  · exact cert2
  · exact cert3
  · exact cert4
  · exact cert5
  · exact cert6
  · exact cert7
  · exact cert8
  · exact cert9
  · exact cert10
