private def row (q r : ℕ) : ℕ := (word q >>> (26*r)) % 2^26

set_option maxRecDepth 20000 in
set_option maxHeartbeats 400000000 in
private def flag (n w : ℕ) : Bool :=
  if 20 < n ∧ n ≤ 5000 then
    let k := w % 8192
    let u := w / 8192
    decide (0 < k ∧ 2*k < n ∧ tot k * tot (n-k) + 1 = u*u)
  else true


