set_option maxHeartbeats 400000000 in
private def tot (n : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors, p ^ (n.primeFactorsList.count p - 1) * (p - 1)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 400000000 in
private theorem tot_eq {n : ℕ} (hn : n ≠ 0) : tot n = n.totient := by
  rw [Nat.totient_eq_prod_factorization hn]
  simp [tot, Finsupp.prod]

