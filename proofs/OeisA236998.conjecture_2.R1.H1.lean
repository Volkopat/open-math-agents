set_option maxRecDepth 20000 in
set_option maxHeartbeats 400000000 in
theorem bounded : ∀ n : ℕ, 20 < n → n ≤ 5000 →
    ∃ k : ℕ, 0 < k ∧ 2*k < n ∧ IsSquare (k.totient * (n-k).totient + 1) := by
  intro n hn hN
  let q := n / 128
  let r := n % 128
  let w := row q r
  have hq : q < 40 := by dsimp [q]; omega
  have hr : r < 128 := Nat.mod_lt _ (by decide)
  have he : q*128+r=n := by dsimp [q,r]; omega
  have hs := List.all_eq_true.mp (allCert q hq) r (List.mem_range.mpr hr)
  change flag (q*128+r) w = true at hs
  rw [he, flag, if_pos ⟨hn,hN⟩] at hs
  obtain ⟨hp,hk,hu⟩ := of_decide_eq_true hs
  have hk' : w % 8192 ≠ 0 := by omega
  have hnk : n - w % 8192 ≠ 0 := by omega
  rw [tot_eq hk',tot_eq hnk] at hu
  exact ⟨w % 8192,hp,hk,w / 8192,hu⟩

end TotientProductSquares

