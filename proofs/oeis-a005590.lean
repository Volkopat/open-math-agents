import OMAStatements.S_oeis_a005590

/-!
# The zero set of the signed Stern recurrence

Ralf Stephan's 2003 conjecture is recorded in https://oeis.org/A005590.
Loning's 2026 TrureTuring proof uses the adjacent-pair sign invariant
x(x−y) ≥ 0 and the fact that x and y do not vanish together. We follow
that mathematical argument with the definitions of this project:
https://www.trureturing.org/research/oeis-a005590-zero-set-fibbinary-characterization/

For every index m, a(m)=0 exactly when m is generated by appending zero
bits or pairs of one bits, equivalently when m=3n with n fibbinary.
In particular each zero is followed by 1. Below 2^k there are exactly
Fibonacci(k+1) zero indices and Fibonacci(k+2) fibbinary indices.
-/

namespace Stern5590
open OMA.S_oeis_a005590

theorem zero_rec : a 0=0 := by rw [a]
theorem one_rec : a 1=1 := by rw [a]

theorem even_rec (n : ℕ) : a (2*n)=a n := by
  cases n with
  | zero => rfl
  | succ n =>
    have he : Even (2*n+2) := ⟨n+1,by omega⟩
    rw [show 2*(n+1)=2*n+2 by omega,a,if_pos he]
    congr 1
    omega

theorem odd_rec (n : ℕ) : a (2*n+1)=a (n+1)-a n := by
  cases n with
  | zero => simp only [Nat.mul_zero,Nat.zero_add,one_rec,zero_rec,sub_zero]
  | succ n =>
    have ho : ¬Even ((2*n+1)+2) := by rintro ⟨t,ht⟩; omega
    rw [show 2*(n+1)+1=(2*n+1)+2 by omega,a,if_neg ho,
      show (2*n+1+1)/2=n+1 by omega]

theorem four_three (n : ℕ) : a (4*n+3)=a n := by
  rw [show 4*n+3=2*(2*n+1)+1 by omega,odd_rec,
    show 2*n+1+1=2*(n+1) by omega,even_rec,odd_rec]
  ring

end Stern5590

namespace Stern5590

open OMA.S_oeis_a005590

private theorem and_zero_iff_halves (a b : ℕ) :
    a &&& b = 0 ↔ (a / 2 &&& b / 2) = 0 ∧ (a % 2 = 0 ∨ b % 2 = 0) := by
  have hdiv := Nat.and_div_two (a := a) (b := b)
  have hbit := Nat.and_mod_two_eq_one (a := a) (b := b)
  omega

theorem fib_double (n : ℕ) : IsFibbinary (2*n) ↔ IsFibbinary n := by
  change 2*n &&& ((2*n)/2) = 0 ↔ n &&& (n/2) = 0
  rw [and_zero_iff_halves]
  simp

theorem fib_double_add_one (n : ℕ) :
    IsFibbinary (2*n+1) ↔ IsFibbinary n ∧ Even n := by
  change (2*n+1) &&& ((2*n+1)/2) = 0 ↔ n &&& (n/2) = 0 ∧ Even n
  rw [and_zero_iff_halves, Nat.even_iff]
  have h : (2*n+1)/2 = n := by omega
  have h' : (2*n+1)%2 = 1 := by omega
  simp [h,h']

theorem fib_four_add_one (n : ℕ) : IsFibbinary (4*n+1) ↔ IsFibbinary n := by
  rw [show 4*n+1 = 2*(2*n)+1 by omega, fib_double_add_one, fib_double]
  simp

theorem not_fib_four_add_three (n : ℕ) : ¬ IsFibbinary (4*n+3) := by
  rw [show 4*n+3 = 2*(2*n+1)+1 by omega, fib_double_add_one, Nat.even_iff]
  omega

/-- The binary language generated by appending a zero or by appending a pair of ones. -/
inductive Paired : ℕ → Prop
  | zero : Paired 0
  | appendZero {k : ℕ} : Paired k → Paired (2*k)
  | appendOnes {k : ℕ} : Paired k → Paired (4*k+3)

theorem paired_of_fib (n : ℕ) (h : IsFibbinary n) : Paired (3*n) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · exact Paired.zero
    · by_cases hn : (n+1)%2 = 0
      · obtain ⟨m,hm⟩ : ∃ m, n+1 = 2*m := ⟨(n+1)/2,by omega⟩
        rw [hm] at h ⊢
        rw [show 3*(2*m) = 2*(3*m) by omega]
        exact .appendZero (ih m (by omega) ((fib_double m).mp h))
      · obtain ⟨m,hm⟩ : ∃ m, n+1 = 2*m+1 := ⟨(n+1)/2,by omega⟩
        rw [hm, fib_double_add_one] at h
        obtain ⟨k,hk⟩ := h.2
        have hm' : m = 2*k := by omega
        rw [hm,hm',show 3*(2*(2*k)+1) = 4*(3*k)+3 by omega]
        exact .appendOnes (ih k (by omega) ((fib_double k).mp (hm' ▸ h.1)))

theorem paired_inverse {k : ℕ} (h : Paired k) : ∃ n, k = 3*n ∧ IsFibbinary n := by
  induction h with
  | zero => exact ⟨0, rfl, rfl⟩
  | @appendZero k _ ih =>
    obtain ⟨n,rfl,hn⟩ := ih
    exact ⟨2*n,by omega,(fib_double n).mpr hn⟩
  | @appendOnes k _ ih =>
    obtain ⟨n,rfl,hn⟩ := ih
    exact ⟨4*n+1,by omega,(fib_four_add_one n).mpr hn⟩

theorem paired_iff_fib (n : ℕ) : Paired (3*n) ↔ IsFibbinary n := by
  constructor
  · intro h
    obtain ⟨m,hm,ha⟩ := paired_inverse h
    rwa [show n=m by omega]
  · exact paired_of_fib n

end Stern5590

namespace Stern5590

open OMA.S_oeis_a005590

/-- The adjacent values never vanish together. Their quadratic invariant is
nonnegative: a zero-bit extension adds a square and a one-bit extension preserves it. -/
theorem adjacent_invariant (n : ℕ) :
    0 ≤ a n * (a n - a (n+1)) ∧ (a n ≠ 0 ∨ a (n+1) ≠ 0) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n=0
    · subst n
      decide +kernel
    let m := n/2
    have hm : m<n := by dsimp [m]; omega
    obtain ⟨quad, nz⟩ := ih m hm
    rcases Nat.mod_two_eq_zero_or_one n with parity | parity
    · have en : n=2*m := by dsimp [m]; omega
      rw [en, even_rec, odd_rec]
      constructor
      · nlinarith [sq_nonneg (a m)]
      · omega
    · have en : n=2*m+1 := by dsimp [m]; omega
      rw [en, show 2*m+1+1=2*(m+1) by omega, odd_rec, even_rec]
      constructor
      · nlinarith
      · omega

/-- An index ending in the two binary digits 01 cannot be a zero. -/
theorem nonzero_four_one (n : ℕ) : a (4*n+1) ≠ 0 := by
  obtain ⟨quad, nz⟩ := adjacent_invariant n
  rw [show 4*n+1=2*(2*n)+1 by omega, odd_rec, odd_rec, even_rec]
  intro h
  have hx : a n = 0 := by
    have he : a (n+1)=2*a n := by omega
    rw [he] at quad
    nlinarith [sq_nonneg (a n)]
  omega

end Stern5590

namespace Stern5590
open OMA.S_oeis_a005590

/-- A zero index can be read from right to left by deleting a single
terminal zero or a pair of terminal ones until reaching the empty word. -/
theorem zero_iff_paired (m : ℕ) : a m=0 ↔ Paired m := by
  constructor
  · intro hz
    induction m using Nat.strong_induction_on with
    | h m ih =>
      by_cases h0 : m=0
      · subst m; exact Paired.zero
      by_cases he : m%2=0
      · have eq : m=2*(m/2) := by omega
        refine eq ▸ Paired.appendZero (ih (m/2) (by omega) ?_)
        simpa only [←eq] using (even_rec (m/2)).symm.trans (by rwa [←eq])
      by_cases h1 : m%4=1
      · have eq : m=4*(m/4)+1 := by omega
        exact False.elim (nonzero_four_one (m/4) (by rwa [←eq]))
      · have eq : m=4*(m/4)+3 := by omega
        refine eq ▸ Paired.appendOnes (ih (m/4) (by omega) ?_)
        exact (four_three (m/4)).symm.trans (by rwa [←eq])
  · intro hp
    induction hp with
    | zero => exact zero_rec
    | appendZero _ ih => exact (even_rec _).trans ih
    | appendOnes _ ih => exact (four_three _).trans ih

theorem all_zero_indices (m : ℕ) : a m=0 ↔ ∃ n : ℕ, m=3*n ∧ IsFibbinary n := by
  rw [zero_iff_paired]
  constructor
  · exact paired_inverse
  · rintro ⟨n,rfl,hn⟩
    exact paired_of_fib n hn

theorem triple_zero (n : ℕ) : a (3*n)=0 ↔ IsFibbinary n :=
  (zero_iff_paired _).trans (paired_iff_fib n)

end Stern5590

namespace Stern5590
open OMA.S_oeis_a005590

theorem right_of_zero {m : ℕ} (hz : a m=0) : a (m+1)=1 := by
  have hp := (zero_iff_paired m).mp hz
  clear hz
  induction hp with
  | zero => exact one_rec
  | @appendZero k hk ih =>
    rw [odd_rec, (zero_iff_paired k).mpr hk,ih,sub_zero]
  | @appendOnes k _ ih =>
    rw [show 4*k+3+1=2*(2*(k+1)) by omega,even_rec,even_rec,ih]

/-- A zero with an odd index has left neighbor 1. Doubling the index
alternates this sign, since a(2m−1)=a(m)−a(m−1) for positive m. -/
theorem left_of_zero_power (k e : ℕ) (h : Paired k) :
    a (2^e*(4*k+3)-1)=(-1:ℤ)^e := by
  have hk := (zero_iff_paired k).mpr h
  have hz : ∀ j : ℕ, a (2^j*(4*k+3))=0 := by
    intro j
    induction j with
    | zero => simpa only [pow_zero,one_mul] using (four_three k).trans hk
    | succ j ih => rw [pow_succ',mul_assoc,even_rec,ih]
  induction e with
  | zero =>
    have hR := right_of_zero hk
    rw [pow_zero,one_mul,show 4*k+3-1=2*(2*k+1) by omega,even_rec,odd_rec,hR,hk]
    norm_num
  | succ e ih =>
    let m := 2^e*(4*k+3)
    have hm : 0 < m := by dsimp [m]; positivity
    change a (2^(e+1)*(4*k+3)-1)=_
    rw [pow_succ',mul_assoc,show 2*(2^e*(4*k+3))-1=2*(m-1)+1 by change 2*m-1=2*(m-1)+1; omega,
      odd_rec,show m-1+1=m by omega]
    change a (2^e*(4*k+3))-a (2^e*(4*k+3)-1)=_
    rw [hz,ih,pow_succ]
    ring

end Stern5590

namespace Stern5590
open Finset OMA.S_oeis_a005590

theorem dyadic_word_count (P : ℕ → Prop) [DecidablePred P] (b : ℕ)
    (h0 : (if P 0 then 1 else 0) = Nat.fib b)
    (h1 : (if P 0 then 1 else 0) + (if P 1 then 1 else 0) = Nat.fib (b+1))
    (he : ∀ n, P (2*n) ↔ P n)
    (ho : ∀ n, (if P (4*n+1) then 1 else 0) + (if P (4*n+3) then 1 else 0) =
      (if P n then 1 else 0 : ℕ))
    (k : ℕ) : ((range (2^k)).filter P).card = Nat.fib (b+k) := by
  let f (n : ℕ) : ℕ := if P n then 1 else 0
  let C (s : ℕ) := ∑ i ∈ range (2^s), f i
  have split (g : ℕ → ℕ) (N : ℕ) :
      (∑ i ∈ range (2*N), g i) = ∑ i ∈ range N, (g (2*i)+g (2*i+1)) := by
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Nat.mul_succ, sum_range_succ, sum_range_succ, ih, sum_range_succ]
      omega
  have next (j : ℕ) : C (j+2) = C j + C (j+1) := by
    have oddSum : (∑ i ∈ range (2^(j+1)), f (2*i+1)) = C j := by
      rw [pow_succ' (2:ℕ) j,split (fun i => f (2*i+1))]
      apply sum_congr rfl
      intro i _
      simpa only [f,show 2*(2*i)+1=4*i+1 by omega,
        show 2*(2*i+1)+1=4*i+3 by omega] using ho i
    have ev (i : ℕ) : f (2*i) = f i := by simp only [f,he]
    change (∑ i ∈ range (2^(j+1+1)), f i) = _
    rw [pow_succ' (2:ℕ) (j+1),split,sum_add_distrib,oddSum]
    simp only [ev,C,add_comm]
  rw [Finset.card_filter]
  change C k=Nat.fib (b+k)
  induction k using Nat.twoStepInduction with
  | zero =>
    change (∑ i ∈ range (0+1), f i) = Nat.fib (b+0)
    rw [sum_range_succ,sum_range_zero,zero_add,Nat.add_zero]
    exact h0
  | one =>
    change (∑ i ∈ range (0+1+1), f i) = Nat.fib (b+1)
    rw [sum_range_succ,sum_range_succ,sum_range_zero,zero_add]
    exact h1
  | more k hk hk' =>
    rw [next,hk,hk',show b+(k+2)=(b+k)+2 by omega,Nat.fib_add_two]
    rw [Nat.add_assoc]

open Classical in
theorem fibbinary_dyadic_count (k : ℕ) :
    ((range (2^k)).filter IsFibbinary).card = Nat.fib (k+2) := by
  have z : IsFibbinary 0 := rfl
  have o : IsFibbinary 1 := rfl
  rw [Nat.add_comm k 2]
  apply dyadic_word_count IsFibbinary 2 (by simp [z]) (by simp only [z,o,if_true]; decide) fib_double _ k
  intro n
  simp only [fib_four_add_one,not_fib_four_add_three,if_false,add_zero]

theorem zero_multiple_count (h : ∀ n, a (3*n)=0 ↔ IsFibbinary n) (k : ℕ) :
    ((range (2^k)).filter (fun n => a (3*n)=0)).card = Nat.fib (k+2) := by
  classical
  convert fibbinary_dyadic_count k using 3
  exact h _

theorem all_zeros_dyadic_count (k : ℕ) :
    ((range (2^k)).filter (fun n => a n=0)).card = Nat.fib (k+1) := by
  rw [Nat.add_comm k 1]
  apply dyadic_word_count (fun n => a n=0) 1 (by simp [zero_rec])
    (by simp [zero_rec,one_rec]) (fun n => by rw [even_rec]) _ k
  intro n
  simp [nonzero_four_one,four_three]

end Stern5590

theorem OMA.solution : type_of% @OMA.S_oeis_a005590.main :=
  Stern5590.triple_zero
