import FormalConjectures.Wikipedia.PierceBirkhoff

/-!
# A reduction of the plane Pierce–Birkhoff theorem to connectedness

Ultrafilters record simultaneous eventual polynomial signs on real points.
Two applications of compactness turn a local polynomial separator for each
pair of ultrafilters into the rectangular finite supremum of infima.
-/

namespace OMA.PB

open Filter Set
open scoped Topology

abbrev Point (n : ℕ) := Fin n → ℝ
abbrev Poly (n : ℕ) := MvPolynomial (Fin n) ℝ

variable {n : ℕ}

def HasRepresentation (f : Point n → ℝ) : Prop :=
  ∃ (ι κ : Type) (g : ι → κ → Poly n), Finite ι ∧ Finite κ ∧
    ∀ x, f x = ⨆ i, ⨅ j, MvPolynomial.eval x (g i j)

private theorem finite_cover_of_ultrafilters {X A : Type} (T : A → Set X)
    (h : ∀ a : Ultrafilter X, ∃ i, T i ∈ a) :
    ∃ s : Finset A, ∀ x, ∃ i ∈ s, x ∈ T i := by
  let U (i : A) := {a : Ultrafilter X | T i ∈ a}
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover U
    (fun i => ultrafilter_isOpen_basic (T i)) (fun a _ => mem_iUnion.mpr (h a))
  refine ⟨s, fun x => ?_⟩
  obtain ⟨i, hi⟩ := mem_iUnion.mp (hs (mem_univ (pure x : Ultrafilter X)))
  obtain ⟨his, hx⟩ := mem_iUnion.mp hi
  exact ⟨i, his, Ultrafilter.mem_pure.mp hx⟩

/-- Compactness of ultrafilter space in both arguments converts local
separation into a finite rectangular array of polynomials. -/
theorem representation_of_local {f : Point n → ℝ}
    (sep : ∀ α β : Ultrafilter (Point n), ∃ p : Poly n,
      (∀ᶠ x in α, f x ≤ MvPolynomial.eval x p) ∧
      (∀ᶠ x in β, MvPolynomial.eval x p ≤ f x)) : HasRepresentation f := by
  classical
  let Row := {s : Finset (Poly n) // ∀ x, ∃ p ∈ s, MvPolynomial.eval x p ≤ f x}
  let high (s : Row) := {x : Point n | ∀ p ∈ s.val, f x ≤ MvPolynomial.eval x p}
  have hrows (α : Ultrafilter (Point n)) : ∃ s : Row, high s ∈ α := by
    let A := {p : Poly n // ∀ᶠ x in α, f x ≤ MvPolynomial.eval x p}
    let low (p : A) := {x : Point n | MvPolynomial.eval x p.val ≤ f x}
    have hlow (β : Ultrafilter (Point n)) : ∃ p : A, low p ∈ β := by
      obtain ⟨p, hα, hβ⟩ := sep α β
      exact ⟨⟨p, hα⟩, hβ⟩
    obtain ⟨t, ht⟩ := finite_cover_of_ultrafilters low hlow
    let s := t.image Subtype.val
    have hs (x : Point n) : ∃ p ∈ s, MvPolynomial.eval x p ≤ f x := by
      obtain ⟨p, hp, hx⟩ := ht x
      exact ⟨p.val, Finset.mem_image_of_mem _ hp, hx⟩
    refine ⟨⟨s, hs⟩, ?_⟩
    change ∀ᶠ x in α, ∀ p ∈ s, f x ≤ MvPolynomial.eval x p
    apply (s.eventually_all).mpr
    intro p hp
    obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp hp
    exact q.property
  obtain ⟨t, ht⟩ := finite_cover_of_ultrafilters high hrows
  let ι := ↥t
  let K (i : ι) := ↥i.val.val
  let κ := (i : ι) → K i
  have hι : Nonempty ι := by
    obtain ⟨s, hs, _⟩ := ht 0
    exact ⟨⟨s, hs⟩⟩
  have hK (i : ι) : Nonempty (K i) := by
    obtain ⟨p, hp, _⟩ := i.val.property 0
    exact ⟨⟨p, hp⟩⟩
  let d : κ := fun i => (hK i).some
  have hκ : Nonempty κ := ⟨d⟩
  let g (i : ι) (k : κ) := (k i).val
  refine ⟨ι, κ, g, inferInstance, inferInstance, fun x => le_antisymm ?_ ?_⟩
  · obtain ⟨s, hs, hx⟩ := ht x
    let i : ι := ⟨s, hs⟩
    have hmin : f x ≤ ⨅ k, MvPolynomial.eval x (g i k) :=
      le_ciInf fun k => hx (k i).val (k i).property
    exact hmin.trans (le_ciSup (finite_range (fun i => ⨅ k, MvPolynomial.eval x (g i k))).bddAbove i)
  · apply ciSup_le
    intro i
    obtain ⟨p, hp, hx⟩ := i.val.property x
    let k : κ := Function.update d i (⟨p, hp⟩ : K i)
    have he : g i k = p := by simp [g, k]
    exact (ciInf_le (finite_range (fun k => MvPolynomial.eval x (g i k))).bddBelow k).trans
      (he ▸ hx)

/-- The ideal generated by polynomials nonnegative at the first ultrafilter
and nonpositive at the second. -/
noncomputable def separatingIdeal (α β : Ultrafilter (Point n)) : Ideal (Poly n) :=
  Ideal.span {q | (∀ᶠ x in α, 0 ≤ MvPolynomial.eval x q) ∧
    (∀ᶠ x in β, MvPolynomial.eval x q ≤ 0)}

theorem separatingIdeal_comm (α β : Ultrafilter (Point n)) :
    separatingIdeal α β = separatingIdeal β α := by
  suffices h : ∀ a b : Ultrafilter (Point n), separatingIdeal a b ≤ separatingIdeal b a from
    le_antisymm (h α β) (h β α)
  intro a b
  apply Ideal.span_le.mpr
  intro p hp
  have hn : -p ∈ separatingIdeal b a := Ideal.subset_span
    ⟨by simpa only [map_neg, Left.nonneg_neg_iff] using hp.2,
     by simpa only [map_neg, Left.neg_nonpos_iff] using hp.1⟩
  change p ∈ separatingIdeal b a
  simpa only [neg_neg] using (separatingIdeal b a).neg_mem hn

private theorem mem_separatingIdeal_of_zero {α β : Ultrafilter (Point n)} {p : Poly n}
    (hz : ∀ᶠ x in α, MvPolynomial.eval x p = 0) : p ∈ separatingIdeal α β := by
  rcases β.em (fun x => MvPolynomial.eval x p ≤ 0) with h | h
  · exact Ideal.subset_span ⟨hz.mono fun _ hx => hx.ge, h⟩
  · have hn : -p ∈ separatingIdeal α β := by
      apply Ideal.subset_span
      exact ⟨hz.mono fun x hx => by simp [hx],
        h.mono fun x hx => by simpa using (le_of_not_ge hx)⟩
    simpa using (separatingIdeal α β).neg_mem hn

/-- When the separating ideal is zero, membership in a semialgebraic piece
transfers from one ultrafilter to the other. -/
theorem mem_of_bot_of_semialgebraic {α β : Ultrafilter (Point n)}
    (hJ : separatingIdeal α β = ⊥) {S : Set (Point n)}
    (hs : PierceBirkhoff.IsSemiAlgebraic S) (hS : S ∈ α) : S ∈ β := by
  classical
  obtain ⟨ι, Z, T, hι, rfl⟩ := hs
  let D (i : ι) := {x : Point n | (∀ p ∈ Z i, MvPolynomial.eval x p = 0) ∧
    ∀ p ∈ T i, 0 < MvPolynomial.eval x p}
  change ∀ᶠ x in α, x ∈ ⋃ i, D i at hS
  obtain ⟨i, hi⟩ := Ultrafilter.eventually_exists_iff.mp (hS.mono fun _ => mem_iUnion.mp)
  change ∀ᶠ x in α, (∀ p ∈ Z i, MvPolynomial.eval x p = 0) ∧
    ∀ p ∈ T i, 0 < MvPolynomial.eval x p at hi
  have hzero (p : Poly n) (hp : p ∈ Z i) : p = 0 := by
    have hmem := mem_separatingIdeal_of_zero (β := β) (hi.mono fun _ hx => hx.1 p hp)
    simpa [hJ] using hmem
  have hpos (p : Poly n) (hp : p ∈ T i) : ∀ᶠ x in β, 0 < MvPolynomial.eval x p := by
    by_contra hn
    have ha : ∀ᶠ x in α, 0 < MvPolynomial.eval x p := hi.mono fun _ hx => hx.2 p hp
    have hb := (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt
    have hmem : p ∈ separatingIdeal α β :=
      Ideal.subset_span ⟨ha.mono fun _ hx => hx.le, hb⟩
    have heq : p = 0 := by simpa [hJ] using hmem
    obtain ⟨x, hx⟩ := ha.exists
    simp [heq] at hx
  change ∀ᶠ x in β, x ∈ ⋃ i, D i
  filter_upwards [((T i).eventually_all).mpr hpos] with x hx
  exact mem_iUnion.mpr ⟨i, fun p hp => by simp [hzero p hp], hx⟩

/-- The contribution of an arbitrary ideal coefficient can be bounded by
the positive polynomial `1 + r²`. -/
private theorem dominate_of_mem {α β : Ultrafilter (Point n)} {p : Poly n}
    (hp : p ∈ separatingIdeal α β) :
    ∃ t : Poly n, (∀ᶠ x in α, 0 ≤ MvPolynomial.eval x t) ∧
      (∀ᶠ x in β, |MvPolynomial.eval x p| ≤ -MvPolynomial.eval x t) := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
    refine ⟨p, hp.1, ?_⟩
    filter_upwards [hp.2] with x hx
    rw [abs_of_nonpos hx]
  | zero => exact ⟨0, by simp, by simp⟩
  | add p q _ _ ihp ihq =>
    obtain ⟨t, ht, ht'⟩ := ihp
    obtain ⟨u, hu, hu'⟩ := ihq
    refine ⟨t + u, ?_, ?_⟩
    · filter_upwards [ht, hu] with x h₁ h₂
      simpa using add_nonneg h₁ h₂
    · filter_upwards [ht', hu'] with x h₁ h₂
      simp only [map_add]
      linarith [abs_add_le (MvPolynomial.eval x p) (MvPolynomial.eval x q)]
  | smul r p _ ih =>
    obtain ⟨t, ht, ht'⟩ := ih
    refine ⟨(1 + r ^ 2) * t, ?_, ?_⟩
    · filter_upwards [ht] with x hx
      simp only [map_mul, map_add, map_one, map_pow]
      positivity
    · filter_upwards [ht'] with x hx
      change |MvPolynomial.eval x (r * p)| ≤ _
      simp only [map_mul, map_add, map_one, map_pow, abs_mul]
      let a := MvPolynomial.eval x r
      have ha : |a| ≤ 1 + a ^ 2 := abs_le.mpr
        ⟨by nlinarith [sq_nonneg (a + 1 / 2)], by nlinarith [sq_nonneg (a - 1 / 2)]⟩
      have h := mul_le_mul ha hx (abs_nonneg _) (by positivity)
      dsimp [a] at h
      linarith

theorem separator_of_difference_mem {α β : Ultrafilter (Point n)} {a b : Poly n}
    (hab : a - b ∈ separatingIdeal α β) :
    ∃ h : Poly n, (∀ᶠ x in α, MvPolynomial.eval x a ≤ MvPolynomial.eval x h) ∧
      (∀ᶠ x in β, MvPolynomial.eval x h ≤ MvPolynomial.eval x b) := by
  obtain ⟨t, ht, ht'⟩ := dominate_of_mem hab
  refine ⟨a + t, ?_, ?_⟩
  · filter_upwards [ht] with x hx
    simp [hx]
  · filter_upwards [ht'] with x hx
    simp only [map_sub, map_add] at *
    linarith [le_abs_self (MvPolynomial.eval x a - MvPolynomial.eval x b)]

/-- In a proper separating ideal, evaluation of each member is infinitesimal
at either ordering. A positive constant gap would put a unit in the ideal. -/
theorem tendsto_zero_of_mem {α β : Ultrafilter (Point n)} {p : Poly n}
    (hproper : separatingIdeal α β ≠ ⊤) (hp : p ∈ separatingIdeal α β) :
    Tendsto (fun x => MvPolynomial.eval x p) β (𝓝 0) := by
  obtain ⟨t, ht, ht'⟩ := dominate_of_mem hp
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  simp only [Real.dist_eq, sub_zero]
  by_contra hn
  have hβ := (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt
  have hneg : ∀ᶠ x in β, MvPolynomial.eval x t ≤ -ε := by
    filter_upwards [ht', hβ] with x hx he
    linarith
  have htmem : t ∈ separatingIdeal α β := Ideal.subset_span
    ⟨ht, hneg.mono fun _ hx => hx.trans (neg_nonpos.mpr hε.le)⟩
  have hplus : t + MvPolynomial.C ε ∈ separatingIdeal α β := by
    apply Ideal.subset_span
    constructor
    · filter_upwards [ht] with x hx
      simpa using add_nonneg hx hε.le
    · filter_upwards [hneg] with x hx
      simp only [map_add, MvPolynomial.eval_C]
      linarith
  have hc : MvPolynomial.C ε ∈ separatingIdeal α β := by
    simpa using (separatingIdeal α β).sub_mem hplus htmem
  exact hproper ((separatingIdeal α β).eq_top_of_isUnit_mem hc (hε.ne'.isUnit.map _))

/-- The plane connectedness statement is phrased solely in terms of real
points. Two ultrafilters share a connected region avoiding any finite family
of zero loci whose polynomials lie outside their separating ideal. -/
def ConnectednessAt (α β : Ultrafilter (Point n)) : Prop :=
  ∀ s : Finset (Poly n), (∀ p ∈ s, p ∉ separatingIdeal α β) →
    ∃ C : Set (Point n), IsPreconnected C ∧ C ∈ α ∧ C ∈ β ∧
      ∀ x ∈ C, ∀ p ∈ s, MvPolynomial.eval x p ≠ 0

theorem connectednessAt_of_top {α β : Ultrafilter (Point n)} (h : separatingIdeal α β = ⊤) :
    ConnectednessAt α β := by
  intro s hs
  refine ⟨univ, isPreconnected_univ, univ_mem, univ_mem, fun _ _ p hp => ?_⟩
  exact (hs p hp (h ▸ Submodule.mem_top)).elim

/-- If the ideal contains the vanishing ideal of a real point, both filters
converge there in the proper case. A single small ball avoids all bad curves. -/
theorem connectednessAt_of_eval_ker {α β : Ultrafilter (Point n)} {z : Point n}
    (hz : RingHom.ker (MvPolynomial.eval z) ≤ separatingIdeal α β) : ConnectednessAt α β := by
  classical
  by_cases ht : separatingIdeal α β = ⊤
  · exact connectednessAt_of_top ht
  have conv (a b : Ultrafilter (Point n)) (he : separatingIdeal a b = separatingIdeal α β) :
      (b : Filter (Point n)) ≤ 𝓝 z := by
    change Tendsto id b (𝓝 z)
    apply tendsto_pi_nhds.mpr
    intro i
    have hx : MvPolynomial.X i - MvPolynomial.C (z i) ∈ RingHom.ker (MvPolynomial.eval z) := by
      rw [RingHom.mem_ker]
      simp
    have h := tendsto_zero_of_mem (α := a) (β := b) (he ▸ ht) (he ▸ hz hx)
    simpa [id_def] using h.add (tendsto_const_nhds (x := z i))
  have hα := conv β α (separatingIdeal_comm β α)
  have hβ := conv α β rfl
  intro s hs
  have hnonzero (p : Poly n) (hp : p ∈ s) : MvPolynomial.eval z p ≠ 0 :=
    fun heq => hs p hp (hz (RingHom.mem_ker.mpr heq))
  have hN : ∀ᶠ x in 𝓝 z, ∀ p ∈ s, MvPolynomial.eval x p ≠ 0 := by
    apply s.eventually_all.mpr
    intro p hp
    exact p.continuous_eval.continuousAt.eventually_ne (hnonzero p hp)
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hN
  exact ⟨Metric.ball z r, (convex_ball z r).isPreconnected, hα (Metric.ball_mem_nhds _ hr),
    hβ (Metric.ball_mem_nhds _ hr), fun _ hx => hball hx⟩

/-- A switch between pieces with incongruent polynomials would separate the
connected region into two relatively closed parts. -/
theorem difference_mem_of_connectedness {ι : Type} [Finite ι]
    {P : ι → Set (Point n)} {g : ι → Poly n} {f : Point n → ℝ}
    (closed : ∀ i, IsClosed (P i)) (cover : ∀ x, ∃ i, x ∈ P i)
    (piece : ∀ i x, x ∈ P i → f x = MvPolynomial.eval x (g i))
    {α β : Ultrafilter (Point n)} (connected : ConnectednessAt α β)
    {i j : ι} (hi : P i ∈ α) (hj : P j ∈ β) : g i - g j ∈ separatingIdeal α β := by
  classical
  let J := separatingIdeal α β
  let _ := Fintype.ofFinite ι
  let allDiff := (Finset.univ : Finset (ι × ι)).image (fun kl => g kl.1 - g kl.2)
  let bad := allDiff.filter (fun p => p ∉ J)
  obtain ⟨C, hc, hα, hβ, havoid⟩ := connected bad fun p hp => (Finset.mem_filter.mp hp).2
  let A := {k : ι // g i - g k ∈ J}
  let B := {k : ι // g i - g k ∉ J}
  let U := ⋃ k : A, P k.val
  let V := ⋃ k : B, P k.val
  have hU : IsClosed U := isClosed_iUnion_of_finite fun k : A => closed k.val
  have hV : IsClosed V := isClosed_iUnion_of_finite fun k : B => closed k.val
  have hUV : C ⊆ U ∪ V := by
    intro x _
    obtain ⟨k, hk⟩ := cover x
    by_cases h : g i - g k ∈ J
    · exact Or.inl (mem_iUnion.mpr ⟨(⟨k, h⟩ : A), hk⟩)
    · exact Or.inr (mem_iUnion.mpr ⟨(⟨k, h⟩ : B), hk⟩)
  by_contra h
  have hCU : (C ∩ U).Nonempty := by
    obtain ⟨x, hx, hix⟩ := Filter.nonempty_of_mem (inter_mem hα hi : C ∩ P i ∈ α)
    exact ⟨x, hx, mem_iUnion.mpr ⟨(⟨i, by simp⟩ : A), hix⟩⟩
  have hCV : (C ∩ V).Nonempty := by
    obtain ⟨x, hx, hjx⟩ := Filter.nonempty_of_mem (inter_mem hβ hj : C ∩ P j ∈ β)
    exact ⟨x, hx, mem_iUnion.mpr ⟨(⟨j, h⟩ : B), hjx⟩⟩
  obtain ⟨x, hx, hux, hvx⟩ := isPreconnected_closed_iff.mp hc U V hU hV hUV hCU hCV
  obtain ⟨k, hk⟩ := mem_iUnion.mp hux
  obtain ⟨l, hl⟩ := mem_iUnion.mp hvx
  have hkl : g k.val - g l.val ∉ J := by
    intro hh
    apply l.property
    convert J.add_mem k.property hh using 1
    abel
  have hbad : g k.val - g l.val ∈ bad := Finset.mem_filter.mpr
    ⟨Finset.mem_image.mpr ⟨(k.val, l.val), Finset.mem_univ _, rfl⟩, hkl⟩
  apply havoid x hx _ hbad
  rw [map_sub, ← piece k.val x hk, ← piece l.val x hl, sub_self]

/-- Dimension-independent final assembly. No semialgebraic elimination or
spectrum representation is needed after the geometric connectedness step. -/
theorem representation_of_connectedness
    (connected : ∀ α β : Ultrafilter (Point n), separatingIdeal α β ≠ ⊥ →
      separatingIdeal α β ≠ ⊤ →
      (∀ z, ¬RingHom.ker (MvPolynomial.eval z) ≤ separatingIdeal α β) → ConnectednessAt α β)
    (f : Point n → ℝ) (hf : PierceBirkhoff.IsPiecewiseMvPolynomial f) :
    HasRepresentation f := by
  classical
  obtain ⟨ι, P, g, hι, closed, semi, hcover, piece⟩ := hf
  have cover (x : Point n) : ∃ i, x ∈ P i :=
    mem_iUnion.mp (hcover.symm ▸ mem_univ x)
  apply representation_of_local
  intro α β
  obtain ⟨i, hi⟩ := (Ultrafilter.eventually_exists_iff (f := α)).mp (Eventually.of_forall cover)
  by_cases hbot : separatingIdeal α β = ⊥
  · refine ⟨g i, hi.mono fun x hx => (piece i x hx).le, ?_⟩
    have hβ : ∀ᶠ x in β, x ∈ P i := mem_of_bot_of_semialgebraic hbot (semi i) hi
    exact hβ.mono fun x hx => (piece i x hx).ge
  obtain ⟨j, hj⟩ := (Ultrafilter.eventually_exists_iff (f := β)).mp (Eventually.of_forall cover)
  have hconn : ConnectednessAt α β := by
    by_cases ht : separatingIdeal α β = ⊤
    · exact connectednessAt_of_top ht
    by_cases hz : ∃ z, RingHom.ker (MvPolynomial.eval z) ≤ separatingIdeal α β
    · obtain ⟨z, hz⟩ := hz
      exact connectednessAt_of_eval_ker hz
    exact connected α β hbot ht (not_exists.mp hz)
  have hm := difference_mem_of_connectedness closed cover piece hconn hi hj
  obtain ⟨p, hpα, hpβ⟩ := separator_of_difference_mem hm
  refine ⟨p, ?_, ?_⟩
  · filter_upwards [hi, hpα] with x hx hle
    rwa [piece i x hx]
  · filter_upwards [hj, hpβ] with x hx hle
    rwa [piece j x hx]

theorem solution_of_plane_connectedness
    (connected : ∀ α β : Ultrafilter (Point 2), separatingIdeal α β ≠ ⊥ →
      separatingIdeal α β ≠ ⊤ →
      (∀ z, ¬RingHom.ker (MvPolynomial.eval z) ≤ separatingIdeal α β) → ConnectednessAt α β) :
    type_of% @PierceBirkhoff.pierce_birkhoff_conjecture_dim_two :=
  representation_of_connectedness connected

/- An alternative reduction to representation on open strips.

If two orderings are separated by a coordinate cut in both directions, the
two linear generators give the vanishing ideal of their intersection point.
Thus it suffices to produce representations on individual open strips in
each direction. This is the form of the intermediate assertion used in
the cylindrical proof of Efroymson and in Delzell (2010), Proposition 4.8.
-/

private theorem local_of_representation {f : Point n → ℝ} (hf : HasRepresentation f)
    (α β : Ultrafilter (Point n)) : ∃ p : Poly n,
    (∀ᶠ x in α, f x ≤ MvPolynomial.eval x p) ∧ (∀ᶠ x in β, MvPolynomial.eval x p ≤ f x) := by
  classical
  obtain ⟨ι, κ, g, hι, hκ, h⟩ := hf
  rcases isEmpty_or_nonempty ι with he | he
  · have hz (x) : f x = 0 := by rw [h, iSup_of_empty', Real.sSup_empty]
    exact ⟨0, Eventually.of_forall fun x => by simp [hz x],
      Eventually.of_forall fun x => by simp [hz x]⟩
  rcases isEmpty_or_nonempty κ with he' | he'
  · have hz (x) : f x = 0 := by simp [h]
    exact ⟨0, Eventually.of_forall fun x => by simp [hz x],
      Eventually.of_forall fun x => by simp [hz x]⟩
  have hi (x) : ∃ i, ∀ j, f x ≤ MvPolynomial.eval x (g i j) := by
    obtain ⟨i, hmax⟩ := exists_eq_ciSup_of_finite (f := fun i => ⨅ j, MvPolynomial.eval x (g i j))
    refine ⟨i, fun j => ?_⟩
    rw [h x, ← hmax]
    exact ciInf_le (finite_range _).bddBelow j
  obtain ⟨i, hi'⟩ := (Ultrafilter.eventually_exists_iff (f := α)).mp (Eventually.of_forall hi)
  have hj (x) : ∃ j, MvPolynomial.eval x (g i j) ≤ f x := by
    obtain ⟨j, hmin⟩ := exists_eq_ciInf_of_finite (f := fun j => MvPolynomial.eval x (g i j))
    refine ⟨j, ?_⟩
    rw [hmin, h x]
    exact le_ciSup (finite_range (fun i => ⨅ j, MvPolynomial.eval x (g i j))).bddAbove i
  obtain ⟨j, hj'⟩ := (Ultrafilter.eventually_exists_iff (f := β)).mp (Eventually.of_forall hj)
  exact ⟨g i j, hi'.mono fun _ hx => hx j, hj'⟩

private theorem same_strict_sign {α β : Ultrafilter (Point n)} {p : Poly n}
    (hp : p ∉ separatingIdeal α β) :
    ((∀ᶠ x in α, 0 < MvPolynomial.eval x p) ∧ (∀ᶠ x in β, 0 < MvPolynomial.eval x p)) ∨
    ((∀ᶠ x in α, MvPolynomial.eval x p < 0) ∧ (∀ᶠ x in β, MvPolynomial.eval x p < 0)) := by
  have pos {a b : Ultrafilter (Point n)} (hab : p ∉ separatingIdeal a b)
      (h : ∀ᶠ x in a, 0 ≤ MvPolynomial.eval x p) : ∀ᶠ x in b, 0 < MvPolynomial.eval x p := by
    by_contra hn
    exact hab (Ideal.subset_span ⟨h, (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt⟩)
  have hp' : p ∉ separatingIdeal β α := by rwa [separatingIdeal_comm β α]
  rcases α.em (fun x => 0 ≤ MvPolynomial.eval x p) with ha | ha
  · have hb := pos hp ha
    exact Or.inl ⟨pos hp' (hb.mono fun _ hx => hx.le), hb⟩
  · have ha' := ha.mono fun _ => lt_of_not_ge
    right
    refine ⟨ha', ?_⟩
    by_contra hn
    have hb := (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt
    exact hp' (Ideal.subset_span ⟨hb, ha'.mono fun _ hx => hx.le⟩)

private theorem ker_eval_le_of_coordinates {J : Ideal (Poly n)} {z : Point n}
    (hz : ∀ i, MvPolynomial.X i - MvPolynomial.C (z i) ∈ J) :
    RingHom.ker (MvPolynomial.eval z) ≤ J := by
  let q := Ideal.Quotient.mk J
  have he : q = (q.comp MvPolynomial.C).comp (MvPolynomial.eval z) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp
    · intro i
      simpa [q] using (Ideal.Quotient.eq.mpr (hz i))
  intro p hp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q p = 0
  rw [RingHom.congr_fun he p]
  simp [RingHom.mem_ker.mp hp]

/-- A sign pattern at finitely many coordinate cuts describes one open strip
(or the empty set). A local expression can depend on the strip. -/
def HasStripRepresentations (f : Point 2 → ℝ) (d : Fin 2) : Prop :=
  ∃ cuts : Finset ℝ, ∀ right : Set ℝ, ∃ h : Point 2 → ℝ, HasRepresentation h ∧
    ∀ x, (∀ c ∈ cuts, (c ∈ right → c < x d) ∧ (c ∉ right → x d < c)) → f x = h x

private theorem local_of_strips {f : Point 2 → ℝ} {d : Fin 2}
    (rep : HasStripRepresentations f d) {α β : Ultrafilter (Point 2)}
    (hcoord : ∀ c : ℝ, MvPolynomial.X d - MvPolynomial.C c ∉ separatingIdeal α β) :
    ∃ p : Poly 2, (∀ᶠ x in α, f x ≤ MvPolynomial.eval x p) ∧
      (∀ᶠ x in β, MvPolynomial.eval x p ≤ f x) := by
  classical
  obtain ⟨cuts, hr⟩ := rep
  let right := {c : ℝ | ∀ᶠ x : Point 2 in α, c < x d}
  let side (c : ℝ) (x : Point 2) := (c ∈ right → c < x d) ∧ (c ∉ right → x d < c)
  have hside (c : ℝ) : (∀ᶠ x in α, side c x) ∧ (∀ᶠ x in β, side c x) := by
    have h : ((∀ᶠ x : Point 2 in α, c < x d) ∧ (∀ᶠ x : Point 2 in β, c < x d)) ∨
        ((∀ᶠ x : Point 2 in α, x d < c) ∧ (∀ᶠ x : Point 2 in β, x d < c)) := by
      simpa using same_strict_sign (hcoord c)
    rcases h with ⟨ha, hb⟩ | ⟨ha, hb⟩
    · have hcr : c ∈ right := ha
      exact ⟨ha.mono fun x hx => by simp [side, hcr, hx],
        hb.mono fun x hx => by simp [side, hcr, hx]⟩
    · have hcr : c ∉ right := fun h => by
        obtain ⟨x, hx, hx'⟩ := (ha.and (show ∀ᶠ x : Point 2 in α, c < x d from h)).exists
        exact lt_asymm hx hx'
      exact ⟨ha.mono fun x hx => by simp [side, hcr, hx],
        hb.mono fun x hx => by simp [side, hcr, hx]⟩
  obtain ⟨h, hrep, heq⟩ := hr right
  obtain ⟨p, hpα, hpβ⟩ := local_of_representation hrep α β
  refine ⟨p, ?_, ?_⟩
  · filter_upwards [hpα, cuts.eventually_all.mpr fun c _ => (hside c).1] with x hx hs
    rwa [heq x hs]
  · filter_upwards [hpβ, cuts.eventually_all.mpr fun c _ => (hside c).2] with x hx hs
    rwa [heq x hs]

/-- Representations on open strips in both coordinate directions assemble
to a global representation, including along every cut and at every crossing. -/
theorem representation_of_strips {f : Point 2 → ℝ} (hf : PierceBirkhoff.IsPiecewiseMvPolynomial f)
    (strips : ∀ d : Fin 2, HasStripRepresentations f d) : HasRepresentation f := by
  classical
  apply representation_of_local
  intro α β
  by_cases h : ∃ d : Fin 2, ∀ c : ℝ, MvPolynomial.X d - MvPolynomial.C c ∉ separatingIdeal α β
  · obtain ⟨d, hd⟩ := h
    exact local_of_strips (strips d) hd
  push Not at h
  choose z hz using h
  have hc := connectednessAt_of_eval_ker (ker_eval_le_of_coordinates hz)
  obtain ⟨ι, P, g, _, closed, _, hcover, piece⟩ := hf
  have cover (x : Point 2) : ∃ i, x ∈ P i := mem_iUnion.mp (hcover.symm ▸ mem_univ x)
  obtain ⟨i, hi⟩ := (Ultrafilter.eventually_exists_iff (f := α)).mp (Eventually.of_forall cover)
  obtain ⟨j, hj⟩ := (Ultrafilter.eventually_exists_iff (f := β)).mp (Eventually.of_forall cover)
  obtain ⟨p, hα, hβ⟩ := separator_of_difference_mem
    (difference_mem_of_connectedness closed cover piece hc hi hj)
  refine ⟨p, ?_, ?_⟩
  · filter_upwards [hi, hα] with x hx hle
    rwa [piece i x hx]
  · filter_upwards [hj, hβ] with x hx hle
    rwa [piece j x hx]

private theorem semialgebraic_precomp {S : Set (Point n)} (hs : PierceBirkhoff.IsSemiAlgebraic S)
    (σ : Fin n → Fin n) : PierceBirkhoff.IsSemiAlgebraic ((fun x : Point n => x ∘ σ) ⁻¹' S) := by
  classical
  obtain ⟨ι, Z, T, _, rfl⟩ := hs
  refine ⟨ι, fun i => (Z i).image (MvPolynomial.rename σ),
    fun i => (T i).image (MvPolynomial.rename σ), inferInstance, ?_⟩
  ext x
  simp [MvPolynomial.eval_rename]

private theorem piecewise_precomp {f : Point n → ℝ} (hf : PierceBirkhoff.IsPiecewiseMvPolynomial f)
    (σ : Fin n → Fin n) : PierceBirkhoff.IsPiecewiseMvPolynomial (fun x => f (x ∘ σ)) := by
  obtain ⟨ι, P, g, _, hc, hs, hcov, hg⟩ := hf
  let φ (x : Point n) := x ∘ σ
  have hφ : Continuous φ := continuous_pi fun i => continuous_apply (σ i)
  refine ⟨ι, fun i => φ ⁻¹' P i, fun i => MvPolynomial.rename σ (g i), inferInstance,
    fun i => (hc i).preimage hφ, fun i => semialgebraic_precomp (hs i) σ, ?_, ?_⟩
  · rw [← preimage_iUnion, hcov, preimage_univ]
  · intro i x hx
    simpa only [MvPolynomial.eval_rename] using hg i (φ x) hx

private theorem representation_precomp {f : Point n → ℝ} (hf : HasRepresentation f)
    (σ : Fin n → Fin n) : HasRepresentation (fun x => f (x ∘ σ)) := by
  obtain ⟨ι, κ, g, hι, hκ, hg⟩ := hf
  refine ⟨ι, κ, fun i j => MvPolynomial.rename σ (g i j), hι, hκ, fun x => ?_⟩
  simpa only [MvPolynomial.eval_rename] using hg (x ∘ σ)

/-- It suffices to construct representations on *vertical* open strips.
Swapping the two coordinates supplies the horizontal ones. -/
theorem solution_of_plane_strips
    (strips : ∀ (f : Point 2 → ℝ), PierceBirkhoff.IsPiecewiseMvPolynomial f →
      HasStripRepresentations f 0) :
    type_of% @PierceBirkhoff.pierce_birkhoff_conjecture_dim_two := by
  intro f hf
  apply representation_of_strips hf
  intro d
  let σ := Equiv.swap (0 : Fin 2) d
  obtain ⟨cuts, hs⟩ := strips _ (piecewise_precomp hf σ)
  refine ⟨cuts, fun right => ?_⟩
  obtain ⟨h, hr, he⟩ := hs right
  refine ⟨fun x => h (x ∘ σ.symm), representation_precomp hr σ.symm, fun x hx => ?_⟩
  have hside : ∀ c ∈ cuts, (c ∈ right → c < (x ∘ σ.symm) 0) ∧
      (c ∉ right → (x ∘ σ.symm) 0 < c) := by simpa [σ] using hx
  have hinv : (x ∘ σ.symm) ∘ σ = x := funext fun i => by simp
  simpa only [hinv] using he (x ∘ σ.symm) hside

end OMA.PB

/-
# Phase 2: the strip theorem, completing the proof

`solution_of_plane_strips` reduced the theorem to representations on vertical
open strips.  They are produced as follows.

* `rem`, `exists_closed_finset`: the differences of the polynomials of the pieces
  are put into a finite family closed under `∂/∂Y` and `a ↦ (deg a) • a - Y * ∂a/∂Y`
  (the two operations of Delzell (2010), (4.0.3)–(4.0.4), after Mahé).
* `exists_regular_product`: irreducible factorisation, Gauss's lemma and a
  resultant give one polynomial `P` and a nonzero `Q ∈ ℝ[X]` such that, away from
  the roots of `Q` (the cuts), `P` has only simple roots in `Y`, a nonvanishing
  leading coefficient, and controls the zero set of every member of the family.
* `exists_root_curves`: over an interval without cuts the real roots of `P` are
  the graphs of finitely many continuous, strictly ordered functions.
* `mem_of_abs_le`, `mem_of_sub_mem`: the separating ideal is convex and the two
  orderings agree modulo it.
* `StripData.claim`: Mahé's lemma (Delzell (2010), Lemma 4.7) in terms of the
  separating ideal: a member of the family lies in the separating ideal of two
  ultrafilters of the strip that are weakly separated by one of its root curves.
  The induction is on the degree in `Y`, through the derivative and `rem`.
* `StripData.difference_mem`: the curves that carry zeros of differences outside
  the separating ideal do not pass between the two ultrafilters, which leaves a
  connected region containing both; `difference_mem_of_region` then applies.
* `representation_on_of_local`: compactness of the ultrafilters on the strip.
-/

namespace OMA.PB

open Polynomial
open scoped Polynomial.Bivariate

/-- `(deg a) • a - Y * ∂a/∂Y`, which cancels the leading term in the outer variable. -/
noncomputable def rem (a : ℝ[X][Y]) : ℝ[X][Y] :=
  (a.natDegree : ℝ[X][Y]) * a - X * derivative a

theorem natDegree_rem_lt {a : ℝ[X][Y]} (ha : a.natDegree ≠ 0) :
    (rem a).natDegree < a.natDegree := by
  by_cases h0 : rem a = 0
  · rw [h0, natDegree_zero]
    exact Nat.pos_of_ne_zero ha
  rw [natDegree_lt_iff_degree_lt h0, degree_lt_iff_coeff_zero]
  intro m hm
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
  rw [rem, coeff_sub, coeff_X_mul, coeff_derivative, ← C_eq_natCast, coeff_C_mul]
  rcases hm.eq_or_lt with h | h
  · rw [h]
    push_cast
    ring
  · rw [coeff_eq_zero_of_natDegree_lt h]
    simp

theorem evalEval_rem (a : ℝ[X][Y]) (x y : ℝ) :
    (rem a).evalEval x y =
      (a.natDegree : ℝ) * a.evalEval x y - y * (derivative a).evalEval x y := by
  simp [rem, evalEval_sub, evalEval_mul, evalEval_X, evalEval_natCast]

theorem exists_closed (n : ℕ) : ∀ a : ℝ[X][Y], a.natDegree ≤ n →
    ∃ B : Finset ℝ[X][Y], a ∈ B ∧ ∀ b ∈ B, derivative b ∈ B ∧ rem b ∈ B := by
  classical
  induction n with
  | zero =>
    intro a ha
    have h0 : a.natDegree = 0 := Nat.le_zero.mp ha
    have hd : derivative a = 0 := by rw [eq_C_of_natDegree_eq_zero h0, derivative_C]
    refine ⟨{a, 0}, by simp, ?_⟩
    intro b hb
    rcases Finset.mem_insert.mp hb with rfl | hb
    · simp [hd, rem, h0]
    · rw [Finset.mem_singleton.mp hb]
      simp [rem]
  | succ n ih =>
    intro a ha
    by_cases h0 : a.natDegree = 0
    · exact ih a (by omega)
    obtain ⟨B₁, h₁, c₁⟩ := ih (derivative a) (by have := natDegree_derivative_lt h0; omega)
    obtain ⟨B₂, h₂, c₂⟩ := ih (rem a) (by have := natDegree_rem_lt h0; omega)
    refine ⟨insert a (B₁ ∪ B₂), by simp, ?_⟩
    intro b hb
    rcases Finset.mem_insert.mp hb with rfl | hb
    · exact ⟨Finset.mem_insert_of_mem (Finset.mem_union_left _ h₁),
        Finset.mem_insert_of_mem (Finset.mem_union_right _ h₂)⟩
    rcases Finset.mem_union.mp hb with hb | hb
    · exact ⟨Finset.mem_insert_of_mem (Finset.mem_union_left _ (c₁ b hb).1),
        Finset.mem_insert_of_mem (Finset.mem_union_left _ (c₁ b hb).2)⟩
    · exact ⟨Finset.mem_insert_of_mem (Finset.mem_union_right _ (c₂ b hb).1),
        Finset.mem_insert_of_mem (Finset.mem_union_right _ (c₂ b hb).2)⟩

theorem exists_closed_finset (s : Finset ℝ[X][Y]) :
    ∃ B : Finset ℝ[X][Y], s ⊆ B ∧ ∀ b ∈ B, derivative b ∈ B ∧ rem b ∈ B := by
  classical
  choose Bf hmem hcl using fun a : ℝ[X][Y] => exists_closed a.natDegree a le_rfl
  refine ⟨s.biUnion Bf, fun a ha => Finset.mem_biUnion.mpr ⟨a, ha, hmem a⟩, ?_⟩
  intro b hb
  obtain ⟨a, ha, hb⟩ := Finset.mem_biUnion.mp hb
  exact ⟨Finset.mem_biUnion.mpr ⟨a, ha, (hcl a b hb).1⟩,
    Finset.mem_biUnion.mpr ⟨a, ha, (hcl a b hb).2⟩⟩

end OMA.PB

namespace OMA.PB

open Polynomial UniqueFactorizationMonoid
open scoped Polynomial.Bivariate

/-- Split off the factors that do not involve the outer variable. -/
theorem factor_split (a : ℝ[X][Y]) (ha : a ≠ 0) : ∃ u : ℝ[X], u ≠ 0 ∧
    a = C u * ((normalizedFactors a).filter fun p => p.natDegree ≠ 0).prod := by
  classical
  obtain ⟨w, hw⟩ := prod_normalizedFactors ha
  set m := normalizedFactors a with hm
  have hsplit := Multiset.prod_filter_mul_prod_filter_not (s := m) (fun p => p.natDegree ≠ 0)
  set v := (m.filter fun p => ¬p.natDegree ≠ 0).prod * (w : ℝ[X][Y]) with hv
  have hdeg : v.natDegree = 0 := by
    apply Nat.eq_zero_of_le_zero
    refine natDegree_mul_le.trans ?_
    rw [natDegree_coe_units, add_zero]
    refine (natDegree_multiset_prod_le _).trans (le_of_eq ?_)
    apply Multiset.sum_eq_zero
    intro d hd
    obtain ⟨p, hp, rfl⟩ := Multiset.mem_map.mp hd
    simpa using (Multiset.mem_filter.mp hp).2
  have hav : a = v * (m.filter fun p => p.natDegree ≠ 0).prod := by
    rw [← hw, ← hsplit, hv]
    ring
  refine ⟨v.coeff 0, ?_, ?_⟩
  · intro h0
    apply ha
    rw [hav, eq_C_of_natDegree_eq_zero hdeg, h0, C_0, zero_mul]
  · rw [← eq_C_of_natDegree_eq_zero hdeg]
    exact hav

/-- A finite family of bivariate polynomials is controlled by one polynomial
whose roots in the outer variable are simple away from finitely many values of
the inner variable. -/
theorem exists_regular_product (B : Finset ℝ[X][Y]) :
    ∃ (P : ℝ[X][Y]) (Q : ℝ[X]), Q ≠ 0 ∧
      (∀ x, Q.eval x ≠ 0 → P.leadingCoeff.eval x ≠ 0 ∧
        ∀ y, P.evalEval x y = 0 → (derivative P).evalEval x y ≠ 0) ∧
      ∀ a ∈ B, a ≠ 0 → ∃ g : ℝ[X][Y], ∀ x y, Q.eval x ≠ 0 →
        (a.evalEval x y = 0 → P.evalEval x y = 0) ∧
        (P.evalEval x y = 0 → (a.evalEval x y = 0 ↔ g.evalEval x y ≠ 0)) := by
  classical
  let Fs : Finset ℝ[X][Y] :=
    (B.biUnion fun a => (normalizedFactors a).toFinset).filter fun p => p.natDegree ≠ 0
  have hFs : ∀ p ∈ Fs, Irreducible p ∧ normalize p = p ∧ p.natDegree ≠ 0 := by
    intro p hp
    obtain ⟨hp, hdeg⟩ := Finset.mem_filter.mp hp
    obtain ⟨a, _, hpa⟩ := Finset.mem_biUnion.mp hp
    have hpa' := Multiset.mem_toFinset.mp hpa
    exact ⟨irreducible_of_normalized_factor p hpa', normalize_normalized_factor p hpa', hdeg⟩
  have hmemFs : ∀ a ∈ B, ∀ p ∈ normalizedFactors a, p.natDegree ≠ 0 → p ∈ Fs := fun a ha p hp hd =>
    Finset.mem_filter.mpr ⟨Finset.mem_biUnion.mpr ⟨a, ha, Multiset.mem_toFinset.mpr hp⟩, hd⟩
  let P : ℝ[X][Y] := ∏ p ∈ Fs, p
  have hP0 : P ≠ 0 := Finset.prod_ne_zero_iff.mpr fun p hp => (hFs p hp).1.ne_zero
  -- two distinct factors vanishing at a point force a multiple root
  have hdouble : ∀ x y, ∀ p ∈ Fs, ∀ q ∈ Fs, p ≠ q → p.evalEval x y = 0 → q.evalEval x y = 0 →
      (derivative P).evalEval x y = 0 := by
    intro x y p hp q hq hpq hpz hqz
    rw [derivative_prod_finset, evalEval_finsetSum]
    apply Finset.sum_eq_zero
    intro i hi
    rw [evalEval_mul, evalEval_prod]
    by_cases hip : i = p
    · rw [Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨fun h => hpq (hip ▸ h).symm, hq⟩) hqz,
        zero_mul]
    · rw [Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨fun h => hip h.symm, hp⟩) hpz, zero_mul]
  -- the resultant certificate
  obtain ⟨R, hR0, hRreg⟩ : ∃ R : ℝ[X], R ≠ 0 ∧ ∀ x y, R.eval x ≠ 0 →
      P.leadingCoeff.eval x ≠ 0 → P.evalEval x y = 0 → (derivative P).evalEval x y ≠ 0 := by
    by_cases hdeg : P.natDegree = 0
    · refine ⟨1, one_ne_zero, fun x y _ hlc hz => ?_⟩
      exfalso
      apply hlc
      rw [eq_C_of_natDegree_eq_zero hdeg, evalEval_C] at hz
      rw [leadingCoeff, hdeg]
      exact hz
    let K := FractionRing ℝ[X]
    let φ : ℝ[X] →+* K := algebraMap ℝ[X] K
    have hφ : Function.Injective φ := IsFractionRing.injective ℝ[X] K
    have : CharZero K := charZero_of_injective_algebraMap hφ
    have hirr : ∀ p ∈ Fs, Irreducible (p.map φ) := fun p hp =>
      (((hFs p hp).1.isPrimitive (hFs p hp).2.2).irreducible_iff_irreducible_map_fraction_map).mp
        (hFs p hp).1
    have hsep : (P.map φ).Separable := by
      rw [Polynomial.map_prod]
      apply separable_prod'
      · intro p hp q hq hpq
        rw [(hirr p hp).coprime_iff_not_dvd]
        intro hdvd
        have hprim := (hFs p hp).1.isPrimitive (hFs p hp).2.2
        have hd : p ∣ q := hprim.dvd_of_fraction_map_dvd_fraction_map hdvd
        exact hpq (((hFs p hp).1.associated_of_dvd (hFs q hq).1 hd).eq_of_normalized
          (hFs p hp).2.1 (hFs q hq).2.1)
      · intro p hp
        exact (hirr p hp).separable
    have hcop : IsCoprime (P.map φ) ((derivative P).map φ) := by
      rw [← derivative_map]
      exact (separable_def _).mp hsep
    let R := resultant P (derivative P)
    have hR : R ≠ 0 := by
      intro h0
      have h := resultant_ne_zero _ _ hcop
      rw [natDegree_map_eq_of_injective hφ, natDegree_map_eq_of_injective hφ,
        resultant_map_map] at h
      exact h (by rw [show resultant P (derivative P) = R from rfl, h0, map_zero])
    obtain ⟨A, A', -, -, hbez⟩ := exists_mul_add_mul_eq_C_resultant
      (m := P.natDegree) (n := (derivative P).natDegree) P (derivative P) le_rfl le_rfl
      (Or.inl hdeg)
    refine ⟨R, hR, fun x y hRx _ hz hz' => ?_⟩
    have h := congrArg (evalEval x y) hbez
    rw [evalEval_add, evalEval_mul, evalEval_mul, hz, hz', evalEval_C, zero_mul, zero_mul,
      add_zero] at h
    exact hRx h.symm
  -- the unit parts
  have hu : ∀ a : ℝ[X][Y], ∃ u : ℝ[X], u ≠ 0 ∧ (a ≠ 0 →
      a = C u * ((normalizedFactors a).filter fun p => p.natDegree ≠ 0).prod) := by
    intro a
    by_cases ha : a = 0
    · exact ⟨1, one_ne_zero, fun h => (h ha).elim⟩
    · obtain ⟨u, hu, h⟩ := factor_split a ha
      exact ⟨u, hu, fun _ => h⟩
  choose u hu0 hua using hu
  let Q : ℝ[X] := R * P.leadingCoeff * ∏ a ∈ B, u a
  have hQ0 : Q ≠ 0 := mul_ne_zero (mul_ne_zero hR0 (leadingCoeff_ne_zero.mpr hP0))
    (Finset.prod_ne_zero_iff.mpr fun a _ => hu0 a)
  have hQ : ∀ x, Q.eval x ≠ 0 → R.eval x ≠ 0 ∧ P.leadingCoeff.eval x ≠ 0 ∧
      ∀ a ∈ B, (u a).eval x ≠ 0 := by
    intro x hx
    simp only [Q, eval_mul, eval_prod] at hx
    refine ⟨fun h => hx (by rw [h, zero_mul, zero_mul]), fun h => hx (by rw [h, mul_zero, zero_mul]),
      fun a ha h => hx ?_⟩
    rw [Finset.prod_eq_zero ha h, mul_zero]
  have hPz : ∀ x y, P.evalEval x y = 0 ↔ ∃ p ∈ Fs, p.evalEval x y = 0 := by
    intro x y
    rw [evalEval_prod, Finset.prod_eq_zero_iff]
  refine ⟨P, Q, hQ0, fun x hx => ⟨(hQ x hx).2.1, fun y hz => hRreg x y (hQ x hx).1 (hQ x hx).2.1 hz⟩,
    ?_⟩
  intro a haB ha
  refine ⟨∏ q ∈ Fs.filter (fun q => q ∉ normalizedFactors a), q, fun x y hx => ?_⟩
  have hreg := hRreg x y (hQ x hx).1 (hQ x hx).2.1
  have haz : a.evalEval x y = 0 ↔
      ∃ p ∈ normalizedFactors a, p.natDegree ≠ 0 ∧ p.evalEval x y = 0 := by
    conv_lhs => rw [hua a ha]
    rw [evalEval_mul, evalEval_C, evalEval_multiset_prod, mul_eq_zero, Multiset.prod_eq_zero_iff]
    constructor
    · rintro (h | h)
      · exact ((hQ x hx).2.2 a haB h).elim
      · obtain ⟨p, hp, hpz⟩ := Multiset.mem_map.mp h
        obtain ⟨hp, hd⟩ := Multiset.mem_filter.mp hp
        exact ⟨p, hp, hd, hpz⟩
    · rintro ⟨p, hp, hd, hpz⟩
      exact Or.inr (Multiset.mem_map.mpr ⟨p, Multiset.mem_filter.mpr ⟨hp, hd⟩, hpz⟩)
  have hgz : (∏ q ∈ Fs.filter (fun q => q ∉ normalizedFactors a), q).evalEval x y = 0 ↔
      ∃ q ∈ Fs, q ∉ normalizedFactors a ∧ q.evalEval x y = 0 := by
    rw [evalEval_prod, Finset.prod_eq_zero_iff]
    constructor
    · rintro ⟨q, hq, hz⟩
      obtain ⟨hq, hn⟩ := Finset.mem_filter.mp hq
      exact ⟨q, hq, hn, hz⟩
    · rintro ⟨q, hq, hn, hz⟩
      exact ⟨q, Finset.mem_filter.mpr ⟨hq, hn⟩, hz⟩
  refine ⟨fun hz => ?_, fun hz => ⟨fun haz' hg => ?_, fun hg => ?_⟩⟩
  · obtain ⟨p, hp, hd, hpz⟩ := haz.mp hz
    exact (hPz x y).mpr ⟨p, hmemFs a haB p hp hd, hpz⟩
  · obtain ⟨p, hp, hd, hpz⟩ := haz.mp haz'
    obtain ⟨q, hq, hn, hqz⟩ := hgz.mp hg
    exact hreg hz (hdouble x y p (hmemFs a haB p hp hd) q hq (fun h => hn (h ▸ hp)) hpz hqz)
  · obtain ⟨p, hp, hpz⟩ := (hPz x y).mp hz
    by_cases hpa : p ∈ normalizedFactors a
    · exact haz.mpr ⟨p, hpa, (hFs p hp).2.2, hpz⟩
    · exact (hg (hgz.mpr ⟨p, hp, hpa, hpz⟩)).elim

end OMA.PB

namespace OMA.PB

open Polynomial Set Filter
open scoped Polynomial.Bivariate Topology

theorem evalEval_eq_sum (a : ℝ[X][Y]) (x y : ℝ) :
    a.evalEval x y = ∑ i ∈ Finset.range (a.natDegree + 1), (a.coeff i).eval x * y ^ i := by
  rw [← eval₂_evalRingHom, eval₂_eq_sum_range]
  rfl

theorem continuous_evalEval (a : ℝ[X][Y]) :
    Continuous fun p : ℝ × ℝ => a.evalEval p.1 p.2 := by
  simp_rw [evalEval_eq_sum]
  exact continuous_finsetSum _ fun i _ =>
    ((a.coeff i).continuous.comp continuous_fst).mul (continuous_snd.pow i)

theorem hasDerivAt_evalEval (a : ℝ[X][Y]) (x y : ℝ) :
    HasDerivAt (fun t => a.evalEval x t) ((derivative a).evalEval x y) y := by
  have h := (a.map (evalRingHom x)).hasDerivAt y
  simpa only [derivative_map, map_evalRingHom_eval] using h

/-- Local existence and uniqueness of a root in the fibre variable near a
simple root, for positive derivative. -/
theorem local_root_pos {F G : ℝ → ℝ → ℝ} (hF : Continuous fun p : ℝ × ℝ => F p.1 p.2)
    (hG : Continuous fun p : ℝ × ℝ => G p.1 p.2) (hd : ∀ x y, HasDerivAt (F x) (G x y) y)
    {x₀ y₀ : ℝ} (h0 : F x₀ y₀ = 0) (h1 : 0 < G x₀ y₀) :
    ∃ ε₀ > 0, ∃ δ₀ > 0,
      (∀ x, |x - x₀| < δ₀ → ∀ y y', |y - y₀| ≤ ε₀ → |y' - y₀| ≤ ε₀ →
        F x y = 0 → F x y' = 0 → y = y') ∧
      ∀ ε, 0 < ε → ε ≤ ε₀ → ∃ δ > 0, ∀ x, |x - x₀| < δ → ∃ y, |y - y₀| < ε ∧ F x y = 0 := by
  have hopen : IsOpen {p : ℝ × ℝ | 0 < G p.1 p.2} := isOpen_lt continuous_const hG
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hopen (x₀, y₀) h1
  have hGpos : ∀ x y, |x - x₀| < r → |y - y₀| < r → 0 < G x y := by
    intro x y hx hy
    have hmem : (x, y) ∈ Metric.ball (x₀, y₀) r := by
      rw [Metric.mem_ball, Prod.dist_eq, Real.dist_eq, Real.dist_eq]
      exact max_lt hx hy
    exact hball hmem
  have hmono : ∀ x, |x - x₀| < r → StrictMonoOn (F x) (Icc (y₀ - r / 2) (y₀ + r / 2)) := by
    intro x hx
    apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
    · exact fun y _ => (hd x y).continuousAt.continuousWithinAt
    · intro y hy
      rw [interior_Icc] at hy
      rw [(hd x y).deriv]
      exact hGpos x y hx (by rw [abs_lt]; constructor <;> linarith [hy.1, hy.2])
  refine ⟨r / 2, by positivity, r, hr, ?_, ?_⟩
  · intro x hx y y' hy hy' hz hz'
    have hy_mem : y ∈ Icc (y₀ - r / 2) (y₀ + r / 2) := by
      rw [abs_le] at hy
      constructor <;> linarith [hy.1, hy.2]
    have hy'_mem : y' ∈ Icc (y₀ - r / 2) (y₀ + r / 2) := by
      rw [abs_le] at hy'
      constructor <;> linarith [hy'.1, hy'.2]
    exact (hmono x hx).injOn hy_mem hy'_mem (hz.trans hz'.symm)
  · intro ε hε hε'
    have hm := hmono x₀ (by simpa using hr)
    have hlo : F x₀ (y₀ - ε) < 0 := by
      rw [← h0]
      exact hm ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩ (by linarith)
    have hhi : 0 < F x₀ (y₀ + ε) := by
      rw [← h0]
      exact hm ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩ (by linarith)
    have hc (c : ℝ) : Continuous fun x => F x c :=
      hF.comp (continuous_id.prodMk continuous_const)
    have hlo' : ∀ᶠ x in 𝓝 x₀, F x (y₀ - ε) < 0 :=
      (hc (y₀ - ε)).continuousAt.eventually (gt_mem_nhds hlo)
    have hhi' : ∀ᶠ x in 𝓝 x₀, 0 < F x (y₀ + ε) :=
      (hc (y₀ + ε)).continuousAt.eventually (lt_mem_nhds hhi)
    obtain ⟨δ, hδ, h⟩ := Metric.eventually_nhds_iff.mp (hlo'.and hhi')
    refine ⟨δ, hδ, fun x hx => ?_⟩
    obtain ⟨h1, h2⟩ := h (by rwa [Real.dist_eq])
    have hcont : ContinuousOn (F x) (Icc (y₀ - ε) (y₀ + ε)) :=
      fun y _ => (hd x y).continuousAt.continuousWithinAt
    obtain ⟨y, hy, hz⟩ := intermediate_value_Ioo (by linarith) hcont ⟨h1, h2⟩
    exact ⟨y, by rw [abs_lt]; constructor <;> linarith [hy.1, hy.2], hz⟩

theorem local_root {F G : ℝ → ℝ → ℝ} (hF : Continuous fun p : ℝ × ℝ => F p.1 p.2)
    (hG : Continuous fun p : ℝ × ℝ => G p.1 p.2) (hd : ∀ x y, HasDerivAt (F x) (G x y) y)
    {x₀ y₀ : ℝ} (h0 : F x₀ y₀ = 0) (h1 : G x₀ y₀ ≠ 0) :
    ∃ ε₀ > 0, ∃ δ₀ > 0,
      (∀ x, |x - x₀| < δ₀ → ∀ y y', |y - y₀| ≤ ε₀ → |y' - y₀| ≤ ε₀ →
        F x y = 0 → F x y' = 0 → y = y') ∧
      ∀ ε, 0 < ε → ε ≤ ε₀ → ∃ δ > 0, ∀ x, |x - x₀| < δ → ∃ y, |y - y₀| < ε ∧ F x y = 0 := by
  rcases lt_or_gt_of_ne h1 with h | h
  · have key := local_root_pos (F := fun x y => -F x y) (G := fun x y => -G x y) hF.neg hG.neg
      (fun x y => (hd x y).neg) (by simpa using h0) (by simpa using h)
    simpa only [neg_eq_zero] using key
  · exact local_root_pos hF hG hd h0 h

/-- Roots near a parameter value with nonvanishing leading coefficient stay
in any open set containing the roots at that value. -/
theorem roots_near (P : ℝ[X][Y]) {x₀ : ℝ} (hlc : P.leadingCoeff.eval x₀ ≠ 0) {U : Set ℝ}
    (hU : IsOpen U) (hroots : ∀ y, P.evalEval x₀ y = 0 → y ∈ U) :
    ∃ δ > 0, ∀ x, |x - x₀| < δ → ∀ y, P.evalEval x y = 0 → y ∈ U := by
  let Rv : ℝ[X][Y] := reflect P.natDegree P
  have hid : ∀ x y : ℝ, y ≠ 0 → P.evalEval x y = Rv.evalEval x y⁻¹ * y ^ P.natDegree := by
    intro x y hy
    let _ := invertibleOfNonzero hy
    have h := eval₂_reflect_mul_pow (evalRingHom x) y P.natDegree P le_rfl
    rw [eval₂_evalRingHom, invOf_eq_inv] at h
    exact h.symm
  have hRv0 : Rv.evalEval x₀ 0 ≠ 0 := by
    have h : Rv.evalEval x₀ 0 = P.leadingCoeff.eval x₀ := by
      change eval x₀ (eval (C 0) Rv) = _
      rw [C_0, ← coeff_zero_eq_eval_zero, coeff_reflect, revAt_le (Nat.zero_le _), Nat.sub_zero,
        coeff_natDegree]
    rwa [h]
  have hopenR : IsOpen {p : ℝ × ℝ | Rv.evalEval p.1 p.2 ≠ 0} :=
    isOpen_ne_fun (continuous_evalEval Rv) continuous_const
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hopenR (x₀, 0) hRv0
  have hbound : ∀ x, |x - x₀| < r → ∀ y, P.evalEval x y = 0 → |y| ≤ r⁻¹ := by
    intro x hx y hy
    by_contra hlt
    rw [not_le] at hlt
    have hypos : 0 < |y| := (inv_pos.mpr hr).trans hlt
    have hy0 : y ≠ 0 := abs_pos.mp hypos
    have hinv : |y⁻¹| < r := by
      rw [abs_inv]
      exact inv_lt_of_inv_lt₀ hr hlt
    have hmem : (x, y⁻¹) ∈ Metric.ball (x₀, (0 : ℝ)) r := by
      rw [Metric.mem_ball, Prod.dist_eq, Real.dist_eq, Real.dist_eq, sub_zero]
      exact max_lt hx hinv
    have hne : Rv.evalEval x y⁻¹ ≠ 0 := hball hmem
    rw [hid x y hy0] at hy
    exact (mul_ne_zero hne (pow_ne_zero _ hy0)) hy
  have hK : IsCompact (Icc (-r⁻¹) r⁻¹ \ U) := isCompact_Icc.diff hU
  have hopenP : IsOpen {p : ℝ × ℝ | P.evalEval p.1 p.2 ≠ 0} :=
    isOpen_ne_fun (continuous_evalEval P) continuous_const
  have hsub : ({x₀} : Set ℝ) ×ˢ (Icc (-r⁻¹) r⁻¹ \ U) ⊆ {p : ℝ × ℝ | P.evalEval p.1 p.2 ≠ 0} := by
    rintro ⟨x, y⟩ ⟨hx, hy⟩
    rw [mem_singleton_iff] at hx
    change x = x₀ at hx
    subst hx
    exact fun h => hy.2 (hroots y h)
  obtain ⟨u, v, hu, -, hxu, hKv, huv⟩ := generalized_tube_lemma isCompact_singleton hK hopenP hsub
  obtain ⟨δ₂, hδ₂, hball₂⟩ := Metric.isOpen_iff.mp hu x₀ (hxu rfl)
  refine ⟨min r δ₂, lt_min hr hδ₂, fun x hx y hy => ?_⟩
  by_contra hyU
  have hyb := abs_le.mp (hbound x (hx.trans_le (min_le_left _ _)) y hy)
  have hxu' : x ∈ u := hball₂ (by
    rw [Metric.mem_ball, Real.dist_eq]
    exact hx.trans_le (min_le_right _ _))
  exact huv (⟨hxu', hKv ⟨⟨hyb.1, hyb.2⟩, hyU⟩⟩ : (x, y) ∈ u ×ˢ v) hy

/-- The real roots in the fibre variable at a parameter value. -/
noncomputable def rts (P : ℝ[X][Y]) (x : ℝ) : Finset ℝ :=
  (P.map (evalRingHom x)).roots.toFinset

theorem map_ne_zero_of_lc {P : ℝ[X][Y]} {x : ℝ} (h : P.leadingCoeff.eval x ≠ 0) :
    P.map (evalRingHom x) ≠ 0 := by
  intro h0
  apply h
  have h1 := congrArg (fun q : ℝ[X] => q.coeff P.natDegree) h0
  simpa [coeff_map] using h1

theorem mem_rts {P : ℝ[X][Y]} {x : ℝ} (h : P.leadingCoeff.eval x ≠ 0) {y : ℝ} :
    y ∈ rts P x ↔ P.evalEval x y = 0 := by
  rw [rts, Multiset.mem_toFinset, mem_roots (map_ne_zero_of_lc h), IsRoot.def,
    map_evalRingHom_eval]

theorem exists_pos_le {ι : Type*} (s : Finset ι) (f : ι → ℝ) (h : ∀ i ∈ s, 0 < f i) :
    ∃ c > 0, ∀ i ∈ s, c ≤ f i := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨1, one_pos, by simp⟩
  | insert a s ha ih =>
    obtain ⟨c, hc, hcs⟩ := ih fun i hi => h i (Finset.mem_insert_of_mem hi)
    refine ⟨min c (f a), lt_min hc (h a (Finset.mem_insert_self a s)), fun i hi => ?_⟩
    rcases Finset.mem_insert.mp hi with rfl | hi
    · exact min_le_right _ _
    · exact (min_le_left _ _).trans (hcs i hi)

/-- Near a regular parameter value the number of roots is constant and the
sorted roots move by less than any prescribed amount. -/
theorem local_structure (P : ℝ[X][Y]) {x₀ : ℝ} (hlc : P.leadingCoeff.eval x₀ ≠ 0)
    (hsimple : ∀ y, P.evalEval x₀ y = 0 → (derivative P).evalEval x₀ y ≠ 0) {n : ℕ}
    (hn : (rts P x₀).card = n) {ε : ℝ} (hε : 0 < ε) :
    ∃ δ > 0, ∀ x, |x - x₀| < δ → ∃ hc : (rts P x).card = n,
      ∀ i, |(rts P x).orderEmbOfFin hc i - (rts P x₀).orderEmbOfFin hn i| < ε := by
  classical
  let e := (rts P x₀).orderEmbOfFin hn
  have hroot : ∀ i, P.evalEval x₀ (e i) = 0 := fun i =>
    (mem_rts hlc).mp (Finset.orderEmbOfFin_mem _ _ i)
  have hloc := fun i => local_root (continuous_evalEval P) (continuous_evalEval (derivative P))
    (hasDerivAt_evalEval P) (hroot i) (hsimple _ (hroot i))
  choose ε₀ hε₀ δ₀ hδ₀ huniq hexist using hloc
  obtain ⟨c₁, hc₁, hc₁'⟩ := exists_pos_le Finset.univ ε₀ fun i _ => hε₀ i
  obtain ⟨c₂, hc₂, hc₂'⟩ := exists_pos_le (Finset.univ : Finset (Fin n × Fin n))
    (fun p => if p.1 < p.2 then (e p.2 - e p.1) / 2 else 1) (by
      intro p _
      split_ifs with h
      · have := e.strictMono h
        linarith
      · exact one_pos)
  have hε'pos : 0 < min ε (min c₁ c₂) := lt_min hε (lt_min hc₁ hc₂)
  have hε'ε : min ε (min c₁ c₂) ≤ ε := min_le_left _ _
  have hε'0 : ∀ i, min ε (min c₁ c₂) ≤ ε₀ i := fun i =>
    (min_le_right _ _).trans ((min_le_left _ _).trans (hc₁' i (Finset.mem_univ i)))
  have hgap : ∀ i j, i < j → e i + min ε (min c₁ c₂) ≤ e j - min ε (min c₁ c₂) := by
    intro i j hij
    have h1 := hc₂' (i, j) (Finset.mem_univ _)
    simp only [hij, if_true] at h1
    have h2 : min ε (min c₁ c₂) ≤ c₂ := (min_le_right _ _).trans (min_le_right _ _)
    linarith
  generalize min ε (min c₁ c₂) = ε' at hε'pos hε'ε hε'0 hgap
  choose δ₁ hδ₁ hex using fun i => hexist i ε' hε'pos (hε'0 i)
  let U : Set ℝ := ⋃ i, Ioo (e i - ε') (e i + ε')
  have hUopen : IsOpen U := isOpen_iUnion fun i => isOpen_Ioo
  have hU₀ : ∀ y, P.evalEval x₀ y = 0 → y ∈ U := by
    intro y hy
    have hy' : y ∈ Set.range e := by
      rw [Finset.range_orderEmbOfFin]
      exact (mem_rts hlc).mpr hy
    obtain ⟨i, rfl⟩ := hy'
    exact mem_iUnion.mpr ⟨i, by constructor <;> linarith⟩
  obtain ⟨δ₂, hδ₂, hnear⟩ := roots_near P hlc hUopen hU₀
  have hlcn : ∀ᶠ x in 𝓝 x₀, P.leadingCoeff.eval x ≠ 0 :=
    P.leadingCoeff.continuous.continuousAt.eventually_ne hlc
  obtain ⟨δ₃, hδ₃, hlc'⟩ := Metric.eventually_nhds_iff.mp hlcn
  obtain ⟨c₃, hc₃, hc₃'⟩ := exists_pos_le Finset.univ (fun i => min (δ₀ i) (δ₁ i))
    fun i _ => lt_min (hδ₀ i) (hδ₁ i)
  refine ⟨min (min δ₂ δ₃) c₃, lt_min (lt_min hδ₂ hδ₃) hc₃, fun x hx => ?_⟩
  have hx₂ : |x - x₀| < δ₂ := hx.trans_le ((min_le_left _ _).trans (min_le_left _ _))
  have hx₃ : dist x x₀ < δ₃ := by
    rw [Real.dist_eq]
    exact hx.trans_le ((min_le_left _ _).trans (min_le_right _ _))
  have hx₀i : ∀ i, |x - x₀| < δ₀ i := fun i =>
    hx.trans_le ((min_le_right _ _).trans ((hc₃' i (Finset.mem_univ i)).trans (min_le_left _ _)))
  have hx₁i : ∀ i, |x - x₀| < δ₁ i := fun i =>
    hx.trans_le ((min_le_right _ _).trans ((hc₃' i (Finset.mem_univ i)).trans (min_le_right _ _)))
  have hlcx := hlc' hx₃
  choose f hf hfz using fun i => hex i x (hx₁i i)
  have hmono : StrictMono f := by
    intro i j hij
    have h1 := abs_lt.mp (hf i)
    have h2 := abs_lt.mp (hf j)
    have h3 := hgap i j hij
    linarith [h1.2, h2.1]
  have hmem : ∀ i, f i ∈ rts P x := fun i => (mem_rts hlcx).mpr (hfz i)
  have hsurj : ∀ y ∈ rts P x, ∃ i, f i = y := by
    intro y hy
    have hyz := (mem_rts hlcx).mp hy
    obtain ⟨i, hi⟩ := mem_iUnion.mp (hnear x hx₂ y hyz)
    refine ⟨i, huniq i x (hx₀i i) (f i) y ((hf i).le.trans (hε'0 i)) ?_ (hfz i) hyz⟩
    rw [abs_le]
    constructor <;> linarith [hi.1, hi.2, hε'0 i]
  have himg : rts P x = Finset.univ.image f := by
    ext y
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨fun hy => hsurj y hy, fun ⟨i, hi⟩ => hi ▸ hmem i⟩
  have hc : (rts P x).card = n := by
    rw [himg, Finset.card_image_of_injective _ hmono.injective, Finset.card_univ, Fintype.card_fin]
  refine ⟨hc, fun i => ?_⟩
  have hfe : f = (rts P x).orderEmbOfFin hc := Finset.orderEmbOfFin_unique hc hmem hmono
  rw [← hfe]
  exact (hf i).trans_le hε'ε

/-- Over a preconnected set of regular parameter values the real roots are
the graphs of finitely many continuous functions, strictly ordered. -/
theorem exists_root_curves {I : Set ℝ} (hI : IsPreconnected I) (P : ℝ[X][Y])
    (hreg : ∀ x ∈ I, P.leadingCoeff.eval x ≠ 0 ∧
      ∀ y, P.evalEval x y = 0 → (derivative P).evalEval x y ≠ 0) :
    ∃ (N : ℕ) (ξ : Fin N → ℝ → ℝ), (∀ i, ContinuousOn (ξ i) I) ∧
      (∀ x ∈ I, StrictMono fun i => ξ i x) ∧
      ∀ x ∈ I, ∀ y, P.evalEval x y = 0 ↔ ∃ i, ξ i x = y := by
  classical
  rcases I.eq_empty_or_nonempty with rfl | ⟨xb, hxb⟩
  · exact ⟨0, fun i => i.elim0, by simp, by simp, by simp⟩
  have hloc : ∀ x₀ ∈ I, ∀ᶠ x in 𝓝 x₀, (rts P x).card = (rts P x₀).card := by
    intro x₀ hx₀
    obtain ⟨δ, hδ, h⟩ := local_structure P (hreg x₀ hx₀).1 (hreg x₀ hx₀).2 rfl one_pos
    exact Metric.eventually_nhds_iff.mpr ⟨δ, hδ, fun x hx => (h x (by rwa [← Real.dist_eq])).1⟩
  have hcard : ∀ x ∈ I, (rts P x).card = (rts P xb).card := by
    intro x hx
    have hcont : ContinuousOn (fun x => (rts P x).card) I := fun x₀ hx₀ =>
      (continuousAt_const.congr ((hloc x₀ hx₀).mono fun x h => h.symm)).continuousWithinAt
    exact hI.constant hcont hx hxb
  let ξ : Fin (rts P xb).card → ℝ → ℝ := fun i x =>
    if h : (rts P x).card = (rts P xb).card then (rts P x).orderEmbOfFin h i else 0
  have hξ : ∀ x (h : (rts P x).card = (rts P xb).card) i,
      ξ i x = (rts P x).orderEmbOfFin h i := fun x h i => dif_pos h
  refine ⟨(rts P xb).card, ξ, ?_, ?_, ?_⟩
  · intro i x₀ hx₀
    apply ContinuousAt.continuousWithinAt
    rw [Metric.continuousAt_iff]
    intro ε hε
    obtain ⟨δ, hδ, h⟩ :=
      local_structure P (hreg x₀ hx₀).1 (hreg x₀ hx₀).2 (hcard x₀ hx₀) hε
    refine ⟨δ, hδ, fun x hx => ?_⟩
    obtain ⟨hc, hclose⟩ := h x (by rwa [← Real.dist_eq])
    rw [Real.dist_eq, hξ x hc, hξ x₀ (hcard x₀ hx₀)]
    exact hclose i
  · intro x hx i j hij
    simp only [hξ x (hcard x hx)]
    exact ((rts P x).orderEmbOfFin (hcard x hx)).strictMono hij
  · intro x hx y
    rw [← mem_rts (hreg x hx).1]
    constructor
    · intro hy
      have hy' : y ∈ Set.range ((rts P x).orderEmbOfFin (hcard x hx)) := by
        rw [Finset.range_orderEmbOfFin]
        exact hy
      obtain ⟨i, hi⟩ := hy'
      exact ⟨i, (hξ x (hcard x hx) i).trans hi⟩
    · rintro ⟨i, rfl⟩
      rw [hξ x (hcard x hx)]
      exact Finset.orderEmbOfFin_mem _ _ i

end OMA.PB

namespace OMA.PB

open Polynomial Set Filter
open scoped Polynomial.Bivariate Topology

/- ### Calculus of the separating ideal -/

/-- The separating ideal is convex for the ordering at the second ultrafilter. -/
theorem mem_of_abs_le {n : ℕ} {α β : Ultrafilter (Point n)} {a b : Poly n}
    (hb : b ∈ separatingIdeal α β)
    (h : ∀ᶠ x in β, |MvPolynomial.eval x a| ≤ |MvPolynomial.eval x b|) :
    a ∈ separatingIdeal α β := by
  obtain ⟨t, ht, ht'⟩ := dominate_of_mem hb
  have htm : t ∈ separatingIdeal α β := Ideal.subset_span
    ⟨ht, ht'.mono fun x hx => by linarith [abs_nonneg (MvPolynomial.eval x b)]⟩
  rcases α.em (fun x => 0 ≤ MvPolynomial.eval x a) with ha | ha
  · have hg : a + t ∈ separatingIdeal α β := by
      apply Ideal.subset_span
      constructor
      · filter_upwards [ha, ht] with x h₁ h₂
        simpa using add_nonneg h₁ h₂
      · filter_upwards [h, ht'] with x h₁ h₂
        simp only [map_add]
        linarith [le_abs_self (MvPolynomial.eval x a)]
    simpa using (separatingIdeal α β).sub_mem hg htm
  · have hg : -a + t ∈ separatingIdeal α β := by
      apply Ideal.subset_span
      constructor
      · filter_upwards [ha, ht] with x h₁ h₂
        simp only [map_add, map_neg]
        linarith [not_le.mp h₁]
      · filter_upwards [h, ht'] with x h₁ h₂
        simp only [map_add, map_neg]
        linarith [neg_abs_le (MvPolynomial.eval x a)]
    have h2 := (separatingIdeal α β).neg_mem ((separatingIdeal α β).sub_mem hg htm)
    simpa using h2

/-- The two orderings agree modulo the separating ideal. -/
theorem mem_of_sub_mem {n : ℕ} {α β : Ultrafilter (Point n)} {u v : Poly n}
    (h : u - v ∈ separatingIdeal α β) (hu : ∀ᶠ x in α, 0 ≤ MvPolynomial.eval x u)
    (hv : ∀ᶠ x in β, MvPolynomial.eval x v ≤ 0) :
    u ∈ separatingIdeal α β ∧ v ∈ separatingIdeal α β := by
  have key : v ∈ separatingIdeal α β := by
    rcases β.em (fun x => |MvPolynomial.eval x v| ≤ |MvPolynomial.eval x (u - v)|) with hc | hc
    · exact mem_of_abs_le h hc
    · have hun : u ∈ separatingIdeal α β := by
        apply Ideal.subset_span
        refine ⟨hu, ?_⟩
        filter_upwards [hc, hv] with x h₁ h₂
        rw [not_le, map_sub, abs_of_nonpos h₂] at h₁
        have h₃ := le_abs_self (MvPolynomial.eval x u - MvPolynomial.eval x v)
        linarith
      have h2 := (separatingIdeal α β).sub_mem hun h
      simpa using h2
  refine ⟨?_, key⟩
  have h2 := (separatingIdeal α β).add_mem h key
  simpa using h2

theorem mem_of_C_mul_mem {n : ℕ} {J : Ideal (Poly n)} {c : ℝ} (hc : c ≠ 0) {p : Poly n}
    (h : MvPolynomial.C c * p ∈ J) : p ∈ J := by
  have hp : p = MvPolynomial.C c⁻¹ * (MvPolynomial.C c * p) := by
    rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul]
  rw [hp]
  exact J.mul_mem_left _ h

/- ### One-variable calculus on a vertical line -/

theorem crit_above {f f' : ℝ → ℝ} (hf : ∀ t, HasDerivAt f (f' t) t) {a b : ℝ} (hab : a < b)
    (h0 : f a = 0) (h1 : 0 < f' a) (h2 : f b < 0) : ∃ c ∈ Ioo a b, f' c = 0 ∧ 0 < f c := by
  have hcont : ContinuousOn f (Icc a b) := fun t _ => (hf t).continuousAt.continuousWithinAt
  obtain ⟨c, hc, hmax⟩ := isCompact_Icc.exists_isMaxOn (nonempty_Icc.mpr hab.le) hcont
  have hslope := (hasDerivAt_iff_tendsto_slope.mp (hf a)).eventually (lt_mem_nhds h1)
  have hright : ∀ᶠ t in 𝓝[>] a, 0 < slope f a t :=
    hslope.filter_mono (nhdsWithin_mono a fun t ht => ne_of_gt ht)
  obtain ⟨t, hts, hta, htb⟩ := (hright.and (Ioo_mem_nhdsGT hab)).exists
  have htpos : 0 < f t := by
    rw [slope_def_field, h0, sub_zero] at hts
    exact (div_pos_iff_of_pos_right (sub_pos.mpr hta)).mp hts
  have hfc : 0 < f c := htpos.trans_le (hmax ⟨hta.le, htb.le⟩)
  have hca : c ≠ a := fun h => by
    rw [h, h0] at hfc
    exact lt_irrefl _ hfc
  have hcb : c ≠ b := fun h => by
    rw [h] at hfc
    exact lt_asymm hfc h2
  have hc' : c ∈ Ioo a b := ⟨lt_of_le_of_ne hc.1 (Ne.symm hca), lt_of_le_of_ne hc.2 hcb⟩
  exact ⟨c, hc', (hmax.isLocalMax (Icc_mem_nhds hc'.1 hc'.2)).hasDerivAt_eq_zero (hf c), hfc⟩

theorem crit_below {f f' : ℝ → ℝ} (hf : ∀ t, HasDerivAt f (f' t) t) {a b : ℝ} (hab : a < b)
    (h0 : f b = 0) (h1 : 0 < f' b) (h2 : 0 < f a) : ∃ c ∈ Ioo a b, f' c = 0 ∧ f c < 0 := by
  have hg : ∀ t, HasDerivAt (fun t => -f (-t)) (f' (-t)) t := by
    intro t
    have h : HasDerivAt (fun t => -f (-t)) (-(f' (-t) * -1)) t :=
      ((hf (-t)).comp t (hasDerivAt_neg t)).neg
    simpa using h
  obtain ⟨c, hc, hc0, hcpos⟩ := crit_above (f := fun t => -f (-t)) (f' := fun t => f' (-t)) hg
    (neg_lt_neg hab) (by simp [h0]) (by simpa using h1) (by simpa using h2)
  exact ⟨-c, ⟨by linarith [hc.2], by linarith [hc.1]⟩, hc0, by simpa using hcpos⟩

theorem root_Ioc {f : ℝ → ℝ} (hf : Continuous f) {a b : ℝ} (hab : a ≤ b) (ha : 0 < f a)
    (hb : f b ≤ 0) : ∃ c ∈ Ioc a b, f c = 0 := by
  obtain ⟨c, hc, h⟩ := intermediate_value_Icc' hab hf.continuousOn ⟨hb, ha.le⟩
  exact ⟨c, ⟨lt_of_le_of_ne hc.1 fun h' => ha.ne' (h' ▸ h), hc.2⟩, h⟩

theorem root_Ico {f : ℝ → ℝ} (hf : Continuous f) {a b : ℝ} (hab : a ≤ b) (ha : f a ≤ 0)
    (hb : 0 < f b) : ∃ c ∈ Ico a b, f c = 0 := by
  obtain ⟨c, hc, h⟩ := intermediate_value_Icc hab hf.continuousOn ⟨ha, hb.le⟩
  exact ⟨c, ⟨hc.1, lt_of_le_of_ne hc.2 fun h' => hb.ne' (h' ▸ h)⟩, h⟩

theorem continuous_evalEval_right (a : ℝ[X][Y]) (x : ℝ) : Continuous fun y => a.evalEval x y :=
  (continuous_evalEval a).comp (continuous_const.prodMk continuous_id)

/- ### Strips -/

/-- The vertical strip over a set of abscissae. -/
def stripSet (I : Set ℝ) : Set (Point 2) := {z | z 0 ∈ I}

/-- The identification of `ℝ[X][Y]` with `MvPolynomial (Fin 2) ℝ`; the outer variable is `X 1`. -/
noncomputable abbrev toMv : ℝ[X][Y] ≃ₐ[ℝ] Poly 2 := Polynomial.Bivariate.equivMvPolynomial ℝ

theorem eval_toMv (z : Point 2) (a : ℝ[X][Y]) :
    MvPolynomial.eval z (toMv a) = a.evalEval (z 0) (z 1) := by
  have h : (MvPolynomial.eval z).comp (toMv : ℝ[X][Y] ≃ₐ[ℝ] Poly 2).toAlgHom.toRingHom =
      evalEvalRingHom (z 0) (z 1) := by
    ext <;> simp [toMv]
  exact RingHom.congr_fun h a

theorem toMv_rem (a : ℝ[X][Y]) : toMv (rem a) =
    MvPolynomial.C (a.natDegree : ℝ) * toMv a - MvPolynomial.X 1 * toMv (derivative a) := by
  simp [rem, toMv]

/-- Combinatorial data of a vertical strip: the zeros of the members of a
finite family lie on finitely many ordered curves, and every member has a
constant sign along each curve. -/
structure StripData (I : Set ℝ) (B : Finset ℝ[X][Y]) where
  /-- the number of curves -/
  N : ℕ
  /-- the curves -/
  ξ : Fin N → ℝ → ℝ
  mono : ∀ x ∈ I, StrictMono fun i => ξ i x
  cont : ∀ i, ContinuousOn (ξ i) I
  zeros : ∀ a ∈ B, a ≠ 0 → ∀ x ∈ I, ∀ y, a.evalEval x y = 0 → ∃ i, ξ i x = y
  inv : ∀ a ∈ B, ∀ i, (∀ x ∈ I, a.evalEval x (ξ i x) = 0) ∨
    (∀ x ∈ I, 0 < a.evalEval x (ξ i x)) ∨ (∀ x ∈ I, a.evalEval x (ξ i x) < 0)

namespace StripData

variable {I : Set ℝ} {B : Finset ℝ[X][Y]} (st : StripData I B)

include st in
theorem lt_of_lt {i j : Fin st.N} {x : ℝ} (hx : x ∈ I) (h : st.ξ i x < st.ξ j x) :
    ∀ x' ∈ I, st.ξ i x' < st.ξ j x' := fun x' hx' =>
  (st.mono x' hx').lt_iff_lt.mpr ((st.mono x hx).lt_iff_lt.mp h)

theorem root_curve {a : ℝ[X][Y]} (ha : a ∈ B) {i : Fin st.N} {x : ℝ} (hx : x ∈ I)
    (h : a.evalEval x (st.ξ i x) = 0) : ∀ x' ∈ I, a.evalEval x' (st.ξ i x') = 0 := by
  rcases st.inv a ha i with h0 | hp | hn
  · exact h0
  · exact absurd h (hp x hx).ne'
  · exact absurd h (hn x hx).ne

theorem sign_curve {a : ℝ[X][Y]} (ha : a ∈ B) {i : Fin st.N} {x : ℝ} (hx : x ∈ I) {s : ℝ}
    (h : 0 < s * a.evalEval x (st.ξ i x)) : ∀ x' ∈ I, 0 < s * a.evalEval x' (st.ξ i x') := by
  intro x' hx'
  rcases st.inv a ha i with h0 | hp | hn
  · rw [h0 x hx, mul_zero] at h
    exact absurd h (lt_irrefl _)
  · exact mul_pos (pos_of_mul_pos_left h (hp x hx).le) (hp x' hx')
  · have hs : s < 0 := neg_of_mul_pos_left h (hn x hx).le
    exact mul_pos_of_neg_of_neg hs (hn x' hx')

/-- If a member of the family is not in the separating ideal and has no root
curve between the two ultrafilters, its sign at both ultrafilters is its sign
along any curve separating them. -/
theorem band_sign {α β : Ultrafilter (Point 2)} (hα : stripSet I ∈ α) (hβ : stripSet I ∈ β)
    {r : ℝ[X][Y]} (hr : r ∈ B) (hr0 : r ≠ 0) (hrJ : toMv r ∉ separatingIdeal α β)
    (IH : ∀ i, (∀ x ∈ I, r.evalEval x (st.ξ i x) = 0) → (∀ᶠ z : Point 2 in α, z 1 ≤ st.ξ i (z 0)) →
      (∀ᶠ z : Point 2 in β, st.ξ i (z 0) ≤ z 1) → toMv r ∈ separatingIdeal α β)
    {j : Fin st.N} (hjα : ∀ᶠ z : Point 2 in α, z 1 < st.ξ j (z 0)) (hjβ : ∀ᶠ z : Point 2 in β, st.ξ j (z 0) < z 1)
    {t : ℝ} (ht : ∀ x ∈ I, 0 < t * r.evalEval x (st.ξ j x)) :
    (∀ᶠ z : Point 2 in α, 0 < t * r.evalEval (z 0) (z 1)) ∧ (∀ᶠ z : Point 2 in β, 0 < t * r.evalEval (z 0) (z 1)) := by
  obtain ⟨z₀, hz₀⟩ := Filter.nonempty_of_mem hα
  have ht0 : t ≠ 0 := fun h => by
    have h' := ht _ hz₀
    rw [h, zero_mul] at h'
    exact lt_irrefl _ h'
  have hcont (x : ℝ) : Continuous fun y => t * r.evalEval x y :=
    continuous_const.mul (continuous_evalEval_right r x)
  constructor
  · by_contra hn
    have hle := (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt
    have hex : ∀ᶠ z : Point 2 in α, ∃ k, z 1 ≤ st.ξ k (z 0) ∧ st.ξ k (z 0) < st.ξ j (z 0) ∧
        r.evalEval (z 0) (st.ξ k (z 0)) = 0 := by
      filter_upwards [hle, hjα, hα] with z hz hlt hzI
      obtain ⟨c, hc, hc0⟩ := root_Ico (hcont (z 0)) hlt.le hz (ht _ hzI)
      have hc0' : r.evalEval (z 0) c = 0 := (mul_eq_zero.mp hc0).resolve_left ht0
      obtain ⟨k, rfl⟩ := st.zeros r hr hr0 _ hzI c hc0'
      exact ⟨k, hc.1, hc.2, hc0'⟩
    obtain ⟨k, hk⟩ := (Ultrafilter.eventually_exists_iff (f := α)).mp hex
    obtain ⟨z₁, hz₁, hz₁I⟩ := (hk.and hα).exists
    have hkj := st.lt_of_lt hz₁I hz₁.2.1
    refine hrJ (IH k (st.root_curve hr hz₁I hz₁.2.2) (hk.mono fun _ h => h.1) ?_)
    filter_upwards [hjβ, hβ] with z hz hzI
    exact ((hkj _ hzI).trans hz).le
  · by_contra hn
    have hle := (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt
    have hex : ∀ᶠ z : Point 2 in β, ∃ k, st.ξ j (z 0) < st.ξ k (z 0) ∧ st.ξ k (z 0) ≤ z 1 ∧
        r.evalEval (z 0) (st.ξ k (z 0)) = 0 := by
      filter_upwards [hle, hjβ, hβ] with z hz hlt hzI
      obtain ⟨c, hc, hc0⟩ := root_Ioc (hcont (z 0)) hlt.le (ht _ hzI) hz
      have hc0' : r.evalEval (z 0) c = 0 := (mul_eq_zero.mp hc0).resolve_left ht0
      obtain ⟨k, rfl⟩ := st.zeros r hr hr0 _ hzI c hc0'
      exact ⟨k, hc.1, hc.2, hc0'⟩
    obtain ⟨k, hk⟩ := (Ultrafilter.eventually_exists_iff (f := β)).mp hex
    obtain ⟨z₁, hz₁, hz₁I⟩ := (hk.and hβ).exists
    have hjk := st.lt_of_lt hz₁I hz₁.1
    refine hrJ (IH k (st.root_curve hr hz₁I hz₁.2.2) ?_ (hk.mono fun _ h => h.2.1))
    filter_upwards [hjα, hα] with z hz hzI
    exact (hz.trans (hjk _ hzI)).le

/-- The simple-root case of the main lemma. -/
theorem claim_simple {α β : Ultrafilter (Point 2)} (hα : stripSet I ∈ α) (hβ : stripSet I ∈ β)
    {a : ℝ[X][Y]} (ha' : derivative a ∈ B) (hr : rem a ∈ B) (h0 : a.natDegree ≠ 0)
    (IHa' : ∀ i, (∀ x ∈ I, (derivative a).evalEval x (st.ξ i x) = 0) →
      (∀ᶠ z : Point 2 in α, z 1 ≤ st.ξ i (z 0)) → (∀ᶠ z : Point 2 in β, st.ξ i (z 0) ≤ z 1) →
      toMv (derivative a) ∈ separatingIdeal α β)
    (IHr : ∀ i, (∀ x ∈ I, (rem a).evalEval x (st.ξ i x) = 0) →
      (∀ᶠ z : Point 2 in α, z 1 ≤ st.ξ i (z 0)) → (∀ᶠ z : Point 2 in β, st.ξ i (z 0) ≤ z 1) →
      toMv (rem a) ∈ separatingIdeal α β)
    {i : Fin st.N} (hroot : ∀ x ∈ I, a.evalEval x (st.ξ i x) = 0)
    (hαlt : ∀ᶠ z : Point 2 in α, z 1 < st.ξ i (z 0)) (hβlt : ∀ᶠ z : Point 2 in β, st.ξ i (z 0) < z 1)
    {s : ℝ} (hs : ∀ x ∈ I, 0 < s * (derivative a).evalEval x (st.ξ i x)) :
    toMv a ∈ separatingIdeal α β := by
  obtain ⟨z₀, hz₀⟩ := Filter.nonempty_of_mem hα
  have hd : (0 : ℝ) < a.natDegree := by exact_mod_cast Nat.pos_of_ne_zero h0
  have hs0 : s ≠ 0 := fun h => by
    have h' := hs _ hz₀
    rw [h, zero_mul] at h'
    exact lt_irrefl _ h'
  have hda0 : derivative a ≠ 0 := fun h => by
    have h' := hs _ hz₀
    rw [h, evalEval_zero, mul_zero] at h'
    exact lt_irrefl _ h'
  have hfin : toMv (derivative a) ∈ separatingIdeal α β → toMv (rem a) ∈ separatingIdeal α β →
      toMv a ∈ separatingIdeal α β := by
    intro h1 h2
    apply mem_of_C_mul_mem hd.ne'
    have h3 := (separatingIdeal α β).add_mem h2
      ((separatingIdeal α β).mul_mem_left (MvPolynomial.X 1) h1)
    rw [toMv_rem] at h3
    simpa using h3
  have hder (x : ℝ) : ∀ y, HasDerivAt (fun y => s * a.evalEval x y)
      (s * (derivative a).evalEval x y) y := fun y => (hasDerivAt_evalEval a x y).const_mul s
  by_cases hgood : (∀ᶠ z : Point 2 in α, s * a.evalEval (z 0) (z 1) ≤ 0) ∧
      (∀ᶠ z : Point 2 in β, 0 ≤ s * a.evalEval (z 0) (z 1))
  · apply mem_of_C_mul_mem (neg_ne_zero.mpr hs0)
    apply Ideal.subset_span
    constructor
    · filter_upwards [hgood.1] with z hz
      rw [map_mul, MvPolynomial.eval_C, eval_toMv]
      linarith
    · filter_upwards [hgood.2] with z hz
      rw [map_mul, MvPolynomial.eval_C, eval_toMv]
      linarith
  rw [not_and_or] at hgood
  rcases hgood with hbad | hbad
  · -- `s * a` is positive at `α`: there is a critical curve below the root curve
    have hpos := (Ultrafilter.eventually_not.mpr hbad).mono fun _ => lt_of_not_ge
    have hcrit : ∀ᶠ z : Point 2 in α, ∃ j, z 1 < st.ξ j (z 0) ∧ st.ξ j (z 0) < st.ξ i (z 0) ∧
        (derivative a).evalEval (z 0) (st.ξ j (z 0)) = 0 ∧
        s * a.evalEval (z 0) (st.ξ j (z 0)) < 0 := by
      filter_upwards [hpos, hαlt, hα] with z hz hlt hzI
      obtain ⟨c, hc, hc0, hcneg⟩ := crit_below (hder (z 0)) hlt
        (by rw [hroot _ hzI, mul_zero]) (hs _ hzI) hz
      have hc0' : (derivative a).evalEval (z 0) c = 0 := (mul_eq_zero.mp hc0).resolve_left hs0
      obtain ⟨j, rfl⟩ := st.zeros _ ha' hda0 _ hzI c hc0'
      exact ⟨j, hc.1, hc.2, hc0', hcneg⟩
    obtain ⟨j, hj⟩ := (Ultrafilter.eventually_exists_iff (f := α)).mp hcrit
    obtain ⟨z₁, hz₁, hz₁I⟩ := (hj.and hα).exists
    have hji := st.lt_of_lt hz₁I hz₁.2.1
    have hjα : ∀ᶠ z : Point 2 in α, z 1 < st.ξ j (z 0) := hj.mono fun _ h => h.1
    have hjβ : ∀ᶠ z : Point 2 in β, st.ξ j (z 0) < z 1 := by
      filter_upwards [hβlt, hβ] with z hz hzI
      exact (hji _ hzI).trans hz
    have hmem' := IHa' j (st.root_curve ha' hz₁I hz₁.2.2.1) (hjα.mono fun _ h => h.le)
      (hjβ.mono fun _ h => h.le)
    by_cases hrJ : toMv (rem a) ∈ separatingIdeal α β
    · exact hfin hmem' hrJ
    have hrsign : ∀ x ∈ I, 0 < -s * (rem a).evalEval x (st.ξ j x) := by
      apply st.sign_curve hr hz₁I
      rw [evalEval_rem, hz₁.2.2.1, mul_zero, sub_zero]
      nlinarith [hz₁.2.2.2]
    have hr0 : rem a ≠ 0 := fun h => by
      have h' := hrsign _ hz₁I
      rw [h, evalEval_zero, mul_zero] at h'
      exact lt_irrefl _ h'
    obtain ⟨-, hrβ⟩ := st.band_sign hα hβ hr hr0 hrJ IHr hjα hjβ hrsign
    have hsub : MvPolynomial.C (s * a.natDegree) * toMv a - MvPolynomial.C s * toMv (rem a) ∈
        separatingIdeal α β := by
      have he : MvPolynomial.C (s * a.natDegree) * toMv a - MvPolynomial.C s * toMv (rem a) =
          MvPolynomial.C s * (MvPolynomial.X 1 * toMv (derivative a)) := by
        rw [toMv_rem, map_mul]
        ring
      rw [he]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hmem')
    refine mem_of_C_mul_mem (mul_ne_zero hs0 hd.ne') (mem_of_sub_mem hsub ?_ ?_).1
    · filter_upwards [hpos] with z hz
      rw [map_mul, MvPolynomial.eval_C, eval_toMv]
      nlinarith
    · filter_upwards [hrβ] with z hz
      rw [map_mul, MvPolynomial.eval_C, eval_toMv]
      linarith
  · -- `s * a` is negative at `β`: there is a critical curve above the root curve
    have hneg := (Ultrafilter.eventually_not.mpr hbad).mono fun _ => lt_of_not_ge
    have hcrit : ∀ᶠ z : Point 2 in β, ∃ j, st.ξ i (z 0) < st.ξ j (z 0) ∧ st.ξ j (z 0) < z 1 ∧
        (derivative a).evalEval (z 0) (st.ξ j (z 0)) = 0 ∧
        0 < s * a.evalEval (z 0) (st.ξ j (z 0)) := by
      filter_upwards [hneg, hβlt, hβ] with z hz hlt hzI
      obtain ⟨c, hc, hc0, hcpos⟩ := crit_above (hder (z 0)) hlt
        (by rw [hroot _ hzI, mul_zero]) (hs _ hzI) hz
      have hc0' : (derivative a).evalEval (z 0) c = 0 := (mul_eq_zero.mp hc0).resolve_left hs0
      obtain ⟨j, rfl⟩ := st.zeros _ ha' hda0 _ hzI c hc0'
      exact ⟨j, hc.1, hc.2, hc0', hcpos⟩
    obtain ⟨j, hj⟩ := (Ultrafilter.eventually_exists_iff (f := β)).mp hcrit
    obtain ⟨z₁, hz₁, hz₁I⟩ := (hj.and hβ).exists
    have hij := st.lt_of_lt hz₁I hz₁.1
    have hjβ : ∀ᶠ z : Point 2 in β, st.ξ j (z 0) < z 1 := hj.mono fun _ h => h.2.1
    have hjα : ∀ᶠ z : Point 2 in α, z 1 < st.ξ j (z 0) := by
      filter_upwards [hαlt, hα] with z hz hzI
      exact hz.trans (hij _ hzI)
    have hmem' := IHa' j (st.root_curve ha' hz₁I hz₁.2.2.1) (hjα.mono fun _ h => h.le)
      (hjβ.mono fun _ h => h.le)
    by_cases hrJ : toMv (rem a) ∈ separatingIdeal α β
    · exact hfin hmem' hrJ
    have hrsign : ∀ x ∈ I, 0 < s * (rem a).evalEval x (st.ξ j x) := by
      apply st.sign_curve hr hz₁I
      rw [evalEval_rem, hz₁.2.2.1, mul_zero, sub_zero]
      nlinarith [hz₁.2.2.2]
    have hr0 : rem a ≠ 0 := fun h => by
      have h' := hrsign _ hz₁I
      rw [h, evalEval_zero, mul_zero] at h'
      exact lt_irrefl _ h'
    obtain ⟨hrα, -⟩ := st.band_sign hα hβ hr hr0 hrJ IHr hjα hjβ hrsign
    have hsub : MvPolynomial.C s * toMv (rem a) - MvPolynomial.C (s * a.natDegree) * toMv a ∈
        separatingIdeal α β := by
      have he : MvPolynomial.C s * toMv (rem a) - MvPolynomial.C (s * a.natDegree) * toMv a =
          MvPolynomial.C (-s) * (MvPolynomial.X 1 * toMv (derivative a)) := by
        rw [toMv_rem, map_mul, map_neg]
        ring
      rw [he]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hmem')
    refine mem_of_C_mul_mem (mul_ne_zero hs0 hd.ne') (mem_of_sub_mem hsub ?_ ?_).2
    · filter_upwards [hrα] with z hz
      rw [map_mul, MvPolynomial.eval_C, eval_toMv]
      linarith
    · filter_upwards [hneg] with z hz
      rw [map_mul, MvPolynomial.eval_C, eval_toMv]
      nlinarith

/-- **Mahé's lemma** in terms of the separating ideal: a member of a family
closed under `∂/∂Y` and `rem` lies in the separating ideal of two ultrafilters
on the strip that are weakly separated by one of its root curves. -/
theorem claim (hcl : ∀ b ∈ B, derivative b ∈ B ∧ rem b ∈ B) (d : ℕ) :
    ∀ a : ℝ[X][Y], a.natDegree ≤ d → a ∈ B → ∀ i : Fin st.N,
      (∀ x ∈ I, a.evalEval x (st.ξ i x) = 0) → ∀ α β : Ultrafilter (Point 2),
      stripSet I ∈ α → stripSet I ∈ β → (∀ᶠ z : Point 2 in α, z 1 ≤ st.ξ i (z 0)) →
      (∀ᶠ z : Point 2 in β, st.ξ i (z 0) ≤ z 1) → toMv a ∈ separatingIdeal α β := by
  induction d with
  | zero =>
    intro a hd _ i hroot α β hα _ _ _
    have h0 : a.natDegree = 0 := Nat.le_zero.mp hd
    apply mem_separatingIdeal_of_zero
    filter_upwards [hα] with z hzI
    have h := hroot _ hzI
    rw [eq_C_of_natDegree_eq_zero h0, evalEval_C] at h
    rw [eval_toMv, eq_C_of_natDegree_eq_zero h0, evalEval_C]
    exact h
  | succ d ih =>
    intro a hd ha i hroot α β hα hβ hαle hβle
    by_cases h0 : a.natDegree ≤ d
    · exact ih a h0 ha i hroot α β hα hβ hαle hβle
    have h0' : a.natDegree ≠ 0 := by omega
    have ha' := (hcl a ha).1
    have hr := (hcl a ha).2
    have hda' : (derivative a).natDegree ≤ d := by
      have := natDegree_derivative_lt h0'
      omega
    have hdr : (rem a).natDegree ≤ d := by
      have := natDegree_rem_lt h0'
      omega
    have IHa' := fun j hj => ih (derivative a) hda' ha' j hj α β hα hβ
    have IHr := fun j hj => ih (rem a) hdr hr j hj α β hα hβ
    rcases α.em (fun z => z 1 = st.ξ i (z 0)) with hαon | hαoff
    · apply mem_separatingIdeal_of_zero
      filter_upwards [hαon, hα] with z hz hzI
      rw [eval_toMv, hz]
      exact hroot _ hzI
    rcases β.em (fun z => z 1 = st.ξ i (z 0)) with hβon | hβoff
    · rw [separatingIdeal_comm]
      apply mem_separatingIdeal_of_zero
      filter_upwards [hβon, hβ] with z hz hzI
      rw [eval_toMv, hz]
      exact hroot _ hzI
    have hαlt : ∀ᶠ z : Point 2 in α, z 1 < st.ξ i (z 0) := by
      filter_upwards [hαle, hαoff] with z h1 h2
      exact lt_of_le_of_ne h1 h2
    have hβlt : ∀ᶠ z : Point 2 in β, st.ξ i (z 0) < z 1 := by
      filter_upwards [hβle, hβoff] with z h1 h2
      exact lt_of_le_of_ne h1 (Ne.symm h2)
    rcases st.inv _ ha' i with hM | hpos | hneg
    · have h1 := IHa' i hM hαle hβle
      have hrz : ∀ x ∈ I, (rem a).evalEval x (st.ξ i x) = 0 := by
        intro x hx
        rw [evalEval_rem, hroot x hx, hM x hx]
        ring
      have h2 := IHr i hrz hαle hβle
      have hd' : (0 : ℝ) < a.natDegree := by exact_mod_cast Nat.pos_of_ne_zero h0'
      apply mem_of_C_mul_mem hd'.ne'
      have h3 := (separatingIdeal α β).add_mem h2
        ((separatingIdeal α β).mul_mem_left (MvPolynomial.X 1) h1)
      rw [toMv_rem] at h3
      simpa using h3
    · exact st.claim_simple hα hβ ha' hr h0' IHa' IHr hroot hαlt hβlt (s := 1)
        (fun x hx => by simpa using hpos x hx)
    · exact st.claim_simple hα hβ ha' hr h0' IHa' IHr hroot hαlt hβlt (s := -1)
        (fun x hx => by simpa using hneg x hx)

end StripData

end OMA.PB

namespace OMA.PB

open Polynomial Set Filter
open scoped Polynomial.Bivariate Topology

/- ### Assembly on a strip -/

/-- Compactness of the ultrafilters containing a set converts local
separators on that set into a representation that is valid on the set. -/
theorem representation_on_of_local {n : ℕ} {f : Point n → ℝ} {S : Set (Point n)}
    (sep : ∀ α β : Ultrafilter (Point n), S ∈ α → S ∈ β → ∃ p : Poly n,
      (∀ᶠ x in α, f x ≤ MvPolynomial.eval x p) ∧
      (∀ᶠ x in β, MvPolynomial.eval x p ≤ f x)) :
    ∃ h : Point n → ℝ, HasRepresentation h ∧ ∀ x ∈ S, f x = h x := by
  classical
  rcases S.eq_empty_or_nonempty with rfl | ⟨x₀, hx₀⟩
  · exact ⟨fun _ => 0, ⟨Unit, Unit, fun _ _ => 0, inferInstance, inferInstance, fun x => by simp⟩,
      fun x hx => hx.elim⟩
  let Row := {s : Finset (Poly n) // ∀ x : ↥S, ∃ p ∈ s, MvPolynomial.eval x.val p ≤ f x.val}
  let high (s : Row) := {x : ↥S | ∀ p ∈ s.val, f x.val ≤ MvPolynomial.eval x.val p}
  have hmap (a : Ultrafilter ↥S) : S ∈ a.map Subtype.val := by
    rw [Ultrafilter.mem_map]
    exact Filter.univ_mem' fun x => x.property
  have hrows (a : Ultrafilter ↥S) : ∃ s : Row, high s ∈ a := by
    let A := {p : Poly n // ∀ᶠ x : ↥S in a, f x.val ≤ MvPolynomial.eval x.val p}
    let low (p : A) := {x : ↥S | MvPolynomial.eval x.val p.val ≤ f x.val}
    have hlow (b : Ultrafilter ↥S) : ∃ p : A, low p ∈ b := by
      obtain ⟨p, hα, hβ⟩ := sep (a.map Subtype.val) (b.map Subtype.val) (hmap a) (hmap b)
      exact ⟨⟨p, hα⟩, hβ⟩
    obtain ⟨t, ht⟩ := finite_cover_of_ultrafilters low hlow
    let s := t.image Subtype.val
    have hs (x : ↥S) : ∃ p ∈ s, MvPolynomial.eval x.val p ≤ f x.val := by
      obtain ⟨p, hp, hx⟩ := ht x
      exact ⟨p.val, Finset.mem_image_of_mem _ hp, hx⟩
    refine ⟨⟨s, hs⟩, ?_⟩
    change ∀ᶠ x : ↥S in a, ∀ p ∈ s, f x.val ≤ MvPolynomial.eval x.val p
    apply (s.eventually_all).mpr
    intro p hp
    obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp hp
    exact q.property
  obtain ⟨t, ht⟩ := finite_cover_of_ultrafilters high hrows
  let ι := ↥t
  let K (i : ι) := ↥i.val.val
  let κ := (i : ι) → K i
  have hι : Nonempty ι := by
    obtain ⟨s, hs, _⟩ := ht ⟨x₀, hx₀⟩
    exact ⟨⟨s, hs⟩⟩
  have hK (i : ι) : Nonempty (K i) := by
    obtain ⟨p, hp, _⟩ := i.val.property ⟨x₀, hx₀⟩
    exact ⟨⟨p, hp⟩⟩
  let d : κ := fun i => (hK i).some
  have hκ : Nonempty κ := ⟨d⟩
  let g (i : ι) (k : κ) := (k i).val
  refine ⟨fun x => ⨆ i, ⨅ j, MvPolynomial.eval x (g i j),
    ⟨ι, κ, g, inferInstance, inferInstance, fun x => rfl⟩, fun x hx => le_antisymm ?_ ?_⟩
  · obtain ⟨s, hs, hxs⟩ := ht ⟨x, hx⟩
    let i : ι := ⟨s, hs⟩
    have hmin : f x ≤ ⨅ k, MvPolynomial.eval x (g i k) :=
      le_ciInf fun k => hxs (k i).val (k i).property
    exact hmin.trans
      (le_ciSup (finite_range (fun i => ⨅ k, MvPolynomial.eval x (g i k))).bddAbove i)
  · apply ciSup_le
    intro i
    obtain ⟨p, hp, hxp⟩ := i.val.property ⟨x, hx⟩
    let k : κ := Function.update d i (⟨p, hp⟩ : K i)
    have he : g i k = p := by simp [g, k]
    exact (ciInf_le (finite_range (fun k => MvPolynomial.eval x (g i k))).bddBelow k).trans
      (he ▸ hxp)

/-- A variant of `difference_mem_of_connectedness` for one connected region
avoiding the zero loci of the differences outside the separating ideal. -/
theorem difference_mem_of_region {n : ℕ} {ι : Type} [Finite ι]
    {P : ι → Set (Point n)} {g : ι → Poly n} {f : Point n → ℝ}
    (closed : ∀ i, IsClosed (P i)) (cover : ∀ x, ∃ i, x ∈ P i)
    (piece : ∀ i x, x ∈ P i → f x = MvPolynomial.eval x (g i))
    {α β : Ultrafilter (Point n)} {C : Set (Point n)} (hc : IsPreconnected C)
    (hα : C ∈ α) (hβ : C ∈ β)
    (havoid : ∀ x ∈ C, ∀ k l, g k - g l ∉ separatingIdeal α β →
      MvPolynomial.eval x (g k - g l) ≠ 0)
    {i j : ι} (hi : P i ∈ α) (hj : P j ∈ β) : g i - g j ∈ separatingIdeal α β := by
  classical
  let J := separatingIdeal α β
  let A := {k : ι // g i - g k ∈ J}
  let B := {k : ι // g i - g k ∉ J}
  let U := ⋃ k : A, P k.val
  let V := ⋃ k : B, P k.val
  have hU : IsClosed U := isClosed_iUnion_of_finite fun k : A => closed k.val
  have hV : IsClosed V := isClosed_iUnion_of_finite fun k : B => closed k.val
  have hUV : C ⊆ U ∪ V := by
    intro x _
    obtain ⟨k, hk⟩ := cover x
    by_cases h : g i - g k ∈ J
    · exact Or.inl (mem_iUnion.mpr ⟨(⟨k, h⟩ : A), hk⟩)
    · exact Or.inr (mem_iUnion.mpr ⟨(⟨k, h⟩ : B), hk⟩)
  by_contra h
  have hCU : (C ∩ U).Nonempty := by
    obtain ⟨x, hx, hix⟩ := Filter.nonempty_of_mem (inter_mem hα hi : C ∩ P i ∈ α)
    exact ⟨x, hx, mem_iUnion.mpr ⟨(⟨i, by simp⟩ : A), hix⟩⟩
  have hCV : (C ∩ V).Nonempty := by
    obtain ⟨x, hx, hjx⟩ := Filter.nonempty_of_mem (inter_mem hβ hj : C ∩ P j ∈ β)
    exact ⟨x, hx, mem_iUnion.mpr ⟨(⟨j, h⟩ : B), hjx⟩⟩
  obtain ⟨x, hx, hux, hvx⟩ := isPreconnected_closed_iff.mp hc U V hU hV hUV hCU hCV
  obtain ⟨k, hk⟩ := mem_iUnion.mp hux
  obtain ⟨l, hl⟩ := mem_iUnion.mp hvx
  have hkl : g k.val - g l.val ∉ J := by
    intro hh
    apply l.property
    convert J.add_mem k.property hh using 1
    abel
  apply havoid x hx _ _ hkl
  rw [map_sub, ← piece k.val x hk, ← piece l.val x hl, sub_self]

/-- The cylindrical structure of a strip avoiding the zeros of `Q`. -/
theorem exists_stripData {I : Set ℝ} (hI : IsPreconnected I) {B : Finset ℝ[X][Y]}
    {P : ℝ[X][Y]} {Q : ℝ[X]} (hQ : ∀ x ∈ I, Q.eval x ≠ 0)
    (hreg : ∀ x, Q.eval x ≠ 0 → P.leadingCoeff.eval x ≠ 0 ∧
      ∀ y, P.evalEval x y = 0 → (derivative P).evalEval x y ≠ 0)
    (hfac : ∀ a ∈ B, a ≠ 0 → ∃ g : ℝ[X][Y], ∀ x y, Q.eval x ≠ 0 →
      (a.evalEval x y = 0 → P.evalEval x y = 0) ∧
      (P.evalEval x y = 0 → (a.evalEval x y = 0 ↔ g.evalEval x y ≠ 0))) :
    Nonempty (StripData I B) := by
  obtain ⟨N, ξ, hcont, hmono, hzero⟩ := exists_root_curves hI P fun x hx => hreg x (hQ x hx)
  have hcurve (a : ℝ[X][Y]) (i : Fin N) : ContinuousOn (fun x => a.evalEval x (ξ i x)) I :=
    (continuous_evalEval a).comp_continuousOn (continuousOn_id.prodMk (hcont i))
  refine ⟨⟨N, ξ, hmono, hcont, ?_, ?_⟩⟩
  · intro a ha ha0 x hx y hy
    obtain ⟨g, hg⟩ := hfac a ha ha0
    exact (hzero x hx y).mp ((hg x y (hQ x hx)).1 hy)
  · intro a ha i
    by_cases ha0 : a = 0
    · left
      intro x _
      rw [ha0, evalEval_zero]
    obtain ⟨g, hg⟩ := hfac a ha ha0
    have hiff : ∀ x ∈ I, (a.evalEval x (ξ i x) = 0 ↔ g.evalEval x (ξ i x) ≠ 0) := fun x hx =>
      (hg x _ (hQ x hx)).2 ((hzero x hx _).mpr ⟨i, rfl⟩)
    have hdich : (∀ x ∈ I, a.evalEval x (ξ i x) = 0) ∨ ∀ x ∈ I, a.evalEval x (ξ i x) ≠ 0 := by
      by_contra hcon
      rw [not_or] at hcon
      push Not at hcon
      obtain ⟨⟨x₁, hx₁, h₁⟩, ⟨x₂, hx₂, h₂⟩⟩ := hcon
      have hg₁ : g.evalEval x₁ (ξ i x₁) = 0 := by
        by_contra h
        exact h₁ ((hiff x₁ hx₁).mpr h)
      have hg₂ : g.evalEval x₂ (ξ i x₂) ≠ 0 := (hiff x₂ hx₂).mp h₂
      have hφ : ContinuousOn
          (fun x => a.evalEval x (ξ i x) ^ 2 - g.evalEval x (ξ i x) ^ 2) I :=
        ((hcurve a i).pow 2).sub ((hcurve g i).pow 2)
      obtain ⟨x, hx, hx0⟩ := hI.intermediate_value₂ hx₂ hx₁ hφ continuousOn_const
        (by
          change a.evalEval x₂ (ξ i x₂) ^ 2 - g.evalEval x₂ (ξ i x₂) ^ 2 ≤ 0
          rw [h₂]
          nlinarith [sq_nonneg (g.evalEval x₂ (ξ i x₂))])
        (by
          change 0 ≤ a.evalEval x₁ (ξ i x₁) ^ 2 - g.evalEval x₁ (ξ i x₁) ^ 2
          rw [hg₁]
          nlinarith [sq_nonneg (a.evalEval x₁ (ξ i x₁))])
      change a.evalEval x (ξ i x) ^ 2 - g.evalEval x (ξ i x) ^ 2 = 0 at hx0
      by_cases hax : a.evalEval x (ξ i x) = 0
      · have hgx := (hiff x hx).mp hax
        rw [hax] at hx0
        exact hgx (by nlinarith [sq_nonneg (g.evalEval x (ξ i x))])
      · have hgx : g.evalEval x (ξ i x) = 0 := by
          by_contra h
          exact hax ((hiff x hx).mpr h)
        rw [hgx] at hx0
        exact hax (by nlinarith [sq_nonneg (a.evalEval x (ξ i x))])
    rcases hdich with h | h
    · exact Or.inl h
    · right
      by_contra hcon
      rw [not_or] at hcon
      push Not at hcon
      obtain ⟨⟨x₁, hx₁, h₁⟩, ⟨x₂, hx₂, h₂⟩⟩ := hcon
      obtain ⟨x, hx, hx0⟩ :=
        hI.intermediate_value₂ hx₁ hx₂ (hcurve a i) continuousOn_const h₁ h₂
      exact h x hx hx0

/-- A region of a strip between finitely many lower and upper continuous
curves is preconnected. -/
theorem isPreconnected_region {I : Set ℝ} (hI : IsPreconnected I) {κ : Type} (Lo Hi : Finset κ)
    (ξ : κ → ℝ → ℝ) (hcont : ∀ k, ContinuousOn (ξ k) I)
    (hlt : ∀ l ∈ Lo, ∀ h ∈ Hi, ∀ x ∈ I, ξ l x < ξ h x) :
    IsPreconnected {z : Point 2 | z 0 ∈ I ∧ (∀ l ∈ Lo, ξ l (z 0) < z 1) ∧
      ∀ h ∈ Hi, z 1 < ξ h (z 0)} := by
  obtain ⟨m, hm, hmem⟩ : ∃ m : ℝ → ℝ, ContinuousOn m I ∧
      ∀ x ∈ I, (∀ l ∈ Lo, ξ l x < m x) ∧ ∀ h ∈ Hi, m x < ξ h x := by
    rcases Lo.eq_empty_or_nonempty with rfl | hLo
    · rcases Hi.eq_empty_or_nonempty with rfl | hHi
      · exact ⟨fun _ => 0, continuousOn_const, by simp⟩
      · refine ⟨fun x => Hi.inf' hHi (fun h => ξ h x) - 1, ?_, fun x _ => ⟨by simp, fun h hh => ?_⟩⟩
        · exact (ContinuousOn.finset_inf'_apply hHi fun h _ => hcont h).sub continuousOn_const
        · have h1 := Finset.inf'_le (fun h => ξ h x) hh
          linarith
    · rcases Hi.eq_empty_or_nonempty with rfl | hHi
      · refine ⟨fun x => Lo.sup' hLo (fun l => ξ l x) + 1, ?_, fun x _ => ⟨fun l hl => ?_, by simp⟩⟩
        · exact (ContinuousOn.finset_sup'_apply hLo fun l _ => hcont l).add continuousOn_const
        · have h1 := Finset.le_sup' (fun l => ξ l x) hl
          linarith
      · refine ⟨fun x => (Lo.sup' hLo (fun l => ξ l x) + Hi.inf' hHi (fun h => ξ h x)) / 2, ?_,
          fun x hx => ?_⟩
        · exact ((ContinuousOn.finset_sup'_apply hLo fun l _ => hcont l).add
            (ContinuousOn.finset_inf'_apply hHi fun h _ => hcont h)).div_const 2
        · have h1 : Lo.sup' hLo (fun l => ξ l x) < Hi.inf' hHi (fun h => ξ h x) := by
            rw [Finset.sup'_lt_iff]
            intro l hl
            rw [Finset.lt_inf'_iff]
            intro h hh
            exact hlt l hl h hh x hx
          refine ⟨fun l hl => ?_, fun h hh => ?_⟩
          · have h2 := Finset.le_sup' (fun l => ξ l x) hl
            linarith
          · have h2 := Finset.inf'_le (fun h => ξ h x) hh
            linarith
  rcases I.eq_empty_or_nonempty with rfl | ⟨xb, hxb⟩
  · have hempty : {z : Point 2 | z 0 ∈ (∅ : Set ℝ) ∧ (∀ l ∈ Lo, ξ l (z 0) < z 1) ∧
        ∀ h ∈ Hi, z 1 < ξ h (z 0)} = ∅ := by
      ext z
      simp
    rw [hempty]
    exact isPreconnected_empty
  let γ : ℝ → Point 2 := fun x => ![x, m x]
  have hγ : ContinuousOn γ I := by
    apply continuousOn_pi.mpr
    intro k
    fin_cases k
    · exact continuousOn_id
    · exact hm
  have hgraph : IsPreconnected (γ '' I) := hI.image γ hγ
  let fib (x : ℝ) : Set (Point 2) :=
    {z | z 0 = x ∧ (∀ l ∈ Lo, ξ l x < z 1) ∧ ∀ h ∈ Hi, z 1 < ξ h x}
  have hfib : ∀ x, IsPreconnected (fib x) := by
    intro x
    have himg : fib x = (fun y : ℝ => (![x, y] : Point 2)) ''
        {y | (∀ l ∈ Lo, ξ l x < y) ∧ ∀ h ∈ Hi, y < ξ h x} := by
      ext z
      constructor
      · rintro ⟨h0, h1⟩
        refine ⟨z 1, h1, ?_⟩
        ext k
        fin_cases k
        · exact h0.symm
        · rfl
      · rintro ⟨y, hy, rfl⟩
        exact ⟨rfl, hy⟩
    rw [himg]
    apply IsPreconnected.image
    · apply Set.OrdConnected.isPreconnected
      constructor
      intro y₁ h₁ y₂ h₂ y hy
      exact ⟨fun l hl => (h₁.1 l hl).trans_le hy.1, fun h hh => hy.2.trans_lt (h₂.2 h hh)⟩
    · apply Continuous.continuousOn
      apply continuous_pi
      intro k
      fin_cases k
      · exact continuous_const
      · exact continuous_id
  have hR : {z : Point 2 | z 0 ∈ I ∧ (∀ l ∈ Lo, ξ l (z 0) < z 1) ∧ ∀ h ∈ Hi, z 1 < ξ h (z 0)} =
      ⋃ x : I, (γ '' I ∪ fib x.val) := by
    ext z
    constructor
    · rintro ⟨hz0, hz⟩
      exact mem_iUnion.mpr ⟨⟨z 0, hz0⟩, Or.inr ⟨rfl, hz⟩⟩
    · intro hz
      obtain ⟨x, hx | hx⟩ := mem_iUnion.mp hz
      · obtain ⟨x', hx', rfl⟩ := hx
        exact ⟨hx', hmem x' hx'⟩
      · obtain ⟨h0, h1⟩ := hx
        have h0' : z 0 = x.val := h0
        change z 0 ∈ I ∧ (∀ l ∈ Lo, ξ l (z 0) < z 1) ∧ ∀ h ∈ Hi, z 1 < ξ h (z 0)
        rw [h0']
        exact ⟨x.property, h1⟩
  rw [hR]
  apply isPreconnected_iUnion
  · exact ⟨γ xb, mem_iInter.mpr fun x => Or.inl (mem_image_of_mem γ hxb)⟩
  · intro x
    exact IsPreconnected.union (γ x.val) (mem_image_of_mem γ x.property)
      ⟨rfl, hmem x.val x.property⟩ hgraph (hfib x.val)

/-- On a strip with cylindrical structure, the polynomials of two pieces
differ by a member of the separating ideal. -/
theorem StripData.difference_mem {I : Set ℝ} {B : Finset ℝ[X][Y]} (st : StripData I B)
    (hI : IsPreconnected I) (hcl : ∀ b ∈ B, derivative b ∈ B ∧ rem b ∈ B)
    {ι : Type} [Finite ι] {P : ι → Set (Point 2)} {g : ι → Poly 2} {f : Point 2 → ℝ}
    (closed : ∀ i, IsClosed (P i)) (cover : ∀ x, ∃ i, x ∈ P i)
    (piece : ∀ i x, x ∈ P i → f x = MvPolynomial.eval x (g i))
    (hB : ∀ k l, toMv.symm (g k - g l) ∈ B)
    {α β : Ultrafilter (Point 2)} (hα : stripSet I ∈ α) (hβ : stripSet I ∈ β)
    {i j : ι} (hi : P i ∈ α) (hj : P j ∈ β) : g i - g j ∈ separatingIdeal α β := by
  classical
  let bad (c : Fin st.N) : Prop := ∃ k l, g k - g l ∉ separatingIdeal α β ∧
    ∀ x ∈ I, (toMv.symm (g k - g l)).evalEval x (st.ξ c x) = 0
  have hclass : ∀ c, bad c →
      ((∀ᶠ z : Point 2 in α, z 1 < st.ξ c (z 0)) ∧ ∀ᶠ z : Point 2 in β, z 1 < st.ξ c (z 0)) ∨
      ((∀ᶠ z : Point 2 in α, st.ξ c (z 0) < z 1) ∧ ∀ᶠ z : Point 2 in β, st.ξ c (z 0) < z 1) := by
    rintro c ⟨k, l, hkl, hroot⟩
    have h1 : ¬((∀ᶠ z : Point 2 in α, z 1 ≤ st.ξ c (z 0)) ∧
        ∀ᶠ z : Point 2 in β, st.ξ c (z 0) ≤ z 1) := by
      rintro ⟨ha, hb⟩
      apply hkl
      have h := st.claim hcl _ _ le_rfl (hB k l) c hroot α β hα hβ ha hb
      simpa using h
    have h2 : ¬((∀ᶠ z : Point 2 in β, z 1 ≤ st.ξ c (z 0)) ∧
        ∀ᶠ z : Point 2 in α, st.ξ c (z 0) ≤ z 1) := by
      rintro ⟨hb, ha⟩
      apply hkl
      have h := st.claim hcl _ _ le_rfl (hB k l) c hroot β α hβ hα hb ha
      rw [separatingIdeal_comm]
      simpa using h
    rcases α.em (fun z : Point 2 => z 1 ≤ st.ξ c (z 0)) with ha | ha
    · have hb : ∀ᶠ z : Point 2 in β, z 1 < st.ξ c (z 0) := by
        by_contra hn
        exact h1 ⟨ha, (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt⟩
      have ha' : ∀ᶠ z : Point 2 in α, z 1 < st.ξ c (z 0) := by
        by_contra hn
        exact h2 ⟨hb.mono fun _ h => h.le,
          (Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt⟩
      exact Or.inl ⟨ha', hb⟩
    · have ha' : ∀ᶠ z : Point 2 in α, st.ξ c (z 0) < z 1 := ha.mono fun _ => lt_of_not_ge
      have hb : ∀ᶠ z : Point 2 in β, st.ξ c (z 0) < z 1 := by
        by_contra hn
        exact h2 ⟨(Ultrafilter.eventually_not.mpr hn).mono fun _ => le_of_not_gt,
          ha'.mono fun _ h => h.le⟩
      exact Or.inr ⟨ha', hb⟩
  let Lo : Finset (Fin st.N) :=
    Finset.univ.filter fun c => bad c ∧ ∀ᶠ z : Point 2 in α, st.ξ c (z 0) < z 1
  let Hi : Finset (Fin st.N) :=
    Finset.univ.filter fun c => bad c ∧ ∀ᶠ z : Point 2 in α, z 1 < st.ξ c (z 0)
  have hLo : ∀ l ∈ Lo, bad l ∧ (∀ᶠ z : Point 2 in α, st.ξ l (z 0) < z 1) ∧
      ∀ᶠ z : Point 2 in β, st.ξ l (z 0) < z 1 := by
    intro l hl
    obtain ⟨hbad, hl'⟩ := (Finset.mem_filter.mp hl).2
    rcases hclass l hbad with h | h
    · obtain ⟨z, hz1, hz2⟩ := (h.1.and hl').exists
      exact absurd hz1 (lt_asymm hz2)
    · exact ⟨hbad, hl', h.2⟩
  have hHi : ∀ h ∈ Hi, bad h ∧ (∀ᶠ z : Point 2 in α, z 1 < st.ξ h (z 0)) ∧
      ∀ᶠ z : Point 2 in β, z 1 < st.ξ h (z 0) := by
    intro h hh
    obtain ⟨hbad, hh'⟩ := (Finset.mem_filter.mp hh).2
    rcases hclass h hbad with h' | h'
    · exact ⟨hbad, hh', h'.2⟩
    · obtain ⟨z, hz1, hz2⟩ := (h'.1.and hh').exists
      exact absurd hz1 (lt_asymm hz2)
  have hCα : {z : Point 2 | z 0 ∈ I ∧ (∀ l ∈ Lo, st.ξ l (z 0) < z 1) ∧
      ∀ h ∈ Hi, z 1 < st.ξ h (z 0)} ∈ α := by
    have h1 : ∀ᶠ z : Point 2 in α, ∀ l ∈ Lo, st.ξ l (z 0) < z 1 :=
      Lo.eventually_all.mpr fun l hl => (hLo l hl).2.1
    have h2 : ∀ᶠ z : Point 2 in α, ∀ h ∈ Hi, z 1 < st.ξ h (z 0) :=
      Hi.eventually_all.mpr fun h hh => (hHi h hh).2.1
    filter_upwards [hα, h1, h2] with z hz h1 h2 using ⟨hz, h1, h2⟩
  have hCβ : {z : Point 2 | z 0 ∈ I ∧ (∀ l ∈ Lo, st.ξ l (z 0) < z 1) ∧
      ∀ h ∈ Hi, z 1 < st.ξ h (z 0)} ∈ β := by
    have h1 : ∀ᶠ z : Point 2 in β, ∀ l ∈ Lo, st.ξ l (z 0) < z 1 :=
      Lo.eventually_all.mpr fun l hl => (hLo l hl).2.2
    have h2 : ∀ᶠ z : Point 2 in β, ∀ h ∈ Hi, z 1 < st.ξ h (z 0) :=
      Hi.eventually_all.mpr fun h hh => (hHi h hh).2.2
    filter_upwards [hβ, h1, h2] with z hz h1 h2 using ⟨hz, h1, h2⟩
  have hlt : ∀ l ∈ Lo, ∀ h ∈ Hi, ∀ x ∈ I, st.ξ l x < st.ξ h x := by
    intro l hl h hh
    obtain ⟨z, ⟨hz1, hz2⟩, hzI⟩ := (((hLo l hl).2.1.and (hHi h hh).2.1).and hα).exists
    exact st.lt_of_lt hzI (hz1.trans hz2)
  have hC := isPreconnected_region hI Lo Hi st.ξ st.cont hlt
  apply difference_mem_of_region closed cover piece hC hCα hCβ ?_ hi hj
  intro z hz k l hkl hzero
  have hne : toMv.symm (g k - g l) ≠ 0 := by
    intro h0
    apply hkl
    have h : g k - g l = 0 := by simpa using congrArg toMv h0
    rw [h]
    exact zero_mem _
  have hz0 : (toMv.symm (g k - g l)).evalEval (z 0) (z 1) = 0 := by
    rw [← eval_toMv]
    simpa using hzero
  obtain ⟨c, hc⟩ := st.zeros _ (hB k l) hne _ hz.1 _ hz0
  have hbad : bad c := ⟨k, l, hkl, st.root_curve (hB k l) hz.1 (by rw [hc]; exact hz0)⟩
  rcases hclass c hbad with h | h
  · have h3 := hz.2.2 c (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hbad, h.1⟩)
    rw [hc] at h3
    exact lt_irrefl _ h3
  · have h3 := hz.2.1 c (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hbad, h.1⟩)
    rw [hc] at h3
    exact lt_irrefl _ h3

/-- Every piecewise polynomial function of two variables is represented on
each vertical open strip between finitely many cuts. -/
theorem hasStripRepresentations (f : Point 2 → ℝ)
    (hf : PierceBirkhoff.IsPiecewiseMvPolynomial f) : HasStripRepresentations f 0 := by
  classical
  obtain ⟨ι, P, g, hι, closed, _, hcover, piece⟩ := hf
  have cover (x : Point 2) : ∃ i, x ∈ P i := mem_iUnion.mp (hcover.symm ▸ mem_univ x)
  let _ := Fintype.ofFinite ι
  let seeds : Finset ℝ[X][Y] :=
    (Finset.univ : Finset (ι × ι)).image fun kl => toMv.symm (g kl.1 - g kl.2)
  obtain ⟨B, hseed, hcl⟩ := exists_closed_finset seeds
  have hB : ∀ k l, toMv.symm (g k - g l) ∈ B := fun k l =>
    hseed (Finset.mem_image.mpr ⟨(k, l), Finset.mem_univ _, rfl⟩)
  obtain ⟨Pr, Q, hQ0, hreg, hfac⟩ := exists_regular_product B
  refine ⟨Q.roots.toFinset, fun right => ?_⟩
  let I : Set ℝ := {t | ∀ c ∈ Q.roots.toFinset, (c ∈ right → c < t) ∧ (c ∉ right → t < c)}
  have hIord : I.OrdConnected := by
    constructor
    intro t₁ h₁ t₂ h₂ t ht c hc
    exact ⟨fun hr => ((h₁ c hc).1 hr).trans_le ht.1, fun hr => ht.2.trans_lt ((h₂ c hc).2 hr)⟩
  have hI : IsPreconnected I := hIord.isPreconnected
  have hQI : ∀ x ∈ I, Q.eval x ≠ 0 := by
    intro x hx h0
    have hmem : x ∈ Q.roots.toFinset := Multiset.mem_toFinset.mpr ((mem_roots hQ0).mpr h0)
    by_cases hr : x ∈ right
    · exact lt_irrefl _ ((hx x hmem).1 hr)
    · exact lt_irrefl _ ((hx x hmem).2 hr)
  obtain ⟨st⟩ := exists_stripData hI hQI hreg hfac
  have key : ∃ h : Point 2 → ℝ, HasRepresentation h ∧ ∀ x ∈ stripSet I, f x = h x := by
    apply representation_on_of_local
    intro α β hα hβ
    obtain ⟨i, hi⟩ := (Ultrafilter.eventually_exists_iff (f := α)).mp (Eventually.of_forall cover)
    obtain ⟨j, hj⟩ := (Ultrafilter.eventually_exists_iff (f := β)).mp (Eventually.of_forall cover)
    have hm := st.difference_mem hI hcl closed cover piece hB hα hβ hi hj
    obtain ⟨p, hpα, hpβ⟩ := separator_of_difference_mem hm
    refine ⟨p, ?_, ?_⟩
    · filter_upwards [hi, hpα] with x hx hle
      rwa [piece i x hx]
    · filter_upwards [hj, hpβ] with x hx hle
      rwa [piece j x hx]
  obtain ⟨h, hrep, heq⟩ := key
  exact ⟨h, hrep, fun x hx => heq x hx⟩

end OMA.PB

/-- The Pierce–Birkhoff conjecture in dimension two (Mahé's theorem). -/
theorem OMA.solution : type_of% @PierceBirkhoff.pierce_birkhoff_conjecture_dim_two :=
  OMA.PB.solution_of_plane_strips OMA.PB.hasStripRepresentations
