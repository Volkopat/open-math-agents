import OMAReductions.R_RamseyNumbers_ramsey_number_four_five_R1_H1_R1_H1_R1_H2_R1

namespace Ramsey34Atlas

open Finset SimpleGraph

/-- Start of column j in the graph6 edge order. -/
def column (j : Nat) : Nat := j*(j-1)/2

private theorem column_succ (j : Nat) : column (j+1) = column j + j := by
  cases j with
  | zero => decide
  | succ j =>
    change (j+1+1)*(j+1)/2 = (j+1)*j/2+(j+1)
    have h : (j+1+1)*(j+1) = (j+1)*j+2*(j+1) := by ring
    rw [h]
    omega

private theorem column_mono : Monotone column := by
  apply monotone_nat_of_le_succ
  intro j
  rw [column_succ]
  omega

/-- The bit at `j*(j-1)/2+i` encodes edge `(i,j)` for `i<j`. -/
def graphOfMask (n word : Nat) : SimpleGraph (Fin n) where
  Adj i j := i ≠ j ∧ word.testBit (column (max i.val j.val) + min i.val j.val) = true
  symm := ⟨fun i j h => ⟨h.1.symm,by simpa only [max_comm j.val i.val,min_comm j.val i.val] using h.2⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

instance (n word : Nat) : DecidableRel (graphOfMask n word).Adj := by
  intro i j
  change Decidable (i ≠ j ∧ word.testBit (column (max i.val j.val) + min i.val j.val) = true)
  infer_instance

theorem adj_graphOfMask_of_lt {n word : Nat} {i j : Fin n} (h : i < j) :
    (graphOfMask n word).Adj i j ↔ word.testBit (column j.val+i.val) = true := by
  have le : i.val ≤ j.val := h.le
  simp [graphOfMask,h.ne,max_eq_right le,min_eq_left le]

end Ramsey34Atlas

namespace Ramsey44Root

open Finset SimpleGraph Ramsey34Atlas

/-- Position 15 is the distinguished root, and the atlas blocks occupy
positions 0 through 6 and 7 through 14. -/
def pivot : Fin 16 := Fin.last 15

def left : Fin 7 ↪ Fin 16 := (Fin.castAddEmb 8).trans Fin.castSuccEmb

def right : Fin 8 ↪ Fin 16 := (Fin.natAddEmb 7).trans Fin.castSuccEmb

@[simp] theorem left_val (i : Fin 7) : (left i).val = i.val := rfl

@[simp] theorem right_val (j : Fin 8) : (right j).val = 7+j.val := rfl

def Rooted (G : SimpleGraph (Fin 16)) : Prop := ∀ i : Fin 16, G.Adj pivot i ↔ i.val < 7

end Ramsey44Root

namespace Ramsey44Root

open Ramsey34Atlas
open Std.Sat

abbrev AdjPair := Fin 16 × Fin 16

def crossIndex (x y : Nat) : Nat := 8*x+(y-7)

def graphAssignment (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj] (k : Nat) : Bool :=
  decide (G.Adj (Fin.ofNat 16 (k/8)) (Fin.ofNat 16 (k%8+7)))

def known (a b x y : Nat) : Option Bool :=
  if y = 15 then some (decide (x < 7))
  else if y < 7 then some (a.testBit (column y+x))
  else if 7 ≤ x then some (! b.testBit (column (y-7)+(x-7)))
  else none

lemma graphAssignment_cross (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj]
    {x y : Fin 16} (hx : x.val < 7) (hy : 7 ≤ y.val) (hhi : y.val < 15) :
    graphAssignment G (crossIndex x.val y.val) = decide (G.Adj x y) := by
  have xeq : Fin.ofNat 16 (crossIndex x.val y.val / 8) = x := by
    apply Fin.ext
    change (crossIndex x.val y.val / 8) % 16 = x.val
    unfold crossIndex
    omega
  have yeq : Fin.ofNat 16 (crossIndex x.val y.val % 8 + 7) = y := by
    apply Fin.ext
    change (crossIndex x.val y.val % 8 + 7) % 16 = y.val
    unfold crossIndex
    omega
  simp only [graphAssignment,xeq,yeq]

lemma known_matches (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj] {a b : Nat}
    (root : Rooted G) (hleft : G.comap left = graphOfMask 7 a)
    (hright : Gᶜ.comap right = graphOfMask 8 b)
    (x y : Fin 16) (order : x < y) :
    match known a b x.val y.val with
    | some hit => decide (G.Adj x y) = hit
    | none => decide (G.Adj x y) = graphAssignment G (crossIndex x.val y.val) := by
  have lt : x.val < y.val := order
  by_cases hy : y.val = 15
  · simp only [known, if_pos hy]
    have yp : y = pivot := Fin.ext hy
    rw [yp]
    exact Bool.eq_iff_iff.mpr (by simpa only [decide_eq_true_eq, G.adj_comm] using root x)
  · by_cases hyL : y.val < 7
    · simp only [known, if_neg hy, if_pos hyL]
      let i : Fin 7 := ⟨x.val,lt.trans hyL⟩
      let j : Fin 7 := ⟨y.val,hyL⟩
      have h := congrArg (fun H : SimpleGraph (Fin 7) => H.Adj i j) hleft
      change G.Adj (left i) (left j) = (graphOfMask 7 a).Adj i j at h
      have xi : left i = x := Fin.ext rfl
      have yj : left j = y := Fin.ext rfl
      rw [xi,yj] at h
      exact Bool.eq_iff_iff.mpr (by
        rw [decide_eq_true_eq,h]
        exact adj_graphOfMask_of_lt (show i < j from lt))
    · have yhi : y.val < 15 := by have := y.isLt; omega
      by_cases hxR : 7 ≤ x.val
      · simp only [known, if_neg hy, if_neg hyL, if_pos hxR]
        let i : Fin 8 := ⟨x.val-7,by omega⟩
        let j : Fin 8 := ⟨y.val-7,by omega⟩
        have h := congrArg (fun H : SimpleGraph (Fin 8) => H.Adj i j) hright
        change Gᶜ.Adj (right i) (right j) = (graphOfMask 8 b).Adj i j at h
        have xi : right i = x := Fin.ext (by simp [i]; omega)
        have yj : right j = y := Fin.ext (by simp [j]; omega)
        rw [xi,yj] at h
        have ij : i < j := by change x.val-7 < y.val-7; omega
        have complement : (¬ G.Adj x y) ↔ Gᶜ.Adj x y :=
          ⟨fun hn => ⟨order.ne,hn⟩,fun hn => hn.2⟩
        have hn : (¬ G.Adj x y) ↔ b.testBit (column (y.val-7)+(x.val-7)) = true := by
          exact complement.trans ((Iff.of_eq h).trans (adj_graphOfMask_of_lt ij))
        cases hb : b.testBit (column (y.val-7)+(x.val-7))
        · simp only [hb, Bool.false_eq_true, iff_false] at hn
          simpa using hn
        · simp only [hb, iff_true] at hn
          simp [hn]
      · simp only [known, if_neg hy, if_neg hyL, if_neg hxR]
        exact (graphAssignment_cross G (by omega) (by omega) yhi).symm

def quadEdges (u v w z : Fin 16) : List AdjPair :=
  [(u,v),(u,w),(u,z),(v,w),(v,z),(w,z)]

private theorem is_four_clique (G : SimpleGraph (Fin 16)) {u v w z : Fin 16}
    (uv : u < v) (vw : v < w) (wz : w < z)
    (edges : ∀ e ∈ quadEdges u v w z, G.Adj e.1 e.2) :
    G.IsNClique 4 {u,v,w,z} := by
  have uw := uv.trans vw
  have uz := uw.trans wz
  have vz := vw.trans wz
  have huv := edges (u,v) (by simp [quadEdges])
  have huw := edges (u,w) (by simp [quadEdges])
  have huz := edges (u,z) (by simp [quadEdges])
  have hvw := edges (v,w) (by simp [quadEdges])
  have hvz := edges (v,z) (by simp [quadEdges])
  have hwz := edges (w,z) (by simp [quadEdges])
  refine ⟨?_, by simp [uv.ne,uw.ne,uz.ne,vw.ne,vz.ne,wz.ne]⟩
  intro a ha b hb hn
  simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
    Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
    first | exact (hn rfl).elim | assumption | exact huv.symm | exact huw.symm |
      exact huz.symm | exact hvw.symm | exact hvz.symm | exact hwz.symm

private theorem quad_differs (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj]
    (hG : G.CliqueFree 4) (hC : Gᶜ.CliqueFree 4) {u v w z : Fin 16}
    (uv : u < v) (vw : v < w) (wz : w < z) (wanted : Bool) :
    ∃ e ∈ quadEdges u v w z, decide (G.Adj e.1 e.2) = wanted := by
  by_contra! none
  cases wanted
  · exact hG _ (is_four_clique G uv vw wz
      (fun e he => of_decide_eq_true (Bool.eq_true_of_not_eq_false (none e he))))
  · apply hC _
    apply is_four_clique Gᶜ uv vw wz
    intro e he
    have order : e.1 < e.2 := by
      simp only [quadEdges, List.mem_cons, List.not_mem_nil, or_false] at he
      rcases he with rfl | rfl | rfl | rfl | rfl | rfl
      all_goals first | exact uv | exact vw | exact wz | exact uv.trans vw |
        exact vw.trans wz | exact uv.trans (vw.trans wz)
    exact ⟨order.ne, fun h => none e he (decide_eq_true h)⟩

def clauseFor (a b : Nat) (wanted : Bool) : List AdjPair → Option (CNF.Clause Nat)
  | [] => some []
  | e :: rest =>
    match known a b e.1.val e.2.val with
    | some hit => if hit = wanted then none else clauseFor a b wanted rest
    | none => (clauseFor a b wanted rest).map (fun tail => (crossIndex e.1.val e.2.val,wanted) :: tail)

private theorem clauseFor_true (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj] {a b : Nat}
    (root : Rooted G) (hleft : G.comap left = graphOfMask 7 a)
    (hright : Gᶜ.comap right = graphOfMask 8 b) (wanted : Bool)
    (edges : List AdjPair) (ordered : ∀ e ∈ edges, e.1 < e.2)
    (witness : ∃ e ∈ edges, decide (G.Adj e.1 e.2) = wanted)
    {clause : CNF.Clause Nat} (formed : clauseFor a b wanted edges = some clause) :
    clause.eval (graphAssignment G) = true := by
  induction edges generalizing clause with
  | nil => simp at witness
  | cons e rest ih =>
    have eord := ordered e (by simp)
    have fullTail : ∀ f ∈ rest, f.1 < f.2 := fun f hf => ordered f (by simp [hf])
    have matchG := known_matches G root hleft hright e.1 e.2 eord
    rw [clauseFor] at formed
    cases choice : known a b e.1.val e.2.val with
    | some hit =>
      simp only [choice] at matchG formed
      by_cases sat : hit = wanted
      · simp [sat] at formed
      · simp only [if_neg sat] at formed
        obtain ⟨f,hf,check⟩ := witness
        rcases List.mem_cons.mp hf with equal | inTail
        · subst f
          exact False.elim (sat (matchG.symm.trans check))
        · exact ih fullTail ⟨f,inTail,check⟩ formed
    | none =>
      simp only [choice] at matchG formed
      cases tail : clauseFor a b wanted rest with
      | none => simp [tail] at formed
      | some c =>
        simp only [tail, Option.map_some, Option.some.injEq] at formed
        subst clause
        obtain ⟨f,hf,check⟩ := witness
        rcases List.mem_cons.mp hf with equal | inTail
        · subst f
          simp [CNF.Clause.eval_cons, ← matchG, check]
        · simp [CNF.Clause.eval_cons, ih fullTail ⟨f,inTail,check⟩ tail]

theorem eval_quad_root (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj] {a b : Nat}
    (hG : G.CliqueFree 4) (hC : Gᶜ.CliqueFree 4) (root : Rooted G)
    (hleft : G.comap left = graphOfMask 7 a) (hright : Gᶜ.comap right = graphOfMask 8 b)
    {u v w z : Fin 16} (uv : u < v) (vw : v < w) (wz : w < z) (wanted : Bool)
    {clause : CNF.Clause Nat} (formed : clauseFor a b wanted (quadEdges u v w z) = some clause) :
    clause.eval (graphAssignment G) = true := by
  apply clauseFor_true G root hleft hright wanted _ _
    (quad_differs G hG hC uv vw wz wanted) formed
  intro e he
  simp only [quadEdges, List.mem_cons, List.not_mem_nil, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals first | exact uv | exact vw | exact wz | exact uv.trans vw |
    exact vw.trans wz | exact uv.trans (vw.trans wz)

def blockerClause (word : Nat) : CNF.Clause Nat :=
  (List.range 56).map (fun k => (k, !word.testBit k))

theorem eval_blocker (A : Nat → Bool) {word : Nat}
    (diff : ¬ ∀ k < 56, A k = word.testBit k) :
    (blockerClause word).eval A = true := by
  obtain ⟨k,hn⟩ := not_forall.mp diff
  have bound : k < 56 := by
    by_contra h
    exact hn (fun h' => (h h').elim)
  have witness : A k = !word.testBit k := by
    have ne : A k ≠ word.testBit k := fun e => hn (fun _ => e)
    cases h : A k <;> cases hb : word.testBit k <;> simp_all
  apply List.any_eq_true.mpr
  refine ⟨(k, !word.testBit k),List.mem_map.mpr ⟨k,List.mem_range.mpr bound,rfl⟩,?_⟩
  simp only [witness, beq_self_eq_true]

def checkedLabel (word : Nat) (v : Fin 16) : Fin 16 :=
  ⟨(word >>> (4*v.val)) % 16, Nat.mod_lt _ (by decide)⟩

def BlockIso (a b mask target code : Nat) : Prop :=
  Function.Injective (checkedLabel code) ∧
    ∀ x y : Fin 16, x < y →
      decide ((graphOfMask 16 target).Adj (checkedLabel code x) (checkedLabel code y)) =
        (known a b x.val y.val).getD (mask.testBit (crossIndex x.val y.val))

instance (a b mask target code : Nat) : Decidable (BlockIso a b mask target code) := by
  unfold BlockIso
  infer_instance

private theorem known_none_index {a b : Nat} {x y : Fin 16}
    (hxy : x < y) (none : known a b x.val y.val = none) :
    crossIndex x.val y.val < 56 := by
  have order := Fin.lt_def.mp hxy
  have ymax := y.isLt
  unfold known at none
  split at none
  · contradiction
  · split at none
    · contradiction
    · split at none
      · contradiction
      · unfold crossIndex
        omega

theorem blockIso_sound (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj]
    {a b mask target code : Nat} (root : Rooted G)
    (hleft : G.comap left = graphOfMask 7 a) (hright : Gᶜ.comap right = graphOfMask 8 b)
    (assignment : ∀ k < 56, graphAssignment G k = mask.testBit k)
    (checked : BlockIso a b mask target code) :
    Nonempty (graphOfMask 16 target ≃g G) := by
  have ordered (x y : Fin 16) (hxy : x < y) :
      (graphOfMask 16 target).Adj (checkedLabel code x) (checkedLabel code y) ↔ G.Adj x y := by
    have supplied := checked.2 x y hxy
    have graph := known_matches G root hleft hright x y hxy
    have eq :
        decide ((graphOfMask 16 target).Adj (checkedLabel code x) (checkedLabel code y)) =
          decide (G.Adj x y) := by
      rw [supplied]
      cases choice : known a b x.val y.val with
      | some hit =>
        simp only [choice, Option.getD_some] at graph ⊢
        exact graph.symm
      | none =>
        simp only [choice, Option.getD_none] at graph ⊢
        exact ((assignment _ (known_none_index hxy choice)).symm).trans graph.symm
    exact decide_eq_decide.mp eq
  have allPairs (x y : Fin 16) :
      (graphOfMask 16 target).Adj (checkedLabel code x) (checkedLabel code y) ↔ G.Adj x y := by
    rcases lt_trichotomy x y with h | rfl | h
    · exact ordered x y h
    · simp
    · exact ⟨fun he => ((ordered y x h).mp he.symm).symm,
        fun he => ((ordered y x h).mpr he.symm).symm⟩
  let toTarget : G ≃g graphOfMask 16 target :=
    { toEquiv := Equiv.ofBijective (checkedLabel code)
        (Finite.injective_iff_bijective.mp checked.1)
      map_rel_iff' := allPairs _ _ }
  exact ⟨toTarget.symm⟩

inductive RootReason (a b : Nat) (blockers : List Nat) (clause : CNF.Clause Nat) : Prop
  | quad {u v w z : Fin 16} (uv : u < v) (vw : v < w) (wz : w < z) (wanted : Bool)
      (agrees : clauseFor a b wanted (quadEdges u v w z) = some clause)
  | blocker {word : Nat} (member : word ∈ blockers) (agrees : clause = blockerClause word)

def originClause (a b : Nat) (blockers : List Nat) (tag : Nat) : Option (CNF.Clause Nat) :=
  if tag.testBit 17 then (blockers[tag % 2^17]?).map blockerClause
  else
    let u := Fin.ofNat 16 tag
    let v := Fin.ofNat 16 (tag >>> 4)
    let w := Fin.ofNat 16 (tag >>> 8)
    let z := Fin.ofNat 16 (tag >>> 12)
    if u < v ∧ v < w ∧ w < z then clauseFor a b (!tag.testBit 16) (quadEdges u v w z)
    else none

theorem origin_sound {a b : Nat} {blockers : List Nat} {tag : Nat} {clause : CNF.Clause Nat}
    (verified : originClause a b blockers tag = some clause) :
    RootReason a b blockers clause := by
  unfold originClause at verified
  split at verified
  · cases hf : blockers[tag % 2^17]? with
    | none => rw [hf] at verified; contradiction
    | some word =>
      rw [hf, Option.map_some, Option.some.injEq] at verified
      exact .blocker (List.mem_of_getElem? hf) verified.symm
  · dsimp only at verified
    split at verified
    · rename_i h
      exact .quad h.1 h.2.1 h.2.2 _ verified
    · simp at verified

theorem classify_case (G : SimpleGraph (Fin 16)) [DecidableRel G.Adj]
    {a b : Nat} {targets blockers : List Nat} {cnf : CNF Nat}
    (hG : G.CliqueFree 4) (hC : Gᶜ.CliqueFree 4) (root : Rooted G)
    (hleft : G.comap left = graphOfMask 7 a) (hright : Gᶜ.comap right = graphOfMask 8 b)
    (unsat : cnf.Unsat) (inputs : ∀ clause ∈ cnf.clauses, RootReason a b blockers clause)
    (recognize : ∀ mask ∈ blockers, ∃ target ∈ targets, ∃ perm, BlockIso a b mask target perm) :
    ∃ target ∈ targets, Nonempty (graphOfMask 16 target ≃g G) := by
  by_cases covered : ∃ mask ∈ blockers, ∀ k < 56, graphAssignment G k = mask.testBit k
  · obtain ⟨mask,member,same⟩ := covered
    obtain ⟨target,memberTarget,perm,valid⟩ := recognize mask member
    exact ⟨target,memberTarget,blockIso_sound G root hleft hright same valid⟩
  · have sat : cnf.eval (graphAssignment G) = true := by
      apply Array.all_eq_true.mpr
      intro i hi
      have hc : cnf.clauses[i] ∈ cnf.clauses := Array.getElem_mem hi
      cases inputs _ hc with
      | quad uv vw wz wanted formed =>
        exact eval_quad_root G hG hC root hleft hright uv vw wz wanted formed
      | blocker member formed =>
        rw [formed]
        exact eval_blocker (graphAssignment G) (fun same => covered ⟨_,member,same⟩)
    have impossible := unsat (graphAssignment G)
    rw [sat] at impossible
    contradiction


def rootsChecked (a b : Nat) (blockers : List Nat) (cnf : CNF Nat) (tags : Nat) : Bool :=
  (List.range cnf.clauses.size).all fun i =>
    decide (originClause a b blockers ((tags >>> (18*i)) % 2^18) = some cnf.clauses[i]!)

theorem inputs_of_checked {a b : Nat} {blockers : List Nat} {cnf : CNF Nat} {tags : Nat}
    (checked : rootsChecked a b blockers cnf tags) :
    ∀ clause ∈ cnf.clauses, RootReason a b blockers clause := by
  intro clause member
  obtain ⟨i,hi,rfl⟩ := Array.mem_iff_getElem.mp member
  have h := (List.all_eq_true.mp checked) i (List.mem_range.mpr hi)
  have agree := of_decide_eq_true h
  rw [getElem!_pos cnf.clauses i hi] at agree
  exact origin_sound agree

def blockRowsChecked (a b : Nat) (targets : List Nat) (rows : List (Nat × Nat × Nat)) : Bool :=
  rows.all fun (mask, target, perm) => decide (target ∈ targets ∧ BlockIso a b mask target perm)

theorem recognize_of_rows {a b : Nat} {targets : List Nat} {rows : List (Nat × Nat × Nat)}
    (checked : blockRowsChecked a b targets rows) :
    ∀ mask ∈ rows.map Prod.fst, ∃ target ∈ targets, ∃ perm, BlockIso a b mask target perm := by
  intro mask member
  obtain ⟨⟨candidate,target,perm⟩,rowMember,equal⟩ := List.mem_map.mp member
  subst mask
  have h := (List.all_eq_true.mp checked) _ rowMember
  have verified : target ∈ targets ∧ BlockIso a b candidate target perm := of_decide_eq_true h
  exact ⟨target,verified.1,perm,verified.2⟩

theorem graphOfMask_eq_of_labels {n : Nat} (G : SimpleGraph (Fin n)) (word : Nat)
    (labels : ∀ i j : Fin n, i < j →
      (G.Adj i j ↔ word.testBit (column j.val+i.val) = true)) :
    G = graphOfMask n word := by
  ext i j
  have ordered (a b : Fin n) (h : a < b) :
      G.Adj a b ↔ (graphOfMask n word).Adj a b :=
    (labels _ _ h).trans (adj_graphOfMask_of_lt h).symm
  rcases lt_trichotomy i j with lo | rfl | hi
  · exact ordered _ _ lo
  · simp
  · exact (G.adj_comm i j).trans ((ordered _ _ hi).trans ((graphOfMask n word).adj_comm j i))
end Ramsey44Root

/-! Finite replay of distance-comparison refutations using reverse unit propagation. -/

namespace Ramsey44Replay.Group2
open Std.Sat

private abbrev Lit := Nat × Bool
private abbrev Clause := List Lit
private abbrev Step := Clause × List Nat
private abbrev Units := Nat × Nat

private def flip (x : Lit) : Lit := (x.1, !x.2)
private def satisfied (a : Nat → Bool) (c : Clause) : Prop := ∃ x ∈ c, a x.1 = x.2
private def recorded (u : Units) (l : Lit) : Bool :=
  (if l.2 then u.1 else u.2).testBit l.1
private def follows (a : Nat → Bool) (u : Units) : Prop :=
  ∀ x, recorded u x = true → a x.1 = x.2

private def mark (u : Units) (l : Lit) : Units :=
  if l.2 then (u.1 ||| (1 <<< l.1), u.2) else (u.1, u.2 ||| (1 <<< l.1))

private theorem recorded_mark {u : Units} {x y : Lit} :
    recorded (mark u x) y = true ↔ y = x ∨ recorded u y = true := by
  rcases x with ⟨i, b⟩
  rcases y with ⟨j, d⟩
  cases b <;> cases d <;> simp [recorded, mark, Nat.testBit_or, Nat.shiftLeft_eq,
    Nat.testBit_two_pow, or_comm]
  all_goals exact or_congr eq_comm Iff.rfl

private theorem follows_mark {a : Nat → Bool} {u : Units} {x : Lit}
    (h : follows a u) (hx : a x.1 = x.2) : follows a (mark u x) := by
  intro y hy
  rcases recorded_mark.mp hy with rfl | hu
  · exact hx
  · exact h y hu

private def seed : Clause → Units
  | [] => (0, 0)
  | x :: xs => mark (seed xs) (flip x)

private theorem seed_sound (a : Nat → Bool) (c : Clause) (hc : ¬ satisfied a c) :
    follows a (seed c) := by
  induction c with
  | nil => intro x hx; simp [seed, recorded] at hx
  | cons x xs ih =>
    apply follows_mark
    · exact ih (fun ⟨y, hy, he⟩ => hc ⟨y, List.mem_cons_of_mem _ hy, he⟩)
    · have hne : a x.1 ≠ x.2 := fun he => hc ⟨x, List.mem_cons_self .., he⟩
      change a x.1 = !x.2
      cases ha : a x.1 <;> cases hb : x.2 <;> simp_all

private def propagate (units : Units) : List Clause → Bool
  | [] => false
  | c :: cs =>
    match c.filter (fun x => !(recorded units (flip x))) with
      | [] => true
      | [x] => propagate (mark units x) cs
      | _ => false

private theorem propagation_sound (a : Nat → Bool) (clauses : List Clause)
    (h : ∀ c ∈ clauses, satisfied a c) (u : Units) (hu : follows a u) :
    propagate u clauses = false := by
  induction clauses generalizing u with
  | nil => rfl
  | cons c cs ih =>
    obtain ⟨x, hx, hvalue⟩ := h c (List.mem_cons_self ..)
    have hn : recorded u (flip x) = false := by
      by_contra! hm
      have hf := hu _ (Bool.eq_true_of_not_eq_false hm)
      change a x.1 = !x.2 at hf
      rw [hvalue] at hf
      rcases x with ⟨x, b⟩
      cases b <;> simp_all
    have hx' : x ∈ c.filter (fun y => !(recorded u (flip y))) := by
      exact List.mem_filter.mpr ⟨hx, by simp [hn]⟩
    unfold propagate
    split
    · rename_i he
      rw [he] at hx'
      cases hx'
    · rename_i y he
      rw [he] at hx'
      have hxy : x = y := by simpa only [List.mem_singleton] using hx'
      subst y
      apply ih
      · exact fun y hy => h y (List.mem_cons_of_mem _ hy)
      · exact follows_mark hu hvalue
    · rfl

private def prefixSound (a : Nat → Bool) (lookup : Nat → Option Clause) (i : Nat) : Prop :=
  ∀ j < i, ∀ c, lookup j = some c → satisfied a c

private def stepChecked (lookup : Nat → Option Clause) (i : Nat) (hints : List Nat) : Bool :=
  match lookup i with
  | none => false
  | some c => (hints.all fun j => decide (j < i)) &&
      propagate (seed c) (hints.filterMap lookup)

private def blockChecked (lookup : Nat → Option Clause) : Nat → List (List Nat) → Bool
  | _, [] => true
  | i, hints :: later => stepChecked lookup i hints && blockChecked lookup (i+1) later

private theorem step_sound (a : Nat → Bool) (lookup : Nat → Option Clause)
    (i : Nat) (hints : List Nat) (good : stepChecked lookup i hints = true)
    (known : prefixSound a lookup i) : prefixSound a lookup (i+1) := by
  intro j hj c hc
  by_cases hj' : j < i
  · exact known j hj' c hc
  have e : j = i := by omega
  subst j
  simp [stepChecked, hc, Bool.and_eq_true] at good
  by_contra absent
  have hm : ∀ d ∈ hints.filterMap lookup, satisfied a d := by
    intro d hd
    obtain ⟨h, hh, he⟩ := List.mem_filterMap.mp hd
    exact known h (good.1 h hh) d he
  have cannot := propagation_sound a _ hm _ (seed_sound a c absent)
  rw [good.2] at cannot
  contradiction

private theorem block_sound (a : Nat → Bool) (lookup : Nat → Option Clause)
    (rows : List (List Nat)) (i : Nat) (good : blockChecked lookup i rows = true)
    (known : prefixSound a lookup i) : prefixSound a lookup (i+rows.length) := by
  induction rows generalizing i with
  | nil => simpa using known
  | cons hints later ih =>
    simp only [blockChecked, Bool.and_eq_true] at good
    have next := step_sound a lookup i hints good.1 known
    have done := ih (i+1) good.2 next
    have arith : i + (hints :: later).length = i+1+later.length := by simp; omega
    rwa [arith]

/-! A variable is the zero-based cross edge 8*i + j, with left vertex i and right vertex 7+j. -/

private inductive PackedTree where
  | empty
  | leaf (offsets words : Nat)
  | split (left right : PackedTree)

private def getPacked : PackedTree → Nat → Nat → Option (Nat × Nat)
  | .empty, _, _ => none
  | .leaf offsets words, _, _ => some (offsets, words)
  | .split _ _, 0, _ => none
  | .split a b, n+1, i => getPacked (if i.testBit n then b else a) n i

private def low (width value : Nat) : Nat := value &&& ((1 <<< width)-1)

private def readWords (width : Nat) : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, data => low width data :: readWords width n (data >>> width)

private def readRows (width : Nat) : Nat → Nat → List (List Nat)
  | 0, _ => []
  | n+1, tape =>
    let size := low width tape
    let body := tape >>> width
    readWords width size body :: readRows width n (body >>> (width*size))

private def packedClause (data : PackedTree) (i : Nat) : Option Clause := do
  let (offsets, words) ← getPacked data 9 (i / 16)
  let offset := low 10 (offsets >>> (10*(i % 16)))
  let row := words >>> (7*offset)
  pure ((readWords 7 (low 7 row) (row >>> 7)).map fun w => (w/2, decide (w%2 = 0)))

private def packedLookup (roots learnt : PackedTree) (n i : Nat) : Option Clause :=
  if i < n then packedClause roots i else packedClause learnt (i-n)

private def rootFormula (roots : PackedTree) (n : Nat) : CNF Nat :=
  ⟨((List.range n).filterMap (packedClause roots)).toArray⟩

private theorem roots_sound (a : Nat → Bool) (roots learnt : PackedTree) (n : Nat)
    (model : (rootFormula roots n).eval a = true) :
    prefixSound a (packedLookup roots learnt n) n := by
  intro i hi c hc
  have entry : packedClause roots i = some c := by simpa [packedLookup, hi] using hc
  have member : c ∈ (rootFormula roots n).clauses := by
    have selected : c ∈ (List.range n).filterMap (packedClause roots) :=
      List.mem_filterMap.mpr ⟨i, List.mem_range.mpr hi, entry⟩
    simpa only [rootFormula, List.mem_toArray] using selected
  have truth := Array.all_eq_true_iff_forall_mem.mp model c member
  simpa [satisfied, CNF.Clause.eval, List.any_eq_true] using truth

def blockingClause (mask : Nat) : CNF.Clause Nat :=
  (List.range 56).map fun i => (i, !(mask.testBit i))

