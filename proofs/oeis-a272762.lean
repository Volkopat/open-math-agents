def guess (k : ℕ) (u v : Bool) (q : ℕ) : ℤ :=
  coeffTable ((k*4+2*u.toNat+v.toNat)*494+q)

def correct (q : Fin 494) : Prop := ∀ u v : Bool,
  guess 0 u v q = weight q ∧
  (∀ k : Fin 5, guess (k.val+1) u v q = mix u v (guess k.val u v) q) ∧
  guess 5 u v q = 12*guess 4 u v q - 55*guess 3 u v q + 120*guess 2 u v q -
    124*guess 1 u v q + 48*guess 0 u v q

instance (q : Fin 494) : Decidable (correct q) := by unfold correct; infer_instance

set_option maxRecDepth 10000 in
lemma coeffCert : ∀ q : Fin 494, correct q := by decide +kernel

lemma iter_eq (k : ℕ) (hk : k ≤ 5) (u v : Bool) (q : Fin 494) :
    iterate k u v q = guess k u v q := by
  induction k generalizing q with
  | zero => exact ((coeffCert q u v).1).symm
  | succ k ih =>
    rw [iterate, (coeffCert q u v).2.1 ⟨k,by omega⟩]
    have h (x y : Bool) := ih (by omega) ⟨_,small_go q true x y⟩
    cases u <;> cases v <;> simp only [mix, pick, ↓reduceIte, Bool.false_eq_true, h]

lemma five_digits (u v : Bool) (q : Fin 494) :
    iterate 5 u v q = 12*iterate 4 u v q - 55*iterate 3 u v q + 120*iterate 2 u v q -
      124*iterate 1 u v q + 48*iterate 0 u v q := by
  simpa only [iter_eq _ (by decide : 5 ≤ 5), iter_eq _ (by decide : 4 ≤ 5),
    iter_eq _ (by decide : 3 ≤ 5), iter_eq _ (by decide : 2 ≤ 5), iter_eq _ (by decide : 1 ≤ 5),
    iter_eq _ (by decide : 0 ≤ 5)] using (coeffCert q u v).2.2

lemma count_rec (n : ℕ) (u v : Bool) :
    count (n+5) u v = 12*count (n+4) u v - 55*count (n+3) u v + 120*count (n+2) u v -
      124*count (n+1) u v + 48*count (n+0) u v := by
  simp only [shift_total, total, Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl; intro y _
  apply Finset.sum_congr rfl; intro x _
  exact five_digits u v ⟨_,small_address n _ x y⟩

lemma reflect_square (t : ℕ) (f : ℕ → ℕ → ℤ) :
    ∑ j ∈ Finset.range (2*t+1), ∑ i ∈ Finset.range (2*t+1),
      f (((i:ℤ)-t).natAbs) (((j:ℤ)-t).natAbs) =
    4*(∑ j ∈ Finset.range (t+1), ∑ i ∈ Finset.range (t+1), f i j) -
      2*(∑ j ∈ Finset.range (t+1), f 0 j) - 2*(∑ i ∈ Finset.range (t+1), f i 0) + f 0 0 := by
  rw [reflect_sum t (fun y => ∑ i ∈ Finset.range (2*t+1), f (((i:ℤ)-t).natAbs) y)]
  have inner (y : ℕ) := reflect_sum t (fun i => f i y)
  simp only [inner]
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
  ring

lemma count_eq (n : ℕ) (u v : Bool) :
    count n u v = ∑ j ∈ Finset.range (span v n), ∑ i ∈ Finset.range (span u n),
      ((value (2^n-1) i j).toNat:ℤ) := by
  have hpos : 0 < (2:ℕ)^n := pow_pos (by decide) _
  unfold count total weight
  apply Finset.sum_congr rfl; intro j hj
  apply Finset.sum_congr rfl; intro i hi
  simp only [Finset.mem_range] at hi hj
  have hb (b : Bool) : span b n ≤ 2^n := by cases b <;> simp [span] <;> omega
  rw [at_width n _ _ _ (by omega) (lt_of_lt_of_le hi (hb u)) (lt_of_lt_of_le hj (hb v))]

lemma sampled_eq (n r : ℕ) (hr : r=822 ∨ r=886) : sampled r n =
    4*count n true true - 2*count n false true - 2*count n true false + count n false false := by
  have h : 0 < (2:ℕ)^n := pow_pos (by decide) _
  rw [sampled, stages r _ hr, sum_grid]
  unfold plane
  rw [reflect_square (2^n-1) (fun i j => ((value (2^n-1) i j).toNat:ℤ))]
  simp only [count_eq, span, ↓reduceIte, Bool.false_eq_true, Finset.sum_range_one,
    show (2:ℕ)^n-1+1 = 2^n by omega]


lemma a_rec (n : ℕ) : a (n+5) = 12*a (n+4) - 55*a (n+3) + 120*a (n+2) -
    124*a (n+1) + 48*a n := by
  simp only [a, sampled_eq _ 822 (Or.inl rfl), count_rec n, Nat.add_zero]
  ring

lemma recurrence (n : ℕ) (h : 4 < n) :
    a n = 12*a (n-1) - 55*a (n-2) + 120*a (n-3) - 124*a (n-4) + 48*a (n-5) := by
  have e := a_rec (n-5)
  simpa only [show n-5+5=n by omega, show n-5+4=n-1 by omega,
    show n-5+3=n-2 by omega, show n-5+2=n-3 by omega, show n-5+1=n-4 by omega] using e

lemma initial (n : ℕ) (h : n < 5) :
    a n = ([1,5,25,105,417] : List ℤ)[n]?.getD 0 := by
  rw [a, sampled_eq _ 822 (Or.inl rfl)]
  interval_cases n <;> decide +kernel

def closedValue (n : ℕ) : ℤ := 5 - 2^(1+n) + 2^(1+2*n) - 4*3^n + 2^(2+n)*(n:ℤ)

lemma value_rec (n : ℕ) :
    closedValue (n+5) = 12*closedValue (n+4) - 55*closedValue (n+3) + 120*closedValue (n+2) -
      124*closedValue (n+1) + 48*closedValue n := by
  unfold closedValue
  simp only [Nat.mul_add, pow_add, Nat.cast_add, Nat.cast_ofNat]
  ring

lemma closed (n : ℕ) : a n = closedValue n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases h : n < 5
    · have hi := initial n h
      interval_cases n <;> norm_num [closedValue] at *
      all_goals assumption
    · let k := n-5
      have hk : n=k+5 := by dsimp [k]; omega
      rw [hk, a_rec, value_rec, ih (k+4) (by omega), ih (k+3) (by omega),
        ih (k+2) (by omega), ih (k+1) (by omega), ih k (by omega)]

