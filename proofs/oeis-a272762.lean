  have hd : mk a * ((X-1)*(2*X-1)^2*(3*X-1)*(4*X-1)) =
      (-1:ℤ) • (mk a * X^0) + (12:ℤ) • (mk a * X^1) + (-55:ℤ) • (mk a * X^2) +
      (120:ℤ) • (mk a * X^3) + (-124:ℤ) • (mk a * X^4) + (48:ℤ) • (mk a * X^5) := by
    simp only [zsmul_eq_mul]; push_cast; ring
  have hp : (-56*X^4 + 40*X^3 - 20*X^2 + 7*X - 1 : PowerSeries ℤ) = (-1:ℤ) • X^0 +
      (7:ℤ) • X^1 + (-20:ℤ) • X^2 + (40:ℤ) • X^3 + (-56:ℤ) • X^4 := by
    simp only [zsmul_eq_mul]; push_cast; ring
  rw [hd,hp]
  ext n
  simp only [map_add,map_zsmul,coeff_mul_X_pow',coeff_X_pow,coeff_mk]
  by_cases h : n < 5
  · have h0 := initial 0 (by decide)
    have h1 := initial 1 (by decide)
    have h2 := initial 2 (by decide)
    have h3 := initial 3 (by decide)
    have h4 := initial 4 (by decide)
    norm_num at h0 h1 h2 h3 h4
    interval_cases n <;> norm_num [zsmul_eq_mul,h0,h1,h2,h3,h4]
  · have hr := recurrence n (by omega)
    simp only [if_pos (show 0 ≤ n by omega), Nat.sub_zero, zsmul_eq_mul,
      if_pos (show 1 ≤ n by omega), if_pos (show 2 ≤ n by omega), if_pos (show 3 ≤ n by omega),
      if_pos (show 4 ≤ n by omega), if_pos (show 5 ≤ n by omega),
      if_neg (show n ≠ 0 by omega), if_neg (show n ≠ 1 by omega),
      if_neg (show n ≠ 2 by omega), if_neg (show n ≠ 3 by omega), if_neg (show n ≠ 4 by omega)]
    norm_num
    linarith only [hr]
