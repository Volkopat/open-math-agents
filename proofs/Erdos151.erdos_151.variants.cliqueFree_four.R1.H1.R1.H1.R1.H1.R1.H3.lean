private def edge (rows : Array Nat) (i j : Nat) : Bool :=
  (rows.getD i 0).testBit j

private def isSymm (rows : Array Nat) (n : Nat) : Bool :=
  (List.range n).all fun i =>
    !(edge rows i i) &&
    (List.range n).all fun j => edge rows i j == edge rows j i

private def isTF (rows : Array Nat) (n : Nat) : Bool :=
  (List.range n).all fun i =>
    (List.range n).all fun j =>
      !(edge rows i j) || ((rows.getD i 0) &&& (rows.getD j 0) == 0)

private inductive Cert where
  | l (pairs : List (Nat × Nat))
  | b (v : Nat) (withV : Cert) (withoutV : Cert)

private def checkPairs (rows : Array Nat) : List Nat → List (Nat × Nat) → Nat → Bool
  | rem, [], need => rem.length < need
  | rem, (u, v) :: ps, need =>
      rem.contains u && rem.contains v && edge rows u v &&
      (need > 0) &&
      checkPairs rows ((rem.erase u).erase v) ps (need - 1)

private def checkCert (rows : Array Nat) : Cert → List Nat → Nat → Bool
  | Cert.l ps, rem, need => checkPairs rows rem ps need
  | Cert.b v cIn cOut, rem, need =>
      rem.contains v && (need > 0) &&
      checkCert rows cIn ((rem.erase v).filter fun x => !(edge rows v x)) (need - 1) &&
      checkCert rows cOut (rem.erase v) need

