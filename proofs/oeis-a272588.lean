set_option maxHeartbeats 2000000 in
lemma state_two_eq : state 507 2 = state 505 2 := by
  funext x y
  by_cases h : |x| ≤ 2 ∧ |y| ≤ 2
  · rcases abs_le.mp h.1 with ⟨_, _⟩; rcases abs_le.mp h.2 with ⟨_, _⟩
    interval_cases x <;> interval_cases y <;> decide +kernel
  · have hout : ∀ r : ℕ, r = 507 ∨ r = 505 →
        ∀ p q : ℤ, 2 < |p| ∨ 2 < |q| → state r 2 p q = false := by
      intro r hr p q hpq
      have hout1 : ∀ u v : ℤ, 1 < |u| ∨ 1 < |v| → state r 1 u v = true := by
        intro u v huv
        have hout0 : ∀ c d : ℤ, ¬(c = 0 ∧ d = 0) → state r 0 c d = false := by
          intro c d hcd; simp [state, hcd]
        change step r (state r 0) u v = true
        unfold step
        rw [hout0 u v (by cases abs_cases u <;> cases abs_cases v <;> omega),
            hout0 (u - 1) v (by cases abs_cases u <;> cases abs_cases v <;> omega),
            hout0 (u + 1) v (by cases abs_cases u <;> cases abs_cases v <;> omega),
            hout0 u (v - 1) (by cases abs_cases u <;> cases abs_cases v <;> omega),
            hout0 u (v + 1) (by cases abs_cases u <;> cases abs_cases v <;> omega)]
        rcases hr with rfl | rfl <;> decide
      change step r (state r 1) p q = false
      unfold step
      rw [hout1 p q (by omega),
          hout1 (p - 1) q (by cases abs_cases p <;> cases abs_cases (p - 1) <;> omega),
          hout1 (p + 1) q (by cases abs_cases p <;> cases abs_cases (p + 1) <;> omega),
          hout1 p (q - 1) (by cases abs_cases q <;> cases abs_cases (q - 1) <;> omega),
          hout1 p (q + 1) (by cases abs_cases q <;> cases abs_cases (q + 1) <;> omega)]
      rcases hr with rfl | rfl <;> decide
    have hfar : 2 < |x| ∨ 2 < |y| := by omega
    rw [hout 507 (Or.inl rfl) x y hfar, hout 505 (Or.inr rfl) x y hfar]

lemma testBit_507_eq_505 (c b1 b2 b3 b4 : Bool)
    (h : ¬(c = true ∧ b1 = false ∧ b2 = false ∧ b3 = false ∧ b4 = false)) :
    Nat.testBit 507 (c.toNat + 2 * (b1.toNat + b2.toNat + b3.toNat + b4.toNat)) =
      Nat.testBit 505 (c.toNat + 2 * (b1.toNat + b2.toNat + b3.toNat + b4.toNat)) := by
  cases c <;> cases b1 <;> cases b2 <;> cases b3 <;> cases b4 <;> simp at h ⊢ <;> decide

lemma state_eq_ge2 (k : ℕ) : state 507 (k + 2) = state 505 (k + 2) := by
  induction k with
  | zero => exact state_two_eq
  | succ k ih =>
    funext x y
    change step 507 (state 507 (k + 2)) x y = step 505 (state 505 (k + 2)) x y
    rw [ih]
    unfold step
    exact testBit_507_eq_505 _ _ _ _ _ (Scale505.no_isolated_505 (k + 2) (by omega) x y)

lemma onCount_eq_ge2 (t : ℕ) (ht : 2 ≤ t) : onCount 507 t = onCount 505 t := by
  obtain ⟨k, rfl⟩ : ∃ k, t = k + 2 := ⟨t - 2, by omega⟩
  unfold onCount
  rw [state_eq_ge2 k]

end Proof_a272588

