import OMAReductions.R_Green14_W_3_15_R2

/-! A branch certificate for the two palindromic obstructions in the reduction.
Each node gives a 15-term progression. Unless it is entirely blue, one of
its reflected half-board positions must be red. Two red positions forbid
a third whenever the three positions form an arithmetic progression.

The trials assume one additional red position at a time. When its search
tree closes, that position is forced blue in subsequent trials. The last
step checks that the forced positions cover a full length-fifteen
progression. The packed search hints are validated by the Lean kernel. -/
namespace OMA.Pal15

private def Wins (n : Nat) (c : Nat → Bool) : Prop :=
  ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 14)*d < n ∧
    ∀ t ≤ (if b then 2 else 14), c (a+t*d) = b

private def foldPos (n x : Nat) := min x (n-1-x)

private theorem reflectAt {n : Nat} {c : Nat → Bool} (hs : ∀ x < n, c (n-1-x) = c x) {x} (hx : x < n) :
    c (foldPos n x) = c x := by
  unfold foldPos
  rcases le_total x (n-1-x) with h | h
  · rw [min_eq_left h]
  · rw [min_eq_right h, hs _ hx]

private def Blue (c : Nat → Bool) (m : Nat) := ∀ i, m.testBit i = true → c i = false

private theorem blueZero (c : Nat → Bool) : Blue c 0 := by simp [Blue]
private theorem blueOr {c u v} (hu : Blue c u) (hv : Blue c v) : Blue c (u ||| v) := by
  intro i hi
  simp only [Nat.testBit_or, Bool.or_eq_true] at hi
  exact hi.elim (hu i) (hv i)

private theorem blueSingle {c x} (hx : c x = false) : Blue c (1 <<< x) := by
  intro i hi
  have : x = i := by simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow, eq_comm] using hi
  simpa [← this] using hx

private def SoundTab (c : Nat → Bool) (tab : Nat → Nat → Nat) :=
  ∀ x y, c x = true → c y = true → Blue c (tab x y)

private def forced (n z : Nat) := 1 <<< foldPos n z

private theorem force_ok {n c} (hs : ∀ x < n, c (n-1-x) = c x)
    {z : Nat} (hz : z<n) (hc : c z = false) : Blue c (forced n z) := by
  apply blueSingle
  rwa [reflectAt hs hz]

private theorem no_ap {n c} (hw : ¬ Wins n c) (a d : Nat) (hd : 0<d)
    (he : a+2*d<n) : ¬ (c a=true ∧ c (a+d)=true ∧ c (a+2*d)=true) := by
  rintro ⟨h0,h1,h2⟩
  apply hw
  refine ⟨true,a,d,hd,he,?_⟩
  intro t ht
  change t ≤ 2 at ht
  interval_cases t <;> simp_all

private def extend (n u v : Nat) :=
  if u<v then
    let d := v-u
    (if d≤u then forced n (u-d) else 0) |||
    (if v+d<n then forced n (v+d) else 0) |||
    (if d%2==0 then forced n (u+d/2) else 0)
  else 0

private theorem extend_ok {n c} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    {u v : Nat} (hv : v<n) (hu' : c u=true) (hv' : c v=true) :
    Blue c (extend n u v) := by
  unfold extend
  split
  · rename_i huv
    dsimp only
    apply blueOr
    · apply blueOr
      · split
        · rename_i hlo
          apply force_ok hs (by omega)
          have h := no_ap hw (u-(v-u)) (v-u) (by omega) (by omega)
          simpa [show u-(v-u)+(v-u)=u by omega, show u-(v-u)+2*(v-u)=v by omega,
            hu',hv'] using h
        · exact blueZero c
      · split
        · rename_i he
          apply force_ok hs he
          have h := no_ap hw u (v-u) (by omega) (by omega)
          simpa [show u+(v-u)=v by omega,show u+2*(v-u)=v+(v-u) by omega,hu',hv'] using h
        · exact blueZero c
    · split
      · rename_i he
        have hm : (v-u)%2=0 := by simpa using he
        apply force_ok hs (by omega)
        have h := no_ap hw u ((v-u)/2) (by omega) (by omega)
        simpa [show u+2*((v-u)/2)=v by omega,hu',hv'] using h
      · exact blueZero c
  · exact blueZero c

private def pairBan (n x y : Nat) := extend n (min x y) (max x y)

private theorem pairBan_ok {n c} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    {x y : Nat} (hx : x<n) (hy : y<n) (hxc : c x=true) (hyc : c y=true) :
    Blue c (pairBan n x y) := by
  rcases le_total x y with h | h
  · simpa [pairBan,min_eq_left h,max_eq_right h] using extend_ok hs hw hy hxc hyc
  · simpa [pairBan,min_eq_right h,max_eq_left h] using extend_ok hs hw hx hyc hxc

/- If the two remaining terms reflect into one another, their common color
alone completes the red triple. The central point is the second exceptional
case and excludes every other reflected pair. -/
private def singleEnd (n x : Nat) :=
  let z := (x+n-1)/3
  if (x+n-1)%3==0 && z≠x && z<n then forced n z else 0

private theorem singleEnd_ok {n c} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    {x : Nat} (hx : x<n) (hr : c x=true) : Blue c (singleEnd n x) := by
  unfold singleEnd
  dsimp only
  split
  · rename_i h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    let z := (x+n-1)/3
    have hz : z<n := h.2
    have hz' : 3*z=x+n-1 := by dsimp [z]; omega
    apply force_ok hs hz
    cases hc : c z with
    | false => rfl
    | true =>
      have hc' : c (n-1-z)=true := (hs z hz).trans hc
      by_cases hlt : x<z
      · have hn := no_ap hw x (z-x) (by omega) (by omega)
        exact (hn ⟨hr,by rwa [show x+(z-x)=z by omega],by rwa [show x+2*(z-x)=n-1-z by omega]⟩).elim
      · have hxz : x≠z := Ne.symm h.1.2
        have hn := no_ap hw (n-1-z) (x-z) (by omega) (by omega)
        exact (hn ⟨hc',by rwa [show n-1-z+(x-z)=z by omega],by rwa [show n-1-z+2*(x-z)=x by omega]⟩).elim
  · exact blueZero c

private def centerBan (n x : Nat) :=
  if 2*x+1=n then (1 <<< x)-1 else 0

private theorem centerBan_ok {n c} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    {x : Nat} (hr : c x=true) : Blue c (centerBan n x) := by
  unfold centerBan
  split
  · rename_i h
    intro i hi
    have hl : i<x := by simpa [Nat.shiftLeft_eq] using hi
    cases hc : c i with
    | false => rfl
    | true =>
      have hn := no_ap hw i (x-i) (by omega) (by omega)
      exact (hn ⟨hc, by rwa [show i+(x-i)=x by omega],
        by rw [show i+2*(x-i)=n-1-i by omega, hs i (by omega),hc]⟩).elim
  · exact blueZero c

private def geometry (n x y : Nat) :=
  if x<n && y<n then
    let m := n-1-y
    pairBan n x y ||| pairBan n x m ||| (if x==y then
      singleEnd n x ||| singleEnd n m ||| centerBan n x else 0)
  else 0

private theorem geometry_ok {n c} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c) :
    SoundTab c (geometry n) := by
  intro x y hxc hyc
  unfold geometry
  split
  · rename_i h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    dsimp only
    have hm : n-1-y < n := by omega
    have hmc := (hs y h.2).trans hyc
    apply blueOr (blueOr (pairBan_ok hs hw h.1 h.2 hxc hyc)
      (pairBan_ok hs hw h.1 hm hxc hmc))
    split
    · exact blueOr (blueOr (singleEnd_ok hs hw h.1 hxc) (singleEnd_ok hs hw hm hmc))
        (centerBan_ok hs hw hxc)
    · exact blueZero c
  · exact blueZero c
private structure Board where
  width : Nat
  rows : Nat → Nat
  initial : Nat

private def cell (s : Board) (v x : Nat) :=
  if x < s.width then (v >>> (s.width*x)) &&& ((1 <<< s.width)-1) else 0

private def row (s : Board) (x : Nat) := if x < s.width then s.rows x else 0

private def checkedRow (n : Nat) (s : Board) (x : Nat) :=
  (List.range s.width).all fun y =>
    let m := cell s (s.rows x) y
    (m &&& geometry n x y) == m

private def checkedInitial (n : Nat) (s : Board) :=
  (List.range s.width).all fun x =>
    let m := cell s s.initial x
    (m &&& geometry n x x) == m

private def Compatible (s : Board) (c : Nat → Bool) (v : Nat) :=
  ∀ x, c x = true → Blue c (cell s v x)

private theorem blue_sub {c m g} (h : m &&& g = m) (hg : Blue c g) : Blue c m := by
  intro i hi
  rw [← h, Nat.testBit_and, Bool.and_eq_true] at hi
  exact hg i hi.2

private theorem row_compatible {n s c} (ht : SoundTab c (geometry n))
    (h : ∀ x < s.width, checkedRow n s x = true) {x} (hx : c x = true) :
    Compatible s c (row s x) := by
  intro y hy
  by_cases h1 : x<s.width
  · by_cases h2 : y<s.width
    · have hm := List.all_eq_true.mp (h x h1) y (List.mem_range.mpr h2)
      simpa only [row,if_pos h1] using blue_sub (beq_iff_eq.mp hm) (ht x y hx hy)
    · simp [cell,h2,blueZero]
  · simp [row,h1,cell,blueZero]

private theorem initial_compatible {n s c} (ht : SoundTab c (geometry n))
    (h : checkedInitial n s = true) : Compatible s c s.initial := by
  intro x hx
  by_cases h1 : x<s.width
  · have hm := List.all_eq_true.mp h x (List.mem_range.mpr h1)
    exact blue_sub (beq_iff_eq.mp hm) (ht x x hx hx)
  · simp [cell,h1,blueZero]

private theorem compatOr {s c a b} (ha : Compatible s c a) (hb : Compatible s c b) :
    Compatible s c (a ||| b) := by
  intro x hx
  by_cases h : x<s.width
  · simpa only [cell,if_pos h,Nat.shiftRight_or_distrib,Nat.and_or_distrib_right] using
      blueOr (ha x hx) (hb x hx)
  · simp [cell,h,blueZero]
private def Hit (c : Nat → Bool) (m : Nat) := ∃ i, m.testBit i = true ∧ c i = true

private def without (m b : Nat) := Nat.xor m (Nat.land m b)

private theorem hit_without {c m b} (h : Hit c m) (hb : Blue c b) : Hit c (without m b) := by
  obtain ⟨i,hi,hc⟩ := h
  have hf : b.testBit i = false := by
    cases hx : b.testBit i <;> simp_all [Blue]
  exact ⟨i,by simp [without,Nat.testBit_xor,Nat.testBit_and,hi,hf],hc⟩

private def validMove (n v : Nat) :=
  let a := v % 256
  let d := (v >>> 8) % 16
  let m := v >>> 12
  0 < d && a+14*d < n && (List.range 15).all (fun t => m.testBit (foldPos n (a+t*d)))

private theorem validMove_hit {n v c} (hs : ∀ x < n, c (n-1-x) = c x) (hw : ¬ Wins n c)
    (hv : validMove n v = true) : Hit c (v >>> 12) := by
  let a := v%256
  let d := (v >>> 8)%16
  have h : (0 < d ∧ a+14*d<n) ∧ ∀ t < 15, (v >>> 12).testBit (foldPos n (a+t*d)) = true := by
    simpa [validMove, a, d, List.all_eq_true] using hv
  by_contra! bad
  apply hw
  refine ⟨false,a,d,h.1.1,h.1.2,?_⟩
  intro t ht
  change t ≤ 14 at ht
  have hx : a+t*d<n := by have := Nat.mul_le_mul_right d ht; omega
  rw [← reflectAt hs hx]
  cases hc : c (foldPos n (a+t*d)) with
  | false => rfl
  | true => exact (bad ⟨_,h.2 t (by omega),hc⟩).elim

private def branches (child : Nat → Nat → Nat → Nat) (s : Board)
    (v : Nat) : Nat → Nat → Nat → Nat → Nat
  | 0, m, _, p => if m == 0 then p else 0
  | k+1, m, b, p =>
    if m == 0 then p else
      let x := (Nat.xor m (m-1)).log2
      let q := child (Nat.lor v (row s x)) (Nat.lor b (cell s v x)) p
      if q == 0 then 0 else
        branches child s v k (without m (1 <<< x)) (Nat.lor b (1 <<< x)) q

private theorem branches_ok {c : Nat → Bool} {s child}
    (ht : ∀ x, c x = true → Compatible s c (row s x))
    (hc : ∀ rs b p, (Compatible s c rs) → Blue c b → child rs b p = 0)
    {v} (hr : Compatible s c v) (k m b p : Nat)
    (hb : Blue c b) (hw : Hit c m) : branches child s v k m b p = 0 := by
  induction k generalizing m b p with
  | zero =>
    have hm : m≠0 := by rintro rfl; simpa [Hit] using hw
    simp [branches,hm]
  | succ k ih =>
    have hm : m≠0 := by rintro rfl; simpa [Hit] using hw
    rw [branches,if_neg (by simpa using hm)]
    dsimp only
    cases hx : c (Nat.xor m (m-1)).log2 with
    | false =>
      split
      · rfl
      · apply ih _ _ _ (blueOr hb (blueSingle hx)) (hit_without hw (blueSingle hx))
    | true =>
      let x := (Nat.xor m (m-1)).log2
      have hchild := hc (Nat.lor v (row s x)) (Nat.lor b (cell s v x)) p
        (compatOr hr (ht x hx)) (blueOr hb (hr x hx))
      split
      · rfl
      · rename_i h
        exact (h (beq_iff_eq.mpr hchild)).elim

private def walk (s : Board) (mask : Nat → Nat) : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, _ => 0
  | fuel+1, v, b, p =>
    branches (walk s mask fuel) s v 15 (without (mask p) b) b (p+1)

private theorem walk_ok {s c} (ht : ∀ x, c x = true → Compatible s c (row s x))
    {mask : Nat → Nat} (hm : ∀ p, Hit c (mask p)) (fuel : Nat) (v b p)
    (hr : Compatible s c v) (hb : Blue c b) : walk s mask fuel v b p = 0 := by
  induction fuel generalizing v b p with
  | zero => rfl
  | succ fuel ih =>
    exact branches_ok ht ih hr _ _ b _ hb (hit_without (hm p) hb)

private def stripe (step len : Nat) := ((1 <<< (step*len))-1) / ((1 <<< step)-1)
private def stripes (width : Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | k+1, d =>
    let u := (d >>> 14) % 8
    let step := if u=0 then width-1 else if u=1 then width+1 else if u=2 then width-2
      else if u=3 then width+2 else if u=4 then 2*width-1 else if u=5 then 2*width+1
      else if u=6 then width else 1
    let m := stripe step ((d >>> 17)%128)
    Nat.lor (m <<< (d%16384)) (stripes width k (d >>> 24))

