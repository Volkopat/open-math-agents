/-- b^e mod m by repeated squaring, with fuel f (enough when e < 2^f). -/
def pmf (m b : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 1 % m
  | f + 1, e =>
    if e = 0 then 1 % m
    else if e % 2 = 1 then (pmf m b f (e / 2) * pmf m b f (e / 2) % m) * b % m
    else pmf m b f (e / 2) * pmf m b f (e / 2) % m

lemma pmf_spec (m b : ℕ) : ∀ f e, e < 2 ^ f → pmf m b f e = b ^ e % m := by
  intro f
  induction f with
  | zero => intro e he; simp at he; subst he; simp [pmf]
  | succ f ih =>
    intro e he
    rw [pow_succ] at he
    have h2 : e / 2 < 2 ^ f := by omega
    simp only [pmf]
    split_ifs with h0 h1
    · subst h0; simp
    · rw [ih _ h2]
      conv_rhs => rw [show e = e / 2 + e / 2 + 1 by omega, pow_succ, pow_add]
      simp only [Nat.mod_mul_mod, Nat.mul_mod_mod]
    · rw [ih _ h2]
      conv_rhs => rw [show e = e / 2 + e / 2 by omega, pow_add]
      simp only [Nat.mod_mul_mod, Nat.mul_mod_mod]

lemma fermat3 (v : ℕ) (hv : v.Prime) (h3 : v % 3 ≠ 0) : 3 ^ (v - 1) % v = 1 := by
  have hc : Nat.Coprime 3 v := (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2
    (fun h => h3 (Nat.mod_eq_zero_of_dvd h))
  have := Nat.ModEq.pow_totient hc
  rw [Nat.totient_prime hv] at this
  unfold Nat.ModEq at this
  rw [this, Nat.mod_eq_of_lt hv.one_lt]

/-- The certificate for one multiplier: a proper divisor, or (p = 0) a Fermat witness 3. -/
def good (v p : ℕ) : Bool :=
  if p = 0 then (v % 3 != 0) && decide (v - 1 < 2 ^ 640) && (pmf v 3 640 (v - 1) != 1)
  else (v % p == 0) && decide (1 < p) && decide (p < v)

lemma good_spec (v p : ℕ) (h : good v p = true) : ¬ v.Prime := by
  unfold good at h
  split_ifs at h with hp
  · simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    intro hv
    rw [pmf_spec _ _ _ _ h2] at h3
    exact h3 (fermat3 v hv h1)
  · simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero h1) h2 h3

/-- Checks the certificates in the list, starting at multiplier k. -/
def ok : ℕ → List ℕ → Bool
  | _, [] => true
  | k, p :: ps => good (k * 2 ^ 624 - 1) p && ok (k + 1) ps

lemma ok_cert : ok 1 cert = true := by decide +kernel

lemma ok_spec : ∀ (l : List ℕ) (k : ℕ), ok k l = true → ∀ i, i < l.length →
    ¬ ((k + i) * 2 ^ 624 - 1).Prime := by
  intro l
  induction l with
  | nil => intro k _ i hi; simp at hi
  | cons p ps ih =>
    intro k h i hi
    simp only [ok, Bool.and_eq_true] at h
    obtain ⟨h1, h4⟩ := h
    cases i with
    | zero =>
      simp only [Nat.add_zero]
      exact good_spec _ _ h1
    | succ i =>
      have := ih (k + 1) h4 i (by simpa using hi)
      rwa [show k + 1 + i = k + (i + 1) by ring] at this

lemma cert_length : cert.length = 1871 := by decide +kernel

