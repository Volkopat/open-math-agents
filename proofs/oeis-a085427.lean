theorem OMA.disproof : ¬ (type_of% @OMA.S_oeis_a085427.main) := by
  intro h
  obtain ⟨k, hk0, hk, hp⟩ := h 624 (by norm_num)
  have := OMA.P_oeis_a085427.ok_spec _ 1 OMA.P_oeis_a085427.ok_cert (k - 1)
    (by rw [OMA.P_oeis_a085427.cert_length]; omega)
  rw [show 1 + (k - 1) = k by omega] at this
  exact this hp
