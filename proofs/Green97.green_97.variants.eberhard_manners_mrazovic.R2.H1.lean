import OMAReductions.R_Green97_green_97_variants_eberhard_manners_mrazovic_R2

/-!
# Major-arc cutoff limit for additive triples of bijections

Proves `Green97.green_97.variants.eberhard_manners_mrazovic.R2.H1`: for every cutoff `M : ℕ`,
the normalized major-arc Fourier sum over vectors `ξ : Fin n → ZMod n` differing from some
constant in at most `2 * M` coordinates converges along odd `n → ∞` to
`∑ j ∈ Finset.range (M + 1), (-(1 / 2) : ℝ) ^ j / (j.factorial : ℝ)`.

Proof outline:
1. For odd `n > 4 * M`, the majority value `a : ZMod n` is unique and `∑ x : ZMod n, x = 0`, so
   `coeff n (fun i => a + η i) = coeff n η`; summing over `a` cancels `1 / n`.
2. Grouping by support `S` of size `k ≤ 2 * M` reduces the `k`-th contribution to
   `(1 / k!) * ((n - k)! / n!)^2 * ∑_{v : Fin k → (ZMod n) \ {0}} (injSum v ^ 2 * injSum (-v)).re`.
3. Inclusion-exclusion over edge subsets `A ⊆ pairs k` expresses `injSum(n, k, v)` as an exact
   real sum `∑ A, (-1)^|A| * (if valid A v then n^(compCount A) else 0)`, invariant under `v ↦ -v`.
4. Expanding the cube over triples `(A₁, A₂, A₃)` shows every triple has degree `≤ 0` in `n`,
   with degree `0` attained iff `k = 2 * j` and `A₁ = A₂ = A₃` is a perfect matching of `Fin (2 * j)`,
   yielding `pm(j) / (2 * j)! * (-1)^j = (-(1 / 2))^j / j!`.
-/

namespace OMA.Green97EMMH1

open Filter Finset
open scoped BigOperators Topology Classical

section Combinatorics

/-- The finite set of ordered pairs `(i, j)` in `Fin k` with `i < j`. -/
def pairs (k : ℕ) : Finset (Fin k × Fin k) :=
  Finset.univ.filter fun p : Fin k × Fin k => p.1 < p.2

/-- The simple graph on `Fin k` generated by an edge set `A`. -/
def graphOf {k : ℕ} (A : Finset (Fin k × Fin k)) : SimpleGraph (Fin k) where
  Adj u v := u ≠ v ∧ ((u, v) ∈ A ∨ (v, u) ∈ A)
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- The number of connected components of `graphOf A`. -/
noncomputable def compCount {k : ℕ} (A : Finset (Fin k × Fin k)) : ℕ :=
  Fintype.card (graphOf A).ConnectedComponent

/-- The vertices of `Fin k` lying in a connected component `c` of `graphOf A`. -/
noncomputable def compFinset {k : ℕ} (A : Finset (Fin k × Fin k))
    (c : (graphOf A).ConnectedComponent) : Finset (Fin k) :=
  Finset.univ.filter fun i => (graphOf A).connectedComponentMk i = c

/-- A vector `v : Fin k → ZMod n` is `A`-valid if it sums to `0` on every connected component
of `graphOf A`. -/
def valid {k n : ℕ} (A : Finset (Fin k × Fin k)) (v : Fin k → ZMod n) : Prop :=
  ∀ c : (graphOf A).ConnectedComponent, ∑ i ∈ compFinset A c, v i = 0

/-- An edge set `A ⊆ pairs k` is a perfect matching if every vertex belongs to a unique edge of `A`. -/
def isPerfectMatching {k : ℕ} (A : Finset (Fin k × Fin k)) : Prop :=
  A ⊆ pairs k ∧ ∀ i : Fin k, ∃! p ∈ A, p.1 = i ∨ p.2 = i

/-- The finset of perfect matchings on `Fin (2 * j)`. -/
noncomputable def perfectMatchings (j : ℕ) : Finset (Finset (Fin (2 * j) × Fin (2 * j))) :=
  (pairs (2 * j)).powerset.filter isPerfectMatching

lemma compFinset_nonempty {k : ℕ} (A : Finset (Fin k × Fin k))
    (c : (graphOf A).ConnectedComponent) : (compFinset A c).Nonempty := by
  refine SimpleGraph.ConnectedComponent.ind (fun i => ?_) c
  exact ⟨i, by simp [compFinset]⟩

lemma sum_compFinset_card {k : ℕ} (A : Finset (Fin k × Fin k)) :
    ∑ c : (graphOf A).ConnectedComponent, (compFinset A c).card = k := by
  have h := Finset.card_eq_sum_card_fiberwise
    (s := (Finset.univ : Finset (Fin k)))
    (t := (Finset.univ : Finset (graphOf A).ConnectedComponent))
    (f := (graphOf A).connectedComponentMk)
    (fun _ _ => Finset.mem_univ _)
  simpa [compFinset] using h.symm

lemma two_mul_compCount_le_of_no_singleton {k : ℕ} (A : Finset (Fin k × Fin k))
    (h : ∀ c : (graphOf A).ConnectedComponent, 2 ≤ (compFinset A c).card) :
    2 * compCount A ≤ k := by
  calc
    2 * compCount A = ∑ _c : (graphOf A).ConnectedComponent, 2 := by
      simp [compCount, mul_comm]
    _ ≤ ∑ c : (graphOf A).ConnectedComponent, (compFinset A c).card :=
      Finset.sum_le_sum fun c _ => h c
    _ = k := sum_compFinset_card A

lemma graphOf_mono {k : ℕ} {A B : Finset (Fin k × Fin k)} (hAB : A ⊆ B) :
    graphOf A ≤ graphOf B := by
  intro u v h
  exact ⟨h.1, h.2.imp (fun h1 => hAB h1) (fun h2 => hAB h2)⟩

lemma mem_compFinset_iff {k : ℕ} (A : Finset (Fin k × Fin k))
    (c : (graphOf A).ConnectedComponent) (i : Fin k) :
    i ∈ compFinset A c ↔ (graphOf A).connectedComponentMk i = c := by
  simp [compFinset]

lemma connectedComponentMk_eq_of_mem {k : ℕ} {A : Finset (Fin k × Fin k)}
    (hA : A ⊆ pairs k) {p : Fin k × Fin k} (hp : p ∈ A) :
    (graphOf A).connectedComponentMk p.1 = (graphOf A).connectedComponentMk p.2 := by
  have hlt : p.1 < p.2 := (Finset.mem_filter.mp (hA hp)).2
  have hadj : (graphOf A).Adj p.1 p.2 := ⟨ne_of_lt hlt, Or.inl hp⟩
  exact SimpleGraph.ConnectedComponent.sound hadj.reachable

lemma eq_on_component_of_edges {k : ℕ} {α : Type*} {A : Finset (Fin k × Fin k)}
    {f : Fin k → α} (hf : ∀ p ∈ A, f p.1 = f p.2)
    {u v : Fin k} (h : (graphOf A).Reachable u v) : f u = f v := by
  obtain ⟨w⟩ := h
  induction w with
  | nil => rfl
  | @cons a b c hab _ ih =>
    have hEq : f a = f b := by
      rcases hab.2 with h1 | h2
      · exact hf (a, b) h1
      · exact (hf (b, a) h2).symm
    exact hEq.trans ih

lemma compFinset_card_eq_two_of_eq {k : ℕ} (A : Finset (Fin k × Fin k))
    (hge : ∀ c : (graphOf A).ConnectedComponent, 2 ≤ (compFinset A c).card)
    (heq : 2 * compCount A = k) (c : (graphOf A).ConnectedComponent) :
    (compFinset A c).card = 2 := by
  by_contra hne
  have hgt : 2 < (compFinset A c).card := lt_of_le_of_ne (hge c) (Ne.symm hne)
  have hlt : ∑ _d : (graphOf A).ConnectedComponent, 2 <
      ∑ d : (graphOf A).ConnectedComponent, (compFinset A d).card :=
    Finset.sum_lt_sum (fun d _ => hge d) ⟨c, Finset.mem_univ c, hgt⟩
  rw [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_comm, sum_compFinset_card] at hlt
  change 2 * compCount A < k at hlt
  omega

lemma isPerfectMatching_of_compCount {k : ℕ} {A : Finset (Fin k × Fin k)}
    (hA : A ⊆ pairs k)
    (hge : ∀ c : (graphOf A).ConnectedComponent, 2 ≤ (compFinset A c).card)
    (heq : 2 * compCount A = k) : isPerfectMatching A := by
  refine ⟨hA, fun i => ?_⟩
  let c := (graphOf A).connectedComponentMk i
  have hc2 : (compFinset A c).card = 2 := compFinset_card_eq_two_of_eq A hge heq c
  have hi : i ∈ compFinset A c := by simp [compFinset, c]
  have herase_pos : 0 < ((compFinset A c).erase i).card := by
    rw [Finset.card_erase_of_mem hi, hc2]; omega
  obtain ⟨j, hj_er⟩ := Finset.card_pos.mp herase_pos
  obtain ⟨hij, hj⟩ := Finset.mem_erase.mp hj_er
  have hpair : compFinset A c = {i, j} := by
    have hsub : ({i, j} : Finset (Fin k)) ⊆ compFinset A c := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact hi
      · exact hj
    have hcard : ({i, j} : Finset (Fin k)).card = (compFinset A c).card := by
      rw [Finset.card_pair hij.symm, hc2]
    exact (Finset.eq_of_subset_of_card_le hsub hcard.ge).symm
  have hreach : (graphOf A).Reachable i j := by
    have hmk : (graphOf A).connectedComponentMk i = (graphOf A).connectedComponentMk j :=
      ((mem_compFinset_iff A c j).mp hj).symm
    exact SimpleGraph.ConnectedComponent.exact hmk
  obtain ⟨w⟩ := hreach
  have hadj : (graphOf A).Adj i j := by
    cases w with
    | nil => exact absurd rfl hij.symm
    | @cons _ b _ hib _ =>
      have hb : b ∈ compFinset A c := by
        rw [mem_compFinset_iff]
        exact (SimpleGraph.ConnectedComponent.sound hib.reachable).symm
      rw [hpair, Finset.mem_insert, Finset.mem_singleton] at hb
      rcases hb with rfl | rfl
      · exact absurd rfl hib.1
      · exact hib
  rcases hadj.2 with hmem | hmem
  · refine ⟨(i, j), ⟨hmem, Or.inl rfl⟩, ?_⟩
    intro p ⟨hpA, hpi⟩
    have hp_lt : p.1 < p.2 := (Finset.mem_filter.mp (hA hpA)).2
    have hmk1 : (graphOf A).connectedComponentMk p.1 = (graphOf A).connectedComponentMk p.2 :=
      connectedComponentMk_eq_of_mem hA hpA
    have hp1c : p.1 ∈ compFinset A c := by
      rw [mem_compFinset_iff]
      rcases hpi with h1 | h2
      · rw [h1]
      · rw [hmk1, h2]
    have hp2c : p.2 ∈ compFinset A c := by
      rw [mem_compFinset_iff]
      rw [← hmk1]; exact (mem_compFinset_iff A c p.1).mp hp1c
    rw [hpair, Finset.mem_insert, Finset.mem_singleton] at hp1c hp2c
    have hij_lt : i < j := (Finset.mem_filter.mp (hA hmem)).2
    rcases p with ⟨u, w⟩
    dsimp only at hp_lt hp1c hp2c
    rcases hp1c with rfl | rfl <;> rcases hp2c with rfl | rfl <;> first | rfl | omega
  · refine ⟨(j, i), ⟨hmem, Or.inr rfl⟩, ?_⟩
    intro p ⟨hpA, hpi⟩
    have hp_lt : p.1 < p.2 := (Finset.mem_filter.mp (hA hpA)).2
    have hmk1 : (graphOf A).connectedComponentMk p.1 = (graphOf A).connectedComponentMk p.2 :=
      connectedComponentMk_eq_of_mem hA hpA
    have hp1c : p.1 ∈ compFinset A c := by
      rw [mem_compFinset_iff]
      rcases hpi with h1 | h2
      · rw [h1]
      · rw [hmk1, h2]
    have hp2c : p.2 ∈ compFinset A c := by
      rw [mem_compFinset_iff]
      rw [← hmk1]; exact (mem_compFinset_iff A c p.1).mp hp1c
    rw [hpair, Finset.mem_insert, Finset.mem_singleton] at hp1c hp2c
    have hji_lt : j < i := (Finset.mem_filter.mp (hA hmem)).2
    rcases p with ⟨u, w⟩
    dsimp only at hp_lt hp1c hp2c
    rcases hp1c with rfl | rfl <;> rcases hp2c with rfl | rfl <;> first | rfl | omega

lemma adj_mem_pair_of_isPerfectMatching {k : ℕ} {A : Finset (Fin k × Fin k)}
    (hpm : isPerfectMatching A) {p : Fin k × Fin k} (hp : p ∈ A)
    {a b : Fin k} (ha : a = p.1 ∨ a = p.2) (hab : (graphOf A).Adj a b) :
    b = p.1 ∨ b = p.2 := by
  have ha' : p.1 = a ∨ p.2 = a := ha.imp Eq.symm Eq.symm
  rcases hab.2 with h1 | h2
  · have hEq : (a, b) = p := (hpm.2 a).unique ⟨h1, Or.inl rfl⟩ ⟨hp, ha'⟩
    have hb : b = p.2 := congrArg Prod.snd hEq
    exact Or.inr hb
  · have hEq : (b, a) = p := (hpm.2 a).unique ⟨h2, Or.inr rfl⟩ ⟨hp, ha'⟩
    have hb : b = p.1 := congrArg Prod.fst hEq
    exact Or.inl hb

lemma walk_mem_pair_of_isPerfectMatching {k : ℕ} {A : Finset (Fin k × Fin k)}
    (hpm : isPerfectMatching A) {p : Fin k × Fin k} (hp : p ∈ A)
    {a b : Fin k} (w : (graphOf A).Walk a b) (ha : a = p.1 ∨ a = p.2) :
    b = p.1 ∨ b = p.2 := by
  induction w with
  | nil => exact ha
  | @cons u v z huv _ ih => exact ih (adj_mem_pair_of_isPerfectMatching hpm hp ha huv)

lemma compFinset_of_isPerfectMatching {k : ℕ} {A : Finset (Fin k × Fin k)}
    (hpm : isPerfectMatching A) {p : Fin k × Fin k} (hp : p ∈ A) :
    compFinset A ((graphOf A).connectedComponentMk p.1) = {p.1, p.2} := by
  have hlt : p.1 < p.2 := (Finset.mem_filter.mp (hpm.1 hp)).2
  have hadj : (graphOf A).Adj p.1 p.2 := ⟨ne_of_lt hlt, Or.inl hp⟩
  ext x
  rw [mem_compFinset_iff, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · intro hx
    obtain ⟨w⟩ := SimpleGraph.ConnectedComponent.exact hx.symm
    exact walk_mem_pair_of_isPerfectMatching hpm hp w (Or.inl rfl)
  · rintro (rfl | rfl)
    · rfl
    · exact (SimpleGraph.ConnectedComponent.sound hadj.reachable).symm

lemma compCount_eq_card_of_isPerfectMatching {k : ℕ} {A : Finset (Fin k × Fin k)}
    (hpm : isPerfectMatching A) : compCount A = A.card ∧ 2 * A.card = k := by
  let f : {p // p ∈ A} → (graphOf A).ConnectedComponent :=
    fun p => (graphOf A).connectedComponentMk p.1.1
  have hbij : Function.Bijective f := by
    constructor
    · intro p q hpq
      have hq1 : q.1.1 ∈ compFinset A ((graphOf A).connectedComponentMk p.1.1) := by
        rw [mem_compFinset_iff]; exact hpq.symm
      rw [compFinset_of_isPerfectMatching hpm p.2, Finset.mem_insert, Finset.mem_singleton] at hq1
      have hEq : p.1 = q.1 := (hpm.2 q.1.1).unique ⟨p.2, hq1.imp Eq.symm Eq.symm⟩ ⟨q.2, Or.inl rfl⟩
      exact Subtype.ext hEq
    · intro c
      refine SimpleGraph.ConnectedComponent.ind (fun i => ?_) c
      obtain ⟨p, ⟨hpA, hpi⟩, _⟩ := hpm.2 i
      refine ⟨⟨p, hpA⟩, ?_⟩
      rcases hpi with rfl | rfl
      · rfl
      · exact connectedComponentMk_eq_of_mem hpm.1 hpA
  have hcard : compCount A = A.card := by
    simpa [compCount, Fintype.card_coe] using (Fintype.card_of_bijective hbij).symm
  have h2 : 2 * A.card = k := by
    have hsum := sum_compFinset_card A
    have hcomp2 : ∀ c : (graphOf A).ConnectedComponent, (compFinset A c).card = 2 := by
      intro c
      obtain ⟨⟨p, hpA⟩, rfl⟩ := hbij.2 c
      rw [compFinset_of_isPerfectMatching hpm hpA, Finset.card_pair]
      exact ne_of_lt (Finset.mem_filter.mp (hpm.1 hpA)).2
    simp_rw [hcomp2] at hsum
    rw [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_comm] at hsum
    change 2 * compCount A = k at hsum
    rw [hcard] at hsum
    exact hsum
  exact ⟨hcard, h2⟩

lemma valid_iff_of_isPerfectMatching {k n : ℕ} {A : Finset (Fin k × Fin k)}
    (hpm : isPerfectMatching A) (v : Fin k → ZMod n) :
    valid A v ↔ ∀ p ∈ A, v p.1 + v p.2 = 0 := by
  constructor
  · intro hv p hp
    have hne : p.1 ≠ p.2 := ne_of_lt (Finset.mem_filter.mp (hpm.1 hp)).2
    have hc := hv ((graphOf A).connectedComponentMk p.1)
    rw [compFinset_of_isPerfectMatching hpm hp, Finset.sum_pair hne] at hc
    exact hc
  · intro h c
    refine SimpleGraph.ConnectedComponent.ind (fun i => ?_) c
    obtain ⟨p, ⟨hpA, hpi⟩, _⟩ := hpm.2 i
    have hmk : (graphOf A).connectedComponentMk i = (graphOf A).connectedComponentMk p.1 := by
      rcases hpi with rfl | rfl
      · rfl
      · exact (connectedComponentMk_eq_of_mem hpm.1 hpA).symm
    have hne : p.1 ≠ p.2 := ne_of_lt (Finset.mem_filter.mp (hpm.1 hpA)).2
    rw [hmk, compFinset_of_isPerfectMatching hpm hpA, Finset.sum_pair hne]
    exact h p hpA

lemma compCount_union_lt_of_ne {k : ℕ} {A₁ A₂ A₃ : Finset (Fin k × Fin k)}
    (hpm₁ : isPerfectMatching A₁) (hpm₂ : isPerfectMatching A₂) (hpm₃ : isPerfectMatching A₃)
    (hne : ¬ (A₁ = A₂ ∧ A₁ = A₃)) :
    compCount (A₁ ∪ A₂ ∪ A₃) < compCount A₁ := by
  let U := A₁ ∪ A₂ ∪ A₃
  have hA₁U : A₁ ⊆ U := Finset.subset_union_left.trans Finset.subset_union_left
  let π : (graphOf A₁).ConnectedComponent → (graphOf U).ConnectedComponent :=
    SimpleGraph.ConnectedComponent.map (SimpleGraph.Hom.ofLE (graphOf_mono hA₁U))
  have hsurj : Function.Surjective π := by
    intro c
    refine SimpleGraph.ConnectedComponent.ind (fun i => ⟨(graphOf A₁).connectedComponentMk i, rfl⟩) c
  have hle : compCount U ≤ compCount A₁ := Fintype.card_le_of_surjective π hsurj
  have hnotinj : ¬ Function.Injective π := by
    intro hinj
    have hex : ∃ B : Finset (Fin k × Fin k), isPerfectMatching B ∧ B ⊆ U ∧ B ≠ A₁ := by
      by_cases h12 : A₁ = A₂
      · refine ⟨A₃, hpm₃, Finset.subset_union_right, fun h => hne ⟨h12, h.symm⟩⟩
      · refine ⟨A₂, hpm₂, Finset.subset_union_right.trans Finset.subset_union_left, Ne.symm h12⟩
    obtain ⟨B, hpmB, hBU, hBne⟩ := hex
    have hcardEq : B.card = A₁.card := by
      have h1 := (compCount_eq_card_of_isPerfectMatching hpm₁).2
      have h2 := (compCount_eq_card_of_isPerfectMatching hpmB).2
      omega
    have hnotSub : ¬ B ⊆ A₁ := fun hsub =>
      hBne (Finset.eq_of_subset_of_card_le hsub hcardEq.ge)
    obtain ⟨p, hpB, hpNotA₁⟩ := Finset.not_subset.mp hnotSub
    have hpU : p ∈ U := hBU hpB
    have hplt : p.1 < p.2 := (Finset.mem_filter.mp (hpmB.1 hpB)).2
    have hUsub : U ⊆ pairs k := by
      intro x hx
      simp only [U, Finset.mem_union] at hx
      rcases hx with (hx | hx) | hx
      · exact hpm₁.1 hx
      · exact hpm₂.1 hx
      · exact hpm₃.1 hx
    have hπeq : π ((graphOf A₁).connectedComponentMk p.1) =
        π ((graphOf A₁).connectedComponentMk p.2) :=
      connectedComponentMk_eq_of_mem hUsub hpU
    have hmkeq : (graphOf A₁).connectedComponentMk p.1 =
        (graphOf A₁).connectedComponentMk p.2 := hinj hπeq
    obtain ⟨q, ⟨hqA₁, hqp1⟩, _⟩ := hpm₁.2 p.1
    have hqlt : q.1 < q.2 := (Finset.mem_filter.mp (hpm₁.1 hqA₁)).2
    have hmkq : (graphOf A₁).connectedComponentMk p.1 =
        (graphOf A₁).connectedComponentMk q.1 := by
      rcases hqp1 with h1 | h2
      · rw [h1]
      · rw [← h2]; exact (connectedComponentMk_eq_of_mem hpm₁.1 hqA₁).symm
    have hp2mem : p.2 ∈ compFinset A₁ ((graphOf A₁).connectedComponentMk q.1) := by
      rw [mem_compFinset_iff, ← hmkq]; exact hmkeq.symm
    rw [compFinset_of_isPerfectMatching hpm₁ hqA₁, Finset.mem_insert, Finset.mem_singleton] at hp2mem
    rcases p with ⟨p1, p2⟩
    rcases q with ⟨q1, q2⟩
    dsimp only at hplt hqlt hqp1 hp2mem
    have hpeqq : (p1, p2) = (q1, q2) := by
      rcases hqp1 with rfl | rfl <;> rcases hp2mem with rfl | rfl <;> first | rfl | omega
    exact hpNotA₁ (hpeqq ▸ hqA₁)
  refine lt_of_le_of_ne hle fun hEq => hnotinj ?_
  exact ((Fintype.bijective_iff_surjective_and_card π).mpr ⟨hsurj, hEq.symm⟩).1

/-- Counting perfect matchings on `Fin (2 * j)`. -/
lemma card_perfectMatchings_mul (j : ℕ) :
    (perfectMatchings j).card * (2 ^ j * j.factorial) = (2 * j).factorial := by
  induction j with
  | zero =>
    have hpm0 : perfectMatchings 0 = {∅} := by
      ext A
      simp only [perfectMatchings, Finset.mem_filter, Finset.mem_powerset, Finset.mem_singleton]
      constructor
      · intro h
        ext p
        exact Fin.elim0 p.1
      · rintro rfl
        exact ⟨Finset.empty_subset _, Finset.empty_subset _, fun i => Fin.elim0 i⟩
    rw [hpm0]
    norm_num
  | succ j ih =>
    have hstep : (perfectMatchings (j + 1)).card = (2 * j + 1) * (perfectMatchings j).card := by
      let k := 2 * (j + 1)
      let rest (m : Fin (2 * j + 1)) : Finset (Fin k) :=
        ((Finset.univ : Finset (Fin k)).erase 0).erase m.succ
      have hrest_card (m : Fin (2 * j + 1)) : (rest m).card = 2 * j := by
        have h0 : (0 : Fin k) ∈ (Finset.univ : Finset (Fin k)) := Finset.mem_univ 0
        have hm : m.succ ∈ (Finset.univ : Finset (Fin k)).erase 0 :=
          Finset.mem_erase.mpr ⟨Fin.succ_ne_zero m, Finset.mem_univ _⟩
        rw [Finset.card_erase_of_mem hm, Finset.card_erase_of_mem h0, Finset.card_univ,
          Fintype.card_fin]
        omega
      let emb (m : Fin (2 * j + 1)) : Fin (2 * j) ↪o Fin k :=
        (rest m).orderEmbOfFin (hrest_card m)
      let mapEdge (m : Fin (2 * j + 1)) (p : Fin (2 * j) × Fin (2 * j)) : Fin k × Fin k :=
        (emb m p.1, emb m p.2)
      have hmapEdge_inj (m : Fin (2 * j + 1)) : Function.Injective (mapEdge m) := by
        intro p q hpq
        exact Prod.ext ((emb m).injective (congrArg Prod.fst hpq))
          ((emb m).injective (congrArg Prod.snd hpq))
      let lift (m : Fin (2 * j + 1)) (A : Finset (Fin (2 * j) × Fin (2 * j))) :
          Finset (Fin k × Fin k) :=
        insert (0, m.succ) (A.image (mapEdge m))
      have hemb_mem (m : Fin (2 * j + 1)) (x : Fin (2 * j)) :
          emb m x ≠ 0 ∧ emb m x ≠ m.succ := by
        have hmem : emb m x ∈ rest m := Finset.orderEmbOfFin_mem (rest m) (hrest_card m) x
        rw [Finset.mem_erase, Finset.mem_erase] at hmem
        exact ⟨hmem.2.1, hmem.1⟩
      have hzero_not_mem (m : Fin (2 * j + 1)) (A : Finset (Fin (2 * j) × Fin (2 * j))) :
          (0, m.succ) ∉ A.image (mapEdge m) := by
        intro h
        obtain ⟨p, _, hp⟩ := Finset.mem_image.mp h
        exact (hemb_mem m p.1).1 (congrArg Prod.fst hp)
      have hlift_inj (m : Fin (2 * j + 1)) : Function.Injective (lift m) := by
        intro A B hAB
        have hEqImg : A.image (mapEdge m) = B.image (mapEdge m) := by
          have h1 := congrArg (fun S => S.erase (0, m.succ)) hAB
          simpa only [lift, Finset.erase_insert (hzero_not_mem m A),
            Finset.erase_insert (hzero_not_mem m B)] using h1
        ext p
        constructor <;> intro hp
        · have : mapEdge m p ∈ B.image (mapEdge m) := hEqImg ▸ Finset.mem_image_of_mem _ hp
          obtain ⟨q, hq, hqp⟩ := Finset.mem_image.mp this
          exact hmapEdge_inj m hqp ▸ hq
        · have : mapEdge m p ∈ A.image (mapEdge m) := hEqImg.symm ▸ Finset.mem_image_of_mem _ hp
          obtain ⟨q, hq, hqp⟩ := Finset.mem_image.mp this
          exact hmapEdge_inj m hqp ▸ hq
      have hlift_mem (m : Fin (2 * j + 1)) {A : Finset (Fin (2 * j) × Fin (2 * j))}
          (hA : A ∈ perfectMatchings j) : lift m A ∈ perfectMatchings (j + 1) := by
        have hpmA : isPerfectMatching A := (Finset.mem_filter.mp hA).2
        have hsub : lift m A ⊆ pairs k := by
          intro p hp
          rw [Finset.mem_insert] at hp
          rcases hp with rfl | hp
          · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, Fin.succ_pos m⟩
          · obtain ⟨q, hqA, rfl⟩ := Finset.mem_image.mp hp
            have hqlt : q.1 < q.2 := (Finset.mem_filter.mp (hpmA.1 hqA)).2
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (emb m).strictMono hqlt⟩
        refine Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hsub, hsub, fun i => ?_⟩
        by_cases hi0 : i = 0
        · subst hi0
          refine ⟨(0, m.succ), ⟨Finset.mem_insert_self _ _, Or.inl rfl⟩, ?_⟩
          intro p ⟨hp, hp0⟩
          rw [Finset.mem_insert] at hp
          rcases hp with rfl | hp
          · rfl
          · obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp hp
            rcases hp0 with h1 | h2
            · exact absurd h1 (hemb_mem m q.1).1
            · exact absurd h2 (hemb_mem m q.2).1
        · by_cases him : i = m.succ
          · subst him
            refine ⟨(0, m.succ), ⟨Finset.mem_insert_self _ _, Or.inr rfl⟩, ?_⟩
            intro p ⟨hp, hpm'⟩
            rw [Finset.mem_insert] at hp
            rcases hp with rfl | hp
            · rfl
            · obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp hp
              rcases hpm' with h1 | h2
              · exact absurd h1 (hemb_mem m q.1).2
              · exact absurd h2 (hemb_mem m q.2).2
          · have hirest : i ∈ rest m :=
              Finset.mem_erase.mpr ⟨him, Finset.mem_erase.mpr ⟨hi0, Finset.mem_univ i⟩⟩
            have hrange : i ∈ Set.range (emb m) := by
              rw [Finset.range_orderEmbOfFin]
              exact hirest
            obtain ⟨x, rfl⟩ := hrange
            obtain ⟨q, ⟨hqA, hqx⟩, hquniq⟩ := hpmA.2 x
            refine ⟨mapEdge m q, ⟨Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hqA),
              hqx.imp (congrArg (emb m)) (congrArg (emb m))⟩, ?_⟩
            intro p ⟨hp, hpx⟩
            rw [Finset.mem_insert] at hp
            rcases hp with rfl | hp
            · rcases hpx with h1 | h2
              · exact absurd h1.symm (hemb_mem m x).1
              · exact absurd h2.symm (hemb_mem m x).2
            · obtain ⟨r, hrA, rfl⟩ := Finset.mem_image.mp hp
              have hrx : r.1 = x ∨ r.2 = x :=
                hpx.imp (fun h1 => (emb m).injective h1) (fun h2 => (emb m).injective h2)
              rw [hquniq r ⟨hrA, hrx⟩]
      have hunion : perfectMatchings (j + 1) =
          Finset.univ.biUnion fun m : Fin (2 * j + 1) => (perfectMatchings j).image (lift m) := by
        ext B
        rw [Finset.mem_biUnion]
        constructor
        · intro hB
          have hpmB : isPerfectMatching B := (Finset.mem_filter.mp hB).2
          obtain ⟨p₀, ⟨hp₀B, hp₀0⟩, hp₀uniq⟩ := hpmB.2 0
          have hp₀lt : p₀.1 < p₀.2 := (Finset.mem_filter.mp (hpmB.1 hp₀B)).2
          have hp₀1 : p₀.1 = 0 := by
            rcases hp₀0 with h1 | h2
            · exact h1
            · rw [h2] at hp₀lt; exact absurd hp₀lt (Fin.not_lt_zero _)
          have hp₀2_ne : p₀.2 ≠ 0 := by
            intro h; rw [hp₀1, h] at hp₀lt; exact lt_irrefl _ hp₀lt
          let m : Fin (2 * j + 1) := p₀.2.pred hp₀2_ne
          have hm_succ : m.succ = p₀.2 := Fin.succ_pred p₀.2 hp₀2_ne
          have hp₀_eq : p₀ = (0, m.succ) := Prod.ext hp₀1 hm_succ.symm
          rw [hp₀_eq] at hp₀B
          let A : Finset (Fin (2 * j) × Fin (2 * j)) :=
            (pairs (2 * j)).filter fun q => mapEdge m q ∈ B
          have hA_img : lift m A = B := by
            ext p
            rw [Finset.mem_insert, Finset.mem_image]
            constructor
            · rintro (rfl | ⟨q, hqA, rfl⟩)
              · exact hp₀B
              · exact (Finset.mem_filter.mp hqA).2
            · intro hpB
              by_cases hp0 : p = (0, m.succ)
              · exact Or.inl hp0
              · right
                have hp1_ne0 : p.1 ≠ 0 := by
                  intro h; exact hp0 (hp₀_eq ▸ hp₀uniq p ⟨hpB, Or.inl h⟩)
                have hp2_ne0 : p.2 ≠ 0 := by
                  intro h; exact hp0 (hp₀_eq ▸ hp₀uniq p ⟨hpB, Or.inr h⟩)
                have hp1_nem : p.1 ≠ m.succ := by
                  intro h
                  have heq := (hpmB.2 m.succ).unique ⟨hpB, Or.inl h⟩ ⟨hp₀B, Or.inr rfl⟩
                  exact hp0 heq
                have hp2_nem : p.2 ≠ m.succ := by
                  intro h
                  have heq := (hpmB.2 m.succ).unique ⟨hpB, Or.inr h⟩ ⟨hp₀B, Or.inr rfl⟩
                  exact hp0 heq
                have hp1_rest : p.1 ∈ rest m :=
                  Finset.mem_erase.mpr ⟨hp1_nem, Finset.mem_erase.mpr ⟨hp1_ne0, Finset.mem_univ _⟩⟩
                have hp2_rest : p.2 ∈ rest m :=
                  Finset.mem_erase.mpr ⟨hp2_nem, Finset.mem_erase.mpr ⟨hp2_ne0, Finset.mem_univ _⟩⟩
                have hr1 : p.1 ∈ Set.range (emb m) := by
                  rw [Finset.range_orderEmbOfFin]; exact hp1_rest
                have hr2 : p.2 ∈ Set.range (emb m) := by
                  rw [Finset.range_orderEmbOfFin]; exact hp2_rest
                obtain ⟨x, hx⟩ := hr1
                obtain ⟨y, hy⟩ := hr2
                have hplt : p.1 < p.2 := (Finset.mem_filter.mp (hpmB.1 hpB)).2
                have hxylt : x < y := by
                  rw [← hx, ← hy] at hplt
                  exact (emb m).strictMono.lt_iff_lt.mp hplt
                refine ⟨(x, y), Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxylt⟩, ?_⟩, ?_⟩
                · simpa [mapEdge, hx, hy] using hpB
                · exact Prod.ext hx hy
          have hA_pm : A ∈ perfectMatchings j := by
            refine Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (Finset.filter_subset _ _),
              Finset.filter_subset _ _, fun x => ?_⟩
            obtain ⟨p, ⟨hpB, hpx⟩, hpuniq⟩ := hpmB.2 (emb m x)
            have hp_ne : p ≠ (0, m.succ) := by
              rintro rfl
              rcases hpx with h1 | h2
              · exact (hemb_mem m x).1 h1.symm
              · exact (hemb_mem m x).2 h2.symm
            rw [← hA_img, Finset.mem_insert] at hpB
            rcases hpB with rfl | hpImg
            · exact absurd rfl hp_ne
            · obtain ⟨q, hqA, rfl⟩ := Finset.mem_image.mp hpImg
              refine ⟨q, ⟨hqA, hpx.imp (fun h => (emb m).injective h) (fun h => (emb m).injective h)⟩, ?_⟩
              intro r ⟨hrA, hrx⟩
              have hmapEq : mapEdge m r = mapEdge m q :=
                hpuniq (mapEdge m r) ⟨(Finset.mem_filter.mp hrA).2,
                  hrx.imp (congrArg (emb m)) (congrArg (emb m))⟩
              exact hmapEdge_inj m hmapEq
          exact ⟨m, Finset.mem_univ m, Finset.mem_image.mpr ⟨A, hA_pm, hA_img⟩⟩
        · rintro ⟨m, _, hBm⟩
          obtain ⟨A, hA, rfl⟩ := Finset.mem_image.mp hBm
          exact hlift_mem m hA
      have hdisj : Set.PairwiseDisjoint (Finset.univ : Finset (Fin (2 * j + 1)))
          (fun m => (perfectMatchings j).image (lift m)) := by
        intro m₁ _ m₂ _ hne
        change Disjoint _ _
        rw [Finset.disjoint_left]
        intro B hB₁ hB₂
        obtain ⟨A₁, _, rfl⟩ := Finset.mem_image.mp hB₁
        obtain ⟨A₂, _, hEq⟩ := Finset.mem_image.mp hB₂
        have hmem : (0, m₁.succ) ∈ lift m₂ A₂ := hEq ▸ Finset.mem_insert_self _ _
        rw [Finset.mem_insert] at hmem
        rcases hmem with hpair | hImg
        · exact hne (Fin.succ_injective _ (congrArg Prod.snd hpair))
        · obtain ⟨q, _, hq⟩ := Finset.mem_image.mp hImg
          exact (hemb_mem m₂ q.1).1 (congrArg Prod.fst hq)
      rw [hunion, Finset.card_biUnion hdisj]
      simp_rw [Finset.card_image_of_injective _ (hlift_inj _)]
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    rw [hstep]
    have hfac : (2 * (j + 1)).factorial = (2 * j + 2) * ((2 * j + 1) * (2 * j).factorial) := by
      have h1 : 2 * (j + 1) = (2 * j + 1) + 1 := by omega
      rw [h1, Nat.factorial_succ, Nat.factorial_succ]
    rw [hfac, ← ih, pow_succ, Nat.factorial_succ]
    ring

end Combinatorics

section FourierReduction

/-- The main Fourier coefficient from `R2`. -/
noncomputable def coeff (n : ℕ) [NeZero n] (ξ : Fin n → ZMod n) : ℂ :=
  ∑ π : Fin n ≃ ZMod n, ∏ i, ZMod.stdAddChar (ξ i * π i)

/-- The injective Fourier sum on `k` coordinates. -/
noncomputable def injSum (n k : ℕ) [NeZero n] (v : Fin k → ZMod n) : ℂ :=
  ∑ φ : Fin k ↪ ZMod n, ∏ j : Fin k, ZMod.stdAddChar (v j * φ j)

/-- The real inclusion-exclusion formula for `injSum`. -/
noncomputable def injSumReal (n k : ℕ) (v : Fin k → ZMod n) : ℝ :=
  ∑ A ∈ (pairs k).powerset,
    (-1 : ℝ) ^ A.card * if valid A v then (n : ℝ) ^ compCount A else 0

lemma stdAddChar_sum {n : ℕ} [NeZero n] {ι : Type*} (s : Finset ι) (f : ι → ZMod n) :
    ZMod.stdAddChar (∑ i ∈ s, f i) = ∏ i ∈ s, ZMod.stdAddChar (f i) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.prod_insert ha, AddChar.map_add_eq_mul, ih]

lemma sum_zmod_eq_zero_of_odd {n : ℕ} [NeZero n] (hn : Odd n) :
    (∑ x : ZMod n, x) = 0 := by
  obtain ⟨m, rfl⟩ := hn
  have hneg : (∑ x : ZMod (2 * m + 1), x) = ∑ x : ZMod (2 * m + 1), (-x) :=
    (Fintype.sum_equiv (Equiv.neg (ZMod (2 * m + 1))) (fun x => -x) (fun x => x)
      (fun _ => rfl)).symm
  have h2 : (2 : ZMod (2 * m + 1)) * (∑ x : ZMod (2 * m + 1), x) = 0 := by
    calc
      (2 : ZMod (2 * m + 1)) * (∑ x : ZMod (2 * m + 1), x)
          = (∑ x : ZMod (2 * m + 1), x) + (∑ x : ZMod (2 * m + 1), x) := two_mul _
      _ = (∑ x : ZMod (2 * m + 1), x) + (∑ x : ZMod (2 * m + 1), (-x)) := by rw [← hneg]
      _ = ∑ x : ZMod (2 * m + 1), (x + (-x)) := (Finset.sum_add_distrib).symm
      _ = 0 := by simp
  have hinv : ((m + 1 : ℕ) : ZMod (2 * m + 1)) * (2 : ZMod (2 * m + 1)) = 1 := by
    calc
      ((m + 1 : ℕ) : ZMod (2 * m + 1)) * (2 : ZMod (2 * m + 1))
          = (((m + 1) * 2 : ℕ) : ZMod (2 * m + 1)) := by push_cast; rfl
      _ = (((2 * m + 1) + 1 : ℕ) : ZMod (2 * m + 1)) := by
            rw [show (m + 1) * 2 = (2 * m + 1) + 1 by omega]
      _ = ((2 * m + 1 : ℕ) : ZMod (2 * m + 1)) + 1 := by push_cast; rfl
      _ = 1 := by rw [ZMod.natCast_self, zero_add]
  calc
    ∑ x : ZMod (2 * m + 1), x = 1 * ∑ x : ZMod (2 * m + 1), x := (one_mul _).symm
    _ = (((m + 1 : ℕ) : ZMod (2 * m + 1)) * 2) * ∑ x : ZMod (2 * m + 1), x := by rw [hinv]
    _ = ((m + 1 : ℕ) : ZMod (2 * m + 1)) * (2 * ∑ x : ZMod (2 * m + 1), x) := by ring
    _ = 0 := by rw [h2, mul_zero]

lemma coeff_add_const {n : ℕ} [NeZero n] (hn : Odd n) (a : ZMod n) (η : Fin n → ZMod n) :
    coeff n (fun i => a + η i) = coeff n η := by
  unfold coeff
  refine Finset.sum_congr rfl fun π _ => ?_
  have hmul : ∀ i : Fin n, ZMod.stdAddChar ((a + η i) * π i) =
      ZMod.stdAddChar (a * π i) * ZMod.stdAddChar (η i * π i) := by
    intro i
    rw [add_mul, AddChar.map_add_eq_mul]
  simp_rw [hmul, Finset.prod_mul_distrib]
  have hconst : ∏ i : Fin n, ZMod.stdAddChar (a * π i) = 1 := by
    rw [← stdAddChar_sum, ← Finset.mul_sum]
    have hsumπ : (∑ i : Fin n, π i) = ∑ x : ZMod n, x :=
      Fintype.sum_equiv π _ _ (fun _ => rfl)
    rw [hsumπ, sum_zmod_eq_zero_of_odd hn, mul_zero, AddChar.map_zero_eq_one]
  rw [hconst, one_mul]

lemma majority_unique {n M : ℕ} (hMn : 4 * M < n) {ξ : Fin n → ZMod n} {a b : ZMod n}
    (ha : (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M)
    (hb : (Finset.univ.filter fun i => ξ i ≠ b).card ≤ 2 * M) : a = b := by
  by_contra hab
  have hcov : (Finset.univ : Finset (Fin n)) ⊆
      (Finset.univ.filter fun i => ξ i ≠ a) ∪ (Finset.univ.filter fun i => ξ i ≠ b) := by
    intro i _
    rw [Finset.mem_union, Finset.mem_filter, Finset.mem_filter]
    by_cases h : ξ i = a
    · right; exact ⟨Finset.mem_univ i, fun h2 => hab (h.symm.trans h2)⟩
    · left; exact ⟨Finset.mem_univ i, h⟩
  have hcard : n ≤ (Finset.univ.filter fun i => ξ i ≠ a).card +
      (Finset.univ.filter fun i => ξ i ≠ b).card := by
    calc
      n = (Finset.univ : Finset (Fin n)).card := by simp
      _ ≤ ((Finset.univ.filter fun i => ξ i ≠ a) ∪ (Finset.univ.filter fun i => ξ i ≠ b)).card :=
        Finset.card_le_card hcov
      _ ≤ _ := Finset.card_union_le _ _
  omega

lemma major_arc_sum_reduce {n M : ℕ} [NeZero n] (hn : Odd n) (hMn : 4 * M < n) :
    (∑ ξ : Fin n → ZMod n,
      if ∃ a : ZMod n, (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M then
        (coeff n ξ ^ 2 * coeff n (-ξ)).re / (n.factorial : ℝ) ^ 3
      else 0) / (n : ℝ) =
    ∑ η : Fin n → ZMod n,
      if (Finset.univ.filter fun i => η i ≠ 0).card ≤ 2 * M then
        (coeff n η ^ 2 * coeff n (-η)).re / (n.factorial : ℝ) ^ 3
      else 0 := by
  let W : (Fin n → ZMod n) → ℝ :=
    fun ξ => (coeff n ξ ^ 2 * coeff n (-ξ)).re / (n.factorial : ℝ) ^ 3
  have hWshift : ∀ (a : ZMod n) (η : Fin n → ZMod n), W (fun i => a + η i) = W η := by
    intro a η
    dsimp [W]
    have h1 := coeff_add_const hn a η
    have h2 : -(fun i => a + η i) = fun i => (-a) + (-η) i := by
      funext i; simp [Pi.neg_apply]; ring
    rw [h1, h2, coeff_add_const hn (-a) (-η)]
  have hinner : ∀ ξ : Fin n → ZMod n,
      (if ∃ a : ZMod n, (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M then W ξ else 0) =
      ∑ a : ZMod n, if (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M then W ξ else 0 := by
    intro ξ
    by_cases hex : ∃ a : ZMod n, (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M
    · obtain ⟨a₀, ha₀⟩ := hex
      rw [if_pos ⟨a₀, ha₀⟩, Finset.sum_eq_single a₀]
      · rw [if_pos ha₀]
      · intro b _ hba
        rw [if_neg]
        intro hb
        exact hba (majority_unique hMn hb ha₀)
      · intro h; exact absurd (Finset.mem_univ a₀) h
    · rw [if_neg hex]
      symm
      refine Finset.sum_eq_zero fun a _ => if_neg fun ha => hex ⟨a, ha⟩
  change (∑ ξ : Fin n → ZMod n,
    if ∃ a : ZMod n, (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M then W ξ else 0) / (n : ℝ) =
    ∑ η : Fin n → ZMod n,
      if (Finset.univ.filter fun i => η i ≠ 0).card ≤ 2 * M then W η else 0
  simp_rw [hinner]
  rw [Finset.sum_comm]
  have hconst_a : ∀ a : ZMod n,
      (∑ ξ : Fin n → ZMod n,
        if (Finset.univ.filter fun i => ξ i ≠ a).card ≤ 2 * M then W ξ else 0) =
      ∑ η : Fin n → ZMod n,
        if (Finset.univ.filter fun i => η i ≠ 0).card ≤ 2 * M then W η else 0 := by
    intro a
    refine (Fintype.sum_equiv (Equiv.addLeft (fun _ : Fin n => a)) _ _ fun η => ?_).symm
    have hfilt : (Finset.univ.filter fun i => a + η i ≠ a) =
        Finset.univ.filter fun i => η i ≠ 0 := by
      ext i
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, ne_eq, add_eq_left]
    have hEqFun : (Equiv.addLeft (fun _ : Fin n => a)) η = fun i => a + η i := rfl
    rw [hEqFun, hWshift a η, hfilt]
  simp_rw [hconst_a, Finset.sum_const, Finset.card_univ, ZMod.card, nsmul_eq_mul]
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne n
  field_simp [hn0]

/-- Extension count of an embedding `φ : Fin k ↪ ZMod n` to bijections `Fin n ≃ ZMod n`
matching on a fixed embedding `e : Fin k ↪ Fin n`. -/
lemma card_bijections_extending {n k : ℕ} [NeZero n] (e : Fin k ↪ Fin n) (φ : Fin k ↪ ZMod n) :
    (Finset.univ.filter fun π : Fin n ≃ ZMod n => e.trans π.toEmbedding = φ).card =
      (n - k).factorial := by
  let S : Finset (Fin n) := Finset.univ.map e
  let T : Finset (ZMod n) := Finset.univ.map φ
  have hS : S.card = k := by simp [S]
  have hT : T.card = k := by simp [T]
  let α := {i : Fin n // i ∉ S}
  let β := {x : ZMod n // x ∉ T}
  have hα : Fintype.card α = n - k := by
    have h1 : Fintype.card α = (Finset.univ \ S).card := by
      rw [Fintype.card_subtype]
      congr 1; ext i; simp
    rw [h1, Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin, hS]
  have hβ : Fintype.card β = n - k := by
    have h1 : Fintype.card β = (Finset.univ \ T).card := by
      rw [Fintype.card_subtype]
      congr 1; ext x; simp
    rw [h1, Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, ZMod.card, hT]
  let F := {π : Fin n ≃ ZMod n // e.trans π.toEmbedding = φ}
  have hcardF : (Finset.univ.filter fun π : Fin n ≃ ZMod n => e.trans π.toEmbedding = φ).card =
      Fintype.card F := by
    rw [Fintype.card_subtype]
  rw [hcardF]
  let toFun : F → (α ≃ β) := fun ⟨π, hπ⟩ =>
    { toFun := fun ⟨i, hi⟩ => ⟨π i, by
        intro hmem
        obtain ⟨j, _, hj⟩ := Finset.mem_map.mp hmem
        have hπe : π (e j) = φ j := DFunLike.congr_fun hπ j
        have hie : i = e j := π.injective (hj.symm.trans hπe.symm)
        exact hi (hie ▸ Finset.mem_map.mpr ⟨j, Finset.mem_univ j, rfl⟩)⟩
      invFun := fun ⟨x, hx⟩ => ⟨π.symm x, by
        intro hmem
        obtain ⟨j, _, hj⟩ := Finset.mem_map.mp hmem
        have hπe : π (e j) = φ j := DFunLike.congr_fun hπ j
        have hxeq : x = φ j := by
          calc x = π (π.symm x) := (π.apply_symm_apply x).symm
            _ = π (e j) := congrArg π hj.symm
            _ = φ j := hπe
        exact hx (hxeq ▸ Finset.mem_map.mpr ⟨j, Finset.mem_univ j, rfl⟩)⟩
      left_inv := fun ⟨i, _⟩ => Subtype.ext (π.symm_apply_apply i)
      right_inv := fun ⟨x, _⟩ => Subtype.ext (π.apply_symm_apply x) }
  let invFun : (α ≃ β) → F := fun σ =>
    let f : Fin n → ZMod n := fun i =>
      if hi : i ∈ S then φ (Classical.choose (Finset.mem_map.mp hi))
      else (σ ⟨i, hi⟩).1
    let g : ZMod n → Fin n := fun x =>
      if hx : x ∈ T then e (Classical.choose (Finset.mem_map.mp hx))
      else (σ.symm ⟨x, hx⟩).1
    have hfe : ∀ j : Fin k, f (e j) = φ j := by
      intro j
      have hjS : e j ∈ S := Finset.mem_map.mpr ⟨j, Finset.mem_univ j, rfl⟩
      simp only [f, dif_pos hjS]
      have hch := (Classical.choose_spec (Finset.mem_map.mp hjS)).2
      exact congrArg φ (e.injective hch)
    have hgφ : ∀ j : Fin k, g (φ j) = e j := by
      intro j
      have hjT : φ j ∈ T := Finset.mem_map.mpr ⟨j, Finset.mem_univ j, rfl⟩
      simp only [g, dif_pos hjT]
      have hch := (Classical.choose_spec (Finset.mem_map.mp hjT)).2
      exact congrArg e (φ.injective hch)
    have hgf : ∀ i : Fin n, g (f i) = i := by
      intro i
      by_cases hi : i ∈ S
      · obtain ⟨j, _, rfl⟩ := Finset.mem_map.mp hi
        rw [hfe j, hgφ j]
      · simp only [f, dif_neg hi, g, dif_neg (σ ⟨i, hi⟩).2]
        exact congrArg Subtype.val (σ.symm_apply_apply ⟨i, hi⟩)
    have hfg : ∀ x : ZMod n, f (g x) = x := by
      intro x
      by_cases hx : x ∈ T
      · obtain ⟨j, _, rfl⟩ := Finset.mem_map.mp hx
        rw [hgφ j, hfe j]
      · simp only [g, dif_neg hx, f, dif_neg (σ.symm ⟨x, hx⟩).2]
        exact congrArg Subtype.val (σ.apply_symm_apply ⟨x, hx⟩)
    ⟨⟨f, g, hgf, hfg⟩, by ext j; exact hfe j⟩
  have hEquiv : F ≃ (α ≃ β) :=
    { toFun := toFun
      invFun := invFun
      left_inv := fun ⟨π, hπ⟩ => by
        apply Subtype.ext
        ext i
        change (if hi : i ∈ S then φ (Classical.choose (Finset.mem_map.mp hi))
          else (toFun ⟨π, hπ⟩ ⟨i, hi⟩).1) = π i
        by_cases hi : i ∈ S
        · rw [dif_pos hi]
          have hch := (Classical.choose_spec (Finset.mem_map.mp hi)).2
          exact (DFunLike.congr_fun hπ _).symm.trans (congrArg π hch)
        · rw [dif_neg hi]
          rfl
      right_inv := fun σ => by
        ext ⟨i, hi⟩
        change (if hi' : i ∈ S then φ (Classical.choose (Finset.mem_map.mp hi'))
          else (σ ⟨i, hi'⟩).1) = (σ ⟨i, hi⟩).1
        rw [dif_neg hi] }
  rw [Fintype.card_congr hEquiv]
  obtain ⟨eαβ⟩ := Fintype.truncEquivOfCardEq (hα.trans hβ.symm)
  rw [Fintype.card_congr (Equiv.equivCongr (Equiv.refl α) eαβ.symm), Fintype.card_perm, hα]

lemma coeff_eq_factorial_mul_injSum {n k : ℕ} [NeZero n] (e : Fin k ↪ Fin n)
    (η : Fin n → ZMod n) (hsupp : ∀ i : Fin n, η i ≠ 0 → i ∈ Finset.univ.map e) :
    coeff n η = ((n - k).factorial : ℂ) * injSum n k (fun j => η (e j)) := by
  unfold coeff injSum
  have hprod : ∀ π : Fin n ≃ ZMod n,
      (∏ i : Fin n, ZMod.stdAddChar (η i * π i)) =
      ∏ j : Fin k, ZMod.stdAddChar (η (e j) * π (e j)) := by
    intro π
    calc
      ∏ i : Fin n, ZMod.stdAddChar (η i * π i)
          = ∏ i ∈ Finset.univ.map e, ZMod.stdAddChar (η i * π i) := by
            symm
            refine Finset.prod_subset (Finset.subset_univ _) fun i _ hi => ?_
            have h0 : η i = 0 := by
              by_contra hne
              exact hi (hsupp i hne)
            simp [h0]
      _ = ∏ j : Fin k, ZMod.stdAddChar (η (e j) * π (e j)) := by
            rw [Finset.prod_map]
  simp_rw [hprod]
  rw [← Finset.sum_fiberwise_of_maps_to
    (g := fun π : Fin n ≃ ZMod n => e.trans π.toEmbedding)
    (t := (Finset.univ : Finset (Fin k ↪ ZMod n)))
    (fun _ _ => Finset.mem_univ _)]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun φ _ => ?_
  have hconst : ∀ π ∈ Finset.univ.filter (fun π : Fin n ≃ ZMod n => e.trans π.toEmbedding = φ),
      (∏ j : Fin k, ZMod.stdAddChar (η (e j) * π (e j))) =
      ∏ j : Fin k, ZMod.stdAddChar (η (e j) * φ j) := by
    intro π hπ
    have hEq := (Finset.mem_filter.mp hπ).2
    refine Finset.prod_congr rfl fun j _ => ?_
    have hj : π (e j) = φ j := DFunLike.congr_fun hEq j
    rw [hj]
  rw [Finset.sum_congr rfl hconst, Finset.sum_const, nsmul_eq_mul, card_bijections_extending e φ]

lemma injSum_eq_injSumReal {n k : ℕ} [NeZero n] (v : Fin k → ZMod n) :
    injSum n k v = (injSumReal n k v : ℂ) := by
  unfold injSum injSumReal
  let phase (ψ : Fin k → ZMod n) : ℂ := ∏ j : Fin k, ZMod.stdAddChar (v j * ψ j)
  have hinj_sum : (∑ φ : Fin k ↪ ZMod n, phase φ) =
      ∑ ψ : Fin k → ZMod n, (if Function.Injective ψ then (1 : ℂ) else 0) * phase ψ := by
    simp_rw [ite_mul, one_mul, zero_mul]
    rw [← Finset.sum_filter]
    symm
    refine Finset.sum_bij (fun (ψ : Fin k → ZMod n) hψ =>
      (⟨ψ, (Finset.mem_filter.mp hψ).2⟩ : Fin k ↪ ZMod n)) ?_ ?_ ?_ ?_
    · intro _ _; exact Finset.mem_univ _
    · intro ψ₁ _ ψ₂ _ h; exact congrArg DFunLike.coe h
    · intro φ _; exact ⟨φ, Finset.mem_filter.mpr ⟨Finset.mem_univ _, φ.injective⟩, rfl⟩
    · intro ψ _; rfl
  change (∑ φ : Fin k ↪ ZMod n, phase φ) = _
  rw [hinj_sum]
  have hind : ∀ ψ : Fin k → ZMod n,
      (if Function.Injective ψ then (1 : ℂ) else 0) =
      ∑ A ∈ (pairs k).powerset,
        (-1 : ℂ) ^ A.card * if ∀ p ∈ A, ψ p.1 = ψ p.2 then (1 : ℂ) else 0 := by
    intro ψ
    have hiff : Function.Injective ψ ↔ ∀ p ∈ pairs k, ψ p.1 ≠ ψ p.2 := by
      constructor
      · intro hinj p hp hEq
        exact ne_of_lt (Finset.mem_filter.mp hp).2 (hinj hEq)
      · intro h i j hEq
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · exact h (i, j) (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hlt⟩) hEq
        · exact h (j, i) (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hgt⟩) hEq.symm
    have hprod_eq : (if Function.Injective ψ then (1 : ℂ) else 0) =
        ∏ p ∈ pairs k, (1 + if ψ p.1 = ψ p.2 then (-1 : ℂ) else 0) := by
      by_cases hinj : Function.Injective ψ
      · rw [if_pos hinj]
        symm
        refine Finset.prod_eq_one fun p hp => ?_
        rw [if_neg (hiff.mp hinj p hp), add_zero]
      · rw [if_neg hinj]
        have hex : ∃ p ∈ pairs k, ψ p.1 = ψ p.2 := by
          by_contra hall
          push Not at hall
          exact hinj (hiff.mpr hall)
        obtain ⟨p, hp, hpeq⟩ := hex
        symm
        exact Finset.prod_eq_zero hp (by rw [if_pos hpeq]; ring)
    rw [hprod_eq, Finset.prod_one_add]
    refine Finset.sum_congr rfl fun A _ => ?_
    by_cases hA : ∀ p ∈ A, ψ p.1 = ψ p.2
    · rw [if_pos hA, mul_one]
      have hterm : ∀ p ∈ A, (if ψ p.1 = ψ p.2 then (-1 : ℂ) else 0) = -1 :=
        fun p hp => if_pos (hA p hp)
      rw [Finset.prod_congr rfl hterm, Finset.prod_const]
    · rw [if_neg hA, mul_zero]
      push Not at hA
      obtain ⟨p, hp, hpne⟩ := hA
      exact Finset.prod_eq_zero hp (if_neg hpne)
  simp_rw [hind, Finset.sum_mul]
  rw [Finset.sum_comm]
  push_cast
  refine Finset.sum_congr rfl fun A hA => ?_
  have hAsub : A ⊆ pairs k := Finset.mem_powerset.mp hA
  simp_rw [mul_assoc, ← Finset.mul_sum]
  congr 1
  simp_rw [ite_mul, one_mul, zero_mul]
  rw [← Finset.sum_filter]
  have hsum_comp :
      (∑ ψ ∈ Finset.univ.filter (fun ψ : Fin k → ZMod n => ∀ p ∈ A, ψ p.1 = ψ p.2),
        phase ψ) =
      ∑ f : (graphOf A).ConnectedComponent → ZMod n,
        ∏ c : (graphOf A).ConnectedComponent,
          ZMod.stdAddChar ((∑ i ∈ compFinset A c, v i) * f c) := by
    refine Finset.sum_bij
      (fun ψ hψ c => ψ (compFinset_nonempty A c).choose)
      (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
    · intro ψ₁ hψ₁ ψ₂ hψ₂ hEq
      have hp₁ := (Finset.mem_filter.mp hψ₁).2
      have hp₂ := (Finset.mem_filter.mp hψ₂).2
      funext i
      let c := (graphOf A).connectedComponentMk i
      let r := (compFinset_nonempty A c).choose
      have hr : (graphOf A).connectedComponentMk r = c :=
        (mem_compFinset_iff A c r).mp (compFinset_nonempty A c).choose_spec
      have hreach : (graphOf A).Reachable i r := SimpleGraph.ConnectedComponent.exact hr.symm
      calc
        ψ₁ i = ψ₁ r := eq_on_component_of_edges hp₁ hreach
        _ = ψ₂ r := congrFun hEq c
        _ = ψ₂ i := (eq_on_component_of_edges hp₂ hreach).symm
    · intro f _
      refine ⟨fun i => f ((graphOf A).connectedComponentMk i),
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun p hp => ?_⟩, ?_⟩
      · dsimp only
        rw [connectedComponentMk_eq_of_mem hAsub hp]
      · funext c
        dsimp only
        have hr : (graphOf A).connectedComponentMk (compFinset_nonempty A c).choose = c :=
          (mem_compFinset_iff A c _).mp (compFinset_nonempty A c).choose_spec
        rw [hr]
    · intro ψ hψ
      have hp := (Finset.mem_filter.mp hψ).2
      dsimp only [phase]
      rw [← Finset.prod_fiberwise_of_maps_to
        (g := (graphOf A).connectedComponentMk)
        (t := (Finset.univ : Finset (graphOf A).ConnectedComponent))
        (fun _ _ => Finset.mem_univ _)]
      refine Finset.prod_congr rfl fun c _ => ?_
      change (∏ i ∈ compFinset A c, ZMod.stdAddChar (v i * ψ i)) = _
      have hψc : ∀ i ∈ compFinset A c, ψ i = ψ (compFinset_nonempty A c).choose := by
        intro i hi
        have hi_mk : (graphOf A).connectedComponentMk i = c := (mem_compFinset_iff A c i).mp hi
        have hr_mk : (graphOf A).connectedComponentMk (compFinset_nonempty A c).choose = c :=
          (mem_compFinset_iff A c _).mp (compFinset_nonempty A c).choose_spec
        exact eq_on_component_of_edges hp
          (SimpleGraph.ConnectedComponent.exact (hi_mk.trans hr_mk.symm))
      have hrew : (∏ i ∈ compFinset A c, ZMod.stdAddChar (v i * ψ i)) =
          ∏ i ∈ compFinset A c,
            ZMod.stdAddChar (v i * ψ (compFinset_nonempty A c).choose) :=
        Finset.prod_congr rfl fun i hi => by rw [hψc i hi]
      rw [hrew, ← stdAddChar_sum, ← Finset.sum_mul]
  rw [hsum_comp]
  rw [← Fintype.prod_sum
    (fun (c : (graphOf A).ConnectedComponent) (a : ZMod n) =>
      ZMod.stdAddChar ((∑ i ∈ compFinset A c, v i) * a))]
  have horth : ∀ c : (graphOf A).ConnectedComponent,
      (∑ a : ZMod n, ZMod.stdAddChar ((∑ i ∈ compFinset A c, v i) * a)) =
      if (∑ i ∈ compFinset A c, v i) = 0 then (n : ℂ) else 0 := by
    intro c
    have hsc := OMA.R_Green97_green_97_variants_eberhard_manners_mrazovic_R2.scalar_orthogonality
      (n := n) (∑ i ∈ compFinset A c, v i)
    simpa only [mul_comm] using hsc
  simp_rw [horth]
  by_cases hv : valid A v
  · rw [if_pos hv]
    have hprod_n : (∏ c : (graphOf A).ConnectedComponent,
        if (∑ i ∈ compFinset A c, v i) = 0 then (n : ℂ) else 0) =
        ∏ _c : (graphOf A).ConnectedComponent, (n : ℂ) :=
      Finset.prod_congr rfl fun c _ => if_pos (hv c)
    rw [hprod_n, Finset.prod_const, Finset.card_univ]
    push_cast
    rfl
  · rw [if_neg hv]
    unfold valid at hv
    push Not at hv
    obtain ⟨c, hc⟩ := hv
    exact Finset.prod_eq_zero (Finset.mem_univ c) (if_neg hc)

lemma valid_neg_iff {k n : ℕ} (A : Finset (Fin k × Fin k)) (v : Fin k → ZMod n) :
    valid A (-v) ↔ valid A v := by
  unfold valid
  refine forall_congr' fun c => ?_
  simp only [Pi.neg_apply, Finset.sum_neg_distrib, neg_eq_zero]

lemma injSumReal_neg {n k : ℕ} (v : Fin k → ZMod n) :
    injSumReal n k (-v) = injSumReal n k v := by
  unfold injSumReal
  refine Finset.sum_congr rfl fun A _ => ?_
  simp_rw [valid_neg_iff]

lemma group_by_support {n M : ℕ} [NeZero n] (hMn : 2 * M ≤ n) :
    (∑ η : Fin n → ZMod n,
      if (Finset.univ.filter fun i => η i ≠ 0).card ≤ 2 * M then
        (coeff n η ^ 2 * coeff n (-η)).re / (n.factorial : ℝ) ^ 3
      else 0) =
    ∑ k ∈ Finset.range (2 * M + 1),
      (1 / (k.factorial : ℝ)) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
        ∑ v : Fin k → {x : ZMod n // x ≠ 0},
          (injSumReal n k (fun j => (v j).1)) ^ 3 := by
  let W : (Fin n → ZMod n) → ℝ :=
    fun η => (coeff n η ^ 2 * coeff n (-η)).re / (n.factorial : ℝ) ^ 3
  let supp (η : Fin n → ZMod n) : Finset (Fin n) := Finset.univ.filter fun i => η i ≠ 0
  have h1 : (∑ η : Fin n → ZMod n, if (supp η).card ≤ 2 * M then W η else 0) =
      ∑ k ∈ Finset.range (2 * M + 1),
        ∑ S ∈ (Finset.univ : Finset (Fin n)).powersetCard k,
          ∑ η ∈ Finset.univ.filter (fun η : Fin n → ZMod n => supp η = S), W η := by
    rw [← Finset.sum_filter]
    rw [← Finset.sum_fiberwise_of_maps_to
      (g := fun η : Fin n → ZMod n => (supp η).card)
      (t := Finset.range (2 * M + 1))
      (fun η hη => Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.mem_filter.mp hη).2))]
    refine Finset.sum_congr rfl fun k hk => ?_
    have hk_le : k ≤ 2 * M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    have hfilt_eq : (Finset.univ.filter (fun η : Fin n → ZMod n => (supp η).card ≤ 2 * M)).filter
        (fun η => (supp η).card = k) =
        Finset.univ.filter (fun η : Fin n → ZMod n => (supp η).card = k) := by
      ext η
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_iff_right_iff_imp]
      intro h; omega
    rw [hfilt_eq]
    rw [← Finset.sum_fiberwise_of_maps_to
      (g := supp)
      (t := (Finset.univ : Finset (Fin n)).powersetCard k)
      (fun η hη => Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, (Finset.mem_filter.mp hη).2⟩)]
    refine Finset.sum_congr rfl fun S hS => ?_
    congr 1
    ext η
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_iff_right_iff_imp]
    intro hEq
    rw [hEq]
    exact (Finset.mem_powersetCard.mp hS).2
  change (∑ η : Fin n → ZMod n, if (supp η).card ≤ 2 * M then W η else 0) = _
  rw [h1]
  refine Finset.sum_congr rfl fun k hk => ?_
  have hk_le : k ≤ n := le_trans (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)) hMn
  have hS_eq : ∀ S ∈ (Finset.univ : Finset (Fin n)).powersetCard k,
      (∑ η ∈ Finset.univ.filter (fun η : Fin n → ZMod n => supp η = S), W η) =
      (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 3 *
        ∑ v : Fin k → {x : ZMod n // x ≠ 0}, (injSumReal n k (fun j => (v j).1)) ^ 3 := by
    intro S hS
    have hScard : S.card = k := (Finset.mem_powersetCard.mp hS).2
    let e : Fin k ↪ Fin n := (S.orderEmbOfFin hScard).toEmbedding
    have hmap : Finset.univ.map e = S := by
      ext i
      rw [Finset.mem_map]
      constructor
      · rintro ⟨j, _, rfl⟩
        exact Finset.orderEmbOfFin_mem S hScard j
      · intro hi
        have hr : i ∈ Set.range (S.orderEmbOfFin hScard) := by
          rw [Finset.range_orderEmbOfFin]; exact hi
        obtain ⟨j, hj⟩ := hr
        exact ⟨j, Finset.mem_univ j, hj⟩
    rw [Finset.mul_sum]
    refine Finset.sum_bij
      (fun η hη j => ⟨η (e j), by
        have hmem : e j ∈ supp η := by
          rw [(Finset.mem_filter.mp hη).2, ← hmap]
          exact Finset.mem_map.mpr ⟨j, Finset.mem_univ j, rfl⟩
        exact (Finset.mem_filter.mp hmem).2⟩)
      (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
    · intro η₁ hη₁ η₂ hη₂ hEq
      have hS₁ : supp η₁ = S := (Finset.mem_filter.mp hη₁).2
      have hS₂ : supp η₂ = S := (Finset.mem_filter.mp hη₂).2
      funext i
      by_cases hi : i ∈ S
      · rw [← hmap, Finset.mem_map] at hi
        obtain ⟨j, _, rfl⟩ := hi
        exact congrArg Subtype.val (congrFun hEq j)
      · have h10 : η₁ i = 0 := by
          by_contra hne
          exact hi (hS₁ ▸ Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
        have h20 : η₂ i = 0 := by
          by_contra hne
          exact hi (hS₂ ▸ Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
        rw [h10, h20]
    · intro v _
      let η : Fin n → ZMod n := fun i =>
        if hi : i ∈ Finset.univ.map e then (v (Classical.choose (Finset.mem_map.mp hi))).1 else 0
      have hηe : ∀ j : Fin k, η (e j) = (v j).1 := by
        intro j
        have hj : e j ∈ Finset.univ.map e := Finset.mem_map.mpr ⟨j, Finset.mem_univ j, rfl⟩
        simp only [η, dif_pos hj]
        have hch := (Classical.choose_spec (Finset.mem_map.mp hj)).2
        rw [e.injective hch]
      have hηsupp : supp η = S := by
        ext i
        rw [← hmap]
        simp only [supp, Finset.mem_filter, Finset.mem_univ, true_and]
        constructor
        · intro hne
          by_contra hi
          simp only [η, dif_neg hi] at hne
          exact hne rfl
        · intro hi
          obtain ⟨j, _, rfl⟩ := Finset.mem_map.mp hi
          rw [hηe j]
          exact (v j).2
      refine ⟨η, Finset.mem_filter.mpr ⟨Finset.mem_univ η, hηsupp⟩, ?_⟩
      funext j
      exact Subtype.ext (hηe j)
    · intro η hη
      have hsuppη : supp η = S := (Finset.mem_filter.mp hη).2
      have hsupp1 : ∀ i : Fin n, η i ≠ 0 → i ∈ Finset.univ.map e := by
        intro i hi
        rw [hmap, ← hsuppη]
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
      have hsupp2 : ∀ i : Fin n, (-η) i ≠ 0 → i ∈ Finset.univ.map e := by
        intro i hi
        exact hsupp1 i (by simpa [Pi.neg_apply] using hi)
      have hc1 := coeff_eq_factorial_mul_injSum e η hsupp1
      have hc2 := coeff_eq_factorial_mul_injSum e (-η) hsupp2
      have hnegv : (fun j => (-η) (e j)) = -(fun j => η (e j)) := rfl
      rw [hnegv, injSum_eq_injSumReal, injSumReal_neg] at hc2
      rw [injSum_eq_injSumReal] at hc1
      dsimp only [W]
      rw [hc1, hc2]
      have hre : ((((n - k).factorial : ℂ) * (injSumReal n k (fun j => η (e j)) : ℂ)) ^ 2 *
          (((n - k).factorial : ℂ) * (injSumReal n k (fun j => η (e j)) : ℂ))).re =
          ((n - k).factorial : ℝ) ^ 3 * (injSumReal n k (fun j => η (e j))) ^ 3 := by
        have hcast : (((n - k).factorial : ℂ) * (injSumReal n k (fun j => η (e j)) : ℂ)) ^ 2 *
            (((n - k).factorial : ℂ) * (injSumReal n k (fun j => η (e j)) : ℂ)) =
            ((((n - k).factorial : ℝ) ^ 3 * (injSumReal n k (fun j => η (e j))) ^ 3 : ℝ) : ℂ) := by
          push_cast; ring
        rw [hcast, Complex.ofReal_re]
      rw [hre]
      ring
  rw [Finset.sum_congr rfl hS_eq, Finset.sum_const, Finset.card_powersetCard,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← mul_assoc]
  congr 1
  have hchoose : (n.choose k : ℝ) * (k.factorial : ℝ) * ((n - k).factorial : ℝ) = (n.factorial : ℝ) := by
    exact_mod_cast Nat.choose_mul_factorial_mul_factorial hk_le
  have hkf : (k.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
  have hnf : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hnmkf : ((n - k).factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero (n - k)
  have hch_eq : (n.choose k : ℝ) = (n.factorial : ℝ) / ((k.factorial : ℝ) * ((n - k).factorial : ℝ)) := by
    field_simp [hkf, hnmkf]
    linarith
  rw [hch_eq]
  field_simp [hkf, hnf, hnmkf]

end FourierReduction

section TripleBounds

/-- Count of nonzero vectors `v : Fin k → (ZMod n) \ {0}` valid for all three edge sets `A₁, A₂, A₃`. -/
noncomputable def validTripleCount (n : ℕ) [NeZero n] {k : ℕ}
    (A₁ A₂ A₃ : Finset (Fin k × Fin k)) : ℕ :=
  (Finset.univ.filter fun v : Fin k → {x : ZMod n // x ≠ 0} =>
    valid A₁ (fun j => (v j).1) ∧
    valid A₂ (fun j => (v j).1) ∧
    valid A₃ (fun j => (v j).1)).card

lemma sum_injSumReal_cube (n k : ℕ) [NeZero n] :
    (∑ v : Fin k → {x : ZMod n // x ≠ 0}, (injSumReal n k (fun j => (v j).1)) ^ 3) =
    ∑ A₁ ∈ (pairs k).powerset, ∑ A₂ ∈ (pairs k).powerset, ∑ A₃ ∈ (pairs k).powerset,
      (-1 : ℝ) ^ (A₁.card + A₂.card + A₃.card) *
      (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
      (validTripleCount n A₁ A₂ A₃ : ℝ) := by
  let P := (pairs k).powerset
  let f (A : Finset (Fin k × Fin k)) (v : Fin k → {x : ZMod n // x ≠ 0}) : ℝ :=
    (-1 : ℝ) ^ A.card * if valid A (fun j => (v j).1) then (n : ℝ) ^ compCount A else 0
  have hcube : ∀ v : Fin k → {x : ZMod n // x ≠ 0},
      (injSumReal n k (fun j => (v j).1)) ^ 3 =
      ∑ A₁ ∈ P, ∑ A₂ ∈ P, ∑ A₃ ∈ P, f A₁ v * f A₂ v * f A₃ v := by
    intro v
    change (∑ A ∈ P, f A v) ^ 3 = _
    calc
      (∑ A ∈ P, f A v) ^ 3 = (∑ A₁ ∈ P, f A₁ v) * ((∑ A₂ ∈ P, f A₂ v) * (∑ A₃ ∈ P, f A₃ v)) := by
        ring
      _ = ∑ A₁ ∈ P, ∑ A₂ ∈ P, ∑ A₃ ∈ P, f A₁ v * (f A₂ v * f A₃ v) := by
        simp_rw [Finset.sum_mul, Finset.mul_sum]
      _ = ∑ A₁ ∈ P, ∑ A₂ ∈ P, ∑ A₃ ∈ P, f A₁ v * f A₂ v * f A₃ v := by
        refine Finset.sum_congr rfl fun A₁ _ => Finset.sum_congr rfl fun A₂ _ =>
          Finset.sum_congr rfl fun A₃ _ => by ring
  simp_rw [hcube]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun A₁ _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun A₂ _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun A₃ _ => ?_
  have hterm : ∀ v : Fin k → {x : ZMod n // x ≠ 0},
      f A₁ v * f A₂ v * f A₃ v =
      if (valid A₁ (fun j => (v j).1) ∧ valid A₂ (fun j => (v j).1) ∧
          valid A₃ (fun j => (v j).1)) then
        (-1 : ℝ) ^ (A₁.card + A₂.card + A₃.card) *
        (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃)
      else 0 := by
    intro v
    dsimp only [f]
    by_cases h1 : valid A₁ (fun j => (v j).1) <;>
    by_cases h2 : valid A₂ (fun j => (v j).1) <;>
    by_cases h3 : valid A₃ (fun j => (v j).1) <;>
    simp [h1, h2, h3, pow_add]
    ring
  simp_rw [hterm, ← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]
  rfl

lemma validTripleCount_eq_zero_of_singleton {n k : ℕ} [NeZero n] {A₁ A₂ A₃ : Finset (Fin k × Fin k)}
    (h : (∃ c, (compFinset A₁ c).card < 2) ∨
         (∃ c, (compFinset A₂ c).card < 2) ∨
         (∃ c, (compFinset A₃ c).card < 2)) :
    validTripleCount n A₁ A₂ A₃ = 0 := by
  have himp : ∀ A : Finset (Fin k × Fin k), (∃ c, (compFinset A c).card < 2) →
      ∀ v : Fin k → {x : ZMod n // x ≠ 0}, ¬ valid A (fun j => (v j).1) := by
    intro A ⟨c, hc⟩ v hv
    have hne : (compFinset A c).Nonempty := compFinset_nonempty A c
    have hcard1 : (compFinset A c).card = 1 := by
      have hpos : 0 < (compFinset A c).card := Finset.card_pos.mpr hne
      omega
    obtain ⟨i, hi⟩ := Finset.card_eq_one.mp hcard1
    have hsum := hv c
    rw [hi, Finset.sum_singleton] at hsum
    exact (v i).2 hsum
  unfold validTripleCount
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro v _ ⟨h1, h2, h3⟩
  rcases h with hA₁ | hA₂ | hA₃
  · exact himp A₁ hA₁ v h1
  · exact himp A₂ hA₂ v h2
  · exact himp A₃ hA₃ v h3

/-- Generic linear-constraint upper bound: `valid A` determines one coordinate per component. -/
lemma card_valid_le {n k : ℕ} [NeZero n] (A : Finset (Fin k × Fin k)) :
    (Finset.univ.filter fun v : Fin k → {x : ZMod n // x ≠ 0} =>
      valid A (fun j => (v j).1)).card ≤ n ^ (k - compCount A) := by
  let rep : (graphOf A).ConnectedComponent → Fin k :=
    fun c => (compFinset_nonempty A c).choose
  have hrep_mem : ∀ c, rep c ∈ compFinset A c :=
    fun c => (compFinset_nonempty A c).choose_spec
  have hrep_inj : Function.Injective rep := by
    intro c₁ c₂ hEq
    have h1 := (mem_compFinset_iff A c₁ (rep c₁)).mp (hrep_mem c₁)
    have h2 := (mem_compFinset_iff A c₂ (rep c₂)).mp (hrep_mem c₂)
    rw [← h1, hEq, h2]
  let R : Finset (Fin k) := Finset.univ.image rep
  have hR_card : R.card = compCount A := by
    rw [Finset.card_image_of_injective _ hrep_inj, Finset.card_univ]
    rfl
  let F := {v : Fin k → {x : ZMod n // x ≠ 0} // valid A (fun j => (v j).1)}
  let rest := {j : Fin k // j ∉ R}
  let restrict : F → (rest → ZMod n) := fun v j => (v.1 j.1).1
  have hrestrict_inj : Function.Injective restrict := by
    intro v₁ v₂ hEq
    apply Subtype.ext
    funext i
    apply Subtype.ext
    by_cases hi : i ∈ R
    · obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hi
      have h1 := v₁.2 c
      have h2 := v₂.2 c
      rw [← Finset.add_sum_erase _ _ (hrep_mem c)] at h1 h2
      have hsum_eq : (∑ j ∈ (compFinset A c).erase (rep c), (v₁.1 j).1) =
          ∑ j ∈ (compFinset A c).erase (rep c), (v₂.1 j).1 := by
        refine Finset.sum_congr rfl fun j hj => ?_
        have hjR : j ∉ R := by
          intro hjR
          obtain ⟨c', _, rfl⟩ := Finset.mem_image.mp hjR
          have hmk : (graphOf A).connectedComponentMk (rep c') = c :=
            (mem_compFinset_iff A c (rep c')).mp (Finset.mem_of_mem_erase hj)
          have hmk' : (graphOf A).connectedComponentMk (rep c') = c' :=
            (mem_compFinset_iff A c' (rep c')).mp (hrep_mem c')
          have hcEq : c' = c := hmk'.symm.trans hmk
          exact (Finset.ne_of_mem_erase hj) (congrArg rep hcEq)
        exact congrFun hEq ⟨j, hjR⟩
      linear_combination h1 - h2 - hsum_eq
    · exact congrFun hEq ⟨i, hi⟩
  have hcard_rest : Fintype.card rest = k - compCount A := by
    have h1 : Fintype.card rest = (Finset.univ \ R).card := by
      rw [Fintype.card_subtype]
      congr 1; ext j; simp
    rw [h1, Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin, hR_card]
  have hle : Fintype.card F ≤ Fintype.card (rest → ZMod n) :=
    Fintype.card_le_of_injective restrict hrestrict_inj
  rw [Fintype.card_subtype] at hle
  rw [Fintype.card_fun, ZMod.card, hcard_rest] at hle
  exact hle

lemma validTripleCount_le_each {n k : ℕ} [NeZero n] (A₁ A₂ A₃ : Finset (Fin k × Fin k)) :
    validTripleCount n A₁ A₂ A₃ ≤ n ^ (k - compCount A₁) ∧
    validTripleCount n A₁ A₂ A₃ ≤ n ^ (k - compCount A₂) ∧
    validTripleCount n A₁ A₂ A₃ ≤ n ^ (k - compCount A₃) := by
  unfold validTripleCount
  refine ⟨?_, ?_, ?_⟩
  · refine (Finset.card_le_card fun v hv => ?_).trans (card_valid_le A₁)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    exact hv.1
  · refine (Finset.card_le_card fun v hv => ?_).trans (card_valid_le A₂)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    exact hv.2.1
  · refine (Finset.card_le_card fun v hv => ?_).trans (card_valid_le A₃)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    exact hv.2.2

/-- Union-graph upper bound for three perfect matchings: one coordinate per component of `A₁ ∪ A₂ ∪ A₃`. -/
lemma validTripleCount_le_union_of_pm {n k : ℕ} [NeZero n]
    {A₁ A₂ A₃ : Finset (Fin k × Fin k)}
    (hpm₁ : isPerfectMatching A₁) (hpm₂ : isPerfectMatching A₂) (hpm₃ : isPerfectMatching A₃) :
    validTripleCount n A₁ A₂ A₃ ≤ n ^ compCount (A₁ ∪ A₂ ∪ A₃) := by
  let U := A₁ ∪ A₂ ∪ A₃
  let rep : (graphOf U).ConnectedComponent → Fin k :=
    fun c => (compFinset_nonempty U c).choose
  have hrep_mem : ∀ c, rep c ∈ compFinset U c :=
    fun c => (compFinset_nonempty U c).choose_spec
  let F := {v : Fin k → {x : ZMod n // x ≠ 0} //
    valid A₁ (fun j => (v j).1) ∧ valid A₂ (fun j => (v j).1) ∧ valid A₃ (fun j => (v j).1)}
  let evalRep : F → ((graphOf U).ConnectedComponent → ZMod n) :=
    fun v c => (v.1 (rep c)).1
  have hadj_neg : ∀ (v : F) {a b : Fin k}, (graphOf U).Adj a b → (v.1 b).1 = -(v.1 a).1 := by
    intro v a b hab
    have h1 := (valid_iff_of_isPerfectMatching hpm₁ _).mp v.2.1
    have h2 := (valid_iff_of_isPerfectMatching hpm₂ _).mp v.2.2.1
    have h3 := (valid_iff_of_isPerfectMatching hpm₃ _).mp v.2.2.2
    have hpair : ∀ p ∈ U, (v.1 p.1).1 + (v.1 p.2).1 = 0 := by
      intro p hp
      simp only [U, Finset.mem_union] at hp
      rcases hp with (hp | hp) | hp
      · exact h1 p hp
      · exact h2 p hp
      · exact h3 p hp
    rcases hab.2 with h | h
    · have hsum := hpair (a, b) h
      linear_combination hsum
    · have hsum := hpair (b, a) h
      linear_combination hsum
  have hwalk_eq : ∀ (v₁ v₂ : F) {a b : Fin k}, (graphOf U).Walk a b →
      (v₁.1 a).1 = (v₂.1 a).1 → (v₁.1 b).1 = (v₂.1 b).1 := by
    intro v₁ v₂ a b w hstart
    induction w with
    | nil => exact hstart
    | @cons x y z hxy _ ih =>
      exact ih (by rw [hadj_neg v₁ hxy, hadj_neg v₂ hxy, hstart])
  have hinj : Function.Injective evalRep := by
    intro v₁ v₂ hEq
    apply Subtype.ext
    funext i
    apply Subtype.ext
    let c := (graphOf U).connectedComponentMk i
    have hreach : (graphOf U).Reachable (rep c) i := by
      have hmk : (graphOf U).connectedComponentMk (rep c) = (graphOf U).connectedComponentMk i :=
        (mem_compFinset_iff U c (rep c)).mp (hrep_mem c)
      exact SimpleGraph.ConnectedComponent.exact hmk
    obtain ⟨w⟩ := hreach
    exact hwalk_eq v₁ v₂ w (congrFun hEq c)
  have hle : Fintype.card F ≤ Fintype.card ((graphOf U).ConnectedComponent → ZMod n) :=
    Fintype.card_le_of_injective evalRep hinj
  rw [Fintype.card_subtype] at hle
  rw [Fintype.card_fun, ZMod.card] at hle
  exact hle

/-- Exact count when `A₁ = A₂ = A₃ = A` is a perfect matching on `Fin k`. -/
lemma validTripleCount_self_of_pm {n k : ℕ} [NeZero n]
    {A : Finset (Fin k × Fin k)} (hpm : isPerfectMatching A) :
    validTripleCount n A A A = (n - 1) ^ A.card := by
  let F := {v : Fin k → {x : ZMod n // x ≠ 0} // valid A (fun i => (v i).1)}
  have hcard_eq : validTripleCount n A A A = Fintype.card F := by
    unfold validTripleCount
    rw [Fintype.card_subtype]
    congr 1
    ext v
    simp
  rw [hcard_eq]
  let toFun : F → ({p // p ∈ A} → {x : ZMod n // x ≠ 0}) := fun v p => v.1 p.1.1
  let edgeOf (i : Fin k) : {p // p ∈ A} :=
    ⟨(hpm.2 i).choose, (hpm.2 i).choose_spec.1.1⟩
  have hedgeOf_mem (i : Fin k) : (edgeOf i).1.1 = i ∨ (edgeOf i).1.2 = i :=
    (hpm.2 i).choose_spec.1.2
  have hedgeOf_eq {p : Fin k × Fin k} (hp : p ∈ A) {i : Fin k}
      (hi : p.1 = i ∨ p.2 = i) : edgeOf i = ⟨p, hp⟩ :=
    Subtype.ext ((hpm.2 i).choose_spec.2 p ⟨hp, hi⟩).symm
  let invFun : ({p // p ∈ A} → {x : ZMod n // x ≠ 0}) → F := fun g =>
    ⟨fun i =>
      if (edgeOf i).1.1 = i then g (edgeOf i)
      else ⟨-(g (edgeOf i)).1, neg_ne_zero.mpr (g (edgeOf i)).2⟩,
      (valid_iff_of_isPerfectMatching hpm _).mpr fun p hp => by
        have hlt : p.1 < p.2 := (Finset.mem_filter.mp (hpm.1 hp)).2
        have he1 : edgeOf p.1 = ⟨p, hp⟩ := hedgeOf_eq hp (Or.inl rfl)
        have he2 : edgeOf p.2 = ⟨p, hp⟩ := hedgeOf_eq hp (Or.inr rfl)
        have hne : p.1 ≠ p.2 := ne_of_lt hlt
        simp only [he1, he2, ite_true, if_neg hne, add_neg_cancel]⟩
  have hEquiv : F ≃ ({p // p ∈ A} → {x : ZMod n // x ≠ 0}) :=
    { toFun := toFun
      invFun := invFun
      left_inv := fun v => by
        apply Subtype.ext
        funext i
        dsimp only [toFun, invFun]
        split_ifs with h
        · rw [h]
        · have h2 : (edgeOf i).1.2 = i := (hedgeOf_mem i).resolve_left h
          have hv := (valid_iff_of_isPerfectMatching hpm _).mp v.2 (edgeOf i).1 (edgeOf i).2
          apply Subtype.ext
          have hval : (v.1 (edgeOf i).1.2).1 = (v.1 i).1 := congrArg (fun x => (v.1 x).1) h2
          linear_combination hval - hv
      right_inv := fun g => by
        funext ⟨p, hp⟩
        dsimp only [toFun, invFun]
        have he1 : edgeOf p.1 = ⟨p, hp⟩ := hedgeOf_eq hp (Or.inl rfl)
        simp only [he1, ite_true] }
  rw [Fintype.card_congr hEquiv, Fintype.card_fun, Fintype.card_coe]
  have hnz : Fintype.card {x : ZMod n // x ≠ 0} = n - 1 := by
    have h1 : Fintype.card {x : ZMod n // x ≠ 0} = ((Finset.univ : Finset (ZMod n)).erase 0).card := by
      rw [Fintype.card_subtype]
      congr 1; ext x; simp
    rw [h1, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, ZMod.card]
  rw [hnz]

end TripleBounds

section Limits

lemma descFactorial_mul_factorial_sub {n k : ℕ} (hk : k ≤ n) :
    n.descFactorial k * (n - k).factorial = n.factorial := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hkn : k ≤ n := Nat.le_of_succ_le hk
    have hsub : n - k = (n - (k + 1)) + 1 := by omega
    rw [Nat.descFactorial_succ]
    have hstep : (n - k) * (n - (k + 1)).factorial = (n - k).factorial := by
      conv_rhs => rw [hsub, Nat.factorial_succ]
      rw [← hsub]
    calc
      (n - k) * n.descFactorial k * (n - (k + 1)).factorial
          = n.descFactorial k * ((n - k) * (n - (k + 1)).factorial) := by ring
      _ = n.descFactorial k * (n - k).factorial := by rw [hstep]
      _ = n.factorial := ih hkn

lemma tendsto_factorial_ratio (k : ℕ) :
    Tendsto (fun n : ℕ => (((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k)
      atTop (𝓝 1) := by
  have hprod : Tendsto (fun n : ℕ => ∏ i ∈ Finset.range k, (1 - (i : ℝ) / (n : ℝ)))
      atTop (𝓝 (∏ _i ∈ Finset.range k, (1 : ℝ))) := by
    refine tendsto_finsetProd _ fun i _ => ?_
    have h0 : Tendsto (fun n : ℕ => (i : ℝ) / (n : ℝ)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
    simpa using tendsto_const_nhds.sub h0
  rw [Finset.prod_const_one] at hprod
  have hinv := hprod.inv₀ (by norm_num : (1 : ℝ) ≠ 0)
  rw [inv_one] at hinv
  refine hinv.congr' ?_
  filter_upwards [eventually_ge_atTop (k + 1)] with n hn
  have hkn : k ≤ n := by omega
  have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast (show 0 < n by omega)
  have hdesc : n.descFactorial k * (n - k).factorial = n.factorial :=
    descFactorial_mul_factorial_sub hkn
  have hdesc_prod : (n.descFactorial k : ℝ) = ∏ i ∈ Finset.range k, ((n : ℝ) - (i : ℝ)) := by
    rw [Nat.descFactorial_eq_prod_range, Nat.cast_prod]
    refine Finset.prod_congr rfl fun i hi => ?_
    have hi_le : i ≤ n := le_trans (le_of_lt (Finset.mem_range.mp hi)) hkn
    exact Nat.cast_sub hi_le
  have hprod_n : (∏ i ∈ Finset.range k, (1 - (i : ℝ) / (n : ℝ))) =
      (n.descFactorial k : ℝ) / (n : ℝ) ^ k := by
    rw [hdesc_prod]
    have hfactor : ∀ i ∈ Finset.range k,
        1 - (i : ℝ) / (n : ℝ) = ((n : ℝ) - (i : ℝ)) / (n : ℝ) := fun i _ => by
      field_simp [hnpos.ne']
    rw [Finset.prod_congr rfl hfactor, Finset.prod_div_distrib, Finset.prod_const,
      Finset.card_range]
  rw [hprod_n, inv_div]
  have hdesc_r : (n.descFactorial k : ℝ) * ((n - k).factorial : ℝ) = (n.factorial : ℝ) := by
    exact_mod_cast hdesc
  have hnf : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hdesc_ne : (n.descFactorial k : ℝ) ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hdesc_r
    exact hnf hdesc_r.symm
  field_simp [hnf, hdesc_ne]
  linarith

lemma tendsto_sub_one_div_pow (j : ℕ) :
    Tendsto (fun n : ℕ => (((n - 1 : ℕ) : ℝ) / (n : ℝ)) ^ j) atTop (𝓝 1) := by
  have hbase : Tendsto (fun n : ℕ => ((n - 1 : ℕ) : ℝ) / (n : ℝ)) atTop (𝓝 1) := by
    have h1 : Tendsto (fun n : ℕ => (1 : ℝ) - 1 / (n : ℝ)) atTop (𝓝 (1 - 0)) :=
      tendsto_const_nhds.sub (tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop)
    rw [sub_zero] at h1
    refine h1.congr' ?_
    filter_upwards [eventually_ge_atTop 1] with n hn
    have hnpos : (n : ℝ) ≠ 0 := by exact_mod_cast (show n ≠ 0 by omega)
    rw [Nat.cast_sub hn, Nat.cast_one]
    field_simp [hnpos]
  simpa using hbase.pow j

lemma tendsto_triple_term (k : ℕ) {A₁ A₂ A₃ : Finset (Fin k × Fin k)}
    (hA₁ : A₁ ∈ (pairs k).powerset) (hA₂ : A₂ ∈ (pairs k).powerset)
    (hA₃ : A₃ ∈ (pairs k).powerset) :
    Tendsto (fun n : ℕ =>
      if hn : n = 0 then (0 : ℝ) else
        letI : NeZero n := ⟨hn⟩
        (1 / (k.factorial : ℝ)) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
          ((-1 : ℝ) ^ (A₁.card + A₂.card + A₃.card) *
          (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
          (validTripleCount n A₁ A₂ A₃ : ℝ)))
      atTop
      (𝓝 (if isPerfectMatching A₁ ∧ A₁ = A₂ ∧ A₁ = A₃ then
        (1 / (k.factorial : ℝ)) * (-1 : ℝ) ^ A₁.card else 0)) := by
  have hA₁sub : A₁ ⊆ pairs k := Finset.mem_powerset.mp hA₁
  have hA₂sub : A₂ ⊆ pairs k := Finset.mem_powerset.mp hA₂
  have hA₃sub : A₃ ⊆ pairs k := Finset.mem_powerset.mp hA₃
  have squeeze_inv : ∀ (f : ℕ → ℝ) (C : ℝ),
      (∀ᶠ n : ℕ in atTop, |f n| ≤ C / (n : ℝ)) → Tendsto f atTop (𝓝 0) := by
    intro f C hbd
    have h0 : Tendsto (fun n : ℕ => C / (n : ℝ)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
    exact squeeze_zero_norm' hbd h0
  have hfac_lim : Tendsto (fun n : ℕ =>
      ((((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k) ^ 2) atTop (𝓝 1) := by
    simpa using (tendsto_factorial_ratio k).pow 2
  have hfac_ev : ∀ᶠ n : ℕ in atTop,
      ((((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k) ^ 2 ≤ 2 := by
    filter_upwards [hfac_lim.eventually (Iio_mem_nhds (by norm_num : (1 : ℝ) < 2))] with n hn
    exact le_of_lt hn
  by_cases hsing : (∃ c, (compFinset A₁ c).card < 2) ∨
      (∃ c, (compFinset A₂ c).card < 2) ∨ (∃ c, (compFinset A₃ c).card < 2)
  · have hnotpm : ¬ (isPerfectMatching A₁ ∧ A₁ = A₂ ∧ A₁ = A₃) := by
      rintro ⟨hpm₁, rfl, rfl⟩
      have hge2 : ∀ c : (graphOf A₁).ConnectedComponent, (compFinset A₁ c).card = 2 := by
        intro c
        refine SimpleGraph.ConnectedComponent.ind (fun i => ?_) c
        obtain ⟨p, ⟨hpA, hpi⟩, _⟩ := hpm₁.2 i
        have hmk : (graphOf A₁).connectedComponentMk i = (graphOf A₁).connectedComponentMk p.1 := by
          rcases hpi with rfl | rfl
          · rfl
          · exact (connectedComponentMk_eq_of_mem hpm₁.1 hpA).symm
        rw [hmk, compFinset_of_isPerfectMatching hpm₁ hpA, Finset.card_pair]
        exact ne_of_lt (Finset.mem_filter.mp (hpm₁.1 hpA)).2
      rcases hsing with ⟨c, hc⟩ | ⟨c, hc⟩ | ⟨c, hc⟩ <;> rw [hge2 c] at hc <;> omega
    rw [if_neg hnotpm]
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_ge_atTop 1] with n hn
    have hn0 : n ≠ 0 := by omega
    rw [dif_neg hn0]
    have : NeZero n := ⟨hn0⟩
    rw [validTripleCount_eq_zero_of_singleton hsing]
    simp
  · push Not at hsing
    obtain ⟨hge₁, hge₂, hge₃⟩ := hsing
    have hc₁ : 2 * compCount A₁ ≤ k := two_mul_compCount_le_of_no_singleton A₁ hge₁
    have hc₂ : 2 * compCount A₂ ≤ k := two_mul_compCount_le_of_no_singleton A₂ hge₂
    have hc₃ : 2 * compCount A₃ ≤ k := two_mul_compCount_le_of_no_singleton A₃ hge₃
    by_cases hall : 2 * compCount A₁ = k ∧ 2 * compCount A₂ = k ∧ 2 * compCount A₃ = k
    · obtain ⟨heq₁, heq₂, heq₃⟩ := hall
      have hpm₁ : isPerfectMatching A₁ := isPerfectMatching_of_compCount hA₁sub hge₁ heq₁
      have hpm₂ : isPerfectMatching A₂ := isPerfectMatching_of_compCount hA₂sub hge₂ heq₂
      have hpm₃ : isPerfectMatching A₃ := isPerfectMatching_of_compCount hA₃sub hge₃ heq₃
      have hcard₁ : compCount A₁ = A₁.card ∧ 2 * A₁.card = k :=
        compCount_eq_card_of_isPerfectMatching hpm₁
      by_cases heqA : A₁ = A₂ ∧ A₁ = A₃
      · obtain ⟨rfl, rfl⟩ := heqA
        rw [if_pos ⟨hpm₁, rfl, rfl⟩]
        let j := A₁.card
        have hkj : k = 2 * j := hcard₁.2.symm
        have hlim : Tendsto (fun n : ℕ =>
            (1 / (k.factorial : ℝ)) * (-1 : ℝ) ^ j *
            (((((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k) ^ 2) *
            ((((n - 1 : ℕ) : ℝ) / (n : ℝ)) ^ j))
            atTop (𝓝 ((1 / (k.factorial : ℝ)) * (-1 : ℝ) ^ j * 1 * 1)) :=
          ((tendsto_const_nhds.mul hfac_lim).mul (tendsto_sub_one_div_pow j))
        simp only [mul_one] at hlim
        refine hlim.congr' ?_
        filter_upwards [eventually_ge_atTop 1] with n hn
        have hn0 : n ≠ 0 := by omega
        rw [dif_neg hn0]
        have : NeZero n := ⟨hn0⟩
        have hnpos : (n : ℝ) ≠ 0 := by exact_mod_cast hn0
        have hvtc : validTripleCount n A₁ A₁ A₁ = (n - 1) ^ j :=
          validTripleCount_self_of_pm hpm₁
        rw [hvtc, hcard₁.1]
        have hsign : (-1 : ℝ) ^ (j + j + j) = (-1 : ℝ) ^ j := by
          have : j + j + j = 2 * j + j := by omega
          rw [this, pow_add, pow_mul]
          norm_num
        change _ = (1 / (k.factorial : ℝ)) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
          ((-1 : ℝ) ^ (j + j + j) * (n : ℝ) ^ (j + j + j) * (((n - 1) ^ j : ℕ) : ℝ))
        rw [hsign, Nat.cast_pow, div_pow]
        have hpow' : ((n : ℝ) ^ k) ^ 2 * ((n : ℝ) ^ j)⁻¹ = (n : ℝ) ^ (j + j + j) := by
          rw [hkj, ← pow_mul]
          have h1 : 2 * j * 2 = (j + j + j) + j := by omega
          rw [h1, pow_add, mul_inv_cancel_right₀ (pow_ne_zero j hnpos)]
        calc
          1 / (k.factorial : ℝ) * (-1 : ℝ) ^ j *
              ((((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k) ^ 2 *
              (((n - 1 : ℕ) : ℝ) ^ j / (n : ℝ) ^ j)
              = 1 / (k.factorial : ℝ) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
                ((-1 : ℝ) ^ j * (((n : ℝ) ^ k) ^ 2 * ((n : ℝ) ^ j)⁻¹) * ((n - 1 : ℕ) : ℝ) ^ j) := by
                ring
          _ = 1 / (k.factorial : ℝ) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
                ((-1 : ℝ) ^ j * (n : ℝ) ^ (j + j + j) * ((n - 1 : ℕ) : ℝ) ^ j) := by
                rw [hpow']
      · rw [if_neg (fun h => heqA h.2)]
        have hltU : compCount (A₁ ∪ A₂ ∪ A₃) < compCount A₁ :=
          compCount_union_lt_of_ne hpm₁ hpm₂ hpm₃ heqA
        refine squeeze_inv _ (2 / (k.factorial : ℝ)) ?_
        filter_upwards [eventually_ge_atTop 1, hfac_ev] with n hn hfac2
        have hn0 : n ≠ 0 := by omega
        rw [dif_neg hn0]
        have : NeZero n := ⟨hn0⟩
        have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast (show 0 < n by omega)
        have hkf_pos : (0 : ℝ) < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
        have hbd_nat : validTripleCount n A₁ A₂ A₃ ≤ n ^ compCount (A₁ ∪ A₂ ∪ A₃) :=
          validTripleCount_le_union_of_pm hpm₁ hpm₂ hpm₃
        have hbd_r : (validTripleCount n A₁ A₂ A₃ : ℝ) ≤ (n : ℝ) ^ (compCount A₁ - 1) := by
          calc
            (validTripleCount n A₁ A₂ A₃ : ℝ) ≤ (n : ℝ) ^ compCount (A₁ ∪ A₂ ∪ A₃) := by
              exact_mod_cast hbd_nat
            _ ≤ (n : ℝ) ^ (compCount A₁ - 1) :=
              pow_le_pow_right₀ (by exact_mod_cast hn) (by omega)
        have hexp : compCount A₁ + compCount A₂ + compCount A₃ + (compCount A₁ - 1) + 1 = 2 * k := by
          omega
        have hdiv_nn : (0 : ℝ) ≤ ((n - k).factorial : ℝ) / (n.factorial : ℝ) := by positivity
        have hvtc_nn : (0 : ℝ) ≤ (validTripleCount n A₁ A₂ A₃ : ℝ) := Nat.cast_nonneg _
        simp only [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul,
          abs_of_pos (one_div_pos.mpr hkf_pos),
          abs_of_nonneg hdiv_nn, abs_of_nonneg hnpos.le, abs_of_nonneg hvtc_nn]
        have hrewrite :
            (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
            ((n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) * (validTripleCount n A₁ A₂ A₃ : ℝ)) ≤
            2 / (n : ℝ) := by
          have h1 : (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
              (validTripleCount n A₁ A₂ A₃ : ℝ) ≤ ((n : ℝ) ^ k) ^ 2 / (n : ℝ) := by
            calc
              (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
                  (validTripleCount n A₁ A₂ A₃ : ℝ)
                  ≤ (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
                    (n : ℝ) ^ (compCount A₁ - 1) :=
                    mul_le_mul_of_nonneg_left hbd_r (pow_nonneg hnpos.le _)
              _ = (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃ + (compCount A₁ - 1)) := by
                    rw [← pow_add]
              _ = ((n : ℝ) ^ k) ^ 2 / (n : ℝ) := by
                    rw [← pow_mul, show k * 2 = 2 * k by ring, ← hexp, pow_succ,
                      mul_div_cancel_right₀ _ hnpos.ne']
          calc
            (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
                ((n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
                  (validTripleCount n A₁ A₂ A₃ : ℝ))
                ≤ (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 * (((n : ℝ) ^ k) ^ 2 / (n : ℝ)) :=
                mul_le_mul_of_nonneg_left h1 (sq_nonneg _)
            _ = ((((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k) ^ 2 / (n : ℝ) := by
                ring
            _ ≤ 2 / (n : ℝ) := div_le_div_of_nonneg_right hfac2 hnpos.le
        calc
          1 / (k.factorial : ℝ) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
              ((n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
                (validTripleCount n A₁ A₂ A₃ : ℝ))
              = 1 / (k.factorial : ℝ) * ((((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
                ((n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
                  (validTripleCount n A₁ A₂ A₃ : ℝ))) := by ring
          _ ≤ 1 / (k.factorial : ℝ) * (2 / (n : ℝ)) :=
                mul_le_mul_of_nonneg_left hrewrite (one_div_nonneg.mpr hkf_pos.le)
          _ = 2 / (k.factorial : ℝ) / (n : ℝ) := by ring
    · have hnotpm : ¬ (isPerfectMatching A₁ ∧ A₁ = A₂ ∧ A₁ = A₃) := by
        rintro ⟨hpm₁, rfl, rfl⟩
        have h := compCount_eq_card_of_isPerfectMatching hpm₁
        exact hall ⟨by omega, by omega, by omega⟩
      rw [if_neg hnotpm]
      have hex_max : ∃ cmax : ℕ,
          (∀ n : ℕ, [NeZero n] → validTripleCount n A₁ A₂ A₃ ≤ n ^ (k - cmax)) ∧
          cmax ≤ k ∧
          compCount A₁ + compCount A₂ + compCount A₃ + (k - cmax) + 1 ≤ 2 * k := by
        by_cases h12 : compCount A₂ ≤ compCount A₁
        · by_cases h13 : compCount A₃ ≤ compCount A₁
          · exact ⟨compCount A₁, fun n _ => (validTripleCount_le_each A₁ A₂ A₃).1,
              by omega, by omega⟩
          · exact ⟨compCount A₃, fun n _ => (validTripleCount_le_each A₁ A₂ A₃).2.2,
              by omega, by omega⟩
        · by_cases h23 : compCount A₃ ≤ compCount A₂
          · exact ⟨compCount A₂, fun n _ => (validTripleCount_le_each A₁ A₂ A₃).2.1,
              by omega, by omega⟩
          · exact ⟨compCount A₃, fun n _ => (validTripleCount_le_each A₁ A₂ A₃).2.2,
              by omega, by omega⟩
      obtain ⟨cmax, hbd_vtc, _, hexp_le⟩ := hex_max
      refine squeeze_inv _ (2 / (k.factorial : ℝ)) ?_
      filter_upwards [eventually_ge_atTop 1, hfac_ev] with n hn hfac2
      have hn0 : n ≠ 0 := by omega
      rw [dif_neg hn0]
      have : NeZero n := ⟨hn0⟩
      have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast (show 0 < n by omega)
      have hkf_pos : (0 : ℝ) < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
      have hbd_r : (validTripleCount n A₁ A₂ A₃ : ℝ) ≤ (n : ℝ) ^ (k - cmax) := by
        exact_mod_cast hbd_vtc n
      have hdiv_nn : (0 : ℝ) ≤ ((n - k).factorial : ℝ) / (n.factorial : ℝ) := by positivity
      have hvtc_nn : (0 : ℝ) ≤ (validTripleCount n A₁ A₂ A₃ : ℝ) := Nat.cast_nonneg _
      simp only [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul,
        abs_of_pos (one_div_pos.mpr hkf_pos),
        abs_of_nonneg hdiv_nn, abs_of_nonneg hnpos.le, abs_of_nonneg hvtc_nn]
      have h1 : (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
          (validTripleCount n A₁ A₂ A₃ : ℝ) ≤ ((n : ℝ) ^ k) ^ 2 / (n : ℝ) := by
        calc
          (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
              (validTripleCount n A₁ A₂ A₃ : ℝ)
              ≤ (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) * (n : ℝ) ^ (k - cmax) :=
                mul_le_mul_of_nonneg_left hbd_r (pow_nonneg hnpos.le _)
          _ = (n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃ + (k - cmax)) := by
                rw [← pow_add]
          _ ≤ (n : ℝ) ^ (2 * k - 1) :=
                pow_le_pow_right₀ (by exact_mod_cast hn) (by omega)
          _ = ((n : ℝ) ^ k) ^ 2 / (n : ℝ) := by
                have h2k : 2 * k = (2 * k - 1) + 1 := by omega
                rw [← pow_mul, show k * 2 = 2 * k by ring, h2k, pow_succ,
                  mul_div_cancel_right₀ _ hnpos.ne', Nat.add_sub_cancel]
      calc
        1 / (k.factorial : ℝ) * (((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
            ((n : ℝ) ^ (compCount A₁ + compCount A₂ + compCount A₃) *
              (validTripleCount n A₁ A₂ A₃ : ℝ))
            ≤ 1 / (k.factorial : ℝ) * ((((n - k).factorial : ℝ) / (n.factorial : ℝ)) ^ 2 *
              (((n : ℝ) ^ k) ^ 2 / (n : ℝ))) := by
              rw [mul_assoc]
              exact mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left h1 (sq_nonneg _)) (one_div_nonneg.mpr hkf_pos.le)
        _ = 1 / (k.factorial : ℝ) *
              (((((n - k).factorial : ℝ) / (n.factorial : ℝ)) * (n : ℝ) ^ k) ^ 2 / (n : ℝ)) := by
              ring
        _ ≤ 1 / (k.factorial : ℝ) * (2 / (n : ℝ)) :=
              mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hfac2 hnpos.le)
                (one_div_nonneg.mpr hkf_pos.le)
        _ = 2 / (k.factorial : ℝ) / (n : ℝ) := by ring

lemma limit_k_sum (k : ℕ) :
    (∑ A₁ ∈ (pairs k).powerset, ∑ A₂ ∈ (pairs k).powerset, ∑ A₃ ∈ (pairs k).powerset,
      if isPerfectMatching A₁ ∧ A₁ = A₂ ∧ A₁ = A₃ then
        (1 / (k.factorial : ℝ)) * (-1 : ℝ) ^ A₁.card else 0) =
    if Even k then (-(1 / 2) : ℝ) ^ (k / 2) / ((k / 2).factorial : ℝ) else 0 := by
  have hcollapse :
      (∑ A₁ ∈ (pairs k).powerset, ∑ A₂ ∈ (pairs k).powerset, ∑ A₃ ∈ (pairs k).powerset,
        if isPerfectMatching A₁ ∧ A₁ = A₂ ∧ A₁ = A₃ then
          (1 / (k.factorial : ℝ)) * (-1 : ℝ) ^ A₁.card else 0) =
      ∑ A₁ ∈ (pairs k).powerset.filter isPerfectMatching,
        (1 / (k.factorial : ℝ)) * (-1 : ℝ) ^ A₁.card := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun A₁ hA₁ => ?_
    by_cases hpm : isPerfectMatching A₁
    · rw [if_pos hpm, Finset.sum_eq_single A₁]
      · rw [Finset.sum_eq_single A₁]
        · simp [hpm]
        · intro A₃ _ hne; simp [Ne.symm hne]
        · intro h; exact absurd hA₁ h
      · intro A₂ _ hne
        refine Finset.sum_eq_zero fun A₃ _ => by simp [Ne.symm hne]
      · intro h; exact absurd hA₁ h
    · rw [if_neg hpm]
      refine Finset.sum_eq_zero fun A₂ _ => Finset.sum_eq_zero fun A₃ _ => by simp [hpm]
  rw [hcollapse]
  by_cases heven : Even k
  · rw [if_pos heven]
    obtain ⟨j, rfl⟩ := heven
    rw [← two_mul]
    have hdiv : (2 * j) / 2 = j := by omega
    rw [hdiv]
    have hcard_each : ∀ A ∈ perfectMatchings j,
        (1 / ((2 * j).factorial : ℝ)) * (-1 : ℝ) ^ A.card =
        (1 / ((2 * j).factorial : ℝ)) * (-1 : ℝ) ^ j := by
      intro A hA
      have hpm : isPerfectMatching A := (Finset.mem_filter.mp hA).2
      have h2 := (compCount_eq_card_of_isPerfectMatching hpm).2
      have hAj : A.card = j := by omega
      rw [hAj]
    change (∑ A ∈ perfectMatchings j, (1 / ((2 * j).factorial : ℝ)) * (-1 : ℝ) ^ A.card) = _
    rw [Finset.sum_congr rfl hcard_each, Finset.sum_const, nsmul_eq_mul]
    have hmul : ((perfectMatchings j).card : ℝ) * (2 ^ j * (j.factorial : ℝ)) =
        ((2 * j).factorial : ℝ) := by
      exact_mod_cast card_perfectMatchings_mul j
    have h2jf : ((2 * j).factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero (2 * j)
    have hjf : (j.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero j
    have h2j : (2 : ℝ) ^ j ≠ 0 := pow_ne_zero j (by norm_num)
    have hneg_half : (-(1 / 2) : ℝ) ^ j = (-1 : ℝ) ^ j / (2 : ℝ) ^ j := by
      rw [show (-(1 / 2) : ℝ) = (-1 : ℝ) / 2 by ring, div_pow]
    rw [hneg_half]
    field_simp [h2jf, hjf, h2j]
    linarith
  · rw [if_neg heven]
    refine Finset.sum_eq_zero fun A hA => ?_
    have hpm : isPerfectMatching A := (Finset.mem_filter.mp hA).2
    have h2 := (compCount_eq_card_of_isPerfectMatching hpm).2
    exact absurd ⟨A.card, by omega⟩ heven

lemma sum_even_range_eq (M : ℕ) :
    (∑ k ∈ Finset.range (2 * M + 1),
      if Even k then (-(1 / 2) : ℝ) ^ (k / 2) / ((k / 2).factorial : ℝ) else 0) =
    ∑ j ∈ Finset.range (M + 1), (-(1 / 2) : ℝ) ^ j / (j.factorial : ℝ) := by
  rw [← Finset.sum_filter]
  refine Finset.sum_bij (fun k _ => k / 2) ?_ ?_ ?_ ?_
  · intro k hk
    have hklt := Finset.mem_range.mp (Finset.mem_filter.mp hk).1
    exact Finset.mem_range.mpr (by omega)
  · intro k₁ hk₁ k₂ hk₂ hEq
    obtain ⟨j₁, rfl⟩ := (Finset.mem_filter.mp hk₁).2
    obtain ⟨j₂, rfl⟩ := (Finset.mem_filter.mp hk₂).2
    omega
  · intro j hj
    have hjlt := Finset.mem_range.mp hj
