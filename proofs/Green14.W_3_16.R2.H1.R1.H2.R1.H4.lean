private def foldPos (x : Nat) : Nat := min x (232 - x)

private theorem reflectAt {c : Nat → Bool} (hs : ∀ x < 233, c (232 - x) = c x) {x : Nat} (hx : x < 233) :
    c (foldPos x) = c x := by
  unfold foldPos
  rcases le_total x (232 - x) with h | h
  · rw [min_eq_left h]
  · rw [min_eq_right h, hs x hx]

private def Blue (c : Nat → Bool) (m : Nat) : Prop :=
  ∀ i, m.testBit i = true → c i = false

private theorem blueZero (c : Nat → Bool) : Blue c 0 := by
  simp [Blue]

private theorem blueOr {c u v} (hu : Blue c u) (hv : Blue c v) : Blue c (u ||| v) := by
  intro i hi
  simp only [Nat.testBit_or, Bool.or_eq_true] at hi
  exact hi.elim (hu i) (hv i)

private theorem blueSub {c m g} (h : m &&& g = m) (hg : Blue c g) : Blue c m := by
  intro i hi
  rw [← h, Nat.testBit_and, Bool.and_eq_true] at hi
  exact hg i hi.2

private theorem blueSingle {c x} (hx : c x = false) : Blue c (1 <<< x) := by
  intro i hi
  have : x = i := by simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow, eq_comm] using hi
  simpa [← this] using hx

private theorem force_ok {c} (hs : ∀ x < 233, c (232 - x) = c x)
    {z : Nat} (hz : z < 233) (hc : c z = false) : Blue c (1 <<< foldPos z) := by
  apply blueSingle
  rwa [reflectAt hs hz]

private theorem no_ap3 {c : Nat → Bool}
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    (a d : Nat) (hd : 0 < d) (he : a + 2 * d < 233) :
    ¬ (c a = true ∧ c (a + d) = true ∧ c (a + 2 * d) = true) := by
  rintro ⟨h0, h1, h2⟩
  obtain ⟨t, ht, hct⟩ := hap false a d hd he
  change t < 3 at ht
  interval_cases t
  · simp [h0] at hct
  · simp [h1] at hct
  · simp [h2] at hct

private def ban3 (u v : Nat) : Nat :=
  let d := v - u
  (if d ≤ u then 1 <<< foldPos (u - d) else 0) |||
  (if v + d < 233 then 1 <<< foldPos (v + d) else 0) |||
  (if d % 2 == 0 then 1 <<< foldPos (u + d / 2) else 0)

private theorem ban3_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {u v : Nat} (huv : u < v) (hv : v < 233) (hu : c u = true) (hv' : c v = true) :
    Blue c (ban3 u v) := by
  unfold ban3
  dsimp only
  apply blueOr
  · apply blueOr
    · split
      · rename_i hlo
        apply force_ok hs (by omega)
        cases hz : c (u - (v - u)) with
        | false => rfl
        | true =>
          have h := no_ap3 hap (u - (v - u)) (v - u) (by omega) (by omega)
          exact (h ⟨hz, by rwa [show u - (v - u) + (v - u) = u by omega],
            by rwa [show u - (v - u) + 2 * (v - u) = v by omega]⟩).elim
      · exact blueZero c
    · split
      · rename_i hhi
        apply force_ok hs hhi
        cases hz : c (v + (v - u)) with
        | false => rfl
        | true =>
          have h := no_ap3 hap u (v - u) (by omega) (by omega)
          exact (h ⟨hu, by rwa [show u + (v - u) = v by omega],
            by rwa [show u + 2 * (v - u) = v + (v - u) by omega]⟩).elim
      · exact blueZero c
  · split
    · rename_i hev
      have hm : (v - u) % 2 = 0 := by simpa using hev
      apply force_ok hs (by omega)
      cases hz : c (u + (v - u) / 2) with
      | false => rfl
      | true =>
        have h := no_ap3 hap u ((v - u) / 2) (by omega) (by omega)
        exact (h ⟨hu, hz, by rwa [show u + 2 * ((v - u) / 2) = v by omega]⟩).elim
    · exact blueZero c

private def banOrd (u v : Nat) : Nat :=
  if u < v then ban3 u v else if v < u then ban3 v u else 0

private theorem banOrd_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {u v : Nat} (hu : u < 233) (hv : v < 233) (hcu : c u = true) (hcv : c v = true) :
    Blue c (banOrd u v) := by
  unfold banOrd
  split
  · exact ban3_ok hs hap ‹_› hv hcu hcv
  · split
    · exact ban3_ok hs hap ‹_› hu hcv hcu
    · exact blueZero c

private def singleEnd (u : Nat) : Nat :=
  let z := (u + 232) / 3
  if (u + 232) % 3 == 0 && z != u && z < 233 then 1 <<< foldPos z else 0

private theorem singleEnd_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {u : Nat} (hu : u < 233) (hcu : c u = true) :
    Blue c (singleEnd u) := by
  unfold singleEnd
  dsimp only
  split
  · rename_i h
    simp only [Bool.and_eq_true, bne_iff_ne, beq_iff_eq, decide_eq_true_eq] at h
    let z := (u + 232) / 3
    have hz : z < 233 := h.2
    have hz3 : 3 * z = u + 232 := by dsimp [z]; omega
    have hzu : z ≠ u := h.1.2
    apply force_ok hs hz
    cases hcz : c z with
    | false => rfl
    | true =>
      have hcz' : c (232 - z) = true := (hs z hz).trans hcz
      by_cases hlt : u < z
      · have hn := no_ap3 hap u (z - u) (by omega) (by omega)
        exact (hn ⟨hcu, by rwa [show u + (z - u) = z by omega],
          by rwa [show u + 2 * (z - u) = 232 - z by omega]⟩).elim
      · have hn := no_ap3 hap (232 - z) (u - z) (by omega) (by omega)
        exact (hn ⟨hcz', by rwa [show 232 - z + (u - z) = z by omega],
          by rwa [show 232 - z + 2 * (u - z) = u by omega]⟩).elim
  · exact blueZero c

private def centerBan (x : Nat) : Nat :=
  if x == 116 then (1 <<< 116) - 1 else 0

private theorem centerBan_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {x : Nat} (hcx : c x = true) : Blue c (centerBan x) := by
  unfold centerBan
  split
  · rename_i h
    have hx : x = 116 := beq_iff_eq.mp h
    subst hx
    intro i hi
    have hlt : i < 116 := by
      by_contra hge
      have hpow : (1 <<< 116) - 1 < 2 ^ i := by
        have h1 : (1 <<< 116) - 1 < 2 ^ 116 := by decide
        have h2 : 2 ^ 116 ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (by omega)
        omega
      have hdiv : ((1 <<< 116) - 1) >>> i = 0 := by
        rw [Nat.shiftRight_eq_div_pow]
        exact Nat.div_eq_of_lt hpow
      rw [Nat.testBit, hdiv] at hi
      simp at hi
    cases hci : c i with
    | false => rfl
    | true =>
      have hn := no_ap3 hap i (116 - i) (by omega) (by omega)
      exact (hn ⟨hci, by rwa [show i + (116 - i) = 116 by omega],
        by rw [show i + 2 * (116 - i) = 232 - i by omega, hs i (by omega), hci]⟩).elim
  · exact blueZero c

private def geom (x y : Nat) : Nat :=
  if x < 117 && y < 117 then
    banOrd x y ||| banOrd x (232 - y) |||
    (if x == y then singleEnd x ||| singleEnd (232 - x) ||| centerBan x else 0)
  else 0

private theorem geom_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {x y : Nat} (hcx : c x = true) (hcy : c y = true) : Blue c (geom x y) := by
  unfold geom
  split
  · rename_i h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    have hcy' : c (232 - y) = true := (hs y (by omega)).trans hcy
    have hcx' : c (232 - x) = true := (hs x (by omega)).trans hcx
    apply blueOr (blueOr (banOrd_ok hs hap (by omega) (by omega) hcx hcy)
      (banOrd_ok hs hap (by omega) (by omega) hcx hcy'))
    split
    · exact blueOr (blueOr (singleEnd_ok hs hap (by omega) hcx)
        (singleEnd_ok hs hap (by omega) hcx'))
        (centerBan_ok hs hap hcx)
    · exact blueZero c
  · exact blueZero c

private def stripe (step len : Nat) : Nat := ((1 <<< (step * len)) - 1) / ((1 <<< step) - 1)

private def stripes : Nat → Nat → Nat
  | 0, _ => 0
  | k + 1, d =>
    let u := (d >>> 14) % 8
    let step := if u = 0 then 116 else if u = 1 then 118 else if u = 2 then 115
      else if u = 3 then 119 else if u = 4 then 233 else if u = 5 then 235
      else if u = 6 then 117 else 1
    let m := stripe step ((d >>> 17) % 128)
    Nat.lor (m <<< (d % 16384)) (stripes k (d >>> 24))

private def mask117 : Nat := (1 <<< 117) - 1

private def cell (v x : Nat) : Nat :=
  if x < 117 then (v >>> (117 * x)) &&& mask117 else 0

private def Compat (c : Nat → Bool) (v : Nat) : Prop :=
  ∀ x, c x = true → Blue c (cell v x)

private theorem compatOr {c a b} (ha : Compat c a) (hb : Compat c b) : Compat c (a ||| b) := by
  intro x hx
  by_cases h : x < 117
  · simpa only [cell, if_pos h, Nat.shiftRight_or_distrib, Nat.and_or_distrib_right] using
      blueOr (ha x hx) (hb x hx)
  · simp [cell, h, blueZero]

private def Hit (c : Nat → Bool) (m : Nat) : Prop :=
  ∃ i, m.testBit i = true ∧ c i = true

private def without (m b : Nat) : Nat := Nat.xor m (Nat.land m b)

private theorem hit_without {c m b} (h : Hit c m) (hb : Blue c b) : Hit c (without m b) := by
  obtain ⟨i, hi, hc⟩ := h
  have hf : b.testBit i = false := by
    cases hx : b.testBit i <;> simp_all [Blue]
  exact ⟨i, by simp [without, Nat.testBit_xor, Nat.testBit_and, hi, hf], hc⟩

