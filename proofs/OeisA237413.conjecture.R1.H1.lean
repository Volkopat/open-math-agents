private theorem large_sound {p : ℕ} (ok : large p = true) : p.Prime := by
  by_cases hs : p ≤ 104729
  · exact (small_iff (p:=p) (by omega)).mp (by simpa [large,hs] using ok)
  · have h : p < 104730*104730 ∧ p.Coprime bigMod := by simpa [large,hs] using ok
    refine Nat.prime_def_le_sqrt.mpr ⟨by omega, ?_⟩
    intro d hd hle hdiv
    have ub : p.sqrt < 104730 := Nat.sqrt_lt.mpr h.1
    have prime := Nat.minFac_prime (by omega : d ≠ 1)
    have db := Nat.minFac_le (by omega : 0 < d)
    have one := Nat.eq_one_of_dvd_coprimes h.2 ((Nat.minFac_dvd d).trans hdiv)
      (prime_divides_mod prime (by omega))
    exact prime.ne_one one

