set_option maxHeartbeats 4000000 in
private theorem small_iff {p : ℕ} (bound : p < 331*331) : small p = true ↔ p.Prime := by
  by_cases hs : p ≤ 330
  · simp [small, hs]
  · simp only [small, if_neg hs, decide_eq_true_eq, fac330_value]
    refine ⟨fun h => Nat.prime_def_le_sqrt.mpr ⟨by omega, ?_⟩,
      fun h => h.coprime_factorial_of_lt (by omega)⟩
    intro d hd hb hdiv
    have hh : p.sqrt < 331 := Nat.sqrt_lt.mpr bound
    have hfac : d ∣ Nat.factorial 330 := Nat.dvd_factorial (by omega) (by omega)
    have := Nat.eq_one_of_dvd_coprimes h hdiv hfac
    omega

