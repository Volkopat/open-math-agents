private theorem prime_divides_mod {p : ℕ} (hp : p.Prime) (hle : p ≤ 104729) : p ∣ bigMod := by
  let i := Nat.count Nat.Prime p
  have hx : Nat.nth Nat.Prime i = p := Nat.nth_count hp
  have last := indexed 9999 (by decide)
  have lastval : primeAt (9999+1) = 104729 := by decide +kernel
  have le : Nat.nth Nat.Prime i ≤ Nat.nth Nat.Prime 9999 := by rw [hx,last,lastval]; exact hle
  have hi := (Nat.nth_le_nth Nat.infinite_setOfPred_prime).mp le
  rw [← hx, indexed i (by omega)]
  exact Nat.dvd_of_mod_eq_zero (beq_iff_eq.mp (allIncluded (i+1) (by omega) (by omega)))

private def large (p : ℕ) :=
  if p ≤ 104729 then small p else decide (p < 104730*104730 ∧ p.Coprime bigMod)

