theorem OMA.solution : OMA.R_OeisA237413_conjecture_R1.H1 := by
  intro n hl hu
  let m := OMA.PrimeSplits.hint n
  let k := n-m
  have h := OMA.PrimeSplits.allSplits n (by omega) (by omega)
  change (decide (0 < m ∧ m < n ∧ 0 < OMA.PrimeSplits.primeAt m ∧ OMA.PrimeSplits.primeAt m ≤ 10000) &&
    OMA.PrimeSplits.goodBits.testBit m && OMA.PrimeSplits.goodBits.testBit k &&
    OMA.PrimeSplits.goodBits.testBit (OMA.PrimeSplits.primeAt m)) = true at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨hm,hmn,hj,hju⟩,hgm⟩,hgk⟩,hgj⟩ := h
  have hkm : n-k=m := by dsimp [k]; omega
  have hpk := OMA.PrimeSplits.good (i:=k) (by dsimp [k]; omega) hgk
  have hpm := OMA.PrimeSplits.good (i:=m) (by omega) hgm
  have hpz := OMA.PrimeSplits.good (i:=OMA.PrimeSplits.primeAt m) ⟨hj,hju⟩ hgj
  have idm := OMA.PrimeSplits.indexed (m-1) (by omega)
  rw [Nat.sub_add_cancel (by omega : 1 ≤ m)] at idm
  apply Finset.sum_pos_iff.mpr
  refine ⟨k, Finset.mem_Ico.mpr (by dsimp [k]; omega), ?_⟩
  change 0 < (if (Nat.nth Nat.Prime (k-1)^2-2).Prime ∧
    (Nat.nth Nat.Prime (n-k-1)^2-2).Prime ∧
    (Nat.nth Nat.Prime (Nat.nth Nat.Prime (n-k-1)-1)^2-2).Prime then 1 else 0)
  rw [hkm]
  have last : (Nat.nth Nat.Prime (Nat.nth Nat.Prime (m-1)-1)^2-2).Prime := idm.symm ▸ hpz
  rw [if_pos ⟨hpk,hpm,last⟩]
  decide
