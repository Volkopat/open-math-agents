private def checkInterval (lo : ℕ) (f : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => f (lo+n) && checkInterval lo f n

private def Span (f : ℕ → Bool) (lo hi : ℕ) := ∀ n, lo ≤ n → n < hi → f n = true
set_option maxRecDepth 5000 in
set_option maxHeartbeats 4000000 in
private theorem of_interval (lo k : ℕ) (f : ℕ → Bool) (h : checkInterval lo f k = true) :
    Span f lo (lo+k) := by
  induction k with
  | zero => intro n hn hu; omega
  | succ k ih =>
    simp only [checkInterval,Bool.and_eq_true] at h
    intro n hn hu
    by_cases he : n = lo+k
    · simpa [he] using h.1
    · exact ih h.2 n hn (by omega)
set_option maxRecDepth 5000 in
set_option maxHeartbeats 4000000 in
private theorem join {f : ℕ → Bool} {a b c : ℕ} (ha : Span f a b) (hb : Span f b c) :
    Span f a c := by
  intro n hl hu
  by_cases h : n < b
  · exact ha _ hl h
  · exact hb _ (by omega) hu

private def link (i : ℕ) :=
  let a := primeAt (i+1)
  let b := primeAt (i+2)
  decide (a < b ∧ b ≤ 104729) && small b &&
    (List.range (b-a-1)).all (fun j => !(small (a+j+1)))

set_option maxRecDepth 5000 in
set_option maxHeartbeats 4000000 in
private theorem step {i : ℕ} (ok : link i = true)
    (h : Nat.nth Nat.Prime i = primeAt (i+1)) :
    Nat.nth Nat.Prime (i+1) = primeAt (i+2) := by
  let a := primeAt (i+1)
  let b := primeAt (i+2)
  change (decide (a < b ∧ b ≤ 104729) && small b &&
    (List.range (b-a-1)).all (fun j => !(small (a+j+1)))) = true at ok
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at ok
  obtain ⟨⟨⟨hab,hb⟩,hpb⟩,gap⟩ := ok
  have pb := (small_iff (p:=b) (by omega)).mp hpb
  change Nat.nth Nat.Prime i = a at h
  have ha : a < Nat.nth Nat.Prime (i+1) := h ▸ Nat.nth_strictMono Nat.infinite_setOfPred_prime (Nat.lt_succ_self i)
  apply le_antisymm
  · by_contra! bad
    have := Nat.le_nth_of_lt_nth_succ bad pb
    omega
  · by_contra! bad
    let x := Nat.nth Nat.Prime (i+1)
    change x < b at bad
    change a < x at ha
    have g := gap (x-a-1) (by omega)
    have ex : a+(x-a-1)+1 = x := by omega
    rw [ex, (small_iff (p:=x) (by omega)).mpr (Nat.prime_nth_prime _)] at g
    contradiction

