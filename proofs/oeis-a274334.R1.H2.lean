private def entry (k : ℕ) : Witness :=
  (entries.find? (fun v => v.key == k)).getD default

private def valid (k : ℕ) : Prop :=
  let v := entry k
  0 < v.w ∧ 0 < v.x ∧ 0 < v.y ∧ 0 < v.z ∧
    k ^ 3 = v.w ^ 3 + v.x ^ 3 + v.y ^ 3 + v.z ^ 3

private instance (k : ℕ) : Decidable (valid k) := by
  unfold valid
  infer_instance

private def exceptions : Finset ℕ :=
  {0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 15, 16, 17, 19, 22, 27, 29, 47, 58, 61, 71}

private theorem ofValid {k : ℕ} (h : valid k) : IsTerm k :=
  ⟨(entry k).w, (entry k).x, (entry k).y, (entry k).z, h⟩

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
private theorem small : ∀ k : Fin 72, k.val ∉ exceptions → valid k.val := by
  decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
private theorem products :
    ∀ a ∈ exceptions, ∀ b ∈ exceptions, 72 ≤ a*b → valid (a*b) := by
  decide +kernel

theorem checked : OMA.R_oeis_a274334_R1.H2 := by
  refine ⟨?_, ?_⟩
  · intro k lower member
    exact ofValid (small ⟨k, lower⟩ member)
  · intro a ha b hb lower
    exact ofValid (products a ha b hb lower)

