lemma U1:∀f:b,0<f->∃D:b,0<D∧∀ᶠa:e in F,aO.l1 a D<f:=by intro f ap;obtain⟨c,Z,bX⟩:=aO.Ov ap;have cE:G (-2*aO.hN*c)<f:=by{apply pz _ bX;apply Real.exp_le_exp.mpr;nlinarith[aO.z4]};let D:b:=4*c;have eE:0<D:=by{dsimp[D];positivity};have U2:∀ᶠa:e in F,c<=aO.oz a D:=by{(have x:=(aO.Hi D).eventually (k0 (show c<D/2 by dsimp[D];linarith)));filter_upwards[x]with a w;exact w.le};have U3:ad (λa:e=>aO.m1 a D*a/(a+1/2:b)) F (nhds (D/2)):=by{have x:=(aO.Hj D).mul (aO.UT 1);simpa only[one_mul,mul_one,ps]using x};have U4:∀ᶠa:e in F,c<=aO.m1 a D*a/(a+1/2:b):=by{(have x:=U3.eventually (k0 (show c<D/2 by dsimp[D];linarith)));filter_upwards[x]with a w;exact w.le};have dg:∀ᶠa:e in F,aO.l1 (2*a) D<f:=by{filter_upwards[bb,U2,aO.TH c Z cE]with a w bu bp;rw[aO.Hb a w];exact(aO.Ha a bu).trans_lt bp};have U5:∀ᶠa:e in F,aO.l1 (2*a+1) D<f:=by{filter_upwards[bb,U4,aO.Odd.US c Z cE]with a w bu bp;rw[aO.Hd,aO.Odd.TY a w];exact(aO.Odd.TZ a bu).trans_lt bp};obtain⟨Ne,hNe⟩:=pT.1 dg;obtain⟨No,hNo⟩:=pT.1 U5;refine⟨D,eE,pT.2 ⟨2*max Ne No+1,?_⟩⟩;intro bE Jm;obtain⟨d,rfl|rfl⟩:=Nat.even_or_odd' bE;{apply hNe;omega};{apply hNo;omega}
lemma U6(Vk:∀f:b,0<f->∃D:b,0<D∧∀ᶠa:e in F,Erdos525.prob a (λA=>D/ac a<Erdos525.m A)<f):type_of%@Erdos525.erdos_525.variants.konyagin:=by intro aI fL;have eG:ad (λa:e=>Erdos525.prob a (λA=>(a:b)^(-1/2+aI:b)<Erdos525.m A)) F (nhds 0):=by{rw[tendsto_order];constructor;{intro f ap;exact Eventually.of_forall λa=>ap.trans_le (by unfold Erdos525.prob;positivity)};{intro f ap;obtain⟨D,eE,fy⟩:=Vk f ap;filter_upwards[UX aI fL D,fy]with a w bp;exact(UV a (λA ct=>w.trans_lt ct)).trans_lt bp}};have a2:=(mT:ad (λ_:e=>(1:b)) F (nhds 1)).sub eG;simp only[f5]at a2;apply a2.congr';exact Eventually.of_forall λa=>(by simpa only[not_lt]using(UW a (λA=>(a:b)^(-1/2+aI:b)<Erdos525.m A)).symm)
end OMA
open OMA in theorem OMA.solution:type_of%@Erdos525.erdos_525.variants.konyagin:=by apply U6;intro f ap;obtain⟨D,eE,bp⟩:=U1 f ap;refine⟨D,eE,?_⟩;simpa only[U0,UZ,aO.l1]using bp
end
