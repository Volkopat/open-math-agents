namespace Ramsey34Atlas

open Finset SimpleGraph

/-- Start of column j in the graph6 edge order. -/
def column (j : Nat) : Nat := j*(j-1)/2

private theorem column_succ (j : Nat) : column (j+1) = column j + j := by
  cases j with
  | zero => decide
  | succ j =>
    change (j+1+1)*(j+1)/2 = (j+1)*j/2+(j+1)
    have h : (j+1+1)*(j+1) = (j+1)*j+2*(j+1) := by ring
    rw [h]
    omega

private theorem column_mono : Monotone column := by
  apply monotone_nat_of_le_succ
  intro j
  rw [column_succ]
  omega

/-- The bit at `j*(j-1)/2+i` encodes edge `(i,j)` for `i<j`. -/
def graphOfMask (n word : Nat) : SimpleGraph (Fin n) where
  Adj i j := i ≠ j ∧ word.testBit (column (max i.val j.val) + min i.val j.val) = true
  symm := ⟨fun i j h => ⟨h.1.symm,by simpa only [max_comm j.val i.val,min_comm j.val i.val] using h.2⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

instance (n word : Nat) : DecidableRel (graphOfMask n word).Adj := by
  intro i j
  change Decidable (i ≠ j ∧ word.testBit (column (max i.val j.val) + min i.val j.val) = true)
  infer_instance

theorem adj_graphOfMask_of_lt {n word : Nat} {i j : Fin n} (h : i < j) :
    (graphOfMask n word).Adj i j ↔ word.testBit (column j.val+i.val) = true := by
  have le : i.val ≤ j.val := h.le
  simp [graphOfMask,h.ne,max_eq_right le,min_eq_left le]

/-- Append a graph6 column with the new vertex at the last position. -/
def extendWord (n word mask : Nat) : Nat := (word % 2^(column n)) ||| (mask <<< column n)

@[simp] theorem adj_extend_last {n word mask : Nat} (i : Fin n) :
    (graphOfMask (n+1) (extendWord n word mask)).Adj i.castSucc (Fin.last n) ↔
      mask.testBit i.val = true := by
  rw [adj_graphOfMask_of_lt (Fin.castSucc_lt_last i)]
  change (extendWord n word mask).testBit (column n+i.val) = true ↔ _
  have hlo : column n ≤ column n + i.val := Nat.le_add_right ..
  have hd : column n + i.val - column n = i.val := by omega
  simp [extendWord,hlo,not_lt.mpr hlo,hd]

@[simp] theorem adj_extend_old {n word mask : Nat} (i j : Fin n) :
    (graphOfMask (n+1) (extendWord n word mask)).Adj i.castSucc j.castSucc ↔
      (graphOfMask n word).Adj i j := by
  have ordered {a b : Fin n} (hab : a < b) :
      (graphOfMask (n+1) (extendWord n word mask)).Adj a.castSucc b.castSucc ↔
        (graphOfMask n word).Adj a b := by
    have le : column (b.val+1) ≤ column n := column_mono b.isLt
    rw [column_succ] at le
    have hab' : a.val < b.val := hab
    have low : column b.val+a.val < column n := by omega
    rw [adj_graphOfMask_of_lt (show a.castSucc < b.castSucc from hab),adj_graphOfMask_of_lt hab]
    change (extendWord n word mask).testBit (column b.val+a.val) = true ↔ _
    simp [extendWord,low,not_le.mpr low]
  rcases lt_trichotomy i j with h | rfl | h
  · exact ordered h
  · simp
  · exact ((graphOfMask (n+1) (extendWord n word mask)).adj_comm i.castSucc j.castSucc).trans
      ((ordered h).trans ((graphOfMask n word).adj_comm j i))

private def encodeMask : (n : Nat) → (Fin n → Bool) → Nat
  | 0, _ => 0
  | n+1, f => encodeMask n (fun i => f i.castSucc) ||| (if f (Fin.last n) then 2^n else 0)

private theorem encodeMask_lt (n : Nat) (f : Fin n → Bool) : encodeMask n f < 2^n := by
  induction n with
  | zero => simp [encodeMask]
  | succ n ih =>
    rw [encodeMask]
    have h : 2^n < 2^(n+1) := by rw [pow_succ]; have := Nat.two_pow_pos n; omega
    apply Nat.or_lt_two_pow ((ih _).trans h)
    split
    · exact h
    · exact Nat.two_pow_pos _

private theorem encodeMask_bit {n : Nat} (f : Fin n → Bool) (i : Fin n) :
    (encodeMask n f).testBit i.val = f i := by
  induction n with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    refine Fin.lastCases ?_ (fun j => ?_) i
    · have clear : (encodeMask n (fun j => f j.castSucc)).testBit n = false :=
        Nat.testBit_lt_two_pow (encodeMask_lt n _)
      rw [encodeMask,Fin.val_last,Nat.testBit_or,clear,Bool.false_or]
      split <;> simp_all [Nat.testBit_two_pow_self]
    · rw [encodeMask,Fin.val_castSucc,Nat.testBit_or,ih]
      split <;> simp_all [Nat.testBit_two_pow_of_ne (Nat.ne_of_gt j.isLt)]

/-- Extend a permutation of the old vertices by fixing the last vertex. -/
def extendEquiv {n : Nat} (e : Fin n ≃ Fin n) : Fin (n+1) ≃ Fin (n+1) where
  toFun := Fin.snoc (fun i => (e i).castSucc) (Fin.last n)
  invFun := Fin.snoc (fun i => (e.symm i).castSucc) (Fin.last n)
  left_inv i := by refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
  right_inv i := by refine Fin.lastCases ?_ (fun j => ?_) i <;> simp

@[simp] theorem extendEquiv_last {n : Nat} (e : Fin n ≃ Fin n) :
    extendEquiv e (Fin.last n) = Fin.last n := by simp [extendEquiv]

@[simp] theorem extendEquiv_castSucc {n : Nat} (e : Fin n ≃ Fin n) (i : Fin n) :
    extendEquiv e i.castSucc = (e i).castSucc := by simp [extendEquiv]

/-- Triangle-free and without an independent set of size four. -/
def Valid {α : Type*} (G : SimpleGraph α) : Prop := G.CliqueFree 3 ∧ Gᶜ.CliqueFree 4

private theorem valid_of_embedding {α β : Type*} {G : SimpleGraph α} {H : SimpleGraph β}
    (e : G ↪g H) (h : Valid H) : Valid G :=
  ⟨h.1.comap e.isContained,h.2.comap (SimpleGraph.Embedding.complEquiv e).isContained⟩

private theorem cliqueFree_iff_checks {n : Nat} (G : SimpleGraph (Fin n)) (k : Nat) :
    G.CliqueFree k ↔ ∀ s ∈ (univ : Finset (Fin n)).powersetCard k, ¬ G.IsClique (s : Set (Fin n)) := by
  constructor
  · intro h s hs hc
    exact h s ⟨hc,(mem_powersetCard.mp hs).2⟩
  · intro h s hs
    exact h s (mem_powersetCard.mpr ⟨subset_univ _,hs.card_eq⟩) hs.isClique

private def decidableCliqueFree {n : Nat} (G : SimpleGraph (Fin n))
    [DecidableRel G.Adj] (k : Nat) : Decidable (G.CliqueFree k) :=
  decidable_of_iff' _ (cliqueFree_iff_checks G k)

instance (n word : Nat) : Decidable (Valid (graphOfMask n word)) :=
  @instDecidableAnd ((graphOfMask n word).CliqueFree 3) ((graphOfMask n word)ᶜ.CliqueFree 4)
    (decidableCliqueFree (graphOfMask n word) 3) (decidableCliqueFree (graphOfMask n word)ᶜ 4)

/-- The atlas contains a graph isomorphic to each valid graph of this order. -/
def Covers (n : Nat) (atlas : List Nat) : Prop :=
  ∀ G : SimpleGraph (Fin n), Valid G → ∃ word ∈ atlas, Nonempty (graphOfMask n word ≃g G)

/-- Every graph on no vertices is represented by the zero word. -/
theorem covers_zero : Covers 0 [0] := by
  intro G _
  have eq : G = graphOfMask 0 0 := by ext i; exact Fin.elim0 i
  subst G
  exact ⟨0,by simp,⟨SimpleGraph.Iso.refl⟩⟩

/-- A smaller atlas and a finite extension certificate imply atlas completeness
at the next order. The relabeling fixes the last vertex. -/
theorem covers_succ {n : Nat} {atlas next : List Nat} (covered : Covers n atlas)
    (step : ∀ word ∈ atlas, ∀ mask < 2^n,
      Valid (graphOfMask (n+1) (extendWord n word mask)) →
        ∃ target ∈ next, Nonempty (graphOfMask (n+1) target ≃g
          graphOfMask (n+1) (extendWord n word mask))) : Covers (n+1) next := by
  classical
  intro G hG
  let H : SimpleGraph (Fin n) := G.comap Fin.castSucc
  have hH : Valid H := valid_of_embedding (SimpleGraph.Embedding.comap Fin.castSuccEmb G) hG
  obtain ⟨word,hw,⟨e⟩⟩ := covered H hH
  let flags (i : Fin n) : Bool := decide (G.Adj (e i).castSucc (Fin.last n))
  let mask := encodeMask n flags
  let E := graphOfMask (n+1) (extendWord n word mask)
  have last (i : Fin n) : G.Adj (e i).castSucc (Fin.last n) ↔ E.Adj i.castSucc (Fin.last n) := by
    change _ ↔ (graphOfMask (n+1) (extendWord n word mask)).Adj _ _
    rw [adj_extend_last, encodeMask_bit flags i]
    simp only [flags, decide_eq_true_eq]
  have relabel : E ≃g G := by
    refine ⟨extendEquiv e.toEquiv,?_⟩
    intro a b
    refine Fin.lastCases ?_ (fun i => ?_) a
    · refine Fin.lastCases ?_ (fun j => ?_) b
      · simp
      · simp only [extendEquiv_last,extendEquiv_castSucc,RelIso.coe_fn_toEquiv]
        exact (G.adj_comm (Fin.last n) (e j).castSucc).trans
          ((last j).trans (E.adj_comm j.castSucc (Fin.last n)))
    · refine Fin.lastCases ?_ (fun j => ?_) b
      · simpa only [extendEquiv_last,extendEquiv_castSucc,RelIso.coe_fn_toEquiv] using last i
      · simp only [extendEquiv_castSucc]
        exact (e.map_adj_iff (v := i) (w := j)).trans (adj_extend_old i j).symm
  obtain ⟨target,ht,⟨e'⟩⟩ := step word hw mask (encodeMask_lt n flags)
    (valid_of_embedding relabel.toEmbedding hG)
  exact ⟨target,ht,⟨relabel.comp e'⟩⟩

end Ramsey34Atlas



