theorem atlas_complete (n : Nat) (bound : n ≤ 9) : Covers n (atlas n) := by
  induction n with
  | zero => exact covers_zero
  | succ n ih =>
    exact covers_succ (ih (by omega)) (check_extension n (allRows n (by omega)))

theorem no_nine (G : SimpleGraph (Fin 9)) (valid : Valid G) : False := by
  obtain ⟨word, mem, _⟩ := atlas_complete 9 (by decide) G valid
  simpa [atlas] using mem

end Ramsey34Atlas

/-- The checked small Ramsey atlas proves the first nested classification step. -/
theorem OMA.solution : OMA.R_RamseyNumbers_ramsey_number_four_five_R1_H1_R1_H1_R1.H1 := by
  refine ⟨fun G hG hC => Ramsey34Atlas.no_nine G ⟨hG,hC⟩, ?_, ?_⟩
  · intro G hG hC
    obtain ⟨word,member,⟨iso⟩⟩ := Ramsey34Atlas.atlas_complete 7 (by decide) G ⟨hG,hC⟩
    refine ⟨word,member,iso.toEquiv,?_⟩
    intro i j hij
    change G.Adj (iso i) (iso j) ↔ _
    exact iso.map_adj_iff.trans (Ramsey34Atlas.adj_graphOfMask_of_lt hij)
  · intro G hG hC
