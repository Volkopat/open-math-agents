namespace Ramsey34Atlas

open Finset SimpleGraph

def chosenLabel (n word : Nat) (v : Fin n) : Fin n :=
  ⟨((word >>> (4*v.val)) % 16) % n, Nat.mod_lt _ v.pos⟩

def extensionGraph (n old mask : Nat) : SimpleGraph (Fin (n+1)) :=
  graphOfMask (n+1) (extendWord n (atlas n)[old]! mask)

def targetGraph (n target : Nat) : SimpleGraph (Fin (n+1)) :=
  graphOfMask (n+1) (atlas (n+1))[target]!

private def badSet (n code : Nat) : Finset (Fin n) :=
  univ.filter fun v => code.testBit v.val = true

def rowCheck (n i mask : Nat) : Prop :=
  let code := witnessCode n i mask
  let dst := (code-1)%16
  let perm := chosenLabel (n+1) ((code-1)/16)
  if code.testBit 39 then
    if code.testBit 9 then (extensionGraph n i mask)ᶜ.IsNClique 4 (badSet (n+1) code)
    else (extensionGraph n i mask).IsNClique 3 (badSet (n+1) code)
  else dst < (atlas (n+1)).length ∧ Function.Injective perm ∧
    ∀ a b, (targetGraph n dst).Adj (perm a) (perm b) ↔ (extensionGraph n i mask).Adj a b

instance (n i mask : Nat) : Decidable (rowCheck n i mask) := by
  unfold rowCheck extensionGraph targetGraph
  dsimp only
  split
  · split <;> infer_instance
  · infer_instance

theorem row_sound (n i mask : Nat) (check : rowCheck n i mask)
    (valid : Valid (extensionGraph n i mask)) :
    ∃ target ∈ atlas (n+1), Nonempty (graphOfMask (n+1) target ≃g extensionGraph n i mask) := by
  let code := witnessCode n i mask
  let dst := (code-1)%16
  let perm := chosenLabel (n+1) ((code-1)/16)
  change (if code.testBit 39 then
    if code.testBit 9 then (extensionGraph n i mask)ᶜ.IsNClique 4 (badSet (n+1) code)
    else (extensionGraph n i mask).IsNClique 3 (badSet (n+1) code)
    else dst < (atlas (n+1)).length ∧ Function.Injective perm ∧
      ∀ a b, (targetGraph n dst).Adj (perm a) (perm b) ↔ (extensionGraph n i mask).Adj a b) at check
  split at check
  · split at check
    · exact False.elim (valid.2 _ check)
    · exact False.elim (valid.1 _ check)
  · obtain ⟨dstBound, injective, law⟩ := check
    let iso : extensionGraph n i mask ≃g targetGraph n dst :=
      { toEquiv := Equiv.ofBijective perm (Finite.injective_iff_bijective.mp injective)
        map_rel_iff' := law _ _ }
    refine ⟨(atlas (n+1))[dst]!, ?_, ⟨iso.symm⟩⟩
    rw [getElem!_pos (atlas (n+1)) dst dstBound]
    exact List.getElem_mem dstBound

theorem check_extension (n : Nat)
    (tabled : ∀ i < (atlas n).length, ∀ mask < 2^n, rowCheck n i mask)
    (old : Nat) (mem : old ∈ atlas n) (mask : Nat) (bound : mask < 2^n)
    (valid : Valid (graphOfMask (n+1) (extendWord n old mask))) :
    ∃ target ∈ atlas (n+1),
      Nonempty (graphOfMask (n+1) target ≃g graphOfMask (n+1) (extendWord n old mask)) := by
  obtain ⟨index, eq⟩ := List.mem_iff_get.mp mem
  have h : (atlas n)[index.val]! = old := by
    rw [getElem!_pos (atlas n) index.val index.isLt]
    exact eq
  have ready : Valid (extensionGraph n index.val mask) := by
    simpa only [extensionGraph, h] using valid
  simpa only [extensionGraph, h] using
    row_sound n index.val mask (tabled _ index.isLt _ bound) ready

end Ramsey34Atlas

