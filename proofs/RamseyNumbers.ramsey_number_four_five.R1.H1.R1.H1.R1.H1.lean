private def gate (n i : Nat) : Bool :=
  (List.range (2^n)).all (fun mask => decide (rowCheck n i mask))

private theorem checked_row {n i : Nat} (check : gate n i = true)
    {mask : Nat} (bound : mask < 2^n) : rowCheck n i mask :=
  of_decide_eq_true (List.all_eq_true.mp check mask (List.mem_range.mpr bound))

