import Mathlib

/-! The inverse certificates use packed rows. The digit sums have no carries. -/

namespace SquareMatrixCertificates

open Finset

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private def digit (w j : ℕ) : ℕ := (w / 64^j) % 64

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private theorem digit_succ (w j : ℕ) : digit w (j+1) = digit (w/64) j := by
  simp only [digit, Nat.div_div_eq_div_mul, pow_succ']

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private theorem sum_split (l : List ℕ) :
    l.sum = (l.map (· % 64)).sum + 64 * (l.map (· / 64)).sum := by
  induction l with
  | nil => rfl
  | cons t l ih =>
    simp only [List.map_cons, List.sum_cons]
    have h := Nat.mod_add_div t 64
    omega

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private theorem digit_sum (l : List ℕ) (j : ℕ)
    (hb : ∀ k ≤ j, (l.map fun w => digit w k).sum < 64) :
    digit l.sum j = (l.map fun w => digit w j).sum := by
  induction j generalizing l with
  | zero =>
    have h := hb 0 le_rfl
    simp only [digit, pow_zero, Nat.div_one] at h ⊢
    rw [sum_split l, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt h]
  | succ j ih =>
    have h := hb 0 (Nat.zero_le _)
    simp only [digit, pow_zero, Nat.div_one] at h
    have hdiv : l.sum / 64 = (l.map (· / 64)).sum := by
      rw [sum_split l, Nat.add_mul_div_left _ _ (by decide : 0 < 64), Nat.div_eq_of_lt h, zero_add]
    rw [digit_succ, hdiv, ih]
    · simp only [List.map_map]
      change (l.map fun w => digit (w/64) j).sum = _
      simp_rw [← digit_succ]
    · intro k hk
      simp only [List.map_map]
      change (l.map fun w => digit (w/64) k).sum < 64
      simp_rw [← digit_succ]
      exact hb (k+1) (Nat.succ_le_succ hk)

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private theorem sum_list_le (l : List ℕ) {b : ℕ} (hb : ∀ x ∈ l, x ≤ b) :
    l.sum ≤ b * l.length := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha := hb a (List.mem_cons_self)
    have hs := ih (fun x hx => hb x (List.mem_cons_of_mem _ hx))
    simp only [List.length_cons, List.sum_cons, Nat.mul_succ]
    omega

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private def validColumn (i j : ℕ) : Bool := (i+j+2).sqrt^2 == i+j+2

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private def columns (n i : ℕ) : List ℕ :=
  (List.range n).filter (validColumn i)

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private def dataWord (W : Array ℕ) (i : ℕ) : ℕ := (W[i]?).getD 0

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private def check (n p : ℕ) (W : Array ℕ) : Bool :=
  (List.range n).all fun i =>
    let cols := columns n i
    let word := (cols.map (dataWord W)).sum
    decide (cols.length ≤ 9) &&
      (List.range n).all (fun j =>
        decide (digit (dataWord W i) j < 8) &&
        (digit word j % p == if i = j then 1 else 0))

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private theorem sum_cols (n i : ℕ) (f : ℕ → ℕ) :
    (∑ j : Fin n, if validColumn i j then f j else 0) =
      ((columns n i).map f).sum := by
  rw [show (∑ j : Fin n, if validColumn i j then f j else 0) =
    ∑ j ∈ range n, if validColumn i j then f j else 0 from
      Fin.sum_univ_eq_sum_range (fun j => if validColumn i j then f j else 0) n]
  have hl : (columns n i).Nodup := (List.nodup_range).filter _
  rw [← List.sum_toFinset _ hl]
  simp only [columns, List.toFinset_filter, List.toFinset_range, sum_filter]

set_option maxRecDepth 30000 in
set_option maxHeartbeats 400000000 in
private theorem det_certificate (n p : ℕ) (W : Array ℕ) (hp : 1 < p)
    (hc : check n p W = true) :
    OeisA228624.a n ≠ 0 := by
  classical
  let : Fact (1 < p) := ⟨hp⟩
  let A : Matrix (Fin n) (Fin n) ℤ :=
    fun i j => if (i.val+j.val+2).sqrt^2 = i.val+j.val+2 then 1 else 0
  let φ := Int.castRingHom (ZMod p)
  let B : Matrix (Fin n) (Fin n) (ZMod p) := fun i j => (digit (dataWord W i) j : ℕ)
  have hrows := List.all_eq_true.mp hc
  have hcheck (i : ℕ) (hi : i < n) := Bool.and_eq_true_iff.mp
    (hrows i (List.mem_range.mpr hi))
  have hsmall (i j : ℕ) (hi : i < n) (hj : j < n) :
      digit (dataWord W i) j < 8 :=
    of_decide_eq_true (Bool.and_eq_true_iff.mp
      (List.all_eq_true.mp (hcheck i hi).2 j (List.mem_range.mpr hj))).1
  have hmul : A.map φ * B = 1 := by
    ext i j
    have hj := j.isLt
    have hi := i.isLt
    let cols := columns n i
    let l := cols.map (dataWord W)
    have hlen : cols.length ≤ 9 := of_decide_eq_true (hcheck i hi).1
    have hd : digit l.sum j = (l.map fun w => digit w j).sum := by
      apply digit_sum
      intro k hk
      have hm := sum_list_le (l.map fun w => digit w k) (b := 7) (by
        intro x hx
        obtain ⟨w,hw,rfl⟩ := List.mem_map.mp hx
        obtain ⟨r,hr,rfl⟩ := List.mem_map.mp hw
        have hrn := List.mem_range.mp ((List.mem_filter.mp hr).1)
        exact Nat.le_of_lt_succ (hsmall r k hrn (by omega)))
      simp only [List.length_map, l] at hm
      change ((cols.map (dataWord W)).map fun w => digit w k).sum < 64
      omega
    have hval : digit l.sum j % p = if i.val = j.val then 1 else 0 :=
      eq_of_beq (Bool.and_eq_true_iff.mp
        (List.all_eq_true.mp (hcheck i hi).2 j (List.mem_range.mpr hj))).2
    have hdot : (A.map φ * B) i j = (↑((l.map fun w => digit w j).sum) : ZMod p) := by
      rw [Matrix.mul_apply]
      have hrow (k : Fin n) :
          (A.map φ) i k * B k j =
            (↑(if validColumn i k then digit (dataWord W k) j else 0 : ℕ) : ZMod p) := by
        change Int.castRingHom (ZMod p)
            (if (i.val+k.val+2).sqrt^2 = i.val+k.val+2 then 1 else 0) *
              (↑(digit (dataWord W k) j) : ZMod p) = _
        by_cases he : (i.val+k.val+2).sqrt^2 = i.val+k.val+2 <;> simp [validColumn, he]
      simp_rw [hrow]
      rw [← Nat.cast_sum, sum_cols n i (fun k => digit (dataWord W k) j)]
      congr 1
      rw [List.map_map]
      rfl
    rw [hdot, ← hd, ← ZMod.natCast_mod, hval, Matrix.one_apply]
    by_cases hh : i = j
    · subst j
      simp
    · have hh' : i.val ≠ j.val := fun h => hh (Fin.ext h)
      simp [hh, hh']
  intro hz
  change A.det = 0 at hz
  have hm := congrArg Matrix.det hmul
  rw [Matrix.det_mul, Matrix.det_one] at hm
  change (φ.mapMatrix A).det * B.det = 1 at hm
  rw [← RingHom.map_det, hz, map_zero, zero_mul] at hm
  exact zero_ne_one hm


