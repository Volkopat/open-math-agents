private theorem primeFlag_sound {n : ℕ} (h : primeFlag n = true) : n.Prime := by
  unfold primeFlag at h
  split at h
  · rename_i hn
    exact smallPrimes_sound ⟨n, by omega⟩ h
  · rename_i hn
    obtain ⟨hr,hg⟩ := of_decide_eq_true h
    by_contra hnp
    have hsq := Nat.minFac_sq_le_self (by omega : 0 < n) hnp
    have hi : n.minFac ≤ 512 := by
      by_contra! hlarge
      have hval := Nat.pow_le_pow_left hlarge 2
      norm_num at hval
      omega
    have hfac := Nat.dvd_factorial (Nat.minFac_pos n) hi
    rw [←denominator_eq] at hfac
    have hdiv := Nat.dvd_gcd (Nat.minFac_dvd n) hfac
    rw [hg] at hdiv
    have := (Nat.minFac_prime (by omega : n ≠ 1)).two_le
    have := Nat.dvd_one.mp hdiv
    omega

