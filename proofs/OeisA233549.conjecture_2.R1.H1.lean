private def phi : ℕ → ℕ → ℕ
  | 0, n => if n = 1 then 1 else 0
  | fuel+1, n =>
    if n = 1 then 1 else
    let p := factorHint n
    if p = 0 then (if primeFlag n then n-1 else 0)
    else
      let q := n / p
      if primeFlag p && p*q == n then (if q % p = 0 then p else p-1) * phi fuel q
      else 0

private theorem phi_sound (fuel n : ℕ) (h : phi fuel n ≠ 0) :
    phi fuel n = n.totient := by
  induction fuel generalizing n with
  | zero =>
    by_cases hn : n = 1 <;> simp_all [phi]
  | succ fuel ih =>
    by_cases hn : n = 1
    · simp [hn, phi]
    simp only [phi, if_neg hn] at h ⊢
    by_cases hp : factorHint n = 0
    · rw [if_pos hp] at h ⊢
      split at h
      · rename_i hP
        simp only [hP, if_true]
        exact (Nat.totient_prime (primeFlag_sound hP)).symm
      · contradiction
    rw [if_neg hp] at h ⊢
    split at h
    · rename_i checked
      rw [if_pos checked]
      obtain ⟨pp,he⟩ := Bool.and_eq_true_iff.mp checked
      have eq := beq_iff_eq.mp he
      have step := ih (n / factorHint n) (fun hz => h (by simp [hz]))
      rw [step]
      split
      · rename_i hd
        have hh := Nat.totient_mul_of_prime_of_dvd (primeFlag_sound pp) (Nat.dvd_of_mod_eq_zero hd)
        rw [eq] at hh
        exact hh.symm
      · rename_i hd
        have hh := Nat.totient_mul_of_prime_of_not_dvd (primeFlag_sound pp)
          (fun hdiv => hd (Nat.mod_eq_zero_of_dvd hdiv))
        rw [eq] at hh
        exact hh.symm
    · contradiction


-- Modular exponentiation uses the radix-64 recurrence in the Erdős 141 certificate.
private def residue (p : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 1
  | h+1, a, n => if n = 0 then 1 else
      (a ^ (n % 64) * (residue p h a (n/64)) ^ 64) % p

private theorem cast_residue (p h a n : ℕ) (hn : n < 64^h) :
    (residue p h a n : ZMod p) = (a : ZMod p)^n := by
  induction h generalizing a n with
  | zero =>
    have : n = 0 := by simpa using hn
    simp [this, residue]
  | succ h ih =>
    by_cases hzero : n = 0
    · simp [hzero, residue]
    rw [pow_succ] at hn
    simp only [residue, if_neg hzero, ZMod.natCast_mod, Nat.cast_mul, Nat.cast_pow,
      ih a (n/64) (by omega), ← pow_mul, ← pow_add]
    congr 1
    omega


private def lucasTest (x a : ℕ) : Bool :=
  let m := x^2 + 1
  let e := x^2
  decide (0 < x ∧ e < 64^8 ∧ residue m 8 a e = 1) &&
    x.primeFactorsList.eraseDups.all (fun q =>
      decide (residue m 8 a (e/q) % m ≠ 1 % m))

private theorem lucasTest_sound {x a : ℕ} (h : lucasTest x a = true) :
    (x^2+1).Prime := by
  simp only [lucasTest, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true,
    List.mem_eraseDups] at h
  obtain ⟨⟨hx, bound, full⟩, parts⟩ := h
  let m := x^2 + 1
  have pred : m - 1 = x^2 := by simp [m]
  apply lucas_primality m (a : ZMod m)
  · rw [pred, ← cast_residue m 8 a _ bound, full, Nat.cast_one]
  · intro q hq hd he
    rw [pred] at hd he
    have hmem := (Nat.mem_primeFactorsList_iff_dvd (by omega : x ≠ 0) hq).mpr
      (hq.dvd_of_dvd_pow hd)
    have divBound := (Nat.div_le_self (x^2) q).trans_lt bound
    rw [← cast_residue m 8 a _ divBound, ← Nat.cast_one (R := ZMod m)] at he
    exact parts q hmem ((ZMod.natCast_eq_natCast_iff ..).mp he)

private def checkRange (test : ℕ → Bool) (a : ℕ) : ℕ → Bool
  | 0 => true
  | len+1 => test (a+len) && checkRange test a len

private theorem checkRange_sound {test : ℕ → Bool} {a len i : ℕ}
    (h : checkRange test a len = true) (lo : a ≤ i) (hi : i < a+len) :
    test i = true := by
  induction len with
  | zero => omega
  | succ len ih =>
    obtain ⟨last, prev⟩ := Bool.and_eq_true_iff.mp h
    by_cases eq : i = a+len
    · exact eq ▸ last
    · exact ih prev (by omega)

private def checked (j : ℕ) : Bool := lucasTest (baseValue j) (generator j)

private def Good (n : ℕ) : Prop :=
  n = 26 ∨ ∃ p < n, p.Prime ∧ Nat.Prime ((p.totient * (n-p).totient)^2 + 1)

private def row (n : ℕ) : Bool :=
  if n = 26 then true else
    let packed := splitWitness n
    let p := packed % 16384
    let j := packed / 16384
    let v := phi 15 (n-p)
    decide (p < n ∧ j < 654 ∧ v ≠ 0 ∧ (p-1)*v = baseValue j) && primeFlag p

private theorem row_sound (primeTable : ∀ j < 654, checked j = true) {n : ℕ}
    (h : row n = true) : Good n := by
  by_cases eq : n = 26
  · exact Or.inl eq
  simp only [row, if_neg eq, Bool.and_eq_true, decide_eq_true_eq] at h
  let p := splitWitness n % 16384
  let j := splitWitness n / 16384
  obtain ⟨⟨hp, hj, hv, he⟩, hprime⟩ := h
  have pp : p.Prime := primeFlag_sound hprime
  refine Or.inr ⟨p, hp, pp, ?_⟩
  rw [Nat.totient_prime pp, ← phi_sound 15 (n-p) hv]
  change (p - 1) * phi 15 (n-p) = baseValue j at he
  rw [he]
