theorem allCheck (i : Fin 280) : check i.val := by
  have hi := i.isLt
  let j := i.val/8
  let r : Fin 8 := ⟨i.val%8, Nat.mod_lt _ (by decide)⟩
  have hq : j < 35 := by dsimp [j]; omega
  have e : i.val = 8*j+r.val := by dsimp [j,r]; omega
  rw [e]
  interval_cases j
