  have hi := i.isLt
  by_cases h : 208 ≤ i.val
  · let r : Fin 2 := ⟨i.val-208, by omega⟩
    have e : i.val = 208+r.val := by dsimp [r]; omega
    rw [e]; exact block26 r
  · let j := i.val/8
    let r : Fin 8 := ⟨i.val%8, Nat.mod_lt _ (by decide)⟩
    have hq : j < 26 := by dsimp [j]; omega
    have e : i.val = 8*j+r.val := by dsimp [j,r]; omega
    rw [e]
    interval_cases j
