import OMAReductions.R_Arxiv_0805_3777_isGenericRank_of_le_critical_R2_H1_R1
import Mathlib

/-! Packed evaluation and field transfer for tangent matrices. -/

namespace OMA.TangentSpan

open Finset Matrix

def pack (base : ℕ) (digit : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => digit 0 + base * pack base (fun i => digit (i+1)) n

theorem pack_sum (base : ℕ) (digit : ℕ → ℕ) (n : ℕ) :
    pack base digit n = ∑ i : Fin n, digit i.val * base^i.val := by
  induction n generalizing digit with
  | zero => simp [pack]
  | succ n ih =>
      rw [pack, ih, Fin.sum_univ_succ]
      simp only [Fin.val_zero, pow_zero, mul_one, Fin.val_succ, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [pow_succ]
      ring

theorem digit_read {base n i : ℕ} (hb : 0 < base) (digit : ℕ → ℕ)
    (bounded : ∀ j < n, digit j < base) (hi : i < n) :
    pack base digit n / base^i % base = digit i := by
  induction n generalizing digit i with
  | zero => omega
  | succ n ih =>
      have h₀ := bounded 0 (by omega)
      have ht : ∀ j < n, digit (j+1) < base := fun j hj => bounded _ (by omega)
      cases i with
      | zero =>
          simp [pack, Nat.add_mod, Nat.mod_eq_of_lt h₀]
      | succ i =>
          rw [pack, pow_succ', ← Nat.div_div_eq_div_mul,
            Nat.add_mul_div_left _ _ hb, Nat.div_eq_of_lt h₀, zero_add]
          exact ih _ ht (by omega)

theorem pack_smul (b n s : ℕ) (f : ℕ → ℕ) :
    s * pack b f n = pack b (fun i => s * f i) n := by
  simp only [pack_sum, Finset.mul_sum, mul_assoc]

theorem distribute3 {I J K : Type*} [Fintype I] [Fintype J] [Fintype K]
    (f : I → ℕ) (g : J → ℕ) (h : K → ℕ) :
    (∑ i, f i) * (∑ j, g j) * (∑ k, h k) = ∑ i, ∑ j, ∑ k, f i * g j * h k := by
  have hf : (∑ i, f i) * (∑ j, g j) = ∑ i, f i * (∑ j, g j) :=
    Finset.sum_mul _ _ _
  rw [hf, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  have hh : f i * (∑ j, g j) = ∑ j, f i * g j :=
    Finset.mul_sum _ _ _
  rw [hh, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  exact Finset.mul_sum _ _ _

theorem pack_congr (b n : ℕ) (f g : ℕ → ℕ) (h : ∀ i < n, f i = g i) :
    pack b f n = pack b g n := by
  simp only [pack_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [h i.val i.isLt]

theorem pack_lt (b n : ℕ) (f : ℕ → ℕ) (h : ∀ i < n, f i < b) :
    pack b f n < b^n := by
  induction n generalizing f with
  | zero => simp [pack]
  | succ n ih =>
      rw [pack, pow_succ']
      have ht := ih (fun i => f (i+1)) (fun i hi => h (i+1) (by omega))
      calc
        _ < b + b * pack b (fun i => f (i+1)) n :=
          Nat.add_lt_add_right (h 0 (by omega)) _
        _ = b * (pack b (fun i => f (i+1)) n + 1) := by ring
        _ ≤ _ := Nat.mul_le_mul_left _ (by omega)

theorem pack_read {b : ℕ} (hb : 0 < b) (n w : ℕ) (hw : w < b^n) :
    pack b (fun i => w / b^i % b) n = w := by
  induction n generalizing w with
  | zero => simpa [pack] using (show 0 = w by simp at hw; omega)
  | succ n ih =>
      rw [pack, pow_zero, Nat.div_one]
      have hq : w / b < b^n := (Nat.div_lt_iff_lt_mul hb).mpr (by simpa [pow_succ] using hw)
      have ht : pack b (fun i => w / b^(i+1) % b) n =
          pack b (fun i => (w/b) / b^i % b) n := by
        apply pack_congr
        intro i _
        rw [pow_succ', Nat.div_div_eq_div_mul]
      rw [ht, ih (w/b) hq, Nat.mod_add_div]

theorem and_read (s i a c : ℕ) :
    (a &&& c) / (2^s)^i % 2^s =
      (a / (2^s)^i % 2^s) &&& (c / (2^s)^i % 2^s) := by
  simp only [← pow_mul, ← Nat.shiftRight_eq_div_pow, Nat.shiftRight_and_distrib,
    Nat.and_mod_two_pow]

theorem pack_and (s n : ℕ) (f g : ℕ → ℕ)
    (hf : ∀ i < n, f i < 2^s) (hg : ∀ i < n, g i < 2^s) :
    (pack (2^s) f n &&& pack (2^s) g n) =
      pack (2^s) (fun i => f i &&& g i) n := by
  have hb : 0 < (2 : ℕ)^s := pow_pos (by decide) _
  let w := pack (2^s) f n &&& pack (2^s) g n
  have hw : w < (2^s)^n := Nat.and_le_right.trans_lt (pack_lt _ _ g hg)
  calc
    w = pack (2^s) (fun i => w / (2^s)^i % 2^s) n := (pack_read hb n _ hw).symm
    _ = _ := by
      apply pack_congr
      intro i hi
      rw [show w = _ from rfl, and_read, digit_read hb f hf hi, digit_read hb g hg hi]

def geom (s n : ℕ) : ℕ := ((1 <<< (s*n)) - 1) / ((1 <<< s) - 1)

theorem geom_eq (s n : ℕ) (hs : 0 < s) :
    geom s n = pack (2^s) (fun _ => 1) n := by
  have hb : 1 < (2 : ℕ)^s := one_lt_pow₀ (by decide) (by omega)
  have hsum := geom_sum_mul_of_one_le (le_of_lt hb) n
  rw [geom, Nat.one_shiftLeft, Nat.one_shiftLeft, pow_mul, ← hsum,
    Nat.mul_div_cancel _ (by omega), pack_sum]
  simp only [one_mul]
  exact (Fin.sum_univ_eq_sum_range (fun i : ℕ => ((2 : ℕ)^s)^i) n).symm

theorem read_mod (w bits off len : ℕ) (h : off+len ≤ bits) :
    w / 2^off % 2^len = (w % 2^bits) / 2^off % 2^len := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [← Nat.shiftRight_eq_div_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]
  by_cases hi : i < len
  · have hl : off+i < bits := by omega
    simp [hi, hl]
  · simp [hi]

def spread (w n step : ℕ) : ℕ :=
  (w * geom (step-3) n) &&& (7 * geom step n)

theorem spread_eq (w n step : ℕ) (hs : 3 ≤ step) (hpos : 0 < step-3)
    (hspace : 3*n ≤ step-3) (hw : w < 2^(3*n)) :
    spread w n step = pack (2^step) (fun i => w / 8^i % 8) n := by
  have hwb : w < 2^(step-3) :=
    hw.trans_le (Nat.pow_le_pow_right (by decide) hspace)
  have hb : 0 < (2:ℕ)^step := pow_pos (by decide) _
  have hb' : 0 < (2:ℕ)^(step-3) := pow_pos (by decide) _
  have h₇ : 7 < (2:ℕ)^step := lt_of_lt_of_le (by decide : 7 < (2:ℕ)^3)
    (Nat.pow_le_pow_right (by decide) hs)
  let wrep := w * geom (step-3) n
  let mask := 7 * geom step n
  have hwm : wrep = pack (2^(step-3)) (fun _ => w) n := by
    simp only [wrep, geom_eq _ _ hpos, pack_smul, mul_one]
  have hm : mask = pack (2^step) (fun _ => 7) n := by
    simp only [mask, geom_eq _ _ (by omega : 0 < step), pack_smul, mul_one]
  have hbound : (wrep &&& mask) < (2^step)^n :=
    Nat.and_le_right.trans_lt (hm.symm ▸ pack_lt _ _ _ (fun _ _ => h₇))
  change (wrep &&& mask) = _
  rw [← pack_read hb n _ hbound]
  apply pack_congr
  intro i hi
  rw [and_read, hm, digit_read hb _ (fun _ _ => h₇) hi]
  have hpow : (2:ℕ)^step = 2^(step-3) * 2^3 := by
    rw [← pow_add]
    congr 1
    omega
  have hdvd : (2:ℕ)^3 ∣ 2^step := pow_dvd_pow 2 hs
  change (wrep / (2^step)^i % 2^step &&& (2^3-1)) = _
  rw [Nat.and_two_pow_sub_one_eq_mod, Nat.mod_mod_of_dvd _ hdvd]
  have hsplit : ((2:ℕ)^step)^i = (2^(step-3))^i * 2^(3*i) := by
    rw [hpow, mul_pow, pow_mul]
  rw [hsplit, ← Nat.div_div_eq_div_mul]
  have hcut : 3*i+3 ≤ step-3 := by omega
  rw [read_mod _ _ _ _ hcut]
  have hread : wrep/(2^(step-3))^i % 2^(step-3) = w := by
    rw [hwm]
    exact digit_read hb' _ (fun _ _ => hwb) hi
  rw [hread, pow_mul]
  rfl

def read (word i : ℕ) : ℕ := word / 8^i % 8

def slice (word start size : ℕ) : ℕ := (word / 8^start) % 2^(3*size)

theorem slice_read (word start size i : ℕ) (hi : i < size) :
    read (slice word start size) i = read word (start+i) := by
  have he : (8:ℕ)^i = 2^(3*i) := by rw [pow_mul]; rfl
  change (word / 8^start % 2^(3*size)) / 8^i % (2^3) = word / 8^(start+i) % (2^3)
  rw [he, ← read_mod _ _ _ _ (by omega : 3*i+3 ≤ 3*size), ← he,
    Nat.div_div_eq_div_mul, ← pow_add]

theorem slice_spread (w start n step : ℕ) (hs : 3 ≤ step)
    (hpos : 0 < step-3) (hspace : 3*n ≤ step-3) :
    spread (slice w start n) n step =
      pack (2^step) (fun i => read w (start+i)) n := by
  have hw : slice w start n < 2^(3*n) := Nat.mod_lt _ (pow_pos (by decide) _)
  rw [spread_eq _ _ _ hs hpos hspace hw]
  exact pack_congr _ _ _ _ fun i hi => slice_read w start n i hi

theorem complexLift {I V : Type*} [Fintype I] [Fintype V] [DecidableEq I]
    (A : Matrix I V ℤ) (b : I → V → ZMod 2)
    (hb : ∀ i j, (A.map (fun z : ℤ => (z : ZMod 2))).mulVec (b i) j =
      if j = i then 1 else 0) :
    Function.Surjective (A.map (fun z : ℤ => (z : ℂ))).mulVec := by
  let B : Matrix V I ℤ := Matrix.of fun v i => ((b i v).val : ℤ)
  have hmod : (A * B).map (fun z : ℤ => (z : ZMod 2)) = 1 := by
    ext i j
    simp only [Matrix.map_apply, Matrix.mul_apply, Int.cast_sum, Int.cast_mul, B,
      Matrix.of_apply, Int.cast_natCast, ZMod.natCast_zmod_val, Matrix.one_apply]
    exact hb j i
  have hdet : ((A * B).det : ZMod 2) = 1 := by
    rw [Int.cast_det, hmod, Matrix.det_one]
  have hInt : (A * B).det ≠ 0 := by
    intro h
    rw [h, Int.cast_zero] at hdet
    exact (by decide : (0 : ZMod 2) ≠ 1) hdet
  let AC := A.map fun z : ℤ => (z : ℂ)
  let BC := B.map fun z : ℤ => (z : ℂ)
  have hcast : ((A * B).det : ℂ) = (AC * BC).det := by
    rw [Int.cast_det]
    change ((A * B).map (Int.castRingHom ℂ)).det =
      (A.map (Int.castRingHom ℂ) * B.map (Int.castRingHom ℂ)).det
    rw [Matrix.map_mul]
  have hComplex : (AC * BC).det ≠ 0 := by
    rw [← hcast]
    exact Int.cast_ne_zero.mpr hInt
  have hUnit : IsUnit (AC*BC) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hComplex)
  intro T
  obtain ⟨v,hv⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hUnit T
  exact ⟨BC.mulVec v, (Matrix.mulVec_mulVec v AC BC).trans hv⟩

end OMA.TangentSpan

namespace OMA.TangentSpan

open Finset Matrix

structure Layout where
  a : ℕ
  b : ℕ
  c : ℕ
  samples : ℕ
  positiveB : 0 < b
  positiveC : 0 < c
  fitsX : 3*a ≤ 32*(b*c)-3
  fitsY : 3*b ≤ 32*c-3
  fitsZ : 3*c ≤ 29
  small : samples ≤ 25

def Layout.rows (d : Layout) : ℕ := d.a*(d.b*d.c)
def Layout.width (d : Layout) : ℕ := d.a+d.b+d.c

abbrev Axes (d : Layout) := Fin d.a × Fin d.b × Fin d.c
abbrev XT (d : Layout) := Fin d.samples → Fin d.a → ℕ
abbrev YT (d : Layout) := Fin d.samples → Fin d.b → ℕ
abbrev ZT (d : Layout) := Fin d.samples → Fin d.c → ℕ
abbrev Words := ℕ → ℕ

def index (d : Layout) (q : Axes d) : ℕ :=
  (d.b*d.c)*q.1.val+d.c*q.2.1.val+q.2.2.val

def axisWord {n : ℕ} (step : ℕ) (f : Fin n → ℕ) : ℕ :=
  ∑ i, f i * ((2 : ℕ)^32)^(step*i.val)

theorem separable (d : Layout) (x : Fin d.a → ℕ) (y : Fin d.b → ℕ) (z : Fin d.c → ℕ) :
    axisWord (d.b*d.c) x * axisWord d.c y * axisWord 1 z =
      ∑ q : Axes d, (x q.1 * y q.2.1 * z q.2.2) * ((2:ℕ)^32)^(index d q) := by
  simp only [axisWord]
  rw [distribute3]
  simp only [index, Fintype.sum_prod_type, pow_add, one_mul]
  refine sum_congr rfl (fun i _ => sum_congr rfl fun j _ => sum_congr rfl fun k _ => ?_)
  ac_rfl

def coefficients (d : Layout) (x : XT d) (y : YT d) (z : ZT d)
    (u : XT d) (v : YT d) (w : ZT d) (q : Axes d) : ℕ :=
  ∑ t, (u t q.1*y t q.2.1*z t q.2.2+x t q.1*v t q.2.1*z t q.2.2+
    x t q.1*y t q.2.1*w t q.2.2)

def packedProduct (d : Layout) (x : XT d) (y : YT d) (z : ZT d)
    (u : XT d) (v : YT d) (w : ZT d) : ℕ :=
  ∑ t, (axisWord (d.b*d.c) (u t)*axisWord d.c (y t)*axisWord 1 (z t)+
    axisWord (d.b*d.c) (x t)*axisWord d.c (v t)*axisWord 1 (z t)+
    axisWord (d.b*d.c) (x t)*axisWord d.c (y t)*axisWord 1 (w t))

theorem packedProduct_eq (d : Layout) (x : XT d) (y : YT d) (z : ZT d)
    (u : XT d) (v : YT d) (w : ZT d) :
    packedProduct d x y z u v w =
      ∑ q : Axes d, (coefficients d x y z u v w q) * ((2:ℕ)^32)^(index d q) := by
  unfold packedProduct coefficients
  simp only [separable, ← sum_add_distrib]
  rw [sum_comm]
  apply sum_congr rfl
  intro q _
  simp only [sum_mul, add_mul]

def rowIndex (d : Layout) : Axes d ≃ Fin d.rows :=
  (Equiv.prodCongr (Equiv.refl (Fin d.a)) (@finProdFinEquiv d.b d.c)).trans finProdFinEquiv

theorem rowIndex_val (d : Layout) (q : Axes d) : (rowIndex d q).val = index d q := by
  rcases q with ⟨i,j,k⟩
  change k.val+d.c*j.val+(d.b*d.c)*i.val = (d.b*d.c)*i.val+d.c*j.val+k.val
  ac_rfl

def rowCoeff (d : Layout) (x : XT d) (y : YT d) (z : ZT d)
    (u : XT d) (v : YT d) (w : ZT d) (i : ℕ) : ℕ :=
  if hi : i < d.rows then coefficients d x y z u v w ((rowIndex d).symm ⟨i,hi⟩) else 0

theorem packed_rows (d : Layout) (x : XT d) (y : YT d) (z : ZT d)
    (u : XT d) (v : YT d) (w : ZT d) :
    packedProduct d x y z u v w = pack (2^32) (rowCoeff d x y z u v w) d.rows := by
  rw [packedProduct_eq, pack_sum, ← Equiv.sum_comp (rowIndex d)]
  apply sum_congr rfl
  intro q _
  rw [← rowIndex_val d q, rowCoeff, dif_pos (rowIndex d q).isLt]
  rw [show (⟨(rowIndex d q).val,(rowIndex d q).isLt⟩ : Fin d.rows) = rowIndex d q from rfl,
    Equiv.symm_apply_apply]

def expandAxis (size step word start : ℕ) : ℕ :=
  spread (slice word start size) size (32*step)

theorem expandAxis_eq (size step word start : ℕ) (h : 0 < step) (space : 3*size ≤ 32*step-3) :
    expandAxis size step word start = axisWord step (fun i : Fin size => read word (start+i.val)) := by
  rw [expandAxis, slice_spread _ _ _ _ (by omega) (by omega) space, pack_sum, axisWord]
  apply sum_congr rfl
  intro i _
  rw [← pow_mul, ← pow_mul, Nat.mul_assoc]

def tangentTerm (d : Layout) (X Y Z : Words) (v t : ℕ) : ℕ :=
  let x := expandAxis d.a (d.b*d.c) (X t) 0
  let y := expandAxis d.b d.c (Y t) 0
  let z := expandAxis d.c 1 (Z t) 0
  let u' := expandAxis d.a (d.b*d.c) v (d.width*t)
  let v' := expandAxis d.b d.c v (d.width*t+d.a)
  let w' := expandAxis d.c 1 v (d.width*t+d.a+d.b)
  u'*y*z+x*v'*z+x*y*w'

def fastProduct (d : Layout) (X Y Z : Words) (v : ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => fastProduct d X Y Z v n + tangentTerm d X Y Z v n

def xAt (d : Layout) (X : Words) (t : Fin d.samples) (i : Fin d.a) : ℕ := read (X t.val) i.val
def yAt (d : Layout) (Y : Words) (t : Fin d.samples) (i : Fin d.b) : ℕ := read (Y t.val) i.val
def zAt (d : Layout) (Z : Words) (t : Fin d.samples) (i : Fin d.c) : ℕ := read (Z t.val) i.val
def uAt (d : Layout) (v : ℕ) (t : Fin d.samples) (i : Fin d.a) : ℕ := read v (d.width*t.val+i.val)
def vAt (d : Layout) (v : ℕ) (t : Fin d.samples) (i : Fin d.b) : ℕ := read v (d.width*t.val+d.a+i.val)
def wAt (d : Layout) (v : ℕ) (t : Fin d.samples) (i : Fin d.c) : ℕ := read v (d.width*t.val+d.a+d.b+i.val)

theorem fastProduct_eq (d : Layout) (X Y Z : Words) (v : ℕ) :
    fastProduct d X Y Z v d.samples = packedProduct d (xAt d X) (yAt d Y) (zAt d Z)
      (uAt d v) (vAt d v) (wAt d v) := by
  have h (n : ℕ) : fastProduct d X Y Z v n = ∑ t ∈ range n, tangentTerm d X Y Z v t := by
    induction n with
    | zero => simp [fastProduct]
    | succ n ih => rw [fastProduct, sum_range_succ, ih]
  rw [h, ← Fin.sum_univ_eq_sum_range (tangentTerm d X Y Z v) d.samples, packedProduct]
  apply sum_congr rfl
  intro t _
  have hprod := Nat.mul_pos d.positiveB d.positiveC
  simp only [tangentTerm,
    expandAxis_eq d.a (d.b*d.c) _ _ hprod d.fitsX,
    expandAxis_eq d.b d.c _ _ d.positiveC d.fitsY,
    expandAxis_eq d.c 1 _ _ (by decide) d.fitsZ, Nat.zero_add]
  rfl

end OMA.TangentSpan

namespace OMA.TangentSpan

open Finset Matrix

private theorem read_le (w i : ℕ) : read w i ≤ 7 :=
  Nat.le_of_lt_succ (Nat.mod_lt _ (by decide))

private theorem correction {n : ℕ} (r : Fin n) :
    pack (2^32) (fun i => if i = r.val then 1 else 0) n = ((2:ℕ)^32)^r.val := by
  rw [pack_sum]
  simp only [← Fin.ext_iff, ite_mul, zero_mul, one_mul, sum_ite_eq', mem_univ, if_true]

private theorem coefficients_bound (d : Layout) (X Y Z : Words) (word : ℕ) (a : Axes d) :
    coefficients d (xAt d X) (yAt d Y) (zAt d Z) (uAt d word) (vAt d word) (wAt d word) a ≤ 25725 := by
  unfold coefficients
  calc
    _ ≤ ∑ _ : Fin d.samples, 1029 := by
      apply sum_le_sum
      intro t _
      simp only [xAt, yAt, zAt, uAt, vAt, wAt]
      calc
        _ ≤ (7*7*7 + 7*7*7 + 7*7*7 : ℕ) := by gcongr <;> exact read_le _ _
        _ = _ := by decide
    _ = d.samples*1029 := by simp
    _ ≤ _ := by have h := d.small; omega

def verified (d : Layout) (word r : ℕ) : Prop :=
  word &&& geom 32 d.rows = ((2:ℕ)^32)^r

private theorem modularBasis (d : Layout) (X Y Z : Words) (r : Fin d.rows) (word : ℕ)
    (h : verified d (fastProduct d X Y Z word d.samples) r.val) (q : Axes d) :
      (coefficients d (xAt d X) (yAt d Y) (zAt d Z) (uAt d word) (vAt d word) (wAt d word) q :
        ZMod 2) = if rowIndex d q = r then 1 else 0 := by
  let f := rowCoeff d (xAt d X) (yAt d Y) (zAt d Z) (uAt d word) (vAt d word) (wAt d word)
  have hb j (hj : j < d.rows) : f j < (2:ℕ)^32 := by
    change rowCoeff d _ _ _ _ _ _ j < _
    rw [rowCoeff, dif_pos hj]
    exact (coefficients_bound d X Y Z word ((rowIndex d).symm ⟨j,hj⟩)).trans_lt (by decide)
  unfold verified at h
  rw [fastProduct_eq, packed_rows, geom_eq _ _ (by decide), ← correction r,
    pack_and 32 d.rows f _ hb (fun _ _ => by decide)] at h
  let i := rowIndex d q
  have e := congrArg (fun t : ℕ => t / ((2:ℕ)^32)^i.val % 2^32) h
  have hc : ∀ j < d.rows, f j &&& 1 < (2:ℕ)^32 :=
    fun j hj => Nat.and_le_left.trans_lt (hb j hj)
  have hd : ∀ j < d.rows, (if j = r.val then 1 else 0) < (2:ℕ)^32 := by
    intro j _
    split <;> decide
  rw [digit_read (by decide) _ hc i.isLt, digit_read (by decide) _ hd i.isLt,
    show f i.val &&& 1 = f i.val % 2 from Nat.and_two_pow_sub_one_eq_mod _ 1] at e
  have hfe : f i.val = coefficients d (xAt d X) (yAt d Y) (zAt d Z) (uAt d word)
      (vAt d word) (wAt d word) q := by
    change rowCoeff d _ _ _ _ _ _ i.val = _
    rw [rowCoeff, dif_pos i.isLt,
      show (⟨i.val,i.isLt⟩ : Fin d.rows) = i from rfl, show i = rowIndex d q from rfl,
      Equiv.symm_apply_apply]
  have eq := congrArg (fun a : ℕ => (a : ZMod 2)) e
  simpa only [ZMod.natCast_mod, Nat.cast_ite, Nat.cast_one, Nat.cast_zero, ← Fin.ext_iff,
    hfe, i] using eq

abbrev Var (d : Layout) := Fin d.samples × (Fin d.a ⊕ Fin d.b ⊕ Fin d.c)

def entry (d : Layout) (X Y Z : Words) (q : Axes d) (j : Var d) : ℕ :=
  match j.2 with
  | .inl i => if q.1 = i then yAt d Y j.1 q.2.1*zAt d Z j.1 q.2.2 else 0
  | .inr (.inl i) => if q.2.1 = i then xAt d X j.1 q.1*zAt d Z j.1 q.2.2 else 0
  | .inr (.inr i) => if q.2.2 = i then xAt d X j.1 q.1*yAt d Y j.1 q.2.1 else 0

def mat (d : Layout) (X Y Z : Words) : Matrix (Axes d) (Var d) ℤ :=
  Matrix.of fun i j => (entry d X Y Z i j : ℤ)

private theorem mat_eval (R : Type*) [CommRing R] (d : Layout) (X Y Z : Words)
    (v : Var d → R) (q : Axes d) :
    ((mat d X Y Z).map (fun z : ℤ => (z : R))).mulVec v q =
      ∑ t, (v (t,.inl q.1)*((yAt d Y t q.2.1 : R)*(zAt d Z t q.2.2 : R)) +
        (xAt d X t q.1 : R)*(v (t,.inr (.inl q.2.1))*(zAt d Z t q.2.2 : R)) +
        (xAt d X t q.1 : R)*((yAt d Y t q.2.1 : R)*v (t,.inr (.inr q.2.2)))) := by
  simp only [Matrix.mulVec, dotProduct, Fintype.sum_prod_type, Fintype.sum_sum_type]
  apply sum_congr rfl
  intro t _
  simp only [mat, Matrix.map_apply, Matrix.of_apply, entry, Int.cast_ite, Int.cast_mul, Int.cast_zero,
    Int.cast_natCast, Nat.cast_ite, Nat.cast_mul, Nat.cast_zero, ite_mul, zero_mul, sum_ite_eq,
    mem_univ, if_true]
  ring

def asBasis (d : Layout) (a : ℕ) (j : Var d) : ZMod 2 :=
  match j.2 with
  | .inl i => uAt d a j.1 i
  | .inr (.inl i) => vAt d a j.1 i
  | .inr (.inr i) => wAt d a j.1 i

private theorem basis_eval (d : Layout) (X Y Z : Words) (w : ℕ) (r : Axes d) :
    ((mat d X Y Z).map (fun z : ℤ => (z : ZMod 2))).mulVec (asBasis d w) r =
      (coefficients d (xAt d X) (yAt d Y) (zAt d Z) (uAt d w) (vAt d w) (wAt d w) r : ZMod 2) := by
  rw [mat_eval]
  simp only [asBasis, coefficients, Nat.cast_sum, Nat.cast_add, Nat.cast_mul, mul_assoc, mul_left_comm]

theorem exactWitness (d : Layout) (X Y Z : Words) (words : ℕ → ℕ)
    (hp : ∀ r : Fin d.rows, verified d (fastProduct d X Y Z (words r.val) d.samples) r.val) :
    ∃ x : Fin d.samples → Fin d.a → ℂ, ∃ y : Fin d.samples → Fin d.b → ℂ,
    ∃ z : Fin d.samples → Fin d.c → ℂ,
      ∀ T : Fin d.a → Fin d.b → Fin d.c → ℂ, ∃ u : Fin d.samples → Fin d.a → ℂ,
        ∃ v : Fin d.samples → Fin d.b → ℂ, ∃ w : Fin d.samples → Fin d.c → ℂ,
          ∀ i j k, T i j k = ∑ t, (u t i*(y t j*z t k)+x t i*(v t j*z t k)+x t i*(y t j*w t k)) := by
  let v (p : Axes d) := asBasis d (words (rowIndex d p).val)
  have modEq (p q : Axes d) :
      ((mat d X Y Z).map (fun z : ℤ => (z : ZMod 2))).mulVec (v p) q =
        if q = p then 1 else 0 := by
    change ((mat d X Y Z).map (fun z : ℤ => (z : ZMod 2))).mulVec
      (asBasis d (words (rowIndex d p).val)) q = _
    rw [basis_eval, modularBasis d X Y Z (rowIndex d p) _ (hp (rowIndex d p))]
    simp [(rowIndex d).injective.eq_iff]
  have surj := complexLift (mat d X Y Z) v modEq
  refine ⟨fun t i => (xAt d X t i : ℂ), fun t j => (yAt d Y t j : ℂ), fun t k => (zAt d Z t k : ℂ), ?_⟩
  intro T
  obtain ⟨v,hv⟩ := surj (fun r => T r.1 r.2.1 r.2.2)
  refine ⟨fun t i => v (t,.inl i), fun t j => v (t,.inr (.inl j)), fun t k => v (t,.inr (.inr k)), ?_⟩
  intro i j k
  have h := congrFun hv (i,j,k)
  rw [mat_eval] at h
  exact h.symm

end OMA.TangentSpan

