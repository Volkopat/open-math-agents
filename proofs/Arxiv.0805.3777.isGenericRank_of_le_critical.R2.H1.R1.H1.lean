theorem allCheck (i : Fin 150) : check i.val := by
  have hi := i.isLt
  by_cases h : 144 ≤ i.val
  · let r : Fin 6 := ⟨i.val-144, by omega⟩
    have e : i.val = 144+r.val := by dsimp [r]; omega
    rw [e]; exact block18 r
  · let j := i.val/8
    let r : Fin 8 := ⟨i.val%8, Nat.mod_lt _ (by decide)⟩
    have hq : j < 18 := by dsimp [j]; omega
    have e : i.val = 8*j+r.val := by dsimp [j,r]; omega
    rw [e]
    interval_cases j
    · exact block00 r
    · exact block01 r
    · exact block02 r
    · exact block03 r
