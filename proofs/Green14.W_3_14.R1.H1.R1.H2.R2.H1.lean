import OMAReductions.R_Green14_W_3_14_R1_H1_R1_H2_R2

/-! Bit-parallel verification on the interval [0,182], adapted from
Green14.W_3_14.R1.H3.R1.H3. Every 256-bit lane holds one coloring. -/

namespace Green183SIMD

def Goal (N : Nat) (c : Nat → Bool) : Prop :=
  ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13) * d < N ∧
    ∀ t : Fin 14, t.val ≤ (if b then 2 else 13) → c (a + t.val * d) = b

def Bit (m i : Nat) : Prop := m.testBit i = true

@[simp] lemma bit_or {a b i} : Bit (a ||| b) i ↔ Bit a i ∨ Bit b i := by
  simp [Bit]

@[simp] lemma bit_and {a b i} : Bit (a &&& b) i ↔ Bit a i ∧ Bit b i := by
  simp [Bit]

@[simp] lemma bit_down {a k i} : Bit (a >>> k) i ↔ Bit a (i + k) := by
  simp [Bit, Nat.add_comm]

lemma bit_up {a k i} : Bit (a <<< k) i ↔ k ≤ i ∧ Bit a (i - k) := by
  simp [Bit]

def low (n : Nat) : Nat := Nat.sub (Nat.shiftLeft 1 n) 1

@[simp] lemma bit_low {n i} : Bit (low n) i ↔ i < n := by
  change ((1 <<< n) - 1).testBit i = true ↔ _
  simp [Nat.shiftLeft_eq]

def joinBits (k a b : Nat) : Nat :=
  Nat.lor (Nat.land a (low k)) (Nat.shiftLeft b k)

lemma join_lo {k a b i} (hi : i < k) : Bit (joinBits k a b) i ↔ Bit a i := by
  change Bit ((a &&& low k) ||| (b <<< k)) i ↔ Bit a i
  simp [bit_up, hi, Nat.not_le_of_gt hi]

lemma join_hi {k a b i} (hi : k ≤ i) : Bit (joinBits k a b) i ↔ Bit b (i - k) := by
  change Bit ((a &&& low k) ||| (b <<< k)) i ↔ Bit b (i - k)
  simp [bit_up, hi, Nat.not_lt_of_ge hi]

def tiles : Nat → Nat → Nat
  | 0, m => m
  | n + 1, m =>
    let v := tiles n m
    Nat.lor v (Nat.shiftLeft v (Nat.shiftLeft 256 n))

lemma tiles_shift_eq (n : Nat) : Nat.shiftLeft 256 n = 256 * 2 ^ n := by
  change 256 <<< n = 256 * 2 ^ n
  rw [Nat.shiftLeft_eq]

lemma tiles_bound (n : Nat) {m : Nat} (hm : m < 2 ^ 256) : tiles n m < 2 ^ (256 * 2 ^ n) := by
  induction n with
  | zero => simpa [tiles] using hm
  | succ n ih =>
    rw [tiles, tiles_shift_eq]
    change (tiles n m ||| (tiles n m <<< (256 * 2 ^ n))) < _
    apply Nat.or_lt_two_pow
    · exact lt_of_lt_of_le ih (Nat.pow_le_pow_right (by decide) (by simp [Nat.pow_succ]))
    · rw [Nat.shiftLeft_eq, Nat.pow_succ, show 256 * (2 ^ n * 2) = 256 * 2 ^ n + 256 * 2 ^ n by omega, Nat.pow_add]
      exact Nat.mul_lt_mul_of_pos_right ih (Nat.two_pow_pos _)

lemma tile_bit (n : Nat) {m j x : Nat} (hm : m < 2 ^ 256) (hj : j < 2 ^ n) (hx : x < 256) :
    Bit (tiles n m) (256 * j + x) ↔ Bit m x := by
  induction n generalizing j with
  | zero =>
    have : j = 0 := by simpa using hj
    simp [tiles, this]
  | succ n ih =>
    rw [tiles, tiles_shift_eq]
    change Bit (tiles n m ||| (tiles n m <<< (256 * 2 ^ n))) (256 * j + x) ↔ Bit m x
    rw [bit_or, bit_up]
    by_cases h : j < 2 ^ n
    · have hlt : 256 * j + x < 256 * 2 ^ n := by omega
      simp [Nat.not_le_of_gt hlt, ih h]
    · have hh : j - 2 ^ n < 2 ^ n := by rw [Nat.pow_succ] at hj; omega
      have hle : 256 * 2 ^ n ≤ 256 * j + x := by omega
      have hzero : ¬ Bit (tiles n m) (256 * j + x) := by
        have hbound := lt_of_lt_of_le (tiles_bound n hm) (Nat.pow_le_pow_right (by decide : 0 < 2) hle)
        simp [Bit, Nat.testBit_lt_two_pow hbound]
      simp only [hzero, false_or, hle, true_and]
      rw [show 256 * j + x - 256 * 2 ^ n = 256 * (j - 2 ^ n) + x by omega]
      exact ih hh

def AtBit (j m x : Nat) : Prop := Bit m (256 * j + x)

def Fact (N : Nat) (c : Nat → Bool) (b : Bool) (j m : Nat) : Prop :=
  ∀ x, x < N → AtBit j m x → c x = b

lemma fact_or {N c b j a d} (fa : Fact N c b j a) (fd : Fact N c b j d) :
    Fact N c b j (Nat.lor a d) :=
  fun x hx h => (bit_or.mp h).elim (fa x hx) (fd x hx)

lemma fact_and_left {N c b j a d} (fa : Fact N c b j a) : Fact N c b j (Nat.land a d) :=
  fun x hx h => fa x hx (bit_and.mp h).1

def Masked (N g m : Nat) : Prop :=
  ∀ j x, j < 2 ^ g → N ≤ x → x < 256 → ¬ AtBit j m x

lemma low_lt_256 {N : Nat} (hN : N ≤ 183) : low N < 2 ^ 256 := by
  change (1 <<< N) - 1 < 2 ^ 256
  rw [Nat.shiftLeft_eq, one_mul]
  have h1 : 2 ^ N ≤ 2 ^ 183 := Nat.pow_le_pow_right (by decide) hN
  have h2 : 2 ^ 183 < 2 ^ 256 := Nat.pow_lt_pow_right (by decide) (by decide)
  omega

lemma masked_M (N g : Nat) (hN : N ≤ 183) : Masked N g (tiles g (low N)) := by
  intro j x hj hlo hhi h
  have := bit_low.mp ((tile_bit g (low_lt_256 hN) hj hhi).mp h)
  omega

lemma masked_and_M {N g m : Nat} (hN : N ≤ 183) :
    Masked N g (Nat.land m (tiles g (low N))) :=
  fun j x hj hlo hhi h => masked_M N g hN j x hj hlo hhi (bit_and.mp h).2

lemma masked_and_left {N g a b : Nat} (ha : Masked N g a) : Masked N g (Nat.land a b) :=
  fun j x hj hlo hhi h => ha j x hj hlo hhi (bit_and.mp h).1

lemma masked_or {N g a b : Nat} (ha : Masked N g a) (hb : Masked N g b) :
    Masked N g (Nat.lor a b) :=
  fun j x hj hlo hhi h => (bit_or.mp h).elim (ha j x hj hlo hhi) (hb j x hj hlo hhi)

def shR1 (M k m : Nat) : Nat := Nat.land (Nat.shiftRight m k) M
def shL1 (M k m : Nat) : Nat := Nat.land (Nat.shiftLeft m k) M

def shR (M k m : Nat) : Nat :=
  match Nat.ble k 73 with
  | true => shR1 M k m
  | false => shR1 M (Nat.sub k 73) (shR1 M 73 m)

def shL (M k m : Nat) : Nat :=
  match Nat.ble k 73 with
  | true => shL1 M k m
  | false => shL1 M (Nat.sub k 73) (shL1 M 73 m)

lemma masked_shR1 {N g k m : Nat} (hN : N ≤ 183) :
    Masked N g (shR1 (tiles g (low N)) k m) := masked_and_M hN

lemma masked_shL1 {N g k m : Nat} (hN : N ≤ 183) :
    Masked N g (shL1 (tiles g (low N)) k m) := masked_and_M hN

lemma masked_shR {N g k m : Nat} (hN : N ≤ 183) :
    Masked N g (shR (tiles g (low N)) k m) := by
  unfold shR; cases Nat.ble k 73 <;> exact masked_and_M hN

lemma masked_shL {N g k m : Nat} (hN : N ≤ 183) :
    Masked N g (shL (tiles g (low N)) k m) := by
  unfold shL; cases Nat.ble k 73 <;> exact masked_and_M hN

lemma shR1_at {N g k m j x : Nat} (hN : N ≤ 183) (hj : j < 2 ^ g) (hx : x < N) (hk : k ≤ 73)
    (hm : Masked N g m) (h : AtBit j (shR1 (tiles g (low N)) k m) x) :
    x + k < N ∧ AtBit j m (x + k) := by
  have h1 : Bit m (256 * j + (x + k)) := by
    simpa [Nat.add_assoc] using bit_down.mp (bit_and.mp h).1
  by_cases hlt : x + k < N
  · exact ⟨hlt, h1⟩
  · exact False.elim (hm j (x + k) hj (by omega) (by omega) h1)

lemma shL1_at {N g k m j x : Nat} (hN : N ≤ 183) (hj : j < 2 ^ g) (hx : x < N) (hk : k ≤ 73)
    (hm : Masked N g m) (h : AtBit j (shL1 (tiles g (low N)) k m) x) :
    k ≤ x ∧ AtBit j m (x - k) := by
  obtain ⟨hle, hb⟩ := bit_up.mp (bit_and.mp h).1
  by_cases hkx : k ≤ x
  · refine ⟨hkx, ?_⟩
    simpa [AtBit, show 256 * j + x - k = 256 * j + (x - k) by omega] using hb
  · cases j with
    | zero => omega
    | succ j' =>
      have hpos : 256 * (j' + 1) + x - k = 256 * j' + (256 + x - k) := by omega
      rw [hpos] at hb
      exact False.elim (hm j' (256 + x - k) (by omega) (by omega) (by omega) hb)

lemma shR_at {N g k m j x : Nat} (hN : N ≤ 183) (hj : j < 2 ^ g) (hx : x < N) (hk : k ≤ 146)
    (hm : Masked N g m) (h : AtBit j (shR (tiles g (low N)) k m) x) :
    x + k < N ∧ AtBit j m (x + k) := by
  unfold shR at h
  cases h73 : Nat.ble k 73
  · rw [h73] at h
    have hgt : 73 < k := by
      have : ¬ (k ≤ 73) := fun hle => by rw [Nat.ble_eq_true_of_le hle] at h73; exact Bool.noConfusion h73
      omega
    change AtBit j (shR1 (tiles g (low N)) (k - 73) (shR1 (tiles g (low N)) 73 m)) x at h
    obtain ⟨h1, hb1⟩ := shR1_at hN hj hx (by omega) (masked_shR1 hN) h
    obtain ⟨h2, hb2⟩ := shR1_at hN hj h1 (by decide) hm hb1
    exact ⟨by omega, by simpa [AtBit, show x + (k - 73) + 73 = x + k by omega] using hb2⟩
  · rw [h73] at h
    exact shR1_at hN hj hx (Nat.le_of_ble_eq_true h73) hm h

lemma shL_at {N g k m j x : Nat} (hN : N ≤ 183) (hj : j < 2 ^ g) (hx : x < N) (hk : k ≤ 146)
    (hm : Masked N g m) (h : AtBit j (shL (tiles g (low N)) k m) x) :
    k ≤ x ∧ AtBit j m (x - k) := by
  unfold shL at h
  cases h73 : Nat.ble k 73
  · rw [h73] at h
    have hgt : 73 < k := by
      have : ¬ (k ≤ 73) := fun hle => by rw [Nat.ble_eq_true_of_le hle] at h73; exact Bool.noConfusion h73
      omega
    change AtBit j (shL1 (tiles g (low N)) (k - 73) (shL1 (tiles g (low N)) 73 m)) x at h
    obtain ⟨h1, hb1⟩ := shL1_at hN hj hx (by omega) (masked_shL1 hN) h
    obtain ⟨h2, hb2⟩ := shL1_at hN hj (by omega) (by decide) hm hb1
    exact ⟨by omega, by simpa [AtBit, show x - (k - 73) - 73 = x - k by omega] using hb2⟩
  · rw [h73] at h
    exact shL1_at hN hj hx (Nat.le_of_ble_eq_true h73) hm h

def force3Small (M d r : Nat) : Nat :=
  let r1 := shR1 M d r
  let r2 := shR1 M d r1
  Nat.lor (Nat.lor (Nat.land r1 r2) (shL1 M d (Nat.land r r2)))
    (shL1 M d (shL1 M d (Nat.land r r1)))

def force3Big (M d r : Nat) : Nat :=
  let r1 := shR M d r
  let r2 := shR M d r1
  Nat.lor (Nat.lor (Nat.land r1 r2) (shL M d (Nat.land r r2)))
    (shL M d (shL M d (Nat.land r r1)))

lemma force3Big_sound {N : Nat} (hN : N ≤ 183) {c : Nat → Bool} {j g d r : Nat}
    (hj : j < 2 ^ g) (hn : ¬ Goal N c) (hd : 0 < d) (hd' : d ≤ 91)
    (hm : Masked N g r) (fr : Fact N c true j r) :
    Fact N c false j (force3Big (tiles g (low N)) d r) := by
  intro x hx hh
  unfold force3Big at hh
  have no3 (a : Nat) (hb : a + 2 * d < N) (h0 : c a = true) (h1 : c (a + d) = true) (h2 : c (a + 2 * d) = true) : False := by
    apply hn
    refine ⟨true, a, d, hd, hb, ?_⟩
    intro t ht
    change t.val ≤ 2 at ht
    rcases (show t.val = 0 ∨ t.val = 1 ∨ t.val = 2 by omega) with h | h | h
    · simpa [h] using h0
    · simpa [h] using h1
    · simpa [h] using h2
  rcases bit_or.mp hh with h | h
  · rcases bit_or.mp h with h | h
    · obtain ⟨h1, h2⟩ := bit_and.mp h
      obtain ⟨hx1, br1⟩ := shR_at hN hj hx (by omega) hm h1
      obtain ⟨hx1', br1'⟩ := shR_at hN hj hx (by omega) (masked_shR hN) h2
      obtain ⟨hx2, br2⟩ := shR_at hN hj hx1' (by omega) hm br1'
      have c1 := fr _ hx1 br1
      have c2 := fr _ hx2 br2
      cases hc : c x with
      | false => rfl
      | true => exact False.elim (no3 x (by omega) hc c1 (by simpa [show x + d + d = x + 2 * d by omega] using c2))
    · obtain ⟨hdx, h'⟩ := shL_at hN hj hx (by omega) (masked_and_left hm) h
      obtain ⟨b0, b2⟩ := bit_and.mp h'
      obtain ⟨hx1, br1⟩ := shR_at hN hj (by omega) (by omega) (masked_shR hN) b2
      obtain ⟨hx2, br2⟩ := shR_at hN hj hx1 (by omega) hm br1
      have c0 := fr _ (by omega) b0
      have c2 := fr _ hx2 br2
      cases hc : c x with
      | false => rfl
      | true =>
        exact False.elim (no3 (x - d) (by omega) c0
          (by simpa [show x - d + d = x by omega] using hc)
          (by simpa [show x - d + 2 * d = x - d + d + d by omega] using c2))
  · obtain ⟨hdx1, h1⟩ := shL_at hN hj hx (by omega) (masked_shL hN) h
    obtain ⟨hdx2, h2⟩ := shL_at hN hj (by omega) (by omega) (masked_and_left hm) h1
    obtain ⟨b0, b1⟩ := bit_and.mp h2
    obtain ⟨hx1, br1⟩ := shR_at hN hj (by omega) (by omega) hm b1
    have c0 := fr _ (by omega) b0
    have c1 := fr _ hx1 br1
    cases hc : c x with
    | false => rfl
    | true =>
      exact False.elim (no3 (x - d - d) (by omega) c0 c1
        (by simpa [show x - d - d + 2 * d = x by omega] using hc))

lemma force3Small_sound {N : Nat} (hN : N ≤ 183) {c : Nat → Bool} {j g d r : Nat}
    (hj : j < 2 ^ g) (hn : ¬ Goal N c) (hd : 0 < d) (hd' : d ≤ 73)
    (hm : Masked N g r) (fr : Fact N c true j r) :
    Fact N c false j (force3Small (tiles g (low N)) d r) := by
  have h := force3Big_sound hN hj hn hd (by omega) hm fr
  have heq : force3Small (tiles g (low N)) d r = force3Big (tiles g (low N)) d r := by
    unfold force3Small force3Big shR shL
    rw [Nat.ble_eq_true_of_le hd']
  rwa [heq]

def Need (N : Nat) (c : Nat → Bool) (j d n m : Nat) : Prop :=
  ∀ a, a < N → AtBit j m a → a + (n - 1) * d < N ∧ ∃ t < n, c (a + t * d) = true

def Run (N : Nat) (c : Nat → Bool) (j d n m : Nat) : Prop :=
  ∀ a, a < N → AtBit j m a → a + (n - 1) * d < N ∧ ∀ t < n, c (a + t * d) = false

lemma run1_ok {N c j d b} (fb : Fact N c false j b) : Run N c j d 1 b := by
  intro a ha h
  refine ⟨by simp; omega, ?_⟩
  intro t ht
  have ht0 : t = 0 := by omega
  subst ht0
  simpa using fb a ha h

lemma run_join {N : Nat} (hN : N ≤ 183) {c j g d p q m1 m2}
    (hj : j < 2 ^ g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 73) (hm2 : Masked N g m2)
    (h1 : Run N c j d p m1) (h2 : Run N c j d q m2) :
    Run N c j d (p + q) (Nat.land m1 (shR1 (tiles g (low N)) (p * d) m2)) := by
  intro a ha h
  obtain ⟨b1, b2⟩ := bit_and.mp h
  obtain ⟨ha2, bm2⟩ := shR1_at hN hj ha hpd hm2 b2
  obtain ⟨hb1, hf1⟩ := h1 a ha b1
  obtain ⟨hb2, hf2⟩ := h2 (a + p * d) ha2 bm2
  have hsum : (p + q - 1) * d = p * d + (q - 1) * d := by
    rw [← Nat.add_mul]; congr 1; omega
  refine ⟨by rw [hsum]; omega, ?_⟩
  intro t ht
  by_cases htp : t < p
  · exact hf1 t htp
  · have hq' := hf2 (t - p) (by omega)
    have heq : a + p * d + (t - p) * d = a + t * d := by
      rw [Nat.sub_mul]
      have := Nat.mul_le_mul_right d (show p ≤ t by omega)
      omega
    rwa [heq] at hq'

lemma st14_need {N : Nat} (hN : N ≤ 183) {c j g d} (hj : j < 2 ^ g) (hn : ¬ Goal N c)
    (hd : 0 < d) (hd' : d ≤ 14) :
    Need N c j d 14
      (shR1 (tiles g (low N)) (5 * d)
        (shR1 (tiles g (low N)) (4 * d)
          (shR1 (tiles g (low N)) (4 * d) (tiles g (low N))))) := by
  intro a ha h
  obtain ⟨h1, b1⟩ := shR1_at hN hj ha (by omega) (masked_shR1 hN) h
  obtain ⟨h2, b2⟩ := shR1_at hN hj h1 (by omega) (masked_shR1 hN) b1
  obtain ⟨h3, _⟩ := shR1_at hN hj h2 (by omega) (masked_M N g hN) b2
  have hbound : a + 13 * d < N := by omega
  refine ⟨hbound, ?_⟩
  by_contra! hall
  apply hn
  refine ⟨false, a, d, hd, hbound, ?_⟩
  intro t _
  have hne := hall t.val t.isLt
  cases hc : c (a + t.val * d) with
  | false => rfl
  | true => exact False.elim (hne hc)

lemma need_or {N c j d n m1 m2} (h1 : Need N c j d n m1) (h2 : Need N c j d n m2) :
    Need N c j d n (Nat.lor m1 m2) :=
  fun a ha h => (bit_or.mp h).elim (h1 a ha) (h2 a ha)

lemma need_left {N : Nat} (hN : N ≤ 183) {c j g d p q st r}
    (hj : j < 2 ^ g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 146) (hmr : Masked N g r)
    (hs : Need N c j d (p + q) st) (hr : Run N c j d q r) :
    Need N c j d p (Nat.land st (shR (tiles g (low N)) (p * d) r)) := by
  intro a ha h
  obtain ⟨b1, b2⟩ := bit_and.mp h
  obtain ⟨hb, t, ht, hct⟩ := hs a ha b1
  obtain ⟨ha2, br⟩ := shR_at hN hj ha hpd hmr b2
  obtain ⟨_, hfr⟩ := hr (a + p * d) ha2 br
  have hle : (p - 1) * d ≤ (p + q - 1) * d := Nat.mul_le_mul_right d (by omega)
  refine ⟨by omega, ?_⟩
  by_cases htp : t < p
  · exact ⟨t, htp, hct⟩
  · have hf := hfr (t - p) (by omega)
    have heq : a + p * d + (t - p) * d = a + t * d := by
      rw [Nat.sub_mul]
      have := Nat.mul_le_mul_right d (show p ≤ t by omega)
      omega
    rw [heq, hct] at hf
    exact Bool.noConfusion hf

lemma need_right {N : Nat} (hN : N ≤ 183) {c j g d p q st r}
    (hj : j < 2 ^ g) (_hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 146) (hmst : Masked N g st)
    (hs : Need N c j d (p + q) st) (hr : Run N c j d p r) :
    Need N c j d q (shL (tiles g (low N)) (p * d) (Nat.land st r)) := by
  intro a ha h
  obtain ⟨hpa, hsr⟩ := shL_at hN hj ha hpd (masked_and_left hmst) h
  obtain ⟨bst, br⟩ := bit_and.mp hsr
  obtain ⟨hb, t, ht, hct⟩ := hs (a - p * d) (by omega) bst
  obtain ⟨_, hfr⟩ := hr (a - p * d) (by omega) br
  have hsum : (p + q - 1) * d = p * d + (q - 1) * d := by
    rw [← Nat.add_mul]; congr 1; omega
  refine ⟨by rw [hsum] at hb; omega, ?_⟩
  by_cases htp : t < p
  · have hf := hfr t htp
    rw [hct] at hf
    exact Bool.noConfusion hf
  · refine ⟨t - p, by omega, ?_⟩
    have heq : a + (t - p) * d = a - p * d + t * d := by
      rw [Nat.sub_mul]
      have := Nat.mul_le_mul_right d (show p ≤ t by omega)
      omega
    rwa [heq]

lemma need_left1 {N : Nat} (hN : N ≤ 183) {c j g d p q st r}
    (hj : j < 2 ^ g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 73) (hmr : Masked N g r)
    (hs : Need N c j d (p + q) st) (hr : Run N c j d q r) :
    Need N c j d p (Nat.land st (shR1 (tiles g (low N)) (p * d) r)) := by
  have h := need_left hN hj hp hq (by omega) hmr hs hr
  simpa [shR, Nat.ble_eq_true_of_le hpd] using h

lemma need_right1 {N : Nat} (hN : N ≤ 183) {c j g d p q st r}
    (hj : j < 2 ^ g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 73) (hmst : Masked N g st)
    (hs : Need N c j d (p + q) st) (hr : Run N c j d p r) :
    Need N c j d q (shL1 (tiles g (low N)) (p * d) (Nat.land st r)) := by
  have h := need_right hN hj hp hq (by omega) hmst hs hr
  simpa [shL, Nat.ble_eq_true_of_le hpd] using h

lemma force2_ok {N : Nat} (hN : N ≤ 183) {c j g d st b}
    (hj : j < 2 ^ g) (hd : d ≤ 73) (hmst : Masked N g st) (hmb : Masked N g b)
    (hs : Need N c j d 2 st) (fb : Fact N c false j b) :
    Fact N c true j
      (Nat.lor (Nat.land st (shR1 (tiles g (low N)) d b)) (shL1 (tiles g (low N)) d (Nat.land st b))) := by
  intro x hx h
  rcases bit_or.mp h with h1 | h2
  · obtain ⟨bst, br⟩ := bit_and.mp h1
    obtain ⟨_, t, ht, hct⟩ := hs x hx bst
    obtain ⟨hx1, bb⟩ := shR1_at hN hj hx hd hmb br
    have hf1 := fb _ hx1 bb
    rcases (show t = 0 ∨ t = 1 by omega) with rfl | rfl
    · simpa using hct
    · simp only [Nat.one_mul] at hct; rw [hf1] at hct; exact Bool.noConfusion hct
  · obtain ⟨hdx, hsb⟩ := shL1_at hN hj hx hd (masked_and_left hmst) h2
    obtain ⟨bst, bb⟩ := bit_and.mp hsb
    obtain ⟨_, t, ht, hct⟩ := hs (x - d) (by omega) bst
    have hf0 := fb _ (by omega) bb
    rcases (show t = 0 ∨ t = 1 by omega) with rfl | rfl
    · simp only [Nat.zero_mul, Nat.add_zero] at hct; rw [hf0] at hct; exact Bool.noConfusion hct
    · rw [Nat.one_mul, show x - d + d = x by omega] at hct; exact hct

lemma force3_need_ok {N : Nat} (hN : N ≤ 183) {c j g d st b}
    (hj : j < 2 ^ g) (hd : 2 * d ≤ 73) (hmst : Masked N g st) (hmb : Masked N g b)
    (hs : Need N c j d 3 st) (fb : Fact N c false j b) :
    Fact N c true j
      (Nat.lor (Nat.lor (Nat.land (Nat.land st (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) b))
        (shL1 (tiles g (low N)) d (Nat.land (Nat.land st b) (shR1 (tiles g (low N)) (2 * d) b))))
       (shL1 (tiles g (low N)) (2 * d) (Nat.land (Nat.land st b) (shR1 (tiles g (low N)) d b)))) := by
  intro x hx h
  rcases bit_or.mp h with h12 | h3
  · rcases bit_or.mp h12 with h1 | h2
    · obtain ⟨h1a, br2⟩ := bit_and.mp h1
      obtain ⟨bst, br1⟩ := bit_and.mp h1a
      obtain ⟨_, t, ht, hct⟩ := hs x hx bst
      obtain ⟨hx1, bb1⟩ := shR1_at hN hj hx (by omega) hmb br1
      obtain ⟨hx2, bb2⟩ := shR1_at hN hj hx hd hmb br2
      have hf1 := fb _ hx1 bb1
      have hf2 := fb _ hx2 bb2
      rcases (show t = 0 ∨ t = 1 ∨ t = 2 by omega) with rfl | rfl | rfl
      · simpa using hct
      · simp only [Nat.one_mul] at hct; rw [hf1] at hct; exact Bool.noConfusion hct
      · rw [hf2] at hct; exact Bool.noConfusion hct
    · obtain ⟨hdx, h'⟩ := shL1_at hN hj hx (by omega) (masked_and_left (masked_and_left hmst)) h2
      obtain ⟨h2a, br2⟩ := bit_and.mp h'
      obtain ⟨bst, bb0⟩ := bit_and.mp h2a
      obtain ⟨_, t, ht, hct⟩ := hs (x - d) (by omega) bst
      obtain ⟨hx2, bb2⟩ := shR1_at hN hj (by omega) hd hmb br2
      have hf0 := fb _ (by omega) bb0
      have hf2 := fb _ hx2 bb2
      rcases (show t = 0 ∨ t = 1 ∨ t = 2 by omega) with rfl | rfl | rfl
      · simp only [Nat.zero_mul, Nat.add_zero] at hct; rw [hf0] at hct; exact Bool.noConfusion hct
      · rw [Nat.one_mul, show x - d + d = x by omega] at hct; exact hct
      · rw [hf2] at hct; exact Bool.noConfusion hct
  · obtain ⟨hdx, h'⟩ := shL1_at hN hj hx hd (masked_and_left (masked_and_left hmst)) h3
    obtain ⟨h3a, br1⟩ := bit_and.mp h'
    obtain ⟨bst, bb0⟩ := bit_and.mp h3a
    obtain ⟨_, t, ht, hct⟩ := hs (x - 2 * d) (by omega) bst
    obtain ⟨hx1, bb1⟩ := shR1_at hN hj (by omega) (by omega) hmb br1
    have hf0 := fb _ (by omega) bb0
    have hf1 := fb _ hx1 bb1
    rcases (show t = 0 ∨ t = 1 ∨ t = 2 by omega) with rfl | rfl | rfl
    · simp only [Nat.zero_mul, Nat.add_zero] at hct; rw [hf0] at hct; exact Bool.noConfusion hct
    · simp only [Nat.one_mul] at hct; rw [hf1] at hct; exact Bool.noConfusion hct
    · simpa [show x - 2 * d + 2 * d = x by omega] using hct

def force14 (M d b : Nat) : Nat :=
  let d2 := Nat.mul 2 d
  let d4 := Nat.mul 4 d
  let d5 := Nat.mul 5 d
  let d7 := Nat.mul 7 d
  let b2 := Nat.land b (shR1 M d b)
  let b3 := Nat.land b2 (shR1 M d2 b)
  let b4 := Nat.land b2 (shR1 M d2 b2)
  let b7 := Nat.land b4 (shR1 M d4 b3)
  let st14 := shR1 M d5 (shR1 M d4 (shR1 M d4 M))
  let st7 := Nat.lor (Nat.land st14 (shR M d7 b7)) (shL M d7 (Nat.land st14 b7))
  let st4 := Nat.land st7 (shR1 M d4 b3)
  let st3 := shL1 M d4 (Nat.land st7 b4)
  let st2 := Nat.lor (Nat.land st4 (shR1 M d2 b2)) (shL1 M d2 (Nat.land st4 b2))
  let f2 := Nat.lor (Nat.land st2 (shR1 M d b)) (shL1 M d (Nat.land st2 b))
  let f3 := Nat.lor (Nat.lor (Nat.land (Nat.land st3 (shR1 M d b)) (shR1 M d2 b))
              (shL1 M d (Nat.land (Nat.land st3 b) (shR1 M d2 b))))
              (shL1 M d2 (Nat.land (Nat.land st3 b) (shR1 M d b)))
  Nat.lor f2 f3

lemma force14_sound {N : Nat} (hN : N ≤ 183) {c : Nat → Bool} {j g d b : Nat}
    (hj : j < 2 ^ g) (hn : ¬ Goal N c) (hd : 0 < d) (hd' : d ≤ 14)
    (hmb : Masked N g b) (fb : Fact N c false j b) :
    Fact N c true j (force14 (tiles g (low N)) d b) := by
  unfold force14
  dsimp only
  have hr1 : Run N c j d 1 b := run1_ok fb
  have hr2 : Run N c j d 2 (Nat.land b (shR1 (tiles g (low N)) d b)) := by
    simpa [Nat.one_mul] using run_join hN (p := 1) (q := 1) hj (by decide) (by decide) (by omega) hmb hr1 hr1
  have hmb2 : Masked N g (Nat.land b (shR1 (tiles g (low N)) d b)) := masked_and_left hmb
  have hr3 : Run N c j d 3 (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) b)) :=
    run_join hN (p := 2) (q := 1) hj (by decide) (by decide) (by omega) hmb hr2 hr1
  have hmb3 : Masked N g (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) b)) :=
    masked_and_left hmb2
  have hr4 : Run N c j d 4 (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) (Nat.land b (shR1 (tiles g (low N)) d b)))) :=
    run_join hN (p := 2) (q := 2) hj (by decide) (by decide) (by omega) hmb2 hr2 hr2
  have hr7 : Run N c j d 7
      (Nat.land (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) (Nat.land b (shR1 (tiles g (low N)) d b))))
       (shR1 (tiles g (low N)) (4 * d) (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) b)))) :=
    run_join hN (p := 4) (q := 3) hj (by decide) (by decide) (by omega) hmb3 hr4 hr3
  have hmb7 : Masked N g
      (Nat.land (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) (Nat.land b (shR1 (tiles g (low N)) d b))))
       (shR1 (tiles g (low N)) (4 * d) (Nat.land (Nat.land b (shR1 (tiles g (low N)) d b)) (shR1 (tiles g (low N)) (2 * d) b)))) :=
    masked_and_left (masked_and_left hmb2)
  have h14 := st14_need hN hj hn hd hd'
  have h7 := need_or
    (need_left hN (p := 7) (q := 7) hj (by decide) (by decide) (by omega) hmb7 h14 hr7)
    (need_right hN (p := 7) (q := 7) hj (by decide) (by decide) (by omega) (masked_shR1 hN) h14 hr7)
  have h4 := need_left1 hN (p := 4) (q := 3) hj (by decide) (by decide) (by omega) hmb3 h7 hr3
  have h3 := need_right1 hN (p := 4) (q := 3) hj (by decide) (by decide) (by omega)
    (masked_or (masked_and_left (masked_shR1 hN)) (masked_shL hN)) h7 hr4
  have h2 := need_or
    (need_left1 hN (p := 2) (q := 2) hj (by decide) (by decide) (by omega) hmb2 h4 hr2)
    (need_right1 hN (p := 2) (q := 2) hj (by decide) (by decide) (by omega)
      (masked_and_left (masked_or (masked_and_left (masked_shR1 hN)) (masked_shL hN))) h4 hr2)
  exact fact_or
    (force2_ok hN hj (by omega)
      (masked_or (masked_and_left (masked_and_left (masked_or (masked_and_left (masked_shR1 hN)) (masked_shL hN)))) (masked_shL1 hN))
      hmb h2 fb)
    (force3_need_ok hN hj (by omega) (masked_shL1 hN) hmb h3 fb)

def gatherAcc (f : Nat → Nat) : Nat → Nat → Nat
  | 0, acc => acc
  | n + 1, acc => gatherAcc f n (Nat.lor acc (f (Nat.add n 1)))

lemma gatherAcc_ok {N c b j n acc f} (hacc : Fact N c b j acc)
    (h : ∀ d, 0 < d → d ≤ n → Fact N c b j (f d)) :
    Fact N c b j (gatherAcc f n acc) := by
  induction n generalizing acc with
  | zero => exact hacc
  | succ n ih =>
    exact ih (fact_or hacc (h (n + 1) (by omega) (by omega))) (fun d hd hb => h d hd (by omega))

def gatherRange (f : Nat → Nat) (lo : Nat) : Nat → Nat → Nat
  | 0, acc => acc
  | n + 1, acc => gatherRange f lo n (Nat.lor acc (f (Nat.add lo (Nat.add n 1))))

lemma gatherRange_ok {N c b j lo n acc f} (hacc : Fact N c b j acc)
    (h : ∀ d, lo < d → d ≤ lo + n → Fact N c b j (f d)) :
    Fact N c b j (gatherRange f lo n acc) := by
  induction n generalizing acc with
  | zero => exact hacc
  | succ n ih =>
    exact ih (fact_or hacc (h (lo + (n + 1)) (by omega) (by omega))) (fun d hd hb => h d hd (by omega))

def State := Nat × Nat
def Valid (N : Nat) (c : Nat → Bool) (j : Nat) (s : State) : Prop :=
  Fact N c true j s.1 ∧ Fact N c false j s.2

def ValidM (N : Nat) (c : Nat → Bool) (g j : Nat) (s : State) : Prop :=
  Valid N c j s ∧ Masked N g s.1 ∧ Masked N g s.2

def step (M : Nat) (s : State) : State :=
  let b1 := gatherAcc (fun d => force3Small M d s.1) 73 s.2
  let b2 := gatherRange (fun d => force3Big M d s.1) 73 18 b1
  let b := Nat.land b2 M
  let r1 := gatherAcc (fun d => force14 M d b) 14 s.1
  (Nat.land r1 M, b)

lemma step_sound {N : Nat} (hN : N ≤ 183) {c j g s}
    (hj : j < 2 ^ g) (hn : ¬ Goal N c) (hs : ValidM N c g j s) :
    ValidM N c g j (step (tiles g (low N)) s) := by
  unfold step
  dsimp only
  have fb1 : Fact N c false j (gatherAcc (fun d => force3Small (tiles g (low N)) d s.1) 73 s.2) :=
    gatherAcc_ok hs.1.2 (fun d hd hb => force3Small_sound hN hj hn hd hb hs.2.1 hs.1.1)
  have fb2 : Fact N c false j
      (gatherRange (fun d => force3Big (tiles g (low N)) d s.1) 73 18
        (gatherAcc (fun d => force3Small (tiles g (low N)) d s.1) 73 s.2)) :=
    gatherRange_ok fb1 (fun d hd hb => force3Big_sound hN hj hn (by omega) (by omega) hs.2.1 hs.1.1)
  have fb : Fact N c false j (Nat.land _ (tiles g (low N))) := fact_and_left fb2
  have fr : Fact N c true j
      (Nat.land (gatherAcc (fun d => force14 (tiles g (low N)) d _) 14 s.1) (tiles g (low N))) :=
    fact_and_left (gatherAcc_ok hs.1.1 (fun d hd hb => force14_sound hN hj hn hd hb (masked_and_M hN) fb))
  exact ⟨⟨fr, fb⟩, masked_and_M hN, masked_and_M hN⟩

def advance (M : Nat) : Nat → State → State
  | 0, s => s
  | n + 1, s => advance M n (step M s)

lemma advance_sound {N : Nat} (hN : N ≤ 183) {c j g}
    (hj : j < 2 ^ g) (hn : ¬ Goal N c) (n : Nat) (s : State)
    (hs : ValidM N c g j s) : ValidM N c g j (advance (tiles g (low N)) n s) := by
  induction n generalizing s with
  | zero => exact hs
  | succ n ih => exact ih _ (step_sound hN hj hn hs)

def diffuse : Nat → Nat → Nat
  | 0, m => m
  | n + 1, m =>
    let v := diffuse n m
    Nat.lor v (Nat.shiftRight v (Nat.shiftLeft 1 n))

lemma diffuse_shift_eq (n : Nat) : Nat.shiftLeft 1 n = 2 ^ n := by
  change 1 <<< n = 2 ^ n
  rw [Nat.shiftLeft_eq, one_mul]

lemma diffuse_bit (n m i) (h : Bit (diffuse n m) i) : ∃ x < 2 ^ n, Bit m (i + x) := by
  induction n generalizing i with
  | zero => exact ⟨0, by decide, by simpa [diffuse] using h⟩
  | succ n ih =>
    rw [diffuse, diffuse_shift_eq] at h
    rcases bit_or.mp h with h | h
    · obtain ⟨x, hx, hb⟩ := ih _ h
      exact ⟨x, by rw [Nat.pow_succ]; omega, hb⟩
    · obtain ⟨x, hx, hb⟩ := ih _ (bit_down.mp h)
      exact ⟨2 ^ n + x, by rw [Nat.pow_succ]; omega, by simpa [Nat.add_assoc] using hb⟩

def closed (g size M : Nat) (s : State) : Bool :=
  let clashes := Nat.land (Nat.land s.1 s.2) M
  let roots := Nat.land (tiles g 1) (low (Nat.mul 256 size))
  Nat.beq (Nat.land (diffuse 8 clashes) roots) roots

lemma closed_false {N : Nat} (hN : N ≤ 183) {c j g n s}
    (hj : j < 2 ^ g) (hj' : j < n) (hs : Valid N c j s) :
    closed g n (tiles g (low N)) s ≠ true := by
  intro h
  have hh := Nat.eq_of_beq_eq_true h
  have hroot : Bit (Nat.land (tiles g 1) (low (Nat.mul 256 n))) (256 * j) := by
    apply bit_and.mpr
    refine ⟨?_, bit_low.mpr (by change 256 * j < 256 * n; omega)⟩
    exact (tile_bit g (m := 1) (x := 0) (by decide) hj (by decide)).mpr (by rfl)
  rw [← hh] at hroot
  obtain ⟨x, hx, hc⟩ := diffuse_bit 8 _ _ (bit_and.mp hroot).1
  obtain ⟨colors, mask⟩ := bit_and.mp hc
  have hx' := bit_low.mp ((tile_bit g (low_lt_256 hN) hj hx).mp mask)
  obtain ⟨hr, hb⟩ := bit_and.mp colors
  exact Bool.noConfusion ((hs.1 x hx' hr).symm.trans (hs.2 x hx' hb))

structure Block where
  size : Nat
  red : Nat
  blue : Nat
  tailCode : Nat

def leaf (s : State) (next : Nat) : Block := ⟨1, s.1, s.2, next⟩

def collect : Nat → Nat → State → Block
  | 0, code, s => leaf s code
  | h + 1, code, s =>
    match Nat.beq (Nat.land code 1) 0 with
    | true => leaf s (Nat.shiftRight code 1)
    | false =>
      let p := Nat.land (Nat.shiftRight code 1) 255
      let bit := Nat.shiftLeft 1 p
      let l := collect h (Nat.shiftRight code 9) (Nat.lor s.1 bit, s.2)
      let r := collect h l.tailCode (s.1, Nat.lor s.2 bit)
      let off := Nat.mul 256 l.size
      ⟨Nat.add l.size r.size, joinBits off l.red r.red,
        joinBits off l.blue r.blue, r.tailCode⟩

lemma set_color {N c b p m} (h : Fact N c b 0 m) (hp : c p = b) :
    Fact N c b 0 (Nat.lor m (Nat.shiftLeft 1 p)) := by
  intro x hx he
  rcases bit_or.mp he with h1 | h2
  · exact h x hx h1
  · have e : p = x := by
      change (1 <<< p).testBit (256 * 0 + x) = true at h2
      simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow] using h2
    exact e ▸ hp

lemma join_left {N c b j n a d} (hN : N ≤ 183) (hj : j < n) (h : Fact N c b j a) :
    Fact N c b j (joinBits (Nat.mul 256 n) a d) :=
  fun x hx hb => h x hx ((join_lo (by change 256 * j + x < 256 * n; omega : 256 * j + x < Nat.mul 256 n)).mp hb)

lemma join_right {N c b j n a d} (h : Fact N c b j d) :
    Fact N c b (n + j) (joinBits (Nat.mul 256 n) a d) := by
  intro x hx hb
  have he := (join_hi (by change 256 * n ≤ 256 * (n + j) + x; omega : Nat.mul 256 n ≤ 256 * (n + j) + x)).mp hb
  change Bit d (256 * (n + j) + x - 256 * n) at he
  exact h x hx (by simpa [AtBit, show 256 * (n + j) + x - 256 * n = 256 * j + x by omega] using he)

lemma collect_cover {N c} (hN : N ≤ 183) (h code s) (hs : Valid N c 0 s) :
    let z := collect h code s
    ∃ j < z.size, Valid N c j (z.red, z.blue) := by
  induction h generalizing code s with
  | zero => exact ⟨0, Nat.zero_lt_succ _, hs⟩
  | succ h ih =>
    unfold collect
    cases hbit : Nat.beq (Nat.land code 1) 0
    · dsimp only
      let p := Nat.land (Nat.shiftRight code 1) 255
      let l := collect h (Nat.shiftRight code 9) (Nat.lor s.1 (Nat.shiftLeft 1 p), s.2)
      cases hp : c p with
      | true =>
        obtain ⟨j, hj, hv⟩ := ih (Nat.shiftRight code 9) (Nat.lor s.1 (Nat.shiftLeft 1 p), s.2) ⟨set_color hs.1 hp, hs.2⟩
        exact ⟨j, lt_of_lt_of_le hj (Nat.le_add_right ..), join_left hN hj hv.1, join_left hN hj hv.2⟩
      | false =>
        obtain ⟨j, hj, hv⟩ := ih l.tailCode (s.1, Nat.lor s.2 (Nat.shiftLeft 1 p)) ⟨hs.1, set_color hs.2 hp⟩
        exact ⟨l.size + j, Nat.add_lt_add_left hj l.size, join_right hv.1, join_right hv.2⟩
    · exact ⟨0, Nat.zero_lt_succ _, hs⟩

def reject (N g rounds height code : Nat) (s : State) : Bool :=
  let z := collect (Nat.add height 1) code s
  let M := tiles g (low N)
  match Nat.ble z.size (Nat.shiftLeft 1 g) with
  | false => false
  | true => closed g z.size M (advance M rounds (Nat.land z.red M, Nat.land z.blue M))

def Impossible (N : Nat) (s : State) : Prop :=
  ∀ c, ¬ Goal N c → Valid N c 0 s → False

lemma of_check {N : Nat} (hN : N ≤ 183) {g rounds height code : Nat} {s}
    (h : reject N g rounds height code s = true) :
    Impossible N s := by
  intro c hn hs
  obtain ⟨j, hj, hv⟩ := collect_cover hN (height + 1) code s hs
  unfold reject at h
  dsimp only at h
  cases hsz : Nat.ble (collect (height + 1) code s).size (Nat.shiftLeft 1 g)
  · rw [hsz] at h; exact Bool.noConfusion h
  · rw [hsz] at h
    have hle : (collect (height + 1) code s).size ≤ 2 ^ g := by
      have := Nat.le_of_ble_eq_true hsz
      rwa [diffuse_shift_eq] at this
    have hj' := lt_of_lt_of_le hj hle
    have hvm : ValidM N c g j
        (Nat.land (collect (height + 1) code s).red (tiles g (low N)),
         Nat.land (collect (height + 1) code s).blue (tiles g (low N))) :=
      ⟨⟨fact_and_left hv.1, fact_and_left hv.2⟩, masked_and_M hN, masked_and_M hN⟩
    exact closed_false hN hj' hj (advance_sound hN hj' hn rounds _ hvm).1 h

lemma branch {N : Nat} (p : Nat) {r b : Nat}
    (hl : Impossible N (Nat.lor r (Nat.shiftLeft 1 p), b))
    (hr : Impossible N (r, Nat.lor b (Nat.shiftLeft 1 p))) :
    Impossible N (r, b) := by
  intro c hn hs
  cases hp : c p with
  | true => exact hl c hn ⟨set_color hs.1 hp, hs.2⟩
  | false => exact hr c hn ⟨hs.1, set_color hs.2 hp⟩


def SymMask (N m : Nat) : Prop :=
  ∀ x, x < N → Bit m x → Bit m (N - 1 - x)

lemma goal_reflect {N : Nat} {c : Nat → Bool}
    (h : Goal N (fun x => c (N - 1 - x))) : Goal N c := by
  obtain ⟨b, a, d, hd, hb, hm⟩ := h
  let L : Nat := if b then 2 else 13
  change a + L * d < N at hb
  refine ⟨b, N - 1 - (a + L * d), d, hd, by change N - 1 - (a + L * d) + L * d < N; omega, ?_⟩
  intro t ht
  change t.val ≤ L at ht
  have hL : L ≤ 13 := by cases b <;> decide
  have ht' : L - t.val < 14 := by omega
  have hmul := Nat.mul_le_mul_right d ht
  have hsub := hm ⟨L - t.val, ht'⟩ (by change L - t.val ≤ L; omega)
  have heq : N - 1 - (a + (L - t.val) * d) = N - 1 - (a + L * d) + t.val * d := by
    rw [Nat.sub_mul]; omega
  simpa only [heq] using hsub

lemma sym_branch3 {N : Nat} (u : Nat) (hu : u < N) {r b : Nat}
    (hr : SymMask N r) (hb : SymMask N b)
    (htt : Impossible N (Nat.lor (Nat.lor r (Nat.shiftLeft 1 u)) (Nat.shiftLeft 1 (N - 1 - u)), b))
    (hff : Impossible N (r, Nat.lor (Nat.lor b (Nat.shiftLeft 1 u)) (Nat.shiftLeft 1 (N - 1 - u))))
    (htf : Impossible N (Nat.lor r (Nat.shiftLeft 1 u), Nat.lor b (Nat.shiftLeft 1 (N - 1 - u)))) :
    Impossible N (r, b) := by
  intro c hn hs
