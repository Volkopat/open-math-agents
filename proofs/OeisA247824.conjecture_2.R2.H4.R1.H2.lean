import OMAReductions.R_OeisA247824_conjecture_2_R2_H4_R1
import Mathlib.NumberTheory.PrimeCounting
import Mathlib.NumberTheory.LucasPrimality

/-! Small certificates for relative prime counts at large endpoints. -/
namespace WindowRanks
open Nat

def remPower (p a : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 1%p
  | f+1, e =>
    let v := remPower p a f (e/2)
    (v^2*(if e%2=1 then a else 1))%p

private theorem rem_bound (p a f e : ℕ) (hp : 0 < p) : remPower p a f e < p := by
  cases f <;> exact Nat.mod_lt _ hp

private theorem rem_cast (p a f e : ℕ) (bound : e < 2^f) :
    ((remPower p a f e : ℕ) : ZMod p) = (a:ZMod p)^e := by
  induction f generalizing e with
  | zero =>
    have eq : e=0 := by simpa using bound
    subst e
    simp [remPower,ZMod.natCast_mod]
  | succ f ih =>
    have half : e/2 < 2^f := by rw [pow_succ] at bound; omega
    rw [remPower,ZMod.natCast_mod,Nat.cast_mul,Nat.cast_pow,ih _ half,←pow_mul]
    by_cases bit : e%2=1
    · rw [if_pos bit,←pow_succ]
      congr 1
      omega
    · rw [if_neg bit,Nat.cast_one,mul_one]
      congr 1
      omega

private theorem rem_one (p a f e : ℕ) (hp : 1 < p) (h : e < 2^f) :
    (a:ZMod p)^e=1 ↔ remPower p a f e=1 := by
  rw [←rem_cast p a f e h]
  simpa only [Nat.cast_one,Nat.mod_eq_of_lt (rem_bound p a f e (by omega)),Nat.mod_eq_of_lt hp]
    using ZMod.natCast_eq_natCast_iff' (remPower p a f e) 1 p

def factorProduct (fs : List (ℕ×ℕ)) : ℕ := (fs.map fun v => v.1^v.2).prod

private theorem prime_factor_mem (q : ℕ) (hq : q.Prime) (fs : List (ℕ×ℕ))
    (primes : ∀ n ∈ fs.map Prod.fst, n.Prime) (h : q ∣ factorProduct fs) :
    q ∈ fs.map Prod.fst := by
  induction fs with
  | nil => simp [factorProduct,hq.not_dvd_one] at h
  | cons v tail ih =>
    change q ∣ v.1^v.2*factorProduct tail at h
    rcases hq.dvd_mul.mp h with left|right
    · have he := Nat.prime_eq_prime_of_dvd_pow hq (primes _ (by simp)) left
      simp [he]
    · exact List.mem_cons_of_mem _ (ih (fun p h => primes p (List.mem_cons_of_mem _ h)) right)

def primeData (p a : ℕ) (fs : List (ℕ×ℕ)) : Bool :=
  decide (1 < p ∧ p < 2^46 ∧ factorProduct fs = p-1 ∧ remPower p a 46 (p-1)=1) &&
    fs.all (fun v => remPower p a 46 ((p-1)/v.1) != 1)

theorem lucasData (p a : ℕ) (fs : List (ℕ×ℕ))
    (primes : ∀ q ∈ fs.map Prod.fst, q.Prime) (data : primeData p a fs=true) : p.Prime := by
  simp only [primeData,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true] at data
  obtain ⟨⟨hp,cap,hf,main⟩,rest⟩ := data
  apply lucas_primality p (a:ZMod p)
  · exact (rem_one _ _ _ _ hp (by omega)).mpr main
  · intro q hq hd
    have memb := prime_factor_mem q hq fs primes (hf ▸ hd)
    obtain ⟨v,hv,eq⟩ := List.mem_map.mp memb
    subst q
    have nz := rest v hv
    have small := Nat.div_le_self (p-1) v.1
    intro eq
    have no : remPower p a 46 ((p-1)/v.1) ≠ 1 := by simpa using nz
    exact no ((rem_one p a 46 _ hp (by omega)).mp eq)


inductive CertTree where
  | leaf
  | node (n witness : ℕ) (factors : List (ℕ×ℕ)) (left right : CertTree)

def known (n : ℕ) : CertTree → Bool
  | .leaf => false
  | .node p _ _ l r => if n=p then true else if n<p then known n l else known n r


private def lowWheel : ℕ := 0x1b30964ec395dc24069528d54bbda40d16e966ef9a70eb21b5b2943a321cdf10391745570cca9420c6ecb3b72ed2ee8b02ea2735c61a000000000000000000000000
private def highWheel : ℕ := 

private theorem low_value : Nat.factorial 100=lowWheel := by
  decide +kernel

set_option maxRecDepth 25000 in
set_option maxHeartbeats 3000000 in
private theorem high_value : Nat.factorial 10000=highWheel := by
  decide +kernel

private theorem wheel_prime (n b w : ℕ) (hn : 1 < n) (cap : n < (b+1)^2)
    (value : Nat.factorial b=w) (coprime : n.gcd w=1) : n.Prime := by
  by_contra comp
  have np := Nat.minFac_prime (show n≠1 by omega)
  have sq := Nat.minFac_sq_le_self (show 0 < n by omega) comp
  have small : n.minFac ≤ b := by
    by_contra! large
    have h := Nat.mul_le_mul large large
    nlinarith only [cap,sq,h]
  have fac := Nat.dvd_factorial np.pos small
  rw [value] at fac
  have divides := Nat.dvd_gcd (Nat.minFac_dvd n) fac
  rw [coprime] at divides
  exact np.not_dvd_one divides

private def quick (n : ℕ) : Bool :=
  if n≤100 then decide n.Prime else
  if n≤10000 then n.gcd lowWheel == 1 else n.gcd highWheel == 1

private theorem quick_sound (n : ℕ) (cap : n ≤ 100000000) (h : quick n=true) : n.Prime := by
  unfold quick at h
  split_ifs at h with tiny small
  · simpa using h
  · exact wheel_prime n 100 lowWheel (by omega) (by norm_num; omega) low_value (by simpa using h)
  · exact wheel_prime n 10000 highWheel (by omega) (by norm_num; omega) high_value (by simpa using h)

private def trusted (n : ℕ) (t : CertTree) : Bool :=
  if n≤100000000 then quick n else known n t

def rowOK (all : CertTree) (n a : ℕ) (fs : List (ℕ×ℕ)) : Bool :=
  primeData n a fs && fs.all (fun v => decide (v.1 < n) && trusted v.1 all)

def treeOK (all : CertTree) : CertTree → Bool
  | .leaf => true
  | .node n a fs l r => rowOK all n a fs && treeOK all l && treeOK all r

theorem joined (all : CertTree) (n a : ℕ) (fs : List (ℕ×ℕ)) (l r : CertTree)
    (own : rowOK all n a fs=true) (low : treeOK all l=true) (high : treeOK all r=true) :
    treeOK all (.node n a fs l r)=true := by simp only [treeOK,own,low,high,Bool.and_self]

private theorem row_present (all t : CertTree) (valid : treeOK all t=true)
    (n : ℕ) (found : known n t=true) : ∃ a fs, rowOK all n a fs=true := by
  induction t with
  | leaf => simp [known] at found
  | node p a fs l r il ir =>
    simp only [treeOK,Bool.and_eq_true] at valid
    by_cases hit : n=p
    · exact ⟨a,fs,hit ▸ valid.1.1⟩
    · by_cases lt : n<p
      · exact il valid.1.2 (by simpa only [known,if_neg hit,if_pos lt] using found)
      · exact ir valid.2 (by simpa only [known,if_neg hit,if_neg lt] using found)

theorem certified (all : CertTree) (check : treeOK all all=true) (n : ℕ)
    (found : trusted n all=true) : n.Prime := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases small : n≤100000000
    · exact quick_sound n small (by simpa only [trusted,if_pos small] using found)
    · have seen : known n all=true := by simpa only [trusted,if_neg small] using found
      obtain ⟨a,fs,ok⟩ := row_present all all check n seen
      simp only [rowOK,Bool.and_eq_true,List.all_eq_true] at ok
      apply lucasData n a fs _ ok.1
      intro q hq
      obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hq
      have smaller := ok.2 v hv
      simp only [decide_eq_true_eq] at smaller
      exact ih _ smaller.1 smaller.2

def flags (t : CertTree) : ℕ → List ℕ → Bool
  | _, [] => true
  | base, f::fs =>
    (if f=0 then trusted (base+1) t else decide (1 < f ∧ f < base+1 ∧ (base+1)%f=0)) &&
      flags t (base+1) fs

def primeSlots : List ℕ → ℕ
  | [] => 0
  | f::fs => (if f=0 then 1 else 0)+primeSlots fs

theorem relative (t : CertTree) (good : treeOK t t=true) (base : ℕ) (fs : List ℕ)
    (checked : flags t base fs=true) :
    Nat.primeCounting (base+fs.length) = Nat.primeCounting base + primeSlots fs := by
  induction fs generalizing base with
  | nil => simp [primeSlots]
  | cons f fs ih =>
    simp only [flags,Bool.and_eq_true] at checked
    obtain ⟨first,rest⟩ := checked
    have step : Nat.primeCounting (base+1) = Nat.primeCounting base +
        if (base+1).Prime then 1 else 0 := Nat.count_succ Nat.Prime (base+1)
    have primeFlag : (base+1).Prime ↔ f=0 := by
      by_cases empty : f=0
      · rw [if_pos empty] at first
        exact iff_of_true (certified t good _ first) empty
      · simp only [if_neg empty,decide_eq_true_eq] at first
        have comp : ¬(base+1).Prime := by
          intro isprime
          have div := Nat.dvd_of_mod_eq_zero first.2.2
          rcases (Nat.dvd_prime isprime).mp div with h|h <;> omega
        exact iff_of_false comp empty
    rw [show base+(f::fs).length=(base+1)+fs.length by simp;omega,ih (base+1) rest,step]
    simp only [primeSlots,primeFlag]
    omega

theorem extend (t : CertTree) (check : treeOK t t=true)
    (base lo hi prev total : ℕ) (fs : List ℕ)
    (old : Nat.primeCounting lo=Nat.primeCounting base+prev)
    (ok : flags t lo fs=true) (endpt : lo+fs.length=hi) (sum : prev+primeSlots fs=total) :
    Nat.primeCounting hi=Nat.primeCounting base+total := by
  have h := relative t check lo fs ok
  rw [endpt] at h
  omega


