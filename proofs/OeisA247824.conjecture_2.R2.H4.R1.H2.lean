  | 29 => (11092009835083,382482495195,382482495196)
  | 30 => (30110134441897,0,1003670521508)
  | _ => (0,0,0)

private def keyOK (e : ℕ) : Prop :=
  let k := e%32
  let m := e/32
  let t := rankBounds k
  ∀ r : ℕ, t.2.1 ≤ r → r ≤ t.2.2 →
    Nat.primeCounting (k*(m+1322164)-20868473)+r ≠ Nat.primeCounting t.1+m

private theorem arithmetic_case (e k m q a low upper delta : ℕ)
    (slope : e%32=k) (idx : e/32=m) (bracket : rankBounds k=(a,low,upper))
    (value : k*(m+1322164)-20868473=q)
    (diff : Nat.primeCounting q=Nat.primeCounting a+delta)
    (away : m < low+delta ∨ upper+delta < m) : keyOK e := by
  unfold keyOK
  dsimp only
  rw [slope,idx,bracket,value]
  intro r l h eq
  change low ≤ r at l
  change r ≤ upper at h
  change Nat.primeCounting q+r=Nat.primeCounting a+m at eq
  omega

private theorem prepend_key {e : ℕ} {xs : List ℕ} (head : keyOK e)
    (tail : ∀ a ∈ xs,keyOK a) : ∀ a ∈ e::xs,keyOK a := by
  intro a h
  rcases List.mem_cons.mp h with h|h
  · exact h ▸ head
  · exact tail a h

private theorem empty_keys : ∀ e ∈ ([] : List ℕ),keyOK e := by simp

