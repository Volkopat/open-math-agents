private def rankBounds (k : ℕ) : ℕ × ℕ × ℕ := match k with
  | 17 => (94085731,5439846,5439846)
  | 19 => (590237761,30841324,590237761)
  | 22 => (10425579253,473516370,10425579253)
  | 23 => (28006150079,0,1217243859)
  | 25 => (204778727327,8190661670,204778727327)
