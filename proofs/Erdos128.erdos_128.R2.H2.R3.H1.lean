/-!
# Proof of Erdos128.erdos_128.R2.H2.R3.H1 (Theorem J1: Vega Blowup Sparse-Half Refutation)

Proves `OMA.R_Erdos128_erdos_128_R2_H2_R3.H1`: no finite triangle-free graph `M` (`n > 0`)
with `5 * alpha(M) < 2 * n`, `3 * delta(M) > n`, admitting a surjective edge-reflecting map
onto an active Vega graph `V_i(dy, de)` (`i >= 2`), can satisfy
`∀ V', 2 * |V'| + 1 >= n -> 50 * e(M[V']) > n^2`.
-/

namespace Erdos128ThmJ

open Finset SimpleGraph

/-- Elementary averaging subset selection: for any finset `B`, weight function `f : V → ℕ`,
    and `t <= #B`, there exists `T ⊆ B` of cardinality `t` with `#B * ∑_{u ∈ T} f u <= t * ∑_{u ∈ B} f u`. -/
lemma exists_subset_avg_le {V : Type} [DecidableEq V] (B : Finset V) (f : V → ℕ) :
    ∀ t : ℕ, t ≤ #B → ∃ T ⊆ B, #T = t ∧ #B * (∑ u ∈ T, f u) ≤ t * (∑ u ∈ B, f u) := by
  induction B using Finset.strongInduction with
  | H B ih =>
    intro t ht
    by_cases hteq : t = #B
    · exact ⟨B, Finset.Subset.refl B, hteq.symm, by rw [hteq]⟩
    have hBne : B.Nonempty := by
      by_contra hempty
      rw [Finset.not_nonempty_iff_eq_empty.mp hempty, Finset.card_empty] at ht hteq; omega
    obtain ⟨m, hmB, hm_max⟩ := Finset.exists_max_image B f hBne
    let B' := B.erase m
    have hB'_ssub : B' ⊂ B := Finset.erase_ssubset hmB
    have hB'_card : #B' = #B - 1 := Finset.card_erase_of_mem hmB
    have ht' : t ≤ #B' := by omega
    obtain ⟨T, hTB', hTcard, hTavg⟩ := ih B' hB'_ssub t ht'
    refine ⟨T, hTB'.trans (Finset.erase_subset m B), hTcard, ?_⟩
    have hsumB : ∑ u ∈ B, f u = ∑ u ∈ B', f u + f m := by
      rw [← Finset.sum_erase_add B f hmB]
    have hm_ge_avg : ∑ u ∈ B', f u ≤ #B' * f m := by
      calc ∑ u ∈ B', f u ≤ ∑ _u ∈ B', f m := Finset.sum_le_sum (fun u hu => hm_max u (Finset.mem_of_mem_erase hu))
        _ = #B' * f m := by rw [Finset.sum_const, smul_eq_mul]
    have hB_pos : 1 ≤ #B := Finset.card_pos.mpr hBne
    -- Cross-multiply: (#B' + 1) * S_T <= t * (S_B' + f m) from #B' * S_T <= t * S_B' and S_B' <= #B' * f m
    by_cases hB'0 : #B' = 0
    · have ht0 : t = 0 := by omega
      subst ht0
      have hT0 : T = ∅ := Finset.card_eq_zero.mp hTcard
      simp [hT0]
    · have hB'_pos : 0 < #B' := Nat.pos_of_ne_zero hB'0
      have h1 : #B' * (#B * ∑ u ∈ T, f u) ≤ #B' * (t * ∑ u ∈ B, f u) := by
        rw [hsumB, show #B = #B' + 1 by omega]
        nlinarith only [hTavg, hm_ge_avg]
      exact Nat.le_of_mul_le_mul_left h1 hB'_pos


end Erdos128ThmJ

