  | .inl 0 => .inr 0 | .inl 1 => .inr 7 | .inl 2 => .inr 4 | .inl 3 => .inr 1 | .inl 4 => .inl 4
  | .inr 0 => .inl 0 | .inr 1 => .inl 3 | .inr 2 => .inr 2 | .inr 3 => .inr 5
  | .inr 4 => .inl 2 | .inr 5 => .inr 3 | .inr 6 => .inr 6 | .inr 7 => .inl 1

