/- ### Step 1: Canonical Vega Weight Variables, Miracle 1 & Miracle 2 -/

section VegaAlgebra

variable {i : ℕ} {dy de : Bool} (S : VegaSystem i dy de)

lemma fin3_cases (j : Fin 3) : j = 0 ∨ j = 1 ∨ j = 2 := by fin_cases j <;> decide
lemma fin8_cases (q : Fin 8) : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 ∨ q = 6 ∨ q = 7 := by fin_cases q <;> decide

def inI1 (i : ℕ) : VegaV i → Bool
  | .inl p => decide (p.val < i)
  | .inr _ => false

def inI2 (i : ℕ) : VegaV i → Bool
  | .inl p => decide (i ≤ p.val ∧ p.val < 2 * i)
  | .inr _ => false

def inI3 (i : ℕ) : VegaV i → Bool
  | .inl p => decide (2 * i ≤ p.val)
  | .inr _ => false

def I1 (i : ℕ) : Finset (VegaV i) := Finset.univ.filter (fun z => inI1 i z = true)
def I2 (i : ℕ) : Finset (VegaV i) := Finset.univ.filter (fun z => inI2 i z = true)
def I3 (i : ℕ) : Finset (VegaV i) := Finset.univ.filter (fun z => inI3 i z = true)

@[simp] lemma mem_I1_inl {i : ℕ} {p : Fin (3 * i - 1)} : (.inl p : VegaV i) ∈ I1 i ↔ p.val < i := by rw [I1, Finset.mem_filter]; simp [inI1]
@[simp] lemma mem_I1_inr {i : ℕ} {q : Fin 8} : (.inr q : VegaV i) ∉ I1 i := by rw [I1, Finset.mem_filter]; simp [inI1]
@[simp] lemma mem_I2_inl {i : ℕ} {p : Fin (3 * i - 1)} : (.inl p : VegaV i) ∈ I2 i ↔ i ≤ p.val ∧ p.val < 2 * i := by rw [I2, Finset.mem_filter]; simp [inI2]
@[simp] lemma mem_I2_inr {i : ℕ} {q : Fin 8} : (.inr q : VegaV i) ∉ I2 i := by rw [I2, Finset.mem_filter]; simp [inI2]
@[simp] lemma mem_I3_inl {i : ℕ} {p : Fin (3 * i - 1)} : (.inl p : VegaV i) ∈ I3 i ↔ 2 * i ≤ p.val := by rw [I3, Finset.mem_filter]; simp [inI3]
@[simp] lemma mem_I3_inr {i : ℕ} {q : Fin 8} : (.inr q : VegaV i) ∉ I3 i := by rw [I3, Finset.mem_filter]; simp [inI3]

def Ij (i : ℕ) : Fin 3 → Finset (VegaV i)
  | 0 => I1 i
  | 1 => I2 i
  | 2 => I3 i

def qx : ℚ := S.w (.inr 0)
def qy : ℚ := S.w (.inr 1)
def qa : ℚ := S.w (.inr 2)
def qb : ℚ := S.w (.inr 3)
def qc : ℚ := S.w (.inr 4)
def qu : ℚ := S.w (.inr 5)
def qv : ℚ := S.w (.inr 6)
def qw : ℚ := S.w (.inr 7)

def av : Fin 3 → ℚ | 0 => qa S | 1 => qb S | 2 => qc S
def uv : Fin 3 → ℚ | 0 => qu S | 1 => qv S | 2 => qw S
def Wv (j : Fin 3) : ℚ := ∑ z ∈ Ij i j, S.w z

def W1 : ℚ := Wv S 0
def W2 : ℚ := Wv S 1
def W3 : ℚ := Wv S 2
def WG : ℚ := W1 S + W2 S + W3 S
def WA : ℚ := qx S + qu S + qv S + qw S
def WB : ℚ := qy S + qa S + qb S + qc S
def sv : ℚ := qx S + qy S
def Stot : ℚ := qa S + qb S + qc S + qu S + qv S + qw S
def sig (j : Fin 3) : ℚ := av S j + uv S j
def del (j : Fin 3) : ℚ := av S j - uv S j
def Lv (j : Fin 3) : ℚ := Stot S - sig S j
def eps (j : Fin 3) : ℚ := 2 * Wv S j + Lv S j + sv S - 2 / 3
def rv (j : Fin 3) : ℚ := sv S - eps S j
def Tv : ℚ := WB S - WA S
def dv (j : Fin 3) : ℚ := del S j - Tv S
def zv (j : Fin 3) : ℚ := (qx S - qy S) - dv S j

def Ev : Fin 3 → ℚ
  | 0 => qb S * qw S + qc S * qv S
  | 1 => qa S * qw S + qc S * qu S
  | 2 => qa S * qv S + qb S * qu S

lemma sum_all_eq : WG S + WA S + WB S = 1 := by
  have h1 := S.hw_sum
  rw [Fintype.sum_sum_type] at h1
  have hQ : ∑ j : Fin 8, S.w (.inr j) = WA S + WB S := by
    rw [Fin.sum_univ_eight]
    simp only [WA, WB, qx, qy, qa, qb, qc, qu, qv, qw]; ring
  have hG : ∑ p : Fin (3 * i - 1), S.w (.inl p) = WG S := by
    have hdisj12 : Disjoint (I1 i) (I2 i) := by
      rw [Finset.disjoint_left]; intro z hz1 hz2
      cases z with
      | inl p => simp only [mem_I1_inl, mem_I2_inl] at hz1 hz2; omega
      | inr q => exact mem_I1_inr hz1
    have hdisj123 : Disjoint (I1 i ∪ I2 i) (I3 i) := by
      rw [Finset.disjoint_left]; intro z hz12 hz3
      cases z with
      | inl p =>
        simp only [Finset.mem_union, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hz12 hz3
        rcases hz12 with h | h <;> omega
      | inr q => exact mem_I3_inr hz3
    change ∑ p : Fin (3 * i - 1), S.w (.inl p) =
      (∑ z ∈ I1 i, S.w z) + (∑ z ∈ I2 i, S.w z) + (∑ z ∈ I3 i, S.w z)
    rw [← Finset.sum_union hdisj12, ← Finset.sum_union hdisj123]
    have hset : I1 i ∪ I2 i ∪ I3 i = Finset.univ.map ⟨Sum.inl, Sum.inl_injective⟩ := by
      ext z; cases z with
      | inl p =>
        simp only [Finset.mem_union, mem_I1_inl, mem_I2_inl, mem_I3_inl,
          Finset.mem_map, Finset.mem_univ, true_and, Function.Embedding.coeFn_mk]
        constructor
        · intro _; exact ⟨p, rfl⟩
        · intro _; omega
      | inr q => simp
    rw [hset, Finset.sum_map]; rfl
  linarith

lemma Stot_eq : Stot S = 1 - WG S - sv S := by
  have := sum_all_eq S; simp only [WA, WB, sv, Stot] at *; linarith

lemma deg_x : (1 / 3 : ℚ) < WB S := by
  have h := S.hdeg (.inr 0) (by simp [vegaActive])
  rw [Fintype.sum_sum_type] at h
  have hG : ∑ p : Fin (3 * i - 1), (if vegaAdj i (.inr 0) (.inl p) then S.w (.inl p) else 0) = 0 := by
    apply Finset.sum_eq_zero; intro p _; simp [vegaAdj]
  have hQ : ∑ q : Fin 8, (if vegaAdj i (.inr 0) (.inr q) then S.w (.inr q) else 0) = WB S := by
    rw [Fin.sum_univ_eight]
    simp [vegaAdj, WB, qy, qa, qb, qc]
  linarith

