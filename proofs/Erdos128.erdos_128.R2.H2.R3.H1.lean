section Stage1

/- ### Case 1A: `i >= 3` and `y > 0` (`dy = false`) -/

/-- Any vertex `p` in `Gamma_i` hits at most 2 vertices of a 5-cycle `s0-s2-s4-s1-s3-s0` (triangle-free!). -/
lemma hit_c5_le_two {i : ℕ} (hi : 2 ≤ i) {s0 s1 s2 s3 s4 : Fin (3 * i - 1)}
    (h02 : vegaAdj i (.inl s0) (.inl s2)) (h24 : vegaAdj i (.inl s2) (.inl s4))
    (h41 : vegaAdj i (.inl s4) (.inl s1)) (h13 : vegaAdj i (.inl s1) (.inl s3))
    (h30 : vegaAdj i (.inl s3) (.inl s0)) (p : Fin (3 * i - 1)) :
    (if vegaAdj i (.inl s0) (.inl p) then (1 : ℚ) else 0) +
    (if vegaAdj i (.inl s1) (.inl p) then 1 else 0) +
    (if vegaAdj i (.inl s2) (.inl p) then 1 else 0) +
    (if vegaAdj i (.inl s3) (.inl p) then 1 else 0) +
    (if vegaAdj i (.inl s4) (.inl p) then 1 else 0) ≤ 2 := by
  have hsym := @vegaAdj_symm i hi
  by_cases hp0 : vegaAdj i (.inl s0) (.inl p) <;>
  by_cases hp1 : vegaAdj i (.inl s1) (.inl p) <;>
  by_cases hp2 : vegaAdj i (.inl s2) (.inl p) <;>
  by_cases hp3 : vegaAdj i (.inl s3) (.inl p) <;>
  by_cases hp4 : vegaAdj i (.inl s4) (.inl p) <;>
  simp only [hp0, hp1, hp2, hp3, hp4, ↓reduceIte] <;>
  first
    | (norm_num; done)
    | exact (vegaAdj_gamma_triangleFree hi h02 hp2 (hsym hp0)).elim
    | exact (vegaAdj_gamma_triangleFree hi h24 hp4 (hsym hp2)).elim
    | exact (vegaAdj_gamma_triangleFree hi h41 hp1 (hsym hp4)).elim
    | exact (vegaAdj_gamma_triangleFree hi h13 hp3 (hsym hp1)).elim
    | exact (vegaAdj_gamma_triangleFree hi h30 hp0 (hsym hp3)).elim

/-- Helper: verify adjacency in `Gamma_i` from simple gap bounds. -/
lemma gamma_adj_of_gap {i : ℕ} (hi : 2 ≤ i) {p q : Fin (3 * i - 1)}
    (h : (p.val ≤ q.val ∧ i ≤ q.val - p.val ∧ q.val - p.val ≤ 2 * i - 1) ∨
         (q.val < p.val ∧ i ≤ q.val + (3 * i - 1) - p.val ∧ q.val + (3 * i - 1) - p.val ≤ 2 * i - 1)) :
    vegaAdj i (.inl p) (.inl q) := by
  simp only [vegaAdj]
  have hp := p.isLt; have hq := q.isLt
  rcases h with ⟨hle, h1, h2⟩ | ⟨hlt, h1, h2⟩
  · have hmod : (q.val + (3 * i - 1) - p.val) % (3 * i - 1) = q.val - p.val := by
      have : q.val + (3 * i - 1) - p.val = (q.val - p.val) + (3 * i - 1) := by omega
      rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
    rw [hmod]; omega
  · have hmod : (q.val + (3 * i - 1) - p.val) % (3 * i - 1) = q.val + (3 * i - 1) - p.val :=
      Nat.mod_eq_of_lt (by omega)
    rw [hmod]; omega

/-- Case 1A (`i >= 3, dy = false`): universal 5-cycle dual gives `W_j + L_j > 1/2` for ALL `j : Fin 3`. -/
lemma stage1_case1A {i : ℕ} {de : Bool} (S : VegaSystem i false de) (hi3 : 3 ≤ i) (j : Fin 3) :
    1 / 2 ≤ Wv S j + Lv S j := by
  have hi := S.hi
  let N := 3 * i - 1
  let Qcap : Fin 8 → ℚ := fun q =>
    match j with
    | 0 => if q.val = 2 ∨ q.val = 5 then 1 else if q.val = 0 ∨ q.val = 1 then 0 else 2
    | 1 => if q.val = 3 ∨ q.val = 6 then 1 else if q.val = 0 ∨ q.val = 1 then 0 else 2
    | 2 => if q.val = 4 ∨ q.val = 7 then 1 else if q.val = 0 ∨ q.val = 1 then 0 else 2
  have hQcap_sum : ∑ q : Fin 8, Qcap q * S.w (.inr q) = sig S j + 2 * Lv S j := by
    rw [Fin.sum_univ_eight]
    rcases fin3_cases j with rfl | rfl | rfl <;> (simp [Qcap, sig, Lv, Stot, av, uv, qa, qb, qc, qu, qv, qw]; ring)
  -- Build the 5-cycle S_j inside Gamma \ {2i - 1} for each j = 0, 1, 2
  have hgen : ∀ (s0 s1 s2 s3 s4 : Fin N),
      s0.val ≠ 2 * i - 1 → s1.val ≠ 2 * i - 1 → s2.val ≠ 2 * i - 1 → s3.val ≠ 2 * i - 1 → s4.val ≠ 2 * i - 1 →
      vegaAdj i (.inl s0) (.inl s2) → vegaAdj i (.inl s2) (.inl s4) →
      vegaAdj i (.inl s4) (.inl s1) → vegaAdj i (.inl s1) (.inl s3) → vegaAdj i (.inl s3) (.inl s0) →
      (∀ q : Fin 8,
        (if vegaAdj i (.inl s0) (.inr q) then (1 : ℚ) else 0) +
        (if vegaAdj i (.inl s1) (.inr q) then 1 else 0) +
        (if vegaAdj i (.inl s2) (.inr q) then 1 else 0) +
        (if vegaAdj i (.inl s3) (.inr q) then 1 else 0) +
        (if vegaAdj i (.inl s4) (.inr q) then 1 else 0) ≤ Qcap q) →
      1 / 2 ≤ Wv S j + Lv S j := by
    intro s0 s1 s2 s3 s4 hs0 hs1 hs2 hs3 hs4 h02 h24 h41 h13 h30 hQhit
    have hd0 := S.hdeg (.inl s0) (by simp [vegaActive, hs0])
    have hd1 := S.hdeg (.inl s1) (by simp [vegaActive, hs1])
    have hd2 := S.hdeg (.inl s2) (by simp [vegaActive, hs2])
    have hd3 := S.hdeg (.inl s3) (by simp [vegaActive, hs3])
    have hd4 := S.hdeg (.inl s4) (by simp [vegaActive, hs4])
    have hdx := deg_x S
    have hdy := deg_y S rfl
    have hda := deg_a S; have hdb := deg_b S; have hdc := deg_c S
    have hdu := deg_u S; have hdv := deg_v S; have hdw := deg_w S
    -- Sum of 5 Gamma degrees <= 2 * W_G + Q-terms!
    have h5sum : (5 / 3 : ℚ) <
        ∑ u : VegaV i,
          ((if vegaAdj i (.inl s0) u then (1 : ℚ) else 0) +
           (if vegaAdj i (.inl s1) u then 1 else 0) +
           (if vegaAdj i (.inl s2) u then 1 else 0) +
           (if vegaAdj i (.inl s3) u then 1 else 0) +
           (if vegaAdj i (.inl s4) u then 1 else 0)) * S.w u := by
      have heq : ∀ k : Fin N, ∑ u : VegaV i, (if vegaAdj i (.inl k) u then S.w u else 0) =
          ∑ u : VegaV i, (if vegaAdj i (.inl k) u then (1 : ℚ) else 0) * S.w u := by
        intro k; apply Finset.sum_congr rfl; intro u _; split_ifs <;> ring
      rw [heq s0] at hd0; rw [heq s1] at hd1; rw [heq s2] at hd2; rw [heq s3] at hd3; rw [heq s4] at hd4
      have hadd : ∑ u : VegaV i,
          ((if vegaAdj i (.inl s0) u then (1 : ℚ) else 0) +
           (if vegaAdj i (.inl s1) u then 1 else 0) +
           (if vegaAdj i (.inl s2) u then 1 else 0) +
           (if vegaAdj i (.inl s3) u then 1 else 0) +
           (if vegaAdj i (.inl s4) u then 1 else 0)) * S.w u =
          (∑ u : VegaV i, (if vegaAdj i (.inl s0) u then (1 : ℚ) else 0) * S.w u) +
          (∑ u : VegaV i, (if vegaAdj i (.inl s1) u then (1 : ℚ) else 0) * S.w u) +
          (∑ u : VegaV i, (if vegaAdj i (.inl s2) u then (1 : ℚ) else 0) * S.w u) +
          (∑ u : VegaV i, (if vegaAdj i (.inl s3) u then (1 : ℚ) else 0) * S.w u) +
          (∑ u : VegaV i, (if vegaAdj i (.inl s4) u then (1 : ℚ) else 0) * S.w u) := by
        simp_rw [add_mul, Finset.sum_add_distrib]
      linarith only [hd0, hd1, hd2, hd3, hd4, hadd]
    have h5le : ∑ u : VegaV i,
          ((if vegaAdj i (.inl s0) u then (1 : ℚ) else 0) +
           (if vegaAdj i (.inl s1) u then 1 else 0) +
           (if vegaAdj i (.inl s2) u then 1 else 0) +
           (if vegaAdj i (.inl s3) u then 1 else 0) +
           (if vegaAdj i (.inl s4) u then 1 else 0)) * S.w u ≤
        2 * WG S + sig S j + 2 * Lv S j := by
      rw [Fintype.sum_sum_type]
      have hG_le : ∑ p : Fin N,
          ((if vegaAdj i (.inl s0) (.inl p) then (1 : ℚ) else 0) +
           (if vegaAdj i (.inl s1) (.inl p) then 1 else 0) +
           (if vegaAdj i (.inl s2) (.inl p) then 1 else 0) +
           (if vegaAdj i (.inl s3) (.inl p) then 1 else 0) +
           (if vegaAdj i (.inl s4) (.inl p) then 1 else 0)) * S.w (.inl p) ≤ 2 * WG S := by
        have h1 : ∑ p : Fin N,
            ((if vegaAdj i (.inl s0) (.inl p) then (1 : ℚ) else 0) +
             (if vegaAdj i (.inl s1) (.inl p) then 1 else 0) +
             (if vegaAdj i (.inl s2) (.inl p) then 1 else 0) +
             (if vegaAdj i (.inl s3) (.inl p) then 1 else 0) +
             (if vegaAdj i (.inl s4) (.inl p) then 1 else 0)) * S.w (.inl p) ≤
            ∑ p : Fin N, 2 * S.w (.inl p) := by
          apply Finset.sum_le_sum; intro p _
          exact mul_le_mul_of_nonneg_right (hit_c5_le_two hi h02 h24 h41 h13 h30 p) (S.hw_nonneg (.inl p))
        have h2 : ∑ p : Fin N, 2 * S.w (.inl p) = 2 * WG S := by
          rw [← Finset.mul_sum]
          have htot := S.hw_sum; rw [Fintype.sum_sum_type] at htot
          have hsum := sum_all_eq S
          have hQ : ∑ q : Fin 8, S.w (.inr q) = WA S + WB S := by
            rw [Fin.sum_univ_eight]; simp [WA, WB, qx, qy, qa, qb, qc, qu, qv, qw]; ring
          linarith only [htot, hsum, hQ]
        linarith only [h1, h2]
      have hQ_le : ∑ q : Fin 8,
          ((if vegaAdj i (.inl s0) (.inr q) then (1 : ℚ) else 0) +
           (if vegaAdj i (.inl s1) (.inr q) then 1 else 0) +
           (if vegaAdj i (.inl s2) (.inr q) then 1 else 0) +
           (if vegaAdj i (.inl s3) (.inr q) then 1 else 0) +
           (if vegaAdj i (.inl s4) (.inr q) then 1 else 0)) * S.w (.inr q) ≤ sig S j + 2 * Lv S j := by
        have h1 : ∑ q : Fin 8,
            ((if vegaAdj i (.inl s0) (.inr q) then (1 : ℚ) else 0) +
             (if vegaAdj i (.inl s1) (.inr q) then 1 else 0) +
             (if vegaAdj i (.inl s2) (.inr q) then 1 else 0) +
             (if vegaAdj i (.inl s3) (.inr q) then 1 else 0) +
             (if vegaAdj i (.inl s4) (.inr q) then 1 else 0)) * S.w (.inr q) ≤
            ∑ q : Fin 8, Qcap q * S.w (.inr q) := by
          apply Finset.sum_le_sum; intro q _
          exact mul_le_mul_of_nonneg_right (hQhit q) (S.hw_nonneg (.inr q))
        linarith only [h1, hQcap_sum]
      linarith only [hG_le, hQ_le]
    have htot := sum_all_eq S
    rcases fin3_cases j with rfl | rfl | rfl <;>
      (simp only [WA, WB, Stot, Lv, sig, av, uv, W1, W2, W3] at h5sum h5le htot hdx hdy hda hdb hdc hdu hdv hdw ⊢
       linarith only [h5sum, h5le, htot, hdx, hdy, hda, hdb, hdc, hdu, hdv, hdw])
  rcases fin3_cases j with rfl | rfl | rfl
  · -- S_1 = {1, i, 2i-2, 2i, 3i-2}
    exact hgen ⟨1, by omega⟩ ⟨i, by omega⟩ ⟨2 * i - 2, by omega⟩ ⟨2 * i, by omega⟩ ⟨3 * i - 2, by omega⟩
      (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inr (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inr (by dsimp; omega)))
      (fun q => by rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        (simp [Qcap, vegaAdj] <;> split_ifs <;> (first | omega | norm_num)))
  · -- S_2 = {1, i-1, 2i-2, 2i, 3i-2}
    exact hgen ⟨1, by omega⟩ ⟨i - 1, by omega⟩ ⟨2 * i - 2, by omega⟩ ⟨2 * i, by omega⟩ ⟨3 * i - 2, by omega⟩
      (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inr (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inr (by dsimp; omega)))
      (fun q => by rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        (simp [Qcap, vegaAdj] <;> split_ifs <;> (first | omega | norm_num)))
  · -- S_3 = {0, i-2, i, 2i-2, 2i}
    exact hgen ⟨0, by omega⟩ ⟨i - 2, by omega⟩ ⟨i, by omega⟩ ⟨2 * i - 2, by omega⟩ ⟨2 * i, by omega⟩
      (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inr (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inl (by dsimp; omega)))
      (gamma_adj_of_gap hi (Or.inr (by dsimp; omega)))
      (fun q => by rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        (simp [Qcap, vegaAdj] <;> split_ifs <;> (first | omega | norm_num)))

/- ### Case 1B: `i >= 3` and `y = 0` (`dy = true`) -/

/-- Neighborhood of `a_j` or `u_j` has total weight `< 2/5` (independent set by triangle-freeness!). -/
lemma deg_aj_lt (S : VegaSystem i dy de) (j : Fin 3) :
    qx S + (match j with | 0 => qv S + qw S | 1 => qu S + qw S | 2 => qu S + qv S) + Wv S j < 2 / 5 := by
  let vidx : Fin 8 := match j with | 0 => 6 | 1 => 5 | 2 => 5
  let widx : Fin 8 := match j with | 0 => 7 | 1 => 7 | 2 => 6
  let T : Finset (VegaV i) := insert (.inr 0) (insert (.inr vidx) (insert (.inr widx) (Ij i j)))
  have hTind : ∀ p ∈ T, ∀ q ∈ T, ¬ vegaAdj i p q := by
    intro p hp q hq
    simp only [T, Finset.mem_insert] at hp hq
    have hinj := indep_Ij S.hi j
    rcases hp with rfl | rfl | rfl | hp <;> rcases hq with rfl | rfl | rfl | hq
    all_goals first
      | (rcases fin3_cases j with rfl | rfl | rfl <;> simp [vidx, widx, vegaAdj]; done)
      | (rcases fin3_cases j with rfl | rfl | rfl <;> cases q with
         | inr _ => simp [Ij] at hq
         | inl q => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hq; simp [vidx, widx, vegaAdj]; try omega)
      | (rcases fin3_cases j with rfl | rfl | rfl <;> cases p with
         | inr _ => simp [Ij] at hp
         | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hp; simp [vidx, widx, vegaAdj]; try omega)
      | exact hinj p hp q hq
  have h := S.hindep T hTind
  have hsum : ∑ z ∈ T, S.w z =
      qx S + (match j with | 0 => qv S + qw S | 1 => qu S + qw S | 2 => qu S + qv S) + Wv S j := by
    have h0I : (Sum.inr 0 : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    have hvI : (Sum.inr vidx : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    have hwI : (Sum.inr widx : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    have h0v : (Sum.inr 0 : VegaV i) ≠ Sum.inr vidx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [vidx]
    have h0w : (Sum.inr 0 : VegaV i) ≠ Sum.inr widx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [widx]
    have hvw : (Sum.inr vidx : VegaV i) ≠ Sum.inr widx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [vidx, widx]
    have h0n : (Sum.inr 0 : VegaV i) ∉ insert (Sum.inr vidx) (insert (Sum.inr widx) (Ij i j)) := by simp [h0v, h0w, h0I]
    have hvn : (Sum.inr vidx : VegaV i) ∉ insert (Sum.inr widx) (Ij i j) := by simp [hvw, hvI]
    dsimp only [T]
    rw [Finset.sum_insert h0n, Finset.sum_insert hvn, Finset.sum_insert hwI]
    rcases fin3_cases j with rfl | rfl | rfl <;> simp [vidx, widx, qx, qu, qv, qw, Wv] <;> ring
  linarith

lemma deg_uj_lt (S : VegaSystem i dy de) (j : Fin 3) :
    qy S + (match j with | 0 => qb S + qc S | 1 => qa S + qc S | 2 => qa S + qb S) + Wv S j < 2 / 5 := by
  let bidx : Fin 8 := match j with | 0 => 3 | 1 => 2 | 2 => 2
  let cidx : Fin 8 := match j with | 0 => 4 | 1 => 4 | 2 => 3
  let T : Finset (VegaV i) := insert (.inr 1) (insert (.inr bidx) (insert (.inr cidx) (Ij i j)))
  have hTind : ∀ p ∈ T, ∀ q ∈ T, ¬ vegaAdj i p q := by
    intro p hp q hq
    simp only [T, Finset.mem_insert] at hp hq
    have hinj := indep_Ij S.hi j
    rcases hp with rfl | rfl | rfl | hp <;> rcases hq with rfl | rfl | rfl | hq
    all_goals first
      | (rcases fin3_cases j with rfl | rfl | rfl <;> simp [bidx, cidx, vegaAdj]; done)
      | (rcases fin3_cases j with rfl | rfl | rfl <;> cases q with
         | inr _ => simp [Ij] at hq
         | inl q => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hq; simp [bidx, cidx, vegaAdj]; try omega)
      | (rcases fin3_cases j with rfl | rfl | rfl <;> cases p with
         | inr _ => simp [Ij] at hp
         | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hp; simp [bidx, cidx, vegaAdj]; try omega)
      | exact hinj p hp q hq
  have h := S.hindep T hTind
  have hsum : ∑ z ∈ T, S.w z =
      qy S + (match j with | 0 => qb S + qc S | 1 => qa S + qc S | 2 => qa S + qb S) + Wv S j := by
    have h1I : (Sum.inr 1 : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    have hbI : (Sum.inr bidx : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    have hcI : (Sum.inr cidx : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    have h1b : (Sum.inr 1 : VegaV i) ≠ Sum.inr bidx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [bidx]
    have h1c : (Sum.inr 1 : VegaV i) ≠ Sum.inr cidx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [cidx]
    have hbc : (Sum.inr bidx : VegaV i) ≠ Sum.inr cidx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [bidx, cidx]
    have h1n : (Sum.inr 1 : VegaV i) ∉ insert (Sum.inr bidx) (insert (Sum.inr cidx) (Ij i j)) := by simp [h1b, h1c, h1I]
    have hbn : (Sum.inr bidx : VegaV i) ∉ insert (Sum.inr cidx) (Ij i j) := by simp [hbc, hbI]
    dsimp only [T]
    rw [Finset.sum_insert h1n, Finset.sum_insert hbn, Finset.sum_insert hcI]
    rcases fin3_cases j with rfl | rfl | rfl <;> simp [bidx, cidx, qy, qa, qb, qc, Wv] <;> ring
  linarith

set_option maxHeartbeats 1000000 in
/-- Case 1B (`i >= 3, dy = true`): refutes any `j` with `W_j + L_j < 1/2` (giving Stage 1 for `i >= 3, y = 0`). -/
lemma stage1_case1B {i : ℕ} {de : Bool} (S : VegaSystem i true de) (hi3 : 3 ≤ i) (j : Fin 3) :
    1 / 2 ≤ Wv S j + Lv S j := by
  by_contra hB2; push Not at hB2
  have hy0 : qy S = 0 := S.hw_zero (.inr 1) (by simp [vegaActive])
  have hs_lt : sv S < 1 / 15 := sv_lt_of_ge_three S hi3
  have hs_nn : 0 ≤ sv S := add_nonneg (S.hw_nonneg (.inr 0)) (S.hw_nonneg (.inr 1))
  have hi2 : (2 : ℚ) ≤ ((i - 1 : ℕ) : ℚ) := by exact_mod_cast (by omega : 2 ≤ i - 1)
  have hW_gt2s : ∀ m : Fin 3, 2 * sv S < Wv S m := by
    intro m; have := Wv_gt_mul_s S m; nlinarith
  have hWG_lt := WG_lt_third_add_s S
  by_cases hs20 : sv S ≤ 1 / 20
  · -- Subcase 1B(1): s <= 1/20
    by_cases hReach : 1 / 2 ≤ Wv S j + Lv S j + sv S
    · have hr_lt : rv S j ≤ 11 / 180 := by
        have := eps_pos S j; simp only [rv]; linarith
      exact boundary2_contra_of_r_le S j hB2 hReach hr_lt
    · push Not at hReach
      -- Overflow into {a_j, u_j}: rem = 1/2 - W_j - L_j - s = W_j - 1/6 - eps_j > 0!
      set rem := 1 / 2 - Wv S j - Lv S j - sv S with hrem_def
      have hrem_pos : 0 < rem := by linarith
      have hrem_eq : rem = Wv S j - 1 / 6 - eps S j := by simp only [rem, eps, Lv]; have := Lv_eq S j; linarith
      have hrem_lt_sig : rem < sig S j := by
        have htot := sum_all_eq S
        have hSt := Stot_eq S
        have hLv : Lv S j + sig S j = Stot S := by simp only [Lv]; ring
        have hWother : WG S - Wv S j < 1 / 2 := by
          have : 0 ≤ Wv S j := by have := hW_gt2s j; linarith
          linarith
        linarith
      have hsig_pos : 0 < sig S j := by linarith
      set th := rem / sig S j with hth_def
      have hth : 0 ≤ th ∧ th ≤ 1 := ⟨div_nonneg (le_of_lt hrem_pos) (le_of_lt hsig_pos),
        (div_le_one hsig_pos).mpr (le_of_lt hrem_lt_sig)⟩
      -- Fractional selection: 1 on I_j ∪ {x, b_j, c_j, v_j, w_j}, th on {a_j, u_j}, 0 on rest
      let f : VegaV i → ℚ := fun z =>
        match z with
        | .inl p => if (.inl p : VegaV i) ∈ Ij i j then 1 else 0
        | .inr q =>
          match q.val with
          | 0 => 1 | 1 => 0
          | 2 => if j = 0 then th else 1
          | 3 => if j = 1 then th else 1
          | 4 => if j = 2 then th else 1
          | 5 => if j = 0 then th else 1
          | 6 => if j = 1 then th else 1
          | 7 => if j = 2 then th else 1
          | _ => 0
      have hf_rng : ∀ z, 0 ≤ f z ∧ f z ≤ 1 := by
        intro z; cases z with
        | inl p => dsimp only [f]; split_ifs <;> norm_num
        | inr q => rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rcases fin3_cases j with rfl | rfl | rfl <;> simp [f, hth.1, hth.2]
      have hf_sum : ∑ z : VegaV i, f z * S.w z = 1 / 2 := by
        rw [Fintype.sum_sum_type]
        have hG : ∑ p : Fin (3 * i - 1), f (.inl p) * S.w (.inl p) = Wv S j := by
          simpa [f] using sum_inl_Ij S j 1
        have hQ : ∑ q : Fin 8, f (.inr q) * S.w (.inr q) = qx S + Lv S j + th * sig S j := by
          rw [Fin.sum_univ_eight]
          rcases fin3_cases j with rfl | rfl | rfl <;> (simp [f, Lv, Stot, sig, av, uv, qx, qa, qb, qc, qu, qv, qw]; ring)
        have hmul : th * sig S j = rem := div_mul_cancel₀ _ (ne_of_gt hsig_pos)
        simp only [sv, hy0] at *; linarith
      have hfr := S.hfrac f hf_rng hf_sum
      -- Evaluate directed edge sum:
      --   2 * (E_j + x*(b_j + c_j) + th * (a_j * deg(a_j) + u_j * deg(u_j)))
      let B := match j with | 0 => qb S + qc S | 1 => qa S + qc S | 2 => qa S + qb S
      let V := match j with | 0 => qv S + qw S | 1 => qu S + qw S | 2 => qu S + qv S
      have hdbl : ∑ u : VegaV i, ∑ v : VegaV i, (if vegaAdj i u v then f u * f v * S.w u * S.w v else 0) =
          2 * (Ev S j + qx S * (B) +
               th * (av S j * (qx S + (V) + Wv S j) +
                     uv S j * (qy S + (B) + Wv S j))) := by
        have hGG : ∀ p q : Fin (3 * i - 1),
            (if vegaAdj i (.inl p) (.inl q) then f (.inl p) * f (.inl q) * S.w (.inl p) * S.w (.inl q) else 0) = 0 := by
          intro p q; split_ifs with h
          · by_cases hp : (.inl p : VegaV i) ∈ Ij i j
            · by_cases hq : (.inl q : VegaV i) ∈ Ij i j
              · exact (indep_Ij S.hi j (.inl p) hp (.inl q) hq h).elim
              · simp [f, hq]
            · simp [f, hp]
          · rfl
        have hQG : ∑ q : Fin 8, ∑ p : Fin (3 * i - 1),
            (if vegaAdj i (.inr q) (.inl p) then f (.inr q) * f (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) =
            th * (av S j * Wv S j + uv S j * Wv S j) := by
          have hstep : ∀ q : Fin 8, ∑ p : Fin (3 * i - 1),
              (if vegaAdj i (.inr q) (.inl p) then f (.inr q) * f (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) =
              if (j = 0 ∧ (q = 2 ∨ q = 5)) ∨ (j = 1 ∧ (q = 3 ∨ q = 6)) ∨ (j = 2 ∧ (q = 4 ∨ q = 7))
              then th * S.w (.inr q) * Wv S j else 0 := by
            have himpl : ∀ (j : Fin 3) (q : Fin 8) (p : Fin (3 * i - 1)),
                ¬((j = 0 ∧ (q = 2 ∨ q = 5)) ∨ (j = 1 ∧ (q = 3 ∨ q = 6)) ∨ (j = 2 ∧ (q = 4 ∨ q = 7))) →
                vegaAdj i (.inr q) (.inl p) → (.inl p : VegaV i) ∉ Ij i j := by
              intro j q p hnot hadj hmem
              rcases fin3_cases j with rfl | rfl | rfl
              · simp only [Ij] at hmem
                rw [mem_I1_inl] at hmem
                rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
                  simp only [vegaAdj] at hadj <;>
                  simp at hnot <;>
                  rcases hadj with ⟨hp, hq⟩ | ⟨hp1, hp2, hq⟩ | ⟨hp, hq⟩ <;>
                  simp at hq <;> omega
              · simp only [Ij] at hmem
                rw [mem_I2_inl] at hmem
                rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
                  simp only [vegaAdj] at hadj <;>
                  simp at hnot <;>
                  rcases hadj with ⟨hp, hq⟩ | ⟨hp1, hp2, hq⟩ | ⟨hp, hq⟩ <;>
                  simp at hq <;> omega
              · simp only [Ij] at hmem
                rw [mem_I3_inl] at hmem
                rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
                  simp only [vegaAdj] at hadj <;>
                  simp at hnot <;>
                  rcases hadj with ⟨hp, hq⟩ | ⟨hp1, hp2, hq⟩ | ⟨hp, hq⟩ <;>
                  simp at hq <;> omega
            intro q
            by_cases hc : (j = 0 ∧ (q = 2 ∨ q = 5)) ∨ (j = 1 ∧ (q = 3 ∨ q = 6)) ∨ (j = 2 ∧ (q = 4 ∨ q = 7))
            · rw [if_pos hc]
              have hfq : f (.inr q) = th := by
                rcases hc with ⟨rfl, hq⟩ | ⟨rfl, hq⟩ | ⟨rfl, hq⟩ <;>
                  rcases hq with rfl | rfl <;> simp [f]
              have hadj : ∀ p : Fin (3 * i - 1), vegaAdj i (.inr q) (.inl p) ↔ (.inl p : VegaV i) ∈ Ij i j := by
                intro p
                rcases hc with ⟨rfl, hq⟩ | ⟨rfl, hq⟩ | ⟨rfl, hq⟩ <;>
                  rcases hq with rfl | rfl <;>
                  simp [vegaAdj, Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl]
              rw [← sum_inl_Ij S j (th * S.w (.inr q))]
              apply Finset.sum_congr rfl; intro p _
              simp only [hadj p, f, hfq]
              split_ifs <;> ring
            · rw [if_neg hc]
              apply Finset.sum_eq_zero; intro p _
              by_cases hadj : vegaAdj i (.inr q) (.inl p)
              · rw [if_pos hadj]
                have hnot := himpl j q p hc hadj
                have hf0 : f (.inl p) = 0 := by simp [f, hnot]
                rw [hf0]; ring
              · rw [if_neg hadj]
          simp only [Fin.sum_univ_eight, hstep]
          rcases fin3_cases j with rfl | rfl | rfl <;> (simp [av, uv, qa, qb, qc, qu, qv, qw]; ring)
        have hGQ : ∑ p : Fin (3 * i - 1), ∑ q : Fin 8,
            (if vegaAdj i (.inl p) (.inr q) then f (.inl p) * f (.inr q) * S.w (.inl p) * S.w (.inr q) else 0) =
            th * (av S j * Wv S j + uv S j * Wv S j) := by
          rw [Finset.sum_comm, ← hQG]
          apply Finset.sum_congr rfl; intro q _; apply Finset.sum_congr rfl; intro p _
          have hsym : vegaAdj i (.inl p) (.inr q) ↔ vegaAdj i (.inr q) (.inl p) := ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
          by_cases h : vegaAdj i (.inr q) (.inl p) <;> simp [hsym, h]; ring
        have hQQ : ∑ p : Fin 8, ∑ q : Fin 8,
            (if vegaAdj i (.inr p) (.inr q) then f (.inr p) * f (.inr q) * S.w (.inr p) * S.w (.inr q) else 0) =
            2 * (Ev S j + qx S * (B) +
                 th * (av S j * (qx S + (V)) +
                       uv S j * (qy S + (B)))) := by
          rw [hy0]
          rcases fin3_cases j with rfl | rfl | rfl <;>
            (simp [Fin.sum_univ_eight, vegaAdj, f, Ev, av, uv, qx, qa, qb, qc, qu, qv, qw, B, V]; ring)
        rw [Fintype.sum_sum_type]
        have h1 : ∑ p : Fin (3 * i - 1), ∑ v : VegaV i,
            (if vegaAdj i (.inl p) v then f (.inl p) * f v * S.w (.inl p) * S.w v else 0) =
            th * (av S j * Wv S j + uv S j * Wv S j) := by
          simp_rw [Fintype.sum_sum_type, Finset.sum_add_distrib]
          have hz : ∑ p : Fin (3 * i - 1), ∑ q : Fin (3 * i - 1),
              (if vegaAdj i (.inl p) (.inl q) then f (.inl p) * f (.inl q) * S.w (.inl p) * S.w (.inl q) else 0) = 0 :=
            Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun q _ => hGG p q))
          rw [hz, zero_add, hGQ]
        have h2 : ∑ q : Fin 8, ∑ v : VegaV i,
            (if vegaAdj i (.inr q) v then f (.inr q) * f v * S.w (.inr q) * S.w v else 0) =
            th * (av S j * Wv S j + uv S j * Wv S j) +
            2 * (Ev S j + qx S * (B) +
                 th * (av S j * (qx S + (V)) +
                       uv S j * (qy S + (B)))) := by
          simp_rw [Fintype.sum_sum_type, Finset.sum_add_distrib]
          rw [hQG, hQQ]
        rw [h1, h2]; ring
      have hda_lt := deg_aj_lt S j
      have hdu_lt := deg_uj_lt S j
      have hav_nn : 0 ≤ av S j := by rcases fin3_cases j with rfl | rfl | rfl <;> exact S.hw_nonneg _
      have huv_nn : 0 ≤ uv S j := by rcases fin3_cases j with rfl | rfl | rfl <;> exact S.hw_nonneg _
      have hth_bound : th * (av S j * (qx S + (V) + Wv S j) +
          uv S j * (qy S + (B) + Wv S j)) ≤
          (2 / 5 : ℚ) * rem := by
        have h1 : av S j * (qx S + (V) + Wv S j) +
            uv S j * (qy S + (B) + Wv S j) ≤
            (2 / 5 : ℚ) * sig S j := by
          simp only [sig]; nlinarith only [hda_lt, hdu_lt, hav_nn, huv_nn]
        have h2 := mul_le_mul_of_nonneg_left h1 hth.1
        have hmul : th * ((2 / 5 : ℚ) * sig S j) = (2 / 5 : ℚ) * rem := by
          rw [mul_left_comm, div_mul_cancel₀ _ (ne_of_gt hsig_pos)]
        linarith
      have hEv_le : Ev S j ≤ Lv S j ^ 2 / 8 := by
        rcases fin3_cases j with rfl | rfl | rfl
        · have := Ev_le_of_y_zero S rfl 0 1 2 (by decide) (by decide) (by decide); nlinarith [sq_nonneg (sig S 1 - sig S 2)]
        · have := Ev_le_of_y_zero S rfl 1 0 2 (by decide) (by decide) (by decide); nlinarith [sq_nonneg (sig S 0 - sig S 2)]
        · have := Ev_le_of_y_zero S rfl 2 0 1 (by decide) (by decide) (by decide); nlinarith [sq_nonneg (sig S 0 - sig S 1)]
      have hbc_le : (B) ≤ (Lv S j + sv S + eps S j) / 2 := by
        have hd := dv_abs_lt S j
        have hbc_eq : (B) = (Lv S j + zv S j) / 2 := by
          rcases fin3_cases j with rfl | rfl | rfl <;> simp only [Lv, zv, dv, del, Tv, Stot, sig, av, uv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw, B] <;> ring
        simp only [zv, sv, hy0] at hbc_eq ⊢; linarith
      have hPhi_gt : (1 / 50 : ℚ) < Lv S j ^ 2 / 8 + sv S * (Lv S j + sv S + eps S j) / 2 + (2 / 5 : ℚ) * (Wv S j - 1 / 6 - eps S j) := by
        have hxs : qx S = sv S := by simp only [sv, hy0]; ring
        rw [hxs] at hdbl hth_bound
        have hmul : sv S * (B) ≤
            sv S * ((Lv S j + sv S + eps S j) / 2) := mul_le_mul_of_nonneg_left hbc_le hs_nn
        linarith
      -- Upper bound W_j <= W_max := 7/45 + s/3 + (2/3)*eps_j from Theorem A!
      have hW_max : Wv S j ≤ 7 / 45 + sv S / 3 + (2 / 3) * eps S j := by
        have hsig_j := sig_eq S j
        rcases fin3_cases j with rfl | rfl | rfl
        · have h1 := sig_add_W_lt S (j := 0) (k := 1) (by decide)
          have h2 := sig_add_W_lt S (j := 0) (k := 2) (by decide)
          simp only [WG, W1, W2, W3] at *; linarith
        · have h1 := sig_add_W_lt S (j := 1) (k := 0) (by decide)
          have h2 := sig_add_W_lt S (j := 1) (k := 2) (by decide)
          simp only [WG, W1, W2, W3] at *; linarith
        · have h1 := sig_add_W_lt S (j := 2) (k := 0) (by decide)
          have h2 := sig_add_W_lt S (j := 2) (k := 1) (by decide)
          simp only [WG, W1, W2, W3] at *; linarith
      set Wmax := (7 / 45 : ℚ) + sv S / 3 + (2 / 3) * eps S j with hWmax_def
      set Lmax := (2 / 3 : ℚ) - 2 * Wmax - sv S + eps S j with hLmax_def
      have hL_eq' : Lv S j = 2 / 3 - 2 * Wv S j - sv S + eps S j := by have := Lv_eq S j; simp only [rv] at this; linarith
      have hmono : Lv S j ^ 2 / 8 + sv S * (Lv S j + sv S + eps S j) / 2 + (2 / 5 : ℚ) * (Wv S j - 1 / 6 - eps S j) ≤
          Lmax ^ 2 / 8 + sv S * (Lmax + sv S + eps S j) / 2 + (2 / 5 : ℚ) * (Wmax - 1 / 6 - eps S j) := by
        have hdiff : (Lmax ^ 2 / 8 + sv S * (Lmax + sv S + eps S j) / 2 + (2 / 5 : ℚ) * (Wmax - 1 / 6 - eps S j)) -
            (Lv S j ^ 2 / 8 + sv S * (Lv S j + sv S + eps S j) / 2 + (2 / 5 : ℚ) * (Wv S j - 1 / 6 - eps S j)) =
            (Wmax - Wv S j) * ((Wmax + Wv S j) / 2 - (sv S + eps S j) / 2 + 1 / 15) := by
          rw [hL_eq']; simp only [Lmax]; ring
        have hpos_e := eps_pos S j; have hr_pos := rv_pos S j; simp only [rv] at hr_pos
        have hfac : 0 ≤ (Wmax + Wv S j) / 2 - (sv S + eps S j) / 2 + 1 / 15 := by linarith
        have hnn : 0 ≤ (Wmax - Wv S j) * ((Wmax + Wv S j) / 2 - (sv S + eps S j) / 2 + 1 / 15) :=
          mul_nonneg (by linarith) hfac
        linarith
      -- Apply cert_case1b1_overflow on (s, e) in [0, 1/20] x [0, s]!
      have he_pos := eps_pos S j
      have hr_pos := rv_pos S j
      have hs_pos : 0 < sv S := by simp only [rv] at hr_pos; linarith
      set u1 := 20 * sv S
      set u0 := 1 - u1
      set v1 := eps S j / sv S
      set v0 := 1 - v1
      have hu0 : 0 ≤ u0 := by simp only [u0, u1]; linarith
      have hu1 : 0 ≤ u1 := by simp only [u1]; linarith
      have hv1 : 0 ≤ v1 := div_nonneg (le_of_lt he_pos) (le_of_lt hs_pos)
      have hv0 : 0 ≤ v0 := by
        simp only [v0, v1]; have : eps S j ≤ sv S := by simp only [rv] at hr_pos; linarith
        exact sub_nonneg.mpr ((div_le_one hs_pos).mpr this)
      have hcert := cert_case1b1_overflow hu0 hu1 hv0 hv1 (by simp only [u0]; ring) (by simp only [v0]; ring)
      have hs_eq : (1 / 20 : ℚ) * u1 = sv S := by simp only [u1]; ring
      have he_eq : sv S * v1 = eps S j := mul_div_cancel₀ _ (ne_of_gt hs_pos)
      dsimp only at hcert
      rw [hs_eq, he_eq, ← hWmax_def, ← hLmax_def] at hcert
      linarith
  · -- Subcase 1B(2): 1/20 < s < 1/15
    push Not at hs20
    -- Pick m maximizing eps S m, so eps S m >= s / 3 and r_m <= (2/3) * s < 2/45!
    have hex_m : ∃ m : Fin 3, sv S / 3 ≤ eps S m := by
      have hsum := eps_sum S
      by_cases h0 : sv S / 3 ≤ eps S 0
      · exact ⟨0, h0⟩
      · by_cases h1 : sv S / 3 ≤ eps S 1
        · exact ⟨1, h1⟩
        · exact ⟨2, by linarith⟩
    obtain ⟨m, hm_eps⟩ := hex_m
    have hrm_le : rv S m ≤ 2 / 3 * sv S := by simp only [rv]; linarith
    have hrm_lt : rv S m < 2 / 45 := by linarith
    have hWm_lt : Wv S m < 1 / 3 - 3 * sv S := by
      have h0 := hW_gt2s 0; have h1 := hW_gt2s 1; have h2 := hW_gt2s 2
      rcases fin3_cases m with rfl | rfl | rfl <;> (simp only [WG, W1, W2, W3] at *; linarith)
    have hReach_m : 1 / 2 ≤ Wv S m + Lv S m + sv S := by
      have hLm := Lv_eq S m; simp only [rv] at hLm; linarith
    by_cases hB2_m : Wv S m + Lv S m < 1 / 2
    · exact boundary2_contra_of_r_le S m hB2_m hReach_m (by linarith)
    · push Not at hB2_m
      have hH1 := H1_pos_of_interior S m hB2_m
      have hEv_m : Ev S m ≤ Lv S m ^ 2 / 8 := by
        rcases fin3_cases m with rfl | rfl | rfl
        · have := Ev_le_of_y_zero S rfl 0 1 2 (by decide) (by decide) (by decide); nlinarith [sq_nonneg (sig S 1 - sig S 2)]
        · have := Ev_le_of_y_zero S rfl 1 0 2 (by decide) (by decide) (by decide); nlinarith [sq_nonneg (sig S 0 - sig S 2)]
        · have := Ev_le_of_y_zero S rfl 2 0 1 (by decide) (by decide) (by decide); nlinarith [sq_nonneg (sig S 0 - sig S 1)]
      have hLm_pos : 0 < Lv S m := by have := hW_gt2s m; linarith
      have hrm_pos := rv_pos S m
      have h1 : (1 / 50 : ℚ) < (1 / 3 + rv S m) * Lv S m / 8 := by
        have hpos : 0 < 1 / 3 + rv S m := by linarith
        nlinarith
      have hLm_lt : Lv S m < 7 / 15 - rv S m := by
        have hLm := Lv_eq S m; have hWm := hW_gt2s m; linarith
      have h2 : (1 / 3 + rv S m) * Lv S m < (1 / 3 + rv S m) * (7 / 15 - rv S m) :=
        mul_lt_mul_of_pos_left hLm_lt (by linarith)
      have h3 : (1 / 3 + rv S m) * (7 / 15 - rv S m) < 323 / 2025 := by
        have hid : 323 / 2025 - (1 / 3 + rv S m) * (7 / 15 - rv S m) = (2 / 45 - rv S m) * (4 / 45 - rv S m) := by ring
        nlinarith
      linarith

/- ### Case 1C: `i = 2` (`Upsilon_2`, `Upsilon_2 - y`, `Upsilon_2 - {3}`, `Grotzsch`) -/

/-- Helper to evaluate `S.hdeg z` cleanly on `VegaV 2`. -/
lemma deg_v2 {dy de : Bool} (S : VegaSystem 2 dy de) (z : VegaV 2) (hz : vegaActive 2 dy de z) :
    (1 / 3 : ℚ) <
      (if vegaAdj 2 z (.inl 0) then S.w (.inl 0) else 0) +
      (if vegaAdj 2 z (.inl 1) then S.w (.inl 1) else 0) +
      (if vegaAdj 2 z (.inl 2) then S.w (.inl 2) else 0) +
      (if vegaAdj 2 z (.inl 3) then S.w (.inl 3) else 0) +
      (if vegaAdj 2 z (.inl 4) then S.w (.inl 4) else 0) +
      (if vegaAdj 2 z (.inr 0) then S.w (.inr 0) else 0) +
      (if vegaAdj 2 z (.inr 1) then S.w (.inr 1) else 0) +
      (if vegaAdj 2 z (.inr 2) then S.w (.inr 2) else 0) +
      (if vegaAdj 2 z (.inr 3) then S.w (.inr 3) else 0) +
      (if vegaAdj 2 z (.inr 4) then S.w (.inr 4) else 0) +
      (if vegaAdj 2 z (.inr 5) then S.w (.inr 5) else 0) +
      (if vegaAdj 2 z (.inr 6) then S.w (.inr 6) else 0) +
      (if vegaAdj 2 z (.inr 7) then S.w (.inr 7) else 0) := by
  have h := S.hdeg z hz
  rw [Fintype.sum_sum_type, Fin.sum_univ_five, Fin.sum_univ_eight] at h
  linarith

lemma deg_v2_0 {dy de : Bool} (S : VegaSystem 2 dy de) :
    (1 / 3 : ℚ) < S.w (.inl 2) + S.w (.inl 3) + qa S + qu S := by
  have h := deg_v2 S (.inl 0) (by simp [vegaActive]); norm_num [vegaAdj] at h; simp only [qa, qu]; linarith only [h]
lemma deg_v2_1 {dy de : Bool} (S : VegaSystem 2 dy de) :
    (1 / 3 : ℚ) < S.w (.inl 3) + S.w (.inl 4) + qa S + qu S := by
  have h := deg_v2 S (.inl 1) (by simp [vegaActive]); norm_num [vegaAdj] at h; simp only [qa, qu]; linarith only [h]
lemma deg_v2_2 {dy de : Bool} (S : VegaSystem 2 dy de) :
    (1 / 3 : ℚ) < S.w (.inl 0) + S.w (.inl 4) + qb S + qv S := by
  have h := deg_v2 S (.inl 2) (by simp [vegaActive]); norm_num [vegaAdj] at h; simp only [qb, qv]; linarith only [h]
lemma deg_v2_3 {dy : Bool} (S : VegaSystem 2 dy false) :
    (1 / 3 : ℚ) < S.w (.inl 0) + S.w (.inl 1) + qb S + qv S := by
  have h := deg_v2 S (.inl 3) (by simp [vegaActive]); norm_num [vegaAdj] at h; simp only [qb, qv]; linarith only [h]
lemma deg_v2_4 {dy de : Bool} (S : VegaSystem 2 dy de) :
    (1 / 3 : ℚ) < S.w (.inl 1) + S.w (.inl 2) + qc S + qw S := by
  have h := deg_v2 S (.inl 4) (by simp [vegaActive]); norm_num [vegaAdj] at h; simp only [qc, qw]; linarith only [h]

lemma sum_v2 {dy de : Bool} (S : VegaSystem 2 dy de) :
    S.w (.inl 0) + S.w (.inl 1) + S.w (.inl 2) + S.w (.inl 3) + S.w (.inl 4) +
    qx S + qy S + qa S + qb S + qc S + qu S + qv S + qw S = 1 := by
  have h := S.hw_sum
  rw [Fintype.sum_sum_type, Fin.sum_univ_five, Fin.sum_univ_eight] at h
  simp only [qx, qy, qa, qb, qc, qu, qv, qw]; linarith

lemma W1_v2 {dy de : Bool} (S : VegaSystem 2 dy de) : W1 S = S.w (.inl 0) + S.w (.inl 1) := by
  simp only [W1, Wv, Ij, I1, Finset.sum_filter]
  rw [Fintype.sum_sum_type, Fin.sum_univ_five, Fin.sum_univ_eight]; simp [inI1]

lemma W2_v2 {dy de : Bool} (S : VegaSystem 2 dy de) : W2 S = S.w (.inl 2) + S.w (.inl 3) := by
  simp only [W2, Wv, Ij, I2, Finset.sum_filter]
  rw [Fintype.sum_sum_type, Fin.sum_univ_five, Fin.sum_univ_eight]; simp [inI2]

lemma W3_v2 {dy de : Bool} (S : VegaSystem 2 dy de) : W3 S = S.w (.inl 4) := by
  simp only [W3, Wv, Ij, I3, Finset.sum_filter]
  rw [Fintype.sum_sum_type, Fin.sum_univ_five, Fin.sum_univ_eight]; simp [inI3]

/-- Explicit involutions and isomorphisms on `VegaV 2` (checked by `decide`!). -/
