/-- Case 1C(1): Refute `Upsilon_2` (`i = 2, dy = false, de = false`) completely! -/
lemma contra_upsilon2_with_orb (S : VegaSystem 2 false false) (horb : qx S + qy S ≤ S.w (.inl 0) + S.w (.inl 3)) : False := by
  by_cases hInt : ∀ j : Fin 3, 1 / 2 ≤ Wv S j + Lv S j
  · exact stage3_interior_contra S hInt
  · push Not at hInt
    -- Exact linear duals on Upsilon_2 with x + y <= w0 + w3!
    have hd0 := deg_v2_0 S; have hd1 := deg_v2_1 S; have hd2 := deg_v2_2 S
    have hd3 := deg_v2_3 S; have hd4 := deg_v2_4 S
    have hdx := deg_x S; have hdy := deg_y S rfl
    have hda := deg_a S; have hdb := deg_b S; have hdc := deg_c S
    have hdu := deg_u S; have hdv := deg_v S; have hdw := deg_w S
    have hsum := sum_v2 S
    have hW1 := W1_v2 S; have hW2 := W2_v2 S; have hW3 := W3_v2 S
    have hnn : ∀ z : VegaV 2, 0 ≤ S.w z := S.hw_nonneg
    have hind1 : S.w (.inl 2) + S.w (.inl 3) + qa S + qu S < 2 / 5 := by
      have := sig_add_W_lt S (j := 0) (k := 1) (by decide); simp only [sig, av, uv, Wv, W2] at *; linarith
    have hind2 : S.w (.inl 0) + S.w (.inl 1) + qb S + qv S < 2 / 5 := by
      have := sig_add_W_lt S (j := 1) (k := 0) (by decide); simp only [sig, av, uv, Wv, W1] at *; linarith
    -- Linear duals: W3 + L3 > 1/2, W3 > s + eps3, s < 1/12, W1+L1+s > 1/2, W2+L2+s > 1/2!
    have hW3L3 : 1 / 2 < W3 S + Lv S 2 := by
      simp only [Lv, Stot, sig, av, uv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 1), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hReach0 : 1 / 2 ≤ W1 S + Lv S 0 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 1), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hReach1 : 1 / 2 ≤ W2 S + Lv S 1 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 1), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hW3_gt : sv S + eps S 2 < W3 S := by
      simp only [eps, Lv, Stot, sig, av, uv, sv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw] at *; linarith only [hd4, horb, hsum, hW3]
    have hW1_gt := W1_gt_W3_add_eps1 S
    have hW2_gt := W2_gt_W3_add_eps2 S rfl
    have hWG_lt := WG_lt_third_of_y S rfl
    have heps_s := eps_sum S
    have heps0 := eps_pos S 0
    have heps1 := eps_pos S 1
    -- 4*s + 2*eps3 < 1/3!
    have h4s : 4 * sv S + 2 * eps S 2 < 1 / 3 := by simp only [WG] at hWG_lt; linarith only [hWG_lt, hW1_gt, hW2_gt, hW3_gt, heps_s]
    -- Helper: kill either j = 0 or j = 1 with B2!
    have hkill01 : ∀ (B1 : W1 S + Lv S 0 < 1 / 2), False := by
      intro hB1
      by_cases hr1 : rv S 0 ≤ 11 / 180
      · exact boundary2_contra_of_r_le S 0 hB1 hReach0 hr1
      · push Not at hr1
        have hW2_ge : 3 / 25 ≤ W2 S := by simp only [rv] at hr1; linarith only [hr1, heps0, heps_s, hW3_gt, hW2_gt]
        have hr2_lt : rv S 1 < 7 / 150 := by simp only [rv] at hr1 ⊢; linarith only [hr1, heps0, heps_s, h4s]
        by_cases hB2 : W2 S + Lv S 1 < 1 / 2
        · exact boundary2_contra_of_r_le S 1 hB2 hReach1 (by linarith only [hr2_lt])
        · push Not at hB2
          exact contra_of_interior_and_W_ge S 1 hB2 hW2_ge
    obtain ⟨j, hj⟩ := hInt
    rcases fin3_cases j with rfl | rfl | rfl
    · exact hkill01 hj
    · -- Swap 1 <-> 2 via `swap12_v2` (preserves `horb` since 0 <-> 3 and x, y fixed!)
      let S' := S.transport (dy' := false) (de' := false) swap12_v2 (by decide) (by decide)
      have horb' : qx S' + qy S' ≤ S'.w (.inl 0) + S'.w (.inl 3) := by
        have e0 : S'.w (Sum.inl 0) = S.w (Sum.inl 3) := rfl
        have e1 : S'.w (Sum.inl 3) = S.w (Sum.inl 0) := rfl
        have ex : qx S' = qx S := rfl
        have ey : qy S' = qy S := rfl
        rw [ex, ey, e0, e1]
        linarith only [horb]
      have hW1' : W1 S' = W2 S := by
        rw [W1_v2 S', hW2]
        have e0 : S'.w (Sum.inl 0) = S.w (Sum.inl 3) := rfl
        have e1 : S'.w (Sum.inl 1) = S.w (Sum.inl 2) := rfl
        rw [e0, e1]; ring
      have hW2' : W2 S' = W1 S := by
        rw [W2_v2 S', hW1]
        have e2 : S'.w (Sum.inl 2) = S.w (Sum.inl 1) := rfl
        have e3 : S'.w (Sum.inl 3) = S.w (Sum.inl 0) := rfl
        rw [e2, e3]; ring
      have hL1' : Lv S' 0 = Lv S 1 := by
        simp only [Lv, Stot, sig, av, uv, qa, qb, qc, qu, qv, qw, S', VegaSystem.transport, swap12_v2, Equiv.coe_fn_symm_mk, swap12_v2_fn]; ring
      have hL2' : Lv S' 1 = Lv S 0 := by
        simp only [Lv, Stot, sig, av, uv, qa, qb, qc, qu, qv, qw, S', VegaSystem.transport, swap12_v2, Equiv.coe_fn_symm_mk, swap12_v2_fn]; ring
      have hs' : sv S' = sv S := by simp only [sv, qx, qy, S', VegaSystem.transport, swap12_v2, Equiv.coe_fn_symm_mk, swap12_v2_fn]
      have hB1' : W1 S' + Lv S' 0 < 1 / 2 := by simp only [W2] at hW1'; linarith only [hj, hW1', hL1']
      have hReach0' : 1 / 2 ≤ W1 S' + Lv S' 0 + sv S' := by linarith only [hReach1, hW1', hL1', hs']
      have hr_eq : rv S' 0 = rv S 1 ∧ rv S' 1 = rv S 0 := by
        simp only [rv, eps, W1, W2] at hW1' hW2' ⊢; constructor <;> linarith only [hW1', hW2', hL1', hL2', hs']
      by_cases hr1' : rv S' 0 ≤ 11 / 180
      · exact boundary2_contra_of_r_le S' 0 hB1' hReach0' hr1'
      · push Not at hr1'
        have hW1_ge : 3 / 25 ≤ W1 S := by simp only [rv] at hr_eq hr1'; linarith only [hr_eq.1, hr1', heps1, heps_s, hW3_gt, hW1_gt]
        have hr0_lt : rv S 0 < 7 / 150 := by simp only [rv] at hr_eq hr1' ⊢; linarith only [hr_eq.1, hr1', heps1, heps_s, h4s]
        by_cases hB0 : W1 S + Lv S 0 < 1 / 2
        · exact boundary2_contra_of_r_le S 0 hB0 hReach0 (by linarith only [hr0_lt])
        · push Not at hB0
          exact contra_of_interior_and_W_ge S 0 hB0 hW1_ge
    · simp only [W3] at hW3L3; linarith only [hj, hW3L3]

lemma contra_upsilon2 (S : VegaSystem 2 false false) : False := by
  by_cases horb : qx S + qy S ≤ S.w (.inl 0) + S.w (.inl 3)
  · exact contra_upsilon2_with_orb S horb
  · let S' := S.transport (dy' := false) (de' := false) aut_full_v2 (by decide) (by decide)
    have horb' : qx S' + qy S' ≤ S'.w (.inl 0) + S'.w (.inl 3) := by
      have ex : qx S' = S.w (Sum.inl 0) := rfl
      have ey : qy S' = S.w (Sum.inl 3) := rfl
      have e0 : S'.w (Sum.inl 0) = qx S := rfl
      have e1 : S'.w (Sum.inl 3) = qy S := rfl
      rw [ex, ey, e0, e1]
      linarith only [horb]
    exact contra_upsilon2_with_orb S' horb'

/-- Case 1C(2a helper): On `Upsilon_2 - {3}` (`i = 2, dy = false, de = true`), if `s <= 11/180`, contradiction! -/
lemma contra_upsilon2_no3_of_s_le (S : VegaSystem 2 false true) (hs_le : sv S ≤ 11 / 180) : False := by
  by_cases hInt : ∀ j : Fin 3, 1 / 2 ≤ Wv S j + Lv S j
  · exact stage3_interior_contra S hInt
  · push Not at hInt
    have hd0 := deg_v2_0 S; have hd1 := deg_v2_1 S; have hd2 := deg_v2_2 S; have hd4 := deg_v2_4 S
    have h3z : S.w (.inl 3) = 0 := S.hw_zero (.inl 3) (by decide)
    have hdx := deg_x S; have hdy := deg_y S rfl
    have hda := deg_a S; have hdb := deg_b S; have hdc := deg_c S
    have hdu := deg_u S; have hdv := deg_v S; have hdw := deg_w S
    have hsum := sum_v2 S
    have hW1 := W1_v2 S; have hW2 := W2_v2 S; have hW3 := W3_v2 S
    have hnn : ∀ z : VegaV 2, 0 ≤ S.w z := S.hw_nonneg
    have hI01 := sig_add_W_lt S (j := 0) (k := 1) (by decide)
    have hI02 := sig_add_W_lt S (j := 0) (k := 2) (by decide)
    have hI10 := sig_add_W_lt S (j := 1) (k := 0) (by decide)
    have hI20 := sig_add_W_lt S (j := 2) (k := 0) (by decide)
    have hReach0 : 1 / 2 ≤ W1 S + Lv S 0 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WA, WB, Wv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 1), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hReach1 : 1 / 2 ≤ W2 S + Lv S 1 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WA, WB, Wv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 1), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hReach2 : 1 / 2 ≤ W3 S + Lv S 2 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WA, WB, Wv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 1), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    obtain ⟨j, hj⟩ := hInt
    have hr_le : rv S j ≤ 11 / 180 := by have := eps_pos S j; simp only [rv]; linarith
    rcases fin3_cases j with rfl | rfl | rfl
    · exact boundary2_contra_of_r_le S 0 hj hReach0 hr_le
    · exact boundary2_contra_of_r_le S 1 hj hReach1 hr_le
    · exact boundary2_contra_of_r_le S 2 hj hReach2 hr_le

/-- Case 1C(2): Refute `Upsilon_2 - y` (`i = 2, dy = true, de = false`) completely! -/
lemma contra_upsilon2_noy_with_orb (S : VegaSystem 2 true false) (horb : qx S ≤ qw S) : False := by
  by_cases hInt : ∀ j : Fin 3, 1 / 2 ≤ Wv S j + Lv S j
  · exact stage3_interior_contra S hInt
  · push Not at hInt
    by_cases h03 : S.w (.inl 0) + S.w (.inl 3) ≤ 11 / 180
    · -- Subcase 1C-2a: switch to Upsilon_2 - {3} where s' = w0 + w3 <= 11/180!
      let S' := S.transport (dy' := false) (de' := true) phi_noy_to_no3 (by decide) (by decide)
      have hs' : sv S' ≤ 11 / 180 := by
        simp only [sv, qx, qy, S', VegaSystem.transport, phi_noy_to_no3, Equiv.coe_fn_symm_mk, phi_no3_to_noy_fn]; exact h03
      exact contra_upsilon2_no3_of_s_le S' hs'
    · push Not at h03
      -- Subcase 1C-2b: w0 + w3 > 11/180!
      have hy0 : qy S = 0 := S.hw_zero (.inr 1) (by decide)
      have hd0 := deg_v2_0 S; have hd1 := deg_v2_1 S; have hd2 := deg_v2_2 S
      have hd3 := deg_v2_3 S; have hd4 := deg_v2_4 S
      have hdx := deg_x S
      have hda := deg_a S; have hdb := deg_b S; have hdc := deg_c S
      have hdu := deg_u S; have hdv := deg_v S; have hdw := deg_w S
      have hsum := sum_v2 S
      have hW1 := W1_v2 S; have hW2 := W2_v2 S; have hW3 := W3_v2 S
      have hnn : ∀ z : VegaV 2, 0 ≤ S.w z := S.hw_nonneg
      -- Exact linear duals: s < 1/12, W3 + L3 > 1/2, W1+L1+s > 1/2, W2+L2+s > 1/2, W3 > (w0+w3) + eps3!
      have hs_lt : sv S < 1 / 12 := by
        simp only [sv, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
        linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
          hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
      have hW3L3 : 1 / 2 < W3 S + Lv S 2 := by
        simp only [Lv, Stot, sig, av, uv, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
        linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
          hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
      have hReach0 : 1 / 2 ≤ W1 S + Lv S 0 + sv S := by
        simp only [Lv, Stot, sig, av, uv, sv, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
        linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
          hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
      have hReach1 : 1 / 2 ≤ W2 S + Lv S 1 + sv S := by
        simp only [Lv, Stot, sig, av, uv, sv, WB, qx, qy, qa, qb, qc, qu, qv, qw] at *
        linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 3), hnn (.inl 4),
          hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
      have hW3_gt : 11 / 180 + eps S 2 < W3 S := by
        simp only [eps, Lv, Stot, sig, av, uv, sv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw] at *
        linarith only [hd4, h03, hsum, hW3]
      have hW1_gt := W1_gt_W3_add_eps1 S
      have hW2_gt := W2_gt_W3_add_eps2 S rfl
      have heps_s := eps_sum S
      -- Helper: if r_k > 11/180 and W_l + L_l >= 1/2 (for {k, l} = {0, 1}), kill via P_{1,l} < 289/16200 < 1/50!
      -- Otherwise BOTH r_0 > 11/180 and r_1 > 11/180 -> kill via P_{1,2} < 323/16200 < 1/50!
      have hkill_pair : ∀ (r0_gt : 11 / 180 < rv S 0) (r1_gt : 11 / 180 < rv S 1), False := by
        intro hr0 hr1
        have hH1_2 := H1_pos_of_interior S 2 (le_of_lt hW3L3)
        have hEv2 := Ev_le_of_y_zero S rfl 2 0 1 (by decide) (by decide) (by decide)
        have hL2 := Lv_eq S 2
        have hr2_pos := rv_pos S 2
        have hr2_lt : rv S 2 < 2 / 45 := by simp only [rv] at hr0 hr1 ⊢; linarith only [hr0, hr1, heps_s, hs_lt]
        have hL2_lt : Lv S 2 < 19 / 45 := by
          simp only [rv, W3] at hr0 hr1 hW3_gt hL2 ⊢; linarith only [hL2, hW3_gt, heps_s, hr0, hr1]
        have hL2_pos : 0 < Lv S 2 := by
          have hWG := WG_lt_third_add_s S
          have hW0s := Wv_gt_s S 0; have hW1s := Wv_gt_s S 1
          have hr2p := rv_pos S 2
          simp only [WG, W1, W2, W3] at hWG hW3L3
          simp only [rv] at hL2 hr2p hr0 hr1
          linarith only [hW3L3, hWG, hW0s, hW1s, hL2, hr2p, heps_s, hr0, hr1]
        have hEv2' : Ev S 2 ≤ Lv S 2 ^ 2 / 8 := by nlinarith only [hEv2, sq_nonneg (sig S 0 - sig S 1)]
        have hprod : (1 / 3 + rv S 2) * Lv S 2 < 4 / 25 := by nlinarith only [hr2_pos, hr2_lt, hL2_pos, hL2_lt]
        nlinarith only [hH1_2, hEv2', hL2_pos, hr2_pos, hprod]
      have hkill_int_2tau : ∀ m : Fin 3, 1 / 2 ≤ Wv S m + Lv S m → 11 / 90 < Wv S m → False := by
        intro m hInt_m hWm_gt
        have hH1 := H1_pos_of_interior S m hInt_m
        have hEv : Ev S m ≤ Lv S m ^ 2 / 8 := by
          rcases fin3_cases m with rfl | rfl | rfl
          · have := Ev_le_of_y_zero S rfl 0 1 2 (by decide) (by decide) (by decide); nlinarith only [this, sq_nonneg (sig S 1 - sig S 2)]
          · have := Ev_le_of_y_zero S rfl 1 0 2 (by decide) (by decide) (by decide); nlinarith only [this, sq_nonneg (sig S 0 - sig S 2)]
          · have := Ev_le_of_y_zero S rfl 2 0 1 (by decide) (by decide) (by decide); nlinarith only [this, sq_nonneg (sig S 0 - sig S 1)]
        have hLm := Lv_eq S m
        have hrm_pos := rv_pos S m
        have hLm_lt : Lv S m < 19 / 45 - rv S m := by linarith only [hLm, hWm_gt]
        have hLm_pos : 0 < Lv S m := by linarith only [hLm, hInt_m, hWm_gt, hrm_pos]
        have h1a : (1 / 50 : ℚ) < (1 / 3 + rv S m) * Lv S m / 8 := by nlinarith only [hH1, hEv, hLm_pos, hrm_pos]
        have h1 : (1 / 50 : ℚ) < (1 / 3 + rv S m) * (19 / 45 - rv S m) / 8 := by nlinarith only [h1a, hLm_lt, hrm_pos]
        have h2 : (1 / 3 + rv S m) * (19 / 45 - rv S m) ≤ 289 / 2025 := by
          nlinarith only [sq_nonneg (rv S m - 2 / 45)]
        linarith only [h1, h2]
      obtain ⟨j, hj⟩ := hInt
      rcases fin3_cases j with rfl | rfl | rfl
      · by_cases hr0 : rv S 0 ≤ 11 / 180
        · exact boundary2_contra_of_r_le S 0 hj hReach0 hr0
        · push Not at hr0
          by_cases hB1 : W2 S + Lv S 1 < 1 / 2
          · by_cases hr1 : rv S 1 ≤ 11 / 180
            · exact boundary2_contra_of_r_le S 1 hB1 hReach1 hr1
            · exact hkill_pair hr0 (lt_of_not_ge hr1)
          · push Not at hB1
            have hW2_2tau : 11 / 90 < W2 S := by simp only [rv] at hr0; linarith only [hr0, hW3_gt, hW2_gt, heps_s]
            exact hkill_int_2tau 1 hB1 hW2_2tau
      · by_cases hr1 : rv S 1 ≤ 11 / 180
        · exact boundary2_contra_of_r_le S 1 hj hReach1 hr1
        · push Not at hr1
          by_cases hB0 : W1 S + Lv S 0 < 1 / 2
          · by_cases hr0 : rv S 0 ≤ 11 / 180
            · exact boundary2_contra_of_r_le S 0 hB0 hReach0 hr0
            · exact hkill_pair (lt_of_not_ge hr0) hr1
          · push Not at hB0
            have hW1_2tau : 11 / 90 < W1 S := by simp only [rv] at hr1; linarith only [hr1, hW3_gt, hW1_gt, heps_s]
            exact hkill_int_2tau 0 hB0 hW1_2tau
      · simp only [W3] at hW3L3; linarith only [hj, hW3L3]

lemma contra_upsilon2_noy (S : VegaSystem 2 true false) : False := by
  by_cases horb : qx S ≤ qw S
  · exact contra_upsilon2_noy_with_orb S horb
  · let S' := S.transport (dy' := true) (de' := false) aut_noy_v2 (by decide) (by decide)
    have horb' : qx S' ≤ qw S' := by
      have ex : qx S' = qw S := rfl
      have ew : qw S' = qx S := rfl
      rw [ex, ew]
      linarith only [horb]
    exact contra_upsilon2_noy_with_orb S' horb'

lemma contra_upsilon2_no3 (S : VegaSystem 2 false true) : False := by
  let S' := S.transport (dy' := true) (de' := false) phi_noy_to_no3.symm (by decide) (by decide)
  exact contra_upsilon2_noy S'

set_option maxHeartbeats 1000000 in
lemma contra_grotzsch_norm (S : VegaSystem 2 true true)
    (hx_v : qx S ≤ qv S) (hx_w : qx S ≤ qw S) (hx_0 : qx S ≤ S.w (.inl 0)) (hx_1 : qx S ≤ S.w (.inl 1))
    (heps23 : eps S 2 ≤ eps S 1) : False := by
  by_cases hInt : ∀ j : Fin 3, 1 / 2 ≤ Wv S j + Lv S j
  · exact stage3_interior_contra S hInt
  · push Not at hInt
    have hy0 : qy S = 0 := S.hw_zero (.inr 1) (by decide)
    have h3z : S.w (.inl 3) = 0 := S.hw_zero (.inl 3) (by decide)
    have hd0 := deg_v2_0 S; have hd1 := deg_v2_1 S; have hd2 := deg_v2_2 S; have hd4 := deg_v2_4 S
    have hdx := deg_x S
    have hda := deg_a S; have hdb := deg_b S; have hdc := deg_c S
    have hdu := deg_u S; have hdv := deg_v S; have hdw := deg_w S
    have hsum := sum_v2 S
    have hW1 := W1_v2 S; have hW2 := W2_v2 S; have hW3 := W3_v2 S
    have hnn : ∀ z : VegaV 2, 0 ≤ S.w z := S.hw_nonneg
    -- Independent 5-set {0, 1, v, w, x}:
    have hind5 : S.w (.inl 0) + S.w (.inl 1) + qv S + qw S + qx S < 2 / 5 := by
      let T : Finset (VegaV 2) := {.inl 0, .inl 1, .inr 6, .inr 7, .inr 0}
      have h := S.hindep T (by decide)
      have heq : ∑ z ∈ T, S.w z = S.w (.inl 0) + S.w (.inl 1) + qv S + qw S + qx S := by
        simp [T, qv, qw, qx]; ring
      linarith
    have hI10 := sig_add_W_lt S (j := 1) (k := 0) (by decide)
    have hI20 := sig_add_W_lt S (j := 2) (k := 0) (by decide)
    -- Exact linear duals on Grotzsch!
    have hs_lt : sv S < 2 / 25 := by simp only [sv, hy0]; linarith
    have hW1_ge2s : 2 * sv S ≤ W1 S := by simp only [sv, hy0]; linarith
    have hr0_lt : rv S 0 < 1 / 15 := by
      have hL0 := Lv_eq S 0
      simp only [Lv, Stot, sig, av, uv, W1, qx, qy, qa, qb, qc, qu, qv, qw] at hL0 hda hdu hW1 hx_v hx_w hx_0 hx_1 hy0
      linarith only [hL0, hda, hdu, hW1, hx_v, hx_w, hx_0, hx_1, hy0]
    have hW2_gt : sv S + eps S 1 < W2 S := by
      simp only [eps, Lv, Stot, sig, av, uv, sv, W2, qx, qy, qa, qb, qc, qu, qv, qw, h3z] at *
      linarith only [hd2, hx_1, hsum, hW2, hy0]
    have hW3_gt : sv S + eps S 2 < W3 S := by
      simp only [eps, Lv, Stot, sig, av, uv, sv, W3, qx, qy, qa, qb, qc, qu, qv, qw, h3z] at *
      linarith only [hd4, hx_0, hsum, hW3, hy0]
    have hReach0 : 1 / 2 ≤ W1 S + Lv S 0 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WB, qx, qy, qa, qb, qc, qu, qv, qw, h3z] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hReach1 : 1 / 2 ≤ W2 S + Lv S 1 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WB, Wv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw, h3z] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    have hReach2 : 1 / 2 ≤ W3 S + Lv S 2 + sv S := by
      simp only [Lv, Stot, sig, av, uv, sv, WB, Wv, W1, W2, W3, qx, qy, qa, qb, qc, qu, qv, qw, h3z] at *
      linarith [hnn (.inl 0), hnn (.inl 1), hnn (.inl 2), hnn (.inl 4),
        hnn (.inr 0), hnn (.inr 2), hnn (.inr 3), hnn (.inr 4), hnn (.inr 5), hnn (.inr 6), hnn (.inr 7)]
    -- First handle j = 1 or j = 2 when W1 + L1 >= 1/2!
    by_cases hB0 : W1 S + Lv S 0 < 1 / 2
    · -- Remaining case: W1 + L1 < 1/2!
      by_cases hr0 : rv S 0 ≤ 11 / 180
      · exact boundary2_contra_of_r_le S 0 hB0 hReach0 hr0
      · push Not at hr0
        have heps_s := eps_sum S
        have he2_ge : rv S 0 / 2 ≤ eps S 1 := by simp only [rv]; linarith only [heps23, heps_s]
        have he2_le : eps S 1 ≤ rv S 0 := by have := eps_pos S 2; simp only [rv]; linarith only [this, heps_s]
        have hr1_lt : rv S 1 ≤ 11 / 180 := by simp only [rv]; linarith only [he2_ge, hs_lt, hr0, heps_s]
        by_cases hB1 : W2 S + Lv S 1 < 1 / 2
        · exact boundary2_contra_of_r_le S 1 hB1 hReach1 hr1_lt
        · push Not at hB1
          by_cases hW2_hi : 1 / 8 ≤ W2 S
          · -- P_{1,2} <= ((1/3 + r_2)*(5/12 - r_2))/8 <= 9/512 < 1/50!
            have hH1 := H1_pos_of_interior S 1 hB1
            have hEv := Ev_le_of_y_zero S rfl 1 0 2 (by decide) (by decide) (by decide)
            have hL1 := Lv_eq S 1
            have hL1_pos : 0 < Lv S 1 := by
              have hWG := WG_lt_third_add_s S
              have hW0s := Wv_gt_s S 0; have hW2s := Wv_gt_s S 2
              have hr1p := rv_pos S 1
              have he1p := eps_pos S 1
              simp only [WG, W1, W2, W3, rv] at hWG hB1 hL1 hr1p
              linarith only [hB1, hWG, hW0s, hW2s, hL1, hr1p, he1p]
            have hEv' : Ev S 1 ≤ Lv S 1 ^ 2 / 8 := by nlinarith only [hEv, sq_nonneg (sig S 0 - sig S 2)]
            have hr1_pos := rv_pos S 1
            have hL1_le : Lv S 1 ≤ 5 / 12 - rv S 1 := by simp only [W2] at hW2_hi; linarith only [hL1, hW2_hi]
            have h1a : (1 / 50 : ℚ) < (1 / 3 + rv S 1) * Lv S 1 / 8 := by nlinarith only [hH1, hEv', hL1_pos, hr1_pos]
            have h1 : (1 / 50 : ℚ) < (1 / 3 + rv S 1) * (5 / 12 - rv S 1) / 8 := by nlinarith only [h1a, hL1_le, hr1_pos]
            have h2 : (1 / 3 + rv S 1) * (5 / 12 - rv S 1) ≤ 9 / 64 := by
              nlinarith only [sq_nonneg (rv S 1 - 1 / 24)]
            linarith only [h1, h2]
          · push Not at hW2_hi
            -- Coupled Cauchy-Schwarz bound A + 2*B <= ... + 3D/4D Bernstein certificates!
            have hB2_0 := boundary2_exact_y_zero S rfl 0 1 2 (by decide) (by decide) (by decide) hB0 hReach0
            have hH1_1 := H1_pos_of_interior S 1 hB1
            have hEv_1 := Ev_le_of_y_zero S rfl 1 0 2 (by decide) (by decide) (by decide)
            have hL0 := Lv_eq S 0; have hL1 := Lv_eq S 1
            have hL1_pos : 0 < Lv S 1 := by simp only [W2] at hB1 hW2_hi; linarith only [hB1, hW2_hi]
            have hr1_pos := rv_pos S 1
            -- Bound z_0 - 2*t_0 >= max(0, 1/3 - r_0 - 2*W_1) (since z_0 = s - d_0 >= r_0 and t_0 = W_1 + r_0 - 1/6)!
            have hz0_ge : rv S 0 ≤ zv S 0 := by
              have hd := dv_abs_lt S 0; simp only [zv, rv, sv, hy0]; linarith only [hd]
            have ht0_eq : 1 / 2 - W1 S - Lv S 0 = W1 S + rv S 0 - 1 / 6 := by simp only [W1]; linarith only [hL0]
            have hD_eq : (sig S 0 - sig S 2) - (sig S 1 - sig S 2) = 2 * (W1 S - W2 S) + eps S 1 - eps S 0 := by
              have hs0 := sig_eq S 0; have hs1 := sig_eq S 1; simp only [W1, W2]; linarith only [hs0, hs1]
            -- Cauchy-Schwarz: d23^2 + 2*(1/3 + r2)*d13^2 >= d23^2 + (2/3)*d13^2 >= (2/5)*(d13 - d23)^2!
            set d23 := sig S 1 - sig S 2 with hd23_def
            set d13 := sig S 0 - sig S 2 with hd13_def
            set D := 2 * (W1 S - W2 S) + eps S 1 - eps S 0 with hD_def
            have hcs : (2 / 5 : ℚ) * D ^ 2 ≤ d23 ^ 2 + 2 * (1 / 3 + rv S 1) * d13 ^ 2 := by
              have h1 : d23 ^ 2 + (2 / 3 : ℚ) * d13 ^ 2 - (2 / 5 : ℚ) * (d13 - d23) ^ 2 = (3 / 5 : ℚ) * (d23 + (2 / 3 : ℚ) * d13) ^ 2 := by ring
              have h2 : 0 ≤ 2 * rv S 1 * d13 ^ 2 := by positivity
              rw [← hD_eq]; nlinarith only [h1, h2, sq_nonneg (d23 + (2 / 3 : ℚ) * d13)]
            have hA_pos : 0 < (1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - d23 ^ 2 - (zv S 0 - 2 * (W1 S + rv S 0 - 1 / 6)) ^ 2 - 4 / 25 := by
              simp only [W1] at ht0_eq hB2_0 ⊢
              rw [ht0_eq] at hB2_0
              linarith only [hB2_0]
            have hB_pos : 0 < (1 / 3 + rv S 1) * (Lv S 1 ^ 2 - d13 ^ 2) - (4 / 25) * Lv S 1 := by
              have h1 : (4 / 25 : ℚ) * Lv S 1 < (1 / 3 + rv S 1) * (8 * Ev S 1) := by linarith only [hH1_1]
              nlinarith only [h1, hEv_1, hr1_pos]
            have hAB_pos : 0 < ((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - (4 / 25) * Lv S 1) - (2 / 5) * D ^ 2 -
                (zv S 0 - 2 * (W1 S + rv S 0 - 1 / 6)) ^ 2 := by linarith only [hA_pos, hB_pos, hcs]
            -- Parameterize u for r1 in [11/180, 1/15] and w for e2 in [r1/2, r1]!
            set u1 := (rv S 0 - 11 / 180) / (1 / 15 - 11 / 180)
            set u0 := 1 - u1
            have hden : (0 : ℚ) < 1 / 15 - 11 / 180 := by norm_num
            have hu0 : 0 ≤ u0 := by
              simp only [u0, u1]
              exact sub_nonneg.mpr (le_of_lt ((div_lt_one hden).mpr (by linarith only [hr0_lt])))
            have hu1 : 0 ≤ u1 := by
              simp only [u1]
              exact div_nonneg (by linarith only [hr0]) (le_of_lt hden)
            have hr1_param : (11 / 180 : ℚ) * u0 + (1 / 15 : ℚ) * u1 = rv S 0 := by simp only [u0, u1]; ring
            have hr1_pos' : 0 < rv S 0 := by linarith only [hr0]
            set w1 := (eps S 1 - rv S 0 / 2) / (rv S 0 / 2)
            set w0 := 1 - w1
            have hw1 : 0 ≤ w1 := div_nonneg (by linarith only [he2_ge]) (by linarith only [hr1_pos'])
            have hw0 : 0 ≤ w0 := by
              simp only [w0, w1]; exact sub_nonneg.mpr ((div_le_one (by linarith only [hr1_pos'])).mpr (by linarith only [he2_le]))
            have he2_param : (rv S 0 / 2) * w0 + rv S 0 * w1 = eps S 1 := by
              simp only [w0, w1]; field_simp [ne_of_gt hr1_pos']; ring
            -- Convexity helper in W2 on [s + e2, 1/8]:
            have hconv_W2 : ∀ (W1_val : ℚ),
                (∀ W2_ep : ℚ, W2_ep = sv S + eps S 1 ∨ W2_ep = 1 / 8 →
                  ((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                  2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * W2_ep - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * W2_ep - rv S 1)) -
                  (2 / 5) * (2 * (W1_val - W2_ep) + eps S 1 - eps S 0) ^ 2 < 0) →
                ((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - (4 / 25) * Lv S 1) -
                (2 / 5) * (2 * (W1_val - W2 S) + eps S 1 - eps S 0) ^ 2 < 0 := by
              intro W1_val hep
              have hlo := hep (sv S + eps S 1) (Or.inl rfl)
              have hhi := hep (1 / 8) (Or.inr rfl)
              set a_l := sv S + eps S 1 with hal_def
              set b_r := (1 / 8 : ℚ) with hbr_def
              have h1 : 0 < W2 S - a_l := by linarith only [hW2_gt]
              have h2 : 0 < b_r - W2 S := by linarith only [hW2_hi]
              have hba : 0 < b_r - a_l := by linarith only [h1, h2]
              have hdiff_id :
                  (b_r - W2 S) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * a_l - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * a_l - rv S 1)) -
                    (2 / 5) * (2 * (W1_val - a_l) + eps S 1 - eps S 0) ^ 2) +
                  (W2 S - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * b_r - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * b_r - rv S 1)) -
                    (2 / 5) * (2 * (W1_val - b_r) + eps S 1 - eps S 0) ^ 2) -
                  (b_r - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - (4 / 25) * Lv S 1) -
                    (2 / 5) * (2 * (W1_val - W2 S) + eps S 1 - eps S 0) ^ 2) =
                  (8 * (1 / 3 + rv S 1) - 8 / 5) * (b_r - a_l) * (W2 S - a_l) * (b_r - W2 S) := by
                rw [hL1]; simp only [W2]; ring
              have hlead : 0 < 8 * (1 / 3 + rv S 1) - 8 / 5 := by linarith only [hr1_pos]
              have hpos_r : 0 < (8 * (1 / 3 + rv S 1) - 8 / 5) * (b_r - a_l) * (W2 S - a_l) * (b_r - W2 S) := by positivity
              have hneg_l : (b_r - W2 S) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * a_l - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * a_l - rv S 1)) -
                    (2 / 5) * (2 * (W1_val - a_l) + eps S 1 - eps S 0) ^ 2) +
                  (W2 S - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * b_r - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * b_r - rv S 1)) -
                    (2 / 5) * (2 * (W1_val - b_r) + eps S 1 - eps S 0) ^ 2) < 0 := by linarith [mul_neg_of_pos_of_neg h2 hlo, mul_neg_of_pos_of_neg h1 hhi]
              have hC : (b_r - a_l) * ((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25 +
                  2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - 4 / 25 * Lv S 1) -
                  (2 / 5) * (2 * (W1_val - W2 S) + eps S 1 - eps S 0) ^ 2) < 0 := by
                linarith only [hdiff_id, hneg_l, hpos_r]
              by_contra hF
              push Not at hF
              have hnn := mul_nonneg (le_of_lt hba) hF
              linarith
            by_cases hW1_split : 1 / 6 - rv S 0 / 2 ≤ W1 S
            · -- Subcase G1: W1 >= 1/6 - r1/2!
              have hs_gt_r1 : rv S 0 < sv S := by have := eps_pos S 0; simp only [rv]; linarith only [this]
              set v1 := (sv S - rv S 0) / (2 / 25 - rv S 0)
              set v0 := 1 - v1
              have hden_v : 0 < 2 / 25 - rv S 0 := by linarith only [hr0_lt]
              have hv1 : 0 ≤ v1 := div_nonneg (by linarith only [hs_gt_r1]) (le_of_lt hden_v)
              have hv0 : 0 ≤ v0 := by simp only [v0, v1]; exact sub_nonneg.mpr ((div_le_one hden_v).mpr (by linarith only [hs_lt]))
              have hs_param : rv S 0 * v0 + (2 / 25 : ℚ) * v1 = sv S := by
                have h1 : v1 * (2 / 25 - rv S 0) = sv S - rv S 0 := by
                  simp only [v1]; exact div_mul_cancel₀ _ (ne_of_gt hden_v)
                have h2 : rv S 0 * v0 + (2 / 25 : ℚ) * v1 = rv S 0 + v1 * (2 / 25 - rv S 0) := by
                  simp only [v0]; ring
                rw [h2, h1]; ring
              have hDmin := cert_grot_D_pos hu0 hu1 hv0 hv1 hw0 hw1 (by simp only [u0]; ring) (by simp only [v0]; ring) (by simp only [w0]; ring)
              dsimp only at hDmin
              rw [hr1_param, hs_param, he2_param] at hDmin
              have he1_eq : sv S - rv S 0 = eps S 0 := by simp only [rv]; ring
              rw [he1_eq] at hDmin
              have hD_le : 2 * ((1 / 6 - rv S 0 / 2) - W2 S) + eps S 1 - eps S 0 ≤ D := by simp only [D]; linarith only [hW1_split]
              have hD_pos : 0 < 2 * ((1 / 6 - rv S 0 / 2) - W2 S) + eps S 1 - eps S 0 := by linarith only [hDmin, hW2_hi]
              have hD_sq : (2 * ((1 / 6 - rv S 0 / 2) - W2 S) + eps S 1 - eps S 0) ^ 2 ≤ D ^ 2 := by nlinarith only [hD_le, hD_pos]
              have hneg := hconv_W2 (1 / 6 - rv S 0 / 2) (by
                intro W2_ep hW2_ep
                rcases hW2_ep with rfl | rfl
                · have hc := cert_grot_B1_lo hu0 hu1 hv0 hv1 hw0 hw1 (by simp only [u0]; ring) (by simp only [v0]; ring) (by simp only [w0]; ring)
                  dsimp only at hc; rw [hr1_param, hs_param, he2_param, he1_eq] at hc
                  have hr2_eq : sv S - eps S 1 = rv S 1 := rfl
                  rw [hr2_eq] at hc; exact hc
                · have hc := cert_grot_B1_hi hu0 hu1 hv0 hv1 hw0 hw1 (by simp only [u0]; ring) (by simp only [v0]; ring) (by simp only [w0]; ring)
                  dsimp only at hc; rw [hr1_param, hs_param, he2_param, he1_eq] at hc
                  have hr2_eq : sv S - eps S 1 = rv S 1 := rfl
                  rw [hr2_eq] at hc; exact hc)
              nlinarith only [hAB_pos, hneg, hD_sq, sq_nonneg (zv S 0 - 2 * (W1 S + rv S 0 - 1 / 6))]
            · -- Subcase G2: 2*s <= W1 < 1/6 - r1/2 (so s < 1/12 - r1/4)!
              push Not at hW1_split
              have hs_gt_r1 : rv S 0 < sv S := by have := eps_pos S 0; simp only [rv]; linarith only [this]
              have hs_lt_cap : sv S < 1 / 12 - rv S 0 / 4 := by linarith only [hW1_ge2s, hW1_split]
              set v1 := (sv S - rv S 0) / ((1 / 12 - rv S 0 / 4) - rv S 0)
              set v0 := 1 - v1
              have hden_v : 0 < (1 / 12 - rv S 0 / 4) - rv S 0 := by linarith only [hs_gt_r1, hs_lt_cap]
              have hv1 : 0 ≤ v1 := div_nonneg (by linarith only [hs_gt_r1]) (le_of_lt hden_v)
              have hv0 : 0 ≤ v0 := by simp only [v0, v1]; exact sub_nonneg.mpr ((div_le_one hden_v).mpr (by linarith only [hs_lt_cap]))
              have hs_param : rv S 0 * v0 + (1 / 12 - rv S 0 / 4) * v1 = sv S := by
                have h1 : v1 * ((1 / 12 - rv S 0 / 4) - rv S 0) = sv S - rv S 0 := by
                  simp only [v1]; exact div_mul_cancel₀ _ (ne_of_gt hden_v)
                have h2 : rv S 0 * v0 + (1 / 12 - rv S 0 / 4) * v1 = rv S 0 + v1 * ((1 / 12 - rv S 0 / 4) - rv S 0) := by
                  simp only [v0]; ring
                rw [h2, h1]; ring
              set z1 := (W1 S - 2 * sv S) / ((1 / 6 - rv S 0 / 2) - 2 * sv S)
              set z0 := 1 - z1
              have hden_z : 0 < (1 / 6 - rv S 0 / 2) - 2 * sv S := by linarith only [hs_lt_cap]
              have hz1 : 0 ≤ z1 := div_nonneg (by linarith only [hW1_ge2s]) (le_of_lt hden_z)
              have hz0 : 0 ≤ z0 := by simp only [z0, z1]; exact sub_nonneg.mpr ((div_le_one hden_z).mpr (by linarith only [hW1_split]))
              have hW1_param : (2 * sv S) * z0 + (1 / 6 - rv S 0 / 2) * z1 = W1 S := by
                have h1 : z1 * ((1 / 6 - rv S 0 / 2) - 2 * sv S) = W1 S - 2 * sv S := by
                  simp only [z1]; exact div_mul_cancel₀ _ (ne_of_gt hden_z)
                have h2 : (2 * sv S) * z0 + (1 / 6 - rv S 0 / 2) * z1 = 2 * sv S + z1 * ((1 / 6 - rv S 0 / 2) - 2 * sv S) := by
                  simp only [z0]; ring
                rw [h2, h1]; ring
              have he1_eq : sv S - rv S 0 = eps S 0 := by simp only [rv]; ring
              have hr2_eq : sv S - eps S 1 = rv S 1 := rfl
              have hlo_c := cert_grot_B2_lo hu0 hu1 hv0 hv1 hw0 hw1 hz0 hz1
                (by simp only [u0]; ring) (by simp only [v0]; ring) (by simp only [w0]; ring) (by simp only [z0]; ring)
              have hhi_c := cert_grot_B2_hi hu0 hu1 hv0 hv1 hw0 hw1 hz0 hz1
                (by simp only [u0]; ring) (by simp only [v0]; ring) (by simp only [w0]; ring) (by simp only [z0]; ring)
              dsimp only at hlo_c hhi_c
              rw [hr1_param, hs_param, he2_param, hW1_param, he1_eq, hr2_eq] at hlo_c hhi_c
              -- Apply convexity in W2 to the function minus ((1/3 - r1 - 2*W1)^2)
              have hY_sq : (1 / 3 - rv S 0 - 2 * W1 S) ^ 2 ≤ (zv S 0 - 2 * (W1 S + rv S 0 - 1 / 6)) ^ 2 := by
                have h1 : 0 ≤ 1 / 3 - rv S 0 - 2 * W1 S := by linarith only [hW1_split]
                have h2 : 1 / 3 - rv S 0 - 2 * W1 S ≤ zv S 0 - 2 * (W1 S + rv S 0 - 1 / 6) := by linarith only [hz0_ge]
                nlinarith only [h1, h2]
              -- Convexity in W2 still holds after subtracting the W2-independent constant Y^2!
              set Ysq := (1 / 3 - rv S 0 - 2 * W1 S) ^ 2 with hYsq_def
              set a_l := sv S + eps S 1 with hal_def
              set b_r := (1 / 8 : ℚ) with hbr_def
              have h1 : 0 < W2 S - a_l := by linarith only [hW2_gt]
              have h2 : 0 < b_r - W2 S := by linarith only [hW2_hi]
              have hba : 0 < b_r - a_l := by linarith only [h1, h2]
              have hdiff_id :
                  (b_r - W2 S) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * a_l - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * a_l - rv S 1)) -
                    (2 / 5) * (2 * (W1 S - a_l) + eps S 1 - eps S 0) ^ 2 - Ysq) +
                  (W2 S - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * b_r - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * b_r - rv S 1)) -
                    (2 / 5) * (2 * (W1 S - b_r) + eps S 1 - eps S 0) ^ 2 - Ysq) -
                  (b_r - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - (4 / 25) * Lv S 1) -
                    (2 / 5) * D ^ 2 - Ysq) =
                  (8 * (1 / 3 + rv S 1) - 8 / 5) * (b_r - a_l) * (W2 S - a_l) * (b_r - W2 S) := by
                simp only [D]; rw [hL1]; simp only [W2]; ring
              have hlead : 0 < 8 * (1 / 3 + rv S 1) - 8 / 5 := by linarith only [hr1_pos]
              have hpos_r : 0 < (8 * (1 / 3 + rv S 1) - 8 / 5) * (b_r - a_l) * (W2 S - a_l) * (b_r - W2 S) := by positivity
              have hneg_l : (b_r - W2 S) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * a_l - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * a_l - rv S 1)) -
                    (2 / 5) * (2 * (W1 S - a_l) + eps S 1 - eps S 0) ^ 2 - Ysq) +
                  (W2 S - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                    2 * ((1 / 3 + rv S 1) * (2 / 3 - 2 * b_r - rv S 1) ^ 2 - (4 / 25) * (2 / 3 - 2 * b_r - rv S 1)) -
                    (2 / 5) * (2 * (W1 S - b_r) + eps S 1 - eps S 0) ^ 2 - Ysq) < 0 := by linarith [mul_neg_of_pos_of_neg h2 hlo_c, mul_neg_of_pos_of_neg h1 hhi_c]
              have hC : (b_r - a_l) * (((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                  2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - (4 / 25) * Lv S 1) -
                  (2 / 5) * D ^ 2 - Ysq) < 0 := by
                linarith only [hdiff_id, hneg_l, hpos_r]
              have hpos : 0 < ((1 / 3 + rv S 0) ^ 2 + rv S 0 ^ 2 - 4 / 25) +
                  2 * ((1 / 3 + rv S 1) * Lv S 1 ^ 2 - (4 / 25) * Lv S 1) -
                  (2 / 5) * D ^ 2 - Ysq := by
                linarith only [hAB_pos, hY_sq]
              have := mul_pos hba hpos
              linarith
    · -- W1 + L1 >= 1/2, so j = 1 or j = 2 has B2!
      push Not at hB0
      obtain ⟨j, hj⟩ := hInt
      have hkill_j23 : ∀ k : Fin 3, k ≠ 0 → Wv S k + Lv S k < 1 / 2 → (1 / 2 ≤ Wv S k + Lv S k + sv S) → False := by
        intro k _ hBk hRk
        by_cases hrk : rv S k ≤ 11 / 180
        · exact boundary2_contra_of_r_le S k hBk hRk hrk
        · push Not at hrk
          have hW1_ge : 3 / 25 ≤ W1 S := by
            have := eps_pos S k; simp only [rv] at hrk; linarith
          exact contra_of_interior_and_W_ge S 0 hB0 hW1_ge
      rcases fin3_cases j with rfl | rfl | rfl
      · simp only [W1] at hB0; linarith
      · exact hkill_j23 1 (by decide) hj hReach1
      · exact hkill_j23 2 (by decide) hj hReach2

lemma contra_grotzsch (S : VegaSystem 2 true true) : False := by
  -- Use order-5 rotation `rot_grot` so x achieves min on {x, v, w, 0, 1}, then `swap23_grot` so eps_2 >= eps_3!
  have hnorm_eps : ∀ T : VegaSystem 2 true true,
      qx T ≤ qv T → qx T ≤ qw T → qx T ≤ T.w (.inl 0) → qx T ≤ T.w (.inl 1) → False := by
    intro T h1 h2 h3 h4
    by_cases he : eps T 2 ≤ eps T 1
    · exact contra_grotzsch_norm T h1 h2 h3 h4 he
    · let T' := T.transport (dy' := true) (de' := true) swap23_grot (by decide) (by decide)
      have h1' : qx T' ≤ qv T' := by simp only [T', VegaSystem.transport, qx, qv, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]; exact h2
      have h2' : qx T' ≤ qw T' := by simp only [T', VegaSystem.transport, qx, qw, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]; exact h1
      have h3' : qx T' ≤ T'.w (.inl 0) := by simp only [T', VegaSystem.transport, qx, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]; exact h4
      have h4' : qx T' ≤ T'.w (.inl 1) := by simp only [T', VegaSystem.transport, qx, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]; exact h3
      have he' : eps T' 2 ≤ eps T' 1 := by
        have h3z : T.w (.inl 3) = 0 := T.hw_zero (.inl 3) (by decide)
        have hW2' : W2 T' = W3 T := by
          have e2 : T'.w (Sum.inl 2) = T.w (Sum.inl 4) := rfl
          have e3 : T'.w (Sum.inl 3) = T.w (Sum.inl 3) := rfl
          rw [W2_v2 T', W3_v2 T, e2, e3, h3z]; ring
        have hW3' : W3 T' = W2 T := by
          have e4 : T'.w (Sum.inl 4) = T.w (Sum.inl 2) := rfl
          rw [W3_v2 T', W2_v2 T, e4, h3z]; ring
        have hL1' : Lv T' 1 = Lv T 2 := by simp only [Lv, Stot, sig, av, uv, qa, qb, qc, qu, qv, qw, T', VegaSystem.transport, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]; ring
        have hL2' : Lv T' 2 = Lv T 1 := by simp only [Lv, Stot, sig, av, uv, qa, qb, qc, qu, qv, qw, T', VegaSystem.transport, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]; ring
        have hs' : sv T' = sv T := by simp only [sv, qx, qy, T', VegaSystem.transport, swap23_grot, Equiv.coe_fn_symm_mk, swap23_grot_fn]
        simp only [eps, W2, W3] at *; linarith only [he, hW2', hW3', hL1', hL2', hs']
      exact contra_grotzsch_norm T' h1' h2' h3' h4' he'
  let S1 := S.transport (dy' := true) (de' := true) rot_grot.symm (by decide) (by decide)
  let S2 := S1.transport (dy' := true) (de' := true) rot_grot.symm (by decide) (by decide)
  let S3 := S2.transport (dy' := true) (de' := true) rot_grot.symm (by decide) (by decide)
  let S4 := S3.transport (dy' := true) (de' := true) rot_grot.symm (by decide) (by decide)
  -- Orbit images of x under rot_grot^k: S -> x, S1 -> v, S2 -> 0, S3 -> 1, S4 -> w!
  have hcase : (qx S ≤ qv S ∧ qx S ≤ qw S ∧ qx S ≤ S.w (.inl 0) ∧ qx S ≤ S.w (.inl 1)) ∨
      (qv S ≤ qx S ∧ qv S ≤ qw S ∧ qv S ≤ S.w (.inl 0) ∧ qv S ≤ S.w (.inl 1)) ∨
      (S.w (.inl 0) ≤ qx S ∧ S.w (.inl 0) ≤ qv S ∧ S.w (.inl 0) ≤ qw S ∧ S.w (.inl 0) ≤ S.w (.inl 1)) ∨
      (S.w (.inl 1) ≤ qx S ∧ S.w (.inl 1) ≤ qv S ∧ S.w (.inl 1) ≤ qw S ∧ S.w (.inl 1) ≤ S.w (.inl 0)) ∨
      (qw S ≤ qx S ∧ qw S ≤ qv S ∧ qw S ≤ S.w (.inl 0) ∧ qw S ≤ S.w (.inl 1)) := by
    obtain ⟨k, _, hk⟩ := Finset.exists_min_image (Finset.univ : Finset (Fin 5))
      (fun k : Fin 5 => match k with | 0 => qx S | 1 => qv S | 2 => S.w (.inl 0) | 3 => S.w (.inl 1) | 4 => qw S)
      ⟨0, Finset.mem_univ _⟩
    fin_cases k
    · exact Or.inl ⟨hk 1 (Finset.mem_univ _), hk 4 (Finset.mem_univ _), hk 2 (Finset.mem_univ _), hk 3 (Finset.mem_univ _)⟩
    · exact Or.inr (Or.inl ⟨hk 0 (Finset.mem_univ _), hk 4 (Finset.mem_univ _), hk 2 (Finset.mem_univ _), hk 3 (Finset.mem_univ _)⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨hk 0 (Finset.mem_univ _), hk 1 (Finset.mem_univ _), hk 4 (Finset.mem_univ _), hk 3 (Finset.mem_univ _)⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨hk 0 (Finset.mem_univ _), hk 1 (Finset.mem_univ _), hk 4 (Finset.mem_univ _), hk 2 (Finset.mem_univ _)⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨hk 0 (Finset.mem_univ _), hk 1 (Finset.mem_univ _), hk 2 (Finset.mem_univ _), hk 3 (Finset.mem_univ _)⟩)))
  rcases hcase with hx | hv | h0 | h1 | hw
  · exact hnorm_eps S hx.1 hx.2.1 hx.2.2.1 hx.2.2.2
  · exact hnorm_eps S1
      (by simp only [S1, VegaSystem.transport, qx, qv, rot_grot]; exact hv.2.2.1)
      (by simp only [S1, VegaSystem.transport, qx, qw, rot_grot]; exact hv.1)
      (by simp only [S1, VegaSystem.transport, qx, rot_grot]; exact hv.2.2.2)
      (by simp only [S1, VegaSystem.transport, qx, rot_grot]; exact hv.2.1)
  · exact hnorm_eps S2
      (by simp only [S2, S1, VegaSystem.transport, qx, qv, rot_grot]; exact h0.2.2.2)
      (by simp only [S2, S1, VegaSystem.transport, qx, qw, rot_grot]; exact h0.2.1)
      (by simp only [S2, S1, VegaSystem.transport, qx, rot_grot]; exact h0.2.2.1)
      (by simp only [S2, S1, VegaSystem.transport, qx, rot_grot]; exact h0.1)
  · exact hnorm_eps S3
      (by simp only [S3, S2, S1, VegaSystem.transport, qx, qv, rot_grot]; exact h1.2.2.1)
      (by simp only [S3, S2, S1, VegaSystem.transport, qx, qw, rot_grot]; exact h1.2.2.2)
      (by simp only [S3, S2, S1, VegaSystem.transport, qx, rot_grot]; exact h1.1)
      (by simp only [S3, S2, S1, VegaSystem.transport, qx, rot_grot]; exact h1.2.1)
  · exact hnorm_eps S4
      (by simp only [S4, S3, S2, S1, VegaSystem.transport, qx, qv, rot_grot]; exact hw.1)
      (by simp only [S4, S3, S2, S1, VegaSystem.transport, qx, qw, rot_grot]; exact hw.2.2.2)
      (by simp only [S4, S3, S2, S1, VegaSystem.transport, qx, rot_grot]; exact hw.2.1)
      (by simp only [S4, S3, S2, S1, VegaSystem.transport, qx, rot_grot]; exact hw.2.2.1)

/- ### Complete Theorem J1: Universal Vega Blowup Refutation (ALL `i >= 2`, ALL 4 Variants) -/

theorem vegaSystem_false {i : ℕ} {dy de : Bool} (S : VegaSystem i dy de) : False := by
  have hi := S.hi
  by_cases hi2 : i = 2
  · subst hi2
    cases dy <;> cases de
    · exact contra_upsilon2 S
    · exact contra_upsilon2_no3 S
    · exact contra_upsilon2_noy S
    · exact contra_grotzsch S
  · have hi3 : 3 ≤ i := by omega
    cases dy
    · exact stage3_interior_contra S (stage1_case1A S hi3)
    · exact stage3_interior_contra S (stage1_case1B S hi3)

/-- **Theorem J1:** No maximal triangle-free counterexample `M` with `3*delta > n` and `5*alpha < 2*n`
    can have a twin-free quotient `H` in the 4-variant closed Vega class `V_i` (`i >= 2`). -/
theorem not_counterexample_of_vega_quotient {V U : Type} [Fintype V] [Fintype U]
    (M : SimpleGraph V) (H : SimpleGraph U) (φ : M →g H)
    {i : ℕ} {dy de : Bool}
    (hn : 0 < Fintype.card V)
    (hMTF : M.CliqueFree 3)
    (hα : ∀ I : Set V, M.IsIndepSet I → 5 * I.ncard < 2 * Fintype.card V)
    (h3d : ∀ v : V, Fintype.card V < 3 * (M.neighborSet v).ncard)
    (hE : ∀ V' : Set V, 2 * V'.ncard + 1 ≥ Fintype.card V →
      50 * (M.induce V').edgeSet.ncard > Fintype.card V ^ 2)
    (hsurj : Function.Surjective φ)
    (hrefl : ∀ u v : V, M.Adj u v ↔ H.Adj (φ u) (φ v))
    (hVega : IsVegaGraph H i dy de) : False :=
  vegaSystem_false (vegaSystem_of_quotient M H φ hn hMTF hα h3d hE hsurj hrefl hVega)


end Stage1
end Erdos128Vega

theorem OMA.solution : OMA.R_Erdos128_erdos_128_R2_H2_R3.H1 := by
  intro V _ M hV hMTF hMα hMδ hM50 hVega
  rcases hVega with ⟨i, dy, de, ψ, hi, hact, hsurj, hadj⟩
  let U := {v : Erdos128Vega.VegaV i // Erdos128Vega.vegaActive i dy de v}
  let H : SimpleGraph U :=
    { Adj := fun a b => Erdos128Vega.vegaAdj i a.1 b.1
      symm := ⟨fun _ _ h => Erdos128Vega.vegaAdj_symm hi h⟩
      loopless := ⟨fun a => Erdos128Vega.vegaAdj_irrefl hi a.1⟩ }
  have hact' : ∀ v : V, Erdos128Vega.vegaActive i dy de (ψ v) := by
    intro v
    have hv := hact v
    cases hψ : ψ v with
    | inl k => simpa [hψ, Erdos128Vega.vegaActive] using hv
    | inr j => simpa [hψ, Erdos128Vega.vegaActive] using hv
  have hadj' : ∀ u v : V, M.Adj u v ↔ Erdos128Vega.vegaAdj i (ψ u) (ψ v) := by
    intro u v
    have huv := hadj u v
    cases hu : ψ u <;> cases hv : ψ v <;> simpa [hu, hv, Erdos128Vega.vegaAdj] using huv
  let φ : M →g H := ⟨fun v => ⟨ψ v, hact' v⟩, fun h => (hadj' _ _).mp h⟩
  have hφ_surj : Function.Surjective φ := by
    rintro ⟨w, hw⟩
    obtain ⟨v, hv⟩ := hsurj w (by cases w with | inl k => exact hw | inr j => exact hw)
    exact ⟨v, Subtype.ext hv⟩
  exact Erdos128Vega.not_counterexample_of_vega_quotient M H φ hV hMTF hMα hMδ hM50
    hφ_surj hadj' ⟨hi, Equiv.refl U, fun _ _ => Iff.rfl⟩
