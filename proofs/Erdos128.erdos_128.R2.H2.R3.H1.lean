/-- Theorem A bounds on `A_0 = {x,u,v,w}`, `B_0 = {y,a,b,c}`, and `{a_j, u_j} ∪ I_k` (`k ≠ j`). -/
lemma WA_lt : WA S < 2 / 5 := by
  let A0 : Finset (VegaV i) := {.inr 0, .inr 5, .inr 6, .inr 7}
  have h := S.hindep A0 (by intro u hu v hv; simp only [A0, Finset.mem_insert, Finset.mem_singleton] at hu hv; rcases hu with rfl | rfl | rfl | rfl <;> rcases hv with rfl | rfl | rfl | rfl <;> simp [vegaAdj])
  have heq : ∑ z ∈ A0, S.w z = WA S := by simp [A0, WA, qx, qu, qv, qw]; ring
  linarith

lemma WB_lt : WB S < 2 / 5 := by
  let B0 : Finset (VegaV i) := {.inr 1, .inr 2, .inr 3, .inr 4}
  have h := S.hindep B0 (by intro u hu v hv; simp only [B0, Finset.mem_insert, Finset.mem_singleton] at hu hv; rcases hu with rfl | rfl | rfl | rfl <;> rcases hv with rfl | rfl | rfl | rfl <;> simp [vegaAdj])
  have heq : ∑ z ∈ B0, S.w z = WB S := by simp [B0, WB, qy, qa, qb, qc]; ring
  linarith

lemma WG_gt : (1 / 5 : ℚ) < WG S := by
  have h1 := sum_all_eq S; have h2 := WA_lt S; have h3 := WB_lt S; linarith

lemma indep_Ij (hi : 2 ≤ i) (j : Fin 3) : ∀ p ∈ Ij i j, ∀ q ∈ Ij i j, ¬ vegaAdj i p q := by
  intro p hp q hq
  rcases fin3_cases j with rfl | rfl | rfl <;>
  (cases p with
   | inr _ => simp [Ij] at hp
   | inl p =>
     cases q with
     | inr _ => simp [Ij] at hq
     | inl q =>
       simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hp hq
       simp only [vegaAdj]
       have hp' := p.isLt; have hq' := q.isLt
       by_cases hle : p.val ≤ q.val
       · have hmod : (q.val + (3 * i - 1) - p.val) % (3 * i - 1) = q.val - p.val := by
           have : q.val + (3 * i - 1) - p.val = (q.val - p.val) + (3 * i - 1) := by omega
           rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
         rw [hmod]; omega
       · have hmod : (q.val + (3 * i - 1) - p.val) % (3 * i - 1) = (3 * i - 1) - (p.val - q.val) := by
           have : q.val + (3 * i - 1) - p.val = (3 * i - 1) - (p.val - q.val) := by omega
           rw [this, Nat.mod_eq_of_lt (by omega)]
         rw [hmod]; omega)

lemma sig_add_W_lt {j k : Fin 3} (hjk : j ≠ k) : sig S j + Wv S k < 2 / 5 := by
  let aidx : Fin 8 := match j with | 0 => 2 | 1 => 3 | 2 => 4
  let uidx : Fin 8 := match j with | 0 => 5 | 1 => 6 | 2 => 7
  let T : Finset (VegaV i) := insert (.inr aidx) (insert (.inr uidx) (Ij i k))
  have hTind : ∀ p ∈ T, ∀ q ∈ T, ¬ vegaAdj i p q := by
    intro p hp q hq
    simp only [T, Finset.mem_insert] at hp hq
    have hinj := indep_Ij S.hi k
    rcases hp with rfl | rfl | hp <;> rcases hq with rfl | rfl | hq
    · rcases fin3_cases j with rfl | rfl | rfl <;> simp [aidx, vegaAdj]
    · rcases fin3_cases j with rfl | rfl | rfl <;> simp [aidx, uidx, vegaAdj]
    · rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
      all_goals (cases q with | inr _ => simp [Ij] at hq | inl q => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hq; simp [aidx, vegaAdj]; omega)
    · rcases fin3_cases j with rfl | rfl | rfl <;> simp [aidx, uidx, vegaAdj]
    · rcases fin3_cases j with rfl | rfl | rfl <;> simp [uidx, vegaAdj]
    · rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
      all_goals (cases q with | inr _ => simp [Ij] at hq | inl q => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hq; simp [uidx, vegaAdj]; omega)
    · rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
      all_goals (cases p with | inr _ => simp [Ij] at hp | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hp; simp [aidx, vegaAdj]; omega)
    · rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
      all_goals (cases p with | inr _ => simp [Ij] at hp | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hp; simp [uidx, vegaAdj]; omega)
    · exact hinj p hp q hq
  have h := S.hindep T hTind
  have ha_not_I : Sum.inr aidx ∉ Ij i k := by rcases fin3_cases k with rfl | rfl | rfl <;> simp [Ij]
  have hu_not_I : Sum.inr uidx ∉ Ij i k := by rcases fin3_cases k with rfl | rfl | rfl <;> simp [Ij]
  have hau_ne : (Sum.inr aidx : VegaV i) ≠ Sum.inr uidx := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [aidx, uidx]
  have hsum : ∑ z ∈ T, S.w z = sig S j + Wv S k := by
    have ha_not_u : (Sum.inr aidx : VegaV i) ∉ insert (Sum.inr uidx) (Ij i k) := by simp [hau_ne, ha_not_I]
    dsimp only [T]
    rw [Finset.sum_insert ha_not_u, Finset.sum_insert hu_not_I]
    rcases fin3_cases j with rfl | rfl | rfl <;> simp [aidx, uidx, sig, av, uv, qa, qb, qc, qu, qv, qw, Wv] <;> ring
  linarith

/-- Miracle 2: Exact slack & asymmetry identities. -/
lemma eps_sum : eps S 0 + eps S 1 + eps S 2 = sv S := by
  have h := Stot_eq S
  simp only [eps, Lv, sig, av, uv, Wv, WG, W1, W2, W3, Stot, sv] at *
  linarith

lemma eps_pos (j : Fin 3) : 0 < eps S j := by
  have ha := deg_a S; have hb := deg_b S; have hc := deg_c S
  have hu := deg_u S; have hv := deg_v S; have hw := deg_w S
  rcases fin3_cases j with rfl | rfl | rfl <;> simp only [eps, Lv, sig, av, uv, W1, W2, W3, Stot, sv] at * <;> linarith

lemma rv_pos (j : Fin 3) : 0 < rv S j := by
  have hsum := eps_sum S
  have h0 := eps_pos S 0; have h1 := eps_pos S 1; have h2 := eps_pos S 2
  rcases fin3_cases j with rfl | rfl | rfl <;> simp only [rv] <;> linarith

lemma dv_abs_lt (j : Fin 3) : -eps S j < dv S j ∧ dv S j < eps S j := by
  have ha := deg_a S; have hb := deg_b S; have hc := deg_c S
  have hu := deg_u S; have hv := deg_v S; have hw := deg_w S
  rcases fin3_cases j with rfl | rfl | rfl <;> simp only [eps, dv, del, Tv, Lv, sig, av, uv, W1, W2, W3, WA, WB, Stot, sv] at * <;>
    constructor <;> linarith

lemma Tv_bounds : -qy S < Tv S ∧ Tv S < qx S := by
  have ha := deg_a S; have hb := deg_b S; have hc := deg_c S
  have hu := deg_u S; have hv := deg_v S; have hw := deg_w S
  have htot := sum_all_eq S
  simp only [Tv, WA, WB, WG, W1, W2, W3] at *
  constructor <;> linarith

lemma WG_lt_third_add_s : WG S < 1 / 3 + sv S := by
  have hx := deg_x S; have hT := Tv_bounds S; have htot := sum_all_eq S
  have hy_nn : 0 ≤ qy S := S.hw_nonneg (.inr 1)
  simp only [Tv, sv] at *; linarith

lemma WG_lt_third_of_y (hdy : dy = false) : WG S < 1 / 3 := by
  have hx := deg_x S; have hy := deg_y S hdy; have htot := sum_all_eq S; linarith

lemma sig_eq (j : Fin 3) : sig S j = 1 / 3 + 2 * Wv S j - WG S - eps S j := by
  have h := Stot_eq S
  simp only [eps, Lv] at *; linarith

lemma Lv_eq (j : Fin 3) : Lv S j = 2 / 3 - 2 * Wv S j - rv S j := by
  simp only [eps, rv] at *; linarith

lemma w_dev_lt_thA (j : Fin 3) : Wv S j - WG S / 3 < 2 / 45 + 2 / 3 * sv S := by
  have heps := eps_pos S j; have hsum := eps_sum S
  have h0 := eps_pos S 0; have h1 := eps_pos S 1; have h2 := eps_pos S 2
  rcases fin3_cases j with rfl | rfl | rfl
  · have h12 := sig_add_W_lt S (j := 0) (k := 1) (by decide)
    have h13 := sig_add_W_lt S (j := 0) (k := 2) (by decide)
    have hs0 := sig_eq S 0; simp only [WG, W1, W2, W3] at *; linarith
  · have h21 := sig_add_W_lt S (j := 1) (k := 0) (by decide)
    have h23 := sig_add_W_lt S (j := 1) (k := 2) (by decide)
    have hs1 := sig_eq S 1; simp only [WG, W1, W2, W3] at *; linarith
  · have h31 := sig_add_W_lt S (j := 2) (k := 0) (by decide)
    have h32 := sig_add_W_lt S (j := 2) (k := 1) (by decide)
    have hs2 := sig_eq S 2; simp only [WG, W1, W2, W3] at *; linarith

/-- Exact `E_j` upper bound (J1.1): `E_j <= (L_j^2 - (sig_k - sig_l)^2 + r_j^2 - z_j^2) / 8`. -/
lemma Ev_le (j k l : Fin 3) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    Ev S j ≤ (Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + rv S j ^ 2 - zv S j ^ 2) / 8 := by
  have hd_k := dv_abs_lt S k
  have hd_l := dv_abs_lt S l
  have hsum := eps_sum S
  have hdiff_sq : (dv S k - dv S l) ^ 2 ≤ rv S j ^ 2 := by
    have h1 : -(eps S k + eps S l) ≤ dv S k - dv S l := by linarith
    have h2 : dv S k - dv S l ≤ eps S k + eps S l := by linarith
    have hr : rv S j = eps S k + eps S l := by
      rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> rcases fin3_cases l with rfl | rfl | rfl
      all_goals first | exact absurd rfl hjk | exact absurd rfl hjl | exact absurd rfl hkl | (simp only [rv]; linarith)
    rw [hr]; nlinarith
  have hident : 8 * Ev S j = Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + (dv S k - dv S l) ^ 2 - zv S j ^ 2 := by
    rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> rcases fin3_cases l with rfl | rfl | rfl
    all_goals first | exact absurd rfl hjk | exact absurd rfl hjl | exact absurd rfl hkl | (simp only [Ev, Lv, sig, del, dv, Tv, zv, Stot, WA, WB, av, uv, qx, qy, qa, qb, qc, qu, qv, qw]; ring)
  linarith

/-- When `y = 0`, `z_j = s - d_j >= r_j`, so `E_j <= (L_j^2 - (sig_k - sig_l)^2) / 8 <= L_j^2 / 8`. -/
lemma Ev_le_of_y_zero (hdy : dy = true) (j k l : Fin 3) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    Ev S j ≤ (Lv S j ^ 2 - (sig S k - sig S l) ^ 2) / 8 := by
  have hy0 : qy S = 0 := S.hw_zero (.inr 1) (by simp [vegaActive, hdy])
  have hEv := Ev_le S j k l hjk hjl hkl
  have hd := dv_abs_lt S j
  have hrz : rv S j ≤ zv S j := by
    simp only [rv, zv, sv, hy0]; linarith
  have hr_pos := rv_pos S j
  have hsq : rv S j ^ 2 ≤ zv S j ^ 2 := by nlinarith
  linarith

/-- Every vertex `p` in `Gamma_i` has exact degree `i` inside `Gamma_i`. -/
lemma card_gamma_nbrs {i : ℕ} (hi : 2 ≤ i) (p : Fin (3 * i - 1)) :
    #(Finset.univ.filter (fun k : Fin (3 * i - 1) => vegaAdj i (.inl k) (.inl p))) = i := by
  let N := 3 * i - 1
  have hp := p.isLt
  have hbij : #(Finset.univ.filter (fun k : Fin N => vegaAdj i (.inl k) (.inl p))) = #(Finset.Ico i (2 * i)) := by
    refine Finset.card_bij (fun k _ => (p.val + N - k.val) % N) ?_ ?_ ?_
    · intro k hk
      have hadj : vegaAdj i (.inl k) (.inl p) := (Finset.mem_filter.mp hk).2
      simp only [vegaAdj] at hadj
      have hd : i ≤ (p.val + N - k.val) % N ∧ (p.val + N - k.val) % N ≤ 2 * i - 1 := hadj
      simp only [Finset.mem_Ico]; omega
    · intro k1 _ k2 _ h
      have h1 := k1.isLt; have h2 := k2.isLt
      apply Fin.ext
      by_cases hle1 : k1.val ≤ p.val <;> by_cases hle2 : k2.val ≤ p.val
      · have hm1 : (p.val + N - k1.val) % N = p.val - k1.val := by
          have : p.val + N - k1.val = (p.val - k1.val) + N := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        have hm2 : (p.val + N - k2.val) % N = p.val - k2.val := by
          have : p.val + N - k2.val = (p.val - k2.val) + N := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        rw [hm1, hm2] at h; omega
      · have hm1 : (p.val + N - k1.val) % N = p.val - k1.val := by
          have : p.val + N - k1.val = (p.val - k1.val) + N := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        have hm2 : (p.val + N - k2.val) % N = p.val + N - k2.val := Nat.mod_eq_of_lt (by omega)
        rw [hm1, hm2] at h; omega
      · have hm1 : (p.val + N - k1.val) % N = p.val + N - k1.val := Nat.mod_eq_of_lt (by omega)
        have hm2 : (p.val + N - k2.val) % N = p.val - k2.val := by
          have : p.val + N - k2.val = (p.val - k2.val) + N := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        rw [hm1, hm2] at h; omega
      · have hm1 : (p.val + N - k1.val) % N = p.val + N - k1.val := Nat.mod_eq_of_lt (by omega)
        have hm2 : (p.val + N - k2.val) % N = p.val + N - k2.val := Nat.mod_eq_of_lt (by omega)
        rw [hm1, hm2] at h; omega
    · intro d hd
      simp only [Finset.mem_Ico] at hd
      let kv := (p.val + N - d) % N
      have hkv_lt : kv < N := Nat.mod_lt _ (by omega)
      have hback : (p.val + N - kv) % N = d := by
        by_cases hpd : d ≤ p.val
        · have hkv_eq : kv = p.val - d := by
            have h1 : p.val + N - d = (p.val - d) + N := by omega
            simp only [kv, h1, Nat.add_mod_right]; exact Nat.mod_eq_of_lt (by omega)
          rw [hkv_eq]
          have h2 : p.val + N - (p.val - d) = d + N := by omega
          rw [h2, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        · have hkv_eq : kv = p.val + N - d := Nat.mod_eq_of_lt (by omega)
          rw [hkv_eq]
          have h2 : p.val + N - (p.val + N - d) = d := by omega
          rw [h2, Nat.mod_eq_of_lt (by omega)]
      refine ⟨⟨kv, hkv_lt⟩, ?_, hback⟩
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_⟩
      change i ≤ (p.val + (3 * i - 1) - kv) % (3 * i - 1) ∧ (p.val + (3 * i - 1) - kv) % (3 * i - 1) ≤ 2 * i - 1
      change (p.val + (3 * i - 1) - kv) % (3 * i - 1) = d at hback
      rw [hback]; omega
  rw [hbij, Nat.card_Ico]; omega

/-- Miracle 1: Exact Gamma-degree-sum lower bounds for all `i >= 2` and all 4 variants. -/
lemma W3_gt_mul_s : ((i - 1 : ℕ) : ℚ) * sv S < W3 S := by
  have hi := S.hi
  let N := 3 * i - 1
  let K : Finset (Fin N) := Finset.univ.filter (fun p : Fin N => p.val ≠ 0 ∧ p.val ≠ 2 * i - 1)
  have hK_card : #K = 3 * (i - 1) := by
    have h0 : (⟨0, by omega⟩ : Fin N) ∈ (Finset.univ : Finset (Fin N)) := Finset.mem_univ _
    have he : (⟨2 * i - 1, by omega⟩ : Fin N) ∈ (Finset.univ : Finset (Fin N)).erase ⟨0, by omega⟩ := by
      simp [Fin.ext_iff]; omega
    have hK_eq : K = ((Finset.univ : Finset (Fin N)).erase ⟨0, by omega⟩).erase ⟨2 * i - 1, by omega⟩ := by
      ext p; simp only [K, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, true_and, and_true, ne_eq, Fin.ext_iff]
      tauto
    rw [hK_eq, Finset.card_erase_of_mem he, Finset.card_erase_of_mem h0, Finset.card_univ, Fintype.card_fin]
    omega
  have hsum_deg : ((#K : ℕ) : ℚ) * (1 / 3 : ℚ) < ∑ k ∈ K, ∑ u : VegaV i, if vegaAdj i (.inl k) u then S.w u else 0 := by
    calc ((#K : ℕ) : ℚ) * (1 / 3 : ℚ) = ∑ _k ∈ K, (1 / 3 : ℚ) := by rw [Finset.sum_const, nsmul_eq_mul]
      _ < ∑ k ∈ K, ∑ u : VegaV i, if vegaAdj i (.inl k) u then S.w u else 0 := by
        apply Finset.sum_lt_sum_of_nonempty
        · rw [Finset.card_pos.symm, hK_card]; omega
        · intro k hk
          have hne : k.val ≠ 2 * i - 1 := (Finset.mem_filter.mp hk).2.2
          exact S.hdeg (.inl k) (by simp [vegaActive, hne])
  rw [Finset.sum_comm] at hsum_deg
  have hcnt_u : ∀ u : VegaV i, ∑ k ∈ K, (if vegaAdj i (.inl k) u then S.w u else 0) =
      (match u with
       | .inl p => if 2 * i ≤ p.val then (i : ℚ) * S.w (.inl p) else ((i - 1 : ℕ) : ℚ) * S.w (.inl p)
       | .inr q => if q.val = 0 ∨ q.val = 1 then 0 else ((i - 1 : ℕ) : ℚ) * S.w (.inr q)) := by
    intro u
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    cases u with
    | inr q =>
      dsimp only
      have hcard_Ico : ∀ (lo hi_b : ℕ) (hhi_le : hi_b ≤ N)
          (hcond : ∀ k : Fin N, k ∈ K ∧ vegaAdj i (.inl k) (.inr q) ↔ lo ≤ k.val ∧ k.val < hi_b),
          #(K.filter (fun k => vegaAdj i (.inl k) (.inr q))) = hi_b - lo := by
        intro lo hi_b hhi_le hcond
        have hbij : #(K.filter (fun k => vegaAdj i (.inl k) (.inr q))) = #(Finset.Ico lo hi_b) := by
          refine Finset.card_bij (fun k _ => k.val) ?_ ?_ ?_
          · intro k hk; rw [Finset.mem_filter] at hk; exact Finset.mem_Ico.mpr ((hcond k).mp hk)
          · intro k1 _ k2 _ h; exact Fin.ext h
          · intro m hm; rw [Finset.mem_Ico] at hm
            exact ⟨⟨m, by omega⟩, Finset.mem_filter.mpr ((hcond ⟨m, by omega⟩).mpr hm), rfl⟩
        rw [hbij, Nat.card_Ico]
      rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · simp [vegaAdj]
      · simp [vegaAdj]
      · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 2))) = i - 1 := by
          have := hcard_Ico 1 i (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
        rw [if_neg (by decide), hfilt]
      · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 3))) = i - 1 := by
          have := hcard_Ico i (2 * i - 1) (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
        rw [if_neg (by decide), hfilt]
      · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 4))) = i - 1 := by
          have := hcard_Ico (2 * i) (3 * i - 1) (by omega) (fun k => by have := k.isLt; simp [K, vegaAdj]; omega); omega
        rw [if_neg (by decide), hfilt]
      · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 5))) = i - 1 := by
          have := hcard_Ico 1 i (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
        rw [if_neg (by decide), hfilt]
      · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 6))) = i - 1 := by
          have := hcard_Ico i (2 * i - 1) (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
        rw [if_neg (by decide), hfilt]
      · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 7))) = i - 1 := by
          have := hcard_Ico (2 * i) (3 * i - 1) (by omega) (fun k => by have := k.isLt; simp [K, vegaAdj]; omega); omega
        rw [if_neg (by decide), hfilt]
    | inl p =>
      dsimp only
      have hp := p.isLt
      have htot_nbr := card_gamma_nbrs hi p
      let S_all := Finset.univ.filter (fun k : Fin N => vegaAdj i (.inl k) (.inl p))
      have h0_mem : (⟨0, by omega⟩ : Fin N) ∈ S_all ↔ i ≤ p.val ∧ p.val < 2 * i := by
        simp only [S_all, Finset.mem_filter, Finset.mem_univ, true_and]
        change (i ≤ (p.val + N - 0) % N ∧ (p.val + N - 0) % N ≤ 2 * i - 1) ↔ _
        have h1 : (p.val + N - 0) % N = p.val := by
          have : p.val + N - 0 = p.val + N := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt hp]
        rw [h1]; omega
      have he_mem : (⟨2 * i - 1, by omega⟩ : Fin N) ∈ S_all ↔ p.val < i := by
        simp only [S_all, Finset.mem_filter, Finset.mem_univ, true_and]
        change (i ≤ (p.val + N - (2 * i - 1)) % N ∧ (p.val + N - (2 * i - 1)) % N ≤ 2 * i - 1) ↔ _
        by_cases hpi : p.val < 2 * i - 1
        · have h1 : (p.val + N - (2 * i - 1)) % N = p.val + i := by
            have : p.val + N - (2 * i - 1) = p.val + i := by omega
            rw [this, Nat.mod_eq_of_lt (by omega)]
          rw [h1]; omega
        · have h1 : (p.val + N - (2 * i - 1)) % N = p.val - (2 * i - 1) := by
            have : p.val + N - (2 * i - 1) = (p.val - (2 * i - 1)) + N := by omega
            rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
          rw [h1]; omega
      have hfilt_eq : K.filter (fun k => vegaAdj i (.inl k) (.inl p)) =
          (S_all.erase ⟨0, by omega⟩).erase ⟨2 * i - 1, by omega⟩ := by
        ext k; simp only [K, S_all, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, true_and, ne_eq, Fin.ext_iff]
        tauto
      rw [hfilt_eq]
      by_cases hp3 : 2 * i ≤ p.val
      · rw [if_pos hp3]
        have h0n : (⟨0, by omega⟩ : Fin N) ∉ S_all := by rw [h0_mem]; omega
        have hen : (⟨2 * i - 1, by omega⟩ : Fin N) ∉ S_all.erase ⟨0, by omega⟩ := by
          intro h; exact (by omega : ¬ p.val < i) (he_mem.mp (Finset.mem_of_mem_erase h))
        rw [Finset.erase_eq_of_notMem hen, Finset.erase_eq_of_notMem h0n, htot_nbr]
      · rw [if_neg hp3]
        by_cases hp1 : p.val < i
        · have h0n : (⟨0, by omega⟩ : Fin N) ∉ S_all := by rw [h0_mem]; omega
          have hem : (⟨2 * i - 1, by omega⟩ : Fin N) ∈ S_all.erase ⟨0, by omega⟩ := by
            rw [Finset.erase_eq_of_notMem h0n]; exact he_mem.mpr hp1
          rw [Finset.card_erase_of_mem hem, Finset.erase_eq_of_notMem h0n, htot_nbr]
        · have h0m : (⟨0, by omega⟩ : Fin N) ∈ S_all := h0_mem.mpr ⟨by omega, by omega⟩
          have hen : (⟨2 * i - 1, by omega⟩ : Fin N) ∉ S_all.erase ⟨0, by omega⟩ := by
            intro h; exact hp1 (he_mem.mp (Finset.mem_of_mem_erase h))
          rw [Finset.erase_eq_of_notMem hen, Finset.card_erase_of_mem h0m, htot_nbr]
  have htot_eval : ∑ u : VegaV i, ∑ k ∈ K, (if vegaAdj i (.inl k) u then S.w u else 0) =
      ((i - 1 : ℕ) : ℚ) * (1 - sv S) + W3 S := by
    simp_rw [hcnt_u]
    rw [Fintype.sum_sum_type]
    have hQ : ∑ q : Fin 8, (if q.val = 0 ∨ q.val = 1 then 0 else ((i - 1 : ℕ) : ℚ) * S.w (.inr q)) =
        ((i - 1 : ℕ) : ℚ) * Stot S := by
      rw [Fin.sum_univ_eight]; simp [Stot, qa, qb, qc, qu, qv, qw]; ring
    have hG : ∑ p : Fin N, (if 2 * i ≤ p.val then (i : ℚ) * S.w (.inl p) else ((i - 1 : ℕ) : ℚ) * S.w (.inl p)) =
        ((i - 1 : ℕ) : ℚ) * WG S + W3 S := by
      have hsplit : ∀ p : Fin N,
          (if 2 * i ≤ p.val then (i : ℚ) * S.w (.inl p) else ((i - 1 : ℕ) : ℚ) * S.w (.inl p)) =
          ((i - 1 : ℕ) : ℚ) * S.w (.inl p) + if 2 * i ≤ p.val then S.w (.inl p) else 0 := by
        intro p; split_ifs
        · have : (i : ℚ) = ((i - 1 : ℕ) : ℚ) + 1 := by
            have : i = (i - 1) + 1 := by omega
            exact_mod_cast this
          rw [this]; ring
        · ring
      simp_rw [hsplit, Finset.sum_add_distrib, ← Finset.mul_sum]
      have hG1 : ∑ p : Fin N, S.w (.inl p) = WG S := by
        have h1 := S.hw_sum; rw [Fintype.sum_sum_type] at h1
        have h2 := sum_all_eq S
        have hQ' : ∑ q : Fin 8, S.w (.inr q) = WA S + WB S := by
          rw [Fin.sum_univ_eight]; simp [WA, WB, qx, qy, qa, qb, qc, qu, qv, qw]; ring
        linarith
      have hG3 : ∑ p : Fin N, (if 2 * i ≤ p.val then S.w (.inl p) else 0) = W3 S := by
        simp only [W3, Wv, Ij, I3, Finset.sum_filter]
        rw [Fintype.sum_sum_type]
        have hz : ∑ q : Fin 8, (if inI3 i (.inr q) = true then S.w (.inr q) else 0) = 0 := by simp [inI3]
        rw [hz, add_zero]
        apply Finset.sum_congr rfl; intro p _; simp [inI3]
      rw [hG1, hG3]
    rw [hG, hQ, Stot_eq S]; ring
  rw [htot_eval, hK_card] at hsum_deg
  have hcast : ((3 * (i - 1) : ℕ) : ℚ) * (1 / 3 : ℚ) = ((i - 1 : ℕ) : ℚ) := by push_cast; ring
  rw [hcast] at hsum_deg
  linarith

lemma W1_gt_W3_add_eps1 : W3 S + eps S 0 < W1 S := by
  have hi := S.hi
  have h0 := S.hdeg (.inl ⟨0, by omega⟩) (by simp [vegaActive]; omega)
  rw [Fintype.sum_sum_type] at h0
  have hQ : ∑ q : Fin 8, (if vegaAdj i (.inl ⟨0, by omega⟩) (.inr q) then S.w (.inr q) else 0) = sig S 0 := by
    rw [Fin.sum_univ_eight]
    have h1 : 0 < i := by omega
    have h2 : ¬(i ≤ 0) := by omega
    have h3 : ¬(2 * i ≤ 0) := by omega
    simp [vegaAdj, sig, av, uv, qa, qu, h1, h2, h3]
  have hG : ∑ p : Fin (3 * i - 1), (if vegaAdj i (.inl ⟨0, by omega⟩) (.inl p) then S.w (.inl p) else 0) = W2 S := by
    simp only [W2, Wv, Ij, I2, Finset.sum_filter]
    rw [Fintype.sum_sum_type]
    have hz : ∑ q : Fin 8, (if inI2 i (.inr q) = true then S.w (.inr q) else 0) = 0 := by simp [inI2]
    rw [hz, add_zero]
    apply Finset.sum_congr rfl; intro p _
    have hp := p.isLt
    have hmod : (p.val + (3 * i - 1) - 0) % (3 * i - 1) = p.val := by
      have : p.val + (3 * i - 1) - 0 = p.val + (3 * i - 1) := by omega
      rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt hp]
    simp only [vegaAdj, inI2, hmod, decide_eq_true_eq]
    have hiff : (i ≤ p.val ∧ p.val ≤ 2 * i - 1) ↔ (i ≤ p.val ∧ p.val < 2 * i) := by omega
    simp [hiff]
  have hs0 := sig_eq S 0
  simp only [WG, W1, W2, W3] at *
  linarith

lemma W1_gt_mul_s_add_eps1 : ((i - 1 : ℕ) : ℚ) * sv S + eps S 0 < W1 S := by
  have := W3_gt_mul_s S; have := W1_gt_W3_add_eps1 S; linarith

lemma W2_gt_W3_add_eps2 (hde : de = false) : W3 S + eps S 1 < W2 S := by
  have hi := S.hi
  have he := S.hdeg (.inl ⟨2 * i - 1, by omega⟩) (by simp [vegaActive, hde])
  rw [Fintype.sum_sum_type] at he
  have hQ : ∑ q : Fin 8, (if vegaAdj i (.inl ⟨2 * i - 1, by omega⟩) (.inr q) then S.w (.inr q) else 0) = sig S 1 := by
    rw [Fin.sum_univ_eight]
    have h1 : ¬(2 * i - 1 < i) := by omega
    have h2 : i ≤ 2 * i - 1 := by omega
    have h3 : 2 * i - 1 < 2 * i := by omega
    have h4 : ¬(2 * i ≤ 2 * i - 1) := by omega
    simp [vegaAdj, sig, av, uv, qb, qv, h1, h2, h3, h4]
  have hG : ∑ p : Fin (3 * i - 1), (if vegaAdj i (.inl ⟨2 * i - 1, by omega⟩) (.inl p) then S.w (.inl p) else 0) = W1 S := by
    simp only [W1, Wv, Ij, I1, Finset.sum_filter]
    rw [Fintype.sum_sum_type]
    have hz : ∑ q : Fin 8, (if inI1 i (.inr q) = true then S.w (.inr q) else 0) = 0 := by simp [inI1]
    rw [hz, add_zero]
    apply Finset.sum_congr rfl; intro p _
    have hp := p.isLt
    have hiff : vegaAdj i (.inl ⟨2 * i - 1, by omega⟩) (.inl p) ↔ p.val < i := by
      simp only [vegaAdj]
      by_cases hpi : p.val < 2 * i - 1
      · have hmod : (p.val + (3 * i - 1) - (2 * i - 1)) % (3 * i - 1) = p.val + i := by
          have : p.val + (3 * i - 1) - (2 * i - 1) = p.val + i := by omega
          rw [this, Nat.mod_eq_of_lt (by omega)]
        rw [hmod]; omega
      · have hmod : (p.val + (3 * i - 1) - (2 * i - 1)) % (3 * i - 1) = p.val - (2 * i - 1) := by
          have : p.val + (3 * i - 1) - (2 * i - 1) = (p.val - (2 * i - 1)) + (3 * i - 1) := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        rw [hmod]; omega
    simp [hiff, inI1]
  have hs1 := sig_eq S 1
  simp only [WG, W1, W2, W3] at *
  linarith

lemma W2_gt_mul_s : ((i - 1 : ℕ) : ℚ) * sv S < W2 S := by
  by_cases hde : de = false
  · have := W3_gt_mul_s S; have := W2_gt_W3_add_eps2 S hde; have := eps_pos S 1; linarith
  · have hdeT : de = true := by cases de <;> simp at hde ⊢
    have hi := S.hi
    let N := 3 * i - 1
    let K : Finset (Fin N) := Finset.univ.filter (fun p : Fin N => p.val ≠ i - 1 ∧ p.val ≠ 2 * i - 1)
    have hK_card : #K = 3 * (i - 1) := by
      have h0 : (⟨i - 1, by omega⟩ : Fin N) ∈ (Finset.univ : Finset (Fin N)) := Finset.mem_univ _
      have he : (⟨2 * i - 1, by omega⟩ : Fin N) ∈ (Finset.univ : Finset (Fin N)).erase ⟨i - 1, by omega⟩ := by
        simp [Fin.ext_iff]; omega
      have hK_eq : K = ((Finset.univ : Finset (Fin N)).erase ⟨i - 1, by omega⟩).erase ⟨2 * i - 1, by omega⟩ := by
        ext p; simp only [K, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, true_and, and_true, ne_eq, Fin.ext_iff]
        tauto
      rw [hK_eq, Finset.card_erase_of_mem he, Finset.card_erase_of_mem h0, Finset.card_univ, Fintype.card_fin]
      omega
    have hsum_deg : ((#K : ℕ) : ℚ) * (1 / 3 : ℚ) < ∑ k ∈ K, ∑ u : VegaV i, if vegaAdj i (.inl k) u then S.w u else 0 := by
      calc ((#K : ℕ) : ℚ) * (1 / 3 : ℚ) = ∑ _k ∈ K, (1 / 3 : ℚ) := by rw [Finset.sum_const, nsmul_eq_mul]
        _ < ∑ k ∈ K, ∑ u : VegaV i, if vegaAdj i (.inl k) u then S.w u else 0 := by
          apply Finset.sum_lt_sum_of_nonempty
          · rw [Finset.card_pos.symm, hK_card]; omega
          · intro k hk
            have hne : k.val ≠ 2 * i - 1 := (Finset.mem_filter.mp hk).2.2
            exact S.hdeg (.inl k) (by simp [vegaActive, hne])
    rw [Finset.sum_comm] at hsum_deg
    have hcnt_u : ∀ u : VegaV i, ∑ k ∈ K, (if vegaAdj i (.inl k) u then S.w u else 0) =
        (match u with
         | .inl p => if i ≤ p.val ∧ p.val < 2 * i then (i : ℚ) * S.w (.inl p) else ((i - 1 : ℕ) : ℚ) * S.w (.inl p)
         | .inr q => if q.val = 0 ∨ q.val = 1 then 0 else ((i - 1 : ℕ) : ℚ) * S.w (.inr q)) := by
      intro u
      rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
      cases u with
      | inr q =>
        dsimp only
        have hcard_Ico : ∀ (lo hi_b : ℕ) (hhi_le : hi_b ≤ N)
            (hcond : ∀ k : Fin N, k ∈ K ∧ vegaAdj i (.inl k) (.inr q) ↔ lo ≤ k.val ∧ k.val < hi_b),
            #(K.filter (fun k => vegaAdj i (.inl k) (.inr q))) = hi_b - lo := by
          intro lo hi_b hhi_le hcond
          have hbij : #(K.filter (fun k => vegaAdj i (.inl k) (.inr q))) = #(Finset.Ico lo hi_b) := by
            refine Finset.card_bij (fun k _ => k.val) ?_ ?_ ?_
            · intro k hk; rw [Finset.mem_filter] at hk; exact Finset.mem_Ico.mpr ((hcond k).mp hk)
            · intro k1 _ k2 _ h; exact Fin.ext h
            · intro m hm; rw [Finset.mem_Ico] at hm
              exact ⟨⟨m, by omega⟩, Finset.mem_filter.mpr ((hcond ⟨m, by omega⟩).mpr hm), rfl⟩
          rw [hbij, Nat.card_Ico]
        rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
        · simp [vegaAdj]
        · simp [vegaAdj]
        · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 2))) = i - 1 := by
            have := hcard_Ico 0 (i - 1) (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
          rw [if_neg (by decide), hfilt]
        · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 3))) = i - 1 := by
            have := hcard_Ico i (2 * i - 1) (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
          rw [if_neg (by decide), hfilt]
        · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 4))) = i - 1 := by
            have := hcard_Ico (2 * i) (3 * i - 1) (by omega) (fun k => by have := k.isLt; simp [K, vegaAdj]; omega); omega
          rw [if_neg (by decide), hfilt]
        · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 5))) = i - 1 := by
            have := hcard_Ico 0 (i - 1) (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
          rw [if_neg (by decide), hfilt]
        · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 6))) = i - 1 := by
            have := hcard_Ico i (2 * i - 1) (by omega) (fun k => by simp [K, vegaAdj]; omega); omega
          rw [if_neg (by decide), hfilt]
        · have hfilt : #(K.filter (fun k => vegaAdj i (.inl k) (.inr 7))) = i - 1 := by
            have := hcard_Ico (2 * i) (3 * i - 1) (by omega) (fun k => by have := k.isLt; simp [K, vegaAdj]; omega); omega
          rw [if_neg (by decide), hfilt]
      | inl p =>
        dsimp only
        by_cases hpend : p.val = 2 * i - 1
        · have hw0 : S.w (.inl p) = 0 := S.hw_zero (.inl p) (by simp [vegaActive, hdeT, hpend])
          simp [hw0]
        · have hp := p.isLt
          have htot_nbr := card_gamma_nbrs hi p
          let S_all := Finset.univ.filter (fun k : Fin N => vegaAdj i (.inl k) (.inl p))
          have hi1_mem : (⟨i - 1, by omega⟩ : Fin N) ∈ S_all ↔ 2 * i ≤ p.val := by
            simp only [S_all, Finset.mem_filter, Finset.mem_univ, true_and]
            change (i ≤ (p.val + N - (i - 1)) % N ∧ (p.val + N - (i - 1)) % N ≤ 2 * i - 1) ↔ _
            by_cases hpi : p.val < i - 1
            · have h1 : (p.val + N - (i - 1)) % N = p.val + 2 * i := by
                have : p.val + N - (i - 1) = p.val + 2 * i := by omega
                rw [this, Nat.mod_eq_of_lt (by omega)]
              rw [h1]; omega
            · have h1 : (p.val + N - (i - 1)) % N = p.val - (i - 1) := by
                have : p.val + N - (i - 1) = (p.val - (i - 1)) + N := by omega
                rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
              rw [h1]; omega
          have he_mem : (⟨2 * i - 1, by omega⟩ : Fin N) ∈ S_all ↔ p.val < i := by
            simp only [S_all, Finset.mem_filter, Finset.mem_univ, true_and]
            change (i ≤ (p.val + N - (2 * i - 1)) % N ∧ (p.val + N - (2 * i - 1)) % N ≤ 2 * i - 1) ↔ _
            by_cases hpi : p.val < 2 * i - 1
            · have h1 : (p.val + N - (2 * i - 1)) % N = p.val + i := by
                have : p.val + N - (2 * i - 1) = p.val + i := by omega
                rw [this, Nat.mod_eq_of_lt (by omega)]
              rw [h1]; omega
            · have h1 : (p.val + N - (2 * i - 1)) % N = p.val - (2 * i - 1) := by
                have : p.val + N - (2 * i - 1) = (p.val - (2 * i - 1)) + N := by omega
                rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
              rw [h1]; omega
          have hfilt_eq : K.filter (fun k => vegaAdj i (.inl k) (.inl p)) =
              (S_all.erase ⟨i - 1, by omega⟩).erase ⟨2 * i - 1, by omega⟩ := by
            ext k; simp only [K, S_all, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, true_and, ne_eq, Fin.ext_iff]
            tauto
          rw [hfilt_eq]
          by_cases hp2 : i ≤ p.val ∧ p.val < 2 * i
          · rw [if_pos hp2]
            have h1n : (⟨i - 1, by omega⟩ : Fin N) ∉ S_all := by rw [hi1_mem]; omega
            have hen : (⟨2 * i - 1, by omega⟩ : Fin N) ∉ S_all.erase ⟨i - 1, by omega⟩ := by
              intro h; exact (by omega : ¬ p.val < i) (he_mem.mp (Finset.mem_of_mem_erase h))
            rw [Finset.erase_eq_of_notMem hen, Finset.erase_eq_of_notMem h1n, htot_nbr]
          · rw [if_neg hp2]
            by_cases hp1 : p.val < i
            · have h1n : (⟨i - 1, by omega⟩ : Fin N) ∉ S_all := by rw [hi1_mem]; omega
              have hem : (⟨2 * i - 1, by omega⟩ : Fin N) ∈ S_all.erase ⟨i - 1, by omega⟩ := by
                rw [Finset.erase_eq_of_notMem h1n]; exact he_mem.mpr hp1
              rw [Finset.card_erase_of_mem hem, Finset.erase_eq_of_notMem h1n, htot_nbr]
            · have h1m : (⟨i - 1, by omega⟩ : Fin N) ∈ S_all := hi1_mem.mpr (by omega)
              have hen : (⟨2 * i - 1, by omega⟩ : Fin N) ∉ S_all.erase ⟨i - 1, by omega⟩ := by
                intro h; exact hp1 (he_mem.mp (Finset.mem_of_mem_erase h))
              rw [Finset.erase_eq_of_notMem hen, Finset.card_erase_of_mem h1m, htot_nbr]
    have htot_eval : ∑ u : VegaV i, ∑ k ∈ K, (if vegaAdj i (.inl k) u then S.w u else 0) =
        ((i - 1 : ℕ) : ℚ) * (1 - sv S) + W2 S := by
      simp_rw [hcnt_u]
      rw [Fintype.sum_sum_type]
      have hQ : ∑ q : Fin 8, (if q.val = 0 ∨ q.val = 1 then 0 else ((i - 1 : ℕ) : ℚ) * S.w (.inr q)) =
          ((i - 1 : ℕ) : ℚ) * Stot S := by
        rw [Fin.sum_univ_eight]; simp [Stot, qa, qb, qc, qu, qv, qw]; ring
      have hG : ∑ p : Fin N, (if i ≤ p.val ∧ p.val < 2 * i then (i : ℚ) * S.w (.inl p) else ((i - 1 : ℕ) : ℚ) * S.w (.inl p)) =
          ((i - 1 : ℕ) : ℚ) * WG S + W2 S := by
        have hsplit : ∀ p : Fin N,
            (if i ≤ p.val ∧ p.val < 2 * i then (i : ℚ) * S.w (.inl p) else ((i - 1 : ℕ) : ℚ) * S.w (.inl p)) =
            ((i - 1 : ℕ) : ℚ) * S.w (.inl p) + if i ≤ p.val ∧ p.val < 2 * i then S.w (.inl p) else 0 := by
          intro p; split_ifs
          · have : (i : ℚ) = ((i - 1 : ℕ) : ℚ) + 1 := by
              have : i = (i - 1) + 1 := by omega
              exact_mod_cast this
            rw [this]; ring
          · ring
        simp_rw [hsplit, Finset.sum_add_distrib, ← Finset.mul_sum]
        have hG1 : ∑ p : Fin N, S.w (.inl p) = WG S := by
          have h1 := S.hw_sum; rw [Fintype.sum_sum_type] at h1
          have h2 := sum_all_eq S
          have hQ' : ∑ q : Fin 8, S.w (.inr q) = WA S + WB S := by
            rw [Fin.sum_univ_eight]; simp [WA, WB, qx, qy, qa, qb, qc, qu, qv, qw]; ring
          linarith
        have hG2 : ∑ p : Fin N, (if i ≤ p.val ∧ p.val < 2 * i then S.w (.inl p) else 0) = W2 S := by
          simp only [W2, Wv, Ij, I2, Finset.sum_filter]
          rw [Fintype.sum_sum_type]
          have hz : ∑ q : Fin 8, (if inI2 i (.inr q) = true then S.w (.inr q) else 0) = 0 := by simp [inI2]
          rw [hz, add_zero]
          apply Finset.sum_congr rfl; intro p _; simp [inI2]
        rw [hG1, hG2]
      rw [hG, hQ, Stot_eq S]; ring
    rw [htot_eval, hK_card] at hsum_deg
    have hcast : ((3 * (i - 1) : ℕ) : ℚ) * (1 / 3 : ℚ) = ((i - 1 : ℕ) : ℚ) := by push_cast; ring
    rw [hcast] at hsum_deg
    linarith

lemma Wv_gt_mul_s (j : Fin 3) : ((i - 1 : ℕ) : ℚ) * sv S < Wv S j := by
  rcases fin3_cases j with rfl | rfl | rfl
  · have h1 := W1_gt_mul_s_add_eps1 S; have h2 := eps_pos S 0; simp only [W1] at h1; linarith
  · exact W2_gt_mul_s S
  · exact W3_gt_mul_s S

lemma Wv_gt_s (j : Fin 3) : sv S < Wv S j := by
  have hi := S.hi
  have h1 := Wv_gt_mul_s S j
  have hs_nn : 0 ≤ sv S := add_nonneg (S.hw_nonneg (.inr 0)) (S.hw_nonneg (.inr 1))
  have hi1 : (1 : ℚ) ≤ ((i - 1 : ℕ) : ℚ) := by exact_mod_cast (by omega : 1 ≤ i - 1)
  nlinarith

lemma sv_lt_of_ge_three (hi3 : 3 ≤ i) : sv S < 1 / 15 := by
  have h1 := Wv_gt_mul_s S 0; have h2 := Wv_gt_mul_s S 1; have h3 := Wv_gt_mul_s S 2
  have hWG := WG_lt_third_add_s S
  have hi2 : (2 : ℚ) ≤ ((i - 1 : ℕ) : ℚ) := by exact_mod_cast (by omega : 2 ≤ i - 1)
  have hs_nn : 0 ≤ sv S := add_nonneg (S.hw_nonneg (.inr 0)) (S.hw_nonneg (.inr 1))
  simp only [WG, W1, W2, W3] at *; nlinarith

lemma sv_lt_twelfth_of_interior (hInt0 : 1 / 2 ≤ W1 S + Lv S 0) : sv S < 1 / 12 := by
  have hi := S.hi
  have h1 := W1_gt_mul_s_add_eps1 S
  have hL0 := Lv_eq S 0
  have hi1 : (1 : ℚ) ≤ ((i - 1 : ℕ) : ℚ) := by exact_mod_cast (by omega : 1 ≤ i - 1)
  have hs_nn : 0 ≤ sv S := add_nonneg (S.hw_nonneg (.inr 0)) (S.hw_nonneg (.inr 1))
  simp only [rv, W1] at *; nlinarith

/- ### Step 2: Family P_1 (Interior & Universal Boundary 2) and Family P_2 -/

/-- Helper: weighted sum over `Gamma_i` filtered by `Ij i j` equals `c * Wv S j`. -/
lemma sum_inl_Ij (j : Fin 3) (c : ℚ) :
    ∑ p : Fin (3 * i - 1), (if (.inl p : VegaV i) ∈ Ij i j then c else 0) * S.w (.inl p) = c * Wv S j := by
  simp only [Wv, Finset.mul_sum]
  have h1 : ∑ z ∈ Ij i j, c * S.w z = ∑ z : VegaV i, if z ∈ Ij i j then c * S.w z else 0 := by
    rw [← Finset.sum_filter]; congr 1; ext z; simp
  rw [h1, Fintype.sum_sum_type]
  have hQ : ∑ q : Fin 8, (if (.inr q : VegaV i) ∈ Ij i j then c * S.w (.inr q) else 0) = 0 := by
    apply Finset.sum_eq_zero; intro q _
    have hni : (.inr q : VegaV i) ∉ Ij i j := by rcases fin3_cases j with rfl | rfl | rfl <;> simp [Ij]
    simp [hni]
  rw [hQ, add_zero]
  apply Finset.sum_congr rfl; intro p _; split_ifs <;> ring

/-- Helper: directed edge sum of a rational fractional selection supported on `I_j ∪ {x, y, b_j, c_j, v_j, w_j}`. -/
lemma frac_sum_on_block (j : Fin 3) (tx ty tb tc tv tw : ℚ)
    (htx : 0 ≤ tx ∧ tx ≤ 1) (hty : 0 ≤ ty ∧ ty ≤ 1)
    (htb : 0 ≤ tb ∧ tb ≤ 1) (htc : 0 ≤ tc ∧ tc ≤ 1)
    (htv : 0 ≤ tv ∧ tv ≤ 1) (htw : 0 ≤ tw ∧ tw ≤ 1)
    (hsum : Wv S j + tx * qx S + ty * qy S +
      (match j with
       | 0 => tb * qb S + tc * qc S + tv * qv S + tw * qw S
       | 1 => tb * qa S + tc * qc S + tv * qu S + tw * qw S
       | 2 => tb * qa S + tc * qb S + tv * qu S + tw * qv S) = 1 / 2) :
    (1 / 50 : ℚ) <
      tx * ty * qx S * qy S +
      (match j with
       | 0 => tb * tw * qb S * qw S + tc * tv * qc S * qv S +
              tx * (tb * qb S + tc * qc S) * qx S + ty * (tv * qv S + tw * qw S) * qy S
       | 1 => tb * tw * qa S * qw S + tc * tv * qc S * qu S +
              tx * (tb * qa S + tc * qc S) * qx S + ty * (tv * qu S + tw * qw S) * qy S
       | 2 => tb * tw * qa S * qv S + tc * tv * qb S * qu S +
              tx * (tb * qa S + tc * qb S) * qx S + ty * (tv * qu S + tw * qv S) * qy S) := by
  let t : VegaV i → ℚ := fun z =>
    match z with
    | .inl p => if .inl p ∈ Ij i j then 1 else 0
    | .inr q =>
      match q.val with
      | 0 => tx | 1 => ty
      | 2 => if j = 0 then 0 else tb
      | 3 => if j = 1 then 0 else if j = 0 then tb else tc
      | 4 => if j = 2 then 0 else tc
      | 5 => if j = 0 then 0 else tv
      | 6 => if j = 1 then 0 else if j = 0 then tv else tw
      | 7 => if j = 2 then 0 else tw
      | _ => 0
  have ht_rng : ∀ z, 0 ≤ t z ∧ t z ≤ 1 := by
    intro z; cases z with
    | inl p => dsimp only [t]; split_ifs <;> norm_num
    | inr q => rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rcases fin3_cases j with rfl | rfl | rfl <;> simp [t] <;> tauto
  have htsum : ∑ z : VegaV i, t z * S.w z = 1 / 2 := by
    rw [Fintype.sum_sum_type]
    have hG : ∑ p : Fin (3 * i - 1), t (.inl p) * S.w (.inl p) = Wv S j := by
      simpa [t] using sum_inl_Ij S j 1
    have hQ : ∑ q : Fin 8, t (.inr q) * S.w (.inr q) =
        tx * qx S + ty * qy S +
        (match j with
         | 0 => tb * qb S + tc * qc S + tv * qv S + tw * qw S
         | 1 => tb * qa S + tc * qc S + tv * qu S + tw * qw S
         | 2 => tb * qa S + tc * qb S + tv * qu S + tw * qv S) := by
      rw [Fin.sum_univ_eight]
      rcases fin3_cases j with rfl | rfl | rfl <;> simp [t, qx, qy, qa, qb, qc, qu, qv, qw] <;> ring
    rcases fin3_cases j with rfl | rfl | rfl <;> (dsimp only at hsum hQ; linarith)
  have hfr := S.hfrac t ht_rng htsum
  -- Evaluate double sum: I_j is independent and has ZERO edges to {x, y, b_j, c_j, v_j, w_j}!
  have hdbl : ∑ u : VegaV i, ∑ v : VegaV i, (if vegaAdj i u v then t u * t v * S.w u * S.w v else 0) =
      2 * (tx * ty * qx S * qy S +
        (match j with
         | 0 => tb * tw * qb S * qw S + tc * tv * qc S * qv S +
                tx * (tb * qb S + tc * qc S) * qx S + ty * (tv * qv S + tw * qw S) * qy S
         | 1 => tb * tw * qa S * qw S + tc * tv * qc S * qu S +
                tx * (tb * qa S + tc * qc S) * qx S + ty * (tv * qu S + tw * qw S) * qy S
         | 2 => tb * tw * qa S * qv S + tc * tv * qb S * qu S +
                tx * (tb * qa S + tc * qb S) * qx S + ty * (tv * qu S + tw * qv S) * qy S)) := by
    have hno_G : ∀ p : Fin (3 * i - 1), ∀ v : VegaV i,
        (if vegaAdj i (.inl p) v then t (.inl p) * t v * S.w (.inl p) * S.w v else 0) = 0 := by
      intro p v
      split_ifs with hadj
      · by_cases hp : (.inl p : VegaV i) ∈ Ij i j
        · cases v with
          | inl q =>
            by_cases hq : (.inl q : VegaV i) ∈ Ij i j
            · exact (indep_Ij S.hi j (.inl p) hp (.inl q) hq hadj).elim
            · simp [t, hq]
          | inr q =>
            rcases fin3_cases j with rfl | rfl | rfl <;>
            rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
            simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hp <;>
            simp only [vegaAdj, t] at hadj ⊢ <;>
            (try simp) <;> (try omega)
        · simp [t, hp]
      · rfl
    have hno_QG : ∀ q : Fin 8, ∀ p : Fin (3 * i - 1),
        (if vegaAdj i (.inr q) (.inl p) then t (.inr q) * t (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) = 0 := by
      intro q p
      have hsym : vegaAdj i (.inr q) (.inl p) ↔ vegaAdj i (.inl p) (.inr q) :=
        ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
      have h0 := hno_G p (.inr q)
      split_ifs at h0 ⊢ with h1 h2
      · linarith
      · exact (h2 (hsym.mp h1)).elim
      · rfl
      · rfl
    rw [Fintype.sum_sum_type]
    have h1 : ∑ p : Fin (3 * i - 1), ∑ v : VegaV i,
        (if vegaAdj i (.inl p) v then t (.inl p) * t v * S.w (.inl p) * S.w v else 0) = 0 :=
      Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun v _ => hno_G p v))
    rw [h1, zero_add]
    have h2 : ∑ q : Fin 8, ∑ v : VegaV i,
        (if vegaAdj i (.inr q) v then t (.inr q) * t v * S.w (.inr q) * S.w v else 0) =
        ∑ q : Fin 8, ∑ r : Fin 8,
          if vegaAdj i (.inr q) (.inr r) then t (.inr q) * t (.inr r) * S.w (.inr q) * S.w (.inr r) else 0 := by
      apply Finset.sum_congr rfl; intro q _
      rw [Fintype.sum_sum_type]
      have hz : ∑ p : Fin (3 * i - 1),
          (if vegaAdj i (.inr q) (.inl p) then t (.inr q) * t (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) = 0 :=
        Finset.sum_eq_zero (fun p _ => hno_QG q p)
      rw [hz, zero_add]
    rw [h2]
    rcases fin3_cases j with rfl | rfl | rfl <;>
      (simp [Fin.sum_univ_eight, vegaAdj, t, qx, qy, qa, qb, qc, qu, qv, qw]; ring)
  linarith

/-- Family P_1 Interior (J1.2): Whenever `W_j + L_j >= 1/2`, `H_{1,j} := (1/3 + r_j) * E_j - (1/50) * L_j > 0`. -/
lemma H1_pos_of_interior (j : Fin 3) (hInt : 1 / 2 ≤ Wv S j + Lv S j) :
    (1 / 50 : ℚ) * Lv S j < (1 / 3 + rv S j) * Ev S j := by
  -- Check both independent halves W_j + b_j + v_j < 1/2 and W_j + c_j + w_j < 1/2 via Theorem A!
  have hbv_lt : ∀ k : Fin 3, k ≠ j → Wv S j + sig S k < 1 / 2 := by
    intro k hkj
    have := sig_add_W_lt S hkj
    linarith
  have hL_eq : Lv S j = (match j with | 0 => sig S 1 + sig S 2 | 1 => sig S 0 + sig S 2 | 2 => sig S 0 + sig S 1) := by
    rcases fin3_cases j with rfl | rfl | rfl <;> simp [Lv, sig, av, uv, Stot, qa, qb, qc, qu, qv, qw] <;> ring
  have h1m : 1 - 2 * Wv S j - Lv S j = 1 / 3 + rv S j := by
    have := Lv_eq S j; linarith
  rcases fin3_cases j with rfl | rfl | rfl
  · have h1 := hbv_lt 1 (by decide); have h2 := hbv_lt 2 (by decide)
    have hs1_pos : 0 < sig S 1 := by linarith
    have hs2_pos : 0 < sig S 2 := by linarith
    set th1 := (1 / 2 - Wv S 0 - sig S 1) / sig S 2
    set th2 := (1 / 2 - Wv S 0 - sig S 2) / sig S 1
    have hth1 : 0 ≤ th1 ∧ th1 ≤ 1 := by
      constructor
      · exact div_nonneg (by linarith) (le_of_lt hs2_pos)
      · rw [div_le_one hs2_pos]; linarith
    have hth2 : 0 ≤ th2 ∧ th2 ≤ 1 := by
      constructor
      · exact div_nonneg (by linarith) (le_of_lt hs1_pos)
      · rw [div_le_one hs1_pos]; linarith
    have hf1 := frac_sum_on_block S 0 0 0 1 th1 1 th1 ⟨le_rfl, by norm_num⟩ ⟨le_rfl, by norm_num⟩
      ⟨by norm_num, le_rfl⟩ hth1 ⟨by norm_num, le_rfl⟩ hth1 (by
        have : th1 * qc S + th1 * qw S = th1 * sig S 2 := by simp [sig, av, uv]; ring
        have hmul : th1 * sig S 2 = 1 / 2 - Wv S 0 - sig S 1 := div_mul_cancel₀ _ (ne_of_gt hs2_pos)
        simp only [sig, av, uv] at *; linarith)
    have hf2 := frac_sum_on_block S 0 0 0 th2 1 th2 1 ⟨le_rfl, by norm_num⟩ ⟨le_rfl, by norm_num⟩
      hth2 ⟨by norm_num, le_rfl⟩ hth2 ⟨by norm_num, le_rfl⟩ (by
        have : th2 * qb S + th2 * qv S = th2 * sig S 1 := by simp [sig, av, uv]; ring
        have hmul : th2 * sig S 1 = 1 / 2 - Wv S 0 - sig S 2 := div_mul_cancel₀ _ (ne_of_gt hs1_pos)
        simp only [sig, av, uv] at *; linarith)
    have he1 : (1 / 50 : ℚ) < th1 * Ev S 0 := by simp only [Ev] at *; linarith
    have he2 : (1 / 50 : ℚ) < th2 * Ev S 0 := by simp only [Ev] at *; linarith
    have hm1 : (1 / 50 : ℚ) * sig S 2 < (1 / 2 - Wv S 0 - sig S 1) * Ev S 0 := by
      have := mul_lt_mul_of_pos_right he1 hs2_pos
      rwa [mul_assoc, mul_comm (Ev S 0), ← mul_assoc, div_mul_cancel₀ _ (ne_of_gt hs2_pos)] at this
    have hm2 : (1 / 50 : ℚ) * sig S 1 < (1 / 2 - Wv S 0 - sig S 2) * Ev S 0 := by
      have := mul_lt_mul_of_pos_right he2 hs1_pos
      rwa [mul_assoc, mul_comm (Ev S 0), ← mul_assoc, div_mul_cancel₀ _ (ne_of_gt hs1_pos)] at this
    dsimp only at hL_eq
    have hadd : (1 / 50 : ℚ) * (sig S 1 + sig S 2) < (1 - 2 * Wv S 0 - (sig S 1 + sig S 2)) * Ev S 0 := by linarith only [hm1, hm2]
    rw [← hL_eq, h1m] at hadd; exact hadd
  · have h1 := hbv_lt 0 (by decide); have h2 := hbv_lt 2 (by decide)
    have hs0_pos : 0 < sig S 0 := by linarith
    have hs2_pos : 0 < sig S 2 := by linarith
    set th1 := (1 / 2 - Wv S 1 - sig S 0) / sig S 2
    set th2 := (1 / 2 - Wv S 1 - sig S 2) / sig S 0
    have hth1 : 0 ≤ th1 ∧ th1 ≤ 1 := ⟨div_nonneg (by linarith) (le_of_lt hs2_pos), (div_le_one hs2_pos).mpr (by linarith)⟩
    have hth2 : 0 ≤ th2 ∧ th2 ≤ 1 := ⟨div_nonneg (by linarith) (le_of_lt hs0_pos), (div_le_one hs0_pos).mpr (by linarith)⟩
    have hf1 := frac_sum_on_block S 1 0 0 1 th1 1 th1 ⟨le_rfl, by norm_num⟩ ⟨le_rfl, by norm_num⟩
      ⟨by norm_num, le_rfl⟩ hth1 ⟨by norm_num, le_rfl⟩ hth1 (by
        have hmul : th1 * sig S 2 = 1 / 2 - Wv S 1 - sig S 0 := div_mul_cancel₀ _ (ne_of_gt hs2_pos)
        simp only [sig, av, uv] at *; linarith)
    have hf2 := frac_sum_on_block S 1 0 0 th2 1 th2 1 ⟨le_rfl, by norm_num⟩ ⟨le_rfl, by norm_num⟩
      hth2 ⟨by norm_num, le_rfl⟩ hth2 ⟨by norm_num, le_rfl⟩ (by
        have hmul : th2 * sig S 0 = 1 / 2 - Wv S 1 - sig S 2 := div_mul_cancel₀ _ (ne_of_gt hs0_pos)
        simp only [sig, av, uv] at *; linarith)
    have he1 : (1 / 50 : ℚ) < th1 * Ev S 1 := by simp only [Ev] at *; linarith
    have he2 : (1 / 50 : ℚ) < th2 * Ev S 1 := by simp only [Ev] at *; linarith
    have hm1 : (1 / 50 : ℚ) * sig S 2 < (1 / 2 - Wv S 1 - sig S 0) * Ev S 1 := by
      have := mul_lt_mul_of_pos_right he1 hs2_pos
      rwa [mul_assoc, mul_comm (Ev S 1), ← mul_assoc, div_mul_cancel₀ _ (ne_of_gt hs2_pos)] at this
    have hm2 : (1 / 50 : ℚ) * sig S 0 < (1 / 2 - Wv S 1 - sig S 2) * Ev S 1 := by
      have := mul_lt_mul_of_pos_right he2 hs0_pos
      rwa [mul_assoc, mul_comm (Ev S 1), ← mul_assoc, div_mul_cancel₀ _ (ne_of_gt hs0_pos)] at this
    dsimp only at hL_eq
    have hadd : (1 / 50 : ℚ) * (sig S 0 + sig S 2) < (1 - 2 * Wv S 1 - (sig S 0 + sig S 2)) * Ev S 1 := by linarith only [hm1, hm2]
    rw [← hL_eq, h1m] at hadd; exact hadd
  · have h1 := hbv_lt 0 (by decide); have h2 := hbv_lt 1 (by decide)
    have hs0_pos : 0 < sig S 0 := by linarith
    have hs1_pos : 0 < sig S 1 := by linarith
    set th1 := (1 / 2 - Wv S 2 - sig S 0) / sig S 1
    set th2 := (1 / 2 - Wv S 2 - sig S 1) / sig S 0
    have hth1 : 0 ≤ th1 ∧ th1 ≤ 1 := ⟨div_nonneg (by linarith) (le_of_lt hs1_pos), (div_le_one hs1_pos).mpr (by linarith)⟩
    have hth2 : 0 ≤ th2 ∧ th2 ≤ 1 := ⟨div_nonneg (by linarith) (le_of_lt hs0_pos), (div_le_one hs0_pos).mpr (by linarith)⟩
    have hf1 := frac_sum_on_block S 2 0 0 1 th1 1 th1 ⟨le_rfl, by norm_num⟩ ⟨le_rfl, by norm_num⟩
      ⟨by norm_num, le_rfl⟩ hth1 ⟨by norm_num, le_rfl⟩ hth1 (by
        have hmul : th1 * sig S 1 = 1 / 2 - Wv S 2 - sig S 0 := div_mul_cancel₀ _ (ne_of_gt hs1_pos)
        simp only [sig, av, uv] at *; linarith)
    have hf2 := frac_sum_on_block S 2 0 0 th2 1 th2 1 ⟨le_rfl, by norm_num⟩ ⟨le_rfl, by norm_num⟩
      hth2 ⟨by norm_num, le_rfl⟩ hth2 ⟨by norm_num, le_rfl⟩ (by
        have hmul : th2 * sig S 0 = 1 / 2 - Wv S 2 - sig S 1 := div_mul_cancel₀ _ (ne_of_gt hs0_pos)
        simp only [sig, av, uv] at *; linarith)
    have he1 : (1 / 50 : ℚ) < th1 * Ev S 2 := by simp only [Ev] at *; linarith
    have he2 : (1 / 50 : ℚ) < th2 * Ev S 2 := by simp only [Ev] at *; linarith
    have hm1 : (1 / 50 : ℚ) * sig S 1 < (1 / 2 - Wv S 2 - sig S 0) * Ev S 2 := by
      have := mul_lt_mul_of_pos_right he1 hs1_pos
      rwa [mul_assoc, mul_comm (Ev S 2), ← mul_assoc, div_mul_cancel₀ _ (ne_of_gt hs1_pos)] at this
    have hm2 : (1 / 50 : ℚ) * sig S 0 < (1 / 2 - Wv S 2 - sig S 1) * Ev S 2 := by
      have := mul_lt_mul_of_pos_right he2 hs0_pos
      rwa [mul_assoc, mul_comm (Ev S 2), ← mul_assoc, div_mul_cancel₀ _ (ne_of_gt hs0_pos)] at this
    dsimp only at hL_eq
    have hadd : (1 / 50 : ℚ) * (sig S 0 + sig S 1) < (1 - 2 * Wv S 2 - (sig S 0 + sig S 1)) * Ev S 2 := by linarith only [hm1, hm2]
    rw [← hL_eq, h1m] at hadd; exact hadd

/-- Universal Boundary-2 Identity (J1.3a, b, c) -> (J1.3):
    Whenever `W_j + L_j < 1/2 <= W_j + L_j + s`, `((1/3 + r_j)^2 + r_j^2 - (sig_k - sig_l)^2) / 8 > 1/50`,
    and when `y = 0` (`t_j <= x`), even tighter with `-(z_j - 2*t_j)^2 / 8`! -/
lemma boundary2_exact_gt (j k l : Fin 3) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l)
    (hB2 : Wv S j + Lv S j < 1 / 2) (hReach : 1 / 2 ≤ Wv S j + Lv S j + sv S) :
    (1 / 50 : ℚ) < ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2 - (sig S k - sig S l) ^ 2) / 8 := by
  set t := 1 / 2 - Wv S j - Lv S j with ht_def
  have ht_pos : 0 < t := by linarith
  have ht_le_s : t ≤ sv S := by linarith
  have hL_t : Lv S j = 1 / 3 + rv S j - 2 * t := by have := Lv_eq S j; linarith
  have hEv := Ev_le S j k l hjk hjl hkl
  have hbc : (match j with | 0 => qb S + qc S | 1 => qa S + qc S | 2 => qa S + qb S) = (Lv S j + zv S j) / 2 := by
    rcases fin3_cases j with rfl | rfl | rfl <;> simp only [Lv, zv, dv, del, Tv, Stot, sig, av, uv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw] <;> ring
  have hvw : (match j with | 0 => qv S + qw S | 1 => qu S + qw S | 2 => qu S + qv S) = (Lv S j - zv S j) / 2 := by
    rcases fin3_cases j with rfl | rfl | rfl <;> simp only [Lv, zv, dv, del, Tv, Stot, sig, av, uv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw] <;> ring
  have hL_match : (match j with | 0 => qb S + qc S + qv S + qw S | 1 => qa S + qc S + qu S + qw S | 2 => qa S + qb S + qu S + qv S) = Lv S j := by
    rcases fin3_cases j with rfl | rfl | rfl <;> simp [Lv, sig, av, uv, Stot] <;> ring
  by_cases htx : t ≤ qx S
  · have hx_pos : 0 < qx S := lt_of_lt_of_le ht_pos htx
    have hf := frac_sum_on_block S j (t / qx S) 0 1 1 1 1
      ⟨div_nonneg (le_of_lt ht_pos) (le_of_lt hx_pos), (div_le_one hx_pos).mpr htx⟩
      ⟨le_rfl, by norm_num⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩
      (by
        have hmul : (t / qx S) * qx S = t := div_mul_cancel₀ _ (ne_of_gt hx_pos)
        rcases fin3_cases j with rfl | rfl | rfl <;> (simp only [one_mul, zero_mul, add_zero] at *; linarith))
    have he_ext : (1 / 50 : ℚ) < Ev S j + t * (Lv S j + zv S j) / 2 := by
      have hmul : (t / qx S) * qx S = t := div_mul_cancel₀ _ (ne_of_gt hx_pos)
      have hcancel : ∀ a : ℚ, t / qx S * a * qx S = t * a := fun a => by rw [mul_right_comm, hmul]
      rcases fin3_cases j with rfl | rfl | rfl <;>
      · simp only [Ev, one_mul, zero_mul, mul_zero, zero_add, add_zero] at hf hbc ⊢
        rw [hbc, hcancel] at hf; linarith only [hf]
    have hid : (Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + rv S j ^ 2 - zv S j ^ 2) / 8 + t * (Lv S j + zv S j) / 2 =
        ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2 - (sig S k - sig S l) ^ 2 - (zv S j - 2 * t) ^ 2) / 8 := by
      rw [hL_t]; ring
    have hsq : 0 ≤ (zv S j - 2 * t) ^ 2 := sq_nonneg _
    linarith
  · by_cases hty : t ≤ qy S
    · have hy_pos : 0 < qy S := lt_of_lt_of_le ht_pos hty
      have hf := frac_sum_on_block S j 0 (t / qy S) 1 1 1 1
        ⟨le_rfl, by norm_num⟩
        ⟨div_nonneg (le_of_lt ht_pos) (le_of_lt hy_pos), (div_le_one hy_pos).mpr hty⟩
        ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩
        (by
          have hmul : (t / qy S) * qy S = t := div_mul_cancel₀ _ (ne_of_gt hy_pos)
          rcases fin3_cases j with rfl | rfl | rfl <;> (simp only [one_mul, zero_mul, add_zero] at *; linarith))
      have he_ext : (1 / 50 : ℚ) < Ev S j + t * (Lv S j - zv S j) / 2 := by
        have hmul : (t / qy S) * qy S = t := div_mul_cancel₀ _ (ne_of_gt hy_pos)
        have hcancel : ∀ a : ℚ, t / qy S * a * qy S = t * a := fun a => by rw [mul_right_comm, hmul]
        rcases fin3_cases j with rfl | rfl | rfl <;>
        · simp only [Ev, one_mul, zero_mul, zero_add, add_zero] at hf hvw ⊢
          rw [hvw, hcancel] at hf; linarith only [hf]
      have hid : (Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + rv S j ^ 2 - zv S j ^ 2) / 8 + t * (Lv S j - zv S j) / 2 =
          ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2 - (sig S k - sig S l) ^ 2 - (zv S j + 2 * t) ^ 2) / 8 := by
        rw [hL_t]; ring
      have hsq : 0 ≤ (zv S j + 2 * t) ^ 2 := sq_nonneg _
      linarith only [he_ext, hEv, hid, hsq]
    · -- Split-(x, y) case: x < t and y < t and t <= x + y
      have hxt : qx S < t := lt_of_not_ge htx
      have hyt : qy S < t := lt_of_not_ge hty
      have hx_pos : 0 < qx S := by simp only [sv] at ht_le_s; linarith only [hyt, ht_le_s]
      have hy_pos : 0 < qy S := by simp only [sv] at ht_le_s; linarith only [hxt, ht_le_s]
      have hfA := frac_sum_on_block S j 1 ((t - qx S) / qy S) 1 1 1 1
        ⟨by norm_num, le_rfl⟩
        ⟨div_nonneg (by linarith only [hxt]) (le_of_lt hy_pos), (div_le_one hy_pos).mpr (by simp only [sv] at ht_le_s; linarith only [ht_le_s])⟩
        ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩
        (by
          have hmul : ((t - qx S) / qy S) * qy S = t - qx S := div_mul_cancel₀ _ (ne_of_gt hy_pos)
          rcases fin3_cases j with rfl | rfl | rfl <;> (simp only [one_mul] at *; linarith only [hmul, hL_match, ht_def]))
      have hfB := frac_sum_on_block S j ((t - qy S) / qx S) 1 1 1 1 1
        ⟨div_nonneg (by linarith only [hyt]) (le_of_lt hx_pos), (div_le_one hx_pos).mpr (by simp only [sv] at ht_le_s; linarith only [ht_le_s])⟩
        ⟨by norm_num, le_rfl⟩
        ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩
        (by
          have hmul : ((t - qy S) / qx S) * qx S = t - qy S := div_mul_cancel₀ _ (ne_of_gt hx_pos)
          rcases fin3_cases j with rfl | rfl | rfl <;> (simp only [one_mul] at *; linarith only [hmul, hL_match, ht_def]))
      have heA : (1 / 50 : ℚ) < Ev S j + qx S * (Lv S j + zv S j) / 2 + (t - qx S) * ((Lv S j - zv S j) / 2 + qx S) := by
        have hmul : ((t - qx S) / qy S) * qy S = t - qx S := div_mul_cancel₀ _ (ne_of_gt hy_pos)
        have hcancel : ∀ a : ℚ, (t - qx S) / qy S * a * qy S = (t - qx S) * a := fun a => by rw [mul_right_comm, hmul]
        rcases fin3_cases j with rfl | rfl | rfl <;>
        · simp only [Ev, one_mul] at hfA hbc hvw ⊢
          rw [hbc, hvw, hcancel, hcancel] at hfA; linarith only [hfA]
      have heB : (1 / 50 : ℚ) < Ev S j + qy S * (Lv S j - zv S j) / 2 + (t - qy S) * ((Lv S j + zv S j) / 2 + qy S) := by
        have hmul : ((t - qy S) / qx S) * qx S = t - qy S := div_mul_cancel₀ _ (ne_of_gt hx_pos)
        have hcancel : ∀ a : ℚ, (t - qy S) / qx S * a * qx S = (t - qy S) * a := fun a => by rw [mul_right_comm, hmul]
        have hxy : (t - qy S) / qx S * qx S * qy S = (t - qy S) * qy S := by rw [hmul]
        rcases fin3_cases j with rfl | rfl | rfl <;>
        · simp only [Ev, one_mul, mul_one] at hfB hbc hvw ⊢
          rw [hbc, hvw, hxy, hcancel] at hfB; linarith only [hfB]
      let u := qx S - qy S
      have hid : ((Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + rv S j ^ 2 - zv S j ^ 2) / 8 +
            qx S * (Lv S j + zv S j) / 2 + (t - qx S) * ((Lv S j - zv S j) / 2 + qx S) +
          ((Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + rv S j ^ 2 - zv S j ^ 2) / 8 +
            qy S * (Lv S j - zv S j) / 2 + (t - qy S) * ((Lv S j + zv S j) / 2 + qy S))) / 2 =
          ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2 - (sig S k - sig S l) ^ 2) / 8 +
            (u ^ 2 - (2 * t - sv S) ^ 2) / 8 - (sv S ^ 2 + 2 * u * dv S j + dv S j ^ 2) / 8 := by
        have hqx : qx S = (sv S + u) / 2 := by simp only [sv, u]; ring
        have hqy : qy S = (sv S - u) / 2 := by simp only [sv, u]; ring
        have hzv : zv S j = u - dv S j := rfl
        rw [hL_t, hzv, hqx, hqy]; ring
      have hu_lt : u ^ 2 ≤ (2 * t - sv S) ^ 2 := by
        have h1 : -(2 * t - sv S) < u := by simp only [u, sv]; linarith only [hyt]
        have h2 : u < 2 * t - sv S := by simp only [u, sv]; linarith only [hxt]
        nlinarith only [h1, h2]
      have hquad_nn : 0 ≤ sv S ^ 2 + 2 * u * dv S j + dv S j ^ 2 := by
        have hu_le_s : -sv S ≤ u ∧ u ≤ sv S := by simp only [u, sv]; constructor <;> linarith only [hx_pos, hy_pos]
        have hd := dv_abs_lt S j
        have heps := eps_pos S j
        have hr := rv_pos S j
        have hd_le_s : -sv S ≤ dv S j ∧ dv S j ≤ sv S := by simp only [rv] at hr; constructor <;> linarith only [hd, heps, hr]
        have hsu : 0 ≤ (sv S - u) * (sv S + u) := mul_nonneg (by linarith only [hu_le_s.2]) (by linarith only [hu_le_s.1])
        have hid2 : sv S ^ 2 + 2 * u * dv S j + dv S j ^ 2 = (u + dv S j) ^ 2 + (sv S - u) * (sv S + u) := by ring
        linarith only [hid2, sq_nonneg (u + dv S j), hsu]
      linarith only [heA, heB, hEv, hid, hu_lt, hquad_nn]

/-- Sharp Boundary-2 bound when `y = 0` (retaining `-(z_j - 2*t_j)^2 / 8` for Grotzsch!). -/
lemma boundary2_exact_y_zero (hdy : dy = true) (j k l : Fin 3) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l)
    (hB2 : Wv S j + Lv S j < 1 / 2) (hReach : 1 / 2 ≤ Wv S j + Lv S j + sv S) :
    (1 / 50 : ℚ) < ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2 - (sig S k - sig S l) ^ 2 - (zv S j - 2 * (1 / 2 - Wv S j - Lv S j)) ^ 2) / 8 := by
  have hy0 : qy S = 0 := S.hw_zero (.inr 1) (by simp [vegaActive, hdy])
  set t := 1 / 2 - Wv S j - Lv S j with ht_def
  have ht_pos : 0 < t := by linarith
  have htx : t ≤ qx S := by simp only [sv, hy0] at hReach; linarith
  have hx_pos : 0 < qx S := lt_of_lt_of_le ht_pos htx
  have hL_t : Lv S j = 1 / 3 + rv S j - 2 * t := by have := Lv_eq S j; linarith
  have hEv := Ev_le S j k l hjk hjl hkl
  have hbc : (match j with | 0 => qb S + qc S | 1 => qa S + qc S | 2 => qa S + qb S) = (Lv S j + zv S j) / 2 := by
    rcases fin3_cases j with rfl | rfl | rfl <;> simp only [Lv, zv, dv, del, Tv, Stot, sig, av, uv, WA, WB, qx, qy, qa, qb, qc, qu, qv, qw] <;> ring
  have hL_match : (match j with | 0 => qb S + qc S + qv S + qw S | 1 => qa S + qc S + qu S + qw S | 2 => qa S + qb S + qu S + qv S) = Lv S j := by
    rcases fin3_cases j with rfl | rfl | rfl <;> simp [Lv, sig, av, uv, Stot] <;> ring
  have hf := frac_sum_on_block S j (t / qx S) 0 1 1 1 1
    ⟨div_nonneg (le_of_lt ht_pos) (le_of_lt hx_pos), (div_le_one hx_pos).mpr htx⟩
    ⟨le_rfl, by norm_num⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩ ⟨by norm_num, le_rfl⟩
    (by
      have hmul : (t / qx S) * qx S = t := div_mul_cancel₀ _ (ne_of_gt hx_pos)
      rcases fin3_cases j with rfl | rfl | rfl <;> (simp only [one_mul, zero_mul, add_zero] at *; linarith))
  have he_ext : (1 / 50 : ℚ) < Ev S j + t * (Lv S j + zv S j) / 2 := by
    have hmul : (t / qx S) * qx S = t := div_mul_cancel₀ _ (ne_of_gt hx_pos)
    have hcancel : ∀ a : ℚ, t / qx S * a * qx S = t * a := fun a => by rw [mul_right_comm, hmul]
    rcases fin3_cases j with rfl | rfl | rfl <;>
    · simp only [Ev, one_mul, zero_mul, mul_zero, zero_add, add_zero] at hf hbc ⊢
      rw [hbc, hcancel] at hf; linarith only [hf]
  have hid : (Lv S j ^ 2 - (sig S k - sig S l) ^ 2 + rv S j ^ 2 - zv S j ^ 2) / 8 + t * (Lv S j + zv S j) / 2 =
      ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2 - (sig S k - sig S l) ^ 2 - (zv S j - 2 * t) ^ 2) / 8 := by
    rw [hL_t]; ring
  linarith

/-- Universal Boundary-2 Threshold (J1.4): `r_j <= 11/180` refutes any reachable Boundary-2 index! -/
lemma boundary2_contra_of_r_le (j : Fin 3)
    (hB2 : Wv S j + Lv S j < 1 / 2) (hReach : 1 / 2 ≤ Wv S j + Lv S j + sv S)
    (hr : rv S j ≤ 11 / 180) : False := by
  have hr_pos := rv_pos S j
  have hgt : (1 / 50 : ℚ) < ((1 / 3 + rv S j) ^ 2 + rv S j ^ 2) / 8 := by
    rcases fin3_cases j with rfl | rfl | rfl
    · have := boundary2_exact_gt S 0 1 2 (by decide) (by decide) (by decide) hB2 hReach
      have hsq : 0 ≤ (sig S 1 - sig S 2) ^ 2 := sq_nonneg _; linarith
    · have := boundary2_exact_gt S 1 0 2 (by decide) (by decide) (by decide) hB2 hReach
      have hsq : 0 ≤ (sig S 0 - sig S 2) ^ 2 := sq_nonneg _; linarith
    · have := boundary2_exact_gt S 2 0 1 (by decide) (by decide) (by decide) hB2 hReach
      have hsq : 0 ≤ (sig S 0 - sig S 1) ^ 2 := sq_nonneg _; linarith
  nlinarith

/-- Family P_2 (J1.5): Whenever `W_A + W_j <= 1/2` and `W_B + W_j <= 1/2` for all `j`, `H_2 > 0`. -/
lemma H2_pos_of_no_boundary1
    (hA : ∀ j : Fin 3, WA S + Wv S j ≤ 1 / 2)
    (hB : ∀ j : Fin 3, WB S + Wv S j ≤ 1 / 2) :
    (2 / 25 : ℚ) * WG S <
      WG S * (sig S 0 * W1 S + sig S 1 * W2 S + sig S 2 * W3 S) -
      Tv S * ((Tv S + dv S 0) * W1 S + (Tv S + dv S 1) * W2 S + (Tv S + dv S 2) * W3 S) +
      4 * W1 S * W2 S * W3 S := by
  let A0 : Finset (VegaV i) := {.inr 0, .inr 5, .inr 6, .inr 7}
  let B0 : Finset (VegaV i) := {.inr 1, .inr 2, .inr 3, .inr 4}
  let e_dir : Fin 3 → Fin 3 → ℚ := fun j k =>
    ∑ p ∈ Ij i j, ∑ q ∈ Ij i k, if vegaAdj i p q then S.w p * S.w q else 0
  have he_sym : ∀ j k : Fin 3, e_dir j k = e_dir k j := by
    intro j k; simp only [e_dir]; rw [Finset.sum_comm]
    apply Finset.sum_congr rfl; intro p _; apply Finset.sum_congr rfl; intro q _
    have hsym : vegaAdj i q p ↔ vegaAdj i p q := ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
    by_cases h : vegaAdj i p q <;> simp [hsym, h, mul_comm]
  have hW_pos : ∀ j : Fin 3, 0 < Wv S j := by
    intro j; have := Wv_gt_s S j
    have hs_nn : 0 ≤ sv S := add_nonneg (S.hw_nonneg (.inr 0)) (S.hw_nonneg (.inr 1))
    linarith
  have hIj_disj : ∀ j k : Fin 3, j ≠ k → Disjoint (Ij i j) (Ij i k) := by
    intro j k hjk; rw [Finset.disjoint_left]; intro z hz1 hz2
    rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
    all_goals (cases z with
      | inr _ => simp [Ij] at hz1
      | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hz1 hz2; omega)
  have hA0_disj : ∀ j : Fin 3, Disjoint A0 (Ij i j) := by
    intro j; rw [Finset.disjoint_left]; intro z hzA hzI
    simp only [A0, Finset.mem_insert, Finset.mem_singleton] at hzA
    rcases fin3_cases j with rfl | rfl | rfl <;> (rcases hzA with rfl | rfl | rfl | rfl <;> simp [Ij] at hzI)
  have hB0_disj : ∀ j : Fin 3, Disjoint B0 (Ij i j) := by
    intro j; rw [Finset.disjoint_left]; intro z hzB hzI
    simp only [B0, Finset.mem_insert, Finset.mem_singleton] at hzB
    rcases fin3_cases j with rfl | rfl | rfl <;> (rcases hzB with rfl | rfl | rfl | rfl <;> simp [Ij] at hzI)
  -- Apply havg for each ordered pair (j, k) with j ≠ k, on both A0 ∪ I_j and B0 ∪ I_j!
  have hpair_A : ∀ j k : Fin 3, j ≠ k →
      (1 / 50 : ℚ) * Wv S k < Wv S k * (uv S j * Wv S j) + (1 / 2 - WA S - Wv S j) * (uv S k * Wv S k + e_dir j k) := by
    intro j k hjk
    have hdisj : Disjoint (A0 ∪ Ij i j) (Ij i k) := Finset.disjoint_union_left.mpr ⟨hA0_disj k, hIj_disj j k hjk⟩
    have hsum_A0Ij : ∑ z ∈ A0 ∪ Ij i j, S.w z = WA S + Wv S j := by
      rw [Finset.sum_union (hA0_disj j)]; simp only [A0, WA, Wv, qx, qu, qv, qw]; simp; ring
    have hAB_ge : 1 / 2 ≤ ∑ z ∈ A0 ∪ Ij i j, S.w z + ∑ z ∈ Ij i k, S.w z := by
      rw [hsum_A0Ij]; change 1 / 2 ≤ WA S + Wv S j + Wv S k
      have htot := sum_all_eq S
      have hBl : WB S + (WG S - Wv S j - Wv S k) ≤ 1 / 2 := by
        rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
        · have := hB 2; simp only [WG, W1, W2, W3] at *; linarith
        · have := hB 1; simp only [WG, W1, W2, W3] at *; linarith
        · have := hB 2; simp only [WG, W1, W2, W3] at *; linarith
        · have := hB 0; simp only [WG, W1, W2, W3] at *; linarith
        · have := hB 1; simp only [WG, W1, W2, W3] at *; linarith
        · have := hB 0; simp only [WG, W1, W2, W3] at *; linarith
      linarith
    have havg1 := S.havg (A0 ∪ Ij i j) (Ij i k) hdisj (indep_Ij S.hi k) (hW_pos k)
      (hsum_A0Ij ▸ hA j) hAB_ge
    rw [hsum_A0Ij] at havg1
    have hA0_Ij : ∀ m : Fin 3, ∑ u ∈ A0, ∑ v ∈ Ij i m, (if vegaAdj i u v then S.w u * S.w v else 0) = uv S m * Wv S m := by
      intro m
      have hA0_sum : ∑ u ∈ A0, ∑ v ∈ Ij i m, (if vegaAdj i u v then S.w u * S.w v else 0) =
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 0) v then S.w (.inr 0) * S.w v else 0) +
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 5) v then S.w (.inr 5) * S.w v else 0) +
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 6) v then S.w (.inr 6) * S.w v else 0) +
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 7) v then S.w (.inr 7) * S.w v else 0) := by
        simp [A0]; ring
      rw [hA0_sum]
      have hterm : ∀ r : Fin 8, (r = 0 ∨ r = 5 ∨ r = 6 ∨ r = 7) → ∀ m : Fin 3,
          ∑ v ∈ Ij i m, (if vegaAdj i (.inr r) v then S.w (.inr r) * S.w v else 0) =
          if (r = 5 ∧ m = 0) ∨ (r = 6 ∧ m = 1) ∨ (r = 7 ∧ m = 2) then S.w (.inr r) * Wv S m else 0 := by
        intro r hr m'
        rcases hr with rfl | rfl | rfl | rfl <;>
        rcases fin3_cases m' with rfl | rfl | rfl <;>
        (simp only [Wv];
         first
         | (rw [if_pos (by decide), Finset.mul_sum]; apply Finset.sum_congr rfl; intro z hz
            cases z with
            | inr _ => simp [Ij] at hz
            | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hz; simp [vegaAdj, hz])
         | (rw [if_neg (by decide)]; apply Finset.sum_eq_zero; intro z hz
            cases z with
            | inr _ => simp [Ij] at hz
            | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hz; simp [vegaAdj]; try omega))
      rw [hterm 0 (by decide) m, hterm 5 (by decide) m, hterm 6 (by decide) m, hterm 7 (by decide) m]
      rcases fin3_cases m with rfl | rfl | rfl <;> simp [uv, qu, qv, qw]
    have hAA : ∑ u ∈ A0 ∪ Ij i j, ∑ v ∈ A0 ∪ Ij i j, (if vegaAdj i u v then S.w u * S.w v else 0) =
        2 * (uv S j * Wv S j) := by
      rw [Finset.sum_union (hA0_disj j)]
      simp_rw [Finset.sum_union (hA0_disj j), Finset.sum_add_distrib]
      have h00 : ∑ u ∈ A0, ∑ v ∈ A0, (if vegaAdj i u v then S.w u * S.w v else 0) = 0 := by
        apply Finset.sum_eq_zero; intro u hu; apply Finset.sum_eq_zero; intro v hv
        simp only [A0, Finset.mem_insert, Finset.mem_singleton] at hu hv
        rcases hu with rfl | rfl | rfl | rfl <;> rcases hv with rfl | rfl | rfl | rfl <;> simp [vegaAdj]
      have h11 : ∑ u ∈ Ij i j, ∑ v ∈ Ij i j, (if vegaAdj i u v then S.w u * S.w v else 0) = 0 := by
        apply Finset.sum_eq_zero; intro u hu; apply Finset.sum_eq_zero; intro v hv
        simp [indep_Ij S.hi j u hu v hv]
      have h10 : ∑ u ∈ Ij i j, ∑ v ∈ A0, (if vegaAdj i u v then S.w u * S.w v else 0) = uv S j * Wv S j := by
        rw [Finset.sum_comm, ← hA0_Ij j]
        apply Finset.sum_congr rfl; intro u _; apply Finset.sum_congr rfl; intro v _
        have hsym : vegaAdj i v u ↔ vegaAdj i u v := ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
        by_cases h : vegaAdj i u v <;> simp [hsym, h, mul_comm]
      rw [h00, h11, h10, hA0_Ij j]; ring
    have hAB : ∑ u ∈ A0 ∪ Ij i j, ∑ v ∈ Ij i k, (if vegaAdj i u v then S.w u * S.w v else 0) =
        uv S k * Wv S k + e_dir j k := by
      rw [Finset.sum_union (hA0_disj j), hA0_Ij k]
    rw [hAA, hAB] at havg1; change (1 / 25 : ℚ) * Wv S k < Wv S k * (2 * (uv S j * Wv S j)) + 2 * (1 / 2 - (WA S + Wv S j)) * (uv S k * Wv S k + e_dir j k) at havg1; linarith
  have hpair_B : ∀ j k : Fin 3, j ≠ k →
      (1 / 50 : ℚ) * Wv S k < Wv S k * (av S j * Wv S j) + (1 / 2 - WB S - Wv S j) * (av S k * Wv S k + e_dir j k) := by
    intro j k hjk
    have hdisj : Disjoint (B0 ∪ Ij i j) (Ij i k) := Finset.disjoint_union_left.mpr ⟨hB0_disj k, hIj_disj j k hjk⟩
    have hsum_B0Ij : ∑ z ∈ B0 ∪ Ij i j, S.w z = WB S + Wv S j := by
      rw [Finset.sum_union (hB0_disj j)]; simp only [B0, WB, Wv, qy, qa, qb, qc]; simp; ring
    have hAB_ge : 1 / 2 ≤ ∑ z ∈ B0 ∪ Ij i j, S.w z + ∑ z ∈ Ij i k, S.w z := by
      rw [hsum_B0Ij]; change 1 / 2 ≤ WB S + Wv S j + Wv S k
      have htot := sum_all_eq S
      have hAl : WA S + (WG S - Wv S j - Wv S k) ≤ 1 / 2 := by
        rcases fin3_cases j with rfl | rfl | rfl <;> rcases fin3_cases k with rfl | rfl | rfl <;> try exact absurd rfl hjk
        · have := hA 2; simp only [WG, W1, W2, W3] at *; linarith
        · have := hA 1; simp only [WG, W1, W2, W3] at *; linarith
        · have := hA 2; simp only [WG, W1, W2, W3] at *; linarith
        · have := hA 0; simp only [WG, W1, W2, W3] at *; linarith
        · have := hA 1; simp only [WG, W1, W2, W3] at *; linarith
        · have := hA 0; simp only [WG, W1, W2, W3] at *; linarith
      linarith
    have havg1 := S.havg (B0 ∪ Ij i j) (Ij i k) hdisj (indep_Ij S.hi k) (hW_pos k)
      (hsum_B0Ij ▸ hB j) hAB_ge
    rw [hsum_B0Ij] at havg1
    have hB0_Ij : ∀ m : Fin 3, ∑ u ∈ B0, ∑ v ∈ Ij i m, (if vegaAdj i u v then S.w u * S.w v else 0) = av S m * Wv S m := by
      intro m
      have hB0_sum : ∑ u ∈ B0, ∑ v ∈ Ij i m, (if vegaAdj i u v then S.w u * S.w v else 0) =
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 1) v then S.w (.inr 1) * S.w v else 0) +
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 2) v then S.w (.inr 2) * S.w v else 0) +
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 3) v then S.w (.inr 3) * S.w v else 0) +
          (∑ v ∈ Ij i m, if vegaAdj i (.inr 4) v then S.w (.inr 4) * S.w v else 0) := by
        simp [B0]; ring
      rw [hB0_sum]
      have hterm : ∀ r : Fin 8, (r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4) → ∀ m : Fin 3,
          ∑ v ∈ Ij i m, (if vegaAdj i (.inr r) v then S.w (.inr r) * S.w v else 0) =
          if (r = 2 ∧ m = 0) ∨ (r = 3 ∧ m = 1) ∨ (r = 4 ∧ m = 2) then S.w (.inr r) * Wv S m else 0 := by
        intro r hr m'
        rcases hr with rfl | rfl | rfl | rfl <;>
        rcases fin3_cases m' with rfl | rfl | rfl <;>
        (simp only [Wv];
         first
         | (rw [if_pos (by decide), Finset.mul_sum]; apply Finset.sum_congr rfl; intro z hz
            cases z with
            | inr _ => simp [Ij] at hz
            | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hz; simp [vegaAdj, hz])
         | (rw [if_neg (by decide)]; apply Finset.sum_eq_zero; intro z hz
            cases z with
            | inr _ => simp [Ij] at hz
            | inl p => simp only [Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl] at hz; simp [vegaAdj]; try omega))
      rw [hterm 1 (by decide) m, hterm 2 (by decide) m, hterm 3 (by decide) m, hterm 4 (by decide) m]
      rcases fin3_cases m with rfl | rfl | rfl <;> simp [av, qa, qb, qc]
    have hBB : ∑ u ∈ B0 ∪ Ij i j, ∑ v ∈ B0 ∪ Ij i j, (if vegaAdj i u v then S.w u * S.w v else 0) =
        2 * (av S j * Wv S j) := by
      rw [Finset.sum_union (hB0_disj j)]
      simp_rw [Finset.sum_union (hB0_disj j), Finset.sum_add_distrib]
      have h00 : ∑ u ∈ B0, ∑ v ∈ B0, (if vegaAdj i u v then S.w u * S.w v else 0) = 0 := by
        apply Finset.sum_eq_zero; intro u hu; apply Finset.sum_eq_zero; intro v hv
        simp only [B0, Finset.mem_insert, Finset.mem_singleton] at hu hv
        rcases hu with rfl | rfl | rfl | rfl <;> rcases hv with rfl | rfl | rfl | rfl <;> simp [vegaAdj]
      have h11 : ∑ u ∈ Ij i j, ∑ v ∈ Ij i j, (if vegaAdj i u v then S.w u * S.w v else 0) = 0 := by
        apply Finset.sum_eq_zero; intro u hu; apply Finset.sum_eq_zero; intro v hv
        simp [indep_Ij S.hi j u hu v hv]
      have h10 : ∑ u ∈ Ij i j, ∑ v ∈ B0, (if vegaAdj i u v then S.w u * S.w v else 0) = av S j * Wv S j := by
        rw [Finset.sum_comm, ← hB0_Ij j]
        apply Finset.sum_congr rfl; intro u _; apply Finset.sum_congr rfl; intro v _
        have hsym : vegaAdj i v u ↔ vegaAdj i u v := ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
        by_cases h : vegaAdj i u v <;> simp [hsym, h, mul_comm]
      rw [h00, h11, h10, hB0_Ij j]; ring
    have hBA : ∑ u ∈ B0 ∪ Ij i j, ∑ v ∈ Ij i k, (if vegaAdj i u v then S.w u * S.w v else 0) =
        av S k * Wv S k + e_dir j k := by
      rw [Finset.sum_union (hB0_disj j), hB0_Ij k]
    rw [hBB, hBA] at havg1; change (1 / 25 : ℚ) * Wv S k < Wv S k * (2 * (av S j * Wv S j)) + 2 * (1 / 2 - (WB S + Wv S j)) * (av S k * Wv S k + e_dir j k) at havg1; linarith
  -- Triangle-freeness of Gamma: W3*e_{12} + W1*e_{23} + W2*e_{31} <= 2*W1*W2*W3
  have htri : W3 S * e_dir 0 1 + W1 S * e_dir 1 2 + W2 S * e_dir 2 0 ≤ 2 * W1 S * W2 S * W3 S := by
    have hsum_le : ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2,
        ((if vegaAdj i p q then (1 : ℚ) else 0) + (if vegaAdj i q r then 1 else 0) + (if vegaAdj i r p then 1 else 0)) *
        (S.w p * S.w q * S.w r) ≤
        ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2, 2 * (S.w p * S.w q * S.w r) := by
      apply Finset.sum_le_sum; intro p hp
      apply Finset.sum_le_sum; intro q hq
      apply Finset.sum_le_sum; intro r hr
      have hnn : 0 ≤ S.w p * S.w q * S.w r := mul_nonneg (mul_nonneg (S.hw_nonneg p) (S.hw_nonneg q)) (S.hw_nonneg r)
      have hle2 : (if vegaAdj i p q then (1 : ℚ) else 0) + (if vegaAdj i q r then 1 else 0) + (if vegaAdj i r p then 1 else 0) ≤ 2 := by
        split_ifs with h1 h2 h3
        · exfalso
          cases p with | inr _ => simp [Ij] at hp | inl p =>
          cases q with | inr _ => simp [Ij] at hq | inl q =>
          cases r with | inr _ => simp [Ij] at hr | inl r =>
          exact vegaAdj_gamma_triangleFree S.hi h1 h2 h3
        all_goals norm_num
      exact mul_le_mul_of_nonneg_right hle2 hnn
    have hrhs : ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2, 2 * (S.w p * S.w q * S.w r) = 2 * W1 S * W2 S * W3 S := by
      simp only [W1, W2, W3, Wv, ← Finset.mul_sum, ← Finset.sum_mul]; ring
    have hlhs : ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2,
        ((if vegaAdj i p q then (1 : ℚ) else 0) + (if vegaAdj i q r then 1 else 0) + (if vegaAdj i r p then 1 else 0)) *
        (S.w p * S.w q * S.w r) = W3 S * e_dir 0 1 + W1 S * e_dir 1 2 + W2 S * e_dir 2 0 := by
      have hsplit : ∀ p q r : VegaV i,
          ((if vegaAdj i p q then (1 : ℚ) else 0) + (if vegaAdj i q r then 1 else 0) + (if vegaAdj i r p then 1 else 0)) *
          (S.w p * S.w q * S.w r) =
          (if vegaAdj i p q then S.w p * S.w q else 0) * S.w r +
          S.w p * (if vegaAdj i q r then S.w q * S.w r else 0) +
          (if vegaAdj i r p then S.w r * S.w p else 0) * S.w q := by
        intro p q r; split_ifs <;> ring
      simp_rw [hsplit, Finset.sum_add_distrib]
      have h1 : ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2, (if vegaAdj i p q then S.w p * S.w q else 0) * S.w r =
          W3 S * e_dir 0 1 := by
        simp only [W3, Wv, e_dir, ← Finset.mul_sum, ← Finset.sum_mul]; ring
      have h2 : ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2, S.w p * (if vegaAdj i q r then S.w q * S.w r else 0) =
          W1 S * e_dir 1 2 := by
        simp only [W1, Wv, e_dir, ← Finset.mul_sum, ← Finset.sum_mul]
      have h3 : ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2, (if vegaAdj i r p then S.w r * S.w p else 0) * S.w q =
          W2 S * e_dir 2 0 := by
        calc ∑ p ∈ Ij i 0, ∑ q ∈ Ij i 1, ∑ r ∈ Ij i 2, (if vegaAdj i r p then S.w r * S.w p else 0) * S.w q
            = ∑ p ∈ Ij i 0, ∑ r ∈ Ij i 2, ∑ q ∈ Ij i 1, (if vegaAdj i r p then S.w r * S.w p else 0) * S.w q := by
                apply Finset.sum_congr rfl; intro p _; rw [Finset.sum_comm]
          _ = ∑ r ∈ Ij i 2, ∑ p ∈ Ij i 0, (if vegaAdj i r p then S.w r * S.w p else 0) * W2 S := by
                rw [Finset.sum_comm]; apply Finset.sum_congr rfl; intro r _
                apply Finset.sum_congr rfl; intro p _; rw [← Finset.mul_sum]; rfl
          _ = W2 S * e_dir 2 0 := by simp only [e_dir, ← Finset.sum_mul]; ring
      rw [h1, h2, h3]
    linarith
  have hA01 := hpair_A 0 1 (by decide); have hA10 := hpair_A 1 0 (by decide)
  have hA12 := hpair_A 1 2 (by decide); have hA21 := hpair_A 2 1 (by decide)
  have hA20 := hpair_A 2 0 (by decide); have hA02 := hpair_A 0 2 (by decide)
  have hB01 := hpair_B 0 1 (by decide); have hB10 := hpair_B 1 0 (by decide)
  have hB12 := hpair_B 1 2 (by decide); have hB21 := hpair_B 2 1 (by decide)
  have hB20 := hpair_B 2 0 (by decide); have hB02 := hpair_B 0 2 (by decide)
  rw [he_sym 1 0] at hA10 hB10
  rw [he_sym 2 1] at hA21 hB21
  rw [he_sym 0 2] at hA02 hB02
  have htot := sum_all_eq S
  have h1mA : 1 - 2 * WA S = WG S + Tv S := by simp only [Tv]; linarith
  have h1mB : 1 - 2 * WB S = WG S - Tv S := by simp only [Tv]; linarith
  have hsum12 : (4 / 50 : ℚ) * WG S <
      (WG S + Tv S) * (uv S 0 * W1 S + uv S 1 * W2 S + uv S 2 * W3 S) +
      (WG S - Tv S) * (av S 0 * W1 S + av S 1 * W2 S + av S 2 * W3 S) +
      2 * (W3 S * e_dir 0 1 + W1 S * e_dir 1 2 + W2 S * e_dir 2 0) := by
    simp only [WG, W1, W2, W3] at *
    have hcomb : (1 / 50 : ℚ) * (2 * Wv S 0 + 2 * Wv S 1 + 2 * Wv S 2) +
        (1 / 50 : ℚ) * (2 * Wv S 0 + 2 * Wv S 1 + 2 * Wv S 2) <
        (Wv S 1 * (uv S 0 * Wv S 0) + (1 / 2 - WA S - Wv S 0) * (uv S 1 * Wv S 1 + e_dir 0 1)) +
        (Wv S 0 * (uv S 1 * Wv S 1) + (1 / 2 - WA S - Wv S 1) * (uv S 0 * Wv S 0 + e_dir 0 1)) +
        (Wv S 2 * (uv S 1 * Wv S 1) + (1 / 2 - WA S - Wv S 1) * (uv S 2 * Wv S 2 + e_dir 1 2)) +
        (Wv S 1 * (uv S 2 * Wv S 2) + (1 / 2 - WA S - Wv S 2) * (uv S 1 * Wv S 1 + e_dir 1 2)) +
        (Wv S 0 * (uv S 2 * Wv S 2) + (1 / 2 - WA S - Wv S 2) * (uv S 0 * Wv S 0 + e_dir 2 0)) +
        (Wv S 2 * (uv S 0 * Wv S 0) + (1 / 2 - WA S - Wv S 0) * (uv S 2 * Wv S 2 + e_dir 2 0)) +
        ((Wv S 1 * (av S 0 * Wv S 0) + (1 / 2 - WB S - Wv S 0) * (av S 1 * Wv S 1 + e_dir 0 1)) +
        (Wv S 0 * (av S 1 * Wv S 1) + (1 / 2 - WB S - Wv S 1) * (av S 0 * Wv S 0 + e_dir 0 1)) +
        (Wv S 2 * (av S 1 * Wv S 1) + (1 / 2 - WB S - Wv S 1) * (av S 2 * Wv S 2 + e_dir 1 2)) +
        (Wv S 1 * (av S 2 * Wv S 2) + (1 / 2 - WB S - Wv S 2) * (av S 1 * Wv S 1 + e_dir 1 2)) +
        (Wv S 0 * (av S 2 * Wv S 2) + (1 / 2 - WB S - Wv S 2) * (av S 0 * Wv S 0 + e_dir 2 0)) +
        (Wv S 2 * (av S 0 * Wv S 0) + (1 / 2 - WB S - Wv S 0) * (av S 2 * Wv S 2 + e_dir 2 0))) := by
      linarith
    have hid_sum :
        (Wv S 1 * (uv S 0 * Wv S 0) + (1 / 2 - WA S - Wv S 0) * (uv S 1 * Wv S 1 + e_dir 0 1)) +
        (Wv S 0 * (uv S 1 * Wv S 1) + (1 / 2 - WA S - Wv S 1) * (uv S 0 * Wv S 0 + e_dir 0 1)) +
        (Wv S 2 * (uv S 1 * Wv S 1) + (1 / 2 - WA S - Wv S 1) * (uv S 2 * Wv S 2 + e_dir 1 2)) +
        (Wv S 1 * (uv S 2 * Wv S 2) + (1 / 2 - WA S - Wv S 2) * (uv S 1 * Wv S 1 + e_dir 1 2)) +
        (Wv S 0 * (uv S 2 * Wv S 2) + (1 / 2 - WA S - Wv S 2) * (uv S 0 * Wv S 0 + e_dir 2 0)) +
        (Wv S 2 * (uv S 0 * Wv S 0) + (1 / 2 - WA S - Wv S 0) * (uv S 2 * Wv S 2 + e_dir 2 0)) +
        ((Wv S 1 * (av S 0 * Wv S 0) + (1 / 2 - WB S - Wv S 0) * (av S 1 * Wv S 1 + e_dir 0 1)) +
        (Wv S 0 * (av S 1 * Wv S 1) + (1 / 2 - WB S - Wv S 1) * (av S 0 * Wv S 0 + e_dir 0 1)) +
        (Wv S 2 * (av S 1 * Wv S 1) + (1 / 2 - WB S - Wv S 1) * (av S 2 * Wv S 2 + e_dir 1 2)) +
        (Wv S 1 * (av S 2 * Wv S 2) + (1 / 2 - WB S - Wv S 2) * (av S 1 * Wv S 1 + e_dir 1 2)) +
        (Wv S 0 * (av S 2 * Wv S 2) + (1 / 2 - WB S - Wv S 2) * (av S 0 * Wv S 0 + e_dir 2 0)) +
        (Wv S 2 * (av S 0 * Wv S 0) + (1 / 2 - WB S - Wv S 0) * (av S 2 * Wv S 2 + e_dir 2 0))) =
        (1 - 2 * WA S) * (uv S 0 * Wv S 0 + uv S 1 * Wv S 1 + uv S 2 * Wv S 2) +
        (1 - 2 * WB S) * (av S 0 * Wv S 0 + av S 1 * Wv S 1 + av S 2 * Wv S 2) +
        2 * ((1 - WA S - WB S - Wv S 0 - Wv S 1) * e_dir 0 1 +
             (1 - WA S - WB S - Wv S 1 - Wv S 2) * e_dir 1 2 +
             (1 - WA S - WB S - Wv S 2 - Wv S 0) * e_dir 2 0) := by ring
    rw [hid_sum, h1mA, h1mB] at hcomb
    have he1 : 1 - WA S - WB S - Wv S 0 - Wv S 1 = Wv S 2 := by linarith
    have he2 : 1 - WA S - WB S - Wv S 1 - Wv S 2 = Wv S 0 := by linarith
    have he3 : 1 - WA S - WB S - Wv S 2 - Wv S 0 = Wv S 1 := by linarith
    rw [he1, he2, he3] at hcomb
    linarith
  have hrewrite :
      (WG S + Tv S) * (uv S 0 * W1 S + uv S 1 * W2 S + uv S 2 * W3 S) +
      (WG S - Tv S) * (av S 0 * W1 S + av S 1 * W2 S + av S 2 * W3 S) =
      WG S * (sig S 0 * W1 S + sig S 1 * W2 S + sig S 2 * W3 S) -
      Tv S * ((Tv S + dv S 0) * W1 S + (Tv S + dv S 1) * W2 S + (Tv S + dv S 2) * W3 S) := by
    simp only [sig, dv, del]; ring
  linarith

/- ### Stage 2: Universal 3-Line Refutation of Boundary 1 (ALL `i >= 2`) -/

/-- Helper: given `W_j + L_j >= 1/2` and `3/25 <= W_j`, `P_{1,j} <= 55081/3000000 < 1/50`, contradiction! -/
lemma contra_of_interior_and_W_ge (j : Fin 3)
    (hInt : 1 / 2 ≤ Wv S j + Lv S j) (hW : 3 / 25 ≤ Wv S j) : False := by
  have hH1 := H1_pos_of_interior S j hInt
  have hEv : Ev S j ≤ (Lv S j ^ 2 + rv S j ^ 2) / 8 := by
    rcases fin3_cases j with rfl | rfl | rfl
    · have := Ev_le S 0 1 2 (by decide) (by decide) (by decide)
      have h1 : 0 ≤ (sig S 1 - sig S 2) ^ 2 := sq_nonneg _; have h2 : 0 ≤ zv S 0 ^ 2 := sq_nonneg _; linarith
    · have := Ev_le S 1 0 2 (by decide) (by decide) (by decide)
      have h1 : 0 ≤ (sig S 0 - sig S 2) ^ 2 := sq_nonneg _; have h2 : 0 ≤ zv S 1 ^ 2 := sq_nonneg _; linarith
    · have := Ev_le S 2 0 1 (by decide) (by decide) (by decide)
      have h1 : 0 ≤ (sig S 0 - sig S 1) ^ 2 := sq_nonneg _; have h2 : 0 ≤ zv S 2 ^ 2 := sq_nonneg _; linarith
  have hLj := Lv_eq S j
  have hr_pos := rv_pos S j
  have hr_le : rv S j ≤ 7 / 150 := by linarith
  have hL_ge : 1 / 3 ≤ Lv S j := by linarith
  have hL_le : Lv S j ≤ 32 / 75 - rv S j := by linarith
  have h1 : (1 / 50 : ℚ) * Lv S j < (1 / 3 + rv S j) * ((Lv S j ^ 2 + rv S j ^ 2) / 8) := by
    have hpos : 0 < 1 / 3 + rv S j := by linarith
    nlinarith
  -- Divide by L_j >= 1/3: 1/50 < (1/3 + r) * (L + r^2 / L) / 8 <= (1/3 + r) * (32/75 - r + 3*r^2) / 8
  have h2 : (1 / 50 : ℚ) * Lv S j < (1 / 3 + rv S j) * ((32 / 75 - rv S j + 3 * rv S j ^ 2) / 8) * Lv S j := by
    have hr2_bound : rv S j ^ 2 ≤ 3 * rv S j ^ 2 * Lv S j := by nlinarith [sq_nonneg (rv S j)]
    have hL2_bound : Lv S j ^ 2 ≤ (32 / 75 - rv S j) * Lv S j := by nlinarith
    have hpos : 0 < 1 / 3 + rv S j := by linarith
    nlinarith
  have h3 : (1 / 50 : ℚ) < (1 / 3 + rv S j) * (32 / 75 - rv S j + 3 * rv S j ^ 2) / 8 := by nlinarith
  -- Exact polynomial identity: (1/3 + r)*(32/75 - r + 3*r^2) = 32/225 + (7/75)*r + 3*r^3 is increasing on r >= 0!
  have hmono : (1 / 3 + rv S j) * (32 / 75 - rv S j + 3 * rv S j ^ 2) ≤
      (1 / 3 + 7 / 150) * (32 / 75 - 7 / 150 + 3 * (7 / 150) ^ 2) := by
    have hexp : ∀ r : ℚ, (1 / 3 + r) * (32 / 75 - r + 3 * r ^ 2) = 32 / 225 + (7 / 75) * r + 3 * r ^ 3 := fun r => by ring
    rw [hexp (rv S j), hexp (7 / 150)]
    have hr3 : rv S j ^ 3 ≤ (7 / 150 : ℚ) ^ 3 := by nlinarith [sq_nonneg (rv S j)]
    linarith
  norm_num at hmono
  linarith

/-- Stage 2 (Universal Boundary 1): Under Stage 1 (`W_j + L_j >= 1/2`), BOTH `W_A + W_j <= 1/2` and `W_B + W_j <= 1/2`. -/
lemma stage2_no_boundary1 (hStage1 : ∀ j : Fin 3, 1 / 2 ≤ Wv S j + Lv S j) :
    (∀ j : Fin 3, WA S + Wv S j ≤ 1 / 2) ∧ (∀ j : Fin 3, WB S + Wv S j ≤ 1 / 2) := by
  constructor
  · intro j
    by_contra hgt; push Not at hgt
    set t := 1 / 2 - WA S with ht_def
    have hWA_lt := WA_lt S
    have ht_gt : 1 / 10 < t := by linarith
    have ht_lt_W : t < Wv S j := by linarith
    have hW_pos : 0 < Wv S j := by linarith
    -- Take all of A0 plus fraction t / W_j of I_j!
    let f : VegaV i → ℚ := fun z =>
      match z with
      | .inl p => if (.inl p : VegaV i) ∈ Ij i j then t / Wv S j else 0
      | .inr q => if q.val = 0 ∨ q.val = 5 ∨ q.val = 6 ∨ q.val = 7 then 1 else 0
    have hf_rng : ∀ z, 0 ≤ f z ∧ f z ≤ 1 := by
      intro z; cases z with
      | inl p =>
        dsimp only [f]; split_ifs
        · exact ⟨div_nonneg (by linarith) (le_of_lt hW_pos), (div_le_one hW_pos).mpr (le_of_lt ht_lt_W)⟩
        · norm_num
      | inr q => dsimp only [f]; split_ifs <;> norm_num
    have hf_sum : ∑ z : VegaV i, f z * S.w z = 1 / 2 := by
      rw [Fintype.sum_sum_type]
      have hQ : ∑ q : Fin 8, f (.inr q) * S.w (.inr q) = WA S := by
        rw [Fin.sum_univ_eight]; simp [f, WA, qx, qu, qv, qw]
      have hG : ∑ p : Fin (3 * i - 1), f (.inl p) * S.w (.inl p) = t := by
        have h1 : ∑ p : Fin (3 * i - 1), f (.inl p) * S.w (.inl p) = (t / Wv S j) * Wv S j :=
          sum_inl_Ij S j (t / Wv S j)
        rw [h1, div_mul_cancel₀ _ (ne_of_gt hW_pos)]
      linarith
    have hfr := S.hfrac f hf_rng hf_sum
    have hdbl : ∑ u : VegaV i, ∑ v : VegaV i, (if vegaAdj i u v then f u * f v * S.w u * S.w v else 0) =
        2 * (uv S j * t) := by
      -- Only edges are between u_j and I_j!
      have hGG : ∀ p q : Fin (3 * i - 1), (if vegaAdj i (.inl p) (.inl q) then f (.inl p) * f (.inl q) * S.w (.inl p) * S.w (.inl q) else 0) = 0 := by
        intro p q; split_ifs with h
        · by_cases hp : (.inl p : VegaV i) ∈ Ij i j
          · by_cases hq : (.inl q : VegaV i) ∈ Ij i j
            · exact (indep_Ij S.hi j (.inl p) hp (.inl q) hq h).elim
            · simp [f, hq]
          · simp [f, hp]
        · rfl
      have hQQ : ∀ p q : Fin 8, (if vegaAdj i (.inr p) (.inr q) then f (.inr p) * f (.inr q) * S.w (.inr p) * S.w (.inr q) else 0) = 0 := by
        intro p q; fin_cases p <;> fin_cases q <;> simp [f, vegaAdj]
      have hQG : ∑ q : Fin 8, ∑ p : Fin (3 * i - 1),
          (if vegaAdj i (.inr q) (.inl p) then f (.inr q) * f (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) = uv S j * t := by
        have hstep : ∀ q : Fin 8, ∑ p : Fin (3 * i - 1),
            (if vegaAdj i (.inr q) (.inl p) then f (.inr q) * f (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) =
            if (q = 5 ∧ j = 0) ∨ (q = 6 ∧ j = 1) ∨ (q = 7 ∧ j = 2) then S.w (.inr q) * t else 0 := by
          intro q
          rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          rcases fin3_cases j with rfl | rfl | rfl <;>
          first
          | (rw [if_pos (by decide)]
             conv_rhs => rw [← div_mul_cancel₀ t (ne_of_gt hW_pos), ← sum_inl_Ij, Finset.mul_sum]
             apply Finset.sum_congr rfl; intro p _
             simp [f, vegaAdj, Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl]; split_ifs <;> ring)
          | (rw [if_neg (by decide)]; apply Finset.sum_eq_zero; intro p _
             simp [f, vegaAdj, Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl]; try (intros; omega))
        rw [Fin.sum_univ_eight]
        simp_rw [hstep]
        rcases fin3_cases j with rfl | rfl | rfl <;> simp [uv, qu, qv, qw]
      have hGQ : ∑ p : Fin (3 * i - 1), ∑ q : Fin 8,
          (if vegaAdj i (.inl p) (.inr q) then f (.inl p) * f (.inr q) * S.w (.inl p) * S.w (.inr q) else 0) = uv S j * t := by
        rw [Finset.sum_comm, ← hQG]
        apply Finset.sum_congr rfl; intro q _; apply Finset.sum_congr rfl; intro p _
        have hsym : vegaAdj i (.inl p) (.inr q) ↔ vegaAdj i (.inr q) (.inl p) := ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
        by_cases h : vegaAdj i (.inr q) (.inl p) <;> simp [hsym, h]; ring
      rw [Fintype.sum_sum_type]
      have h1 : ∑ p : Fin (3 * i - 1), ∑ v : VegaV i, (if vegaAdj i (.inl p) v then f (.inl p) * f v * S.w (.inl p) * S.w v else 0) = uv S j * t := by
        simp_rw [Fintype.sum_sum_type, Finset.sum_add_distrib]
        have hz : ∑ p : Fin (3 * i - 1), ∑ q : Fin (3 * i - 1), (if vegaAdj i (.inl p) (.inl q) then f (.inl p) * f (.inl q) * S.w (.inl p) * S.w (.inl q) else 0) = 0 :=
          Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun q _ => hGG p q))
        rw [hz, zero_add, hGQ]
      have h2 : ∑ q : Fin 8, ∑ v : VegaV i, (if vegaAdj i (.inr q) v then f (.inr q) * f v * S.w (.inr q) * S.w v else 0) = uv S j * t := by
        simp_rw [Fintype.sum_sum_type, Finset.sum_add_distrib]
        have hz : ∑ p : Fin 8, ∑ q : Fin 8, (if vegaAdj i (.inr p) (.inr q) then f (.inr p) * f (.inr q) * S.w (.inr p) * S.w (.inr q) else 0) = 0 :=
          Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun q _ => hQQ p q))
        rw [hz, add_zero, hQG]
      rw [h1, h2]; ring
    have hut : (1 / 50 : ℚ) < uv S j * t := by linarith
    have hu_lt : uv S j < Wv S j - t + 1 / 6 := by
      have ha := deg_a S; have hb := deg_b S; have hc := deg_c S
      rcases fin3_cases j with rfl | rfl | rfl <;> simp only [uv, WA, W1, W2, W3] at * <;> linarith
    have hW_ge : 3 / 25 ≤ Wv S j := by
      by_cases ht3 : 3 / 25 ≤ t
      · linarith
      · have hfac : 0 < (25 * t - 3) * (6 * t - 1) := by nlinarith
        nlinarith
    exact contra_of_interior_and_W_ge S j (hStage1 j) hW_ge
  · intro j
    by_contra hgt; push Not at hgt
    set t := 1 / 2 - WB S with ht_def
    have hWB_lt := WB_lt S
    have ht_gt : 1 / 10 < t := by linarith
    have ht_lt_W : t < Wv S j := by linarith
    have hW_pos : 0 < Wv S j := by linarith
    let f : VegaV i → ℚ := fun z =>
      match z with
      | .inl p => if (.inl p : VegaV i) ∈ Ij i j then t / Wv S j else 0
      | .inr q => if q.val = 1 ∨ q.val = 2 ∨ q.val = 3 ∨ q.val = 4 then 1 else 0
    have hf_rng : ∀ z, 0 ≤ f z ∧ f z ≤ 1 := by
      intro z; cases z with
      | inl p =>
        dsimp only [f]; split_ifs
        · exact ⟨div_nonneg (by linarith) (le_of_lt hW_pos), (div_le_one hW_pos).mpr (le_of_lt ht_lt_W)⟩
        · norm_num
      | inr q => dsimp only [f]; split_ifs <;> norm_num
    have hf_sum : ∑ z : VegaV i, f z * S.w z = 1 / 2 := by
      rw [Fintype.sum_sum_type]
      have hQ : ∑ q : Fin 8, f (.inr q) * S.w (.inr q) = WB S := by
        rw [Fin.sum_univ_eight]; simp [f, WB, qy, qa, qb, qc]
      have hG : ∑ p : Fin (3 * i - 1), f (.inl p) * S.w (.inl p) = t := by
        have h1 : ∑ p : Fin (3 * i - 1), f (.inl p) * S.w (.inl p) = (t / Wv S j) * Wv S j :=
          sum_inl_Ij S j (t / Wv S j)
        rw [h1, div_mul_cancel₀ _ (ne_of_gt hW_pos)]
      linarith
    have hfr := S.hfrac f hf_rng hf_sum
    have hdbl : ∑ u : VegaV i, ∑ v : VegaV i, (if vegaAdj i u v then f u * f v * S.w u * S.w v else 0) =
        2 * (av S j * t) := by
      have hGG : ∀ p q : Fin (3 * i - 1), (if vegaAdj i (.inl p) (.inl q) then f (.inl p) * f (.inl q) * S.w (.inl p) * S.w (.inl q) else 0) = 0 := by
        intro p q; split_ifs with h
        · by_cases hp : (.inl p : VegaV i) ∈ Ij i j
          · by_cases hq : (.inl q : VegaV i) ∈ Ij i j
            · exact (indep_Ij S.hi j (.inl p) hp (.inl q) hq h).elim
            · simp [f, hq]
          · simp [f, hp]
        · rfl
      have hQQ : ∀ p q : Fin 8, (if vegaAdj i (.inr p) (.inr q) then f (.inr p) * f (.inr q) * S.w (.inr p) * S.w (.inr q) else 0) = 0 := by
        intro p q; fin_cases p <;> fin_cases q <;> simp [f, vegaAdj]
      have hQG : ∑ q : Fin 8, ∑ p : Fin (3 * i - 1),
          (if vegaAdj i (.inr q) (.inl p) then f (.inr q) * f (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) = av S j * t := by
        have hstep : ∀ q : Fin 8, ∑ p : Fin (3 * i - 1),
            (if vegaAdj i (.inr q) (.inl p) then f (.inr q) * f (.inl p) * S.w (.inr q) * S.w (.inl p) else 0) =
            if (q = 2 ∧ j = 0) ∨ (q = 3 ∧ j = 1) ∨ (q = 4 ∧ j = 2) then S.w (.inr q) * t else 0 := by
          intro q
          rcases fin8_cases q with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          rcases fin3_cases j with rfl | rfl | rfl <;>
          first
          | (rw [if_pos (by decide)]
             conv_rhs => rw [← div_mul_cancel₀ t (ne_of_gt hW_pos), ← sum_inl_Ij, Finset.mul_sum]
             apply Finset.sum_congr rfl; intro p _
             simp [f, vegaAdj, Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl]; split_ifs <;> ring)
          | (rw [if_neg (by decide)]; apply Finset.sum_eq_zero; intro p _
             simp [f, vegaAdj, Ij, mem_I1_inl, mem_I2_inl, mem_I3_inl]; try (intros; omega))
        rw [Fin.sum_univ_eight]
        simp_rw [hstep]
        rcases fin3_cases j with rfl | rfl | rfl <;> simp [av, qa, qb, qc]
      have hGQ : ∑ p : Fin (3 * i - 1), ∑ q : Fin 8,
          (if vegaAdj i (.inl p) (.inr q) then f (.inl p) * f (.inr q) * S.w (.inl p) * S.w (.inr q) else 0) = av S j * t := by
        rw [Finset.sum_comm, ← hQG]
        apply Finset.sum_congr rfl; intro q _; apply Finset.sum_congr rfl; intro p _
        have hsym : vegaAdj i (.inl p) (.inr q) ↔ vegaAdj i (.inr q) (.inl p) := ⟨vegaAdj_symm S.hi, vegaAdj_symm S.hi⟩
        by_cases h : vegaAdj i (.inr q) (.inl p) <;> simp [hsym, h]; ring
      rw [Fintype.sum_sum_type]
      have h1 : ∑ p : Fin (3 * i - 1), ∑ v : VegaV i, (if vegaAdj i (.inl p) v then f (.inl p) * f v * S.w (.inl p) * S.w v else 0) = av S j * t := by
        simp_rw [Fintype.sum_sum_type, Finset.sum_add_distrib]
        have hz : ∑ p : Fin (3 * i - 1), ∑ q : Fin (3 * i - 1), (if vegaAdj i (.inl p) (.inl q) then f (.inl p) * f (.inl q) * S.w (.inl p) * S.w (.inl q) else 0) = 0 :=
          Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun q _ => hGG p q))
        rw [hz, zero_add, hGQ]
      have h2 : ∑ q : Fin 8, ∑ v : VegaV i, (if vegaAdj i (.inr q) v then f (.inr q) * f v * S.w (.inr q) * S.w v else 0) = av S j * t := by
        simp_rw [Fintype.sum_sum_type, Finset.sum_add_distrib]
        have hz : ∑ p : Fin 8, ∑ q : Fin 8, (if vegaAdj i (.inr p) (.inr q) then f (.inr p) * f (.inr q) * S.w (.inr p) * S.w (.inr q) else 0) = 0 :=
          Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun q _ => hQQ p q))
        rw [hz, add_zero, hQG]
      rw [h1, h2]; ring
    have hat : (1 / 50 : ℚ) < av S j * t := by linarith
    have ha_lt : av S j < Wv S j - t + 1 / 6 := by
      have hu := deg_u S; have hv := deg_v S; have hw := deg_w S
      rcases fin3_cases j with rfl | rfl | rfl <;> simp only [av, WB, W1, W2, W3] at * <;> linarith
    have hW_ge : 3 / 25 ≤ Wv S j := by
      by_cases ht3 : 3 / 25 ≤ t
      · linarith
      · have hfac : 0 < (25 * t - 3) * (6 * t - 1) := by nlinarith
        nlinarith
    exact contra_of_interior_and_W_ge S j (hStage1 j) hW_ge

/- ### Stage 3: Universal Exact Rational Interior Refutation (ALL `i >= 2`) -/

/-- Elementary `S_3` invariant bounds on `x1 + x2 + x3 = 0` with `-a <= x_j <= b` (`a, b >= 0`). -/
lemma s3_inv_bounds {x1 x2 x3 a b : ℚ} (hsum : x1 + x2 + x3 = 0) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (h1 : -a ≤ x1 ∧ x1 ≤ b) (h2 : -a ≤ x2 ∧ x2 ≤ b) (h3 : -a ≤ x3 ∧ x3 ≤ b) :
    let q := x1 ^ 2 + x2 ^ 2 + x3 ^ 2
    let r := x1 * x2 * x3
    q ≤ 3 * a * b ∧ -(a / 6) * q ≤ r ∧ r ≤ (b / 6) * q := by
  dsimp only
  have hq : x1 ^ 2 + x2 ^ 2 + x3 ^ 2 ≤ 3 * a * b := by
    have p1 : 0 ≤ (b - x1) * (a + x1) := mul_nonneg (by linarith) (by linarith)
    have p2 : 0 ≤ (b - x2) * (a + x2) := mul_nonneg (by linarith) (by linarith)
    have p3 : 0 ≤ (b - x3) * (a + x3) := mul_nonneg (by linarith) (by linarith)
    have hid : (b - x1) * (a + x1) + (b - x2) * (a + x2) + (b - x3) * (a + x3) =
        3 * a * b - (x1 ^ 2 + x2 ^ 2 + x3 ^ 2) + (b - a) * (x1 + x2 + x3) := by ring
    rw [hsum] at hid; linarith
  have hrup : ∀ u1 u2 u3 B : ℚ, u1 + u2 + u3 = 0 → 0 ≤ B → u1 ≤ B → u2 ≤ B → u3 ≤ B →
      u1 * u2 * u3 ≤ (B / 6) * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) := by
    intro u1 u2 u3 B hs hB hu1 hu2 hu3
    by_cases hpos : u1 * u2 * u3 ≤ 0
    · have hnn : 0 ≤ (B / 6) * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) := by positivity
      linarith
    · push Not at hpos
      have hcase : (0 < u1 ∧ u2 < 0 ∧ u3 < 0) ∨ (0 < u2 ∧ u1 < 0 ∧ u3 < 0) ∨ (0 < u3 ∧ u1 < 0 ∧ u2 < 0) := by
        by_contra hnone; push Not at hnone
        rcases lt_or_ge 0 u1 with h1p | h1n <;> rcases lt_or_ge 0 u2 with h2p | h2n <;> rcases lt_or_ge 0 u3 with h3p | h3n
        · linarith
        · have : u1 * u2 * u3 ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (mul_nonneg (le_of_lt h1p) (le_of_lt h2p)) h3n; linarith
        · have : u1 * u2 * u3 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos (le_of_lt h1p) h2n) (le_of_lt h3p)
          linarith
        · rcases eq_or_lt_of_le h2n with rfl | h2lt
          · simp at hpos
          · rcases eq_or_lt_of_le h3n with rfl | h3lt
            · simp at hpos
            · exact absurd h3lt (not_lt.mpr (hnone.1 h1p h2lt))
        · have : u1 * u2 * u3 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonpos_of_nonneg h1n (le_of_lt h2p)) (le_of_lt h3p)
          linarith
        · rcases eq_or_lt_of_le h1n with rfl | h1lt
          · simp at hpos
          · rcases eq_or_lt_of_le h3n with rfl | h3lt
            · simp at hpos
            · exact absurd h3lt (not_lt.mpr (hnone.2.1 h2p h1lt))
        · rcases eq_or_lt_of_le h1n with rfl | h1lt
          · simp at hpos
          · rcases eq_or_lt_of_le h2n with rfl | h2lt
            · simp at hpos
            · exact absurd h2lt (not_lt.mpr (hnone.2.2 h3p h1lt))
        · have : u1 * u2 * u3 ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (mul_nonneg_of_nonpos_of_nonpos h1n h2n) h3n
          linarith
      rcases hcase with ⟨hp, hn1, hn2⟩ | ⟨hp, hn1, hn2⟩ | ⟨hp, hn1, hn2⟩
      · have hq3 : 3 * u1 ^ 2 ≤ 2 * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) := by
          have : 2 * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - 3 * u1 ^ 2 = (u2 - u3) ^ 2 + (u1 + u2 + u3) ^ 2 - 2 * u1 * (u1 + u2 + u3) := by ring
          rw [hs] at this; nlinarith [sq_nonneg (u2 - u3)]
        have hpr : 4 * (u2 * u3) ≤ u1 ^ 2 := by
          have : u1 ^ 2 - 4 * (u2 * u3) = (u2 - u3) ^ 2 + (u1 + u2 + u3) * (u1 - u2 - u3) := by ring
          rw [hs] at this; nlinarith [sq_nonneg (u2 - u3)]
        nlinarith [sq_nonneg u1]
      · have hq3 : 3 * u2 ^ 2 ≤ 2 * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) := by
          have : 2 * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - 3 * u2 ^ 2 = (u1 - u3) ^ 2 + (u1 + u2 + u3) ^ 2 - 2 * u2 * (u1 + u2 + u3) := by ring
          rw [hs] at this; nlinarith [sq_nonneg (u1 - u3)]
        have hpr : 4 * (u1 * u3) ≤ u2 ^ 2 := by
          have : u2 ^ 2 - 4 * (u1 * u3) = (u1 - u3) ^ 2 + (u1 + u2 + u3) * (u2 - u1 - u3) := by ring
          rw [hs] at this; nlinarith [sq_nonneg (u1 - u3)]
        nlinarith [sq_nonneg u2]
      · have hq3 : 3 * u3 ^ 2 ≤ 2 * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) := by
          have : 2 * (u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - 3 * u3 ^ 2 = (u1 - u2) ^ 2 + (u1 + u2 + u3) ^ 2 - 2 * u3 * (u1 + u2 + u3) := by ring
          rw [hs] at this; nlinarith [sq_nonneg (u1 - u2)]
        have hpr : 4 * (u1 * u2) ≤ u3 ^ 2 := by
          have : u3 ^ 2 - 4 * (u1 * u2) = (u1 - u2) ^ 2 + (u1 + u2 + u3) * (u3 - u1 - u2) := by ring
          rw [hs] at this; nlinarith [sq_nonneg (u1 - u2)]
        nlinarith [sq_nonneg u3]
  refine ⟨hq, ?_, hrup x1 x2 x3 b hsum hb h1.2 h2.2 h3.2⟩
  have hneg := hrup (-x1) (-x2) (-x3) a (by linarith) ha (by linarith) (by linarith) (by linarith)
  have h1 : (-x1) * (-x2) * (-x3) = -(x1 * x2 * x3) := by ring
  have h2 : (-x1) ^ 2 + (-x2) ^ 2 + (-x3) ^ 2 = x1 ^ 2 + x2 ^ 2 + x3 ^ 2 := by ring
  linarith

/-- Pure `ℚ` square-root-free weighted AM-GM:
    If `X^2 <= A^2 * (Q * P)` and `Y^2 <= B^2 * (Q * P)` (`A, B, Q, P >= 0`, `mu > 0`),
    then `X + Y <= (mu / 2) * P + ((A + B)^2 / (2 * mu)) * Q`. -/
lemma rat_amgm_pair {X Y A B Q P mu : ℚ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hQ : 0 ≤ Q) (hP : 0 ≤ P) (hmu : 0 < mu)
    (hX : X ^ 2 ≤ A ^ 2 * (Q * P)) (hY : Y ^ 2 ≤ B ^ 2 * (Q * P)) :
    X + Y ≤ (mu / 2) * P + ((A + B) ^ 2 / (2 * mu)) * Q := by
  set R := (mu / 2) * P + ((A + B) ^ 2 / (2 * mu)) * Q with hR_def
  have hR_nn : 0 ≤ R := by rw [hR_def]; positivity
  by_cases hXY : X + Y ≤ 0
  · linarith
  · have hXY_pos : 0 ≤ X + Y := by linarith
    have hcross_sq : (X * Y) ^ 2 ≤ (A * B * (Q * P)) ^ 2 := by
      have : (X * Y) ^ 2 = X ^ 2 * Y ^ 2 := by ring
      have h2 : (A * B * (Q * P)) ^ 2 = (A ^ 2 * (Q * P)) * (B ^ 2 * (Q * P)) := by ring
      rw [this, h2]
      exact mul_le_mul hX hY (sq_nonneg Y) (by positivity)
    have hcross : X * Y ≤ A * B * (Q * P) := by
      have hnn : 0 ≤ A * B * (Q * P) := by positivity
      nlinarith
    have hsum_sq : (X + Y) ^ 2 ≤ (A + B) ^ 2 * (Q * P) := by nlinarith
    have hR_sq : (A + B) ^ 2 * (Q * P) ≤ R ^ 2 := by
      have hid : R ^ 2 - (A + B) ^ 2 * (Q * P) = ((mu / 2) * P - ((A + B) ^ 2 / (2 * mu)) * Q) ^ 2 := by
        simp only [R]; field_simp [ne_of_gt hmu]; ring
      nlinarith [sq_nonneg ((mu / 2) * P - ((A + B) ^ 2 / (2 * mu)) * Q)]
    nlinarith

/-- Unified Stage 3 core refutation for a given `(c, c1, c2)` and box bounds `(a, b)` once the 4 triangle certs hold! -/
lemma stage3_contra_from_certs {W s w1 w2 w3 t1 t2 t3 a b : ℚ}
    (hW_pos : 0 < W) (hs_nn : 0 ≤ s)
    (hw_sum : w1 + w2 + w3 = 0) (ht_sum : t1 + t2 + t3 = 0)
    (ha_nn : 0 ≤ a) (hb_nn : 0 ≤ b)
    (hw1 : -a ≤ w1 ∧ w1 ≤ b) (hw2 : -a ≤ w2 ∧ w2 ≤ b) (hw3 : -a ≤ w3 ∧ w3 ≤ b)
    (ht1 : -(s / 3) ≤ t1 ∧ t1 ≤ 2 * s / 3) (ht2 : -(s / 3) ≤ t2 ∧ t2 ≤ 2 * s / 3) (ht3 : -(s / 3) ≤ t3 ∧ t3 ≤ 2 * s / 3)
    (c1 c2 C0div Cpdiv rtdiv Cq Crw Cm B Cwt2 Cpm Cqp Cm2 : ℚ)
    (hc1 : 0 < c1) (hc2 : 0 < c2)
    (hCm2 : Cm2 ≤ 0) (hCqp : 0 ≤ Cqp) (hrt_nn : 0 ≤ rtdiv) (hCwt2 : 0 ≤ Cwt2) (hCpm : Cpm ≤ 0)
    (hF_pos : 0 <
      W * C0div + Cq * (w1^2 + w2^2 + w3^2) + W * Cpdiv * (t1^2 + t2^2 + t3^2) +
      Cm * (w1*t1 + w2*t2 + w3*t3) + Crw * (w1*w2*w3) + (-18 * W * rtdiv) * (t1*t2*t3) +
      (-B) * (w1^2*t1 + w2^2*t2 + w3^2*t3) + Cwt2 * (w1*t1^2 + w2*t2^2 + w3*t3^2) +
      Cqp * (w1^2 + w2^2 + w3^2) * (t1^2 + t2^2 + t3^2) +
      Cm2 * (w1*t1 + w2*t2 + w3*t3)^2 + Cpm * (t1^2 + t2^2 + t3^2) * (w1*t1 + w2*t2 + w3*t3))
    (hC0 : C0div < 0)
    (hB1 : C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * (2 / 3) * s ^ 2 < 0)
    (hB2p : (W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) +
        (Cwt2 * (1 / 3) * s - Cpm * (2 / 3) * s ^ 2) ^ 2 * (1 / (2 * c2))) +
        (W * Crw - 3 * Cm * B / c1) * b / 6 + (B ^ 2 / (12 * c1)) * 3 * a * b < 0)
    (hB2m : (W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) +
        (Cwt2 * (1 / 3) * s - Cpm * (2 / 3) * s ^ 2) ^ 2 * (1 / (2 * c2))) -
        (W * Crw - 3 * Cm * B / c1) * a / 6 + (B ^ 2 / (12 * c1)) * 3 * a * b < 0) :
    False := by
  set q := w1^2 + w2^2 + w3^2
  set p := t1^2 + t2^2 + t3^2
  set m := w1*t1 + w2*t2 + w3*t3
  set r_w := w1*w2*w3
  set r_t := t1*t2*t3
  set c_w2t := w1^2*t1 + w2^2*t2 + w3^2*t3
  set c_wt2 := w1*t1^2 + w2*t2^2 + w3*t3^2
  have hq_nn : 0 ≤ q := by positivity
  have hp_nn : 0 ≤ p := by positivity
  obtain ⟨hq_le, hrw_lo, hrw_hi⟩ := s3_inv_bounds hw_sum ha_nn hb_nn hw1 hw2 hw3
  obtain ⟨hp_le', hrt_lo, _⟩ := s3_inv_bounds ht_sum (by linarith : 0 ≤ s / 3) (by linarith : 0 ≤ 2 * s / 3)
    ⟨by linarith [ht1.1], ht1.2⟩ ⟨by linarith [ht2.1], ht2.2⟩ ⟨by linarith [ht3.1], ht3.2⟩
  have hp_le : p ≤ (2 / 3 : ℚ) * s ^ 2 := by
    calc p ≤ 3 * (s / 3) * (2 * s / 3) := hp_le'
      _ = (2 / 3 : ℚ) * s ^ 2 := by ring
  have hrt_bound : (-18 * W * rtdiv) * r_t ≤ W * rtdiv * s * p := by
    have h1 : -(s / 18) * p ≤ r_t := by linarith only [hrt_lo]
    have h2 : 0 ≤ 18 * W * rtdiv := by positivity
    nlinarith only [h1, h2]
  -- 1. Drop Cm2 * m^2 <= 0 and bound Cqp * q * p <= Cqp * (2/3)*s^2 * q
  have hm2_le : Cm2 * m ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hCm2 (sq_nonneg m)
  have hqp_le : Cqp * q * p ≤ Cqp * (2 / 3) * s ^ 2 * q := by
    have hnn : 0 ≤ Cqp * q := mul_nonneg hCqp hq_nn
    nlinarith only [hnn, hp_le]
  -- 2. Weighted AM-GM for Cm * m - B * c_w2t with lam = c1 * W
  set lam := c1 * W
  have hlam : 0 < lam := mul_pos hc1 hW_pos
  have ham1 : Cm * m - B * c_w2t ≤ (lam / 2) * p + (1 / (2 * lam)) * (Cm^2 * q - 6 * Cm * B * r_w + (B^2 / 6) * q^2) := by
    have hsq_nn : 0 ≤ (lam * t1 - (Cm * w1 - B * (w1^2 - q / 3))) ^ 2 +
        (lam * t2 - (Cm * w2 - B * (w2^2 - q / 3))) ^ 2 +
        (lam * t3 - (Cm * w3 - B * (w3^2 - q / 3))) ^ 2 := by positivity
    have hid1 : (lam * t1 - (Cm * w1 - B * (w1^2 - q / 3))) ^ 2 +
        (lam * t2 - (Cm * w2 - B * (w2^2 - q / 3))) ^ 2 +
        (lam * t3 - (Cm * w3 - B * (w3^2 - q / 3))) ^ 2 =
        lam^2 * p - 2 * lam * (Cm * m - B * c_w2t) + (Cm^2 * q - 6 * Cm * B * r_w + (B^2 / 6) * q^2) := by
      have hw3' : w3 = -w1 - w2 := by linarith only [hw_sum]
      have ht3' : t3 = -t1 - t2 := by linarith only [ht_sum]
      simp only [q, p, m, r_w, c_w2t]; rw [hw3', ht3']; ring
    have h2 : 2 * lam * (Cm * m - B * c_w2t) ≤ lam^2 * p + (Cm^2 * q - 6 * Cm * B * r_w + (B^2 / 6) * q^2) := by
      linarith only [hsq_nn, hid1]
    have hdiv := div_le_div_of_nonneg_right h2 (by linarith only [hlam] : (0 : ℚ) ≤ 2 * lam)
    have hl : 2 * lam * (Cm * m - B * c_w2t) / (2 * lam) = Cm * m - B * c_w2t := mul_div_cancel_left₀ _ (by linarith only [hlam])
    rw [hl] at hdiv
    have hr : (lam^2 * p + (Cm^2 * q - 6 * Cm * B * r_w + (B^2 / 6) * q^2)) / (2 * lam) =
        (lam / 2) * p + (1 / (2 * lam)) * (Cm^2 * q - 6 * Cm * B * r_w + (B^2 / 6) * q^2) := by
      field_simp [ne_of_gt hlam]
    linarith only [hdiv, hr]
  -- 3. Square-root-free rational AM-GM for Cwt2 * c_wt2 + Cpm * p * m with mu = c2 * W
  set mu := c2 * W
  have hmu : 0 < mu := mul_pos hc2 hW_pos
  have hcwt2_sq : c_wt2 ^ 2 ≤ (s / 3) ^ 2 * (q * p) := by
    have hcs : c_wt2 ^ 2 ≤ q * ((t1^2 - p/3)^2 + (t2^2 - p/3)^2 + (t3^2 - p/3)^2) := by
      have hdiff : q * ((t1^2 - p/3)^2 + (t2^2 - p/3)^2 + (t3^2 - p/3)^2) - c_wt2 ^ 2 =
          (w1 * (t2^2 - p/3) - w2 * (t1^2 - p/3))^2 +
          (w2 * (t3^2 - p/3) - w3 * (t2^2 - p/3))^2 +
          (w3 * (t1^2 - p/3) - w1 * (t3^2 - p/3))^2 := by
        have hw3' : w3 = -w1 - w2 := by linarith only [hw_sum]
        simp only [q, p, c_wt2]; rw [hw3']; ring
      linarith only [hdiff, sq_nonneg (w1 * (t2^2 - p/3) - w2 * (t1^2 - p/3)),
        sq_nonneg (w2 * (t3^2 - p/3) - w3 * (t2^2 - p/3)),
        sq_nonneg (w3 * (t1^2 - p/3) - w1 * (t3^2 - p/3))]
    have hp6 : (t1^2 - p/3)^2 + (t2^2 - p/3)^2 + (t3^2 - p/3)^2 = p^2 / 6 := by
      have ht3' : t3 = -t1 - t2 := by linarith only [ht_sum]
      simp only [p]; rw [ht3']; ring
    rw [hp6] at hcs
    have hq_p : q * (p^2 / 6) ≤ (s / 3)^2 * (q * p) := by
      have hid2 : (s / 3)^2 * (q * p) - q * (p^2 / 6) = q * p * ((2 / 3) * s^2 - p) / 6 := by ring
      have hnn : 0 ≤ q * p * ((2 / 3) * s^2 - p) / 6 := by
        have h1 : 0 ≤ (2 / 3) * s^2 - p := by linarith only [hp_le]
        positivity
      linarith only [hid2, hnn]
    linarith only [hcs, hq_p]
  have hpm_sq : (p * m) ^ 2 ≤ ((2 / 3) * s ^ 2) ^ 2 * (q * p) := by
    have hm_sq : m ^ 2 ≤ q * p := by
      have hid3 : q * p - m ^ 2 = (w1 * t2 - w2 * t1)^2 + (w2 * t3 - w3 * t2)^2 + (w3 * t1 - w1 * t3)^2 := by
        simp only [q, p, m]; ring
      linarith only [hid3, sq_nonneg (w1 * t2 - w2 * t1), sq_nonneg (w2 * t3 - w3 * t2), sq_nonneg (w3 * t1 - w1 * t3)]
    have hp2 : p ^ 2 ≤ ((2 / 3) * s ^ 2) ^ 2 := by nlinarith only [hp_nn, hp_le]
    calc (p * m) ^ 2 = p ^ 2 * m ^ 2 := by ring
      _ ≤ ((2 / 3) * s ^ 2) ^ 2 * (q * p) := mul_le_mul hp2 hm_sq (sq_nonneg m) (by positivity)
  have hX_sq : (Cwt2 * c_wt2) ^ 2 ≤ (Cwt2 * (1 / 3) * s) ^ 2 * (q * p) := by
    have : (Cwt2 * c_wt2) ^ 2 = Cwt2 ^ 2 * c_wt2 ^ 2 := by ring
    have h2 : (Cwt2 * (1 / 3) * s) ^ 2 * (q * p) = Cwt2 ^ 2 * ((s / 3) ^ 2 * (q * p)) := by ring
    rw [this, h2]; exact mul_le_mul_of_nonneg_left hcwt2_sq (sq_nonneg Cwt2)
  have hY_sq : (Cpm * (p * m)) ^ 2 ≤ ((-Cpm) * (2 / 3) * s ^ 2) ^ 2 * (q * p) := by
    have : (Cpm * (p * m)) ^ 2 = Cpm ^ 2 * (p * m) ^ 2 := by ring
    have h2 : ((-Cpm) * (2 / 3) * s ^ 2) ^ 2 * (q * p) = Cpm ^ 2 * (((2 / 3) * s ^ 2) ^ 2 * (q * p)) := by ring
    rw [this, h2]; exact mul_le_mul_of_nonneg_left hpm_sq (sq_nonneg Cpm)
  have ham2 := rat_amgm_pair (A := Cwt2 * (1 / 3) * s) (B := (-Cpm) * (2 / 3) * s ^ 2)
    (by positivity) (by nlinarith only [hCpm, hs_nn]) hq_nn hp_nn hmu hX_sq hY_sq
  -- 4. Combine Phi_1(p) < 0 and Phi_2(r_w, q) <= 0!
  set Dm := Cwt2 * (1 / 3) * s - Cpm * (2 / 3) * s ^ 2
  have hDm_eq : Cwt2 * (1 / 3) * s + (-Cpm) * (2 / 3) * s ^ 2 = Dm := by simp only [Dm]; ring
  rw [hDm_eq] at ham2
  have hPhi1_neg : W * (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * p) < 0 := by
    have hlin : C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * p < 0 := by
      by_cases hs0 : s = 0
      · have hp0 : p = 0 := by nlinarith only [hs0, hp_nn, hp_le]
        rw [hp0]; linarith only [hC0]
      · have hs_pos : 0 < (2 / 3 : ℚ) * s ^ 2 := by
          have : 0 < s := lt_of_le_of_ne hs_nn (Ne.symm hs0); positivity
        have hconv : (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * p) * ((2 / 3) * s ^ 2) =
            C0div * ((2 / 3) * s ^ 2 - p) +
            (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * (2 / 3) * s ^ 2) * p := by ring
        have h1 : C0div * ((2 / 3) * s ^ 2 - p) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (le_of_lt hC0) (by linarith only [hp_le])
        have h2 : (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * (2 / 3) * s ^ 2) * p ≤ 0 :=
          mul_nonpos_of_nonpos_of_nonneg (le_of_lt hB1) hp_nn
        have hstrict : C0div * ((2 / 3) * s ^ 2 - p) +
            (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * (2 / 3) * s ^ 2) * p < 0 := by
          by_cases hp0 : p = 0
          · rw [hp0]; nlinarith only [hC0, hs_pos]
          · have hpp : 0 < p := lt_of_le_of_ne hp_nn (Ne.symm hp0); nlinarith only [h1, hB1, hpp]
        nlinarith only [hconv, hstrict, hs_pos]
    exact mul_neg_of_pos_of_neg hW_pos hlin
  have hPhi2_le : (W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) + Dm ^ 2 * (1 / (2 * c2))) * q +
      (W * Crw - 3 * Cm * B / c1) * r_w + (B ^ 2 / (12 * c1)) * q ^ 2 ≤ 0 := by
    set Kq := W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) + Dm ^ 2 * (1 / (2 * c2))
    set Kr := W * Crw - 3 * Cm * B / c1
    set Kq2 := B ^ 2 / (12 * c1)
    have hKq2_nn : 0 ≤ Kq2 := by positivity
    have hq2_le : Kq2 * q ^ 2 ≤ Kq2 * (3 * a * b) * q := by
      have hid : Kq2 * (3 * a * b) * q - Kq2 * q ^ 2 = Kq2 * q * (3 * a * b - q) := by ring
      have h1 : 0 ≤ 3 * a * b - q := by linarith only [hq_le]
      have hnn : 0 ≤ Kq2 * q * (3 * a * b - q) := by positivity
      linarith only [hid, hnn]
    by_cases hKr : 0 ≤ Kr
    · have h1 : Kq * q + Kr * r_w + Kq2 * q ^ 2 ≤ (Kq + Kr * b / 6 + Kq2 * 3 * a * b) * q := by
        have hKr_b : Kr * r_w ≤ Kr * (b / 6) * q := by nlinarith only [hKr, hrw_hi]
        linarith only [hKr_b, hq2_le]
      have h2 : (Kq + Kr * b / 6 + Kq2 * 3 * a * b) * q ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (le_of_lt hB2p) hq_nn
      linarith only [h1, h2]
    · have h1 : Kq * q + Kr * r_w + Kq2 * q ^ 2 ≤ (Kq - Kr * a / 6 + Kq2 * 3 * a * b) * q := by
        have hKr_a : Kr * r_w ≤ Kr * (-(a / 6)) * q := by nlinarith only [hKr, hrw_lo]
        linarith only [hKr_a, hq2_le]
      have h2 : (Kq - Kr * a / 6 + Kq2 * 3 * a * b) * q ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (le_of_lt hB2m) hq_nn
      linarith only [h1, h2]
  -- Divide hPhi2_le by W > 0 and compare with F_pos!
  have htot_le : W * C0div + Cq * q + W * Cpdiv * p + Cm * m + Crw * r_w + (-18 * W * rtdiv) * r_t +
      (-B) * c_w2t + Cwt2 * c_wt2 + Cqp * q * p + Cm2 * m ^ 2 + Cpm * p * m ≤
      W * (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * p) +
      ((W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) + Dm ^ 2 * (1 / (2 * c2))) * q +
       (W * Crw - 3 * Cm * B / c1) * r_w + (B ^ 2 / (12 * c1)) * q ^ 2) / W := by
    have hsplit :
        W * (C0div + (Cpdiv + rtdiv * s + (c1 + c2) / 2) * p) +
        ((W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) + Dm ^ 2 * (1 / (2 * c2))) * q +
         (W * Crw - 3 * Cm * B / c1) * r_w + (B ^ 2 / (12 * c1)) * q ^ 2) / W =
        W * C0div + Cq * q + W * Cpdiv * p + W * rtdiv * s * p +
        ((lam / 2) * p + (1 / (2 * lam)) * (Cm ^ 2 * q - 6 * Cm * B * r_w + (B ^ 2 / 6) * q ^ 2)) +
        ((mu / 2) * p + (Dm ^ 2 / (2 * mu)) * q) +
        Crw * r_w + Cqp * (2 / 3) * s ^ 2 * q := by
      simp only [lam, mu]
      field_simp [ne_of_gt hW_pos, ne_of_gt hc1, ne_of_gt hc2]; ring
    rw [hsplit]
    have ham2' : Cwt2 * c_wt2 + Cpm * p * m ≤ (mu / 2) * p + (Dm ^ 2 / (2 * mu)) * q := by
      have h1 : Cpm * (p * m) = Cpm * p * m := by ring
      linarith only [ham2, h1]
    linarith only [hrt_bound, hm2_le, hqp_le, ham1, ham2']
  have hdiv_le : ((W * (Cq + Cqp * (2 / 3) * s ^ 2) + Cm ^ 2 * (1 / (2 * c1)) + Dm ^ 2 * (1 / (2 * c2))) * q +
       (W * Crw - 3 * Cm * B / c1) * r_w + (B ^ 2 / (12 * c1)) * q ^ 2) / W ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg hPhi2_le (le_of_lt hW_pos)
  linarith only [hF_pos, htot_le, hPhi1_neg, hdiv_le]

/-- Exact 11-term S_3-invariant expansion of `F_6^(23)` (ZERO residual, verified by `ring`). -/
lemma F6_23_eq (W s w1 w2 t1 t2 : ℚ) :
    let w3 := -w1 - w2; let t3 := -t1 - t2
    let W1 := W / 3 + w1; let W2 := W / 3 + w2; let W3 := W / 3 + w3
    let e1 := s / 3 + t1; let e2 := s / 3 + t2; let e3 := s / 3 + t3
    let S := 1 - W - s
    let s1 := (1/3 : ℚ) + 2*W1 - W - e1; let s2 := (1/3 : ℚ) + 2*W2 - W - e2; let s3 := (1/3 : ℚ) + 2*W3 - W - e3
    let L1 := (2/3 : ℚ) - 2*W1 - (s - e1); let L2 := (2/3 : ℚ) - 2*W2 - (s - e2); let L3 := (2/3 : ℚ) - 2*W3 - (s - e3)
    let c1 := (1/3 : ℚ) + (s - e1); let c2 := (1/3 : ℚ) + (s - e2); let c3 := (1/3 : ℚ) + (s - e3)
    let q := w1^2 + w2^2 + w3^2; let p := t1^2 + t2^2 + t3^2; let m := w1*t1 + w2*t2 + w3*t3
    let rw_ := w1*w2*w3; let rt := t1*t2*t3
    let cw2t := w1^2*t1 + w2^2*t2 + w3^2*t3; let cwt2 := w1*t1^2 + w2*t2^2 + w3*t3^2
    23 * (W1 * (c1 * (s2 * s3 / 2 + (e2 + e3)^2 / 8) - (1/50) * L1) +
          W2 * (c2 * (s3 * s1 / 2 + (e3 + e1)^2 / 8) - (1/50) * L2) +
          W3 * (c3 * (s1 * s2 / 2 + (e1 + e2)^2 / 8) - (1/50) * L3)) +
    2 * S * (W * (s1 * W1 + s2 * W2 + s3 * W3) + (1/4) * (W1 * e1^2 + W2 * e2^2 + W3 * e3^2) +
             4 * W1 * W2 * W3 - (2/25) * W) =
    W * C0div_23 W s + Cq_23 W s * q + W * Cpdiv_23 W s * p + Cm_23 W s * m +
    Crw_23 W s * rw_ + (-18 * W * rtdiv_23 W s) * rt + (-B_23 W s) * cw2t +
    Cwt2_23 W s * cwt2 + Cqp_23 W s * q * p + Cm2_23 W s * m^2 + Cpm_23 W s * p * m := by
  dsimp only [C0div_23, Cpdiv_23, rtdiv_23, Cq_23, Crw_23, Cm_23, B_23, Cwt2_23, Cpm_23, Cqp_23, Cm2_23]
  ring

/-- Exact 11-term S_3-invariant expansion of `F_6^(20)` (ZERO residual, verified by `ring`). -/
lemma F6_20_eq (W s w1 w2 t1 t2 : ℚ) :
    let w3 := -w1 - w2; let t3 := -t1 - t2
    let W1 := W / 3 + w1; let W2 := W / 3 + w2; let W3 := W / 3 + w3
    let e1 := s / 3 + t1; let e2 := s / 3 + t2; let e3 := s / 3 + t3
    let S := 1 - W - s
    let s1 := (1/3 : ℚ) + 2*W1 - W - e1; let s2 := (1/3 : ℚ) + 2*W2 - W - e2; let s3 := (1/3 : ℚ) + 2*W3 - W - e3
    let L1 := (2/3 : ℚ) - 2*W1 - (s - e1); let L2 := (2/3 : ℚ) - 2*W2 - (s - e2); let L3 := (2/3 : ℚ) - 2*W3 - (s - e3)
    let c1 := (1/3 : ℚ) + (s - e1); let c2 := (1/3 : ℚ) + (s - e2); let c3 := (1/3 : ℚ) + (s - e3)
    let q := w1^2 + w2^2 + w3^2; let p := t1^2 + t2^2 + t3^2; let m := w1*t1 + w2*t2 + w3*t3
    let rw_ := w1*w2*w3; let rt := t1*t2*t3
    let cw2t := w1^2*t1 + w2^2*t2 + w3^2*t3; let cwt2 := w1*t1^2 + w2*t2^2 + w3*t3^2
    20 * (W1 * (c1 * (s2 * s3 / 2 + (e2 + e3)^2 / 8) - (1/50) * L1) +
          W2 * (c2 * (s3 * s1 / 2 + (e3 + e1)^2 / 8) - (1/50) * L2) +
          W3 * (c3 * (s1 * s2 / 2 + (e1 + e2)^2 / 8) - (1/50) * L3)) +
    2 * S * (W * (s1 * W1 + s2 * W2 + s3 * W3) + (1/4) * (W1 * e1^2 + W2 * e2^2 + W3 * e3^2) +
             4 * W1 * W2 * W3 - (2/25) * W) =
    W * C0div_20 W s + Cq_20 W s * q + W * Cpdiv_20 W s * p + Cm_20 W s * m +
    Crw_20 W s * rw_ + (-18 * W * rtdiv_20 W s) * rt + (-B_20 W s) * cw2t +
    Cwt2_20 W s * cwt2 + Cqp_20 W s * q * p + Cm2_20 W s * m^2 + Cpm_20 W s * p * m := by
  dsimp only [C0div_20, Cpdiv_20, rtdiv_20, Cq_20, Crw_20, Cm_20, B_20, Cwt2_20, Cpm_20, Cqp_20, Cm2_20]
  ring

/-- Stage 3 (Universal Interior Refutation for ALL `i >= 2`):
    If `W_j + L_j >= 1/2` for all `j`, then `False`! -/
theorem stage3_interior_contra (hStage1 : ∀ j : Fin 3, 1 / 2 ≤ Wv S j + Lv S j) : False := by
  obtain ⟨hB1_A, hB1_B⟩ := stage2_no_boundary1 S hStage1
  have hH1_0 := H1_pos_of_interior S 0 (hStage1 0)
  have hH1_1 := H1_pos_of_interior S 1 (hStage1 1)
  have hH1_2 := H1_pos_of_interior S 2 (hStage1 2)
  have hH2 := H2_pos_of_no_boundary1 S hB1_A hB1_B
  -- Establish polygon P: 0 <= s < 1/12, max(1/5, 3*s) < W_G < 1/3 + s
  set W := WG S
  set s := sv S
  have hW_gt : 1 / 5 < W := WG_gt S
  have hW_pos : 0 < W := by linarith
  have hs_nn : 0 ≤ s := add_nonneg (S.hw_nonneg (.inr 0)) (S.hw_nonneg (.inr 1))
  have hs_lt : s < 1 / 12 := sv_lt_twelfth_of_interior S (hStage1 0)
  have hW_lt : W < 1 / 3 + s := WG_lt_third_add_s S
  have hW1_gt : s < W1 S := Wv_gt_s S 0
  have hW2_gt : s < W2 S := Wv_gt_s S 1
  have hW3_gt : s < W3 S := Wv_gt_s S 2
  have hW_gt_3s : 3 * s < W := by simp only [W, WG]; linarith
  have hS_pos : 0 < Stot S := by rw [Stot_eq S]; linarith
  -- Upper bound E_j <= sig_k*sig_l/2 + r_j^2/8 and -T*(T+d_j) <= eps_j^2/4!
  have hEv0 : Ev S 0 ≤ sig S 1 * sig S 2 / 2 + rv S 0 ^ 2 / 8 := by
    have h := Ev_le S 0 1 2 (by decide) (by decide) (by decide)
    have hL : Lv S 0 = sig S 1 + sig S 2 := by simp [Lv, sig, av, uv, Stot]; ring
    have hsq : 0 ≤ zv S 0 ^ 2 := sq_nonneg _
    rw [hL] at h; linarith
  have hEv1 : Ev S 1 ≤ sig S 2 * sig S 0 / 2 + rv S 1 ^ 2 / 8 := by
    have h := Ev_le S 1 2 0 (by decide) (by decide) (by decide)
    have hL : Lv S 1 = sig S 2 + sig S 0 := by simp [Lv, sig, av, uv, Stot]; ring
    have hsq : 0 ≤ zv S 1 ^ 2 := sq_nonneg _
    rw [hL] at h; linarith
  have hEv2 : Ev S 2 ≤ sig S 0 * sig S 1 / 2 + rv S 2 ^ 2 / 8 := by
    have h := Ev_le S 2 0 1 (by decide) (by decide) (by decide)
    have hL : Lv S 2 = sig S 0 + sig S 1 := by simp [Lv, sig, av, uv, Stot]; ring
    have hsq : 0 ≤ zv S 2 ^ 2 := sq_nonneg _
    rw [hL] at h; linarith
  have hTd_le : ∀ j : Fin 3, -(Tv S * (Tv S + dv S j)) ≤ eps S j ^ 2 / 4 := by
    intro j
    have hd := dv_abs_lt S j
    have hsq : dv S j ^ 2 ≤ eps S j ^ 2 := by nlinarith
    have hcomp : -(Tv S * (Tv S + dv S j)) ≤ dv S j ^ 2 / 4 := by
      nlinarith [sq_nonneg (Tv S + dv S j / 2)]
    linarith
  have hF_pos_gen : ∀ c : ℚ, 0 < c →
      0 < c * (W1 S * ((1 / 3 + rv S 0) * (sig S 1 * sig S 2 / 2 + (eps S 1 + eps S 2) ^ 2 / 8) - (1 / 50) * Lv S 0) +
               W2 S * ((1 / 3 + rv S 1) * (sig S 2 * sig S 0 / 2 + (eps S 2 + eps S 0) ^ 2 / 8) - (1 / 50) * Lv S 1) +
               W3 S * ((1 / 3 + rv S 2) * (sig S 0 * sig S 1 / 2 + (eps S 0 + eps S 1) ^ 2 / 8) - (1 / 50) * Lv S 2)) +
          2 * Stot S * (W * (sig S 0 * W1 S + sig S 1 * W2 S + sig S 2 * W3 S) +
                        (1 / 4) * (W1 S * eps S 0 ^ 2 + W2 S * eps S 1 ^ 2 + W3 S * eps S 2 ^ 2) +
                        4 * W1 S * W2 S * W3 S - (2 / 25) * W) := by
    intro c hc
    have hsum_e := eps_sum S
    have hr0 : rv S 0 = eps S 1 + eps S 2 := by simp only [rv]; linarith
    have hr1 : rv S 1 = eps S 2 + eps S 0 := by simp only [rv]; linarith
    have hr2 : rv S 2 = eps S 0 + eps S 1 := by simp only [rv]; linarith
    have hW1_pos : 0 < W1 S := by linarith
    have hW2_pos : 0 < W2 S := by linarith
    have hW3_pos : 0 < W3 S := by linarith
    have hc0 : 0 < 1 / 3 + rv S 0 := by have := rv_pos S 0; linarith
    have hc1 : 0 < 1 / 3 + rv S 1 := by have := rv_pos S 1; linarith
    have hc2 : 0 < 1 / 3 + rv S 2 := by have := rv_pos S 2; linarith
    have hP0 : 0 < (1 / 3 + rv S 0) * (sig S 1 * sig S 2 / 2 + (eps S 1 + eps S 2) ^ 2 / 8) - (1 / 50) * Lv S 0 := by
      rw [← hr0]; nlinarith only [hH1_0, hEv0, hc0]
    have hP1 : 0 < (1 / 3 + rv S 1) * (sig S 2 * sig S 0 / 2 + (eps S 2 + eps S 0) ^ 2 / 8) - (1 / 50) * Lv S 1 := by
      rw [← hr1]; nlinarith only [hH1_1, hEv1, hc1]
    have hP2 : 0 < (1 / 3 + rv S 2) * (sig S 0 * sig S 1 / 2 + (eps S 0 + eps S 1) ^ 2 / 8) - (1 / 50) * Lv S 2 := by
      rw [← hr2]; nlinarith only [hH1_2, hEv2, hc2]
    have hP2_pos : 0 < W * (sig S 0 * W1 S + sig S 1 * W2 S + sig S 2 * W3 S) +
        (1 / 4) * (W1 S * eps S 0 ^ 2 + W2 S * eps S 1 ^ 2 + W3 S * eps S 2 ^ 2) +
        4 * W1 S * W2 S * W3 S - (2 / 25) * W := by
      have ht0 := hTd_le 0; have ht1 := hTd_le 1; have ht2 := hTd_le 2
      have h1 : -(Tv S * ((Tv S + dv S 0) * W1 S + (Tv S + dv S 1) * W2 S + (Tv S + dv S 2) * W3 S)) ≤
          (1 / 4) * (W1 S * eps S 0 ^ 2 + W2 S * eps S 1 ^ 2 + W3 S * eps S 2 ^ 2) := by
        nlinarith only [ht0, ht1, ht2, hW1_pos, hW2_pos, hW3_pos]
      linarith only [hH2, h1]
    have hP1_pos : 0 < W1 S * ((1 / 3 + rv S 0) * (sig S 1 * sig S 2 / 2 + (eps S 1 + eps S 2) ^ 2 / 8) - (1 / 50) * Lv S 0) +
        W2 S * ((1 / 3 + rv S 1) * (sig S 2 * sig S 0 / 2 + (eps S 2 + eps S 0) ^ 2 / 8) - (1 / 50) * Lv S 1) +
        W3 S * ((1 / 3 + rv S 2) * (sig S 0 * sig S 1 / 2 + (eps S 0 + eps S 1) ^ 2 / 8) - (1 / 50) * Lv S 2) :=
      add_pos (add_pos (mul_pos hW1_pos hP0) (mul_pos hW2_pos hP1)) (mul_pos hW3_pos hP2)
    exact add_pos (mul_pos hc hP1_pos) (mul_pos (mul_pos two_pos hS_pos) hP2_pos)
  -- Centered variables w_j = W_j - W/3 and t_j = eps_j - s/3
  set w1 := W1 S - W / 3; set w2 := W2 S - W / 3; set w3 := W3 S - W / 3
  set t1 := eps S 0 - s / 3; set t2 := eps S 1 - s / 3; set t3 := eps S 2 - s / 3
  have hw_sum : w1 + w2 + w3 = 0 := by simp only [w1, w2, w3, W, WG]; ring
  have ht_sum : t1 + t2 + t3 = 0 := by have := eps_sum S; simp only [t1, t2, t3, s]; linarith
  have ht_rng : ∀ j : Fin 3, -(s / 3) ≤ eps S j - s / 3 ∧ eps S j - s / 3 ≤ 2 * s / 3 := by
    intro j; have he := eps_pos S j; have hr := rv_pos S j; simp only [rv] at hr; constructor <;> linarith only [he, hr]
  -- Box bounds for w_j:
  -- Lower 1: w_j >= -(W/3 - s) (since W_j > s)
  -- Lower 2: w_j >= -(1/3 - 2*W/3) (since W_k, W_l < 1/6 => W_j = W - W_k - W_l > W - 1/3)
  -- Upper 1: w_j <= 2/45 + 2*s/3 (Theorem A)
  -- Upper 2: w_j <= 1/6 - W/3 (since W_j + r_j <= 1/6 => W_j < 1/6)
  have hW_lt_sixth : ∀ j : Fin 3, Wv S j < 1 / 6 := by
    intro j; have h1 := hStage1 j; have h2 := Lv_eq S j; have h3 := rv_pos S j; linarith only [h1, h2, h3]
  have hw_lo_i2 : ∀ j : Fin 3, -(W / 3 - s) ≤ Wv S j - W / 3 := by
    intro j; have h := Wv_gt_s S j; linarith only [h]
  have hw_lo_2bc : ∀ j : Fin 3, -(1 / 3 - 2 * W / 3) ≤ Wv S j - W / 3 := by
    intro j; have h0 := hW_lt_sixth 0; have h1 := hW_lt_sixth 1; have h2 := hW_lt_sixth 2
    rcases fin3_cases j with rfl | rfl | rfl <;> (simp only [W, WG, W1, W2, W3] at *; linarith only [h0, h1, h2])
  have hw_hi_thA : ∀ j : Fin 3, Wv S j - W / 3 ≤ 2 / 45 + 2 * s / 3 := by
    intro j; have h := w_dev_lt_thA S j; linarith only [h]
  have hw_hi_cap : ∀ j : Fin 3, Wv S j - W / 3 ≤ 1 / 6 - W / 3 := by
    intro j; have h := hW_lt_sixth j; linarith only [h]
  -- Connect F_pos_gen to the 11-term expansions F6_23_eq and F6_20_eq
  have hF23_pos : 0 < W * C0div_23 W s + Cq_23 W s * (w1^2 + w2^2 + w3^2) + W * Cpdiv_23 W s * (t1^2 + t2^2 + t3^2) +
      Cm_23 W s * (w1*t1 + w2*t2 + w3*t3) + Crw_23 W s * (w1*w2*w3) + (-18 * W * rtdiv_23 W s) * (t1*t2*t3) +
      (-B_23 W s) * (w1^2*t1 + w2^2*t2 + w3^2*t3) + Cwt2_23 W s * (w1*t1^2 + w2*t2^2 + w3*t3^2) +
      Cqp_23 W s * (w1^2 + w2^2 + w3^2) * (t1^2 + t2^2 + t3^2) +
      Cm2_23 W s * (w1*t1 + w2*t2 + w3*t3)^2 + Cpm_23 W s * (t1^2 + t2^2 + t3^2) * (w1*t1 + w2*t2 + w3*t3) := by
    have hpos := hF_pos_gen 23 (by norm_num)
    have hid := F6_23_eq W s w1 w2 t1 t2
    have hw3e : w3 = -w1 - w2 := by linarith only [hw_sum]
    have ht3e : t3 = -t1 - t2 := by linarith only [ht_sum]
    have hW1e : W1 S = W / 3 + w1 := by simp only [w1]; ring
    have hW2e : W2 S = W / 3 + w2 := by simp only [w2]; ring
    have hW3e : W3 S = W / 3 + (-w1 - w2) := by rw [← hw3e]; simp only [w3]; ring
    have he1e : eps S 0 = s / 3 + t1 := by simp only [t1]; ring
    have he2e : eps S 1 = s / 3 + t2 := by simp only [t2]; ring
    have he3e : eps S 2 = s / 3 + (-t1 - t2) := by rw [← ht3e]; simp only [t3]; ring
    have hSe : Stot S = 1 - W - s := Stot_eq S
    have hs1e : sig S 0 = 1/3 + 2 * W1 S - W - eps S 0 := sig_eq S 0
    have hs2e : sig S 1 = 1/3 + 2 * W2 S - W - eps S 1 := sig_eq S 1
    have hs3e : sig S 2 = 1/3 + 2 * W3 S - W - eps S 2 := sig_eq S 2
    have hL1e : Lv S 0 = 2/3 - 2 * W1 S - (s - eps S 0) := Lv_eq S 0
    have hL2e : Lv S 1 = 2/3 - 2 * W2 S - (s - eps S 1) := Lv_eq S 1
    have hL3e : Lv S 2 = 2/3 - 2 * W3 S - (s - eps S 2) := Lv_eq S 2
    have hr0e : rv S 0 = s - eps S 0 := rfl
    have hr1e : rv S 1 = s - eps S 1 := rfl
    have hr2e : rv S 2 = s - eps S 2 := rfl
