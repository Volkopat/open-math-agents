namespace Erdos128Vega

open Finset SimpleGraph Erdos128ThmJ Erdos128ThmJ1Certs

/-- Vertex type for the ambient full Vega graph `Upsilon_i`: `Gamma_i = Fin (3*i - 1)` plus `Q_3^+ = Fin 8`
    (`0=x, 1=y, 2=a, 3=b, 4=c, 5=u, 6=v, 7=w`). -/
abbrev VegaV (i : ℕ) : Type := Fin (3 * i - 1) ⊕ Fin 8

/-- Active vertices of the 4 Vega variants: `dy` deletes `y` (`inr 1`), `de` deletes `2*i - 1` (`inl (2*i-1)`). -/
def vegaActive (i : ℕ) (dy de : Bool) : VegaV i → Prop
  | Sum.inl k => ¬ (de = true ∧ k.val = 2 * i - 1)
  | Sum.inr j => ¬ (dy = true ∧ j.val = 1)

instance (i : ℕ) (dy de : Bool) : DecidablePred (vegaActive i dy de) := fun v => by
  cases v with
  | inl k => unfold vegaActive; infer_instance
  | inr j => unfold vegaActive; infer_instance

/-- Adjacency relation of the full Vega graph `Upsilon_i` (`i >= 2`). -/
def vegaAdj (i : ℕ) : VegaV i → VegaV i → Prop
  | Sum.inl p, Sum.inl q =>
      let N := 3 * i - 1
      let d := (q.val + N - p.val) % N
      i ≤ d ∧ d ≤ 2 * i - 1
  | Sum.inl p, Sum.inr q =>
      (p.val < i ∧ (q.val = 2 ∨ q.val = 5)) ∨
      (i ≤ p.val ∧ p.val < 2 * i ∧ (q.val = 3 ∨ q.val = 6)) ∨
      (2 * i ≤ p.val ∧ (q.val = 4 ∨ q.val = 7))
  | Sum.inr q, Sum.inl p =>
      (p.val < i ∧ (q.val = 2 ∨ q.val = 5)) ∨
      (i ≤ p.val ∧ p.val < 2 * i ∧ (q.val = 3 ∨ q.val = 6)) ∨
      (2 * i ≤ p.val ∧ (q.val = 4 ∨ q.val = 7))
  | Sum.inr p, Sum.inr q =>
      (p.val = 0 ∧ (q.val = 1 ∨ q.val = 2 ∨ q.val = 3 ∨ q.val = 4)) ∨
      (q.val = 0 ∧ (p.val = 1 ∨ p.val = 2 ∨ p.val = 3 ∨ p.val = 4)) ∨
      (p.val = 1 ∧ (q.val = 5 ∨ q.val = 6 ∨ q.val = 7)) ∨
      (q.val = 1 ∧ (p.val = 5 ∨ p.val = 6 ∨ p.val = 7)) ∨
      (p.val = 2 ∧ (q.val = 6 ∨ q.val = 7)) ∨ (q.val = 2 ∧ (p.val = 6 ∨ p.val = 7)) ∨
      (p.val = 3 ∧ (q.val = 5 ∨ q.val = 7)) ∨ (q.val = 3 ∧ (p.val = 5 ∨ p.val = 7)) ∨
      (p.val = 4 ∧ (q.val = 5 ∨ q.val = 6)) ∨ (q.val = 4 ∧ (p.val = 5 ∨ p.val = 6))

instance (i : ℕ) : DecidableRel (vegaAdj i) := fun u v => by
  cases u <;> cases v <;> unfold vegaAdj <;> infer_instance

lemma vegaAdj_symm {i : ℕ} (hi : 2 ≤ i) {u v : VegaV i} (h : vegaAdj i u v) : vegaAdj i v u := by
  cases u with
  | inl p =>
    cases v with
    | inl q =>
      simp only [vegaAdj] at h ⊢
      have hp := p.isLt; have hq := q.isLt
      have hN : 0 < 3 * i - 1 := by omega
      by_cases hpq : p.val ≤ q.val
      · have h1 : (q.val + (3 * i - 1) - p.val) % (3 * i - 1) = q.val - p.val := by
          have : q.val + (3 * i - 1) - p.val = (q.val - p.val) + (3 * i - 1) := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        rw [h1] at h
        have hlt : p.val < q.val := by omega
        have h2 : (p.val + (3 * i - 1) - q.val) % (3 * i - 1) = (3 * i - 1) - (q.val - p.val) := by
          have : p.val + (3 * i - 1) - q.val = (3 * i - 1) - (q.val - p.val) := by omega
          rw [this, Nat.mod_eq_of_lt (by omega)]
        rw [h2]; omega
      · have h1 : (q.val + (3 * i - 1) - p.val) % (3 * i - 1) = (3 * i - 1) - (p.val - q.val) := by
          have : q.val + (3 * i - 1) - p.val = (3 * i - 1) - (p.val - q.val) := by omega
          rw [this, Nat.mod_eq_of_lt (by omega)]
        rw [h1] at h
        have h2 : (p.val + (3 * i - 1) - q.val) % (3 * i - 1) = p.val - q.val := by
          have : p.val + (3 * i - 1) - q.val = (p.val - q.val) + (3 * i - 1) := by omega
          rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
        rw [h2]; omega
    | inr q => exact h
  | inr p =>
    cases v with
    | inl q => exact h
    | inr q =>
      fin_cases p <;> fin_cases q <;> simp_all [vegaAdj]

lemma vegaAdj_irrefl {i : ℕ} (hi : 2 ≤ i) (u : VegaV i) : ¬ vegaAdj i u u := by
  cases u with
  | inl p =>
    simp only [vegaAdj]
    have hp := p.isLt
    have h1 : (p.val + (3 * i - 1) - p.val) % (3 * i - 1) = 0 := by
      have : p.val + (3 * i - 1) - p.val = 3 * i - 1 := by omega
      rw [this, Nat.mod_self]
    rw [h1]; omega
  | inr p =>
    fin_cases p <;> simp [vegaAdj]

lemma vegaAdj_gamma_triangleFree {i : ℕ} (hi : 2 ≤ i) {p q r : Fin (3 * i - 1)}
    (hpq : vegaAdj i (.inl p) (.inl q))
    (hqr : vegaAdj i (.inl q) (.inl r))
    (hrp : vegaAdj i (.inl r) (.inl p)) : False := by
  simp only [vegaAdj] at hpq hqr hrp
  have hp := p.isLt; have hq := q.isLt; have hr := r.isLt
  let N := 3 * i - 1
  let d1 := (q.val + N - p.val) % N
  let d2 := (r.val + N - q.val) % N
  let d3 := (p.val + N - r.val) % N
  have hd1 : i ≤ d1 ∧ d1 ≤ 2 * i - 1 := hpq
  have hd2 : i ≤ d2 ∧ d2 ≤ 2 * i - 1 := hqr
  have hd3 : i ≤ d3 ∧ d3 ≤ 2 * i - 1 := hrp
  have hmod : (d1 + d2 + d3) % N = 0 := by
    have hsum : (q.val + N - p.val) + (r.val + N - q.val) + (p.val + N - r.val) = 3 * N := by omega
    have h1 : (d1 + d2 + d3) % N = ((q.val + N - p.val) + (r.val + N - q.val) + (p.val + N - r.val)) % N := by
      simp only [d1, d2, d3, Nat.add_mod, Nat.mod_mod]
    rw [h1, hsum, Nat.mul_mod_left]
  have h1 : N < d1 + d2 + d3 := by omega
  have h2 : d1 + d2 + d3 < 2 * N := by omega
  have h3 : (d1 + d2 + d3) % N = d1 + d2 + d3 - N := by
    have : d1 + d2 + d3 = (d1 + d2 + d3 - N) + N := by omega
    conv_lhs => rw [this]
    rw [Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
  omega

/-- A graph `H` on `U` belongs to the 4-variant closed Vega class `V_i(dy, de)`. -/
def IsVegaGraph {U : Type} (H : SimpleGraph U) (i : ℕ) (dy de : Bool) : Prop :=
  2 ≤ i ∧ ∃ e : U ≃ {v : VegaV i // vegaActive i dy de v},
    ∀ u v : U, H.Adj u v ↔ vegaAdj i (e u).1 (e v).1

/-- Rational weighted Vega blowup counterexample system (decoupled from ambient graph `M`). -/
structure VegaSystem (i : ℕ) (dy de : Bool) where
  hi : 2 ≤ i
  w : VegaV i → ℚ
  hw_nonneg : ∀ z, 0 ≤ w z
  hw_zero : ∀ z, ¬ vegaActive i dy de z → w z = 0
  hw_sum : ∑ z : VegaV i, w z = 1
  hdeg : ∀ z, vegaActive i dy de z → (1 / 3 : ℚ) < ∑ u : VegaV i, if vegaAdj i z u then w u else 0
  hindep : ∀ S : Finset (VegaV i), (∀ a ∈ S, ∀ b ∈ S, ¬ vegaAdj i a b) → ∑ z ∈ S, w z < 2 / 5
  hfrac : ∀ t : VegaV i → ℚ, (∀ z, 0 ≤ t z ∧ t z ≤ 1) → (∑ z : VegaV i, t z * w z = 1 / 2) →
    (1 / 25 : ℚ) < ∑ u : VegaV i, ∑ v : VegaV i, if vegaAdj i u v then t u * t v * w u * w v else 0
  havg : ∀ A B : Finset (VegaV i), Disjoint A B →
    (∀ a ∈ B, ∀ b ∈ B, ¬ vegaAdj i a b) →
    (0 < ∑ z ∈ B, w z) →
    (∑ z ∈ A, w z ≤ 1 / 2) →
    (1 / 2 ≤ ∑ z ∈ A, w z + ∑ z ∈ B, w z) →
    (1 / 25 : ℚ) * (∑ z ∈ B, w z) <
      (∑ z ∈ B, w z) * (∑ u ∈ A, ∑ v ∈ A, if vegaAdj i u v then w u * w v else 0) +
      2 * ((1 / 2 : ℚ) - ∑ z ∈ A, w z) * (∑ u ∈ A, ∑ v ∈ B, if vegaAdj i u v then w u * w v else 0)

/-- Transport a `VegaSystem` along an active-to-active graph isomorphism `f : VegaV i ≃ VegaV i`. -/
def VegaSystem.transport {i : ℕ} {dy de dy' de' : Bool} (S : VegaSystem i dy de)
    (f : VegaV i ≃ VegaV i)
    (hact : ∀ z, vegaActive i dy' de' (f z) ↔ vegaActive i dy de z)
    (hadj : ∀ u v, vegaActive i dy de u → vegaActive i dy de v →
      (vegaAdj i (f u) (f v) ↔ vegaAdj i u v)) :
    VegaSystem i dy' de' where
  hi := S.hi
  w := fun z => S.w (f.symm z)
  hw_nonneg := fun z => S.hw_nonneg (f.symm z)
  hw_zero := fun z hz => S.hw_zero (f.symm z) (by
    intro ha; apply hz; have := (hact (f.symm z)).mpr ha; simpa using this)
  hw_sum := by
    rw [Equiv.sum_comp f.symm S.w]
    exact S.hw_sum
  hdeg := fun z hz => by
    have hz' : vegaActive i dy de (f.symm z) := (hact (f.symm z)).mp (by simpa using hz)
    have h1 := S.hdeg (f.symm z) hz'
    have h2 : ∑ u : VegaV i, (if vegaAdj i z u then S.w (f.symm u) else 0) =
        ∑ u : VegaV i, if vegaAdj i (f.symm z) u then S.w u else 0 := by
      rw [← Equiv.sum_comp f]
      apply Finset.sum_congr rfl
      intro u _
      by_cases hu : vegaActive i dy de u
      · have heq := hadj (f.symm z) u hz' hu
        simp only [Equiv.apply_symm_apply] at heq
        simp only [Equiv.symm_apply_apply, heq]
      · have h0 : S.w u = 0 := S.hw_zero u hu
        simp [Equiv.symm_apply_apply, h0]
    rw [h2]; exact h1
  hindep := fun T hT => by
    let T' : Finset (VegaV i) := (T.map f.symm.toEmbedding).filter (vegaActive i dy de)
    have hsum : ∑ z ∈ T, S.w (f.symm z) = ∑ z ∈ T', S.w z := by
      have h1 : ∑ z ∈ T, S.w (f.symm z) = ∑ z ∈ T.map f.symm.toEmbedding, S.w z := by
        rw [Finset.sum_map]; rfl
      rw [h1]; symm
      apply Finset.sum_subset (Finset.filter_subset _ _)
      intro z hz hnf
      simp only [Finset.mem_filter, not_and] at hnf
      exact S.hw_zero z (hnf hz)
    rw [hsum]
    apply S.hindep T'
    intro a ha b hb
    simp only [T', Finset.mem_filter, Finset.mem_map, Equiv.toEmbedding_apply] at ha hb
    obtain ⟨⟨a', ha'T, rfl⟩, ha_act⟩ := ha
    obtain ⟨⟨b', hb'T, rfl⟩, hb_act⟩ := hb
    have heq := hadj (f.symm a') (f.symm b') ha_act hb_act
    simp only [Equiv.apply_symm_apply] at heq
    rw [← heq]
    exact hT a' ha'T b' hb'T
  hfrac := fun t ht hsum => by
    have hsum' : ∑ z : VegaV i, t (f z) * S.w z = 1 / 2 := by
      calc ∑ z : VegaV i, t (f z) * S.w z
          = ∑ z : VegaV i, t (f z) * S.w (f.symm (f z)) := by simp
        _ = ∑ y : VegaV i, t y * S.w (f.symm y) := Equiv.sum_comp f (fun y => t y * S.w (f.symm y))
        _ = 1 / 2 := hsum
    have h1 := S.hfrac (fun z => t (f z)) (fun z => ht (f z)) hsum'
    have h2 : ∑ u : VegaV i, ∑ v : VegaV i, (if vegaAdj i u v then t u * t v * S.w (f.symm u) * S.w (f.symm v) else 0) =
        ∑ u : VegaV i, ∑ v : VegaV i, if vegaAdj i u v then t (f u) * t (f v) * S.w u * S.w v else 0 := by
      rw [← Equiv.sum_comp f]
      apply Finset.sum_congr rfl
      intro u _
      rw [← Equiv.sum_comp f]
      apply Finset.sum_congr rfl
      intro v _
      by_cases hu : vegaActive i dy de u
      · by_cases hv : vegaActive i dy de v
        · simp [hadj u v hu hv]
        · simp [S.hw_zero v hv]
      · simp [S.hw_zero u hu]
    rw [h2]; exact h1
  havg := fun A B hdisj hB hBpos hAle hABge => by
    let A' : Finset (VegaV i) := (A.map f.symm.toEmbedding).filter (vegaActive i dy de)
    let B' : Finset (VegaV i) := (B.map f.symm.toEmbedding).filter (vegaActive i dy de)
    have hdisj' : Disjoint A' B' := by
      rw [Finset.disjoint_left]
      intro z hzA hzB
      simp only [A', B', Finset.mem_filter, Finset.mem_map, Equiv.toEmbedding_apply] at hzA hzB
      obtain ⟨⟨a, haA, rfl⟩, _⟩ := hzA
      obtain ⟨⟨b, hbB, heq⟩, _⟩ := hzB
      have hab : a = b := f.symm.injective heq.symm
      exact Finset.disjoint_left.mp hdisj haA (hab ▸ hbB)
    have hB' : ∀ a ∈ B', ∀ b ∈ B', ¬ vegaAdj i a b := by
      intro a ha b hb
      simp only [B', Finset.mem_filter, Finset.mem_map, Equiv.toEmbedding_apply] at ha hb
      obtain ⟨⟨a', ha'B, rfl⟩, ha_act⟩ := ha
      obtain ⟨⟨b', hb'B, rfl⟩, hb_act⟩ := hb
      have heq := hadj (f.symm a') (f.symm b') ha_act hb_act
      simp only [Equiv.apply_symm_apply] at heq
      rw [← heq]
      exact hB a' ha'B b' hb'B
    have hsum_act : ∀ X : Finset (VegaV i), ∑ z ∈ X, S.w (f.symm z) =
        ∑ z ∈ (X.map f.symm.toEmbedding).filter (vegaActive i dy de), S.w z := by
      intro X
      have h1 : ∑ z ∈ X, S.w (f.symm z) = ∑ z ∈ X.map f.symm.toEmbedding, S.w z := by
        rw [Finset.sum_map]; rfl
      rw [h1]; symm; apply Finset.sum_subset (Finset.filter_subset _ _)
      intro z hz hnf; simp only [Finset.mem_filter, not_and] at hnf; exact S.hw_zero z (hnf hz)
    have hsumA : ∑ z ∈ A, S.w (f.symm z) = ∑ z ∈ A', S.w z := hsum_act A
    have hsumB : ∑ z ∈ B, S.w (f.symm z) = ∑ z ∈ B', S.w z := hsum_act B
    have hmap : ∀ X Y : Finset (VegaV i),
        ∑ u ∈ X, ∑ v ∈ Y, (if vegaAdj i u v then S.w (f.symm u) * S.w (f.symm v) else 0) =
        ∑ u ∈ (X.map f.symm.toEmbedding).filter (vegaActive i dy de),
          ∑ v ∈ (Y.map f.symm.toEmbedding).filter (vegaActive i dy de),
            if vegaAdj i u v then S.w u * S.w v else 0 := by
      intro X Y
      have h1 : ∑ u ∈ X, ∑ v ∈ Y, (if vegaAdj i u v then S.w (f.symm u) * S.w (f.symm v) else 0) =
          ∑ u ∈ X.map f.symm.toEmbedding, ∑ v ∈ Y, if vegaAdj i (f u) v then S.w u * S.w (f.symm v) else 0 := by
        rw [Finset.sum_map]; apply Finset.sum_congr rfl; intro u _; simp
      rw [h1]; symm
      rw [← Finset.sum_subset (Finset.filter_subset (vegaActive i dy de) (X.map f.symm.toEmbedding))]
      · apply Finset.sum_congr rfl; intro u _
        by_cases hu_act : vegaActive i dy de u
        · have h2 : ∑ v ∈ Y, (if vegaAdj i (f u) v then S.w u * S.w (f.symm v) else 0) =
              ∑ v ∈ Y.map f.symm.toEmbedding, if vegaAdj i (f u) (f v) then S.w u * S.w v else 0 := by
            rw [Finset.sum_map]; apply Finset.sum_congr rfl; intro v _; simp
          rw [h2]; symm
          rw [← Finset.sum_subset (Finset.filter_subset (vegaActive i dy de) (Y.map f.symm.toEmbedding))]
          · apply Finset.sum_congr rfl; intro v _
            by_cases hv_act : vegaActive i dy de v
            · simp [hadj u v hu_act hv_act]
            · simp [S.hw_zero v hv_act]
          · intro v hv hnf; simp only [Finset.mem_filter, not_and] at hnf; simp [S.hw_zero v (hnf hv)]
        · simp [S.hw_zero u hu_act]
      · intro u hu hnf; simp only [Finset.mem_filter, not_and] at hnf; simp [S.hw_zero u (hnf hu)]
    rw [hsumA, hsumB, hmap A A, hmap A B]
    exact S.havg A' B' hdisj' hB' (hsumB ▸ hBpos) (hsumA ▸ hAle) (hsumA ▸ hsumB ▸ hABge)

/-- Step 0: Exact finite-n blowup bridge from a maximal TF counterexample `M` with Vega quotient `H in V_i`
    to a rational `VegaSystem i dy de` (ZERO rounding loss!). -/
noncomputable def vegaSystem_of_quotient {V U : Type} [Fintype V] [Fintype U]
    (M : SimpleGraph V) (H : SimpleGraph U) (φ : M →g H)
    {i : ℕ} {dy de : Bool}
    (hn : 0 < Fintype.card V)
    (hMTF : M.CliqueFree 3)
    (hα : ∀ I : Set V, M.IsIndepSet I → 5 * I.ncard < 2 * Fintype.card V)
    (h3d : ∀ v : V, Fintype.card V < 3 * (M.neighborSet v).ncard)
    (hE : ∀ V' : Set V, 2 * V'.ncard + 1 ≥ Fintype.card V →
      50 * (M.induce V').edgeSet.ncard > Fintype.card V ^ 2)
    (hsurj : Function.Surjective φ)
    (hrefl : ∀ u v : V, M.Adj u v ↔ H.Adj (φ u) (φ v))
    (hVega : IsVegaGraph H i dy de) : VegaSystem i dy de := by
  classical
  set n := Fintype.card V
  have hnQ : (0 : ℚ) < (n : ℚ) := Nat.cast_pos.mpr hn
  have hi : 2 ≤ i := hVega.1
  let e : U ≃ {v : VegaV i // vegaActive i dy de v} := Classical.choose hVega.2
  have he : ∀ u v : U, H.Adj u v ↔ vegaAdj i (e u).1 (e v).1 := Classical.choose_spec hVega.2
  let ψ : V → VegaV i := fun v => (e (φ v)).1
  have hψ_adj : ∀ u v : V, M.Adj u v ↔ vegaAdj i (ψ u) (ψ v) := fun u v =>
    (hrefl u v).trans (he (φ u) (φ v))
  have hψ_act : ∀ v : V, vegaActive i dy de (ψ v) := fun v => (e (φ v)).2
  have hψ_surj : ∀ z : VegaV i, vegaActive i dy de z → ∃ v : V, ψ v = z := by
    intro z hz
    obtain ⟨v, hv⟩ := hsurj (e.symm ⟨z, hz⟩)
    exact ⟨v, by simp [ψ, hv]⟩
  let fib : VegaV i → ℕ := fun z => #(Finset.univ.filter (fun v : V => ψ v = z))
  let w : VegaV i → ℚ := fun z => (fib z : ℚ) / (n : ℚ)
  have hfib_sum : ∑ z : VegaV i, fib z = n := by
    have hpart := Finset.card_eq_sum_card_fiberwise
      (f := ψ) (s := (Finset.univ : Finset V)) (t := (Finset.univ : Finset (VegaV i)))
      (fun v _ => Finset.mem_univ _)
    simpa [fib, n] using hpart.symm
  have hw_nonneg : ∀ z, 0 ≤ w z := fun z => div_nonneg (Nat.cast_nonneg _) (le_of_lt hnQ)
  have hw_zero : ∀ z, ¬ vegaActive i dy de z → w z = 0 := by
    intro z hz
    have hf0 : fib z = 0 := by
      rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro v _ hv; exact hz (hv ▸ hψ_act v)
    simp [w, hf0]
  have hw_sum : ∑ z : VegaV i, w z = 1 := by
    simp only [w, ← Finset.sum_div]
    have : (∑ z : VegaV i, (fib z : ℚ)) = (n : ℚ) := by exact_mod_cast hfib_sum
    rw [this, div_self (ne_of_gt hnQ)]
  have hdeg : ∀ z, vegaActive i dy de z → (1 / 3 : ℚ) < ∑ u : VegaV i, if vegaAdj i z u then w u else 0 := by
    intro z hz
    obtain ⟨v0, hv0⟩ := hψ_surj z hz
    have hd_nat : n < 3 * #(Finset.univ.filter (M.Adj v0)) := by
      have h1 := h3d v0
      have hcard : (M.neighborSet v0).ncard = #(Finset.univ.filter (M.Adj v0)) := by
        rw [Set.ncard_eq_toFinset_card']
        congr 1; ext x; simp [SimpleGraph.mem_neighborSet]
      omega
    have hcard_eq : #(Finset.univ.filter (M.Adj v0)) = ∑ u : VegaV i, if vegaAdj i z u then fib u else 0 := by
      have hpart := Finset.card_eq_sum_card_fiberwise
        (f := ψ) (s := Finset.univ.filter (M.Adj v0)) (t := (Finset.univ : Finset (VegaV i)))
        (fun _ _ => Finset.mem_univ _)
      rw [hpart]
      apply Finset.sum_congr rfl
      intro u _
      by_cases hadj : vegaAdj i z u
      · rw [if_pos hadj]
        congr 1; ext x; simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        constructor
        · exact fun h => h.2
        · intro hxu; exact ⟨(hψ_adj v0 x).mpr (by rw [hv0, hxu]; exact hadj), hxu⟩
      · rw [if_neg hadj, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
        intro x hx hxu
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
        exact hadj (by rw [← hv0, ← hxu]; exact (hψ_adj v0 x).mp hx)
    have hQ : (n : ℚ) < 3 * ∑ u : VegaV i, if vegaAdj i z u then (fib u : ℚ) else 0 := by
      have hcast : (∑ u : VegaV i, if vegaAdj i z u then (fib u : ℚ) else 0) =
          ((∑ u : VegaV i, if vegaAdj i z u then fib u else 0 : ℕ) : ℚ) := by
        push_cast; apply Finset.sum_congr rfl; intro u _; split_ifs <;> simp
      rw [hcast, ← hcard_eq]; exact_mod_cast hd_nat
    have hsum_w : (∑ u : VegaV i, if vegaAdj i z u then w u else 0) =
        (∑ u : VegaV i, if vegaAdj i z u then (fib u : ℚ) else 0) / (n : ℚ) := by
      rw [Finset.sum_div]; apply Finset.sum_congr rfl; intro u _; split_ifs <;> simp [w]
    rw [hsum_w, div_lt_div_iff₀ (by norm_num : (0 : ℚ) < 3) hnQ]; linarith
  have hindep : ∀ S : Finset (VegaV i), (∀ a ∈ S, ∀ b ∈ S, ¬ vegaAdj i a b) → ∑ z ∈ S, w z < 2 / 5 := by
    intro S hS
    let I_fin : Finset V := Finset.univ.filter (fun v : V => ψ v ∈ S)
    have hI_indep : M.IsIndepSet (I_fin : Set V) := by
      intro x hx y hy _ hadj
      simp only [Finset.mem_coe, I_fin, Finset.mem_filter, Finset.mem_univ, true_and] at hx hy
      exact hS (ψ x) hx (ψ y) hy ((hψ_adj x y).mp hadj)
    have hI_card : #I_fin = ∑ z ∈ S, fib z := by
      have hpart := Finset.card_eq_sum_card_fiberwise
        (f := ψ) (s := I_fin) (t := S) (fun v hv => (Finset.mem_filter.mp hv).2)
      rw [hpart]
      apply Finset.sum_congr rfl
      intro z hz
      congr 1; ext v; simp only [I_fin, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨fun h => h.2, fun h => ⟨h ▸ hz, h⟩⟩
    have h5 := hα (I_fin : Set V) hI_indep
    rw [Set.ncard_coe_finset, hI_card] at h5
    have hQ : 5 * (∑ z ∈ S, (fib z : ℚ)) < 2 * (n : ℚ) := by exact_mod_cast h5
    have hsum_w : ∑ z ∈ S, w z = (∑ z ∈ S, (fib z : ℚ)) / (n : ℚ) := by
      simp only [w, ← Finset.sum_div]
    rw [hsum_w, div_lt_div_iff₀ hnQ (by norm_num : (0 : ℚ) < 5)]; linarith
  have hfrac : ∀ t : VegaV i → ℚ, (∀ z, 0 ≤ t z ∧ t z ≤ 1) → (∑ z : VegaV i, t z * w z = 1 / 2) →
      (1 / 25 : ℚ) < ∑ u : VegaV i, ∑ v : VegaV i, if vegaAdj i u v then t u * t v * w u * w v else 0 := by
    intro t ht htsum
    let D : ℕ := ∏ z : VegaV i, (t z).den
    have hD_pos : 1 ≤ D := Finset.one_le_prod' (fun z _ => (t z).pos)
    obtain ⟨M2, hM2_adj, _, hM2_E, _, _⟩ :=
      OMA.R_Erdos128_erdos_128_R2.blowup_counterexample M hMTF hE D hD_pos
    let q : VegaV i → ℕ := fun z => (D / (t z).den) * (t z).num.toNat
    have hq_le : ∀ z, q z ≤ D := by
      intro z
      have hdvd : (t z).den ∣ D := Finset.dvd_prod_of_mem _ (Finset.mem_univ z)
      have hnum_nn : 0 ≤ (t z).num := Rat.num_nonneg.mpr (ht z).1
      have hnum_le : (t z).num ≤ ((t z).den : ℤ) := by
        have h1 := (ht z).2
        rw [← Rat.num_div_den (t z)] at h1
        have hden_pos : (0 : ℚ) < ((t z).den : ℚ) := Nat.cast_pos.mpr (t z).pos
        have h2 : ((t z).num : ℚ) ≤ ((t z).den : ℚ) := (div_le_one hden_pos).mp h1
        exact_mod_cast h2
      have htoNat_le : (t z).num.toNat ≤ (t z).den := by omega
      calc q z = (D / (t z).den) * (t z).num.toNat := rfl
        _ ≤ (D / (t z).den) * (t z).den := Nat.mul_le_mul_left _ htoNat_le
        _ = D := Nat.div_mul_cancel hdvd
    have hq_eq : ∀ z, (q z : ℚ) = (D : ℚ) * t z := by
      intro z
      have hdvd : (t z).den ∣ D := Finset.dvd_prod_of_mem _ (Finset.mem_univ z)
      have hnum_nn : 0 ≤ (t z).num := Rat.num_nonneg.mpr (ht z).1
      have hden_ne : ((t z).den : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.pos_iff_ne_zero.mp (t z).pos)
      have hdiv_cast : ((D / (t z).den : ℕ) : ℚ) = (D : ℚ) / ((t z).den : ℚ) := Nat.cast_div hdvd hden_ne
      have hnum_cast : ((t z).num.toNat : ℚ) = ((t z).num : ℚ) := by
        exact_mod_cast Int.toNat_of_nonneg hnum_nn
      calc (q z : ℚ) = ((D / (t z).den : ℕ) : ℚ) * ((t z).num.toNat : ℚ) := by simp [q]
        _ = ((D : ℚ) / ((t z).den : ℚ)) * ((t z).num : ℚ) := by rw [hdiv_cast, hnum_cast]
        _ = (D : ℚ) * (((t z).num : ℚ) / ((t z).den : ℚ)) := by ring
        _ = (D : ℚ) * t z := by rw [Rat.num_div_den]
    let U_fin : Finset (V × Fin (2 * D)) := Finset.univ.filter (fun p => p.2.val < 2 * q (ψ p.1))
    have hU_card_v : ∀ v : V, #(Finset.univ.filter (fun r : Fin (2 * D) => r.val < 2 * q (ψ v))) = 2 * q (ψ v) := by
      intro v
      have hle : 2 * q (ψ v) ≤ 2 * D := by have := hq_le (ψ v); omega
      have hbij : #(Finset.univ.filter (fun r : Fin (2 * D) => r.val < 2 * q (ψ v))) = #(Finset.range (2 * q (ψ v))) := by
        refine Finset.card_bij (fun r _ => r.val) ?_ ?_ ?_
        · intro r hr; simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hr; exact Finset.mem_range.mpr hr
        · intro r1 _ r2 _ h; exact Fin.ext h
        · intro k hk
          have hklt : k < 2 * q (ψ v) := Finset.mem_range.mp hk
          exact ⟨⟨k, by omega⟩, by simp [hklt], rfl⟩
      rw [hbij, Finset.card_range]
    have hU_card : #U_fin = ∑ z : VegaV i, fib z * (2 * q z) := by
      have h1 : #U_fin = ∑ v : V, #(Finset.univ.filter (fun r : Fin (2 * D) => r.val < 2 * q (ψ v))) := by
        rw [← Finset.card_sigma]
        refine Finset.card_bij (fun p _ => ⟨p.1, p.2⟩) ?_ ?_ ?_
        · intro p hp; simp only [U_fin, Finset.mem_filter, Finset.mem_univ, true_and] at hp
          simp [hp]
        · intro p1 _ p2 _ h; cases p1; cases p2; simp at h; exact Prod.ext h.1 h.2
        · intro ⟨v, r⟩ hvr; simp at hvr; exact ⟨(v, r), by simp [U_fin, hvr], rfl⟩
      rw [h1]
      simp_rw [hU_card_v]
      have hpart := Finset.sum_fiberwise_of_maps_to (s := (Finset.univ : Finset V))
        (t := (Finset.univ : Finset (VegaV i))) (g := ψ) (f := fun v => 2 * q (ψ v))
        (fun _ _ => Finset.mem_univ _)
      rw [← hpart]
      apply Finset.sum_congr rfl
      intro z _
      have hcongr : ∑ v ∈ Finset.univ.filter (fun x => ψ x = z), 2 * q (ψ v) =
          ∑ _v ∈ Finset.univ.filter (fun x => ψ x = z), 2 * q z :=
        Finset.sum_congr rfl (fun v hv => by rw [(Finset.mem_filter.mp hv).2])
      rw [hcongr, Finset.sum_const, smul_eq_mul]
    have hU_half : 2 * #U_fin = Fintype.card (V × Fin (2 * D)) := by
      have hQ : (2 * (#U_fin : ℚ)) = ((2 * D * n : ℕ) : ℚ) := by
        have h1 : (#U_fin : ℚ) = ∑ z : VegaV i, (fib z : ℚ) * (2 * (q z : ℚ)) := by
          rw [hU_card]; push_cast; rfl
        rw [h1]
        have h2 : ∑ z : VegaV i, (fib z : ℚ) * (2 * (q z : ℚ)) = (2 * D * n : ℚ) * ∑ z : VegaV i, t z * w z := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro z _
          rw [hq_eq z]; dsimp only [w]
          field_simp [ne_of_gt hnQ]
        rw [h2, htsum]; push_cast; ring
      have hcard_prod : Fintype.card (V × Fin (2 * D)) = 2 * D * n := by
        simp [Fintype.card_prod, Fintype.card_fin, n, mul_comm]
      rw [hcard_prod]
      exact_mod_cast hQ
    have h50 := hM2_E (U_fin : Set (V × Fin (2 * D))) (by rw [Set.ncard_coe_finset]; omega)
    have hdir := OMA.R_Erdos128_erdos_128_R2.two_mul_induce_edgeSet_ncard M2 U_fin
    have h25 : (Fintype.card (V × Fin (2 * D))) ^ 2 < 25 * ∑ p ∈ U_fin, #(U_fin.filter (M2.Adj p)) := by omega
    -- Evaluate directed sum over U_fin in terms of fib and 2 * q
    have hdir_eq : ∑ p ∈ U_fin, #(U_fin.filter (M2.Adj p)) =
        ∑ u : VegaV i, ∑ v : VegaV i, if vegaAdj i u v then (fib u * (2 * q u)) * (fib v * (2 * q v)) else 0 := by
      have hstep1 : ∀ p ∈ U_fin, #(U_fin.filter (M2.Adj p)) =
          ∑ v : VegaV i, if vegaAdj i (ψ p.1) v then fib v * (2 * q v) else 0 := by
        intro p _
        have hsub : U_fin.filter (M2.Adj p) =
            U_fin.filter (fun p2 => vegaAdj i (ψ p.1) (ψ p2.1)) := by
          ext p2; simp only [Finset.mem_filter]
          exact and_congr_right (fun _ => (hM2_adj p.1 p.2 p2.1 p2.2).trans (hψ_adj p.1 p2.1))
        rw [hsub]
        have hpart := Finset.card_eq_sum_card_fiberwise
          (f := fun p2 : V × Fin (2 * D) => ψ p2.1)
          (s := U_fin.filter (fun p2 => vegaAdj i (ψ p.1) (ψ p2.1)))
          (t := (Finset.univ : Finset (VegaV i))) (fun _ _ => Finset.mem_univ _)
        rw [hpart]
        apply Finset.sum_congr rfl
        intro v _
        by_cases hadj : vegaAdj i (ψ p.1) v
        · rw [if_pos hadj]
          have hset : (U_fin.filter (fun p2 => vegaAdj i (ψ p.1) (ψ p2.1))).filter (fun p2 => ψ p2.1 = v) =
              (Finset.univ.filter (fun x : V => ψ x = v)) ×ˢ (Finset.univ.filter (fun r : Fin (2 * D) => r.val < 2 * q v)) := by
            ext ⟨x, r⟩
            simp only [U_fin, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_product]
            constructor
            · rintro ⟨⟨hr, _⟩, rfl⟩; exact ⟨rfl, hr⟩
            · rintro ⟨rfl, hr⟩; exact ⟨⟨hr, hadj⟩, rfl⟩
          rw [hset, Finset.card_product]
          have hrcard : #(Finset.univ.filter (fun r : Fin (2 * D) => r.val < 2 * q v)) = 2 * q v := by
            have hle : 2 * q v ≤ 2 * D := by have := hq_le v; omega
            have hbij : #(Finset.univ.filter (fun r : Fin (2 * D) => r.val < 2 * q v)) = #(Finset.range (2 * q v)) := by
              refine Finset.card_bij (fun r _ => r.val) ?_ ?_ ?_
              · intro r hr; simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hr; exact Finset.mem_range.mpr hr
              · intro r1 _ r2 _ h; exact Fin.ext h
              · intro k hk; have hklt := Finset.mem_range.mp hk; exact ⟨⟨k, by omega⟩, by simp [hklt], rfl⟩
            rw [hbij, Finset.card_range]
          rw [hrcard]
        · rw [if_neg hadj, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
          intro p2 hp2 hv; simp only [Finset.mem_filter] at hp2; exact hadj (hv ▸ hp2.2)
      rw [Finset.sum_congr rfl hstep1]
      have hpart := Finset.sum_fiberwise_of_maps_to (s := U_fin) (t := (Finset.univ : Finset (VegaV i)))
        (g := fun p : V × Fin (2 * D) => ψ p.1)
        (f := fun p => ∑ v : VegaV i, if vegaAdj i (ψ p.1) v then fib v * (2 * q v) else 0)
        (fun _ _ => Finset.mem_univ _)
      rw [← hpart]
      apply Finset.sum_congr rfl
      intro u _
      have hcongr : ∑ p ∈ U_fin.filter (fun p => ψ p.1 = u),
            (∑ v : VegaV i, if vegaAdj i (ψ p.1) v then fib v * (2 * q v) else 0) =
          ∑ _p ∈ U_fin.filter (fun p => ψ p.1 = u),
