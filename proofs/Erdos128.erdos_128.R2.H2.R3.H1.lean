    rw [Fin.sum_univ_eight]; simp [vegaAdj, qx, qv, qw]
  have hG : ∑ p : Fin (3 * i - 1), (if vegaAdj i (.inr 2) (.inl p) then S.w (.inl p) else 0) = W1 S := by
    simp only [W1, Wv, Ij, I1, Finset.sum_filter]
    rw [Fintype.sum_sum_type]
    have hz : ∑ q : Fin 8, (if inI1 i (.inr q) = true then S.w (.inr q) else 0) = 0 := by simp [inI1]
    rw [hz, add_zero]
    apply Finset.sum_congr rfl; intro p _; simp [vegaAdj, inI1]
