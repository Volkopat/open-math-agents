lemma all_parts : (Ts (fun x => Ts (fun y => tab0 (x * 64 + y))) == 72) = true ∧ (Ts (fun x => Ts (fun y => tab1 (x * 64 + y))) == 93) = true ∧ (Ts (fun x => Ts (fun y => tab2 (x * 64 + y))) == 218) = true ∧ (Ts (fun x => Ts (fun y => tab3 (x * 64 + y))) == 471) = true ∧ (Ts (fun x => Ts (fun y => tab4 (x * 64 + y))) == 932) = true ∧ (Ts (fun x => Ts (fun y => tab5 (x * 64 + y))) == 1725) = true ∧ (Ts (fun x => Ts (fun y => tab6 (x * 64 + y))) == 3011) = true ∧ (Ts (fun x => Ts (fun y => tab7 (x * 64 + y))) == 5014) = true ∧ (Ts (fun x => Ts (fun y => tab8 (x * 64 + y))) == 8016) = true := by
