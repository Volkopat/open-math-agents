import OMAStatements.S_oeis_a206264

namespace OMA.S_oeis_a206264

open PowerSeries Finset



/-! ## Rows, the conditions on pairs and triples of rows -/

/-- A row. -/
abbrev Row := Fin 6 → Fin 2

/-- The conditions between two consecutive rows r (above) and s (below). -/
def Qpair (r s : Row) : Prop :=
  (∀ j j' j'' : Fin 6, j'.val = j.val + 1 → j''.val = j'.val + 1 → incr (r j) (r j') (s j) (s j') = incr (r j') (r j'') (s j') (s j''))

/-- The conditions on three consecutive rows r, s, t. -/
def Ttrip (r s t : Row) : Prop :=
  (∀ j j' : Fin 6, j'.val = j.val + 1 → incr (r j) (r j') (s j) (s j') = incr (s j) (s j') (t j) (t j'))

instance : DecidableRel Qpair := fun r s => by unfold Qpair; infer_instance

instance (r s t : Row) : Decidable (Ttrip r s t) := by unfold Ttrip; infer_instance

/-- Consecutive pairs and triples of rows satisfy the conditions. -/
def Valid {m : ℕ} (x : Fin m → Row) : Prop :=
  (∀ i i' : Fin m, i'.val = i.val + 1 → Qpair (x i) (x i')) ∧
    ∀ i i' i'' : Fin m, i'.val = i.val + 1 → i''.val = i'.val + 1 → Ttrip (x i) (x i') (x i'')

instance {m : ℕ} : DecidablePred (@Valid m) := fun x => by unfold Valid; infer_instance

/-- The number of valid arrays with n + 1 rows. -/
def cnt (n : ℕ) : ℕ := ((univ : Finset (Fin (n + 1) → Row)).filter Valid).card

lemma a_eq (n : ℕ) : a n = cnt n := by
  unfold a cnt
  exact congrArg Finset.card (Finset.filter_congr (fun x _ => Iff.rfl))

lemma pair_cons {m : ℕ} (r : Row) (g : Fin (m + 1) → Row) :
    (∀ i i' : Fin (m + 2), i'.val = i.val + 1 →
      Qpair ((Fin.cons r g : Fin (m + 2) → Row) i) ((Fin.cons r g : Fin (m + 2) → Row) i')) ↔
      Qpair r (g 0) ∧ ∀ i i' : Fin (m + 1), i'.val = i.val + 1 → Qpair (g i) (g i') := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · have := h 0 1 (by simp)
      simpa using this
    · intro i j hij
      have := h i.succ j.succ (by simp [hij])
      simpa using this
  · rintro ⟨h0, hg⟩ i j hij
    induction i using Fin.cases with
    | zero =>
      induction j using Fin.cases with
      | zero => simp at hij
      | succ j =>
        have hj : j = 0 := by ext; simp at hij; omega
        subst hj
        simpa using h0
    | succ i =>
      induction j using Fin.cases with
      | zero => simp at hij
      | succ j =>
        simp only [Fin.cons_succ]
        exact hg i j (by simp at hij; omega)

lemma trip_cons {m : ℕ} (r : Row) (g : Fin (m + 2) → Row) :
    (∀ i i' i'' : Fin (m + 3), i'.val = i.val + 1 → i''.val = i'.val + 1 →
      Ttrip ((Fin.cons r g : Fin (m + 3) → Row) i) ((Fin.cons r g : Fin (m + 3) → Row) i')
        ((Fin.cons r g : Fin (m + 3) → Row) i'')) ↔
      Ttrip r (g 0) (g 1) ∧ ∀ i i' i'' : Fin (m + 2), i'.val = i.val + 1 → i''.val = i'.val + 1 →
        Ttrip (g i) (g i') (g i'') := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · have := h 0 (Fin.succ 0) (Fin.succ (Fin.succ 0))
        (by simp only [Fin.val_succ, Fin.val_zero]) (by simp only [Fin.val_succ, Fin.val_zero])
      simp only [Fin.cons_zero, Fin.cons_succ, Fin.succ_zero_eq_one] at this
      exact this
    · intro i i' i'' h1 h2
      have := h i.succ i'.succ i''.succ (by simp [h1]) (by simp [h2])
      simpa using this
  · rintro ⟨h0, hg⟩ i i' i'' h1 h2
    induction i using Fin.cases with
    | zero =>
      have e1 : i' = Fin.succ 0 := Fin.ext (by simp only [Fin.val_succ, Fin.val_zero] at h1 ⊢; omega)
      have e2 : i'' = Fin.succ (Fin.succ 0) := Fin.ext (by
        rw [e1] at h2; simp only [Fin.val_succ, Fin.val_zero] at h2 ⊢; omega)
      rw [e1, e2]
      simp only [Fin.cons_zero, Fin.cons_succ, Fin.succ_zero_eq_one]
      exact h0
    | succ i =>
      induction i' using Fin.cases with
      | zero => simp at h1
      | succ i' =>
        induction i'' using Fin.cases with
        | zero => simp at h2
        | succ i'' =>
          simp only [Fin.cons_succ]
          exact hg i i' i'' (by simp at h1; omega) (by simp at h2; omega)

lemma valid_cons {m : ℕ} (r : Row) (g : Fin (m + 2) → Row) :
    Valid (Fin.cons r g : Fin (m + 3) → Row) ↔ Qpair r (g 0) ∧ Ttrip r (g 0) (g 1) ∧ Valid g := by
  unfold Valid
  rw [pair_cons, trip_cons]
  tauto

/-- W(n, r, s): valid arrays with n + 2 rows whose first two rows are r, s. -/
def W (n : ℕ) (r s : Row) : ℕ :=
  ((univ : Finset (Fin (n + 2) → Row)).filter (fun x => Valid x ∧ x 0 = r ∧ x 1 = s)).card

lemma W_zero (r s : Row) : W 0 r s = if Qpair r s then 1 else 0 := by
  unfold W
  split_ifs with hq
  · rw [Finset.card_eq_one]
    refine ⟨![r, s], ?_⟩
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    constructor
    · rintro ⟨_, h0, h1⟩
      funext i
      fin_cases i
      · simpa using h0
      · simpa using h1
    · rintro rfl
      refine ⟨⟨?_, ?_⟩, rfl, rfl⟩
      · intro i i' h
        fin_cases i <;> fin_cases i' <;> simp at h ⊢
        exact hq
      · intro i i' i'' h1 h2
        have := i''.isLt
        omega
  · rw [Finset.card_eq_zero]
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty, iff_false]
    rintro ⟨⟨hp, _⟩, h0, h1⟩
    have := hp 0 1 rfl
    rw [h0, h1] at this
    exact hq this

/-- Prepending the row r. -/
def consEmb (n : ℕ) (r : Row) : (Fin (n + 2) → Row) ↪ (Fin (n + 3) → Row) where
  toFun g := Fin.cons r g
  inj' g g' h := by
    funext i
    have := congrFun h i.succ
    simpa using this

lemma consEmb_apply (n : ℕ) (r : Row) (g : Fin (n + 2) → Row) :
    consEmb n r g = Fin.cons r g := rfl

lemma W_succ (n : ℕ) (r s : Row) :
    W (n + 1) r s = if Qpair r s then ∑ t : Row, (if Ttrip r s t then W n s t else 0) else 0 := by
  have e : ((univ : Finset (Fin (n + 3) → Row)).filter (fun x => Valid x ∧ x 0 = r ∧ x 1 = s)) =
      (((univ : Finset (Fin (n + 2) → Row)).filter
        (fun y => (Qpair r (y 0) ∧ Ttrip r (y 0) (y 1)) ∧ (Valid y ∧ y 0 = s))).map
          (consEmb n r)) := by
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_map, consEmb_apply]
    constructor
    · rintro ⟨hv, h0, h1⟩
      refine ⟨Fin.tail x, ?_, ?_⟩
      · have hx : x = Fin.cons r (Fin.tail x) := by
          rw [← h0]; exact (Fin.cons_self_tail x).symm
        rw [hx, valid_cons] at hv
        have hs : Fin.tail x 0 = s := by
          rw [← h1]; rfl
        exact ⟨⟨hv.1, hv.2.1⟩, hv.2.2, hs⟩
      · rw [← h0]; exact Fin.cons_self_tail x
    · rintro ⟨y, ⟨⟨hq, ht⟩, hv, hy0⟩, rfl⟩
      exact ⟨(valid_cons r y).2 ⟨hq, ht, hv⟩, by simp, by simpa using hy0⟩
  unfold W
  rw [e, Finset.card_map]
  split_ifs with hq
  · rw [Finset.card_eq_sum_card_fiberwise (f := fun y => y 1) (t := univ) (by simp)]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    split_ifs with ht
    · congr 1
      ext y
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      constructor
      · rintro ⟨⟨_, hv, h0⟩, h1⟩
        exact ⟨hv, h0, h1⟩
      · rintro ⟨hv, h0, h1⟩
        exact ⟨⟨⟨by rw [h0]; exact hq, by rw [h0, h1]; exact ht⟩, hv, h0⟩, h1⟩
    · rw [Finset.card_eq_zero]
      ext y
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty, iff_false]
      rintro ⟨⟨⟨_, ht'⟩, _, h0⟩, h1⟩
      rw [h0, h1] at ht'
      exact ht ht'
  · rw [Finset.card_eq_zero]
    ext y
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty, iff_false]
    rintro ⟨⟨hq', _⟩, _, h0⟩
    rw [h0] at hq'
    exact hq hq'

lemma cnt_sum (n : ℕ) : cnt (n + 1) = ∑ r : Row, ∑ s : Row, W n r s := by
  unfold cnt W
  rw [Finset.card_eq_sum_card_fiberwise (f := fun x => x 0) (t := univ) (by simp)]
  refine Finset.sum_congr rfl (fun r _ => ?_)
  rw [Finset.card_eq_sum_card_fiberwise (f := fun x => x 1) (t := univ) (by simp)]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  congr 1
  ext x
  simp [and_assoc]

lemma sum_cons {m : ℕ} (f : (Fin (m + 1) → Fin 2) → ℕ) :
    ∑ s : Fin (m + 1) → Fin 2, f s = ∑ x : Fin 2, ∑ t : Fin m → Fin 2, f (Fin.cons x t) := by
  rw [← Fintype.sum_prod_type']
  exact Fintype.sum_equiv (Fin.consEquiv fun _ => Fin 2).symm _ _
    (fun s => by simp [Fin.consEquiv, Fin.cons_self_tail])

lemma sum_row (f : Row → ℕ) :
    ∑ s : Row, f s = ∑ x0 : Fin 2, ∑ x1 : Fin 2, ∑ x2 : Fin 2, ∑ x3 : Fin 2, ∑ x4 : Fin 2, ∑ x5 : Fin 2, f ![x0, x1, x2, x3, x4, x5] := by
  rw [sum_cons]
  refine Finset.sum_congr rfl (fun x0 _ => ?_)
  rw [sum_cons]
  refine Finset.sum_congr rfl (fun x1 _ => ?_)
  rw [sum_cons]
  refine Finset.sum_congr rfl (fun x2 _ => ?_)
  rw [sum_cons]
  refine Finset.sum_congr rfl (fun x3 _ => ?_)
  rw [sum_cons]
  refine Finset.sum_congr rfl (fun x4 _ => ?_)
  rw [sum_cons]
  refine Finset.sum_congr rfl (fun x5 _ => ?_)
  rw [Fintype.sum_unique]
  exact congrArg f (by funext j; fin_cases j <;> rfl)

/-! ## The kernel's numeric form -/

/-- The H3 condition on numbers, as a bit of a mask. -/
def gH3 (a b c d e f : ℕ) : Bool := Nat.beq (15085102003281517705 >>> (((((a * 2 + b) * 2 + c) * 2 + d) * 2 + e) * 2 + f) % 2) 1

lemma H3_iff : ∀ a b c d e f : Fin 2, (incr a b d e = incr b c e f) ↔ gH3 a.val b.val c.val d.val e.val f.val = true := by
  decide +kernel

/-- The V2 condition on numbers, as a bit of a mask. -/
def gV2 (a b c d e f : ℕ) : Bool := Nat.beq (15353094253029099745 >>> (((((a * 2 + b) * 2 + c) * 2 + d) * 2 + e) * 2 + f) % 2) 1

lemma V2_iff : ∀ a b c d e f : Fin 2, (incr a b c d = incr c d e f) ↔ gV2 a.val b.val c.val d.val e.val f.val = true := by
  decide +kernel

lemma Qpair_explicit (r s : Row) : Qpair r s ↔ (incr (r 0) (r 1) (s 0) (s 1) = incr (r 1) (r 2) (s 1) (s 2)) ∧ (incr (r 1) (r 2) (s 1) (s 2) = incr (r 2) (r 3) (s 2) (s 3)) ∧ (incr (r 2) (r 3) (s 2) (s 3) = incr (r 3) (r 4) (s 3) (s 4)) ∧ (incr (r 3) (r 4) (s 3) (s 4) = incr (r 4) (r 5) (s 4) (s 5)) := by
  unfold Qpair
  constructor
  · intro h0
    exact ⟨h0 0 1 2 rfl rfl, h0 1 2 3 rfl rfl, h0 2 3 4 rfl rfl, h0 3 4 5 rfl rfl⟩
  · rintro ⟨k0, k1, k2, k3⟩
    intro j j' j'' hj hj'
    rcases j with ⟨j, hj0⟩; rcases j' with ⟨j', hj1⟩; rcases j'' with ⟨j'', hj2⟩
    simp only at hj hj'; subst hj; subst hj'
    have hjw : j < 4 := by omega
    interval_cases j
    · exact k0
    · exact k1
    · exact k2
    · exact k3

/-- Qpair on the entries of the two rows. -/
def QB (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) : Bool := gH3 r0 r1 r2 s0 s1 s2 && gH3 r1 r2 r3 s1 s2 s3 && gH3 r2 r3 r4 s2 s3 s4 && gH3 r3 r4 r5 s3 s4 s5

lemma Q_iff (r s : Row) : Qpair r s ↔ QB (r 0).val (r 1).val (r 2).val (r 3).val (r 4).val (r 5).val (s 0).val (s 1).val (s 2).val (s 3).val (s 4).val (s 5).val = true := by
  rw [Qpair_explicit]
  simp only [QB, Bool.and_eq_true, and_assoc, H3_iff]

lemma Ttrip_explicit (r s t : Row) : Ttrip r s t ↔ (incr (r 0) (r 1) (s 0) (s 1) = incr (s 0) (s 1) (t 0) (t 1)) ∧ (incr (r 1) (r 2) (s 1) (s 2) = incr (s 1) (s 2) (t 1) (t 2)) ∧ (incr (r 2) (r 3) (s 2) (s 3) = incr (s 2) (s 3) (t 2) (t 3)) ∧ (incr (r 3) (r 4) (s 3) (s 4) = incr (s 3) (s 4) (t 3) (t 4)) ∧ (incr (r 4) (r 5) (s 4) (s 5) = incr (s 4) (s 5) (t 4) (t 5)) := by
  unfold Ttrip
  constructor
  · intro h0
    exact ⟨h0 0 1 rfl, h0 1 2 rfl, h0 2 3 rfl, h0 3 4 rfl, h0 4 5 rfl⟩
  · rintro ⟨k0, k1, k2, k3, k4⟩
    intro j j' hj
    rcases j with ⟨j, hj0⟩; rcases j' with ⟨j', hj1⟩
    simp only at hj; subst hj
    have hjw : j < 5 := by omega
    interval_cases j
    · exact k0
    · exact k1
    · exact k2
    · exact k3
    · exact k4

/-- The sum of f over 0, ..., 1. -/
def sumK (f : ℕ → ℕ) : ℕ := f 0 + f 1

lemma sumK_fin (f : ℕ → ℕ) : ∑ x : Fin 2, f x.val = sumK f := by
  rw [Fin.sum_univ_eq_sum_range (fun x => f x) 2]
  simp [Finset.sum_range_succ, sumK]

/-- The concatenation of f over 0, ..., 1. -/
def catK (f : ℕ → List ℕ) : List ℕ := f 0 ++ f 1

/-- The code of a row: its entries as base-K digits, r 0 the most significant. -/
def code (r : Row) : ℕ := (((((r 0).val * 2 + (r 1).val) * 2 + (r 2).val) * 2 + (r 3).val) * 2 + (r 4).val) * 2 + (r 5).val

lemma code_lt (r : Row) : code r < 64 := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

lemma dig0 (r : Row) : code r / 32 % 2 = (r 0).val := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

lemma dig1 (r : Row) : code r / 16 % 2 = (r 1).val := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

lemma dig2 (r : Row) : code r / 8 % 2 = (r 2).val := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

lemma dig3 (r : Row) : code r / 4 % 2 = (r 3).val := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

lemma dig4 (r : Row) : code r / 2 % 2 = (r 4).val := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

lemma dig5 (r : Row) : code r % 2 = (r 5).val := by
  unfold code; have h0 := (r 0).isLt; have h1 := (r 1).isLt; have h2 := (r 2).isLt; have h3 := (r 3).isLt; have h4 := (r 4).isLt; have h5 := (r 5).isLt; omega

/-- The sum of g over all row codes. -/
def Ts (g : ℕ → ℕ) : ℕ := sumK (fun x0 => sumK (fun x1 => sumK (fun x2 => sumK (fun x3 => sumK (fun x4 => sumK (fun x5 => g (((((x0 * 2 + x1) * 2 + x2) * 2 + x3) * 2 + x4) * 2 + x5)))))))

lemma total (g : ℕ → ℕ) : (∑ s : Row, g (code s)) = Ts g := by
  rw [sum_row]
  simp only [code, Matrix.cons_val, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.tail_cons, Matrix.cons_val_succ]
  unfold Ts
  simp only [← sumK_fin]

def N5 (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : ℕ :=
  sumK (fun x => bif gV2 r4 r5 s4 s5 p1 x then g (acc * 2 + x) else 0)

def N4 (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : ℕ :=
  sumK (fun x => bif gV2 r3 r4 s3 s4 p1 x then N5 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else 0)

def N3 (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : ℕ :=
  sumK (fun x => bif gV2 r2 r3 s2 s3 p1 x then N4 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else 0)

def N2 (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : ℕ :=
  sumK (fun x => bif gV2 r1 r2 s1 s2 p1 x then N3 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else 0)

def N1 (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : ℕ :=
  sumK (fun x => bif gV2 r0 r1 s0 s1 p1 x then N2 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else 0)

def M5 (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : List ℕ :=
  catK (fun x => bif gV2 r4 r5 s4 s5 p1 x then [acc * 2 + x] else [])

def M4 (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : List ℕ :=
  catK (fun x => bif gV2 r3 r4 s3 s4 p1 x then M5 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else [])

def M3 (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : List ℕ :=
  catK (fun x => bif gV2 r2 r3 s2 s3 p1 x then M4 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else [])

def M2 (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : List ℕ :=
  catK (fun x => bif gV2 r1 r2 s1 s2 p1 x then M3 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else [])

def M1 (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) (p2 p1 acc : ℕ) : List ℕ :=
  catK (fun x => bif gV2 r0 r1 s0 s1 p1 x then M2 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p1 x (acc * 2 + x) else [])

/-- The sum of g over the codes of the rows t with T r s t. -/
def Tn (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) : ℕ := sumK (fun x => N1 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 0 x x)

/-- The codes of the rows t with T r s t. -/
def Tl (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 : ℕ) : List ℕ := catK (fun x => M1 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 0 x x)

lemma N5_list (g : ℕ → ℕ) (r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p2 p1 acc : ℕ) :
    N5 g r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p2 p1 acc = ((M5 r0 r1 r2 r3 r4 r5 s0 s1 s2 s3 s4 s5 p2 p1 acc).map g).sum := by
  unfold N5 M5 sumK catK
