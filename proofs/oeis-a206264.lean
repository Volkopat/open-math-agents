lemma row_ok (c : ℕ) (hc : c < 4096) : step0 c = true ∧ step1 c = true ∧ step2 c = true ∧ step3 c = true ∧ step4 c = true ∧ step5 c = true ∧ step6 c = true ∧ step7 c = true ∧ step8 c = true ∧ relB c = true := by
  have h : rowB c = true := by
