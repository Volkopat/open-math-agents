namespace MatchingRows.Orbit.Separated

private def rowIdx (b s : Nat) (salt slots : Nat → Nat) (k : Nat) : Nat :=
  let q := k / b
  slots ((q % s + salt (k % b) * (1 + q / s % (s-1))) % s)

def rowS0 (i : Nat) : Nat :=
  (0x18228f18900309510a04f1017634402d614e2c211c21100004370023310018000534504640b2c71030c07c304104134a1c00d054008404700030014a00d3841490c60c8001010301082041 >>> (6 * i)) % 64

def rowE0 (i : Nat) : Nat :=
  ( >>> (9 * i)) % 512

private def index0 := rowIdx 101 463 rowS0 rowE0

private theorem paint_union (s : Action) (u v : Nat) :
    maskImage s (u ||| v) = maskImage s u ||| maskImage s v := by
  apply Nat.eq_of_testBit_eq
  intro p
  apply Bool.eq_iff_iff.mpr
  simp only [Nat.testBit_or, Bool.or_eq_true_iff, image_bits]
  constructor
  · rintro ⟨i,hy,hi⟩
    rcases hy with h|h
    · exact Or.inl ⟨i,h,hi⟩
    · exact Or.inr ⟨i,h,hi⟩
  · rintro (⟨i,h,hi⟩|⟨i,h,hi⟩)
    · exact ⟨i,by simp [h],hi⟩
    · exact ⟨i,by simp [h],hi⟩

private theorem paint_one (s : Action) (i : Fin 60) :
    maskImage s (1 <<< i.val) = (1 <<< (map60 s.points i).val) := by
  apply Nat.eq_of_testBit_eq
  intro p
  apply Bool.eq_iff_iff.mpr
  rw [image_bits]
  simp only [Nat.shiftLeft_eq,Nat.one_mul,Nat.testBit_two_pow,decide_eq_true_eq]
  constructor
  · rintro ⟨j,hij,e⟩
    exact (Fin.ext hij : i = j) ▸ e
  · intro eq
    exact ⟨i,rfl,eq⟩

private def coord (word offset : Nat) : Fin 60 := Fin.ofNat 60 ((word >>> offset) % 64)

private def six (emit : Fin 60 → Nat) (word : Nat) : Nat :=
  emit (coord word 0) ||| emit (coord word 6) ||| emit (coord word 12) |||
    emit (coord word 18) ||| emit (coord word 24) ||| emit (coord word 30)

private def oneBit (q : Fin 60) := 1 <<< q.val

private theorem image_six (a : Action) (word : Nat) :
    maskImage a (six oneBit word) = six (fun q => oneBit (map60 a.points q)) word := by
  simp only [six, oneBit, paint_union, paint_one]

def byRow (a : Action) (w : Nat) : Nat :=
  let p := PlaneData.pos0 (index0 w)
  if six oneBit p = w then six (fun q => oneBit (map60 a.points q)) p else maskImage a w

theorem byRow_eq (a : Action) : byRow a = maskImage a := by
  funext w
  let p := PlaneData.pos0 (index0 w)
  change (if six oneBit p = w then six (fun q => oneBit (map60 a.points q)) p else maskImage a w) = _
  by_cases hit : six oneBit p = w
  · rw [if_pos hit, ← image_six, hit]
  · rw [if_neg hit]

def rowFactor (a : Action) (f : List Nat) : List Nat := sorted (f.map (byRow a))

theorem rowFactor_eq (a : Action) (f : List Nat) : rowFactor a f = factorImage a f := by
  simp only [rowFactor, factorImage, byRow_eq]

end MatchingRows.Orbit.Separated



namespace MatchingRows.Orbit.Separated

def checkImage (image : Action → List Nat → List Nat) (f : List Nat) (w : Nat) : Bool :=
  if w < 48*1013 then
    match actions[w % 48]? with
    | none => false
    | some a => image a f == PlaneCases.factor (w/48)
  else allSurvivors[w-48*1013]? == some f

def accept (f : List Nat) : Bool :=
  (List.range 65536).any (checkImage factorImage f)

theorem tape_pass (f : List Nat) (w : Nat) (hw : w<65536)
    (h : checkImage rowFactor f w=true) : accept f=true := by
  have eq : rowFactor = factorImage := funext fun a => funext fun v => rowFactor_eq a v
  exact List.any_eq_true.mpr ⟨w,List.mem_range.mpr hw,eq ▸ h⟩

theorem accepted {f : List Nat} (hv : Viable 0 f) (ok : accept f = true)
    (reject : ∀ k : Fin 1013, ¬ Extends (PlaneCases.factor k.val) 9 14) :
    f ∈ allSurvivors := by
  obtain ⟨w, _, ok⟩ := List.any_eq_true.mp ok
  unfold checkImage at ok
  by_cases hw : w < 48*1013
  · rw [if_pos hw] at ok
    cases ha : actions[w % 48]? with
    | none => simp [ha] at ok
    | some a =>
      simp only [ha,beq_iff_eq] at ok
      have valid := actions_valid a (List.mem_of_getElem? ha)
      have vh := viable_zero a valid.1 0 valid.2 f hv
      have h := vh.2 (9,14) (by decide)
      change Extends (factorImage a f) 9 14 at h
      rw [ok] at h
      exact False.elim (reject ⟨w/48,by omega⟩ h)
  · rw [if_neg hw] at ok
    exact List.mem_of_getElem? (eq_of_beq ok)

end MatchingRows.Orbit.Separated

