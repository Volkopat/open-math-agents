def byPoint (g p : Nat) : List Nat :=
  if g = 0 ∧ p ∈ hot then point0 p else
    (catalogue (Fin.ofNat 15 g)).filter (fun x => x.testBit p)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 32000000 in
private theorem table0 : ∀ x ∈ catalogue 0, ∀ p ∈ hot,
    x.testBit p = true → x ∈ point0 p := by decide +kernel

theorem byPoint_complete (g : Fin 15) (_hg : g.val ∈ [0,9,14]) :
    ∀ x ∈ catalogue g, ∀ p, x.testBit p = true → x ∈ byPoint g p := by
  intro x hx p hp
  by_cases h : g.val = 0 ∧ p ∈ hot
  · rw [byPoint,if_pos h]
    have hg : g = 0 := Fin.ext h.1
    exact table0 x (hg ▸ hx) p h.2 hp
  · rw [byPoint,if_neg h,List.mem_filter]
    have eg : Fin.ofNat 15 g.val = g := Fin.ext (Nat.mod_eq_of_lt g.isLt)
    rw [eg]
    exact ⟨hx,hp⟩

end MatchingRows.RootTables

namespace MatchingRows.Orbit.Separated

theorem classified
    (checks : ∀ y ∈ roots, RF.walk (RootTables.byPoint 0) accept 5 (allowed 0 ^^^ y) [y] = true)
    (reject : ∀ k : Fin 1013, ¬ Extends (PlaneCases.factor k.val) 9 14)
    (f : List Nat) (hv : Viable 0 f) : f ∈ allSurvivors := by
  apply cover_from_roots _ f hv
  intro b hb y hy mem
  apply accepted hb _ reject
  apply RF.root_sound (g := 0) hb.1 mem (RootTables.byPoint 0) accept
    (RootTables.byPoint_complete 0 (by decide))
  exact checks y hy

theorem final_cover
    (checks : ∀ y ∈ roots, RF.walk (RootTables.byPoint 0) accept 5 (allowed 0 ^^^ y) [y] = true)
    (reject : ∀ k : Fin 1013, ¬ Extends (PlaneCases.factor k.val) 9 14)
    (g : Fin 15) (hg : g.val ∈ [0,9,14]) (f : List Nat) (hv : Viable g.val f)
    (separate : ¬ joined g.val f) : f ∈ candidates g.val :=
  separated_mem (classified checks reject) g hg hv separate

end MatchingRows.Orbit.Separated

namespace Hi

/-- Inspect the upper half of a binary block. -/
def step (k : Nat) (rest : Nat → Nat) (x : Nat) : Nat :=
  let upper := x >>> k
  if upper = 0 then rest x else rest upper + k

/-- Highest set-bit index on integers fitting in 64 bits; zero maps to zero. -/
def index : Nat → Nat :=
  step 32 (step 16 (step 8 (step 4 (step 2 (step 1 (fun _ => 0))))))

private theorem step_correct (k : Nat) (rest : Nat → Nat)
    (hr : ∀ x, x < 2^k → rest x = x.log2) :
    ∀ x, x < 2^(k+k) → step k rest x = x.log2 := by
  intro x hx
  let q := x / 2^k
  have hp : 0 < 2^k := Nat.two_pow_pos _
  rw [Nat.pow_add] at hx
  have hq : q < 2^k := (Nat.div_lt_iff_lt_mul hp).2 hx
  simp only [step, Nat.shiftRight_eq_div_pow]
  change (if q = 0 then rest x else rest q + k) = x.log2
  split
  next h => exact hr x ((Nat.div_eq_zero_iff_lt hp).1 h)
  next h =>
    rw [hr q hq]
    symm
    apply (Nat.log2_eq_iff (by intro hz; simp [q,hz] at h)).2
    constructor
    · rw [Nat.pow_add]
      exact Nat.mul_le_of_le_div _ _ _ (Nat.log2_self_le h)
    · rw [show q.log2 + k + 1 = (q.log2+1) + k by omega, Nat.pow_add]
      exact Nat.lt_mul_of_div_lt Nat.lt_log2_self hp

theorem index_eq_log2 {x : Nat} (h : x < 2^60) : index x = x.log2 := by
  have base : ∀ y : Nat, y < 2^1 → 0 = y.log2 := by
    intro y hy
    have cases : y = 0 ∨ y = 1 := by omega
    rcases cases with rfl | rfl <;> decide
  have h64 : x < 2^64 := Nat.lt_of_lt_of_le h (by decide)
  exact step_correct 32 _ (step_correct 16 _ (step_correct 8 _ (step_correct 4 _
    (step_correct 2 _ (step_correct 1 _ base))))) x h64

end Hi

namespace Hi

def safe (x : Nat) := if x < 2^60 then index x else x.log2

theorem safe_eq (x : Nat) : safe x = x.log2 := by
  unfold safe
  split
  next h => exact index_eq_log2 h
  next => rfl
end Hi

namespace MatchingRows.RF
open MatchingRows.Orbit
def highWalk (byPoint : Nat → List Nat) (check : List Nat → Bool) :
    Nat → Nat → List Nat → Bool
  | 0, rem, acc => if rem = 0 then check (sorted acc) else true
  | fuel + 1, rem, acc =>
    if rem = 0 then true else
      (byPoint (Hi.safe rem)).all fun x =>
        if x &&& rem = x then highWalk byPoint check fuel (rem ^^^ x) (x :: acc) else true

theorem highWalk_eq (byPoint : Nat → List Nat) (check : List Nat → Bool) (fuel rem : Nat)
    (acc : List Nat) : highWalk byPoint check fuel rem acc = walk byPoint check fuel rem acc := by
  induction fuel generalizing rem acc with
  | zero => rfl
  | succ n ih => simp only [highWalk,walk,Hi.safe_eq,ih]

end MatchingRows.RF

namespace MatchingRows.Orbit.Separated

def nextRows (y : Nat) : List Nat :=
  RootTables.byPoint 0 (Hi.safe (allowed 0 ^^^ y))

def visitChild (check : List Nat → Bool) (y x : Nat) : Bool :=
  let rem := allowed 0 ^^^ y
  if x &&& rem = x then RF.highWalk (RootTables.byPoint 0) check 4 (rem ^^^ x) [x,y]
  else true

/-- Seven successive candidates for the row covering the highest remaining point. -/
def slice7 (check : List Nat → Bool) (y k : Nat) : Bool :=
  (((nextRows y).drop (7*k)).take 7).all (visitChild check y)

private theorem append_slice {xs : List Nat} {f : Nat → Bool} {k n : Nat}
    (before : ((xs.drop k).take n).all f = true)
    (after : (xs.drop (k+n)).all f = true) : (xs.drop k).all f = true := by
  have both := congrArg (fun l : List Nat => l.all f) (List.take_append_drop n (xs.drop k))
  simpa only [List.all_append, List.drop_drop, before, after, Bool.true_and] using both.symm

theorem root_from_slices (check : List Nat → Bool) (y : Nat) (nonzero : allowed 0 ^^^ y ≠ 0)
    (len : (nextRows y).length ≤ 56)
    (a : slice7 check y 0 = true) (b : slice7 check y 1 = true)
    (c : slice7 check y 2 = true) (d : slice7 check y 3 = true)
    (e : slice7 check y 4 = true) (f : slice7 check y 5 = true)
    (g : slice7 check y 6 = true) (h : slice7 check y 7 = true) :
    RF.walk (RootTables.byPoint 0) check 5 (allowed 0 ^^^ y) [y] = true := by
  rw [← RF.highWalk_eq]
  change (if allowed 0 ^^^ y = 0 then true else (nextRows y).all (visitChild check y)) = true
  rw [if_neg nonzero]
  have last : ((nextRows y).drop 56).all (visitChild check y) = true := by
    rw [List.drop_eq_nil_iff.mpr len]; rfl
  exact append_slice (k := 0) (n := 7) a (append_slice b (append_slice c (append_slice d
    (append_slice e (append_slice f (append_slice g (append_slice h last)))))))

end MatchingRows.Orbit.Separated

namespace MatchingRows.RF
open MatchingRows.Orbit

/-- After the other rows have been selected, any successful last row must
equal the uncovered mask. Testing that row directly suffices for coverage. -/
def forcedWalk (byPoint : Nat → List Nat) (check : List Nat → Bool) :
    Nat → Nat → List Nat → Bool
  | 0, rem, acc => if rem=0 then check (sorted acc) else true
  | 1, rem, acc => check (sorted (rem::acc))
  | n+2, rem, acc =>
    if rem=0 then true else
      (byPoint (Hi.safe rem)).all fun x =>
        if x &&& rem=x then forcedWalk byPoint check (n+1) (rem ^^^ x) (x::acc) else true

theorem forced_sound (byPoint : Nat → List Nat) (check : List Nat → Bool) (fuel rem : Nat)
    (acc : List Nat) (h : forcedWalk byPoint check fuel rem acc=true) :
    highWalk byPoint check fuel rem acc=true := by
  induction fuel generalizing rem acc with
  | zero => exact h
  | succ n ih =>
    rw [highWalk]
    split <;> rename_i hz
    · rfl
    · apply List.all_eq_true.mpr
      intro x hx
      split <;> rename_i fits
      · cases n with
        | zero =>
          rw [highWalk]
          split <;> rename_i last
          · have eq : rem=x := by
              have e := congrArg (fun a => a ^^^ x) last
              simpa only [Nat.xor_assoc,Nat.xor_self,Nat.xor_zero,Nat.zero_xor] using e
            subst x
            exact h
          · rfl
        | succ n =>
          apply ih
          rw [forcedWalk,if_neg hz] at h
          simpa only [if_pos fits] using List.all_eq_true.mp h x hx
      · rfl

end MatchingRows.RF

namespace MatchingRows.RF
open MatchingRows.Orbit

/-- Sequential checks consume the witness stream only when reaching a complete factor. -/
def runChildren (exec : Nat → Nat → Option Nat) : List Nat → Nat → Option Nat
  | [], tape => some tape
  | x::xs, tape => match exec x tape with
    | none => none
    | some later => runChildren exec xs later

theorem tape_ran_child {exec : Nat → Nat → Option Nat} (xs : List Nat) {tape last : Nat}
    (ok : runChildren exec xs tape=some last) {x : Nat} (mem : x∈xs) :
    ∃ a b, exec x a=some b := by
  induction xs generalizing tape with
  | nil => contradiction
  | cons y ys ih =>
    rw [runChildren] at ok
    cases h : exec y tape with
    | none => simp [h] at ok
    | some b =>
      simp only [h] at ok
      rcases List.mem_cons.mp mem with rfl|m
      · exact ⟨tape,b,h⟩
      · exact ih ok m

private def verifyLeaf (cert : List Nat → Nat → Bool) (v : List Nat) (tape : Nat) : Option Nat :=
  if cert (sorted v) (tape%65536) then some (tape >>> 16) else none

def tapeWalk (byPoint : Nat → List Nat) (cert : List Nat → Nat → Bool) :
    Nat → Nat → List Nat → Nat → Option Nat
  | 0, rem, acc, tape => if rem=0 then verifyLeaf cert acc tape else some tape
  | 1, rem, acc, tape => verifyLeaf cert (rem::acc) tape
  | n+2, rem, acc, tape =>
    if rem=0 then some tape else
      runChildren (fun x prev =>
        if x &&& rem=x then tapeWalk byPoint cert (n+1) (rem^^^x) (x::acc) prev else some prev)
        (byPoint (Hi.safe rem)) tape

private theorem leaf_sound {cert : List Nat → Nat → Bool} {P : List Nat → Bool}
    (sound : ∀ f w, w<65536 → cert f w=true → P f=true) (xs : List Nat) {tape last : Nat}
    (h : verifyLeaf cert xs tape=some last) : P (sorted xs)=true := by
  unfold verifyLeaf at h
  split at h <;> rename_i passed
  · exact sound _ _ (Nat.mod_lt _ (by decide)) passed
  · contradiction

theorem tape_forced (byPoint : Nat → List Nat) (cert : List Nat → Nat → Bool) (P : List Nat → Bool)
    (sound : ∀ f w, w<65536 → cert f w=true → P f=true) (fuel rem : Nat) (acc : List Nat) {tape last : Nat}
    (h : tapeWalk byPoint cert fuel rem acc tape=some last) :
    forcedWalk byPoint P fuel rem acc=true := by
  induction fuel generalizing rem acc tape last with
  | zero =>
    by_cases z : rem=0
    · subst rem; simpa [forcedWalk] using leaf_sound sound acc
        (show verifyLeaf cert acc tape=some last by simpa [tapeWalk] using h)
    · simp [forcedWalk,z]
  | succ n ih =>
    cases n with
    | zero => exact leaf_sound sound _ h
    | succ n =>
      rw [forcedWalk]
      split <;>rename_i hz
      · rfl
      · rw [tapeWalk,if_neg hz] at h
        apply List.all_eq_true.mpr
        intro x hx
        obtain ⟨prev,after,run⟩ := tape_ran_child _ h hx
        split <;> rename_i fit
        · apply ih (tape:=prev) (last:=after)
          simpa only [if_pos fit] using run
        · rfl

end MatchingRows.RF

