set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk0 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (0 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk1 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (43 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk2 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (86 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk3 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (129 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk4 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (172 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk5 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (215 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk6 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (258 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk7 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (301 + i.val) := by decide +kernel

theorem allFlags (a : Bool) (i : Fin 344) : flagsForRow a i.val := by
  by_cases h0 : i.val < 43
  · have h := chunk0 a ⟨i.val - 0, by omega⟩
    change flagsForRow a (0 + (i.val - 0)) at h
    simpa only [show 0 + (i.val - 0) = i.val by omega] using h
  by_cases h1 : i.val < 86
  · have h := chunk1 a ⟨i.val - 43, by omega⟩
    change flagsForRow a (43 + (i.val - 43)) at h
    simpa only [show 43 + (i.val - 43) = i.val by omega] using h
  by_cases h2 : i.val < 129
  · have h := chunk2 a ⟨i.val - 86, by omega⟩
    change flagsForRow a (86 + (i.val - 86)) at h
    simpa only [show 86 + (i.val - 86) = i.val by omega] using h
  by_cases h3 : i.val < 172
  · have h := chunk3 a ⟨i.val - 129, by omega⟩
    change flagsForRow a (129 + (i.val - 129)) at h
    simpa only [show 129 + (i.val - 129) = i.val by omega] using h
  by_cases h4 : i.val < 215
  · have h := chunk4 a ⟨i.val - 172, by omega⟩
    change flagsForRow a (172 + (i.val - 172)) at h
    simpa only [show 172 + (i.val - 172) = i.val by omega] using h
  by_cases h5 : i.val < 258
  · have h := chunk5 a ⟨i.val - 215, by omega⟩
    change flagsForRow a (215 + (i.val - 215)) at h
    simpa only [show 215 + (i.val - 215) = i.val by omega] using h
  by_cases h6 : i.val < 301
  · have h := chunk6 a ⟨i.val - 258, by omega⟩
    change flagsForRow a (258 + (i.val - 258)) at h
    simpa only [show 258 + (i.val - 258) = i.val by omega] using h
  have h := chunk7 a ⟨i.val - 301, by omega⟩
  change flagsForRow a (301 + (i.val - 301)) at h
  simpa only [show 301 + (i.val - 301) = i.val by omega] using h
