  simp only [roots,List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hy
  rcases hy with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact root_0
  · exact root_1
  · exact root_2
  · exact root_3
  · exact root_8
  · exact root_9
  · exact root_16
  · exact root_32
