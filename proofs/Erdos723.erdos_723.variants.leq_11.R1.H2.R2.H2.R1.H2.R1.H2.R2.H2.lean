theorem search_eq_visit : ∀ (fuel : Nat) (s : EC.State) (c : Nat),
    search fuel (s.rem false) (s.rem true) (s.opts false) (s.opts true) c =
      EC.visit tables fuel s c := by
  intro fuel
  induction fuel with
  | zero => intros; rfl
  | succ n ih =>
    intro s c
    let tag := c % 128
    change search (n + 1) _ _ _ _ c = _
    by_cases hz : tag = 0
    · have z : c % 128 = 0 := hz
      simp [search, EC.visit, z]
    have pos : 0 < c % 128 := Nat.pos_of_ne_zero hz
    have nz : c % 128 ≠ 0 := hz
    by_cases small : c % 128 ≤ 60
    · have nlarge : ¬60 < c % 128 := by omega
      have bound : c % 128 ≤ 120 := by omega
      by_cases hp : (s.rem false).testBit (c % 128 - 1) = true
      · simp only [search, EC.visit, nz, if_false, small, if_true, nlarge, decide_false,
          Bool.false_eq_true, Bool.false_eq_true, pos, bound, hp, and_self, EC.picks]
        apply congrArg (fun step : Nat → Nat → Option Nat => EC.branches step 344 _ _)
        funext i k
        exact ih (EC.child tables s false i) k
      · simp [search, EC.visit, nz, small, nlarge, pos, bound, hp]
    · have large : 60 < c % 128 := by omega
      by_cases bound : c % 128 ≤ 120
      · by_cases hp : (s.rem true).testBit (c % 128 - 61) = true
        · simp only [search, EC.visit, nz, if_false, small, if_true, large, decide_true,
            pos, bound, hp, and_self, EC.picks]
          apply congrArg (fun step : Nat → Nat → Option Nat => EC.branches step 344 _ _)
          funext i k
          exact ih (EC.child tables s true i) k
        · simp [search, EC.visit, nz, small, large, pos, bound, hp]
      · simp [search, EC.visit, nz, small, large, pos, bound]

end PlaneData

namespace EC

private theorem branches_forbid {step : Nat → Nat → Option Nat} {q : Nat}
    (reject : ∀ c r, step q c ≠ some r) :
    ∀ k pool c r, pool.testBit q = true → branches step k pool c ≠ some r := by
  intro k
  induction k with
  | zero =>
    intro pool c r hp
    have hn : pool ≠ 0 := by rintro rfl; simp at hp
    simp [branches, hn]
  | succ k ih =>
    intro pool c r hp
    have hn : pool ≠ 0 := by rintro rfl; simp at hp
    simp only [branches, hn, ↓reduceIte]
    cases hx : step (pivotIndex pool) c with
    | none => simp
    | some rest =>
      have hq : pivotIndex pool ≠ q := by
        intro h
        rw [h] at hx
        exact reject c rest hx
      exact ih _ rest r (by simp [Nat.testBit_xor, hp, hq])

theorem visit_forbids {t : Tables} (Good : State → Prop)
    (next : ∀ s, Good s → ∀ side p, (s.rem side).testBit p = true →
      ∃ i, (picks t s side p).testBit i = true ∧ Good (child t s side i)) :
    ∀ fuel s c r, Good s → visit t fuel s c ≠ some r := by
  intro fuel
  induction fuel with
  | zero => simp [visit]
  | succ fuel ih =>
    intro s c r hgood
    let tag := c % 128
    let side := decide (60 < tag)
    let p := if side then tag - 61 else tag - 1
    change (if 0 < tag ∧ tag ≤ 120 ∧ (s.rem side).testBit p = true then
      branches (fun i r => visit t fuel (child t s side i) r) 344
        (picks t s side p) (c / 128) else none) ≠ some r
    by_cases htag : 0 < tag ∧ tag ≤ 120 ∧ (s.rem side).testBit p = true
    · rw [if_pos htag]
      obtain ⟨i, hi, hchild⟩ := next s hgood _ _ htag.2.2
      exact branches_forbid (q := i) (fun c' r' => ih _ c' r' hchild) _ _ _ _ hi
    · simp [htag]

end EC

namespace EC

/-- A pair of permitted exact covers. W records the row indices in each cover. -/
structure Family (t : Tables) (W : Bool → Nat → Prop) : Prop where
  point : ∀ a i p, W a i → (t.rows a i).testBit p = true → (t.point a p).testBit i = true
  separate : ∀ a i j, W a i → W a j → i ≠ j → t.rows a i &&& t.rows a j = 0
  sameFlag : ∀ a i j, W a i → W a j → i ≠ j → (t.disj a i).testBit j = true
  otherFlag : ∀ a i j, W a i → W (!a) j → (t.cross a i).testBit j = true

/-- The pending witnesses are still available and cover exactly the pending points. -/
def Good (t : Tables) (W : Bool → Nat → Prop) (s : State) : Prop :=
  ∃ left : Bool → Nat → Prop,
    (∀ a i, left a i → W a i) ∧
    (∀ a i, left a i → (s.opts a).testBit i = true) ∧
    (∀ a p, (s.rem a).testBit p = true ↔ ∃ i, left a i ∧ (t.rows a i).testBit p = true)

theorem good_initial {t : Tables} {W : Bool → Nat → Prop} {s : State}
    (opts : ∀ a i, W a i → (s.opts a).testBit i = true)
    (cover : ∀ a p, (s.rem a).testBit p = true ↔ ∃ i, W a i ∧ (t.rows a i).testBit p = true) :
    Good t W s := ⟨W,fun _ _ h => h,opts,cover⟩

private theorem clear_bit (u v p : Nat) :
    (u ^^^ (u &&& v)).testBit p = true ↔ u.testBit p = true ∧ v.testBit p ≠ true := by
  rw [Nat.testBit_xor,Nat.testBit_and]
  cases u.testBit p <;> cases v.testBit p <;> decide

theorem good_step {t : Tables} {W : Bool → Nat → Prop} (family : Family t W)
    {s : State} (good : Good t W s) (side : Bool) (p : Nat) (hp : (s.rem side).testBit p = true) :
    ∃ i, (picks t s side p).testBit i = true ∧ Good t W (child t s side i) := by
  obtain ⟨left,original,available,cover⟩ := good
  obtain ⟨i,hi,hip⟩ := (cover side p).1 hp
  have wi := original side i hi
  refine ⟨i, ?_, ?_⟩
  · unfold picks
    rw [Nat.testBit_and, Bool.and_eq_true]
    exact ⟨available side i hi, family.point side i p wi hip⟩
  let next (a : Bool) (j : Nat) := left a j ∧ (a = side → j ≠ i)
  refine ⟨next,fun a j h => original a j h.1,?_,?_⟩
  · intro a j h
    change (s.opts a &&& (if a = side then t.disj side i else t.cross side i)).testBit j = true
    rw [Nat.testBit_and,Bool.and_eq_true]
    refine ⟨available a j h.1, ?_⟩
    by_cases e : a = side
    · subst a
      simp only
      exact family.sameFlag side i j wi (original side j h.1) (Ne.symm (h.2 rfl))
    · rw [if_neg e]
      have ea : a = !side := by cases a <;> cases side <;> simp_all
      exact family.otherFlag side i j wi (ea ▸ original a j h.1)
  · intro a q
    change (if a = side then s.rem a ^^^ (s.rem a &&& t.rows side i) else s.rem a).testBit q = true ↔ _
    by_cases e : a = side
    · subst a
      rw [if_pos rfl, clear_bit, cover]
      constructor
      · rintro ⟨⟨j,hj,hq⟩,hclear⟩
        exact ⟨j,⟨hj,fun _ eq => hclear (eq ▸ hq)⟩,hq⟩
      · rintro ⟨j,hj,hq⟩
        refine ⟨⟨j,hj.1,hq⟩, ?_⟩
        intro hbit
        have hd := family.separate side i j wi (original side j hj.1) (Ne.symm (hj.2 rfl))
        have pos : (t.rows side i &&& t.rows side j).testBit q = true := by
          rw [Nat.testBit_and,Bool.and_eq_true]
          exact ⟨hbit,hq⟩
        simp [hd] at pos
    · rw [if_neg e, cover]
      constructor
      · rintro ⟨j,hj,hq⟩
        exact ⟨j,⟨hj,fun eq => False.elim (e eq)⟩,hq⟩
      · rintro ⟨j,hj,hq⟩
        exact ⟨j,hj.1,hq⟩


end EC

namespace MatchingRows

def allowed (g : Nat) := ((0xfffc3ef80fafa00f3bbfb03bed00eeaeefc0bef00bdbdcf43b5efe00e7db781eef77db7007715f55fdd75f5f003c3740d75d7ddf5d5c1dd01e7d77fa4b5ea76c0beee5fa2a83ababebbbaf00cccf3cf3f3f3f033333cf3cfcfcffc003cf3cf3f3f3ffffc0000fcfcfcfffffffff000000 : Nat) >>> (60*g)) % 2^60
def incident (m : Fin 15) := ((0x2a0220020808000842110800400080511000410004040c008802082020003080481000010200c440400410001003c000082080008003c020010008040003c104004040000003f000000202000000fc002000100000003f010100000000000ff000000000000000ff000000000000000ff : Nat) >>> (60*m.val)) % 2^60

def thin (n : Nat) := n &&& (n - 1) = 0
def legal (g : Nat) (b : List Nat) := b.length = 6 ∧ b.Pairwise (· ≤ ·) ∧
  b.foldr Nat.lor 0 = allowed g ∧ ∀ x ∈ b, ∀ m, thin (x &&& incident m)
def active (g : Nat) (m : Fin 15) : Prop := allowed g &&& incident m ≠ 0
instance (g : Nat) (m : Fin 15) : Decidable (active g m) := inferInstanceAs (Decidable (_ ≠ _))

def perfectRow (g x : Nat) : Prop :=
  (∀ p : Nat, x.testBit p = true → (allowed g).testBit p = true) ∧
  ∀ m : Fin 15, active g m → ∃ p : Fin 60,
    (x &&& incident m).testBit p.val = true ∧
    ∀ q : Fin 60, (x &&& incident m).testBit q.val = true → q = p

/-- Six ordered incident edges at each active vertex. Unused table entries are zero. -/
def neighbor (g m : Fin 15) (k : Fin 6) : Fin 60 :=
  Fin.ofNat 60 ((( : Nat) >>> (6*(6*(15*g.val+m.val)+k.val))) % 64)

set_option maxHeartbeats 12000000 in
theorem six_neighbors : ∀ (g m : Fin 15), active g.val m →
    (∀ k : Fin 6, (allowed g.val).testBit (neighbor g m k).val = true ∧
        (incident m).testBit (neighbor g m k).val = true) ∧
    (∀ k l : Fin 6, neighbor g m k = neighbor g m l → k = l) := by decide

set_option maxHeartbeats 12000000 in
theorem has_endpoint : ∀ (g : Fin 15) (p : Fin 60),
    (allowed g.val).testBit p.val = true → ∃ m : Fin 15,
      active g.val m ∧ (incident m).testBit p.val = true := by decide

set_option maxHeartbeats 12000000 in
theorem graph_sizes : ∀ g : Fin 15,
    ((List.finRange 60).filter fun p => (allowed g.val).testBit p.val).length = 36 ∧
    ((List.finRange 15).filter fun m => decide (active g.val m)).length = 12 ∧
    (∀ m : Fin 15, active g.val m →
      ((List.finRange 60).filter fun p => (allowed g.val &&& incident m).testBit p.val).length = 6) ∧
    (∀ p : Fin 60, (allowed g.val).testBit p.val = true →
      ((List.finRange 15).filter fun m => (incident m).testBit p.val).length = 2) := by decide

end MatchingRows

namespace MatchingRows.Orbit

structure Action where
  vertices : Nat
  inverseVertices : Nat
  groups : Nat
  inverseGroups : Nat
  points : Nat
  inversePoints : Nat

def map15 (code : Nat) (i : Fin 15) : Fin 15 :=
  Fin.ofNat 15 ((code >>> (4 * i.val)) % 16)
def map60 (code : Nat) (i : Fin 60) : Fin 60 :=
  Fin.ofNat 60 ((code >>> (6 * i.val)) % 64)

def pairSet (g : Nat) : List (Nat × Nat) :=
  if g = 0 then [(9,14),(10,13),(11,12)] else if g = 9 then [(0,14),(3,8),(4,7)]
  else [(0,9),(1,6),(2,5)]

abbrev Valid (s : Action) : Prop :=
  (∀ i : Fin 15, map15 s.inverseVertices (map15 s.vertices i) = i ∧
    map15 s.vertices (map15 s.inverseVertices i) = i ∧
    map15 s.inverseGroups (map15 s.groups i) = i ∧ map15 s.groups (map15 s.inverseGroups i) = i) ∧
  (∀ i : Fin 60, map60 s.inversePoints (map60 s.points i) = i ∧
    map60 s.points (map60 s.inversePoints i) = i) ∧
  ∀ (i : Fin 15) (p : Fin 60),
    (allowed i.val).testBit p.val = (allowed (map15 s.groups i).val).testBit (map60 s.points p).val ∧
    (incident i).testBit p.val = (incident (map15 s.vertices i)).testBit (map60 s.points p).val

abbrev ToZero (s : Action) (g : Fin 15) : Prop :=
  map15 s.groups g = 0 ∧
  (∀ e ∈ pairSet g.val, ∃ f ∈ pairSet 0,
    let a := (map15 s.groups (Fin.ofNat 15 e.1)).val
    let b := (map15 s.groups (Fin.ofNat 15 e.2)).val
    (a,b) = f ∨ (b,a) = f) ∧
  (∀ f ∈ pairSet 0, ∃ e ∈ pairSet g.val,
    let a := (map15 s.groups (Fin.ofNat 15 e.1)).val
    let b := (map15 s.groups (Fin.ofNat 15 e.2)).val
    (a,b) = f ∨ (b,a) = f)

def maskImage (s : Action) (w : Nat) : Nat :=
  (List.finRange 60).foldr (fun p acc =>
    if w.testBit p.val then (1 <<< (map60 s.points p).val) ||| acc else acc) 0

def ins (a : Nat) : List Nat → List Nat
  | [] => [a]
  | b :: bs => if a ≤ b then a :: b :: bs else b :: ins a bs

def sorted : List Nat → List Nat
  | [] => []
  | x :: xs => ins x (sorted xs)

def factorImage (s : Action) (f : List Nat) : List Nat := sorted (f.map (maskImage s))

end MatchingRows.Orbit

namespace MatchingRows

theorem six_surjective (f : Fin 6 → Fin 6) (hf : ∀ x y, f x = f y → x = y) :
    ∀ i, ∃ k, f k = i := by
  intro i
  have hmap : ((List.finRange 6).map f).Nodup := by
    apply List.pairwise_map.mpr
    exact (List.nodup_finRange 6).imp (fun h e => h (hf _ _ e))
  by_cases hit : i ∈ (List.finRange 6).map f
  · obtain ⟨k, _, hk⟩ := List.mem_map.mp hit
    exact ⟨k, hk⟩
  · have hd := List.nodup_cons.mpr ⟨hit, hmap⟩
    have hs : i :: (List.finRange 6).map f ⊆ List.finRange 6 :=
      fun {_} _ => List.mem_finRange _
    have hl := hd.length_le_of_subset hs
    simp at hl

end MatchingRows

namespace MatchingRows

theorem thin_unique {w i j : Nat} (h : w &&& (w - 1) = 0)
    (hi : w.testBit i = true) (hj : w.testBit j = true) : i = j := by
  have hw : w ≠ 0 := by
    intro hz
    simp [hz] at hi
  obtain ⟨k, rfl⟩ := (Nat.and_sub_one_eq_zero_iff_isPowerOfTwo hw).mp h
  simp only [Nat.testBit_two_pow, decide_eq_true_eq] at hi hj
  exact hi.symm.trans hj

end MatchingRows

namespace MatchingRows

theorem fold_or_bits (xs : List Nat) (p : Nat) :
    (xs.foldr Nat.lor 0).testBit p = true ↔ ∃ x ∈ xs, x.testBit p = true := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih]

def blockAt (b : List Nat) (h : b.length = 6) (i : Fin 6) : Nat :=
  b[i.val]'(by rw [h]; exact i.isLt)

theorem blockAt_mem (b : List Nat) (h : b.length = 6) (i : Fin 6) :
    blockAt b h i ∈ b := List.getElem_mem ..

theorem to_index (b : List Nat) (h : b.length = 6) (x : Nat) (hx : x ∈ b) :
    ∃ i : Fin 6, blockAt b h i = x := by
  obtain ⟨j, hj, he⟩ := List.getElem_of_mem hx
  exact ⟨⟨j,h ▸ hj⟩,he⟩

theorem allowed_lt {g p : Nat} (hp : (allowed g).testBit p = true) : p < 60 := by
  rw [allowed, ← Nat.and_two_pow_sub_one_eq_mod, Nat.testBit_and, Bool.and_eq_true,
      Nat.testBit_two_pow_sub_one] at hp
  exact of_decide_eq_true hp.2

theorem legal_factors {g : Nat} (hg : g < 15) {b : List Nat} (hb : legal g b) :
    (∀ x ∈ b, perfectRow g x) ∧
    ∀ i j : Fin 6, i ≠ j → blockAt b hb.1 i &&& blockAt b hb.1 j = 0 := by
  let G : Fin 15 := ⟨g, hg⟩
  let row := blockAt b hb.1
  have row_mem (i : Fin 6) : row i ∈ b := blockAt_mem _ _ i
  have is_allowed (x : Nat) (hx : x ∈ b) (p : Nat) (hxp : x.testBit p = true) :
      (allowed g).testBit p = true := hb.2.2.1 ▸ (fold_or_bits b p).2 ⟨x,hx,hxp⟩
  have owner_exists (p : Fin 60) (hp : (allowed g).testBit p.val = true) :
      ∃ i : Fin 6, (row i).testBit p.val = true := by
    rw [← hb.2.2.1, fold_or_bits] at hp
    obtain ⟨x,hx,hp⟩ := hp
    obtain ⟨i,he⟩ := to_index b hb.1 x hx
    change row i = x at he
    exact ⟨i,he.symm ▸ hp⟩
  have at_vertex (m : Fin 15) (hm : active g m) :
      ∃ f : Fin 6 → Fin 6, (∀ k : Fin 6,
          (row (f k) &&& incident m).testBit (neighbor G m k).val = true) ∧
        (∀ i : Fin 6, ∃ k, f k = i) := by
    obtain ⟨hits, separate⟩ := six_neighbors G m hm
    let f (k : Fin 6) := Classical.choose (owner_exists (neighbor G m k) (hits k).1)
    have hf (k : Fin 6) :
        (row (f k) &&& incident m).testBit (neighbor G m k).val = true := by
      rw [Nat.testBit_and, Bool.and_eq_true]
      exact ⟨Classical.choose_spec (owner_exists (neighbor G m k) (hits k).1), (hits k).2⟩
    refine ⟨f,hf,six_surjective f ?_⟩
    intro k l e
    apply separate k l
    apply Fin.ext
    apply thin_unique (hb.2.2.2 _ (row_mem (f k)) m) (hf k)
    rw [e]
    exact hf l
  constructor
  · intro x hx
    refine ⟨is_allowed x hx, ?_⟩
    intro m hm
    obtain ⟨i,hi⟩ := to_index b hb.1 x hx
    obtain ⟨f,hf,onto⟩ := at_vertex m hm
    obtain ⟨k,hk⟩ := onto i
    have hhit := hf k
    change (row (f k) &&& incident m).testBit (neighbor G m k).val = true at hhit
    rw [hk] at hhit
    change row i = x at hi
    rw [hi] at hhit
    exact ⟨neighbor G m k,hhit,fun q hq => Fin.ext (thin_unique (hb.2.2.2 x hx m) hq hhit)⟩
  · intro i j hne
    apply Nat.eq_of_testBit_eq
    intro p
    change (row i &&& row j).testBit p = (0 : Nat).testBit p
    simp only [Nat.zero_testBit]
    apply Bool.eq_false_iff.mpr
    intro both
    rw [Nat.testBit_and, Bool.and_eq_true] at both
    obtain ⟨hi, hj⟩ := both
    have hp := is_allowed (row i) (row_mem i) p hi
    let P : Fin 60 := ⟨p, allowed_lt hp⟩
    obtain ⟨m,hm,hip⟩ := has_endpoint G P hp
    obtain ⟨f,hf,onto⟩ := at_vertex m hm
    obtain ⟨k,hk⟩ := onto i
    obtain ⟨l,hl⟩ := onto j
    have pos (a : Fin 6) (idx : Fin 6) (he : f a = idx) (here : (row idx).testBit p = true) :
        (neighbor G m a).val = p := by
      have hv := hf a
      rw [he] at hv
      apply thin_unique (hb.2.2.2 _ (row_mem idx) m) hv
      rw [Nat.testBit_and, Bool.and_eq_true]
      exact ⟨here, hip⟩
    have same := (six_neighbors G m hm).2 k l (Fin.ext ((pos k i hk hi).trans (pos l j hl hj).symm))
    exact hne (hk.symm.trans ((congrArg f same).trans hl))

theorem legal_rows_in_catalogue {g : Nat} (hg : g < 15) {b : List Nat} (hb : legal g b)
    (catalogue : Nat → List Nat) (complete : ∀ x, perfectRow g x → x ∈ catalogue g) :
    ∀ x ∈ b, x ∈ catalogue g := fun x hx => complete x ((legal_factors hg hb).1 x hx)

end MatchingRows

namespace MatchingRows.Orbit

private theorem image_bits_aux (s : Action) (w pos : Nat) (vs : List (Fin 60)) :
    ((vs.foldr (fun p acc => if w.testBit p.val then (1 <<< (map60 s.points p).val) ||| acc else acc) 0).testBit pos = true) ↔
      ∃ p ∈ vs, w.testBit p.val = true ∧ (map60 s.points p).val = pos := by
  induction vs with
  | nil => simp
  | cons p ps ih =>
    by_cases h : w.testBit p.val = true
    · have one : (1 <<< (map60 s.points p).val).testBit pos = decide ((map60 s.points p).val = pos) := by
        simp [Nat.shiftLeft_eq, Nat.testBit_two_pow]
      simp [h, one, ih]
    · simp [h, ih]

theorem image_bits (s : Action) (w pos : Nat) :
    (maskImage s w).testBit pos = true ↔
      ∃ p : Fin 60, w.testBit p.val = true ∧ (map60 s.points p).val = pos := by
  simpa only [maskImage, List.mem_finRange, true_and] using image_bits_aux s w pos (List.finRange 60)

private theorem inj_points {s : Action} (hs : Valid s) {a b : Fin 60}
    (h : (map60 s.points a).val = (map60 s.points b).val) : a = b := by
  have eq := congrArg (map60 s.inversePoints) (Fin.ext h)
  simpa only [(hs.2.1 a).1, (hs.2.1 b).1] using eq

private theorem thin_of_unique {w : Nat}
    (h : ∀ i j, w.testBit i = true → w.testBit j = true → i = j) : thin w := by
  by_cases hn : ∃ i, w.testBit i = true
  · obtain ⟨i, hi⟩ := hn
    have heq : w = 2^i := by
      apply Nat.eq_of_testBit_eq
      intro j
      rw [Nat.testBit_two_pow]
      by_cases hj : w.testBit j = true
      · simp [hj, h i j hi hj]
      · have ij : i ≠ j := fun eq => hj (eq ▸ hi)
        simp [hj, ij]
    rw [heq]
    exact (Nat.and_sub_one_eq_zero_iff_isPowerOfTwo (Nat.ne_of_gt (Nat.two_pow_pos i))).mpr ⟨i,rfl⟩
  · have heq : w = 0 := by
      apply Nat.eq_of_testBit_eq
      intro j
      have hj : w.testBit j ≠ true := fun hit => hn ⟨j,hit⟩
      simp [hj]
    simp [thin, heq]

private theorem ins_mem (k a : Nat) (xs : List Nat) : k ∈ ins a xs ↔ k = a ∨ k ∈ xs := by
  induction xs with
  | nil => simp [ins]
  | cons b bs ih => by_cases h : a ≤ b <;> simp [ins,h,ih] <;> grind

private theorem ins_len (a : Nat) (xs : List Nat) : (ins a xs).length = xs.length + 1 := by
  induction xs with
  | nil => rfl
  | cons b bs ih => by_cases h : a ≤ b <;> simp [ins,h,ih]

private theorem sorted_mem (k : Nat) (xs : List Nat) : k ∈ sorted xs ↔ k ∈ xs := by
  induction xs with
  | nil => simp [sorted]
  | cons x xs ih => simp [sorted, ins_mem, ih]

private theorem sorted_len (xs : List Nat) : (sorted xs).length = xs.length := by
  induction xs <;> simp [sorted, ins_len, *]

private theorem ins_sorted (a : Nat) (xs : List Nat) (h : xs.Pairwise (· ≤ ·)) :
    (ins a xs).Pairwise (· ≤ ·) := by
  induction xs with
  | nil => simp [ins]
  | cons b bs ih =>
    obtain ⟨hb,hs⟩ := List.pairwise_cons.mp h
    by_cases hab : a ≤ b
    · simp only [ins,if_pos hab, List.pairwise_cons]
      exact ⟨fun t ht => by
        rcases List.mem_cons.mp ht with rfl | ht
        · exact hab
        · exact Nat.le_trans hab (hb t ht), hb, hs⟩
    · simp only [ins,if_neg hab, List.pairwise_cons]
      exact ⟨fun t ht => by
        rcases (ins_mem t a bs).mp ht with rfl | ht
        · omega
        · exact hb t ht, ih hs⟩

private theorem sorted_ok (xs : List Nat) : (sorted xs).Pairwise (· ≤ ·) := by
  induction xs with
  | nil => exact .nil
  | cons a as ih => exact ins_sorted a _ ih

private theorem ins_perm (a : Nat) (xs : List Nat) : (ins a xs).Perm (a :: xs) := by
  induction xs with
  | nil => exact .refl _
  | cons x xs ih =>
    by_cases h : a ≤ x
    · simp [ins,h]
    · simp only [ins,if_neg h]
      exact (ih.cons x).trans (.swap a x xs)

theorem sorted_perm (xs : List Nat) : (sorted xs).Perm xs := by
  induction xs with
  | nil => exact .refl _
  | cons a as ih => exact (ins_perm a (sorted as)).trans (ih.cons a)

theorem sorted_eq_of_perm {xs b : List Nat} (h : xs.Perm b) (hb : b.Pairwise (· ≤ ·)) :
    sorted xs = b :=
  List.Perm.eq_of_pairwise (fun _ _ _ _ => Nat.le_antisymm) (sorted_ok xs) hb
    ((sorted_perm xs).trans h)

theorem factor_mem (s : Action) (b : List Nat) (y : Nat) :
    y ∈ factorImage s b ↔ ∃ x ∈ b, maskImage s x = y := by
  simp [factorImage,sorted_mem]

private theorem image_lookup {s : Action} (hs : Valid s) (w : Nat) (p : Fin 60) :
    (maskImage s w).testBit (map60 s.points p).val = true ↔ w.testBit p.val = true := by
  rw [image_bits]
  constructor
  · rintro ⟨i, hi, hep⟩
    exact inj_points hs hep ▸ hi
  · exact fun hp => ⟨p, hp, rfl⟩

theorem legal_image {s : Action} (hs : Valid s) (g : Fin 15) {b : List Nat} (hb : legal g b) :
    legal (map15 s.groups g) (factorImage s b) := by
  obtain ⟨hlen, _, hunion, hthin⟩ := hb
  refine ⟨by simpa [factorImage,sorted_len] using hlen, ?_, ?_, ?_⟩
  · exact sorted_ok _
  · apply Nat.eq_of_testBit_eq
    intro pos
    apply Bool.eq_iff_iff.mpr
    rw [fold_or_bits]
    constructor
    · rintro ⟨y, hy, hyp⟩
      obtain ⟨x, hx, rfl⟩ := (factor_mem s b y).mp hy
      obtain ⟨i, hi, rfl⟩ := (image_bits ..).mp hyp
      rw [← (hs.2.2 g i).1, ← hunion, fold_or_bits]
      exact ⟨x, hx, hi⟩
    · intro hpos
      let p : Fin 60 := ⟨pos, allowed_lt hpos⟩
      let i := map60 s.inversePoints p
      have ei : map60 s.points i = p := (hs.2.1 p).2
      have hit : (allowed g).testBit i.val = true := by rw [(hs.2.2 g i).1, ei]; exact hpos
      rw [← hunion, fold_or_bits] at hit
      obtain ⟨x, hx, hxi⟩ := hit
      exact ⟨maskImage s x, (factor_mem ..).mpr ⟨x,hx,rfl⟩, (image_bits ..).mpr ⟨i,hxi, congrArg Fin.val ei⟩⟩
  · intro y hy m
    obtain ⟨x, hx, rfl⟩ := (factor_mem s b y).mp hy
    let v := map15 s.inverseVertices m
    have hv : map15 s.vertices v = m := (hs.1 m).2.1
    apply thin_of_unique
    intro p q hp hq
    simp only [Nat.testBit_and, Bool.and_eq_true_iff] at hp hq
    obtain ⟨i, hxi, rfl⟩ := (image_bits ..).mp hp.1
    obtain ⟨j, hxj, rfl⟩ := (image_bits ..).mp hq.1
    have hit (i : Fin 60) (h : (incident m).testBit (map60 s.points i).val = true) :
        (incident v).testBit i.val = true := by rw [(hs.2.2 v i).2, hv]; exact h
    have eq := thin_unique (i := i.val) (j := j.val) (hthin x hx v)
      (by simpa [Nat.testBit_and, hxi] using hit i hp.2)
      (by simpa [Nat.testBit_and, hxj] using hit j hq.2)
    exact congrArg (fun p : Fin 60 => (map60 s.points p).val) (Fin.ext eq)

def Compatible (b c : List Nat) := ∀ x ∈ b, ∀ y ∈ c, thin (x &&& y)

theorem compat_image {s : Action} (hs : Valid s) {b c : List Nat} (h : Compatible b c) :
    Compatible (factorImage s b) (factorImage s c) := by
  intro a ha d hd
  obtain ⟨x, hx, rfl⟩ := (factor_mem ..).mp ha
  obtain ⟨y, hy, rfl⟩ := (factor_mem ..).mp hd
  apply thin_of_unique
  intro p q hp hq
  simp only [Nat.testBit_and, Bool.and_eq_true_iff] at hp hq
  obtain ⟨i,hxi,rfl⟩ := (image_bits ..).mp hp.1
  obtain ⟨j,hxj,rfl⟩ := (image_bits ..).mp hq.1
  have hi := (image_lookup hs y i).mp hp.2
  have hj := (image_lookup hs y j).mp hq.2
  have eq := thin_unique (i := i.val) (j := j.val) (h x hx y hy)
    (by simp [Nat.testBit_and,hxi,hi]) (by simp [Nat.testBit_and,hxj,hj])
  exact congrArg (fun p : Fin 60 => (map60 s.points p).val) (Fin.ext eq)

def Extends (x : List Nat) (b c : Nat) : Prop :=
  ∃ y z, legal b y ∧ legal c z ∧ Compatible x y ∧ Compatible x z ∧ Compatible y z

theorem extension_image (s : Action) (hs : Valid s) (b c : Fin 15) (x : List Nat)
    (h : Extends x b c) : Extends (factorImage s x) (map15 s.groups b) (map15 s.groups c) := by
  obtain ⟨y, z, hy, hz, hxy, hxz, hyz⟩ := h
  exact ⟨factorImage s y, factorImage s z, legal_image hs b hy, legal_image hs c hz,
    compat_image hs hxy, compat_image hs hxz, compat_image hs hyz⟩

theorem extension_comm (x : List Nat) (b c : Nat) (h : Extends x b c) : Extends x c b := by
  obtain ⟨y, z, hy, hz, hxy, hxz, hyz⟩ := h
  exact ⟨z, y, hz, hy, hxz, hxy, fun a ha d hd => by simpa [Nat.and_comm] using hyz d hd a ha⟩

def Viable (g : Nat) (x : List Nat) : Prop := legal g x ∧ ∀ t ∈ pairSet g, Extends x t.1 t.2

private theorem partner_bounds (g : Fin 15) : ∀ t ∈ pairSet g.val, t.1 < 15 ∧ t.2 < 15 := by
  revert g
  decide +kernel

theorem viable_zero (s : Action) (hs : Valid s) (g : Fin 15) (hzero : ToZero s g)
    (x : List Nat) (h : Viable g.val x) : Viable 0 (factorImage s x) := by
  refine ⟨by simpa [hzero.1] using legal_image hs g h.1, ?_⟩
  intro t ht
  obtain ⟨e,he,hor⟩ := hzero.2.2 t ht
  have ⟨ha,hb⟩ := partner_bounds g e he
  let a := Fin.ofNat 15 e.1
  let b := Fin.ofNat 15 e.2
  have ae : a.val = e.1 := Nat.mod_eq_of_lt ha
  have be : b.val = e.2 := Nat.mod_eq_of_lt hb
  have ext := extension_image s hs a b x (by simpa only [ae,be] using h.2 e he)
  rcases hor with eq | eq
  · rw [←eq]
    exact ext
  · rw [←eq]
    exact extension_comm _ _ _ ext


end MatchingRows.Orbit

namespace PlaneCases

open MatchingRows MatchingRows.Orbit

theorem forbidden_if_checked
    (goodAt : ∀ (xs c d : List Nat), (∀ i ∈ xs, i < 344) → legal 9 c → legal 14 d →
      (∀ i ∈ xs, ∀ x ∈ c, thin (PlaneData.rootRow i &&& x)) →
      (∀ i ∈ xs, ∀ x ∈ d, thin (PlaneData.rootRow i &&& x)) → Compatible c d →
      ∃ W, EC.Family PlaneData.tables W ∧ EC.Good PlaneData.tables W (PlaneData.init xs))
    (k : Fin 1013) (cert : Nat)
    (checked : PlaneData.check (indices (factorCode k.val)) cert = true) :
    ¬ Extends (factor k.val) 9 14 := by
  rintro ⟨c,d,hc,hd,hrc,hrd,hcd⟩
  obtain ⟨W,family,good⟩ := goodAt _ c d (index_bound k) hc hd
    (fun i hi => hrc _ (List.mem_map.mpr ⟨i,hi,rfl⟩))
    (fun i hi => hrd _ (List.mem_map.mpr ⟨i,hi,rfl⟩)) hcd
  apply EC.visit_forbids (EC.Good PlaneData.tables W)
    (fun _ h => EC.good_step family h) 13 _ cert 0 good
  rw [← PlaneData.search_eq_visit]
  exact beq_iff_eq.mp checked

end PlaneCases

namespace MatchingRows

/-- The two endpoints of each edge, packed in low-to-high edge index order. -/
def endLow (p : Fin 60) : Fin 15 :=
  Fin.ofNat 15 (((0xbbaa99888877776666555555444444333333222222221111111100000000 : Nat) >>> (4*p.val)) % 16)
def endHigh (p : Fin 60) : Fin 15 :=
  Fin.ofNat 15 (((0xdcecedeca9dcb9edbaeda976dcba86ecb987edb98643ecba7653dca98754 : Nat) >>> (4*p.val)) % 16)

def otherEnd (m : Fin 15) (p : Fin 60) : Fin 15 :=
  if endLow p = m then endHigh p else endLow p

set_option maxHeartbeats 12000000 in
theorem otherEnd_valid : ∀ (g m : Fin 15) (k : Fin 6), active g.val m →
    let p := neighbor g m k
    active g.val (otherEnd m p) ∧ (incident (otherEnd m p)).testBit p.val = true := by decide

set_option maxHeartbeats 12000000 in
theorem mem_neighbors : ∀ (g m : Fin 15) (p : Fin 60),
    (allowed g.val &&& incident m).testBit p.val = true → ∃ k : Fin 6, neighbor g m k = p := by decide

/-- Scan the active vertices in increasing order, choosing an incident edge when
the vertex is uncovered. The other endpoint must still be free. -/
def enumerateRows (g : Fin 15) : List (Fin 15) → Nat → List Nat
  | [], row => [row]
  | m :: ms, row =>
    if row &&& incident m = 0 then
      (List.finRange 6).flatMap fun k =>
        let p := neighbor g m k
        if row &&& incident (otherEnd m p) = 0 then
          enumerateRows g ms (row ||| 2^p.val) else []
    else enumerateRows g ms row

def catalogue (g : Fin 15) : List Nat :=
  enumerateRows g ((List.finRange 15).filter (fun m => decide (active g.val m))) 0

private theorem row_edge_unique {g : Fin 15} {x y : Nat} (hx : perfectRow g.val x)
    (sub : ∀ j, y.testBit j = true → x.testBit j = true)
    {m : Fin 15} (hm : active g.val m) {p : Fin 60}
    (xp : (x &&& incident m).testBit p.val = true) (used : y &&& incident m ≠ 0) :
    y.testBit p.val = true := by
  obtain ⟨q, hq⟩ := Nat.exists_testBit_of_ne_zero used
  rw [Nat.testBit_and, Bool.and_eq_true] at hq
  have hqx := sub q hq.1
  let Q : Fin 60 := ⟨q, allowed_lt (hx.1 _ hqx)⟩
  have hQ : (x &&& incident m).testBit Q.val = true := by
    rw [Nat.testBit_and, Bool.and_eq_true]
    exact ⟨hqx,hq.2⟩
  obtain ⟨r,_,hr⟩ := hx.2 m hm
  have e : Q = p := (hr _ hQ).trans (hr _ xp).symm
  exact (congrArg Fin.val e) ▸ hq.1

private theorem enumeration_complete {g : Fin 15} {x : Nat} (hx : perfectRow g.val x)
    (vs : List (Fin 15)) (row : Nat)
    (sub : ∀ j, row.testBit j = true → x.testBit j = true)
    (past : ∀ m, active g.val m → m ∉ vs → row &&& incident m ≠ 0)
    (act : ∀ m ∈ vs, active g.val m) : x ∈ enumerateRows g vs row := by
  induction vs generalizing row with
  | nil =>
    have e : x = row := by
      apply Nat.eq_of_testBit_eq
      intro j
      apply Bool.eq_iff_iff.mpr
      refine ⟨?_,sub j⟩
      intro h
      let p : Fin 60 := ⟨j, allowed_lt (hx.1 _ h)⟩
      obtain ⟨m,hm,hep⟩ := has_endpoint g p (hx.1 _ h)
      apply row_edge_unique hx sub hm (p := p) _ (past m hm (by simp))
      rw [Nat.testBit_and, Bool.and_eq_true]
      exact ⟨h,hep⟩
    simp [enumerateRows,e]
  | cons m ms ih =>
    have hm : active g.val m := act m (by simp)
    have restact : ∀ v ∈ ms, active g.val v := fun v hv => act v (.tail m hv)
    rw [enumerateRows]
    split
    next free =>
      obtain ⟨p,xp,_⟩ := hx.2 m hm
      have both := (Bool.and_eq_true_iff.mp ((Nat.testBit_and ..) ▸ xp))
      have allowedInc : (allowed g.val &&& incident m).testBit p.val = true := by
        rw [Nat.testBit_and, Bool.and_eq_true]
        exact ⟨hx.1 _ both.1,both.2⟩
      obtain ⟨k,hk⟩ := mem_neighbors g m p allowedInc
      apply List.mem_flatMap.mpr
      refine ⟨k,List.mem_finRange _,?_⟩
      dsimp only
      rw [hk]
      have valid := otherEnd_valid g m k hm
      dsimp only at valid
      rw [hk] at valid
      have otherFree : row &&& incident (otherEnd m p) = 0 := by
        apply Classical.byContradiction
        intro hbad
        have mem := row_edge_unique hx sub valid.1 (p := p) (by
          rw [Nat.testBit_and, Bool.and_eq_true]; exact ⟨both.1,valid.2⟩) hbad
        have overlap : (row &&& incident m).testBit p.val = true := by
          rw [Nat.testBit_and, Bool.and_eq_true]; exact ⟨mem,both.2⟩
        simp [free] at overlap
      rw [if_pos otherFree]
      apply ih _ ?_ ?_ restact
      · intro j hit
        simp only [Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq] at hit
        rcases hit with hpast | rfl
        · exact sub _ hpast
        · exact both.1
      · intro v hv hvs he
        by_cases hvm : v = m
        · subst v
          have hh := congrArg (fun q : Nat => q.testBit p.val) he
          simpa [Nat.testBit_and, Nat.testBit_or, Nat.testBit_two_pow, both.2] using hh
        · have hpast := past v hv (by simpa [hvm] using hvs)
          obtain ⟨q,hq⟩ := Nat.exists_testBit_of_ne_zero hpast
          have bits := Bool.and_eq_true_iff.mp ((Nat.testBit_and ..) ▸ hq)
          have hh := congrArg (fun v : Nat => v.testBit q) he
          simpa [Nat.testBit_and,Nat.testBit_or,bits.1,bits.2] using hh
    next used =>
      apply ih _ sub ?_ restact
      intro v hv hvs
      by_cases hvm : v = m
      · exact hvm ▸ used
      · exact past v hv (by simpa [hvm] using hvs)

theorem catalogue_complete (g : Fin 15) {x : Nat} (hx : perfectRow g.val x) :
    x ∈ catalogue g := by
  apply enumeration_complete hx
  · simp
  · intro m hm
    simp [List.mem_finRange,hm]
  · simp

end MatchingRows

namespace EC

open MatchingRows

/-- Build an initial exact-cover witness from two compatible legal groups, allowing the
initial option table to have already screened rows against a central group. -/
theorem good_of_legal {t : Tables} {s : State} (groups : Bool → Fin 15) (b : Bool → List Nat)
    (legalB : ∀ a, legal (groups a).val (b a))
    (compatible : ∀ a x, x ∈ b a → ∀ y, y ∈ b (!a) → thin (x &&& y))
    (rowsList : ∀ a x, x ∈ catalogue (groups a) → ∃ i : Fin 344, t.rows a i.val = x)
    (pointOK : ∀ a (i : Fin 344) (p : Fin 60), (t.rows a i.val).testBit p.val = true →
      (t.point a p.val).testBit i.val = true)
    (sameOK : ∀ a (i j : Fin 344), t.rows a i.val &&& t.rows a j.val = 0 →
      (t.disj a i.val).testBit j.val = true)
    (crossOK : ∀ a (i j : Fin 344), thin (t.rows a i.val &&& t.rows (!a) j.val) →
      (t.cross a i.val).testBit j.val = true)
    (optsOK : ∀ a (i : Fin 344), t.rows a i.val ∈ b a → (s.opts a).testBit i.val = true)
    (remOK : ∀ a, s.rem a = allowed (groups a).val) :
    ∃ W : Bool → Nat → Prop, Family t W ∧ Good t W s := by
  let row (a : Bool) := blockAt (b a) (legalB a).1
  have hm a k : row a k ∈ b a := blockAt_mem .. 
  have perfect a k := (legal_factors (groups a).isLt (legalB a)).1 _ (hm a k)
  have listed a k := rowsList a _ (catalogue_complete (groups a) (perfect a k))
  let code (a : Bool) (k : Fin 6) := Classical.choose (listed a k)
  have hcode a k : t.rows a (code a k).val = row a k := Classical.choose_spec (listed a k)
  let W (a : Bool) (i : Nat) := ∃ k : Fin 6, (code a k).val = i
  refine ⟨W, ?_, ?_⟩
  · have separate : ∀ a i j, W a i → W a j → i ≠ j → t.rows a i &&& t.rows a j = 0 := by
      rintro a i j ⟨k,rfl⟩ ⟨l,rfl⟩ hne
      rw [hcode,hcode]
      exact (legal_factors (groups a).isLt (legalB a)).2 k l (fun eq => hne (eq ▸ rfl))
    refine ⟨?_, separate, ?_, ?_⟩
    · rintro a i p ⟨k,rfl⟩ hp
      have hp' : (row a k).testBit p = true := hcode a k ▸ hp
      exact pointOK a (code a k) ⟨p,allowed_lt ((perfect a k).1 p hp')⟩ hp
    · rintro a i j hi hj hne
      have hd := separate a i j hi hj hne
      obtain ⟨k,rfl⟩ := hi
      obtain ⟨l,rfl⟩ := hj
      exact sameOK a (code a k) (code a l) hd
    · rintro a i j ⟨k,rfl⟩ ⟨l,rfl⟩
      apply crossOK a (code a k) (code (!a) l)
      rw [hcode,hcode]
      exact compatible a _ (hm a k) _ (hm (!a) l)
  · apply good_initial
    · rintro a i ⟨k,rfl⟩
      apply optsOK a (code a k)
      rw [hcode]
      exact hm a k
    · intro a p
      rw [remOK, ← (legalB a).2.2.1, fold_or_bits]
      constructor
      · rintro ⟨x,hx,hp⟩
        obtain ⟨k,hk⟩ := to_index _ (legalB a).1 x hx
        refine ⟨(code a k).val, ⟨k,rfl⟩, ?_⟩
        rw [hcode]
        change row a k = x at hk
        exact hk.symm ▸ hp
      · rintro ⟨_,⟨k,rfl⟩,hp⟩
        exact ⟨row a k,hm a k,hcode a k ▸ hp⟩


end EC

namespace PlaneData

/-- Up to six present bit positions, each removed as it is returned. -/
def positions : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, x => if x = 0 then [] else x.log2 :: positions n (x ^^^ (2 ^ x.log2))

private theorem removed_at {x p : Nat} (hx : x ≠ 0)
    (hp : (x ^^^ (2 ^ x.log2)).testBit p = true) : p ≠ x.log2 ∧ x.testBit p = true := by
  by_cases e : p = x.log2
  · subst p
    simp [Nat.testBit_log2 hx] at hp
  · have ne : x.log2 ≠ p := fun eq => e eq.symm
    exact ⟨e, by simpa [Nat.testBit_xor, Nat.testBit_two_pow, ne, e] using hp⟩

theorem positions_sound (n x : Nat) :
    (positions n x).Nodup ∧ ∀ p ∈ positions n x, x.testBit p = true := by
  induction n generalizing x with
  | zero => simp [positions]
  | succ n ih =>
    by_cases hx : x = 0
    · simp [positions,hx]
    · obtain ⟨hd,hbits⟩ := ih (x ^^^ 2 ^ x.log2)
      simp only [positions,if_neg hx,List.nodup_cons,List.mem_cons]
      refine ⟨⟨fun h => (removed_at hx (hbits _ h)).1 rfl, hd⟩, ?_⟩
      intro p h
      rcases h with rfl | h
      · exact Nat.testBit_log2 hx
      · exact (removed_at hx (hbits _ h)).2

/-- For all candidate rows simultaneously, masks having one hit, or at least two. -/
def blockers (s : Bool) : List Nat → Nat × Nat
  | [] => (0,0)
  | p :: ps =>
    let prev := blockers s ps
    (point s p ||| prev.1, (point s p &&& prev.1) ||| prev.2)

theorem one_sound (s : Bool) (ps : List Nat) (j : Nat) :
    (blockers s ps).1.testBit j = true → ∃ p ∈ ps, (point s p).testBit j = true := by
  induction ps with
  | nil => simp [blockers]
  | cons p ps ih =>
    simp only [blockers, Nat.testBit_or, Bool.or_eq_true]
    rintro (hp | hr)
    · exact ⟨p,by simp,hp⟩
    · obtain ⟨q,hq,hb⟩ := ih hr
      exact ⟨q,List.Mem.tail _ hq,hb⟩

theorem two_sound (s : Bool) (ps : List Nat) (hd : ps.Nodup) (j : Nat) :
    (blockers s ps).2.testBit j = true →
    ∃ p ∈ ps, ∃ q ∈ ps, p ≠ q ∧ (point s p).testBit j = true ∧ (point s q).testBit j = true := by
  induction ps with
  | nil => simp [blockers]
  | cons p ps ih =>
    obtain ⟨hnot,hd⟩ := List.nodup_cons.mp hd
    simp only [blockers, Nat.testBit_or, Nat.testBit_and, Bool.or_eq_true, Bool.and_eq_true]
    rintro (⟨hp,hr⟩ | hr)
    · obtain ⟨q,hq,hb⟩ := one_sound s ps j hr
      exact ⟨p,by simp,q,List.Mem.tail _ hq,fun e => hnot (e ▸ hq),hp,hb⟩
    · obtain ⟨q,hq,r,hr,hne,hb,hc⟩ := ih hd hr
      exact ⟨q,List.Mem.tail _ hq,r,List.Mem.tail _ hr,hne,hb,hc⟩

def full : Nat := 2^344-1

theorem finish_flag {flags bad : Nat} (h : (flags ||| bad) &&& full = full)
    (j : Fin 344) (safe : bad.testBit j.val ≠ true) : flags.testBit j.val = true := by
  have bits := congrArg (fun w : Nat => w.testBit j.val) h
  have hf : full.testBit j.val = true := by simp [full, Nat.testBit_two_pow_sub_one, j.isLt]
  change ((flags ||| bad) &&& full).testBit j.val = full.testBit j.val at bits
  simp only [Nat.testBit_and,Nat.testBit_or,hf,Bool.and_true,Bool.or_eq_true] at bits
  exact bits.elim id (fun hb => False.elim (safe hb))

end PlaneData

namespace PlaneData

abbrev flagsForRow (a : Bool) (i : Nat) : Prop :=
    row a i < 2^60 ∧ rootRow i < 2^60 ∧
    (disj a i ||| (blockers a (positions 6 (row a i))).1) &&& full = full ∧
    (cross a i ||| (blockers (!a) (positions 6 (row a i))).2) &&& full = full ∧
    (rootOpts a i ||| (blockers a (positions 6 (rootRow i))).2) &&& full = full
end PlaneData

