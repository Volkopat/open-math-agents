open MatchingRows MatchingRows.Orbit in
theorem OMA.solution : OMA.R_Erdos723_erdos_723_variants_leq_11_R1_H2_R2_H2_R1_H2_R1_H2_R2.H2 := by
  intro g hg S hS
  have bound : g < 15 := by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    omega
  let center : Fin 15 := ⟨g,bound⟩
  have sub : S ⊆ (Separated.candidates g).toFinset := by
    intro f hf
    have h := hS f hf
    exact List.mem_toFinset.mpr (Separated.final_cover Separated.checked_roots
      PlaneCases.rejected center hg f h.1 h.2)
  calc
    S.card ≤ (Separated.candidates g).toFinset.card := Finset.card_le_card sub
    _ ≤ (Separated.candidates g).length := List.toFinset_card_le _
    _ = 52 := Separated.candidates_length g hg
