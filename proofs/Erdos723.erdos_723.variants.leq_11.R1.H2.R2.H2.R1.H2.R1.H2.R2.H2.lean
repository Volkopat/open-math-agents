namespace MatchingRows.Orbit.Separated

structure RouteData where
  src : Nat
  dest : Nat
  idx : Nat

def routeAction (r : RouteData) := actions[r.idx]?.getD ⟨0,0,0,0,0,0⟩

abbrev GoodRoute (r : RouteData) : Prop :=
  r.idx < actions.length ∧ maskImage (routeAction r) r.src = r.dest ∧ r.dest ∈ roots ∧
  ∀ f ∈ allSurvivors, r.dest ∈ f → factorImage (inverse (routeAction r)) f ∈ allSurvivors

abbrev RoutesGood (rs : List RouteData) : Prop := ∀ r ∈ rs, GoodRoute r

theorem goodAppend {a b : List RouteData} (ha : RoutesGood a) (hb : RoutesGood b) :
    RoutesGood (a++b) := fun r h => (List.mem_append.mp h).elim (ha r) (hb r)


end MatchingRows.Orbit.Separated

