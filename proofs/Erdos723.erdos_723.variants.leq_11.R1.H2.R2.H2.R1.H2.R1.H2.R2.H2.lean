import OMAReductions.R_Erdos723_erdos_723_variants_leq_11_R1_H2_R2_H2_R1_H2_R1_H2_R2

/-! Separated marked blocks in the weight-fifteen incidence search.

A legal group consists of six disjoint perfect matchings whose union is the allowed
edge set. At center zero, the 344 perfect matchings split into 15 orbits under the
permutations preserving the three partner pairs. Eight matching orbits meet every
legal group. A separate exact-cover check proves that the remaining 132 matching rows
cannot cover the edge set.

Transporting one such row to its representative leaves 6,626 factorizations across the
eight root searches. The checked table either identifies a survivor or gives a
symmetry taking a failed extension to the fixed partner pair 9 and 14. The 1,013
extension certificates each choose an uncovered point on one side and branch on every
remaining compatible row through it. Their leaves exhibit an uncovered point with
no possible row.

Finally, transport the 86 listed center-zero survivors back to each center and filter
for separated markers. Each resulting list contains 52 entries.
-/

namespace EC

structure Tables where
  rows : Bool → Nat → Nat
  point : Bool → Nat → Nat
  disj : Bool → Nat → Nat
  cross : Bool → Nat → Nat

structure State where
  rem : Bool → Nat
  opts : Bool → Nat

def picks (t : Tables) (s : State) (side : Bool) (p : Nat) : Nat :=
  s.opts side &&& t.point side p

def child (t : Tables) (s : State) (side : Bool) (i : Nat) : State :=
  { rem := fun a =>
      if a = side then s.rem a ^^^ (s.rem a &&& t.rows side i) else s.rem a
    opts := fun a =>
      s.opts a &&& (if a = side then t.disj side i else t.cross side i) }

def highBit : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | n+1, k, w =>
    let upper := w >>> k
    if upper = 0 then highBit n (k/2) w else k + highBit n (k/2) upper

def pivotIndex (w : Nat) : Nat := highBit 9 256 w

def branches (step : Nat → Nat → Option Nat) : Nat → Nat → Nat → Option Nat
  | 0, pool, cert => if pool = 0 then some cert else none
  | fuel + 1, pool, cert =>
    if pool = 0 then some cert else
    let i := pivotIndex pool
    match step i cert with
    | none => none
    | some remaining => branches step fuel (pool ^^^ (2 ^ i)) remaining

def visit (t : Tables) : Nat → State → Nat → Option Nat
  | 0, _, _ => none
  | fuel + 1, s, cert =>
    let tag := cert % 128
    let side := decide (60 < tag)
    let p := if side then tag - 61 else tag - 1
    if 0 < tag ∧ tag ≤ 120 ∧ (s.rem side).testBit p = true then
      branches (fun i r => visit t fuel (child t s side i) r) 344
        (picks t s side p) (cert / 128)
    else none

end EC

