def tapeSlice (y k tape : Nat) : Option Nat :=
  let rem := allowed 0 ^^^ y
  RF.runChildren (fun x prev => if x &&& rem=x then
    RF.tapeWalk (RootTables.byPoint 0) (checkImage rowFactor) 4 (rem^^^x) [x,y] prev else some prev)
    (((nextRows y).drop (7*k)).take 7) tape

theorem slice_success {y k tape : Nat} (ok : tapeSlice y k tape=some 0) : slice7 accept y k=true := by
  apply List.all_eq_true.mpr
  intro x hx
  obtain ⟨before,after,done⟩ := RF.tape_ran_child _ ok hx
  by_cases fit : x &&& (allowed 0 ^^^ y)=x
  · simp only [visitChild,if_pos fit]
    apply RF.forced_sound
    apply RF.tape_forced _ _ _ tape_pass (tape:=before) (last:=after)
    simpa only [if_pos fit] using done
  · simp [visitChild,fit]

end MatchingRows.Orbit.Separated

