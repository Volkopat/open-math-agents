namespace MatchingRows

theorem active_some : ∀ g : Fin 15, ∃ m : Fin 15, active g.val m := by decide

theorem row_nonzero {g x : Nat} (hg : g < 15) (h : perfectRow g x) : x ≠ 0 := by
  obtain ⟨m,hm⟩ := active_some ⟨g,hg⟩
  obtain ⟨p,hp,_⟩ := h.2 m hm
  intro hx
  simp [hx] at hp

theorem legal_strict {g : Nat} (hg : g < 15) {b : List Nat} (h : legal g b) :
    b.Pairwise (· < ·) := by
  obtain ⟨perfect,disj⟩ := legal_factors hg h
  apply List.pairwise_iff_getElem.mpr
  intro i j hi hj hij
  have hle := List.pairwise_iff_getElem.mp h.2.1 i j hi hj hij
  apply Nat.lt_of_le_of_ne hle
  intro eq
  let u : Fin 6 := ⟨i,h.1 ▸ hi⟩
  let v : Fin 6 := ⟨j,h.1 ▸ hj⟩
  have d := disj u v (fun he => (Nat.ne_of_lt hij) (congrArg Fin.val he))
  change b[i] &&& b[j] = 0 at d
  rw [← eq, Nat.and_self] at d
  exact row_nonzero hg (perfect b[i] (List.getElem_mem ..)) d


end MatchingRows

namespace MatchingRows.RF

open MatchingRows.Orbit

/-- All branches fill the highest uncovered point, consuming only completely unused rows. -/
def walk (byPoint : Nat → List Nat) (check : List Nat → Bool) :
    Nat → Nat → List Nat → Bool
  | 0, rem, acc => if rem = 0 then check (sorted acc) else true
  | fuel + 1, rem, acc =>
    if rem = 0 then true else
      (byPoint rem.log2).all fun x =>
        if x &&& rem = x then walk byPoint check fuel (rem ^^^ x) (x :: acc) else true

/-- Start on a marked row. The remaining five rows are recovered by exact cover. -/
def certify (marked : List Nat) (byPoint : Nat → List Nat) (check : List Nat → Bool)
    (allMask : Nat) : Bool :=
  marked.all fun x => walk byPoint check 5 (allMask ^^^ x) [x]

private abbrev union (xs : List Nat) : Nat := xs.foldr Nat.lor 0
private abbrev Apart (xs : List Nat) : Prop := xs.Pairwise (fun x y => x &&& y = 0)

private theorem legal_apart {g : Fin 15} {b : List Nat} (h : legal g.val b) : Apart b := by
  apply List.pairwise_iff_getElem.mpr
  intro i j hi hj hij
  apply (legal_factors g.isLt h).2
    (⟨i,h.1 ▸ hi⟩ : Fin 6) (⟨j,h.1 ▸ hj⟩ : Fin 6)
  exact fun eq => (Nat.ne_of_lt hij) (congrArg Fin.val eq)

private theorem union_perm {xs ys : List Nat} (hp : xs.Perm ys) : union xs = union ys := by
  apply Nat.eq_of_testBit_eq
  intro i
  apply Bool.eq_iff_iff.mpr
  rw [fold_or_bits, fold_or_bits]
  exact exists_congr fun x => and_congr_left fun _ => hp.mem_iff

private theorem extract {x : Nat} {xs : List Nat} (hx : x ∈ xs) (hd : Apart xs) :
    x &&& union xs = x ∧ union xs ^^^ x = union (xs.erase x) ∧ Apart (xs.erase x) := by
  have perm := List.perm_cons_erase hx
  have eq : union xs = x ||| union (xs.erase x) := union_perm perm
  have pair := List.pairwise_cons.mp (perm.pairwise hd (fun {a b} h => (Nat.and_comm b a) ▸ h))
  have disj : x &&& union (xs.erase x) = 0 := by
    apply Nat.eq_of_testBit_eq
    intro p
    simp only [Nat.testBit_and, Nat.zero_testBit, Bool.and_eq_false_imp]
    intro xp
    apply Bool.eq_false_iff.mpr
    intro bit
    obtain ⟨y,hy,hp⟩ := (fold_or_bits _ _).mp bit
    have := congrArg (fun m : Nat => m.testBit p) (pair.1 y hy)
    simp [Nat.testBit_and, xp, hp] at this
  rw [eq]
  refine ⟨?_,?_,pair.2⟩
  · apply Nat.eq_of_testBit_eq
    intro p
    simp only [Nat.testBit_and,Nat.testBit_or]
    cases x.testBit p <;> simp
  · apply Nat.eq_of_testBit_eq
    intro p
    have d := congrArg (fun m : Nat => m.testBit p) disj
    simp only [Nat.testBit_and,Nat.zero_testBit] at d
    rw [Nat.testBit_xor,Nat.testBit_or]
    cases hxbit : x.testBit p <;> cases hrbit : (union (xs.erase x)).testBit p <;> simp_all

private theorem walk_covers (byPoint : Nat → List Nat) (check : List Nat → Bool) (fuel : Nat)
    (rest acc : List Nat) (hlen : rest.length = fuel) (hd : Apart rest)
    (hnz : ∀ y ∈ rest, y ≠ 0)
    (htable : ∀ y ∈ rest, ∀ p, y.testBit p = true → y ∈ byPoint p)
    (hc : walk byPoint check fuel (union rest) acc = true) :
    ∃ out, out.Perm (rest ++ acc) ∧ check (sorted out) = true := by
  induction fuel generalizing rest acc with
  | zero =>
    have := List.length_eq_zero_iff.mp hlen
    subst rest
    exact ⟨acc,by simp,by simpa [walk] using hc⟩
  | succ fuel ih =>
    have nrest : rest ≠ [] := fun eq => by simp [eq] at hlen
    have nonzero : union rest ≠ 0 := by
      obtain ⟨y,hy⟩ := List.exists_mem_of_ne_nil rest nrest
      obtain ⟨p,hp⟩ := Nat.exists_testBit_of_ne_zero (hnz y hy)
      have bit := (fold_or_bits rest p).mpr ⟨y,hy,hp⟩
      intro zero
      change (union rest).testBit p = true at bit
      simp [zero] at bit
    let p := (union rest).log2
    obtain ⟨x,hx,hbit⟩ := (fold_or_bits rest p).mp (Nat.testBit_log2 nonzero)
    have listed := htable x hx p hbit
    obtain ⟨subset, step, disj⟩ := extract hx hd
    rw [walk, if_neg nonzero, List.all_eq_true] at hc
    have hchild := hc x listed
    rw [if_pos subset,step] at hchild
    have hl : (rest.erase x).length = fuel := by rw [List.length_erase_of_mem hx,hlen]; rfl
    obtain ⟨out,hperm,hpass⟩ := ih (rest.erase x) (x :: acc) hl disj
      (fun y hy => hnz _ (List.mem_of_mem_erase hy))
      (fun y hy => htable _ (List.mem_of_mem_erase hy)) hchild
    have move : ((rest.erase x) ++ x :: acc).Perm (rest ++ acc) :=
      List.perm_middle.trans ((List.perm_cons_erase hx).symm.append_right acc)
    exact ⟨out,hperm.trans move,hpass⟩

/-- Completeness per marked root, with a permutation result independent of a sorting library. -/
theorem root_covers {g : Fin 15} {b : List Nat} (hb : legal g.val b)
    {x : Nat} (hx : x ∈ b) (byPoint : Nat → List Nat) (check : List Nat → Bool)
    (byPoint_complete : ∀ y ∈ catalogue g, ∀ p, y.testBit p = true → y ∈ byPoint p)
    (hc : walk byPoint check 5 (allowed g.val ^^^ x) [x] = true) :
    ∃ out, out.Perm b ∧ check (sorted out) = true := by
  have al : union b = allowed g.val := hb.2.2.1
  have apart := legal_apart hb
  obtain ⟨_, step, disj⟩ := extract hx apart
  rw [←al,step] at hc
  have hl : (b.erase x).length = 5 := by rw [List.length_erase_of_mem hx,hb.1]
  have perfect := (legal_factors g.isLt hb).1
  obtain ⟨out,perm,pass⟩ := walk_covers byPoint check 5 (b.erase x) [x] hl disj
    (fun y hy => row_nonzero g.isLt (perfect y (List.mem_of_mem_erase hy)))
    (fun y hy => byPoint_complete y (catalogue_complete g (perfect y (List.mem_of_mem_erase hy)))) hc
  exact ⟨out, perm.trans (List.perm_middle.trans (by simpa using (List.perm_cons_erase hx).symm)),pass⟩

/-- A check certified for the marked root row holds for the original numerically sorted factor. -/
theorem root_sound {g : Fin 15} {b : List Nat} (hb : legal g.val b)
    {x : Nat} (hx : x ∈ b) (byPoint : Nat → List Nat) (check : List Nat → Bool)
    (byPoint_complete : ∀ y ∈ catalogue g, ∀ p, y.testBit p = true → y ∈ byPoint p)
    (hc : walk byPoint check 5 (allowed g.val ^^^ x) [x] = true) : check b = true := by
  obtain ⟨out,perm,pass⟩ := root_covers hb hx byPoint check byPoint_complete hc
  rwa [sorted_eq_of_perm perm hb.2.1] at pass

/-- A complete catalogue for the marked rows and the rows incident to each point suffices
to transfer the finite Boolean check to every legal joined factorization. -/
theorem certify_sound {g : Fin 15} {b : List Nat} (hb : legal g.val b)
    (marker : Nat) (joined : ∃ x ∈ b, x &&& marker = marker)
    (marked : List Nat) (byPoint : Nat → List Nat) (check : List Nat → Bool)
    (marked_complete : ∀ x ∈ catalogue g, x &&& marker = marker → x ∈ marked)
    (byPoint_complete : ∀ y ∈ catalogue g, ∀ p, y.testBit p = true → y ∈ byPoint p)
    (hc : certify marked byPoint check (allowed g.val) = true) : check b = true := by
  obtain ⟨x,hx,hm⟩ := joined
  have hcat := catalogue_complete g ((legal_factors g.isLt hb).1 x hx)
  exact root_sound hb hx byPoint check byPoint_complete
    (List.all_eq_true.mp hc x (marked_complete x hcat hm))

/-- If a proposed row table would cover every row of a legal group, the
corresponding exhaustive search cannot reject all its leaves. -/
theorem contradiction_of_walk {g : Fin 15} {b : List Nat} (hb : legal g.val b)
    (byPoint : Nat → List Nat)
    (table : ∀ y ∈ b, ∀ p, y.testBit p = true → y ∈ byPoint p)
    (noCover : walk byPoint (fun _ => false) 6 (allowed g.val) [] = true) : False := by
  have pass : walk byPoint (fun _ => false) 6 (union b) [] = true := by
    change walk byPoint (fun _ => false) 6 (b.foldr Nat.lor 0) [] = true
    rwa [hb.2.2.1]
  obtain ⟨_,_,bad⟩ := walk_covers byPoint (fun _ => false) 6 b [] hb.1
    (legal_apart hb) (fun y hy => row_nonzero g.isLt ((legal_factors g.isLt hb).1 y hy))
    table pass
  contradiction

end MatchingRows.RF

