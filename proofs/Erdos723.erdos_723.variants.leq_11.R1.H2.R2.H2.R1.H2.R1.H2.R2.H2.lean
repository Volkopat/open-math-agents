private theorem routed : ∀ x ∈ SeparatedAnchors.anchorRows, x ∈ allRoutes.map RouteData.src := by
  decide +kernel

theorem cover_from_roots
    (rooted : ∀ f, Viable 0 f → ∀ y ∈ roots, y ∈ f → f ∈ allSurvivors)
    (f : List Nat) (hf : Viable 0 f) : f ∈ allSurvivors := by
  obtain ⟨x,hx,hr⟩ := SeparatedAnchors.hits hf.1
  obtain ⟨r,hr,eq⟩ := List.mem_map.mp (routed x hr)
  obtain ⟨index,moved,sel,closed⟩ := allRoutesGood r hr
  have inner : routeAction r = actions[r.idx] := by simp [routeAction,List.getElem?_eq_getElem index]
  have hm : routeAction r ∈ actions := inner ▸ List.getElem_mem index
  have hv := actions_valid _ hm
  have pushed := viable_zero (routeAction r) hv.1 0 hv.2 f hf
  have dest_mem : r.dest ∈ factorImage (routeAction r) f :=
    (factor_mem ..).mpr ⟨x,hx,eq ▸ moved⟩
  have retract := closed _ (rooted _ pushed r.dest sel dest_mem) dest_mem
  rwa [inverse_factor _ hv.1 hf.1] at retract


