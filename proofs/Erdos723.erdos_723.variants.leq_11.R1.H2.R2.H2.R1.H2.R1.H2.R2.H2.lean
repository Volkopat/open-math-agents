def marker (g : Nat) := if g = 0 then 4398063288320 else if g = 9 then 262400 else 131584

def joined (g : Nat) (f : List Nat) := ∃ x ∈ f, x &&& marker g = marker g

instance (g : Nat) (f : List Nat) : Decidable (joined g f) :=
  inferInstanceAs (Decidable (∃ x ∈ f, x &&& marker g = marker g))

def allAt (g : Nat) : List (List Nat) :=
  if g = 0 then allSurvivors else
    allSurvivors.map (factorImage (inverse (if g = 9 then chosen9 else chosen14)))

def candidates (g : Nat) : List (List Nat) := (allAt g).filter fun f => !decide (joined g f)

theorem inverse_mem (s : Action) {g : Fin 15} (h : Valid s ∧ ToZero s g)
    (cover : ∀ f, Viable 0 f → f ∈ allSurvivors) {f : List Nat} (hf : Viable g.val f) :
    f ∈ allSurvivors.map (factorImage (inverse s)) :=
  List.mem_map.mpr ⟨_, cover _ (viable_zero s h.1 g h.2 f hf), inverse_factor s h.1 hf.1⟩

theorem separated_mem (cover : ∀ f, Viable 0 f → f ∈ allSurvivors)
    (g : Fin 15) (hg : g.val ∈ [0,9,14]) {f : List Nat} (hv : Viable g.val f) (hj : ¬joined g.val f) :
    f ∈ candidates g.val := by
  apply List.mem_filter.mpr
  refine ⟨?_,by simp [hj]⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with h|h|h
  · have eq : g = 0 := Fin.ext h
    subst g
    exact cover f hv
  · have eq : g = 9 := Fin.ext h
    subst g
    exact inverse_mem chosen9 chosen9_valid cover hv
  · have eq : g = 14 := Fin.ext h
    subst g
    exact inverse_mem chosen14 chosen14_valid cover hv

