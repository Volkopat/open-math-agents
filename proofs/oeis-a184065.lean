  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hIcl t ht)
  exact rec_lift f 16 2176 D hD hcl hfd acc hacc P Q 10 base m hm q hq


theorem urecZ (m : ℕ) (hm : 10 ≤ m) :
    (a (m + 4) : ℤ) = 4 * a (m + 3) - 6 * a (m + 2) + 4 * a (m + 1) - a m := by
