theorem lin_T (L : List (ℕ × ℕ)) (hL : ∀ q ∈ L, 10 + q.2 ≤ 14) (p : ℕ × List ℕ) (hp : p ∈ D) :
    lin (fun j => (W f 16)^[j] acc) L 10 p.1 = (L.map fun q => q.1 * T (10 + q.2) p.1).sum := by
  unfold lin
  congr 1
  apply List.map_congr_left
