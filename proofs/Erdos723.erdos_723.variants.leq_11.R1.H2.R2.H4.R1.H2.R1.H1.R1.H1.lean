def original (record : Nat) : Nat := record &&& 32767
def orbit (record : Nat) : Nat := (record >>> 15) &&& 31
def relabel (record : Nat) : Nat := record >>> 20

def checkWord (w : Nat) : Bool :=
  if 11 ≤ countBits 15 w then
    let record := catalogue.get w
    (original record == w) &&
      decide (((List.range 6).map (image (relabel record))).Nodup) &&
      representatives[orbit record]? == some (moveWord w (relabel record))
  else true

def checkBlock (b : Nat) : Bool :=
  (List.range 256).all fun i => checkWord (256*b+i)


set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem allBlocks (b : Nat) (small : b < 128) : checkBlock b = true :=
  List.all_eq_true.mp (show (List.range 128).all checkBlock = true by decide +kernel) b (List.mem_range.mpr small)

theorem dense_graph_representatives (w : Nat) (small : w < 2^15) (large : 11 ≤ countBits 15 w) :
    ∃ rep ∈ representatives, ∃ move, ((List.range 6).map (image move)).Nodup ∧ moveWord w move = rep := by
  have block := allBlocks (w/256) (by omega)
  have tested := List.all_eq_true.mp block (w%256) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have eq : 256*(w/256)+w%256 = w := by omega
  change checkWord (256*(w/256)+w%256) = true at tested
  rw [eq] at tested
  simp only [checkWord, if_pos large, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at tested
  exact ⟨_,List.mem_of_getElem? tested.2,relabel (catalogue.get w),tested.1.2,rfl⟩


end WeightNineteenPairGraphs

theorem OMA.solution : OMA.R_Erdos723_erdos_723_variants_leq_11_R1_H2_R2_H4_R1_H2_R1_H1_R1.H1 := by
  intro A size maxPair overlap
  obtain ⟨w,small,large,atPair⟩ := WeightNineteenPairGraphs.encode_pair_layout A size maxPair overlap
  obtain ⟨rep,good,move,permutation,image⟩ := WeightNineteenPairGraphs.dense_graph_representatives w small large
  refine ⟨w,small,?_ ,rep,good,move,permutation,?_⟩
  · intro i
    have within : i.val < WeightNineteenPairGraphs.pairs.length := by
      simpa only [WeightNineteenPairGraphs.pairs_length] using i.isLt
    change w.testBit i.val = true ↔ ∃ p,
      A (WeightNineteenPairGraphs.pairs[i.val]!).1 p = true ∧
      A (WeightNineteenPairGraphs.pairs[i.val]!).2 p = true
    have pair_eq : WeightNineteenPairGraphs.pairs[i.val]! = WeightNineteenPairGraphs.pairOf i :=
      getElem!_pos WeightNineteenPairGraphs.pairs i.val within
    rw [pair_eq]
    exact atPair i
  · exact image
