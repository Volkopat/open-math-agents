/-- A finset of naturals is complete when each element is at most one more than the sum of the
smaller elements. -/
def Complete (S : Finset ℕ) : Prop := ∀ x ∈ S, x ≤ 1 + ∑ y ∈ S.filter (· < x), y

/-- Every number up to the total of a complete finset is a sum of some of its elements. -/
lemma complete_subsetSum (S : Finset ℕ) (hS : Complete S) :
    ∀ N ≤ ∑ y ∈ S, y, ∃ T ⊆ S, ∑ y ∈ T, y = N := by
  induction S using Finset.induction_on_max with
  | empty =>
    intro N hN
    exact ⟨∅, Finset.empty_subset _, by simp at hN ⊢; omega⟩
  | insert M S hlt ih =>
    have hMS : M ∉ S := fun h => lt_irrefl _ (hlt M h)
    have hS' : Complete S := by
      intro x hx
      have h1 := hS x (Finset.mem_insert_of_mem hx)
      have hxM := hlt x hx
      rwa [Finset.filter_insert, if_neg (by omega)] at h1
    have hM := hS M (Finset.mem_insert_self M S)
    rw [Finset.filter_insert, if_neg (lt_irrefl M), Finset.filter_true_of_mem hlt] at hM
    intro N hN
    rw [Finset.sum_insert hMS] at hN
    by_cases h : N ≤ ∑ y ∈ S, y
    · obtain ⟨T, hT, hsum⟩ := ih hS' N h
      exact ⟨T, hT.trans (Finset.subset_insert M S), hsum⟩
    · obtain ⟨T, hT, hsum⟩ := ih hS' (N - M) (by omega)
      refine ⟨insert M T, Finset.insert_subset_insert M hT, ?_⟩
      have hMT : M ∉ T := fun h => hMS (hT h)
      rw [Finset.sum_insert hMT, hsum]
      omega

/-- The divisors of a practical number form a complete finset. -/
lemma complete_divisors {m : ℕ} (hm : IsPractical m) : Complete m.divisors := by
  intro x hx
  have hxm : x ≤ m := Nat.divisor_le hx
  have hx0 : 0 < x := Nat.pos_of_mem_divisors hx
  obtain ⟨T, hT, hsum⟩ := hm.2 (x - 1) (by omega)
  have hsub : T ⊆ m.divisors.filter (· < x) := by
    intro d hd
    rw [Finset.mem_filter]
    refine ⟨hT hd, ?_⟩
    have hdle : d ≤ ∑ i ∈ T, i := Finset.single_le_sum (f := fun i : ℕ => i) (fun i _ => Nat.zero_le i) hd
    omega
  have h2 : ∑ i ∈ T, i ≤ ∑ y ∈ m.divisors.filter (· < x), y :=
    Finset.sum_le_sum_of_subset (f := fun i : ℕ => i) hsub
  omega

/-- A practical number represents every number up to the sum of its divisors. -/
lemma practical_subsetSum_sigma {m : ℕ} (hm : IsPractical m) {N : ℕ}
    (hN : N ≤ ∑ d ∈ m.divisors, d) : ∃ T ⊆ m.divisors, ∑ d ∈ T, d = N :=
  complete_subsetSum _ (complete_divisors hm) N hN

/-- Margenstern's lemma: if `m` is practical and `0 < n ≤ σ(m) + 1` then `m * n` is practical. -/
lemma practical_mul {m n : ℕ} (hm : IsPractical m) (hn0 : 0 < n)
    (hn : n ≤ ∑ d ∈ m.divisors, d + 1) : IsPractical (m * n) := by
  have hmn : 0 < m * n := Nat.mul_pos hm.1 hn0
  refine ⟨hmn, ?_⟩
  intro N hN
  have hr : N % n < n := Nat.mod_lt _ hn0
  have hq : N / n ≤ m := Nat.div_le_of_le_mul (by rw [Nat.mul_comm]; exact hN)
  obtain ⟨R, hR, hRs⟩ := practical_subsetSum_sigma hm (N := N % n) (by omega)
  obtain ⟨Q, hQ, hQs⟩ := hm.2 (N / n) hq
  refine ⟨R ∪ Q.image (n * ·), ?_, ?_⟩
  · intro x hx
    rcases Finset.mem_union.mp hx with hx | hx
    · exact Nat.mem_divisors.mpr
        ⟨Dvd.dvd.mul_right (Nat.dvd_of_mem_divisors (hR hx)) n, hmn.ne'⟩
    · obtain ⟨d, hd, rfl⟩ := Finset.mem_image.mp hx
      refine Nat.mem_divisors.mpr ⟨?_, hmn.ne'⟩
      rw [Nat.mul_comm m n]
      exact Nat.mul_dvd_mul_left n (Nat.dvd_of_mem_divisors (hQ hd))
  · have hdisj : Disjoint R (Q.image (n * ·)) := by
      rw [Finset.disjoint_left]
      intro x hxR hxQ
      obtain ⟨d, hd, rfl⟩ := Finset.mem_image.mp hxQ
      have hd0 : 0 < d := Nat.pos_of_mem_divisors (hQ hd)
      have h1 : n * d ≤ N % n := by
        rw [← hRs]; exact Finset.single_le_sum (f := fun i : ℕ => i) (fun i _ => Nat.zero_le i) hxR
      have h2 : n ≤ n * d := Nat.le_mul_of_pos_right n hd0
      omega
    rw [Finset.sum_union hdisj,
      Finset.sum_image (fun a _ b _ h => Nat.eq_of_mul_eq_mul_left hn0 h),
      ← Finset.mul_sum, hRs, hQs]
    have := Nat.div_add_mod N n
    omega

/-- Margenstern's lemma with the product written as a numeral. -/
lemma practical_mul' {m n N : ℕ} (hm : IsPractical m) (hN : m * n = N) (hn0 : 0 < n)
    (hn : n ≤ ∑ d ∈ m.divisors, d + 1) : IsPractical N := hN ▸ practical_mul hm hn0 hn

lemma practical_one : IsPractical 1 := by
  refine ⟨Nat.one_pos, ?_⟩
  intro m hm
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hm with rfl | rfl
  · exact ⟨∅, Finset.empty_subset _, by simp⟩
  · exact ⟨{1}, by simp, by simp⟩

lemma one_le_sigma {m : ℕ} (hm : 0 < m) : 1 ≤ ∑ d ∈ m.divisors, d :=
  Finset.single_le_sum (f := fun d => d) (fun i _ => Nat.zero_le i)
    (Nat.one_mem_divisors.mpr hm.ne')

lemma practical_two_pow (a : ℕ) : IsPractical (2 ^ a) := by
  induction a with
  | zero => simpa using practical_one
  | succ a ih =>
    rw [pow_succ]
    exact practical_mul ih (by norm_num) (by have := one_le_sigma ih.1; omega)

/-! ## A verified certificate checker for representability -/

/-- `vp p f m` counts how often `p` divides `m` (at most `f` times). Only used to choose a
candidate; the checker re-verifies every divisibility it relies on. -/
def vp (p : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 0
  | f + 1, m => cond (Nat.beq (m % p) 0) (vp p f (m / p) + 1) 0

/-- `geom p a = 1 + p + ... + p ^ a`. -/
def geom (p : ℕ) : ℕ → ℕ
  | 0 => 1
  | a + 1 => geom p a + p ^ (a + 1)

lemma geom_eq (p a : ℕ) : geom p a = ∑ x ∈ Finset.range (a + 1), p ^ x := by
  induction a with
  | zero => simp [geom]
  | succ a ih => rw [geom, ih, Finset.sum_range_succ (n := a + 1)]

lemma sigma_two_pow_mul_three_pow (a b : ℕ) :
    ∑ d ∈ (2 ^ a * 3 ^ b).divisors, d = geom 2 a * geom 3 b := by
  have hc : Nat.Coprime (2 ^ a) (3 ^ b) := Nat.Coprime.pow a b (by norm_num)
  rw [Nat.Coprime.sum_divisors_mul hc, Nat.sum_divisors_prime_pow Nat.prime_two,
    Nat.sum_divisors_prime_pow Nat.prime_three, geom_eq, geom_eq]

lemma one_le_geom (p a : ℕ) : 1 ≤ geom p a := by
  induction a with
  | zero => simp [geom]
  | succ a ih => rw [geom]; omega

lemma three_le_geom_two {a : ℕ} (ha : 1 ≤ a) : 3 ≤ geom 2 a := by
  obtain ⟨c, rfl⟩ : ∃ c, a = c + 1 := ⟨a - 1, by omega⟩
  rw [geom]
  have h1 := one_le_geom 2 c
  have h2 : 2 ≤ 2 ^ (c + 1) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (c + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  omega

lemma practical_two_pow_mul_three_pow {a : ℕ} (ha : 1 ≤ a) (b : ℕ) :
    IsPractical (2 ^ a * 3 ^ b) := by
  induction b with
  | zero => simpa using practical_two_pow a
  | succ b ih =>
    rw [pow_succ, ← Nat.mul_assoc]
    refine practical_mul ih (by norm_num) ?_
    rw [sigma_two_pow_mul_three_pow]
    have h1 := three_le_geom_two ha
    have h2 := one_le_geom 3 b
    have : 3 ≤ geom 2 a * geom 3 b := le_trans h1 (Nat.le_mul_of_pos_right _ h2)
    omega

/-- The family F23: `m = 2^a 3^b t` with `a ≥ 1` and `t ≤ σ(2^a 3^b) + 1`. -/
def f23core (m a b : ℕ) : Bool :=
  Nat.blt 0 m && Nat.ble 1 a && Nat.beq (m % (2 ^ a * 3 ^ b)) 0 &&
    Nat.ble (m / (2 ^ a * 3 ^ b)) (geom 2 a * geom 3 b + 1)

def f23 (m : ℕ) : Bool := f23core m (vp 2 64 m) (vp 3 64 m)

lemma practical_of_f23core {m a b : ℕ} (h : f23core m a b = true) : IsPractical m := by
  simp only [f23core, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq, Nat.beq_eq] at h
  obtain ⟨⟨⟨hm, ha⟩, hmod⟩, hle⟩ := h
  have hdvd : 2 ^ a * 3 ^ b ∣ m := Nat.dvd_of_mod_eq_zero hmod
  have hDpos : 0 < 2 ^ a * 3 ^ b := Nat.mul_pos (by positivity) (by positivity)
  have ht : 0 < m / (2 ^ a * 3 ^ b) := Nat.div_pos (Nat.le_of_dvd hm hdvd) hDpos
  rw [← Nat.mul_div_cancel' hdvd]
  exact practical_mul (practical_two_pow_mul_three_pow ha b) ht
    (by rw [sigma_two_pow_mul_three_pow]; exact hle)

lemma practical_of_f23 {m : ℕ} (h : f23 m = true) : IsPractical m := practical_of_f23core h

def okAt (n k : ℕ) : Bool := Nat.blt (polygonal k) n && f23 (n - polygonal k)

lemma isRepresentable_of_okAt {n k : ℕ} (h : okAt n k = true) : IsRepresentable n := by
  simp only [okAt, Bool.and_eq_true, Nat.blt_eq] at h
  exact ⟨n - polygonal k, k, practical_of_f23 h.2, by omega⟩

/-- Check `lo + c - 1, lo + c - 2, ..., lo` against the certificate `C`, whose base-256 digits
(lowest first) are the claimed `k` for each `n` in that order; numbers in `exc` are skipped
(they are handled separately). A wrong certificate can only make the check fail. -/
def allCert (exc : List ℕ) (lo : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | c + 1, C => (okAt (lo + c) (C % 256) || exc.contains (lo + c)) && allCert exc lo c (C / 256)

lemma isRepresentable_of_allCert (exc : List ℕ) (lo : ℕ) :
    ∀ c C, allCert exc lo c C = true → ∀ m, lo ≤ m → m < lo + c → m ∉ exc → IsRepresentable m
  | 0, _, _, m, h1, h2, _ => by omega
  | c + 1, C, h, m, h1, h2, hm => by
    simp only [allCert, Bool.and_eq_true, Bool.or_eq_true] at h
    obtain ⟨h3, h4⟩ := h
    rcases Nat.lt_or_ge m (lo + c) with hlt | hge
    · exact isRepresentable_of_allCert exc lo c _ h4 m h1 hlt hm
    · obtain rfl : m = lo + c := by omega
      rcases h3 with h3 | h3
      · exact isRepresentable_of_okAt h3
      · exact absurd (List.contains_iff_mem.mp h3) hm

