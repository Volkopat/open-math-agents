/-- Both of Barker's conjectures. -/
theorem conjecture :
    (∀ n : ℕ, 6 < n →
      (a n : ℤ) = 6 * a (n - 1) - 15 * a (n - 2) + 20 * a (n - 3) - 15 * a (n - 4) + 6 * a (n - 5) - a (n - 6)) ∧
    PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 6 =
      6 * X * (1 + X) * (1 + 6 * X + 3 * X ^ 2) :=
  ⟨recurrence, gf⟩

