/-! ### Rows of any length and the depth-first sums -/

/-- Rows with `k + 1` entries in `0..2`. -/
abbrev R (k : ℕ) := Fin (k + 1) → Fin 3

/-- The base-3 code of a row (entry `j` is digit `j`). -/
def code : (k : ℕ) → R k → ℕ
  | 0, r => (r 0 : ℕ)
  | k + 1, r => (r 0 : ℕ) + 3 * code k (Fin.tail r)

/-- `ch Q k r s`: every block of the upper row `r` and the lower row `s` passes the test `Q`. -/
def ch (Q : ℕ → ℕ → ℕ → ℕ → Bool) : (k : ℕ) → R k → R k → Prop
  | 0, _, _ => True
  | k + 1, r, s => Q (r 0) (Fin.tail r 0) (s 0) (Fin.tail s 0) = true ∧
      ch Q k (Fin.tail r) (Fin.tail s)

theorem code_lt : ∀ (k : ℕ) (r : R k), code k r < 3 ^ (k + 1)
  | 0, r => by
    show (r 0 : ℕ) < 3 ^ 1
    simpa using (r 0).isLt
  | k + 1, r => by
    have h1 := code_lt k (Fin.tail r)
    have h2 := (r 0).isLt
    show (r 0 : ℕ) + 3 * code k (Fin.tail r) < 3 ^ (k + 1 + 1)
    rw [pow_succ]
    omega

theorem code_mod : ∀ (k : ℕ) (r : R k), code k r % 3 = r 0
  | 0, r => Nat.mod_eq_of_lt (r 0).isLt
  | k + 1, r => by
    have h2 := (r 0).isLt
    show ((r 0 : ℕ) + 3 * code k (Fin.tail r)) % 3 = r 0
    omega

theorem code_div (k : ℕ) (r : R (k + 1)) : code (k + 1) r / 3 = code k (Fin.tail r) := by
  have h2 := (r 0).isLt
  show ((r 0 : ℕ) + 3 * code k (Fin.tail r)) / 3 = code k (Fin.tail r)
  omega

theorem code_zero : ∀ k : ℕ, code k (fun _ => 0) = 0
  | 0 => rfl
  | k + 1 => by
    show ((0 : Fin 3) : ℕ) + 3 * code k (fun _ => 0) = 0
    rw [code_zero k]
    rfl

theorem ch_tt : ∀ (k : ℕ) (r s : R k), ch ptt k r s
  | 0, _, _ => trivial
  | k + 1, r, s => ⟨rfl, ch_tt k _ _⟩

theorem ch_swap : ∀ (k : ℕ) (r s : R k), ch pb k r s ↔ ch pbs k s r
  | 0, _, _ => Iff.rfl
  | k + 1, r, s => and_congr Iff.rfl (ch_swap k _ _)

theorem ch_iff (Q : ℕ → ℕ → ℕ → ℕ → Bool) : ∀ (k : ℕ) (r s : R k),
    ch Q k r s ↔ ∀ j : Fin k, Q (r j.castSucc) (r j.succ) (s j.castSucc) (s j.succ) = true
  | 0, r, s => by simp [ch]
  | k + 1, r, s => by
    rw [ch, ch_iff Q k, Fin.forall_fin_succ]
    simp only [Fin.tail, Fin.succ_castSucc]
    rfl

open scoped Classical in
/-- The sum of `g (code s)` over the lower rows `s` that fit under `r`, where the entries just
before the rows are `rp` above and `sp` below. -/
noncomputable def Psi (Q : ℕ → ℕ → ℕ → ℕ → Bool) (k : ℕ) (r : R k) (rp sp : ℕ)
    (g : ℕ → ℕ) : ℕ :=
  ∑ s : R k, if Q rp (r 0) sp (s 0) = true ∧ ch Q k r s then g (code k s) else 0

theorem Psi_zero (Q : ℕ → ℕ → ℕ → ℕ → Bool) (r : R 0) (rp sp : ℕ) (g : ℕ → ℕ) :
    Psi Q 0 r rp sp g = ∑ s0 : Fin 3, if Q rp (r 0) sp s0 = true then g s0 else 0 := by
  classical
  unfold Psi
  refine Fintype.sum_equiv (Equiv.funUnique (Fin 1) (Fin 3)) _ _ fun s => ?_
  simp [ch, code]

theorem Psi_succ (Q : ℕ → ℕ → ℕ → ℕ → Bool) (k : ℕ) (r : R (k + 1)) (rp sp : ℕ)
    (g : ℕ → ℕ) :
    Psi Q (k + 1) r rp sp g = ∑ s0 : Fin 3, if Q rp (r 0) sp s0 = true then
      Psi Q k (Fin.tail r) (r 0) s0 (fun c => g (s0 + 3 * c)) else 0 := by
  classical
  unfold Psi
  rw [Fintype.sum_equiv (Fin.consEquiv fun _ => Fin 3).symm _
    (fun p => if Q rp (r 0) sp ((Fin.cons p.1 p.2 : R (k + 1)) 0) = true ∧
      ch Q (k + 1) r (Fin.cons p.1 p.2) then g (code (k + 1) (Fin.cons p.1 p.2)) else 0)
    (fun s => by simp), Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun s0 _ => ?_
  by_cases hq : Q rp (r 0) sp s0 = true
  · rw [if_pos hq]
    refine Finset.sum_congr rfl fun s' _ => ?_
    simp only [Fin.cons_zero, hq, true_and, ch, code, Fin.tail_cons]
  · rw [if_neg hq]
    refine Finset.sum_eq_zero fun s' _ => if_neg fun h => hq ?_
    simpa using h.1

theorem sum_ch (Q : ℕ → ℕ → ℕ → ℕ → Bool) (k : ℕ) (r : R (k + 1)) (g : ℕ → ℕ) :
    (∑ s : R (k + 1), @ite _ (ch Q (k + 1) r s) (Classical.propDecidable _)
      (g (code (k + 1) s)) 0) =
      ∑ s0 : Fin 3, Psi Q k (Fin.tail r) (r 0) s0 (fun c => g (s0 + 3 * c)) := by
  classical
  unfold Psi
  rw [Fintype.sum_equiv (Fin.consEquiv fun _ => Fin 3).symm _
    (fun p => @ite _ (ch Q (k + 1) r (Fin.cons p.1 p.2)) (Classical.propDecidable _)
      (g (code (k + 1) (Fin.cons p.1 p.2))) 0)
    (fun s => by simp), Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun s0 _ => ?_
  refine Finset.sum_congr rfl fun s' _ => ?_
  simp only [ch, code, Fin.cons_zero, Fin.tail_cons]

theorem Psi_eq (Q : ℕ → ℕ → ℕ → ℕ → Bool) :
    ∀ (k : ℕ) (r : R k) (rp sp : ℕ) (g : ℕ → ℕ), Psi Q k r rp sp g = psiN Q k (code k r) rp sp g
  | 0, r, rp, sp, g => by
    rw [Psi_zero, Fin.sum_univ_three]
    show _ = cond (Q rp (code 0 r % 3) sp 0) (g 0) 0 + cond (Q rp (code 0 r % 3) sp 1) (g 1) 0 +
      cond (Q rp (code 0 r % 3) sp 2) (g 2) 0
    rw [code_mod]
    simp [Bool.cond_eq_ite]
  | k + 1, r, rp, sp, g => by
    rw [Psi_succ, Fin.sum_univ_three]
    simp only [Psi_eq Q k]
    show _ = cond (Q rp (code (k + 1) r % 3) sp 0)
        (psiN Q k (code (k + 1) r / 3) (code (k + 1) r % 3) 0 (fun c => g (0 + 3 * c))) 0 +
      cond (Q rp (code (k + 1) r % 3) sp 1)
        (psiN Q k (code (k + 1) r / 3) (code (k + 1) r % 3) 1 (fun c => g (1 + 3 * c))) 0 +
      cond (Q rp (code (k + 1) r % 3) sp 2)
        (psiN Q k (code (k + 1) r / 3) (code (k + 1) r % 3) 2 (fun c => g (2 + 3 * c))) 0
    rw [code_mod, code_div]
    simp [Bool.cond_eq_ite]

theorem phi_eq (Q : ℕ → ℕ → ℕ → ℕ → Bool) (k : ℕ) (r : R (k + 1)) (g : ℕ → ℕ) :
    (∑ s : R (k + 1), @ite _ (ch Q (k + 1) r s) (Classical.propDecidable _)
      (g (code (k + 1) s)) 0) = phiN Q k (code (k + 1) r) g := by
  rw [sum_ch, Fin.sum_univ_three, Psi_eq, Psi_eq, Psi_eq]
  unfold phiN
  rw [code_mod, code_div]
  simp

theorem phi7 (Q : ℕ → ℕ → ℕ → ℕ → Bool) (r : R 7) (g : ℕ → ℕ) :
    (∑ s : R 7, @ite _ (ch Q 7 r s) (Classical.propDecidable _) (g (code 7 s)) 0) =
      phiN Q 6 (code 7 r) g :=
  phi_eq Q 6 r g

/-! ### The transfer recursion -/

/-- A row of the array. -/
abbrev Row := R 7

/-- The condition on the blocks of two consecutive rows. -/
def Compat (r s : Row) : Prop :=
  ∀ j : Fin 7, Blk (r j.castSucc) (r j.succ) (s j.castSucc) (s j.succ)

theorem blk_iff (p q r s : ℕ) : Blk p q r s ↔ pb p q r s = true := by
  simp only [Blk, pb, Bool.or_eq_true, Nat.ble_eq, not_lt, le_max_iff]

theorem compat_iff (r s : Row) : Compat r s ↔ ch pb 7 r s := by
  rw [ch_iff]
  exact forall_congr' fun j => blk_iff _ _ _ _

/-- Each row of `A` is compatible with the next one. -/
def Chain {m : ℕ} (A : Fin (m + 1) → Row) : Prop :=
  ∀ i : Fin m, Compat (A i.castSucc) (A i.succ)

theorem chain_cons {m : ℕ} (r : Row) (A : Fin (m + 1) → Row) :
    Chain (Fin.cons r A : Fin (m + 2) → Row) ↔ Compat r (A 0) ∧ Chain A := by
  unfold Chain
  rw [Fin.forall_fin_succ]
  simp only [← Fin.succ_castSucc, Fin.cons_succ, Fin.castSucc_zero, Fin.cons_zero, Fin.succ_zero_eq_one, Fin.cons_one]

open scoped Classical in
/-- The number of ways to continue the row `r` by `m` more rows. -/
noncomputable def N (m : ℕ) (r : Row) : ℕ :=
  ∑ A : Fin m → Row, if Chain (Fin.cons r A : Fin (m + 1) → Row) then 1 else 0

theorem N_zero (r : Row) : N 0 r = 1 := by
  classical
  unfold N
  rw [Fintype.sum_unique, if_pos]
  exact fun i => i.elim0

open scoped Classical in
theorem N_succ (m : ℕ) (r : Row) :
    N (m + 1) r = ∑ s : Row, if Compat r s then N m s else 0 := by
  unfold N
  rw [Fintype.sum_equiv (Fin.consEquiv fun _ => Row).symm _
    (fun p => if Chain (Fin.cons r (Fin.cons p.1 p.2) : Fin (m + 2) → Row) then 1 else 0)
    (fun A => by simp), Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun s _ => ?_
  by_cases hc : Compat r s
  · rw [if_pos hc]
    refine Finset.sum_congr rfl fun A _ => if_congr ?_ rfl rfl
    rw [chain_cons]
    simp [hc]
  · rw [if_neg hc]
    refine Finset.sum_eq_zero fun A _ => if_neg ?_
    rw [chain_cons]
    exact fun h => hc (by simpa using h.1)

theorem a_eq (n : ℕ) : a n = ∑ r : Row, N n r := by
  classical
  unfold a
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]
  rw [Fintype.sum_equiv (Fin.consEquiv fun _ => Row).symm _
    (fun p => if Chain (Fin.cons p.1 p.2 : Fin (n + 1) → Row) then 1 else 0)
    (fun A => by
      rw [show (Fin.consEquiv fun _ => Row).symm A = (A 0, Fin.tail A) from rfl]
      simp only [Fin.cons_self_tail]
      exact if_congr Iff.rfl rfl rfl), Fintype.sum_prod_type]
  rfl

open scoped Classical in
/-- The number of rows that may precede the row `s`. -/
noncomputable def indeg (s : Row) : ℕ := ∑ r : Row, if Compat r s then 1 else 0

theorem indeg_eq (s : Row) : indeg s = Dg (code 7 s) := by
  classical
  have h : indeg s = ∑ r : Row, @ite _ (ch pbs 7 s r) (Classical.propDecidable _)
      ((fun _ => 1) (code 7 r)) 0 := by
    unfold indeg
    refine Finset.sum_congr rfl fun r _ => ?_
    exact if_congr ((compat_iff r s).trans (ch_swap 7 r s)) rfl rfl
  rw [h, phi7 pbs s (fun _ => 1), K1 _ (code_lt 7 s)]

theorem indeg_pos {r s : Row} (h : Compat r s) : 0 < indeg s := by
  classical
  unfold indeg
  have := Finset.single_le_sum (f := fun r : Row => if Compat r s then 1 else 0)
    (fun _ _ => Nat.zero_le _) (Finset.mem_univ r)
  simp only [if_pos h] at this
  omega

theorem idx_ne {s : Row} (h : 0 < indeg s) : idx (code 7 s) ≠ 0 := by
  rw [indeg_eq] at h
  exact Dg_pos _ h

theorem N_eq_T (m : ℕ) (hm : m ≤ 10) : ∀ r : Row, 0 < indeg r → N m r = T m (code 7 r) := by
  classical
  induction m with
  | zero =>
    intro r hr
    rw [N_zero, K3 _ (code_lt 7 r) (idx_ne hr)]
  | succ m ih =>
    intro r hr
    rw [N_succ]
    have h : (∑ s : Row, if Compat r s then N m s else 0) =
        ∑ s : Row, @ite _ (ch pb 7 r s) (Classical.propDecidable _) (T m (code 7 s)) 0 := by
      refine Finset.sum_congr rfl fun s _ => ?_
      by_cases hc : Compat r s
      · rw [if_pos hc, if_pos ((compat_iff r s).1 hc), ih (by omega) s (indeg_pos hc)]
      · rw [if_neg hc, if_neg (fun h => hc ((compat_iff r s).2 h))]
    rw [h, phi7 pb r (T m), K2 m (by omega) _ (code_lt 7 r) (idx_ne hr)]

/-- The linear recurrence at the level of rows, starting at `k`. -/
def VR (k : ℕ) (s : Row) : Prop :=
  2 * N k s + 14 * N (k + 2) s + 13 * N (k + 5) s + N (k + 7) s =
    9 * N (k + 1) s + 5 * N (k + 3) s + 10 * N (k + 4) s + 6 * N (k + 6) s

theorem VR_base (s : Row) (hs : 0 < indeg s) : VR 3 s := by
  show 2 * N 3 s + 14 * N 5 s + 13 * N 8 s + N 10 s =
    9 * N 4 s + 5 * N 6 s + 10 * N 7 s + 6 * N 9 s
  rw [N_eq_T 3 (by norm_num) s hs, N_eq_T 4 (by norm_num) s hs, N_eq_T 5 (by norm_num) s hs,
    N_eq_T 6 (by norm_num) s hs, N_eq_T 7 (by norm_num) s hs, N_eq_T 8 (by norm_num) s hs,
    N_eq_T 9 (by norm_num) s hs, N_eq_T 10 (by norm_num) s hs]
  exact K4 _ (code_lt 7 s) (idx_ne hs)

theorem VR_step (k : ℕ) (h : ∀ s, 0 < indeg s → VR k s) (s : Row) : VR (k + 1) s := by
  classical
  show 2 * N (k + 1) s + 14 * N (k + 2 + 1) s + 13 * N (k + 5 + 1) s + N (k + 7 + 1) s =
    9 * N (k + 1 + 1) s + 5 * N (k + 3 + 1) s + 10 * N (k + 4 + 1) s + 6 * N (k + 6 + 1) s
  rw [N_succ (k + 7), N_succ (k + 6), N_succ (k + 5), N_succ (k + 4)]
  rw [N_succ (k + 3), N_succ (k + 2), N_succ (k + 1), N_succ k]
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun s' _ => ?_
  by_cases hc : Compat s s'
  · simp only [if_pos hc]
    exact h s' (indeg_pos hc)
  · simp [if_neg hc]

theorem VR_all (k : ℕ) (hk : 3 ≤ k) : ∀ s, 0 < indeg s → VR k s := by
  induction k, hk using Nat.le_induction with
  | base => exact VR_base
  | succ k _ ih => exact fun s _ => VR_step k ih s

theorem a_succ_eq (m : ℕ) : a (m + 1) = ∑ s : Row, indeg s * N m s := by
  classical
  rw [a_eq]
  simp only [N_succ, indeg, Finset.sum_mul, ite_mul, one_mul, zero_mul]
  exact Finset.sum_comm

theorem rec_nat (k : ℕ) (hk : 3 ≤ k) :
    2 * a (k + 1) + 14 * a (k + 3) + 13 * a (k + 6) + a (k + 8) =
      9 * a (k + 2) + 5 * a (k + 4) + 10 * a (k + 5) + 6 * a (k + 7) := by
  show 2 * a (k + 1) + 14 * a (k + 2 + 1) + 13 * a (k + 5 + 1) + a (k + 7 + 1) =
    9 * a (k + 1 + 1) + 5 * a (k + 3 + 1) + 10 * a (k + 4 + 1) + 6 * a (k + 6 + 1)
  rw [a_succ_eq (k + 7), a_succ_eq (k + 6), a_succ_eq (k + 5), a_succ_eq (k + 4),
    a_succ_eq (k + 3), a_succ_eq (k + 2), a_succ_eq (k + 1), a_succ_eq k]
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun s _ => ?_
  rcases Nat.eq_zero_or_pos (indeg s) with h0 | hpos
  · simp [h0]
  · have hv := VR_all k hk s hpos
    unfold VR at hv
    have e := congrArg (fun t => indeg s * t) hv
    linarith [e]

theorem a_val (m : ℕ) (hm : m ≤ 10) :
    a (m + 1) = phiN ptt 6 0 (fun c => Dg c * T m c) := by
  classical
  rw [a_succ_eq]
  have h : (∑ s : Row, indeg s * N m s) =
      ∑ s : Row, @ite _ (ch ptt 7 (fun _ => 0) s) (Classical.propDecidable _)
        ((fun c => Dg c * T m c) (code 7 s)) 0 := by
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [if_pos (ch_tt 7 _ s)]
    show indeg s * N m s = Dg (code 7 s) * T m (code 7 s)
    rw [← indeg_eq]
    rcases Nat.eq_zero_or_pos (indeg s) with h0 | hpos
    · rw [h0]
      simp
    · rw [N_eq_T m hm s hpos]
  rw [h, phi7 ptt (fun _ => 0) (fun c => Dg c * T m c), code_zero]

theorem V0c : phiN ptt 6 0 (fun c => Dg c * T 0 c) = 10033 := by decide +kernel
theorem V1c : phiN ptt 6 0 (fun c => Dg c * T 1 c) = 19548 := by decide +kernel
theorem V2c : phiN ptt 6 0 (fun c => Dg c * T 2 c) = 30770 := by decide +kernel
theorem V3c : phiN ptt 6 0 (fun c => Dg c * T 3 c) = 51679 := by decide +kernel
theorem V4c : phiN ptt 6 0 (fun c => Dg c * T 4 c) = 82431 := by decide +kernel
theorem V5c : phiN ptt 6 0 (fun c => Dg c * T 5 c) = 135959 := by decide +kernel
theorem V6c : phiN ptt 6 0 (fun c => Dg c * T 6 c) = 223663 := by decide +kernel
theorem V7c : phiN ptt 6 0 (fun c => Dg c * T 7 c) = 380641 := by decide +kernel
theorem V8c : phiN ptt 6 0 (fun c => Dg c * T 8 c) = 662361 := by decide +kernel
theorem V9c : phiN ptt 6 0 (fun c => Dg c * T 9 c) = 1191797 := by decide +kernel

theorem a_vals : a 1 = 10033 ∧ a 2 = 19548 ∧ a 3 = 30770 ∧ a 4 = 51679 ∧ a 5 = 82431 ∧
    a 6 = 135959 ∧ a 7 = 223663 ∧ a 8 = 380641 ∧ a 9 = 662361 ∧ a 10 = 1191797 :=
  ⟨(a_val 0 (by norm_num)).trans V0c, (a_val 1 (by norm_num)).trans V1c,
    (a_val 2 (by norm_num)).trans V2c, (a_val 3 (by norm_num)).trans V3c,
    (a_val 4 (by norm_num)).trans V4c, (a_val 5 (by norm_num)).trans V5c,
    (a_val 6 (by norm_num)).trans V6c, (a_val 7 (by norm_num)).trans V7c,
    (a_val 8 (by norm_num)).trans V8c, (a_val 9 (by norm_num)).trans V9c⟩

/-- The recurrence of the entry, over `ℤ`. -/
theorem rec_int (n : ℕ) (hn : 10 < n) :
    (a n : ℤ) = 6 * a (n - 1) - 13 * a (n - 2) + 10 * a (n - 3) + 5 * a (n - 4) -
      14 * a (n - 5) + 9 * a (n - 6) - 2 * a (n - 7) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 8 := ⟨n - 8, by omega⟩
  have h := rec_nat k (by omega)
  simp only [show k + 8 - 1 = k + 7 by omega, show k + 8 - 2 = k + 6 by omega,
    show k + 8 - 3 = k + 5 by omega, show k + 8 - 4 = k + 4 by omega,
    show k + 8 - 5 = k + 3 by omega, show k + 8 - 6 = k + 2 by omega,
    show k + 8 - 7 = k + 1 by omega]
  have h' : (2 * a (k + 1) + 14 * a (k + 3) + 13 * a (k + 6) + a (k + 8) : ℤ) =
      9 * a (k + 2) + 5 * a (k + 4) + 10 * a (k + 5) + 6 * a (k + 7) := by
    exact_mod_cast h
  linarith

/-- Barker's closed form. -/
noncomputable def CF (n : ℕ) : ℚ :=
  (68472 + 6724 * (-1) ^ n + 1369 * 2 ^ (3 + n) + 34882 * (n : ℚ) + 8827 * (n : ℚ) ^ 2 +
    1130 * (n : ℚ) ^ 3 + 65 * (n : ℚ) ^ 4) / 12

theorem CF_rec (k : ℕ) :
    CF (k + 8) = 6 * CF (k + 7) - 13 * CF (k + 6) + 10 * CF (k + 5) + 5 * CF (k + 4) -
      14 * CF (k + 3) + 9 * CF (k + 2) - 2 * CF (k + 1) := by
  unfold CF
  push_cast
  ring

theorem closed (n : ℕ) (hn : 3 < n) : (a n : ℚ) = CF n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8, v9, v10⟩ := a_vals
    rcases (show n ≤ 10 ∨ 10 < n by omega) with h | h
    · interval_cases n <;> simp [CF, v4, v5, v6, v7, v8, v9, v10] <;> norm_num
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + 8 := ⟨n - 8, by omega⟩
      have hr := rec_int (k + 8) h
      simp only [show k + 8 - 1 = k + 7 by omega, show k + 8 - 2 = k + 6 by omega,
        show k + 8 - 3 = k + 5 by omega, show k + 8 - 4 = k + 4 by omega,
        show k + 8 - 5 = k + 3 by omega, show k + 8 - 6 = k + 2 by omega,
        show k + 8 - 7 = k + 1 by omega] at hr
      have hq : (a (k + 8) : ℚ) = 6 * a (k + 7) - 13 * a (k + 6) + 10 * a (k + 5) +
          5 * a (k + 4) - 14 * a (k + 3) + 9 * a (k + 2) - 2 * a (k + 1) := by
        exact_mod_cast hr
      rw [hq, CF_rec, ih (k + 7) (by omega) (by omega), ih (k + 6) (by omega) (by omega),
        ih (k + 5) (by omega) (by omega), ih (k + 4) (by omega) (by omega),
        ih (k + 3) (by omega) (by omega), ih (k + 2) (by omega) (by omega),
        ih (k + 1) (by omega) (by omega)]

open PowerSeries in
theorem gen_fun :
    PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) *
      ((1 - X) ^ 5 * (1 + X) * (1 - 2 * X)) =
    X * (10033 - 40650 * X + 43911 * X ^ 2 + 20853 * X ^ 3 - 73278 * X ^ 4 + 48222 * X ^ 5 -
      7753 * X ^ 6 - 1661 * X ^ 7 + 61 * X ^ 8 + 2 * X ^ 9) := by
  set A := PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) with hA
  have key : A * ((1 - X) ^ 5 * (1 + X) * (1 - 2 * X)) =
      C 1 * (A * X ^ 0) - C 6 * (A * X ^ 1) + C 13 * (A * X ^ 2) - C 10 * (A * X ^ 3) -
        C 5 * (A * X ^ 4) + C 14 * (A * X ^ 5) - C 9 * (A * X ^ 6) + C 2 * (A * X ^ 7) := by
    simp only [map_one, map_ofNat]
    ring
  have hrhs : (X : ℚ⟦X⟧) * (10033 - 40650 * X + 43911 * X ^ 2 + 20853 * X ^ 3 -
      73278 * X ^ 4 + 48222 * X ^ 5 - 7753 * X ^ 6 - 1661 * X ^ 7 + 61 * X ^ 8 + 2 * X ^ 9) =
      C 10033 * X ^ 1 - C 40650 * X ^ 2 + C 43911 * X ^ 3 + C 20853 * X ^ 4 -
        C 73278 * X ^ 5 + C 48222 * X ^ 6 - C 7753 * X ^ 7 - C 1661 * X ^ 8 + C 61 * X ^ 9 +
        C 2 * X ^ 10 := by
    simp only [map_ofNat]
    ring
  rw [key, hrhs]
  ext k
  simp only [map_sub, map_add, coeff_C_mul_X_pow]
  simp only [coeff_C_mul, coeff_mul_X_pow', hA, coeff_mk]
  obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8, v9, v10⟩ := a_vals
  by_cases hk : k < 11
  · interval_cases k <;> norm_num [v1, v2, v3, v4, v5, v6, v7, v8, v9, v10]
  · obtain ⟨j, rfl⟩ : ∃ j, k = j + 11 := ⟨k - 11, by omega⟩
    have hr := rec_int (j + 11) (by omega)
    simp only [show j + 11 - 1 = j + 10 by omega, show j + 11 - 2 = j + 9 by omega,
      show j + 11 - 3 = j + 8 by omega, show j + 11 - 4 = j + 7 by omega,
      show j + 11 - 5 = j + 6 by omega, show j + 11 - 6 = j + 5 by omega,
      show j + 11 - 7 = j + 4 by omega] at hr
    have hq : (a (j + 11) : ℚ) = 6 * a (j + 10) - 13 * a (j + 9) + 10 * a (j + 8) +
        5 * a (j + 7) - 14 * a (j + 6) + 9 * a (j + 5) - 2 * a (j + 4) := by
      exact_mod_cast hr
    simp only [show 0 ≤ j + 11 by omega, show 1 ≤ j + 11 by omega, show 2 ≤ j + 11 by omega,
      show 3 ≤ j + 11 by omega, show 4 ≤ j + 11 by omega, show 5 ≤ j + 11 by omega,
      show 6 ≤ j + 11 by omega, show 7 ≤ j + 11 by omega,
      show j + 11 - 0 = j + 11 by omega, show j + 11 - 1 = j + 10 by omega,
      show j + 11 - 2 = j + 9 by omega, show j + 11 - 3 = j + 8 by omega,
      show j + 11 - 4 = j + 7 by omega, show j + 11 - 5 = j + 6 by omega,
      show j + 11 - 6 = j + 5 by omega, show j + 11 - 7 = j + 4 by omega,
      show ¬ (j + 11 = 1) by omega, show ¬ (j + 11 = 2) by omega, show ¬ (j + 11 = 3) by omega,
      show ¬ (j + 11 = 4) by omega, show ¬ (j + 11 = 5) by omega, show ¬ (j + 11 = 6) by omega,
      show ¬ (j + 11 = 7) by omega, show ¬ (j + 11 = 8) by omega, show ¬ (j + 11 = 9) by omega,
      show ¬ (j + 11 = 10) by omega, show ¬ (j + 11 = 0) by omega,
      show ¬ (j + 10 = 0) by omega, show ¬ (j + 9 = 0) by omega, show ¬ (j + 8 = 0) by omega,
      show ¬ (j + 7 = 0) by omega, show ¬ (j + 6 = 0) by omega, show ¬ (j + 5 = 0) by omega,
      show ¬ (j + 4 = 0) by omega, if_true, if_false]
    linarith

end OMA.Helpers

open OMA.Helpers PowerSeries in
theorem OMA.solution : type_of% @OMA.S_oeis_a251136.main := by
  refine ⟨fun n hn => rec_int n hn, ?_, fun n hn => closed n hn⟩
  unfold OMA.S_oeis_a251136.G
  rw [PowerSeries.eq_mul_inv_iff_mul_eq (by simp)]

  exact gen_fun
