def idx (c : ℕ) : ℕ := getF IDX 11 c

def VT (m : ℕ) : ℕ :=
  match m with
  | 0 => V0 | 1 => V1 | 2 => V2 | 3 => V3 | 4 => V4 | 5 => V5 | 6 => V6 | 7 => V7
  | 8 => V8 | 9 => V9 | 10 => V10 | _ => 0

def T (m c : ℕ) : ℕ := cond (idx c == 0) 0 (getF (VT m) 18 (idx c - 1))

def Dg (c : ℕ) : ℕ := cond (idx c == 0) 0 (getF DV 7 (idx c - 1))

/-- `chkR f n lo`: `f i` holds for `lo ≤ i < lo + n`. -/
def chkR (f : ℕ → Bool) (n : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true) (fun _ ih l => f l && ih (l + 1)) n

/-! ### Kernel checks on the tables -/

theorem chkR_sound (f : ℕ → Bool) (n : ℕ) :
    ∀ lo, chkR f n lo = true → ∀ i, i < n → f (lo + i) = true := by
  induction n with
  | zero => intro lo _ i hi; omega
  | succ n ih =>
    intro lo h i hi
    have h' : (f lo && chkR f n (lo + 1)) = true := h
    rw [Bool.and_eq_true] at h'
    rcases i with _ | i
    · simpa using h'.1
    · have := ih (lo + 1) h'.2 i (by omega)
      rwa [show lo + 1 + i = lo + (i + 1) by omega] at this

theorem chk_full (f : ℕ → Bool) (h : chkR f 6561 0 = true) : ∀ c, c < 6561 → f c = true := by
  intro c hc
  simpa using chkR_sound f 6561 0 h c hc

theorem chk_three (f : ℕ → Bool) (h1 : chkR f 2187 0 = true) (h2 : chkR f 2187 2187 = true)
    (h3 : chkR f 2187 4374 = true) : ∀ c, c < 6561 → f c = true := by
  intro c hc
  rcases (show c < 2187 ∨ (2187 ≤ c ∧ c < 4374) ∨ 4374 ≤ c by omega) with h | h | h
  · simpa using chkR_sound f 2187 0 h1 c h
  · have := chkR_sound f 2187 2187 h2 (c - 2187) (by omega)
    rwa [show 2187 + (c - 2187) = c by omega] at this
  · have := chkR_sound f 2187 4374 h3 (c - 4374) (by omega)
    rwa [show 4374 + (c - 4374) = c by omega] at this

theorem K1a : chkR (fun c => phiN pbs 6 c (fun _ => 1) == Dg c) 2187 0 = true := by
