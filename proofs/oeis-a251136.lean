    2 * T 3 c + 14 * T 5 c + 13 * T 8 c + T 10 c =
      9 * T 4 c + 5 * T 6 c + 10 * T 7 c + 6 * T 9 c := by
  simpa [hi] using chk_full _ K4c c hc

theorem Dg_pos (c : ℕ) (h : 0 < Dg c) : idx c ≠ 0 := by
  intro hc
