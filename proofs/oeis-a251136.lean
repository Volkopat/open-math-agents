/-- The block test on numbers: `a + d ≤ max b c`, for the block with upper row `a, b` and lower
row `c, d`. -/
def pb (a b c d : ℕ) : Bool := Nat.ble (a + d) b || Nat.ble (a + d) c

/-- The block test with the two rows exchanged. -/
def pbs (a b c d : ℕ) : Bool := pb c d a b

/-- The test that accepts every block. -/
def ptt (_ _ _ _ : ℕ) : Bool := true

/-- Depth-first sum over the digits of the lower row: `psiN Q k rc rp sp g` is the sum, over the
lower rows `s` with `k + 1` digits that fit under the upper row with code `rc` (where the digits
just before are `rp` above and `sp` below), of `g (code s)`. -/
def psiN (Q : ℕ → ℕ → ℕ → ℕ → Bool) : ℕ → ℕ → ℕ → ℕ → (ℕ → ℕ) → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ → ℕ → (ℕ → ℕ) → ℕ)
    (fun rc rp sp g =>
      cond (Q rp (rc % 3) sp 0) (g 0) 0 + cond (Q rp (rc % 3) sp 1) (g 1) 0 +
        cond (Q rp (rc % 3) sp 2) (g 2) 0)
    (fun _ ih rc rp sp g =>
      cond (Q rp (rc % 3) sp 0) (ih (rc / 3) (rc % 3) 0 (fun c => g (0 + 3 * c))) 0 +
        cond (Q rp (rc % 3) sp 1) (ih (rc / 3) (rc % 3) 1 (fun c => g (1 + 3 * c))) 0 +
        cond (Q rp (rc % 3) sp 2) (ih (rc / 3) (rc % 3) 2 (fun c => g (2 + 3 * c))) 0)

/-- The sum over all lower rows with `k + 2` digits fitting under the row with code `rc`. -/
def phiN (Q : ℕ → ℕ → ℕ → ℕ → Bool) (k rc : ℕ) (g : ℕ → ℕ) : ℕ :=
  psiN Q k (rc / 3) (rc % 3) 0 (fun c => g (0 + 3 * c)) +
    psiN Q k (rc / 3) (rc % 3) 1 (fun c => g (1 + 3 * c)) +
    psiN Q k (rc / 3) (rc % 3) 2 (fun c => g (2 + 3 * c))

