theorem K1b : chkR (fun c => phiN pbs 6 c (fun _ => 1) == Dg c) 2187 2187 = true := by
  decide +kernel

theorem K1c : chkR (fun c => phiN pbs 6 c (fun _ => 1) == Dg c) 2187 4374 = true := by
  decide +kernel

theorem K1 (c : ℕ) (hc : c < 6561) : phiN pbs 6 c (fun _ => 1) = Dg c := by
  simpa using chk_three _ K1a K1b K1c c hc

