theorem K2 (m : ℕ) (hm : m < 10) (c : ℕ) (hc : c < 6561) (hi : idx c ≠ 0) :
    T (m + 1) c = phiN pb 6 c (T m) := by
  have h : (idx c == 0 || T (m + 1) c == phiN pb 6 c (T m)) = true := by
    interval_cases m
    · exact chk_full _ K20 c hc
    · exact chk_full _ K21 c hc
    · exact chk_full _ K22 c hc
    · exact chk_full _ K23 c hc
    · exact chk_full _ K24 c hc
