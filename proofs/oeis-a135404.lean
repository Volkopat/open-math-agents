/-- The parametrizing series `Z`: `Z(0)=1`, `256 X Z^6 = (Z^2-1)(Z^2+3)^3`. -/
theorem exists_Z : ∃ Z : ℚ⟦X⟧, constantCoeff Z = 1 ∧
    256 * X * Z ^ 6 = (Z ^ 2 - 1) * (Z ^ 2 + 3) ^ 3 := by
  let Φ : ℚ⟦X⟧ → ℚ⟦X⟧ := fun A => 1 + X * (256 * A ^ 6 * ((A + 1) * (A ^ 2 + 3) ^ 3)⁻¹)
  let P : ℚ⟦X⟧ → Prop := fun A => constantCoeff A = 1
  have hD : ∀ A, P A → constantCoeff ((A + 1) * (A ^ 2 + 3) ^ 3) ≠ 0 := by
    intro A hA; simp only [P] at hA; simp [hA, cc_num]; norm_num
  obtain ⟨Z, hZ, hfix⟩ := fixed_point Φ P 1 (by simp [P]) (by intro A _; simp [Φ, P])
    (by
      intro A B h hA
      simp only [P] at hA ⊢
      obtain ⟨c, hc⟩ := h
      have := congrArg constantCoeff hc
      simp at this; linarith)
    (by
      intro A B n hA hB h
      have h' : X ^ n ∣ 256 * A ^ 6 * ((A + 1) * (A ^ 2 + 3) ^ 3)⁻¹ -
          256 * B ^ 6 * ((B + 1) * (B ^ 2 + 3) ^ 3)⁻¹ := by
        rw [dvd_iff_mk] at h ⊢
        have hi := mk_inv_congr (Ideal.span {(X : ℚ⟦X⟧) ^ n}) _ _ (hD A hA) (hD B hB)
          (by simp only [map_mul, map_add, map_pow, h])
        simp only [map_mul, map_pow]
        rw [hi, h]
      have : Φ A - Φ B = X * (256 * A ^ 6 * ((A + 1) * (A ^ 2 + 3) ^ 3)⁻¹ -
          256 * B ^ 6 * ((B + 1) * (B ^ 2 + 3) ^ 3)⁻¹) := by simp only [Φ]; ring
      rw [this, pow_succ, mul_comm (X ^ n)]
      exact mul_dvd_mul_left X h')
  refine ⟨Z, hZ, ?_⟩
  have hinv := PowerSeries.inv_mul_cancel _ (hD Z hZ)
  have e : Z = 1 + X * (256 * Z ^ 6 * ((Z + 1) * (Z ^ 2 + 3) ^ 3)⁻¹) := hfix.symm
  have : (Z - 1) * ((Z + 1) * (Z ^ 2 + 3) ^ 3) = 256 * X * Z ^ 6 := by
    have h2 : Z - 1 = X * (256 * Z ^ 6 * ((Z + 1) * (Z ^ 2 + 3) ^ 3)⁻¹) := by
      rw [sub_eq_iff_eq_add']; exact e
    rw [h2]
    linear_combination (X * 256 * Z ^ 6) * hinv
  linear_combination -this

end GesselFP


namespace GesselK
open PowerSeries

variable {R : Type*} [CommRing R] {k : Type*} [CommRing k] (φ : R →+* k⟦X⟧)

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Evaluate a power series with coefficients in `R` along `φ : R → k⟦X⟧`, keeping `X`. -/
noncomputable def evT (F : R⟦X⟧) : k⟦X⟧ :=
  PowerSeries.mk fun m => coeff m ((trunc (m + 1) F).eval₂ φ X)

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma zero_of_dvd_all (d : k⟦X⟧) (hd : ∀ n, X ^ n ∣ d) : d = 0 := by
  ext m
  have := hd (m + 1)
  rw [X_pow_dvd_iff] at this
  simpa using this m (by omega)

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma poly_dvd_eval₂ (M : ℕ) (p : Polynomial R) (hp : (Polynomial.X : Polynomial R) ^ M ∣ p) :
    X ^ M ∣ p.eval₂ φ X := by
  obtain ⟨q, rfl⟩ := hp
  rw [Polynomial.eval₂_mul, Polynomial.eval₂_X_pow]
  exact dvd_mul_right _ _

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma trunc_sub_dvd (F : R⟦X⟧) {M N : ℕ} (h : M ≤ N) :
    (Polynomial.X : Polynomial R) ^ M ∣ trunc N F - trunc M F := by
  rw [Polynomial.X_pow_dvd_iff]
  intro d hd
  simp only [Polynomial.coeff_sub, coeff_trunc]
  have h1 : d < N := by omega
  simp [hd, h1]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_congr (F : R⟦X⟧) (N : ℕ) : X ^ N ∣ evT φ F - (trunc N F).eval₂ φ X := by
  rw [X_pow_dvd_iff]
  intro m hm
  have h := poly_dvd_eval₂ φ (m + 1) _ (trunc_sub_dvd F (show m + 1 ≤ N by omega))
  rw [Polynomial.eval₂_sub, X_pow_dvd_iff] at h
  have := h m (by omega)
  simp only [map_sub, evT, coeff_mk] at this ⊢
  rw [sub_eq_zero] at this; rw [this, sub_self]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma poly_trunc_dvd (p : Polynomial R) (N : ℕ) :
    (Polynomial.X : Polynomial R) ^ N ∣ p - trunc N (p : R⟦X⟧) := by
  rw [Polynomial.X_pow_dvd_iff]
  intro d hd
  simp [coeff_trunc, hd]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_mul (F G : R⟦X⟧) : evT φ (F * G) = evT φ F * evT φ G := by
  rw [← sub_eq_zero]
  apply zero_of_dvd_all
  intro N
  have h1 := evT_congr φ (F * G) N
  have h2 := evT_congr φ F N
  have h3 := evT_congr φ G N
  have h4 := poly_dvd_eval₂ φ N _ (poly_trunc_dvd (trunc N F * trunc N G) N)
  rw [← trunc_trunc_mul_trunc] at h1
  rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul] at h4
  have e : evT φ (F * G) - evT φ F * evT φ G =
      (evT φ (F * G) - (trunc N (↑(trunc N F) * ↑(trunc N G) : R⟦X⟧)).eval₂ φ X) -
      ((trunc N F).eval₂ φ X * (trunc N G).eval₂ φ X -
        (trunc N (↑(trunc N F) * ↑(trunc N G) : R⟦X⟧)).eval₂ φ X) -
      (evT φ F - (trunc N F).eval₂ φ X) * evT φ G -
      (trunc N F).eval₂ φ X * (evT φ G - (trunc N G).eval₂ φ X) := by ring
  rw [e]
  refine dvd_sub (dvd_sub (dvd_sub h1 ?_) (dvd_mul_of_dvd_left h2 _)) (dvd_mul_of_dvd_right h3 _)
  push_cast at h4
  simpa using h4

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_add (F G : R⟦X⟧) : evT φ (F + G) = evT φ F + evT φ G := by
  ext m; simp [evT, map_add, Polynomial.eval₂_add]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_one : evT φ (1 : R⟦X⟧) = 1 := by
  rw [← sub_eq_zero]
  apply zero_of_dvd_all
  intro N
  rcases N with _ | N
  · simp
  have h := evT_congr φ (1 : R⟦X⟧) (N + 1)
  rw [trunc_one] at h
  simpa using h

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_zero : evT φ (0 : R⟦X⟧) = 0 := by
  ext m; simp [evT]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- `evT` as a ring hom. -/
noncomputable def evTHom : R⟦X⟧ →+* k⟦X⟧ where
  toFun := evT φ
  map_one' := evT_one φ
  map_mul' := evT_mul φ
  map_zero' := evT_zero φ
  map_add' := evT_add φ

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_C (r : R) : evT φ (C r) = φ r := by
  rw [← sub_eq_zero]
  apply zero_of_dvd_all
  intro N
  rcases N with _ | N
  · simp
  have h := evT_congr φ (C r) (N + 1)
  rw [trunc_C] at h
  simpa using h

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_X : evT φ (X : R⟦X⟧) = X := by
  rw [← sub_eq_zero]
  apply zero_of_dvd_all
  intro N
  have h := evT_congr φ (X : R⟦X⟧) (N + 2)
  rw [trunc_X] at h
  exact (pow_dvd_pow X (by omega : N ≤ N + 2)).trans (by simpa using h)

section comp
variable {R1 R2 : Type*} [CommRing R1] [CommRing R2] {k : Type*} [CommRing k]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_comp (ψ : R1 →+* R2⟦X⟧) (φ : R2 →+* k⟦X⟧) (F : R1⟦X⟧) :
    evT φ (evT ψ F) = evT ((evTHom φ).comp ψ) F := by
  rw [← sub_eq_zero]
  apply zero_of_dvd_all
  intro N
  have h1 := map_dvd (evTHom φ) (evT_congr ψ F N)
  rw [map_sub, map_pow, Polynomial.hom_eval₂] at h1
  have hX : evTHom φ X = X := evT_X φ
  rw [hX] at h1
  have h2 := evT_congr ((evTHom φ).comp ψ) F N
  have e : evT φ (evT ψ F) - evT ((evTHom φ).comp ψ) F =
      (evTHom φ (evT ψ F) - (trunc N F).eval₂ ((evTHom φ).comp ψ) X) -
      (evT ((evTHom φ).comp ψ) F - (trunc N F).eval₂ ((evTHom φ).comp ψ) X) := by
    simp [evTHom]
  rw [e]; exact dvd_sub h1 h2

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_eq_mk (φ : R1 →+* k⟦X⟧) (F : R1⟦X⟧) (c : ℕ → k)
    (hF : ∀ m, φ (coeff m F) = C (c m)) : evT φ F = PowerSeries.mk c := by
  ext m
  rw [evT, coeff_mk, coeff_mk, Polynomial.eval₂_eq_sum_range' φ (natDegree_trunc_lt F m) X]
  simp only [coeff_trunc]
  rw [Finset.sum_congr rfl (fun i hi => by rw [if_pos (Finset.mem_range.mp hi), hF])]
  simp

end comp

section shift

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- constant polynomials -/
noncomputable def ι : ℚ⟦X⟧ →+* (Polynomial ℚ)⟦X⟧ := PowerSeries.map Polynomial.C

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
noncomputable def evAt (a : ℚ⟦X⟧) : Polynomial ℚ →+* ℚ⟦X⟧ := Polynomial.eval₂RingHom C a

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
noncomputable def shφ (a : ℚ⟦X⟧) : Polynomial ℚ →+* (Polynomial ℚ)⟦X⟧ :=
  Polynomial.eval₂RingHom ((C : Polynomial ℚ →+* (Polynomial ℚ)⟦X⟧).comp Polynomial.C)
    (C Polynomial.X + ι a)

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma coeff_ι (a : ℚ⟦X⟧) (m : ℕ) : coeff m (ι a) = Polynomial.C (coeff m a) := by
  simp [ι]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma shφ_C (a : ℚ⟦X⟧) (q : ℚ) : shφ a (Polynomial.C q) = C (Polynomial.C q) := by
  simp [shφ]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma shφ_X (a : ℚ⟦X⟧) : shφ a Polynomial.X = C Polynomial.X + ι a := by
  simp [shφ]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evAt_C (a : ℚ⟦X⟧) (q : ℚ) : evAt a (Polynomial.C q) = C q := by
  simp [evAt]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evAt_X (a : ℚ⟦X⟧) : evAt a Polynomial.X = a := by
  simp [evAt]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_shφ_ι (b a : ℚ⟦X⟧) : evT (shφ b) (ι a) = ι a := by
  rw [evT_eq_mk _ _ (fun m => Polynomial.C (coeff m a))]
  · ext m; simp [coeff_ι]
  · intro m; rw [coeff_ι, shφ_C]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_evAt_ι (b a : ℚ⟦X⟧) : evT (evAt b) (ι a) = a := by
  rw [evT_eq_mk _ _ (fun m => coeff m a)]
  · ext m; simp
  · intro m; rw [coeff_ι, evAt_C]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma evT_C_self {R : Type*} [CommRing R] (F : R⟦X⟧) : evT (C : R →+* R⟦X⟧) F = F := by
  rw [evT_eq_mk _ _ (fun m => coeff m F)]
  · ext m; simp
  · intro m; rfl

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma sh_inv (a : ℚ⟦X⟧) (F : (Polynomial ℚ)⟦X⟧) : evT (shφ (-a)) (evT (shφ a) F) = F := by
  rw [evT_comp]
  have : (evTHom (shφ (-a))).comp (shφ a) = C := by
    apply Polynomial.ringHom_ext
    · intro q
      show evT (shφ (-a)) (shφ a (Polynomial.C q)) = C (Polynomial.C q)
      rw [shφ_C, evT_C, shφ_C]
    · show evT (shφ (-a)) (shφ a Polynomial.X) = C Polynomial.X
      rw [shφ_X, evT_add, evT_C, evT_shφ_ι, shφ_X, map_neg]; ring
  rw [this, evT_C_self]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma ev_sh (a : ℚ⟦X⟧) (F : (Polynomial ℚ)⟦X⟧) :
    evT (evAt 0) (evT (shφ a) F) = evT (evAt a) F := by
  rw [evT_comp]
  congr 1
  apply Polynomial.ringHom_ext
  · intro q
    show evT (evAt 0) (shφ a (Polynomial.C q)) = evAt a (Polynomial.C q)
    rw [shφ_C, evT_C, evAt_C, evAt_C]
  · show evT (evAt 0) (shφ a Polynomial.X) = evAt a Polynomial.X
    rw [shφ_X, evT_add, evT_C, evT_evAt_ι, evAt_X, evAt_X, zero_add]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Division by `ŷ - a` when the value at `a` is subtracted. -/
theorem div_lin (a : ℚ⟦X⟧) (F : (Polynomial ℚ)⟦X⟧) :
    ∃ G, F = (C Polynomial.X - ι a) * G + ι (evT (evAt a) F) := by
  set F' := evT (shφ a) F with hF'def
  set G' : (Polynomial ℚ)⟦X⟧ := PowerSeries.mk fun m => (coeff m F').divX
  set c : ℚ⟦X⟧ := PowerSeries.mk fun m => (coeff m F').coeff 0
  have hF' : F' = C Polynomial.X * G' + ι c := by
    ext m : 1
    rw [map_add, coeff_C_mul, coeff_ι]
    simp only [G', c, coeff_mk]
    exact (Polynomial.X_mul_divX_add (coeff m F')).symm
  have hc : c = evT (evAt a) F := by
    rw [← ev_sh a F, evT_eq_mk (evAt 0) (evT (shφ a) F) (fun m => (coeff m F').coeff 0)]
    intro m; simp [evAt, Polynomial.eval₂_at_zero, F']
  refine ⟨evT (shφ (-a)) G', ?_⟩
  have h := congrArg (evT (shφ (-a))) hF'
  rw [hF'def, sh_inv, evT_add, evT_mul, evT_shφ_ι, evT_C] at h
  rw [← hc]
  rw [shφ_X, map_neg] at h
  rw [h]; ring

end shift

