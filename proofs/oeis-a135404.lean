  rw [← Vb_eq ξ Y (n + 1) (n + 2) n le_rfl (by omega), Vb, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  ring

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
noncomputable def Hn (n i j : ℕ) : ℚ⟦X⟧ := (g n i j : ℚ⟦X⟧) * wt ξ Y n i j

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma Vb_H (A B n : ℕ) : Vb ξ Y A B n = ∑ i ∈ Finset.range A, ∑ j ∈ Finset.range B, Hn ξ Y n i j := rfl

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma T2 (n : ℕ) : ∑ i ∈ Finset.range (n + 2), ∑ j ∈ Finset.range (n + 2),
    (g n ((i : ℤ) + 1) j : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) = Y * (V ξ Y n - sR ξ Y n) := by
  have hW : ∀ i j : ℕ, (g n ((i : ℤ) + 1) j : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) =
      Y * Hn ξ Y n (i + 1) j := by
    intro i j; have := tw_W ξ Y n i j; push_cast at this; rw [this, Hn]; push_cast; ring
  simp_rw [hW, ← Finset.mul_sum]
  have e2 := Vb_eq ξ Y (n + 3) (n + 2) n (by omega) (by omega)
  rw [Vb_H, Finset.sum_range_succ'] at e2
  have e3 : ∑ j ∈ Finset.range (n + 2), Hn ξ Y n 0 j = sR ξ Y n := by
    unfold sR; rw [sum_box (M := n + 1) (by omega)]; · rfl
    intro j hj; simp [Hn, g_big_j _ hj]
  linear_combination Y * e2 - Y * e3

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma T3 (n : ℕ) : ∑ i ∈ Finset.range (n + 2), ∑ j ∈ Finset.range (n + 2),
    (g n ((i : ℤ) - 1) ((j : ℤ) - 1) : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) =
    X * ξ ^ 2 * Y ^ 2 * V ξ Y n := by
  have hrow : ∀ i : ℕ, ∑ j ∈ Finset.range (n + 2),
      (g n (((i + 1 : ℕ) : ℤ) - 1) ((j : ℤ) - 1) : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) (i + 1) j) =
      X * ξ ^ 2 * Y ^ 2 * ∑ j ∈ Finset.range (n + 1), Hn ξ Y n i j := by
    intro i
    rw [Finset.sum_range_succ']
    simp only [Nat.cast_zero, zero_sub, g_neg_j, zero_mul, add_zero,
      Nat.cast_add, Nat.cast_one, add_sub_cancel_right]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have := tw_NE ξ Y n i j
    rw [this, Hn]; ring
  rw [Finset.sum_range_succ']
  simp only [Nat.cast_zero, zero_sub, g_neg_i, zero_mul, Finset.sum_const_zero,
    add_zero]
  rw [Finset.sum_congr rfl fun i _ => hrow i, ← Finset.mul_sum]
  rfl

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma T4 (n : ℕ) : ∑ i ∈ Finset.range (n + 2), ∑ j ∈ Finset.range (n + 2),
    (g n ((i : ℤ) + 1) ((j : ℤ) + 1) : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) =
    X * (V ξ Y n - rR ξ Y n - sR ξ Y n + zR ξ Y n) := by
  have hSW : ∀ i j : ℕ, (g n ((i : ℤ) + 1) ((j : ℤ) + 1) : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) =
      X * Hn ξ Y n (i + 1) (j + 1) := by
    intro i j; have := tw_SW ξ Y n i j; push_cast at this; rw [this, Hn]; push_cast; ring
  simp_rw [hSW, ← Finset.mul_sum]
  have e2 := Vb_eq ξ Y (n + 3) (n + 3) n (by omega) (by omega)
  rw [Vb_H, Finset.sum_range_succ',
    Finset.sum_congr rfl fun i _ => Finset.sum_range_succ' (fun j => Hn ξ Y n (i + 1) j) (n + 2),
    Finset.sum_add_distrib] at e2
  have er : ∑ i ∈ Finset.range (n + 3), Hn ξ Y n i 0 = rR ξ Y n := by
    unfold rR; rw [sum_box (M := n + 1) (by omega)]; · rfl
    intro i hi; simp [Hn, g_big_i _ hi]
  have es : ∑ j ∈ Finset.range (n + 3), Hn ξ Y n 0 j = sR ξ Y n := by
    unfold sR; rw [sum_box (M := n + 1) (by omega)]; · rfl
    intro j hj; simp [Hn, g_big_j _ hj]
  rw [Finset.sum_range_succ'] at er
  have ez : Hn ξ Y n 0 0 = zR ξ Y n := rfl
  linear_combination X * e2 - X * er - X * es + X * ez

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
theorem step_identity (n : ℕ) : ξ * Y * V ξ Y (n + 1) =
    (Y + X ^ 2 * ξ ^ 2 * Y + X * ξ ^ 2 * Y ^ 2 + X) * V ξ Y n - X * rR ξ Y n
      - (X + Y) * sR ξ Y n + X * zR ξ Y n := by
  have hg : ∀ i j : ℕ, (g (n + 1) i j : ℚ⟦X⟧) = (g n ((i : ℤ) - 1) j : ℚ⟦X⟧) +
      (g n ((i : ℤ) + 1) j : ℚ⟦X⟧) + (g n ((i : ℤ) - 1) ((j : ℤ) - 1) : ℚ⟦X⟧) +
      (g n ((i : ℤ) + 1) ((j : ℤ) + 1) : ℚ⟦X⟧) := by
    intro i j; simp [g]
  have h := congrArg (fun z => ξ * Y * z) (Vb_eq ξ Y (n + 2) (n + 2) (n + 1) le_rfl le_rfl)
  rw [← h, Vb, Finset.mul_sum]
  simp_rw [Finset.mul_sum]
  have e : ∀ i j : ℕ, ξ * Y * ((g (n + 1) i j : ℚ⟦X⟧) * wt ξ Y (n + 1) i j) =
      (g n ((i : ℤ) - 1) j : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) +
      (g n ((i : ℤ) + 1) j : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) +
      (g n ((i : ℤ) - 1) ((j : ℤ) - 1) : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) +
      (g n ((i : ℤ) + 1) ((j : ℤ) + 1) : ℚ⟦X⟧) * (ξ * Y * wt ξ Y (n + 1) i j) := by
    intro i j; rw [hg]; ring
  simp_rw [e, Finset.sum_add_distrib]
  rw [T1, T2, T3, T4]; ring

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma Hn_dvd (n i j : ℕ) : X ^ ((n + 1) / 2) ∣ Hn ξ Y n i j := by
  by_cases hg : g n i j = 0
  · simp [Hn, hg]
  have := g_support n i j hg
  unfold Hn wt
  exact Dvd.dvd.mul_left (Dvd.dvd.mul_left (pow_dvd_pow _ (by omega)) _) _

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma V_dvd (n : ℕ) : X ^ ((n + 1) / 2) ∣ V ξ Y n := by
  unfold V; rw [Vb_H]; exact Finset.dvd_sum fun i _ => Finset.dvd_sum fun j _ => Hn_dvd ξ Y n i j
set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma sR_dvd (n : ℕ) : X ^ ((n + 1) / 2) ∣ sR ξ Y n :=
  Finset.dvd_sum fun j _ => Hn_dvd ξ Y n 0 j
set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma rR_dvd (n : ℕ) : X ^ ((n + 1) / 2) ∣ rR ξ Y n :=
  Finset.dvd_sum fun i _ => Hn_dvd ξ Y n i 0
set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma zR_dvd (n : ℕ) : X ^ ((n + 1) / 2) ∣ zR ξ Y n := Hn_dvd ξ Y n 0 0

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma V_zero : V ξ Y 0 = 1 := by
  simp [V, Vb, wt, g]

open SumX in
set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Summed kernel identity. -/
theorem summed_identity :
    (Y + X ^ 2 * ξ ^ 2 * Y + X * ξ ^ 2 * Y ^ 2 + X - ξ * Y) * tsX (V ξ Y) =
      X * tsX (rR ξ Y) + (X + Y) * tsX (sR ξ Y) - X * tsX (zR ξ Y) - ξ * Y := by
  have hV := Smb_of_dvd (V_dvd ξ Y)
  have hs := Smb_of_dvd (sR_dvd ξ Y)
  have hr := Smb_of_dvd (rR_dvd ξ Y)
  have hz := Smb_of_dvd (zR_dvd ξ Y)
  have h := tsX_congr (step_identity ξ Y)
  rw [tsX_mul _ (Smb_shift hV), tsX_shift hV, V_zero,
    tsX_add (Smb_sub (Smb_sub (Smb_mul _ hV) (Smb_mul _ hr)) (Smb_mul _ hs)) (Smb_mul _ hz),
    tsX_sub (Smb_sub (Smb_mul _ hV) (Smb_mul _ hr)) (Smb_mul _ hs),
    tsX_sub (Smb_mul _ hV) (Smb_mul _ hr), tsX_mul _ hV, tsX_mul _ hr, tsX_mul _ hs,
    tsX_mul _ hz] at h
  linear_combination -h

end kernel

