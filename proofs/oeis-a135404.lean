set_option maxRecDepth 20000 in
lemma f_eq_card (L : ℕ) (p : ℤ × ℤ) : f L p = (W L p).card := by
  induction L generalizing p with
  | zero =>
    by_cases hp : p = (0, 1)
    · subst hp
      have : W 0 (0, 1) = univ := by
        ext w; simp [W, pos_zero', inR]
      simp [f, this]
    · have : W 0 p = ∅ := by
        ext w; simp only [W, mem_filter, mem_univ, true_and, pos_zero', notMem_empty, iff_false]
        intro h; exact hp h.1.symm
      simp [f, hp, this]
  | succ L ih =>
    rw [card_W_succ, f]
    simp [ih]

