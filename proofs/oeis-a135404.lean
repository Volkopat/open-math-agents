set_option maxRecDepth 20000 in
lemma card_W_succ (L : ℕ) (p : ℤ × ℤ) :
    (W (L + 1) p).card = if inR p then ∑ s : Fin 4, (W L (p - step s)).card else 0 := by
  classical
  unfold W
  rw [card_filter]
  rw [← (Fin.snocEquiv (fun _ : Fin (L + 1) => Fin 4)).sum_comp]
  rw [Fintype.sum_prod_type]
  have hE : ∀ (x : Fin 4) (y : Fin L → Fin 4),
      (Fin.snocEquiv fun _ : Fin (L + 1) => Fin 4) (x, y) = Fin.snoc y x := fun _ _ => rfl
  simp_rw [hE, snoc_cond]
  split_ifs with hp
  · refine Finset.sum_congr rfl fun s _ => ?_
    rw [card_filter]
    simp [hp]
  · simp [hp]

