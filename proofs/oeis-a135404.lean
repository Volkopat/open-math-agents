      have z1 : constantCoeff e1 = 0 := by linarith
      have z2 : constantCoeff e2 = 0 := by linarith
      have z3 : constantCoeff e3 = 0 := by linarith
      refine ⟨?_, ?_, ?_⟩
      · rw [he1, pow_succ]; exact mul_dvd_mul_left _ (X_dvd_iff.mpr z1)
      · rw [he2, pow_succ]; exact mul_dvd_mul_left _ (X_dvd_iff.mpr z2)
      · rw [he3, pow_succ]; exact mul_dvd_mul_left _ (X_dvd_iff.mpr z3)
