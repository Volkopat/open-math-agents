lemma inv_dom {D : Type*} [CommRing D] [IsDomain D] (t c Y1 Y2 S1 S2 A s0 : D)
    (hv1 : t + Y1 ≠ 0) (hv2 : t + Y2 ≠ 0) (hY1 : Y1 ≠ 0) (hY2 : Y2 ≠ 0) (hd : Y1 ≠ Y2)
    (k1 : (1 + t * c) ^ 2 * Y1 ^ 2 - c * Y1 + t * (1 + t * c) ^ 2 * Y1 + 1 = 0)
    (k2 : (1 + t * c) ^ 2 * Y2 ^ 2 - c * Y2 + t * (1 + t * c) ^ 2 * Y2 + 1 = 0)
    (hK : (t + Y1) * S1 - (1 + t * c) * Y1 = (t + Y2) * S2 - (1 + t * c) * Y2) :
    GInv.Psi t Y1 A s0 S1 * (Y2 * (t + Y2) ^ 3) = GInv.Psi t Y2 A s0 S2 * (Y1 * (t + Y1) ^ 3) := by
  have inj := IsFractionRing.injective D (FractionRing D)
  set f := algebraMap D (FractionRing D)
  have nz : ∀ x : D, x ≠ 0 → f x ≠ 0 := fun x hx => (map_ne_zero_iff _ inj).mpr hx
  apply inj
  simp only [map_mul, GInv.map_Psi, map_pow]
  have h := GInv.inv_field (f t) (f c) (f Y1) (f Y2) (f S1) (f S2) (f A) (f s0)
    (by simpa using nz _ hv1) (by simpa using nz _ hv2) (nz _ hY1) (nz _ hY2)
    (fun h => hd (inj h))
    (by simpa using congrArg f k1) (by simpa using congrArg f k2) (by simpa using congrArg f hK)
  simpa using h

