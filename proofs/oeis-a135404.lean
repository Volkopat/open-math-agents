/-- Congruence mod `X^n` as equality in the quotient. -/
lemma dvd_iff_mk (n : ℕ) (A B : ℚ⟦X⟧) :
    X ^ n ∣ A - B ↔ Ideal.Quotient.mk (Ideal.span {(X : ℚ⟦X⟧) ^ n}) A =
      Ideal.Quotient.mk (Ideal.span {(X : ℚ⟦X⟧) ^ n}) B := by
  rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]

