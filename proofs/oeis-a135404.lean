set_option maxRecDepth 20000 in
lemma Smb_sub {f g : ℕ → k⟦X⟧} (hf : Smb f) (hg : Smb g) : Smb fun n => f n - g n := by
  intro n m h; simp [hf n m h, hg n m h]

