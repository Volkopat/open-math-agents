theorem fixed_point (Φ : ℚ⟦X⟧ → ℚ⟦X⟧) (P : ℚ⟦X⟧ → Prop) (A0 : ℚ⟦X⟧) (hA0 : P A0)
    (hP : ∀ A, P A → P (Φ A))
    (hPX : ∀ A B, X ∣ A - B → P A → P B)
    (hc : ∀ A B n, P A → P B → X ^ n ∣ A - B → X ^ (n + 1) ∣ Φ A - Φ B) :
    ∃ L, P L ∧ Φ L = L := by
  let A : ℕ → ℚ⟦X⟧ := fun k => Φ^[k] A0
  have hAs : ∀ k, A (k + 1) = Φ (A k) := fun k => Function.iterate_succ_apply' Φ k A0
  have hPk : ∀ k, P (A k) := by
    intro k; induction k with
    | zero => exact hA0
    | succ k ih => rw [hAs]; exact hP _ ih
  have hstep : ∀ k, X ^ k ∣ A (k + 1) - A k := by
    intro k; induction k with
    | zero => simp
    | succ k ih =>
      have := hc _ _ _ (hPk (k + 1)) (hPk k) ih
      rwa [← hAs (k + 1), ← hAs k] at this
  have hmono : ∀ k d, X ^ k ∣ A (k + d) - A k := by
    intro k d; induction d with
    | zero => simp
    | succ d ih =>
      have h1 : X ^ k ∣ A (k + d + 1) - A (k + d) :=
        (pow_dvd_pow X (by omega)).trans (hstep (k + d))
      have : A (k + (d + 1)) - A k = (A (k + d + 1) - A (k + d)) + (A (k + d) - A k) := by
        rw [← add_assoc]; ring
      rw [this]; exact dvd_add h1 ih
  let L : ℚ⟦X⟧ := PowerSeries.mk fun n => coeff n (A (n + 1))
  have hL : ∀ n, X ^ n ∣ L - A n := by
    intro n
    rw [X_pow_dvd_iff]
    intro m hm
    have h := hmono (m + 1) (n - (m + 1))
    rw [show m + 1 + (n - (m + 1)) = n by omega, X_pow_dvd_iff] at h
    have := h m (by omega)
    simp only [map_sub, L, coeff_mk] at this ⊢
    linarith
  have hPL : P L := by
    refine hPX (A 1) L ?_ (hPk 1)
    have := hL 1
    rw [pow_one] at this
    have h2 : A 1 - L = -(L - A 1) := by ring
    rw [h2]; exact (dvd_neg).2 this
  refine ⟨L, hPL, ?_⟩
  ext n
  have h := hc L (A n) n hPL (hPk n) (hL n)
  rw [X_pow_dvd_iff] at h
  have := h n (by omega)
  rw [map_sub, ← hAs] at this
  simp only [L, coeff_mk] at this ⊢
  linarith

