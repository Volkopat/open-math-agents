set_option maxRecDepth 20000 in
lemma a_eq_f (m : ℕ) : a m = f (2 * m) (0, 1) := by
  rw [f_eq_card]; rfl

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Gessel quadrant DP: steps E=(1,0), W=(-1,0), NE=(1,1), SW=(-1,-1), from (0,0). -/
def g : ℕ → ℤ → ℤ → ℕ
  | 0, i, j => if i = 0 ∧ j = 0 then 1 else 0
  | L + 1, i, j => if 0 ≤ i ∧ 0 ≤ j then
      g L (i - 1) j + g L (i + 1) j + g L (i - 1) (j - 1) + g L (i + 1) (j + 1) else 0

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma inR_iff (x y : ℤ) : inR (x, y) ↔ 0 ≤ x + y - 1 ∧ 0 ≤ y - 1 := by
  unfold inR; constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> simp_all <;> omega

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma f_eq_g (L : ℕ) (x y : ℤ) : f L (x, y) = g L (x + y - 1) (y - 1) := by
  induction L generalizing x y with
  | zero =>
    simp only [f, g, Prod.mk.injEq]
    congr 1
    apply propext; omega
  | succ L ih =>
    simp only [f, g, Fin.sum_univ_four, inR_iff]
    split_ifs with h
    · have s0 : step 0 = (0, 1) := by decide
      have s1 : step 1 = (1, 0) := by decide
      have s2 : step 2 = (0, -1) := by decide
      have s3 : step 3 = (-1, 0) := by decide
      simp only [s0, s1, s2, s3, Prod.mk_sub_mk, ih]
      ring_nf
    · rfl

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma a_eq_g (m : ℕ) : a m = g (2 * m) 0 0 := by
  rw [a_eq_f, f_eq_g]; norm_num

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma g_support (n : ℕ) (i j : ℤ) (h : g n i j ≠ 0) :
    0 ≤ i ∧ 0 ≤ j ∧ i ≤ n ∧ j ≤ n ∧ 2 * j ≤ n + i := by
  induction n generalizing i j with
  | zero =>
    simp only [g] at h
    split_ifs at h with h0
    · omega
    · exact absurd rfl h
  | succ n ih =>
    simp only [g] at h
    split_ifs at h with h0
    · push_cast
      rcases Nat.eq_zero_or_pos (g n (i - 1) j) with h1 | h1 <;>
      rcases Nat.eq_zero_or_pos (g n (i + 1) j) with h2 | h2 <;>
      rcases Nat.eq_zero_or_pos (g n (i - 1) (j - 1)) with h3 | h3 <;>
      rcases Nat.eq_zero_or_pos (g n (i + 1) (j + 1)) with h4 | h4
      all_goals first
        | (exfalso; omega)
        | (have := ih _ _ (by omega : g n (i - 1) j ≠ 0); omega)
        | (have := ih _ _ (by omega : g n (i + 1) j ≠ 0); omega)
        | (have := ih _ _ (by omega : g n (i - 1) (j - 1) ≠ 0); omega)
        | (have := ih _ _ (by omega : g n (i + 1) (j + 1) ≠ 0); omega)
    · exact absurd rfl h


