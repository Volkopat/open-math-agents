/-- Kernel relation at a root `Y` of the kernel for parameter `c`. -/
theorem kernel_rel (c : ℚ) (Y : ℚ⟦X⟧)
    (hY : (1 + X * C c) ^ 2 * Y ^ 2 - C c * Y + X * (1 + X * C c) ^ 2 * Y + 1 = 0) :
    (X + Y) * evT (evAt Y) Sser - (1 + X * C c) * Y =
      X * tsX (zR (1 + X * C c) 0) - X * tsX (rR (1 + X * C c) 0) := by
  have h := summed_identity (1 + X * C c) Y
  rw [ev_Sser (1 + X * C c)]
  have e : (Y + X ^ 2 * (1 + X * C c) ^ 2 * Y + X * (1 + X * C c) ^ 2 * Y ^ 2 + X -
      (1 + X * C c) * Y) = X * ((1 + X * C c) ^ 2 * Y ^ 2 - C c * Y + X * (1 + X * C c) ^ 2 * Y + 1) := by
    ring
  rw [e, hY, mul_zero, zero_mul, rR_indep _ Y 0, zR_indep _ Y 0] at h
  linear_combination -h

