theorem fixed_point_unique (Φ : ℚ⟦X⟧ → ℚ⟦X⟧) (P : ℚ⟦X⟧ → Prop)
    (hc : ∀ A B n, P A → P B → X ^ n ∣ A - B → X ^ (n + 1) ∣ Φ A - Φ B)
    (L L' : ℚ⟦X⟧) (hL : P L) (hL' : P L') (h1 : Φ L = L) (h2 : Φ L' = L') : L = L' := by
  have : ∀ n, X ^ n ∣ L - L' := by
    intro n; induction n with
    | zero => simp
    | succ n ih =>
      have := hc L L' n hL hL' ih
      rwa [h1, h2] at this
  rw [← sub_eq_zero]
  ext n
  have h := this (n + 1)
  rw [X_pow_dvd_iff] at h
  simpa using h n (by omega)

