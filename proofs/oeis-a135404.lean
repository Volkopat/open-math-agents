lemma sRp_dvd (n : ℕ) : X ^ ((n + 1) / 2) ∣ sRp n := by
  refine Finset.dvd_sum fun j _ => ?_
  by_cases hg : g n 0 j = 0
  · simp [hg]
  have := g_support n 0 j hg
  exact Dvd.dvd.mul_left (Dvd.dvd.mul_left (pow_dvd_pow _ (by omega)) _) _

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
noncomputable def Sser : (Polynomial ℚ)⟦X⟧ := tsX sRp

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma ev_sRp (ξ Y : ℚ⟦X⟧) (n : ℕ) : evT (evAt Y) (sRp n) = sR ξ Y n := by
  change evTHom (evAt Y) (sRp n) = _
  unfold sRp sR
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  have ha : ∀ F, evTHom (evAt Y) F = evT (evAt Y) F := fun _ => rfl
  have hX : evT (evAt Y) ((X : (Polynomial ℚ)⟦X⟧) ^ (n - j)) = X ^ (n - j) := by
    rw [← ha, map_pow, ha, evT_X]
  rw [map_mul, map_mul, map_natCast, ha, ha, evT_C, hX, map_pow, evAt_X, wt]
  simp

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma ev_Sser (ξ Y : ℚ⟦X⟧) : evT (evAt Y) Sser = tsX (sR ξ Y) := by
  change evTHom (evAt Y) (tsX sRp) = _
  have hs : Smb fun n => evTHom (evAt Y) (sRp n) := by
    have := Smb_of_dvd (sR_dvd ξ Y)
    intro n m hm; have h := this n m hm
    change coeff m (evT _ _) = 0; rw [ev_sRp ξ]; exact h
  rw [map_tsX _ (evT_X _) (Smb_of_dvd sRp_dvd) hs]
  exact tsX_congr fun n => ev_sRp ξ Y n

