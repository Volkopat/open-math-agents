lemma map_Tp {K' : Type*} [CommRing K'] (f : K →+* K') (t y A Bc s0 W U : K) :
    f (Tp t y A Bc s0 W U) = Tp (f t) (f y) (f A) (f Bc) (f s0) (f W) (f U) := by
  simp [Tp, map_ofNat]

set_option maxHeartbeats 0 in
