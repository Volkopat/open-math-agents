lemma rec_unique {b : ℕ → ℚ}
    (h0 : b 0 = 1)
    (hrec : ∀ n : ℕ, ((n : ℚ) + 2) * (3 * (n : ℚ) + 5) * b (n + 1) =
      4 * (6 * (n : ℚ) + 5) * (2 * (n : ℚ) + 1) * b n) :
    ∀ n, b n = c n := by
  intro n
  induction n with
  | zero => simp [h0, c_zero]
  | succ n ih =>
    have hn2 : (n : ℚ) + 2 ≠ 0 := by
      have : (0 : ℚ) < (n : ℚ) + 2 := by positivity
      exact ne_of_gt this
    have hn5 : 3 * (n : ℚ) + 5 ≠ 0 := by
      have : (0 : ℚ) < 3 * (n : ℚ) + 5 := by positivity
      exact ne_of_gt this
    have hb := hrec n
    have hc := c_rec n
    have hmul := mul_ne_zero hn2 hn5
    apply (mul_right_inj' hmul).mp
    calc
      ((n : ℚ) + 2) * (3 * (n : ℚ) + 5) * b (n + 1)
          = 4 * (6 * (n : ℚ) + 5) * (2 * (n : ℚ) + 1) * b n := hb
      _ = 4 * (6 * (n : ℚ) + 5) * (2 * (n : ℚ) + 1) * c n := by rw [ih]
      _ = ((n : ℚ) + 2) * (3 * (n : ℚ) + 5) * c (n + 1) := hc.symm

