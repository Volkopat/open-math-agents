lemma inv_field {L : Type*} [Field L] (t c Y1 Y2 S1 S2 A s0 : L)
    (hv1 : t + Y1 ≠ 0) (hv2 : t + Y2 ≠ 0) (hY1 : Y1 ≠ 0) (hY2 : Y2 ≠ 0) (hd : Y1 ≠ Y2)
    (k1 : (1 + t * c) ^ 2 * Y1 ^ 2 - c * Y1 + t * (1 + t * c) ^ 2 * Y1 + 1 = 0)
    (k2 : (1 + t * c) ^ 2 * Y2 ^ 2 - c * Y2 + t * (1 + t * c) ^ 2 * Y2 + 1 = 0)
    (hK : (t + Y1) * S1 - (1 + t * c) * Y1 = (t + Y2) * S2 - (1 + t * c) * Y2) :
    Psi t Y1 A s0 S1 * (Y2 * (t + Y2) ^ 3) = Psi t Y2 A s0 S2 * (Y1 * (t + Y1) ^ 3) := by
  set ξ := 1 + t * c with hξ
  have hsum : ξ ^ 2 * (Y1 + Y2) = c - t * ξ ^ 2 := by
    have h : (Y1 - Y2) * (ξ ^ 2 * (Y1 + Y2) - c + t * ξ ^ 2) = 0 := by linear_combination k1 - k2
    rcases mul_eq_zero.mp h with h | h
    · exact absurd (sub_eq_zero.mp h) hd
    · linear_combination h
  have hprod : ξ ^ 2 * (Y1 * Y2) = 1 := by linear_combination Y1 * hsum - k1
  have hξ0 : ξ ≠ 0 := by rintro h; rw [h] at hprod; simp at hprod
  have hvv : ξ * (t + Y1) * (t + Y2) = 1 := by
    have : ξ * (ξ * (t + Y1) * (t + Y2) - 1) = 0 := by
      linear_combination t * hsum + hprod - hξ
    rcases mul_eq_zero.mp this with h | h
    · exact absurd h hξ0
    · linear_combination h
  have i1 : (t + Y1)⁻¹ = ξ * (t + Y2) := inv_eq_of_mul_eq_one_right (by linear_combination hvv)
  have i2 : (t + Y2)⁻¹ = ξ * (t + Y1) := inv_eq_of_mul_eq_one_right (by linear_combination hvv)
  have i3 : Y1⁻¹ = ξ ^ 2 * Y2 := inv_eq_of_mul_eq_one_right (by linear_combination hprod)
  have i4 : Y2⁻¹ = ξ ^ 2 * Y1 := inv_eq_of_mul_eq_one_right (by linear_combination hprod)
  have e : ∀ (Y S : L), t + Y ≠ 0 → Y ≠ 0 → Psi t Y A s0 S =
      Y * (t + Y) ^ 3 * Fp t A s0 ((t + Y) * S + (t + Y)⁻¹) (Y * ((t + Y)⁻¹) ^ 2 + (t + Y) ^ 2 * Y⁻¹) := by
    intro Y S hv hY
    unfold Psi Fp
    field_simp
    ring
  rw [e Y1 S1 hv1 hY1, e Y2 S2 hv2 hY2, i1, i2, i3, i4]
  have hl : (t + Y1) * S1 + ξ * (t + Y2) = (t + Y2) * S2 + ξ * (t + Y1) := by linear_combination hK
  have hj : Y1 * (ξ * (t + Y2)) ^ 2 + (t + Y1) ^ 2 * (ξ ^ 2 * Y2) =
      Y2 * (ξ * (t + Y1)) ^ 2 + (t + Y2) ^ 2 * (ξ ^ 2 * Y1) := by ring
  rw [hl, hj]; ring

