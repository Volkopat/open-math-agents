/-- Region test. -/
def inR (p : ℤ × ℤ) : Prop := 0 < p.2 ∧ -p.2 < p.1

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
instance (p : ℤ × ℤ) : Decidable (inR p) := by unfold inR; infer_instance

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- DP count of admissible words of length `L` ending at `p`. -/
def f : ℕ → ℤ × ℤ → ℕ
  | 0, p => if p = (0, 1) then 1 else 0
  | L + 1, p => if inR p then ∑ s : Fin 4, f L (p - step s) else 0

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Admissible words of length `L` ending at `p`. -/
def W (L : ℕ) (p : ℤ × ℤ) : Finset (Fin L → Fin 4) :=
  univ.filter fun w => pos w L = p ∧ ∀ j ≤ L, inR (pos w j)

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma pos_snoc_le {L : ℕ} (w : Fin L → Fin 4) (s : Fin 4) {j : ℕ} (hj : j ≤ L) :
    pos (Fin.snoc w s : Fin (L + 1) → Fin 4) j = pos w j := by
  unfold pos
  rw [Fin.sum_univ_castSucc]
  simp only [Fin.snoc_castSucc, Fin.val_castSucc, Fin.snoc_last, Fin.val_last]
  have : ¬ L < j := by omega
  simp [this]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma pos_snoc_last {L : ℕ} (w : Fin L → Fin 4) (s : Fin 4) :
    pos (Fin.snoc w s : Fin (L + 1) → Fin 4) (L + 1) = pos w L + step s := by
  unfold pos
  rw [Fin.sum_univ_castSucc]
  simp only [Fin.snoc_castSucc, Fin.val_castSucc, Fin.snoc_last, Fin.val_last]
  have h1 : ∀ i : Fin L, (i : ℕ) < L + 1 := fun i => by omega
  have h2 : ∀ i : Fin L, (i : ℕ) < L := fun i => i.isLt
  simp [h1, h2, add_assoc]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma pos_zero' {L : ℕ} (w : Fin L → Fin 4) : pos w 0 = (0, 1) := by simp [pos]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma snoc_cond {L : ℕ} (w : Fin L → Fin 4) (s : Fin 4) (p : ℤ × ℤ) :
    (pos (Fin.snoc w s : Fin (L + 1) → Fin 4) (L + 1) = p ∧
      ∀ j ≤ L + 1, inR (pos (Fin.snoc w s : Fin (L + 1) → Fin 4) j)) ↔
    (inR p ∧ (pos w L = p - step s ∧ ∀ j ≤ L, inR (pos w j))) := by
  rw [pos_snoc_last]
  constructor
  · rintro ⟨hp, hall⟩
    have hL := hall (L + 1) le_rfl
    rw [pos_snoc_last, hp] at hL
    refine ⟨hL, ?_, ?_⟩
    · rw [← hp]; abel
    · intro j hj
      have := hall j (by omega)
      rwa [pos_snoc_le w s hj] at this
  · rintro ⟨hp, hpos, hall⟩
    have hp' : pos w L + step s = p := by rw [hpos]; abel
    refine ⟨hp', ?_⟩
    intro j hj
    rcases Nat.lt_or_ge j (L + 1) with h | h
    · rw [pos_snoc_le w s (by omega)]; exact hall j (by omega)
    · have : j = L + 1 := by omega
      subst this
      rw [pos_snoc_last, hp']; exact hp

