    intro d hd
    ext m
    have := hd (m + 1)
    rw [X_pow_dvd_iff] at this
    simpa using this m (by omega)
  refine ⟨?_, ?_, ?_⟩
  · exact sub_eq_zero.mp (fin _ fun n => (key n).1)
  · exact sub_eq_zero.mp (fin _ fun n => (key n).2.1)
  · exact sub_eq_zero.mp (fin _ fun n => (key n).2.2)

