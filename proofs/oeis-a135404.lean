  2*A*s*t^3*v^4 - 2*A*s*t^2*v^5 + 2*A*t^3*v^2 - 2*A*t^2*v^3 - s^3*t^3*v^6 + s^3*t^2*v^7 + s^2*s0*t^4*v^5 - s^2*s0*t^3*v^6 - 3*s^2*t^3*v^4 + 5*s^2*t^2*v^5 - 2*s^2*t*v^6 + 2*s*s0*t^4*v^3 - 3*s*s0*t^3*v^4 + s*s0*t^2*v^5 - 2*s*t^3*v^2 + 5*s*t^2*v^3 + s*t*v^6 - 4*s*t*v^4 + s*v^5 - s0*t^2*v^5 + t*v^4 - v^5

