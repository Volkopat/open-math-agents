namespace GesselKr
open PowerSeries

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
theorem fixed_point (Φ : ℚ⟦X⟧ → ℚ⟦X⟧) (P : ℚ⟦X⟧ → Prop) (A0 : ℚ⟦X⟧) (hA0 : P A0)
    (hP : ∀ A, P A → P (Φ A))
    (hPX : ∀ A B, X ∣ A - B → P A → P B)
    (hc : ∀ A B n, P A → P B → X ^ n ∣ A - B → X ^ (n + 1) ∣ Φ A - Φ B) :
    ∃ L, P L ∧ Φ L = L := by
  let A : ℕ → ℚ⟦X⟧ := fun k => Φ^[k] A0
  have hAs : ∀ k, A (k + 1) = Φ (A k) := fun k => Function.iterate_succ_apply' Φ k A0
  have hPk : ∀ k, P (A k) := by
    intro k; induction k with
    | zero => exact hA0
    | succ k ih => rw [hAs]; exact hP _ ih
  have hstep : ∀ k, X ^ k ∣ A (k + 1) - A k := by
    intro k; induction k with
    | zero => simp
    | succ k ih =>
      have := hc _ _ _ (hPk (k + 1)) (hPk k) ih
      rwa [← hAs (k + 1), ← hAs k] at this
  have hmono : ∀ k d, X ^ k ∣ A (k + d) - A k := by
    intro k d; induction d with
    | zero => simp
    | succ d ih =>
      have h1 : X ^ k ∣ A (k + d + 1) - A (k + d) :=
        (pow_dvd_pow X (by omega)).trans (hstep (k + d))
      have : A (k + (d + 1)) - A k = (A (k + d + 1) - A (k + d)) + (A (k + d) - A k) := by
        rw [← add_assoc]; ring
      rw [this]; exact dvd_add h1 ih
  let L : ℚ⟦X⟧ := PowerSeries.mk fun n => coeff n (A (n + 1))
  have hL : ∀ n, X ^ n ∣ L - A n := by
    intro n
    rw [X_pow_dvd_iff]
    intro m hm
    have h := hmono (m + 1) (n - (m + 1))
    rw [show m + 1 + (n - (m + 1)) = n by omega, X_pow_dvd_iff] at h
    have := h m (by omega)
    simp only [map_sub, L, coeff_mk] at this ⊢
    linarith
  have hPL : P L := by
    refine hPX (A 1) L ?_ (hPk 1)
    have := hL 1
    rw [pow_one] at this
    have h2 : A 1 - L = -(L - A 1) := by ring
    rw [h2]; exact (dvd_neg).2 this
  refine ⟨L, hPL, ?_⟩
  ext n
  have h := hc L (A n) n hPL (hPk n) (hL n)
  rw [X_pow_dvd_iff] at h
  have := h n (by omega)
  rw [map_sub, ← hAs] at this
  simp only [L, coeff_mk] at this ⊢
  linarith

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
theorem fixed_point_unique (Φ : ℚ⟦X⟧ → ℚ⟦X⟧) (P : ℚ⟦X⟧ → Prop)
    (hc : ∀ A B n, P A → P B → X ^ n ∣ A - B → X ^ (n + 1) ∣ Φ A - Φ B)
    (L L' : ℚ⟦X⟧) (hL : P L) (hL' : P L') (h1 : Φ L = L) (h2 : Φ L' = L') : L = L' := by
  have : ∀ n, X ^ n ∣ L - L' := by
    intro n; induction n with
    | zero => simp
    | succ n ih =>
      have := hc L L' n hL hL' ih
      rwa [h1, h2] at this
  rw [← sub_eq_zero]
  ext n
  have h := this (n + 1)
  rw [X_pow_dvd_iff] at h
  simpa using h n (by omega)

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Congruence mod `X^n` as equality in the quotient. -/
lemma dvd_iff_mk (n : ℕ) (A B : ℚ⟦X⟧) :
    X ^ n ∣ A - B ↔ Ideal.Quotient.mk (Ideal.span {(X : ℚ⟦X⟧) ^ n}) A =
      Ideal.Quotient.mk (Ideal.span {(X : ℚ⟦X⟧) ^ n}) B := by
  rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma mk_inv_congr (I : Ideal ℚ⟦X⟧) (A B : ℚ⟦X⟧) (hA : constantCoeff A ≠ 0)
    (hB : constantCoeff B ≠ 0) (h : Ideal.Quotient.mk I A = Ideal.Quotient.mk I B) :
    Ideal.Quotient.mk I A⁻¹ = Ideal.Quotient.mk I B⁻¹ := by
  have e1 : Ideal.Quotient.mk I A * Ideal.Quotient.mk I A⁻¹ = 1 := by
    rw [← map_mul, PowerSeries.mul_inv_cancel A hA, map_one]
  have e2 : Ideal.Quotient.mk I B⁻¹ * Ideal.Quotient.mk I B = 1 := by
    rw [← map_mul, PowerSeries.inv_mul_cancel B hB, map_one]
  calc Ideal.Quotient.mk I A⁻¹ = (Ideal.Quotient.mk I B⁻¹ * Ideal.Quotient.mk I B) *
        Ideal.Quotient.mk I A⁻¹ := by rw [e2, one_mul]
    _ = Ideal.Quotient.mk I B⁻¹ * (Ideal.Quotient.mk I A * Ideal.Quotient.mk I A⁻¹) := by
        rw [h]; ring
    _ = _ := by rw [e1, mul_one]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma cc_num (k : ℕ) [k.AtLeastTwo] :
    constantCoeff (no_index (OfNat.ofNat k : ℚ⟦X⟧)) = (OfNat.ofNat k : ℚ) := map_ofNat _ _


set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Kernel root (rescaled): `ξ^2 Y^2 - (w + w⁻¹) Y + X ξ^2 Y + 1 = 0`, `Y(0) = w`,
    where `ξ = 1 + X (w + w⁻¹)`. -/
theorem exists_kernel_root (w : ℚ) (hw0 : w ≠ 0) (hw1 : w ≠ w⁻¹) :
    ∃ Y : ℚ⟦X⟧, constantCoeff Y = w ∧
      (1 + X * C (w + w⁻¹)) ^ 2 * Y ^ 2 - C (w + w⁻¹) * Y + X * (1 + X * C (w + w⁻¹)) ^ 2 * Y
        + 1 = 0 := by
  let H : ℚ⟦X⟧ → ℚ⟦X⟧ := fun A => (-(2 * C (w + w⁻¹) + X * C (w + w⁻¹) ^ 2) * A ^ 2 - (1 + X * C (w + w⁻¹)) ^ 2 * A) * (A - C w⁻¹)⁻¹
  let Φ : ℚ⟦X⟧ → ℚ⟦X⟧ := fun A => C w + X * H A
  let P : ℚ⟦X⟧ → Prop := fun A => constantCoeff A = w
  have hD : ∀ A, P A → constantCoeff (A - C w⁻¹) ≠ 0 := by
    intro A hA; simp only [P] at hA; simp [hA]; exact sub_ne_zero.mpr hw1
  obtain ⟨Y, hY, hfix⟩ := fixed_point Φ P (C w) (by simp [P]) (by intro A _; simp [Φ, P])
    (by
      intro A B h hA
      simp only [P] at hA ⊢
      obtain ⟨c, hc⟩ := h
      have := congrArg constantCoeff hc
      simp at this; linarith)
    (by
      intro A B n hA hB h
      have h' : X ^ n ∣ H A - H B := by
        rw [dvd_iff_mk] at h ⊢
        have hi := mk_inv_congr (Ideal.span {(X : ℚ⟦X⟧) ^ n}) _ _ (hD A hA) (hD B hB)
          (by simp only [map_sub, h])
        simp only [H, map_mul, map_pow, map_sub, map_neg, map_add]
        rw [hi, h]
      have : Φ A - Φ B = X * (H A - H B) := by simp only [Φ]; ring
      rw [this, pow_succ, mul_comm (X ^ n)]
      exact mul_dvd_mul_left X h')
  refine ⟨Y, hY, ?_⟩
