lemma T_Psi (t y A Bc s0 W U s : K) (h1 : s = A + (t + y) * Bc + (t + y) ^ 2 * W)
    (h2 : s = s0 + y * U) :
    y * (t + y) ^ 3 * Tp t y A Bc s0 W U = Psi t y A s0 s := by
  subst h1
  unfold Tp Psi
