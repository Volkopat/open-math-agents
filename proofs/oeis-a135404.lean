  rw [tsX, coeff_mk, ← Finset.sum_range_add_sum_Ico _ h, Finset.sum_eq_zero (s := Ico _ _), add_zero]
  intro n hn; exact hf n m (by have := (Finset.mem_Ico.mp hn).1; omega)

