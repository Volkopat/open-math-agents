lemma mk_inv_congr (I : Ideal ℚ⟦X⟧) (A B : ℚ⟦X⟧) (hA : constantCoeff A ≠ 0)
    (hB : constantCoeff B ≠ 0) (h : Ideal.Quotient.mk I A = Ideal.Quotient.mk I B) :
    Ideal.Quotient.mk I A⁻¹ = Ideal.Quotient.mk I B⁻¹ := by
  have e1 : Ideal.Quotient.mk I A * Ideal.Quotient.mk I A⁻¹ = 1 := by
    rw [← map_mul, PowerSeries.mul_inv_cancel A hA, map_one]
  have e2 : Ideal.Quotient.mk I B⁻¹ * Ideal.Quotient.mk I B = 1 := by
    rw [← map_mul, PowerSeries.inv_mul_cancel B hB, map_one]
  calc Ideal.Quotient.mk I A⁻¹ = (Ideal.Quotient.mk I B⁻¹ * Ideal.Quotient.mk I B) *
        Ideal.Quotient.mk I A⁻¹ := by rw [e2, one_mul]
    _ = Ideal.Quotient.mk I B⁻¹ * (Ideal.Quotient.mk I A * Ideal.Quotient.mk I A⁻¹) := by
        rw [h]; ring
    _ = _ := by rw [e1, mul_one]

