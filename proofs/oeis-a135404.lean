lemma W_infinite : {w : ℚ | w ≠ 0 ∧ w ≠ w⁻¹}.Infinite := by
  refine Set.infinite_of_injective_forall_mem (f := fun n : ℕ => (n : ℚ) + 2) ?_ ?_
  · intro a b h; simpa using h
  · intro n
    have hpos : (0 : ℚ) < n + 2 := by positivity
    refine ⟨hpos.ne', fun h => ?_⟩
    have h1 : ((n : ℚ) + 2) * ((n : ℚ) + 2) = 1 := by
      nth_rewrite 2 [h]; exact mul_inv_cancel₀ hpos.ne'
    nlinarith

