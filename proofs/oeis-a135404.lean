open PowerSeries

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma cc_eval₂ (p : Polynomial ℚ) (Y : ℚ⟦X⟧) :
    constantCoeff (p.eval₂ C Y) = p.eval (constantCoeff Y) := by
  rw [Polynomial.hom_eval₂]
  have : (constantCoeff).comp (C (R := ℚ)) = RingHom.id ℚ := by ext; simp
  rw [this, Polynomial.eval₂_id]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma refl_contra (p : Polynomial ℚ) (hp : p.natDegree ≠ 0) (W : Set ℚ) (hW : W.Infinite)
    (h0 : ∀ w ∈ W, w ≠ 0) (h : ∀ w ∈ W, p.eval w = p.eval w⁻¹) : False := by
  set d := p.natDegree
  let q : Polynomial ℚ := Polynomial.X ^ d * p - Polynomial.reflect d p
  have hq : ∀ w ∈ W, q.IsRoot w := by
    intro w hw
    have hw0 := h0 w hw
    let _ : Invertible w⁻¹ := invertibleOfNonzero (inv_ne_zero hw0)
    have := Polynomial.eval₂_reflect_mul_pow (RingHom.id ℚ) w⁻¹ d p le_rfl
    simp only [Polynomial.eval₂_id, invOf_eq_inv, inv_inv] at this
    simp only [Polynomial.IsRoot, q, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_X]
    rw [h w hw, ← this, ← mul_assoc, mul_comm (w ^ d), mul_assoc, ← mul_pow,
      mul_inv_cancel₀ hw0, one_pow, mul_one, sub_self]
  have hq0 : q = 0 := Polynomial.eq_zero_of_infinite_isRoot q (hW.mono fun w hw => hq w hw)
  have := congrArg (fun r => Polynomial.coeff r 0) hq0
  simp only [q, Polynomial.coeff_sub, Polynomial.coeff_reflect, Polynomial.coeff_zero] at this
  rw [Polynomial.coeff_X_pow_mul', if_neg (by omega)] at this
  simp only [Polynomial.revAt_le (Nat.zero_le d), Nat.sub_zero, zero_sub, neg_eq_zero] at this
  exact (Polynomial.leadingCoeff_ne_zero.mpr (by rintro rfl; simp [d] at hp)) this

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
/-- Invariant lemma (rescaled form of BBMR Lemma 3.2). -/
theorem invariant_lemma (B : (Polynomial ℚ)⟦X⟧) (W : Set ℚ) (hW : W.Infinite)
    (h0 : ∀ w ∈ W, w ≠ 0) (Y : ℚ → ℚ⟦X⟧) (hY : ∀ w, constantCoeff (Y w) = w)
    (hinv : ∀ w ∈ W, evT (Polynomial.eval₂RingHom C (Y w)) B =
      evT (Polynomial.eval₂RingHom C (Y w⁻¹)) B) :
    ∀ m, (coeff m B).natDegree = 0 := by
  by_contra hcon
  push Not at hcon
  classical
  let m := Nat.find hcon
  have hm : (coeff m B).natDegree ≠ 0 := Nat.find_spec hcon
  have hlt : ∀ k < m, (coeff k B).natDegree = 0 := fun k hk => by
    by_contra h; exact Nat.find_min hcon hk h
  have key : ∀ w, coeff m (evT (Polynomial.eval₂RingHom C (Y w)) B) = (coeff m B).eval w := by
    intro w
    rw [coeff_evT, Finset.sum_range_succ, Nat.sub_self, coeff_zero_eq_constantCoeff_apply]
    rw [Finset.sum_eq_zero]
    · simp [cc_eval₂, hY]
    · intro k hk
      rw [Finset.mem_range] at hk
      rw [Polynomial.eq_C_of_natDegree_eq_zero (hlt k hk)]
      simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, coeff_C]
      rw [if_neg (by omega)]
  refine refl_contra (coeff m B) hm W hW h0 fun w hw => ?_
  rw [← key w, ← key w⁻¹, hinv w hw]

end GesselC



