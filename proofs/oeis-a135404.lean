    (h2 : a2 * (Z ^ 2 + 3) ^ 3 = 2 * (Z ^ 6 + Z ^ 4 + 27 * Z ^ 2 + 3))
    (h3 : a3 * (Z ^ 3 * (Z ^ 2 + 3) ^ 3) =
      (Z - 1) * (Z ^ 8 - Z ^ 7 - 8 * Z ^ 5 + 19 * Z ^ 4 + 7 * Z ^ 3 + 10 * Z ^ 2 + 2 * Z + 2)) :
    F1 a1 a2 a3 = 0 ∧ F2 a1 a2 a3 = 0 ∧ F3 a1 a2 a3 = 0 := by
  have c1 : constantCoeff a1 = 1 := by
    have := congrArg constantCoeff h1
    simp [hZ0, cc_num] at this; linarith
  have nz : ∀ P : ℚ⟦X⟧, constantCoeff P ≠ 0 → P ≠ 0 := fun P hP h => hP (by rw [h]; simp)
  have hF2 : F2 a1 a2 a3 = 0 := by
    have := cand_F2 Z a1 a2 a3 hZ h1 h2 h3
    refine (mul_eq_zero.mp this).resolve_left (nz _ ?_)
    simp [hZ0, cc_num] <;> norm_num
  have hK : Kq a1 = 0 := by
    have := cand_K Z a1 hZ h1
    refine (mul_eq_zero.mp this).resolve_left (nz _ ?_)
    simp [hZ0, cc_num] <;> norm_num
  have hH : (-a1^2*X - a1 + 3*a2 - 2) = 0 := by
    have := cand_H Z a1 a2 hZ h1 h2
    refine (mul_eq_zero.mp this).resolve_left (nz _ ?_)
    simp [hZ0, cc_num] <;> norm_num
  have hG1 : (32*a1^3*a2*X^3 - 64*a1^3*a3*X^3 + 256*a1^2*a2^2*X^3 + 112*a1^2*a2*X^2 - 96*a1^2*a3*X^2 - 256*a1^2*X^2 + 4*a1^2*X + 256*a1*a2^2*X^2 + 88*a1*a2*X - 48*a1*a3*X - 256*a1*X + 4*a1 - 512*a2^3*X^2 - 344*a2^2*X + 864*a2*a3*X + 512*a2*X - 4*a2 - 864*a3^2*X - 8*a3) = 0 := by
