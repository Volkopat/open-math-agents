/-- Euler operator. -/
noncomputable def θ (F : ℚ⟦X⟧) : ℚ⟦X⟧ := X * (PowerSeries.derivative ℚ) F

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma coeff_θ (F : ℚ⟦X⟧) (m : ℕ) : coeff m (θ F) = m * coeff m F := by
  cases m with
  | zero => simp [θ]
  | succ k =>
    rw [θ, coeff_succ_X_mul, coeff_derivative]
    push_cast; ring

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma coeff_num_mul (k : ℕ) [k.AtLeastTwo] (n : ℕ) (φ : ℚ⟦X⟧) :
    coeff n ((no_index (OfNat.ofNat k : ℚ⟦X⟧)) * φ) = (OfNat.ofNat k : ℚ) * coeff n φ := by
  rw [← map_ofNat (C (R := ℚ)) k, coeff_C_mul]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma θθ (F : ℚ⟦X⟧) : θ (θ F) = X * (PowerSeries.derivative ℚ) F + X ^ 2 * (PowerSeries.derivative ℚ) ((PowerSeries.derivative ℚ) F) := by
  simp only [θ, Derivation.leibniz, derivative_X, smul_eq_mul]
  ring

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma cc_num (k : ℕ) [k.AtLeastTwo] :
    constantCoeff (no_index (OfNat.ofNat k : ℚ⟦X⟧)) = (OfNat.ofNat k : ℚ) := map_ofNat _ _

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
lemma M_ne_zero (Z : ℚ⟦X⟧) (hZ0 : constantCoeff Z = 1) : (134217728*Z^18*(Z + 1)^3*(Z^2 - 3)^6*(Z^2 + 3)^15) ≠ 0 := by
  intro h
  have := congrArg constantCoeff h
  simp [hZ0, cc_num] at this
  norm_num at this

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
theorem gessel_rec (Z G : ℚ⟦X⟧) (hZ0 : constantCoeff Z = 1)
    (hZ : 256 * X * Z ^ 6 = (Z ^ 2 - 1) * (Z ^ 2 + 3) ^ 3)
    (hG : G * ((1 + Z) * (Z ^ 2 + 3) ^ 3) = 32 * Z ^ 3 * (3 + 3 * Z - 3 * Z ^ 2 + Z ^ 3)) :
    coeff 0 G = 1 ∧ ∀ n : ℕ, ((n : ℚ) + 2) * (3 * (n : ℚ) + 5) * coeff (n + 1) G =
      4 * (6 * (n : ℚ) + 5) * (2 * (n : ℚ) + 1) * coeff n G := by
  have hP := ode_poly Z G hZ hG
  have hE := (mul_eq_zero.mp hP).resolve_left (M_ne_zero Z hZ0)
  have ode : 3 * θ (θ G) + 5 * θ G + 2 * G - 2 = 4 * X * (12 * θ (θ G) + 16 * θ G + 5 * G) := by
    rw [θθ]; unfold θ; linear_combination hE
  constructor
  · have h0 := congrArg constantCoeff hG
    simp [hZ0, cc_num] at h0
    have : constantCoeff G = coeff 0 G := by simp
    rw [← this]; linarith
  · intro n
    have h := congrArg (coeff (n + 1)) ode
    simp only [map_add, map_sub, coeff_num_mul, coeff_θ, mul_assoc, coeff_succ_X_mul] at h
    have h2 : coeff (n + 1) (2 : ℚ⟦X⟧) = 0 := by
      rw [← map_ofNat (C (R := ℚ)) 2, coeff_C]; simp
    rw [h2] at h
    push_cast at h
    linear_combination h

end GesselE


