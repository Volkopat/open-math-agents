theorem cand_all (Z a1 a2 a3 : ℚ⟦X⟧) (hZ0 : constantCoeff Z = 1)
    (hZ : 256 * X * Z ^ 6 = (Z ^ 2 - 1) * (Z ^ 2 + 3) ^ 3)
