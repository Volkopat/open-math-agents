      unfold F1; unfold F2 at hF2; linear_combination hG1 - (8 * a2 * X + 1) * hF2
    exact (mul_eq_zero.mp h8).resolve_left (nz _ (by simp [cc_num]))
  refine ⟨hF1, hF2, ?_⟩
  have h8 : (8 : ℚ⟦X⟧) * F3 a1 a2 a3 = 0 := by
    unfold F3; unfold F1 at hF1; unfold F2 at hF2
    linear_combination 8 * hF1 + (16 * X + 1) * hF2 + (4 * (16 * X - 1) ^ 2) * hH
  exact (mul_eq_zero.mp h8).resolve_left (nz _ (by simp [cc_num]))

