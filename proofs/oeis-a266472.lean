import OMAStatements.S_oeis_a266472
import Mathlib

/-!
# oeis-a266472: counting the 5 X n arrays

Split an array (a list of columns) into its first column and the rest. The local conditions
are a chain condition, and each lexicographic comparison of consecutive rows is decided at the first position
where the two differ, so it only adds a flag saying whether the comparison is still pending. The
numbers of valid arrays with a given first column and given pending flags satisfy a linear
recursion over the next column; their explicit polynomial closed forms are checked by induction
over the 32 possible first columns and all flag settings. Summing them gives Hardin's
polynomial, and the generating function and Barker's recurrence follow from it.

Source: OEIS A266472, https://oeis.org/A266472.
-/
namespace OMA.P_oeis_a266472

open OMA.S_oeis_a266472

abbrev R := Fin 5 → Fin 2

lemma lexle (r s : R) : toLex r ≤ toLex s ↔ (r 0 < s 0 ∨ (r 0 = s 0 ∧ (r 1 < s 1 ∨ (r 1 = s 1 ∧ (r 2 < s 2 ∨ (r 2 = s 2 ∧ (r 3 < s 3 ∨ (r 3 = s 3 ∧ r 4 ≤ s 4)))))))) := by
  rw [le_iff_lt_or_eq]
  change (∃ i, (∀ j, j < i → r j = s j) ∧ r i < s i) ∨ r = s ↔ _
  rw [funext_iff]
  simp only [Fin.exists_fin_succ, Fin.forall_fin_succ, IsEmpty.exists_iff,
    IsEmpty.forall_iff]
  simp +decide only [Fin.succ_zero_eq_one, Fin.succ_one_eq_two, Fin.isValue, false_imp_iff, true_imp_iff, and_true, true_and, or_false]
  rw [le_iff_lt_or_eq (a := r 4)]
  tauto

lemma sumk (g : R → ℚ) : ∑ s : R, g s = ∑ y0 : Fin 2, ∑ y1 : Fin 2, ∑ y2 : Fin 2, ∑ y3 : Fin 2, ∑ y4 : Fin 2, g ![y0, y1, y2, y3, y4] := by
  let e : Fin 2 × Fin 2 × Fin 2 × Fin 2 × Fin 2 ≃ R :=
    ⟨fun p => ![p.1, p.2.1, p.2.2.1, p.2.2.2.1, p.2.2.2.2], fun f => (f 0, f 1, f 2, f 3, f 4), fun p => by simp,
      fun f => by ext i; fin_cases i <;> rfl⟩
  rw [← e.sum_comp]
  simp only [Fintype.sum_prod_type]
  rfl

def rowOK (_r : R) : Prop := True

def adj (r s : R) : Prop := toLex r ≤ toLex s ∧ ∑ i, (s i : ℕ) ≤ ∑ i, (r i : ℕ)

/-- A decidable form of `adj`. -/
def adjE (r s : R) : Prop :=
  (r 0 < s 0 ∨ (r 0 = s 0 ∧ (r 1 < s 1 ∨ (r 1 = s 1 ∧ (r 2 < s 2 ∨ (r 2 = s 2 ∧ (r 3 < s 3 ∨ (r 3 = s 3 ∧ r 4 ≤ s 4)))))))) ∧
    ∑ i, (s i : ℕ) ≤ ∑ i, (r i : ℕ)

lemma adj_iff (r s : R) : adj r s ↔ adjE r s := by unfold adj adjE; rw [lexle]

instance : DecidablePred rowOK := fun r => by unfold rowOK; infer_instance
instance (r s : R) : Decidable (adjE r s) := by unfold adjE; infer_instance

open Classical

def Pall (l : List R) : Prop := (∀ r ∈ l, rowOK r) ∧ l.IsChain adj

def C0 (l : List R) : Prop := l.map (fun r => r 0) ≤ l.map (fun r => r 1)
def C1 (l : List R) : Prop := l.map (fun r => r 1) ≤ l.map (fun r => r 2)
def C2 (l : List R) : Prop := l.map (fun r => r 2) ≤ l.map (fun r => r 3)
def C3 (l : List R) : Prop := l.map (fun r => r 3) ≤ l.map (fun r => r 4)

lemma isSol_iff (l : List R) : IsSolution l ↔ Pall l ∧ C0 l ∧ C1 l ∧ C2 l ∧ C3 l := by
  unfold IsSolution Pall rowOK adj C0 C1 C2 C3
  simp only [Fin.forall_fin_succ, IsEmpty.forall_iff, Fin.succ_zero_eq_one, Fin.castSucc_zero, Fin.succ_one_eq_two, Fin.castSucc_one, Fin.reduceSucc, Fin.reduceCastSucc, implies_true, true_and]
  tauto

lemma pall_cons_nil (r : R) : Pall [r] ↔ rowOK r := by
  simp [Pall]

lemma pall_cons_cons (r s : R) (m : List R) :
    Pall (r :: s :: m) ↔ rowOK r ∧ adj r s ∧ Pall (s :: m) := by
  unfold Pall
  rw [List.isChain_cons]
  simp only [List.mem_cons, forall_eq_or_imp, List.head?_cons, Option.mem_def,
    Option.some.injEq, forall_eq']
  tauto

lemma lcons (a b : Fin 2) (l m : List (Fin 2)) : a :: l ≤ b :: m ↔ a < b ∨ (a = b ∧ l ≤ m) := by
  rw [le_iff_lt_or_eq, le_iff_lt_or_eq]
  change (List.Lex (· < ·) _ _ ∨ _) ↔ (_ ∨ _ ∧ (List.Lex (· < ·) _ _ ∨ _))
  rw [List.cons_lex_cons_iff, List.cons.injEq]
  tauto

lemma c0_cons (r : R) (l : List R) : C0 (r :: l) ↔ r 0 < r 1 ∨ (r 0 = r 1 ∧ C0 l) := by
  unfold C0; simp only [List.map_cons]; exact lcons _ _ _ _

lemma c1_cons (r : R) (l : List R) : C1 (r :: l) ↔ r 1 < r 2 ∨ (r 1 = r 2 ∧ C1 l) := by
  unfold C1; simp only [List.map_cons]; exact lcons _ _ _ _

lemma c2_cons (r : R) (l : List R) : C2 (r :: l) ↔ r 2 < r 3 ∨ (r 2 = r 3 ∧ C2 l) := by
  unfold C2; simp only [List.map_cons]; exact lcons _ _ _ _

lemma c3_cons (r : R) (l : List R) : C3 (r :: l) ↔ r 3 < r 4 ∨ (r 3 = r 4 ∧ C3 l) := by
  unfold C3; simp only [List.map_cons]; exact lcons _ _ _ _

lemma c_nil0 : C0 [] := by unfold C0; simp
lemma c_nil1 : C1 [] := by unfold C1; simp
lemma c_nil2 : C2 [] := by unfold C2; simp
lemma c_nil3 : C3 [] := by unfold C3; simp

def LL : ℕ → Finset (List R)
  | 0 => {[]}
  | n + 1 => ((Finset.univ : Finset R) ×ˢ LL n).image (fun p => p.1 :: p.2)

lemma mem_LL (n : ℕ) (l : List R) : l ∈ LL n ↔ l.length = n := by
  induction n generalizing l with
  | zero => simp [LL]
  | succ n ih =>
    cases l with
    | nil => simp [LL]
    | cons x m => simp [LL, ih]

lemma card_cons (n : ℕ) (Q : List R → Prop) [DecidablePred Q] :
    ((LL (n + 1)).filter Q).card = ∑ s : R, ((LL n).filter (fun m => Q (s :: m))).card := by
  rw [LL, Finset.filter_image, Finset.card_image_of_injective _ (by
    intro p q h; simp only [List.cons.injEq] at h; exact Prod.ext h.1 h.2)]
  rw [Finset.card_filter, Finset.sum_product]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [Finset.card_filter]

/-- The pending track comparisons. -/
def Q (b0 b1 b2 b3 : Bool) (l : List R) : Prop := Pall l ∧ (b0 = true → C0 l) ∧ (b1 = true → C1 l) ∧ (b2 = true → C2 l) ∧ (b3 = true → C3 l)

/-- Condition on the first letter. -/
def okT (b0 b1 b2 b3 : Bool) (r : R) : Prop := rowOK r ∧ (b0 = true → r 0 ≤ r 1) ∧ (b1 = true → r 1 ≤ r 2) ∧ (b2 = true → r 2 ≤ r 3) ∧ (b3 = true → r 3 ≤ r 4)

instance (b0 b1 b2 b3 : Bool) (r : R) : Decidable (okT b0 b1 b2 b3 r) := by
  unfold okT; infer_instance

noncomputable def f (b0 b1 b2 b3 : Bool) (n : ℕ) (r : R) : ℕ :=
  ((LL n).filter (fun l => Q b0 b1 b2 b3 (r :: l))).card

lemma a_succ (n : ℕ) : a (n + 1) = ∑ r : R, f true true true true n r := by
  have e : {l : List R // l.length = n + 1 ∧ IsSolution l} ≃
      {l // l ∈ (LL (n + 1)).filter (Q true true true true)} :=
    Equiv.subtypeEquivRight (fun l => by simp [mem_LL, Q, isSol_iff])
  rw [a, Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe, card_cons]
  rfl

lemma aux (b : Bool) (x y : Fin 2) (C : Prop) :
    (b = true → (x < y ∨ (x = y ∧ C))) ↔ (b = true → x ≤ y) ∧ ((b && decide (x = y)) = true → C) := by
  cases b
  · simp
  · simp only [true_imp_iff, Bool.true_and, decide_eq_true_eq]
    constructor
    · rintro (h | ⟨h, hc⟩)
      · exact ⟨h.le, fun he => absurd he h.ne⟩
      · exact ⟨h.le, fun _ => hc⟩
    · rintro ⟨h, hc⟩
      rcases lt_or_eq_of_le h with h' | h'
      · exact Or.inl h'
      · exact Or.inr ⟨h', hc h'⟩

lemma aux1 (b : Bool) (x y : Fin 2) (C : Prop) (hC : C) :
    (b = true → (x < y ∨ (x = y ∧ C))) ↔ (b = true → x ≤ y) := by
  rw [aux]; constructor
  · exact fun h => h.1
  · exact fun h => ⟨h, fun _ => hC⟩

lemma q_single (b0 b1 b2 b3 : Bool) (r : R) : Q b0 b1 b2 b3 [r] ↔ okT b0 b1 b2 b3 r := by
  unfold Q okT
  rw [pall_cons_nil, c0_cons, c1_cons, c2_cons, c3_cons]
  have h0 := c_nil0; have h1 := c_nil1; have h2 := c_nil2; have h3 := c_nil3
  simp only [aux1 _ _ _ _ h0, aux1 _ _ _ _ h1, aux1 _ _ _ _ h2, aux1 _ _ _ _ h3]

lemma q_cons (b0 b1 b2 b3 : Bool) (r s : R) (m : List R) :
    Q b0 b1 b2 b3 (r :: s :: m) ↔ (okT b0 b1 b2 b3 r ∧ adj r s) ∧ Q (b0 && decide (r 0 = r 1)) (b1 && decide (r 1 = r 2)) (b2 && decide (r 2 = r 3)) (b3 && decide (r 3 = r 4)) (s :: m) := by
  unfold Q okT
  rw [pall_cons_cons, c0_cons, c1_cons, c2_cons, c3_cons, aux, aux, aux, aux]
  tauto

lemma f_zero (b0 b1 b2 b3 : Bool) (r : R) :
    f b0 b1 b2 b3 0 r = if okT b0 b1 b2 b3 r then 1 else 0 := by
  unfold f; simp only [LL]; rw [Finset.filter_singleton]
  by_cases h : okT b0 b1 b2 b3 r
  · rw [if_pos ((q_single b0 b1 b2 b3 r).mpr h), if_pos h]; rfl
  · rw [if_neg (fun h' => h ((q_single b0 b1 b2 b3 r).mp h')), if_neg h]; rfl

lemma f_succ (b0 b1 b2 b3 : Bool) (n : ℕ) (r : R) :
    f b0 b1 b2 b3 (n + 1) r = ∑ s : R, if okT b0 b1 b2 b3 r ∧ adjE r s then
      f (b0 && decide (r 0 = r 1)) (b1 && decide (r 1 = r 2)) (b2 && decide (r 2 = r 3)) (b3 && decide (r 3 = r 4)) n s else 0 := by
  unfold f
  rw [card_cons]
  refine Finset.sum_congr rfl fun s _ => ?_
  simp only [q_cons, adj_iff]
  split_ifs with h
  · congr 1; ext m; simp [h]
  · simp only [Finset.card_eq_zero, Finset.filter_eq_empty_iff]; intro m _ hm; exact h hm.1

