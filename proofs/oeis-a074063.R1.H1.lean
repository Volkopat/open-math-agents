def factorialBound : ℕ := 

/-- Certificates only test coprimality with a fixed factorial, after handling smaller primes. -/
def primeCertificate (p : ℕ) : Prop :=
  2 ≤ p ∧ p ≤ 80089 ∧
    (if p ≤ 283 then p.Prime else p.gcd factorialBound = 1)

set_option maxRecDepth 10000 in
theorem factorial_eq : factorialBound = (283 : ℕ).factorial := by decide +kernel

theorem prime_of_certificate {p : ℕ} (h : primeCertificate p) : p.Prime := by
  rcases h with ⟨h2, hbound, h⟩
  by_cases hs : p ≤ 283
  · simpa only [if_pos hs] using h
  · rw [if_neg hs] at h
    have hlt : p.sqrt < 284 := Nat.sqrt_lt.mpr (by omega)
    have hroot : p.sqrt ≤ 283 := by omega
    refine Nat.prime_def_le_sqrt.mpr ⟨h2, fun d hd hds hdp => ?_⟩
    have hdF := Nat.dvd_factorial (show 0 < d by omega) (hds.trans hroot)
    rw [← factorial_eq] at hdF
    have hd1 := Nat.dvd_gcd hdp hdF
    rw [h] at hd1
    exact (by omega : d ≠ 1) (Nat.dvd_one.mp hd1)

def vertices : List ℕ → ℕ
  | [] => 0
  | a :: xs => 2 ^ a ||| vertices xs

theorem testBit_vertices (xs : List ℕ) (a : ℕ) :
    (vertices xs).testBit a = decide (a ∈ xs) := by
  induction xs with
  | nil => simp [vertices]
  | cons b xs ih =>
    simp [vertices, Nat.testBit_or, Nat.testBit_two_pow, ih, eq_comm]

