theorem primeMask_eq : vertices primeValues = primeMask := by decide +kernel

theorem prime_of_bit {p : ℕ} (h : primeMask.testBit p = true) : p.Prime := by
  rw [← primeMask_eq, testBit_vertices] at h
  exact prime_of_certificate (primeValuesChecked p (of_decide_eq_true h))

def adjacent (a b : ℕ) : Prop :=
  primeMask.testBit (a + 1 + (b + 1)) = true ∧
    primeMask.testBit ((a + 1) ^ 2 + (b + 1) ^ 2) = true

def valid (n : ℕ) (xs : List ℕ) : Prop :=
  xs.length = n ∧ vertices xs = 2 ^ n - 1 ∧ (∀ x ∈ xs, x < n) ∧
    xs.IsChain adjacent

theorem arrangement {n : ℕ} {xs : List ℕ} (h : valid n xs) :
    OMA.S_oeis_a074063.Exists n := by
  rcases h with ⟨hlen, hvertices, hbound, hchain⟩
  subst n
  let f (i : Fin xs.length) : Fin xs.length :=
    ⟨xs.get i, hbound _ (List.get_mem xs i)⟩
  have hsurj : Function.Surjective f := by
    intro j
    have hm : j.val ∈ xs := by
      have hbit := testBit_vertices xs j.val
      rw [hvertices, Nat.testBit_two_pow_sub_one, decide_eq_true j.isLt] at hbit
      exact of_decide_eq_true hbit.symm
    obtain ⟨i, hi⟩ := List.mem_iff_get.mp hm
    exact ⟨i, Fin.ext hi⟩
  refine ⟨Equiv.ofBijective f (Finite.surjective_iff_bijective.mp hsurj), ?_⟩
  intro i j hij
  have hj : i.val + 1 < xs.length := hij ▸ j.isLt
  have hc := List.isChain_iff_getElem.mp hchain i.val hj
  have heq : j = ⟨i.val + 1, hj⟩ := Fin.ext hij
  rw [heq]
  exact ⟨prime_of_bit hc.1, prime_of_bit hc.2⟩

