    (hu : ∀ n, u (n + 10) = 24 * u (n + 3) - 116 * u (n + 4) + 234 * u (n + 5) - 255 * u (n + 6) + 162 * u (n + 7) - 60 * u (n + 8) + 12 * u (n + 9))
    (hv : ∀ n, v (n + 10) = 24 * v (n + 3) - 116 * v (n + 4) + 234 * v (n + 5) - 255 * v (n + 6) + 162 * v (n + 7) - 60 * v (n + 8) + 12 * v (n + 9))
