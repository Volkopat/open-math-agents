    intro n
    induction n with
    | zero => exact ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩
    | succ n ih =>
      obtain ⟨a0, a1, a2, a3, a4, a5, a6, a7, a8, a9⟩ := ih
