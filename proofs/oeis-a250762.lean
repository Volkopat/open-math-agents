/-- The recurrence on every class. -/
theorem rec_class (m : ℕ) (p : Fin L) : (G (m + 3) p : ℤ) = 3 * (G (m + 2) p : ℤ) - 3 * (G (m + 1) p : ℤ) + (G (m + 0) p : ℤ) := by
  induction m generalizing p with
  | zero =>
    simp only [Nat.zero_add, G0, G1, G2, G3]
    revert p
    decide +kernel
  | succ m ih =>
    rw [show m + 1 + 3 = m + 3 + 1 by omega, show m + 1 + 2 = m + 2 + 1 by omega, show m + 1 + 1 = m + 1 + 1 by omega, show m + 1 + 0 = m + 0 + 1 by omega]
    rw [G_succ (m + 3) p, G_succ (m + 2) p, G_succ (m + 1) p, G_succ (m + 0) p]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    linear_combination ((Mf p q : ℕ) : ℤ) * ih q

lemma values : a 1 = 29012 ∧ a 2 = 67356 ∧ a 3 = 121593 ∧ a 4 = 191723 ∧ a 5 = 277746 := by
