    ROWS.getD (κ s) 0 := by
  have hs : s.val < 6561 := s.isLt
  have key : srch s = ROWS.getD (κ s) 0 := by
    have hc : (0 ≤ s.val ∧ s.val < 256) ∨ (256 ≤ s.val ∧ s.val < 512) ∨ (512 ≤ s.val ∧ s.val < 768) ∨ (768 ≤ s.val ∧ s.val < 1024) ∨ (1024 ≤ s.val ∧ s.val < 1280) ∨ (1280 ≤ s.val ∧ s.val < 1536) ∨ (1536 ≤ s.val ∧ s.val < 1792) ∨ (1792 ≤ s.val ∧ s.val < 2048) ∨ (2048 ≤ s.val ∧ s.val < 2304) ∨ (2304 ≤ s.val ∧ s.val < 2560) ∨ (2560 ≤ s.val ∧ s.val < 2816) ∨ (2816 ≤ s.val ∧ s.val < 3072) ∨ (3072 ≤ s.val ∧ s.val < 3328) ∨ (3328 ≤ s.val ∧ s.val < 3584) ∨ (3584 ≤ s.val ∧ s.val < 3840) ∨ (3840 ≤ s.val ∧ s.val < 4096) ∨ (4096 ≤ s.val ∧ s.val < 4352) ∨ (4352 ≤ s.val ∧ s.val < 4608) ∨ (4608 ≤ s.val ∧ s.val < 4864) ∨ (4864 ≤ s.val ∧ s.val < 5120) ∨ (5120 ≤ s.val ∧ s.val < 5376) ∨ (5376 ≤ s.val ∧ s.val < 5632) ∨ (5632 ≤ s.val ∧ s.val < 5888) ∨ (5888 ≤ s.val ∧ s.val < 6144) ∨ (6144 ≤ s.val ∧ s.val < 6400) ∨ (6400 ≤ s.val ∧ s.val < 6656) := by omega
    rcases hc with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7 | h8 | h9 | h10 | h11 | h12 | h13 | h14 | h15 | h16 | h17 | h18 | h19 | h20 | h21 | h22 | h23 | h24 | h25
    · have h := List.all_eq_true.mp check_0 s (List.mem_filter.mpr ⟨List.mem_finRange s, by simp [h0.1, h0.2]⟩)
