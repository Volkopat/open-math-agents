theorem recurrence (n : ℕ) (hn : 3 < n) : (a n : ℤ) = 3 * a (n - 1) - 3 * a (n - 2) + a (n - 3) := by
  obtain ⟨v1, v2, v3, v4, v5⟩ := values
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
  rw [show m + 3 - 1 = m + 2 by omega, show m + 3 - 2 = m + 1 by omega, show m + 3 - 3 = m + 0 by omega]
  simp only [a_G]
  have e : ∑ s : Fin K, (G (m + 3) (κ s) : ℤ) = ∑ s : Fin K, (3 * (G (m + 2) (κ s) : ℤ) - 3 * (G (m + 1) (κ s) : ℤ) + (G (m + 0) (κ s) : ℤ)) :=
    Finset.sum_congr rfl (fun s _ => rec_class m (κ s))
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_neg_distrib, ← Finset.mul_sum] at e
  push_cast
  linarith [e]

theorem gf : PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) * (1 - X) ^ 3 = X * (29012 - 19680 * X + 6561 * X ^ 2) := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) with hA
  have e1 : A * (1 - X) ^ 3 = A - C 3 * (A * X ^ 1) + C 3 * (A * X ^ 2) - C 1 * (A * X ^ 3) := by
    simp only [map_ofNat, map_one]; ring
  have e2 : (X * (29012 - 19680 * X + 6561 * X ^ 2) : ℚ⟦X⟧) = X ^ 1 * C 29012 - X ^ 2 * C 19680 + X ^ 3 * C 6561 := by
    simp only [map_ofNat, map_one]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℚ) else (a k : ℚ) := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, map_neg, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  obtain ⟨v1, v2, v3, v4, v5⟩ := values
  rcases Nat.lt_or_ge n 4 with hn | hn
  · interval_cases n <;> simp [v1, v2, v3, v4, v5] <;> norm_num
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 4 := ⟨n - 4, by omega⟩
    have h := recurrence (q + 4) (by omega)
    simp only [show q + 4 - 1 = q + 3 by omega, show q + 4 - 2 = q + 2 by omega, show q + 4 - 3 = q + 1 by omega] at h
    have h' : (a (q + 4) : ℚ) = 3 * a (q + 3) - 3 * a (q + 2) + a (q + 1) := by exact_mod_cast h
    simp only [show 1 ≤ q + 4 by omega, show q + 4 - 1 = q + 3 by omega, show 2 ≤ q + 4 by omega, show q + 4 - 2 = q + 2 by omega, show 3 ≤ q + 4 by omega, show q + 4 - 3 = q + 1 by omega, show ¬ q + 4 = 0 by omega, show ¬ q + 4 = 1 by omega, show ¬ q + 4 = 2 by omega, show ¬ q + 4 = 3 by omega, show ¬ q + 4 = 0 by omega, show ¬ q + 3 = 0 by omega, show ¬ q + 2 = 0 by omega, show ¬ q + 1 = 0 by omega, if_true, if_false]
    rw [h']
    ring

