lemma denominator_cover :
    (List.range 201).all (fun n =>
      decide (n < 3 ∨ n ∈ exceptions ∨ n ∈ denominators) ||
      largePrimes.any (fun p => decide (p.Prime ∧ 7 ≤ p ∧ p ∣ n))) = true := by
  decide

lemma denominator_mem {n : ℕ} (h3 : 3 ≤ n) (h200 : n ≤ 200)
    (hexc : n ∉ exceptions) (hsm : ∀ p : ℕ, p.Prime → p ∣ n → p ≤ 5) :
    n ∈ denominators := by
  have hc := List.all_eq_true.mp denominator_cover n (List.mem_range.mpr (by omega))
  simp only [Bool.or_eq_true, decide_eq_true_eq, List.any_eq_true] at hc
  rcases hc with (hsmall | hex | hgood) | ⟨p, _, hp⟩
  · omega
  · exact (hexc hex).elim
  · exact hgood
  · obtain ⟨hpp, h7, hdiv⟩ := hp
    have := hsm p hpp hdiv
    omega

lemma finite_relations {n : ℕ} {a : Fin 3 → ℕ}
    (hpos : ∀ i, 0 < a i) (hsum : ∑ i, a i = n)
    (hg : Nat.gcd (a 0) (Nat.gcd (a 1) (a 2)) = 1)
    (hcheck : checkDenominator n = true) :
    relations n a = trivial n a := by
  have h0 := hpos 0
  have hn : 0 < n := lt_trans h0 (entry_lt hpos hsum 0)
  apply le_antisymm
  · intro v hv
    let σ := Tuple.sort a
    have hxy : a (σ 0) ≤ a (σ 1) := Tuple.monotone_sort a (by decide)
    have hyz : a (σ 1) ≤ a (σ 2) := Tuple.monotone_sort a (by decide)
    have hs : a (σ 0) + a (σ 1) + a (σ 2) = n := by
      simpa only [Fin.sum_univ_three] using (Equiv.sum_comp σ a).trans hsum
    have hgp : Nat.gcd (a (σ 0)) (Nat.gcd (a (σ 1)) (a (σ 2))) = 1 :=
      (gcd_permute a σ).trans hg
    exact member_of_certificate σ (certificate n (a (σ 0)) (a (σ 1))).1
      (certificate n (a (σ 0)) (a (σ 1))).2
      ((relations_iff hn hpos hsum v).mp hv)
      (check_sound hcheck (hpos (σ 0)) hxy hyz hs hgp)
  · exact trivial_le hn hpos hsum

