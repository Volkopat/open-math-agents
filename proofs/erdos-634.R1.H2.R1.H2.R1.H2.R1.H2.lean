theorem OMA.solution : OMA.R_erdos_634_R1_H2_R1_H2_R1_H2_R1.H2 := by
  intro n a hpos hsum hg hsmooth
  by_cases hlarge : 200 < n
  · exact Or.inr (Or.inl hlarge)
  by_cases hexc : n = 3 ∨ n = 4 ∨ n = 6 ∨ n = 8 ∨ n = 10 ∨ n = 12 ∨
      n = 18 ∨ n = 24 ∨ n = 30 ∨ n = 60
  · exact Or.inr (Or.inr hexc)
  apply Or.inl
  change relations n a = trivial n a
  have h3 : 3 ≤ n := by
    have h0 := hpos 0
    have h1 := hpos 1
    have h2 := hpos 2
    rw [Fin.sum_univ_three] at hsum
    omega
  have hnotexc : n ∉ exceptions := by simpa [exceptions] using hexc
  have hmem := denominator_mem h3 (by omega) hnotexc hsmooth
  exact finite_relations hpos hsum hg (List.all_eq_true.mp all_checked n hmem)
