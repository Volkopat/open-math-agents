namespace OMA.E634Finite

/-- The integer coefficient obtained by multiplying a sawtooth value by 2n. -/
def coefficient (n k x : ℕ) : ℤ := 2 * ((k * x % n : ℕ) : ℤ) - n

def minor (n x y k : ℕ) : ℤ :=
  coefficient n 1 x * coefficient n k y - coefficient n 1 y * coefficient n k x

def determinant (n x y z k l : ℕ) : ℤ :=
  coefficient n 1 x * (coefficient n k y * coefficient n l z -
    coefficient n k z * coefficient n l y) -
  coefficient n 1 y * (coefficient n k x * coefficient n l z -
    coefficient n k z * coefficient n l x) +
  coefficient n 1 z * (coefficient n k x * coefficient n l y -
    coefficient n k y * coefficient n l x)

/-- Repeated entries and a half-denominator entry require a two-by-two minor.
The remaining case requires a three-by-three determinant. -/
def certificateValid (n x y z k l : ℕ) : Bool :=
  decide (k.Coprime n) &&
  if x = y then decide (minor n x z k ≠ 0)
  else if y = z ∨ 2 * z = n then decide (minor n x y k ≠ 0)
  else decide (l.Coprime n ∧ determinant n x y z k l ≠ 0)

/- Generated unit indices for sorted triples x ≤ y ≤ z with x + y + z = n.
The outer list is indexed by x - 1 and the inner list by y - x.
An entry encodes k + 256l. Every relevant decoded pair is checked below.
Separate declarations keep elaboration of the finite data within the memory budget. -/

