/-! Consecutive triples in a finite ordered set, in two disjoint-support families. -/

namespace OMA.Erdos1162AdjacentTriples

open Equiv Equiv.Perm

/-- Start every two vertices, moving the final triple left when necessary. -/
def start (n : ℕ) (i : Fin (n / 2)) : ℕ := min (2 * i.val) (n - 3)

def vertex {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) (k : Fin 3) : Fin n :=
  ⟨start n i + k.val, by
    have hs := Nat.min_le_right (2 * i.val) (n - 3)
    have hk := k.isLt
    change start n i + k.val < n
    unfold start
    omega⟩

theorem vertex_injective {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) :
    Function.Injective (vertex hn i) := by
  intro a b h
  apply Fin.ext
  exact Nat.add_left_cancel (congrArg Fin.val h)

/-- The three-cycle on the vertices of the indicated triple. -/
def cycle {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) : Equiv.Perm (Fin n) :=
  swap (vertex hn i 0) (vertex hn i 1) * swap (vertex hn i 1) (vertex hn i 2)

theorem cycle_support {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) :
    (cycle hn i).support = {vertex hn i 0, vertex hn i 1, vertex hn i 2} := by
  unfold cycle
  apply support_swap_mul_swap
  have h01 := (vertex_injective hn i).ne (show (0 : Fin 3) ≠ 1 by decide)
  have h02 := (vertex_injective hn i).ne (show (0 : Fin 3) ≠ 2 by decide)
  have h12 := (vertex_injective hn i).ne (show (1 : Fin 3) ≠ 2 by decide)
  simp [h01, h02, h12]

theorem cycle_isThreeCycle {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) :
    (cycle hn i).IsThreeCycle := by
  rw [← card_support_eq_three_iff, cycle_support]
  have h01 := (vertex_injective hn i).ne (show (0 : Fin 3) ≠ 1 by decide)
  have h02 := (vertex_injective hn i).ne (show (0 : Fin 3) ≠ 2 by decide)
  have h12 := (vertex_injective hn i).ne (show (1 : Fin 3) ≠ 2 by decide)
  simp [h01, h02, h12]

def cycleAlt {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) : alternatingGroup (Fin n) :=
  ⟨cycle hn i, mem_alternatingGroup.mpr (cycle_isThreeCycle hn i).sign⟩

@[simp] theorem coe_cycleAlt {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) :
    (cycleAlt hn i : Equiv.Perm (Fin n)) = cycle hn i := rfl

theorem mem_cycle_support_iff {n : ℕ} (hn : 3 ≤ n) (i : Fin (n / 2)) (x : Fin n) :
    x ∈ (cycle hn i).support ↔ start n i ≤ x.val ∧ x.val ≤ start n i + 2 := by
  rw [cycle_support]
  simp only [Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro (rfl | rfl | rfl) <;> simp [vertex]
  · intro h
    have hx : x.val = start n i ∨ x.val = start n i + 1 ∨ x.val = start n i + 2 := by omega
    rcases hx with h | h | h
    · exact Or.inl (Fin.ext (by simpa [vertex] using h))
    · exact Or.inr (Or.inl (Fin.ext h))
    · exact Or.inr (Or.inr (Fin.ext h))

private theorem start_gap {n : ℕ} {i j : Fin (n / 2)} (hij : i.val < j.val)
    (hpar : i.val % 2 = j.val % 2) : start n i + 2 < start n j := by
  have hj := j.isLt
  have hstep : 2 * i.val + 4 ≤ 2 * j.val := by omega
  have hbound : 2 * j.val + 2 ≤ n := by omega
  have hstart : start n i ≤ 2 * i.val := Nat.min_le_left _ _
  change start n i + 2 < min (2 * j.val) (n - 3)
  exact lt_min (by omega) (by omega)

theorem cycle_disjoint_of_same_parity {n : ℕ} (hn : 3 ≤ n) {i j : Fin (n / 2)}
    (hne : i ≠ j) (hpar : i.val % 2 = j.val % 2) :
    (cycle hn i).Disjoint (cycle hn j) := by
  apply disjoint_iff_disjoint_support.mpr
  refine Finset.disjoint_left.mpr fun x hxi hxj => ?_
  have hi := (mem_cycle_support_iff hn i x).mp hxi
  have hj := (mem_cycle_support_iff hn j x).mp hxj
  have hv : i.val ≠ j.val := fun h => hne (Fin.ext h)
  rcases lt_or_gt_of_ne hv with h | h
  · have := start_gap h hpar
    omega
  · have := start_gap h hpar.symm
    omega

theorem cycle_commute_of_same_parity {n : ℕ} (hn : 3 ≤ n) {i j : Fin (n / 2)}
    (hne : i ≠ j) (hpar : i.val % 2 = j.val % 2) :
    Commute (cycle hn i) (cycle hn j) :=
  (cycle_disjoint_of_same_parity hn hne hpar).commute

theorem exists_consecutive_mem_support {n : ℕ} (hn : 3 ≤ n) {x y : Fin n}
    (hxy : x.val + 1 = y.val) :
    ∃ i : Fin (n / 2), x ∈ (cycle hn i).support ∧ y ∈ (cycle hn i).support := by
  have hy := y.isLt
  let i : Fin (n / 2) := ⟨x.val / 2, by omega⟩
  have hi : i.val = x.val / 2 := rfl
  have hleft : start n i ≤ 2 * i.val := Nat.min_le_left _ _
  have hright : y.val ≤ start n i + 2 := by
    unfold start
    omega
  refine ⟨i, (mem_cycle_support_iff hn i x).mpr ⟨?_, ?_⟩,
    (mem_cycle_support_iff hn i y).mpr ⟨?_, hright⟩⟩ <;> omega

end OMA.Erdos1162AdjacentTriples

/-! A transitive group generated by three-cycles is the alternating group. -/

namespace OMA.Erdos1162SolvableGeneration

open Equiv MulAction
open scoped Pointwise

private theorem threeCycle_fixes_nonsingleton_block {α : Type*} [Fintype α] [DecidableEq α]
    {G : Subgroup (Perm α)} {B : Set α} (hB : IsBlock G B) (hsize : B.Nontrivial)
    (g : G) (hg : (g : Perm α).IsThreeCycle) : g • B = B := by
  by_contra hne
  have hdisj := Set.disjoint_left.mp (hB.disjoint_smul_of_ne hne)
  have hnot {x : α} (hx : x ∈ B) : (g : Perm α) x ∉ B := fun hm =>
    hdisj (Set.smul_mem_smul_set hx) hm
  have hmoved {x : α} (hx : x ∈ B) : x ∈ (g : Perm α).support :=
    Perm.mem_support.mpr fun he => hnot hx (he.symm ▸ hx : (g : Perm α) x ∈ B)
  obtain ⟨a, ha, b, hb, hab⟩ := hsize
  have hga_ne_a : (g : Perm α) a ≠ a := Perm.mem_support.mp (hmoved ha)
  have hgb_ne_b : (g : Perm α) b ≠ b := Perm.mem_support.mp (hmoved hb)
  have hga_ne_b : (g : Perm α) a ≠ b := fun he => hnot ha (he.symm ▸ hb)
  have hgb_ne_a : (g : Perm α) b ≠ a := fun he => hnot hb (he.symm ▸ ha)
  have hga_ne_gb : (g : Perm α) a ≠ (g : Perm α) b := fun he =>
    hab ((g : Perm α).injective he)
  have hsubset : ({a, b, (g : Perm α) a, (g : Perm α) b} : Finset α) ⊆
      (g : Perm α).support := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hmoved ha
    · exact hmoved hb
    · exact Perm.apply_mem_support.mpr (hmoved ha)
    · exact Perm.apply_mem_support.mpr (hmoved hb)
  have hcard : ({a, b, (g : Perm α) a, (g : Perm α) b} : Finset α).card = 4 := by
    simp [Finset.card_insert_of_notMem, hab, hga_ne_a.symm, hga_ne_b.symm,
      hgb_ne_a.symm, hgb_ne_b.symm, hga_ne_gb]
  have hbound := Finset.card_le_card hsubset
  have hthree := hg.card_support
  omega

/-- The Jordan theorem applies to a transitive group generated by three-cycles. -/
theorem closure_threeCycles_eq_alternating {α : Type*} [Fintype α] [DecidableEq α]
    (cycles : Set (Perm α)) (hcycles : ∀ g ∈ cycles, g.IsThreeCycle)
    (hne : cycles.Nonempty) (htrans : IsPretransitive (Subgroup.closure cycles) α) :
    Subgroup.closure cycles = alternatingGroup α := by
  let G := Subgroup.closure cycles
  have hprimitive : IsPreprimitive G α := by
    refine { exists_smul_eq := htrans.exists_smul_eq, isTrivialBlock_of_isBlock := ?_ }
    intro B hB
    by_cases hs : B.Subsingleton
    · exact Or.inl hs
    right
    have hn := Set.not_subsingleton_iff.mp hs
    have hle : G ≤ stabilizer (Perm α) B := by
      change Subgroup.closure cycles ≤ _
      rw [Subgroup.closure_le]
      intro g hg
      let g' : G := ⟨g, Subgroup.subset_closure hg⟩
      exact mem_stabilizer_iff.mpr
        (threeCycle_fixes_nonsingleton_block hB hn g' (hcycles g hg))
    obtain ⟨a, ha⟩ := hn.nonempty
    apply Set.eq_univ_of_forall
    intro b
    obtain ⟨g, hg⟩ := htrans.exists_smul_eq a b
    have hfix : g • B = B := mem_stabilizer_iff.mp (hle g.property)
    have hb : g • a ∈ g • B := Set.smul_mem_smul_set ha
    rwa [hg, hfix] at hb
  obtain ⟨g, hg⟩ := hne
  apply le_antisymm
  · rw [Subgroup.closure_le]
    exact fun t ht => (hcycles t ht).mem_alternatingGroup
  · exact Perm.alternatingGroup_le_of_isPreprimitive_of_isThreeCycle_mem hprimitive
      (hcycles g hg) (Subgroup.subset_closure hg)

private theorem closure_isPGroup_three {G : Type*} [Group G] (s : Set G)
    (hcomm : ∀ x ∈ s, ∀ y ∈ s, Commute x y) (hcube : ∀ x ∈ s, x ^ 3 = 1) :
    IsPGroup 3 (Subgroup.closure s) := by
  let _ : IsMulCommutative (Subgroup.closure s) := Subgroup.isMulCommutative_closure hcomm
  have hpow {x : G} (hx : x ∈ Subgroup.closure s) : x ^ 3 = 1 := by
    refine Subgroup.closure_induction (p := fun a _ => a ^ 3 = 1) hcube (one_pow 3)
      ?_ ?_ hx
    · intro a b ha hb ha3 hb3
      have hab : Commute a b := setLike_mul_comm ha hb
      rw [hab.mul_pow, ha3, hb3, one_mul]
    · intro a _ ha3
      rw [inv_pow, ha3, inv_one]
  intro x
  refine ⟨1, ?_⟩
  apply Subtype.ext
  simpa only [pow_one, Subgroup.coe_pow, Subgroup.coe_one] using hpow x.property

/-- Generating by two pairwise commuting sets of elements of order dividing three
gives generation by two conjugate Sylow three-subgroups. -/
theorem sylow_three_pair_of_two_commuting_sets {G : Type*} [Group G] [Finite G]
    (s t : Set G) (hs : ∀ x ∈ s, ∀ y ∈ s, Commute x y)
    (ht : ∀ x ∈ t, ∀ y ∈ t, Commute x y)
    (hpow : ∀ x ∈ s ∪ t, x ^ 3 = 1)
    (hgen : Subgroup.closure (s ∪ t) = ⊤) :
    ∃ (P : Sylow 3 G) (x : G),
      (P : Subgroup G) ⊔ (P : Subgroup G).map (MulAut.conj x).toMonoidHom = ⊤ := by
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  obtain ⟨P, hP⟩ := (closure_isPGroup_three s hs fun x hx => hpow x (Or.inl hx)).exists_le_sylow
  obtain ⟨Q, hQ⟩ := (closure_isPGroup_three t ht fun x hx => hpow x (Or.inr hx)).exists_le_sylow
  obtain ⟨g, hg⟩ := exists_smul_eq G P Q
  have hPQ : (P : Subgroup G) ⊔ (Q : Subgroup G) = ⊤ := by
    apply top_le_iff.mp
    rw [← hgen, Subgroup.closure_le]
    rintro a (ha | ha)
    · exact (show (P : Subgroup G) ≤ (P : Subgroup G) ⊔ (Q : Subgroup G) from
        le_sup_left) (hP (Subgroup.subset_closure ha))
    · exact (show (Q : Subgroup G) ≤ (P : Subgroup G) ⊔ (Q : Subgroup G) from
        le_sup_right) (hQ (Subgroup.subset_closure ha))
  refine ⟨P, g, ?_⟩
  rw [← hg, Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at hPQ
  exact hPQ

end OMA.Erdos1162SolvableGeneration

/-! Generation of each alternating group of degree at least three by conjugate Sylow subgroups. -/

namespace OMA.Erdos1162SolvableGeneration

open Equiv MulAction
open OMA.Erdos1162AdjacentTriples

private theorem adjacent_cycles_are_transitive (n : ℕ) (hn : 3 ≤ n) :
    IsPretransitive (Subgroup.closure (Set.range (cycle hn))) (Fin n) := by
  let G := Subgroup.closure (Set.range (cycle hn))
  let origin : Fin n := ⟨0, by omega⟩
  have move {a b : Fin n} (hab : a.val + 1 = b.val) : ∃ g : G, g • a = b := by
    obtain ⟨i, ha, hb⟩ := exists_consecutive_mem_support hn hab
    have hi : cycle hn i ∈ G := Subgroup.subset_closure ⟨i, rfl⟩
    obtain ⟨k, hk⟩ := (cycle_isThreeCycle hn i).isCycle.exists_pow_eq
      (Perm.mem_support.mp ha) (Perm.mem_support.mp hb)
    exact ⟨⟨(cycle hn i) ^ k, G.pow_mem hi k⟩, hk⟩
  have reach (k : ℕ) (hk : k < n) : ∃ g : G, g • origin = (⟨k, hk⟩ : Fin n) := by
    induction k with
    | zero => exact ⟨1, one_smul G origin⟩
    | succ k ih =>
        have hk' : k < n := by omega
        obtain ⟨g, hg⟩ := ih hk'
        obtain ⟨h, hh⟩ := move (a := ⟨k, hk'⟩) (b := ⟨k + 1, hk⟩) rfl
        exact ⟨h * g, by rw [mul_smul, hg, hh]⟩
  constructor
  intro a b
  obtain ⟨g, hg⟩ := reach a.val a.isLt
  obtain ⟨h, hh⟩ := reach b.val b.isLt
  refine ⟨h * g⁻¹, ?_⟩
  change g • origin = a at hg
  change h • origin = b at hh
  rw [mul_smul, ← hg, inv_smul_smul, hh]

/-- The two parity classes of adjacent three-cycles extend to a Sylow generating pair. -/
theorem alternating_sylow_three_pair (n : ℕ) (hn : 3 ≤ n) :
    ∃ (P : Sylow 3 (alternatingGroup (Fin n))) (x : alternatingGroup (Fin n)),
      (P : Subgroup (alternatingGroup (Fin n))) ⊔
        (P : Subgroup (alternatingGroup (Fin n))).map (MulAut.conj x).toMonoidHom = ⊤ := by
  let A := alternatingGroup (Fin n)
  let C (k : ℕ) : Set A := {g | ∃ i : Fin (n / 2), i.val % 2 = k ∧ cycleAlt hn i = g}
  have hcomm (k : ℕ) : ∀ a ∈ C k, ∀ b ∈ C k, Commute a b := by
    rintro _ ⟨i, hi, rfl⟩ _ ⟨j, hj, rfl⟩
    by_cases h : i = j
    · subst j
      exact Commute.refl _
    change cycleAlt hn i * cycleAlt hn j = cycleAlt hn j * cycleAlt hn i
    exact Subtype.ext (cycle_commute_of_same_parity hn h (hi.trans hj.symm)).eq
  have hcube (i : Fin (n / 2)) : cycleAlt hn i ^ 3 = 1 := by
    apply Subtype.ext
    change cycle hn i ^ 3 = 1
    rw [← (cycle_isThreeCycle hn i).orderOf, pow_orderOf_eq_one]
  have hpow : ∀ x ∈ C 0 ∪ C 1, x ^ 3 = 1 := by
    rintro _ (⟨i, _, rfl⟩ | ⟨i, _, rfl⟩) <;> exact hcube i
  have hu : C 0 ∪ C 1 = Set.range (cycleAlt hn) := by
    ext x
    constructor
    · rintro (⟨i, _, rfl⟩ | ⟨i, _, rfl⟩) <;> exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      by_cases hi : i.val % 2 = 0
      · exact Or.inl ⟨i, hi, rfl⟩
      · exact Or.inr ⟨i, by omega, rfl⟩
  have hmap : A.subtype '' (C 0 ∪ C 1) = Set.range (cycle hn) := by
    rw [hu, ← Set.range_comp]
    rfl
  have hcycles : ∀ g ∈ Set.range (cycle hn), g.IsThreeCycle := by
    rintro _ ⟨i, rfl⟩
    exact cycle_isThreeCycle hn i
  let i : Fin (n / 2) := ⟨0, by omega⟩
  have hnonempty : (Set.range (cycle hn)).Nonempty := ⟨cycle hn i, i, rfl⟩
  have hclosure := closure_threeCycles_eq_alternating (Set.range (cycle hn)) hcycles
    hnonempty (adjacent_cycles_are_transitive n hn)
  have hgen : Subgroup.closure (C 0 ∪ C 1) = ⊤ := by
    apply Subgroup.map_injective A.subtype_injective
    rw [MonoidHom.map_closure, hmap, hclosure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  exact sylow_three_pair_of_two_commuting_sets (C 0) (C 1) (hcomm 0) (hcomm 1) hpow hgen

end OMA.Erdos1162SolvableGeneration

/-- The even and odd adjacent three-cycle families give the two Sylow factors. -/
theorem OMA.solution : OMA.R_Erdos1162_erdos_1162_variants_roney_dougal_tracey_R1_H2_R2_H2_R1_H2_R1_H1_R1.H1 := by
  exact OMA.Erdos1162SolvableGeneration.alternating_sylow_three_pair
