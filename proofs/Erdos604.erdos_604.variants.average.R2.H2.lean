-- Proof of Székely's circle-incidence pinned distance bound via discrete wiring diagrams and crossing number inequality.

namespace OMA.SzekelyWiring

noncomputable section

open Finset
open scoped BigOperators Classical

/-! ### Part 1: Discrete Wiring Diagrams, Combinatorial Euler Bound, and Crossing Number Inequality -/

abbrev DirEdge (n : ℕ) := Fin n × Fin n

inductive WStep (n : ℕ) where
  | vertex (v : Fin n)
  | swap (e₁ e₂ : DirEdge n)
  | noop
  deriving DecidableEq

/-- A discrete x-monotone wiring diagram on `n` vertices for a simple directed edge set `E`
(with `e.1 < e.2` for all `e ∈ E`). -/
structure WiringDiagram (n : ℕ) (E : Finset (DirEdge n)) where
  L : ℕ
  state : Fin (L + 1) → List (DirEdge n)
  step : Fin L → WStep n
  hE : ∀ e ∈ E, e.1 < e.2
  hstart : state 0 = []
  hend : state ⟨L, Nat.lt_succ_self L⟩ = []
  hnodup : ∀ s, (state s).Nodup
  hmemE : ∀ s, ∀ e ∈ state s, e ∈ E
  hvert_pos : Fin n → Fin L
  hvert_mono : StrictMono hvert_pos
  hvert_step : ∀ v, step (hvert_pos v) = WStep.vertex v
  hvert_only : ∀ t v, step t = WStep.vertex v → t = hvert_pos v
  hstep_valid : ∀ t : Fin L, match step t with
    | WStep.noop => state t.succ = state t.castSucc
    | WStep.swap e₁ e₂ =>
        ∃ pre post : List (DirEdge n),
          state t.castSucc = pre ++ [e₁, e₂] ++ post ∧
          state t.succ = pre ++ [e₂, e₁] ++ post
    | WStep.vertex v =>
        ∃ pre Lv Rv post : List (DirEdge n),
          state t.castSucc = pre ++ Lv ++ post ∧
          state t.succ = pre ++ Rv ++ post ∧
          (∀ e ∈ Lv, e.2 = v) ∧
          (∀ e ∈ Rv, e.1 = v) ∧
          (∀ e ∈ pre, e.1 ≠ v ∧ e.2 ≠ v) ∧
          (∀ e ∈ post, e.1 ≠ v ∧ e.2 ≠ v)
  hactive_iff : ∀ s : Fin (L + 1), ∀ e ∈ E,
    e ∈ state s ↔ (hvert_pos e.1).val < s.val ∧ s.val ≤ (hvert_pos e.2).val

namespace WiringDiagram

variable {n : ℕ} {E : Finset (DirEdge n)} (D : WiringDiagram n E)

def isSwap (t : Fin D.L) : Bool :=
  match D.step t with
  | WStep.swap _ _ => true
  | _ => false

def numSwaps : ℕ := (univ.filter fun t : Fin D.L => D.isSwap t = true).card

private lemma list_map_eq_self {α : Type*} {f : α → α} {l : List α} (h : ∀ a ∈ l, f a = a) :
    l.map f = l := by
  induction l with
  | nil => rfl
  | cons x xs ih => simp [h x (by simp), ih (fun a ha => h a (by simp [ha]))]

private lemma card_filter_lt_of_imp {α : Type*} [Fintype α] (P Q : α → Bool)
    (himp : ∀ x, P x = true → Q x = true)
    (hex : ∃ x, Q x = true ∧ P x ≠ true) :
    (univ.filter fun x => P x = true).card < (univ.filter fun x => Q x = true).card := by
  apply Finset.card_lt_card
  rw [Finset.ssubset_iff_subset_ne]
  refine ⟨fun x hx => mem_filter.mpr ⟨mem_univ x, himp x (mem_filter.mp hx).2⟩, fun heq => ?_⟩
  obtain ⟨x, hqx, hnpx⟩ := hex
  have hmem : x ∈ univ.filter (fun x => Q x = true) := mem_filter.mpr ⟨mem_univ x, hqx⟩
  rw [← heq] at hmem
  exact hnpx (mem_filter.mp hmem).2

/-- Every finite graph (vertex set `V`, edge list `edges`) has at least `|V| - |edges|` components
under the equivalence relation generated by `edges`. -/
private lemma card_quot_ge_sub {V : Type*} [Fintype V] [DecidableEq V]
    (edges : List (V × V)) :
    Fintype.card V ≤
      Fintype.card (Quotient (Relation.EqvGen.setoid (fun a b : V => (a, b) ∈ edges))) + edges.length := by
  induction edges with
  | nil =>
    let s0 := Relation.EqvGen.setoid (fun a b : V => (a, b) ∈ ([] : List (V × V)))
    have hbij : Fintype.card (Quotient s0) = Fintype.card V := by
      apply Fintype.card_congr
      refine Equiv.ofBijective (Quotient.lift id (fun a b h => by
        induction h with
        | rel _ _ h => simp at h
        | refl _ => rfl
        | symm _ _ _ ih => exact ih.symm
        | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2)) ⟨?_, ?_⟩
      · intro x y h
        induction x using Quotient.ind with | _ a =>
        induction y using Quotient.ind with | _ b =>
        exact congrArg (Quotient.mk s0) h
      · intro a; exact ⟨Quotient.mk s0 a, rfl⟩
    rw [List.length_nil, add_zero]; exact le_of_eq hbij.symm
  | cons p es ih =>
    rcases p with ⟨u, w⟩
    let s₁ := Relation.EqvGen.setoid (fun a b : V => (a, b) ∈ es)
    let s₂ := Relation.EqvGen.setoid (fun a b : V => (a, b) ∈ ((u, w) :: es))
    let f : Quotient s₁ → Quotient s₂ :=
      Quotient.lift (Quotient.mk s₂) (fun a b h => by
        apply Quotient.sound
        induction h with
        | rel x y hxy => exact Relation.EqvGen.rel x y (List.mem_cons_of_mem _ hxy)
        | refl x => exact Relation.EqvGen.refl x
        | symm x y _ ih' => exact Relation.EqvGen.symm x y ih'
        | trans x y z _ _ ih1 ih2 => exact Relation.EqvGen.trans x y z ih1 ih2)
    let u₁ : Quotient s₁ := Quotient.mk s₁ u
    let w₁ : Quotient s₁ := Quotient.mk s₁ w
    have hstep : Fintype.card (Quotient s₁) ≤ Fintype.card (Quotient s₂) + 1 := by
      let g : Quotient s₂ → Quotient s₁ :=
        Quotient.lift (fun a => if Quotient.mk s₁ a = w₁ then u₁ else Quotient.mk s₁ a)
          (fun a b hab => by
            induction hab with
            | rel x y hxy =>
              rcases List.mem_cons.mp hxy with h | h
              · cases h; simp [u₁, w₁]
              · have heq : Quotient.mk s₁ x = Quotient.mk s₁ y := Quotient.sound (Relation.EqvGen.rel x y h)
                simp [heq]
            | refl _ => rfl
            | symm _ _ _ ih' => exact ih'.symm
            | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2)
      have hfg : ∀ z : Quotient s₁, z ≠ w₁ → g (f z) = z := fun z hz => by
        induction z using Quotient.ind with | _ a =>
        dsimp [f, g]; simp [hz]
      have hcard_le : (univ.erase w₁ : Finset (Quotient s₁)).card ≤ (univ : Finset (Quotient s₂)).card := by
        apply card_le_card_of_injOn f (fun _ _ => mem_coe.mpr (mem_univ _))
        intro x hx y hy hxy
        have hx' : x ≠ w₁ := (mem_erase.mp (mem_coe.mp hx)).1
        have hy' : y ≠ w₁ := (mem_erase.mp (mem_coe.mp hy)).1
        calc x = g (f x) := (hfg x hx').symm
          _ = g (f y) := congrArg g hxy
          _ = y := hfg y hy'
      rw [card_erase_of_mem (mem_univ w₁), card_univ, card_univ] at hcard_le
      have hpos : 0 < Fintype.card (Quotient s₁) := Fintype.card_pos_iff.mpr ⟨w₁⟩
      omega
    simp only [List.length_cons]
    change Fintype.card (Quotient s₁) ≤ Fintype.card (Quotient s₂) + 1 at hstep
    change Fintype.card V ≤ Fintype.card (Quotient s₁) + es.length at ih
    change Fintype.card V ≤ Fintype.card (Quotient s₂) + (es.length + 1)
    omega

/-- Helper: extract the vertex-step decomposition for `D.step t = WStep.vertex v`. -/
private lemma vertex_decomp (t : Fin D.L) (v : Fin n) (hv : D.step t = WStep.vertex v) :
    ∃ pre Lv Rv post : List (DirEdge n),
      D.state t.castSucc = pre ++ Lv ++ post ∧
      D.state t.succ = pre ++ Rv ++ post ∧
      (∀ e ∈ Lv, e.2 = v) ∧
      (∀ e ∈ Rv, e.1 = v) ∧
      (∀ e ∈ pre, e.1 ≠ v ∧ e.2 ≠ v) ∧
      (∀ e ∈ post, e.1 ≠ v ∧ e.2 ≠ v) := by
  have h := D.hstep_valid t
  rw [hv] at h
  exact h

/-- Gap vertices in a diagram: pairs `(s, g)` with `g ≤ (D.state s).length`. -/
abbrev Gap := {p : Fin (D.L + 1) × ℕ // p.2 ≤ (D.state p.1).length}

private def gapFinset : Finset (Fin (D.L + 1) × ℕ) :=
  (univ : Finset (Fin (D.L + 1))).biUnion fun s =>
    (Finset.range ((D.state s).length + 1)).map
      ⟨fun g => (s, g), fun _ _ h => congrArg Prod.snd h⟩

private lemma mem_gapFinset (p : Fin (D.L + 1) × ℕ) :
    p ∈ D.gapFinset ↔ p.2 ≤ (D.state p.1).length := by
  rcases p with ⟨s, g⟩
  simp only [gapFinset, mem_biUnion, mem_univ, true_and, mem_map, mem_range, Function.Embedding.coeFn_mk]
  constructor
  · rintro ⟨s', g', hg', heq⟩
    have hs : s' = s := congrArg Prod.fst heq
    have hg : g' = g := congrArg Prod.snd heq
    subst hs; subst hg; omega
  · intro hle
    exact ⟨s, g, by omega, rfl⟩

instance : Fintype D.Gap := Fintype.ofFinset D.gapFinset D.mem_gapFinset

private lemma card_gap : Fintype.card D.Gap = 1 + ∑ t : Fin D.L, ((D.state t.succ).length + 1) := by
  have h1 : Fintype.card D.Gap = ∑ s : Fin (D.L + 1), ((D.state s).length + 1) := by
    have hcard_eq : Fintype.card D.Gap = D.gapFinset.card := by
      rw [← Fintype.card_coe]
      exact Fintype.card_congr (Equiv.subtypeEquivRight (fun p => (D.mem_gapFinset p).symm))
    rw [hcard_eq]
    dsimp only [gapFinset]
    rw [Finset.card_biUnion]
    · apply sum_congr rfl; intro s _; simp
    · intro s₁ _ s₂ _ hne; dsimp only [Function.onFun]; rw [Finset.disjoint_left]; intro p h1 h2
      simp only [mem_map, mem_range, Function.Embedding.coeFn_mk] at h1 h2
      obtain ⟨g₁, _, rfl⟩ := h1; obtain ⟨g₂, _, h2⟩ := h2
      exact hne (congrArg Prod.fst h2).symm
  rw [h1, Fin.sum_univ_succ, D.hstart]; simp

/-- Unpack chosen decomposition for a vertex step. -/
private def vPre (t : Fin D.L) (v : Fin n) (hv : D.step t = WStep.vertex v) : List (DirEdge n) :=
  Classical.choose (D.vertex_decomp t v hv)

private def vLv (t : Fin D.L) (v : Fin n) (hv : D.step t = WStep.vertex v) : List (DirEdge n) :=
  Classical.choose (Classical.choose_spec (D.vertex_decomp t v hv))

private def vRv (t : Fin D.L) (v : Fin n) (hv : D.step t = WStep.vertex v) : List (DirEdge n) :=
  Classical.choose (Classical.choose_spec (Classical.choose_spec (D.vertex_decomp t v hv)))

private def vPost (t : Fin D.L) (v : Fin n) (hv : D.step t = WStep.vertex v) : List (DirEdge n) :=
  Classical.choose (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (D.vertex_decomp t v hv))))

private lemma vSpec (t : Fin D.L) (v : Fin n) (hv : D.step t = WStep.vertex v) :
    D.state t.castSucc = D.vPre t v hv ++ D.vLv t v hv ++ D.vPost t v hv ∧
    D.state t.succ = D.vPre t v hv ++ D.vRv t v hv ++ D.vPost t v hv ∧
    (∀ e ∈ D.vLv t v hv, e.2 = v) ∧
    (∀ e ∈ D.vRv t v hv, e.1 = v) ∧
    (∀ e ∈ D.vPre t v hv, e.1 ≠ v ∧ e.2 ≠ v) ∧
    (∀ e ∈ D.vPost t v hv, e.1 ≠ v ∧ e.2 ≠ v) :=
  Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (D.vertex_decomp t v hv))))

/-- Gap edges for step `t` when `D` has no swaps. -/
private def gapStepEdges (hnoswap : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t ≠ WStep.swap e₁ e₂)
    (t : Fin D.L) : List (D.Gap × D.Gap) :=
  match hst : D.step t with
  | WStep.noop =>
    have heq : D.state t.succ = D.state t.castSucc := by
      have h := D.hstep_valid t; rwa [hst] at h
    (List.finRange ((D.state t.castSucc).length + 1)).map fun g =>
      (⟨(t.castSucc, g.val), by (try dsimp); omega⟩, ⟨(t.succ, g.val), by dsimp; rw [heq]; omega⟩)
  | WStep.swap e₁ e₂ => absurd hst (hnoswap t e₁ e₂)
  | WStep.vertex v =>
    have hsp := D.vSpec t v hst
    let a := (D.vPre t v hst).length
    let dl := (D.vLv t v hst).length
    let dr := (D.vRv t v hst).length
    let b := (D.vPost t v hst).length
    have hlenL : (D.state t.castSucc).length = a + dl + b := by
      dsimp only [a, dl, b]; rw [hsp.1, List.length_append, List.length_append]
    have hlenR : (D.state t.succ).length = a + dr + b := by
      dsimp only [a, dr, b]; rw [hsp.2.1, List.length_append, List.length_append]
    let belowEdges : List (D.Gap × D.Gap) :=
      (List.finRange a).map fun i =>
        (⟨(t.castSucc, i.val), by (try dsimp); omega⟩, ⟨(t.succ, i.val), by (try dsimp); omega⟩)
    let aboveEdges : List (D.Gap × D.Gap) :=
      (List.finRange b).map fun i =>
        (⟨(t.castSucc, a + dl + 1 + i.val), by (try dsimp); omega⟩,
         ⟨(t.succ, a + dr + 1 + i.val), by (try dsimp); omega⟩)
    let midEdges : List (D.Gap × D.Gap) :=
      if dl = 0 ∧ dr = 0 then
        [(⟨(t.castSucc, a), by (try dsimp); omega⟩, ⟨(t.succ, a), by (try dsimp); omega⟩)]
      else
        [(⟨(t.castSucc, a), by (try dsimp); omega⟩, ⟨(t.succ, a), by (try dsimp); omega⟩),
         (⟨(t.castSucc, a + dl), by (try dsimp); omega⟩, ⟨(t.succ, a + dr), by (try dsimp); omega⟩)]
    belowEdges ++ midEdges ++ aboveEdges

private lemma gapStepEdges_noop (hnoswap : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t ≠ WStep.swap e₁ e₂)
    (t : Fin D.L) (hst : D.step t = WStep.noop) :
    D.gapStepEdges hnoswap t =
      (List.finRange ((D.state t.castSucc).length + 1)).map fun g =>
        (⟨(t.castSucc, g.val), by (try dsimp); omega⟩,
         ⟨(t.succ, g.val), by
            have heq : D.state t.succ = D.state t.castSucc := by have h := D.hstep_valid t; rwa [hst] at h
            dsimp; rw [heq]; omega⟩) := by
  unfold gapStepEdges
  split
  · rfl
  · rename_i e₁ e₂ h; rw [hst] at h; cases h
  · rename_i v h; rw [hst] at h; cases h

private lemma gapStepEdges_vertex (hnoswap : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t ≠ WStep.swap e₁ e₂)
    (t : Fin D.L) (v : Fin n) (hst : D.step t = WStep.vertex v) :
    D.gapStepEdges hnoswap t =
      let a := (D.vPre t v hst).length
      let dl := (D.vLv t v hst).length
      let dr := (D.vRv t v hst).length
      let b := (D.vPost t v hst).length
      have hsp := D.vSpec t v hst
      have hlenL : (D.state t.castSucc).length = a + dl + b := by
        dsimp only [a, dl, b]; rw [hsp.1, List.length_append, List.length_append]
      have hlenR : (D.state t.succ).length = a + dr + b := by
        dsimp only [a, dr, b]; rw [hsp.2.1, List.length_append, List.length_append]
      let belowEdges : List (D.Gap × D.Gap) :=
        (List.finRange a).map fun i =>
          (⟨(t.castSucc, i.val), by (try dsimp); omega⟩, ⟨(t.succ, i.val), by (try dsimp); omega⟩)
      let aboveEdges : List (D.Gap × D.Gap) :=
        (List.finRange b).map fun i =>
          (⟨(t.castSucc, a + dl + 1 + i.val), by (try dsimp); omega⟩,
           ⟨(t.succ, a + dr + 1 + i.val), by (try dsimp); omega⟩)
      let midEdges : List (D.Gap × D.Gap) :=
        if dl = 0 ∧ dr = 0 then
          [(⟨(t.castSucc, a), by (try dsimp); omega⟩, ⟨(t.succ, a), by (try dsimp); omega⟩)]
        else
          [(⟨(t.castSucc, a), by (try dsimp); omega⟩, ⟨(t.succ, a), by (try dsimp); omega⟩),
           (⟨(t.castSucc, a + dl), by (try dsimp); omega⟩, ⟨(t.succ, a + dr), by (try dsimp); omega⟩)]
      belowEdges ++ midEdges ++ aboveEdges := by
  unfold gapStepEdges
  split
  · rename_i h; rw [hst] at h; cases h
  · rename_i e₁ e₂ h; rw [hst] at h; cases h
  · rename_i v' hv'
    have hvv' : v' = v := by rw [hst] at hv'; cases hv'; rfl
    subst hvv'; rfl

private lemma gapStepEdges_length (hnoswap : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t ≠ WStep.swap e₁ e₂)
    (S : Finset (Fin n)) (hS : ∀ e ∈ E, e.1 ∈ S ∧ e.2 ∈ S) (t : Fin D.L) :
    (D.gapStepEdges hnoswap t).length +
      (match D.step t with | WStep.vertex v => (E.filter fun e => e.1 = v).card | _ => 0) ≤
    ((D.state t.succ).length + 1) +
      (match D.step t with | WStep.vertex v => if v ∈ S then 1 else 0 | _ => 0) := by
  cases hst : D.step t with
  | noop =>
    have heq : D.state t.succ = D.state t.castSucc := by
      have h := D.hstep_valid t; rwa [hst] at h
    rw [D.gapStepEdges_noop hnoswap t hst]; simp [heq]
  | swap e₁ e₂ => exact absurd hst (hnoswap t e₁ e₂)
  | vertex v =>
    have hsp := D.vSpec t v hst
    have hlenR : (D.state t.succ).length =
        (D.vPre t v hst).length + (D.vRv t v hst).length + (D.vPost t v hst).length := by
      rw [hsp.2.1, List.length_append, List.length_append]
    have hRv_eq : (D.vRv t v hst).length = (E.filter fun e => e.1 = v).card := by
      have hnodupR : (D.vRv t v hst).Nodup := by
        have := D.hnodup t.succ
        rw [hsp.2.1] at this
        exact (List.nodup_append.mp (List.nodup_append.mp this).1).2.1
      rw [← List.toFinset_card_of_nodup hnodupR]
      congr 1; ext e
      rw [List.mem_toFinset, mem_filter]
      constructor
      · intro heR
        exact ⟨D.hmemE t.succ e (by rw [hsp.2.1]; simp [heR]), hsp.2.2.2.1 e heR⟩
      · rintro ⟨heE, he1⟩
        have ht_eq : t = D.hvert_pos v := D.hvert_only t v hst
        have hlt : (D.hvert_pos e.1).val < t.succ.val := by rw [he1, ← ht_eq]; simp
        have hle : t.succ.val ≤ (D.hvert_pos e.2).val := by
          have h12 : D.hvert_pos e.1 < D.hvert_pos e.2 := D.hvert_mono (D.hE e heE)
          rw [he1, ← ht_eq] at h12; exact h12
        have he_act : e ∈ D.state t.succ := (D.hactive_iff t.succ e heE).mpr ⟨hlt, hle⟩
        rw [hsp.2.1, List.mem_append, List.mem_append] at he_act
        rcases he_act with (hpre | hRv) | hpost
        · exact absurd he1 (hsp.2.2.2.2.1 e hpre).1
        · exact hRv
        · exact absurd he1 (hsp.2.2.2.2.2 e hpost).1
    have hzero_if_notS : v ∉ S → (D.vLv t v hst).length = 0 ∧ (D.vRv t v hst).length = 0 := by
      intro hvnot
      constructor
      · by_contra hne
        obtain ⟨e, he⟩ := List.exists_mem_of_ne_nil _ (List.ne_nil_of_length_pos (Nat.pos_of_ne_zero hne))
        have heS : e ∈ D.state t.castSucc := by rw [hsp.1]; exact List.mem_append_left _ (List.mem_append_right _ he)
        exact hvnot (hsp.2.2.1 e he ▸ (hS e (D.hmemE t.castSucc e heS)).2)
      · by_contra hne
        obtain ⟨e, he⟩ := List.exists_mem_of_ne_nil _ (List.ne_nil_of_length_pos (Nat.pos_of_ne_zero hne))
        have heS : e ∈ D.state t.succ := by rw [hsp.2.1]; exact List.mem_append_left _ (List.mem_append_right _ he)
        exact hvnot (hsp.2.2.2.1 e he ▸ (hS e (D.hmemE t.succ e heS)).1)
    rw [D.gapStepEdges_vertex hnoswap t v hst]
    dsimp only
    simp only [List.length_append, List.length_map, List.length_finRange]
    by_cases hvS : v ∈ S
    · simp only [hvS, ↓reduceIte]
      split_ifs <;> simp only [List.length_cons, List.length_nil] <;> omega
    · simp only [hvS, ↓reduceIte]
      have h0 := hzero_if_notS hvS
      rw [if_pos h0]
      simp only [List.length_cons, List.length_nil]; omega

private lemma mem_gapStepEdges_vertex (hnoswap : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t ≠ WStep.swap e₁ e₂)
    (t : Fin D.L) (v : Fin n) (hst : D.step t = WStep.vertex v) (x y : D.Gap)
    (hx : x.1.1 = t.castSucc) (hy : y.1.1 = t.succ)
    (hcase :
      (x.1.2 < (D.vPre t v hst).length ∧ y.1.2 = x.1.2) ∨
      (x.1.2 = (D.vPre t v hst).length ∧ y.1.2 = (D.vPre t v hst).length) ∨
      (x.1.2 = (D.vPre t v hst).length + (D.vLv t v hst).length ∧
       y.1.2 = (D.vPre t v hst).length + (D.vRv t v hst).length) ∨
      (∃ j : ℕ, j < (D.vPost t v hst).length ∧
        x.1.2 = (D.vPre t v hst).length + (D.vLv t v hst).length + 1 + j ∧
        y.1.2 = (D.vPre t v hst).length + (D.vRv t v hst).length + 1 + j)) :
    (x, y) ∈ D.gapStepEdges hnoswap t := by
  rw [D.gapStepEdges_vertex hnoswap t v hst]; dsimp only
  rcases hcase with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨j, hj, h1, h2⟩
  · refine List.mem_append_left _ (List.mem_append_left _ ?_)
    simp only [List.mem_map, List.mem_finRange, true_and]
    refine ⟨⟨x.1.2, h1⟩, Prod.ext (Subtype.ext (Prod.ext hx.symm rfl)) (Subtype.ext (Prod.ext hy.symm h2.symm))⟩
  · refine List.mem_append_left _ (List.mem_append_right _ ?_)
    split_ifs
    · simp only [List.mem_singleton]
      exact Prod.ext (Subtype.ext (Prod.ext hx h1)) (Subtype.ext (Prod.ext hy h2))
    · simp only [List.mem_cons]
      left; exact Prod.ext (Subtype.ext (Prod.ext hx h1)) (Subtype.ext (Prod.ext hy h2))
  · refine List.mem_append_left _ (List.mem_append_right _ ?_)
    split_ifs with h0
    · simp only [List.mem_singleton]
      exact Prod.ext (Subtype.ext (Prod.ext hx (by simp [h0.1] at h1; exact h1)))
        (Subtype.ext (Prod.ext hy (by simp [h0.2] at h2; exact h2)))
    · exact List.mem_cons_of_mem _ (List.mem_singleton.mpr (Prod.ext (Subtype.ext (Prod.ext hx h1)) (Subtype.ext (Prod.ext hy h2))))
  · refine List.mem_append_right _ ?_
    simp only [List.mem_map, List.mem_finRange, true_and]
    exact ⟨⟨j, hj⟩, Prod.ext (Subtype.ext (Prod.ext hx.symm h1.symm)) (Subtype.ext (Prod.ext hy.symm h2.symm))⟩

/-- In a diagram with 0 swaps, for any `S : Finset (Fin n)` containing all endpoints of `E`,
we have `E.card ≤ 3 * S.card`. -/
theorem euler_no_swaps (h0 : D.numSwaps = 0)
    (S : Finset (Fin n)) (hS : ∀ e ∈ E, e.1 ∈ S ∧ e.2 ∈ S) :
    E.card ≤ 3 * S.card := by
  have hnoswap : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t ≠ WStep.swap e₁ e₂ := by
    intro t e₁ e₂ hsw
    have hmem : t ∈ univ.filter (fun t : Fin D.L => D.isSwap t = true) := mem_filter.mpr ⟨mem_univ t, by simp [isSwap, hsw]⟩
    have hpos : 0 < D.numSwaps := Finset.card_pos.mpr ⟨t, hmem⟩
    omega
  let allEdges : List (D.Gap × D.Gap) := (List.finRange D.L).flatMap (D.gapStepEdges hnoswap)
  let st := Relation.EqvGen.setoid (fun x y : D.Gap => (x, y) ∈ allEdges)
  let Q := Quotient st
  let comp : D.Gap → Q := Quotient.mk st
  have hrel_step : ∀ (t : Fin D.L) (x y : D.Gap), (x, y) ∈ D.gapStepEdges hnoswap t → comp x = comp y := by
    intro t x y hxy
    exact Quotient.sound (Relation.EqvGen.rel x y (List.mem_flatMap.mpr ⟨t, List.mem_finRange t, hxy⟩))
  -- Step 1: Lower bound on F = Fintype.card Q
  have hlen_all : allEdges.length = ∑ t : Fin D.L, (D.gapStepEdges hnoswap t).length := by
    simp [allEdges, List.length_flatMap, Fin.sum_univ_def]
  have hsum_vert_fn : ∀ (g : Fin n → ℕ),
      ∑ t : Fin D.L, (match D.step t with | WStep.vertex v => g v | _ => 0) = ∑ v : Fin n, g v := by
    intro g
    rw [← Finset.sum_subset (subset_univ (univ.image D.hvert_pos))]
    · rw [Finset.sum_image (fun a _ b _ h => D.hvert_mono.injective h)]
      apply sum_congr rfl; intro v _; rw [D.hvert_step v]
    · intro t _ ht
      cases hst : D.step t with
      | noop => rfl
      | swap _ _ => rfl
      | vertex v => exfalso; exact ht (mem_image.mpr ⟨v, mem_univ v, (D.hvert_only t v hst).symm⟩)
  have hsum_out : ∑ t : Fin D.L, (match D.step t with | WStep.vertex v => (E.filter fun e => e.1 = v).card | _ => 0) = E.card := by
    rw [hsum_vert_fn]
    rw [← Finset.card_biUnion]
    · congr 1; ext e; simp
    · intro u _ v _ huv; dsimp only [Function.onFun]; rw [Finset.disjoint_left]; intro e he1 he2
      exact huv ((mem_filter.mp he1).2.symm.trans (mem_filter.mp he2).2)
  have hsum_S : ∑ t : Fin D.L, (match D.step t with | WStep.vertex v => if v ∈ S then 1 else 0 | _ => 0) = S.card := by
    rw [hsum_vert_fn (fun v => if v ∈ S then 1 else 0)]; simp [Finset.sum_boole]
  have heuler1 : 1 + E.card ≤ Fintype.card Q + S.card := by
    have hsum := Finset.sum_le_sum (fun t (_ : t ∈ univ) => D.gapStepEdges_length hnoswap S hS t)
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib] at hsum
    rw [← hlen_all, hsum_out, hsum_S] at hsum
    have hcg := D.card_gap
    have hq : Fintype.card D.Gap ≤ Fintype.card Q + allEdges.length := card_quot_ge_sub allEdges
    omega
  -- Step 2: Top gap is always in c0 = comp ⟨(0, 0), _⟩
  let c0 : Q := comp ⟨(0, 0), by simp [D.hstart]⟩
  have htop_c0 : ∀ s : Fin (D.L + 1), comp ⟨(s, (D.state s).length), le_rfl⟩ = c0 := by
    intro ⟨s, hs⟩
    induction s with
    | zero =>
      have : (⟨0, hs⟩ : Fin (D.L + 1)) = 0 := Fin.ext rfl
      congr 1; exact Subtype.ext (Prod.ext this (by simp [this, D.hstart]))
    | succ s ih =>
      let t : Fin D.L := ⟨s, by (try dsimp); omega⟩
      have hprev := ih (by omega)
      have hstep : comp ⟨(t.castSucc, (D.state t.castSucc).length), le_rfl⟩ =
          comp ⟨(t.succ, (D.state t.succ).length), le_rfl⟩ := by
        apply hrel_step t
        cases hst : D.step t with
        | noop =>
          have heq : D.state t.succ = D.state t.castSucc := by
            have h := D.hstep_valid t; rwa [hst] at h
          rw [D.gapStepEdges_noop hnoswap t hst]; simp only [List.mem_map, List.mem_finRange, true_and]
          refine ⟨⟨(D.state t.castSucc).length, Nat.lt_succ_self _⟩,
            Prod.ext (Subtype.ext (Prod.ext rfl rfl)) (Subtype.ext (Prod.ext rfl (by simp [heq])))⟩
        | swap e₁ e₂ => exact absurd hst (hnoswap t e₁ e₂)
        | vertex v =>
          have hsp := D.vSpec t v hst
          have hlenL : (D.state t.castSucc).length =
              (D.vPre t v hst).length + (D.vLv t v hst).length + (D.vPost t v hst).length := by
            rw [hsp.1, List.length_append, List.length_append]
          have hlenR : (D.state t.succ).length =
              (D.vPre t v hst).length + (D.vRv t v hst).length + (D.vPost t v hst).length := by
            rw [hsp.2.1, List.length_append, List.length_append]
          apply D.mem_gapStepEdges_vertex hnoswap t v hst _ _ rfl rfl
          by_cases hb : (D.vPost t v hst).length = 0
          · exact Or.inr (Or.inr (Or.inl ⟨by simp; omega, by simp; omega⟩))
          · exact Or.inr (Or.inr (Or.inr ⟨(D.vPost t v hst).length - 1, by omega, by simp; omega, by simp; omega⟩))
      exact hstep.symm.trans hprev
  -- Step 3: Arc-side invariance across a single step
  have harc_step : ∀ (t : Fin D.L) (e : DirEdge n) (i₁ i₂ : ℕ)
      (hi1_lt : i₁ < (D.state t.castSucc).length) (hi2_lt : i₂ < (D.state t.succ).length),
      (D.state t.castSucc)[i₁]'hi1_lt = e → (D.state t.succ)[i₂]'hi2_lt = e →
      comp ⟨(t.castSucc, i₁), by (try dsimp); omega⟩ = comp ⟨(t.succ, i₂), by (try dsimp); omega⟩ ∧
      comp ⟨(t.castSucc, i₁ + 1), by (try dsimp); omega⟩ = comp ⟨(t.succ, i₂ + 1), by (try dsimp); omega⟩ := by
    intro t e i₁ i₂ hi1_lt hi2_lt hi₁ hi₂
    cases hst : D.step t with
    | noop =>
      have heq : D.state t.succ = D.state t.castSucc := by
        have h := D.hstep_valid t; rwa [hst] at h
      have hi12 : i₁ = i₂ := by
        have hget : (D.state t.castSucc)[i₁]'hi1_lt = (D.state t.castSucc)[i₂]'(by rw [← heq]; exact hi2_lt) := by
          rw [hi₁, ← hi₂]; simp [heq]
        exact (List.Nodup.getElem_inj_iff (D.hnodup t.castSucc)).mp hget
      constructor
      · apply hrel_step t
        rw [D.gapStepEdges_noop hnoswap t hst]; simp only [List.mem_map, List.mem_finRange, true_and]
        exact ⟨⟨i₁, by (try dsimp); omega⟩, Prod.ext rfl (Subtype.ext (Prod.ext rfl (by simp [hi12])))⟩
      · apply hrel_step t
        rw [D.gapStepEdges_noop hnoswap t hst]; simp only [List.mem_map, List.mem_finRange, true_and]
        exact ⟨⟨i₁ + 1, by (try dsimp); omega⟩, Prod.ext rfl (Subtype.ext (Prod.ext rfl (by simp [hi12])))⟩
    | swap e₁ e₂ => exact absurd hst (hnoswap t e₁ e₂)
    | vertex v =>
      have hsp := D.vSpec t v hst
      set pre := D.vPre t v hst
      set Lv := D.vLv t v hst
      set Rv := D.vRv t v hst
      set post := D.vPost t v hst
      have hlenL : (D.state t.castSucc).length = pre.length + Lv.length + post.length := by
        dsimp only [pre, Lv, post]; rw [hsp.1, List.length_append, List.length_append]
      have hlenR : (D.state t.succ).length = pre.length + Rv.length + post.length := by
        dsimp only [pre, Rv, post]; rw [hsp.2.1, List.length_append, List.length_append]
      have he_not_L : e ∉ Lv := by
        intro heL
        have he2 : e.2 = v := hsp.2.2.1 e heL
        have heS : e ∈ D.state t.succ := hi₂ ▸ List.getElem_mem _
        rw [hsp.2.1, List.mem_append, List.mem_append] at heS
        rcases heS with (hpre | hRv) | hpost
        · exact (hsp.2.2.2.2.1 e hpre).2 he2
        · have he1 : e.1 = v := hsp.2.2.2.1 e hRv
          have hlt := D.hE e (D.hmemE t.castSucc e (hi₁ ▸ List.getElem_mem _))
          rw [he1, he2] at hlt; exact lt_irrefl _ hlt
        · exact (hsp.2.2.2.2.2 e hpost).2 he2
      by_cases hlt_pre : i₁ < pre.length
      · have he_pre : pre[i₁] = e := by
          have h1 := hi₁
          simp only [hsp.1, List.getElem_append_left (show i₁ < (pre ++ Lv).length by simp; omega),
            List.getElem_append_left hlt_pre] at h1
          exact h1
        have hi12 : i₂ = i₁ := by
          have h2 : (D.state t.succ)[i₁]'(by omega) = e := by
            simp only [hsp.2.1, List.getElem_append_left (show i₁ < (pre ++ Rv).length by simp; omega),
              List.getElem_append_left hlt_pre]
            exact he_pre
          exact (List.Nodup.getElem_inj_iff (D.hnodup t.succ)).mp (hi₂.trans h2.symm)
        constructor
        · exact hrel_step t _ _ (D.mem_gapStepEdges_vertex hnoswap t v hst _ _ rfl rfl (Or.inl ⟨hlt_pre, hi12⟩))
        · apply hrel_step t; apply D.mem_gapStepEdges_vertex hnoswap t v hst _ _ rfl rfl
          by_cases h1 : i₁ + 1 < pre.length
          · exact Or.inl ⟨h1, by simp [hi12]⟩
          · exact Or.inr (Or.inl ⟨by change i₁ + 1 = pre.length; omega, by change i₂ + 1 = pre.length; omega⟩)
      · have hge_post : pre.length + Lv.length ≤ i₁ := by
          by_contra hlt_lv
          have hmemL : (D.state t.castSucc)[i₁]'hi1_lt ∈ Lv := by
            simp only [hsp.1, List.getElem_append_left (show i₁ < (pre ++ Lv).length by simp; omega),
              List.getElem_append_right (show pre.length ≤ i₁ by omega)]
            exact List.getElem_mem _
          rw [hi₁] at hmemL; exact he_not_L hmemL
        let j : ℕ := i₁ - (pre.length + Lv.length)
        have hj_lt : j < post.length := by omega
        have he_post : post[j] = e := by
          have h1 := hi₁
          simp only [hsp.1, List.getElem_append_right (show (pre ++ Lv).length ≤ i₁ by simp; omega),
            List.length_append] at h1
          exact h1
        have hi2_val : i₂ = pre.length + Rv.length + j := by
          have h2 : (D.state t.succ)[pre.length + Rv.length + j]'(by omega) = e := by
            simp only [hsp.2.1, List.getElem_append_right (show (pre ++ Rv).length ≤ pre.length + Rv.length + j by rw [List.length_append]; omega),
              List.length_append, Nat.add_sub_cancel_left]
            exact he_post
          exact (List.Nodup.getElem_inj_iff (D.hnodup t.succ)).mp (hi₂.trans h2.symm)
        constructor
        · apply hrel_step t; apply D.mem_gapStepEdges_vertex hnoswap t v hst _ _ rfl rfl
          by_cases hj0 : j = 0
          · exact Or.inr (Or.inr (Or.inl ⟨by change i₁ = pre.length + Lv.length; omega, by change i₂ = pre.length + Rv.length; omega⟩))
          · exact Or.inr (Or.inr (Or.inr ⟨j - 1, by change j - 1 < post.length; omega, by change i₁ = pre.length + Lv.length + 1 + (j - 1); omega, by change i₂ = pre.length + Rv.length + 1 + (j - 1); omega⟩))
        · apply hrel_step t; apply D.mem_gapStepEdges_vertex hnoswap t v hst _ _ rfl rfl
          exact Or.inr (Or.inr (Or.inr ⟨j, hj_lt, by change i₁ + 1 = pre.length + Lv.length + 1 + j; omega, by change i₂ + 1 = pre.length + Rv.length + 1 + j; omega⟩))
  -- Step 4: Well-defined sideComp e b for e ∈ E
  have hact_start : ∀ e ∈ E, e ∈ D.state (D.hvert_pos e.1).succ := by
    intro e he
    rw [D.hactive_iff _ e he]
    exact ⟨by simp, D.hvert_mono (D.hE e he)⟩
  let sideComp (e : DirEdge n) (b : Bool) : Q :=
    if he : e ∈ E then
      let s0 := (D.hvert_pos e.1).succ
      let idx := (D.state s0).idxOf e
      have hlt : idx < (D.state s0).length := List.idxOf_lt_length_iff.mpr (hact_start e he)
      if b then comp ⟨(s0, idx + 1), by (try dsimp); omega⟩ else comp ⟨(s0, idx), by (try dsimp); omega⟩
    else c0
  have hside_eq : ∀ (e : DirEdge n) (he : e ∈ E) (s : Fin (D.L + 1)) (i : ℕ) (hi_lt : i < (D.state s).length),
      (D.state s)[i]'hi_lt = e →
      comp ⟨(s, i), by (try dsimp); omega⟩ = sideComp e false ∧
      comp ⟨(s, i + 1), by (try dsimp); omega⟩ = sideComp e true := by
    intro e he s i hi_lt hi
    have ⟨hs1, hs2⟩ := (D.hactive_iff s e he).mp (hi ▸ List.getElem_mem _)
    let s0 := (D.hvert_pos e.1).succ
    suffices h : ∀ (d : ℕ) (s' : Fin (D.L + 1)), s'.val = s0.val + d → s'.val ≤ (D.hvert_pos e.2).val →
        ∀ (j : ℕ) (hj_lt : j < (D.state s').length),
        (D.state s')[j]'hj_lt = e →
        comp ⟨(s', j), by dsimp; omega⟩ = sideComp e false ∧
        comp ⟨(s', j + 1), by dsimp; omega⟩ = sideComp e true by
      exact h (s.val - s0.val) s (by dsimp [s0]; omega) hs2 i hi_lt hi
    intro d
    induction d with
    | zero =>
      intro s' hs' _ j hj_lt hj
      have hs0_eq : s' = s0 := Fin.ext (by omega)
      subst hs0_eq
      have hj_eq : j = (D.state s0).idxOf e := by
        have hlt : (D.state s0).idxOf e < (D.state s0).length :=
          List.idxOf_lt_length_iff.mpr (hact_start e he)
        have hget : (D.state s0)[(D.state s0).idxOf e] = e := List.getElem_idxOf hlt
        exact (List.Nodup.getElem_inj_iff (D.hnodup s0)).mp (hj.trans hget.symm)
      simp only [sideComp, dif_pos he, Bool.false_eq_true, ↓reduceIte]
      constructor
      · congr 1; exact Subtype.ext (Prod.ext rfl hj_eq)
      · congr 1; exact Subtype.ext (Prod.ext rfl (congrArg (· + 1) hj_eq))
    | succ d ih =>
      intro s' hs' hs'le j hj_lt hj
      have ht_lt : s0.val + d < D.L := by have := (D.hvert_pos e.2).isLt; omega
      let t : Fin D.L := ⟨s0.val + d, ht_lt⟩
      have ht_succ : t.succ = s' := Fin.ext (by dsimp [t]; omega)
      subst ht_succ
      have he_prev : e ∈ D.state t.castSucc := (D.hactive_iff t.castSucc e he).mpr
        ⟨by simp only [Fin.val_castSucc, t, s0, Fin.val_succ]; omega, by simp only [Fin.val_castSucc, t]; simp only [Fin.val_succ, t] at hs'le; omega⟩
      let j₀ := (D.state t.castSucc).idxOf e
      have hj0_lt : j₀ < (D.state t.castSucc).length := List.idxOf_lt_length_iff.mpr he_prev
      have hj₀ : (D.state t.castSucc)[j₀]'hj0_lt = e := List.getElem_idxOf hj0_lt
      have hprev := ih t.castSucc (by dsimp [t]) (by dsimp [t]; omega) j₀ hj0_lt hj₀
      have hstep := harc_step t e j₀ j hj0_lt hj_lt hj₀ hj
      exact ⟨hstep.1.symm.trans hprev.1, hstep.2.symm.trans hprev.2⟩
  -- Step 5: Every C ≠ c0 has at least 3 distinct arc-sides
  have hthree : ∀ C : Q, C ≠ c0 →
      3 ≤ ((E ×ˢ ({false, true} : Finset Bool)).filter fun p => sideComp p.1 p.2 = C).card := by
    intro C hCne
    let SC : Finset (Fin (D.L + 1)) := univ.filter fun s => ∃ x : D.Gap, x.1.1 = s ∧ comp x = C
    have hSC_ne : SC.Nonempty := by
      induction C using Quotient.ind with | _ x =>
      exact ⟨x.1.1, mem_filter.mpr ⟨mem_univ _, x, rfl, rfl⟩⟩
    let smin := SC.min' hSC_ne
    let smax := SC.max' hSC_ne
    obtain ⟨x₁, hx1s, hx1c⟩ := (mem_filter.mp (min'_mem SC hSC_ne)).2
    obtain ⟨x₂, hx2s, hx2c⟩ := (mem_filter.mp (max'_mem SC hSC_ne)).2
    change x₁.1.1 = smin at hx1s
    change x₂.1.1 = smax at hx2s
    have hsmin_pos : 0 < smin.val := by
      by_contra h0
      have hs0 : smin = 0 := Fin.ext (by change smin.val = 0; omega)
      have hx0 : x₁ = ⟨(0, 0), by simp [D.hstart]⟩ := by
        apply Subtype.ext; apply Prod.ext
        · exact hx1s.trans hs0
        · have := x₁.2; rw [hx1s, hs0, D.hstart] at this; simp at this; omega
      exact hCne (hx1c.symm.trans (congrArg comp hx0))
    have hsmax_lt : smax.val < D.L := by
      by_contra hL
      have hsL : smax = ⟨D.L, Nat.lt_succ_self D.L⟩ := Fin.ext (by have := smax.isLt; change smax.val = D.L; omega)
      have hxL : x₂ = ⟨(⟨D.L, Nat.lt_succ_self D.L⟩, (D.state ⟨D.L, Nat.lt_succ_self D.L⟩).length), le_rfl⟩ := by
        apply Subtype.ext; apply Prod.ext
        · exact hx2s.trans hsL
        · have hle : x₂.1.2 ≤ (D.state x₂.1.1).length := x₂.2
          have hlen0 : (D.state ⟨D.L, Nat.lt_succ_self D.L⟩).length = 0 := by rw [D.hend]; rfl
          rw [hx2s, hsL, hlen0] at hle
          change x₂.1.2 = (D.state ⟨D.L, Nat.lt_succ_self D.L⟩).length; rw [hlen0]; omega
      exact hCne (hx2c.symm.trans ((congrArg comp hxL).trans (htop_c0 _)))
    -- Left witness at t₁ = smin - 1
    let t₁ : Fin D.L := ⟨smin.val - 1, by (try dsimp); omega⟩
    have ht1_succ : t₁.succ = smin := Fin.ext (by simp only [Fin.val_succ, t₁]; omega)
    have hno_in : ∀ x₀ : D.Gap, (x₀, x₁) ∉ D.gapStepEdges hnoswap t₁ := by
      intro x₀ hmem
      have hceq : comp x₀ = C := (hrel_step t₁ x₀ x₁ hmem).trans hx1c
      have hx0s : x₀.1.1 = t₁.castSucc := by
        cases hst : D.step t₁ with
        | noop =>
          rw [D.gapStepEdges_noop hnoswap t₁ hst] at hmem; simp only [List.mem_map, List.mem_finRange, true_and] at hmem
          obtain ⟨g, hg⟩ := hmem
          exact (congrArg (fun p : D.Gap × D.Gap => p.1.1.1) hg).symm
        | swap e₁ e₂ => exact absurd hst (hnoswap t₁ e₁ e₂)
        | vertex v =>
          rw [D.gapStepEdges_vertex hnoswap _ v hst] at hmem; dsimp only at hmem; simp only [List.mem_append, List.mem_map, List.mem_finRange, true_and] at hmem
          rcases hmem with (⟨g, hg⟩ | hmid) | ⟨g, hg⟩
          · exact (congrArg (fun p : D.Gap × D.Gap => p.1.1.1) hg).symm
          · split_ifs at hmid
            · simp only [List.mem_singleton] at hmid; exact (congrArg (fun p : D.Gap × D.Gap => p.1.1.1) hmid)
            · simp only [List.mem_cons, List.not_mem_nil, or_false] at hmid
              rcases hmid with h | h <;> exact (congrArg (fun p : D.Gap × D.Gap => p.1.1.1) h)
          · exact (congrArg (fun p : D.Gap × D.Gap => p.1.1.1) hg).symm
      have hle : smin ≤ t₁.castSucc := min'_le SC _ (mem_filter.mpr ⟨mem_univ _, x₀, hx0s, hceq⟩)
      have : smin.val ≤ t₁.castSucc.val := hle
      dsimp [t₁] at this; omega
    have hex_left : ∃ v₁ : Fin n, ∃ e₁ ∈ E, ∃ e₂ ∈ E,
        e₁.1 = v₁ ∧ e₂.1 = v₁ ∧ e₁ ≠ e₂ ∧ sideComp e₁ true = C ∧ sideComp e₂ false = C := by
      cases hst : D.step t₁ with
      | noop =>
        have heq : D.state t₁.succ = D.state t₁.castSucc := by
          have h := D.hstep_valid t₁; rwa [hst] at h
        have hx1_le : x₁.1.2 ≤ (D.state t₁.castSucc).length := by
          have := x₁.2; rwa [hx1s, ← ht1_succ, heq] at this
        exfalso; apply hno_in ⟨(t₁.castSucc, x₁.1.2), hx1_le⟩
        rw [D.gapStepEdges_noop hnoswap t₁ hst]; simp only [List.mem_map, List.mem_finRange, true_and]
        exact ⟨⟨x₁.1.2, by (try dsimp); omega⟩, Prod.ext rfl (Subtype.ext (Prod.ext (ht1_succ.trans hx1s.symm) rfl))⟩
      | swap e₁ e₂ => exact absurd hst (hnoswap t₁ e₁ e₂)
      | vertex v₁ =>
        have hsp := D.vSpec t₁ v₁ hst
        let a := (D.vPre t₁ v₁ hst).length
        let dl := (D.vLv t₁ v₁ hst).length
        let dr := (D.vRv t₁ v₁ hst).length
        let b := (D.vPost t₁ v₁ hst).length
        have hlenL : (D.state t₁.castSucc).length = a + dl + b := by
          dsimp only [a, dl, b]; rw [hsp.1, List.length_append, List.length_append]
        have hlenR : (D.state t₁.succ).length = a + dr + b := by
          dsimp only [a, dr, b]; rw [hsp.2.1, List.length_append, List.length_append]
        have hx1_le : x₁.1.2 ≤ a + dr + b := by have := x₁.2; rwa [hx1s, ← ht1_succ, hlenR] at this
        have hgi_in_R : a < x₁.1.2 ∧ x₁.1.2 < a + dr := by
          by_contra hnot
          by_cases h1 : x₁.1.2 < a
          · exact hno_in ⟨(t₁.castSucc, x₁.1.2), by (try dsimp); omega⟩
              (D.mem_gapStepEdges_vertex hnoswap t₁ v₁ hst _ _ rfl (hx1s.trans ht1_succ.symm) (Or.inl ⟨h1, rfl⟩))
          · by_cases h2 : x₁.1.2 = a
            · exact hno_in ⟨(t₁.castSucc, a), by (try dsimp); omega⟩
                (D.mem_gapStepEdges_vertex hnoswap t₁ v₁ hst _ _ rfl (hx1s.trans ht1_succ.symm) (Or.inr (Or.inl ⟨rfl, h2⟩)))
            · by_cases h3 : x₁.1.2 = a + dr
              · exact hno_in ⟨(t₁.castSucc, a + dl), by (try dsimp); omega⟩
                  (D.mem_gapStepEdges_vertex hnoswap t₁ v₁ hst _ _ rfl (hx1s.trans ht1_succ.symm) (Or.inr (Or.inr (Or.inl ⟨rfl, h3⟩))))
              · have h4 : a + dr + 1 ≤ x₁.1.2 := by omega
                exact hno_in ⟨(t₁.castSucc, a + dl + 1 + (x₁.1.2 - (a + dr + 1))), by (try dsimp); omega⟩
                  (D.mem_gapStepEdges_vertex hnoswap t₁ v₁ hst _ _ rfl (hx1s.trans ht1_succ.symm)
                    (Or.inr (Or.inr (Or.inr ⟨x₁.1.2 - (a + dr + 1), by omega, rfl, by (try dsimp); omega⟩))))
        have hi1_lt : x₁.1.2 - 1 < (D.state t₁.succ).length := by omega
        have hi2_lt : x₁.1.2 < (D.state t₁.succ).length := by omega
        let e₁ := (D.state t₁.succ)[x₁.1.2 - 1]'hi1_lt
        let e₂ := (D.state t₁.succ)[x₁.1.2]'hi2_lt
        have he1E : e₁ ∈ E := D.hmemE t₁.succ e₁ (List.getElem_mem _)
        have he2E : e₂ ∈ E := D.hmemE t₁.succ e₂ (List.getElem_mem _)
        have he1_Rv : e₁ ∈ D.vRv t₁ v₁ hst := by
          dsimp only [e₁]
          simp only [hsp.2.1, List.getElem_append_left (show x₁.1.2 - 1 < (D.vPre t₁ v₁ hst ++ D.vRv t₁ v₁ hst).length by simp [a, dr]; omega),
            List.getElem_append_right (show (D.vPre t₁ v₁ hst).length ≤ x₁.1.2 - 1 by omega)]
          exact List.getElem_mem _
        have he2_Rv : e₂ ∈ D.vRv t₁ v₁ hst := by
          dsimp only [e₂]
          simp only [hsp.2.1, List.getElem_append_left (show x₁.1.2 < (D.vPre t₁ v₁ hst ++ D.vRv t₁ v₁ hst).length by simp [a, dr]; omega),
            List.getElem_append_right (show (D.vPre t₁ v₁ hst).length ≤ x₁.1.2 by omega)]
          exact List.getElem_mem _
        have hne12 : e₁ ≠ e₂ := fun h => by
          have hidx : x₁.1.2 - 1 = x₁.1.2 := (List.Nodup.getElem_inj_iff (D.hnodup t₁.succ)).mp h
          have hpos : 0 < x₁.1.2 := Nat.lt_of_le_of_lt (Nat.zero_le a) hgi_in_R.1
          omega
        have hs1 := (hside_eq e₁ he1E t₁.succ (x₁.1.2 - 1) hi1_lt rfl).2
        have hs2 := (hside_eq e₂ he2E t₁.succ x₁.1.2 hi2_lt rfl).1
        have hcx1 : comp ⟨(t₁.succ, x₁.1.2), by (try dsimp); omega⟩ = C := by
          have : (⟨(t₁.succ, x₁.1.2), by (try dsimp); omega⟩ : D.Gap) = x₁ := Subtype.ext (Prod.ext (ht1_succ.trans hx1s.symm) rfl)
          rw [this]; exact hx1c
        have hcx1' : comp ⟨(t₁.succ, x₁.1.2 - 1 + 1), by (try dsimp); omega⟩ = C := by
          have : (⟨(t₁.succ, x₁.1.2 - 1 + 1), by (try dsimp); omega⟩ : D.Gap) = ⟨(t₁.succ, x₁.1.2), by (try dsimp); omega⟩ :=
            Subtype.ext (Prod.ext rfl (Nat.sub_add_cancel (Nat.lt_of_le_of_lt (Nat.zero_le a) hgi_in_R.1)))
          rw [this]; exact hcx1
        exact ⟨v₁, e₁, he1E, e₂, he2E, hsp.2.2.2.1 e₁ he1_Rv, hsp.2.2.2.1 e₂ he2_Rv,
          hne12, hs1.symm.trans hcx1', hs2.symm.trans hcx1⟩
    -- Right witness at t₂ = smax
    let t₂ : Fin D.L := ⟨smax.val, hsmax_lt⟩
    have ht2_cast : t₂.castSucc = smax := Fin.ext rfl
    have hno_out : ∀ x₃ : D.Gap, (x₂, x₃) ∉ D.gapStepEdges hnoswap t₂ := by
      intro x₃ hmem
      have hceq : comp x₃ = C := (hrel_step t₂ x₂ x₃ hmem).symm.trans hx2c
      have hx3s : x₃.1.1 = t₂.succ := by
        cases hst : D.step t₂ with
        | noop =>
          rw [D.gapStepEdges_noop hnoswap t₂ hst] at hmem; simp only [List.mem_map, List.mem_finRange, true_and] at hmem
          obtain ⟨g, hg⟩ := hmem
          exact (congrArg (fun p : D.Gap × D.Gap => p.2.1.1) hg).symm
        | swap e₁ e₂ => exact absurd hst (hnoswap t₂ e₁ e₂)
        | vertex v =>
          rw [D.gapStepEdges_vertex hnoswap _ v hst] at hmem; dsimp only at hmem; simp only [List.mem_append, List.mem_map, List.mem_finRange, true_and] at hmem
          rcases hmem with (⟨g, hg⟩ | hmid) | ⟨g, hg⟩
          · exact (congrArg (fun p : D.Gap × D.Gap => p.2.1.1) hg).symm
          · split_ifs at hmid
            · simp only [List.mem_singleton] at hmid; exact (congrArg (fun p : D.Gap × D.Gap => p.2.1.1) hmid)
            · simp only [List.mem_cons, List.not_mem_nil, or_false] at hmid
              rcases hmid with h | h <;> exact (congrArg (fun p : D.Gap × D.Gap => p.2.1.1) h)
          · exact (congrArg (fun p : D.Gap × D.Gap => p.2.1.1) hg).symm
      have hle : t₂.succ ≤ smax := le_max' SC _ (mem_filter.mpr ⟨mem_univ _, x₃, hx3s, hceq⟩)
      have : t₂.succ.val ≤ smax.val := hle
      dsimp [t₂] at this; omega
    have hex_right : ∃ v₂ : Fin n, ∃ e₃ ∈ E, ∃ e₄ ∈ E,
        e₃.2 = v₂ ∧ e₄.2 = v₂ ∧ e₃ ≠ e₄ ∧ sideComp e₃ true = C ∧ sideComp e₄ false = C := by
      cases hst : D.step t₂ with
      | noop =>
        have heq : D.state t₂.succ = D.state t₂.castSucc := by
          have h := D.hstep_valid t₂; rwa [hst] at h
        have hx2_le : x₂.1.2 ≤ (D.state t₂.succ).length := by
          have := x₂.2; rwa [hx2s, ← ht2_cast, ← heq] at this
        exfalso; apply hno_out ⟨(t₂.succ, x₂.1.2), hx2_le⟩
        rw [D.gapStepEdges_noop hnoswap t₂ hst]; simp only [List.mem_map, List.mem_finRange, true_and]
        exact ⟨⟨x₂.1.2, by rw [← heq]; omega⟩, Prod.ext (Subtype.ext (Prod.ext (ht2_cast.trans hx2s.symm) rfl)) rfl⟩
      | swap e₁ e₂ => exact absurd hst (hnoswap t₂ e₁ e₂)
      | vertex v₂ =>
        have hsp := D.vSpec t₂ v₂ hst
        let a := (D.vPre t₂ v₂ hst).length
        let dl := (D.vLv t₂ v₂ hst).length
        let dr := (D.vRv t₂ v₂ hst).length
        let b := (D.vPost t₂ v₂ hst).length
        have hlenL : (D.state t₂.castSucc).length = a + dl + b := by
          dsimp only [a, dl, b]; rw [hsp.1, List.length_append, List.length_append]
        have hlenR : (D.state t₂.succ).length = a + dr + b := by
          dsimp only [a, dr, b]; rw [hsp.2.1, List.length_append, List.length_append]
        have hx2_le : x₂.1.2 ≤ a + dl + b := by have := x₂.2; rwa [hx2s, ← ht2_cast, hlenL] at this
        have hgi_in_L : a < x₂.1.2 ∧ x₂.1.2 < a + dl := by
          by_contra hnot
          by_cases h1 : x₂.1.2 < a
          · exact hno_out ⟨(t₂.succ, x₂.1.2), by (try dsimp); omega⟩
              (D.mem_gapStepEdges_vertex hnoswap t₂ v₂ hst _ _ (hx2s.trans ht2_cast.symm) rfl (Or.inl ⟨h1, rfl⟩))
          · by_cases h2 : x₂.1.2 = a
            · exact hno_out ⟨(t₂.succ, a), by (try dsimp); omega⟩
                (D.mem_gapStepEdges_vertex hnoswap t₂ v₂ hst _ _ (hx2s.trans ht2_cast.symm) rfl (Or.inr (Or.inl ⟨h2, rfl⟩)))
            · by_cases h3 : x₂.1.2 = a + dl
              · exact hno_out ⟨(t₂.succ, a + dr), by (try dsimp); omega⟩
                  (D.mem_gapStepEdges_vertex hnoswap t₂ v₂ hst _ _ (hx2s.trans ht2_cast.symm) rfl (Or.inr (Or.inr (Or.inl ⟨h3, rfl⟩))))
              · have h4 : a + dl + 1 ≤ x₂.1.2 := by omega
                exact hno_out ⟨(t₂.succ, a + dr + 1 + (x₂.1.2 - (a + dl + 1))), by (try dsimp); omega⟩
                  (D.mem_gapStepEdges_vertex hnoswap t₂ v₂ hst _ _ (hx2s.trans ht2_cast.symm) rfl
                    (Or.inr (Or.inr (Or.inr ⟨x₂.1.2 - (a + dl + 1), by omega, by omega, rfl⟩))))
        have hi3_lt : x₂.1.2 - 1 < (D.state t₂.castSucc).length := by omega
        have hi4_lt : x₂.1.2 < (D.state t₂.castSucc).length := by omega
        let e₃ := (D.state t₂.castSucc)[x₂.1.2 - 1]'hi3_lt
        let e₄ := (D.state t₂.castSucc)[x₂.1.2]'hi4_lt
        have he3E : e₃ ∈ E := D.hmemE t₂.castSucc e₃ (List.getElem_mem _)
        have he4E : e₄ ∈ E := D.hmemE t₂.castSucc e₄ (List.getElem_mem _)
        have he3_Lv : e₃ ∈ D.vLv t₂ v₂ hst := by
          dsimp only [e₃]
          simp only [hsp.1, List.getElem_append_left (show x₂.1.2 - 1 < (D.vPre t₂ v₂ hst ++ D.vLv t₂ v₂ hst).length by simp [a, dl]; omega),
            List.getElem_append_right (show (D.vPre t₂ v₂ hst).length ≤ x₂.1.2 - 1 by omega)]
          exact List.getElem_mem _
        have he4_Lv : e₄ ∈ D.vLv t₂ v₂ hst := by
          dsimp only [e₄]
          simp only [hsp.1, List.getElem_append_left (show x₂.1.2 < (D.vPre t₂ v₂ hst ++ D.vLv t₂ v₂ hst).length by simp [a, dl]; omega),
            List.getElem_append_right (show (D.vPre t₂ v₂ hst).length ≤ x₂.1.2 by omega)]
          exact List.getElem_mem _
        have hne34 : e₃ ≠ e₄ := fun h => by
          have hidx : x₂.1.2 - 1 = x₂.1.2 := (List.Nodup.getElem_inj_iff (D.hnodup t₂.castSucc)).mp h
          have hpos : 0 < x₂.1.2 := Nat.lt_of_le_of_lt (Nat.zero_le a) hgi_in_L.1
          omega
        have hs3 := (hside_eq e₃ he3E t₂.castSucc (x₂.1.2 - 1) hi3_lt rfl).2
        have hs4 := (hside_eq e₄ he4E t₂.castSucc x₂.1.2 hi4_lt rfl).1
        have hcx2 : comp ⟨(t₂.castSucc, x₂.1.2), by (try dsimp); omega⟩ = C := by
          have : (⟨(t₂.castSucc, x₂.1.2), by (try dsimp); omega⟩ : D.Gap) = x₂ := Subtype.ext (Prod.ext (ht2_cast.trans hx2s.symm) rfl)
          rw [this]; exact hx2c
        have hcx2' : comp ⟨(t₂.castSucc, x₂.1.2 - 1 + 1), by (try dsimp); omega⟩ = C := by
          have : (⟨(t₂.castSucc, x₂.1.2 - 1 + 1), by (try dsimp); omega⟩ : D.Gap) = ⟨(t₂.castSucc, x₂.1.2), by (try dsimp); omega⟩ :=
            Subtype.ext (Prod.ext rfl (Nat.sub_add_cancel (Nat.lt_of_le_of_lt (Nat.zero_le a) hgi_in_L.1)))
          rw [this]; exact hcx2
        exact ⟨v₂, e₃, he3E, e₄, he4E, hsp.2.2.1 e₃ he3_Lv, hsp.2.2.1 e₄ he4_Lv,
          hne34, hs3.symm.trans hcx2', hs4.symm.trans hcx2⟩
    obtain ⟨v₁, e₁, he1E, e₂, he2E, h11, h21, hne12, hs1, hs2⟩ := hex_left
    obtain ⟨v₂, e₃, he3E, e₄, he4E, h32, h42, hne34, hs3, hs4⟩ := hex_right
    have hnot_both : ¬ (e₁ = e₃ ∧ e₂ = e₄) := by
      rintro ⟨rfl, rfl⟩
      exact hne12 (Prod.ext (h11.trans h21.symm) (h32.trans h42.symm))
    let Tset : Finset (DirEdge n × Bool) := {(e₁, true), (e₂, false), (e₃, true), (e₄, false)}
    have hTsub : Tset ⊆ (E ×ˢ ({false, true} : Finset Bool)).filter fun p => sideComp p.1 p.2 = C := by
      intro p hp
      simp only [Tset, mem_insert, mem_singleton] at hp
      rcases hp with rfl | rfl | rfl | rfl <;> simp [he1E, he2E, he3E, he4E, hs1, hs2, hs3, hs4]
    have hTcard : 3 ≤ Tset.card := by
      by_cases h13 : e₁ = e₃
      · have h24 : e₂ ≠ e₄ := fun h => hnot_both ⟨h13, h⟩
        have hsub3 : ({(e₁, true), (e₂, false), (e₄, false)} : Finset (DirEdge n × Bool)) ⊆ Tset := by
          intro x hx; simp only [Tset, mem_insert, mem_singleton] at hx ⊢; tauto
        have h3 : ({(e₁, true), (e₂, false), (e₄, false)} : Finset (DirEdge n × Bool)).card = 3 := by
          rw [card_insert_of_notMem, card_insert_of_notMem, card_singleton]
          · simp [h24]
          · simp
        exact h3 ▸ card_le_card hsub3
      · have hsub3 : ({(e₁, true), (e₂, false), (e₃, true)} : Finset (DirEdge n × Bool)) ⊆ Tset := by
          intro x hx; simp only [Tset, mem_insert, mem_singleton] at hx ⊢; tauto
        have h3 : ({(e₁, true), (e₂, false), (e₃, true)} : Finset (DirEdge n × Bool)).card = 3 := by
          rw [card_insert_of_notMem, card_insert_of_notMem, card_singleton]
          · simp
          · simp [h13]
        exact h3 ▸ card_le_card hsub3
    exact hTcard.trans (card_le_card hTsub)
  -- Step 6: Sum over all C ≠ c0
  have heuler2 : 3 * (Fintype.card Q - 1) ≤ 2 * E.card := by
    let sides := E ×ˢ ({false, true} : Finset Bool)
    have hsum_le : ∑ C ∈ (univ.erase c0 : Finset Q),
        (sides.filter fun p => sideComp p.1 p.2 = C).card ≤ sides.card := by
      rw [← Finset.card_biUnion]
      · exact card_le_card (by intro p hp; simp only [mem_biUnion, mem_filter] at hp; exact hp.choose_spec.2.1)
      · intro C₁ _ C₂ _ hne; dsimp only [Function.onFun]; rw [Finset.disjoint_left]; intro p h1 h2
        exact hne ((mem_filter.mp h1).2.symm.trans (mem_filter.mp h2).2)
    have hsum_ge : 3 * (Fintype.card Q - 1) ≤ ∑ C ∈ (univ.erase c0 : Finset Q),
        (sides.filter fun p => sideComp p.1 p.2 = C).card := by
      calc 3 * (Fintype.card Q - 1)
          = ∑ _C ∈ (univ.erase c0 : Finset Q), 3 := by
              rw [sum_const, card_erase_of_mem (mem_univ c0), card_univ, smul_eq_mul, mul_comm]
        _ ≤ ∑ C ∈ (univ.erase c0 : Finset Q), (sides.filter fun p => sideComp p.1 p.2 = C).card :=
              sum_le_sum fun C hC => hthree C (ne_of_mem_erase hC)
    have hsides : sides.card = 2 * E.card := by
      simp [sides, card_product, mul_comm]
    omega
  have hQpos : 1 ≤ Fintype.card Q := Fintype.card_pos_iff.mpr ⟨c0⟩
  omega

/-- Restrict a wiring diagram to any subset of edges `E' ⊆ E` by filtering every state list. -/
def restrict (E' : Finset (DirEdge n)) (hsub : E' ⊆ E) : WiringDiagram n E' where
  L := D.L
  state := fun s => (D.state s).filter (· ∈ E')
  step := fun t => match D.step t with
    | WStep.noop => WStep.noop
    | WStep.vertex v => WStep.vertex v
    | WStep.swap e₁ e₂ => if e₁ ∈ E' ∧ e₂ ∈ E' then WStep.swap e₁ e₂ else WStep.noop
  hE := fun e he => D.hE e (hsub he)
  hstart := by simp [D.hstart]
  hend := by simp [D.hend]
  hnodup := fun s => (D.hnodup s).filter _
  hmemE := fun s e he => by simpa using (List.mem_filter.mp he).2
  hvert_pos := D.hvert_pos
  hvert_mono := D.hvert_mono
  hvert_step := fun v => by simp [D.hvert_step v]
  hvert_only := fun t v h => by
    cases hst : D.step t with
    | noop => simp [hst] at h
    | vertex v' => simp [hst] at h; subst h; exact D.hvert_only t v' hst
    | swap e₁ e₂ => simp [hst] at h; split_ifs at h <;> cases h
  hstep_valid := fun t => by
    have hv := D.hstep_valid t
    cases hst : D.step t with
    | noop =>
      simp only [hst] at hv ⊢
      exact congrArg (List.filter (· ∈ E')) hv
    | swap e₁ e₂ =>
      simp only [hst] at hv ⊢
      obtain ⟨pre, post, h1, h2⟩ := hv
      split_ifs with hboth
      · refine ⟨pre.filter (· ∈ E'), post.filter (· ∈ E'), ?_, ?_⟩
        · rw [h1, List.filter_append, List.filter_append]; simp [hboth.1, hboth.2]
        · rw [h2, List.filter_append, List.filter_append]; simp [hboth.1, hboth.2]
      · rw [h1, h2, List.filter_append, List.filter_append, List.filter_append, List.filter_append]
        congr 1; congr 1
        by_cases h1' : e₁ ∈ E'
        · have h2' : e₂ ∉ E' := fun h => hboth ⟨h1', h⟩
          simp [h1', h2']
        · by_cases h2' : e₂ ∈ E' <;> simp [h1', h2']
    | vertex v =>
      simp only [hst] at hv ⊢
      obtain ⟨pre, Lv, Rv, post, h1, h2, hL, hR, hpre, hpost⟩ := hv
      refine ⟨pre.filter (· ∈ E'), Lv.filter (· ∈ E'), Rv.filter (· ∈ E'), post.filter (· ∈ E'), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [h1, List.filter_append, List.filter_append]
      · rw [h2, List.filter_append, List.filter_append]
      · intro e he; exact hL e (List.mem_filter.mp he).1
      · intro e he; exact hR e (List.mem_filter.mp he).1
      · intro e he; exact hpre e (List.mem_filter.mp he).1
      · intro e he; exact hpost e (List.mem_filter.mp he).1
  hactive_iff := fun s e he => by
    rw [List.mem_filter, D.hactive_iff s e (hsub he)]
    simp [he]

/-- Deleting one edge per swap yields `E.card ≤ 3 * S.card + D.numSwaps`. -/
theorem edges_le_three_card_add_swaps (S : Finset (Fin n)) (hS : ∀ e ∈ E, e.1 ∈ S ∧ e.2 ∈ S) :
    E.card ≤ 3 * S.card + D.numSwaps := by
  generalize hk : D.numSwaps = k
  induction k using Nat.strong_induction_on generalizing E D with
  | _ k ih =>
    by_cases hk0 : k = 0
    · subst hk0; exact (D.euler_no_swaps hk S hS).trans (Nat.le_add_right _ _)
    · have hpos : 0 < (univ.filter fun t : Fin D.L => D.isSwap t = true).card := by
        rw [← numSwaps, hk]; omega
      obtain ⟨t₀, ht₀⟩ := Finset.card_pos.mp hpos
      have hsw := (mem_filter.mp ht₀).2
      cases hst : D.step t₀ with
      | noop => simp [isSwap, hst] at hsw
      | vertex _ => simp [isSwap, hst] at hsw
      | swap e₁ e₂ =>
        have hv := D.hstep_valid t₀; rw [hst] at hv
        obtain ⟨pre, post, h1, _⟩ := hv
        have he1E : e₁ ∈ E := D.hmemE t₀.castSucc e₁ (by rw [h1]; simp)
        let D' := D.restrict (E.erase e₁) (erase_subset e₁ E)
        have hlt : D'.numSwaps < k := by
          rw [← hk]; dsimp only [numSwaps]
          exact card_filter_lt_of_imp D'.isSwap D.isSwap (by
            intro t ht; dsimp only [D', restrict, isSwap] at ht ⊢
            cases ht' : D.step t with
            | noop => simp [ht'] at ht
            | vertex _ => simp [ht'] at ht
            | swap a b => simp [ht'])
            ⟨t₀, by simp [isSwap, hst], by simp [D', restrict, isSwap, hst]⟩
        have hrec := ih D'.numSwaps hlt D' (fun e he => hS e (mem_of_mem_erase he)) rfl
        rw [card_erase_of_mem he1E] at hrec
        have hEpos : 1 ≤ E.card := Finset.card_pos.mpr ⟨e₁, he1E⟩
        omega

/-- Swap the labels of two edges `e₁, e₂` sharing their left endpoint `e₁.1 = e₂.1` at all times `≤ t₀`,
turning the swap step `t₀` into a `noop` and strictly reducing `numSwaps`. -/
def uncrossLeft (t₀ : Fin D.L) (e₁ e₂ : DirEdge n) (hst : D.step t₀ = WStep.swap e₁ e₂)
    (hsame : e₁.1 = e₂.1) : WiringDiagram n E :=
  let σ : Equiv.Perm (DirEdge n) := Equiv.swap e₁ e₂
  have hv₀ := D.hstep_valid t₀
  have hact1 : e₁ ∈ D.state t₀.castSucc := by
    rw [hst] at hv₀; obtain ⟨pre, post, h1, _⟩ := hv₀; rw [h1]; simp
  have hact2 : e₂ ∈ D.state t₀.castSucc := by
    rw [hst] at hv₀; obtain ⟨pre, post, h1, _⟩ := hv₀; rw [h1]; simp
  have he1E : e₁ ∈ E := D.hmemE t₀.castSucc e₁ hact1
  have he2E : e₂ ∈ E := D.hmemE t₀.castSucc e₂ hact2
  have hle1 : t₀.val ≤ (D.hvert_pos e₁.2).val := ((D.hactive_iff t₀.castSucc e₁ he1E).mp hact1).2
  have hle2 : t₀.val ≤ (D.hvert_pos e₂.2).val := ((D.hactive_iff t₀.castSucc e₂ he2E).mp hact2).2
  { L := D.L
    state := fun s => if s.val ≤ t₀.val then (D.state s).map σ else D.state s
    step := fun t =>
      if t.val < t₀.val then
        match D.step t with
        | WStep.noop => WStep.noop
        | WStep.vertex v => WStep.vertex v
        | WStep.swap a b => WStep.swap (σ a) (σ b)
      else if t = t₀ then WStep.noop
      else D.step t
    hE := D.hE
    hstart := by simp [D.hstart]
    hend := by have := t₀.isLt; simp [show ¬(D.L ≤ t₀.val) by omega, D.hend]
    hnodup := fun s => by split_ifs; exact (D.hnodup s).map σ.injective; exact D.hnodup s
    hmemE := fun s e he => by
      split_ifs at he
      · obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
        by_cases h1 : e' = e₁
        · subst h1; simpa [σ] using he2E
        · by_cases h2 : e' = e₂
          · subst h2; simpa [σ] using he1E
          · rw [Equiv.swap_apply_of_ne_of_ne h1 h2]; exact D.hmemE s e' he'
      · exact D.hmemE s e he
    hvert_pos := D.hvert_pos
    hvert_mono := D.hvert_mono
    hvert_step := fun v => by
      have hv_ne : D.hvert_pos v ≠ t₀ := fun h => by
        have := D.hvert_step v; rw [h, hst] at this; cases this
      by_cases h1 : (D.hvert_pos v).val < t₀.val
      · simp [h1, D.hvert_step v]
      · simp [h1, hv_ne, D.hvert_step v]
    hvert_only := fun t v h => by
      by_cases h1 : t.val < t₀.val
      · simp only [h1, ↓reduceIte] at h
        cases hst' : D.step t with
        | noop => simp [hst'] at h
        | swap _ _ => simp [hst'] at h
        | vertex v' => simp [hst'] at h; subst h; exact D.hvert_only t v' hst'
      · by_cases h2 : t = t₀
        · simp [h1, h2] at h
        · simp only [h1, h2, ↓reduceIte] at h; exact D.hvert_only t v h
    hstep_valid := fun t => by
      have hv := D.hstep_valid t
      by_cases hlt : t.val < t₀.val
      · simp only [hlt, ↓reduceIte]
        have hle_succ : t.succ.val ≤ t₀.val := by simp; omega
        have hle_cast : t.castSucc.val ≤ t₀.val := by simp; omega
        cases hst' : D.step t with
        | noop =>
          simp only [hst'] at hv ⊢
          simp only [hle_succ, hle_cast, ↓reduceIte, hv]
        | swap a b =>
          simp only [hst'] at hv ⊢
          obtain ⟨pre, post, h1, h2⟩ := hv
          refine ⟨pre.map σ, post.map σ, ?_, ?_⟩
          · simp only [hle_cast, ↓reduceIte, h1, List.map_append, List.map_cons, List.map_nil]
          · simp only [hle_succ, ↓reduceIte, h2, List.map_append, List.map_cons, List.map_nil]
        | vertex v =>
          simp only [hst'] at hv ⊢
          obtain ⟨pre, Lv, Rv, post, h1, h2, hL, hR, hpre, hpost⟩ := hv
          have ht_v : t = D.hvert_pos v := D.hvert_only t v hst'
          have hno_end : v ≠ e₁.2 ∧ v ≠ e₂.2 := by
            constructor <;> intro hv' <;> subst hv'
            · have : t.val = (D.hvert_pos e₁.2).val := congrArg Fin.val ht_v; omega
            · have : t.val = (D.hvert_pos e₂.2).val := congrArg Fin.val ht_v; omega
          have hmap_Lv : Lv.map σ = Lv := by
            apply list_map_eq_self; intro e he
            have he2 : e.2 = v := hL e he
            exact Equiv.swap_apply_of_ne_of_ne (fun h => hno_end.1 (h ▸ he2.symm)) (fun h => hno_end.2 (h ▸ he2.symm))
          refine ⟨pre.map σ, Lv, Rv.map σ, post.map σ, ?_, ?_, hL, ?_, ?_, ?_⟩
          · simp only [hle_cast, ↓reduceIte, h1, List.map_append, hmap_Lv]
          · simp only [hle_succ, ↓reduceIte, h2, List.map_append]
          · intro e he; obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
            have he1' : e'.1 = v := hR e' he'
            by_cases ha : e' = e₁
            · subst ha; simp [σ, ← hsame, he1']
            · by_cases hb : e' = e₂
              · subst hb; simp [σ, hsame, he1']
              · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact he1'
          · intro e he; obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
            have ⟨h1', h2'⟩ := hpre e' he'
            by_cases ha : e' = e₁
            · subst ha; exact ⟨by simp [σ, ← hsame, h1'], by simp [σ]; exact hno_end.2.symm⟩
            · by_cases hb : e' = e₂
              · subst hb; exact ⟨by simp [σ, hsame, h1'], by simp [σ]; exact hno_end.1.symm⟩
              · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact ⟨h1', h2'⟩
          · intro e he; obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
            have ⟨h1', h2'⟩ := hpost e' he'
            by_cases ha : e' = e₁
            · subst ha; exact ⟨by simp [σ, ← hsame, h1'], by simp [σ]; exact hno_end.2.symm⟩
            · by_cases hb : e' = e₂
              · subst hb; exact ⟨by simp [σ, hsame, h1'], by simp [σ]; exact hno_end.1.symm⟩
              · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact ⟨h1', h2'⟩
      · by_cases heq : t = t₀
        · subst heq
          simp only [hlt, ↓reduceIte, hst] at hv ⊢
          obtain ⟨pre, post, h1, h2⟩ := hv
          have hnot_succ : ¬(t.succ.val ≤ t.val) := by simp
          have hle_cast : t.castSucc.val ≤ t.val := by simp
          simp only [hnot_succ, hle_cast, ↓reduceIte, h1, h2, List.map_append, List.map_cons, List.map_nil]
          have hnd := D.hnodup t.castSucc; rw [h1] at hnd
          have hpre_id : pre.map σ = pre := by
            apply list_map_eq_self; intro e he
            have hdisj := (List.nodup_append.mp (List.nodup_append.mp hnd).1).2.2 e he
            exact Equiv.swap_apply_of_ne_of_ne (fun h => hdisj e₁ (by simp) h) (fun h => hdisj e₂ (by simp) h)
          have hpost_id : post.map σ = post := by
            apply list_map_eq_self; intro e he
            have hdisj := (List.nodup_append.mp hnd).2.2
            exact Equiv.swap_apply_of_ne_of_ne
              (fun h => hdisj e₁ (by simp) e he h.symm)
              (fun h => hdisj e₂ (by simp) e he h.symm)
          rw [hpre_id, hpost_id]; simp [σ]
        · simp only [hlt, heq, ↓reduceIte]
          have hgt : t₀.val < t.val := by
            have : t.val ≠ t₀.val := fun h => heq (Fin.ext h)
            omega
          have h1 : ¬(t.castSucc.val ≤ t₀.val) := by simp; omega
          have h2 : ¬(t.succ.val ≤ t₀.val) := by simp; omega
          cases hst' : D.step t with
          | noop => simp only [hst'] at hv ⊢; simp only [h1, h2, ↓reduceIte]; exact hv
          | swap a b => simp only [hst'] at hv ⊢; simp only [h1, h2, ↓reduceIte]; exact hv
          | vertex v => simp only [hst'] at hv ⊢; simp only [h1, h2, ↓reduceIte]; exact hv
    hactive_iff := fun s e he => by
      split_ifs with hsle
      · simp only [List.mem_map]
        constructor
        · rintro ⟨e', he', rfl⟩
          by_cases h1 : e' = e₁
          · subst h1; simp only [σ, Equiv.swap_apply_left]
            have ⟨a, _⟩ := (D.hactive_iff s e' he1E).mp he'
            exact ⟨by rw [← hsame]; exact a, by (try dsimp); omega⟩
          · by_cases h2 : e' = e₂
            · subst h2; simp only [σ, Equiv.swap_apply_right]
              have ⟨a, _⟩ := (D.hactive_iff s e' he2E).mp he'
              exact ⟨by rw [hsame]; exact a, by (try dsimp); omega⟩
            · rw [Equiv.swap_apply_of_ne_of_ne h1 h2] at he ⊢
              exact (D.hactive_iff s e' he).mp he'
        · rintro ⟨ha, hb⟩
          by_cases h1 : e = e₁
          · subst h1
            refine ⟨e₂, (D.hactive_iff s e₂ he2E).mpr ⟨by rw [← hsame]; exact ha, by (try dsimp); omega⟩, by simp [σ]⟩
          · by_cases h2 : e = e₂
            · subst h2
              refine ⟨e₁, (D.hactive_iff s e₁ he1E).mpr ⟨by rw [hsame]; exact ha, by (try dsimp); omega⟩, by simp [σ]⟩
            · exact ⟨e, (D.hactive_iff s e he).mpr ⟨ha, hb⟩, Equiv.swap_apply_of_ne_of_ne h1 h2⟩
      · exact D.hactive_iff s e he }

lemma uncrossLeft_swaps_lt (t₀ : Fin D.L) (e₁ e₂ : DirEdge n)
    (hst : D.step t₀ = WStep.swap e₁ e₂) (hsame : e₁.1 = e₂.1) :
    (D.uncrossLeft t₀ e₁ e₂ hst hsame).numSwaps < D.numSwaps := by
  dsimp only [numSwaps]
  apply card_filter_lt_of_imp
  · intro t ht; dsimp only [uncrossLeft, isSwap] at ht ⊢
    by_cases h1 : t.val < t₀.val
    · simp only [h1, ↓reduceIte] at ht
      cases ht' : D.step t with
      | noop => simp [ht'] at ht
      | vertex _ => simp [ht'] at ht
      | swap a b => simp [ht']
    · by_cases h2 : t = t₀
      · simp [h1, h2] at ht
      · simp only [h1, ↓reduceIte] at ht; split_ifs at ht; exact ht
  · exact ⟨t₀, by simp [isSwap, hst], by simp [uncrossLeft, isSwap]⟩

/-- Symmetric: swap the labels of two edges `e₁, e₂` sharing their right endpoint `e₁.2 = e₂.2`
at all times `> t₀`, turning step `t₀` into `noop` and strictly reducing `numSwaps`. -/
def uncrossRight (t₀ : Fin D.L) (e₁ e₂ : DirEdge n) (hst : D.step t₀ = WStep.swap e₁ e₂)
    (hsame : e₁.2 = e₂.2) : WiringDiagram n E :=
  let σ : Equiv.Perm (DirEdge n) := Equiv.swap e₁ e₂
  have hv₀ := D.hstep_valid t₀
  have hact1 : e₁ ∈ D.state t₀.castSucc := by
    rw [hst] at hv₀; obtain ⟨pre, post, h1, _⟩ := hv₀; rw [h1]; simp
  have hact2 : e₂ ∈ D.state t₀.castSucc := by
    rw [hst] at hv₀; obtain ⟨pre, post, h1, _⟩ := hv₀; rw [h1]; simp
  have he1E : e₁ ∈ E := D.hmemE t₀.castSucc e₁ hact1
  have he2E : e₂ ∈ E := D.hmemE t₀.castSucc e₂ hact2
  have hlt1 : (D.hvert_pos e₁.1).val < t₀.val := ((D.hactive_iff t₀.castSucc e₁ he1E).mp hact1).1
  have hlt2 : (D.hvert_pos e₂.1).val < t₀.val := ((D.hactive_iff t₀.castSucc e₂ he2E).mp hact2).1
  { L := D.L
    state := fun s => if t₀.val < s.val then (D.state s).map σ else D.state s
    step := fun t =>
      if t₀.val < t.val then
        match D.step t with
        | WStep.noop => WStep.noop
        | WStep.vertex v => WStep.vertex v
        | WStep.swap a b => WStep.swap (σ a) (σ b)
      else if t = t₀ then WStep.noop
      else D.step t
    hE := D.hE
    hstart := by simp [D.hstart]
    hend := by simp [D.hend]
    hnodup := fun s => by split_ifs; exact (D.hnodup s).map σ.injective; exact D.hnodup s
    hmemE := fun s e he => by
      split_ifs at he
      · obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
        by_cases h1 : e' = e₁
        · subst h1; simpa [σ] using he2E
        · by_cases h2 : e' = e₂
          · subst h2; simpa [σ] using he1E
          · rw [Equiv.swap_apply_of_ne_of_ne h1 h2]; exact D.hmemE s e' he'
      · exact D.hmemE s e he
    hvert_pos := D.hvert_pos
    hvert_mono := D.hvert_mono
    hvert_step := fun v => by
      have hv_ne : D.hvert_pos v ≠ t₀ := fun h => by
        have := D.hvert_step v; rw [h, hst] at this; cases this
      by_cases h1 : t₀.val < (D.hvert_pos v).val
      · simp [h1, D.hvert_step v]
      · simp [h1, hv_ne, D.hvert_step v]
    hvert_only := fun t v h => by
      by_cases h1 : t₀.val < t.val
      · simp only [h1, ↓reduceIte] at h
        cases hst' : D.step t with
        | noop => simp [hst'] at h
        | swap _ _ => simp [hst'] at h
        | vertex v' => simp [hst'] at h; subst h; exact D.hvert_only t v' hst'
      · by_cases h2 : t = t₀
        · simp [h1, h2] at h
        · simp only [h1, h2, ↓reduceIte] at h; exact D.hvert_only t v h
    hstep_valid := fun t => by
      have hv := D.hstep_valid t
      by_cases hgt : t₀.val < t.val
      · simp only [hgt, ↓reduceIte]
        have hgt_cast : t₀.val < t.castSucc.val := by simp; omega
        have hgt_succ : t₀.val < t.succ.val := by simp; omega
        cases hst' : D.step t with
        | noop => simp only [hst'] at hv ⊢; simp only [hgt_cast, hgt_succ, ↓reduceIte, hv]
        | swap a b =>
          simp only [hst'] at hv ⊢
          obtain ⟨pre, post, h1, h2⟩ := hv
          refine ⟨pre.map σ, post.map σ, ?_, ?_⟩
          · simp only [hgt_cast, ↓reduceIte, h1, List.map_append, List.map_cons, List.map_nil]
          · simp only [hgt_succ, ↓reduceIte, h2, List.map_append, List.map_cons, List.map_nil]
        | vertex v =>
          simp only [hst'] at hv ⊢
          obtain ⟨pre, Lv, Rv, post, h1, h2, hL, hR, hpre, hpost⟩ := hv
          have ht_v : t = D.hvert_pos v := D.hvert_only t v hst'
          have hno_start : v ≠ e₁.1 ∧ v ≠ e₂.1 := by
            constructor <;> intro hv' <;> subst hv'
            · have : t.val = (D.hvert_pos e₁.1).val := congrArg Fin.val ht_v; omega
            · have : t.val = (D.hvert_pos e₂.1).val := congrArg Fin.val ht_v; omega
          have hmap_Rv : Rv.map σ = Rv := by
            apply list_map_eq_self; intro e he
            have he1 : e.1 = v := hR e he
            exact Equiv.swap_apply_of_ne_of_ne (fun h => hno_start.1 (h ▸ he1.symm)) (fun h => hno_start.2 (h ▸ he1.symm))
          refine ⟨pre.map σ, Lv.map σ, Rv, post.map σ, ?_, ?_, ?_, hR, ?_, ?_⟩
          · simp only [hgt_cast, ↓reduceIte, h1, List.map_append]
          · simp only [hgt_succ, ↓reduceIte, h2, List.map_append, hmap_Rv]
          · intro e he; obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
            have he2' : e'.2 = v := hL e' he'
            by_cases ha : e' = e₁
            · subst ha; simp [σ, ← hsame, he2']
            · by_cases hb : e' = e₂
              · subst hb; simp [σ, hsame, he2']
              · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact he2'
          · intro e he; obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
            have ⟨h1', h2'⟩ := hpre e' he'
            by_cases ha : e' = e₁
            · subst ha; exact ⟨by simp [σ]; exact hno_start.2.symm, by simp [σ, ← hsame, h2']⟩
            · by_cases hb : e' = e₂
              · subst hb; exact ⟨by simp [σ]; exact hno_start.1.symm, by simp [σ, hsame, h2']⟩
              · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact ⟨h1', h2'⟩
          · intro e he; obtain ⟨e', he', rfl⟩ := List.mem_map.mp he
            have ⟨h1', h2'⟩ := hpost e' he'
            by_cases ha : e' = e₁
            · subst ha; exact ⟨by simp [σ]; exact hno_start.2.symm, by simp [σ, ← hsame, h2']⟩
            · by_cases hb : e' = e₂
              · subst hb; exact ⟨by simp [σ]; exact hno_start.1.symm, by simp [σ, hsame, h2']⟩
              · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact ⟨h1', h2'⟩
      · by_cases heq : t = t₀
        · subst heq
          simp only [hgt, ↓reduceIte, hst] at hv ⊢
          obtain ⟨pre, post, h1, h2⟩ := hv
          have hgt_succ : t.val < t.succ.val := by simp
          have hnot_cast : ¬(t.val < t.castSucc.val) := by simp
          simp only [hgt_succ, hnot_cast, ↓reduceIte, h1, h2, List.map_append, List.map_cons, List.map_nil]
          have hnd := D.hnodup t.succ; rw [h2] at hnd
          have hpre_id : pre.map σ = pre := by
            apply list_map_eq_self; intro e he
            have hdisj := (List.nodup_append.mp (List.nodup_append.mp hnd).1).2.2 e he
            exact Equiv.swap_apply_of_ne_of_ne (fun h => hdisj e₁ (by simp) h) (fun h => hdisj e₂ (by simp) h)
          have hpost_id : post.map σ = post := by
            apply list_map_eq_self; intro e he
            have hdisj := (List.nodup_append.mp hnd).2.2
            exact Equiv.swap_apply_of_ne_of_ne
              (fun h => hdisj e₁ (by simp) e he h.symm)
              (fun h => hdisj e₂ (by simp) e he h.symm)
          rw [hpre_id, hpost_id]; simp [σ]
        · simp only [hgt, heq, ↓reduceIte]
          have hlt : t.val < t₀.val := by
            have : t.val ≠ t₀.val := fun h => heq (Fin.ext h)
            omega
          have h1 : ¬(t₀.val < t.castSucc.val) := by simp; omega
          have h2 : ¬(t₀.val < t.succ.val) := by simp; omega
          cases hst' : D.step t with
          | noop => simp only [hst'] at hv ⊢; simp only [h1, h2, ↓reduceIte]; exact hv
          | swap a b => simp only [hst'] at hv ⊢; simp only [h1, h2, ↓reduceIte]; exact hv
          | vertex v => simp only [hst'] at hv ⊢; simp only [h1, h2, ↓reduceIte]; exact hv
    hactive_iff := fun s e he => by
      split_ifs with hsgt
      · simp only [List.mem_map]
        constructor
        · rintro ⟨e', he', rfl⟩
          by_cases h1 : e' = e₁
          · subst h1; simp only [σ, Equiv.swap_apply_left]
            have ⟨_, b⟩ := (D.hactive_iff s e' he1E).mp he'
            exact ⟨by omega, by rw [← hsame]; exact b⟩
          · by_cases h2 : e' = e₂
            · subst h2; simp only [σ, Equiv.swap_apply_right]
              have ⟨_, b⟩ := (D.hactive_iff s e' he2E).mp he'
              exact ⟨by omega, by rw [hsame]; exact b⟩
            · rw [Equiv.swap_apply_of_ne_of_ne h1 h2] at he ⊢
              exact (D.hactive_iff s e' he).mp he'
        · rintro ⟨ha, hb⟩
          by_cases h1 : e = e₁
          · subst h1
            refine ⟨e₂, (D.hactive_iff s e₂ he2E).mpr ⟨by omega, by rw [← hsame]; exact hb⟩, by simp [σ]⟩
          · by_cases h2 : e = e₂
            · subst h2
              refine ⟨e₁, (D.hactive_iff s e₁ he1E).mpr ⟨by omega, by rw [hsame]; exact hb⟩, by simp [σ]⟩
            · exact ⟨e, (D.hactive_iff s e he).mpr ⟨ha, hb⟩, Equiv.swap_apply_of_ne_of_ne h1 h2⟩
      · exact D.hactive_iff s e he }

lemma uncrossRight_swaps_lt (t₀ : Fin D.L) (e₁ e₂ : DirEdge n)
    (hst : D.step t₀ = WStep.swap e₁ e₂) (hsame : e₁.2 = e₂.2) :
    (D.uncrossRight t₀ e₁ e₂ hst hsame).numSwaps < D.numSwaps := by
  dsimp only [numSwaps]
  apply card_filter_lt_of_imp
  · intro t ht; dsimp only [uncrossRight, isSwap] at ht ⊢
    by_cases h1 : t₀.val < t.val
    · simp only [h1, ↓reduceIte] at ht
      cases ht' : D.step t with
      | noop => simp [ht'] at ht
      | vertex _ => simp [ht'] at ht
      | swap a b => simp [ht']
    · by_cases h2 : t = t₀
      · simp [h1, h2] at ht
      · simp only [h1, ↓reduceIte] at ht; split_ifs at ht; exact ht
  · exact ⟨t₀, by simp [isSwap, hst], by simp [uncrossRight, isSwap]⟩

/-- Existence of a diagram for `(n, E)` with at most `D.numSwaps` swaps in which every swap
involves two vertex-disjoint edges (4 distinct endpoints). -/
lemma exists_disjoint_swaps :
    ∃ D' : WiringDiagram n E, D'.numSwaps ≤ D.numSwaps ∧
      ∀ t : Fin D'.L, ∀ e₁ e₂, D'.step t = WStep.swap e₁ e₂ →
        ({e₁.1, e₁.2, e₂.1, e₂.2} : Finset (Fin n)).card = 4 := by
  generalize hk : D.numSwaps = k
  induction k using Nat.strong_induction_on generalizing D with
  | _ k ih =>
    by_cases hgood : ∀ t : Fin D.L, ∀ e₁ e₂, D.step t = WStep.swap e₁ e₂ →
        e₁.1 ≠ e₂.1 ∧ e₁.2 ≠ e₂.2
    · refine ⟨D, hk.le, fun t e₁ e₂ hst => ?_⟩
      have ⟨h11, h22⟩ := hgood t e₁ e₂ hst
      have hv := D.hstep_valid t; rw [hst] at hv
      obtain ⟨pre, post, h1, _⟩ := hv
      have hact1 : e₁ ∈ D.state t.castSucc := by rw [h1]; simp
      have hact2 : e₂ ∈ D.state t.castSucc := by rw [h1]; simp
      have he1E := D.hmemE t.castSucc e₁ hact1
      have he2E := D.hmemE t.castSucc e₂ hact2
      have ⟨a1, b1⟩ := (D.hactive_iff t.castSucc e₁ he1E).mp hact1
      have ⟨a2, b2⟩ := (D.hactive_iff t.castSucc e₂ he2E).mp hact2
      have h12 : e₁.1 ≠ e₁.2 := (D.hE e₁ he1E).ne
      have h34 : e₂.1 ≠ e₂.2 := (D.hE e₂ he2E).ne
      have h14 : e₁.1 ≠ e₂.2 := fun h => by rw [h] at a1; omega
      have h23 : e₁.2 ≠ e₂.1 := fun h => by rw [h] at b1; omega
      rw [card_insert_of_notMem, card_insert_of_notMem, card_insert_of_notMem, card_singleton]
      · simp [h34]
      · simp [h23, h22]
      · simp [h12, h11, h14]
    · push Not at hgood
      obtain ⟨t₀, e₁, e₂, hst, hbad⟩ := hgood
      by_cases h1 : e₁.1 = e₂.1
      · let D₁ := D.uncrossLeft t₀ e₁ e₂ hst h1
        have hlt := D.uncrossLeft_swaps_lt t₀ e₁ e₂ hst h1
        obtain ⟨D', hle, hd⟩ := ih D₁.numSwaps (hk ▸ hlt) D₁ rfl
        exact ⟨D', hle.trans (hk ▸ hlt.le), hd⟩
      · have h2 : e₁.2 = e₂.2 := by tauto
        let D₁ := D.uncrossRight t₀ e₁ e₂ hst h2
        have hlt := D.uncrossRight_swaps_lt t₀ e₁ e₂ hst h2
        obtain ⟨D', hle, hd⟩ := ih D₁.numSwaps (hk ▸ hlt) D₁ rfl
        exact ⟨D', hle.trans (hk ▸ hlt.le), hd⟩

set_option maxHeartbeats 400000 in
private lemma crossing_alg (n m K k : ℕ) (hn : 8 ≤ n) (hm : 0 < m) (hk8 : 8 ≤ k) (hkn : k ≤ n)
    (hk_def : k = 4 * n * n / m)
    (hsum : m * Nat.choose (n - 2) (k - 2) ≤ Nat.choose n k * (3 * k) + K * Nat.choose (n - 4) (k - 4)) :
    m ^ 3 ≤ 512 * n ^ 2 * K := by
  have hreal : (m : ℝ) * (Nat.choose (n - 2) (k - 2) : ℝ) ≤
      (Nat.choose n k : ℝ) * (3 * (k : ℝ)) + (K : ℝ) * (Nat.choose (n - 4) (k - 4) : ℝ) := by
    exact_mod_cast hsum
  have hbin1 : ∀ a b : ℕ, 1 ≤ a → 1 ≤ b → b * Nat.choose a b = a * Nat.choose (a - 1) (b - 1) := by
    have haux : ∀ a b : ℕ, (b + 1) * Nat.choose (a + 1) (b + 1) = (a + 1) * Nat.choose a b := by
      intro a; induction a with
      | zero =>
        intro b; cases b with
        | zero => simp
        | succ b => simp [Nat.choose_eq_zero_of_lt]
      | succ a ih =>
        intro b
        cases b with
        | zero => simp
        | succ b =>
          have h1 := ih b
          have h2 := ih (b + 1)
          have h3 := Nat.choose_succ_succ (a + 1) (b + 1)
          have h4 := Nat.choose_succ_succ a b
          nlinarith
    intro a b ha hb
    cases a with
    | zero => omega
    | succ a =>
      cases b with
      | zero => omega
      | succ b => exact haux a b
  have hid1 : (k : ℝ) * ((k : ℝ) - 1) * (Nat.choose n k : ℝ) =
      (n : ℝ) * ((n : ℝ) - 1) * (Nat.choose (n - 2) (k - 2) : ℝ) := by
    have h1 : k * (k - 1) * Nat.choose n k = n * (n - 1) * Nat.choose (n - 2) (k - 2) := by
      have ha := hbin1 n k (by omega) (by omega)
      have hb := hbin1 (n - 1) (k - 1) (by omega) (by omega)
      have hc : (n - 1) - 1 = n - 2 := by omega
      have hd : (k - 1) - 1 = k - 2 := by omega
      rw [hc, hd] at hb
      calc k * (k - 1) * Nat.choose n k
          = (k - 1) * (k * Nat.choose n k) := by ring
        _ = (k - 1) * (n * Nat.choose (n - 1) (k - 1)) := by rw [ha]
        _ = n * ((k - 1) * Nat.choose (n - 1) (k - 1)) := by ring
        _ = n * ((n - 1) * Nat.choose (n - 2) (k - 2)) := by rw [hb]
        _ = n * (n - 1) * Nat.choose (n - 2) (k - 2) := by ring
    have h1r : ((k * (k - 1) * Nat.choose n k : ℕ) : ℝ) = ((n * (n - 1) * Nat.choose (n - 2) (k - 2) : ℕ) : ℝ) :=
      congrArg Nat.cast h1
    push_cast [Nat.cast_sub (show 1 ≤ k by omega), Nat.cast_sub (show 1 ≤ n by omega)] at h1r
    exact h1r
  have hid2 : ((k : ℝ) - 2) * ((k : ℝ) - 3) * (Nat.choose (n - 2) (k - 2) : ℝ) =
      ((n : ℝ) - 2) * ((n : ℝ) - 3) * (Nat.choose (n - 4) (k - 4) : ℝ) := by
    have h2 : (k - 2) * (k - 3) * Nat.choose (n - 2) (k - 2) =
        (n - 2) * (n - 3) * Nat.choose (n - 4) (k - 4) := by
      have ha := hbin1 (n - 2) (k - 2) (by omega) (by omega)
      have hb := hbin1 (n - 3) (k - 3) (by omega) (by omega)
      have hc1 : (n - 2) - 1 = n - 3 := by omega
      have hd1 : (k - 2) - 1 = k - 3 := by omega
      have hc2 : (n - 3) - 1 = n - 4 := by omega
      have hd2 : (k - 3) - 1 = k - 4 := by omega
      rw [hc1, hd1] at ha; rw [hc2, hd2] at hb
      calc (k - 2) * (k - 3) * Nat.choose (n - 2) (k - 2)
          = (k - 3) * ((k - 2) * Nat.choose (n - 2) (k - 2)) := by ring
        _ = (k - 3) * ((n - 2) * Nat.choose (n - 3) (k - 3)) := by rw [ha]
        _ = (n - 2) * ((k - 3) * Nat.choose (n - 3) (k - 3)) := by ring
        _ = (n - 2) * ((n - 3) * Nat.choose (n - 4) (k - 4)) := by rw [hb]
        _ = (n - 2) * (n - 3) * Nat.choose (n - 4) (k - 4) := by ring
    have h2r : (((k - 2) * (k - 3) * Nat.choose (n - 2) (k - 2) : ℕ) : ℝ) =
        (((n - 2) * (n - 3) * Nat.choose (n - 4) (k - 4) : ℕ) : ℝ) := congrArg Nat.cast h2
    push_cast [Nat.cast_sub (show 2 ≤ k by omega), Nat.cast_sub (show 3 ≤ k by omega),
      Nat.cast_sub (show 2 ≤ n by omega), Nat.cast_sub (show 3 ≤ n by omega)] at h2r
    exact h2r
  have hch_pos : (0 : ℝ) < (Nat.choose (n - 2) (k - 2) : ℝ) := by
    exact_mod_cast Nat.choose_pos (show k - 2 ≤ n - 2 by omega)
  have hkr : (8 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk8
  have hnr : (8 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hk_le_nr : (k : ℝ) ≤ (n : ℝ) := by exact_mod_cast hkn
  have hratio1 : (Nat.choose n k : ℝ) * (3 * (k : ℝ)) ≤
      (3 * (n : ℝ) * (n : ℝ) / ((k : ℝ) - 1)) * (Nat.choose (n - 2) (k - 2) : ℝ) := by
    have hk0 : (0 : ℝ) < (k : ℝ) * ((k : ℝ) - 1) := by nlinarith
    have h1 : (Nat.choose n k : ℝ) = ((n : ℝ) * ((n : ℝ) - 1) / ((k : ℝ) * ((k : ℝ) - 1))) *
        (Nat.choose (n - 2) (k - 2) : ℝ) := by
      rw [div_mul_eq_mul_div, eq_div_iff hk0.ne']; linarith
    rw [h1]
    have hle : (n : ℝ) * ((n : ℝ) - 1) / ((k : ℝ) * ((k : ℝ) - 1)) * (3 * (k : ℝ)) ≤
        3 * (n : ℝ) * (n : ℝ) / ((k : ℝ) - 1) := by
      have hk1 : (0 : ℝ) < (k : ℝ) - 1 := by linarith
      rw [div_mul_eq_mul_div, div_le_div_iff₀ hk0 hk1]
      nlinarith
    nlinarith
  have hratio2 : (Nat.choose (n - 4) (k - 4) : ℝ) ≤
      ((k : ℝ) ^ 2 / (n : ℝ) ^ 2) * (Nat.choose (n - 2) (k - 2) : ℝ) := by
    have hn23 : (0 : ℝ) < ((n : ℝ) - 2) * ((n : ℝ) - 3) := by nlinarith
    have h2 : (Nat.choose (n - 4) (k - 4) : ℝ) =
        (((k : ℝ) - 2) * ((k : ℝ) - 3) / (((n : ℝ) - 2) * ((n : ℝ) - 3))) *
          (Nat.choose (n - 2) (k - 2) : ℝ) := by
      rw [div_mul_eq_mul_div, eq_div_iff hn23.ne']; linarith
    rw [h2]
    have hle : ((k : ℝ) - 2) * ((k : ℝ) - 3) / (((n : ℝ) - 2) * ((n : ℝ) - 3)) ≤
        (k : ℝ) ^ 2 / (n : ℝ) ^ 2 := by
      rw [div_le_div_iff₀ hn23 (by positivity)]
      have hdiff : (k : ℝ) ^ 2 * (((n : ℝ) - 2) * ((n : ℝ) - 3)) - ((k : ℝ) - 2) * ((k : ℝ) - 3) * (n : ℝ) ^ 2 =
          ((n : ℝ) - (k : ℝ)) * (5 * (k : ℝ) * (n : ℝ) - 6 * (n : ℝ) - 6 * (k : ℝ)) := by ring
      have hge0 : 0 ≤ ((n : ℝ) - (k : ℝ)) * (5 * (k : ℝ) * (n : ℝ) - 6 * (n : ℝ) - 6 * (k : ℝ)) :=
        mul_nonneg (by linarith) (by nlinarith)
      linarith
    nlinarith
  have hcomb : (m : ℝ) ≤ 3 * (n : ℝ) * (n : ℝ) / ((k : ℝ) - 1) +
      (K : ℝ) * ((k : ℝ) ^ 2 / (n : ℝ) ^ 2) := by
    have hmul : (m : ℝ) * (Nat.choose (n - 2) (k - 2) : ℝ) ≤
        (3 * (n : ℝ) * (n : ℝ) / ((k : ℝ) - 1) + (K : ℝ) * ((k : ℝ) ^ 2 / (n : ℝ) ^ 2)) *
          (Nat.choose (n - 2) (k - 2) : ℝ) := by
      have hsw_nn : (0 : ℝ) ≤ (K : ℝ) := Nat.cast_nonneg _
      nlinarith
    exact le_of_mul_le_mul_right hmul hch_pos
  have hk_mul_le : (k : ℝ) * (m : ℝ) ≤ 4 * (n : ℝ) ^ 2 := by
    have h1 : k * m ≤ 4 * n * n := hk_def ▸ Nat.div_mul_le_self (4 * n * n) m
    have h1r : ((k * m : ℕ) : ℝ) ≤ ((4 * n * n : ℕ) : ℝ) := by exact_mod_cast h1
    push_cast at h1r; linarith
  have hk_mul_gt : 4 * (n : ℝ) ^ 2 ≤ ((k : ℝ) + 1) * (m : ℝ) := by
    have h1 : 4 * n * n < (k + 1) * m := by
      have := Nat.lt_div_mul_add hm (a := 4 * n * n)
      rw [hk_def]; nlinarith
    have h1r : ((4 * n * n : ℕ) : ℝ) ≤ (((k + 1) * m : ℕ) : ℝ) := by exact_mod_cast h1.le
    push_cast at h1r; linarith
  have hterm1 : 3 * (n : ℝ) * (n : ℝ) / ((k : ℝ) - 1) ≤ (27 / 28 : ℝ) * (m : ℝ) := by
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < (k : ℝ) - 1)]
    have h97 : 7 * ((k : ℝ) + 1) ≤ 9 * ((k : ℝ) - 1) := by linarith
    have hm_nn : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg _
    nlinarith
  have hrem : (1 / 28 : ℝ) * (m : ℝ) ≤ (K : ℝ) * ((k : ℝ) ^ 2 / (n : ℝ) ^ 2) := by linarith
  have hk2_le : (k : ℝ) ^ 2 / (n : ℝ) ^ 2 ≤ 16 * (n : ℝ) ^ 2 / (m : ℝ) ^ 2 := by
    have hm_pos_r : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have : ((k : ℝ) * (m : ℝ)) ^ 2 ≤ (4 * (n : ℝ) ^ 2) ^ 2 :=
      pow_le_pow_left₀ (by positivity) hk_mul_le 2
    nlinarith
  have hfinal_r : (m : ℝ) ^ 3 ≤ 512 * (n : ℝ) ^ 2 * (K : ℝ) := by
    have hsw_nn : (0 : ℝ) ≤ (K : ℝ) := Nat.cast_nonneg _
    have h1 : (1 / 28 : ℝ) * (m : ℝ) ≤ (K : ℝ) * (16 * (n : ℝ) ^ 2 / (m : ℝ) ^ 2) :=
      hrem.trans (mul_le_mul_of_nonneg_left hk2_le hsw_nn)
    have hm_pos_r : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
    have h2 : (1 / 28 : ℝ) * (m : ℝ) ^ 3 ≤ (K : ℝ) * (16 * (n : ℝ) ^ 2) := by
      have hmul := mul_le_mul_of_nonneg_right h1 (sq_nonneg (m : ℝ))
      have hcancel : (K : ℝ) * (16 * (n : ℝ) ^ 2 / (m : ℝ) ^ 2) * (m : ℝ) ^ 2 = (K : ℝ) * (16 * (n : ℝ) ^ 2) := by
        rw [mul_assoc, div_mul_cancel₀ _ (pow_ne_zero 2 hm_pos_r.ne')]
      linarith
    have hnn : (0 : ℝ) ≤ (n : ℝ) ^ 2 * (K : ℝ) := mul_nonneg (sq_nonneg _) hsw_nn
    linarith
  exact_mod_cast hfinal_r

/-- Crossing Number Inequality for discrete wiring diagrams:
if `4 * n ≤ E.card`, then `E.card ^ 3 ≤ 512 * n ^ 2 * D.numSwaps`. -/
theorem crossing_number_ineq (h4 : 4 * n ≤ E.card) :
    E.card ^ 3 ≤ 512 * n ^ 2 * D.numSwaps := by
  obtain ⟨D', hsw_le, hdisj⟩ := D.exists_disjoint_swaps
  suffices h : E.card ^ 3 ≤ 512 * n ^ 2 * D'.numSwaps by nlinarith
  have hE_upper : 2 * E.card ≤ n * n := by
    let Erev : Finset (DirEdge n) := E.image Prod.swap
    have hdisjE : Disjoint E Erev := by
      rw [disjoint_left]; intro e he1 he2
      obtain ⟨e', he', heq⟩ := mem_image.mp he2
      have h1 := D'.hE e he1
      have h2 := D'.hE e' he'
      rw [← heq] at h1; exact lt_asymm h1 h2
    have hcard_rev : Erev.card = E.card := card_image_of_injective E Prod.swap_injective
    have hunion : (E ∪ Erev).card ≤ (univ : Finset (Fin n × Fin n)).card := card_le_card (subset_univ _)
    rw [card_union_of_disjoint hdisjE, hcard_rev, card_univ, Fintype.card_prod, Fintype.card_fin] at hunion
    omega
  by_cases hn0 : n = 0
  · subst hn0
    have hE0 : E = ∅ := by ext e; exact Fin.elim0 e.1
    simp [hE0]
  have hn1 : 1 ≤ n := Nat.pos_of_ne_zero hn0
  have hn_pos : 8 ≤ n := by nlinarith
  let k : ℕ := 4 * n * n / E.card
  have hE_pos : 0 < E.card := by omega
  have hk_ge8 : 8 ≤ k := (Nat.le_div_iff_mul_le hE_pos).mpr (by nlinarith)
  have hk_le_n : k ≤ n := (Nat.div_le_iff_le_mul_add_pred hE_pos).mpr (by nlinarith)
  let ES (S : Finset (Fin n)) : Finset (DirEdge n) := E.filter fun e => e.1 ∈ S ∧ e.2 ∈ S
  have hS_bound : ∀ S ∈ (univ : Finset (Fin n)).powersetCard k,
      (ES S).card ≤ 3 * k + (D'.restrict (ES S) (filter_subset _ E)).numSwaps := by
    intro S hS
    have hcardS : S.card = k := (mem_powersetCard.mp hS).2
    rw [← hcardS]
    exact (D'.restrict (ES S) (filter_subset _ E)).edges_le_three_card_add_swaps S
      (fun e he => (mem_filter.mp he).2)
  have hsum := Finset.sum_le_sum hS_bound
  rw [Finset.sum_add_distrib, sum_const, card_powersetCard, card_univ, Fintype.card_fin, smul_eq_mul] at hsum
  have hcount_sup : ∀ (A : Finset (Fin n)), A.card ≤ k →
      (((univ : Finset (Fin n)).powersetCard k).filter fun S => A ⊆ S).card =
        Nat.choose (n - A.card) (k - A.card) := by
    intro A hAk
    have hbij : (((univ : Finset (Fin n)).powersetCard k).filter fun S => A ⊆ S).card =
        ((univ \ A).powersetCard (k - A.card)).card := by
      apply Finset.card_bij (fun S _ => S \ A)
      · intro S hS
        rw [mem_filter, mem_powersetCard] at hS
        rw [mem_powersetCard]
        refine ⟨by intro x hx; rw [mem_sdiff] at hx ⊢; exact ⟨mem_univ x, hx.2⟩, ?_⟩
        rw [card_sdiff_of_subset hS.2, hS.1.2]
      · intro S₁ hS₁ S₂ hS₂ heq
        have h1 := (mem_filter.mp hS₁).2
        have h2 := (mem_filter.mp hS₂).2
        rw [← sdiff_union_of_subset h1, ← sdiff_union_of_subset h2, heq]
      · intro T hT
        rw [mem_powersetCard] at hT
        have hdisjTA : Disjoint T A := by
          rw [disjoint_left]; intro x hx; exact (mem_sdiff.mp (hT.1 hx)).2
        refine ⟨T ∪ A, mem_filter.mpr ⟨mem_powersetCard.mpr ⟨subset_univ _, ?_⟩, subset_union_right⟩, ?_⟩
        · rw [card_union_of_disjoint hdisjTA, hT.2]; omega
        · exact union_sdiff_cancel_right hdisjTA
    rw [hbij, card_powersetCard, card_sdiff_of_subset (subset_univ A), card_univ, Fintype.card_fin]
  have hsum_ES : ∑ S ∈ (univ : Finset (Fin n)).powersetCard k, (ES S).card =
      E.card * Nat.choose (n - 2) (k - 2) := by
    simp only [ES, card_filter]
    rw [Finset.sum_comm]
    calc ∑ e ∈ E, ∑ S ∈ (univ : Finset (Fin n)).powersetCard k, (if e.1 ∈ S ∧ e.2 ∈ S then 1 else 0)
        = ∑ e ∈ E, (((univ : Finset (Fin n)).powersetCard k).filter fun S => ({e.1, e.2} : Finset (Fin n)) ⊆ S).card := by
            apply sum_congr rfl; intro e _
            rw [← card_filter]; congr 1; ext S; simp [insert_subset_iff]
      _ = ∑ e ∈ E, Nat.choose (n - 2) (k - 2) := by
            apply sum_congr rfl; intro e he
            have h2 : ({e.1, e.2} : Finset (Fin n)).card = 2 := by rw [card_pair (D'.hE e he).ne]
            rw [hcount_sup _ (by omega), h2]
      _ = E.card * Nat.choose (n - 2) (k - 2) := by rw [sum_const, smul_eq_mul]
  have hsum_sw : ∑ S ∈ (univ : Finset (Fin n)).powersetCard k,
      (D'.restrict (ES S) (filter_subset _ E)).numSwaps =
      D'.numSwaps * Nat.choose (n - 4) (k - 4) := by
    simp only [numSwaps, card_filter]
    change (∑ S ∈ (univ : Finset (Fin n)).powersetCard k,
      ∑ t : Fin D'.L, if (D'.restrict (ES S) (filter_subset _ E)).isSwap t = true then 1 else 0) = _
    rw [Finset.sum_comm]
    have hterm : ∀ t : Fin D'.L,
        (∑ S ∈ (univ : Finset (Fin n)).powersetCard k,
          if (D'.restrict (ES S) (filter_subset _ E)).isSwap t = true then 1 else 0) =
        if D'.isSwap t = true then Nat.choose (n - 4) (k - 4) else 0 := by
      intro t
      cases hst : D'.step t with
      | noop => simp [restrict, isSwap, hst]
      | vertex _ => simp [restrict, isSwap, hst]
      | swap e₁ e₂ =>
        have h4c := hdisj t e₁ e₂ hst
        have hv := D'.hstep_valid t; rw [hst] at hv
        obtain ⟨pre, post, h1, _⟩ := hv
        have he1E : e₁ ∈ E := D'.hmemE t.castSucc e₁ (by rw [h1]; simp)
        have he2E : e₂ ∈ E := D'.hmemE t.castSucc e₂ (by rw [h1]; simp)
        simp only [isSwap, hst, ↓reduceIte]
        have heq_f : ∀ S : Finset (Fin n),
            ((D'.restrict (ES S) (filter_subset _ E)).isSwap t = true) ↔
              ({e₁.1, e₁.2, e₂.1, e₂.2} : Finset (Fin n)) ⊆ S := by
          intro S
          simp only [restrict, isSwap, hst, ES, mem_filter, he1E, he2E, true_and]
          split_ifs with h
          · simp [insert_subset_iff, h.1.1, h.1.2, h.2.1, h.2.2]
          · simp only [Bool.false_eq_true, false_iff, insert_subset_iff, singleton_subset_iff]
            intro ⟨a, b, c, d⟩; exact h ⟨⟨a, b⟩, ⟨c, d⟩⟩
        calc ∑ S ∈ (univ : Finset (Fin n)).powersetCard k,
              (if (D'.restrict (ES S) (filter_subset _ E)).isSwap t = true then 1 else 0)
            = (((univ : Finset (Fin n)).powersetCard k).filter fun S =>
                ({e₁.1, e₁.2, e₂.1, e₂.2} : Finset (Fin n)) ⊆ S).card := by
                rw [← card_filter]; congr 1; ext S; simp [heq_f S]
          _ = Nat.choose (n - 4) (k - 4) := by rw [hcount_sup _ (by omega), h4c]
    simp_rw [hterm, ← Finset.sum_filter, sum_const, smul_eq_mul]; simp
  rw [hsum_ES, hsum_sw] at hsum
  exact crossing_alg n E.card D'.numSwaps k hn_pos hE_pos hk_ge8 hk_le_n rfl hsum

end WiringDiagram

/-! ### Part 2: Geometry of Circles, Bubble-Sort Swaps, and Generic Rotation -/

open scoped EuclideanGeometry

private lemma dist_sq_eq (p q : ℝ²) :
    dist p q ^ 2 = (p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 := by
  rw [EuclideanSpace.dist_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_two]
  simp [Real.dist_eq, sq_abs]

/-- A non-degenerate quadratic `a * y^2 + b * y + c = 0` (`a ≠ 0`) has at most 2 real roots. -/
private lemma card_quad_roots_le_two {a b c : ℝ} (ha : a ≠ 0) (S : Finset ℝ)
    (hS : ∀ y ∈ S, a * y ^ 2 + b * y + c = 0) : S.card ≤ 2 := by
  by_contra hgt
  push Not at hgt
  obtain ⟨y₁, hy1⟩ := Finset.card_pos.mp (by omega : 0 < S.card)
  obtain ⟨y₂, hy2⟩ := Finset.card_pos.mp (by rw [card_erase_of_mem hy1]; omega : 0 < (S.erase y₁).card)
  obtain ⟨y₃, hy3⟩ := Finset.card_pos.mp (by
    rw [card_erase_of_mem hy2, card_erase_of_mem hy1]; omega : 0 < ((S.erase y₁).erase y₂).card)
  have hy2S : y₂ ∈ S := mem_of_mem_erase hy2
  have hy3S : y₃ ∈ S := mem_of_mem_erase (mem_of_mem_erase hy3)
  have h12 : y₂ ≠ y₁ := ne_of_mem_erase hy2
  have h13 : y₃ ≠ y₁ := ne_of_mem_erase (mem_of_mem_erase hy3)
  have h23 : y₃ ≠ y₂ := ne_of_mem_erase hy3
  have e1 := hS y₁ hy1
  have e2 := hS y₂ hy2S
  have e3 := hS y₃ hy3S
  have hmul1 : (y₂ - y₁) * (a * (y₂ + y₁) + b) = 0 := by linear_combination e2 - e1
  have hmul2 : (y₃ - y₁) * (a * (y₃ + y₁) + b) = 0 := by linear_combination e3 - e1
  have hlin1 : a * (y₂ + y₁) + b = 0 := (mul_eq_zero.mp hmul1).resolve_left (sub_ne_zero.mpr h12)
  have hlin2 : a * (y₃ + y₁) + b = 0 := (mul_eq_zero.mp hmul2).resolve_left (sub_ne_zero.mpr h13)
  have hmul3 : a * (y₃ - y₂) = 0 := by linear_combination hlin2 - hlin1
  exact sub_ne_zero.mpr h23 ((mul_eq_zero.mp hmul3).resolve_left ha)

/-- Two circles in `ℝ²` with distinct centers intersect in at most 2 points. -/
private lemma two_circles_inter_le_two {x₁ x₂ : ℝ²} (hne : x₁ ≠ x₂) (r₁ r₂ : ℝ)
    (S : Finset ℝ²) (hS : ∀ p ∈ S, dist x₁ p = r₁ ∧ dist x₂ p = r₂) : S.card ≤ 2 := by
  have hdx_or_dy : x₂ 0 - x₁ 0 ≠ 0 ∨ x₂ 1 - x₁ 1 ≠ 0 := by
    by_contra h
    push Not at h
    apply hne; ext i; fin_cases i
    · change x₁ 0 = x₂ 0; linarith
    · change x₁ 1 = x₂ 1; linarith
  have hsq : ∀ p ∈ S,
      (p 0 - x₁ 0) ^ 2 + (p 1 - x₁ 1) ^ 2 = r₁ ^ 2 ∧
      (p 0 - x₂ 0) ^ 2 + (p 1 - x₂ 1) ^ 2 = r₂ ^ 2 := by
    intro p hp
    have ⟨h1, h2⟩ := hS p hp
    constructor
    · rw [← h1, dist_comm, dist_sq_eq]
    · rw [← h2, dist_comm, dist_sq_eq]
  -- Linear relation: 2 * (x₂ 0 - x₁ 0) * p 0 + 2 * (x₂ 1 - x₁ 1) * p 1 = K
  let K : ℝ := r₁ ^ 2 - r₂ ^ 2 + (x₂ 0 ^ 2 - x₁ 0 ^ 2) + (x₂ 1 ^ 2 - x₁ 1 ^ 2)
  have hlin : ∀ p ∈ S, 2 * (x₂ 0 - x₁ 0) * p 0 + 2 * (x₂ 1 - x₁ 1) * p 1 = K := by
    intro p hp
    have ⟨h1, h2⟩ := hsq p hp
    dsimp only [K]; linear_combination h1 - h2
  rcases hdx_or_dy with hdx | hdy
  · -- Express p 0 in terms of p 1; projection p ↦ p 1 is injective on S
    have hinj : Set.InjOn (fun p : ℝ² => p 1) (S : Set ℝ²) := by
      intro p hp q hq heq
      have hp1 := hlin p hp
      have hq1 := hlin q hq
      have h0 : 2 * (x₂ 0 - x₁ 0) * (p 0 - q 0) = 0 := by linear_combination hp1 - hq1 - 2 * (x₂ 1 - x₁ 1) * heq
      have hpq0 : p 0 = q 0 := sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_left (mul_ne_zero two_ne_zero hdx))
      ext i; fin_cases i
      · exact hpq0
      · exact heq
    rw [← card_image_of_injOn hinj]
    let d := 2 * (x₂ 0 - x₁ 0)
    have hd : d ≠ 0 := mul_ne_zero two_ne_zero hdx
    let A0 : ℝ := (2 * (x₂ 1 - x₁ 1)) ^ 2 + d ^ 2
    let B0 : ℝ := -2 * (2 * (x₂ 1 - x₁ 1)) * (K - d * x₁ 0) - 2 * d ^ 2 * x₁ 1
    let C0 : ℝ := (K - d * x₁ 0) ^ 2 + d ^ 2 * (x₁ 1 ^ 2 - r₁ ^ 2)
    have hA0 : A0 ≠ 0 := by dsimp [A0]; positivity
    apply card_quad_roots_le_two hA0
    intro y hy
    obtain ⟨p, hp, rfl⟩ := mem_image.mp hy
    have h1 := (hsq p hp).1
    have hl := hlin p hp
    have hdp : d * (p 0 - x₁ 0) = (K - d * x₁ 0) - 2 * (x₂ 1 - x₁ 1) * p 1 := by
      dsimp [d]; linear_combination hl
    have hsq_p0 : (d * (p 0 - x₁ 0)) ^ 2 = ((K - d * x₁ 0) - 2 * (x₂ 1 - x₁ 1) * p 1) ^ 2 := congrArg (· ^ 2) hdp
    have hstep : A0 * p 1 ^ 2 + B0 * p 1 + C0 =
        d ^ 2 * ((p 0 - x₁ 0) ^ 2 + (p 1 - x₁ 1) ^ 2) - d ^ 2 * r₁ ^ 2 - (d * (p 0 - x₁ 0)) ^ 2 +
        ((K - d * x₁ 0) - 2 * (x₂ 1 - x₁ 1) * p 1) ^ 2 := by dsimp only [A0, B0, C0]; ring
    rw [hstep, h1, hsq_p0]; ring
  · -- Express p 1 in terms of p 0; projection p ↦ p 0 is injective on S
    have hinj : Set.InjOn (fun p : ℝ² => p 0) (S : Set ℝ²) := by
      intro p hp q hq heq
      have hp1 := hlin p hp
      have hq1 := hlin q hq
      have h0 : 2 * (x₂ 1 - x₁ 1) * (p 1 - q 1) = 0 := by linear_combination hp1 - hq1 - 2 * (x₂ 0 - x₁ 0) * heq
      have hpq1 : p 1 = q 1 := sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_left (mul_ne_zero two_ne_zero hdy))
      ext i; fin_cases i
      · exact heq
      · exact hpq1
    rw [← card_image_of_injOn hinj]
    let d := 2 * (x₂ 1 - x₁ 1)
    have hd : d ≠ 0 := mul_ne_zero two_ne_zero hdy
    let A0 : ℝ := (2 * (x₂ 0 - x₁ 0)) ^ 2 + d ^ 2
    let B0 : ℝ := -2 * (2 * (x₂ 0 - x₁ 0)) * (K - d * x₁ 1) - 2 * d ^ 2 * x₁ 0
    let C0 : ℝ := (K - d * x₁ 1) ^ 2 + d ^ 2 * (x₁ 0 ^ 2 - r₁ ^ 2)
    have hA0 : A0 ≠ 0 := by dsimp [A0]; positivity
    apply card_quad_roots_le_two hA0
    intro x hx
    obtain ⟨p, hp, rfl⟩ := mem_image.mp hx
    have h1 := (hsq p hp).1
    have hl := hlin p hp
    have hdp : d * (p 1 - x₁ 1) = (K - d * x₁ 1) - 2 * (x₂ 0 - x₁ 0) * p 0 := by
      dsimp [d]; linear_combination hl
    have hsq_p1 : (d * (p 1 - x₁ 1)) ^ 2 = ((K - d * x₁ 1) - 2 * (x₂ 0 - x₁ 0) * p 0) ^ 2 := congrArg (· ^ 2) hdp
    have hstep : A0 * p 0 ^ 2 + B0 * p 0 + C0 =
        d ^ 2 * ((p 0 - x₁ 0) ^ 2 + (p 1 - x₁ 1) ^ 2) - d ^ 2 * r₁ ^ 2 - (d * (p 1 - x₁ 1)) ^ 2 +
        ((K - d * x₁ 1) - 2 * (x₂ 0 - x₁ 0) * p 0) ^ 2 := by dsimp only [A0, B0, C0]; ring
    rw [hstep, h1, hsq_p1]; ring

/-- Two distinct pins in `B ⊆ A` already guarantee `max(D(A, x₁), D(A, x₂)) ≥ √(|A| / 8)`. -/
private lemma pin_of_two_pins (A B : Finset ℝ²) (hBA : B ⊆ A) (hB2 : 2 ≤ B.card) :
    ∃ x ∈ B, Real.sqrt ((A.card : ℝ) / 8) ≤ (distinctDistancesFrom A x : ℝ) := by
  obtain ⟨x₁, hx1, x₂, hx2, hne⟩ := Finset.one_lt_card.mp (by omega : 1 < B.card)
  let f : ℝ² → ℝ × ℝ := fun y => (dist x₁ y, dist x₂ y)
  have hfib : ∀ q ∈ A.image f, (A.filter fun y => f y = q).card ≤ 2 := by
    intro q _
    apply two_circles_inter_le_two hne q.1 q.2
    intro y hy
    have heq := (mem_filter.mp hy).2
    exact ⟨congrArg Prod.fst heq, congrArg Prod.snd heq⟩
  have hcardA : A.card ≤ 2 * (A.image f).card := by
    calc A.card = ∑ q ∈ A.image f, (A.filter fun y => f y = q).card :=
          Finset.card_eq_sum_card_image f A
      _ ≤ ∑ _q ∈ A.image f, 2 := sum_le_sum hfib
      _ = 2 * (A.image f).card := by rw [sum_const, smul_eq_mul, mul_comm]
  have himg_sub : A.image f ⊆ (A.image (dist x₁ ·)) ×ˢ (A.image (dist x₂ ·)) := by
    intro q hq
    obtain ⟨y, hy, rfl⟩ := mem_image.mp hq
    exact mem_product.mpr ⟨mem_image_of_mem _ hy, mem_image_of_mem _ hy⟩
  have hD_bound : ∀ x ∈ B, (A.image (dist x ·)).card ≤ distinctDistancesFrom A x + 1 := by
    intro x _
    have hsub : A.image (dist x ·) ⊆ insert 0 ((A.erase x).image (dist · x)) := by
      intro r hr
      obtain ⟨y, hy, rfl⟩ := mem_image.mp hr
      by_cases hyx : y = x
      · subst hyx; simp
      · exact mem_insert_of_mem (mem_image.mpr ⟨y, mem_erase.mpr ⟨hyx, hy⟩, dist_comm y x⟩)
    have hD_eq : ((A.erase x).image (dist · x)).card = distinctDistancesFrom A x := by
      unfold distinctDistancesFrom; congr 1; ext r; simp
    calc (A.image (dist x ·)).card ≤ (insert 0 ((A.erase x).image (dist · x))).card := card_le_card hsub
      _ ≤ ((A.erase x).image (dist · x)).card + 1 := card_insert_le _ _
      _ = distinctDistancesFrom A x + 1 := by rw [hD_eq]
  have hD_pos : ∀ x ∈ B, 1 ≤ distinctDistancesFrom A x := by
    intro x hx
    have hlt : 1 < A.card := lt_of_lt_of_le (by omega) (card_le_card hBA)
    have hcard_er : 0 < (A.erase x).card := by rw [card_erase_of_mem (hBA hx)]; omega
    have hD_eq : ((A.erase x).image (dist · x)).card = distinctDistancesFrom A x := by
      unfold distinctDistancesFrom; congr 1; ext r; simp
    rw [← hD_eq]
    exact Finset.card_pos.mpr ((Finset.card_pos.mp hcard_er).image (dist · x))
  have h1 := hD_bound x₁ hx1
  have h2 := hD_bound x₂ hx2
  have hp1 := hD_pos x₁ hx1
  have hp2 := hD_pos x₂ hx2
  have hprod : A.card ≤ 8 * (distinctDistancesFrom A x₁ * distinctDistancesFrom A x₂) := by
    have h3 : (A.image f).card ≤ (A.image (dist x₁ ·)).card * (A.image (dist x₂ ·)).card := by
      simpa [card_product] using card_le_card himg_sub
    nlinarith
  by_cases hle : distinctDistancesFrom A x₁ ≤ distinctDistancesFrom A x₂
  · refine ⟨x₂, hx2, ?_⟩
    rw [Real.sqrt_le_iff]
    refine ⟨Nat.cast_nonneg _, ?_⟩
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 8)]
    have h4 : A.card ≤ 8 * distinctDistancesFrom A x₂ ^ 2 := by nlinarith
    have h4r : (A.card : ℝ) ≤ 8 * (distinctDistancesFrom A x₂ : ℝ) ^ 2 := by exact_mod_cast h4
    linarith
  · refine ⟨x₁, hx1, ?_⟩
    rw [Real.sqrt_le_iff]
    refine ⟨Nat.cast_nonneg _, ?_⟩
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 8)]
    have h4 : A.card ≤ 8 * distinctDistancesFrom A x₁ ^ 2 := by nlinarith
    have h4r : (A.card : ℝ) ≤ 8 * (distinctDistancesFrom A x₁ : ℝ) ^ 2 := by exact_mod_cast h4
    linarith

/-- Number of inversions between two `Nodup` permutations `L₁, L₂`:
pairs `(a, b)` that appear in order `(a, b)` in `L₁` and `(b, a)` in `L₂`. -/
private def invSet {α : Type*} [DecidableEq α] [BEq α] [LawfulBEq α] (L₁ L₂ : List α) : Finset (α × α) :=
  (L₁.toFinset ×ˢ L₁.toFinset).filter fun p =>
    L₁.idxOf p.1 < L₁.idxOf p.2 ∧ L₂.idxOf p.2 < L₂.idxOf p.1

/-- Bubble-sort step sequence: any two `Nodup` permutations `L₁, L₂` can be connected by
a sequence of `K = (invSet L₁ L₂).card` adjacent swaps. -/
private lemma bubble_sort_chain {α : Type*} [DecidableEq α] [BEq α] [LawfulBEq α] :
    ∀ (k : ℕ) (L₁ L₂ : List α), L₁.Nodup → L₂.Nodup → L₁.Perm L₂ →
      (invSet L₁ L₂).card = k →
      ∃ (states : Fin (k + 1) → List α) (swaps : Fin k → α × α),
        states 0 = L₁ ∧ states ⟨k, Nat.lt_succ_self k⟩ = L₂ ∧
        ∀ t : Fin k, ∃ pre post : List α,
          states t.castSucc = pre ++ [(swaps t).1, (swaps t).2] ++ post ∧
          states t.succ = pre ++ [(swaps t).2, (swaps t).1] ++ post := by
  intro k
  induction k with
  | zero =>
    intro L₁ L₂ hnd1 hnd2 hperm hinv0
    have hlen : L₁.length = L₂.length := hperm.length_eq
    have heq : L₁ = L₂ := by
      apply List.ext_getElem hlen
      intro i hi1 hi2
      by_contra hne
      -- If L₁ ≠ L₂, then idxOf in L₂ is not strictly increasing on L₁, giving an inversion!
      have hmono : ∀ a b : ℕ, (ha : a < L₁.length) → (hb : b < L₁.length) → a < b →
          L₂.idxOf L₁[a] < L₂.idxOf L₁[b] := by
        intro a b ha hb hab
        have hne_ab : L₁[a] ≠ L₁[b] := fun h => by
          have := (List.Nodup.getElem_inj_iff hnd1).mp h; omega
        have hmem_a : L₁[a] ∈ L₂ := hperm.subset (List.getElem_mem _)
        have hmem_b : L₁[b] ∈ L₂ := hperm.subset (List.getElem_mem _)
        have hidx_ne : L₂.idxOf L₁[a] ≠ L₂.idxOf L₁[b] := fun h => by
          have h1_lt : L₂.idxOf L₁[a] < L₂.length := List.idxOf_lt_length_iff.mpr hmem_a
          have h2_lt : L₂.idxOf L₁[b] < L₂.length := List.idxOf_lt_length_iff.mpr hmem_b
          have h1 : L₂[L₂.idxOf L₁[a]] = L₁[a] := List.getElem_idxOf h1_lt
          have h2 : L₂[L₂.idxOf L₁[b]] = L₁[b] := List.getElem_idxOf h2_lt
          apply hne_ab; rw [← h1, ← h2]; simp [h]
        rcases lt_or_gt_of_ne hidx_ne with hlt | hgt
        · exact hlt
        · exfalso
          have hmem_inv : (L₁[a], L₁[b]) ∈ invSet L₁ L₂ := by
            rw [invSet, mem_filter, mem_product, List.mem_toFinset, List.mem_toFinset]
            refine ⟨⟨List.getElem_mem _, List.getElem_mem _⟩, ?_, hgt⟩
            rw [List.Nodup.idxOf_getElem hnd1, List.Nodup.idxOf_getElem hnd1]; exact hab
          have := Finset.card_pos.mpr ⟨_, hmem_inv⟩; omega
      have hidx_eq : ∀ j : ℕ, (hj : j < L₁.length) → L₂.idxOf L₁[j] = j := by
        intro j hj
        have hle1 : j ≤ L₂.idxOf L₁[j] := by
          induction j with
          | zero => exact Nat.zero_le _
          | succ j ih' =>
            have h1 := ih' (by omega)
            have h2 := hmono j (j + 1) (by omega) hj (Nat.lt_succ_self j)
            omega
        have hle2 : L₂.idxOf L₁[j] ≤ j := by
          -- Count how many elements of L₁ have larger idxOf in L₂
          have hge : ∀ d : ℕ, (hd : j + d < L₁.length) → L₂.idxOf L₁[j] + d ≤ L₂.idxOf L₁[j + d] := by
            intro d
            induction d with
            | zero => intro _; simp
            | succ d ihd =>
              intro hd
              have h1 := ihd (by omega)
              have h2 := hmono (j + d) (j + (d + 1)) (by omega) hd (by omega)
              omega
          have hlast_lt : j + (L₁.length - 1 - j) < L₁.length := by omega
          have hlast := hge (L₁.length - 1 - j) hlast_lt
          have hltL2 : L₂.idxOf (L₁[j + (L₁.length - 1 - j)]'hlast_lt) < L₂.length :=
            List.idxOf_lt_length_iff.mpr (hperm.subset (List.getElem_mem _))
          have hltL : L₂.idxOf (L₁[j + (L₁.length - 1 - j)]'hlast_lt) < L₁.length := by omega
          have hadd : L₂.idxOf L₁[j] + (L₁.length - 1 - j) < L₁.length := lt_of_le_of_lt hlast hltL
          have hj_lt : j < L₁.length := hj
          omega
        omega
      have hmem_i : L₁[i] ∈ L₂ := hperm.subset (List.getElem_mem _)
      have hi_lt2 : L₂.idxOf L₁[i] < L₂.length := List.idxOf_lt_length_iff.mpr hmem_i
      have hget : L₂[L₂.idxOf L₁[i]] = L₁[i] := List.getElem_idxOf hi_lt2
      have hi_eq := hidx_eq i hi1
      have hget' : L₂[i] = L₁[i] := by simpa only [hi_eq] using hget
      exact hne hget'.symm
    exact ⟨fun _ => L₁, fun t => Fin.elim0 t, rfl, heq, fun t => Fin.elim0 t⟩
  | succ k ih =>
    intro L₁ L₂ hnd1 hnd2 hperm hinvk
    -- Find an adjacent pair (L₁[i], L₁[i+1]) inverted in L₂
    have hex_adj : ∃ i : ℕ, ∃ (h1 : i + 1 < L₁.length),
        L₂.idxOf (L₁[i + 1]) < L₂.idxOf (L₁[i]) := by
      by_contra hno
      push Not at hno
      have hmono : ∀ a b : ℕ, (ha : a < L₁.length) → (hb : b < L₁.length) → a < b →
          L₂.idxOf L₁[a] ≤ L₂.idxOf L₁[b] := by
        intro a b ha hb hab
        induction b with
        | zero => omega
        | succ b ihb =>
          rcases eq_or_lt_of_le (Nat.lt_succ_iff.mp hab) with rfl | hlt
          · exact hno a hb
          · exact (ihb (by omega) hlt).trans (hno b hb)
      have hne_inv : (invSet L₁ L₂).Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨⟨x, y⟩, hxy⟩ := hne_inv
      rw [invSet, mem_filter, mem_product, List.mem_toFinset, List.mem_toFinset] at hxy
      obtain ⟨⟨hx, hy⟩, h1, h2⟩ := hxy
      have hxlt := List.idxOf_lt_length_iff.mpr hx
      have hylt := List.idxOf_lt_length_iff.mpr hy
      have hm := hmono (L₁.idxOf x) (L₁.idxOf y) hxlt hylt h1
      rw [List.getElem_idxOf hxlt, List.getElem_idxOf hylt] at hm
      omega
    obtain ⟨i, hi1, hadj⟩ := hex_adj
    let a := L₁[i]
    let b := L₁[i + 1]'hi1
    let pre := L₁.take i
    let post := L₁.drop (i + 2)
    have hL1_eq : L₁ = pre ++ [a, b] ++ post := by
      have h1 := (List.take_append_drop i L₁).symm
      have hdrop : L₁.drop i = a :: b :: post := by
        rw [List.drop_eq_getElem_cons (by omega), List.drop_eq_getElem_cons hi1]
      rw [h1, hdrop]; simp [pre, post]
    let L₁' := pre ++ [b, a] ++ post
    have hperm_step : L₁.Perm L₁' := by
      rw [hL1_eq]; dsimp only [L₁']
      exact ((List.Perm.swap b a []).append_left pre).append_right post
    have hnd1' : L₁'.Nodup := (hperm_step.nodup_iff).mp hnd1
    have hperm' : L₁'.Perm L₂ := hperm_step.symm.trans hperm
    -- invSet L₁' L₂ = (invSet L₁ L₂).erase (a, b)
    have hab_ne : a ≠ b := fun h => by
      have := (List.Nodup.getElem_inj_iff hnd1).mp h; omega
    have hab_mem : (a, b) ∈ invSet L₁ L₂ := by
      rw [invSet, mem_filter, mem_product, List.mem_toFinset, List.mem_toFinset]
      refine ⟨⟨List.getElem_mem _, List.getElem_mem _⟩, ?_, hadj⟩
      rw [List.Nodup.idxOf_getElem hnd1, List.Nodup.idxOf_getElem hnd1]; omega
    have hlen_pre : pre.length = i := List.length_take_of_le (by omega)
    have hidx_L1' : ∀ x ∈ L₁,
        L₁'.idxOf x = if x = a then i + 1 else if x = b then i else L₁.idxOf x := by
      intro x hx
      have hlen1' : L₁'.length = L₁.length := hperm_step.length_eq.symm
      have hget' : ∀ (j : ℕ) (hj : j < L₁'.length), L₁'[j] =
          if j = i then b else if j = i + 1 then a else L₁[j]'(by omega) := by
        intro j hj
        by_cases hj1 : j < i
        · have hj_ne1 : j ≠ i := by omega
          have hj_ne2 : j ≠ i + 1 := by omega
          simp only [hj_ne1, hj_ne2, ↓reduceIte, L₁']
          rw [List.getElem_append_left (by simp [hlen_pre]; omega), List.getElem_append_left (by omega)]
          have hL1_j : L₁[j]'(by omega) = (pre ++ [a, b] ++ post)[j]'(by rw [← hL1_eq]; omega) := by
            simp [hL1_eq]
          rw [hL1_j, List.getElem_append_left (by simp [hlen_pre]; omega), List.getElem_append_left (by omega)]
        · by_cases hj2 : j = i
          · subst hj2; simp only [↓reduceIte, L₁']
            rw [List.getElem_append_left (by simp [hlen_pre]), List.getElem_append_right (by simp [hlen_pre])]
            simp [hlen_pre]
          · by_cases hj3 : j = i + 1
            · subst hj3; simp only [show i + 1 ≠ i by omega, ↓reduceIte, L₁']
              rw [List.getElem_append_left (by simp [hlen_pre]), List.getElem_append_right (by simp [hlen_pre])]
              simp [hlen_pre]
            · have hj_ge : i + 2 ≤ j := by omega
              simp only [hj2, hj3, ↓reduceIte, L₁']
              have h1 : (pre ++ [b, a]).length ≤ j := by simp [hlen_pre]; omega
              have h2 : (pre ++ [a, b]).length ≤ j := by simp [hlen_pre]; omega
              rw [List.getElem_append_right h1]
              have hL1_j : L₁[j]'(by omega) = (pre ++ [a, b] ++ post)[j]'(by rw [← hL1_eq]; omega) := by
                simp [hL1_eq]
              rw [hL1_j, List.getElem_append_right h2]
              congr 1; simp only [List.length_append, List.length_cons, List.length_nil]
      by_cases hxa : x = a
      · subst hxa; simp only [↓reduceIte]
        have hlt' : i + 1 < L₁'.length := by omega
        have hget : L₁'[i + 1] = a := by rw [hget' (i + 1) hlt']; simp
        rw [← hget, List.Nodup.idxOf_getElem hnd1']
      · by_cases hxb : x = b
        · subst hxb; simp only [hxa, ↓reduceIte]
          have hlt' : i < L₁'.length := by omega
          have hget : L₁'[i] = b := by rw [hget' i hlt']; simp
          rw [← hget, List.Nodup.idxOf_getElem hnd1']
        · simp only [hxa, hxb, ↓reduceIte]
          have hlt : L₁.idxOf x < L₁.length := List.idxOf_lt_length_iff.mpr hx
          have hlt' : L₁.idxOf x < L₁'.length := by omega
          have hne_i : L₁.idxOf x ≠ i := fun h => hxa (by
            have := List.getElem_idxOf hlt; rw [← this]; simp [a, h])
          have hne_i1 : L₁.idxOf x ≠ i + 1 := fun h => hxb (by
            have := List.getElem_idxOf hlt; rw [← this]; simp [b, h])
          have hget : L₁'[L₁.idxOf x] = x := by
            rw [hget' (L₁.idxOf x) hlt']; simp [hne_i, hne_i1, List.getElem_idxOf hlt]
          conv_lhs => rw [← hget]
          exact List.Nodup.idxOf_getElem hnd1' _ _
    have hia : L₁.idxOf a = i := by dsimp only [a]; rw [List.Nodup.idxOf_getElem hnd1]
    have hib : L₁.idxOf b = i + 1 := by dsimp only [b]; rw [List.Nodup.idxOf_getElem hnd1]
    have hidx_ne_i : ∀ z ∈ L₁, z ≠ a → L₁.idxOf z ≠ i := fun z hz hza h => hza (by
      have hlt := List.idxOf_lt_length_iff.mpr hz
      have := List.getElem_idxOf hlt; rw [← this]; simp [a, h])
    have hidx_ne_i1 : ∀ z ∈ L₁, z ≠ b → L₁.idxOf z ≠ i + 1 := fun z hz hzb h => hzb (by
      have hlt := List.idxOf_lt_length_iff.mpr hz
      have := List.getElem_idxOf hlt; rw [← this]; simp [b, h])
    have hinv_eq : invSet L₁' L₂ = (invSet L₁ L₂).erase (a, b) := by
      ext ⟨x, y⟩
      simp only [invSet, mem_erase, mem_filter, mem_product, List.mem_toFinset, hperm_step.mem_iff]
      constructor
      · rintro ⟨⟨hx, hy⟩, h1, h2⟩
        have hx1 : x ∈ L₁ := hperm_step.mem_iff.mpr hx
        have hy1 : y ∈ L₁ := hperm_step.mem_iff.mpr hy
        have hne_ab : (x, y) ≠ (a, b) := by
          rintro h; cases h
          rw [hidx_L1' a (List.getElem_mem _), hidx_L1' b (List.getElem_mem _)] at h1
          simp [hab_ne.symm] at h1
        refine ⟨hne_ab, ⟨hx, hy⟩, ?_, h2⟩
        rw [hidx_L1' x hx1, hidx_L1' y hy1] at h1
        by_cases hxa : x = a
        · subst hxa; simp only [↓reduceIte] at h1; rw [hia]
          by_cases hya : y = a
          · subst hya; simp at h1
          · by_cases hyb : y = b
            · subst hyb; exact absurd rfl hne_ab
            · simp only [hya, hyb, ↓reduceIte] at h1; omega
        · by_cases hxb : x = b
          · subst hxb; simp only [hxa, ↓reduceIte] at h1; rw [hib]
            by_cases hya : y = a
            · subst hya; exact absurd hadj (not_lt_of_gt h2)
            · by_cases hyb : y = b
              · subst hyb; simp [hab_ne.symm] at h1
              · simp only [hya, hyb, ↓reduceIte] at h1
                have := hidx_ne_i1 y hy1 hyb; omega
          · simp only [hxa, hxb, ↓reduceIte] at h1
            have hxi := hidx_ne_i x hx1 hxa
            have hxi1 := hidx_ne_i1 x hx1 hxb
            by_cases hya : y = a
            · subst hya; simp only [↓reduceIte] at h1; rw [hia]; omega
            · by_cases hyb : y = b
              · subst hyb; simp only [hya, ↓reduceIte] at h1; rw [hib]; omega
              · simp only [hya, hyb, ↓reduceIte] at h1; exact h1
      · rintro ⟨hne_ab, ⟨hx, hy⟩, h1, h2⟩
        have hx1 : x ∈ L₁ := hperm_step.mem_iff.mpr hx
        have hy1 : y ∈ L₁ := hperm_step.mem_iff.mpr hy
        refine ⟨⟨hx, hy⟩, ?_, h2⟩
        rw [hidx_L1' x hx1, hidx_L1' y hy1]
        by_cases hxa : x = a
        · subst hxa; simp only [↓reduceIte]; rw [hia] at h1
          by_cases hya : y = a
          · subst hya; omega
          · by_cases hyb : y = b
            · subst hyb; exact absurd rfl hne_ab
            · simp only [hya, hyb, ↓reduceIte]
              have := hidx_ne_i1 y hy1 hyb; omega
        · by_cases hxb : x = b
          · subst hxb; simp only [hxa, ↓reduceIte]; rw [hib] at h1
            by_cases hya : y = a
            · subst hya; rw [hia] at h1; omega
            · by_cases hyb : y = b
              · subst hyb; omega
              · simp only [hya, hyb, ↓reduceIte]; omega
          · simp only [hxa, hxb, ↓reduceIte]
            have hxi := hidx_ne_i x hx1 hxa
            have hxi1 := hidx_ne_i1 x hx1 hxb
            by_cases hya : y = a
            · subst hya; simp only [↓reduceIte]; rw [hia] at h1; omega
            · by_cases hyb : y = b
              · subst hyb; simp only [hya, ↓reduceIte]; rw [hib] at h1; omega
              · simp only [hya, hyb, ↓reduceIte]; exact h1
    have hinv_card' : (invSet L₁' L₂).card = k := by
      rw [hinv_eq, card_erase_of_mem hab_mem, hinvk]; omega
    obtain ⟨states', swaps', hs0, hsk, hstep'⟩ := ih L₁' L₂ hnd1' hnd2 hperm' hinv_card'
    refine ⟨Fin.cons L₁ states', Fin.cons (a, b) swaps', rfl, by simpa [Fin.cons] using hsk, fun t => ?_⟩
    refine Fin.cases ?_ (fun t' => ?_) t
    · exact ⟨pre, post, hL1_eq, hs0⟩
    · simpa using hstep' t'

/-! ### Part 2B-1: Slab-to-WiringDiagram Assembly, Generic Rotation, and Circle Intersections -/

/-- Prefix chain of steps for building a `WiringDiagram` one slab block at a time. -/
private structure SlabChain (n : ℕ) (E : Finset (DirEdge n)) (K : ℕ)
    (slab : Fin (K + 1) → List (DirEdge n)) (vertSlab : Fin n → Fin K) (k : ℕ) (hk : k ≤ K) where
  L : ℕ
  state : Fin (L + 1) → List (DirEdge n)
  step : Fin L → WStep n
  hstart : state 0 = slab 0
  hend : state ⟨L, Nat.lt_succ_self L⟩ = slab ⟨k, by omega⟩
  hnodup : ∀ s, (state s).Nodup
  hmemE : ∀ s, ∀ e ∈ state s, e ∈ E
  hvert_pos : ∀ v : Fin n, (vertSlab v).val < k → Fin L
  hvert_mono : ∀ v₁ v₂ (h1 : (vertSlab v₁).val < k) (h2 : (vertSlab v₂).val < k),
    v₁ < v₂ → (hvert_pos v₁ h1).val < (hvert_pos v₂ h2).val
  hvert_step : ∀ v (hv : (vertSlab v).val < k), step (hvert_pos v hv) = WStep.vertex v
  hvert_only : ∀ t v, step t = WStep.vertex v → ∃ hv : (vertSlab v).val < k, t = hvert_pos v hv
  hstep_valid : ∀ t : Fin L, match step t with
    | WStep.noop => state t.succ = state t.castSucc
    | WStep.swap e₁ e₂ =>
        ∃ pre post : List (DirEdge n),
          state t.castSucc = pre ++ [e₁, e₂] ++ post ∧
          state t.succ = pre ++ [e₂, e₁] ++ post
    | WStep.vertex v =>
        ∃ pre Lv Rv post : List (DirEdge n),
          state t.castSucc = pre ++ Lv ++ post ∧
          state t.succ = pre ++ Rv ++ post ∧
          (∀ e ∈ Lv, e.2 = v) ∧
          (∀ e ∈ Rv, e.1 = v) ∧
          (∀ e ∈ pre, e.1 ≠ v ∧ e.2 ≠ v) ∧
          (∀ e ∈ post, e.1 ≠ v ∧ e.2 ≠ v)
  hactive_iff : ∀ s : Fin (L + 1), ∀ e ∈ E,
    e ∈ state s ↔
      (∃ h1 : (vertSlab e.1).val < k, (hvert_pos e.1 h1).val < s.val) ∧
      (∀ h2 : (vertSlab e.2).val < k, s.val ≤ (hvert_pos e.2 h2).val)
  hswaps : (univ.filter fun t : Fin L => (match step t with | WStep.swap _ _ => true | _ => false) = true).card ≤
    ∑ j ∈ (univ.filter fun j : Fin K => j.val < k ∧ ∀ v : Fin n, j ≠ vertSlab v),
      (invSet (slab j.castSucc) (slab j.succ)).card

/-- Assemble a `WiringDiagram n E` from `K + 1` slabs using `bubble_sort_chain` at non-vertex
critical points and a single `WStep.vertex v` step at each vertex critical point. -/
private lemma build_wiring_diagram_from_slabs {n : ℕ} {E : Finset (DirEdge n)}
    (hE : ∀ e ∈ E, e.1 < e.2) (K : ℕ)
    (slab : Fin (K + 1) → List (DirEdge n))
    (hstart : slab 0 = []) (hend : slab ⟨K, Nat.lt_succ_self K⟩ = [])
    (hnodup : ∀ j, (slab j).Nodup)
    (hmemE : ∀ j, ∀ e ∈ slab j, e ∈ E)
    (vertSlab : Fin n → Fin K) (hvm : StrictMono vertSlab)
    (hactive : ∀ j : Fin (K + 1), ∀ e ∈ E,
      e ∈ slab j ↔ (vertSlab e.1).val < j.val ∧ j.val ≤ (vertSlab e.2).val)
    (hvstep : ∀ v : Fin n, ∃ pre Lv Rv post : List (DirEdge n),
      slab (vertSlab v).castSucc = pre ++ Lv ++ post ∧
      slab (vertSlab v).succ = pre ++ Rv ++ post ∧
      (∀ e ∈ Lv, e.2 = v) ∧ (∀ e ∈ Rv, e.1 = v) ∧
      (∀ e ∈ pre, e.1 ≠ v ∧ e.2 ≠ v) ∧ (∀ e ∈ post, e.1 ≠ v ∧ e.2 ≠ v))
    (hperm : ∀ j : Fin K, (∀ v : Fin n, j ≠ vertSlab v) → (slab j.castSucc).Perm (slab j.succ)) :
    ∃ D : WiringDiagram n E,
      D.numSwaps ≤ ∑ j ∈ (univ.filter fun j : Fin K => ∀ v : Fin n, j ≠ vertSlab v),
        (invSet (slab j.castSucc) (slab j.succ)).card := by
  have hchain : ∀ k (hk : k ≤ K), Nonempty (SlabChain n E K slab vertSlab k hk) := by
    intro k
    induction k with
    | zero =>
      intro hk
      refine ⟨{
        L := 0
        state := fun _ => slab 0
        step := fun t => Fin.elim0 t
        hstart := rfl
        hend := rfl
        hnodup := fun _ => hnodup 0
        hmemE := fun _ => hmemE 0
        hvert_pos := fun _ h => absurd h (Nat.not_lt_zero _)
        hvert_mono := fun _ _ h => absurd h (Nat.not_lt_zero _)
        hvert_step := fun _ h => absurd h (Nat.not_lt_zero _)
        hvert_only := fun t => Fin.elim0 t
        hstep_valid := fun t => Fin.elim0 t
        hactive_iff := fun s e he => by
          rw [hstart]; simp
        hswaps := by simp
      }⟩
    | succ k ih =>
      intro hk
      obtain ⟨C⟩ := ih (by omega)
      let jK : Fin K := ⟨k, by omega⟩
      by_cases hexv : ∃ v : Fin n, vertSlab v = jK
      · obtain ⟨v₀, hv₀⟩ := hexv
        have hv₀_val : (vertSlab v₀).val = k := congrArg Fin.val hv₀
        -- Append 1 vertex step for v₀
        let L' := C.L + 1
        let state' : Fin (L' + 1) → List (DirEdge n) := fun s =>
          if h : s.val ≤ C.L then C.state ⟨s.val, by omega⟩ else slab jK.succ
        let step' : Fin L' → WStep n := fun t =>
          if h : t.val < C.L then C.step ⟨t.val, h⟩ else WStep.vertex v₀
        have hstate_last : state' ⟨C.L, by omega⟩ = slab jK.castSucc := by
          simp only [state', le_refl, ↓reduceDIte]
          exact C.hend
        have hstate_end : state' ⟨L', Nat.lt_succ_self L'⟩ = slab jK.succ := by
          simp only [state', L', show ¬(C.L + 1 ≤ C.L) by omega, ↓reduceDIte]
        let hvpos' : ∀ v : Fin n, (vertSlab v).val < k + 1 → Fin L' := fun v hv =>
          if h : (vertSlab v).val < k then ⟨(C.hvert_pos v h).val, by omega⟩
          else ⟨C.L, by omega⟩
        have hfilt_eq : (univ.filter fun j : Fin K => j.val < k + 1 ∧ ∀ v : Fin n, j ≠ vertSlab v) =
            (univ.filter fun j : Fin K => j.val < k ∧ ∀ v : Fin n, j ≠ vertSlab v) := by
          ext j; simp only [mem_filter, mem_univ, true_and]
          constructor
          · rintro ⟨h1, h2⟩
            refine ⟨?_, h2⟩
            by_contra hge
            have hjeq : j = jK := Fin.ext (by dsimp [jK]; omega)
            exact h2 v₀ (hjeq.trans hv₀.symm)
          · rintro ⟨h1, h2⟩; exact ⟨by omega, h2⟩
        refine ⟨{
          L := L'
          state := state'
          step := step'
          hstart := by simp [state', C.hstart]
          hend := hstate_end
          hnodup := fun s => by dsimp only [state']; split_ifs; exact C.hnodup _; exact hnodup _
          hmemE := fun s => by dsimp only [state']; split_ifs; exact C.hmemE _; exact hmemE _
          hvert_pos := hvpos'
          hvert_mono := fun v₁ v₂ h1 h2 hlt => by
            dsimp only [hvpos']
            have hvlt : (vertSlab v₁).val < (vertSlab v₂).val := hvm hlt
            split_ifs with ha hb
            · exact C.hvert_mono v₁ v₂ ha hb hlt
            · exact (C.hvert_pos v₁ ha).isLt
            · omega
            · omega
          hvert_step := fun v hv => by
            dsimp only [hvpos', step']
            split_ifs with h1 h2 h3
            · exact C.hvert_step v h1
            · exact absurd (C.hvert_pos v h1).isLt h2
            · exact absurd h3 (lt_irrefl _)
            · have hveq : v = v₀ := hvm.injective (Fin.ext (by omega))
              rw [hveq]
          hvert_only := fun t v hst => by
            dsimp only [step'] at hst
            split_ifs at hst with h1
            · obtain ⟨hv, hteq⟩ := C.hvert_only ⟨t.val, h1⟩ v hst
              refine ⟨by omega, Fin.ext ?_⟩
              dsimp only [hvpos']; rw [dif_pos hv]
              change t.val = (C.hvert_pos v hv).val
              exact congrArg Fin.val hteq
            · cases hst
              refine ⟨by omega, Fin.ext ?_⟩
              dsimp only [hvpos']; rw [dif_neg (by omega)]
              change t.val = C.L
              have := t.isLt; dsimp [L'] at this; omega
          hstep_valid := fun t => by
            dsimp only [step']
            split_ifs with h1
            · have hv := C.hstep_valid ⟨t.val, h1⟩
              have hs1 : state' t.castSucc = C.state ⟨t.val, by omega⟩ := by
                simp only [state', Fin.val_castSucc, show t.val ≤ C.L by omega, ↓reduceDIte]
              have hs2 : state' t.succ = C.state ⟨t.val + 1, by omega⟩ := by
                simp only [state', Fin.val_succ, show t.val + 1 ≤ C.L by omega, ↓reduceDIte]
              rw [hs1, hs2]; exact hv
            · have htval : t.val = C.L := by have := t.isLt; dsimp [L'] at this; omega
              have hs1 : state' t.castSucc = slab (vertSlab v₀).castSucc := by
                have : t.castSucc = ⟨C.L, by omega⟩ := Fin.ext (by simp [htval])
                rw [this, hstate_last, hv₀]
              have hs2 : state' t.succ = slab (vertSlab v₀).succ := by
                have : t.succ = ⟨L', Nat.lt_succ_self L'⟩ := Fin.ext (by simp [L', htval])
                rw [this, hstate_end, hv₀]
              rw [hs1, hs2]; exact hvstep v₀
          hactive_iff := fun s e he => by
            dsimp only [state']
            split_ifs with hsle
            · rw [C.hactive_iff ⟨s.val, by omega⟩ e he]
              constructor
              · rintro ⟨⟨h1, h1lt⟩, h2⟩
                refine ⟨⟨by omega, by dsimp [hvpos']; rw [dif_pos h1]; exact h1lt⟩, fun h2' => ?_⟩
                dsimp only [hvpos']
                split_ifs with h2k
                · exact h2 h2k
                · exact hsle
              · rintro ⟨⟨h1, h1lt⟩, h2⟩
                dsimp only [hvpos'] at h1lt
                have h1k : (vertSlab e.1).val < k := by
                  by_contra hge
                  rw [dif_neg hge] at h1lt; dsimp at h1lt; omega
                rw [dif_pos h1k] at h1lt
                refine ⟨⟨h1k, h1lt⟩, fun h2k => ?_⟩
                have := h2 (by omega)
                dsimp only [hvpos'] at this; rw [dif_pos h2k] at this; exact this
            · have hsval : s.val = C.L + 1 := by have := s.isLt; dsimp [L'] at this; omega
              rw [hactive jK.succ e he]
              simp only [Fin.val_succ, jK]
              constructor
              · rintro ⟨h1, h2⟩
                refine ⟨⟨h1, ?_⟩, fun h2' => by omega⟩
                dsimp only [hvpos']
                split_ifs with h1k
                · have := (C.hvert_pos e.1 h1k).isLt; omega
                · omega
              · rintro ⟨⟨h1, _⟩, h2⟩
                refine ⟨h1, ?_⟩
                by_contra hlt2
                have h2lt : (vertSlab e.2).val < k + 1 := by omega
                have hle := h2 h2lt
                dsimp only [hvpos'] at hle
                split_ifs at hle with h2k
                · have := (C.hvert_pos e.2 h2k).isLt; omega
                · omega
          hswaps := by
            rw [hfilt_eq]
            have hsub : (univ.filter fun t : Fin L' => (match step' t with | WStep.swap _ _ => true | _ => false) = true) ⊆
                (univ.filter fun t : Fin C.L => (match C.step t with | WStep.swap _ _ => true | _ => false) = true).image
                  (fun t : Fin C.L => (⟨t.val, by omega⟩ : Fin L')) := by
              intro t ht
              rw [mem_filter] at ht
              dsimp only [step'] at ht
              split_ifs at ht with h1
              · exact mem_image.mpr ⟨⟨t.val, h1⟩, mem_filter.mpr ⟨mem_univ _, by simpa using ht.2⟩, Fin.ext rfl⟩
              · simp at ht
            exact (card_le_card hsub).trans ((card_image_le).trans C.hswaps)
        }⟩
      · -- Non-vertex step: connect slab jK.castSucc to slab jK.succ via bubble_sort_chain
        push Not at hexv
        have hnov : ∀ v : Fin n, jK ≠ vertSlab v := fun v h => hexv v h.symm
        let m := (invSet (slab jK.castSucc) (slab jK.succ)).card
        obtain ⟨bst, bsw, hb0, hbm, hbstep⟩ :=
          bubble_sort_chain m (slab jK.castSucc) (slab jK.succ) (hnodup jK.castSucc) (hnodup jK.succ) (hperm jK hnov) rfl
        have hbperm : ∀ r : Fin (m + 1), (bst r).Perm (slab jK.castSucc) := by
          intro r
          obtain ⟨rv, hrv⟩ := r
          induction rv with
          | zero => rw [show (⟨0, hrv⟩ : Fin (m + 1)) = 0 from rfl, hb0]
          | succ rv ihr =>
            have hst := hbstep ⟨rv, by omega⟩
            obtain ⟨pre, post, h1, h2⟩ := hst
            have hsp : (bst ⟨rv + 1, hrv⟩).Perm (bst ⟨rv, by omega⟩) := by
              have h1' : bst ⟨rv, by omega⟩ = pre ++ [(bsw ⟨rv, by omega⟩).1, (bsw ⟨rv, by omega⟩).2] ++ post := h1
              have h2' : bst ⟨rv + 1, hrv⟩ = pre ++ [(bsw ⟨rv, by omega⟩).2, (bsw ⟨rv, by omega⟩).1] ++ post := h2
              rw [h1', h2']
              exact ((List.Perm.swap _ _ []).append_left pre).append_right post
            exact hsp.trans (ihr (by omega))
        let L' := C.L + m
        let state' : Fin (L' + 1) → List (DirEdge n) := fun s =>
          if h : s.val ≤ C.L then C.state ⟨s.val, by omega⟩ else bst ⟨s.val - C.L, by omega⟩
        let step' : Fin L' → WStep n := fun t =>
          if h : t.val < C.L then C.step ⟨t.val, h⟩
          else WStep.swap (bsw ⟨t.val - C.L, by omega⟩).1 (bsw ⟨t.val - C.L, by omega⟩).2
        have hvlt_iff : ∀ v : Fin n, (vertSlab v).val < k + 1 ↔ (vertSlab v).val < k := fun v => by
          constructor
          · intro h
            by_contra hge
            exact hnov v (Fin.ext (by dsimp [jK]; omega))
          · intro h; omega
        have hstate_C : state' ⟨C.L, by omega⟩ = bst 0 := by
          simp only [state', le_refl, ↓reduceDIte, C.hend, hb0]; rfl
        have hfilt_eq : (univ.filter fun j : Fin K => j.val < k + 1 ∧ ∀ v : Fin n, j ≠ vertSlab v) =
            insert jK (univ.filter fun j : Fin K => j.val < k ∧ ∀ v : Fin n, j ≠ vertSlab v) := by
          ext j; simp only [mem_insert, mem_filter, mem_univ, true_and]
          constructor
          · rintro ⟨h1, h2⟩
            by_cases hlt : j.val < k
            · exact Or.inr ⟨hlt, h2⟩
            · exact Or.inl (Fin.ext (by dsimp [jK]; omega))
          · rintro (rfl | ⟨h1, h2⟩)
            · exact ⟨by dsimp [jK]; omega, hnov⟩
            · exact ⟨by omega, h2⟩
        have hjK_nmem : jK ∉ (univ.filter fun j : Fin K => j.val < k ∧ ∀ v : Fin n, j ≠ vertSlab v) := by
          simp [jK]
        refine ⟨{
          L := L'
          state := state'
          step := step'
          hstart := by simp [state', C.hstart]
          hend := by
            dsimp only [state']
            split_ifs with h
            · have hm0 : m = 0 := by omega
              have : (⟨L', by omega⟩ : Fin (C.L + 1)) = ⟨C.L, Nat.lt_succ_self C.L⟩ := Fin.ext (by dsimp [L']; omega)
              rw [this, C.hend]
              have h0m : (⟨0, by omega⟩ : Fin (m + 1)) = ⟨m, Nat.lt_succ_self m⟩ := Fin.ext (by omega)
              have hbm' : bst 0 = slab jK.succ := by rw [← hbm]; exact congrArg bst h0m
              exact hb0.symm.trans hbm'
            · have hsub : L' - C.L = m := by dsimp [L']; omega
              exact (congrArg bst (Fin.ext hsub)).trans hbm
          hnodup := fun s => by
            dsimp only [state']; split_ifs
            · exact C.hnodup _
            · exact (hbperm _).nodup_iff.mpr (hnodup _)
          hmemE := fun s e he => by
            dsimp only [state'] at he; split_ifs at he
            · exact C.hmemE _ e he
            · exact hmemE _ e ((hbperm _).subset he)
          hvert_pos := fun v hv => ⟨(C.hvert_pos v ((hvlt_iff v).mp hv)).val, by
            have := (C.hvert_pos v ((hvlt_iff v).mp hv)).isLt; omega⟩
          hvert_mono := fun v₁ v₂ h1 h2 hlt => C.hvert_mono v₁ v₂ ((hvlt_iff v₁).mp h1) ((hvlt_iff v₂).mp h2) hlt
          hvert_step := fun v hv => by
            dsimp only [step']
            have hlt := (C.hvert_pos v ((hvlt_iff v).mp hv)).isLt
            rw [dif_pos hlt]
            exact C.hvert_step v ((hvlt_iff v).mp hv)
          hvert_only := fun t v hst => by
            dsimp only [step'] at hst
            split_ifs at hst with h1
            obtain ⟨hv, hteq⟩ := C.hvert_only ⟨t.val, h1⟩ v hst
            refine ⟨by omega, Fin.ext ?_⟩
            simpa using congrArg Fin.val hteq
          hstep_valid := fun t => by
            dsimp only [step']
            split_ifs with h1
            · have hv := C.hstep_valid ⟨t.val, h1⟩
              have hs1 : state' t.castSucc = C.state ⟨t.val, by omega⟩ := by
                simp only [state', Fin.val_castSucc, show t.val ≤ C.L by omega, ↓reduceDIte]
              have hs2 : state' t.succ = C.state ⟨t.val + 1, by omega⟩ := by
                simp only [state', Fin.val_succ, show t.val + 1 ≤ C.L by omega, ↓reduceDIte]
              rw [hs1, hs2]; exact hv
            · have hge : C.L ≤ t.val := by omega
              have hs1 : state' t.castSucc = bst ⟨t.val - C.L, by omega⟩ := by
                dsimp only [state']
                split_ifs with hle
                · have hteq : t.val = C.L := by simp at hle; omega
                  have hsub : t.val - C.L = 0 := by omega
                  have : (⟨t.castSucc.val, by omega⟩ : Fin (C.L + 1)) = ⟨C.L, Nat.lt_succ_self C.L⟩ := Fin.ext (by simp [hteq])
                  rw [this, C.hend]
                  exact hb0.symm.trans (congrArg bst (Fin.ext hsub.symm))
                · rfl
              have hs2 : state' t.succ = bst ⟨t.val - C.L + 1, by omega⟩ := by
                dsimp only [state']
                rw [dif_neg (by simp; omega)]
                exact congrArg bst (Fin.ext (by simp; omega))
              rw [hs1, hs2]
              exact hbstep ⟨t.val - C.L, by omega⟩
          hactive_iff := fun s e he => by
            dsimp only [state']
            split_ifs with hsle
            · rw [C.hactive_iff ⟨s.val, by omega⟩ e he]
              constructor
              · rintro ⟨⟨h1, h1lt⟩, h2⟩
                exact ⟨⟨(hvlt_iff e.1).mpr h1, h1lt⟩, fun h2' => h2 ((hvlt_iff e.2).mp h2')⟩
              · rintro ⟨⟨h1, h1lt⟩, h2⟩
                exact ⟨⟨(hvlt_iff e.1).mp h1, h1lt⟩, fun h2' => h2 ((hvlt_iff e.2).mpr h2')⟩
            · rw [(hbperm _).mem_iff, hactive jK.castSucc e he]
              simp only [Fin.val_castSucc, jK]
              constructor
              · rintro ⟨h1, h2⟩
                refine ⟨⟨by omega, ?_⟩, fun h2' => ?_⟩
                · have := (C.hvert_pos e.1 h1).isLt; omega
                · have := (hvlt_iff e.2).mp h2'; omega
              · rintro ⟨⟨h1, _⟩, h2⟩
                refine ⟨(hvlt_iff e.1).mp h1, ?_⟩
                by_contra hlt2
                have h2' : (vertSlab e.2).val < k + 1 := by omega
                have hle := h2 h2'
                have := (C.hvert_pos e.2 ((hvlt_iff e.2).mp h2')).isLt; omega
          hswaps := by
            rw [hfilt_eq, sum_insert hjK_nmem]
            let S1 : Finset (Fin L') := (univ.filter fun t : Fin C.L =>
              (match C.step t with | WStep.swap _ _ => true | _ => false) = true).image
                (fun t : Fin C.L => (⟨t.val, by omega⟩ : Fin L'))
            let S2 : Finset (Fin L') := univ.image (fun r : Fin m => (⟨C.L + r.val, by omega⟩ : Fin L'))
            have hsub : (univ.filter fun t : Fin L' => (match step' t with | WStep.swap _ _ => true | _ => false) = true) ⊆
                S1 ∪ S2 := by
              intro t ht
              rw [mem_filter] at ht
              dsimp only [step'] at ht
              split_ifs at ht with h1
              · exact mem_union_left _ (mem_image.mpr ⟨⟨t.val, h1⟩, mem_filter.mpr ⟨mem_univ _, ht.2⟩, Fin.ext rfl⟩)
              · exact mem_union_right _ (mem_image.mpr ⟨⟨t.val - C.L, by omega⟩, mem_univ _, Fin.ext (by dsimp; omega)⟩)
            have hc1 : S1.card ≤ ∑ j ∈ (univ.filter fun j : Fin K => j.val < k ∧ ∀ v : Fin n, j ≠ vertSlab v),
                (invSet (slab j.castSucc) (slab j.succ)).card :=
              card_image_le.trans C.hswaps
            have hc2 : S2.card ≤ m := card_image_le.trans (by simp)
            have hc2' : S2.card ≤ (invSet (slab jK.castSucc) (slab jK.succ)).card := hc2
            calc _ ≤ (S1 ∪ S2).card := card_le_card hsub
              _ ≤ S1.card + S2.card := card_union_le S1 S2
              _ ≤ _ := by omega
        }⟩
  obtain ⟨C⟩ := hchain K le_rfl
  refine ⟨{
    L := C.L
    state := C.state
    step := C.step
    hE := hE
    hstart := C.hstart.trans hstart
    hend := C.hend.trans hend
    hnodup := C.hnodup
    hmemE := C.hmemE
    hvert_pos := fun v => C.hvert_pos v (vertSlab v).isLt
    hvert_mono := fun v₁ v₂ hlt => C.hvert_mono v₁ v₂ (vertSlab v₁).isLt (vertSlab v₂).isLt hlt
    hvert_step := fun v => C.hvert_step v (vertSlab v).isLt
    hvert_only := fun t v hst => (C.hvert_only t v hst).2
    hstep_valid := C.hstep_valid
    hactive_iff := fun s e he => by
      rw [C.hactive_iff s e he]
      exact ⟨fun ⟨⟨_, h1⟩, h2⟩ => ⟨h1, h2 (vertSlab e.2).isLt⟩,
        fun ⟨h1, h2⟩ => ⟨⟨(vertSlab e.1).isLt, h1⟩, fun _ => h2⟩⟩
  }, ?_⟩
  have hfeq : (univ.filter fun j : Fin K => j.val < K ∧ ∀ v : Fin n, j ≠ vertSlab v) =
      (univ.filter fun j : Fin K => ∀ v : Fin n, j ≠ vertSlab v) := by
    ext j; simp [j.isLt]
  have hsw := C.hswaps; rw [hfeq] at hsw
  refine le_trans (le_of_eq ?_) hsw
  congr 1

/-- Construct a point in `ℝ²` from its two coordinates. -/
private def mkPt (x y : ℝ) : ℝ² := (EuclideanSpace.equiv (Fin 2) ℝ).symm ![x, y]

private lemma mkPt_zero (x y : ℝ) : mkPt x y 0 = x := rfl
private lemma mkPt_one (x y : ℝ) : mkPt x y 1 = y := rfl

/-- Rational orthogonal rotation of `ℝ²` by parameter `t : ℝ`. -/
private def rot (t : ℝ) (p : ℝ²) : ℝ² :=
  mkPt (((1 - t ^ 2) * p 0 - 2 * t * p 1) / (1 + t ^ 2))
       ((2 * t * p 0 + (1 - t ^ 2) * p 1) / (1 + t ^ 2))

private lemma rot_zero (t : ℝ) (p : ℝ²) :
    (rot t p) 0 = ((1 - t ^ 2) * p 0 - 2 * t * p 1) / (1 + t ^ 2) := rfl

private lemma rot_one (t : ℝ) (p : ℝ²) :
    (rot t p) 1 = (2 * t * p 0 + (1 - t ^ 2) * p 1) / (1 + t ^ 2) := rfl

private lemma rot_dist (t : ℝ) (p q : ℝ²) : dist (rot t p) (rot t q) = dist p q := by
  have h1 : 0 ≤ dist (rot t p) (rot t q) := dist_nonneg
  have h2 : 0 ≤ dist p q := dist_nonneg
  have hsq : dist (rot t p) (rot t q) ^ 2 = dist p q ^ 2 := by
    rw [dist_sq_eq, dist_sq_eq, rot_zero, rot_zero, rot_one, rot_one]
    have hd : (1 + t ^ 2 : ℝ) ≠ 0 := by positivity
    field_simp [hd]
    ring
  nlinarith

private lemma rot_injective (t : ℝ) : Function.Injective (rot t) := by
  intro p q h
  rw [← dist_eq_zero, ← rot_dist t p q, h, dist_self]

/-- For any finite set `S : Finset ℝ²`, there is a rational rotation `rot t` making all
x-coordinates of `S` pairwise distinct AND all y-coordinates of `S` pairwise distinct. -/
private lemma exists_generic_rot (S : Finset ℝ²) :
    ∃ t : ℝ, (∀ p ∈ S, ∀ q ∈ S, p ≠ q → (rot t p) 0 ≠ (rot t q) 0) ∧
             (∀ p ∈ S, ∀ q ∈ S, p ≠ q → (rot t p) 1 ≠ (rot t q) 1) := by
  have hquad_fin : ∀ a b c : ℝ, (a ≠ 0 ∨ b ≠ 0) → Set.Finite {t : ℝ | a * t ^ 2 + b * t + c = 0} := by
    intro a b c hab
    by_cases ha : a ≠ 0
    · by_contra hinf
      obtain ⟨F, hFsub, hFcard⟩ := (Set.Infinite.exists_subset_card_eq hinf 3)
      have hle := card_quad_roots_le_two ha F (fun t ht => hFsub ht)
      omega
    · push Not at ha; subst ha
      have hb : b ≠ 0 := hab.resolve_left (not_not.mpr rfl)
      apply (Set.finite_singleton (-c / b)).subset
      intro t ht
      simp only [Set.mem_setOf_eq, zero_mul, zero_add] at ht
      simp only [Set.mem_singleton_iff]
      field_simp [hb]; linarith
  let badX : ℝ² × ℝ² → Set ℝ := fun pq =>
    if pq.1 = pq.2 then ∅ else {t : ℝ | (rot t pq.1) 0 = (rot t pq.2) 0}
  let badY : ℝ² × ℝ² → Set ℝ := fun pq =>
    if pq.1 = pq.2 then ∅ else {t : ℝ | (rot t pq.1) 1 = (rot t pq.2) 1}
  have hfinX : ∀ pq ∈ S ×ˢ S, (badX pq).Finite := by
    intro ⟨p, q⟩ _
    dsimp only [badX]
    split_ifs with hpq
    · exact Set.finite_empty
    · have hne : p 0 - q 0 ≠ 0 ∨ p 1 - q 1 ≠ 0 := by
        by_contra h; push Not at h
        apply hpq; ext i; fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one] <;> linarith
      have hsub : {t : ℝ | (rot t p) 0 = (rot t q) 0} ⊆
          {t : ℝ | (-(p 0 - q 0)) * t ^ 2 + (-2 * (p 1 - q 1)) * t + (p 0 - q 0) = 0} := by
        intro t ht
        simp only [Set.mem_setOf_eq, rot_zero] at ht ⊢
        have hd : (1 + t ^ 2 : ℝ) ≠ 0 := by positivity
        have hmul := (div_eq_div_iff hd hd).mp ht
        have hdiff : ((1 - t ^ 2) * p 0 - 2 * t * p 1 - ((1 - t ^ 2) * q 0 - 2 * t * q 1)) * (1 + t ^ 2) = 0 := by
          linarith
        have h0 := (mul_eq_zero.mp hdiff).resolve_right hd
        linarith
      have hne' : -(p 0 - q 0) ≠ 0 ∨ -2 * (p 1 - q 1) ≠ 0 := by
        rcases hne with h | h
        · left; exact neg_ne_zero.mpr h
        · right; exact mul_ne_zero (by norm_num) h
      exact (hquad_fin _ _ _ hne').subset hsub
  have hfinY : ∀ pq ∈ S ×ˢ S, (badY pq).Finite := by
    intro ⟨p, q⟩ _
    dsimp only [badY]
    split_ifs with hpq
    · exact Set.finite_empty
    · have hne : p 0 - q 0 ≠ 0 ∨ p 1 - q 1 ≠ 0 := by
        by_contra h; push Not at h
        apply hpq; ext i; fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one] <;> linarith
      have hsub : {t : ℝ | (rot t p) 1 = (rot t q) 1} ⊆
          {t : ℝ | (-(p 1 - q 1)) * t ^ 2 + (2 * (p 0 - q 0)) * t + (p 1 - q 1) = 0} := by
        intro t ht
        simp only [Set.mem_setOf_eq, rot_one] at ht ⊢
        have hd : (1 + t ^ 2 : ℝ) ≠ 0 := by positivity
        have hmul := (div_eq_div_iff hd hd).mp ht
        have hdiff : ((2 * t * p 0 + (1 - t ^ 2) * p 1) - (2 * t * q 0 + (1 - t ^ 2) * q 1)) * (1 + t ^ 2) = 0 := by
          linarith
        have h0 := (mul_eq_zero.mp hdiff).resolve_right hd
        linarith
      have hne' : -(p 1 - q 1) ≠ 0 ∨ 2 * (p 0 - q 0) ≠ 0 := by
        rcases hne with h | h
        · right; exact mul_ne_zero two_ne_zero h
        · left; exact neg_ne_zero.mpr h
      exact (hquad_fin _ _ _ hne').subset hsub
  have hbad_fin : ((⋃ pq ∈ (S ×ˢ S : Finset (ℝ² × ℝ²)), badX pq) ∪
      (⋃ pq ∈ (S ×ˢ S : Finset (ℝ² × ℝ²)), badY pq)).Finite :=
    ((S ×ˢ S).finite_toSet.biUnion hfinX).union ((S ×ˢ S).finite_toSet.biUnion hfinY)
  obtain ⟨t, -, ht⟩ := Set.Infinite.exists_notMem_finite Set.infinite_univ hbad_fin
  refine ⟨t, fun p hp q hq hpq hEq => ht ?_, fun p hp q hq hpq hEq => ht ?_⟩
  · left; exact Set.mem_biUnion (x := (p, q)) (Finset.mem_coe.mpr (mem_product.mpr ⟨hp, hq⟩)) (by simp [badX, hpq, hEq])
  · right; exact Set.mem_biUnion (x := (p, q)) (Finset.mem_coe.mpr (mem_product.mpr ⟨hp, hq⟩)) (by simp [badY, hpq, hEq])

/-- Finite set of intersection points of two distinct circles `c₁, c₂ : ℝ² × ℝ`, with card ≤ 2. -/
private lemma circle_inter_finite (c₁ c₂ : ℝ² × ℝ) (hne : c₁ ≠ c₂) :
    {p : ℝ² | dist c₁.1 p = c₁.2 ∧ dist c₂.1 p = c₂.2}.Finite ∧
    ∀ F : Finset ℝ², (∀ p ∈ F, dist c₁.1 p = c₁.2 ∧ dist c₂.1 p = c₂.2) → F.card ≤ 2 := by
  have hbound : ∀ F : Finset ℝ², (∀ p ∈ F, dist c₁.1 p = c₁.2 ∧ dist c₂.1 p = c₂.2) → F.card ≤ 2 := by
    intro F hF
    by_cases hx : c₁.1 = c₂.1
    · have hr : c₁.2 ≠ c₂.2 := fun h => hne (Prod.ext hx h)
      have hempty : F = ∅ := by
        ext p; simp only [notMem_empty, iff_false]; intro hp
        have ⟨h1, h2⟩ := hF p hp
        rw [hx] at h1; exact hr (h1.symm.trans h2)
      simp [hempty]
    · exact two_circles_inter_le_two hx c₁.2 c₂.2 F hF
  refine ⟨?_, hbound⟩
  by_contra hinf
  obtain ⟨F, hFsub, hFcard⟩ := Set.Infinite.exists_subset_card_eq hinf 3
  have := hbound F (fun p hp => hFsub hp)
  omega

/-- The `Finset ℝ²` of all intersection points of two distinct circles `c₁ ≠ c₂`. -/
private def circleInter (c₁ c₂ : ℝ² × ℝ) : Finset ℝ² :=
  if h : c₁ ≠ c₂ then (circle_inter_finite c₁ c₂ h).1.toFinset else ∅

private lemma mem_circleInter {c₁ c₂ : ℝ² × ℝ} (hne : c₁ ≠ c₂) {p : ℝ²} :
    p ∈ circleInter c₁ c₂ ↔ dist c₁.1 p = c₁.2 ∧ dist c₂.1 p = c₂.2 := by
  simp [circleInter, hne]

private lemma card_circleInter_le_two (c₁ c₂ : ℝ² × ℝ) : (circleInter c₁ c₂).card ≤ 2 := by
  dsimp only [circleInter]
  split_ifs with h
  · exact (circle_inter_finite c₁ c₂ h).2 _ (fun p hp => ((circle_inter_finite c₁ c₂ h).1.mem_toFinset).mp hp)
  · simp

/-- Upper (`s = true`) or lower (`s = false`) semicircle y-coordinate for circle `c = (x, r)`. -/
private def semiY (c : ℝ² × ℝ) (s : Bool) (t : ℝ) : ℝ :=
  c.1 1 + (if s then (1 : ℝ) else -1) * Real.sqrt (c.2 ^ 2 - (t - c.1 0) ^ 2)

private lemma semiY_continuous (c : ℝ² × ℝ) (s : Bool) : Continuous (semiY c s) := by
  unfold semiY
  fun_prop

private lemma semiY_on_circle {c : ℝ² × ℝ} (hr : 0 ≤ c.2) (s : Bool) {t : ℝ}
    (ht : (t - c.1 0) ^ 2 ≤ c.2 ^ 2) :
    dist c.1 (mkPt t (semiY c s t)) = c.2 := by
  have hnn : 0 ≤ c.2 ^ 2 - (t - c.1 0) ^ 2 := by linarith
  have hsq : dist c.1 (mkPt t (semiY c s t)) ^ 2 = c.2 ^ 2 := by
    rw [dist_sq_eq, mkPt_zero, mkPt_one]
    dsimp only [semiY]
    have hpm : (if s then (1 : ℝ) else -1) ^ 2 = 1 := by cases s <;> norm_num
    calc (c.1 0 - t) ^ 2 + (c.1 1 - (c.1 1 + (if s then (1 : ℝ) else -1) * Real.sqrt (c.2 ^ 2 - (t - c.1 0) ^ 2))) ^ 2
        = (t - c.1 0) ^ 2 + (if s then (1 : ℝ) else -1) ^ 2 * (Real.sqrt (c.2 ^ 2 - (t - c.1 0) ^ 2)) ^ 2 := by ring
      _ = (t - c.1 0) ^ 2 + 1 * (c.2 ^ 2 - (t - c.1 0) ^ 2) := by rw [hpm, Real.sq_sqrt hnn]
      _ = c.2 ^ 2 := by ring
  have hdn : 0 ≤ dist c.1 (mkPt t (semiY c s t)) := dist_nonneg
  nlinarith

private lemma semiY_eq_of_on_circle {c : ℝ² × ℝ} {s : Bool} {p : ℝ²}
    (hon : dist c.1 p = c.2) (hside : if s then c.1 1 < p 1 else p 1 < c.1 1) :
    semiY c s (p 0) = p 1 := by
  have hsq : (p 0 - c.1 0) ^ 2 + (p 1 - c.1 1) ^ 2 = c.2 ^ 2 := by
    have := congrArg (· ^ 2) hon; rw [dist_sq_eq] at this; linarith
  have hrad : c.2 ^ 2 - (p 0 - c.1 0) ^ 2 = (p 1 - c.1 1) ^ 2 := by linarith
  dsimp only [semiY]
  rw [hrad]
  cases s
  · simp only [Bool.false_eq_true, ↓reduceIte] at hside ⊢
    rw [Real.sqrt_sq_eq_abs, abs_of_neg (by linarith)]; linarith
  · simp only [↓reduceIte] at hside ⊢
    rw [Real.sqrt_sq_eq_abs, abs_of_pos (by linarith)]; linarith

/-- IVT crossing lemma: if continuous functions `f, g` satisfy `f a < g a` and `g b < f b`
for `a < b`, then there exists `x ∈ (a, b)` with `f x = g x`. -/
private lemma exists_eq_of_lt_gt {f g : ℝ → ℝ} (hf : Continuous f) (hg : Continuous g)
    {a b : ℝ} (hab : a < b) (h1 : f a < g a) (h2 : g b < f b) :
    ∃ x, a < x ∧ x < b ∧ f x = g x := by
  have hcont : ContinuousOn (fun x => f x - g x) (Set.Icc a b) := (hf.sub hg).continuousOn
  have h0 : (0 : ℝ) ∈ Set.Icc (f a - g a) (f b - g b) := ⟨by linarith, by linarith⟩
  obtain ⟨x, hxIcc, hx0⟩ := intermediate_value_Icc hab.le hcont h0
  refine ⟨x, ?_, ?_, by linarith⟩
  · rcases eq_or_lt_of_le hxIcc.1 with rfl | hlt
    · linarith
    · exact hlt
  · rcases eq_or_lt_of_le hxIcc.2 with rfl | hlt
    · linarith
    · exact hlt

/-! ### Part 2B-2: Consecutive Arcs, Key-Sorting, and Geometric Wiring Diagram -/

/-- Consecutive pairs of a list. -/
private def consecPairs {α : Type*} : List α → List (α × α)
  | [] => []
  | [_] => []
  | a :: b :: t => (a, b) :: consecPairs (b :: t)

private lemma consecPairs_length_le {α : Type*} (l : List α) :
    l.length ≤ (consecPairs l).length + 1 := by
  match l with
  | [] => simp [consecPairs]
  | [_] => simp [consecPairs]
  | _ :: b :: t =>
    have ih := consecPairs_length_le (b :: t)
    simp only [consecPairs, List.length_cons] at ih ⊢; omega

private lemma consecPairs_mem {α : Type*} {l : List α} {u v : α}
    (h : (u, v) ∈ consecPairs l) : u ∈ l ∧ v ∈ l := by
  match l with
  | [] => simp [consecPairs] at h
  | [_] => simp [consecPairs] at h
  | a :: b :: t =>
    simp only [consecPairs, List.mem_cons] at h
    rcases h with h1 | h2
    · cases h1; exact ⟨by simp, by simp⟩
    · have ⟨hu, hv⟩ := consecPairs_mem h2
      exact ⟨List.mem_cons_of_mem a hu, List.mem_cons_of_mem a hv⟩

private lemma consecPairs_lt {α : Type*} [LinearOrder α] {l : List α} (hp : l.Pairwise (· < ·))
    {u v : α} (h : (u, v) ∈ consecPairs l) : u < v := by
  match l with
  | [] => simp [consecPairs] at h
  | [_] => simp [consecPairs] at h
  | a :: b :: t =>
    rw [List.pairwise_cons] at hp
    simp only [consecPairs, List.mem_cons] at h
    rcases h with h1 | h2
    · cases h1; exact hp.1 v List.mem_cons_self
    · exact consecPairs_lt hp.2 h2

private lemma consecPairs_no_between {α : Type*} [LinearOrder α] {l : List α} (hp : l.Pairwise (· < ·))
    {u v : α} (h : (u, v) ∈ consecPairs l) {w : α} (hw : w ∈ l) : ¬(u < w ∧ w < v) := by
  match l with
  | [] => simp [consecPairs] at h
  | [_] => simp [consecPairs] at h
  | a :: b :: t =>
    rw [List.pairwise_cons] at hp
    have hp2 := hp.2
    rw [List.pairwise_cons] at hp2
    simp only [consecPairs, List.mem_cons] at h
    rcases h with h1 | h2
    · cases h1
      simp only [List.mem_cons] at hw
      rcases hw with rfl | rfl | hwt
      · intro ⟨h, _⟩; exact lt_irrefl _ h
      · intro ⟨_, h⟩; exact lt_irrefl _ h
      · intro ⟨_, hlt⟩; exact not_lt_of_gt (hp2.1 w hwt) hlt
    · simp only [List.mem_cons] at hw
      rcases hw with rfl | hwb
      · intro ⟨hlt, _⟩
        have hu_mem : u ∈ b :: t := (consecPairs_mem h2).1
        exact not_lt_of_gt (hp.1 u hu_mem) hlt
      · exact consecPairs_no_between hp.2 h2 (List.mem_cons.mpr hwb)

private lemma consecPairs_disjoint {α : Type*} [LinearOrder α] {l : List α} (hp : l.Pairwise (· < ·))
    {u₁ v₁ u₂ v₂ : α} (h1 : (u₁, v₁) ∈ consecPairs l) (h2 : (u₂, v₂) ∈ consecPairs l)
    (hne : (u₁, v₁) ≠ (u₂, v₂)) : v₁ ≤ u₂ ∨ v₂ ≤ u₁ := by
  match l with
  | [] => simp [consecPairs] at h1
  | [_] => simp [consecPairs] at h1
  | a :: b :: t =>
    rw [List.pairwise_cons] at hp
    have hp2 := hp.2
    rw [List.pairwise_cons] at hp2
    simp only [consecPairs, List.mem_cons] at h1 h2
    rcases h1 with h1a | h1b <;> rcases h2 with h2a | h2b
    · cases h1a; cases h2a; exact absurd rfl hne
    · cases h1a
      have hu2_mem : u₂ ∈ v₁ :: t := (consecPairs_mem h2b).1
      simp only [List.mem_cons] at hu2_mem
      rcases hu2_mem with rfl | ht
      · exact Or.inl le_rfl
      · exact Or.inl (hp2.1 u₂ ht).le
    · cases h2a
      have hu1_mem : u₁ ∈ v₂ :: t := (consecPairs_mem h1b).1
      simp only [List.mem_cons] at hu1_mem
      rcases hu1_mem with rfl | ht
      · exact Or.inr le_rfl
      · exact Or.inr (hp2.1 u₁ ht).le
    · exact consecPairs_disjoint hp.2 h1b h2b hne

private lemma consecPairs_nodup {α : Type*} [LinearOrder α] {l : List α} (hp : l.Pairwise (· < ·)) :
    (consecPairs l).Nodup := by
  match l with
  | [] => simp [consecPairs]
  | [_] => simp [consecPairs]
  | a :: b :: t =>
    rw [List.pairwise_cons] at hp
    simp only [consecPairs, List.nodup_cons]
    refine ⟨?_, consecPairs_nodup hp.2⟩
    intro hmem
    have ha_mem : a ∈ b :: t := (consecPairs_mem hmem).1
    exact lt_irrefl a (hp.1 a ha_mem)

/-- Sort a `Finset α` by a real-valued key that is injective on `S`. -/
private lemma sort_by_key {α : Type*} [DecidableEq α] [BEq α] [LawfulBEq α] (S : Finset α) (key : α → ℝ)
    (hinj : Set.InjOn key S) :
    ∃ L : List α, L.Nodup ∧ (∀ x, x ∈ L ↔ x ∈ S) ∧
      ∀ x ∈ L, ∀ y ∈ L, L.idxOf x < L.idxOf y ↔ key x < key y := by
  let Y : Finset ℝ := S.image key
  let eY : Fin Y.card ≃o Y := Y.orderIsoOfFin rfl
  let inv : Fin Y.card → α := fun i => Classical.choose (mem_image.mp (eY i).2)
  have hinv_spec : ∀ i : Fin Y.card, inv i ∈ S ∧ key (inv i) = (eY i).1 :=
    fun i => Classical.choose_spec (mem_image.mp (eY i).2)
  have hinv_inj : Function.Injective inv := fun i j h => by
    have hkey : (eY i).1 = (eY j).1 := by rw [← (hinv_spec i).2, ← (hinv_spec j).2, h]
    exact eY.injective (Subtype.ext hkey)
  let L : List α := (List.finRange Y.card).map inv
  have hnd : L.Nodup := (List.nodup_finRange Y.card).map hinv_inj
  have hmem : ∀ x, x ∈ L ↔ x ∈ S := by
    intro x
    simp only [L, List.mem_map, List.mem_finRange, true_and]
    constructor
    · rintro ⟨i, rfl⟩; exact (hinv_spec i).1
    · intro hx
      let i : Fin Y.card := eY.symm ⟨key x, mem_image_of_mem key hx⟩
      refine ⟨i, hinj (hinv_spec i).1 hx ?_⟩
      rw [(hinv_spec i).2]
      exact congrArg Subtype.val (eY.apply_symm_apply ⟨key x, mem_image_of_mem key hx⟩)
  have hidx_eq : ∀ i : Fin Y.card, L.idxOf (inv i) = i.val := by
    intro i
    have hi : i.val < L.length := by simp [L]
    have hget : L[i.val]'hi = inv i := by simp [L]
    conv_lhs => rw [← hget]
    exact List.Nodup.idxOf_getElem hnd i.val hi
  refine ⟨L, hnd, hmem, fun x hx y hy => ?_⟩
  obtain ⟨i, rfl⟩ : ∃ i, inv i = x := by simpa [L] using hx
  obtain ⟨j, rfl⟩ : ∃ j, inv j = y := by simpa [L] using hy
  rw [hidx_eq i, hidx_eq j, (hinv_spec i).2, (hinv_spec j).2]
  exact ⟨fun h => eY.strictMono (Fin.mk_lt_mk.mpr h), fun h => by
    have : i < j := eY.strictMono.lt_iff_lt.mp h; exact this⟩

/-- Two `Nodup` lists with the same membership and same relative order are equal. -/
private lemma list_eq_of_same_order {α : Type*} [DecidableEq α] [BEq α] [LawfulBEq α] {L₁ L₂ : List α}
    (h1 : L₁.Nodup) (h2 : L₂.Nodup) (hmem : ∀ x, x ∈ L₁ ↔ x ∈ L₂)
    (hord : ∀ x ∈ L₁, ∀ y ∈ L₁, L₁.idxOf x < L₁.idxOf y → L₂.idxOf x < L₂.idxOf y) :
    L₁ = L₂ := by
  have hperm : L₁.Perm L₂ := (List.perm_ext_iff_of_nodup h1 h2).mpr hmem
  have hinv0 : (invSet L₁ L₂).card = 0 := by
    rw [card_eq_zero, eq_empty_iff_forall_notMem]
    intro ⟨x, y⟩ hxy
    rw [invSet, mem_filter, mem_product, List.mem_toFinset, List.mem_toFinset] at hxy
    exact lt_asymm (hord x hxy.1.1 y hxy.1.2 hxy.2.1) hxy.2.2
  obtain ⟨states, _, hs0, hs1, _⟩ := bubble_sort_chain 0 L₁ L₂ h1 h2 hperm hinv0
  exact hs0.symm.trans hs1

/-- Partition a `Nodup` list into `pre ++ mid ++ post` using two predicates `P, M, Q` that
respect the list order: every `P` comes before every `M` and `Q`, and every `M` comes before every `Q`. -/
private lemma list_split_three {α : Type*} [DecidableEq α] [BEq α] [LawfulBEq α] (L : List α) (hnd : L.Nodup)
    (P M Q : α → Bool)
    (hpart : ∀ x ∈ L, (P x = true ∧ M x = false ∧ Q x = false) ∨
                      (P x = false ∧ M x = true ∧ Q x = false) ∨
                      (P x = false ∧ M x = false ∧ Q x = true))
    (hPM : ∀ x ∈ L, ∀ y ∈ L, P x = true → M y = true → L.idxOf x < L.idxOf y)
    (hPQ : ∀ x ∈ L, ∀ y ∈ L, P x = true → Q y = true → L.idxOf x < L.idxOf y)
    (hMQ : ∀ x ∈ L, ∀ y ∈ L, M x = true → Q y = true → L.idxOf x < L.idxOf y) :
    L = L.filter P ++ L.filter M ++ L.filter Q := by
  let R := L.filter P ++ L.filter M ++ L.filter Q
  have hndP : (L.filter P).Nodup := hnd.filter P
  have hndM : (L.filter M).Nodup := hnd.filter M
  have hndQ : (L.filter Q).Nodup := hnd.filter Q
  have hdisjPM : List.Disjoint (L.filter P) (L.filter M) := by
    intro x h1 h2; rw [List.mem_filter] at h1 h2
    rcases hpart x h1.1 with ⟨_, hm, _⟩ | ⟨hp, _, _⟩ | ⟨hp, _, _⟩ <;> simp_all
  have hdisjPQ : List.Disjoint (L.filter P) (L.filter Q) := by
    intro x h1 h2; rw [List.mem_filter] at h1 h2
    rcases hpart x h1.1 with ⟨_, _, hq⟩ | ⟨hp, _, _⟩ | ⟨hp, _, _⟩ <;> simp_all
  have hdisjMQ : List.Disjoint (L.filter M) (L.filter Q) := by
    intro x h1 h2; rw [List.mem_filter] at h1 h2
    rcases hpart x h1.1 with ⟨_, hm, _⟩ | ⟨_, _, hq⟩ | ⟨_, hm, _⟩ <;> simp_all
  have hndR : R.Nodup := by
    dsimp only [R]
    rw [List.nodup_append, List.nodup_append]
    refine ⟨⟨hndP, hndM, fun x hx y hy hxy => hdisjPM hx (hxy ▸ hy)⟩, hndQ, fun x hx1 y hy2 hxy => ?_⟩
    rw [List.mem_append] at hx1
    rcases hx1 with h | h
    · exact hdisjPQ h (hxy ▸ hy2)
    · exact hdisjMQ h (hxy ▸ hy2)
  have hmemR : ∀ x, x ∈ L ↔ x ∈ R := by
    intro x
    simp only [R, List.mem_append, List.mem_filter]
    constructor
    · intro hx
      rcases hpart x hx with ⟨hp, _, _⟩ | ⟨_, hm, _⟩ | ⟨_, _, hq⟩
      · exact Or.inl (Or.inl ⟨hx, hp⟩)
      · exact Or.inl (Or.inr ⟨hx, hm⟩)
      · exact Or.inr ⟨hx, hq⟩
    · rintro ((⟨hx, _⟩ | ⟨hx, _⟩) | ⟨hx, _⟩) <;> exact hx
  have hfilt_ord : ∀ (B : α → Bool) (x y : α), x ∈ L.filter B → y ∈ L.filter B →
      L.idxOf x < L.idxOf y → (L.filter B).idxOf x < (L.filter B).idxOf y := by
    intro B x y hx hy hlt
    -- Proof by induction on L
    clear hpart hPM hPQ hMQ hndP hndM hndQ hdisjPM hdisjPQ hdisjMQ hndR hmemR R
    induction L with
    | nil => simp at hx
    | cons a t ih =>
      rw [List.nodup_cons] at hnd
      simp only [List.filter_cons] at hx hy ⊢
      by_cases hB : B a = true
      · simp only [hB, ↓reduceIte] at hx hy ⊢
        by_cases hxa : x = a
        · subst hxa
          have hya : y ≠ x := fun h => by subst h; omega
          simp [List.idxOf_cons_self, List.idxOf_cons_ne _ hya.symm]
        · have hya : y ≠ a := fun h => by
            subst h; simp [List.idxOf_cons_self, List.idxOf_cons_ne _ (Ne.symm hxa)] at hlt
          simp only [List.idxOf_cons_ne _ (Ne.symm hxa), List.idxOf_cons_ne _ (Ne.symm hya)] at hlt ⊢
          have hx' : x ∈ t.filter B := by simpa [hxa] using hx
          have hy' : y ∈ t.filter B := by simpa [hya] using hy
          exact Nat.succ_lt_succ (ih hnd.2 hx' hy' (Nat.lt_of_succ_lt_succ hlt))
      · have hBf : B a = false := Bool.eq_false_iff.mpr hB
        simp only [hBf, Bool.false_eq_true, ↓reduceIte] at hx hy ⊢
        have hxa : x ≠ a := fun h => by subst h; rw [List.mem_filter] at hx; exact hnd.1 hx.1
        have hya : y ≠ a := fun h => by subst h; rw [List.mem_filter] at hy; exact hnd.1 hy.1
        simp only [List.idxOf_cons_ne _ (Ne.symm hxa), List.idxOf_cons_ne _ (Ne.symm hya)] at hlt
        exact ih hnd.2 hx hy (Nat.lt_of_succ_lt_succ hlt)
  have hidx_app_l : ∀ {l₁ l₂ : List α} {x : α}, x ∈ l₁ → (l₁ ++ l₂).idxOf x = l₁.idxOf x :=
    fun h => List.idxOf_append_of_mem h
  have hidx_app_r : ∀ {l₁ l₂ : List α} {x : α}, x ∉ l₁ → (l₁ ++ l₂).idxOf x = l₁.length + l₂.idxOf x :=
    fun h => List.idxOf_append_of_notMem h
  apply list_eq_of_same_order hnd hndR hmemR
  intro x hx y hy hlt
  have hidx_x_lt : ∀ {l : List α} {z : α}, z ∈ l → l.idxOf z < l.length := fun h => List.idxOf_lt_length_iff.mpr h
  rcases hpart x hx with ⟨hPx, hMx, hQx⟩ | ⟨hPx, hMx, hQx⟩ | ⟨hPx, hMx, hQx⟩ <;>
  rcases hpart y hy with ⟨hPy, hMy, hQy⟩ | ⟨hPy, hMy, hQy⟩ | ⟨hPy, hMy, hQy⟩
  · have hxP : x ∈ L.filter P := List.mem_filter.mpr ⟨hx, hPx⟩
    have hyP : y ∈ L.filter P := List.mem_filter.mpr ⟨hy, hPy⟩
    dsimp only [R]
    rw [hidx_app_l (List.mem_append_left _ hxP), hidx_app_l hxP,
        hidx_app_l (List.mem_append_left _ hyP), hidx_app_l hyP]
    exact hfilt_ord P x y hxP hyP hlt
  · have hxP : x ∈ L.filter P := List.mem_filter.mpr ⟨hx, hPx⟩
    have hyM : y ∈ L.filter M := List.mem_filter.mpr ⟨hy, hMy⟩
    have hyNP : y ∉ L.filter P := fun h => by rw [List.mem_filter] at h; simp [hPy] at h
    dsimp only [R]
    rw [hidx_app_l (List.mem_append_left _ hxP), hidx_app_l hxP,
        hidx_app_l (List.mem_append_right _ hyM), hidx_app_r hyNP]
    have := hidx_x_lt hxP; omega
  · have hxP : x ∈ L.filter P := List.mem_filter.mpr ⟨hx, hPx⟩
    have hyQ : y ∈ L.filter Q := List.mem_filter.mpr ⟨hy, hQy⟩
    have hyNPM : y ∉ L.filter P ++ L.filter M := by simp [List.mem_filter, hPy, hMy]
    dsimp only [R]
    rw [hidx_app_l (List.mem_append_left _ hxP), hidx_app_l hxP, hidx_app_r hyNPM, List.length_append]
    have := hidx_x_lt hxP; omega
  · exact absurd (hPM y hy x hx hPy hMx) (not_lt_of_gt hlt)
  · have hxM : x ∈ L.filter M := List.mem_filter.mpr ⟨hx, hMx⟩
    have hyM : y ∈ L.filter M := List.mem_filter.mpr ⟨hy, hMy⟩
    have hxNP : x ∉ L.filter P := fun h => by rw [List.mem_filter] at h; simp [hPx] at h
    have hyNP : y ∉ L.filter P := fun h => by rw [List.mem_filter] at h; simp [hPy] at h
    dsimp only [R]
    rw [hidx_app_l (List.mem_append_right _ hxM), hidx_app_r hxNP,
        hidx_app_l (List.mem_append_right _ hyM), hidx_app_r hyNP]
    have := hfilt_ord M x y hxM hyM hlt; omega
  · have hxM : x ∈ L.filter M := List.mem_filter.mpr ⟨hx, hMx⟩
    have hxNP : x ∉ L.filter P := fun h => by rw [List.mem_filter] at h; simp [hPx] at h
    have hyNPM : y ∉ L.filter P ++ L.filter M := by simp [List.mem_filter, hPy, hMy]
    dsimp only [R]
    rw [hidx_app_l (List.mem_append_right _ hxM), hidx_app_r hxNP, hidx_app_r hyNPM, List.length_append]
    have := hidx_x_lt hxM; omega
  · exact absurd (hPQ y hy x hx hPy hQx) (not_lt_of_gt hlt)
  · exact absurd (hMQ y hy x hx hMy hQx) (not_lt_of_gt hlt)
  · have hxQ : x ∈ L.filter Q := List.mem_filter.mpr ⟨hx, hQx⟩
    have hyQ : y ∈ L.filter Q := List.mem_filter.mpr ⟨hy, hQy⟩
    have hxNPM : x ∉ L.filter P ++ L.filter M := by simp [List.mem_filter, hPx, hMx]
    have hyNPM : y ∉ L.filter P ++ L.filter M := by simp [List.mem_filter, hPy, hMy]
    dsimp only [R]
    rw [hidx_app_r hxNPM, hidx_app_r hyNPM]
    have := hfilt_ord Q x y hxQ hyQ hlt; omega

/-- Circle family of `(A, B)`: all circles `(x, r)` with `x ∈ B` and `r = dist x y` for some `y ∈ A \ {x}`. -/
private def circleFamily (A B : Finset ℝ²) : Finset (ℝ² × ℝ) :=
  B.biUnion fun x => ((A.erase x).image (dist x ·)).image (fun r => (x, r))

private lemma card_circleFamily (A B : Finset ℝ²) :
    (circleFamily A B).card = ∑ x ∈ B, distinctDistancesFrom A x := by
  unfold circleFamily
  rw [card_biUnion]
  · refine sum_congr rfl fun x _ => ?_
    rw [card_image_of_injective _ (fun r₁ r₂ h => (Prod.mk.inj h).2)]
    unfold distinctDistancesFrom
    congr 1; ext r; simp [dist_comm]
  · intro x₁ _ x₂ _ hne
    refine Finset.disjoint_left.mpr fun c h1 h2 => ?_
    obtain ⟨r₁, _, rfl⟩ := mem_image.mp h1
    obtain ⟨r₂, _, h2'⟩ := mem_image.mp h2
    exact hne (Prod.mk.inj h2').1.symm

/-- Pairwise intersections of all distinct circles in `𝒞`. -/
private def allCircleInters (𝒞 : Finset (ℝ² × ℝ)) : Finset ℝ² :=
  (𝒞 ×ˢ 𝒞).biUnion fun p => circleInter p.1 p.2

set_option maxHeartbeats 800000 in
/-- Core Székely bound in generic position: if `65 ≤ |B|`, `8 |𝒞| < |A| |B|`, and `A ∪ W` has
pairwise distinct x- and y-coordinates, then `|A| |B|^3 ≤ 65536 |𝒞|^2`. -/
private theorem szekely_generic (A B : Finset ℝ²) (hBA : B ⊆ A) (hB65 : 65 ≤ B.card)
    (hndeg : ∀ y ∈ A, ∀ z ∈ A, y ≠ z → (B.filter fun x => dist x y = dist x z).card ≤ 2)
    (hMlt : 8 * (circleFamily A B).card < A.card * B.card)
    (hgenX : ∀ p ∈ A ∪ allCircleInters (circleFamily A B),
      ∀ q ∈ A ∪ allCircleInters (circleFamily A B), p ≠ q → p 0 ≠ q 0)
    (hgenY : ∀ p ∈ A ∪ allCircleInters (circleFamily A B),
      ∀ q ∈ A ∪ allCircleInters (circleFamily A B), p ≠ q → p 1 ≠ q 1) :
    A.card * B.card ^ 3 ≤ 65536 * (circleFamily A B).card ^ 2 := by
  let 𝒞 := circleFamily A B
  let W := allCircleInters 𝒞
  have hB_le_A : B.card ≤ A.card := card_le_card hBA
  have hn65 : 65 ≤ A.card := hB65.trans hB_le_A
  let n := A.card
  -- Step 1: Enumerate A in strictly increasing order of x-coordinate
  have hXA_inj : Set.InjOn (fun p : ℝ² => p 0) (A : Set ℝ²) := fun p hp q hq h => by
    by_contra hne; exact hgenX p (mem_union_left _ hp) q (mem_union_left _ hq) hne h
  let XA : Finset ℝ := A.image (· 0)
  have hXA_card : XA.card = n := card_image_of_injOn hXA_inj
  let eXA : Fin n ≃o XA := XA.orderIsoOfFin hXA_card
  let pt : Fin n → ℝ² := fun i => Classical.choose (mem_image.mp (eXA i).2)
  have hpt_spec : ∀ i : Fin n, pt i ∈ A ∧ (pt i) 0 = (eXA i).1 :=
    fun i => Classical.choose_spec (mem_image.mp (eXA i).2)
  have hpt_mem : ∀ i : Fin n, pt i ∈ A := fun i => (hpt_spec i).1
  have hpt_mono : StrictMono (fun i : Fin n => (pt i) 0) := fun i j hij => by
    dsimp only; rw [(hpt_spec i).2, (hpt_spec j).2]; exact eXA.strictMono hij
  have hpt_inj : Function.Injective pt := fun i j h =>
    hpt_mono.injective (congrArg (fun p : ℝ² => p 0) h)
  have hpt_surj : ∀ p ∈ A, ∃ i : Fin n, pt i = p := fun p hp => by
    let i : Fin n := eXA.symm ⟨p 0, mem_image_of_mem _ hp⟩
    refine ⟨i, hXA_inj (hpt_mem i) hp ?_⟩
    dsimp only; rw [(hpt_spec i).2]
    exact congrArg Subtype.val (eXA.apply_symm_apply ⟨p 0, mem_image_of_mem _ hp⟩)
  -- Circle properties
  have h𝒞_prop : ∀ c ∈ 𝒞, c.1 ∈ B ∧ 0 < c.2 := by
    intro c hc
    obtain ⟨x, hxB, hc'⟩ := mem_biUnion.mp hc
    obtain ⟨r, hr, rfl⟩ := mem_image.mp hc'
    obtain ⟨y, hy, rfl⟩ := mem_image.mp hr
    exact ⟨hxB, dist_pos.mpr (mem_erase.mp hy).1.symm⟩
  -- Step 2: Semicircle vertex lists and consecutive arcs
  let V : (ℝ² × ℝ) → Bool → Finset (Fin n) := fun c s =>
    univ.filter fun i => dist c.1 (pt i) = c.2 ∧ (if s then c.1 1 < (pt i) 1 else (pt i) 1 < c.1 1)
  let L : (ℝ² × ℝ) → Bool → List (Fin n) := fun c s => (V c s).sort (· ≤ ·)
  have hL_pw : ∀ c s, (L c s).Pairwise (· < ·) := fun c s =>
    List.pairwise_iff_getElem.mpr fun i j hi hj hij =>
      lt_of_le_of_ne (List.pairwise_iff_getElem.mp ((V c s).pairwise_sort (· ≤ ·)) i j hi hj hij)
        (fun h => hij.ne ((List.Nodup.getElem_inj_iff ((V c s).sort_nodup (· ≤ ·))).mp h))
  have hL_mem : ∀ c s i, i ∈ L c s ↔ i ∈ V c s := fun c s i => Finset.mem_sort (· ≤ ·)
  let CS : Finset ((ℝ² × ℝ) × Bool) := 𝒞 ×ˢ ({false, true} : Finset Bool)
  let arcsOf : (ℝ² × ℝ) × Bool → Finset (DirEdge n) := fun cs => (consecPairs (L cs.1 cs.2)).toFinset
  let E : Finset (DirEdge n) := CS.biUnion arcsOf
  have hE_lt : ∀ e ∈ E, e.1 < e.2 := by
    intro e he
    obtain ⟨cs, _, hcs⟩ := mem_biUnion.mp he
    exact consecPairs_lt (hL_pw cs.1 cs.2) (List.mem_toFinset.mp hcs)
  -- Pick one representative semicircle rep e = (c_e, s_e) for each e ∈ E
  have hrep_ex : ∀ e : DirEdge n, e ∈ E → ∃ cs ∈ CS, e ∈ arcsOf cs := fun e he => mem_biUnion.mp he
  let rep : ∀ e : DirEdge n, e ∈ E → (ℝ² × ℝ) × Bool := fun e he => Classical.choose (hrep_ex e he)
  have hrep_spec : ∀ e (he : e ∈ E), rep e he ∈ CS ∧ e ∈ arcsOf (rep e he) :=
    fun e he => Classical.choose_spec (hrep_ex e he)
  -- Step 3: Double counting |E|
  have hmult_le_two : ∀ e ∈ E, (CS.filter fun cs => e ∈ arcsOf cs).card ≤ 2 := by
    intro e he
    have hlt := hE_lt e he
    have hpt_ne : pt e.1 ≠ pt e.2 := fun h => hlt.ne (hpt_inj h)
    let F := CS.filter fun cs => e ∈ arcsOf cs
    have hsub : F.image (fun cs => cs.1.1) ⊆ B.filter (fun x => dist x (pt e.1) = dist x (pt e.2)) := by
      intro x hx
      obtain ⟨⟨c, s⟩, hcs, rfl⟩ := mem_image.mp hx
      rw [mem_filter] at hcs
      have hcC : c ∈ 𝒞 := (mem_product.mp hcs.1).1
      have hpair := consecPairs_mem (List.mem_toFinset.mp hcs.2)
      have hv1 := (mem_filter.mp ((hL_mem c s e.1).mp hpair.1)).2
      have hv2 := (mem_filter.mp ((hL_mem c s e.2).mp hpair.2)).2
      exact mem_filter.mpr ⟨(h𝒞_prop c hcC).1, hv1.1.trans hv2.1.symm⟩
    have hinj : Set.InjOn (fun cs : (ℝ² × ℝ) × Bool => cs.1.1) (F : Set ((ℝ² × ℝ) × Bool)) := by
      intro ⟨c₁, s₁⟩ h1 ⟨c₂, s₂⟩ h2 hxeq
      dsimp only at hxeq
      rw [mem_coe, mem_filter] at h1 h2
      have hv1 := (mem_filter.mp ((hL_mem c₁ s₁ e.1).mp (consecPairs_mem (List.mem_toFinset.mp h1.2)).1)).2
      have hv2 := (mem_filter.mp ((hL_mem c₂ s₂ e.1).mp (consecPairs_mem (List.mem_toFinset.mp h2.2)).1)).2
      have hreq : c₁.2 = c₂.2 := by rw [← hv1.1, ← hv2.1, hxeq]
      have hceq : c₁ = c₂ := Prod.ext hxeq hreq
      have hseq : s₁ = s₂ := by
        cases s₁ <;> cases s₂
        · rfl
        · exfalso; rw [hxeq] at hv1; simp at hv1 hv2; linarith
        · exfalso; rw [hxeq] at hv1; simp at hv1 hv2; linarith
        · rfl
      exact Prod.ext hceq hseq
    calc F.card = (F.image (fun cs => cs.1.1)).card := (card_image_of_injOn hinj).symm
      _ ≤ (B.filter fun x => dist x (pt e.1) = dist x (pt e.2)).card := card_le_card hsub
      _ ≤ 2 := hndeg (pt e.1) (hpt_mem e.1) (pt e.2) (hpt_mem e.2) hpt_ne
  have hsum_arcs_le : ∑ cs ∈ CS, (arcsOf cs).card ≤ 2 * E.card := by
    have hswap : ∑ cs ∈ CS, (arcsOf cs).card = ∑ e ∈ E, (CS.filter fun cs => e ∈ arcsOf cs).card := by
      calc ∑ cs ∈ CS, (arcsOf cs).card
          = ∑ cs ∈ CS, ∑ e ∈ E, if e ∈ arcsOf cs then 1 else 0 := by
              refine sum_congr rfl fun cs hcs => ?_
              rw [← sum_filter, sum_const, smul_eq_mul, mul_one]
              congr 1; ext e; simp only [mem_filter]
              exact ⟨fun h => ⟨mem_biUnion.mpr ⟨cs, hcs, h⟩, h⟩, fun h => h.2⟩
        _ = ∑ e ∈ E, ∑ cs ∈ CS, if e ∈ arcsOf cs then 1 else 0 := Finset.sum_comm
        _ = ∑ e ∈ E, (CS.filter fun cs => e ∈ arcsOf cs).card := by
              refine sum_congr rfl fun e _ => ?_
              rw [← sum_filter, sum_const, smul_eq_mul, mul_one]
    rw [hswap]
    calc ∑ e ∈ E, (CS.filter fun cs => e ∈ arcsOf cs).card
        ≤ ∑ _e ∈ E, 2 := sum_le_sum hmult_le_two
      _ = 2 * E.card := by rw [sum_const, smul_eq_mul, mul_comm]
  have hsum_V_eq : ∑ cs ∈ CS, (V cs.1 cs.2).card = B.card * (A.card - 1) := by
    let Pairs := B.biUnion fun x => (A.erase x).image fun y => (x, y)
    have hPairs_card : Pairs.card = B.card * (A.card - 1) := by
      rw [card_biUnion]
      · calc ∑ x ∈ B, ((A.erase x).image fun y => (x, y)).card
            = ∑ x ∈ B, (A.erase x).card := sum_congr rfl fun x _ =>
                card_image_of_injective _ (fun _ _ h => (Prod.mk.inj h).2)
          _ = ∑ _x ∈ B, (A.card - 1) := sum_congr rfl fun x hx => card_erase_of_mem (hBA hx)
          _ = B.card * (A.card - 1) := by rw [sum_const, smul_eq_mul]
      · intro x₁ _ x₂ _ hne
        refine Finset.disjoint_left.mpr fun p h1 h2 => ?_
        obtain ⟨y₁, _, rfl⟩ := mem_image.mp h1
        obtain ⟨y₂, _, h2'⟩ := mem_image.mp h2
        exact hne (Prod.mk.inj h2').1.symm
    let Inc := CS.biUnion fun cs => (V cs.1 cs.2).image fun i => (cs, i)
    have hInc_card : Inc.card = ∑ cs ∈ CS, (V cs.1 cs.2).card := by
      rw [card_biUnion]
      · exact sum_congr rfl fun cs _ => card_image_of_injective _ (fun _ _ h => (Prod.mk.inj h).2)
      · intro cs₁ _ cs₂ _ hne
        refine Finset.disjoint_left.mpr fun p h1 h2 => ?_
        obtain ⟨i₁, _, rfl⟩ := mem_image.mp h1
        obtain ⟨i₂, _, h2'⟩ := mem_image.mp h2
        exact hne (Prod.mk.inj h2').1.symm
    rw [← hInc_card, ← hPairs_card]
    refine Finset.card_bij (fun p _ => (p.1.1.1, pt p.2)) ?_ ?_ ?_
    · intro ⟨⟨c, s⟩, i⟩ hp
      obtain ⟨⟨c', s'⟩, hcs', hpi⟩ := mem_biUnion.mp hp
      obtain ⟨i', hi', heq⟩ := mem_image.mp hpi
      cases heq
      have hcC : c ∈ 𝒞 := (mem_product.mp hcs').1
      have hv := (mem_filter.mp hi').2
      have hne : pt i ≠ c.1 := fun h => by
        have := (h𝒞_prop c hcC).2; rw [h, dist_self] at hv; linarith
      exact mem_biUnion.mpr ⟨c.1, (h𝒞_prop c hcC).1,
        mem_image.mpr ⟨pt i, mem_erase.mpr ⟨hne, hpt_mem i⟩, rfl⟩⟩
    · intro ⟨⟨c₁, s₁⟩, i₁⟩ h1 ⟨⟨c₂, s₂⟩, i₂⟩ h2 heq
      have hxeq : c₁.1 = c₂.1 := (Prod.mk.inj heq).1
      have hiq : i₁ = i₂ := hpt_inj (Prod.mk.inj heq).2
      subst hiq
      obtain ⟨cs₁, _, hpi1⟩ := mem_biUnion.mp h1
      obtain ⟨i₁', hi1', he1⟩ := mem_image.mp hpi1; cases he1
      obtain ⟨cs₂, _, hpi2⟩ := mem_biUnion.mp h2
      obtain ⟨i₂', hi2', he2⟩ := mem_image.mp hpi2; cases he2
      have hv1 := (mem_filter.mp hi1').2
      have hv2 := (mem_filter.mp hi2').2
      have hreq : c₁.2 = c₂.2 := by rw [← hv1.1, ← hv2.1, hxeq]
      have hseq : s₁ = s₂ := by
        cases s₁ <;> cases s₂
        · rfl
        · exfalso; rw [hxeq] at hv1; simp at hv1 hv2; linarith
        · exfalso; rw [hxeq] at hv1; simp at hv1 hv2; linarith
        · rfl
      exact Prod.ext (Prod.ext (Prod.ext hxeq hreq) hseq) rfl
    · intro ⟨x, y⟩ hxy
      obtain ⟨x', hxB, hy'⟩ := mem_biUnion.mp hxy
      obtain ⟨y', hyEr, heq⟩ := mem_image.mp hy'
      cases heq
      obtain ⟨hyx, hyA⟩ := mem_erase.mp hyEr
      obtain ⟨i, rfl⟩ := hpt_surj y hyA
      have hyne : (pt i) 1 ≠ x 1 := hgenY (pt i) (mem_union_left _ (hpt_mem i)) x (mem_union_left _ (hBA hxB)) hyx
      let c : ℝ² × ℝ := (x, dist x (pt i))
      have hcC : c ∈ 𝒞 := mem_biUnion.mpr ⟨x, hxB, mem_image.mpr ⟨dist x (pt i), mem_image_of_mem _ hyEr, rfl⟩⟩
      let s : Bool := decide (x 1 < (pt i) 1)
      have hcs : (c, s) ∈ CS := mem_product.mpr ⟨hcC, by cases s <;> simp⟩
      have hiV : i ∈ V c s := by
        refine mem_filter.mpr ⟨mem_univ _, rfl, ?_⟩
        by_cases hlt : x 1 < (pt i) 1
        · simp only [s, hlt, decide_true, ↓reduceIte]; exact hlt
        · simp only [s, hlt, decide_false, Bool.false_eq_true, ↓reduceIte]; exact lt_of_le_of_ne (not_lt.mp hlt) hyne
      exact ⟨((c, s), i), mem_biUnion.mpr ⟨(c, s), hcs, mem_image_of_mem _ hiV⟩, rfl⟩
  have hE_lower : B.card * (A.card - 1) ≤ 2 * E.card + 2 * 𝒞.card := by
    have hV_le : ∀ cs ∈ CS, (V cs.1 cs.2).card ≤ (arcsOf cs).card + 1 := by
      intro cs _
      have h1 : (V cs.1 cs.2).card = (L cs.1 cs.2).length := (Finset.length_sort (· ≤ ·)).symm
      have h2 : (consecPairs (L cs.1 cs.2)).length = (arcsOf cs).card :=
        (List.toFinset_card_of_nodup (consecPairs_nodup (hL_pw cs.1 cs.2))).symm
      rw [h1, ← h2]
      exact consecPairs_length_le _
    have hCS_card : CS.card = 2 * 𝒞.card := by
      rw [card_product, card_pair (by decide), mul_comm]
    calc B.card * (A.card - 1) = ∑ cs ∈ CS, (V cs.1 cs.2).card := hsum_V_eq.symm
      _ ≤ ∑ cs ∈ CS, ((arcsOf cs).card + 1) := sum_le_sum hV_le
      _ = ∑ cs ∈ CS, (arcsOf cs).card + CS.card := by rw [sum_add_distrib, sum_const, smul_eq_mul, mul_one]
      _ ≤ 2 * E.card + 2 * 𝒞.card := by rw [hCS_card]; omega
  have h4E : A.card * B.card ≤ 4 * E.card := by
    have hAB_sub : B.card * (A.card - 1) + B.card = A.card * B.card := by
      have : 1 ≤ A.card := by omega
      zify [this]; ring
    nlinarith
  have h4n_le_E : 4 * n ≤ E.card := by dsimp [n]; nlinarith
  -- Step 4: Critical x-coordinates Xcrit, midpoints ξ, and slabs
  let Xcrit : Finset ℝ := (A ∪ W).image (· 0)
  let K := Xcrit.card
  let eXc : Fin K ≃o Xcrit := Xcrit.orderIsoOfFin rfl
  let xs : Fin K → ℝ := fun k => (eXc k).1
  have hxs_mono : StrictMono xs := fun i j hij => eXc.strictMono hij
  let vertSlab : Fin n → Fin K := fun v =>
    eXc.symm ⟨(pt v) 0, mem_image_of_mem _ (mem_union_left _ (hpt_mem v))⟩
  have hxs_vert : ∀ v : Fin n, xs (vertSlab v) = (pt v) 0 := fun v =>
    congrArg Subtype.val (eXc.apply_symm_apply _)
  have hvm : StrictMono vertSlab := fun u v huv => by
    rw [← hxs_mono.lt_iff_lt, hxs_vert, hxs_vert]; exact hpt_mono huv
  -- Active edges on slab j
  let act : Fin (K + 1) → Finset (DirEdge n) := fun j =>
    E.filter fun e => (vertSlab e.1).val < j.val ∧ j.val ≤ (vertSlab e.2).val
  -- Semicircle y-function for each edge e ∈ E
  let edgeY : ∀ e : DirEdge n, e ∈ E → ℝ → ℝ := fun e he => semiY (rep e he).1 (rep e he).2
  have hedgeY_cont : ∀ e (he : e ∈ E), Continuous (edgeY e he) := fun e he => semiY_continuous _ _
  have hedge_ends : ∀ e (he : e ∈ E),
      edgeY e he ((pt e.1) 0) = (pt e.1) 1 ∧ edgeY e he ((pt e.2) 0) = (pt e.2) 1 := by
    intro e he
    have hpair := consecPairs_mem (List.mem_toFinset.mp (hrep_spec e he).2)
    have hv1 := (mem_filter.mp ((hL_mem _ _ e.1).mp hpair.1)).2
    have hv2 := (mem_filter.mp ((hL_mem _ _ e.2).mp hpair.2)).2
    exact ⟨semiY_eq_of_on_circle hv1.1 hv1.2, semiY_eq_of_on_circle hv2.1 hv2.2⟩
  -- For any x strictly between (pt e.1) 0 and (pt e.2) 0, (x - c.1 0)^2 < c.2^2
  have hedge_rad_pos : ∀ e (he : e ∈ E), ∀ x : ℝ, (pt e.1) 0 < x → x < (pt e.2) 0 →
      (x - (rep e he).1.1 0) ^ 2 < (rep e he).1.2 ^ 2 := by
    intro e he x hx1 hx2
    have hpair := consecPairs_mem (List.mem_toFinset.mp (hrep_spec e he).2)
    have hv1 := (mem_filter.mp ((hL_mem _ _ e.1).mp hpair.1)).2
    have hv2 := (mem_filter.mp ((hL_mem _ _ e.2).mp hpair.2)).2
    have hsq1 : ((pt e.1) 0 - (rep e he).1.1 0) ^ 2 < (rep e he).1.2 ^ 2 := by
      have h := congrArg (· ^ 2) hv1.1; rw [dist_sq_eq] at h
      have hne : (pt e.1) 1 - (rep e he).1.1 1 ≠ 0 := by
        cases hs : (rep e he).2 <;> simp [hs] at hv1 <;> linarith
      have : 0 < ((pt e.1) 1 - (rep e he).1.1 1) ^ 2 := sq_pos_of_ne_zero hne
      linarith
    have hsq2 : ((pt e.2) 0 - (rep e he).1.1 0) ^ 2 < (rep e he).1.2 ^ 2 := by
      have h := congrArg (· ^ 2) hv2.1; rw [dist_sq_eq] at h
      have hne : (pt e.2) 1 - (rep e he).1.1 1 ≠ 0 := by
        cases hs : (rep e he).2 <;> simp [hs] at hv2 <;> linarith
      have : 0 < ((pt e.2) 1 - (rep e he).1.1 1) ^ 2 := sq_pos_of_ne_zero hne
      linarith
    -- Convexity of t ↦ (t - a)^2: if x ∈ (x1, x2), (x - a)^2 ≤ max((x1 - a)^2, (x2 - a)^2)
    have hconv : (x - (rep e he).1.1 0) ^ 2 ≤ ((pt e.1) 0 - (rep e he).1.1 0) ^ 2 ∨
                 (x - (rep e he).1.1 0) ^ 2 ≤ ((pt e.2) 0 - (rep e he).1.1 0) ^ 2 := by
      by_cases hle : x ≤ (rep e he).1.1 0
      · left; nlinarith
      · right; nlinarith
    rcases hconv with h | h <;> linarith
  -- Key intersection property: if two distinct edges e₁ ≠ e₂ in E both span x strictly and
  -- edgeY e₁ x = edgeY e₂ x, then (rep e₁).1 ≠ (rep e₂).1 and mkPt x (edgeY e₁ x) ∈ circleInter ⊆ W.
  have hedge_inter : ∀ e₁ (h1 : e₁ ∈ E) e₂ (h2 : e₂ ∈ E), e₁ ≠ e₂ →
      ∀ x : ℝ, (pt e₁.1) 0 < x → x < (pt e₁.2) 0 → (pt e₂.1) 0 < x → x < (pt e₂.2) 0 →
      edgeY e₁ h1 x = edgeY e₂ h2 x →
      (rep e₁ h1).1 ≠ (rep e₂ h2).1 ∧
      mkPt x (edgeY e₁ h1 x) ∈ circleInter (rep e₁ h1).1 (rep e₂ h2).1 := by
    intro e₁ h1 e₂ h2 hne x hx1l hx1r hx2l hx2r hyEq
    have hrad1 := hedge_rad_pos e₁ h1 x hx1l hx1r
    have hrad2 := hedge_rad_pos e₂ h2 x hx2l hx2r
    have hc1_ne_c2 : (rep e₁ h1).1 ≠ (rep e₂ h2).1 := by
      intro hceq
      by_cases hseq : (rep e₁ h1).2 = (rep e₂ h2).2
      · have hrep_eq : rep e₁ h1 = rep e₂ h2 := Prod.ext hceq hseq
        have hm1 : e₁ ∈ consecPairs (L (rep e₁ h1).1 (rep e₁ h1).2) := List.mem_toFinset.mp (hrep_spec e₁ h1).2
        have hm2 : e₂ ∈ consecPairs (L (rep e₁ h1).1 (rep e₁ h1).2) := by
          rw [hrep_eq]; exact List.mem_toFinset.mp (hrep_spec e₂ h2).2
        rcases consecPairs_disjoint (hL_pw _ _) hm1 hm2 hne with hle | hle
        · have : (pt e₁.2) 0 ≤ (pt e₂.1) 0 := hpt_mono.monotone hle
          linarith
        · have : (pt e₂.2) 0 ≤ (pt e₁.1) 0 := hpt_mono.monotone hle
          linarith
      · -- Same circle, opposite semicircles: sqrt > 0 separates them
        dsimp only [edgeY, semiY] at hyEq
        rw [hceq] at hyEq hrad1
        have hsqpos : 0 < Real.sqrt ((rep e₂ h2).1.2 ^ 2 - (x - (rep e₂ h2).1.1 0) ^ 2) :=
          Real.sqrt_pos.mpr (by linarith)
        cases hs1 : (rep e₁ h1).2 <;> cases hs2 : (rep e₂ h2).2
        · exact hseq (hs1.trans hs2.symm)
        · rw [hs1, hs2] at hyEq; simp at hyEq; linarith
        · rw [hs1, hs2] at hyEq; simp at hyEq; linarith
        · exact hseq (hs1.trans hs2.symm)
    refine ⟨hc1_ne_c2, (mem_circleInter hc1_ne_c2).mpr ⟨?_, ?_⟩⟩
    · exact semiY_on_circle (h𝒞_prop _ (mem_product.mp (hrep_spec e₁ h1).1).1).2.le _ hrad1.le
    · rw [hyEq]
      exact semiY_on_circle (h𝒞_prop _ (mem_product.mp (hrep_spec e₂ h2).1).1).2.le _ hrad2.le
  -- Midpoint ξ j for slab j (when 1 ≤ j.val < K)
  let ξ : Fin (K + 1) → ℝ := fun j =>
    if h : 1 ≤ j.val ∧ j.val < K then (xs ⟨j.val - 1, by omega⟩ + xs ⟨j.val, h.2⟩) / 2 else 0
  have hξ_between : ∀ j : Fin (K + 1), (h : 1 ≤ j.val ∧ j.val < K) →
      xs ⟨j.val - 1, by omega⟩ < ξ j ∧ ξ j < xs ⟨j.val, h.2⟩ := by
    intro j h
    have hlt : xs ⟨j.val - 1, by omega⟩ < xs ⟨j.val, h.2⟩ := hxs_mono (Fin.mk_lt_mk.mpr (by omega))
    simp only [ξ, dif_pos h]; constructor <;> linarith
  have hξ_not_Xcrit : ∀ j : Fin (K + 1), 1 ≤ j.val → j.val < K → ξ j ∉ Xcrit := by
    intro j h1 h2 hmem
    let k := eXc.symm ⟨ξ j, hmem⟩
    have hk : xs k = ξ j := congrArg Subtype.val (eXc.apply_symm_apply _)
    have hbt := hξ_between j ⟨h1, h2⟩
    have hlt1 : (⟨j.val - 1, by omega⟩ : Fin K) < k := hxs_mono.lt_iff_lt.mp (by rw [hk]; exact hbt.1)
    have hlt2 : k < ⟨j.val, h2⟩ := hxs_mono.lt_iff_lt.mp (by rw [hk]; exact hbt.2)
    have : j.val - 1 < k.val := hlt1
    have : k.val < j.val := hlt2
    omega
  have hact_empty_edge : ∀ j : Fin (K + 1), ¬(1 ≤ j.val ∧ j.val < K) → act j = ∅ := by
    intro j hj
    ext e; simp only [act, mem_filter, notMem_empty, iff_false, not_and]
    intro _ h1 h2
    have := (vertSlab e.2).isLt
    omega
  -- Key function on slab j
  let slabKey : Fin (K + 1) → DirEdge n → ℝ := fun j e =>
    if he : e ∈ E then edgeY e he (ξ j) else 0
  have hslabKey_inj : ∀ j : Fin (K + 1), Set.InjOn (slabKey j) (act j : Set (DirEdge n)) := by
    intro j e₁ h1 e₂ h2 hEq
    by_contra hne
    by_cases hj : 1 ≤ j.val ∧ j.val < K
    · rw [mem_coe, mem_filter] at h1 h2
      have hbt := hξ_between j hj
      have hx1l : (pt e₁.1) 0 < ξ j := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₁.1 ≤ ⟨j.val - 1, by omega⟩ by change (vertSlab e₁.1).val ≤ j.val - 1; omega)) hbt.1
      have hx1r : ξ j < (pt e₁.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le hbt.2 (hxs_mono.monotone (show (⟨j.val, hj.2⟩ : Fin K) ≤ vertSlab e₁.2 by change j.val ≤ (vertSlab e₁.2).val; omega))
      have hx2l : (pt e₂.1) 0 < ξ j := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₂.1 ≤ ⟨j.val - 1, by omega⟩ by change (vertSlab e₂.1).val ≤ j.val - 1; omega)) hbt.1
      have hx2r : ξ j < (pt e₂.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le hbt.2 (hxs_mono.monotone (show (⟨j.val, hj.2⟩ : Fin K) ≤ vertSlab e₂.2 by change j.val ≤ (vertSlab e₂.2).val; omega))
      simp only [slabKey, dif_pos h1.1, dif_pos h2.1] at hEq
      have ⟨_, hw⟩ := hedge_inter e₁ h1.1 e₂ h2.1 hne (ξ j) hx1l hx1r hx2l hx2r hEq
      have hwW : mkPt (ξ j) (edgeY e₁ h1.1 (ξ j)) ∈ W :=
        mem_biUnion.mpr ⟨((rep e₁ h1.1).1, (rep e₂ h2.1).1),
          mem_product.mpr ⟨(mem_product.mp (hrep_spec e₁ h1.1).1).1, (mem_product.mp (hrep_spec e₂ h2.1).1).1⟩, hw⟩
      have hξX : ξ j ∈ Xcrit := mem_image.mpr ⟨mkPt (ξ j) (edgeY e₁ h1.1 (ξ j)), mem_union_right _ hwW, mkPt_zero _ _⟩
      exact hξ_not_Xcrit j hj.1 hj.2 hξX
    · rw [hact_empty_edge j hj] at h1; simp at h1
  -- Build sorted slab list for each j : Fin (K + 1)
  have hslab_ex : ∀ j : Fin (K + 1), ∃ L : List (DirEdge n),
      L.Nodup ∧ (∀ e, e ∈ L ↔ e ∈ act j) ∧
      ∀ e₁ ∈ L, ∀ e₂ ∈ L, L.idxOf e₁ < L.idxOf e₂ ↔ slabKey j e₁ < slabKey j e₂ :=
    fun j => sort_by_key (act j) (slabKey j) (hslabKey_inj j)
  let slab : Fin (K + 1) → List (DirEdge n) := fun j => Classical.choose (hslab_ex j)
  have hslab_spec : ∀ j : Fin (K + 1), (slab j).Nodup ∧ (∀ e, e ∈ slab j ↔ e ∈ act j) ∧
      ∀ e₁ ∈ slab j, ∀ e₂ ∈ slab j, (slab j).idxOf e₁ < (slab j).idxOf e₂ ↔ slabKey j e₁ < slabKey j e₂ :=
    fun j => Classical.choose_spec (hslab_ex j)
  have hslab_start : slab 0 = [] := by
    cases h : slab 0 with
    | nil => rfl
    | cons e _ =>
      have he : e ∈ slab 0 := by rw [h]; simp
      rw [(hslab_spec 0).2.1, hact_empty_edge 0 (by simp)] at he
      exact absurd he (notMem_empty e)
  have hslab_end : slab ⟨K, Nat.lt_succ_self K⟩ = [] := by
    cases h : slab ⟨K, Nat.lt_succ_self K⟩ with
    | nil => rfl
    | cons e _ =>
      have he : e ∈ slab ⟨K, Nat.lt_succ_self K⟩ := by rw [h]; simp
      rw [(hslab_spec ⟨K, _⟩).2.1, hact_empty_edge ⟨K, _⟩ (by simp)] at he
      exact absurd he (notMem_empty e)
  have hslab_memE : ∀ j e, e ∈ slab j → e ∈ E := fun j e he =>
    (mem_filter.mp ((hslab_spec j).2.1 e |>.mp he)).1
  have hslab_active : ∀ j : Fin (K + 1), ∀ e ∈ E,
      e ∈ slab j ↔ (vertSlab e.1).val < j.val ∧ j.val ≤ (vertSlab e.2).val := fun j e he => by
    rw [(hslab_spec j).2.1, mem_filter]; exact ⟨fun h => h.2, fun h => ⟨he, h⟩⟩
  -- Helper: no element of Xcrit lies in (ξ k, xs k) or (xs k, ξ (k+1))
  have hno_Xcrit_left : ∀ (k : Fin K) (hk : 1 ≤ k.val) (x : ℝ), ξ k.castSucc < x → x < xs k → x ∉ Xcrit := by
    intro k hk x h1 h2 hmem
    let m := eXc.symm ⟨x, hmem⟩
    have hm : xs m = x := congrArg Subtype.val (eXc.apply_symm_apply _)
    have hbt := hξ_between k.castSucc ⟨hk, k.isLt⟩
    have hlt1 : (⟨k.val - 1, by omega⟩ : Fin K) < m := hxs_mono.lt_iff_lt.mp (by rw [hm]; exact hbt.1.trans h1)
    have hlt2 : m < k := hxs_mono.lt_iff_lt.mp (by rw [hm]; exact h2)
    have : k.val - 1 < m.val := hlt1
    have : m.val < k.val := hlt2
    omega
  have hno_Xcrit_right : ∀ (k : Fin K) (hk : k.val + 1 < K) (x : ℝ), xs k < x → x < ξ k.succ → x ∉ Xcrit := by
    intro k hk x h1 h2 hmem
    let m := eXc.symm ⟨x, hmem⟩
    have hm : xs m = x := congrArg Subtype.val (eXc.apply_symm_apply _)
    have hbt := hξ_between k.succ ⟨by simp, hk⟩
    have hlt1 : k < m := hxs_mono.lt_iff_lt.mp (by rw [hm]; exact h1)
    have hlt2 : m < ⟨k.val + 1, hk⟩ := hxs_mono.lt_iff_lt.mp (by rw [hm]; exact h2.trans hbt.2)
    have : k.val < m.val := hlt1
    have : m.val < k.val + 1 := hlt2
    omega
  -- Step 5: Verify vertex step condition at every v : Fin n
  have hvstep : ∀ v : Fin n, ∃ pre Lv Rv post : List (DirEdge n),
      slab (vertSlab v).castSucc = pre ++ Lv ++ post ∧
      slab (vertSlab v).succ = pre ++ Rv ++ post ∧
      (∀ e ∈ Lv, e.2 = v) ∧ (∀ e ∈ Rv, e.1 = v) ∧
      (∀ e ∈ pre, e.1 ≠ v ∧ e.2 ≠ v) ∧ (∀ e ∈ post, e.1 ≠ v ∧ e.2 ≠ v) := by
    intro v
    let k := vertSlab v
    -- Passing edges through v cannot hit pt v
    have hpass_ne_y : ∀ e (he : e ∈ E), e.1 < v → v < e.2 → edgeY e he ((pt v) 0) ≠ (pt v) 1 := by
      intro e he h1v hv2 hyEq
      have hxv1 : (pt e.1) 0 < (pt v) 0 := hpt_mono h1v
      have hxv2 : (pt v) 0 < (pt e.2) 0 := hpt_mono hv2
      have hrad := hedge_rad_pos e he ((pt v) 0) hxv1 hxv2
      have hon : dist (rep e he).1.1 (pt v) = (rep e he).1.2 := by
        have hmk : mkPt ((pt v) 0) (edgeY e he ((pt v) 0)) = pt v := by
          ext i; fin_cases i <;> simp [mkPt_zero, mkPt_one, hyEq]
        rw [← hmk]
        exact semiY_on_circle (h𝒞_prop _ (mem_product.mp (hrep_spec e he).1).1).2.le _ hrad.le
      have hside : if (rep e he).2 then (rep e he).1.1 1 < (pt v) 1 else (pt v) 1 < (rep e he).1.1 1 := by
        rw [← hyEq]; dsimp only [edgeY, semiY]
        have hsq : 0 < Real.sqrt ((rep e he).1.2 ^ 2 - ((pt v) 0 - (rep e he).1.1 0) ^ 2) :=
          Real.sqrt_pos.mpr (by linarith)
        cases (rep e he).2 <;> simp <;> linarith
      have hvL : v ∈ L (rep e he).1 (rep e he).2 := (hL_mem _ _ v).mpr (mem_filter.mpr ⟨mem_univ _, hon, hside⟩)
      exact consecPairs_no_between (hL_pw _ _) (List.mem_toFinset.mp (hrep_spec e he).2) hvL ⟨h1v, hv2⟩
    -- Two distinct passing edges cannot meet at (pt v) 0
    have hpass_ne_pass : ∀ e₁ (h1 : e₁ ∈ E) e₂ (h2 : e₂ ∈ E), e₁ ≠ e₂ →
        e₁.1 < v → v < e₁.2 → e₂.1 < v → v < e₂.2 →
        edgeY e₁ h1 ((pt v) 0) ≠ edgeY e₂ h2 ((pt v) 0) := by
      intro e₁ h1 e₂ h2 hne ha1 hb1 ha2 hb2 hyEq
      have ⟨_, hw⟩ := hedge_inter e₁ h1 e₂ h2 hne ((pt v) 0) (hpt_mono ha1) (hpt_mono hb1) (hpt_mono ha2) (hpt_mono hb2) hyEq
      have hwW : mkPt ((pt v) 0) (edgeY e₁ h1 ((pt v) 0)) ∈ W :=
        mem_biUnion.mpr ⟨((rep e₁ h1).1, (rep e₂ h2).1),
          mem_product.mpr ⟨(mem_product.mp (hrep_spec e₁ h1).1).1, (mem_product.mp (hrep_spec e₂ h2).1).1⟩, hw⟩
      have hw_ne : mkPt ((pt v) 0) (edgeY e₁ h1 ((pt v) 0)) ≠ pt v := fun h =>
        hpass_ne_y e₁ h1 ha1 hb1 (by have := congrArg (fun p : ℝ² => p 1) h; simpa [mkPt_one] using this)
      exact hgenX _ (mem_union_right _ hwW) (pt v) (mem_union_left _ (hpt_mem v)) hw_ne (mkPt_zero _ _)
    -- Order preservation on (ξ k, (pt v) 0] for any e₁, e₂ ∈ slab k.castSucc
    have hord_left : ∀ e₁ (h1 : e₁ ∈ E) e₂ (h2 : e₂ ∈ E),
        e₁ ∈ slab k.castSucc → e₂ ∈ slab k.castSucc →
        edgeY e₁ h1 ((pt v) 0) < edgeY e₂ h2 ((pt v) 0) →
        slabKey k.castSucc e₁ < slabKey k.castSucc e₂ := by
      intro e₁ h1 e₂ h2 hm1 hm2 hltv
      have hk1 : 1 ≤ k.val := by
        have := ((hslab_active k.castSucc e₁ h1).mp hm1).1; simp at this; omega
      have hbt := hξ_between k.castSucc ⟨hk1, k.isLt⟩
      have hξ_lt_v : ξ k.castSucc < (pt v) 0 := by rw [← hxs_vert]; exact hbt.2
      simp only [slabKey, dif_pos h1, dif_pos h2]
      by_contra hge
      have hne12 : e₁ ≠ e₂ := fun h => by subst h; exact lt_irrefl _ hltv
      have hgt : edgeY e₂ h2 (ξ k.castSucc) < edgeY e₁ h1 (ξ k.castSucc) := by
        rcases lt_or_eq_of_le (not_lt.mp hge) with hlt | heq
        · exact hlt
        · exfalso
          have := hslabKey_inj k.castSucc ((hslab_spec k.castSucc).2.1 e₁ |>.mp hm1)
            ((hslab_spec k.castSucc).2.1 e₂ |>.mp hm2) (by simp [slabKey, h1, h2, heq.symm])
          exact hne12 this
      obtain ⟨x, hx1, hx2, hxEq⟩ := exists_eq_of_lt_gt (hedgeY_cont e₂ h2) (hedgeY_cont e₁ h1) hξ_lt_v hgt hltv
      have ha1 := (hslab_active k.castSucc e₁ h1).mp hm1
      have ha2 := (hslab_active k.castSucc e₂ h2).mp hm2
      have h1l : (pt e₁.1) 0 < x := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₁.1 ≤ ⟨k.val - 1, by omega⟩ by change (vertSlab e₁.1).val ≤ k.val - 1; simp at ha1; omega)) (hbt.1.trans hx1)
      have h1r : x < (pt e₁.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le (by rwa [← hxs_vert] at hx2) (hxs_mono.monotone (show k ≤ vertSlab e₁.2 by change k.val ≤ (vertSlab e₁.2).val; simp at ha1; omega))
      have h2l : (pt e₂.1) 0 < x := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₂.1 ≤ ⟨k.val - 1, by omega⟩ by change (vertSlab e₂.1).val ≤ k.val - 1; simp at ha2; omega)) (hbt.1.trans hx1)
      have h2r : x < (pt e₂.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le (by rwa [← hxs_vert] at hx2) (hxs_mono.monotone (show k ≤ vertSlab e₂.2 by change k.val ≤ (vertSlab e₂.2).val; simp at ha2; omega))
      have ⟨_, hw⟩ := hedge_inter e₁ h1 e₂ h2 hne12 x h1l h1r h2l h2r hxEq.symm
      have hwW : mkPt x (edgeY e₁ h1 x) ∈ W :=
        mem_biUnion.mpr ⟨((rep e₁ h1).1, (rep e₂ h2).1),
          mem_product.mpr ⟨(mem_product.mp (hrep_spec e₁ h1).1).1, (mem_product.mp (hrep_spec e₂ h2).1).1⟩, hw⟩
      exact hno_Xcrit_left k hk1 x hx1 (by rwa [← hxs_vert] at hx2)
        (mem_image.mpr ⟨mkPt x (edgeY e₁ h1 x), mem_union_right _ hwW, mkPt_zero _ _⟩)
    -- Symmetric order preservation on [(pt v) 0, ξ (k+1)) for any e₁, e₂ ∈ slab k.succ
    have hord_right : ∀ e₁ (h1 : e₁ ∈ E) e₂ (h2 : e₂ ∈ E),
        e₁ ∈ slab k.succ → e₂ ∈ slab k.succ →
        edgeY e₁ h1 ((pt v) 0) < edgeY e₂ h2 ((pt v) 0) →
        slabKey k.succ e₁ < slabKey k.succ e₂ := by
      intro e₁ h1 e₂ h2 hm1 hm2 hltv
      have hk2 : k.val + 1 < K := by
        have ha1 := ((hslab_active k.succ e₁ h1).mp hm1).2; have hlt := (vertSlab e₁.2).isLt; simp only [Fin.val_succ] at ha1; omega
      have hbt := hξ_between k.succ ⟨by simp, hk2⟩
      have hv_lt_ξ : (pt v) 0 < ξ k.succ := by rw [← hxs_vert]; exact hbt.1
      simp only [slabKey, dif_pos h1, dif_pos h2]
      by_contra hge
      have hne12 : e₁ ≠ e₂ := fun h => by subst h; exact lt_irrefl _ hltv
      have hgt : edgeY e₂ h2 (ξ k.succ) < edgeY e₁ h1 (ξ k.succ) := by
        rcases lt_or_eq_of_le (not_lt.mp hge) with hlt | heq
        · exact hlt
        · exfalso
          have := hslabKey_inj k.succ ((hslab_spec k.succ).2.1 e₁ |>.mp hm1)
            ((hslab_spec k.succ).2.1 e₂ |>.mp hm2) (by simp [slabKey, h1, h2, heq.symm])
          exact hne12 this
      obtain ⟨x, hx1, hx2, hxEq⟩ := exists_eq_of_lt_gt (hedgeY_cont e₁ h1) (hedgeY_cont e₂ h2) hv_lt_ξ hltv hgt
      have ha1 := (hslab_active k.succ e₁ h1).mp hm1
      have ha2 := (hslab_active k.succ e₂ h2).mp hm2
      have h1l : (pt e₁.1) 0 < x := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₁.1 ≤ k by change (vertSlab e₁.1).val ≤ k.val; simp at ha1; omega)) (by rwa [← hxs_vert] at hx1)
      have h1r : x < (pt e₁.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le (hx2.trans hbt.2) (hxs_mono.monotone (show (⟨k.val + 1, hk2⟩ : Fin K) ≤ vertSlab e₁.2 by change k.val + 1 ≤ (vertSlab e₁.2).val; simp at ha1; omega))
      have h2l : (pt e₂.1) 0 < x := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₂.1 ≤ k by change (vertSlab e₂.1).val ≤ k.val; simp at ha2; omega)) (by rwa [← hxs_vert] at hx1)
      have h2r : x < (pt e₂.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le (hx2.trans hbt.2) (hxs_mono.monotone (show (⟨k.val + 1, hk2⟩ : Fin K) ≤ vertSlab e₂.2 by change k.val + 1 ≤ (vertSlab e₂.2).val; simp at ha2; omega))
      have ⟨_, hw⟩ := hedge_inter e₁ h1 e₂ h2 hne12 x h1l h1r h2l h2r hxEq
      have hwW : mkPt x (edgeY e₁ h1 x) ∈ W :=
        mem_biUnion.mpr ⟨((rep e₁ h1).1, (rep e₂ h2).1),
          mem_product.mpr ⟨(mem_product.mp (hrep_spec e₁ h1).1).1, (mem_product.mp (hrep_spec e₂ h2).1).1⟩, hw⟩
      exact hno_Xcrit_right k hk2 x (by rwa [← hxs_vert] at hx1) hx2
        (mem_image.mpr ⟨mkPt x (edgeY e₁ h1 x), mem_union_right _ hwW, mkPt_zero _ _⟩)
    -- Define the 3-way partition predicates P (below pt v), M_L (ending at v), M_R (starting at v), Q (above pt v)
    let P : DirEdge n → Bool := fun e =>
      decide (e ∈ E ∧ e.1 < v ∧ v < e.2 ∧ ∃ he : e ∈ E, edgeY e he ((pt v) 0) < (pt v) 1)
    let Q : DirEdge n → Bool := fun e =>
      decide (e ∈ E ∧ e.1 < v ∧ v < e.2 ∧ ∃ he : e ∈ E, (pt v) 1 < edgeY e he ((pt v) 0))
    let ML : DirEdge n → Bool := fun e => decide (e.2 = v)
    let MR : DirEdge n → Bool := fun e => decide (e.1 = v)
    have hsplitL : slab k.castSucc = (slab k.castSucc).filter P ++ (slab k.castSucc).filter ML ++ (slab k.castSucc).filter Q := by
      apply list_split_three _ (hslab_spec k.castSucc).1 P ML Q
      · intro e heL
        have heE := hslab_memE k.castSucc e heL
        have ha := (hslab_active k.castSucc e heE).mp heL
        have h1v : e.1 < v := hvm.lt_iff_lt.mp (show (vertSlab e.1).val < k.val by simpa using ha.1)
        have hv2 : v ≤ e.2 := hvm.le_iff_le.mp (show k ≤ vertSlab e.2 by exact ha.2)
        rcases eq_or_lt_of_le hv2 with rfl | hlt2
        · right; left; simp [P, ML, Q]
        · have hne : edgeY e heE ((pt v) 0) ≠ (pt v) 1 := hpass_ne_y e heE h1v hlt2
          rcases lt_or_gt_of_ne hne with hlt | hgt
          · left; simp [P, ML, Q, heE, h1v, hlt2, hlt, hlt2.ne', not_lt_of_gt hlt]
          · right; right; simp [P, ML, Q, heE, h1v, hlt2, hgt, hlt2.ne', not_lt_of_gt hgt]
      · intro x hx y hy hPx hMy
        have hxE := hslab_memE k.castSucc x hx
        have hyE := hslab_memE k.castSucc y hy
        rw [(hslab_spec k.castSucc).2.2 x hx y hy]
        have hlt : edgeY x hxE ((pt v) 0) < (pt v) 1 := by
          simp only [P, decide_eq_true_eq] at hPx; exact hPx.2.2.2.choose_spec
        have hy_end : edgeY y hyE ((pt v) 0) = (pt v) 1 := by
          have : y.2 = v := of_decide_eq_true hMy
          rw [← this]; exact (hedge_ends y hyE).2
        exact hord_left x hxE y hyE hx hy (hy_end ▸ hlt)
      · intro x hx y hy hPx hQy
        have hxE := hslab_memE k.castSucc x hx
        have hyE := hslab_memE k.castSucc y hy
        rw [(hslab_spec k.castSucc).2.2 x hx y hy]
        have hlt1 : edgeY x hxE ((pt v) 0) < (pt v) 1 := by
          simp only [P, decide_eq_true_eq] at hPx; exact hPx.2.2.2.choose_spec
        have hlt2 : (pt v) 1 < edgeY y hyE ((pt v) 0) := by
          simp only [Q, decide_eq_true_eq] at hQy; exact hQy.2.2.2.choose_spec
        exact hord_left x hxE y hyE hx hy (hlt1.trans hlt2)
      · intro x hx y hy hMx hQy
        have hxE := hslab_memE k.castSucc x hx
        have hyE := hslab_memE k.castSucc y hy
        rw [(hslab_spec k.castSucc).2.2 x hx y hy]
        have hx_end : edgeY x hxE ((pt v) 0) = (pt v) 1 := by
          have : x.2 = v := of_decide_eq_true hMx
          rw [← this]; exact (hedge_ends x hxE).2
        have hlt2 : (pt v) 1 < edgeY y hyE ((pt v) 0) := by
          simp only [Q, decide_eq_true_eq] at hQy; exact hQy.2.2.2.choose_spec
        exact hord_left x hxE y hyE hx hy (hx_end.symm ▸ hlt2)
    have hsplitR : slab k.succ = (slab k.succ).filter P ++ (slab k.succ).filter MR ++ (slab k.succ).filter Q := by
      apply list_split_three _ (hslab_spec k.succ).1 P MR Q
      · intro e heR
        have heE := hslab_memE k.succ e heR
        have ha := (hslab_active k.succ e heE).mp heR
        have h1v : e.1 ≤ v := hvm.le_iff_le.mp (show vertSlab e.1 ≤ k by change (vertSlab e.1).val ≤ k.val; simp at ha; omega)
        have hv2 : v < e.2 := hvm.lt_iff_lt.mp (show k.val < (vertSlab e.2).val by simp only [Fin.val_succ] at ha; omega)
        rcases eq_or_lt_of_le h1v with rfl | hlt1
        · right; left; simp [P, MR, Q]
        · have hne : edgeY e heE ((pt v) 0) ≠ (pt v) 1 := hpass_ne_y e heE hlt1 hv2
          rcases lt_or_gt_of_ne hne with hlt | hgt
          · left; simp [P, MR, Q, heE, hlt1, hv2, hlt, hlt1.ne, not_lt_of_gt hlt]
          · right; right; simp [P, MR, Q, heE, hlt1, hv2, hgt, hlt1.ne, not_lt_of_gt hgt]
      · intro x hx y hy hPx hMy
        have hxE := hslab_memE k.succ x hx
        have hyE := hslab_memE k.succ y hy
        rw [(hslab_spec k.succ).2.2 x hx y hy]
        have hlt : edgeY x hxE ((pt v) 0) < (pt v) 1 := by
          simp only [P, decide_eq_true_eq] at hPx; exact hPx.2.2.2.choose_spec
        have hy_end : edgeY y hyE ((pt v) 0) = (pt v) 1 := by
          have : y.1 = v := of_decide_eq_true hMy
          rw [← this]; exact (hedge_ends y hyE).1
        exact hord_right x hxE y hyE hx hy (hy_end ▸ hlt)
      · intro x hx y hy hPx hQy
        have hxE := hslab_memE k.succ x hx
        have hyE := hslab_memE k.succ y hy
        rw [(hslab_spec k.succ).2.2 x hx y hy]
        have hlt1 : edgeY x hxE ((pt v) 0) < (pt v) 1 := by
          simp only [P, decide_eq_true_eq] at hPx; exact hPx.2.2.2.choose_spec
        have hlt2 : (pt v) 1 < edgeY y hyE ((pt v) 0) := by
          simp only [Q, decide_eq_true_eq] at hQy; exact hQy.2.2.2.choose_spec
        exact hord_right x hxE y hyE hx hy (hlt1.trans hlt2)
      · intro x hx y hy hMx hQy
        have hxE := hslab_memE k.succ x hx
        have hyE := hslab_memE k.succ y hy
        rw [(hslab_spec k.succ).2.2 x hx y hy]
        have hx_end : edgeY x hxE ((pt v) 0) = (pt v) 1 := by
          have : x.1 = v := of_decide_eq_true hMx
          rw [← this]; exact (hedge_ends x hxE).1
        have hlt2 : (pt v) 1 < edgeY y hyE ((pt v) 0) := by
          simp only [Q, decide_eq_true_eq] at hQy; exact hQy.2.2.2.choose_spec
        exact hord_right x hxE y hyE hx hy (hx_end.symm ▸ hlt2)
    -- Show (slab k.castSucc).filter P = (slab k.succ).filter P and similarly for Q
    have hfilt_eq : ∀ (B : DirEdge n → Bool),
        (∀ e, B e = true → e ∈ E ∧ e.1 < v ∧ v < e.2) →
        (slab k.castSucc).filter B = (slab k.succ).filter B := by
      intro B hB
      have hmemB : ∀ e, e ∈ (slab k.castSucc).filter B ↔ e ∈ (slab k.succ).filter B := by
        intro e
        simp only [List.mem_filter]
        constructor
        · rintro ⟨_, hBe⟩
          have ⟨heE, h1, h2⟩ := hB e hBe
          refine ⟨(hslab_active k.succ e heE).mpr ⟨?_, ?_⟩, hBe⟩
          · have : (vertSlab e.1).val < k.val := hvm h1; simp; omega
          · have : k.val < (vertSlab e.2).val := hvm h2; simp; omega
        · rintro ⟨_, hBe⟩
          have ⟨heE, h1, h2⟩ := hB e hBe
          refine ⟨(hslab_active k.castSucc e heE).mpr ⟨?_, ?_⟩, hBe⟩
          · have : (vertSlab e.1).val < k.val := hvm h1; simp; omega
          · have : k.val < (vertSlab e.2).val := hvm h2; simp; omega
      -- Helper: idxOf order in L.filter B matches idxOf order in L
      have hfilt_idx_iff : ∀ (L0 : List (DirEdge n)), L0.Nodup →
          ∀ x ∈ L0.filter B, ∀ y ∈ L0.filter B,
            (L0.filter B).idxOf x < (L0.filter B).idxOf y ↔ L0.idxOf x < L0.idxOf y := by
        intro L0 hnd0 x hx y hy
        induction L0 with
        | nil => simp at hx
        | cons a t ih =>
          rw [List.nodup_cons] at hnd0
          simp only [List.filter_cons] at hx hy ⊢
          by_cases hBa : B a = true
          · simp only [hBa, ↓reduceIte] at hx hy ⊢
            by_cases hxa : x = a
            · subst hxa
              by_cases hya : y = x
              · subst hya; simp
              · simp [List.idxOf_cons_self, List.idxOf_cons_ne _ (Ne.symm hya)]
            · by_cases hya : y = a
              · subst hya; simp [List.idxOf_cons_self, List.idxOf_cons_ne _ (Ne.symm hxa)]
              · simp only [List.idxOf_cons_ne _ (Ne.symm hxa), List.idxOf_cons_ne _ (Ne.symm hya), Nat.succ_lt_succ_iff]
                exact ih hnd0.2 (by simpa [hxa] using hx) (by simpa [hya] using hy)
          · have hBf : B a = false := Bool.eq_false_iff.mpr hBa
            simp only [hBf, Bool.false_eq_true, ↓reduceIte] at hx hy ⊢
            have hxa : x ≠ a := fun h => by subst h; rw [List.mem_filter] at hx; exact hnd0.1 hx.1
            have hya : y ≠ a := fun h => by subst h; rw [List.mem_filter] at hy; exact hnd0.1 hy.1
            simp only [List.idxOf_cons_ne _ (Ne.symm hxa), List.idxOf_cons_ne _ (Ne.symm hya), Nat.succ_lt_succ_iff]
            exact ih hnd0.2 hx hy
      apply list_eq_of_same_order ((hslab_spec k.castSucc).1.filter B) ((hslab_spec k.succ).1.filter B) hmemB
      intro x hx y hy hlt
      have hx' := (hmemB x).mp hx
      have hy' := (hmemB y).mp hy
      rw [hfilt_idx_iff _ (hslab_spec k.castSucc).1 x hx y hy] at hlt
      rw [hfilt_idx_iff _ (hslab_spec k.succ).1 x hx' y hy']
      rw [List.mem_filter] at hx hy hx' hy'
      rw [(hslab_spec k.castSucc).2.2 x hx.1 y hy.1] at hlt
      rw [(hslab_spec k.succ).2.2 x hx'.1 y hy'.1]
      have ⟨hxE, hx1, hx2⟩ := hB x hx.2
      have ⟨hyE, hy1, hy2⟩ := hB y hy.2
      have hne : x ≠ y := fun h => by subst h; exact lt_irrefl _ hlt
      have hlt_v : edgeY x hxE ((pt v) 0) < edgeY y hyE ((pt v) 0) := by
        rcases lt_or_gt_of_ne (hpass_ne_pass x hxE y hyE hne hx1 hx2 hy1 hy2) with h | h
        · exact h
        · exact absurd (hord_left y hyE x hxE hy.1 hx.1 h) (not_lt_of_gt hlt)
      exact hord_right x hxE y hyE hx'.1 hy'.1 hlt_v
    have hPeq := hfilt_eq P (fun e h => by simp only [P, decide_eq_true_eq] at h; exact ⟨h.1, h.2.1, h.2.2.1⟩)
    have hQeq := hfilt_eq Q (fun e h => by simp only [Q, decide_eq_true_eq] at h; exact ⟨h.1, h.2.1, h.2.2.1⟩)
    refine ⟨(slab k.castSucc).filter P, (slab k.castSucc).filter ML, (slab k.succ).filter MR,
      (slab k.castSucc).filter Q, hsplitL, by rw [hPeq, hQeq]; exact hsplitR, ?_, ?_, ?_, ?_⟩
    · intro e he; rw [List.mem_filter] at he; exact of_decide_eq_true he.2
    · intro e he; rw [List.mem_filter] at he; exact of_decide_eq_true he.2
    · intro e he; rw [List.mem_filter] at he; simp only [P, decide_eq_true_eq] at he; exact ⟨he.2.2.1.ne, he.2.2.2.1.ne'⟩
    · intro e he; rw [List.mem_filter] at he; simp only [Q, decide_eq_true_eq] at he; exact ⟨he.2.2.1.ne, he.2.2.2.1.ne'⟩
  -- Step 6: Non-vertex slabs have identical edge sets, and total inversions ≤ 2 * |𝒞|^2
  have hnonvert_perm : ∀ j : Fin K, (∀ v : Fin n, j ≠ vertSlab v) → (slab j.castSucc).Perm (slab j.succ) := by
    intro j hnov
    apply (List.perm_ext_iff_of_nodup (hslab_spec j.castSucc).1 (hslab_spec j.succ).1).mpr
    intro e
    by_cases he : e ∈ E
    · rw [hslab_active j.castSucc e he, hslab_active j.succ e he]
      simp only [Fin.val_castSucc, Fin.val_succ]
      have hne1 : (vertSlab e.1).val ≠ j.val := fun h => hnov e.1 (Fin.ext h.symm)
      have hne2 : (vertSlab e.2).val ≠ j.val := fun h => hnov e.2 (Fin.ext h.symm)
      omega
    · constructor <;> intro hm <;> exact absurd (hslab_memE _ e hm) he
  -- Assemble the WiringDiagram
  obtain ⟨D, hD_swaps⟩ := build_wiring_diagram_from_slabs hE_lt K slab hslab_start hslab_end
    (fun j => (hslab_spec j).1) hslab_memE vertSlab hvm hslab_active hvstep hnonvert_perm
  -- Bound total inversions across all non-vertex j by 2 * |𝒞|^2
  let Jnv : Finset (Fin K) := univ.filter fun j : Fin K => ∀ v : Fin n, j ≠ vertSlab v
  have hinv_bound : ∑ j ∈ Jnv, (invSet (slab j.castSucc) (slab j.succ)).card ≤ 2 * 𝒞.card ^ 2 := by
    let InvAll := Jnv.biUnion fun j => (invSet (slab j.castSucc) (slab j.succ)).image fun p => (j, p)
    have hInvAll_card : InvAll.card = ∑ j ∈ Jnv, (invSet (slab j.castSucc) (slab j.succ)).card := by
      rw [card_biUnion]
      · exact sum_congr rfl fun j _ => card_image_of_injective _ (fun _ _ h => (Prod.mk.inj h).2)
      · intro j₁ _ j₂ _ hne
        refine Finset.disjoint_left.mpr fun q h1 h2 => ?_
        obtain ⟨_, _, rfl⟩ := mem_image.mp h1
        obtain ⟨_, _, h2'⟩ := mem_image.mp h2
        exact hne (Prod.mk.inj h2').1.symm
    let Triples : Finset ((ℝ² × ℝ) × (ℝ² × ℝ) × ℝ²) :=
      (𝒞 ×ˢ 𝒞).biUnion fun p => (circleInter p.1 p.2).image fun w => (p.1, p.2, w)
    have hTriples_card : Triples.card ≤ 2 * 𝒞.card ^ 2 := by
      calc Triples.card ≤ ∑ p ∈ 𝒞 ×ˢ 𝒞, ((circleInter p.1 p.2).image fun w => (p.1, p.2, w)).card := card_biUnion_le
        _ ≤ ∑ p ∈ 𝒞 ×ˢ 𝒞, (circleInter p.1 p.2).card := sum_le_sum fun _ _ => card_image_le
        _ ≤ ∑ _p ∈ 𝒞 ×ˢ 𝒞, 2 := sum_le_sum fun p _ => card_circleInter_le_two p.1 p.2
        _ = 2 * 𝒞.card ^ 2 := by rw [sum_const, smul_eq_mul, card_product]; ring
    rw [← hInvAll_card]
    -- Map (j, (e₁, e₂)) ↦ ((rep e₁).1, (rep e₂).1, mkPt (xs j) (edgeY e₁ (xs j)))
    have hinv_prop : ∀ q ∈ InvAll, ∃ (h1 : q.2.1 ∈ E) (h2 : q.2.2 ∈ E),
        (rep q.2.1 h1).1 ≠ (rep q.2.2 h2).1 ∧
        edgeY q.2.1 h1 (xs q.1) = edgeY q.2.2 h2 (xs q.1) ∧
        mkPt (xs q.1) (edgeY q.2.1 h1 (xs q.1)) ∈ circleInter (rep q.2.1 h1).1 (rep q.2.2 h2).1 := by
      intro ⟨j, e₁, e₂⟩ hq
      obtain ⟨j', hj', hq'⟩ := mem_biUnion.mp hq
      obtain ⟨p, hp, heq⟩ := mem_image.mp hq'
      cases heq
      rw [invSet, mem_filter, mem_product, List.mem_toFinset, List.mem_toFinset] at hp
      obtain ⟨⟨he1L, he2L⟩, hlt1, hlt2⟩ := hp
      have h1 : e₁ ∈ E := hslab_memE j.castSucc e₁ he1L
      have h2 : e₂ ∈ E := hslab_memE j.castSucc e₂ he2L
      have hjnov : ∀ v, j ≠ vertSlab v := (mem_filter.mp hj').2
      have hperm := hnonvert_perm j hjnov
      have he1R : e₁ ∈ slab j.succ := hperm.subset he1L
      have he2R : e₂ ∈ slab j.succ := hperm.subset he2L
      have hne12 : e₁ ≠ e₂ := fun h => by subst h; exact lt_irrefl _ hlt1
      rw [(hslab_spec j.castSucc).2.2 e₁ he1L e₂ he2L] at hlt1
      rw [(hslab_spec j.succ).2.2 e₂ he2R e₁ he1R] at hlt2
      simp only [slabKey, dif_pos h1, dif_pos h2] at hlt1 hlt2
      have ha1L := (hslab_active j.castSucc e₁ h1).mp he1L
      have ha1R := (hslab_active j.succ e₁ h1).mp he1R
      have ha2L := (hslab_active j.castSucc e₂ h2).mp he2L
      have ha2R := (hslab_active j.succ e₂ h2).mp he2R
      have hj1 : 1 ≤ j.val := by simp at ha1L; omega
      have hj2 : j.val + 1 < K := by have := (vertSlab e₁.2).isLt; simp at ha1R; omega
      have hbtL := hξ_between j.castSucc ⟨hj1, j.isLt⟩
      have hbtR := hξ_between j.succ ⟨by simp, hj2⟩
      have hξ_lt : ξ j.castSucc < ξ j.succ := hbtL.2.trans hbtR.1
      obtain ⟨x, hx1, hx2, hxEq⟩ := exists_eq_of_lt_gt (hedgeY_cont e₁ h1) (hedgeY_cont e₂ h2) hξ_lt hlt1 hlt2
      have h1l : (pt e₁.1) 0 < x := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₁.1 ≤ ⟨j.val - 1, by omega⟩ by change (vertSlab e₁.1).val ≤ j.val - 1; simp at ha1L; omega)) (hbtL.1.trans hx1)
      have h1r : x < (pt e₁.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le (hx2.trans hbtR.2) (hxs_mono.monotone (show (⟨j.val + 1, hj2⟩ : Fin K) ≤ vertSlab e₁.2 by change j.val + 1 ≤ (vertSlab e₁.2).val; simp at ha1R; omega))
      have h2l : (pt e₂.1) 0 < x := by
        rw [← hxs_vert]; exact lt_of_le_of_lt (hxs_mono.monotone (show vertSlab e₂.1 ≤ ⟨j.val - 1, by omega⟩ by change (vertSlab e₂.1).val ≤ j.val - 1; simp at ha2L; omega)) (hbtL.1.trans hx1)
      have h2r : x < (pt e₂.2) 0 := by
        rw [← hxs_vert]; exact lt_of_lt_of_le (hx2.trans hbtR.2) (hxs_mono.monotone (show (⟨j.val + 1, hj2⟩ : Fin K) ≤ vertSlab e₂.2 by change j.val + 1 ≤ (vertSlab e₂.2).val; simp at ha2R; omega))
      have ⟨hcne, hw⟩ := hedge_inter e₁ h1 e₂ h2 hne12 x h1l h1r h2l h2r hxEq
      have hwW : mkPt x (edgeY e₁ h1 x) ∈ W :=
        mem_biUnion.mpr ⟨((rep e₁ h1).1, (rep e₂ h2).1),
          mem_product.mpr ⟨(mem_product.mp (hrep_spec e₁ h1).1).1, (mem_product.mp (hrep_spec e₂ h2).1).1⟩, hw⟩
      have hxX : x ∈ Xcrit := mem_image.mpr ⟨mkPt x (edgeY e₁ h1 x), mem_union_right _ hwW, mkPt_zero _ _⟩
      have hxeq : x = xs j := by
        rcases lt_trichotomy x (xs j) with hlt | rfl | hgt
        · exact absurd hxX (hno_Xcrit_left j hj1 x hx1 hlt)
        · rfl
        · exact absurd hxX (hno_Xcrit_right j hj2 x hgt hx2)
      subst hxeq
      exact ⟨h1, h2, hcne, hxEq, hw⟩
    -- Build injection InvAll → Triples
    have hcard_le : InvAll.card ≤ Triples.card := by
      refine Finset.card_le_card_of_injOn
        (fun q => if h : q.2.1 ∈ E ∧ q.2.2 ∈ E then
          ((rep q.2.1 h.1).1, (rep q.2.2 h.2).1, mkPt (xs q.1) (edgeY q.2.1 h.1 (xs q.1)))
          else ((0, 0), (0, 0), 0)) ?_ ?_
      · intro q hq
        obtain ⟨h1, h2, _, _, hw⟩ := hinv_prop q hq
        dsimp only; rw [mem_coe, dif_pos ⟨h1, h2⟩]
        exact mem_biUnion.mpr ⟨((rep q.2.1 h1).1, (rep q.2.2 h2).1),
          mem_product.mpr ⟨(mem_product.mp (hrep_spec q.2.1 h1).1).1, (mem_product.mp (hrep_spec q.2.2 h2).1).1⟩,
          mem_image_of_mem _ hw⟩
      · intro q₁ hq1 q₂ hq2 heq
        rw [mem_coe] at hq1 hq2
        obtain ⟨h1a, h1b, hcne1, hyEq1, hw1⟩ := hinv_prop q₁ hq1
        obtain ⟨h2a, h2b, hcne2, hyEq2, hw2⟩ := hinv_prop q₂ hq2
        dsimp only at heq; rw [dif_pos ⟨h1a, h1b⟩, dif_pos ⟨h2a, h2b⟩] at heq
        have hc1_eq : (rep q₁.2.1 h1a).1 = (rep q₂.2.1 h2a).1 := (Prod.mk.inj heq).1
        have hc2_eq : (rep q₁.2.2 h1b).1 = (rep q₂.2.2 h2b).1 := (Prod.mk.inj (Prod.mk.inj heq).2).1
        have hw_eq : mkPt (xs q₁.1) (edgeY q₁.2.1 h1a (xs q₁.1)) = mkPt (xs q₂.1) (edgeY q₂.2.1 h2a (xs q₂.1)) :=
          (Prod.mk.inj (Prod.mk.inj heq).2).2
        have hjeq : q₁.1 = q₂.1 := hxs_mono.injective (by
          have := congrArg (fun p : ℝ² => p 0) hw_eq; simpa [mkPt_zero] using this)
        -- Helper: at a fixed j, two active edges with the same circle and same y(xs j) must be equal!
        have he_unique : ∀ e₁ (he1 : e₁ ∈ E) e₂ (he2 : e₂ ∈ E),
            e₁ ∈ slab q₁.1.castSucc → e₂ ∈ slab q₁.1.castSucc →
            (∀ v, q₁.1 ≠ vertSlab v) →
            (rep e₁ he1).1 = (rep e₂ he2).1 →
            edgeY e₁ he1 (xs q₁.1) = edgeY e₂ he2 (xs q₁.1) → e₁ = e₂ := by
          intro e₁ he1 e₂ he2 hm1 hm2 hnov hceq hyEq
          by_contra hne
          have ha1 := (hslab_active q₁.1.castSucc e₁ he1).mp hm1
          have ha2 := (hslab_active q₁.1.castSucc e₂ he2).mp hm2
          have hne1 : vertSlab e₁.2 ≠ q₁.1 := fun h => hnov e₁.2 h.symm
          have hne2 : vertSlab e₂.2 ≠ q₁.1 := fun h => hnov e₂.2 h.symm
          have h1l : (pt e₁.1) 0 < xs q₁.1 := by
            rw [← hxs_vert]; exact hxs_mono (show (vertSlab e₁.1).val < q₁.1.val by simpa using ha1.1)
          have h1r : xs q₁.1 < (pt e₁.2) 0 := by
            rw [← hxs_vert]; exact hxs_mono (show q₁.1.val < (vertSlab e₁.2).val by
              have hne1v : (vertSlab e₁.2).val ≠ q₁.1.val := fun h => hne1 (Fin.ext h)
              have hle1 : q₁.1.val ≤ (vertSlab e₁.2).val := by simpa using ha1.2
              omega)
          have h2l : (pt e₂.1) 0 < xs q₁.1 := by
            rw [← hxs_vert]; exact hxs_mono (show (vertSlab e₂.1).val < q₁.1.val by simpa using ha2.1)
          have h2r : xs q₁.1 < (pt e₂.2) 0 := by
            rw [← hxs_vert]; exact hxs_mono (show q₁.1.val < (vertSlab e₂.2).val by
              have hne2v : (vertSlab e₂.2).val ≠ q₁.1.val := fun h => hne2 (Fin.ext h)
              have hle2 : q₁.1.val ≤ (vertSlab e₂.2).val := by simpa using ha2.2
              omega)
          exact (hedge_inter e₁ he1 e₂ he2 hne (xs q₁.1) h1l h1r h2l h2r hyEq).1 hceq
        obtain ⟨j1', hj1', hm1'⟩ := mem_biUnion.mp hq1
        obtain ⟨p1', hp1', heq1'⟩ := mem_image.mp hm1'; cases heq1'
        obtain ⟨j2', hj2', hm2'⟩ := mem_biUnion.mp hq2
        obtain ⟨p2', hp2', heq2'⟩ := mem_image.mp hm2'; cases heq2'
        dsimp only at hjeq hc1_eq hc2_eq hw_eq hyEq1 hyEq2 h1a h1b h2a h2b
        subst hjeq
        rw [invSet, mem_filter, mem_product, List.mem_toFinset, List.mem_toFinset] at hp1' hp2'
        have hy_same1 : edgeY p1'.1 h1a (xs j1') = edgeY p2'.1 h2a (xs j1') := by
          have := congrArg (fun p : ℝ² => p 1) hw_eq; simpa [mkPt_one] using this
        have hy_same2 : edgeY p1'.2 h1b (xs j1') = edgeY p2'.2 h2b (xs j1') := by
          rw [← hyEq1, ← hyEq2, hy_same1]
        have hnov := (mem_filter.mp hj1').2
        have hp1_eq := he_unique p1'.1 h1a p2'.1 h2a hp1'.1.1 hp2'.1.1 hnov hc1_eq hy_same1
        have hp2_eq := he_unique p1'.2 h1b p2'.2 h2b hp1'.1.2 hp2'.1.2 hnov hc2_eq hy_same2
        exact Prod.ext rfl (Prod.ext hp1_eq hp2_eq)
    exact hcard_le.trans hTriples_card
  -- Step 7: Apply Crossing Number Inequality
  have hcr := D.crossing_number_ineq h4n_le_E
  have hsw_le : D.numSwaps ≤ 2 * 𝒞.card ^ 2 := hD_swaps.trans hinv_bound
  have hE3 : E.card ^ 3 ≤ 1024 * n ^ 2 * 𝒞.card ^ 2 := by
    calc E.card ^ 3 ≤ 512 * n ^ 2 * D.numSwaps := hcr
      _ ≤ 512 * n ^ 2 * (2 * 𝒞.card ^ 2) := Nat.mul_le_mul_left _ hsw_le
      _ = 1024 * n ^ 2 * 𝒞.card ^ 2 := by ring
  have hAB3 : (A.card * B.card) ^ 3 ≤ 65536 * A.card ^ 2 * 𝒞.card ^ 2 := by
    calc (A.card * B.card) ^ 3 ≤ (4 * E.card) ^ 3 := Nat.pow_le_pow_left h4E 3
      _ = 64 * E.card ^ 3 := by ring
      _ ≤ 64 * (1024 * A.card ^ 2 * 𝒞.card ^ 2) := Nat.mul_le_mul_left 64 hE3
      _ = 65536 * A.card ^ 2 * 𝒞.card ^ 2 := by ring
  have hA2_pos : 0 < A.card ^ 2 := by positivity
  have hmul : A.card ^ 2 * (A.card * B.card ^ 3) ≤ A.card ^ 2 * (65536 * 𝒞.card ^ 2) := by
    calc A.card ^ 2 * (A.card * B.card ^ 3) = (A.card * B.card) ^ 3 := by ring
      _ ≤ 65536 * A.card ^ 2 * 𝒞.card ^ 2 := hAB3
      _ = A.card ^ 2 * (65536 * 𝒞.card ^ 2) := by ring
  exact Nat.le_of_mul_le_mul_left hmul hA2_pos

end

end OMA.SzekelyWiring

theorem OMA.solution : OMA.R_Erdos604_erdos_604_variants_average_R2.H2 := by
  open Finset OMA.SzekelyWiring in
  open scoped EuclideanGeometry in
  refine ⟨1 / 256, by norm_num, fun A B hBA hB2 hndeg => ?_⟩
  by_cases hB64 : B.card ≤ 64
  · obtain ⟨x, hxB, hpin⟩ := pin_of_two_pins A B hBA hB2
    refine ⟨x, hxB, le_trans ?_ hpin⟩
    rw [show (1 / 256 : ℝ) * Real.sqrt ((A.card : ℝ) * (B.card : ℝ)) =
        Real.sqrt ((A.card : ℝ) * (B.card : ℝ) / 65536) by
      rw [Real.sqrt_div (by positivity), show Real.sqrt 65536 = 256 by
        rw [show (65536 : ℝ) = 256 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]]
      ring]
    apply Real.sqrt_le_sqrt
    have hB64r : (B.card : ℝ) ≤ 64 := by exact_mod_cast hB64
    have hAnn : (0 : ℝ) ≤ (A.card : ℝ) := Nat.cast_nonneg _
    nlinarith
  · have hB65 : 65 ≤ B.card := by omega
    have hB_le_A : B.card ≤ A.card := card_le_card hBA
    let M := (circleFamily A B).card
    have hM_sum : M = ∑ x ∈ B, distinctDistancesFrom A x := card_circleFamily A B
    -- Pigeonhole: ∃ x ∈ B with M ≤ B.card * distinctDistancesFrom A x
    have hex_max : ∃ x ∈ B, M ≤ B.card * distinctDistancesFrom A x := by
      by_contra hno
      push Not at hno
      have hlt : ∑ x ∈ B, B.card * distinctDistancesFrom A x < ∑ _x ∈ B, M :=
        sum_lt_sum_of_nonempty (Finset.card_pos.mp (by omega)) hno
      rw [← mul_sum, ← hM_sum, sum_const, smul_eq_mul] at hlt
      exact lt_irrefl _ hlt
    obtain ⟨x₀, hx0B, hx0_ge⟩ := hex_max
    refine ⟨x₀, hx0B, ?_⟩
    -- Suffices to show A.card * B.card ^ 3 ≤ 65536 * M ^ 2
    suffices hcore : A.card * B.card ^ 3 ≤ 65536 * M ^ 2 by
      have hsq : A.card * B.card ^ 3 ≤ 65536 * (B.card * distinctDistancesFrom A x₀) ^ 2 :=
        hcore.trans (Nat.mul_le_mul_left 65536 (Nat.pow_le_pow_left hx0_ge 2))
      have hB2pos : 0 < B.card ^ 2 := by positivity
      have hcancel : B.card ^ 2 * (A.card * B.card) ≤ B.card ^ 2 * (65536 * distinctDistancesFrom A x₀ ^ 2) := by
        calc B.card ^ 2 * (A.card * B.card) = A.card * B.card ^ 3 := by ring
          _ ≤ 65536 * (B.card * distinctDistancesFrom A x₀) ^ 2 := hsq
          _ = B.card ^ 2 * (65536 * distinctDistancesFrom A x₀ ^ 2) := by ring
      have hnat : A.card * B.card ≤ 65536 * distinctDistancesFrom A x₀ ^ 2 :=
        Nat.le_of_mul_le_mul_left hcancel hB2pos
      have hreal : (A.card : ℝ) * (B.card : ℝ) ≤ (256 * (distinctDistancesFrom A x₀ : ℝ)) ^ 2 := by
        have h1 : ((A.card * B.card : ℕ) : ℝ) ≤ ((65536 * distinctDistancesFrom A x₀ ^ 2 : ℕ) : ℝ) := by
          exact_mod_cast hnat
        push_cast at h1; linarith
      have hsqrt := Real.sqrt_le_sqrt hreal
      rw [Real.sqrt_sq (by positivity)] at hsqrt
      linarith
    by_cases hMge : A.card * B.card ≤ 8 * M
    · have h1 : A.card * B.card ^ 3 ≤ (A.card * B.card) ^ 2 := by nlinarith
      have h2 : (A.card * B.card) ^ 2 ≤ (8 * M) ^ 2 := Nat.pow_le_pow_left hMge 2
      nlinarith
    · push Not at hMge
      -- Apply generic rotation to A ∪ allCircleInters (circleFamily A B)
      obtain ⟨t, hgenX, hgenY⟩ := exists_generic_rot (A ∪ allCircleInters (circleFamily A B))
      let A' := A.image (rot t)
      let B' := B.image (rot t)
      have hBA' : B' ⊆ A' := image_subset_image hBA
      have hB'card : B'.card = B.card := card_image_of_injective B (rot_injective t)
      have hA'card : A'.card = A.card := card_image_of_injective A (rot_injective t)
      have hndeg' : ∀ y ∈ A', ∀ z ∈ A', y ≠ z → (B'.filter fun x => dist x y = dist x z).card ≤ 2 := by
        intro y hy z hz hyz
        obtain ⟨y₀, hy0, rfl⟩ := mem_image.mp hy
        obtain ⟨z₀, hz0, rfl⟩ := mem_image.mp hz
        have hyz0 : y₀ ≠ z₀ := fun h => hyz (congrArg (rot t) h)
        have hfeq : (B'.filter fun x => dist x (rot t y₀) = dist x (rot t z₀)) =
            (B.filter fun x => dist x y₀ = dist x z₀).image (rot t) := by
          ext x; simp only [B', mem_filter, mem_image]
          constructor
          · rintro ⟨⟨x₀, hx0, rfl⟩, hd⟩
            rw [rot_dist, rot_dist] at hd
            exact ⟨x₀, ⟨hx0, hd⟩, rfl⟩
          · rintro ⟨x₀, ⟨hx0, hd⟩, rfl⟩
            exact ⟨⟨x₀, hx0, rfl⟩, by rw [rot_dist, rot_dist]; exact hd⟩
        rw [hfeq, card_image_of_injective _ (rot_injective t)]
        exact hndeg y₀ hy0 z₀ hz0 hyz0
      have h𝒞'_eq : circleFamily A' B' = (circleFamily A B).image (fun c => (rot t c.1, c.2)) := by
        ext ⟨x', r⟩
        simp only [circleFamily, A', B', mem_biUnion, mem_image, mem_erase]
        constructor
        · rintro ⟨x, ⟨x₀, hx0, rfl⟩, r', ⟨y, ⟨hyx, y₀, hy0, rfl⟩, rfl⟩, hpair⟩
          cases hpair
          have hyx0 : y₀ ≠ x₀ := fun h => hyx (congrArg (rot t) h)
          refine ⟨(x₀, dist x₀ y₀), ⟨x₀, hx0, dist x₀ y₀, ⟨y₀, ⟨hyx0, hy0⟩, rfl⟩, rfl⟩, ?_⟩
          exact Prod.ext rfl (rot_dist t x₀ y₀).symm
        · rintro ⟨⟨x₀, r₀⟩, ⟨x₁, hx1, r₁, ⟨y₀, ⟨hyx0, hy0⟩, rfl⟩, hpair1⟩, hpair2⟩
          obtain ⟨rfl, rfl⟩ := Prod.mk.inj hpair1
          obtain ⟨rfl, rfl⟩ := Prod.mk.inj hpair2
          refine ⟨rot t x₁, ⟨x₁, hx1, rfl⟩, dist (rot t x₁) (rot t y₀),
            ⟨rot t y₀, ⟨fun h => hyx0 (rot_injective t h), y₀, hy0, rfl⟩, rfl⟩, ?_⟩
          exact Prod.ext rfl (rot_dist t x₁ y₀)
      have h𝒞'_card : (circleFamily A' B').card = M := by
        rw [h𝒞'_eq, card_image_of_injective]
        intro ⟨x₁, r₁⟩ ⟨x₂, r₂⟩ h
        exact Prod.ext (rot_injective t (Prod.mk.inj h).1) (Prod.mk.inj h).2
      have hW'_sub : allCircleInters (circleFamily A' B') ⊆
          (allCircleInters (circleFamily A B)).image (rot t) := by
        intro p hp
        obtain ⟨⟨c₁', c₂'⟩, hc12', hpc⟩ := mem_biUnion.mp hp
        have hcne' : c₁' ≠ c₂' := by
          intro heq; subst heq; simp [circleInter] at hpc
        rw [mem_product, h𝒞'_eq] at hc12'
        obtain ⟨c₁, hc1, rfl⟩ := mem_image.mp hc12'.1
        obtain ⟨c₂, hc2, rfl⟩ := mem_image.mp hc12'.2
        have hcne : c₁ ≠ c₂ := fun h => hcne' (congrArg (fun c : ℝ² × ℝ => (rot t c.1, c.2)) h)
        -- Find preimage p₀ of p under rot t (using rot (-t)!)
        let p₀ := rot (-t) p
        have hrot_inv : rot t p₀ = p := by
          dsimp only [p₀]
          ext i; fin_cases i
          · simp only [Fin.zero_eta, rot_zero, rot_one]
            have hd : (1 + t ^ 2 : ℝ) ≠ 0 := by positivity
            have hd' : (1 + (-t) ^ 2 : ℝ) ≠ 0 := by positivity
            field_simp [hd, hd']; ring
          · simp only [Fin.mk_one, rot_zero, rot_one]
            have hd : (1 + t ^ 2 : ℝ) ≠ 0 := by positivity
            have hd' : (1 + (-t) ^ 2 : ℝ) ≠ 0 := by positivity
            field_simp [hd, hd']; ring
        have hpc' := (mem_circleInter hcne').mp hpc
        have hp0_mem : p₀ ∈ circleInter c₁ c₂ := by
          rw [mem_circleInter hcne]
          exact ⟨by rw [← rot_dist t c₁.1 p₀, hrot_inv]; exact hpc'.1,
                 by rw [← rot_dist t c₂.1 p₀, hrot_inv]; exact hpc'.2⟩
        exact mem_image.mpr ⟨p₀, mem_biUnion.mpr ⟨(c₁, c₂), mem_product.mpr ⟨hc1, hc2⟩, hp0_mem⟩, hrot_inv⟩
      have hAW'_sub : A' ∪ allCircleInters (circleFamily A' B') ⊆
          (A ∪ allCircleInters (circleFamily A B)).image (rot t) := by
        rw [image_union]
        exact union_subset_union_right hW'_sub
      have hgenX' : ∀ p ∈ A' ∪ allCircleInters (circleFamily A' B'),
          ∀ q ∈ A' ∪ allCircleInters (circleFamily A' B'), p ≠ q → p 0 ≠ q 0 := by
        intro p hp q hq hpq
        obtain ⟨p₀, hp0, rfl⟩ := mem_image.mp (hAW'_sub hp)
        obtain ⟨q₀, hq0, rfl⟩ := mem_image.mp (hAW'_sub hq)
        exact hgenX p₀ hp0 q₀ hq0 (fun h => hpq (congrArg (rot t) h))
      have hgenY' : ∀ p ∈ A' ∪ allCircleInters (circleFamily A' B'),
          ∀ q ∈ A' ∪ allCircleInters (circleFamily A' B'), p ≠ q → p 1 ≠ q 1 := by
        intro p hp q hq hpq
        obtain ⟨p₀, hp0, rfl⟩ := mem_image.mp (hAW'_sub hp)
        obtain ⟨q₀, hq0, rfl⟩ := mem_image.mp (hAW'_sub hq)
        exact hgenY p₀ hp0 q₀ hq0 (fun h => hpq (congrArg (rot t) h))
      have hres := szekely_generic A' B' hBA' (by omega) hndeg' (by rw [h𝒞'_card, hA'card, hB'card]; exact hMge) hgenX' hgenY'
      rwa [hA'card, hB'card, h𝒞'_card] at hres
