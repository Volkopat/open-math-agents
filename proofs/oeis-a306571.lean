/-! ## The statement -/


/-- The condition counted by `a n`, for the quadruple `(w, x, y, z)`. -/
def IsSol (n w x y z : ℕ) : Prop :=
  n = w * (w + 1) + (x + 3).choose 4 + (y + 5).choose 6 + (z + 7).choose 8

/-! ## Closed forms of the binomial coefficients -/

def c4 (x : ℕ) : ℕ := x * (x + 1) * (x + 2) * (x + 3) / 24

def c6 (y : ℕ) : ℕ := y * (y + 1) * (y + 2) * (y + 3) * (y + 4) * (y + 5) / 720

def c8 (z : ℕ) : ℕ :=
  z * (z + 1) * (z + 2) * (z + 3) * (z + 4) * (z + 5) * (z + 6) * (z + 7) / 40320

theorem choose4 (x : ℕ) : (x + 3).choose 4 = c4 x := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (x + 3) 4
  simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, Nat.factorial] at h
  rw [c4, show x * (x + 1) * (x + 2) * (x + 3) = 24 * (x + 3).choose 4 by
    rw [show x + 3 - 3 = x by omega, show x + 3 - 2 = x + 1 by omega,
      show x + 3 - 1 = x + 2 by omega, Nat.sub_zero] at h
    linarith]
  omega

theorem choose6 (y : ℕ) : (y + 5).choose 6 = c6 y := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (y + 5) 6
  simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, Nat.factorial] at h
  rw [c6, show y * (y + 1) * (y + 2) * (y + 3) * (y + 4) * (y + 5) = 720 * (y + 5).choose 6 by
    rw [show y + 5 - 5 = y by omega, show y + 5 - 4 = y + 1 by omega,
      show y + 5 - 3 = y + 2 by omega, show y + 5 - 2 = y + 3 by omega,
      show y + 5 - 1 = y + 4 by omega, Nat.sub_zero] at h
    linarith]
  omega

theorem choose8 (z : ℕ) : (z + 7).choose 8 = c8 z := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (z + 7) 8
  simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, Nat.factorial] at h
  rw [c8, show z * (z + 1) * (z + 2) * (z + 3) * (z + 4) * (z + 5) * (z + 6) * (z + 7) =
      40320 * (z + 7).choose 8 by
    rw [show z + 7 - 7 = z by omega, show z + 7 - 6 = z + 1 by omega,
      show z + 7 - 5 = z + 2 by omega, show z + 7 - 4 = z + 3 by omega,
      show z + 7 - 3 = z + 4 by omega, show z + 7 - 2 = z + 5 by omega,
      show z + 7 - 1 = z + 6 by omega, Nat.sub_zero] at h
    linarith]
  omega

theorem c4_mono {x x' : ℕ} (h : x ≤ x') : c4 x ≤ c4 x' := by
  rw [← choose4, ← choose4]; exact Nat.choose_le_choose 4 (by omega)

theorem c6_mono {y y' : ℕ} (h : y ≤ y') : c6 y ≤ c6 y' := by
  rw [← choose6, ← choose6]; exact Nat.choose_le_choose 6 (by omega)

theorem c8_mono {z z' : ℕ} (h : z ≤ z') : c8 z ≤ c8 z' := by
  rw [← choose8, ← choose8]; exact Nat.choose_le_choose 8 (by omega)

theorem isSol_iff (n w x y z : ℕ) :
    IsSol n w x y z ↔ c8 z + c6 y + c4 x ≤ n ∧ w * (w + 1) = n - (c8 z + c6 y + c4 x) := by
  rw [IsSol, choose4, choose6, choose8]
  omega

/-! ## Pronic numbers -/

theorem beq_false_of_ne {a b : ℕ} (h : a ≠ b) : Nat.beq a b = false := by
  cases hc : Nat.beq a b
  · rfl
  · exact absurd (Nat.beq_eq.mp hc) h

/-- Bit `r` is set for every square residue `r` modulo `45045 = 9 * 5 * 7 * 11 * 13`. -/
def QRM : ℕ := 

def qrCheck : ℕ → ℕ → Bool
  | 0, _ => true
  | n + 1, k => Nat.testBit QRM (k * k % 45045) && qrCheck n (k + 1)

theorem qrCheck_spec : ∀ n k, qrCheck n k = true →
    ∀ j, k ≤ j → j < k + n → Nat.testBit QRM (j * j % 45045) = true := by
  intro n
  induction n with
  | zero => intro k _ j h1 h2; omega
  | succ n ih =>
    intro k h j h1 h2
    simp only [qrCheck, Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact h.1
    · exact ih (k + 1) h.2 j (by omega) (by omega)

theorem QRM_spec : ∀ k, k < 45045 → Nat.testBit QRM (k * k % 45045) = true :=
  fun k hk => qrCheck_spec 45045 0 (by decide +kernel) k (Nat.zero_le _) (by omega)

def isqF : ℕ → ℕ → ℕ → ℕ
  | 0, _, g => g
  | fuel + 1, v, g => cond (Nat.blt ((g + v / g) / 2) g) (isqF fuel v ((g + v / g) / 2)) g

/-- A square root guess (Newton from `2 ^ 23`); `wList` checks it. -/
def isq (v : ℕ) : ℕ := isqF 40 v 8388608

/-- The `w` with `w(w+1) = r`: `4r + 1` must be a square; a residue filter, then the guess,
checked, with a slow search if the guess is not the square root. -/
def wList (r : ℕ) : List ℕ :=
  cond (Nat.testBit QRM ((4 * r + 1) % 45045))
    (cond (Nat.beq (isq (4 * r + 1) * isq (4 * r + 1)) (4 * r + 1)) [(isq (4 * r + 1) - 1) / 2]
      (cond (Nat.ble (isq (4 * r + 1) * isq (4 * r + 1)) (4 * r + 1) &&
          Nat.blt (4 * r + 1) ((isq (4 * r + 1) + 1) * (isq (4 * r + 1) + 1))) []
        ((List.range (r + 1)).filter (fun w => Nat.beq (w * (w + 1)) r))))
    []

theorem pronic_sq {w r : ℕ} (h : w * (w + 1) = r) : (2 * w + 1) * (2 * w + 1) = 4 * r + 1 := by
  rw [← h]; ring

theorem mem_wList (r w : ℕ) : w ∈ wList r ↔ w * (w + 1) = r := by
  unfold wList
  by_cases hq : Nat.testBit QRM ((4 * r + 1) % 45045) = true
  · rw [hq, cond_true]
    set s := isq (4 * r + 1) with hs
    by_cases h1 : s * s = 4 * r + 1
    · rw [show Nat.beq (s * s) (4 * r + 1) = true from Nat.beq_eq.mpr h1, cond_true,
        List.mem_singleton]
      have hodd : s % 2 = 1 := by
        rcases Nat.mod_two_eq_zero_or_one s with h | h
        · have : s * s % 2 = 0 := by rw [Nat.mul_mod, h]
          omega
        · exact h
      constructor
      · rintro rfl
        obtain ⟨k, hk⟩ : ∃ k, s = 2 * k + 1 := ⟨s / 2, by omega⟩
        rw [hk] at h1
        rw [hk, show (2 * k + 1 - 1) / 2 = k by omega]
        nlinarith
      · intro hw
        have h2 := pronic_sq hw
        have : s = 2 * w + 1 := by
          rw [← h2] at h1
          exact Nat.mul_self_inj.mp h1
        omega
    · rw [beq_false_of_ne h1, cond_false]
      by_cases h2 : (Nat.ble (s * s) (4 * r + 1) && Nat.blt (4 * r + 1) ((s + 1) * (s + 1))) = true
      · rw [h2, cond_true]
        simp only [List.not_mem_nil, false_iff]
        intro hw
        have h3 := pronic_sq hw
        simp only [Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq] at h2
        obtain ⟨hlo, hhi⟩ := h2
        rw [← h3] at hlo hhi
        have := Nat.mul_self_le_mul_self_iff.mp hlo
        have := Nat.mul_self_lt_mul_self_iff.mp hhi
        exact h1 (by rw [← h3, show s = 2 * w + 1 by omega])
      · rw [Bool.eq_false_iff.mpr h2, cond_false]
        simp only [List.mem_filter, List.mem_range, Nat.beq_eq]
        constructor
        · exact fun h => h.2
        · intro hw
          exact ⟨by nlinarith, hw⟩
  · rw [Bool.eq_false_iff.mpr hq, cond_false]
    simp only [List.not_mem_nil, false_iff]
    intro hw
    apply hq
    rw [← pronic_sq hw, Nat.mul_mod]
    exact QRM_spec _ (Nat.mod_lt _ (by norm_num))

/-! ## The search -/

abbrev Hit := ℕ × ℕ × ℕ × ℕ × ℕ

/-- For the targets `ns` at `(x, y, z)` with `S = C(z+7,8) + C(y+5,6) + C(x+3,4)`. -/
def leafs (S x y z : ℕ) : List ℕ → List Hit
  | [] => []
  | n :: ns => cond (Nat.ble S n) ((wList (n - S)).map (fun w => (n, w, x, y, z))) [] ++
      leafs S x y z ns

theorem mem_leafs (x y z : ℕ) (t : Hit) : ∀ ns, t ∈ leafs (c8 z + c6 y + c4 x) x y z ns ↔
    ∃ n ∈ ns, ∃ w, t = (n, w, x, y, z) ∧ IsSol n w x y z := by
  intro ns
  induction ns with
  | nil => simp [leafs]
  | cons n ns ih =>
    rw [leafs, List.mem_append, ih]
    have hn : t ∈ cond (Nat.ble (c8 z + c6 y + c4 x) n)
        ((wList (n - (c8 z + c6 y + c4 x))).map (fun w => (n, w, x, y, z))) [] ↔
        ∃ w, t = (n, w, x, y, z) ∧ IsSol n w x y z := by
      by_cases hS : c8 z + c6 y + c4 x ≤ n
      · rw [show Nat.ble (c8 z + c6 y + c4 x) n = true from Nat.ble_eq.mpr hS, cond_true,
          List.mem_map]
        constructor
        · rintro ⟨w, hw, rfl⟩
          exact ⟨w, rfl, (isSol_iff n w x y z).mpr ⟨hS, (mem_wList _ w).mp hw⟩⟩
        · rintro ⟨w, rfl, hsol⟩
          exact ⟨w, (mem_wList _ w).mpr ((isSol_iff n w x y z).mp hsol).2, rfl⟩
      · have hb : Nat.ble (c8 z + c6 y + c4 x) n = false := by
          cases hc : Nat.ble (c8 z + c6 y + c4 x) n
          · rfl
          · exact absurd (Nat.ble_eq.mp hc) hS
        rw [hb, cond_false]
        simp only [List.not_mem_nil, false_iff, not_exists, not_and]
        intro w _ hsol
        exact hS ((isSol_iff n w x y z).mp hsol).1
    rw [hn]
    constructor
    · rintro (⟨w, h⟩ | ⟨m, hm, w, h⟩)
      · exact ⟨n, List.mem_cons_self, w, h⟩
      · exact ⟨m, List.mem_cons_of_mem _ hm, w, h⟩
    · rintro ⟨m, hm, w, h⟩
      rcases List.mem_cons.mp hm with rfl | hm
      · exact Or.inl ⟨w, h⟩
      · exact Or.inr ⟨m, hm, w, h⟩

def xLoop (ns : List ℕ) (N y z : ℕ) : ℕ → ℕ → List Hit
  | 0, _ => []
  | fuel + 1, x => cond (Nat.blt N (c8 z + c6 y + c4 x)) []
      (leafs (c8 z + c6 y + c4 x) x y z ns ++ xLoop ns N y z fuel (x + 1))

/-- No solution for a target `n ≤ N` once `C(z+7,8) + C(y+5,6) + C(x+3,4) > N`. -/
theorem no_sol_above {ns : List ℕ} {N : ℕ} (hN : ∀ n ∈ ns, n ≤ N) {n w x y z : ℕ} (hn : n ∈ ns)
    (hsol : IsSol n w x y z) : c8 z + c6 y + c4 x ≤ N := by
  have := ((isSol_iff n w x y z).mp hsol).1
  have := hN n hn
  omega

theorem mem_xLoop {ns : List ℕ} {N y z : ℕ} (hN : ∀ n ∈ ns, n ≤ N) (t : Hit) : ∀ fuel x,
    N < c8 z + c6 y + c4 (x + fuel) →
      (t ∈ xLoop ns N y z fuel x ↔ ∃ n ∈ ns, ∃ w x', x ≤ x' ∧ t = (n, w, x', y, z) ∧
        IsSol n w x' y z) := by
  intro fuel
  induction fuel with
  | zero =>
    intro x hf
    simp only [xLoop, List.not_mem_nil, false_iff, not_exists, not_and]
    intro n hn w x' hx' _ hsol
    have := no_sol_above hN hn hsol
    have := c4_mono hx'
    rw [Nat.add_zero] at hf
    omega
  | succ fuel ih =>
    intro x hf
    by_cases hS : N < c8 z + c6 y + c4 x
    · rw [xLoop, show Nat.blt N (c8 z + c6 y + c4 x) = true from Nat.blt_eq.mpr hS, cond_true]
      simp only [List.not_mem_nil, false_iff, not_exists, not_and]
      intro n hn w x' hx' _ hsol
      have := no_sol_above hN hn hsol
      have := c4_mono hx'
      omega
    · have hb : Nat.blt N (c8 z + c6 y + c4 x) = false := by
        cases hc : Nat.blt N (c8 z + c6 y + c4 x)
        · rfl
        · exact absurd (Nat.blt_eq.mp hc) hS
      rw [xLoop, hb, cond_false, List.mem_append, mem_leafs,
        ih (x + 1) (by rw [show x + 1 + fuel = x + (fuel + 1) by ring]; exact hf)]
      constructor
      · rintro (⟨n, hn, w, rfl, hsol⟩ | ⟨n, hn, w, x', hx', rfl, hsol⟩)
        · exact ⟨n, hn, w, x, le_rfl, rfl, hsol⟩
        · exact ⟨n, hn, w, x', by omega, rfl, hsol⟩
      · rintro ⟨n, hn, w, x', hx', rfl, hsol⟩
        rcases Nat.eq_or_lt_of_le hx' with rfl | hlt
        · exact Or.inl ⟨n, hn, w, rfl, hsol⟩
        · exact Or.inr ⟨n, hn, w, x', hlt, rfl, hsol⟩

def yLoop (ns : List ℕ) (N z : ℕ) : ℕ → ℕ → List Hit
  | 0, _ => []
  | fuel + 1, y => cond (Nat.blt N (c8 z + c6 y)) []
      (xLoop ns N y z 200 0 ++ yLoop ns N z fuel (y + 1))

theorem mem_yLoop {ns : List ℕ} {N z : ℕ} (hN : ∀ n ∈ ns, n ≤ N) (hx : N < c4 200) (t : Hit) :
    ∀ fuel y, N < c8 z + c6 (y + fuel) →
      (t ∈ yLoop ns N z fuel y ↔ ∃ n ∈ ns, ∃ w x y', y ≤ y' ∧ t = (n, w, x, y', z) ∧
        IsSol n w x y' z) := by
  intro fuel
  induction fuel with
  | zero =>
    intro y hf
    simp only [yLoop, List.not_mem_nil, false_iff, not_exists, not_and]
    intro n hn w x y' hy' _ hsol
    have := no_sol_above hN hn hsol
    have := c6_mono hy'
    rw [Nat.add_zero] at hf
    omega
  | succ fuel ih =>
    intro y hf
    by_cases hS : N < c8 z + c6 y
    · rw [yLoop, show Nat.blt N (c8 z + c6 y) = true from Nat.blt_eq.mpr hS, cond_true]
      simp only [List.not_mem_nil, false_iff, not_exists, not_and]
      intro n hn w x y' hy' _ hsol
      have := no_sol_above hN hn hsol
      have := c6_mono hy'
      omega
    · have hb : Nat.blt N (c8 z + c6 y) = false := by
        cases hc : Nat.blt N (c8 z + c6 y)
        · rfl
        · exact absurd (Nat.blt_eq.mp hc) hS
      rw [yLoop, hb, cond_false, List.mem_append,
        mem_xLoop hN t 200 0 (by rw [Nat.zero_add]; omega),
        ih (y + 1) (by rw [show y + 1 + fuel = y + (fuel + 1) by ring]; exact hf)]
      constructor
      · rintro (⟨n, hn, w, x, -, rfl, hsol⟩ | ⟨n, hn, w, x, y', hy', rfl, hsol⟩)
        · exact ⟨n, hn, w, x, y, le_rfl, rfl, hsol⟩
        · exact ⟨n, hn, w, x, y', by omega, rfl, hsol⟩
      · rintro ⟨n, hn, w, x, y', hy', rfl, hsol⟩
        rcases Nat.eq_or_lt_of_le hy' with rfl | hlt
        · exact Or.inl ⟨n, hn, w, x, Nat.zero_le _, rfl, hsol⟩
        · exact Or.inr ⟨n, hn, w, x, y', hlt, rfl, hsol⟩

/-- A hit for `z`: a solution for a target in `ns` with this `z`. -/
def IsHitZ (ns : List ℕ) (z : ℕ) (t : Hit) : Prop :=
  ∃ n ∈ ns, ∃ w x y, t = (n, w, x, y, z) ∧ IsSol n w x y z

theorem mem_yLoop0 {ns : List ℕ} {N z : ℕ} (hN : ∀ n ∈ ns, n ≤ N) (hx : N < c4 200)
    (hy : N < c6 100) (t : Hit) : t ∈ yLoop ns N z 100 0 ↔ IsHitZ ns z t := by
  rw [mem_yLoop hN hx t 100 0 (by rw [Nat.zero_add]; omega)]
  constructor
  · rintro ⟨n, hn, w, x, y, -, rfl, hsol⟩
    exact ⟨n, hn, w, x, y, rfl, hsol⟩
  · rintro ⟨n, hn, w, x, y, rfl, hsol⟩
    exact ⟨n, hn, w, x, y, Nat.zero_le _, rfl, hsol⟩

/-- After the values `z' < z`, `acc` lists every hit. -/
def Inv (ns : List ℕ) (z : ℕ) (acc : List Hit) : Prop :=
  ∀ t, t ∈ acc ↔ ∃ z', z' < z ∧ IsHitZ ns z' t

theorem inv_zero (ns : List ℕ) : Inv ns 0 [] := by
  intro t; simp only [List.not_mem_nil, false_iff]; omega

theorem inv_step {ns : List ℕ} {N z : ℕ} {acc L acc' : List Hit} (hN : ∀ n ∈ ns, n ≤ N)
    (hx : N < c4 200) (hy : N < c6 100) (h : Inv ns z acc) (hs : yLoop ns N z 100 0 = L)
    (hacc : acc ++ L = acc') : Inv ns (z + 1) acc' := by
  intro t
  rw [← hacc, List.mem_append, h t, ← hs, mem_yLoop0 hN hx hy t]
  constructor
  · rintro (⟨z', h1, ht⟩ | ht)
    · exact ⟨z', by omega, ht⟩
    · exact ⟨z, by omega, ht⟩
  · rintro ⟨z', h1, ht⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp h1 with h2 | rfl
    · exact Or.inl ⟨z', h2, ht⟩
    · exact Or.inr ht

theorem sol_iff {ns : List ℕ} {N Z : ℕ} {acc : List Hit} (hN : ∀ n ∈ ns, n ≤ N)
    (hInv : Inv ns Z acc) (hZ : N < c8 Z) :
    ∀ n ∈ ns, ∀ w x y z, IsSol n w x y z ↔ (n, w, x, y, z) ∈ acc := by
  intro n hn w x y z
  rw [hInv]
  constructor
  · intro hsol
    have h1 := no_sol_above hN hn hsol
    have hz : z < Z := by
      by_contra hc
      have := c8_mono (show Z ≤ z by omega)
      omega
    exact ⟨z, hz, n, hn, w, x, y, rfl, hsol⟩
  · rintro ⟨z', -, m, hm, w', x', y', ht, hsol⟩
    simp only [Prod.mk.injEq] at ht
    obtain ⟨rfl, rfl, rfl, rfl, rfl⟩ := ht
    exact hsol

theorem a_eq_length {ns : List ℕ} {N Z : ℕ} {acc : List Hit} (hN : ∀ n ∈ ns, n ≤ N)
    (hInv : Inv ns Z acc) (hZ : N < c8 Z) {n : ℕ} (hn : n ∈ ns)
    (hnd : ((acc.filter (fun t => t.1 = n)).map (fun t => t.2)).Nodup) :
    a n = ((acc.filter (fun t => t.1 = n)).map (fun t => t.2)).length := by
  have hset : {q : ℕ × ℕ × ℕ × ℕ | n = q.1 * (q.1 + 1) + (q.2.1 + 3).choose 4 +
      (q.2.2.1 + 5).choose 6 + (q.2.2.2 + 7).choose 8} =
      ↑((acc.filter (fun t => t.1 = n)).map (fun t => t.2)).toFinset := by
    ext ⟨w, x, y, z⟩
    simp only [Set.mem_ofPred_eq, List.coe_toFinset, List.mem_map, List.mem_filter,
      decide_eq_true_eq]
    rw [show (n = w * (w + 1) + (x + 3).choose 4 + (y + 5).choose 6 + (z + 7).choose 8) =
      IsSol n w x y z from rfl, sol_iff hN hInv hZ n hn]
    constructor
    · intro h
      exact ⟨(n, w, x, y, z), ⟨h, rfl⟩, rfl⟩
    · rintro ⟨⟨m, t⟩, ⟨ht, rfl⟩, rfl⟩
      exact ht
  rw [a, hset, Set.ncard_coe_finset, List.toFinset_card_of_nodup hnd]


