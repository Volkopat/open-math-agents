theorem cls_lt : ∀ t : R, cls t < 50 := by decide +kernel

theorem sum_cls (g : ℕ → ℕ) (P : R → Prop) [DecidablePred P] :
    (∑ t : R, if P t then g (cls t) else 0) =
      ∑ c ∈ Finset.range 50, (Finset.univ.filter (fun t : R => cls t = c ∧ P t)).card * g c := by
  have h1 : ∀ t : R, (if P t then g (cls t) else 0) =
      ∑ c ∈ Finset.range 50, if cls t = c ∧ P t then g c else 0 := by
    intro t
    rw [Finset.sum_eq_single (cls t)]
    · by_cases hp : P t <;> simp [hp]
    · intro c _ hc
      rw [if_neg]
      exact fun h => hc h.1.symm
    · intro h
      exact absurd (Finset.mem_range.mpr (cls_lt t)) h
  rw [Finset.sum_congr rfl (fun t _ => h1 t), Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro c _
  rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul]

/-- The lines, numbered by their base-4 digits. -/
abbrev E : R ≃ Fin (4 ^ 5) := finFunctionFinEquiv

/-- The line with digit code x. -/
def dec (x : ℕ) : R := fun i => ⟨x / 4 ^ (i : ℕ) % 4, Nat.mod_lt _ (by norm_num)⟩

theorem E_symm (a : Fin (4 ^ 5)) : E.symm a = dec a := by
  funext i
  exact Fin.ext rfl

theorem dec_E (t : R) : dec (E t : ℕ) = t := by
  rw [← E_symm, Equiv.symm_apply_apply]

/-- mem c: the codes of the lines of class c. -/
noncomputable def mem (c : ℕ) : List ℕ :=
