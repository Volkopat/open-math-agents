theorem mem_nodup : ∀ c < 50, (mem c).Nodup := by decide +kernel

theorem mem_sound : ∀ c < 50, ∀ x ∈ mem c, x < 4 ^ 5 ∧ cls (dec x) = c := by decide +kernel

theorem mem_complete : ∀ x < 4 ^ 5, x ∈ mem (cls (dec x)) := by decide +kernel

theorem card_cls (c : ℕ) (hc : c < 50) (P : R → Prop) [DecidablePred P] :
    (Finset.univ.filter (fun u : R => cls u = c ∧ P u)).card =
      ((mem c).filter (fun x => P (dec x))).length := by
  have hn := List.toFinset_card_of_nodup ((mem_nodup c hc).filter (fun x => decide (P (dec x))))
  rw [← hn]
  apply Finset.card_bij (fun u _ => ((E u : Fin (4 ^ 5)) : ℕ))
  · intro u hu
    rw [Finset.mem_filter] at hu
    rw [List.mem_toFinset, List.mem_filter]
    refine ⟨?_, ?_⟩
    · have h := mem_complete (E u : ℕ) (E u).isLt
      rw [dec_E, hu.2.1] at h
      exact h
    · rw [dec_E]
      exact decide_eq_true hu.2.2
  · intro u1 _ u2 _ h
    exact E.injective (Fin.ext h)
  · intro x hx
    rw [List.mem_toFinset, List.mem_filter] at hx
    obtain ⟨hx1, hx2⟩ := hx
    obtain ⟨hs1, hs2⟩ := mem_sound c hc x hx1
    have e : E.symm ⟨x, hs1⟩ = dec x := E_symm ⟨x, hs1⟩
    have he : E (dec x) = ⟨x, hs1⟩ := (congrArg E e).symm.trans (Equiv.apply_symm_apply E ⟨x, hs1⟩)
    refine ⟨dec x, ?_, congrArg Fin.val he⟩
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_univ _, hs2, of_decide_eq_true hx2⟩

