theorem allCert (i : Fin 2412) : certCheck i.val := by
  have hi := i.isLt
  by_cases h : 2400 ≤ i.val
  · let r : Fin 12 := ⟨i.val-2400, by omega⟩
    have e : i.val = 2400+r.val := by dsimp [r]; omega
    rw [e]; exact cert75 r
  · let b := i.val/32
    let j : Fin 32 := ⟨i.val%32, Nat.mod_lt _ (by decide)⟩
    have hb : b < 75 := by dsimp [b]; omega
    have e : i.val = 32*b+j.val := by dsimp [b,j]; omega
