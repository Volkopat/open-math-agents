theorem OMA.solution : OMA.R_oeis_a187553_R1.H1 := by
  intro n hlo hhi
  let i : Fin 1021 := ⟨n-4, by omega⟩
  obtain ⟨hb,hd⟩ := allDigit i
  refine ⟨value i.val, every_prime rows 2412 (fun j hj => allCert ⟨j,hj⟩) (witnessId i.val) hb, ?_⟩
  have e : i.val+4=n := by dsimp [i]; omega
  exact hd.trans e