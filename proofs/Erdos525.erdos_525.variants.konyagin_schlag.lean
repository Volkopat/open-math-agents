lemma RM (a : d) (u : 0 < a) (c ae : b) (f6 : 2 * ac a < r * (2 * am a)) (fH : jo a 0 < 1) (B9 : jM a < ae / 2) (l : R (2 * a + 1)) (eo : mP a c ae l) : pY a c ae l := by
