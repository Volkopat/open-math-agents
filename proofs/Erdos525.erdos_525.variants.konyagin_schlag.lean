lemma Uc(c:b)(aq:0<c):∀ᶠa:d in J,1-T.Odd.ex a c<=(16*jZ+10)*c:=by (classical have kX:aa (λt:d=>2*((12*(2*c)/r)*cl (1/(t+1:b)) (t+1:b))) J (nhds (16*jZ*c)):=by{convert(Ms (2*c)).const_mul 2 using 1;ring_nf};(have ax:=kX.eventually (b1 (show 16*jZ*c<16*jZ*c+c by linarith)));have r2:=(T.Odd.TW c).eventually (b1 aq);have eF:=(T.Odd.TX c).eventually (b1 aq);obtain⟨t,eg,hkl,hkh⟩:=(ax.and (r2.and eF)).exists;let ae:b:=1/(t+1:b);let ah:b:=t+1;have fi:0<ae:=by{dsimp[ae];positivity};have dc:0<ah:=by{dsimp[ah];positivity};let I:b:=2*((12*(2*c)/r)*cl ae ah);have YJ:I<16*jZ*c+c:=eg;have ut:0<=I:=by{dsimp[I];exact aA (by norm_num) (aA (by positivity) (L5 ae ah))};have cq:∀ᶠa:d in J,T.Odd.pV a 1 2 (2*c) ae ah<I+c:=by{have iS:=T.Odd.Rb 1 (by omega) 2 (2*c) ae ah (by norm_num) (by positivity) fi dc aq;filter_upwards[iS]with a u;have fY:(fG a 1).card<=af a:=by{exact (_C (f0 a) (_B (((ge a).powersetCard 1).card) (wJ (Finset.filter_subset _ _)) (by rw[VZ,xQ];simp)) (wU _ _))};have pK:((fG a 1).card:b)<=(af a:b):=by{exact_mod_cast fY};have eK:(0:b)<af a:=by{exact_mod_cast eI a};have bH:I*((fG a 1).card:b)/af a<=I:=(fm eK).2 (aF pK ut);have nM:|T.Odd.pV a 1 2 (2*c) ae ah-I*((fG a 1).card:b)/af a|<c:=by{simpa only[pow_one,I]using u};linarith[(abs_lt.1 nM).2]};have g1:=(T.Odd.TR c aq).eventually (b1 aq);have eo:=T.Odd.RU c (2*ae) aq.le (by positivity);have hV:=T.Odd.SR c (ah/2) c aq.le (by positivity) (by (simpa[T.Odd.Cp,ah,div_div,show(2:b)*4=8 by norm_num]using hkh));have r3:=T.Odd.TV c ae ah;have kJ:=T5 c (2*c) 2 ae ah (by linarith) (by norm_num) fi dc;filter_upwards[cq,g1,eo,hV,r3,kJ]with a Zj Zk Vw Zl Zm Vx;have YK:Y (T.Odd.mP a c (2*ae))<c:=by{have cg:256*r^2*(c+1+2*r*(2*ae))^2*(2*(2*ae))^2<c:=by{simpa[T.Odd.Co,ae]using hkl};exact Vw.trans_lt cg};let he:R (2*a+1)->Prop:=λl=>∃x∈fG a 1,∀g∈x,T.Odd.fy a 2 (2*c) ae ah l g;have gE:Y he<=T.Odd.pV a 1 2 (2*c) ae ah:=OMA.T3 (fG a 1) (λx l=>∀g∈x,T.Odd.fy a 2 (2*c) ae ah l g);have bN:Y (λl:R (2*a+1)=>T.Odd.minimum a l<=c/a)<=Y he+Y (T.Odd.n3 a c ae ah):=by{refine(hb (aT:=λl=>he l∨T.Odd.n3 a c ae ah l) ?_).trans (hE _ _);intro l cf;by_cases a0:T.Odd.v7 a c ae ah l;{exact Or.inl (Vx l a0)};{exact Or.inr ⟨cf,a0⟩}};have uP:Y (λl:R (2*a+1)=>T.Odd.minimum a l<=c/a)=1-T.Odd.ex a c:=by{simpa only[not_lt,T.Odd.ex]using OMA.T2 (λl:R (2*a+1)=>c/a<T.Odd.minimum a l)};rw[uP]at bN;linarith)
end OMA.r1
open Filter Real Finset T in
theorem OMA.solution : type_of% @Erdos525.erdos_525.variants.konyagin_schlag := by
  let C := 16 * T.jZ + 10
  refine ⟨C, fun ε hε ↦ ?_⟩
  have bound (last : OMA.LastTerm ()) :
      ∀ᶠ n : ℕ in atTop, 1 - @T.Odd.ex () last n ε ≤ C * ε :=
    @OMA.r1.Uc () last ε hε
  have comparison (n k : ℕ) (hn : 0 < n) (hk : 2*n ≤ k) :
      ε / √k ≤ √(2*n+2 : ℝ) * (ε / n) := by
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hk' : (n : ℝ) ≤ k := by exact_mod_cast (show n ≤ k by omega)
    have hs : 0 < √(k : ℝ) := Real.sqrt_pos.mpr (hn'.trans_le hk')
    have hp : (n : ℝ) ≤ √(2*n+2 : ℝ) * √(k : ℝ) := calc
      (n : ℝ) = √(n : ℝ) * √(n : ℝ) := (Real.mul_self_sqrt hn'.le).symm
      _ ≤ _ := mul_le_mul (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_le_sqrt hk')
        (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    apply (div_le_iff₀ hs).2
    rw [mul_comm _ (ε / n), mul_assoc]
    exact (div_mul_cancel₀ ε hn'.ne').symm.le.trans
      (mul_le_mul_of_nonneg_left hp (div_nonneg hε.le hn'.le))
  let event (k : ℕ) (v : R k) := ky v ≤ ε / √k
  have publicProb (k : ℕ) : Erdos525.prob k (fun f ↦ Erdos525.m f ≤ ε / √k) = Y (event k) := by
    simp only [OMA.prob_coeffEquiv, OMA.m_coeffEquiv, event]
  have pushBound (last : OMA.LastTerm ()) (n : ℕ) (hn : 0 < n) :
      Y (fun l : R (2*n+1) ↦ event (@T.Odd.selected () last n l).1 (@T.Odd.selected () last n l).2) ≤
        1 - @T.Odd.ex () last n ε := by
    unfold T.Odd.ex
    rw [← OMA.T2]
    apply T.hb
    intro l hl
    change ¬ ε / n < ky (@T.Odd.selected () last n l).2 / √(2*n+2 : ℝ)
    apply not_lt.mpr
    apply (div_le_iff₀ (by positivity)).2
    rw [mul_comm]
    exact hl.trans (comparison n _ hn (by cases last with | mk active =>
                                            cases active <;> simp [T.Odd.selected]))
  have evenBound : ∀ᶠ n : ℕ in atTop, Y (event (2*n)) ≤ C*ε := by
    filter_upwards [Nat.eventually_pos, bound ⟨false⟩] with n hn h
    have hp := pushBound ⟨false⟩ n hn
    change Y (fun l : R (2*n+1) ↦ event (2*n) (T.Odd.cA n l)) ≤ _ at hp
    rw [T.Odd.vy] at hp
    simpa only [T.Odd.Bt, add_self_div_two] using hp.trans h
  have oddBound : ∀ᶠ n : ℕ in atTop, Y (event (2*n+1)) ≤ C*ε := by
    filter_upwards [Nat.eventually_pos, bound ⟨true⟩] with n hn h
    exact (pushBound ⟨true⟩ n hn).trans h
  obtain ⟨Ne, he⟩ := eventually_atTop.mp evenBound
  obtain ⟨No, ho⟩ := eventually_atTop.mp oddBound
  apply limsup_le_of_le (isCoboundedUnder_le_of_le atTop
    (x := (0 : ℝ)) (fun n ↦ by unfold Erdos525.prob; positivity))
  refine eventually_atTop.mpr ⟨2 * max Ne No + 1, fun k hk ↦ ?_⟩
  rw [publicProb]
  obtain ⟨n, rfl | rfl⟩ := Nat.even_or_odd' k
  · exact he n (by omega)
  · exact ho n (by omega)
end
