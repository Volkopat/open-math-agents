theorem RE(E z:b)(d3:0<E)(eJ:0<z):∀ᶠa:d in J,∀e:b,bz a (am a) e->cK a (am a) (λ_:s 1=>e)->(af a:b)*Y (λl:R (2*a+1)=>bT a l (λ_:s 1=>e)∈iq (E/a) z)<=256*r^2*E^2*z^2:=by have lL:aa (λa:d=>(a:b)*bs a) J (𝓝 0):=rj;have a0:aa bs J (𝓝 0):=kg;have ds:aa (dZ 1) J (𝓝 0):=by{have dH:=px 1;refine en (f:=dZ 1) (g:=λa:d=>(af a:b)*dZ 1 a) (Eventually.of_forall λa=>(by unfold dZ;positivity)) ?_ (by simpa only[pow_one]using dH);exact Eventually.of_forall λa=>(by have hK:(1:b)<=af a:=by{exact_mod_cast eI a};have fD:0<=dZ 1 a:=by{unfold dZ;positivity};nlinarith)};(filter_upwards[ba,lL.eventually (b1 d3),a0.eventually (b1 eJ),ds.eventually (b1 ((by norm_num):(0:b)<1/2)),q9 (m:=1) (by omega) (show(0:b)<1 by norm_num)]with a u Vl Vm wD wE);intro e a1 bf;let k:b:=bs a;let x:=iq (E/a) z;let da:=iq (E/a+k) (z+k);let H:=Y (λl:R (2*a+1)=>bT a l (λ_:s 1=>e)∈x);have aV:(0:b)<a:=by{exact_mod_cast u};have BT:0<aL a:=hW a;have Yd:aL a<=1:=lT a;have RF:0<=bs a:=mB a;have mn:0<=k:=RF;have BU:k<=bs a:=ez;have BV:0<=E/a+k:=by{positivity};have BW:0<=z+k:=by{positivity};have kU:volume da≠⊤:=N9 _ _;have RG:∀q:P 1,bU a (λ_:s 1=>e) (aL a*aI a) q<=4:=by{intro q;have iS:=wE (λ_:s 1=>e) q (λ_=>a1) bf;rw[abs_lt]at iS;linarith[AU q]};have lJ:(∫q in da,bU a (λ_:s 1=>e) (aL a*aI a) q)<=4*volume.real da:=by{have a9:0<aL a*aI a:=ec BT (by unfold aI;exact cn u _);exact (_B (∫_y:P 1 in da,(4:b)) (by apply integral_mono_ae;{exact(rF 1 a (λ_:s 1=>e) (aL a*aI a) a9).integrableOn};{exact sM kU};{filter_upwards[]with q;exact RG q}) (by rw[setIntegral_const];simp;ring))};have a9:0<aL a*aI a:=ec BT (by unfold aI;exact cn u _);have vM:=vA a (λ_:s 1=>e) (aL a*aI a) k a9 mn x;have vN:fK k x⊆da:=(Oa _ _ _);have hO:(∫q in fK k x,bU a (λ_:s 1=>e) (aL a*aI a) q)<=∫q in da,bU a (λ_:s 1=>e) (aL a*aI a) q:=(lk (rF 1 a (λ_:s 1=>e) (aL a*aI a) a9).integrableOn (Eventually.of_forall λq=>vz 1 a (λ_:s 1=>e) (aL a*aI a) q) (Eventually.of_forall vN));have RH:2^(2*1)*B (-(k^2/(4*(aL a*aI a)^2)))=dZ 1 a:=by{unfold dZ;dsimp[k]};have es:H*(1/2)<=4*volume.real da:=by{have bd:0<=H:=iH _;have cb:(1/2:b)<1-dZ 1 a:=by{linarith};have bZ:=aF cb.le bd;exact (_Q (_Q (_C (H*(1-2^(2*1)*B (-(k^2/(4*(aL a*aI a)^2))))) (_P bZ (by rw[RH])) (by simpa only[H,x]using vM)) hO) lJ)};have Ye:H<=8*volume.real da:=by{linarith};have RI:E/a+k<2*(E/a):=by{have dH:(a:b)*k<E:=(aF BU aV.le).trans_lt Vl;have As:k<E/a:=(wH aV).2 (by simpa[dq]using dH);linarith};have RJ:z+k<2*z:=by{have:k<z:=BU.trans_lt Vm;linarith};have hj:(af a:b)<=2*a^2:=by{unfold af;push_cast;(nlinarith[show(1:b)<=a by exact_mod_cast u])};have RK:volume.real da=(r*(E/a+k)^2)*(r*(z+k)^2):=(N8 _ _ BV BW);have vf:(af a:b)*volume.real da<=32*r^2*E^2*z^2:=by{rw[RK];have Yf:=(eO BV (aA (by norm_num) (cj d3.le aV.le))).2 RI.le;have Yg:=(eO BW (aA (by norm_num) eJ.le)).2 RJ.le;exact (_B ((2*a^2)*((r*(2*(E/a))^2)*(r*(2*z)^2))) (by gcongr) (by field_simp[aV.ne'];ring))};exact (_B (8*(32*r^2*E^2*z^2)) (_C ((af a:b)*(8*volume.real da)) (by gcongr) (by nlinarith[vf])) (by ring))
