 | nil => simp at ib
 | cons kζ G bk =>
  rcases kζ with ⟨t, as⟩
  rcases List.mem_cons.mp ib with CD | gw
  ·
   have eg : t = h := co Prod.fst CD.symm
   have bO : as = W a e (h : A) := co Prod.snd CD.symm
   subst t
   subst as
   simp only [oU]
   rw [tC]
   funext v
   exact GP a e (h : A) v (e8 a e E z G) (z * fh a e G)
  ·
   simp only [oU]
   rw [bk gw, Gy]
