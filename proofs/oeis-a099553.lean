  have hP' : (8 : ℚ⟦X⟧) * X ^ 4 + (32 : ℚ⟦X⟧) * X ^ 3 * G + (-1 : ℚ⟦X⟧) * X ^ 3 + (48 : ℚ⟦X⟧) * X ^ 2 * G ^ 2 + (10 : ℚ⟦X⟧) * X ^ 2 * G + (32 : ℚ⟦X⟧) * X * G ^ 3 + (23 : ℚ⟦X⟧) * X * G ^ 2 + (-10 : ℚ⟦X⟧) * X * G + (8 : ℚ⟦X⟧) * G ^ 4 + (12 : ℚ⟦X⟧) * G ^ 3 + (6 : ℚ⟦X⟧) * G ^ 2 + (1 : ℚ⟦X⟧) * G = 0 := by linear_combination hP
