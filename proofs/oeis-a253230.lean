def K6 : Bool := rows.length == 497 && rows.all (fun r => r.all (fun e => decide (e < 497))) &&
  rows.getD 0 [] == []

set_option maxRecDepth 100000 in
theorem K6_ok : K6 = true := by decide +kernel

theorem rows_len : rows.length = 497 := by
  have h := K6_ok; unfold K6 at h; simp only [Bool.and_eq_true, beq_iff_eq] at h; exact h.1.1

theorem rows_lt (d : ℕ) (e : ℕ) (he : e ∈ rows.getD d []) : e < 497 := by
  have h := K6_ok
  unfold K6 at h
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at h
  by_cases hd : d < rows.length
  · rw [List.getD_eq_getElem _ _ hd] at he
    exact h.1.2 _ (List.getElem_mem hd) e he
  · rw [List.getD_eq_default _ _ (by omega)] at he
    simp at he

theorem rows_zero : rows.getD 0 [] = [] := by
  have h := K6_ok; unfold K6 at h; simp only [Bool.and_eq_true, beq_iff_eq] at h; exact h.2

/-! ### Class vectors -/

def step (v : List ℕ) : List ℕ := rows.map (fun r => (r.map (fun e => v.getD e 0)).sum)

def gvec : ℕ → List ℕ
  | 0 => (List.range 497).map (fun d => if d = 0 then 0 else 1)
  | m + 1 => step (gvec m)

def g (m d : ℕ) : ℕ := (gvec m).getD d 0

theorem g_succ (m d : ℕ) : g (m + 1) d = ((rows.getD d []).map (g m)).sum := by
  simp only [g, gvec, step]
  by_cases hd : d < rows.length
  · rw [List.getD_eq_getElem _ _ (by simpa using hd), List.getElem_map, List.getD_eq_getElem _ _ hd]
    rfl
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by omega)]
    rfl

theorem g_zero (d : ℕ) (hd : d < 497) : g 0 d = if d = 0 then 0 else 1 := by
  simp [g, gvec, List.getD_eq_getElem?_getD, hd]

theorem g_dead (m : ℕ) : g m 0 = 0 := by
  cases m with
  | zero => rw [g_zero 0 (by norm_num)]; rfl
  | succ m => rw [g_succ, rows_zero]; rfl

/-! ### Sums as list sums -/

theorem sum_fin_list (n : ℕ) (f : ℕ → ℕ) : (∑ c : Fin n, f c) = ((List.range n).map f).sum := by
  rw [Fin.sum_univ_eq_sum_range]
  induction n with
  | zero => simp
  | succ n ih => rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append, List.sum_append]; simp

theorem sum_filter_map (l : List ℕ) (p : ℕ → Bool) (f : ℕ → ℕ) :
    ((l.filter p).map f).sum = (l.map (fun c => if p c = true then f c else 0)).sum := by
  induction l with
  | nil => simp
  | cons x l ih =>
    by_cases h : p x = true
    · simp [h, ih]
    · simp [h, ih]

theorem F_eq (m : ℕ) : ∀ a b : ℕ, a < 256 → b < 256 → F Pb Qb (2 ^ 8) m a b = g m (kap a b) := by
  induction m with
  | zero =>
    intro a b ha hb
    obtain ⟨h1, h2⟩ := K1_spec a b ha hb
    rw [F, g_zero _ h2]
    by_cases hP : Pb a b = true
    · rw [if_pos hP, if_neg (h1.1 hP)]
    · rw [if_neg hP, if_pos (by by_contra hc; exact hP (h1.2 hc))]
  | succ m ih =>
    intro a b ha hb
    obtain ⟨h1, h2⟩ := K1_spec a b ha hb
    rw [F]
    by_cases hP : Pb a b = true
    · rw [if_pos hP, g_succ, ← K2_spec a b ha hb hP,
        ((List.perm_insertionSort _ _).map _).sum_eq]
      unfold succL
      rw [List.map_map, sum_filter_map]
      have : ∀ c : Fin (2 ^ 8), (if Qb a b c = true then F Pb Qb (2 ^ 8) m b c else 0) =
          (fun c : ℕ => if (kap b c != 0 && Qb a b c) = true then (g m ∘ kap b) c else 0) c := by
        intro c
        have hc : (c : ℕ) < 256 := c.isLt
        rw [ih b c hb hc]
        by_cases hQ : Qb a b c = true
        · by_cases hk : kap b c = 0
          · simp [hQ, hk, g_dead]
          · simp [hQ, hk]
        · simp [hQ]
      rw [Finset.sum_congr rfl (fun c _ => this c),
        sum_fin_list (2 ^ 8) (fun c => if (kap b c != 0 && Qb a b c) = true then (g m ∘ kap b) c else 0)]
      simp only [Nat.reducePow]
    · rw [if_neg hP]
      have hk : kap a b = 0 := by by_contra hc; exact hP (h1.2 hc)
      rw [hk, g_dead]

