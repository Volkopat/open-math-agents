def K3 : Bool := (List.range 497).all fun d =>
  L8.getD d 0 + 9 * L6.getD d 0 + 2 * L4.getD d 0 == 5 * L7.getD d 0 + 7 * L5.getD d 0

set_option maxRecDepth 100000 in
theorem K3_ok : K3 = true := by decide +kernel


theorem vec_id (m : ℕ) (hm : 4 ≤ m) : ∀ d, d < 497 →
    g (m + 4) d + 9 * g (m + 2) d + 2 * g m d = 5 * g (m + 3) d + 7 * g (m + 1) d := by
  induction m, hm using Nat.le_induction with
  | base =>
    intro d hd
    have h := K3_ok
    unfold K3 at h
    rw [List.all_eq_true] at h
    have := h d (List.mem_range.2 hd)
    simp only [beq_iff_eq] at this
    show (gvec 8).getD d 0 + 9 * (gvec 6).getD d 0 + 2 * (gvec 4).getD d 0 =
      5 * (gvec 7).getD d 0 + 7 * (gvec 5).getD d 0
    rw [gv4, gv5, gv6, gv7, gv8]
    exact this
  | succ m hm ih =>
    intro d _
    rw [show m + 1 + 4 = (m + 4) + 1 by ring, show m + 1 + 2 = (m + 2) + 1 by ring,
      show m + 1 + 3 = (m + 3) + 1 by ring, show m + 1 + 1 = (m + 1) + 1 by ring,
      g_succ, g_succ, g_succ, g_succ, g_succ]
    rw [← List.sum_map_mul_left, ← List.sum_map_mul_left, ← List.sum_map_mul_left,
      ← List.sum_map_mul_left, ← List.sum_map_add, ← List.sum_map_add, ← List.sum_map_add]
    congr 1
    apply List.map_congr_left
    intro e he
    exact ih e (rows_lt d e he)

def s (m : ℕ) : ℕ := ∑ a : Fin (2 ^ 8), ∑ b : Fin (2 ^ 8), F Pb Qb (2 ^ 8) m a b

theorem a_succ (m : ℕ) : OMA.S_oeis_a253230.a (m + 1) = s m := by
  rw [bridge, total]; rfl

theorem s_g (m : ℕ) : s m = ∑ a : Fin (2 ^ 8), ∑ b : Fin (2 ^ 8), g m (kap a b) := by
  unfold s
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro b _
  exact F_eq m a b a.isLt b.isLt

theorem s_rec (m : ℕ) (hm : 4 ≤ m) :
    s (m + 4) + 9 * s (m + 2) + 2 * s m = 5 * s (m + 3) + 7 * s (m + 1) := by
  simp only [s_g, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro b _
  exact vec_id m hm _ (K1_spec a b a.isLt b.isLt).2

/-! ### The first terms, through packed class vectors -/

def up (P d : ℕ) : ℕ := (P >>> (16 * d)) % 2 ^ 16

def pk : List ℕ → ℕ
  | [] => 0
  | x :: l => x + 2 ^ 16 * pk l

theorem up_pk (l : List ℕ) (h : ∀ x ∈ l, x < 2 ^ 16) (d : ℕ) : up (pk l) d = l.getD d 0 := by
  unfold up
  rw [Nat.shiftRight_eq_div_pow]
  induction l generalizing d with
  | nil => simp [pk]
  | cons x l ih =>
    have hx : x < 2 ^ 16 := h x (by simp)
    cases d with
    | zero =>
      rw [show 16 * 0 = 0 from rfl, pow_zero, Nat.div_one, pk, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hx]
      rfl
    | succ d =>
      have := ih (fun y hy => h y (by simp [hy])) d
      simp only [List.getD_cons_succ]
      rw [← this, pk, show 16 * (d + 1) = 16 + 16 * d by ring, pow_add, ← Nat.div_div_eq_div_mul,
        Nat.add_mul_div_left _ _ (by norm_num), Nat.div_eq_of_lt hx, zero_add]

def sNum (P : ℕ) : ℕ := ((List.range 256).map fun a => ((List.range 256).map fun b => up P (kap a b)).sum).sum

theorem s_num (m : ℕ) (l : List ℕ) (hl : gvec m = l) (h : ∀ x ∈ l, x < 2 ^ 16) :
    s m = sNum (pk l) := by
  rw [s_g]
  have hin : ∀ a : ℕ, (∑ b : Fin (2 ^ 8), g m (kap a b)) =
      ((List.range 256).map fun b => up (pk l) (kap a b)).sum := by
    intro a
    rw [sum_fin_list (2 ^ 8) (fun b => g m (kap a b))]
    simp only [Nat.reducePow]
    congr 1
    apply List.map_congr_left
