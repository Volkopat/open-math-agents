def succL (a b : ℕ) : List ℕ :=
  ((List.range 256).filter (fun c => kap b c != 0 && Qb a b c)).map (kap b)

def K1 : Bool := (List.range 256).all fun a => (List.range 256).all fun b =>
  (Pb a b == (kap a b != 0)) && decide (kap a b < 497)

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem K1_ok : K1 = true := by decide +kernel

theorem K1_spec (a b : ℕ) (ha : a < 256) (hb : b < 256) :
    (Pb a b = true ↔ kap a b ≠ 0) ∧ kap a b < 497 := by
  have h := K1_ok
  unfold K1 at h
  rw [List.all_eq_true] at h
  have h2 := h a (List.mem_range.2 ha)
  rw [List.all_eq_true] at h2
  have h3 := h2 b (List.mem_range.2 hb)
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h3
  refine ⟨?_, h3.2⟩
  rw [h3.1]
  simp

def K2 (lo len : ℕ) : Bool := (List.range' lo len).all fun a => (List.range 256).all fun b =>
  !(Pb a b) || (List.insertionSort (· ≤ ·) (succL a b) == rows.getD (kap a b) [])

