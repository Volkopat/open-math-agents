import OMAStatements.S_mo_460893
import Mathlib

/-! Credit: @caa1982 for the original cyclotomic counterexample. -/

open OMA.S_mo_460893

open IntermediateField Complex

/-- The real numbers as an intermediate field of `ℂ / ℚ`. -/
noncomputable def Rq : IntermediateField ℚ ℂ := (⊥ : IntermediateField ℝ ℂ).restrictScalars ℚ

lemma mem_Rq {z : ℂ} : z ∈ Rq ↔ ∃ r : ℝ, (r : ℂ) = z := by
  unfold Rq
  rw [mem_restrictScalars, IntermediateField.mem_bot]
  rfl

lemma im_of_mem_Rq {z : ℂ} (h : z ∈ Rq) : z.im = 0 := by
  obtain ⟨r, rfl⟩ := mem_Rq.mp h
  simp

/-- `e^{2iπ/m}` written as `exp ((2π/m) I)`. -/
lemma exp_form (m : ℕ) (hm : m ≠ 0) :
    Complex.exp (2 * Real.pi * Complex.I / (m : ℂ)) =
      Complex.exp (((2 * Real.pi / m : ℝ) : ℂ) * Complex.I) := by
  congr 1
  push_cast
  field_simp

lemma im_exp (m : ℕ) (hm : m ≠ 0) :
    (Complex.exp (2 * Real.pi * Complex.I / (m : ℂ))).im = Real.sin (2 * Real.pi / m) := by
  rw [exp_form m hm, Complex.exp_ofReal_mul_I_im]

lemma finrank_two (m : ℕ) (hm : 0 < m) (ht : m.totient = 2) :
    Module.finrank ℚ (ℚ⟮Complex.exp (2 * Real.pi * Complex.I / (m : ℂ))⟯) = 2 := by
  have hz := Complex.isPrimitiveRoot_exp m hm.ne'
  rw [IntermediateField.adjoin.finrank (hz.isIntegral hm).tower_top,
    ← Polynomial.cyclotomic_eq_minpoly_rat hz hm, Polynomial.natDegree_cyclotomic, ht]

/-- A degree two subfield generated by a non-real number meets the reals in `ℚ`. -/
lemma inf_Rq_bot (z : ℂ) (h2 : Module.finrank ℚ (ℚ⟮z⟯) = 2) (hz : z.im ≠ 0) :
    Rq ⊓ ℚ⟮z⟯ = ⊥ := by
  have hfd : FiniteDimensional ℚ (ℚ⟮z⟯) := Module.finite_of_finrank_eq_succ h2
  have hdvd := IntermediateField.finrank_dvd_of_le_right (inf_le_right : Rq ⊓ ℚ⟮z⟯ ≤ ℚ⟮z⟯)
  rw [h2] at hdvd
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h1
  · exact IntermediateField.finrank_eq_one_iff.mp h1
  · exfalso
    have heq := IntermediateField.eq_of_le_of_finrank_eq inf_le_right (h1.trans h2.symm)
    have hzm : z ∈ Rq ⊓ ℚ⟮z⟯ := by rw [heq]; exact mem_adjoin_simple_self ℚ z
    exact hz (im_of_mem_Rq ((inf_le_left : Rq ⊓ ℚ⟮z⟯ ≤ Rq) hzm))

theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_460893.main) := by
  intro h
  set A : IntermediateField ℚ ℂ := ℚ⟮((Real.sqrt 3 : ℝ) : ℂ)⟯ with hA
  have hAR : A ≤ Rq := by
    rw [hA, adjoin_simple_le_iff]
    exact mem_Rq.mpr ⟨_, rfl⟩
  -- the twelfth root of unity
  set ζ := Complex.exp (2 * Real.pi * Complex.I / ((3 ^ 1 * 4 : ℕ) : ℂ)) with hζ
  have hsqrt : ((Real.sqrt 3 : ℝ) : ℂ) = ζ + ζ⁻¹ := by
    have e1 : ζ = Complex.exp (((Real.pi / 6 : ℝ) : ℂ) * Complex.I) := by
      rw [hζ]; congr 1; push_cast; field_simp; ring
    have e2 : ζ⁻¹ = Complex.exp (-((Real.pi / 6 : ℝ) : ℂ) * Complex.I) := by
      rw [e1, ← Complex.exp_neg]; congr 1; ring
    rw [e2, e1, ← Complex.two_cos, ← Complex.ofReal_cos, Real.cos_pi_div_six]
    push_cast
    ring
  have hAK : A ≤ ℚ⟮ζ⟯ := by
    rw [hA, adjoin_simple_le_iff, hsqrt]
    exact add_mem (mem_adjoin_simple_self ℚ ζ) (inv_mem (mem_adjoin_simple_self ℚ ζ))
  have key := h 3 1 4 Nat.prime_three le_rfl (by norm_num) (by norm_num) A hAK
  -- the two cyclotomic subfields meet the reals in ℚ
  have hE : Rq ⊓ ℚ⟮Complex.exp (2 * Real.pi * Complex.I / ((3 ^ 1 : ℕ) : ℂ))⟯ = ⊥ := by
    apply inf_Rq_bot
    · exact finrank_two (3 ^ 1) (by norm_num) (by decide)
    · rw [im_exp _ (by norm_num)]
      apply ne_of_gt
      apply Real.sin_pos_of_pos_of_lt_pi
      · positivity
      · have : (2 : ℝ) * Real.pi / ((3 ^ 1 : ℕ) : ℝ) = 2 / 3 * Real.pi := by push_cast; ring
        rw [this]; nlinarith [Real.pi_pos]
  have hF : Rq ⊓ ℚ⟮Complex.exp (2 * Real.pi * Complex.I / ((4 : ℕ) : ℂ))⟯ = ⊥ := by
    apply inf_Rq_bot
    · exact finrank_two 4 (by norm_num) (by decide)
    · rw [im_exp _ (by norm_num)]
      apply ne_of_gt
      apply Real.sin_pos_of_pos_of_lt_pi
      · positivity
      · have : (2 : ℝ) * Real.pi / ((4 : ℕ) : ℝ) = 1 / 2 * Real.pi := by push_cast; ring
        rw [this]; nlinarith [Real.pi_pos]
  have hle : A ≤ ⊥ := by
    rw [key]
    apply sup_le
    · rw [← hE]; exact inf_le_inf_right _ hAR
    · rw [← hF]; exact inf_le_inf_right _ hAR
  have hmem : ((Real.sqrt 3 : ℝ) : ℂ) ∈ (⊥ : IntermediateField ℚ ℂ) :=
    hle (mem_adjoin_simple_self ℚ _)
  rw [IntermediateField.mem_bot] at hmem
  obtain ⟨q, hq⟩ := hmem
  have hq' : ((q : ℝ) : ℂ) = ((Real.sqrt 3 : ℝ) : ℂ) := by
    rw [← hq]; simp
  have hq'' : (q : ℝ) = Real.sqrt 3 := Complex.ofReal_injective hq'
  have hirr : Irrational (Real.sqrt 3) := by
    have := Nat.prime_three.irrational_sqrt
    simpa using this
  exact hirr ⟨q, hq''⟩
