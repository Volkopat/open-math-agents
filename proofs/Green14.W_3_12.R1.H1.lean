import OMAReductions.R_Green14_W_3_12_R1
-- This step is byte-for-byte the same proposition as the already proved step Green14.W_3_12.R2.H1; the proof below is that proof, retargeted to this reduction.


/-! The finite search checker is adapted from @VinnyMo’s Green14.W_3_11.R1.H2 proof
(commit 824077b4). The search data below are for the 135 positions of W(3,12).
A red point has color false. In a counterexample every 12-term progression
contains a red point, and no three red points form a progression. -/

namespace OMA.Progressions

def removeMask (allowed bad : Nat) := allowed ^^^ (allowed &&& bad)

structure Shadows where
  twice : Nat
  reverse : Nat
  even : Nat
  odd : Nat

def addShadow (p : Nat) (s : Shadows) : Shadows :=
  ⟨s.twice ||| (1 <<< (2*p)), s.reverse ||| (if p ≤ 255 then 1 <<< (255-p) else 0),
   s.even ||| (if p%2=0 then 1 <<< (p/2) else 0),
   s.odd ||| (if p%2=1 then 1 <<< (p/2) else 0)⟩

def shadows (rs : List Nat) := rs.foldr addShadow ⟨0,0,0,0⟩

def shadowMask (s : Shadows) (p : Nat) :=
  removeMask ((s.twice >>> p) ||| ((s.reverse <<< (2*p)) >>> 255) |||
    (if p%2=0 then s.even <<< (p/2) else s.odd <<< (p/2+1))) (1 <<< p)

def bluePattern (a d : Nat) : Nat :=
  (List.range 12).foldr (fun t m => (1 <<< (a+t*d)) ||| m) 0

-- Each chunk is a little-endian stream of two-bit search hints and eight-bit split positions.
def decode (i : Nat) : Nat := (i >>> 2) &&& 255

structure Catalog where
  size : Nat
  mask : Nat → Nat

def fullMask : Nat := 2^135-1

def runs12 (m d : Nat) : Nat :=
  let r2 := m &&& (m >>> d)
  let r4 := r2 &&& (r2 >>> (2*d))
  let r8 := r4 &&& (r4 >>> (4*d))
  r8 &&& (r4 >>> (8*d))

-- Search only suggests a progression index. The checker independently tests
-- its allowed positions, so the correctness proof needs no search heuristic.
def firstRun (blue : Nat) : Nat → Nat → Option Nat
  | 0, _ => none
  | n+1, d =>
    let z := runs12 blue d
    if z == 0 then firstRun blue n (d+1)
    else some ((d-1)*135 + (z ^^^ (z-1)).log2)

def firstUnit (blue nonred : Nat) : Nat → Nat → Option Nat
  | 0, _ => none
  | n+1, d =>
    let r2 := blue &&& (blue >>> d)
    let e2 := (blue &&& (nonred >>> d)) ||| (nonred &&& (blue >>> d))
    let r4 := r2 &&& (r2 >>> (2*d))
    let e4 := (e2 &&& (r2 >>> (2*d))) ||| (r2 &&& (e2 >>> (2*d)))
    let r8 := r4 &&& (r4 >>> (4*d))
    let e8 := (e4 &&& (r4 >>> (4*d))) ||| (r4 &&& (e4 >>> (4*d)))
    let hits := (e8 &&& (r4 >>> (8*d))) ||| (r8 &&& (e4 >>> (8*d)))
    if hits == 0 then firstUnit blue nonred n (d+1)
    else some ((d-1)*135 + (hits ^^^ (hits-1)).log2)

def redBits (rs : List Nat) : Nat := rs.foldr (fun p m => (1 <<< p) ||| m) 0

def NoTriple (R : ℕ → Prop) := ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

lemma remove_safe {a b t : ℕ} (ha : a.testBit t = true) (hb : b.testBit t = false) :
    (removeMask a b).testBit t = true := by simp [removeMask, Nat.testBit_xor, ha, hb]

structure Represents (R : Nat → Prop) (s : Shadows) : Prop where
  twice : ∀ t, s.twice.testBit t = true → ∃ q, t=2*q ∧ R q
  reverse : ∀ t, s.reverse.testBit t = true → ∃ q, q≤255 ∧ t=255-q ∧ R q
  even : ∀ t, s.even.testBit t = true → R (2*t)
  odd : ∀ t, s.odd.testBit t = true → R (2*t+1)

lemma add_rep {R : Nat → Prop} {s : Shadows} (h : Represents R s) {p : ℕ} (hp : R p) :
    Represents R (addShadow p s) := by
  constructor
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.twice t ht
    · have e : 2*p=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
      exact ⟨p,e.symm,hp⟩
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.reverse t ht
    · split at ht
      · rename_i hb
        have e : 255-p=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
        exact ⟨p,hb,e.symm,hp⟩
      · simp at ht
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.even t ht
    · split at ht
      · rename_i hb
        have e : p/2=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
        rwa [show 2*t=p by omega]
      · simp at ht
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.odd t ht
    · split at ht
      · rename_i hb
        have e : p/2=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
        rwa [show 2*t+1=p by omega]
      · simp at ht

lemma shadows_rep {R : Nat → Prop} {rs : List Nat} (hr : ∀ x ∈ rs, R x) :
    Represents R (shadows rs) := by
  induction rs with
  | nil => constructor <;> simp [shadows]
  | cons p rs ih =>
    exact add_rep (ih fun x hx => hr x (by simp [hx])) (hr p (by simp))

lemma no_midpoint {R : Nat → Prop} (h : NoTriple R) {a m b : ℕ}
    (ha : R a) (hm : R m) (hb : R b) (he : a+b=2*m) (hne : a≠b) : False := by
  by_cases hh : a < b
  · exact h a (m-a) (by omega) ha (by rwa [show a+(m-a)=m by omega])
      (by rwa [show a+2*(m-a)=b by omega])
  · exact h b (m-b) (by omega) hb (by rwa [show b+(m-b)=m by omega])
      (by rwa [show b+2*(m-b)=a by omega])

lemma shadow_safe {R : Nat → Prop} {s : Shadows} (hs : Represents R s) (hn : NoTriple R)
    {p t : Nat} (hp : R p) (ht : R t) : (shadowMask s p).testBit t = false := by
  by_cases e : p=t
  · simp [shadowMask,removeMask,Nat.testBit_xor,Nat.shiftLeft_eq,Nat.testBit_two_pow,e]
  have ep : (1 <<< p : Nat).testBit t = false := by simp [Nat.shiftLeft_eq,Nat.testBit_two_pow,e]
  simp only [shadowMask,removeMask,Nat.testBit_xor,Nat.testBit_and,ep,Bool.and_false,
    Bool.xor_false,Nat.testBit_or,Bool.or_eq_false_iff]
  refine ⟨⟨?_,?_⟩,?_⟩ <;> apply Bool.eq_false_iff.mpr <;> intro h
  · rw [Nat.testBit_shiftRight] at h
    obtain ⟨q,hq,hr⟩ := hs.twice _ h
    exact no_midpoint hn hp hr ht (by omega) e
  · rw [Nat.testBit_shiftRight, Nat.testBit_shiftLeft] at h
    simp only [Bool.and_eq_true,decide_eq_true_eq] at h
    obtain ⟨q,hb,hq,hr⟩ := hs.reverse _ h.2
    exact no_midpoint hn hr hp ht (by omega) (by omega)
  · split at h
    · rename_i hpar
      rw [Nat.testBit_shiftLeft] at h
      simp only [Bool.and_eq_true,decide_eq_true_eq] at h
      have hr := hs.even _ h.2
      exact no_midpoint hn hp ht hr (by omega) (by omega)
    · rename_i hpar
      rw [Nat.testBit_shiftLeft] at h
      simp only [Bool.and_eq_true,decide_eq_true_eq] at h
      have hr := hs.odd _ h.2
      exact no_midpoint hn hp ht hr (by omega) (by omega)

def Hits (R : ℕ → Prop) (patterns : Catalog) :=
  ∀ i, i < patterns.size → ∃ t, (patterns.mask i).testBit t = true ∧ R t

def Bad (patterns : Catalog) (seed : List ℕ × ℕ) :=
  ∀ R : ℕ → Prop, NoTriple R → Hits R patterns →
    (∀ x ∈ seed.1, R x) → (∀ x, R x → seed.2.testBit x = true) → False

abbrev Seed := List Nat × Nat

def gate (leaves : List Seed) (k : Nat) (red : List Nat) (a : Nat) : Bool :=
  match leaves[k]? with
  | some leaf => leaf == (red,a)
  | none => false

def AllBad (patterns : Catalog) : List Seed → Prop
  | [] => True
  | s::ss => Bad patterns s ∧ AllBad patterns ss

lemma gate_sound {patterns : Catalog} {leaves : List Seed}
    (rules : AllBad patterns leaves) {R : Nat → Prop} (hn : NoTriple R) (hit : Hits R patterns)
    (k : Nat) (rs : List Nat) (a : Nat) (hr : ∀ x ∈ rs, R x)
    (ha : ∀ x, R x → a.testBit x = true) : gate leaves k rs a ≠ true := by
  induction leaves generalizing k with
  | nil => simp [gate]
  | cons s ss ih =>
    cases k with
    | zero =>
      simp only [gate, List.getElem?_cons_zero]
      intro he
      have eq := beq_iff_eq.mp he
      subst s
      exact rules.1 R hn hit hr ha
    | succ k => exact ih rules.2 k

structure SearchState where
  red : List Nat
  allowed : Nat
  redMask : Nat
  shadow : Shadows

def SearchState.markRed (s : SearchState) (p : Nat) : SearchState :=
  ⟨p::s.red, removeMask s.allowed (shadowMask s.shadow p),
    s.redMask ||| (1 <<< p), addShadow p s.shadow⟩

def SearchState.markBlue (s : SearchState) (p : Nat) : SearchState :=
  { s with allowed := removeMask s.allowed (1 <<< p) }

structure Compatible (R : Nat → Prop) (s : SearchState) : Prop where
  shadow : Represents R s.shadow
  red : ∀ x ∈ s.red, R x
  allowed : ∀ x, R x → s.allowed.testBit x = true

lemma compatible_red {R : Nat → Prop} {s : SearchState} (hs : Compatible R s)
    (hn : NoTriple R) {p : Nat} (hp : R p) : Compatible R (s.markRed p) := by
  refine ⟨add_rep hs.shadow hp, ?_, ?_⟩
  · intro x hx
    rcases List.mem_cons.mp hx with rfl | h
    · exact hp
    · exact hs.red x h
  · intro x hx
    exact remove_safe (hs.allowed x hx) (shadow_safe hs.shadow hn hp hx)

lemma compatible_blue {R : Nat → Prop} {s : SearchState} (hs : Compatible R s)
    {p : Nat} (hp : ¬ R p) : Compatible R (s.markBlue p) := by
  refine ⟨hs.shadow, hs.red, ?_⟩
  intro x hx
  apply remove_safe (hs.allowed x hx)
  have e : p ≠ x := fun h => hp (h ▸ hx)
  simp [Nat.shiftLeft_eq, e]

def suggested (hint allowed red : Nat) : Option Nat :=
  if hint == 0 then none else
  let first := if hint == 1 then 1 else if hint == 2 then 4 else 7
  let count := if hint == 3 then 6 else 3
  let blue := fullMask ^^^ allowed
  match firstRun blue count first with
  | some i => some i
  | none => firstUnit blue (fullMask ^^^ red) count first

def children (stop : Nat → List Nat → Nat → Bool) (pats : Catalog) (bits : Nat)
    (s : SearchState) : Option (Nat × List SearchState) :=
  let z := decode bits
  let hint := bits &&& 3
  if (hint == 0 && 135 ≤ z) && stop (z-135) s.red s.allowed then some (bits >>> 10, []) else
  match suggested hint s.allowed s.redMask with
  | some ap =>
    if ap < pats.size then
      let rest := pats.mask ap &&& s.allowed
      if rest == 0 then some (bits >>> 2, []) else
      let p := rest.log2
      if rest == (1 <<< p) then some (bits >>> 2, [s.markRed p]) else none
    else none
  | none =>
    if 135 ≤ z then none else some (bits >>> 10, [s.markRed z, s.markBlue z])

def search (stop : Nat → List Nat → Nat → Bool) (pats : Catalog) :
    Nat → Nat → List SearchState → Bool
  | _, _, [] => true
  | 0, _, _::_ => false
  | gas+1, bits, s::stack =>
    match children stop pats bits s with
    | none => false
    | some (j, kids) => search stop pats gas j (kids ++ stack)

def Viable (R : Nat → Prop) (stack : List SearchState) := ∃ s ∈ stack, Compatible R s

lemma children_sound {pats : Catalog} {stop : Nat → List Nat → Nat → Bool} {R : Nat → Prop}
    (hst : ∀ k rs a, (∀ x ∈ rs, R x) → (∀ x, R x → a.testBit x = true) → stop k rs a ≠ true)
    (hn : NoTriple R) (hit : Hits R pats) {i j : Nat} {s : SearchState} {kids : List SearchState}
    (hs : Compatible R s) (he : children stop pats i s = some (j,kids)) : Viable R kids := by
  simp only [children] at he
  split at he
  · rename_i h
    exact (hst _ _ _ hs.red hs.allowed (Bool.and_eq_true_iff.mp h).2).elim
  split at he
  · rename_i ap hSuggest
    split at he
    · rename_i hin
      obtain ⟨t, hbit, ht⟩ := hit ap hin
      have hrest : (pats.mask ap &&& s.allowed).testBit t = true := by simp [hbit, hs.allowed t ht]
      split at he
      · rename_i e
        simp [beq_iff_eq.mp e] at hrest
      split at he
      · rename_i e
        let p := (pats.mask ap &&& s.allowed).log2
        have heq : t = p := by
          rw [beq_iff_eq.mp e, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hrest
          exact (of_decide_eq_true hrest).symm
        cases he
        exact ⟨s.markRed p, by simp [p], compatible_red hs hn (heq ▸ ht : R p)⟩
      · cases he
    · cases he
  · split at he
    · cases he
    · cases he
      by_cases hp : R (decode i)
      · exact ⟨s.markRed (decode i), by simp, compatible_red hs hn hp⟩
      · exact ⟨s.markBlue (decode i), by simp, compatible_blue hs hp⟩

lemma search_sound {pats : Catalog} {stop : Nat → List Nat → Nat → Bool} {R : Nat → Prop}
    (hst : ∀ k rs a, (∀ x ∈ rs, R x) → (∀ x, R x → a.testBit x = true) → stop k rs a ≠ true)
    (hn : NoTriple R) (hit : Hits R pats) (gas i : Nat) (stack : List SearchState)
    (hl : Viable R stack) : search stop pats gas i stack = false := by
  induction gas generalizing i stack with
  | zero =>
    rcases hl with ⟨s,hm,_⟩
    cases stack with
    | nil => simp at hm
    | cons => rfl
  | succ fuel ih =>
    rcases hl with ⟨v,hm,hv⟩
    cases stack with
    | nil => simp at hm
    | cons s stack =>
      simp only [search]
      split
      · rfl
      · rename_i j kids e
        apply ih
        rcases List.mem_cons.mp hm with rfl | h
        · obtain ⟨w, hw, hc⟩ := children_sound hst hn hit hv e
          exact ⟨w,List.mem_append_left _ hw,hc⟩
        · exact ⟨v,List.mem_append_right _ h,hv⟩

lemma bad_of_gated_check {tape : ℕ} {pats : Catalog} {gas : ℕ} {s : List ℕ × ℕ}
    (leaves : List Seed) (rules : AllBad pats leaves)
    (h : search (gate leaves) pats gas tape [⟨s.1, s.2, redBits s.1, shadows s.1⟩] = true) : Bad pats s := by
  intro R hn hit hr ha
  have he := search_sound (gate_sound rules hn hit) hn hit gas tape
    [⟨s.1,s.2,redBits s.1,shadows s.1⟩] ⟨⟨s.1,s.2,redBits s.1,shadows s.1⟩,List.mem_cons_self,⟨shadows_rep hr,hr,ha⟩⟩
  exact Bool.noConfusion (h.symm.trans he)


lemma pattern_has {t : ℕ} (ht : t < 12) (a d : ℕ) :
    (bluePattern a d).testBit (a+t*d) = true := by
  suffices ∀ xs : List ℕ, t ∈ xs → (xs.foldr (fun i m : ℕ => (1 <<< (a+i*d)) ||| m) 0).testBit (a+t*d) = true from
    this _ (List.mem_range.mpr ht)
  intro xs
  induction xs with
  | nil => simp
  | cons u xs ih =>
    intro hm
    rcases List.mem_cons.mp hm with rfl | h
    · simp [Nat.shiftLeft_eq, Nat.testBit_two_pow]
    · simp [ih h]


def baseMask (d : Nat) := if d = 0 then 1 else ((1 <<< (12*d))-1)/((1 <<< d)-1)

def pats : Catalog := ⟨1620, fun i =>
  let a := i%135
  let d := i/135+1
  if a+11*d < 135 then (baseMask d <<< a) else baseMask 1⟩

lemma base_correct : ∀ d : Fin 13, baseMask d.val = bluePattern 0 d.val := by decide +kernel

private def Mono135 (r : ℕ → Bool) : Prop :=
  ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 135 ∧
    ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b

private def Red135 (r : ℕ → Bool) (i : ℕ) := i < 135 ∧ r i = false

private lemma noTriple135 {r : ℕ → Bool} (h : ¬Mono135 r) : NoTriple (Red135 r) := by
  intro a d hd h₀ h₁ h₂
  apply h
  refine ⟨false, a, d, hd, h₂.1, ?_⟩
  intro t ht
  change t ≤ 2 at ht
  interval_cases t
  · simpa using h₀.2
  · simpa using h₁.2
  · simpa using h₂.2

private lemma shifted_hit135 {r : ℕ → Bool} (h : ¬Mono135 r) {a d : ℕ}
    (hd : 0 < d) (hb : a+11*d < 135) :
    ∃ x, ((baseMask d) <<< a).testBit x = true ∧ Red135 r x := by
  by_contra! bad
  apply h
  refine ⟨true, a, d, hd, hb, ?_⟩
  intro t ht
  change t ≤ 11 at ht
  have hx : a+t*d < 135 := by have := Nat.mul_le_mul_right d ht; omega
  have hbit : ((baseMask d) <<< a).testBit (a+t*d) = true := by
    rw [base_correct ⟨d, by omega⟩]
    simpa [Nat.testBit_shiftLeft, Nat.le_add_right] using pattern_has (by omega : t < 12) 0 d
  have hh := bad _ hbit
  cases e : r (a+t*d) with
  | false => exact (hh ⟨hx,e⟩).elim
  | true => rfl

private lemma all_hit135 {r : ℕ → Bool} (h : ¬Mono135 r) : Hits (Red135 r) pats := by
  intro i hi
  dsimp only [pats]
  split
  · exact shifted_hit135 h (by omega) (by assumption)
  · simpa using shifted_hit135 h (a:=0) (d:=1) (by decide) (by decide)


private theorem fromTape (bits : Nat) {s : Seed} (leaves : List Seed)
    (h : search (gate leaves) pats 4096 bits [⟨s.1,s.2,redBits s.1,shadows s.1⟩] = true)
    (rules : AllBad pats leaves) : Bad pats s := bad_of_gated_check leaves rules h

