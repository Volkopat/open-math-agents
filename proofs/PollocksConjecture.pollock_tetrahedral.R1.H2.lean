import OMAReductions.R_PollocksConjecture_pollock_tetrahedral_R1
import Mathlib

/-!
Every `n ≤ 343867` is a sum of five tetrahedral numbers, by a kernel computation.

`B4` is a bitset of sums of four tetrahedral numbers `T a + T b + T c + T d` (`a, b, c, d < 54`),
built as `B2 <<< x` over all sums of two `x`, where `B2` is the bitset of sums of two. For each `n`
we take tetrahedral numbers `T k ≤ n` from a starting index downwards until `n - T k` is a bit of `B4`.
The soundness lemmas read the folds back into explicit sums.
-/

namespace OMA.Pollock
open PollocksConjecture

def L1 : List ℕ := (List.range 54).map tetrahedral
def L2 : List ℕ := L1.flatMap (fun a => L1.map (fun b => a + b))
def B2 : ℕ := L2.foldl (fun acc x => acc ||| (1 <<< x)) 0
def B4 : ℕ := L2.foldl (fun acc x => acc ||| (B2 <<< x)) 0
def B4lit : ℕ := 

theorem B4_eq : B4 = B4lit := by decide +kernel

def check (n : ℕ) : ℕ → Bool
  | 0 => B4lit.testBit n
  | k + 1 => (decide (tetrahedral (k + 1) ≤ n) && B4lit.testBit (n - tetrahedral (k + 1))) || check n k

def allRange (lo k : ℕ) : ℕ → Bool
  | 0 => true
  | m + 1 => check (lo + m) k && allRange lo k m

def fit (n : ℕ) : ℕ → ℕ → ℕ
  | k, 0 => k
  | k, f + 1 => if tetrahedral k ≤ n then k else fit n (k - 1) f

def CL : ℕ := 1000
def kst (j : ℕ) : ℕ := fit ((j + 1) * CL) 127 130

def allChunks : ℕ → Bool
  | 0 => true
  | j + 1 => allRange (j * CL) (kst j) CL && allChunks j

lemma fold_bit (L : List ℕ) (g : ℕ → ℕ) (acc r : ℕ)
    (h : (L.foldl (fun a x => a ||| g x) acc).testBit r = true) :
    acc.testBit r = true ∨ ∃ x ∈ L, (g x).testBit r = true := by
  induction L generalizing acc with
  | nil => left; simpa using h
  | cons y L ih =>
    simp only [List.foldl_cons] at h
    rcases ih _ h with h1 | ⟨x, hx, h2⟩
    · rw [Nat.testBit_or, Bool.or_eq_true] at h1
      rcases h1 with h1 | h1
      · exact Or.inl h1
      · exact Or.inr ⟨y, List.mem_cons_self .., h1⟩
    · exact Or.inr ⟨x, List.mem_cons_of_mem _ hx, h2⟩

lemma mem_L2 {x : ℕ} (h : x ∈ L2) : ∃ a b, x = tetrahedral a + tetrahedral b := by
  simp only [L2, L1, List.mem_flatMap, List.mem_map] at h
  obtain ⟨_, ⟨a, -, rfl⟩, _, ⟨b, -, rfl⟩, rfl⟩ := h
  exact ⟨a, b, rfl⟩

lemma B2_bit {r : ℕ} (h : B2.testBit r = true) : ∃ a b, r = tetrahedral a + tetrahedral b := by
  rcases fold_bit L2 (fun x => 1 <<< x) 0 r h with h | ⟨x, hx, h⟩
  · simp at h
  · rw [Nat.testBit_shiftLeft] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, Nat.testBit_one_eq_true_iff_self_eq_zero] at h
    obtain ⟨h1, h2⟩ := h
    have : r = x := by omega
    subst this
    exact mem_L2 hx

lemma B4_bit {r : ℕ} (h : B4.testBit r = true) :
    ∃ a b c d, r = tetrahedral a + tetrahedral b + (tetrahedral c + tetrahedral d) := by
  rcases fold_bit L2 (fun x => B2 <<< x) 0 r h with h | ⟨x, hx, h⟩
  · simp at h
  · rw [Nat.testBit_shiftLeft] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨h1, h2⟩ := h
    obtain ⟨a, b, hab⟩ := mem_L2 hx
    obtain ⟨c, d, hcd⟩ := B2_bit h2
    exact ⟨a, b, c, d, by omega⟩

lemma check_sound (n : ℕ) : ∀ k, check n k = true →
    ∃ f : Fin 5 → ℕ, n = ∑ i, tetrahedral (f i) := by
  intro k
  induction k with
  | zero =>
    intro h
    simp only [check] at h
    rw [← B4_eq] at h
    obtain ⟨a, b, c, d, h⟩ := B4_bit h
    refine ⟨![0, a, b, c, d], ?_⟩
    simp [Fin.sum_univ_five, tetrahedral] at *
    omega
  | succ k ih =>
    intro h
    simp only [check, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
    rcases h with ⟨h1, h2⟩ | h
    · rw [← B4_eq] at h2
      obtain ⟨a, b, c, d, h⟩ := B4_bit h2
      refine ⟨![k + 1, a, b, c, d], ?_⟩
      simp [Fin.sum_univ_five]
      omega
    · exact ih h

lemma allRange_sound (lo k : ℕ) : ∀ m, allRange lo k m = true → ∀ i < m, check (lo + i) k = true := by
  intro m
  induction m with
  | zero => intro _ i hi; omega
  | succ m ih =>
    intro h i hi
    simp only [allRange, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact ih h.2 i hi
    · exact h.1

lemma allChunks_sound : ∀ J, allChunks J = true → ∀ j < J, allRange (j * CL) (kst j) CL = true := by
  intro J
  induction J with
  | zero => intro _ j hj; omega
  | succ J ih =>
    intro h j hj
    simp only [allChunks, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
    · exact ih h.2 j hj
    · exact h.1

set_option maxRecDepth 100000 in
theorem chunks_ok : allChunks 344 = true := by decide +kernel

theorem pollock_le (n : ℕ) (hn : n ≤ 343867) : ∃ f : Fin 5 → ℕ, n = ∑ i, tetrahedral (f i) := by
  have hj : n / CL < 344 := by simp only [CL]; omega
  have h1 := allChunks_sound 344 chunks_ok (n / CL) hj
  have h2 := allRange_sound _ _ CL h1 (n % CL) (Nat.mod_lt _ (by simp [CL]))
  rw [Nat.div_add_mod'] at h2
  exact check_sound n _ h2

end OMA.Pollock

theorem OMA.solution : OMA.R_PollocksConjecture_pollock_tetrahedral_R1.H2 :=
  fun n hn => OMA.Pollock.pollock_le n hn
