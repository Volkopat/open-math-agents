private theorem lineBit {d : Nat} (hd : 0 < d) (hd' : d ≤ 13) {t : Nat} (ht : t ≤ 12) (a : Nat) :
    (bases[d-1]! <<< (5*a)).testBit (5*(a+t*d)) = true := by
  simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
    base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩

