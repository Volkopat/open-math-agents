  have hm3' : 100 * m ^ 2 ≤ m ^ 3 := by
    have := Nat.mul_le_mul_right (m ^ 2) hm
    rw [show m * m ^ 2 = m ^ 3 by ring] at this
    exact this
  have hexp : 27 + 27 * (P + T3) + 9 * m ^ 2 ≤ 2 * m ^ 3 := by linarith
  refine le_trans (Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (Nat.mul_le_mul_left 2 hN2) 27)) ?_
  calc (2 * 2 ^ (P + T3)) ^ 27 * 2 ^ (9 * m ^ 2)
