/-- Walk counts by class; coordinate 128 at time n+1 is the number of admissible walks with n+1 states. -/
def V : ℕ → ℕ → ℕ
  | 0, j => L0.getD j 0
  | n + 1, i => ∑ j ∈ Finset.range 129, MX i j * V n j

theorem V_succ (n i : ℕ) : V (n + 1) i = ∑ j ∈ Finset.range 129, MX i j * V n j := rfl

theorem base_ok : ∀ i < 729, (if ok (dec i) then 1 else 0) = L0.getD (clsN i) 0 := by decide +kernel

theorem hashS' (s : R) :
    (∑ t ∈ Finset.range 729, if ok s ∧ compat s (dec t) then 1024 ^ clsN t else 0) =
      ∑ j ∈ Finset.range 129, MX (cls s) j * 1024 ^ j := by
  have h := hashS (enc s) (enc_lt s)
  unfold HashP at h
  rw [dec_enc, HX_sum] at h
  exact h

theorem F_eq (n : ℕ) : ∀ s : R, F n s = V n (cls s) := by
  induction n with
  | zero =>
    intro s
    rw [F_zero]
    have h := base_ok (enc s) (enc_lt s)
    rw [dec_enc] at h
    exact h
  | succ n ih =>
    intro s
    rw [F_succ, V_succ]
    simp only [ih]
    rw [sum_cls (fun t => ok s ∧ compat s t) (V n)]
    apply Finset.sum_congr rfl
    intro j hj
    rw [counts_of_hash (fun t => ok s ∧ compat s t) (cls s) (hashS' s) (fun j _ => MX_lt _ j) j
      (Finset.mem_range.mp hj)]

theorem count_walks (n : ℕ) :
    Nat.card {y : Fin (n + 1) → R // Walk y ∧ Init (y 0)} = V (n + 1) 128 := by
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]
  have h1 : (∑ x : Fin (n + 1) → R, if Walk x ∧ Init (x 0) then 1 else 0) =
      ∑ s : R, if Init s then F n s else 0 := by
    unfold F
    have h2 : ∀ s : R, (if Init s then
        (∑ y : Fin (n + 1) → R, if Walk y ∧ y 0 = s then 1 else 0) else 0) =
        ∑ y : Fin (n + 1) → R, if y 0 = s then (if Walk y ∧ Init (y 0) then 1 else 0) else 0 := by
      intro s
      by_cases hs : Init s
      · rw [if_pos hs]
        apply Finset.sum_congr rfl
        intro y _
        by_cases hy : y 0 = s
        · subst hy
          rw [if_pos rfl]
          exact if_congr ⟨fun h => ⟨h.1, hs⟩, fun h => ⟨h.1, rfl⟩⟩ rfl rfl
        · rw [if_neg hy, if_neg (show ¬(Walk y ∧ y 0 = s) from fun h => hy h.2)]
      · rw [if_neg hs]
        symm
        apply Finset.sum_eq_zero
        intro y _
        by_cases hy : y 0 = s
        · subst hy
          rw [if_pos rfl, if_neg (fun h => hs h.2)]
        · rw [if_neg hy]
    rw [Finset.sum_congr rfl (fun s _ => h2 s), Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro y _
    rw [Finset.sum_ite_eq, if_pos (Finset.mem_univ _)]
  rw [h1]
  simp only [F_eq]
  rw [sum_cls Init (V n), V_succ]
  apply Finset.sum_congr rfl
  intro j hj
  rw [counts_of_hash Init 128 hashI (fun j _ => MX_lt _ j) j (Finset.mem_range.mp hj)]

theorem V_step (n : ℕ) (L L' : List ℕ) (hL : L.length ≤ 129) (h : ∀ j < 129, V n j = L.getD j 0)
