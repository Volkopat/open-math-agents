  exact if h0 : i < 72 then hashG_0 i h0 hlo else if h1 : i < 144 then hashG_1 i h1 (Nat.le_of_not_lt h0) else if h2 : i < 216 then hashG_2 i h2 (Nat.le_of_not_lt h1) else if h3 : i < 288 then hashG_3 i h3 (Nat.le_of_not_lt h2) else if h4 : i < 360 then hashG_4 i h4 (Nat.le_of_not_lt h3) else if h5 : i < 432 then hashG_5 i h5 (Nat.le_of_not_lt h4) else if h6 : i < 504 then hashG_6 i h6 (Nat.le_of_not_lt h5) else if h7 : i < 576 then hashG_7 i h7 (Nat.le_of_not_lt h6) else if h8 : i < 648 then hashG_8 i h8 (Nat.le_of_not_lt h7) else if h9 : i < 720 then hashG_9 i h9 (Nat.le_of_not_lt h8) else hashG_10 i hi (Nat.le_of_not_lt h9)

theorem hashI0 :
    (∑ t ∈ Finset.range 729, if Init (dec t) then 1024 ^ clsN t else 0) = HXL.getD 128 0 := by
  decide +kernel

theorem hashI :
    (∑ t ∈ Finset.range 729, if Init (dec t) then 1024 ^ clsN t else 0) =
      ∑ j ∈ Finset.range 129, MX 128 j * 1024 ^ j := by
  rw [hashI0, HX_sum]

theorem digits_unique (B : ℕ) (hB : 0 < B) : ∀ (c : ℕ) (n m : ℕ → ℕ), (∀ j < c, n j < B) →
    (∀ j < c, m j < B) →
    ∑ j ∈ Finset.range c, n j * B ^ j = ∑ j ∈ Finset.range c, m j * B ^ j → ∀ j < c, n j = m j := by
  intro c
  induction c with
  | zero => intro n m _ _ _ j hj; omega
  | succ c ih =>
    intro n m hn hm h j hj
    rw [Finset.sum_range_succ', Finset.sum_range_succ'] at h
    simp only [pow_zero, mul_one, pow_succ] at h
    have e1 : ∀ f : ℕ → ℕ, ∑ k ∈ Finset.range c, f (k + 1) * (B ^ k * B) =
        B * ∑ k ∈ Finset.range c, f (k + 1) * B ^ k := by
      intro f
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun k _ => by ring)
    rw [e1 n, e1 m] at h
    have h0 : n 0 = m 0 := by
      have h' := congrArg (fun z => z % B) h
      simp only [Nat.mul_add_mod] at h'
      rwa [Nat.mod_eq_of_lt (hn 0 (by omega)), Nat.mod_eq_of_lt (hm 0 (by omega))] at h'
    have h1 : ∑ k ∈ Finset.range c, n (k + 1) * B ^ k = ∑ k ∈ Finset.range c, m (k + 1) * B ^ k := by
      rw [h0] at h
      exact Nat.eq_of_mul_eq_mul_left hB (Nat.add_right_cancel h)
    rcases j with _ | j
    · exact h0
    · exact ih (fun k => n (k + 1)) (fun k => m (k + 1)) (fun k hk => hn (k + 1) (by omega))
        (fun k hk => hm (k + 1) (by omega)) h1 j (by omega)

theorem sum_cls (P : R → Prop) [DecidablePred P] (f : ℕ → ℕ) :
    (∑ t : R, if P t then f (cls t) else 0) =
      ∑ j ∈ Finset.range 129, (Finset.univ.filter (fun t : R => P t ∧ cls t = j)).card * f j := by
  have h : ∀ j, (Finset.univ.filter (fun t : R => P t ∧ cls t = j)).card * f j =
      ∑ t : R, if P t ∧ cls t = j then f j else 0 := by
    intro j
    rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, smul_eq_mul]
  rw [Finset.sum_congr rfl (fun j _ => h j), Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro t _
  by_cases hP : P t
  · simp only [hP, true_and, if_true]
    rw [Finset.sum_ite_eq (Finset.range 129) (cls t) f, if_pos (Finset.mem_range.mpr (cls_lt t))]
  · simp [hP]

theorem card_lt (P : R → Prop) [DecidablePred P] : (Finset.univ.filter P).card < 1024 := by
  have h1 : (Finset.univ.filter P).card ≤ (Finset.univ : Finset R).card := Finset.card_filter_le _ _
  have h2 : (Finset.univ : Finset R).card = 729 := by
    rw [Finset.card_eq_sum_ones, sum_R]
    simp
  omega

/-- From the base 1024 encoding to the class counts. -/
theorem counts_of_hash (P : R → Prop) [DecidablePred P] (k : ℕ)
    (h : (∑ t ∈ Finset.range 729, if P (dec t) then 1024 ^ clsN t else 0) =
      ∑ j ∈ Finset.range 129, MX k j * 1024 ^ j)
    (hk : ∀ j < 129, MX k j < 1024) :
    ∀ j < 129, (Finset.univ.filter (fun t : R => P t ∧ cls t = j)).card = MX k j := by
  have e : (∑ t : R, if P t then 1024 ^ cls t else 0) =
      ∑ j ∈ Finset.range 129, (Finset.univ.filter (fun t : R => P t ∧ cls t = j)).card * 1024 ^ j :=
    sum_cls P (fun j => 1024 ^ j)
  refine digits_unique 1024 (by norm_num) 129
    (fun j => (Finset.univ.filter (fun t : R => P t ∧ cls t = j)).card) (fun j => MX k j)
    (fun j _ => card_lt _) hk ?_
  rw [← e, sum_R, ← h]
  apply Finset.sum_congr rfl
  intro t ht
  unfold cls
  rw [enc_dec t (Finset.mem_range.mp ht)]

