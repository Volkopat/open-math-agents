lemma goal {L : SimpleGraph (Fin 8)} (h3 : L.CliqueFree 3) (h5 : Lᶜ.CliqueFree 5) : Goal L := by
  have q8 : ∀ r ∈ reps8, Emb L 8 r → Goal L := fun r hr => by
    simp [reps8] at hr
  have q7 := level h3 h5 (by norm_num) ok7 q8
  have q6 := level h3 h5 (by norm_num) ok6 q7
  have q5 := level h3 h5 (by norm_num) ok5 q6
  have q4 := level h3 h5 (by norm_num) ok4 q5
  have q3 := level h3 h5 (by norm_num) ok3 q4
  have q2 := level h3 h5 (by norm_num) ok2 q3
  have q1 := level h3 h5 (by norm_num) ok1 q2
  have q0 := level h3 h5 (by norm_num) ok0 q1
  exact q0 0 (by simp [reps0]) ⟨Fin.elim0, fun a => Fin.elim0 a, fun i => Fin.elim0 i⟩

end RamseyGlueCover

open RamseyGlueCover in
theorem OMA.solution : OMA.R_RamseyNumbers_ramsey_number_four_five_R1_H1_R1_H2_R1.H1 := by
  intro L h3 h5
  obtain ⟨p, hp, e, einj, he⟩ := goal h3 h5
  refine ⟨p, hp, ⟨e, einj⟩, fun i j hij => ?_⟩
  change L.Adj (e i) (e j) ↔ _
  rw [he i j hij]
  unfold edge
  rw [idx_lt (show i.val < j.val from hij)]
