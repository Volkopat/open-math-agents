def idx (i j : ℕ) : ℕ := max i j * (max i j - 1) / 2 + min i j

def edge (g i j : ℕ) : Bool := g.testBit (idx i j)

def pairsAll (m : ℕ) (f : ℕ → ℕ → Bool) : Bool :=
  (List.range m).all fun j => (List.range j).all fun i => f i j

def okSel (k : ℕ) (σ : List ℕ) (m : ℕ) : Bool :=
  (σ.length == m) && σ.all (fun v => decide (v < k)) && decide σ.Nodup

def same (g h m : ℕ) (σ : List ℕ) : Bool :=
  pairsAll m fun i j => edge g (σ.getD i 0) (σ.getD j 0) == edge h i j

def okEntry (k g : ℕ) (next : List ℕ) (c : ℕ × ℕ × List ℕ) : Bool :=
  match c.1 with
  | 0 => okSel (k + 1) c.2.2 3 &&
      pairsAll 3 (fun i j => edge g (c.2.2.getD i 0) (c.2.2.getD j 0))
  | 1 => okSel (k + 1) c.2.2 5 &&
      pairsAll 5 (fun i j => !edge g (c.2.2.getD i 0) (c.2.2.getD j 0))
  | 2 =>
      match pats[c.2.1]? with
      | some p => okSel (k + 1) c.2.2 p.1 && same g p.2 p.1 c.2.2
      | none => false
  | _ =>
      match next[c.2.1]? with
      | some h => okSel (k + 1) c.2.2 (k + 1) && same g h (k + 1) c.2.2
      | none => false

def okRow (k r : ℕ) (next : List ℕ) (row : List (ℕ × ℕ × List ℕ)) : Bool :=
  (List.range (2 ^ k)).all fun N =>
    match row[N]? with
    | some c => okEntry k (r ||| (N <<< (k * (k - 1) / 2))) next c
    | none => false

def okLevel (k : ℕ) (cur next : List ℕ) (cert : List (List (ℕ × ℕ × List ℕ))) : Bool :=
  cur.all (fun r => decide (r < 2 ^ (k * (k - 1) / 2))) &&
  (List.range cur.length).all fun a =>
    match cur[a]?, cert[a]? with
    | some r, some row => okRow k r next row
    | _, _ => false

def Emb (L : SimpleGraph (Fin 8)) (m h : ℕ) : Prop :=
  ∃ e : Fin m → Fin 8, Function.Injective e ∧
    ∀ i j : Fin m, i < j → (L.Adj (e i) (e j) ↔ edge h i.val j.val = true)

lemma idx_lt {i j : ℕ} (h : i < j) : idx i j = j * (j - 1) / 2 + i := by
  unfold idx
  rw [max_eq_right h.le, min_eq_left h.le]

lemma idx_comm (i j : ℕ) : idx i j = idx j i := by
  unfold idx
  rw [max_comm, min_comm]

lemma emb_adj {L : SimpleGraph (Fin 8)} {m h : ℕ} {e : Fin m → Fin 8}
    (he : ∀ i j : Fin m, i < j → (L.Adj (e i) (e j) ↔ edge h i.val j.val = true))
    (i j : Fin m) (hij : i ≠ j) : L.Adj (e i) (e j) ↔ edge h i.val j.val = true := by
  rcases lt_or_gt_of_ne hij with hlt | hlt
  · exact he i j hlt
  · rw [SimpleGraph.adj_comm, he j i hlt]
    unfold edge
    rw [idx_comm]

lemma pairs_sound {m : ℕ} {f : ℕ → ℕ → Bool} (h : pairsAll m f = true)
    (i j : ℕ) (hij : i < j) (hj : j < m) : f i j = true := by
  unfold pairsAll at h
  have h1 := List.all_eq_true.mp h j (List.mem_range.mpr hj)
  exact List.all_eq_true.mp h1 i (List.mem_range.mpr hij)

lemma sel_sound {L : SimpleGraph (Fin 8)} {k g m : ℕ} (hg : Emb L k g) {σ : List ℕ}
    (hs : okSel k σ m = true) :
    ∃ f : Fin m → Fin 8, Function.Injective f ∧ ∀ i j : Fin m, i ≠ j →
      (L.Adj (f i) (f j) ↔ edge g (σ.getD i.val 0) (σ.getD j.val 0) = true) := by
  obtain ⟨e, einj, he⟩ := hg
  unfold okSel at hs
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at hs
  obtain ⟨⟨hlen, hlt⟩, hnd⟩ := hs
  have hget : ∀ i : Fin m, σ.getD i.val 0 = σ[i.val]'(by have := i.isLt; omega) := by
    intro i
    exact (List.getD_eq_getElem σ 0 (by have := i.isLt; omega))
  have hb : ∀ i : Fin m, σ.getD i.val 0 < k := by
    intro i
    rw [hget]
    exact hlt _ (List.getElem_mem _)
  have hne : ∀ i j : Fin m, i ≠ j → (⟨_, hb i⟩ : Fin k) ≠ ⟨_, hb j⟩ := by
    intro i j hij h
    have h' : σ.getD i.val 0 = σ.getD j.val 0 := congrArg Fin.val h
    rw [hget, hget] at h'
    exact hij (Fin.ext ((List.Nodup.getElem_inj_iff hnd).mp h'))
  refine ⟨fun i => e ⟨_, hb i⟩, ?_, ?_⟩
  · intro i j h
    by_contra hij
    exact hne i j hij (einj h)
  · intro i j hij
    exact emb_adj he _ _ (hne i j hij)

lemma same_sound {L : SimpleGraph (Fin 8)} {k g h m : ℕ} (hg : Emb L k g) {σ : List ℕ}
    (hs : okSel k σ m = true) (hsame : same g h m σ = true) : Emb L m h := by
  obtain ⟨f, finj, hf⟩ := sel_sound hg hs
  refine ⟨f, finj, fun i j hij => ?_⟩
  rw [hf i j (ne_of_lt hij)]
  have := pairs_sound hsame i.val j.val hij j.isLt
  rw [beq_iff_eq] at this
  rw [this]

lemma extend {L : SimpleGraph (Fin 8)} {k r : ℕ} (hk : k < 8)
    (hr : r < 2 ^ (k * (k - 1) / 2)) (h : Emb L k r) :
    ∃ N < 2 ^ k, Emb L (k + 1) (r ||| (N <<< (k * (k - 1) / 2))) := by
  classical
  obtain ⟨e, einj, he⟩ := h
  have hv : ∃ v : Fin 8, ∀ i, e i ≠ v := by
    by_contra hcon
    push Not at hcon
    have := Fintype.card_le_of_surjective e hcon
    simp only [Fintype.card_fin] at this
    omega
  obtain ⟨v, hv⟩ := hv
  let N := Nat.ofBits (fun i : Fin k => decide (L.Adj (e i) v))
  refine ⟨N, Nat.ofBits_lt_two_pow _, Fin.snoc e v, ?_, ?_⟩
  · intro a b hab
    induction a using Fin.lastCases with
    | last =>
      induction b using Fin.lastCases with
      | last => rfl
      | cast b =>
        rw [Fin.snoc_last, Fin.snoc_castSucc] at hab
        exact absurd hab.symm (hv b)
    | cast a =>
      induction b using Fin.lastCases with
      | last =>
        rw [Fin.snoc_last, Fin.snoc_castSucc] at hab
        exact absurd hab (hv a)
      | cast b =>
        rw [Fin.snoc_castSucc, Fin.snoc_castSucc] at hab
        rw [einj hab]
  · intro a b hab
    induction a using Fin.lastCases with
    | last => exact absurd hab (not_lt.mpr (Fin.le_last _))
    | cast a =>
      induction b using Fin.lastCases with
      | last =>
        rw [Fin.snoc_last, Fin.snoc_castSucc]
        have ha := a.isLt
        have hbit : r.testBit (k * (k - 1) / 2 + a.val) = false :=
          Nat.testBit_lt_two_pow (lt_of_lt_of_le hr
            (Nat.pow_le_pow_right (by norm_num) (by omega)))
        unfold edge
        rw [Fin.val_castSucc, Fin.val_last, idx_lt ha, Nat.testBit_or, hbit,
          Nat.testBit_shiftLeft]
        simp [N, Nat.testBit_ofBits, ha]
      | cast b =>
        rw [Fin.snoc_castSucc, Fin.snoc_castSucc]
        have hab' : a < b := by simpa using hab
        have hb := b.isLt
        have hlt : idx a.val b.val < k * (k - 1) / 2 := by
          rw [idx_lt (show a.val < b.val from hab')]
          have hstep : ∀ n : ℕ, (n + 1) * n / 2 = n * (n - 1) / 2 + n := by
            intro n
            have : (n + 1) * n = n * (n - 1) + n * 2 := by
              cases n with
              | zero => rfl
              | succ n => simp only [Nat.add_sub_cancel]; ring
            rw [this, Nat.add_mul_div_right _ _ (by norm_num : 0 < 2)]
          have h1 := hstep b.val
          have h2 : (b.val + 1) * b.val ≤ k * (k - 1) :=
            Nat.mul_le_mul (by omega) (by omega)
          have h3 := Nat.div_le_div_right (c := 2) h2
          have : a.val < b.val := hab'
          omega
        rw [he a b hab']
        unfold edge
        rw [Fin.val_castSucc, Fin.val_castSucc, Nat.testBit_or, Nat.testBit_shiftLeft]
        simp [Nat.not_le.mpr hlt]

def Goal (L : SimpleGraph (Fin 8)) : Prop := ∃ p ∈ pats, Emb L p.1 p.2

lemma level {L : SimpleGraph (Fin 8)} (h3 : L.CliqueFree 3) (h5 : Lᶜ.CliqueFree 5)
    {k : ℕ} (hk : k < 8) {cur next : List ℕ} {cert : List (List (ℕ × ℕ × List ℕ))}
    (hc : okLevel k cur next cert = true)
    (hnext : ∀ h ∈ next, Emb L (k + 1) h → Goal L) :
    ∀ r ∈ cur, Emb L k r → Goal L := by
  intro r hr hemb
  unfold okLevel at hc
  rw [Bool.and_eq_true] at hc
  obtain ⟨hsmall, hrows⟩ := hc
  have hrlt := of_decide_eq_true (List.all_eq_true.mp hsmall r hr)
  obtain ⟨N, hN, hg⟩ := extend hk hrlt hemb
  obtain ⟨a, ha, har⟩ := List.getElem_of_mem hr
  have h1 := List.all_eq_true.mp hrows a (List.mem_range.mpr ha)
  rw [List.getElem?_eq_getElem ha, har] at h1
  cases hrow : cert[a]? with
  | none => rw [hrow] at h1; exact absurd h1 Bool.false_ne_true
  | some row =>
    rw [hrow] at h1
    change okRow k r next row = true at h1
    have h2 := List.all_eq_true.mp h1 N (List.mem_range.mpr hN)
    cases hc' : row[N]? with
    | none => rw [hc'] at h2; exact absurd h2 Bool.false_ne_true
    | some c =>
      rw [hc'] at h2
      change okEntry k _ next c = true at h2
      obtain ⟨tag, n, σ⟩ := c
      unfold okEntry at h2
      dsimp only at h2
      split at h2
      · rw [Bool.and_eq_true] at h2
        obtain ⟨f, _, hf⟩ := sel_sound hg h2.1
        exfalso
        classical
        have key : ∀ i j : Fin 3, i < j → L.Adj (f i) (f j) := fun i j hij =>
          (hf i j (ne_of_lt hij)).mpr (pairs_sound h2.2 i.val j.val hij j.isLt)
        exact h3 {f 0, f 1, f 2} (SimpleGraph.is3Clique_triple_iff.mpr
          ⟨key 0 1 (by decide), key 0 2 (by decide), key 1 2 (by decide)⟩)
      · rw [Bool.and_eq_true] at h2
        obtain ⟨f, finj, hf⟩ := sel_sound hg h2.1
        exfalso
        classical
        have key : ∀ i j : Fin 5, i < j → ¬ L.Adj (f i) (f j) := by
          intro i j hij hadj
          have h4 := pairs_sound h2.2 i.val j.val hij j.isLt
          have h6 := (hf i j (ne_of_lt hij)).mp hadj
          rw [h6] at h4
          exact Bool.false_ne_true h4
        refine h5 (Finset.univ.image f) ⟨?_, ?_⟩
        · intro x hx y hy hxy
          rw [Finset.coe_image] at hx hy
          obtain ⟨i, _, rfl⟩ := hx
          obtain ⟨j, _, rfl⟩ := hy
          have hij : i ≠ j := fun h => hxy (congrArg f h)
          refine ⟨hxy, fun hadj => ?_⟩
          rcases lt_or_gt_of_ne hij with hlt | hlt
          · exact key i j hlt hadj
          · exact key j i hlt hadj.symm
        · rw [Finset.card_image_of_injective _ finj, Finset.card_univ, Fintype.card_fin]
      · split at h2
        · rename_i p hp
          rw [Bool.and_eq_true] at h2
          exact ⟨p, List.mem_of_getElem? hp, same_sound hg h2.1 h2.2⟩
        · exact absurd h2 Bool.false_ne_true
      · split at h2
        · rename_i h hh
          rw [Bool.and_eq_true] at h2
          exact hnext h (List.mem_of_getElem? hh) (same_sound hg h2.1 h2.2)
        · exact absurd h2 Bool.false_ne_true

