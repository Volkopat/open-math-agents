private def high : Nat := 
private def cv : Nat := 
private def fm : Nat := 
private def bases : Nat := 
private def lowbit (x : Nat) := Nat.xor x (Nat.land x (Nat.sub x 1))
private def index (x : Nat) := Nat.land 255 (Nat.shiftRight  (Nat.mul 8 (Nat.mod (lowbit x) 197)))
private def lineCode (x : Nat) := Nat.land 16383 (Nat.shiftRight  (Nat.mul 14 (Nat.mod (lowbit x) 2389)))
private def base (di : Nat) := Nat.land (Nat.sub (Nat.shiftLeft 1 1024) 1)
  (Nat.shiftRight bases (Nat.mul 1024 di))
private def layout (code : Nat) : Nat :=
  let a := Nat.div (Nat.land code 1023) 5
  let i := Nat.shiftRight code 10
  if a + 13*(i+1) < 184 then Nat.shiftLeft (base i) (Nat.mul 5 a) else base 0
private def seek (m s : Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | k+1, w => let v := Nat.land w m
              match Nat.beq v 0 with
              | true => seek m s k (Nat.add w s)
              | false => v
private def tag (p : Nat) : Nat :=
  (1 <<< (2760-5*p)) ||| ((1 <<< (4000+10*p)) |||
    (1 <<< ((if p%2=0 then 7000 else 9000)+5*(p/2))))
private def ban (m p : Nat) : Nat :=
  (m >>> (2760-10*p)) ||| ((m >>> (4000+5*p)) |||
    (m >>> ((if p%2=0 then 7000 else 9000)-5*((p+1)/2))))
private structure St where
  m : Nat
  a : Nat
  u : Nat

private def pt (x : Nat) := Nat.shiftLeft 1 (Nat.mul 5 x)
private def left (s : St) (p : Nat) : St :=
  let t := pt p
  ⟨Nat.lor s.m (tag p), Nat.lor (Nat.xor s.a (Nat.land s.a (ban s.m p))) t,
   Nat.xor s.u (Nat.land s.u (Nat.shiftLeft cv (Nat.add 4 (Nat.mul 5 p))))⟩
private def right (s : St) (p : Nat) : St :=
  ⟨s.m, Nat.xor s.a (Nat.land s.a (pt p)), s.u⟩

private def Red (c : Nat → Bool) (t : Nat) := t < 184 ∧ c t = true
private def Good (c : Nat → Bool) (m : Nat) := ∀ p t, Red c p → Red c t →
  p ≠ t → (ban m p).testBit (5*t) = false
private def Fits (c : Nat → Bool) (s : St) :=
  Good c s.m ∧ ∀ t, Red c t → s.a.testBit (5*t) = true
private def Closed (s : St) := ∀ c, ¬Goal 184 c → Fits c s → False

private lemma triple {c : Nat → Bool} (hn : ¬Goal 184 c) {u v w : Nat}
    (hu : Red c u) (hv : Red c v) (hw : Red c w)
    (he : u+w=2*v) (hne : u ≠ w) : False := by
  have mono {a b e : Nat} (ha : Red c a) (hb : Red c b) (hc : Red c e)
      (lt : a < e) (eq : a+e=2*b) : False := by
    apply hn
    refine ⟨true, a, b-a, by omega, ?_, ?_⟩
    · change a+2*(b-a)<184; have := hc.1; omega
    · intro t ht
      change t.val ≤ 2 at ht
      rcases (show t.val = 0 ∨ t.val = 1 ∨ t.val = 2 by omega) with h | h | h
      · simpa [h] using ha.2
      · simpa [h, show a+(b-a)=b by omega] using hb.2
      · simpa [h, show a+2*(b-a)=e by omega] using hc.2
  rcases lt_or_gt_of_ne hne with h | h
  · exact mono hu hv hw h he
  · exact mono hw hv hu h (by omega)

private lemma tag_good {c p : _} (hn : ¬Goal 184 c) (hp : Red c p) : Good c (tag p) := by
  intro q t hq ht hne
  have pb:=hp.1; have qb:=hq.1; have tb:=ht.1
  have n1 : t+p ≠ 2*q := fun he => triple hn ht hq hp he (by rintro rfl; omega)
  have n2 : t+q ≠ 2*p := fun he => triple hn ht hp hq he (Ne.symm hne)
  have n3 : p+q ≠ 2*t := fun he => triple hn hp ht hq he (by rintro rfl; omega)
  have single (a i : Nat) : (1 <<< a : Nat).testBit i = decide (a=i) := by
    rw [Nat.shiftLeft_eq, Nat.one_mul, Nat.testBit_two_pow]
  unfold ban tag
  by_cases ep : p%2=0 <;> by_cases eq : q%2=0 <;>
    simp only [ep, eq, if_true, if_false, Nat.testBit_or, Nat.testBit_shiftRight,
      single, Bool.or_eq_false_iff, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> omega

private lemma joined {c : Nat → Bool} {u v : Nat} (hu : Good c u) (hv : Good c v) :
    Good c (Nat.lor u v) := by
  intro p t hp ht hne
  have a := hu p t hp ht hne
  have b := hv p t hp ht hne
  change (ban (u ||| v) p).testBit (5*t) = false
  unfold ban at *
  simp_all only [Nat.testBit_or,Nat.testBit_shiftRight,Bool.or_eq_false_iff,true_and]

private lemma ptbit (p i : Nat) : (pt p).testBit i = decide (5*p=i) := by
  simp [pt, Nat.shiftLeft_eq, Nat.testBit_two_pow]
private lemma fitsL {s : St} {c p} (hn : ¬Goal 184 c) (f : Fits c s) (hp : Red c p) :
    Fits c (left s p) := by
  refine ⟨joined f.1 (tag_good hn hp), ?_⟩
  intro t ht
  by_cases he : p=t
  · simp [left,ptbit,he]
  · simp [left,Nat.testBit_xor, f.2 t ht, f.1 p t hp ht he]
private lemma fitsR {s : St} {c p} (f : Fits c s) (hp : ¬Red c p) :
    Fits c (right s p) := by
  refine ⟨f.1, ?_⟩
  intro t ht
  have he : 5*p ≠ 5*t := fun h => hp ((show t=p by omega) ▸ ht)
  simp [right,Nat.testBit_xor, f.2 t ht,ptbit,he]

private lemma bb {s : St} (p : Nat) (hl : Closed (left s p)) (hr : Closed (right s p)) :
    Closed s := by
  intro c hn hs
  by_cases hp : Red c p
  · exact hl c hn (fitsL hn hs hp)
  · exact hr c hn (fitsR hs hp)

private lemma bbit : ∀ i : Fin 14, ∀ t : Fin 14,
    (base i.val).testBit (5*(t.val*(i.val+1))) = true := by decide +kernel
private lemma hits {c : Nat → Bool} (hn : ¬Goal 184 c) (code : Nat) :
    ∃ t, (layout code).testBit (5*t) = true ∧ Red c t := by
  have line (a i : Nat) (hb : a+13*(i+1)<184) :
      ∃ t, ((base i) <<< (5*a)).testBit (5*t) = true ∧ Red c t := by
    have hr : ∃ t : Fin 14, c (a+t.val*(i+1)) = true := by
      by_contra! nr
      apply hn
      exact ⟨false,a,i+1,by omega,hb,fun t _ => by simpa using nr t⟩
    obtain ⟨t,hr⟩ := hr
    have ht := Nat.mul_le_mul_right (i+1) (show t.val ≤ 13 by omega)
    refine ⟨_,?_, ⟨by omega,hr⟩⟩
    simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using bbit ⟨i,by omega⟩ t
  unfold layout
  dsimp only
  split
  · exact line _ _ ‹_›
  · simpa using line 0 0 (by decide)

private def rest (s : St) :=
  Nat.land (layout (lineCode (seek s.u slots 16 (Nat.sub high (Nat.land (Nat.mul s.a cv) fm))))) s.a
private def pick (mask xs : Nat) :=
  let near := Nat.land mask xs
  index (if Nat.beq near 0 then xs else near)
private def check (mask : Nat) : Nat → St → Bool
  | 0, _ => false
  | n+1, s =>
    let xs := rest s
    if xs = 0 then true else
    let p := pick mask xs
    if xs = pt p then check mask n (left s p) else
    check mask n (left s p) && check mask n (right s p)

private lemma checked (mask fuel : Nat) (s : St) (ok : check mask fuel s = true) : Closed s := by
  induction fuel generalizing s with
  | zero => simp [check] at ok
  | succ fuel ih =>
    simp only [check] at ok
    split at ok
    · rename_i hz
      intro c hn f
      obtain ⟨t,hb,hr⟩ := hits hn (lineCode (seek s.u slots 16 (Nat.sub high (Nat.land (Nat.mul s.a cv) fm))))
      have bit : (rest s).testBit (5*t) = true := by simp [rest, f.2 t hr]; exact hb
      simp [hz] at bit
    · split at ok
      · rename_i he
        intro c hn f
        obtain ⟨t,hb,hr⟩ := hits hn (lineCode (seek s.u slots 16 (Nat.sub high (Nat.land (Nat.mul s.a cv) fm))))
        have bit : (rest s).testBit (5*t) = true := by simp [rest, f.2 t hr]; exact hb
        rw [he,ptbit] at bit
        exact ih _ ok c hn (fitsL hn f ((show t = pick mask (rest s) by have := of_decide_eq_true bit; omega) ▸ hr))
      · exact bb _ (ih _ (Bool.and_eq_true_iff.mp ok).1) (ih _ (Bool.and_eq_true_iff.mp ok).2)

private def initial : St := ⟨0,0x8421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421,high⟩
private def insertKnown (s : St) (p : Nat) :=
  if s.a.testBit (5*p) then left s p else {s with a := 0}
private def paint : St → List Nat → St
  | s, [] => s
  | s, p::ps => paint (insertKnown s p) ps
private def clearBlue : St → List Nat → St
  | s, [] => s
  | s, p::ps => clearBlue (right s p) ps
private def initialCase (rs bs : List Nat) := clearBlue (paint initial rs) bs
private lemma initialFits (c : Nat → Bool) : Fits c initial := by
  constructor
  · intro p t _ _ _
    simp [initial,ban]
  · intro t ht
    have tested : ∀ i : Fin 184, initial.a.testBit (5*i.val) = true := by decide +kernel
    exact tested ⟨t,ht.1⟩
private lemma paintFits {c : Nat → Bool} (hn : ¬Goal 184 c) (rs : List Nat) (s : St)
    (f : Fits c s) (red : ∀ p ∈ rs, Red c p) : Fits c (paint s rs) := by
  induction rs generalizing s with
  | nil => exact f
  | cons p ps ih =>
    apply ih
    · have hp := red p (by simp)
      simpa [insertKnown,f.2 p hp] using fitsL hn f hp
    · intro q hq; exact red q (by simp [hq])
private lemma clearFits {c : Nat → Bool} (bs : List Nat) (s : St)
    (f : Fits c s) (blue : ∀ p ∈ bs, ¬Red c p) : Fits c (clearBlue s bs) := by
  induction bs generalizing s with
  | nil => exact f
  | cons p ps ih =>
    apply ih
    · exact fitsR f (blue p (by simp))
    · intro q hq; exact blue q (by simp [hq])
private lemma ofCase (rs bs : List Nat) {r b : Nat}
    (hr : rs.all (fun p => decide (p<184) && r.testBit p) = true)
    (hb : bs.all (fun p => decide (p<184) && b.testBit p) = true)
    (done : Closed (initialCase rs bs)) : Impossible 184 (r,b) := by
  intro c hn hs
  apply done c hn
  apply clearFits
  · apply paintFits hn rs initial (initialFits c)
    intro p hp
    obtain ⟨hlt,hbit⟩ := Bool.and_eq_true_iff.mp (List.all_eq_true.mp hr p hp)
    exact ⟨of_decide_eq_true hlt,hs.1 p (of_decide_eq_true hlt) (by simpa [AtBit,Bit] using hbit)⟩
  · intro p hp red
    obtain ⟨hlt,hbit⟩ := Bool.and_eq_true_iff.mp (List.all_eq_true.mp hb p hp)
    have hfalse := hs.2 p (of_decide_eq_true hlt) (by simpa [AtBit,Bit] using hbit)
    exact Bool.false_ne_true (hfalse.symm.trans red.2)

