import OMAReductions.R_Green14_W_3_14_R1_H1_R1_H1_R1

/-!
# Adjacent red sites at 91 and 92

This certificate uses the symmetric window of positions zero through 183.
The arithmetic-progression masks and red-site geometry adapt @anmolspace's
PR #5642 and PR #9049. The reflection argument adapts @nijv's PR #8792.
The original formalization credits NickLeko, ZedingZhang, MrSeizy,
Vincent T. Mossman and PanPapag. The numerical result is due to Ahmed,
Kullmann and Snevily. The adjacent-window proof is by @sprajs.
-/
namespace OMA.AdjacentWindow

private def Goal (N : Nat) (c : Nat → Bool) : Prop :=
  ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13)*d < N ∧
    ∀ t : Fin 14, t.val ≤ (if b then 2 else 13) → c (a+t.val*d) = b

private def Bit (m i : Nat) := m.testBit i = true
private def AtBit (j m x : Nat) := Bit m (256*j+x)
private def Fact (N : Nat) (c : Nat → Bool) (b : Bool) (j m : Nat) :=
  ∀ x, x < N → AtBit j m x → c x = b
private def Valid (N : Nat) (c : Nat → Bool) (j : Nat) (s : Nat × Nat) :=
  Fact N c true j s.1 ∧ Fact N c false j s.2
private def Impossible (N : Nat) (s : Nat × Nat) :=
  ∀ c, ¬Goal N c → Valid N c 0 s → False
private lemma bit_or {a b i : Nat} : Bit (a ||| b) i ↔ Bit a i ∨ Bit b i := by simp [Bit,Nat.testBit_or]

private lemma set_color {N c b p m} (h : Fact N c b 0 m) (hp : c p = b) :
    Fact N c b 0 (Nat.lor m (Nat.shiftLeft 1 p)) := by
  intro x hx he
  rcases bit_or.mp he with h1.property | h2.property
  · exact h x hx h1.property
  · have e : p = x := by
      change (1 <<< p).testBit (256 * 0 + x) = true at h2.property
      simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow] using h2.property
    exact e ▸ hp

private def SymMask (N m : Nat) : Prop :=
  ∀ x, x < N → Bit m x → Bit m (N - 1 - x)

private lemma goal_reflect {N : Nat} {c : Nat → Bool}
    (h : Goal N (fun x => c (N - 1 - x))) : Goal N c := by
  obtain ⟨b, a, d, hd, hb, hm⟩ := h
  let L : Nat := if b then 2 else 13
  change a + L * d < N at hb
  refine ⟨b, N - 1 - (a + L * d), d, hd, by change N - 1 - (a + L * d) + L * d < N; omega, ?_⟩
  intro t ht
  change t.val ≤ L at ht
  have hL : L ≤ 13 := by cases b <;> decide
  have ht' : L - t.val < 14 := by omega
  have hmul := Nat.mul_le_mul_right d ht
  have hsub := hm ⟨L - t.val, ht'⟩ (by change L - t.val ≤ L; omega)
  have heq : N - 1 - (a + (L - t.val) * d) = N - 1 - (a + L * d) + t.val * d := by
    rw [Nat.sub_mul]; omega
  simpa only [heq] using hsub

private lemma sym_branch3 {N : Nat} (u : Nat) (hu : u < N) {r b : Nat}
    (hr : SymMask N r) (hb : SymMask N b)
    (htt : Impossible N (Nat.lor (Nat.lor r (Nat.shiftLeft 1 u)) (Nat.shiftLeft 1 (N - 1 - u)), b))
    (hff : Impossible N (r, Nat.lor (Nat.lor b (Nat.shiftLeft 1 u)) (Nat.shiftLeft 1 (N - 1 - u))))
    (htf : Impossible N (Nat.lor r (Nat.shiftLeft 1 u), Nat.lor b (Nat.shiftLeft 1 (N - 1 - u)))) :
    Impossible N (r, b) := by
  intro c hn hs
  cases hu1 : c u with
  | true =>
    cases hu2 : c (N - 1 - u) with
    | true => exact htt c hn ⟨set_color (set_color hs.1 hu1) hu2, hs.2⟩
    | false => exact htf c hn ⟨set_color hs.1 hu1, set_color hs.2 hu2⟩
  | false =>
    cases hu2 : c (N - 1 - u) with
    | false => exact hff c hn ⟨hs.1, set_color (set_color hs.2 hu1) hu2⟩
    | true =>
      let c' := fun x => c (N - 1 - x)
      have hn' : ¬ Goal N c' := fun hg => hn (goal_reflect hg)
      have hr' : Fact N c' true 0 r := fun x hx hbit => by
        simpa [c'] using hs.1 (N - 1 - x) (by omega) (by simpa [AtBit] using hr x hx (by simpa [AtBit] using hbit))
      have hb' : Fact N c' false 0 b := fun x hx hbit => by
        simpa [c'] using hs.2 (N - 1 - x) (by omega) (by simpa [AtBit] using hb x hx (by simpa [AtBit] using hbit))
      have hu2' : c' u = true := by simpa [c'] using hu2
      have hu1' : c' (N - 1 - u) = false := by
        simpa [c', show N - 1 - (N - 1 - u) = u by omega] using hu1
      exact htf c' hn' ⟨set_color hr' hu2', set_color hb' hu1'⟩

private lemma sym_of_decide {N m : Nat}
    (h : ∀ x : Fin N, m.testBit x.val = true → m.testBit (N - 1 - x.val) = true) :
    SymMask N m := fun x hx hb => h ⟨x, hx⟩ hb

private lemma liftWindow (h : Impossible 184 (0x180000000000000000000000, 0)) :
    ∀ c : Nat → Bool, c 91 = true → c 92 = true →
      (∀ q : Nat, 91 < q → q < 92 → c q = false) → Goal 185 c := by
  intro c h91.property h92.property _
  have H : Goal 184 c := by
    by_contra hn
    apply h c hn
    constructor
    · intro x hx hb
      have hc : ∀ i : Fin 184, (0x180000000000000000000000 : Nat).testBit i.val = true →
          i.val = 91 ∨ i.val = 92 := by decide +kernel
      rcases hc ⟨x,hx⟩ (by simpa [AtBit, Bit] using hb) with h | h
      · rw [show x = 91 from h]; exact h91.property
      · rw [show x = 92 from h]; exact h92.property
    · intro x hx hb
      simp [AtBit, Bit] at hb
  obtain ⟨b,a,d,hd,hb, ht⟩ := H
  exact ⟨b,a,d,hd, Nat.lt_trans hb (by decide),ht⟩

