/-! ### floor inequalities (Legendre) -/

private lemma sc (Z k x Y : ℕ) (hk : 0 < k) (h : Z = k * x) : Z / Y / k = x / Y := by
  subst h; rw [Nat.div_div_eq_div_mul, mul_comm Y k, Nat.mul_div_mul_left _ _ hk]

private lemma sc2 (Z k x q : ℕ) (hk : 0 < k) (h : Z = k * (2 * x)) : Z / (2 * q) / k = x / q := by
  rw [sc Z k (2 * x) (2 * q) hk h, Nat.mul_div_mul_left x q two_pos]

set_option maxHeartbeats 4000000 in
private lemma key_odd (c : ℕ) :
    c / 12 + c / 15 + c / 20 + c / 120 ≤ c / 6 + c / 60 + c / 40 := by
  have hr : ∀ ρ < 120, ρ / 12 + ρ / 15 + ρ / 20 + ρ / 120 ≤ ρ / 6 + ρ / 60 + ρ / 40 := by
    intro ρ hρ; interval_cases ρ <;> omega
  obtain ⟨h', ρ, hρ, rfl⟩ : ∃ h' ρ, ρ < 120 ∧ c = ρ + 120 * h' :=
    ⟨c / 120, c % 120, Nat.mod_lt _ (by norm_num), by omega⟩
  have h := hr ρ hρ
  have e1 : (ρ + 120 * h') / 12 = ρ / 12 + 10 * h' := by omega
  have e2 : (ρ + 120 * h') / 15 = ρ / 15 + 8 * h' := by omega
  have e3 : (ρ + 120 * h') / 20 = ρ / 20 + 6 * h' := by omega
  have e5 : (ρ + 120 * h') / 6 = ρ / 6 + 20 * h' := by omega
  have e6 : (ρ + 120 * h') / 60 = ρ / 60 + 2 * h' := by omega
  have e7 : (ρ + 120 * h') / 40 = ρ / 40 + 3 * h' := by omega
  have e8 : ρ / 120 = 0 := by omega
  rw [e1, e2, e3, e5, e6, e7]
  rw [e8] at h
  omega

private lemma fl_even (u q : ℕ) : 10 * u / q + 8 * u / q + 3 * u / q ≤ 20 * u / q + u / q := by
  have h1 := sc (120 * u) 6 (20 * u) q (by norm_num) (by ring)
  have h2 := sc (120 * u) 12 (10 * u) q (by norm_num) (by ring)
  have h3 := sc (120 * u) 15 (8 * u) q (by norm_num) (by ring)
  have h4 := sc (120 * u) 40 (3 * u) q (by norm_num) (by ring)
  have h5 := sc (120 * u) 120 u q (by norm_num) (by ring)
  omega

private lemma fl_odd (m q : ℕ) :
    5 * (2 * m + 1) / q + 4 * (2 * m + 1) / q + 3 * (2 * m + 1) / q + m / q ≤
      10 * (2 * m + 1) / q + (2 * m + 1) / q + (3 * m + 1) / q := by
  have h1 := sc2 (120 * (2 * m + 1)) 6 (10 * (2 * m + 1)) q (by norm_num) (by ring)
  have h2 := sc2 (120 * (2 * m + 1)) 60 (2 * m + 1) q (by norm_num) (by ring)
  have h3 := sc2 (120 * (2 * m + 1)) 12 (5 * (2 * m + 1)) q (by norm_num) (by ring)
  have h4 := sc2 (120 * (2 * m + 1)) 15 (4 * (2 * m + 1)) q (by norm_num) (by ring)
  have h5 := sc2 (120 * (2 * m + 1)) 20 (3 * (2 * m + 1)) q (by norm_num) (by ring)
  have h6 := sc (120 * (2 * m + 1)) 120 (2 * m + 1) (2 * q) (by norm_num) (by ring)
  have h7 := sc (120 * (2 * m + 1)) 40 (3 * (2 * m + 1)) (2 * q) (by norm_num) (by ring)
  have e6 : (2 * m + 1) / (2 * q) = m / q := by
    rw [← Nat.div_div_eq_div_mul, show (2 * m + 1) / 2 = m by omega]
  have e7 : 3 * (2 * m + 1) / (2 * q) = (3 * m + 1) / q := by
    rw [← Nat.div_div_eq_div_mul, show 3 * (2 * m + 1) / 2 = 3 * m + 1 by omega]
  have hk := key_odd (120 * (2 * m + 1) / (2 * q))
  omega

variable {p : ℕ} [hp : Fact p.Prime]

private lemma D_of_val (Z W : ℕ) (hW : W ≠ 0) (hZ : Z ≠ 0)
    (h : padicValNat p W ≤ padicValNat p Z) : D p 0 ((Z : ℚ) / (W : ℚ)) := by
  obtain ⟨w, hw⟩ := (pow_padicValNat_dvd (p := p) (n := W))
  obtain ⟨z, hz⟩ := (pow_dvd_pow p h).trans (pow_padicValNat_dvd (p := p) (n := Z))
  set v := padicValNat p W with hv
  have hpw : ¬ p ∣ w := by
    intro hd
    apply pow_succ_padicValNat_not_dvd (p := p) hW
    have key : p ^ v * p ∣ p ^ v * w := mul_dvd_mul_left _ hd
    rw [← hw, ← pow_succ] at key
    exact key
  refine ⟨z, w, hpw, ?_⟩
  have hw0 : (w : ℚ) ≠ 0 := by
    intro h0; apply hW; rw [hw]; simp [show w = 0 by exact_mod_cast h0]
  have hp0 : ((p : ℚ) ^ v) ≠ 0 := pow_ne_zero _ (by exact_mod_cast hp.out.ne_zero)
  have hZ' : (Z : ℚ) = (p : ℚ) ^ v * (z : ℚ) := by exact_mod_cast hz
  have hW' : (W : ℚ) = (p : ℚ) ^ v * (w : ℚ) := by exact_mod_cast hw
  rw [hZ', hW', pow_zero, one_mul]
  field_simp
  norm_cast

private lemma ve (u : ℕ) :
    padicValNat p ((10 * u).factorial * (8 * u).factorial * (3 * u).factorial) ≤
      padicValNat p ((20 * u).factorial * u.factorial) := by
  have f0 := Nat.factorial_ne_zero
  rw [padicValNat.mul (mul_ne_zero (f0 _) (f0 _)) (f0 _), padicValNat.mul (f0 _) (f0 _),
    padicValNat.mul (f0 _) (f0 _)]
  have hB : ∀ x, x ≤ 20 * u → Nat.log p x < 20 * u + 1 := fun x hx =>
    lt_of_le_of_lt (Nat.log_le_self p x) (by omega)
  rw [padicValNat_factorial (hB (10 * u) (by omega)), padicValNat_factorial (hB (8 * u) (by omega)),
    padicValNat_factorial (hB (3 * u) (by omega)), padicValNat_factorial (hB (20 * u) (by omega)),
    padicValNat_factorial (hB u (by omega))]
  simp only [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro i _
  exact fl_even u (p ^ i)

private lemma vo (m : ℕ) :
    padicValNat p ((5 * (2 * m + 1)).factorial * (4 * (2 * m + 1)).factorial *
        (3 * (2 * m + 1)).factorial * m.factorial) ≤
      padicValNat p ((10 * (2 * m + 1)).factorial * (2 * m + 1).factorial *
        (3 * m + 1).factorial * 4 ^ (2 * m + 1)) := by
  have f0 := Nat.factorial_ne_zero
  have h4 : (4 : ℕ) ^ (2 * m + 1) ≠ 0 := by positivity
  rw [padicValNat.mul (mul_ne_zero (mul_ne_zero (f0 _) (f0 _)) (f0 _)) (f0 _),
    padicValNat.mul (mul_ne_zero (f0 _) (f0 _)) (f0 _), padicValNat.mul (f0 _) (f0 _),
    padicValNat.mul (mul_ne_zero (mul_ne_zero (f0 _) (f0 _)) (f0 _)) h4,
    padicValNat.mul (mul_ne_zero (f0 _) (f0 _)) (f0 _), padicValNat.mul (f0 _) (f0 _)]
  have hB : ∀ x, x ≤ 10 * (2 * m + 1) → Nat.log p x < 10 * (2 * m + 1) + 1 := fun x hx =>
    lt_of_le_of_lt (Nat.log_le_self p x) (by omega)
  rw [padicValNat_factorial (hB (5 * (2 * m + 1)) (by omega)),
    padicValNat_factorial (hB (4 * (2 * m + 1)) (by omega)),
    padicValNat_factorial (hB (3 * (2 * m + 1)) (by omega)),
    padicValNat_factorial (hB m (by omega)),
    padicValNat_factorial (hB (10 * (2 * m + 1)) (by omega)),
    padicValNat_factorial (hB (2 * m + 1) (by omega)),
    padicValNat_factorial (hB (3 * m + 1) (by omega))]
  simp only [← Finset.sum_add_distrib]
  exact (Finset.sum_le_sum fun i _ => fl_odd m (p ^ i)).trans (Nat.le_add_right _ _)

private lemma hf_even (u : ℕ) : hf (2 * u) = (u.factorial : ℚ) := by
  unfold hf; rw [if_pos (by omega), show 2 * u / 2 = u by omega]

private lemma hf_odd (m : ℕ) : hf (2 * m + 1) =
    ((2 * m + 1).factorial : ℚ) / ((2 : ℚ) ^ (2 * m + 1) * (m.factorial : ℚ)) := by
  unfold hf; rw [if_neg (by omega), show (2 * m + 1 - 1) / 2 = m by omega]

private lemma a_int (N : ℕ) : D p 0 (a N) := by
  rcases Nat.even_or_odd' N with ⟨u, rfl | rfl⟩
  · have e : a (2 * u) = (((20 * u).factorial * u.factorial : ℕ) : ℚ) /
        (((10 * u).factorial * (8 * u).factorial * (3 * u).factorial : ℕ) : ℚ) := by
      unfold a
      rw [hf_even, show 3 * (2 * u) = 2 * (3 * u) by ring, hf_even,
        show 10 * (2 * u) = 20 * u by ring, show 5 * (2 * u) = 10 * u by ring,
        show 4 * (2 * u) = 8 * u by ring]
      push_cast
      have := Nat.factorial_ne_zero
      field_simp
    rw [e]
    exact D_of_val _ _ (by positivity) (by positivity) (ve u)
  · have e : a (2 * u + 1) = (((10 * (2 * u + 1)).factorial * (2 * u + 1).factorial *
        (3 * u + 1).factorial * 4 ^ (2 * u + 1) : ℕ) : ℚ) /
        (((5 * (2 * u + 1)).factorial * (4 * (2 * u + 1)).factorial *
          (3 * (2 * u + 1)).factorial * u.factorial : ℕ) : ℚ) := by
      unfold a
      rw [hf_odd, show 3 * (2 * u + 1) = 2 * (3 * u + 1) + 1 by ring, hf_odd,
        show 2 * (3 * u + 1) + 1 = 3 * (2 * u + 1) by ring]
      have h2 : (2 : ℚ) ^ (3 * (2 * u + 1)) = (2 : ℚ) ^ (2 * u + 1) * (4 : ℚ) ^ (2 * u + 1) := by
        rw [show 3 * (2 * u + 1) = (2 * u + 1) + 2 * (2 * u + 1) by ring, pow_add, pow_mul]
        norm_num
      rw [h2]
      push_cast
      field_simp
    rw [e]
    exact D_of_val _ _ (by positivity) (by positivity) (vo u)

/-! ### product formula -/

private lemma hf_pos (k : ℕ) : 0 < hf k := by
  unfold hf; split_ifs <;> positivity

private lemma hf_step (M : ℕ) : hf (M + 2) = hf M * ((M : ℚ) / 2 + 1) := by
  rcases Nat.even_or_odd' M with ⟨u, rfl | rfl⟩
  · rw [show 2 * u + 2 = 2 * (u + 1) by ring, hf_even, hf_even, Nat.factorial_succ]
    push_cast; ring
  · rw [show 2 * u + 1 + 2 = 2 * (u + 1) + 1 by ring, hf_odd, hf_odd,
      show 2 * (u + 1) + 1 = (2 * u + 2) + 1 by ring, Nat.factorial_succ, Nat.factorial_succ,
      Nat.factorial_succ, Nat.factorial_succ u]
    push_cast
    field_simp
    ring

private lemma hf_add (N k : ℕ) :
    hf (N + 2 * k) = hf N * ∏ i ∈ Finset.range k, ((N : ℚ) / 2 + (i : ℚ) + 1) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show N + 2 * (k + 1) = (N + 2 * k) + 2 by ring, hf_step, ih, Finset.prod_range_succ]
    push_cast; ring

/-- `Gh N = ∏_{0<i<N} (1 + N/(2i))` -/
private def Gh (N : ℕ) : ℚ := Gp (-(N : ℚ) / 2) N

private lemma Gh_pos (N : ℕ) : 0 < Gh N := by
  unfold Gh Gp
  apply Finset.prod_pos
  intro i _
  have h0 : (0 : ℚ) ≤ (N : ℚ) / 2 / (i : ℚ) := by positivity
  have : (1 : ℚ) - -(N : ℚ) / 2 / (i : ℚ) = 1 + (N : ℚ) / 2 / (i : ℚ) := by ring
  rw [this]; linarith

private lemma prod_half (N : ℕ) (hN : 1 ≤ N) :
    ∏ i ∈ Finset.range N, ((N : ℚ) / 2 + (i : ℚ) + 1) = (N.factorial : ℚ) * (Gh N * (3 / 2)) := by
  have h1 : Gp (-(N : ℚ) / 2) (N + 1) = Gh N * (3 / 2) := by
    unfold Gh Gp
    rw [Finset.prod_range_succ]
    congr 1
    have : (N : ℚ) ≠ 0 := by exact_mod_cast (show N ≠ 0 by omega)
    field_simp; ring
  have h2 : Gp (-(N : ℚ) / 2) (N + 1) =
      ∏ i ∈ Finset.range N, (1 - (-(N : ℚ) / 2) / ((i : ℚ) + 1)) := by
    unfold Gp
    rw [Finset.prod_range_succ']
    simp
  rw [← h1, h2, ← Finset.prod_range_add_one_eq_factorial]
  push_cast
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  have : (i : ℚ) + 1 ≠ 0 := by positivity
  field_simp
  ring

private lemma a_formula (N : ℕ) (hN : 1 ≤ N) :
    a N * (Gh N * (3 / 2)) = ((10 * N).choose (5 * N) : ℚ) * ((5 * N).choose N : ℚ) := by
  unfold a
  rw [show 3 * N = N + 2 * N by ring, hf_add, prod_half N hN,
    Nat.cast_choose ℚ (by omega : 5 * N ≤ 10 * N), Nat.cast_choose ℚ (by omega : N ≤ 5 * N),
    show 10 * N - 5 * N = 5 * N by omega, show 5 * N - N = 4 * N by omega]
  have := hf_pos N
  have := Gh_pos N
  have := Nat.factorial_ne_zero
  field_simp

/-! ### the unit-product congruence with a rational parameter -/

private lemma R_Dq (h5 : 5 ≤ p) {s : ℕ} (hs : 1 ≤ s) (A : ℚ) (hA : D p 0 A) (t : ℕ) :
    D p (3 * s) (R p (A * (p : ℚ) ^ s) (t * p ^ s) - 1) := by
  have hp2 : ¬ p ∣ 2 := Nat.not_dvd_of_pos_of_lt (by norm_num) (by omega)
  obtain ⟨W, hW, hprod⟩ := prod_expand2 hp2 (U p (t * p ^ s)) (fun i => A * ((i : ℚ)⁻¹))
    ((p : ℚ) ^ s) ((D.ppow s).le (Nat.zero_le _))
    (fun i hi => hA.mul0 (D.inv (mem_U.mp hi).2))
  have hR : R p (A * (p : ℚ) ^ s) (t * p ^ s) =
      ∏ i ∈ U p (t * p ^ s), (1 - (p : ℚ) ^ s * (A * ((i : ℚ)⁻¹))) := by
    unfold R
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [div_eq_mul_inv]; ring
  have h1 : ∑ i ∈ U p (t * p ^ s), A * ((i : ℚ)⁻¹) = A * sg p (t * p ^ s) 1 := by
    unfold sg; rw [Finset.mul_sum]; simp only [pow_one]
  have h2 : ∑ i ∈ U p (t * p ^ s), (A * ((i : ℚ)⁻¹)) ^ 2 =
      A ^ 2 * sg p (t * p ^ s) 2 := by
    unfold sg; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by ring
  rw [hR, hprod, h1, h2]
  have hS1 := S1_D h5 hs t
  have hS2 := S2_D h5 hs t
  have hi2 : D p 0 ((2 : ℚ)⁻¹) := by simpa using D.inv (p := p) hp2
  have e1 : D p (3 * s) ((p : ℚ) ^ s * (A * sg p (t * p ^ s) 1)) :=
    ((D.ppow s).mul (hA.mul0' hS1)).le (by omega)
  have e2 : D p (3 * s) (((p : ℚ) ^ s) ^ 2 *
      ((A * sg p (t * p ^ s) 1) ^ 2 - A ^ 2 * sg p (t * p ^ s) 2)) := by
    have hin : D p s ((A * sg p (t * p ^ s) 1) ^ 2 - A ^ 2 * sg p (t * p ^ s) 2) :=
      (((hA.mul0' hS1).pow 2).le (by omega)).sub ((hA.pow0 2).mul0' hS2)
    exact (((D.ppow s).pow 2).mul hin).le (by omega)
  have e3 : D p (3 * s) (((p : ℚ) ^ s) ^ 3 * W) :=
    (((D.ppow s).pow 3).mul0 hW).le (by omega)
  exact ((e1.neg.add (e2.mul0 hi2)).add e3).congr (by ring)

private lemma rho (h5 : 5 ≤ p) (a b r : ℕ) (hr : 1 ≤ r) :
    ∃ ρ : ℚ, D p (3 * r) (ρ - 1) ∧ ((a * p ^ r).choose (b * p ^ r) : ℚ) =
      ((a * p ^ (r - 1)).choose (b * p ^ (r - 1)) : ℚ) * ρ := by
  have hp2 : p ≠ 2 := by omega
  have hc := choose_ratio (p := p) hp2 (a * p ^ (r - 1)) (b * p ^ (r - 1))
  obtain ⟨k, rfl⟩ : ∃ k, r = k + 1 := ⟨r - 1, by omega⟩
  simp only [Nat.add_sub_cancel] at hc ⊢
  have e1 : p * (a * p ^ k) = a * p ^ (k + 1) := by ring
  have e2 : p * (b * p ^ k) = b * p ^ (k + 1) := by ring
  rw [e1, e2] at hc
  have e3 : ((a * p ^ (k + 1) : ℕ) : ℚ) = (a : ℚ) * (p : ℚ) ^ (k + 1) := by push_cast; ring
  rw [e3] at hc
  exact ⟨_, R_D h5 (by omega : 1 ≤ k + 1) a b, hc⟩

private lemma D_inv_unit {e : ℕ} {x : ℚ} (he : 1 ≤ e) (h : D p e (x - 1)) : D p 0 x⁻¹ := by
  obtain ⟨a, b, hb, hab⟩ := h
  set c : ℤ := (b : ℤ) + (p : ℤ) ^ e * a with hcdef
  have hpc : ¬ (p : ℤ) ∣ c := by
    intro hd
    apply hb
    have h2 : (p : ℤ) ∣ (p : ℤ) ^ e * a := Dvd.dvd.mul_right (dvd_pow_self _ (by omega)) _
    exact Int.natCast_dvd_natCast.mp ((dvd_add_left h2).mp hd)
  have hc0 : c ≠ 0 := fun h0 => hpc (h0 ▸ dvd_zero _)
  have hxc : x * (b : ℚ) = (c : ℚ) := by
    rw [hcdef]; push_cast; linear_combination hab
  have hx0 : x ≠ 0 := by
    intro h0; rw [h0, zero_mul] at hxc; exact hc0 (by exact_mod_cast hxc.symm)
  have hinv : x⁻¹ * (c : ℚ) = (b : ℚ) := by rw [← hxc]; field_simp
  have hpn : ¬ p ∣ c.natAbs := by
    intro hd; apply hpc
    exact Int.dvd_natAbs.mp (Int.natCast_dvd_natCast.mpr hd)
  rcases Int.natAbs_eq c with hc | hc
  · refine ⟨(b : ℤ), c.natAbs, hpn, ?_⟩
    have h' : (c : ℚ) = ((c.natAbs : ℕ) : ℚ) := by rw [← Int.cast_natCast, ← hc]
    rw [pow_zero, one_mul, Int.cast_natCast]
    linear_combination -x⁻¹ * h' + hinv
  · refine ⟨-(b : ℤ), c.natAbs, hpn, ?_⟩
    have h' : (c : ℚ) = -((c.natAbs : ℕ) : ℚ) := by rw [← Int.cast_natCast, ← Int.cast_neg, ← hc]
    rw [pow_zero, one_mul, Int.cast_neg, Int.cast_natCast]
    linear_combination x⁻¹ * h' - hinv

private lemma D_one_add {e : ℕ} {x : ℚ} (h : D p e (x - 1)) : D p 0 x :=
  ((h.le (Nat.zero_le _)).add D.one).congr (by ring)

private lemma D_val {e : ℕ} {x : ℚ} (h : D p e x) (hx : x ≠ 0) : ((e : ℕ) : ℤ) ≤ padicValRat p x := by
  obtain ⟨a, b, hb, hab⟩ := h
  have hb0 : (b : ℚ) ≠ 0 := by
    intro h0; apply hb; rw [show b = 0 by exact_mod_cast h0]; exact dvd_zero _
  have ha0 : (a : ℚ) ≠ 0 := by
    intro h0; rw [h0, mul_zero] at hab; exact mul_ne_zero hx hb0 hab
  have hpq : (p : ℚ) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  have h1 := congrArg (padicValRat p) hab
  rw [padicValRat.mul hx hb0, padicValRat.mul (pow_ne_zero _ hpq) ha0, padicValRat.pow (p : ℚ),
    padicValRat.self hp.out.one_lt, padicValRat.of_nat, padicValRat.of_int,
    padicValNat.eq_zero_of_not_dvd hb] at h1
  have h2 : (0 : ℤ) ≤ (padicValInt p a : ℤ) := Nat.cast_nonneg _
  push_cast at h1
  linarith

theorem main' (h5 : 5 ≤ p) (n r : ℕ) (hn : 1 ≤ n) (hr : 1 ≤ r) :
    D p (3 * r) (a (n * p ^ r) - a (n * p ^ (r - 1))) := by
  have hp2 : p ≠ 2 := by omega
  have hp0 : 0 < p := hp.out.pos
  obtain ⟨ρ1, d1, h1⟩ := rho h5 (10 * n) (5 * n) r hr
  obtain ⟨ρ2, d2, h2⟩ := rho h5 (5 * n) n r hr
  obtain ⟨k, rfl⟩ : ∃ k, r = k + 1 := ⟨r - 1, by omega⟩
  simp only [Nat.add_sub_cancel] at h1 h2 ⊢
  set M := n * p ^ k with hM
  have hM1 : 1 ≤ M := by rw [hM]; have := pow_pos hp0 k; nlinarith
  have hNp : n * p ^ (k + 1) = p * M := by rw [hM]; ring
  rw [hNp]
  have g1 : 10 * n * p ^ (k + 1) = 10 * (p * M) := by rw [hM]; ring
  have g2 : 5 * n * p ^ (k + 1) = 5 * (p * M) := by rw [hM]; ring
  have g3 : n * p ^ (k + 1) = p * M := hNp
  have g4 : 10 * n * p ^ k = 10 * M := by rw [hM]; ring
  have g5 : 5 * n * p ^ k = 5 * M := by rw [hM]; ring
  rw [g1, g2, g4, g5] at h1
  rw [g2, g3, g5] at h2
  -- the Gamma part
  have hsplit := Gp_split hp0 (-((p * M : ℕ) : ℚ) / 2) M
  have hx : -((p * M : ℕ) : ℚ) / 2 / (p : ℚ) = -(M : ℚ) / 2 := by
    push_cast; field_simp
  rw [hx] at hsplit
  set ρ3 := R p (-((p * M : ℕ) : ℚ) / 2) (p * M) with hρ3
  have d3 : D p (3 * (k + 1)) (ρ3 - 1) := by
    have hA : D p 0 (-(n : ℚ) / 2) := by
      have hi2 : D p 0 ((2 : ℚ)⁻¹) := by
        simpa using D.inv (p := p) (show ¬ p ∣ 2 from Nat.not_dvd_of_pos_of_lt (by norm_num) (by omega))
      exact ((D.nat n).neg.mul0 hi2).congr (by ring)
    have := R_Dq h5 (by omega : 1 ≤ k + 1) (-(n : ℚ) / 2) hA n
    rw [hρ3]
    convert this using 2
    · rw [hM]; push_cast; ring
  have hG : Gh (p * M) = ρ3 * Gh M := by
    unfold Gh; rw [hsplit]
  have fa := a_formula (p * M) (by nlinarith)
  have fb := a_formula M hM1
  rw [h1, h2, hG] at fa
  have hGM := Gh_pos M
  have hGp := Gh_pos (p * M)
  have hρ30 : ρ3 ≠ 0 := by
    intro h0; rw [hG, h0, zero_mul] at hGp; exact lt_irrefl _ hGp
  set X := a M
  set Y := a (p * M)
  have hY : Y * ρ3 = X * (ρ1 * ρ2) := by
    have hc : Gh M * (3 / 2) ≠ 0 := by positivity
    apply mul_right_cancel₀ hc
    linear_combination fa - (ρ1 * ρ2) * fb
  have hdiff : Y - X = X * (ρ1 * ρ2 - ρ3) * ρ3⁻¹ := by
    field_simp
    linear_combination hY
  rw [hdiff]
  have e12 : D p (3 * (k + 1)) (ρ1 * ρ2 - ρ3) := by
    have a2 := D_one_add d2
    exact (((d1.mul0 a2).add d2).sub d3).congr (by ring)
  exact ((a_int M).mul0' e12).mul0 (D_inv_unit (by omega : 1 ≤ 3 * (k + 1)) d3)

end A364179P

theorem OMA.solution : type_of% @OMA.S_oeis_a364179.main := by
  intro p n r hp h5 hn hr
  haveI := Fact.mk hp
  have h := A364179P.main' h5 n r hn hr
  by_cases hd : OMA.S_oeis_a364179.a (n * p ^ r) - OMA.S_oeis_a364179.a (n * p ^ (r - 1)) = 0
  · exact Or.inl hd
  · exact Or.inr (A364179P.D_val h hd)
