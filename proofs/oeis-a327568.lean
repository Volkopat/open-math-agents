import OMAStatements.S_oeis_a327568
import Mathlib

-- Problem: OEIS A327568, a(n) = exponent of the group GL(2, Z/nZ).
-- Conjecture: a(p^e) = (p^2 - 1) p^e for primes p.
-- Statement: statements/oeis-a327568.lean (declaration OMA.S_oeis_a327568.main)
-- Credit: @schulzee (agent: Claude Code, model claude-fable-5-2)
--
-- Proof. Upper bound over the field Z/p (lemma field_bound). Let A be a 2 x 2 matrix over
-- Z/p with trace t and determinant d, and let delta = t - 2 A, so that delta^2 = D = t^2 - 4 d
-- is a scalar. For odd p the Frobenius map on the commutative ring generated by A gives
-- delta^p = t - 2 A^p, and also delta^p = D^((p-1)/2) delta = eta delta. Thus
-- 2 (A^p - A) = (1 - eta) delta and 2 (A^(p^2) - A) = (1 - eta^2) delta, and the square of
-- this is (1 - eta^2)^2 D = 0 because D^p = D. So N = A^(p^2) - A has N^2 = 0 (for p = 2 this
-- is a finite check). Then N^p = 0, A^(p^3) = A^p, and A^(p (p^2 - 1)) = 1 if A is invertible.
-- Upper bound over Z/p^e (lemma upper): for g in GL(2, Z/p^e), g^(p (p^2 - 1)) = 1 + p Y.
-- If z = 1 + p^i W with i >= 1 then z^p = 1 + p^(i+1) W' (geometric sum), so
-- (1 + p Y)^(p^(e-1)) = 1 + p^e W'' = 1.
-- Lower bound: the matrix [[1, 1], [0, 1]] has order p^e. The multiplication by a generator
-- of the cyclic group of units of the field with p^2 elements is a matrix in GL(2, p) of
-- order p^2 - 1 (lemma singer); a lift of it to Z/p^e is invertible, and its order is a
-- multiple of p^2 - 1. The numbers p^e and p^2 - 1 are coprime.

namespace OMA.A327568

open Matrix

section field
variable {p : ℕ} [hp : Fact p.Prime]

/-- `N = A^(p^2) - A` has square zero, for odd `p`. -/
lemma N_sq (hodd : p ≠ 2) (A : Matrix (Fin 2) (Fin 2) (ZMod p)) :
    (A ^ (p ^ 2) - A) * (A ^ (p ^ 2) - A) = 0 := by
  obtain ⟨k, hk⟩ : ∃ k, p = 2 * k + 1 := by
    rcases hp.out.eq_two_or_odd with h | h
    · exact absurd h hodd
    · exact ⟨p / 2, by omega⟩
  have h2 : (2 : ZMod p) ≠ 0 := by
    intro h
    have : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h
    rw [ZMod.natCast_eq_zero_iff] at this
    exact hodd ((Nat.prime_dvd_prime_iff_eq hp.out Nat.prime_two).mp this)
  set t := A.trace with ht
  set Δ := t ^ 2 - 4 * A.det with hΔ
  set δ : Matrix (Fin 2) (Fin 2) (ZMod p) := t • 1 - (2 : ZMod p) • A with hδ
  set η := Δ ^ k with hη
  have dsq : δ * δ = Δ • 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [hδ, hΔ, ht, Matrix.mul_apply, Fin.sum_univ_two, Matrix.trace_fin_two,
        Matrix.det_fin_two] <;> ring
  have hc1 : Commute (t • (1 : Matrix (Fin 2) (Fin 2) (ZMod p))) ((2 : ZMod p) • A) :=
    ((Commute.one_left A).smul_left t).smul_right 2
  have F2 : δ ^ p = t • 1 - (2 : ZMod p) • A ^ p := by
    rw [hδ, sub_pow_char_of_commute (p := p) (h := hc1), smul_pow, smul_pow, one_pow, ZMod.pow_card, ZMod.pow_card]
  have F3 : δ ^ p = η • δ := by
    have e : δ ^ p = δ ^ (2 * k + 1) := congrArg (fun n => δ ^ n) hk
    rw [e, pow_succ, pow_mul, pow_two, dsq, smul_pow, one_pow, smul_mul_assoc, one_mul]
  set u := A ^ p - A with hu
  have G1 : (2 : ZMod p) • u = (1 - η) • δ := by
    have : η • δ = t • 1 - (2 : ZMod p) • A ^ p := by rw [← F3, F2]
    rw [sub_smul, one_smul, this, hu, hδ, smul_sub]
    abel
  have hNu : A ^ (p ^ 2) - A = u ^ p + u := by
    have : u ^ p = (A ^ p) ^ p - A ^ p := by
      rw [hu, sub_pow_char_of_commute (p := p) (h := (Commute.refl A).pow_left p)]
    rw [this, hu, pow_two, pow_mul]
    abel
  have G2 : (2 : ZMod p) • u ^ p = ((1 - η) * η) • δ := by
    have : ((2 : ZMod p) • u) ^ p = (2 : ZMod p) • u ^ p := by rw [smul_pow, ZMod.pow_card]
    rw [← this, G1, smul_pow, ZMod.pow_card, F3, smul_smul]
  have G3 : (2 : ZMod p) • (A ^ (p ^ 2) - A) = ((1 - η) * (1 + η)) • δ := by
    rw [hNu, smul_add, G2, G1, ← add_smul]
    congr 1
    ring
  have hs : ((1 - η) * (1 + η)) * ((1 - η) * (1 + η)) * Δ = 0 := by
    have h1 : Δ ^ p = Δ := ZMod.pow_card Δ
    have e : Δ ^ p = Δ ^ (2 * k + 1) := congrArg (fun n => Δ ^ n) hk
    have h3 : (1 - η) * (1 + η) * Δ = Δ - Δ ^ p := by rw [e, hη]; ring
    rw [h1, sub_self] at h3
    rw [mul_assoc, h3, mul_zero]
  have G4 : ((2 : ZMod p) * 2) • ((A ^ (p ^ 2) - A) * (A ^ (p ^ 2) - A)) = 0 := by
    have : ((2 : ZMod p) • (A ^ (p ^ 2) - A)) * ((2 : ZMod p) • (A ^ (p ^ 2) - A))
        = ((2 : ZMod p) * 2) • ((A ^ (p ^ 2) - A) * (A ^ (p ^ 2) - A)) := by
      rw [smul_mul_smul_comm]
    rw [← this, G3, smul_mul_smul_comm, dsq, smul_smul, hs, zero_smul]
  rcases smul_eq_zero.mp G4 with h | h
  · exact absurd h (mul_ne_zero h2 h2)
  · exact h

lemma N_sq_two (A : Matrix (Fin 2) (Fin 2) (ZMod 2)) :
    (A ^ (2 ^ 2) - A) * (A ^ (2 ^ 2) - A) = 0 := by
  revert A
  decide

/-- Every invertible 2 x 2 matrix over `ZMod p` has `A ^ (p (p^2 - 1)) = 1`. -/
lemma field_bound (A : Matrix (Fin 2) (Fin 2) (ZMod p)) (hA : IsUnit A) :
    A ^ (p * (p ^ 2 - 1)) = 1 := by
  have hp2 := hp.out.two_le
  have hN : (A ^ (p ^ 2) - A) * (A ^ (p ^ 2) - A) = 0 := by
    by_cases h2 : p = 2
    · subst h2
      exact N_sq_two A
    · exact N_sq h2 A
  have hNp : (A ^ (p ^ 2) - A) ^ p = 0 := by
    obtain ⟨m, hm⟩ : ∃ m, p = 2 + m := ⟨p - 2, by omega⟩
    have e : (A ^ (p ^ 2) - A) ^ p = (A ^ (p ^ 2) - A) ^ (2 + m) :=
      congrArg (fun n => (A ^ (p ^ 2) - A) ^ n) hm
    rw [e, pow_add, pow_two, hN, zero_mul]
  rw [sub_pow_char_of_commute (p := p) (h := (Commute.refl A).pow_left _), sub_eq_zero, ← pow_mul] at hNp
  obtain ⟨g, rfl⟩ := hA
  have e : p ^ 2 * p = p * (p ^ 2 - 1) + p := by
    have : 1 ≤ p ^ 2 := Nat.one_le_pow _ _ (by omega)
    obtain ⟨m, hm⟩ : ∃ m, p ^ 2 = m + 1 := ⟨p ^ 2 - 1, by omega⟩
    rw [hm]
    simp
    ring
  have h3 : g ^ (p * (p ^ 2 - 1)) * g ^ p = 1 * g ^ p := by
    rw [← pow_add, ← e, one_mul]
    exact Units.ext (by simpa using hNp)
  have := mul_right_cancel h3
  simpa using congrArg Units.val this

end field

section lift
variable {S : Type*} [Ring S]

lemma powA (p : ℕ) (z W : S) (hz : z = 1 + (p : S) * W) : ∀ j : ℕ, ∃ V, z ^ j = 1 + (p : S) * V := by
  intro j
  induction j with
  | zero => exact ⟨0, by simp⟩
  | succ j ih =>
    obtain ⟨V, hV⟩ := ih
    refine ⟨W + V + V * ((p : S) * W), ?_⟩
    rw [pow_succ, hV, hz]
    noncomm_ring

lemma sumA (p : ℕ) (z W : S) (hz : z = 1 + (p : S) * W) :
    ∀ n : ℕ, ∃ U, ∑ j ∈ Finset.range n, z ^ j = (n : S) + (p : S) * U := by
  intro n
  induction n with
  | zero => exact ⟨0, by simp⟩
  | succ n ih =>
    obtain ⟨U, hU⟩ := ih
    obtain ⟨V, hV⟩ := powA p z W hz n
    refine ⟨U + V, ?_⟩
    rw [Finset.sum_range_succ, hU, hV]
    push_cast
    noncomm_ring

lemma powB (p i : ℕ) (z W : S) (hz : z = 1 + (p : S) ^ (i + 1) * W) :
    ∃ W', z ^ p = 1 + (p : S) ^ (i + 2) * W' := by
  have hz' : z = 1 + (p : S) * ((p : S) ^ i * W) := by rw [hz, pow_succ', mul_assoc]
  obtain ⟨U, hU⟩ := sumA p z _ hz' p
  have h1 : (z - 1) * ∑ j ∈ Finset.range p, z ^ j = z ^ p - 1 := mul_geom_sum z p
  have hc : W * (p : S) = (p : S) * W := ((Nat.cast_commute p W).eq).symm
  refine ⟨W * (1 + U), ?_⟩
  have h2 : z ^ p = 1 + (z - 1) * ∑ j ∈ Finset.range p, z ^ j := by rw [h1]; abel
  rw [h2, hU]
  have h3 : z - 1 = (p : S) ^ (i + 1) * W := by rw [hz]; abel
  rw [h3]
  have h4 : (p : S) ^ (i + 1) * W * ((p : S) + (p : S) * U)
      = (p : S) ^ (i + 1) * (W * (p : S)) * (1 + U) := by noncomm_ring
  rw [h4, hc, pow_succ (p : S) (i + 1)]
  noncomm_ring

lemma powC (p : ℕ) (z W : S) (hz : z = 1 + (p : S) * W) :
    ∀ k : ℕ, ∃ W', z ^ (p ^ k) = 1 + (p : S) ^ (k + 1) * W' := by
  intro k
  induction k with
  | zero => exact ⟨W, by simpa using hz⟩
  | succ k ih =>
    obtain ⟨W1, hW1⟩ := ih
    obtain ⟨W2, hW2⟩ := powB p k (z ^ (p ^ k)) W1 hW1
    exact ⟨W2, by rw [pow_succ, pow_mul, hW2]⟩

end lift

section ring
variable {p e : ℕ} [hp : Fact p.Prime]

lemma ker_cast (he : 1 ≤ e) (r : ZMod (p ^ e))
    (h : ZMod.castHom (dvd_pow_self p (by omega : e ≠ 0)) (ZMod p) r = 0) :
    ∃ s : ZMod (p ^ e), r = (p : ZMod (p ^ e)) * s := by
  have : NeZero (p ^ e) := ⟨pow_ne_zero e hp.out.ne_zero⟩
  have hr : ((r.val : ℕ) : ZMod (p ^ e)) = r := ZMod.natCast_zmod_val r
  rw [← hr, map_natCast, ZMod.natCast_eq_zero_iff] at h
  obtain ⟨m, hm⟩ := h
  exact ⟨(m : ZMod (p ^ e)), by rw [← hr, hm]; push_cast; ring⟩

lemma unit_cast (he : 1 ≤ e) (r : ZMod (p ^ e))
    (h : ZMod.castHom (dvd_pow_self p (by omega : e ≠ 0)) (ZMod p) r ≠ 0) : IsUnit r := by
  have : NeZero (p ^ e) := ⟨pow_ne_zero e hp.out.ne_zero⟩
  have hr : ((r.val : ℕ) : ZMod (p ^ e)) = r := ZMod.natCast_zmod_val r
  rw [← hr, map_natCast, Ne, ZMod.natCast_eq_zero_iff] at h
  rw [← hr, ZMod.isUnit_iff_coprime]
  exact Nat.Coprime.pow_right e ((Nat.Prime.coprime_iff_not_dvd hp.out).mpr h).symm

lemma upper (he : 1 ≤ e) (g : GL (Fin 2) (ZMod (p ^ e))) : g ^ ((p ^ 2 - 1) * p ^ e) = 1 := by
  have hne : NeZero (p ^ e) := ⟨pow_ne_zero e hp.out.ne_zero⟩
  set φ := ZMod.castHom (dvd_pow_self p (by omega : e ≠ 0)) (ZMod p) with hφ
  set A : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e)) := (g : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e))) with hA
  have hB : IsUnit (φ.mapMatrix A) := (g.isUnit).map φ.mapMatrix
  have h1 : φ.mapMatrix (A ^ (p * (p ^ 2 - 1)) - 1) = 0 := by
    rw [map_sub, map_pow, map_one, field_bound _ hB, sub_self]
  have h2 : ∀ i j, ∃ s : ZMod (p ^ e),
      (A ^ (p * (p ^ 2 - 1)) - 1 : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e))) i j = (p : ZMod (p ^ e)) * s := by
    intro i j
    apply ker_cast he
    have h := congrFun (congrFun h1 i) j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.zero_apply] at h
    exact h
  choose Y hY using h2
  have h3 : A ^ (p * (p ^ 2 - 1)) = 1 + (p : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e))) * Matrix.of Y := by
    have : A ^ (p * (p ^ 2 - 1)) - 1 = (p : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e))) * Matrix.of Y := by
      rw [← nsmul_eq_mul]
      ext i j
      rw [Matrix.smul_apply, nsmul_eq_mul, hY i j]
      rfl
    rw [← this]
    abel
  obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
  obtain ⟨W, hW⟩ := powC p _ _ h3 e'
  have h0 : (p : Matrix (Fin 2) (Fin 2) (ZMod (p ^ (e' + 1)))) ^ (e' + 1) = 0 := by
    rw [← Nat.cast_pow]
    exact CharP.cast_eq_zero _ _
  rw [h0, zero_mul, add_zero, ← pow_mul] at hW
  have hexp : p * (p ^ 2 - 1) * p ^ e' = (p ^ 2 - 1) * p ^ (e' + 1) := by ring
  rw [hexp] at hW
  exact Units.ext (by simpa [hA] using hW)

lemma unip_pow (R : Type*) [CommRing R] (k : ℕ) :
    (!![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) R) ^ k = !![1, (k : R); 0, 1] := by
  induction k with
  | zero =>
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  | succ k ih =>
    rw [pow_succ, ih]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
    ring

lemma lower_p : p ^ e ∣ Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) := by
  have hu : IsUnit (!![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e))) := by
    rw [Matrix.isUnit_iff_isUnit_det, Matrix.det_fin_two_of]
    simp
  obtain ⟨u, hu'⟩ := hu
  have h1 : u ^ Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) = 1 := Monoid.pow_exponent_eq_one u
  have h2 := congrArg (fun v : GL (Fin 2) (ZMod (p ^ e)) => (v : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e))) 0 1) h1
  simp only [Units.val_pow_eq_pow_val, hu', unip_pow] at h2
  have h3 : ((Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) : ℕ) : ZMod (p ^ e)) = 0 := by
    simpa using h2
  exact (ZMod.natCast_eq_zero_iff _ _).mp h3

/-- A matrix in GL(2, p) whose order is `p^2 - 1`. -/
lemma singer : ∃ g0 : Matrix (Fin 2) (Fin 2) (ZMod p), IsUnit g0 ∧
    ∀ k : ℕ, g0 ^ k = 1 → (p ^ 2 - 1) ∣ k := by
  have hcard : Nat.card (GaloisField p 2) = p ^ 2 := GaloisField.card p 2 (by norm_num)
  have : Finite (GaloisField p 2) := Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero 2 hp.out.ne_zero)
  obtain ⟨γ, hγ⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := (GaloisField p 2)ˣ)
  have hcu : Nat.card (GaloisField p 2)ˣ = p ^ 2 - 1 := by rw [Nat.card_units, hcard]
  let b := Module.finBasisOfFinrankEq (ZMod p) (GaloisField p 2) (GaloisField.finrank p (by norm_num))
  refine ⟨Algebra.leftMulMatrix b (γ : GaloisField p 2), (γ.isUnit).map (Algebra.leftMulMatrix b), ?_⟩
  intro k hk
  rw [← map_pow, ← map_one (Algebra.leftMulMatrix b)] at hk
  have h1 := Algebra.leftMulMatrix_injective b hk
  have h2 : γ ^ k = 1 := Units.ext (by simpa using h1)
  rw [← hcu, ← hγ]
  exact orderOf_dvd_of_pow_eq_one h2

lemma lower_q (he : 1 ≤ e) : (p ^ 2 - 1) ∣ Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) := by
  have hne : NeZero (p ^ e) := ⟨pow_ne_zero e hp.out.ne_zero⟩
  have hnp : NeZero p := ⟨hp.out.ne_zero⟩
  set φ := ZMod.castHom (dvd_pow_self p (by omega : e ≠ 0)) (ZMod p) with hφ
  obtain ⟨g0, hg0, hord⟩ := singer (p := p)
  let N : Matrix (Fin 2) (Fin 2) (ZMod (p ^ e)) := Matrix.of (fun i j => (((g0 i j).val : ℕ) : ZMod (p ^ e)))
  have hN : φ.mapMatrix N = g0 := by
    ext i j
    simp [N, RingHom.mapMatrix_apply]
  have hdet : IsUnit N.det := by
    apply unit_cast he
    rw [← hφ, RingHom.map_det, hN]
    exact ((Matrix.isUnit_iff_isUnit_det g0).mp hg0).ne_zero
  obtain ⟨u, hu⟩ := (Matrix.isUnit_iff_isUnit_det N).mpr hdet
  have h1 : u ^ Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) = 1 := Monoid.pow_exponent_eq_one u
  have h2 : N ^ Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) = 1 := by
    rw [← hu, ← Units.val_pow_eq_pow_val, h1]
    rfl
  apply hord
  rw [← hN, ← map_pow, h2, map_one]

theorem result (he : 1 ≤ e) :
    Monoid.exponent (GL (Fin 2) (ZMod (p ^ e))) = (p ^ 2 - 1) * p ^ e := by
  apply Nat.dvd_antisymm
  · exact Monoid.exponent_dvd_of_forall_pow_eq_one (fun g => upper he g)
  · have hcop : Nat.Coprime (p ^ 2 - 1) (p ^ e) := by
      apply Nat.Coprime.pow_right
      rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd hp.out]
      intro h
      have h1 : 1 ≤ p ^ 2 := Nat.one_le_pow _ _ hp.out.pos
      have h2 : p ∣ p ^ 2 := dvd_pow_self p (by norm_num)
      have h3 : p ∣ p ^ 2 - (p ^ 2 - 1) := Nat.dvd_sub h2 h
      rw [show p ^ 2 - (p ^ 2 - 1) = 1 by omega] at h3
      exact hp.out.one_lt.ne' (Nat.dvd_one.mp h3)
    exact hcop.mul_dvd_of_dvd_of_dvd (lower_q he) lower_p

end ring

end OMA.A327568

theorem OMA.solution : type_of% @OMA.S_oeis_a327568.main := by
  intro p e hp he
  have : Fact p.Prime := ⟨hp⟩
  exact OMA.A327568.result he
