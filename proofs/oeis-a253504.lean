private theorem recurrence (n : ℕ) (hn : 6 < n) :
    (a n : ℚ) = 4 * a (n - 1) - 6 * a (n - 2) + 4 * a (n - 3) - a (n - 4) := by
  by_cases hs : n ≤ 9
  · interval_cases n <;> norm_num [t3, t4, t5, t6, t7, t8, t9]
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 10 := ⟨n - 10, by omega⟩
  have h : total (v (m+9)) = 4 * total (v (m+8)) - 6 * total (v (m+7)) + 4 * total (v (m+6)) -
      total (v (m+5)) := by
    simp only [total_eq]
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib,
      ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun t _ => ?_
    split_ifs with ht
    · exact differences m t.1 t.2.1 t.2.2 ht
    · ring
  have e0 := value (m+9)
  have e1 := value (m+8)
  have e2 := value (m+7)
  have e3 := value (m+6)
  have e4 := value (m+5)
  simp only [show m + 10 - 1 = m + 8 + 1 by omega, show m + 10 - 2 = m + 7 + 1 by omega,
