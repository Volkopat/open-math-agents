import OMAStatements.S_oeis_a253504
import Mathlib

namespace OMA.Helpers_a253504

open OMA.S_oeis_a253504
open PowerSeries

private abbrev Row := Fin 4 → Fin 2

private def D2 (p q : Row) (j : ℕ) (hj : j < 3) : ℤ :=
  max ((p ⟨j, by omega⟩).val : ℤ) ((q ⟨j + 1, by omega⟩).val : ℤ) -
    min ((p ⟨j + 1, by omega⟩).val : ℤ) ((q ⟨j, by omega⟩).val : ℤ)

private def D3 (p q r : Row) (j : ℕ) (hj : j < 2) : ℤ :=
  max (max ((p ⟨j, by omega⟩).val : ℤ) ((q ⟨j + 1, by omega⟩).val : ℤ))
      ((r ⟨j + 2, by omega⟩).val : ℤ) -
    min (min ((p ⟨j + 2, by omega⟩).val : ℤ) ((q ⟨j + 1, by omega⟩).val : ℤ))
      ((r ⟨j, by omega⟩).val : ℤ)

private def H2 (p q : Row) : Prop :=
  D2 p q 0 (by omega) ≤ D2 p q 1 (by omega) ∧ D2 p q 1 (by omega) ≤ D2 p q 2 (by omega)

private def V2 (p q r : Row) : Prop :=
  D2 p q 0 (by omega) ≤ D2 q r 0 (by omega) ∧ D2 p q 1 (by omega) ≤ D2 q r 1 (by omega) ∧
    D2 p q 2 (by omega) ≤ D2 q r 2 (by omega)

private def H3 (p q r : Row) : Prop := D3 p q r 0 (by omega) ≤ D3 p q r 1 (by omega)

private def V3 (p q r s : Row) : Prop :=
  D3 p q r 0 (by omega) ≤ D3 q r s 0 (by omega) ∧ D3 p q r 1 (by omega) ≤ D3 q r s 1 (by omega)

/-- The conditions on the first three rows. -/
private def start (p q r : Row) : Prop := H2 p q ∧ H2 q r ∧ V2 p q r ∧ H3 p q r

private instance (p q r : Row) : Decidable (start p q r) := by
  unfold start H2 V2 H3; infer_instance

/-- The new conditions when the row s is added below the rows p, q, r. -/
private def next (p q r s : Row) : Prop := H2 r s ∧ V2 q r s ∧ H3 q r s ∧ V3 p q r s

private instance (p q r s : Row) : Decidable (next p q r s) := by
  unfold next H2 V2 H3 V3; infer_instance

private theorem next_start {p q r s : Row} (h : start p q r) (h' : next p q r s) : start q r s :=
  ⟨h.2.1, h'.1, h'.2.1, h'.2.2.1⟩

private theorem fin4_c3 (j j' j'' : Fin 4) (h1 : j'.val = j.val + 1) (h2 : j''.val = j'.val + 1) :
    (j = 0 ∧ j' = 1 ∧ j'' = 2) ∨ (j = 1 ∧ j' = 2 ∧ j'' = 3) := by
  fin_cases j <;> fin_cases j' <;> fin_cases j'' <;> simp_all

private theorem fin4_c2 (j j' : Fin 4) (h1 : j'.val = j.val + 1) :
    (j = 0 ∧ j' = 1) ∨ (j = 1 ∧ j' = 2) ∨ (j = 2 ∧ j' = 3) := by
  fin_cases j <;> fin_cases j' <;> simp_all

private theorem fin4_c4 (j j' j'' j''' : Fin 4) (h1 : j'.val = j.val + 1)
    (h2 : j''.val = j'.val + 1) (h3 : j'''.val = j''.val + 1) :
    j = 0 ∧ j' = 1 ∧ j'' = 2 ∧ j''' = 3 := by
  fin_cases j <;> fin_cases j' <;> fin_cases j'' <;> fin_cases j''' <;> simp_all

private theorem hor2_iff {m : ℕ} (x : Fin (m + 1) → Row) :
    Horizontal2 x ↔ ∀ i : Fin m, H2 (x i.castSucc) (x i.succ) := by
  constructor
  · intro h i
    exact ⟨h i.castSucc i.succ (by simp) 0 1 2 rfl rfl, h i.castSucc i.succ (by simp) 1 2 3 rfl rfl⟩
  · intro h i i' hi j j' j'' hj hj'
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).succ := Fin.ext (by simp [hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2] at hh
    rcases fin4_c3 j j' j'' hj hj' with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · exact hh.1
    · exact hh.2

private theorem vert2_iff {m : ℕ} (x : Fin (m + 2) → Row) :
    Vertical2 x ↔ ∀ i : Fin m, V2 (x i.castSucc.castSucc) (x i.castSucc.succ) (x i.succ.succ) := by
  constructor
  · intro h i
    have hs := fun j j' (hj : j'.val = j.val + 1) =>
      h i.castSucc.castSucc i.castSucc.succ i.succ.succ (by simp) (by simp) j j' hj
    exact ⟨hs 0 1 rfl, hs 1 2 rfl, hs 2 3 rfl⟩
  · intro h i i' i'' hi hi' j j' hj
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc.castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).castSucc.succ := Fin.ext (by simp [hi])
    have e3 : i'' = (⟨i.val, hlt⟩ : Fin m).succ.succ := Fin.ext (by simp [hi', hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2, ← e3] at hh
    rcases fin4_c2 j j' hj with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hh.1
    · exact hh.2.1
    · exact hh.2.2

private theorem hor3_iff {m : ℕ} (x : Fin (m + 2) → Row) :
    Horizontal3 x ↔ ∀ i : Fin m, H3 (x i.castSucc.castSucc) (x i.castSucc.succ) (x i.succ.succ) := by
  constructor
  · intro h i
    exact h i.castSucc.castSucc i.castSucc.succ i.succ.succ (by simp) (by simp) 0 1 2 3 rfl rfl rfl
  · intro h i i' i'' hi hi' j j' j'' j''' hj hj' hj''
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc.castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).castSucc.succ := Fin.ext (by simp [hi])
    have e3 : i'' = (⟨i.val, hlt⟩ : Fin m).succ.succ := Fin.ext (by simp [hi', hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2, ← e3] at hh
    obtain ⟨rfl, rfl, rfl, rfl⟩ := fin4_c4 j j' j'' j''' hj hj' hj''
    exact hh

private theorem vert3_iff {m : ℕ} (x : Fin (m + 3) → Row) :
    Vertical3 x ↔ ∀ i : Fin m, V3 (x i.castSucc.castSucc.castSucc) (x i.castSucc.castSucc.succ)
      (x i.castSucc.succ.succ) (x i.succ.succ.succ) := by
  constructor
  · intro h i
    have hs := fun j j' j'' (hj : j'.val = j.val + 1) (hj' : j''.val = j'.val + 1) =>
      h i.castSucc.castSucc.castSucc i.castSucc.castSucc.succ i.castSucc.succ.succ i.succ.succ.succ
        (by simp) (by simp) (by simp) j j' j'' hj hj'
    exact ⟨hs 0 1 2 rfl rfl, hs 1 2 3 rfl rfl⟩
  · intro h i i' i'' i''' hi hi' hi'' j j' j'' hj hj'
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc.castSucc.castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).castSucc.castSucc.succ := Fin.ext (by simp [hi])
    have e3 : i'' = (⟨i.val, hlt⟩ : Fin m).castSucc.succ.succ := Fin.ext (by simp [hi', hi])
    have e4 : i''' = (⟨i.val, hlt⟩ : Fin m).succ.succ.succ := Fin.ext (by simp [hi'', hi', hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2, ← e3, ← e4] at hh
    rcases fin4_c3 j j' j'' hj hj' with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · exact hh.1
    · exact hh.2

private def good {n : ℕ} (p q r : Row) (x : Fin n → Row) : Prop :=
  ∀ i : Fin n,
    let y : Fin (n+3) → Row := Fin.cons p (Fin.cons q (Fin.cons r x))
    next (y i.castSucc.castSucc.castSucc) (y i.castSucc.castSucc.succ) (y i.castSucc.succ.succ) (x i)

private theorem array_iff {n : ℕ} (x : Fin (n+3) → Row) :
    (Horizontal2 x ∧ Vertical2 x ∧ Horizontal3 x ∧ Vertical3 x) ↔
      start (x 0) (x 1) (x 2) ∧ good (x 0) (x 1) (x 2) (fun i => x i.succ.succ.succ) := by
  have reconstruct : Fin.cons (x 0) (Fin.cons (x 1) (Fin.cons (x 2)
      (fun i : Fin n => x i.succ.succ.succ))) = x := by
    funext j
    refine Fin.cases rfl (fun i => ?_) j
    refine Fin.cases rfl (fun i => ?_) i
    exact Fin.cases rfl (fun _ => rfl) i
  simp only [hor2_iff, vert2_iff, hor3_iff, vert3_iff, good, reconstruct, next, start]
  simp only [Fin.forall_fin_succ]
  constructor
  · rintro ⟨⟨a0, a1, a2⟩, ⟨b0, b1⟩, ⟨c0, c1⟩, d⟩
    exact ⟨⟨a0, a1, b0, c0⟩, fun i => ⟨a2 i, b1 i, c1 i, d i⟩⟩
  · rintro ⟨⟨a0, a1, b0, c0⟩, h⟩
    exact ⟨⟨a0, a1, fun i => (h i).1⟩, ⟨b0, fun i => (h i).2.1⟩, ⟨c0, fun i => (h i).2.2.1⟩,
      fun i => (h i).2.2.2⟩

private theorem split_good {n : ℕ} (p q r : Row) (x : Fin (n+1) → Row) :
    good p q r x ↔ next p q r (x 0) ∧ good q r (x 0) (fun i => x i.succ) := by
  simp only [good, Fin.forall_fin_succ]
  have reconstruct : Fin.cons (x 0) (fun i => x i.succ) = x := Fin.cons_self_tail _
  rw [reconstruct]
  exact Iff.rfl

private abbrev Chain (n : ℕ) (p q r : Row) := {x : Fin n → Row // good p q r x}

private noncomputable instance (n : ℕ) (p q r : Row) : Fintype (Chain n p q r) :=
  Fintype.ofFinite _

private def splitChain (n : ℕ) (p q r : Row) :
    Chain (n+1) p q r ≃ (Σ s : {s : Row // next p q r s}, Chain n q r s.val) where
  toFun x :=
    let h := (split_good p q r x.val).mp x.property
    ⟨⟨x.val 0, h.1⟩, ⟨fun i => x.val i.succ, h.2⟩⟩
  invFun y := ⟨Fin.cons y.1.val y.2.val, (split_good _ _ _ _).mpr (by
    simpa only [Fin.cons_zero, Fin.cons_succ] using And.intro y.1.property y.2.property)⟩
  left_inv x := Subtype.ext (Fin.cons_self_tail _)
  right_inv y := by rcases y with ⟨⟨s, hs⟩, ⟨x, hx⟩⟩; rfl

private abbrev Triple := {t : Row × Row × Row // start t.1 t.2.1 t.2.2}

private def splitArray (n : ℕ) :
    {x : Fin (n+3) → Row // Horizontal2 x ∧ Vertical2 x ∧ Horizontal3 x ∧ Vertical3 x} ≃
      (Σ t : Triple, Chain n t.val.1 t.val.2.1 t.val.2.2) where
  toFun x :=
    let h := (array_iff x.val).mp x.property
    ⟨⟨(x.val 0, x.val 1, x.val 2), h.1⟩, ⟨fun i => x.val i.succ.succ.succ, h.2⟩⟩
  invFun y := ⟨Fin.cons y.1.val.1 (Fin.cons y.1.val.2.1 (Fin.cons y.1.val.2.2 y.2.val)),
    (array_iff _).mpr ⟨y.1.property, y.2.property⟩⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    refine Fin.cases rfl (fun j => ?_) i
    refine Fin.cases rfl (fun j => ?_) j
    exact Fin.cases rfl (fun _ => rfl) j
  right_inv y := by rcases y with ⟨⟨⟨p, q, r⟩, hp⟩, ⟨x, hx⟩⟩; rfl

private noncomputable def v (n : ℕ) (p q r : Row) : ℤ := Fintype.card (Chain n p q r)

private def step (f : Row → Row → Row → ℤ) (p q r : Row) : ℤ :=
  ∑ s : {s : Row // next p q r s}, f q r s.val

private theorem succ_v (n : ℕ) : v (n+1) = step (v n) := by
  funext p q r
  simp [step, v, Fintype.card_congr (splitChain n p q r), Fintype.card_sigma]

private theorem zero_v : v 0 = fun _ _ _ => 1 := by
  funext p q r
  have : Unique (Chain 0 p q r) :=
    { default := ⟨Fin.elim0, fun i => i.elim0⟩
      uniq := fun _ => Subtype.ext (funext fun i => i.elim0) }
  simp [v]

private def total (f : Row → Row → Row → ℤ) : ℤ := ∑ t : Triple, f t.val.1 t.val.2.1 t.val.2.2

private theorem value (n : ℕ) : (a (n+1) : ℤ) = total (v n) := by
  have h := Fintype.card_congr (splitArray n)
  simp only [Fintype.card_sigma] at h
  unfold a total v
  rw [← Fintype.card_subtype, h]
  push_cast
  rfl

private def code (r : Row) : Fin 16 :=
  ⟨8 * (r 0).val + 4 * (r 1).val + 2 * (r 2).val + (r 3).val, by omega⟩

private def dec (i : Fin 16) : Row := fun j =>
  ⟨(i.val / 2 ^ (3 - j.val)) % 2, Nat.mod_lt _ (by norm_num)⟩

private theorem code_dec : ∀ i : Fin 16, code (dec i) = i := by decide +kernel

private theorem dec_code : ∀ r : Row, dec (code r) = r := by decide +kernel

private abbrev Idx := Fin 16 × Fin 16 × Fin 16

private def ok (t : Idx) : Prop := start (dec t.1) (dec t.2.1) (dec t.2.2)

private instance (t : Idx) : Decidable (ok t) := by unfold ok; infer_instance

private theorem total_eq (f : Row → Row → Row → ℤ) :
    total f = ∑ t : Idx, if ok t then f (dec t.1) (dec t.2.1) (dec t.2.2) else 0 := by
  unfold total
  rw [← Finset.sum_filter]
  let e : Triple ≃ {t : Idx // ok t} :=
    { toFun := fun t => ⟨(code t.val.1, code t.val.2.1, code t.val.2.2), by
        show start _ _ _
        rw [dec_code, dec_code, dec_code]; exact t.property⟩
      invFun := fun t => ⟨(dec t.val.1, dec t.val.2.1, dec t.val.2.2), t.property⟩
      left_inv := fun t => Subtype.ext (Prod.ext (dec_code _) (Prod.ext (dec_code _) (dec_code _)))
      right_inv := fun t => Subtype.ext (Prod.ext (code_dec _) (Prod.ext (code_dec _) (code_dec _))) }
  rw [Fintype.sum_equiv e _ (fun t => f (dec t.val.1) (dec t.val.2.1) (dec t.val.2.2)) (fun t => by
    show f t.val.1 t.val.2.1 t.val.2.2 =
      f (dec (code t.val.1)) (dec (code t.val.2.1)) (dec (code t.val.2.2))
    rw [dec_code, dec_code, dec_code])]
  symm
  apply Finset.sum_subtype
  intro t
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

private def stepC (f : Fin 16 → Fin 16 → Fin 16 → ℤ) (i j k : Fin 16) : ℤ :=
  ∑ l ∈ Finset.univ.filter (fun l : Fin 16 => next (dec i) (dec j) (dec k) (dec l)), f j k l

private theorem step_eq (f : Row → Row → Row → ℤ) (i j k : Fin 16) :
    step f (dec i) (dec j) (dec k) = stepC (fun a b c => f (dec a) (dec b) (dec c)) i j k := by
  unfold step stepC
  let e : {r : Row // next (dec i) (dec j) (dec k) r} ≃
      {l : Fin 16 // next (dec i) (dec j) (dec k) (dec l)} :=
    { toFun := fun r => ⟨code r.val, by rw [dec_code]; exact r.property⟩
      invFun := fun l => ⟨dec l.val, l.property⟩
      left_inv := fun r => Subtype.ext (dec_code _)
      right_inv := fun l => Subtype.ext (code_dec l.val) }
  rw [Fintype.sum_equiv e _ (fun l => f (dec j) (dec k) (dec l.val)) (fun r => by
    show f (dec j) (dec k) r.val = f (dec j) (dec k) (dec (code r.val))
    rw [dec_code])]
  symm
  apply Finset.sum_subtype
  intro l
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

private theorem mem_succ {i j k l : Fin 16} (h : ok (i, j, k))
    (hl : l ∈ Finset.univ.filter (fun l : Fin 16 => next (dec i) (dec j) (dec k) (dec l))) :
    ok (j, k, l) := next_start h (Finset.mem_filter.mp hl).2

