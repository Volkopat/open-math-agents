private def T : Fin 10 → Fin 16 → Fin 16 → Fin 16 → ℤ :=
  ![fun _ _ _ => 1, T1, T2, T3, T4, T5, T6, T7, T8, T9]

private theorem table_step0 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 1 i j l = stepC (T 0) i j l := by decide +kernel

private theorem table_step1 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 2 i j l = stepC (T 1) i j l := by decide +kernel

private theorem table_step2 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 3 i j l = stepC (T 2) i j l := by decide +kernel

private theorem table_step3 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 4 i j l = stepC (T 3) i j l := by decide +kernel

private theorem table_step4 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 5 i j l = stepC (T 4) i j l := by decide +kernel

private theorem table_step5 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 6 i j l = stepC (T 5) i j l := by decide +kernel

private theorem table_step6 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 7 i j l = stepC (T 6) i j l := by decide +kernel

private theorem table_step7 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 8 i j l = stepC (T 7) i j l := by decide +kernel

private theorem table_step8 : ∀ i j l : Fin 16, ok (i, j, l) →
    T 9 i j l = stepC (T 8) i j l := by decide +kernel

private theorem table_step (k : Fin 9) : ∀ i j l : Fin 16, ok (i, j, l) →
    T k.succ i j l = stepC (T k.castSucc) i j l := by
  fin_cases k
  · exact table_step0
  · exact table_step1
  · exact table_step2
  · exact table_step3
  · exact table_step4
  · exact table_step5
  · exact table_step6
  · exact table_step7
  · exact table_step8

private theorem initial_eq (k : Fin 10) : ∀ i j l : Fin 16, ok (i, j, l) →
    v k.val (dec i) (dec j) (dec l) = T k i j l := by
  induction k using Fin.induction with
  | zero =>
    intro i j l _
    simp only [Fin.val_zero, zero_v]
    rfl
  | succ k ih =>
    intro i j l hijl
    simp only [Fin.val_castSucc] at ih
    rw [Fin.val_succ, succ_v, step_eq, table_step k i j l hijl]
    unfold stepC
    exact Finset.sum_congr rfl fun m hm => ih j l m (mem_succ hijl hm)

set_option maxHeartbeats 4000000 in
private theorem differences (n : ℕ) : ∀ i j l : Fin 16, ok (i, j, l) →
    v (n+9) (dec i) (dec j) (dec l) = 4 * v (n+8) (dec i) (dec j) (dec l) -
      6 * v (n+7) (dec i) (dec j) (dec l) + 4 * v (n+6) (dec i) (dec j) (dec l) -
      v (n+5) (dec i) (dec j) (dec l) := by
  induction n with
  | zero =>
    intro i j l h
    have e5 : v 5 (dec i) (dec j) (dec l) = T 5 i j l := initial_eq 5 i j l h
    have e6 : v 6 (dec i) (dec j) (dec l) = T 6 i j l := initial_eq 6 i j l h
    have e7 : v 7 (dec i) (dec j) (dec l) = T 7 i j l := initial_eq 7 i j l h
    have e8 : v 8 (dec i) (dec j) (dec l) = T 8 i j l := initial_eq 8 i j l h
    have e9 : v 9 (dec i) (dec j) (dec l) = T 9 i j l := initial_eq 9 i j l h
    simp only [Nat.zero_add, e5, e6, e7, e8, e9]
    clear e5 e6 e7 e8 e9
    revert i j l h
    decide +kernel
  | succ n ih =>
    intro i j l h
    change v ((n+9)+1) (dec i) (dec j) (dec l) = _
    rw [succ_v (n+9), step_eq]
    unfold stepC
    rw [Finset.sum_congr rfl (fun m hm => ih j l m (mem_succ h hm))]
    simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
    have sum_v (t : ℕ) :
        (∑ m ∈ Finset.univ.filter (fun m : Fin 16 => next (dec i) (dec j) (dec l) (dec m)),
          v t (dec j) (dec l) (dec m)) = v (t+1) (dec i) (dec j) (dec l) := by
      rw [succ_v, step_eq]; rfl
    simp only [sum_v]

private theorem initial_total (k : Fin 10) :
    total (v k.val) = ∑ t : Idx, if ok t then T k t.1 t.2.1 t.2.2 else 0 := by
  rw [total_eq]
  refine Finset.sum_congr rfl fun t _ => ?_
  split_ifs with h
  · exact initial_eq k t.1 t.2.1 t.2.2 h
  · rfl

