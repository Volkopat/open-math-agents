/-! Soundness of density-constrained minimum-degree extension certificates for the eleven- and
twelve-vertex cases. Supplying certificates for the two finite classifications implies H4. -/

/- Cutoffs and extension rules for the last two orders of the small graph covering. -/
namespace Astra1182.Large
def literal {α : Type} (n : Nat) (f : Nat → α) : α :=
  match n with
  | 0 => f 0
  | m+1 => f (m+1)

theorem literal_eq {α : Type} (n : Nat) (f : Nat → α) : literal n f = f n := by
  cases n <;> rfl

def upper (N : Nat) : Nat := if N=11 then 32 else 43
def threshold (N : Nat) (k : Nat) : Nat :=
  if N=11 then
    match k with
    | 2 => 1 | 3 => 3 | 4 => 5 | 5 => 7 | 6 => 10 | 7 => 14 | 8 => 18
    | 9 => 22 | 10 => 27 | 11 => 32 | _ => 0
  else
    match k with
    | 2 => 1 | 3 => 3 | 4 => 5 | 5 => 8 | 6 => 11 | 7 => 15 | 8 => 19
    | 9 => 24 | 10 => 30 | 11 => 36 | 12 => 43 | _ => 0

def pair (N t i j : Nat) := let a:=min i j; let b:=max i j
  decide (i≠j) && t.testBit (a*(2*N-1-a)/2 + b-a-1)
def augment (N n t h i j : Nat) := if i=j then false else
  if max i j=n then h.testBit (min i j) else pair N t i j
def count (N : Nat) : Nat := if N=11 then 2 else 4
def order (N : Nat) (kind : Fin (count N)) : Nat :=
  if N=11 then (if kind.val=0 then 10 else 9) else
    match kind.val with | 1 => 11 | 2 => 10 | _ => 12
def mask (N : Nat) (kind : Fin (count N)) : Nat :=
  if N=11 then (if kind.val=0 then 158495020111019088292975255562 else 9444734656926049394710) else
    match kind.val with
    | 0 => 14855280693082744087392632874 | 1 => 4951760378943817067685560330
    | 2 => 604831853708092460023990 | _ => 40564825856395375891792278241302
def core (N : Nat) (kind : Fin (count N)) (i j : Fin (order N kind)) :=
  (mask N kind).testBit ((min i j).val*N+(max i j).val)

def label (n code i : Nat) : Fin (n+1) := Fin.ofNat (n+1) ((code >>> (4*i)) %16)
def weight (n h : Nat) := (Finset.univ.filter (fun i : Fin n => h.testBit i.val)).card

theorem pair_symm (N t i j) : pair N t i j = pair N t j i := by simp [pair,min_comm i j,max_comm i j,(eq_comm : i=j ↔ j=i)]
theorem aug_symm (N n t h i j) : augment N n t h i j = augment N n t h j i := by
  simp only [augment, min_comm i j, max_comm i j,pair_symm N t i j,(eq_comm : i=j ↔ j=i)]

abbrev Shape := Nat × Nat
def augmentedDegree (N n t h i : Nat) :=
  (Finset.univ.filter (fun j : Fin (n+1) => augment N n t h i j.val)).card
def growth (r d : Nat) := r*d+r*(r+1)/2

/-- The semantic interface to any certificate for one representative. -/
def row (N k : Nat) (s : Shape) (next : Shape → Prop) : Prop :=
  ∀ h : Fin (2^k), threshold N (k+1) ≤ s.2+weight k h.val → s.2+weight k h.val ≤ upper N →
    (∀ j : Fin k, weight k h.val ≤ augmentedDegree N k s.1 h.val j.val) →
    upper N ≤ s.2+weight k h.val+growth (N-(k+1)) (weight k h.val) →
    (∃ kind : Fin (count N), ∃ f : Fin (order N kind) ↪ Fin (k+1),
      ∀ i j, core N kind i j=true → augment N k s.1 h.val (f i).val (f j).val=true) ∨
    (∃ t : Nat, next (t,s.2+weight k h.val) ∧ ∃ e : Equiv.Perm (Fin (k+1)),
      ∀ i j, pair N t i.val j.val = augment N k s.1 h.val (e i).val (e j).val)

theorem dropBound (N : Nat) (ok : N=11 ∨ N=12) : ∀ n : Fin N, ∀ m d : Fin (upper N+1),
    threshold N (n.val+1) ≤ m.val → (n.val+1)*d.val ≤ 2*m.val → threshold N n.val ≤ m.val-d.val := by
  rcases ok with rfl | rfl <;> decide +kernel

theorem encode (f : Nat → Bool) (n : Nat) :
    ∃ h < 2^n, ∀ i<n, h.testBit i = f i := by
  induction n with
  | zero => exact ⟨0,by decide,by simp⟩
  | succ n ih =>
    obtain ⟨x,hx,bits⟩ := ih
    have hi : x.testBit n=false := Nat.testBit_lt_two_pow hx
    cases hf : f n with
    | false =>
      refine ⟨x,by rw [Nat.pow_succ]; omega,?_⟩
      intro i h
      by_cases he : i=n
      · simpa [he,hf] using hi
      · exact bits _ (by omega)
    | true =>
      refine ⟨2^n+x,by rw [Nat.pow_succ]; omega,?_⟩
      intro i h
      by_cases he : i=n
      · subst i; simp [Nat.testBit_two_pow_add_eq,hi,hf]
      · rw [Nat.testBit_two_pow_add_gt (by omega)]
        exact bits i (by omega)
end Astra1182.Large

/- Soundness of a one-vertex extension in the forbidden-graph classification. -/
namespace Astra1182.Large
open SimpleGraph

def HasCore (N : Nat) {X : Type} (G : SimpleGraph X) : Prop :=
  ∃ kind : Fin (count N), ∃ e : Fin (order N kind) ↪ X, ∀ i j, core N kind i j=true → G.Adj (e i) (e j)
def Represents (N : Nat) {X : Type} (G : SimpleGraph X) (n mask : Nat) : Prop :=
  ∃ e : Fin n ≃ X, ∀ i j, G.Adj (e i) (e j) ↔ pair N mask i.val j.val=true
def Classified (N : Nat) {X : Type} [Fintype X] [DecidableEq X] (G : SimpleGraph X) [DecidableRel G.Adj]
    (n : Nat) (shapes : Shape → Prop) :=
  HasCore N G ∨ ∃ s, shapes s ∧ G.edgeFinset.card=s.2 ∧ Represents N G n s.1

theorem aug_old {N n t h i j} (hi : i<n) (hj : j<n) : augment N n t h i j = pair N t i j := by
  by_cases he : i=j
  · simp [augment,pair,he]
  · simp [augment,he,(max_lt hi hj).ne]
theorem aug_last {N n t h i} (hi : i<n) : augment N n t h n i = h.testBit i := by
  simp [augment,Nat.ne_of_gt hi,max_eq_left hi.le,min_eq_right hi.le]

theorem extendStage {N : Nat} {X : Type} [Fintype X] [DecidableEq X] (G : SimpleGraph X) [DecidableRel G.Adj]
    (v : X) (minimal : ∀ x, G.degree v ≤ G.degree x) {n : Nat} (cardX : Fintype.card X=n+1) (s : Shape) (next : Shape → Prop)
    (bound : threshold N (n+1) ≤ G.edgeFinset.card) (ceiling : G.edgeFinset.card ≤ upper N)
    (reach : upper N ≤ G.edgeFinset.card+growth (N-(n+1)) (G.degree v))
    (previous : (G.induce {v}ᶜ).edgeFinset.card=s.2) (rep : Represents N (G.induce {v}ᶜ) n s.1)
    (records : row N n s next) : Classified N G (n+1) next := by
  classical
  obtain ⟨e,old⟩ := rep
  let lab : Fin (n+1) → X := Fin.lastCases v (fun i => (e i).val)
  have labLast : lab (Fin.last n)=v := by simp [lab]
  have labCast (i : Fin n) : lab i.castSucc=(e i).val := by simp [lab]
  have inj : Function.Injective lab := by
    intro i j
    refine Fin.lastCases ?_ (fun a => ?_) i <;> refine Fin.lastCases ?_ (fun b => ?_) j
    · simp
    · intro hv; rw [labLast,labCast] at hv; exact ((e b).property (Set.mem_singleton_iff.mpr hv.symm)).elim
    · intro hv; rw [labCast,labLast] at hv; exact ((e a).property (Set.mem_singleton_iff.mpr hv)).elim
    · intro he; rw [labCast,labCast] at he; exact congrArg Fin.castSucc (e.injective (Subtype.ext he))
  let E := Equiv.ofBijective lab
    ((Fintype.bijective_iff_injective_and_card lab).mpr ⟨inj,by simp [cardX]⟩)
  have eLast : E (Fin.last n)=v := labLast
  have eCast (i : Fin n) : E i.castSucc=(e i).val := labCast i
  let f (k : Nat) := if hk : k<n then decide (G.Adj (e ⟨k,hk⟩).val v) else false
  obtain ⟨hood, hlow, masked⟩ := encode f n
  have bits (i : Fin n) : hood.testBit i.val=decide (G.Adj (e i).val v) := by
    simpa [f,i.isLt] using masked i.val i.isLt
  have extAdj (i j : Fin (n+1)) :
      G.Adj (E i) (E j) ↔ augment N n s.1 hood i.val j.val=true := by
    refine Fin.lastCases ?_ (fun a => ?_) i <;> refine Fin.lastCases ?_ (fun b => ?_) j
    all_goals simp only [eLast,eCast,Fin.val_last,Fin.val_castSucc]
    · simp [augment]
    · rw [aug_last b.isLt,bits,decide_eq_true_eq,G.adj_comm]
    · rw [aug_symm,aug_last a.isLt,bits,decide_eq_true_eq]
    · rw [aug_old a.isLt b.isLt]
      exact old a b
  let guest : Fin n ↪ X := e.toEmbedding.trans (Function.Embedding.subtype _)
  let set := Finset.univ.filter (fun i : Fin n => hood.testBit i.val)
  have mapped : set.map guest = G.neighborFinset v := by
    ext x
    constructor
    · intro hit
      obtain ⟨i,hi,rfl⟩ := Finset.mem_map.mp hit
      apply (G.mem_neighborFinset v _).mpr
      exact (of_decide_eq_true ((bits i).symm.trans (Finset.mem_filter.mp hi).2)).symm
    · intro hit
      have hx := (G.mem_neighborFinset v _).mp hit
      let y : ↥({v}ᶜ : Set X) := ⟨x,hx.ne.symm⟩
      refine Finset.mem_map.mpr ⟨e.symm y,Finset.mem_filter.mpr ⟨Finset.mem_univ _,?_⟩,?_⟩
      · rw [bits,decide_eq_true_eq,e.apply_symm_apply]; exact hx.symm
      · change (e (e.symm y)).val=x; rw [e.apply_symm_apply]
  have deg : G.degree v = weight n hood := by
    rw [←G.card_neighborFinset_eq_degree, ←mapped, Finset.card_map]
    rfl
  have count : G.edgeFinset.card=s.2+weight n hood := by
    rw [G.card_edgeFinset_induce_compl_singleton,G.card_edgeFinset_deleteIncidenceSet] at previous
    have hd := G.degree_le_card_edgeFinset v
    omega
  have augDegree (i : Fin (n+1)) : augmentedDegree N n s.1 hood i.val = G.degree (E i) := by
    rw [← G.card_neighborFinset_eq_degree (E i)]
    unfold augmentedDegree
    rw [← Finset.card_map E.toEmbedding]
    congr 1
    ext x
    constructor
    · intro h
      obtain ⟨j,hj,rfl⟩ := Finset.mem_map.mp h
      exact (G.mem_neighborFinset _ _).2 ((extAdj i j).2 (Finset.mem_filter.mp hj).2)
    · intro h
      refine Finset.mem_map.mpr ⟨E.symm x, Finset.mem_filter.mpr ⟨Finset.mem_univ _,?_⟩,?_⟩
      · apply (extAdj i _).1
        simpa using (G.mem_neighborFinset _ _).1 h
      · exact E.apply_symm_apply _
  have mind (j : Fin n) : weight n hood ≤ augmentedDegree N n s.1 hood j.val := by
    rw [←deg,show augmentedDegree N n s.1 hood j.val = G.degree (E j.castSucc) from augDegree j.castSucc]
    exact minimal _
  rcases records ⟨hood,hlow⟩ (count ▸ bound) (count ▸ ceiling) mind
      (by rw [←count,←deg]; exact reach) with ⟨kind,f,hf⟩ | ⟨t,ht,π,hπ⟩
  · exact Or.inl ⟨kind,f.trans E.toEmbedding,fun i j hit => (extAdj _ _).2 (hf i j hit)⟩
  · refine Or.inr ⟨(t,s.2+weight n hood),ht,count,π.trans E,?_⟩
    intro i j
    change G.Adj (E (π i)) (E (π j)) ↔ pair N t i.val j.val=true
    rw [extAdj,hπ i j]
end Astra1182.Large

/- Delete a vertex of minimum degree, classify the induced graph, and reattach the vertex. -/
namespace Astra1182.Large
open SimpleGraph

theorem growth_succ (r d : Nat) : growth (r+1) d = (d+1)+growth r (d+1) := by
  unfold growth
  have hm : (r+1)*(r+1+1) = r*(r+1)+2*(r+1) := by ring
  rw [hm, Nat.succ_mul r d, Nat.mul_succ r d]
  omega

theorem growth_mono {x y : Nat} (h : x ≤ y) (r : Nat) : growth r x ≤ growth r y :=
  Nat.add_le_add_right (Nat.mul_le_mul_left _ h) _

theorem degree_before_delete {X : Type} [Fintype X] [DecidableEq X] (G : SimpleGraph X)
    [DecidableRel G.Adj] (v : X) (x : ↥({v}ᶜ : Set X)) :
    G.degree x.val ≤ (G.induce {v}ᶜ).degree x+1 := by
  classical
  have sub : G.neighborFinset x.val ⊆ insert v (((G.induce {v}ᶜ).neighborFinset x).map (.subtype _)) := by
    rw [map_neighborFinset_induce]
    intro y hy
    by_cases hv : y=v
    · simp [hv]
    · exact Finset.mem_insert_of_mem <| Finset.mem_inter.mpr ⟨hy,by simpa using hv⟩
  have h := (Finset.card_le_card sub).trans (Finset.card_insert_le _ _)
  simpa using h

theorem classify (N : Nat) (ok : N=11 ∨ N=12) (stages : Nat → Shape → Prop) (base : stages 1 (0,0))
    (rows : ∀ n : Fin N, 0<n.val → ∀ s, stages n.val s → row N n.val s (stages (n.val+1))) :
    ∀ k < N, ∀ (X : Type) [Fintype X] [DecidableEq X] (G : SimpleGraph X) [DecidableRel G.Adj],
      Fintype.card X=k+1 → threshold N (k+1) ≤ G.edgeFinset.card → G.edgeFinset.card ≤ upper N →
      upper N ≤ G.edgeFinset.card+growth (N-(k+1)) G.minDegree →
      Classified N G (k+1) (stages (k+1)) := by
  classical
  intro k
  induction k with
  | zero =>
    intro _ X _ _ G _ hc _ _ _
    let e := (Fintype.equivFinOfCardEq hc).symm
    have size := G.card_edgeFinset_le_card_choose_two
    rw [hc] at size
    refine Or.inr ⟨(0,0),base,by exact Nat.eq_zero_of_le_zero size,e,?_⟩
    intro i j
    have he : i=j := Fin.ext (by omega)
    subst j
    simp [pair]
  | succ k ih =>
    intro hk X _ _ G _ hc lower ceiling reach
    have : Nonempty X := Fintype.card_pos_iff.mp (by omega)
    obtain ⟨v,smallest⟩ := G.exists_minimal_degree_vertex
    have degSum : (k+2)*G.degree v ≤ 2*G.edgeFinset.card := calc
      _ = ∑ _ : X, G.degree v := by simp [hc]
      _ ≤ ∑ i, G.degree i := Finset.sum_le_sum fun i _ => by rw [←smallest]; exact G.minDegree_le_degree i
      _ = _ := G.sum_degrees_eq_twice_card_edges
    let n : Fin N := ⟨k+1,by omega⟩
    let m : Fin (upper N+1) := ⟨G.edgeFinset.card,by omega⟩
    let d : Fin (upper N+1) := ⟨G.degree v, lt_of_le_of_lt (G.degree_le_card_edgeFinset v) m.isLt⟩
    have residual := dropBound N ok n m d lower degSum
    have count := (G.card_edgeFinset_induce_compl_singleton v).trans (G.card_edgeFinset_deleteIncidenceSet v)
    have c : Fintype.card ↥({v}ᶜ : Set X) = k+1 := calc
      _ = Fintype.card X - Fintype.card ↥({v} : Set X) := Fintype.card_compl_set _
      _ = k+1 := by simp [hc]
    have ord : threshold N (k+1) ≤ (G.induce {v}ᶜ).edgeFinset.card := by rw [count]; exact residual
    have up : (G.induce {v}ᶜ).edgeFinset.card ≤ upper N := by rw [count]; omega
    have : Nonempty ↥({v}ᶜ : Set X) := Fintype.card_pos_iff.mp (by omega)
    obtain ⟨y,delMin⟩ := (G.induce {v}ᶜ).exists_minimal_degree_vertex
    have delta : G.degree v ≤ (G.induce {v}ᶜ).minDegree+1 := by
      rw [delMin,←smallest]
      exact (G.minDegree_le_degree y.val).trans (degree_before_delete G v y)
    have delReach : upper N ≤ (G.induce {v}ᶜ).edgeFinset.card +
        growth (N-(k+1)) (G.induce {v}ᶜ).minDegree := by
      have add := G.degree_le_card_edgeFinset v
      rw [count,show N-(k+1)=N-(k+2)+1 by omega,growth_succ]
      have mono := growth_mono delta (N-(k+2))
      change upper N ≤ G.edgeFinset.card + growth (N-(k+2)) G.minDegree at reach
      rw [smallest] at reach
      omega
    rcases ih (by omega) _ (G.induce {v}ᶜ) c ord up delReach with ⟨kind,e,he⟩ | ⟨s,hs,sz,rep⟩
    · exact Or.inl ⟨kind,e.trans (Function.Embedding.subtype _),he⟩
    · exact extendStage G v (fun x => smallest ▸ G.minDegree_le_degree x) hc s _ lower ceiling (smallest ▸ reach) sz rep (rows n (by dsimp [n]; omega) s hs)
end Astra1182.Large

/- Recover the official embedding from a forbidden core, or use a cut to rule out a final class. -/
namespace Astra1182.Large
open SimpleGraph

theorem order_le {N : Nat} (valid : N=11 ∨ N=12) (kind : Fin (count N)) : order N kind ≤ N := by
  rcases valid with rfl | rfl <;> revert kind <;> decide

def incl {N : Nat} (valid : N=11 ∨ N=12) (kind : Fin (count N)) := Fin.castLEEmb (order_le valid kind)
def target (N : Nat) (kind : Fin (count N)) (u v : Fin N) :=
  (mask N kind).testBit ((min u v).val*N+(max u v).val)

theorem active {N : Nat} (valid : N=11 ∨ N=12) :
    ∀ kind : Fin (count N), ∀ u v : Fin N, target N kind u v=true →
    ∃ i j : Fin (order N kind), incl valid kind i=u ∧ incl valid kind j=v ∧ core N kind i j=true := by
  rcases valid with rfl | rfl <;> decide +kernel

def finalCuts (N : Nat) (last : Shape → Prop) : Prop :=
  ∀ s, last s → ∃ c : Nat, ∃ x y : Fin N, c.testBit x.val ≠ c.testBit y.val ∧
    ∀ i j : Fin N, c.testBit i.val ≠ c.testBit j.val → pair N s.1 i.val j.val=true

def lastEleven : List Nat := [24056546462113487,1099511098383,528900119576575,549489475583,1099245027327,4294967295,12817793023,8522825727]
theorem elevenCuts (last : Shape → Prop) (h : ∀ s, last s → s.1 ∈ lastEleven) : finalCuts 11 last := by
  have known : ∀ t ∈ lastEleven, ∃ c ∈ ([611,12,1] : List Nat),
      ∃ x y : Fin 11, c.testBit x.val ≠ c.testBit y.val ∧
      ∀ i j : Fin 11, c.testBit i.val ≠ c.testBit j.val → pair 11 t i.val j.val=true := by decide +kernel
  intro s hs
  obtain ⟨c,_,hc⟩ := known _ (h _ hs)
  exact ⟨c,hc⟩

theorem twelveCuts (last : Shape → Prop) (h : ∀ s, ¬last s) : finalCuts 12 last :=
  fun s hs => (h s hs).elim

theorem finish (N : Nat) (valid : N=11 ∨ N=12) (stages : Nat → Shape → Prop)
    (base : stages 1 (0,0))
    (rows : ∀ n : Fin N, 0<n.val → ∀ s, stages n.val s → row N n.val s (stages (n.val+1)))
    (cuts : finalCuts N (stages N))
    (G : SimpleGraph (Fin N)) (conn : G.Connected) (size : G.edgeSet.ncard=23) :
    ∃ kind : Fin (count N), ∃ e : Fin N ↪ Fin N, ∀ i j, G.Adj i j → target N kind (e i) (e j)=false := by
  classical
  have countG : G.edgeFinset.card=23 := by
    rwa [←show G.edgeSet.ncard=G.edgeFinset.card from Set.ncard_eq_toFinset_card' _]
  have csize : Gᶜ.edgeFinset.card=upper N := by
    have sets : Gᶜ.edgeFinset = (⊤ : SimpleGraph (Fin N)).edgeFinset \ G.edgeFinset := by
      apply Finset.coe_injective
      simp only [Finset.coe_sdiff,coe_edgeFinset,←edgeSet_sdiff,top_sdiff]
    rw [sets,Finset.card_sdiff_of_subset (edgeFinset_mono le_top),
      card_edgeFinset_top_eq_card_choose_two,Fintype.card_fin,countG]
    rcases valid with rfl | rfl <;> decide
  have hn : N-1+1=N := by omega
  have run := classify N valid stages base rows (N-1) (by omega) (Fin N) Gᶜ
  rw [hn] at run
  have low : threshold N N ≤ upper N := by rcases valid with rfl | rfl <;> decide
  obtain hc | ⟨s,hs,_,e,rel⟩ := run (by simp) (csize ▸ low) csize.le (by simp [csize,growth])
  · obtain ⟨kind,f,hf⟩ := hc
    obtain ⟨π,map⟩ := Equiv.Perm.exists_extending_pair (incl valid kind) f (incl valid kind).injective f.injective
    refine ⟨kind,π.symm.toEmbedding,?_⟩
    intro u v huv
    change target N kind (π.symm u) (π.symm v)=false
    apply Bool.eq_false_iff.mpr
    intro bad
    obtain ⟨i,j,ha,hb,hit⟩ := active valid kind _ _ bad
    have ui : f i=u := by rw [←map i,ha,π.apply_symm_apply]
    have vj : f j=v := by rw [←map j,hb,π.apply_symm_apply]
    exact (hf i j hit).2 (by simpa [ui,vj] using huv)
  · obtain ⟨cut,a,b,apart,cross⟩ := cuts s hs
    let tag (x : Fin N) := cut.testBit (e.symm x).val
    have same {x y} (xy : G.Adj x y) : tag x=tag y := by
      by_contra hn
      have h := (rel (e.symm x) (e.symm y)).2 (cross _ _ hn)
      exact h.2 (by simpa using xy)
    have along {x y : Fin N} (p : G.Walk x y) : tag x=tag y := by
      induction p with
      | nil => rfl
      | cons h _ ih => exact (same h).trans ih
    exact (apart (by simpa [tag] using along (conn.preconnected (e a) (e b)).some)).elim

end Astra1182.Large

namespace Astra1182.Large
structure Certificate (N : Nat) where
  stages : Nat → Shape → Prop
  base : stages 1 (0,0)
  rows : ∀ n : Fin N, 0<n.val → ∀ s, stages n.val s → row N n.val s (stages (n.val+1))
  cuts : finalCuts N (stages N)

theorem complete (eleven : Certificate 11) (twelve : Certificate 12) :
    OMA.R_Erdos1182_erdos_1182_variants_small_values_R1_H1_R1_H1_R1.H4 := by
  constructor
  · intro G conn size
    obtain ⟨kind,e,valid⟩ := finish 11 (Or.inl rfl) eleven.stages eleven.base eleven.rows eleven.cuts G conn size
    have mem : ∀ k, mask 11 k ∈ [158495020111019088292975255562,9444734656926049394710] := by decide
    exact ⟨mask 11 kind,mem kind,e,valid⟩
  · intro G conn size
    obtain ⟨kind,e,valid⟩ := finish 12 (Or.inr rfl) twelve.stages twelve.base twelve.rows twelve.cuts G conn size
    have mem : ∀ k, mask 12 k ∈ [14855280693082744087392632874,4951760378943817067685560330,604831853708092460023990,40564825856395375891792278241302] := by decide
    exact ⟨mask 12 kind,mem kind,e,valid⟩
end Astra1182.Large


/- Reflection for the finite extension records of the 11- and 12-vertex classifications. -/
namespace Astra1182.Large.Reflect
open Astra1182.Large

def every (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | n+1 => every f n && f n

theorem every_at {f : Nat → Bool} {n : Nat} (h : every f n = true) {i : Nat} (hi : i<n) :
    f i = true := by
  induction n with
  | zero => omega
  | succ n ih =>
    obtain ⟨left,right⟩ := Bool.and_eq_true_iff.mp h
    by_cases e : i=n
    · simpa [e] using right
    · exact ih left (by omega)

def unionBits (f : Nat → Nat) : Nat → Nat
  | 0 => 0
  | n+1 => unionBits f n ||| f n

theorem mem_union (f : Nat → Nat) (n h : Nat) :
    (unionBits f n).testBit h = true ↔ ∃ i<n, (f i).testBit h = true := by
  induction n with
  | zero => simp [unionBits]
  | succ n ih =>
    rw [unionBits, Nat.testBit_or, Bool.or_eq_true, ih]
    constructor
    · rintro (⟨i,hi,v⟩ | v)
      · exact ⟨i,by omega,v⟩
      · exact ⟨n,by omega,v⟩
    · rintro ⟨i,hi,hit⟩
      by_cases e : i=n
      · exact Or.inr (e ▸ hit)
      · exact Or.inl ⟨i,by omega,hit⟩

def cone (col : Nat → Nat) (full r : Nat) : Nat → Nat
  | 0 => full
  | j+1 => if r.testBit j then cone col full r j &&& col j else cone col full r j

theorem mem_cone (col : Nat → Nat) (full r k h : Nat) :
    (cone col full r k).testBit h = true ↔
      full.testBit h = true ∧ ∀ i<k, r.testBit i = true → (col i).testBit h = true := by
  induction k with
  | zero => simp [cone]
  | succ k ih =>
    by_cases bit : r.testBit k = true
    · rw [cone, if_pos bit, Nat.testBit_and, Bool.and_eq_true_iff, ih]
      constructor
      · rintro ⟨⟨top,lower⟩,endbit⟩
        refine ⟨top,fun i hi hr => ?_⟩
        by_cases e : i=k
        · simpa [e] using endbit
        · exact lower i (by omega) hr
      · rintro ⟨top,all⟩
        exact ⟨⟨top,fun i hi => all i (by omega)⟩,all k (by omega) bit⟩
    · rw [cone, if_neg bit, ih]
      constructor
      · rintro ⟨top,lower⟩
        refine ⟨top,fun i hi hr => ?_⟩
        have ne : i ≠ k := by intro eq; exact bit (eq ▸ hr)
        exact lower i (by omega) hr
      · rintro ⟨top,all⟩
        exact ⟨top,fun i hi => all i (by omega)⟩

def numTrue (f : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n+1 => numTrue f n + if f n then 1 else 0

theorem numTrue_eq (f : Nat → Bool) (n : Nat) :
    numTrue f n = (Finset.univ.filter (fun i : Fin n => f i.val)).card := by
  have sum (m : Nat) : numTrue f m = ∑ i : Fin m, if f i.val then (1 : Nat) else 0 := by
    induction m with
    | zero => simp [numTrue]
    | succ m ih => rw [numTrue, Fin.sum_univ_castSucc, ih]; rfl
  simpa only [Finset.sum_boole, Nat.cast_id] using sum n

def oldDegree (N k t i : Nat) := literal t fun t => literal i fun i => numTrue (pair N t i) k

theorem aug_degree (N k t h : Nat) (i : Fin k) :
    augmentedDegree N k t h i.val = oldDegree N k t i.val + if h.testBit i.val then 1 else 0 := by
  simp only [augmentedDegree,oldDegree,literal_eq]
  rw [← numTrue_eq, numTrue]
  have old : ∀ j<k, augment N k t h i.val j = pair N t i.val j := by
    intro j hj
    have lt : max i.val j < k := max_lt i.isLt hj
    by_cases e : i.val = j <;> simp [augment, pair, e, lt.ne]
  have eq {n : Nat} (hn : n≤k) :
      numTrue (augment N k t h i.val) n = numTrue (pair N t i.val) n := by
    induction n with
    | zero => rfl
    | succ n ih => rw [numTrue, numTrue, ih (by omega), old n (by omega)]
  rw [eq (le_refl _)]
  simp [augment, i.isLt.ne]

def subsetBits (a b : Nat) := a &&& b == a

theorem subset_at {a b : Nat} (incl : subsetBits a b = true) {j : Nat} (hit : a.testBit j=true) :
    b.testBit j=true := by
  have t := congrArg (fun z : Nat => z.testBit j) (beq_iff_eq.mp incl)
  simpa [Nat.testBit_and,hit] using t

structure Coordinates (k : Nat) where
  col : Nat → Nat
  size : Nat → Nat
  col_eq : ∀ (h : Fin (2^k)) (i : Fin k), (col i.val).testBit h.val = h.val.testBit i.val
  size_eq : ∀ (h : Fin (2^k)), (size (weight k h.val)).testBit h.val = true

def full (k : Nat) := 2^(2^k)-1

def candidates (N k edges md lows : Nat) (coord : Coordinates k) :=
  unionBits (fun d =>
    if threshold N (k+1) ≤ edges+d ∧ edges+d ≤ upper N ∧
        upper N ≤ edges+d+growth (N-(k+1)) d then
      if d ≤ md then coord.size d else if d=md+1 then coord.size d &&& cone coord.col (full k) lows k else 0
    else 0) (k+1)

def minOK (N k t md vertex lows : Nat) :=
  decide (vertex<k) && (oldDegree N k t vertex == md) &&
    every (fun i => !lows.testBit i || oldDegree N k t i == md) k

theorem candidate_hit {N k t edges md vertex lows : Nat} {coord : Coordinates k}
    (ok : minOK N k t md vertex lows = true) (h : Fin (2^k))
    (lower : threshold N (k+1) ≤ edges+weight k h.val) (upperE : edges+weight k h.val ≤ upper N)
    (mins : ∀ j : Fin k, weight k h.val ≤ augmentedDegree N k t h.val j.val)
    (bound : upper N ≤ edges+weight k h.val+growth (N-(k+1)) (weight k h.val)) :
    (candidates N k edges md lows coord).testBit h.val=true := by
  obtain ⟨vcheck,rest⟩ := Bool.and_eq_true_iff.mp ok
  obtain ⟨vlt,vdeg⟩ := Bool.and_eq_true_iff.mp vcheck
  let v : Fin k := ⟨vertex,of_decide_eq_true vlt⟩
  let d := weight k h.val
  have hk : d≤k := by
    have z := Finset.card_filter_le Finset.univ (fun i : Fin k => h.val.testBit i.val = true)
    simpa [d,weight] using z
  apply (mem_union _ _ _).mpr
  refine ⟨d,by omega,?_⟩
  rw [if_pos ⟨lower,upperE,bound⟩]
  by_cases sm : d ≤ md
  · simp only [if_pos sm]; exact coord.size_eq h
  · have vm := mins v
    rw [aug_degree] at vm
    change d ≤ oldDegree N k t vertex + _ at vm
    rw [beq_iff_eq.mp vdeg] at vm
    have last : d=md+1 := by split at vm <;> omega
    rw [if_neg sm, if_pos last, Nat.testBit_and, Bool.and_eq_true_iff]
    refine ⟨coord.size_eq h,(mem_cone _ _ _ _ _).mpr ⟨?_,?_⟩⟩
    · simp [full,h.isLt]
    · intro i hi bi
      have ti : oldDegree N k t i=md := by
        have := every_at rest hi
        simpa [bi] using this
      have tmin := mins ⟨i,hi⟩
      rw [aug_degree] at tmin
      change d ≤ oldDegree N k t i + (if h.val.testBit i then 1 else 0) at tmin
      rw [ti] at tmin
      rw [coord.col_eq h ⟨i,hi⟩]
      split at tmin <;> simp_all <;> omega

def coordOK (k : Nat) (col size : Nat → Nat) :=
  every (fun h => every (fun i => (col i).testBit h == h.testBit i) k &&
    (size (numTrue h.testBit k)).testBit h) (2^k)

def coordinates (k : Nat) (col size : Nat → Nat) (ok : coordOK k col size = true) : Coordinates k where
  col := col
  size := size
  col_eq h i := by
    have hit := (Bool.and_eq_true_iff.mp (every_at ok h.isLt)).1
    exact beq_iff_eq.mp (every_at hit i.isLt)
  size_eq h := by
    have hit := (Bool.and_eq_true_iff.mp (every_at ok h.isLt)).2
    simpa only [numTrue_eq, weight] using hit

def listBits {α : Type} (f : α → Nat) : List α → Nat
  | [] => 0
  | x::xs => f x ||| listBits f xs

theorem mem_listBits {α : Type} (f : α → Nat) (xs : List α) (h : Nat) :
    (listBits f xs).testBit h = true ↔ ∃ x ∈ xs, (f x).testBit h = true := by
  induction xs with
  | nil => simp [listBits]
  | cons x xs ih => simp [listBits, Nat.testBit_or, ih]

end Astra1182.Large.Reflect

/- Reflect short injection codes, forbidden-core embeddings and graph isomorphisms. -/
namespace Astra1182.Large.Rules
open Astra1182.Large

def digit (code i : Nat) := (code >>> (4*i)) % 16

def scan (k code : Nat) : Nat → Nat → Bool
  | 0, _ => true
  | r+1, used =>
    let x := digit code r
    decide (x≤k) && !used.testBit x && scan k code r (used ||| 2^x)

theorem scan_sound {k code r used} (ok : scan k code r used=true) :
    (∀ i<r, digit code i ≤ k ∧ used.testBit (digit code i)=false) ∧
    (∀ i<r, ∀ j<r, digit code i=digit code j → i=j) := by
  induction r generalizing used with
  | zero => simp
  | succ r ih =>
    simp only [scan,Bool.and_eq_true_iff] at ok
    obtain ⟨⟨bound,clear⟩,small⟩ := ok
    have lim : digit code r ≤ k := of_decide_eq_true bound
    have free : used.testBit (digit code r)=false := by simpa using clear
    obtain ⟨fresh,unique⟩ := ih small
    have prior (i : Nat) (hi : i<r) : used.testBit (digit code i)=false ∧ digit code i ≠ digit code r := by
      have hh := (fresh i hi).2
      rw [Nat.testBit_or] at hh
      obtain ⟨hu,hp⟩ := Bool.or_eq_false_iff.mp hh
      exact ⟨hu,fun e => by simp [e,Nat.testBit_two_pow_self] at hp⟩
    constructor
    · intro i hi
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h | rfl
      · exact ⟨(fresh i h).1,(prior i h).1⟩
      · exact ⟨lim,free⟩
    · intro i hi j hj e
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h | rfl <;> rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h' | rfl
      · exact unique i h j h' e
      · exact ((prior i h).2 e).elim
      · exact ((prior j h').2 e.symm).elim
      · rfl

def image {k code r} (ok : scan k code r 0=true) : Fin r ↪ Fin (k+1) where
  toFun i := ⟨digit code i.val, Nat.lt_succ_of_le ((scan_sound ok).1 i.val i.isLt).1⟩
  inj' i j h := Fin.ext ((scan_sound ok).2 i.val i.isLt j.val j.isLt (congrArg Fin.val h))

def positive : Nat → Nat → List (Nat × Nat)
  | 11, 0 => [(0,1),(1,2),(0,3),(2,3),(1,4),(3,4),(4,5),(5,6),(1,7),(3,7),(6,7),(5,8),(7,8),(8,9)]
  | 11, 1 => [(0,1),(0,2),(1,2),(1,3),(2,3),(0,4),(3,4),(2,5),(4,5),(2,6),(4,6),(1,7),(6,7),(3,8)]
  | 12, 0 => [(0,1),(1,2),(0,3),(2,3),(1,4),(3,4),(0,5),(2,5),(4,5),(3,6),(5,6),(3,7),(5,7),(7,8),(7,9),(4,10),(2,11)]
  | 12, 1 => [(0,1),(1,2),(0,3),(2,3),(1,4),(3,4),(2,5),(4,5),(3,6),(5,6),(3,7),(5,7),(7,8),(2,9),(4,9),(2,10),(4,10)]
  | 12, 2 => [(0,1),(0,2),(1,2),(1,3),(2,3),(0,4),(3,4),(0,5),(3,5),(4,5),(2,6),(5,6),(0,7),(3,7),(6,7),(1,8),(5,8),(2,9)]
  | 12, 3 => [(0,1),(0,2),(1,2),(1,3),(2,3),(0,4),(2,4),(3,4),(1,5),(4,5),(1,6),(4,6),(2,7),(6,7),(6,8),(8,9),(6,10),(3,11)]
  | _, _ => []

theorem positive_complete (N : Nat) (valid : N=11 ∨ N=12) :
    ∀ k : Fin (count N), ∀ i j : Fin (order N k), core N k i j=true →
      (i.val,j.val)∈positive N k.val ∨ (j.val,i.val)∈positive N k.val := by
  rcases valid with rfl | rfl <;> decide +kernel

def copyOK (N k kind code old req : Nat) : Bool :=
  literal code fun code => literal old fun old => literal req fun req =>
  if hk : kind < count N then
    decide (N=11 ∨ N=12) && scan k code (order N ⟨kind,hk⟩) 0 &&
      (positive N kind).all (fun p => augment N k old req (digit code p.1) (digit code p.2))
  else false

theorem aug_mono {N k old req t h i j : Nat} (oldSub : old &&& t=old)
    (hood : ∀ u<k, req.testBit u=true → h.testBit u=true) (hi : i≤k) (hj : j≤k)
    (hit : augment N k old req i j=true) : augment N k t h i j=true := by
  by_cases same : i=j
  · simp [augment,same] at hit
  by_cases last : max i j=k
  · have small : min i j<k := by omega
    simpa [augment,same,last] using hood _ small (by simpa [augment,same,last] using hit)
  · let q := (min i j)*(2*N-1-min i j)/2 + max i j-min i j-1
    have b : old.testBit q=true := by simpa [q,augment,same,last,pair] using hit
    have eb := congrArg (fun x : Nat => x.testBit q) oldSub
    have m : t.testBit q=true := by simpa [Nat.testBit_and,b] using eb
    simpa [q,augment,same,last,pair] using m

theorem copy_sound {N k kind code old req t h} (ok : copyOK N k kind code old req = true)
    (sub : old &&& t=old) (hood : ∀ i<k, req.testBit i=true → h.testBit i=true) :
    ∃ kind : Fin (count N), ∃ f : Fin (order N kind) ↪ Fin (k+1),
      ∀ i j, core N kind i j=true → augment N k t h (f i).val (f j).val=true := by
  simp only [copyOK,literal_eq] at ok
  split at ok
  next hk =>
    simp only [Bool.and_eq_true_iff] at ok
    obtain ⟨⟨guard,scanOK⟩,pairs⟩ := ok
    let kind' : Fin (count N) := ⟨kind,hk⟩
    let f := image scanOK
    refine ⟨kind',f,?_⟩
    intro i j hit
    apply aug_mono sub hood (Nat.le_of_lt_succ (f i).isLt) (Nat.le_of_lt_succ (f j).isLt)
    rcases positive_complete N (of_decide_eq_true guard) kind' i j hit with hi | hj
    · exact List.all_eq_true.mp pairs _ hi
    · rw [aug_symm]; exact List.all_eq_true.mp pairs _ hj
  next => contradiction

def allLt (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | n+1 => f n && allLt f n

theorem allLt_sound {f n} (ok : allLt f n=true) : ∀ i<n, f i=true := by
  induction n with
  | zero => simp
  | succ n ih =>
    obtain ⟨last,rest⟩ := Bool.and_eq_true_iff.mp ok
    intro i hi
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h | rfl
    · exact ih rest i h
    · exact last

def isoOK (N k t h child code : Nat) : Bool :=
  literal t fun t => literal h fun h => literal child fun child => literal code fun code =>
  scan k code (k+1) 0 && allLt (fun j => allLt (fun i =>
    pair N child i j == augment N k t h (digit code i) (digit code j)) j) (k+1)

theorem iso_sound {N k t h child code} (ok : isoOK N k t h child code=true) :
    ∃ e : Equiv.Perm (Fin (k+1)), ∀ i j,
      pair N child i.val j.val = augment N k t h (e i).val (e j).val := by
  simp only [isoOK,literal_eq] at ok
  obtain ⟨checked,pairs⟩ := Bool.and_eq_true_iff.mp ok
  let f := image checked
  let e := Equiv.ofBijective f f.injective.bijective_of_finite
  refine ⟨e,?_⟩
  intro i j
  have hpair (a b : Fin (k+1)) (ab : a.val<b.val) :
      pair N child a.val b.val = augment N k t h (e a).val (e b).val :=
    beq_iff_eq.mp (allLt_sound (allLt_sound pairs b.val b.isLt) a.val ab)
  rcases lt_trichotomy i.val j.val with before | same | after
  · exact hpair _ _ before
  · have eq : i=j := Fin.ext same
    simp [eq,pair,augment]
  · rw [pair_symm,aug_symm]; exact hpair _ _ after

end Astra1182.Large.Rules

namespace Astra1182.Large.Reflect
open Astra1182.Large Astra1182.Large.Rules

structure ShapeTable where
  length : Nat
  entry : Nat → Shape

def ShapeTable.contains (tab : ShapeTable) (s : Shape) : Prop := ∃ j<tab.length, tab.entry j = s

structure CopyEntry where
  kind : Nat
  code : Nat
  old : Nat
  req : Nat

structure IsoEntry where
  hood : Nat
  child : Nat
  code : Nat

structure Hints where
  vertex : Nat
  lows : Nat
  copies : List Nat
  isos : List IsoEntry

structure Layer where
  entries : Nat
  dict : Nat → CopyEntry
  hints : Nat → Hints

def dictOK (N k : Nat) (L : Layer) (i : Nat) : Bool :=
  let w := L.dict i
  copyOK N k w.kind w.code w.old w.req

def isoChecked (N k : Nat) (s : Shape) (children : ShapeTable) (z : IsoEntry) : Bool :=
  let t := children.entry z.child
  decide (z.child < children.length) && (t.2 == s.2 + numTrue z.hood.testBit k) &&
    isoOK N k s.1 z.hood t.1 z.code

def testRow (N k : Nat) (coord : Coordinates k) (L : Layer) (parents children : ShapeTable) (i : Nat) : Bool :=
  let s := parents.entry i
  literal s.1 fun t => literal s.2 fun edges =>
  let s : Shape := (t,edges)
  let a := L.hints i
  literal (oldDegree N k s.1 a.vertex) fun md =>
  let C := listBits (fun j => cone coord.col (full k) (L.dict j).req k) a.copies
  let I := listBits (fun z => 2^z.hood) a.isos
  minOK N k s.1 md a.vertex a.lows &&
    a.copies.all (fun j => decide (j<L.entries) && subsetBits (L.dict j).old s.1) &&
    a.isos.all (isoChecked N k s children) &&
    subsetBits (candidates N k s.2 md a.lows coord) (C ||| I)

theorem testRow_sound {N k : Nat} {coord : Coordinates k} {L : Layer} {parents children : ShapeTable}
    (checked : ∀ j<L.entries, dictOK N k L j = true) {i : Nat}
    (ok : testRow N k coord L parents children i = true) :
    row N k (parents.entry i) children.contains := by
  let s := parents.entry i
  let a := L.hints i
  let md := oldDegree N k s.1 a.vertex
  let C := listBits (fun j => cone coord.col (full k) (L.dict j).req k) a.copies
  let I := listBits (fun z => 2^z.hood) a.isos
  simp only [testRow,literal_eq] at ok
  obtain ⟨prev,cover⟩ := Bool.and_eq_true_iff.mp ok
  obtain ⟨prev,isos⟩ := Bool.and_eq_true_iff.mp prev
  obtain ⟨minTest,copyTest⟩ := Bool.and_eq_true_iff.mp prev
  intro h hl hu hm hg
  have good := candidate_hit (coord:=coord) minTest h hl hu hm hg
  have existsRule : (C ||| I).testBit h.val=true := subset_at cover good
  rw [Nat.testBit_or, Bool.or_eq_true] at existsRule
  rcases existsRule with cbit | ibit
  · obtain ⟨j,hj,uses⟩ := (mem_listBits _ _ _).mp cbit
    have w := (List.all_eq_true.mp copyTest) j hj
    obtain ⟨valid,incl⟩ := Bool.and_eq_true_iff.mp w
    refine Or.inl (copy_sound (checked j (of_decide_eq_true valid)) (beq_iff_eq.mp incl) ?_)
    intro n hn hb
    have cg := ((mem_cone _ _ _ _ _).mp uses).2 n hn hb
    simpa only [coord.col_eq h ⟨n,hn⟩] using cg
  · obtain ⟨z,hz,hit⟩ := (mem_listBits _ _ _).mp ibit
    have eq : z.hood=h.val := by simpa only [Nat.testBit_two_pow,decide_eq_true_eq] using hit
    have wz := List.all_eq_true.mp isos z hz
    obtain ⟨base,per⟩ := Bool.and_eq_true_iff.mp wz
    obtain ⟨idx,size⟩ := Bool.and_eq_true_iff.mp base
    let t := children.entry z.child
    have sz : t.2 = s.2 + weight k h.val := by
      simpa only [eq,numTrue_eq,weight] using (beq_iff_eq.mp size)
    refine Or.inr ⟨t.1,⟨z.child,of_decide_eq_true idx,?_⟩,?_⟩
    · exact Prod.ext rfl sz
    · rw [← eq]
      exact iso_sound per

end Astra1182.Large.Reflect

/- Finite witnesses are stored in bit fields. Their decoding is untrusted input
to the row verifier: every permutation and every final cover is checked again. -/
namespace Astra1182.Large.Reflect
open Astra1182.Large Astra1182.Large.Rules

abbrev Pages := Nat → Nat

def getBits (pages : Pages) (offset width : Nat) : Nat :=
  let j := offset/4096
  let pos := offset%4096
  let first := pages j >>> pos
  (if pos+width≤4096 then first else first ||| (pages (j+1) <<< (4096-pos))) % (2^width)

def fields (g : Nat → Nat) (n : Nat) := (List.range n).map g

def emitEdge (N a b : Nat) := let i:=min a b; let j:=max a b; 2^(i*(2*N-1-i)/2+j-i-1)

def putHood (N k hood : Nat) : Nat → Nat
  | 0 => 0
  | i+1 => putHood N k hood i ||| (if hood.testBit i then emitEdge N i k else 0)

structure ShapePages where
  length : Nat
  parentWidth : Nat
  pages : Pages

def shape (N : Nat) (config : Nat → ShapePages) : Nat → Nat → Shape
  | 0, _ => (0,0)
  | k+1, j =>
    let S := config (k+1)
    if N=12 ∧ k+1=8 ∨ N=11 ∧ k+1=7 then
      let offset := j*(S.parentWidth+6)
      (getBits S.pages offset S.parentWidth, getBits S.pages (offset+S.parentWidth) 6)
    else
      let offset := j*(k+S.parentWidth)
      let hood := getBits S.pages offset k
      let i := getBits S.pages (offset+k) S.parentWidth
      let p := shape N config k i
      (p.1 ||| putHood N k hood k, p.2 + numTrue hood.testBit k)

def stageTable (N : Nat) (config : Nat → ShapePages) (k : Nat) : ShapeTable :=
  ⟨(config k).length,shape N config k⟩

def unpackPerm : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | r+1, rank, available =>
    literal available fun available =>
    literal (4*(rank%(r+1))) fun offset =>
    let bit := 2^offset
    let rest := available >>> offset
    let digit := rest%16
    let next := (available%bit) ||| ((rest >>> 4) <<< offset)
    digit ||| (unpackPerm r (rank/(r+1)) next <<< 4)

def decodePerm (k rank : Nat) := unpackPerm (k+1) rank 0xfedcba9876543210

def imageEntry (N k kind code : Nat) : CopyEntry :=
  literal code fun code =>
  let v := (positive N kind).foldl (fun (m : Nat × Nat) e =>
    let a := digit code e.1
    let b := digit code e.2
    if max a b=k then (m.1,m.2 ||| 2^(min a b)) else (m.1 ||| emitEdge N a b,m.2)) (0,0)
  ⟨kind,code,v.1,v.2⟩

def invLast (k code : Nat) : Nat → Nat
  | 0 => 0
  | j+1 => if digit code j=k then j else invLast k code j

def isoHood (N k child code : Nat) : Nat :=
  literal child fun child => literal code fun code =>
  literal (invLast k code (k+1)) fun i =>
  unionBits (fun j => if pair N child i j then 2^(digit code j) else 0) (k+1)

structure Layout where
  dictLen : Nat
  copyWidth : Nat
  childWidth : Nat
  permWidth : Nat
  rankWidth : Nat
  kindWidth : Nat
  colsLenWidth : Nat
  isoLenWidth : Nat
  newWidth : Nat
  newBaseWidth : Nat
  offsetWidth : Nat
  headerStart : Nat
  groupStart : Nat
  copyStart : Nat
  permStart : Nat
  payload : Nat
  raw : Pages

def rowLengths (L : Layout) (i : Nat) :=
  let b := L.headerStart+i*(L.colsLenWidth+L.isoLenWidth+L.newWidth)
  (getBits L.raw b L.colsLenWidth, getBits L.raw (b+L.colsLenWidth) L.isoLenWidth)

def newCount (L : Layout) (i : Nat) :=
  getBits L.raw (L.headerStart+i*(L.colsLenWidth+L.isoLenWidth+L.newWidth)+L.colsLenWidth+L.isoLenWidth) L.newWidth

def prefixNew (L : Layout) (group : Nat) : Nat → Nat
  | 0 => getBits L.raw (L.groupStart+group*(L.offsetWidth+L.newBaseWidth)+L.offsetWidth) L.newBaseWidth
  | j+1 => prefixNew L group j + newCount L (group*16+j)

def identityCode : Nat → Nat
  | 0 => 0
  | j+1 => identityCode j ||| (j <<< (4*j))

def advanceRows (L : Layout) (group : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => let len := rowLengths L (group*16+n)
           advanceRows L group n + len.1*L.copyWidth + len.2*(L.permWidth+L.childWidth)

def pickSmallest (N k t : Nat) : Nat → Nat
  | 0 => 0
  | j+1 => let old := pickSmallest N k t j
           if oldDegree N k t j < oldDegree N k t old then j else old

def makeLayer (N k : Nat) (parents children : ShapeTable) (L : Layout) : Layer where
  entries := L.dictLen
  dict j := let loc := L.copyStart+j*(L.rankWidth+L.kindWidth)
            let rank := getBits L.raw loc L.rankWidth
            let kind := getBits L.raw (loc+L.rankWidth) L.kindWidth
            imageEntry N k kind (decodePerm k rank)
  hints i :=
    let len := rowLengths L i
    let group := i/16
    let p := L.payload + getBits L.raw (L.groupStart + group*(L.offsetWidth+L.newBaseWidth)) L.offsetWidth +
      advanceRows L group (i%16)
    let c := fields (fun j => getBits L.raw (p+j*L.copyWidth) L.copyWidth) len.1
    let off := p+len.1*L.copyWidth
    let z := (List.range len.2).map (fun j =>
      let q := off+j*(L.childWidth+L.permWidth)
      let step := getBits L.raw q L.childWidth
      let pi := getBits L.raw (q+L.childWidth) L.permWidth
      let rank := getBits L.raw (L.permStart+pi*L.rankWidth) L.rankWidth
      let perm := decodePerm k rank
      let target := (children.entry step).1
      (⟨isoHood N k target perm, step, perm⟩ : IsoEntry))
    let fresh := if L.newWidth=0 then [] else
      let q := prefixNew L group (i%16)
      let identity := identityCode (k+1)
      fields (fun j => j) (newCount L i)
        |>.map (fun j => (⟨isoHood N k (children.entry (q+j)).1 identity,q+j,identity⟩ : IsoEntry))
    literal (parents.entry i).1 fun t =>
    literal (pickSmallest N k t k) fun v =>
    literal (oldDegree N k t v) fun md =>
    let lows := unionBits (fun j => if oldDegree N k t j = md then 2^j else 0) k
    ⟨v,lows,c,z++fresh⟩

end Astra1182.Large.Reflect

