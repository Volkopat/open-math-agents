theorem slice_split {f : Nat → Bool} {lo len : Nat}
    (a : slice f lo (len/2)=true)
    (b : slice f (lo+len/2) (len-len/2)=true) : slice f lo len=true := by
  have le : len/2 ≤ len := Nat.div_le_self len 2
  have h := slice_add a b
  simpa only [Nat.add_sub_of_le le] using h

end Astra1182.Large.Board

