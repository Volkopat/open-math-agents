def res (n : ℕ) (b : Bool) (i : ℕ) := if b then res1 n i else res0 n i

def resBound (n : ℕ) (b : Bool) (i : ℕ) := if i < sz n then res n b i else 0

def sameBoolQuad (x y : Q Bool) : Bool := decide (x = y)

def verify (k : ℕ) (s : Bool) (u : ℕ) : Bool :=
  resBound (k+2) s u == 0 || match k with
    | 0 => sameBoolQuad (jump 0 s (repr ch 2 u)) (repr ch 1 (resBound 2 s u-1))
    | j+1 => cert ch findId resBound (j+2) s u


def scan (p : ℕ → Bool) : ℕ → ℕ → Bool
  | 0, _ => true
  | k+1, i => p i && scan p k (i+1)
lemma ofScan (p : ℕ → Bool) (n i j : ℕ) (h : scan p n i = true) (ha : i ≤ j) (hb : j < i+n) :
    p j = true := by
  induction n generalizing i with
  | zero => omega
  | succ n ih =>
    simp only [scan, Bool.and_eq_true] at h
    by_cases hj : j = i
    · simpa [hj] using h.1
    · exact ih (i+1) h.2 (by omega) (by omega)
def both (k i : ℕ) := verify k false i && verify k true i


