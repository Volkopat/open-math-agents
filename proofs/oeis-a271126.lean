def sz (n : ℕ)  : ℕ :=
  match n with
  | 0 => 2
  | 1 => 10
  | 2 => 1049
  | 3 => 5038
  | 4 => 3530
  | 5 => 2491
  | 6 => 1947
  | 7 => 1948
  | _ => 1948

def findId (n : ℕ) (q : Q ℕ) : ℕ :=
  match n with
  | 0 => 0
  | 1 => 0
  | 2 => perm2 ((hTwo q % 1259 + off2 (hOne q % 263) * (1 + hThree q % 1258)) % 1259)
  | 3 => perm3 ((hTwo q % 6047 + off3 (hOne q % 1260) * (1 + hThree q % 6046)) % 6047)
  | 4 => perm4 ((hTwo q % 4241 + off4 (hOne q % 883) * (1 + hThree q % 4240)) % 4241)
  | 5 => perm5 ((hTwo q % 2999 + off5 (hOne q % 623) * (1 + hThree q % 2998)) % 2999)
  | 6 => perm6 ((hTwo q % 2339 + off6 (hOne q % 487) * (1 + hThree q % 2338)) % 2339)
  | 7 => perm7 ((hTwo q % 2339 + off7 (hOne q % 487) * (1 + hThree q % 2338)) % 2339)
