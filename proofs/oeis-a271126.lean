def ch (n : ℕ) (i : ℕ) : Q ℕ :=
  match n with
  | 0 => ⟨0,0,0,0⟩
  | 1 => let v := child1 i; ⟨v % 2, (v >>> 1) % 2, (v >>> 2) % 2, v >>> 3⟩
  | 2 => let v := child2 i; ⟨v % 16, (v >>> 4) % 16, (v >>> 8) % 16, v >>> 12⟩
  | 3 => let v := child3 i; ⟨v % 2048, (v >>> 11) % 2048, (v >>> 22) % 2048, v >>> 33⟩
  | 4 => let v := child4 i; ⟨v % 8192, (v >>> 13) % 8192, (v >>> 26) % 8192, v >>> 39⟩
  | 5 => let v := child5 i; ⟨v % 4096, (v >>> 12) % 4096, (v >>> 24) % 4096, v >>> 36⟩
  | 6 => let v := child6 i; ⟨v % 4096, (v >>> 12) % 4096, (v >>> 24) % 4096, v >>> 36⟩
