lemma stabilized (k : ℕ) (s : Bool) (u : ℕ) :
    verify (k+8) s u = verify 8 s u := by
  rfl
lemma checked (k : ℕ) (s : Bool) (u : ℕ) (hu : u < sz (k+2)) :
    verify k s u = true := by
  have h : both k u = true := by
    by_cases hk : k < 8
    · exact checkedFinite ⟨k,by omega⟩ u hu
    · obtain ⟨j,rfl⟩ : ∃ j, k=j+8 := ⟨k-8,by omega⟩
      exact checkedFinite 8 u hu
  simp only [both, Bool.and_eq_true] at h
  cases s <;> tauto
lemma certified (k : ℕ) (s : Bool) (u : ℕ) (ok : resBound (k+2) s u ≠ 0) :
    jump k s (repr ch (k+2) u) = repr ch (k+1) (resBound (k+2) s u-1) := by
  induction k generalizing s u with
  | zero =>
    have hu : u < sz 2 := by by_contra h; simp [resBound, h] at ok
    have hv := checked 0 s u hu
    change @Eq (Q Bool) (jump 0 s (repr ch 2 u)) (repr ch 1 (resBound 2 s u-1))
    simpa only [verify, show (resBound 2 s u == 0) = false by simpa using ok,
      Bool.false_or, sameBoolQuad, decide_eq_true_eq] using hv
  | succ k ih =>
    apply certSound ch findId resBound k s u
    · have hu : u < sz (k+3) := by by_contra h; simp [resBound, h] at ok
      have hv := checked (k+1) s u hu
      simpa only [verify, show (resBound (k+3) s u == 0) = false by simpa using ok,
        Bool.false_or] using hv
    · exact ih


def flat : (k : ℕ) → B k
  | 0 => false
  | k+1 => ⟨flat k, flat k, flat k, flat k⟩

def corner : (k : ℕ) → B k
  | 0 => true
  | k+1 => ⟨corner k, flat k, flat k, flat k⟩

lemma winFlat (k : ℕ) (x y : ℤ) (h : 0 < x ∨ x+2^k ≤ 0 ∨ 0 < y ∨ y+2^k ≤ 0) :
    window k 0 x y = flat k := by
  induction k generalizing x y with
  | zero => simp only [window, flat, cell]; simp [show ¬(x=0 ∧ y=0) by simp at h; omega] <;> rfl
  | succ k ih =>
    rw [pow_succ] at h
    have hp : 0 < (2:ℤ)^k := by positivity
    simp only [window, flat]
    congr 1 <;> apply ih <;> omega

lemma winCorner (k : ℕ) : window k 0 0 0 = corner k := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [window, corner, ih, zero_add]
    have hp : 0 < (2:ℤ)^k := by positivity
    congr 1 <;> apply winFlat <;> omega

lemma zeroID (n : ℕ) : ch (n+1) 0 = ⟨0,0,0,0⟩ := by
  by_cases h : n < 8
  · interval_cases n <;> decide
  · obtain ⟨j,rfl⟩ : ∃ j, n=j+8 := ⟨n-8,by omega⟩
    rfl

lemma flatID (k : ℕ) : repr ch k 0 = flat k := by
  induction k with
  | zero => rfl
  | succ k ih => simp only [repr, zeroID, Q.map, ih, flat] <;> rfl

def cid : ℕ → ℕ
  | 0 => 1 | 1 => 5 | 2 => 480 | 3 => 2399 | 4 => 1909 | 5 => 1028 | _ => 864
def seedID : ℕ → ℕ
  | 0 => 2 | 1 => 10 | 2 => 15 | 3 => 16 | _ => 17
def outID : ℕ → ℕ
  | 0 => 1 | 1 => 1035 | 2 => 5033 | 3 => 3525 | 4 => 2486 | 5 => 1942 | _ => 1943

lemma idChild (n : ℕ) : ch (n+1) (cid (n+1)) = ⟨cid n,0,0,0⟩ := by
  by_cases h : n<8
  · interval_cases n <;> decide
  · obtain ⟨j,rfl⟩ : ∃ j, n=j+8 := ⟨n-8,by omega⟩
    change ch 8 864 = ⟨864,0,0,0⟩
    decide

lemma cornerID (k : ℕ) : repr ch k (cid k) = corner k := by
  induction k with
  | zero => rfl
  | succ k ih => simp only [repr, idChild, Q.map, flatID, ih, corner] <;> rfl

lemma seedChild (n : ℕ) : ch (n+2) (seedID n) = ⟨0,0,0,cid (n+1)⟩ := by
  by_cases h : n < 8
  · interval_cases n <;> decide
  · obtain ⟨j,rfl⟩ : ∃ j, n=j+8 := ⟨n-8,by omega⟩
    change ch 8 17 = ⟨0,0,0,864⟩
    decide

lemma seedWindow (n : ℕ) : window (n+2) 0 (-(2:ℤ)^(n+1)) (-(2:ℤ)^(n+1)) =
    repr ch (n+2) (seedID n) := by
  rw [window, repr, seedChild]
  simp only [Q.map, flatID, cornerID, neg_add_cancel, winCorner]
  congr 1 <;> apply winFlat <;> omega

lemma resultID (n : ℕ) : resBound (n+2) true (seedID n) = outID n+1 := by
  by_cases h : n < 8
  · interval_cases n <;> decide
  · obtain ⟨j,rfl⟩ : ∃ j, n=j+8 := ⟨n-8,by omega⟩
    change resBound 9 true 17 = 1943+1
    decide

lemma finalWindow (n : ℕ) : window (n+1) (2^n-1) (-(2:ℤ)^n) (-(2:ℤ)^n) =
    repr ch (n+1) (outID n) := by
  have h := sound n true 0 (-(2:ℤ)^(n+1)) (-(2:ℤ)^(n+1))
  rw [seedWindow, certified n true _ (by rw [resultID]; omega), resultID] at h
  simpa [pow_succ, show ∀ z : ℤ, -(z*2)+z = -z by intro; ring] using h.symm

def mass : (k : ℕ) → B k → ℤ
  | 0, x => x.toNat
  | k+1, q => mass k q.a + mass k q.b + mass k q.c + mass k q.d

def row (d : ℕ) (x : ℤ) (f : ℤ → ℤ) : ℤ :=
  ∑ i ∈ Finset.range d, f (x+i)

lemma rowDouble (d : ℕ) (x : ℤ) (f : ℤ → ℤ) :
    row (d*2) x f = row d x f + row d (x+d) f := by
  rw [Nat.mul_two]
  unfold row
  rw [Finset.sum_range_add]
  simp only [Nat.cast_add, add_assoc]

lemma massWindow (k t : ℕ) (x y : ℤ) : mass k (window k t x y) =
    row (2^k) x (fun i => row (2^k) y (fun j => ((cell 289 t i j).toNat:ℤ))) := by
  induction k generalizing x y with
  | zero => simp [mass, window, row]
  | succ k ih =>
    simp only [mass, window, ih, pow_succ]
    simp_rw [rowDouble]
    simp [row, Finset.sum_add_distrib, add_assoc]

def oddB (i : ℤ) : Bool := decide (i%2 = 1)




lemma exterior (t : ℕ) (x y : ℤ)
    (h : x < -(t:ℤ) ∨ (t:ℤ) < x ∨ y < -(t:ℤ) ∨ (t:ℤ) < y) :
    cell 289 t x y = (oddB t) := by
  induction t generalizing x y with
  | zero =>
    simp only [cell, Nat.cast_zero, neg_zero] at *
    simp [show ¬ (x = 0 ∧ y = 0) by omega, oddB]
  | succ t ih =>
    simp only [Nat.cast_succ] at h
    simp only [cell]
    rw [ih x y (by omega), ih (x+1) y (by omega), ih (x-1) y (by omega),
      ih x (y+1) (by omega), ih x (y-1) (by omega)]
    all_goals by_cases e : (t:ℤ)%2 = 0
    · simp [oddB, e, show ((t:ℤ)+1)%2=1 by omega]
    · simp [oddB, show (t:ℤ)%2=1 by omega, show ((t:ℤ)+1)%2=0 by omega] <;> decide

lemma rowHead (n : ℕ) (x : ℤ) (f : ℤ → ℤ) :
    row (n+1) x f = f x + row n (x+1) f := by
  unfold row
  rw [Finset.sum_range_succ']
  simp only [Nat.cast_zero, add_zero, Nat.cast_succ]
  simp_rw [show ∀ i : ℤ, x + (i+1) = x+1+i by intro i; ring]
  exact add_comm _ _

def countZ (t : ℕ) : ℤ := onCount 289 t

lemma countSquare (t : ℕ) :
    row (2*t+2) (-(t:ℤ)-1) (fun x => row (2*t+2) (-(t:ℤ)-1)
      (fun y => ((cell 289 t x y).toNat : ℤ))) =
    countZ t + (4*(t:ℤ)+3) * ((oddB t)).toNat := by
  have he (j : ℤ) : cell 289 t (-(t:ℤ)-1) j = (oddB t) := exterior _ _ _ (by omega)
  have hf (i : ℤ) : cell 289 t i (-(t:ℤ)-1) = (oddB t) := exterior _ _ _ (by omega)
  rw [rowHead]
  simp_rw [he]
  simp_rw [rowHead (2*t+1), hf]
  simp only [sub_add_cancel]
  unfold countZ onCount row
  push_cast
  simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have eqb (v : Bool) : (v.toNat : ℤ) = (if v then 1 else 0) := by cases v <;> rfl
  simp_rw [eqb]
  simp only [sub_eq_neg_add]
  push_cast
  ring_nf



lemma massCount (n : ℕ) (hn : 0 < n) : mass (n+1) (repr ch (n+1) (outID n)) =
    a n + 4*(2:ℤ)^n-1 := by
  let t := (2:ℕ)^n-1
  have hp : 0 < (2:ℕ)^n := by positivity
  have ht : (t:ℤ) = 2^n-1 := by dsimp [t]; rw [Nat.cast_sub (by omega)]; push_cast; rfl
  have hd : (2:ℕ)^(n+1) = 2*t+2 := by rw [pow_succ]; dsimp [t]; omega
  have hb : oddB t = true := by
    obtain ⟨j,rfl⟩ : ∃ j,n=j+1 := ⟨n-1,by omega⟩
    simp [oddB, ht, pow_succ, Int.sub_emod]
  rw [← finalWindow, massWindow, hd, show -(2:ℤ)^n = -(t:ℤ)-1 by omega, countSquare, hb]
  change (a n) + _ = _
  rw [ht]; norm_num; ring


