import OMAStatements.S_oeis_a271126

open OMA.S_oeis_a271126

namespace Tiled

structure Q (α : Type) where
  a : α
  b : α
  c : α
  d : α
  deriving DecidableEq

def Q.map (f : α → β) (u : Q α) : Q β := ⟨f u.a, f u.b, f u.c, f u.d⟩

structure Nine (α : Type) where
  a : α
  b : α
  c : α
  d : α
  e : α
  f : α
  g : α
  h : α
  i : α

def Nine.map (f : α → β) (u : Nine α) : Nine β :=
  ⟨f u.a, f u.b, f u.c, f u.d, f u.e, f u.f, f u.g, f u.h, f u.i⟩

def blocks (u : Q (Q α)) : Nine (Q α) :=
  ⟨u.a, ⟨u.a.b,u.b.a,u.a.d,u.b.c⟩, u.b,
   ⟨u.a.c,u.a.d,u.c.a,u.c.b⟩, ⟨u.a.d,u.b.c,u.c.b,u.d.a⟩, ⟨u.b.c,u.b.d,u.d.a,u.d.b⟩,
   u.c, ⟨u.c.b,u.d.a,u.c.d,u.d.c⟩, u.d⟩

def around (v : Nine α) : Q (Q α) :=
  ⟨⟨v.a,v.b,v.d,v.e⟩,⟨v.b,v.c,v.e,v.f⟩,⟨v.d,v.e,v.g,v.h⟩,⟨v.e,v.f,v.h,v.i⟩⟩

def B : ℕ → Type
  | 0 => Bool
  | k+1 => Q (B k)

def tick (m a b c d : Bool) : Bool :=
  (289:ℕ).testBit (m.toNat + 2*(a.toNat+b.toNat+c.toNat+d.toNat))

def one (short : Bool) (u : Q (Q Bool)) : Q Bool := if short then (blocks u).e else
  ⟨tick u.a.d u.c.b u.a.b u.b.c u.a.c, tick u.b.c u.d.a u.b.a u.b.d u.a.d,
   tick u.c.b u.c.d u.a.d u.d.a u.c.a, tick u.d.a u.d.c u.b.c u.d.b u.c.b⟩

def jump : (k : ℕ) → Bool → B (k+2) → B (k+1)
  | 0 => one
  | k+1 => fun s u => (around ((blocks u).map (jump k false))).map (jump k s)

def window : (k : ℕ) → ℕ → ℤ → ℤ → B k
  | 0,t,x,y => cell 289 t x y
  | k+1,t,x,y => ⟨window k t x y, window k t x (y+2^k),
      window k t (x+2^k) y, window k t (x+2^k) (y+2^k)⟩

def grid (f : ℤ → ℤ → α) (x y d : ℤ) : Nine α :=
  ⟨f x y, f x (y+d), f x (y+2*d), f (x+d) y, f (x+d) (y+d),
   f (x+d) (y+2*d), f (x+2*d) y, f (x+2*d) (y+d), f (x+2*d) (y+2*d)⟩

lemma gridWindow (k t : ℕ) (x y : ℤ) :
    blocks (window (k+2) t x y) = grid (window (k+1) t) x y (2^k) := by
  simp only [window, blocks, grid, pow_succ]
  congr 1 <;> congr 1 <;> congr 1 <;> ring

lemma aroundWindow (k t : ℕ) (x y : ℤ) :
    around (grid (window k t) x y (2^k)) =
      ⟨window (k+1) t x y, window (k+1) t x (y+2^k),
       window (k+1) t (x+2^k) y, window (k+1) t (x+2^k) (y+2^k)⟩ := by
  simp only [around, grid, window]
  congr 1 <;> congr 1 <;> congr 1 <;> ring

lemma sound (k : ℕ) (s : Bool) (t : ℕ) (x y : ℤ) :
    jump k s (window (k+2) t x y) =
      window (k+1) (t+(2^k-s.toNat)) (x+2^k) (y+2^k) := by
  induction k generalizing s t x y with
  | zero =>
    cases s <;> simp only [jump, one, window, blocks, cell, tick, pow_zero, pow_one,
      Bool.toNat_false, Bool.toNat_true, Nat.sub_zero, Nat.sub_self, add_zero,
      Bool.false_eq_true, if_false, if_true, reduceCtorEq]
    all_goals ring_nf <;> rfl
  | succ k ih =>
    simp only [jump]
    rw [gridWindow (k+1)]
    have hh : (grid (window (k+2) t) x y (2^(k+1))).map (jump k false) =
        grid (window (k+1) (t+2^k)) (x+2^k) (y+2^k) (2^(k+1)) := by
      simp only [grid, Nine.map, ih, Bool.toNat_false, Nat.sub_zero]
      congr 1 <;> congr 1 <;> ring
    rw [hh, aroundWindow]
    simp only [Q.map, ih]
    conv_rhs => rw [window]
    have hp : 0 < (2:ℕ)^k := by positivity
    have hb : s.toNat ≤ 1 := by cases s <;> decide
    simp only [pow_succ]
    congr 1 <;> congr 1 <;> first | omega | ring



def repr (ch : ℕ → ℕ → Q ℕ) : (k : ℕ) → ℕ → B k
  | 0, i => decide (i = 1)
  | k+1, i => (ch (k+1) i).map (repr ch k)

def raw9 (ch : ℕ → ℕ → Q ℕ) (n u : ℕ) :=
  blocks ((ch (n+1) u).map (ch n))

def Nine.All (p : α → Bool) (u : Nine α) : Bool :=
  p u.a && p u.b && p u.c && p u.d && p u.e && p u.f && p u.g && p u.h && p u.i

def Q.All (p : α → Bool) (u : Q α) : Bool := p u.a && p u.b && p u.c && p u.d

def cert (ch : ℕ → ℕ → Q ℕ) (find : ℕ → Q ℕ → ℕ)
    (res : ℕ → Bool → ℕ → ℕ) (n : ℕ) (s : Bool) (u : ℕ) : Bool := Id.run do
  let r := raw9 ch n u
  let v := r.map (find n)
  let f := fun i => res n false i - 1
  let b := around (v.map f)
  let w := b.map (find n)
  return r.All (fun q => decide (ch n (find n q) = q) && (res n false (find n q) != 0)) &&
    b.All (fun q => decide (ch n (find n q) = q) && (res n s (find n q) != 0)) &&
    decide (w.map (fun i => res n s i-1) = ch n (res (n+1) s u-1))

lemma mapQmap (f : α → β) (g : β → γ) (q : Q α) :
    (q.map f).map g = q.map (fun x => g (f x)) := rfl

lemma mapNmap (f : α → β) (g : β → γ) (q : Nine α) :
    (q.map f).map g = q.map (fun x => g (f x)) := rfl

lemma blocksMap (f : α → β) (u : Q (Q α)) :
    blocks (u.map (Q.map f)) = (blocks u).map (Q.map f) := rfl

lemma aroundMap (f : α → β) (u : Nine α) :
    around (u.map f) = (around u).map (Q.map f) := rfl

lemma mapNineIf (q : Nine α) (p : α → Bool) (f g : α → β)
    (h : q.All p = true) (eq : ∀ a, p a = true → f a = g a) : q.map f = q.map g := by
  simp only [Nine.All, Bool.and_eq_true] at h
  simp only [Nine.map]
  congr 1 <;> apply eq <;> tauto

lemma mapQuadIf (q : Q α) (p : α → Bool) (f g : α → β)
    (h : q.All p = true) (eq : ∀ a, p a = true → f a = g a) : q.map f = q.map g := by
  simp only [Q.All, Bool.and_eq_true] at h
  simp only [Q.map]
  congr 1 <;> apply eq <;> tauto

lemma certSound (ch : ℕ → ℕ → Q ℕ) (find : ℕ → Q ℕ → ℕ) (res : ℕ → Bool → ℕ → ℕ)
    (k : ℕ) (s : Bool) (u : ℕ) (hc : cert ch find res (k+2) s u = true)
    (ih : ∀ b i, res (k+2) b i ≠ 0 →
      jump k b (repr ch (k+2) i) = repr ch (k+1) (res (k+2) b i-1)) :
    jump (k+1) s (repr ch (k+3) u) = repr ch (k+2) (res (k+3) s u-1) := by
  let n := k+2
  let r := raw9 ch n u
  let f := fun b q => res n b (find n q)-1
  let b := around (r.map (f false))
  have hp (m : Bool) (q : Q ℕ)
      (h : (decide (ch n (find n q) = q) && (res n m (find n q) != 0)) = true) :
      jump k m (q.map (repr ch (k+1))) = repr ch (k+1) (f m q) := by
    simp only [Bool.and_eq_true] at h
    obtain ⟨h₁,h₂⟩ := h
    have e := of_decide_eq_true h₁
    have h₃ := ih m (find n q) (by simpa [n] using h₂)
    change jump k m ((ch n (find n q)).map (repr ch (k+1))) = _ at h₃
    rw [e] at h₃
    exact h₃
  change (_ && _ && decide (_ = _)) = true at hc
  simp only [Bool.and_eq_true] at hc
  obtain ⟨⟨h₁,h₂⟩,h₃⟩ := hc
  have e := of_decide_eq_true h₃
  have first : (blocks (repr ch (k+3) u)).map (jump k false) =
      (r.map (f false)).map (repr ch (k+1)) := by
    change ((r.map (Q.map (repr ch (k+1)))).map (jump k false)) = _
    change r.map (fun q => jump k false (q.map (repr ch (k+1)))) = r.map (fun q => repr ch (k+1) (f false q))
    apply mapNineIf _ _ _ _ h₁
    exact hp false
  simp only [jump]
  rw [first, aroundMap]
  change b.map (fun q => jump k s (q.map (repr ch (k+1)))) = _
  rw [mapQuadIf b _ _ (fun q => repr ch (k+1) (f s q)) h₂ (hp s)]
  change (b.map (f s)).map (repr ch (k+1)) = (ch n (res (n+1) s u-1)).map (repr ch (k+1))
  exact congrArg (Q.map (repr ch (k+1))) e


