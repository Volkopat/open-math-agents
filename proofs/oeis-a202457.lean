/-- Barker's g.f., as A(x) (1 - x)^7 = N(x) in Z[[x]]. -/
theorem gf : PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 7 =
    X * (1331 - 6482 * X + 13841 * X ^ 2 - 16277 * X ^ 3 + 10983 * X ^ 4 - 4003 * X ^ 5 + 613 * X ^
      6) := by
  set A : ℤ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) with hA
  have e1 : A * (1 - X) ^ 7 =
      A - C 7 * (A * X ^ 1) + C 21 * (A * X ^ 2) - C 35 * (A * X ^ 3) + C 35 * (A * X ^ 4) - C 21 *
        (A * X ^ 5) + C 7 * (A * X ^ 6) - A * X ^ 7 := by
    simp only [map_ofNat]; ring
  have e2 : (X * (1331 - 6482 * X + 13841 * X ^ 2 - 16277 * X ^ 3 + 10983 * X ^ 4 - 4003 * X ^ 5 +
    613 * X ^ 6) : ℤ⟦X⟧) =
      X ^ 1 * C 1331 - X ^ 2 * C 6482 + X ^ 3 * C 13841 - X ^ 4 * C 16277 + X ^ 5 * C 10983 - X ^
        6 * C 4003 + X ^ 7 * C 613 := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℤ) else a k := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  have v := values
  rcases Nat.lt_or_ge n 8 with hn | hn
  · interval_cases n <;> simp_all
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 8 := ⟨n - 8, by omega⟩
    have h := recurrence (q + 8) (by omega)
    simp only [show q + 8 - 1 = q + 7 by omega, show q + 8 - 2 = q + 6 by omega, show q + 8 - 3 =
      q + 5 by omega, show q + 8 - 4 = q + 4 by omega, show q + 8 - 5 = q + 3 by omega, show q + 8 -
      6 = q + 2 by omega, show q + 8 - 7 = q + 1 by omega] at h ⊢
    simp only [show ¬ q + 8 = 0 by omega, show ¬ q + 7 = 0 by omega, show ¬ q + 6 = 0 by omega, show
      ¬ q + 5 = 0 by omega, show ¬ q + 4 = 0 by omega, show ¬ q + 3 = 0 by omega, show ¬ q + 2 = 0
      by omega, show ¬ q + 1 = 0 by omega, show 1 ≤ q + 8 by omega, show 2 ≤ q + 8 by omega, show 3
      ≤ q + 8 by omega, show 4 ≤ q + 8 by omega, show 5 ≤ q + 8 by omega, show 6 ≤ q + 8 by omega,
      show 7 ≤ q + 8 by omega, show ¬ q + 8 = 1 by omega, show ¬ q + 8 = 2 by omega, show ¬ q + 8 =
      3 by omega, show ¬ q + 8 = 4 by omega, show ¬ q + 8 = 5 by omega, show ¬ q + 8 = 6 by omega,
      show ¬ q + 8 = 7 by omega, if_true, if_false]
    rw [h]
    ring

/-- Hardin's empirical formula, for n >= 1. -/
theorem empirical (n : ℕ) (hn : 1 ≤ n) : (a n : ℚ) = 1 / 120 * n ^ 6 + 17 / 40 * n ^ 5 + 27 / 4 * n
    ^ 4 + 1195 / 24 * n ^ 3 + 22769 / 120 * n ^ 2 + 28277 / 60 * n + 613 := by
  obtain ⟨w1, w2, w3, w4, w5, w6, w7⟩ := values
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 8 with h7 | h7
    · interval_cases n
      · rw [w1]; norm_num
      · rw [w2]; norm_num
      · rw [w3]; norm_num
      · rw [w4]; norm_num
      · rw [w5]; norm_num
      · rw [w6]; norm_num
      · rw [w7]; norm_num
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + 8 := ⟨n - 8, by omega⟩
      have h := recurrence (k + 8) (by omega)
      simp only [show k + 8 - 1 = k + 7 by omega, show k + 8 - 2 = k + 6 by omega, show k + 8 - 3 =
        k + 5 by omega, show k + 8 - 4 = k + 4 by omega, show k + 8 - 5 = k + 3 by omega, show k +
        8 - 6 = k + 2 by omega, show k + 8 - 7 = k + 1 by omega] at h
      have h' : (a (k + 8) : ℚ) = 7 * a (k + 7) - 21 * a (k + 6) + 35 * a (k + 5) - 35 * a (k + 4) +
          21 * a (k + 3) - 7 * a (k + 2) + a (k + 1) := by exact_mod_cast h
      rw [h', ih (k + 7) (by omega) (by omega), ih (k + 6) (by omega) (by omega), ih (k + 5) (by
        omega) (by omega), ih (k + 4) (by omega) (by omega), ih (k + 3) (by omega) (by omega), ih
        (k + 2) (by omega) (by omega), ih (k + 1) (by omega) (by omega)]
      push_cast
      ring

