/-- (E - 1)^7 G = 0 from m = 3 on, on every state. -/
theorem G_rec (m : ℕ) : ∀ a b c : Fin 11, (G a b c (m + 10) : ℤ) = 7 * G a b c (m + 9) - 21 * G a b
    c (m + 8) + 35 * G a b c (m + 7) - 35 * G a b c (m + 6) + 21 * G a b c (m + 5) - 7 * G a b c
    (m + 4) + G a b c (m + 3) := by
  induction m with
  | zero =>
    intro a b c
    rw [G10, G9, G8, G7, G6, G5, G4, G3]
    revert a b c
    decide +kernel
  | succ m ih =>
    intro a b c
    rw [G_succ a b c (m + 10), G_succ a b c (m + 9), G_succ a b c (m + 8), G_succ a b c (m + 7),
      G_succ a b c (m + 6), G_succ a b c (m + 5), G_succ a b c (m + 4), G_succ a b c (m + 3)]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    split_ifs
    · exact ih _ _ _
    · simp

