import OMAStatements.S_oeis_a231104

/-!
Proof of Barker's conjectures for OEIS A231104, by a transfer computation over the rows.

The rows are scanned with a window: the continuation count N p c m counts the ways to put m rows
below the row c, when p is the row above c (or `none`), such that every element of c and of the
new rows passes `cellOk`. It depends on p only through which elements of c still need their
neighbour below and whether c is compatible with p, and it satisfies, for every window, the
recurrence of the polynomial x (x + 1) (x - 9). The tables of N_0 .. N_3 were computed by a
script and are checked by the kernel, through two partial sums that the kernel tabulates.
-/

namespace OMA.S_oeis_a231104

open PowerSeries

abbrev R := Fin 4 → Fin 4

/-- All elements of the row c pass `cellOk`, with p above and q below. -/
def Wb (p : Option R) (c : R) (q : Option R) : Bool := decide (∀ j : Fin 4, cellOk p c q j)

/-- Scanning the rows l below the row c, where p is the row above c. -/
def okW : Option R → R → List R → Bool
  | p, c, [] => Wb p c none
  | p, c, r :: l => Wb p c (some r) && okW (some c) r l

/-- The row above row i, where p is the row above row 0. -/
def aboveP {n : ℕ} (p : Option R) (x : Fin n → R) (i : Fin n) : Option R :=
  if h : 0 < i.val then some (x ⟨i.val - 1, by omega⟩) else p

theorem chain (n : ℕ) : ∀ (p : Option R) (x : Fin (n + 1) → R),
    (∀ i : Fin (n + 1), ∀ j : Fin 4, cellOk (aboveP p x i) (x i) (below x i) j) ↔
      okW p (x 0) (List.ofFn fun i : Fin n => x i.succ) = true := by
  induction n with
  | zero =>
    intro p x
    have h1 : aboveP p x 0 = p := by simp [aboveP]
    have h2 : below x 0 = none := by simp [below]
    simp only [List.ofFn_zero, okW, Wb, decide_eq_true_eq]
    constructor
    · intro h j
      have := h 0 j
      rwa [h1, h2] at this
    · intro h i j
      have hi : i = 0 := Fin.fin_one_eq_zero i
      subst hi
      rw [h1, h2]
      exact h j
  | succ n ih =>
    intro p x
    have h := ih (some (x 0)) (fun i => x i.succ)
    have e1 : aboveP p x 0 = p := by simp [aboveP]
    have e2 : below x 0 = some (x (Fin.succ 0)) := by
      unfold below
      rw [dif_pos (by simp)]
      rfl
    have e3 : ∀ k : Fin (n + 1), aboveP p x k.succ = aboveP (some (x 0)) (fun i => x i.succ) k := by
      intro k
      unfold aboveP
      rw [dif_pos (by simp)]
      by_cases hk : 0 < k.val
      · rw [dif_pos hk]
        congr 2
        ext
        simp only [Fin.val_succ]
        omega
      · rw [dif_neg hk]
        congr 2
        ext
        simp only [Fin.val_succ, Fin.val_zero]
        omega
    have e4 : ∀ k : Fin (n + 1), below x k.succ = below (fun i => x i.succ) k := by
      intro k
      unfold below
      simp only [Fin.val_succ]
      by_cases hk : k.val + 1 < n + 1
      · rw [dif_pos (by omega), dif_pos hk]
        rfl
      · rw [dif_neg (by omega), dif_neg hk]
    rw [List.ofFn_succ, okW, Bool.and_eq_true, Fin.forall_fin_succ]
    simp only [e1, e2, e3, e4]
    simp only [Fin.succ_zero_eq_one] at h ⊢
    exact and_congr decide_eq_true_iff.symm h

/-- The continuations of the window (p, c) by m rows. -/
def N (p : Option R) (c : R) (m : ℕ) : ℕ :=
  ∑ y : Fin m → R, if okW p c (List.ofFn y) = true then 1 else 0

theorem sum_cons {α : Type} [Fintype α] (m : ℕ) (f : List α → ℕ) :
    ∑ x : Fin (m + 1) → α, f (List.ofFn x) = ∑ c : α, ∑ y : Fin m → α, f (c :: List.ofFn y) := by
  rw [← (Fin.consEquiv fun _ => α).sum_comp]
  rw [Fintype.sum_prod_type (f := fun p : α × (Fin m → α) =>
    f (List.ofFn ((Fin.consEquiv fun _ => α) p)))]
  simp [List.ofFn_succ]

theorem N_zero (p : Option R) (c : R) : N p c 0 = if Wb p c none = true then 1 else 0 := by
  simp [N, okW]

theorem N_succ (p : Option R) (c : R) (m : ℕ) :
    N p c (m + 1) = ∑ r : R, if Wb p c (some r) = true then N (some c) r m else 0 := by
  have h := sum_cons m (fun l => if okW p c l = true then 1 else 0)
  unfold N
  rw [h]
  apply Finset.sum_congr rfl
  intro r _
  by_cases hc : Wb p c (some r) = true
  · rw [if_pos hc]
    apply Finset.sum_congr rfl
    intro y _
    simp only [okW, hc, Bool.true_and]
  · rw [if_neg hc]
    apply Finset.sum_eq_zero
    intro y _
    have hc' := Bool.eq_false_iff.mpr hc
    have hk : okW p c (r :: List.ofFn y) = false := by
      simp only [okW, hc', Bool.false_and]
    simp [hk]

theorem a_eq (n : ℕ) : a (n + 1) = ∑ c : R, if c 0 = 0 then N none c n else 0 := by
  unfold a N
  rw [Finset.card_filter, ← (Fin.consEquiv fun _ => R).sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun c _ => ?_
  have hv' : ∀ y : Fin n → R, valid (Fin.cons c y : Fin (n + 1) → R) ↔
      c 0 = 0 ∧ okW none c (List.ofFn y) = true := by
    intro y
    have h := chain n none (Fin.cons c y)
    simp only [Fin.cons_zero, Fin.cons_succ] at h
    have ha : above (Fin.cons c y : Fin (n + 1) → R) = aboveP none (Fin.cons c y) := rfl
    unfold valid
    rw [ha, h]
    constructor
    · rintro ⟨h0, h1⟩
      exact ⟨by simpa using h0 (Nat.succ_pos n), h1⟩
    · rintro ⟨h0, h1⟩
      exact ⟨fun _ => by simpa using h0, h1⟩
  have hv : ∀ y : Fin n → R, valid ((Fin.consEquiv fun _ => R) (c, y)) ↔
      c 0 = 0 ∧ okW none c (List.ofFn y) = true := fun y => hv' y
  simp only [hv, ite_and]
  by_cases h0 : c 0 = 0
  · simp only [h0, if_true]
  · simp only [h0, if_false, Finset.sum_const_zero]

/-! The window state: the row c, which elements of c still need their neighbour below (m0 .. m3),
and whether c has no equal horizontal neighbours and none equal to its neighbours above (zz). -/

abbrev FT := Fin 4 → Fin 4 → Fin 4 → Fin 4 → Bool → Bool → Bool → Bool → Bool → ℕ
abbrev FH := Fin 4 → Fin 4 → Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℕ
abbrev FH2 := Fin 4 → Fin 4 → Fin 4 → Bool → Fin 4 → Fin 4 → ℕ

def opt (f : Bool) (p0 p1 p2 p3 : Fin 4) : Option R := if f then some ![p0, p1, p2, p3] else none

def hn (c0 c1 c2 c3 : Fin 4) : Bool := decide (c0 ≠ c1) && decide (c1 ≠ c2) && decide (c2 ≠ c3)
def zf (f : Bool) (p1 p2 p3 c0 c1 c2 : Fin 4) : Bool :=
  !f || (decide (p1 ≠ c0) && decide (p2 ≠ c1) && decide (p3 ≠ c2))
def m0f (f : Bool) (p1 c0 c1 : Fin 4) : Bool := !(decide (c1 = c0 + 1) || (f && decide (p1 = c0 + 1)))
def m1f (f : Bool) (p2 c0 c1 c2 : Fin 4) : Bool :=
  !(decide (c0 = c1 + 1) || decide (c2 = c1 + 1) || (f && decide (p2 = c1 + 1)))
def m2f (f : Bool) (p3 c1 c2 c3 : Fin 4) : Bool :=
  !(decide (c1 = c2 + 1) || decide (c3 = c2 + 1) || (f && decide (p3 = c2 + 1)))
def m3f (c2 c3 : Fin 4) : Bool := !(decide (c2 = c3 + 1))
/-- The element c_j with its neighbour r below (column j-1): not equal, and the right value if
c_j still needs it. -/
def Af (cj : Fin 4) (mj : Bool) (r : Fin 4) : Bool := decide (r ≠ cj) && (!mj || decide (r = cj + 1))

set_option maxHeartbeats 8000000 in
theorem wb_some (f : Bool) (p0 p1 p2 p3 c0 c1 c2 c3 r0 r1 r2 r3 : Fin 4) :
    Wb (opt f p0 p1 p2 p3) ![c0, c1, c2, c3] (some ![r0, r1, r2, r3]) =
      ((zf f p1 p2 p3 c0 c1 c2 && hn c0 c1 c2 c3) && !(m0f f p1 c0 c1) &&
        Af c1 (m1f f p2 c0 c1 c2) r0 && Af c2 (m2f f p3 c1 c2 c3) r1 && Af c3 (m3f c2 c3) r2) := by
  rw [Bool.eq_iff_iff]
  cases f <;>
  simp [Wb, opt, cellOk, zf, hn, m0f, m1f, m2f, m3f, Af, Fin.forall_fin_succ, Fin.exists_fin_succ] <;>
  tauto

set_option maxHeartbeats 8000000 in
theorem wb_none (f : Bool) (p0 p1 p2 p3 c0 c1 c2 c3 : Fin 4) :
    Wb (opt f p0 p1 p2 p3) ![c0, c1, c2, c3] none =
      ((zf f p1 p2 p3 c0 c1 c2 && hn c0 c1 c2 c3) && !(m0f f p1 c0 c1) && !(m1f f p2 c0 c1 c2) &&
        !(m2f f p3 c1 c2 c3) && !(m3f c2 c3)) := by
  rw [Bool.eq_iff_iff]
  cases f <;>
  simp [Wb, opt, cellOk, zf, hn, m0f, m1f, m2f, m3f, Fin.forall_fin_succ, Fin.exists_fin_succ] <;>
  tauto

def sm (f : Fin 4 → ℕ) : ℕ := f 0 + f 1 + f 2 + f 3

theorem sm_eq (f : Fin 4 → ℕ) : sm f = ∑ x, f x := by
  simp [sm, Fin.sum_univ_succ, add_assoc]

def hS (F : FT) : FH := fun c1 c2 c3 r0 r1 r2 => sm fun r3 =>
  F r0 r1 r2 r3 (m0f true c1 r0 r1) (m1f true c2 r0 r1 r2) (m2f true c3 r1 r2 r3) (m3f r2 r3)
    (zf true c1 c2 c3 r0 r1 r2 && hn r0 r1 r2 r3)
def h2S (H : FH) : FH2 := fun c1 c2 c3 m3 r0 r1 => sm fun r2 =>
  if Af c3 m3 r2 = true then H c1 c2 c3 r0 r1 r2 else 0
def h1S (G : FH2) : FT := fun _ c1 c2 c3 m0 m1 m2 m3 zz =>
  if (zz && !m0) = true then
    sm fun r0 => sm fun r1 => if (Af c1 m1 r0 && Af c2 m2 r1) = true then G c1 c2 c3 m3 r0 r1 else 0
  else 0
def step (F : FT) : FT := h1S (h2S (hS F))

theorem sum_pi (g : R → ℕ) :
    ∑ c, g c = ∑ r0 : Fin 4, ∑ r1 : Fin 4, ∑ r2 : Fin 4, ∑ r3 : Fin 4, g ![r0, r1, r2, r3] := by
  let e : Fin 4 × Fin 4 × Fin 4 × Fin 4 ≃ R :=
    { toFun := fun x => ![x.1, x.2.1, x.2.2.1, x.2.2.2]
      invFun := fun f => (f 0, f 1, f 2, f 3)
      left_inv := fun x => rfl
      right_inv := fun f => by
        funext j
        fin_cases j <;> rfl }
  rw [← e.sum_comp]
  simp only [Fintype.sum_prod_type]
  rfl

theorem row_sum (F : FT) (c0 c1 c2 c3 : Fin 4) (m0 m1 m2 m3 zz : Bool) :
    (∑ r : R, if (zz && !m0 && Af c1 m1 (r 0) && Af c2 m2 (r 1) && Af c3 m3 (r 2)) = true then
      F (r 0) (r 1) (r 2) (r 3) (m0f true c1 (r 0) (r 1)) (m1f true c2 (r 0) (r 1) (r 2))
        (m2f true c3 (r 1) (r 2) (r 3)) (m3f (r 2) (r 3))
        (zf true c1 c2 c3 (r 0) (r 1) (r 2) && hn (r 0) (r 1) (r 2) (r 3)) else 0) =
      step F c0 c1 c2 c3 m0 m1 m2 m3 zz := by
  rw [sum_pi]
  simp only [step, h1S, h2S, hS, sm_eq, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  simp only [Bool.and_eq_true, ite_and, Finset.sum_ite_irrel, Finset.sum_const_zero]

/-! Tables, packed as 18-bit fields of one numeral. -/

def look (t i : ℕ) : ℕ := (t >>> (18 * i)) % 2 ^ 18
def pk (f : ℕ → ℕ) : ℕ → ℕ → ℕ
  | 0, acc => acc
  | n + 1, acc => pk f n (acc * 2 ^ 18 + f n)
def dg (i k : ℕ) : Fin 4 := ⟨i / k % 4, Nat.mod_lt _ (by norm_num)⟩
def db (i k : ℕ) : Bool := decide (i / k % 2 = 1)
def iT (c0 c1 c2 c3 : Fin 4) (m0 m1 m2 m3 zz : Bool) : ℕ :=
  c0.val + 4 * (c1.val + 4 * (c2.val + 4 * (c3.val + 4 * (m0.toNat + 2 * (m1.toNat + 2 *
    (m2.toNat + 2 * (m3.toNat + 2 * zz.toNat)))))))
def iH (c1 c2 c3 r0 r1 r2 : Fin 4) : ℕ :=
  c1.val + 4 * (c2.val + 4 * (c3.val + 4 * (r0.val + 4 * (r1.val + 4 * r2.val))))
def iH2 (c1 c2 c3 : Fin 4) (m3 : Bool) (r0 r1 : Fin 4) : ℕ :=
  c1.val + 4 * (c2.val + 4 * (c3.val + 4 * (m3.toNat + 2 * (r0.val + 4 * r1.val))))
def tT (t : ℕ) : FT := fun c0 c1 c2 c3 m0 m1 m2 m3 zz => look t (iT c0 c1 c2 c3 m0 m1 m2 m3 zz)
def tH (t : ℕ) : FH := fun c1 c2 c3 r0 r1 r2 => look t (iH c1 c2 c3 r0 r1 r2)
def tH2 (t : ℕ) : FH2 := fun c1 c2 c3 m3 r0 r1 => look t (iH2 c1 c2 c3 m3 r0 r1)
def mkH (H : FH) : ℕ :=
  pk (fun i => H (dg i 1) (dg i 4) (dg i 16) (dg i 64) (dg i 256) (dg i 1024)) 4096 0
def mkH2 (H : FH2) : ℕ :=
  pk (fun i => H (dg i 1) (dg i 4) (dg i 16) (db i 64) (dg i 128) (dg i 512)) 2048 0

def T0 : ℕ := 

def T1 : ℕ := 

def T2 : ℕ := 

def T3 : ℕ := 

def V0 : ℕ := mkH (hS (tT T0))
def W0 : ℕ := mkH2 (h2S (tH V0))
def V1 : ℕ := mkH (hS (tT T1))
def W1 : ℕ := mkH2 (h2S (tH V1))
def V2 : ℕ := mkH (hS (tT T2))
def W2 : ℕ := mkH2 (h2S (tH V2))

def StageOk (A V W B : ℕ) : Prop :=
  (∀ c1 c2 c3 r0 r1 r2 : Fin 4, hS (tT A) c1 c2 c3 r0 r1 r2 = tH V c1 c2 c3 r0 r1 r2) ∧
  (∀ (c1 c2 c3 : Fin 4) (m3 : Bool) (r0 r1 : Fin 4),
    h2S (tH V) c1 c2 c3 m3 r0 r1 = tH2 W c1 c2 c3 m3 r0 r1) ∧
  (∀ (c0 c1 c2 c3 : Fin 4) (m0 m1 m2 m3 zz : Bool),
    h1S (tH2 W) c0 c1 c2 c3 m0 m1 m2 m3 zz = tT B c0 c1 c2 c3 m0 m1 m2 m3 zz)

instance (A V W B : ℕ) : Decidable (StageOk A V W B) := by unfold StageOk; infer_instance

theorem stage_0 : StageOk T0 V0 W0 T1 := by decide +kernel
theorem stage_1 : StageOk T1 V1 W1 T2 := by decide +kernel
theorem stage_2 : StageOk T2 V2 W2 T3 := by decide +kernel

theorem step_eq (A V W B : ℕ) (h : StageOk A V W B) : step (tT A) = tT B := by
  obtain ⟨h1, h2, h3⟩ := h
  have e1 : hS (tT A) = tH V := by funext c1 c2 c3 r0 r1 r2; exact h1 c1 c2 c3 r0 r1 r2
  have e2 : h2S (tH V) = tH2 W := by funext c1 c2 c3 m3 r0 r1; exact h2 c1 c2 c3 m3 r0 r1
  unfold step
  rw [e1, e2]
  funext c0 c1 c2 c3 m0 m1 m2 m3 zz
  exact h3 c0 c1 c2 c3 m0 m1 m2 m3 zz

theorem T0_eq : ∀ (c0 c1 c2 c3 : Fin 4) (m0 m1 m2 m3 zz : Bool),
    tT T0 c0 c1 c2 c3 m0 m1 m2 m3 zz =
      if (zz && !m0 && !m1 && !m2 && !m3) = true then 1 else 0 := by
  decide +kernel

/-! The continuation counts N_0 .. N_3, from the tables. -/

theorem some_eq (c0 c1 c2 c3 : Fin 4) : some ![c0, c1, c2, c3] = opt true c0 c1 c2 c3 := rfl

def Tab (m A : ℕ) : Prop := ∀ (f : Bool) (p0 p1 p2 p3 c0 c1 c2 c3 : Fin 4),
  N (opt f p0 p1 p2 p3) ![c0, c1, c2, c3] m =
    tT A c0 c1 c2 c3 (m0f f p1 c0 c1) (m1f f p2 c0 c1 c2) (m2f f p3 c1 c2 c3) (m3f c2 c3)
      (zf f p1 p2 p3 c0 c1 c2 && hn c0 c1 c2 c3)

theorem N_next (m : ℕ) (A B : ℕ) (hA : Tab m A) (h : step (tT A) = tT B) : Tab (m + 1) B := by
  intro f p0 p1 p2 p3 c0 c1 c2 c3
  rw [N_succ, ← h, ← row_sum]
  refine Finset.sum_congr rfl fun r _ => ?_
  obtain ⟨r0, r1, r2, r3, rfl⟩ : ∃ r0 r1 r2 r3 : Fin 4, r = ![r0, r1, r2, r3] :=
    ⟨r 0, r 1, r 2, r 3, by funext j; fin_cases j <;> rfl⟩
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  rw [wb_some, some_eq, hA]

theorem N0 : Tab 0 T0 := by
  intro f p0 p1 p2 p3 c0 c1 c2 c3
  rw [N_zero, wb_none, T0_eq]
theorem N1 : Tab 1 T1 := N_next 0 T0 T1 N0 (step_eq T0 V0 W0 T1 stage_0)
theorem N2 : Tab 2 T2 := N_next 1 T1 T2 N1 (step_eq T1 V1 W1 T2 stage_1)
theorem N3 : Tab 3 T3 := N_next 2 T2 T3 N2 (step_eq T2 V2 W2 T3 stage_2)

theorem base : ∀ (c0 c1 c2 c3 : Fin 4) (m0 m1 m2 m3 zz : Bool),
    tT T3 c0 c1 c2 c3 m0 m1 m2 m3 zz =
      8 * tT T2 c0 c1 c2 c3 m0 m1 m2 m3 zz + 9 * tT T1 c0 c1 c2 c3 m0 m1 m2 m3 zz := by
  decide +kernel

theorem window (p : Option R) (c : R) :
    ∃ (f : Bool) (p0 p1 p2 p3 : Fin 4), p = opt f p0 p1 p2 p3 ∧ c = ![c 0, c 1, c 2, c 3] := by
  have hc : c = ![c 0, c 1, c 2, c 3] := by funext j; fin_cases j <;> rfl
  cases p with
  | none => exact ⟨false, 0, 0, 0, 0, rfl, hc⟩
  | some q =>
    refine ⟨true, q 0, q 1, q 2, q 3, ?_, hc⟩
    have hq : q = ![q 0, q 1, q 2, q 3] := by funext j; fin_cases j <;> rfl
    rw [opt, if_pos rfl, ← hq]

/-- The recurrence of the continuation counts, on every window. -/
theorem N_rec (m : ℕ) : ∀ (p : Option R) (c : R),
    (N p c (m + 3) : ℤ) = 8 * N p c (m + 2) + 9 * N p c (m + 1) := by
  induction m with
  | zero =>
    intro p c
    obtain ⟨f, p0, p1, p2, p3, rfl, hc⟩ := window p c
    rw [hc, N3, N2, N1]
    have h := base (c 0) (c 1) (c 2) (c 3) (m0f f p1 (c 0) (c 1)) (m1f f p2 (c 0) (c 1) (c 2))
      (m2f f p3 (c 1) (c 2) (c 3)) (m3f (c 2) (c 3))
      (zf f p1 p2 p3 (c 0) (c 1) (c 2) && hn (c 0) (c 1) (c 2) (c 3))
    omega
  | succ m ih =>
    intro p c
    rw [N_succ p c (m + 3), N_succ p c (m + 2), N_succ p c (m + 1)]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    split_ifs with hc
    · exact ih (some c) r
    · simp

theorem a_rec (m : ℕ) : (a (m + 4) : ℤ) = 8 * a (m + 3) + 9 * a (m + 2) := by
  rw [a_eq (m + 3), a_eq (m + 2), a_eq (m + 1)]
  push_cast
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun c _ => ?_)
  split_ifs with hc
  · exact N_rec m none c
  · simp

theorem a_first (n : ℕ) (A : ℕ) (hA : Tab n A) :
    a (n + 1) = sm fun c1 => sm fun c2 => sm fun c3 =>
      tT A 0 c1 c2 c3 (m0f false 0 0 c1) (m1f false 0 0 c1 c2) (m2f false 0 c1 c2 c3) (m3f c2 c3)
        (zf false 0 0 0 0 c1 c2 && hn 0 c1 c2 c3) := by
  rw [a_eq, sum_pi]
  simp only [sm_eq, Matrix.cons_val_zero]
  rw [Fin.sum_univ_succ]
  simp only [if_true, Fin.succ_ne_zero, if_false, Finset.sum_const_zero, add_zero]
  refine Finset.sum_congr rfl fun c1 _ => Finset.sum_congr rfl fun c2 _ =>
    Finset.sum_congr rfl fun c3 _ => ?_
  have hn' : (none : Option R) = opt false 0 0 0 0 := rfl
  rw [hn', hA]

theorem v1 : a 1 = 0 := by rw [a_first 0 T0 N0]; decide +kernel
theorem v2 : a 2 = 6 := by rw [a_first 1 T1 N1]; decide +kernel
theorem v3 : a 3 = 48 := by rw [a_first 2 T2 N2]; decide +kernel
theorem v4 : a 4 = 438 := by rw [a_first 3 T3 N3]; decide +kernel

/-! The closed forms. -/

theorem a_recQ (m : ℕ) : (a (m + 4) : ℚ) = 8 * a (m + 3) + 9 * a (m + 2) := by
  exact_mod_cast a_rec m

theorem closed1 (n : ℕ) (hn : 1 ≤ n) : (a n : ℚ) = (9 ^ n + 9 * (-1) ^ n) / 15 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 4 with h | h
    · interval_cases n
      · rw [v1]; norm_num
      · rw [v2]; norm_num
      · rw [v3]; norm_num
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
      rw [a_recQ m, ih (m + 3) (by omega) (by omega), ih (m + 2) (by omega) (by omega)]
      ring

theorem closed (n : ℕ) (hn : 1 ≤ n) :
    (Even n → (a n : ℚ) = (9 ^ n + 9) / 15) ∧ (Odd n → (a n : ℚ) = (9 ^ n - 9) / 15) := by
  refine ⟨fun he => ?_, fun ho => ?_⟩
  · rw [closed1 n hn, he.neg_one_pow]; ring
  · rw [closed1 n hn, ho.neg_one_pow]; ring

/-! The g.f. -/

theorem gf_mul : gf * ((1 + X) * (1 - 9 * X)) = 6 * X ^ 2 := by
  have e1 : gf * ((1 + X) * (1 - 9 * X)) = gf - C (8 : ℚ) * (gf * X ^ 1) - C (9 : ℚ) * (gf * X ^ 2) := by
    simp only [map_ofNat]; ring
  have e2 : (6 * X ^ 2 : ℚ⟦X⟧) = X ^ 2 * C (6 : ℚ) := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k gf = if k = 0 then (0 : ℚ) else a k := fun k => by rw [gf, coeff_mk]
  simp only [map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 4 with hn | hn
  · have w1 := v1; have w2 := v2; have w3 := v3
    interval_cases n <;> simp_all <;> norm_num
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
    have s1 : m + 4 - 1 = m + 3 := by omega
    have s2 : m + 4 - 2 = m + 2 := by omega
    rw [s1, s2]
    simp only [show ¬ m + 4 = 0 by omega, show ¬ m + 3 = 0 by omega, show ¬ m + 2 = 0 by omega,
      show 1 ≤ m + 4 by omega, show 2 ≤ m + 4 by omega, show ¬ m + 4 = 2 by omega, if_true, if_false]
    rw [a_recQ m]
    ring

/-- Both of Barker's conjectures. -/
theorem conjecture :
    gf = 6 * X ^ 2 * ((1 + X) * (1 - 9 * X))⁻¹ ∧
    ∀ n : ℕ, 1 ≤ n →
      (Even n → (a n : ℚ) = (9 ^ n + 9) / 15) ∧ (Odd n → (a n : ℚ) = (9 ^ n - 9) / 15) := by
  refine ⟨?_, closed⟩
  apply (PowerSeries.eq_mul_inv_iff_mul_eq (by simp :
    constantCoeff ((1 + X) * (1 - 9 * X) : ℚ⟦X⟧) ≠ 0)).2
  exact gf_mul

end OMA.S_oeis_a231104

theorem OMA.solution : type_of% @OMA.S_oeis_a231104.main :=
  OMA.S_oeis_a231104.conjecture
