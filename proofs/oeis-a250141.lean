/-- Both of Barker's conjectures. -/
theorem conjecture :
    (∀ n : ℕ, 5 < n →
      (a n : ℤ) = 5 * a (n - 1) - 10 * a (n - 2) + 10 * a (n - 3) - 5 * a (n - 4) + a (n - 5)) ∧
    PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 5 =
      X * (14 - 3 * X + 9 * X ^ 2 - 5 * X ^ 3 + X ^ 4) :=
  ⟨recurrence, gf⟩

