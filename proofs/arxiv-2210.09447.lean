import OMAStatements.S_arxiv_2210_09447
import Mathlib

namespace OMA.P_arxiv_2210_09447

open OMA.S_arxiv_2210_09447

private def mkBox (a b c : Fin 3) : Fin 7 → ℕ := fun i =>
  match i.val with
  | 0 => a.val
  | 1 => b.val
  | 2 => c.val
  | _ => 0

private def mkChain (k : Fin 7) (m : Fin 7) : Fin 7 → ℕ := fun i =>
  if i = k then m.val else 0

private def boxSet : Finset (Fin 7 → ℕ) :=
  (Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).image fun t => mkBox t.1 t.2.1 t.2.2

private def chainSet (k : Fin 7) : Finset (Fin 7 → ℕ) :=
  (Finset.univ : Finset (Fin 7)).image (mkChain k)

/-- The 51-monomial pure order ideal in 7 variables generated by the 5 degree-6 monomials
`x₀² x₁² x₂², x₃⁶, x₄⁶, x₅⁶, x₆⁶`, with pure `O`-sequence `(1, 7, 10, 11, 10, 7, 5)`. -/
def M0 : Finset (Fin 7 → ℕ) :=
  boxSet ∪ chainSet 3 ∪ chainSet 4 ∪ chainSet 5 ∪ chainSet 6

private lemma mkBox_mem {a b c : Fin 3} : mkBox a b c ∈ M0 := by
  have h : mkBox a b c ∈ boxSet :=
    Finset.mem_image.mpr ⟨(a, b, c), Finset.mem_univ _, rfl⟩
  simp only [M0, Finset.mem_union]
  exact Or.inl (Or.inl (Or.inl (Or.inl h)))

private lemma mkChain_mem_3 (m : Fin 7) : mkChain 3 m ∈ M0 := by
  have h : mkChain 3 m ∈ chainSet 3 := Finset.mem_image.mpr ⟨m, Finset.mem_univ _, rfl⟩
  simp only [M0, Finset.mem_union]
  exact Or.inl (Or.inl (Or.inl (Or.inr h)))

private lemma mkChain_mem_4 (m : Fin 7) : mkChain 4 m ∈ M0 := by
  have h : mkChain 4 m ∈ chainSet 4 := Finset.mem_image.mpr ⟨m, Finset.mem_univ _, rfl⟩
  simp only [M0, Finset.mem_union]
  exact Or.inl (Or.inl (Or.inr h))

private lemma mkChain_mem_5 (m : Fin 7) : mkChain 5 m ∈ M0 := by
  have h : mkChain 5 m ∈ chainSet 5 := Finset.mem_image.mpr ⟨m, Finset.mem_univ _, rfl⟩
  simp only [M0, Finset.mem_union]
  exact Or.inl (Or.inr h)

private lemma mkChain_mem_6 (m : Fin 7) : mkChain 6 m ∈ M0 := by
  have h : mkChain 6 m ∈ chainSet 6 := Finset.mem_image.mpr ⟨m, Finset.mem_univ _, rfl⟩
  simp only [M0, Finset.mem_union]
  exact Or.inr h

private lemma le_mkBox_mem {a b c : Fin 3} {v : Fin 7 → ℕ} (hv : v ≤ mkBox a b c) :
    v ∈ M0 := by
  have h0 : v 0 < 3 := lt_of_le_of_lt (hv 0) a.isLt
  have h1 : v 1 < 3 := lt_of_le_of_lt (hv 1) b.isLt
  have h2 : v 2 < 3 := lt_of_le_of_lt (hv 2) c.isLt
  have h3 : v 3 = 0 := Nat.eq_zero_of_le_zero (hv 3)
  have h4 : v 4 = 0 := Nat.eq_zero_of_le_zero (hv 4)
  have h5 : v 5 = 0 := Nat.eq_zero_of_le_zero (hv 5)
  have h6 : v 6 = 0 := Nat.eq_zero_of_le_zero (hv 6)
  have heq : v = mkBox ⟨v 0, h0⟩ ⟨v 1, h1⟩ ⟨v 2, h2⟩ := by
    funext i
    fin_cases i <;> simp [mkBox, h3, h4, h5, h6]
  rw [heq]
  exact mkBox_mem

private lemma le_mkChain_eq {k : Fin 7} {m : Fin 7} {v : Fin 7 → ℕ} (hv : v ≤ mkChain k m) :
    ∃ m' : Fin 7, v = mkChain k m' := by
  have hk : v k < 7 := by
    have := hv k
    simp only [mkChain, ↓reduceIte] at this
    exact lt_of_le_of_lt this m.isLt
  refine ⟨⟨v k, hk⟩, ?_⟩
  funext i
  by_cases hi : i = k
  · subst hi; simp [mkChain]
  · have hle := hv i
    simp only [mkChain, hi, ↓reduceIte] at hle ⊢
    exact Nat.eq_zero_of_le_zero hle

private lemma monDeg_mkBox (a b c : Fin 3) : monDeg (mkBox a b c) = a.val + b.val + c.val := by
  unfold monDeg
  rw [Fin.sum_univ_seven]
  simp [mkBox]

private lemma monDeg_mkChain (k m : Fin 7) : monDeg (mkChain k m) = m.val := by
  unfold monDeg mkChain
  rw [Finset.sum_ite_eq' Finset.univ k]
  simp

lemma M0_pure : IsPureOrderIdeal M0 6 := by
  refine ⟨⟨mkBox 0 0 0, mkBox_mem⟩, ?_, ?_, ?_, ?_⟩
  · intro u hu v hv
    simp only [M0, Finset.mem_union] at hu
    rcases hu with (((hb | h3) | h4) | h5) | h6
    · obtain ⟨⟨a, b, c⟩, _, rfl⟩ := Finset.mem_image.mp hb
      exact le_mkBox_mem hv
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h3
      obtain ⟨m', rfl⟩ := le_mkChain_eq hv
      exact mkChain_mem_3 m'
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h4
      obtain ⟨m', rfl⟩ := le_mkChain_eq hv
      exact mkChain_mem_4 m'
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h5
      obtain ⟨m', rfl⟩ := le_mkChain_eq hv
      exact mkChain_mem_5 m'
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h6
      obtain ⟨m', rfl⟩ := le_mkChain_eq hv
      exact mkChain_mem_6 m'
  · intro u hu
    simp only [M0, Finset.mem_union] at hu
    rcases hu with (((hb | h3) | h4) | h5) | h6
    · obtain ⟨⟨a, b, c⟩, _, rfl⟩ := Finset.mem_image.mp hb
      rw [monDeg_mkBox]; omega
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h3
      rw [monDeg_mkChain]; omega
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h4
      rw [monDeg_mkChain]; omega
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h5
      rw [monDeg_mkChain]; omega
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h6
      rw [monDeg_mkChain]; omega
  · intro u hu
    simp only [M0, Finset.mem_union] at hu
    rcases hu with (((hb | h3) | h4) | h5) | h6
    · obtain ⟨⟨a, b, c⟩, _, rfl⟩ := Finset.mem_image.mp hb
      refine ⟨mkBox 2 2 2, mkBox_mem, ?_, ?_⟩
      · intro i; fin_cases i <;> simp [mkBox] <;> omega
      · rw [monDeg_mkBox]; rfl
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h3
      refine ⟨mkChain 3 6, mkChain_mem_3 6, ?_, ?_⟩
      · intro i; unfold mkChain; split_ifs
        · exact Nat.le_of_lt_succ m.isLt
        · exact le_rfl
      · rw [monDeg_mkChain]; rfl
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h4
      refine ⟨mkChain 4 6, mkChain_mem_4 6, ?_, ?_⟩
      · intro i; unfold mkChain; split_ifs
        · exact Nat.le_of_lt_succ m.isLt
        · exact le_rfl
      · rw [monDeg_mkChain]; rfl
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h5
      refine ⟨mkChain 5 6, mkChain_mem_5 6, ?_, ?_⟩
      · intro i; unfold mkChain; split_ifs
        · exact Nat.le_of_lt_succ m.isLt
        · exact le_rfl
      · rw [monDeg_mkChain]; rfl
    · obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp h6
      refine ⟨mkChain 6 6, mkChain_mem_6 6, ?_, ?_⟩
      · intro i; unfold mkChain; split_ifs
        · exact Nat.le_of_lt_succ m.isLt
        · exact le_rfl
      · rw [monDeg_mkChain]; rfl
  · intro i
    fin_cases i
    · convert mkBox_mem (a := 1) (b := 0) (c := 0) using 1
      funext j; fin_cases j <;> rfl
    · convert mkBox_mem (a := 0) (b := 1) (c := 0) using 1
      funext j; fin_cases j <;> rfl
    · convert mkBox_mem (a := 0) (b := 0) (c := 1) using 1
      funext j; fin_cases j <;> rfl
    · convert mkChain_mem_3 1 using 1
      funext j; fin_cases j <;> rfl
    · convert mkChain_mem_4 1 using 1
      funext j; fin_cases j <;> rfl
    · convert mkChain_mem_5 1 using 1
      funext j; fin_cases j <;> rfl
    · convert mkChain_mem_6 1 using 1
      funext j; fin_cases j <;> rfl

private lemma filter_chainSet_eq (k : Fin 7) (d : Fin 7) :
    (chainSet k).filter (fun m => monDeg m = d.val) = {mkChain k d} := by
  ext m
  simp only [Finset.mem_filter, chainSet, Finset.mem_image, Finset.mem_univ, true_and,
    Finset.mem_singleton]
  constructor
  · rintro ⟨⟨a, rfl⟩, hdeg⟩
    rw [monDeg_mkChain] at hdeg
    have ha : a = d := Fin.ext hdeg
    rw [ha]
  · rintro rfl
    exact ⟨⟨d, rfl⟩, monDeg_mkChain k d⟩

private lemma filter_boxSet_card (d : ℕ) :
    (boxSet.filter (fun m => monDeg m = d)).card =
      ((Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).filter
        (fun t => t.1.val + t.2.1.val + t.2.2.val = d)).card := by
  have heq : boxSet.filter (fun m => monDeg m = d) =
      ((Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).filter
        (fun t => t.1.val + t.2.1.val + t.2.2.val = d)).image
        (fun t => mkBox t.1 t.2.1 t.2.2) := by
    ext m
    simp only [Finset.mem_filter, boxSet, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨⟨t, rfl⟩, hdeg⟩
      rw [monDeg_mkBox] at hdeg
      exact ⟨t, hdeg, rfl⟩
    · rintro ⟨t, hdeg, rfl⟩
      exact ⟨⟨t, rfl⟩, by rw [monDeg_mkBox]; exact hdeg⟩
  rw [heq, Finset.card_image_of_injective]
  intro t1 t2 h
  have h0 := congrFun h 0
  have h1 := congrFun h 1
  have h2 := congrFun h 2
  simp only [mkBox] at h0 h1 h2
  ext
  · exact h0
  · exact h1
  · exact h2

private lemma oSeq_M0_eq (d : Fin 7) (hd : 0 < d.val) :
    oSeq M0 d.val =
      ((Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).filter
        (fun t => t.1.val + t.2.1.val + t.2.2.val = d.val)).card + 4 := by
  unfold oSeq M0
  simp only [Finset.filter_union]
  have hc3 := filter_chainSet_eq 3 d
  have hc4 := filter_chainSet_eq 4 d
  have hc5 := filter_chainSet_eq 5 d
  have hc6 := filter_chainSet_eq 6 d
  rw [hc3, hc4, hc5, hc6]
  have hnotB : ∀ k : Fin 7, 3 ≤ k.val → mkChain k d ∉ boxSet.filter (fun m => monDeg m = d.val) := by
    intro k hk hmem
    have hb := (Finset.mem_filter.mp hmem).1
    obtain ⟨t, _, heq⟩ := Finset.mem_image.mp hb
    have hval := congrFun heq k
    simp only [mkBox, mkChain, ↓reduceIte] at hval
    have hzero : (match k.val with | 0 => t.1.val | 1 => t.2.1.val | 2 => t.2.2.val | _ => 0) = 0 := by
      rcases k with ⟨kv, hkv⟩
      interval_cases kv <;> simp_all
    omega
  have hneC : ∀ k1 k2 : Fin 7, k1 ≠ k2 → mkChain k1 d ≠ mkChain k2 d := by
    intro k1 k2 hne heq
    have hv := congrFun heq k1
    simp only [mkChain, ↓reduceIte, hne] at hv
    omega
  have hd1 : Disjoint (boxSet.filter (fun m => monDeg m = d.val)) {mkChain 3 d} :=
    Finset.disjoint_singleton_right.mpr (hnotB 3 (by decide))
  have hd2 : Disjoint (boxSet.filter (fun m => monDeg m = d.val) ∪ {mkChain 3 d}) {mkChain 4 d} := by
    rw [Finset.disjoint_singleton_right, Finset.mem_union, Finset.mem_singleton]
    rintro (h | h)
    · exact hnotB 4 (by decide) h
    · exact hneC 4 3 (by decide) h
  have hd3 : Disjoint (boxSet.filter (fun m => monDeg m = d.val) ∪ {mkChain 3 d} ∪ {mkChain 4 d}) {mkChain 5 d} := by
    rw [Finset.disjoint_singleton_right, Finset.mem_union, Finset.mem_union,
      Finset.mem_singleton, Finset.mem_singleton]
    rintro ((h | h) | h)
    · exact hnotB 5 (by decide) h
    · exact hneC 5 3 (by decide) h
    · exact hneC 5 4 (by decide) h
  have hd4 : Disjoint (boxSet.filter (fun m => monDeg m = d.val) ∪ {mkChain 3 d} ∪ {mkChain 4 d} ∪ {mkChain 5 d}) {mkChain 6 d} := by
    rw [Finset.disjoint_singleton_right, Finset.mem_union, Finset.mem_union, Finset.mem_union,
      Finset.mem_singleton, Finset.mem_singleton, Finset.mem_singleton]
    rintro (((h | h) | h) | h)
    · exact hnotB 6 (by decide) h
    · exact hneC 6 3 (by decide) h
    · exact hneC 6 4 (by decide) h
    · exact hneC 6 5 (by decide) h
  rw [Finset.card_union_of_disjoint hd4, Finset.card_union_of_disjoint hd3,
    Finset.card_union_of_disjoint hd2, Finset.card_union_of_disjoint hd1,
    Finset.card_singleton, Finset.card_singleton, Finset.card_singleton, Finset.card_singleton,
    filter_boxSet_card]

lemma oSeq_M0_4 : oSeq M0 4 = 10 := by
  have h := oSeq_M0_eq 4 (by decide)
  have hb : ((Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).filter
      (fun t => t.1.val + t.2.1.val + t.2.2.val = (4 : Fin 7).val)).card = 6 := by decide
  change oSeq M0 (4 : Fin 7).val = 10
  rw [h, hb]

lemma oSeq_M0_5 : oSeq M0 5 = 7 := by
  have h := oSeq_M0_eq 5 (by decide)
  have hb : ((Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).filter
      (fun t => t.1.val + t.2.1.val + t.2.2.val = (5 : Fin 7).val)).card = 3 := by decide
  change oSeq M0 (5 : Fin 7).val = 7
  rw [h, hb]

lemma oSeq_M0_6 : oSeq M0 6 = 5 := by
  have h := oSeq_M0_eq 6 (by decide)
  have hb : ((Finset.univ : Finset (Fin 3 × Fin 3 × Fin 3)).filter
      (fun t => t.1.val + t.2.1.val + t.2.2.val = (6 : Fin 7).val)).card = 1 := by decide
  change oSeq M0 (6 : Fin 7).val = 5
  rw [h, hb]

end OMA.P_arxiv_2210_09447

theorem OMA.disproof : ¬ (type_of% @OMA.S_arxiv_2210_09447.main) := by
  intro h
  have hlc := h 7 6 OMA.P_arxiv_2210_09447.M0 OMA.P_arxiv_2210_09447.M0_pure 5 (by norm_num) (by norm_num)
  have h51 : (5 : ℕ) - 1 = 4 := rfl
  have h52 : (5 : ℕ) + 1 = 6 := rfl
  rw [h51, h52, OMA.P_arxiv_2210_09447.oSeq_M0_4, OMA.P_arxiv_2210_09447.oSeq_M0_5,
    OMA.P_arxiv_2210_09447.oSeq_M0_6] at hlc
  omega
