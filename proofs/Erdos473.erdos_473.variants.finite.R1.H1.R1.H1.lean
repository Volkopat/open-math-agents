/-! Prime witnesses for even orders in the finite interval. -/

namespace OMA.ReflectionPairs

private abbrev goodPair (m u v : ℕ) : Prop :=
  u < v ∧ v < m ∧ (v-u).Coprime m ∧
    (2*u+3).Prime ∧ ((u+1 < m) → (2*u+3+2*m).Prime) ∧
    (2*v+3).Prime ∧ ((v+1 < m) → (2*v+3+2*m).Prime)

private def coversHeads (P : ℕ) : ℕ → ℕ → Bool
  | _, 0 => true
  | a, width+1 => decide (a.gcd P ≠ 1) && coversHeads P (a+1) width

private theorem coversHeads_sound (P a width : ℕ) (h : coversHeads P a width = true) :
    ∀ d, a ≤ d → d < a+width → d.gcd P ≠ 1 := by
  induction width generalizing a with
  | zero => omega
  | succ width ih =>
    change (decide (a.gcd P ≠ 1) && coversHeads P (a+1) width) = true at h
    simp only [Bool.and_eq_true_iff, decide_eq_true_eq] at h
    intro d lo hi
    by_cases heq : d = a
    · exact heq ▸ h.1
    · exact ih (a+1) h.2 d (by omega) (by omega)

private theorem prime_of_covers {P b n : ℕ}
    (hcover : ∀ d, 2 ≤ d → d < b+1 → d.gcd P ≠ 1)
    (hn : 2 ≤ n) (hb : n < (b+1)^2) (hcop : n.gcd P = 1) : n.Prime := by
  by_contra h
  let d := n.minFac
  have hd : d.Prime := Nat.minFac_prime (by omega)
  have hsq : d^2 ≤ n := Nat.minFac_sq_le_self (by omega) h
  have hbound : d < b+1 := by
    by_contra! hbad
    have hh : (b+1)^2 ≤ d^2 := Nat.pow_le_pow_left hbad 2
    omega
  have hdiv : d ∣ P := by
    by_contra hnd
    exact hcover d hd.two_le hbound (hd.coprime_iff_not_dvd.mpr hnd)
  have hdg := Nat.dvd_gcd (Nat.minFac_dvd n) hdiv
  rw [hcop] at hdg
  exact hd.ne_one (Nat.dvd_one.mp hdg)

private def divisorProduct : ℕ := 23984823528925228172706521638692258396210

private theorem productCheck : coversHeads divisorProduct 2 103 = true := by decide +kernel

private theorem productCovers :
    ∀ d, 2 ≤ d → d < 105 → d.gcd divisorProduct ≠ 1 :=
  coversHeads_sound divisorProduct 2 103 productCheck

private def smallPrime (n : ℕ) : Bool :=
  if n ≤ 104 then decide n.Prime else decide (n < 105^2 ∧ n.gcd divisorProduct = 1)

private theorem smallPrime_sound {n : ℕ} (h : smallPrime n = true) : n.Prime := by
  unfold smallPrime at h
  split at h
  · exact of_decide_eq_true h
  · have v := of_decide_eq_true h
    exact prime_of_covers productCovers (by omega) v.1 v.2

private def offsetPrime (m u : ℕ) : Bool :=
  if u+1 < m then smallPrime (2*u+3+2*m) else true

private def pairCheck (m u v : ℕ) : Bool :=
  decide (u < v ∧ v < m ∧ (v-u).Coprime m) &&
    (smallPrime (2*u+3) && (offsetPrime m u && (smallPrime (2*v+3) && offsetPrime m v)))

private theorem pairCheck_sound {m u v : ℕ} (h : pairCheck m u v = true) : goodPair m u v := by
  simp only [pairCheck, Bool.and_eq_true_iff, decide_eq_true_eq] at h
  obtain ⟨⟨lt,bound,cop⟩,u1,u2,v1,v2⟩ := h
  exact ⟨lt,bound,cop,smallPrime_sound u1,
    fun hl => smallPrime_sound (by simpa [offsetPrime,hl] using u2),
    smallPrime_sound v1,
    fun hl => smallPrime_sound (by simpa [offsetPrime,hl] using v2)⟩

private def checkRows (m word : ℕ) : ℕ → Bool
  | 0 => true
  | width+1 =>
    let row := word % 65536
    pairCheck m (row % 256) (row / 256) && checkRows (m+2) (word/65536) width

private theorem checkRows_sound (first word width : ℕ) (checked : checkRows first word width = true) :
    ∀ m, first ≤ m → m < first+2*width → m%2=first%2 → ∃ u v, goodPair m u v := by
  induction width generalizing first word with
  | zero => omega
  | succ width ih =>
    rw [checkRows, Bool.and_eq_true_iff] at checked
    intro m lo hi parity
    by_cases eq : m = first
    · subst m
      exact ⟨word % 65536 % 256, word % 65536 / 256, pairCheck_sound checked.1⟩
    · exact ih (first+2) (word/65536) checked.2 m (by omega) (by omega) (by omega)

private theorem joinRows {a b c : ℕ}
    (left : ∀ m, a ≤ m → m < b → m%2=0 → ∃ u v, goodPair m u v)
    (right : ∀ m, b ≤ m → m < c → m%2=0 → ∃ u v, goodPair m u v) :
    ∀ m, a ≤ m → m < c → m%2=0 → ∃ u v, goodPair m u v := by
  intro m lo hi even
  by_cases h : m < b
  · exact left m lo h even
  · exact right m (by omega) hi even

