import OMAReductions.R_Kourovka_1_40_kourovka_1_40_R1

-- Step Kourovka.1.40.kourovka_1_40.R1.H1: hypothesis H1 of reduction Kourovka.1.40.kourovka_1_40.R1
-- Credit: @nnkostov

/-!
# Product of Two Normal Engel Subgroups Meeting Inside the Center

If `G` is generated by two normal Engel subgroups `H` and `K` whose intersection
`Z = H ⊓ K` is contained in `Subgroup.center G`, then `G` is an Engel group:

* Because `H` and `K` are normal, `[H, K] ≤ H ⊓ K = Z`, so their images commute
  in the quotient `G ⧸ Z`, giving a surjective homomorphism `φ : H × K →* G ⧸ Z`.
* A direct product `H × K` of Engel groups is Engel (taking `max n₁ n₂`), and
  Engel commutators commute with homomorphisms, so `π [x, _n y] = 1` for some `n`.
* Thus `[x, _n y] ∈ Z ≤ center G`, whence `[x, _{n+1} y] = [[x, _n y], y] = 1`.
-/

open Kourovka.«1.40»
open scoped commutatorElement Pointwise

private lemma engelCommutator_map {A B : Type*} [Group A] [Group B]
    (f : A →* B) (x y : A) (n : ℕ) :
    engelCommutator (f x) (f y) n = f (engelCommutator x y n) := by
  induction n with
  | zero => rfl
  | succ k ih => simp only [engelCommutator, ih, map_commutatorElement]

private lemma engelCommutator_eq_one_of_le {A : Type*} [Group A]
    {x y : A} {n m : ℕ} (h : engelCommutator x y n = 1) (hnm : n ≤ m) :
    engelCommutator x y m = 1 := by
  induction m, hnm using Nat.le_induction with
  | base => exact h
  | succ k _ ih =>
    simp only [engelCommutator, ih, commutatorElement_def]
    group

private lemma engelCommutator_prod {A B : Type*} [Group A] [Group B]
    (x₁ y₁ : A) (x₂ y₂ : B) (n : ℕ) :
    engelCommutator (x₁, x₂) (y₁, y₂) n =
      (engelCommutator x₁ y₁ n, engelCommutator x₂ y₂ n) := by
  induction n with
  | zero => rfl
  | succ k ih =>
    ext <;> simp only [engelCommutator, ih, commutatorElement_def,
      Prod.fst_mul, Prod.snd_mul, Prod.fst_inv, Prod.snd_inv]

private lemma isEngelGroup_prod {A B : Type*} [Group A] [Group B]
    (hA : IsEngelGroup A) (hB : IsEngelGroup B) : IsEngelGroup (A × B) := by
  intro ⟨y₁, y₂⟩ ⟨x₁, x₂⟩
  obtain ⟨n₁, hn₁⟩ := hA y₁ x₁
  obtain ⟨n₂, hn₂⟩ := hB y₂ x₂
  refine ⟨max n₁ n₂, ?_⟩
  rw [engelCommutator_prod, engelCommutator_eq_one_of_le hn₁ (le_max_left n₁ n₂),
    engelCommutator_eq_one_of_le hn₂ (le_max_right n₁ n₂)]
  rfl

theorem OMA.solution : OMA.R_Kourovka_1_40_kourovka_1_40_R1.H1 := by
  intro G _ H K hH hK heH heK hsup hinf
  let _ : H.Normal := hH
  let _ : K.Normal := hK
  let Z : Subgroup G := H ⊓ K
  let π : G →* G ⧸ Z := QuotientGroup.mk' Z
  have hcomm_HK : ∀ h ∈ H, ∀ k ∈ K, π h * π k = π k * π h := by
    intro h hh k hk
    have hcommZ : ⁅h, k⁆ ∈ Z := by
      refine ⟨?_, ?_⟩
      · have heq : h * k * h⁻¹ * k⁻¹ = h * (k * h⁻¹ * k⁻¹) := by group
        rw [commutatorElement_def, heq]
        exact H.mul_mem hh (hH.conj_mem h⁻¹ (H.inv_mem hh) k)
      · rw [commutatorElement_def]
        exact K.mul_mem (hK.conj_mem k hk h) (K.inv_mem hk)
    have h1 : π ⁅h, k⁆ = 1 := (QuotientGroup.eq_one_iff ⁅h, k⁆).mpr hcommZ
    rw [map_commutatorElement, commutatorElement_def] at h1
    have h2 : π h * π k * (π h)⁻¹ = π k := mul_inv_eq_one.mp h1
    calc π h * π k = (π h * π k * (π h)⁻¹) * π h := by group
      _ = π k * π h := by rw [h2]
  let φ : H × K →* G ⧸ Z :=
    { toFun := fun p => π (p.1.1 * p.2.1)
      map_one' := by simp
      map_mul' := fun p q => by
        simp only [Prod.fst_mul, Prod.snd_mul, Subgroup.coe_mul, map_mul]
        calc π p.1.1 * π q.1.1 * (π p.2.1 * π q.2.1)
            = π p.1.1 * (π q.1.1 * π p.2.1) * π q.2.1 := by group
          _ = π p.1.1 * (π p.2.1 * π q.1.1) * π q.2.1 := by
              rw [hcomm_HK q.1.1 q.1.2 p.2.1 p.2.2]
          _ = π p.1.1 * π p.2.1 * (π q.1.1 * π q.2.1) := by group }
  have hφ_surj : Function.Surjective φ := by
    intro q
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective Z q
    have hg : g ∈ (H : Set G) * (K : Set G) := by
      rw [← Subgroup.mul_normal H K, hsup]
      trivial
    obtain ⟨h, hh, k, hk, rfl⟩ := Set.mem_mul.mp hg
    exact ⟨(⟨h, hh⟩, ⟨k, hk⟩), rfl⟩
  intro y x
  obtain ⟨a, ha⟩ := hφ_surj (π x)
  obtain ⟨b, hb⟩ := hφ_surj (π y)
  obtain ⟨n, hn⟩ := isEngelGroup_prod heH heK b a
  refine ⟨n + 1, ?_⟩
  have hπ0 : π (engelCommutator x y n) = 1 := by
    rw [← engelCommutator_map π x y n, ← ha, ← hb, engelCommutator_map φ a b n, hn, map_one]
  have hmemZ : engelCommutator x y n ∈ Z := (QuotientGroup.eq_one_iff _).mp hπ0
  have hzy : y * engelCommutator x y n = engelCommutator x y n * y :=
    Subgroup.mem_center_iff.mp (hinf hmemZ) y
  simp only [engelCommutator, commutatorElement_def, ← hzy]
  group
