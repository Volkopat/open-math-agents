theorem F_zero (m j : ℕ) (h : m + 2 ≤ j) : F m j = 0 := by
  unfold F
  rw [Nat.choose_eq_zero_of_lt (by omega : 4 * m + 5 < 3 * m + 4 + j)]
  simp

theorem sum_ext (m d : ℕ) : ∑ j ∈ Finset.range (m + 2 + d), F m j = ∑ j ∈ Finset.range (m + 2), F m j := by
  induction d with
  | zero => rfl
  | succ d ih => rw [← add_assoc, Finset.sum_range_succ, ih, F_zero m (m + 2 + d) (by omega), add_zero]

theorem a_eq (m : ℕ) : a (m + 1) = ∑ j ∈ Finset.range (m + 2), F m j := by
  unfold a
  rw [← Finset.sum_range_reflect]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  rw [Finset.mem_range] at hj
  unfold F
  rw [show m + 1 + 1 - 1 - j = m + 1 - j by omega, show 4 * (m + 1) - (m + 1 - j) - 1 = 3 * m + 2 + j by omega,
    show m + 1 - (m + 1 - j) = j by omega,
    Nat.choose_symm_of_eq_add (show 4 * (m + 1) + 1 = (m + 1 - j) + (3 * m + 4 + j) by omega),
    show 4 * (m + 1) + 1 = 4 * m + 5 by ring]

