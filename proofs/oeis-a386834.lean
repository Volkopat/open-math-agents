theorem diag_z (M K : ℕ) : ((M : ℤ) + 1) * (M.choose K : ℤ) = ((M + 1).choose (K + 1) : ℤ) * ((K : ℤ) + 1) := by
  exact_mod_cast Nat.add_one_mul_choose_eq M K

theorem vert_z (M K : ℕ) : (M.choose K : ℤ) * ((M : ℤ) + 1) = ((M + 1).choose K : ℤ) * ((M : ℤ) + 1 - K) := by
  rcases Nat.lt_or_ge (M + 1) K with h | h
  · rw [Nat.choose_eq_zero_of_lt h, Nat.choose_eq_zero_of_lt (by omega : M < K)]
    simp
  · have e := Nat.choose_mul_succ_eq M K
    have e' : ((M.choose K * (M + 1) : ℕ) : ℤ) = (((M + 1).choose K * (M + 1 - K) : ℕ) : ℤ) := by rw [e]
    push_cast [Nat.cast_sub h] at e'
    linear_combination e'

theorem jup_z (M K : ℕ) : (M.choose (K + 1) : ℤ) * ((K : ℤ) + 1) = (M.choose K : ℤ) * ((M : ℤ) - K) := by
  rcases Nat.lt_or_ge M K with h | h
  · rw [Nat.choose_eq_zero_of_lt h, Nat.choose_eq_zero_of_lt (by omega : M < K + 1)]
    simp
  · have e := Nat.choose_succ_right_eq M K
    have e' : ((M.choose (K + 1) * (K + 1) : ℕ) : ℤ) = ((M.choose K * (M - K) : ℕ) : ℤ) := by rw [e]
    push_cast [Nat.cast_sub h] at e'
    linear_combination e'

