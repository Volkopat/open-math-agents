import Mathlib

namespace TMEngine2

open Finset

/-- One transfer step on weight vectors: `W f N w s = ∑ k < N, w (f s k)`. -/
def W (f : ℕ → ℕ → ℕ) (N : ℕ) (w : ℕ → ℕ) (s : ℕ) : ℕ := ∑ k ∈ range N, w (f s k)

theorem sum_sem {α : Type*} [Fintype α] {N : ℕ} (e : α ≃ Fin N)
    (sem : ∀ n : ℕ, (Fin (n + 1) → α) → ℕ) (f : ℕ → ℕ → ℕ) (ι : ℕ → ℕ)
    (h0 : ∀ x : Fin 1 → α, sem 0 x = ι (e (x 0)))
    (hs : ∀ n (x : Fin (n + 2) → α), sem (n + 1) x = f (sem n (Fin.init x)) (e (x (Fin.last _)))) :
    ∀ n (w : ℕ → ℕ), ∑ x : Fin (n + 1) → α, w (sem n x) = ∑ k ∈ range N, (W f N)^[n] w (ι k) := by
  intro n
  induction n with
  | zero =>
    intro w
    rw [← (Equiv.funUnique (Fin 1) α).symm.sum_comp]
    simp only [Function.iterate_zero, id]
    rw [← Fin.sum_univ_eq_sum_range (fun k => w (ι k)), ← e.sum_comp]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [h0]; rfl
  | succ n ih =>
    intro w
    rw [← (Fin.snocEquiv (fun _ => α)).sum_comp, Fintype.sum_prod_type_right]
    have : ∀ y : Fin (n + 1) → α, ∑ c : α, w (sem (n + 1) ((Fin.snocEquiv fun _ => α) (c, y)))
        = W f N w (sem n y) := by
      intro y
      unfold W
      rw [← Fin.sum_univ_eq_sum_range (fun k => w (f (sem n y) k)), ← e.sum_comp]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [hs, show ((Fin.snocEquiv fun _ => α) (c, y)) = Fin.snoc y c from
        funext fun i => Fin.snocEquiv_apply _ _ i, Fin.init_snoc, Fin.snoc_last]
    simp_rw [this]
    rw [ih, Function.iterate_succ_apply]

/-- Packed table lookup: field `s` of width `B` bits of the number `V`. -/
def pk (B V s : ℕ) : ℕ := V / 2 ^ (B * s) % 2 ^ B

theorem list_sum_filter (l : List ℕ) (w : ℕ → ℕ) (d : ℕ) (hd : w d = 0) :
    ((l.filter (fun t => t != d)).map w).sum = (l.map w).sum := by
  induction l with
  | nil => rfl
  | cons t l ih =>
    by_cases h : t = d
    · subst h; simp [List.filter_cons, hd, ih]
    · simp [List.filter_cons, h, ih]

theorem sum_range_list (N : ℕ) (g : ℕ → ℕ) : ∑ k ∈ range N, g k = ((List.range N).map g).sum := by
  induction N with
  | zero => rfl
  | succ N ih => rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append, List.sum_append]; simp

/-- The transfer step on a live state, through its list of live successors. -/
theorem W_list (f : ℕ → ℕ → ℕ) (N d : ℕ) (w : ℕ → ℕ) (hd : w d = 0) (s : ℕ) (L : List ℕ)
    (hL : ((List.range N).map (f s)).filter (fun t => t != d) = L) :
    W f N w s = (L.map w).sum := by
  unfold W
  rw [← hL, list_sum_filter _ _ _ hd, List.map_map, sum_range_list]
  rfl

theorem iter_dead (f : ℕ → ℕ → ℕ) (N d : ℕ) (hfd : ∀ k < N, f d k = d) (w : ℕ → ℕ) (hw : w d = 0) :
    ∀ j, (W f N)^[j] w d = 0 := by
  intro j
  induction j with
  | zero => exact hw
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    unfold W
    exact Finset.sum_eq_zero fun k hk => by rw [hfd k (Finset.mem_range.mp hk)]; exact ih

section
variable (f : ℕ → ℕ → ℕ) (N d : ℕ) (D : List (ℕ × List ℕ))
  (hD : ∀ p ∈ D, ((List.range N).map (f p.1)).filter (fun t => t != d) = p.2)
  (hcl : ∀ p ∈ D, ∀ t ∈ p.2, t ∈ D.map Prod.fst)
  (hfd : ∀ k < N, f d k = d)

include hD hcl hfd in
theorem iter_table (w : ℕ → ℕ) (hw : w d = 0) (T : ℕ → ℕ → ℕ) (h0 : ∀ p ∈ D, w p.1 = T 0 p.1)
    (J : ℕ) (hT : ∀ j < J, ∀ p ∈ D, (p.2.map (T j)).sum = T (j + 1) p.1) :
    ∀ j ≤ J, ∀ p ∈ D, (W f N)^[j] w p.1 = T j p.1 := by
  intro j
  induction j with
  | zero => intro _ p hp; exact h0 p hp
  | succ j ih =>
    intro hj p hp
    rw [Function.iterate_succ_apply', W_list f N d _ (iter_dead f N d hfd w hw j) p.1 p.2 (hD p hp),
      ← hT j (by omega) p hp]
    congr 1
    apply List.map_congr_left
    intro t ht
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcl p hp t ht)
    exact ih (by omega) q hq

/-- A nonnegative linear combination `∑ c * V (m + i) s` over a list of pairs `(c, i)`. -/
def lin (V : ℕ → ℕ → ℕ) (P : List (ℕ × ℕ)) (m s : ℕ) : ℕ := (P.map fun p => p.1 * V (m + p.2) s).sum

theorem lin_succ (w : ℕ → ℕ) (P : List (ℕ × ℕ)) (m s : ℕ) :
    lin (fun j => (W f N)^[j] w) P (m + 1) s
      = ∑ k ∈ range N, lin (fun j => (W f N)^[j] w) P m (f s k) := by
  induction P with
  | nil => simp [lin]
  | cons p P ih =>
    simp only [lin, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Finset.sum_add_distrib, ← Finset.mul_sum,
      show m + 1 + p.2 = (m + p.2) + 1 by omega, Function.iterate_succ_apply']
    rfl

include hD hcl hfd in
theorem rec_lift (w : ℕ → ℕ) (hw : w d = 0) (P Q : List (ℕ × ℕ)) (m0 : ℕ)
    (hbase : ∀ p ∈ D, lin (fun j => (W f N)^[j] w) P m0 p.1 = lin (fun j => (W f N)^[j] w) Q m0 p.1) :
    ∀ m, m0 ≤ m → ∀ p ∈ D,
      lin (fun j => (W f N)^[j] w) P m p.1 = lin (fun j => (W f N)^[j] w) Q m p.1 := by
  have hlin0 : ∀ (P : List (ℕ × ℕ)) m, lin (fun j => (W f N)^[j] w) P m d = 0 := by
    intro P m
    unfold lin
    apply List.sum_eq_zero
    intro x hx
    obtain ⟨q, _, rfl⟩ := List.mem_map.mp hx
    dsimp only
    rw [iter_dead f N d hfd w hw, mul_zero]
  intro m hm
  induction m, hm using Nat.le_induction with
  | base => exact hbase
  | succ m _ ih =>
    intro p hp
    rw [lin_succ, lin_succ]
    have e1 := W_list f N d (lin (fun j => (W f N)^[j] w) P m) (hlin0 P m) p.1 p.2 (hD p hp)
    have e2 := W_list f N d (lin (fun j => (W f N)^[j] w) Q m) (hlin0 Q m) p.1 p.2 (hD p hp)
    change W f N (lin (fun j => (W f N)^[j] w) P m) p.1 = W f N (lin (fun j => (W f N)^[j] w) Q m) p.1
    rw [e1, e2]
    congr 1
    apply List.map_congr_left
    intro t ht
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcl p hp t ht)
    exact ih q hq
end

theorem lin_sum (V : ℕ → ℕ → ℕ) (ι : ℕ → ℕ) (N : ℕ) (P : List (ℕ × ℕ)) (m : ℕ) :
    (P.map fun p => p.1 * ∑ k ∈ range N, V (m + p.2) (ι k)).sum
      = ∑ k ∈ range N, lin V P m (ι k) := by
  induction P with
  | nil => simp [lin]
  | cons p P ih =>
    simp only [lin, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Finset.sum_add_distrib, Finset.mul_sum]

end TMEngine2

namespace TMEngine2

theorem forall_pair_snoc {n : ℕ} (P : Fin (n + 2) → Fin (n + 2) → Prop) :
    (∀ i j : Fin (n + 2), j.val = i.val + 1 → P i j) ↔
      (∀ i j : Fin (n + 1), j.val = i.val + 1 → P i.castSucc j.castSucc) ∧
        P (Fin.last n).castSucc (Fin.last (n + 1)) := by
  constructor
  · intro H
    exact ⟨fun i j h => H _ _ (by simpa using h), H _ _ (by simp)⟩
  · rintro ⟨H, Hl⟩ i j h
    by_cases hj : j.val < n + 1
    · exact H ⟨i.val, by omega⟩ ⟨j.val, hj⟩ h
    · have hj' : j = Fin.last _ := Fin.ext (by have := j.isLt; simp; omega)
      have hi' : i = (Fin.last n).castSucc := Fin.ext (by simp; omega)
      subst hj' hi'
      exact Hl

theorem forall_triple_snoc {n : ℕ} (P : Fin (n + 2) → Fin (n + 2) → Fin (n + 2) → Prop) :
    (∀ i j l : Fin (n + 2), j.val = i.val + 1 → l.val = j.val + 1 → P i j l) ↔
      (∀ i j l : Fin (n + 1), j.val = i.val + 1 → l.val = j.val + 1 → P i.castSucc j.castSucc l.castSucc) ∧
        (∀ i j : Fin (n + 2), j.val = i.val + 1 → j.val = n → P i j (Fin.last (n + 1))) := by
  constructor
  · intro H
    refine ⟨fun i j l h1 h2 => H _ _ _ (by simpa using h1) (by simpa using h2), fun i j h1 h2 => H _ _ _ h1 ?_⟩
    simp; omega
  · rintro ⟨H, Hl⟩ i j l h1 h2
    by_cases hl : l.val < n + 1
    · exact H ⟨i.val, by omega⟩ ⟨j.val, by omega⟩ ⟨l.val, hl⟩ h1 h2
    · have hl' : l = Fin.last _ := Fin.ext (by have := l.isLt; simp; omega)
      subst hl'
      exact Hl i j h1 (by simp at h2; omega)

end TMEngine2

namespace A201696P

open Finset TMEngine2 OMA.S_oeis_a201696

instance lexDec {m q : ℕ} (u v : Fin m → Fin q) : Decidable (lexLE u v) :=
  inferInstanceAs (Decidable (u = v ∨ ∃ i : Fin m, (∀ j : Fin m, j < i → u j = v j) ∧ u i < v i))

abbrev Row := Fin 3 × Fin 3 × Fin 3 × Fin 3
abbrev St := Option (Row × Fin 3 × Fin 3 × Fin 3)

def encR (r : Row) : ℕ := r.1.val + 3 * r.2.1.val + 9 * r.2.2.1.val + 27 * r.2.2.2.val

def enc : St → ℕ
  | none => 2187
  | some (r, f0, f1, f2) => encR r + 81 * (f0.val + 3 * f1.val + 9 * f2.val)

def d3 (k i : ℕ) : Fin 3 := ⟨k / i % 3, Nat.mod_lt _ (by norm_num)⟩

def decR (k : ℕ) : Row := (d3 k 1, d3 k 3, d3 k 9, d3 k 27)

def dec (s : ℕ) : St :=
  if s < 2187 then some (decR s, d3 s 81, d3 s 243, d3 s 729) else none

theorem dec_enc : ∀ t : St, dec (enc t) = t := by decide +kernel

def vec (r : Row) : Fin 4 → Fin 3 := ![r.1, r.2.1, r.2.2.1, r.2.2.2]

def rowOK (u v : Fin 4 → Fin 3) : Prop := lexLE u v ∧ lexLE (bwd v) (bwd u)

instance (u v : Fin 4 → Fin 3) : Decidable (rowOK u v) :=
  inferInstanceAs (Decidable (lexLE u v ∧ lexLE (bwd v) (bwd u)))

/-- Flag update of one column pair (c above, d beside) with new entries a and b:
0 = equal so far, 1 = first difference has c < d and last difference has d > c,
2 = first difference has c < d and last difference has d < c, none = dead. -/
def upd (fl : Fin 3) (a b : Fin 3) : Option (Fin 3) :=
  if fl = 0 then (if a = b then some 0 else if a < b then some 1 else none)
  else if a = b then some fl else if a < b then some 1 else some 2

def updAll (f0 f1 f2 : Fin 3) (r : Row) : Option (Fin 3 × Fin 3 × Fin 3) :=
  match upd f0 r.1 r.2.1, upd f1 r.2.1 r.2.2.1, upd f2 r.2.2.1 r.2.2.2 with
  | some g0, some g1, some g2 => some (g0, g1, g2)
  | _, _, _ => none

def step : St → Row → St
  | none, _ => none
  | some (u, f0, f1, f2), r =>
    if rowOK (vec u) (vec r) then
      match updAll f0 f1 f2 r with
      | some (g0, g1, g2) => some (r, g0, g1, g2)
      | none => none
    else none

def start (r : Row) : St :=
  match updAll 0 0 0 r with
  | some (g0, g1, g2) => some (r, g0, g1, g2)
  | none => none

def f (s k : ℕ) : ℕ := enc (step (dec s) (decR k))
def ι (k : ℕ) : ℕ := enc (start (decR k))
def accS : St → ℕ
  | none => 0
  | some (_, f0, f1, f2) => if f0 ≠ 1 ∧ f1 ≠ 1 ∧ f2 ≠ 1 then 1 else 0
def acc (s : ℕ) : ℕ := accS (dec s)

def e : (Fin 4 → Fin 3) ≃ Fin 81 := finFunctionFinEquiv

theorem e_val (c : Fin 4 → Fin 3) :
    (e c : ℕ) = (c 0).val + 3 * (c 1).val + 9 * (c 2).val + 27 * (c 3).val := by
  unfold e
  rw [finFunctionFinEquiv_apply, Fin.sum_univ_four]
  simp only [Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one]
  norm_num
  ring

theorem decR_e (c : Fin 4 → Fin 3) : decR (e c) = (c 0, c 1, c 2, c 3) := by
  rw [e_val]
  have h0 := (c 0).isLt
  have h1 := (c 1).isLt
  have h2 := (c 2).isLt
  have h3 := (c 3).isLt
  simp only [decR, d3, Prod.mk.injEq, Fin.ext_iff]
  omega

theorem vec_eq (c : Fin 4 → Fin 3) : vec (c 0, c 1, c 2, c 3) = c := by
  funext i; fin_cases i <;> rfl

/-! Column-pair properties. Pair `j : Fin 3` compares columns `j.castSucc` and `j.succ`. -/

def PE {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) : Prop := ∀ i, x i j.castSucc = x i j.succ
def PF {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) : Prop :=
  ∃ i : Fin m, (∀ i' : Fin m, i'.val < i.val → x i' j.castSucc = x i' j.succ) ∧ x i j.castSucc < x i j.succ
def PL {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) : Prop :=
  ∃ i : Fin m, (∀ i' : Fin m, i.val < i'.val → x i' j.succ = x i' j.castSucc) ∧ x i j.succ < x i j.castSucc

theorem lex_fwd {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) :
    lexLE (fun i => x i j.castSucc) (fun i => x i j.succ) ↔ PE x j ∨ PF x j := by
  unfold lexLE PE PF
  rw [funext_iff]
  simp only [Fin.lt_def]

theorem lex_bwd {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) :
    lexLE (bwd fun i => x i j.succ) (bwd fun i => x i j.castSucc) ↔ PE x j ∨ PL x j := by
  unfold lexLE PE PL bwd
  apply or_congr
  · rw [funext_iff]
    constructor
    · intro h i; have := h i.rev; rw [Fin.rev_rev] at this; exact this.symm
    · intro h i; exact (h i.rev).symm
  · constructor
    · rintro ⟨i, h1, h2⟩
      refine ⟨i.rev, fun i' hi' => ?_, h2⟩
      have := h1 i'.rev (by have := i.isLt; have := i'.isLt; rw [Fin.lt_def, Fin.val_rev]; rw [Fin.val_rev] at hi'; omega)
      rwa [Fin.rev_rev] at this
    · rintro ⟨i, h1, h2⟩
      refine ⟨i.rev, fun i' hi' => ?_, by rwa [Fin.rev_rev]⟩
      exact h1 i'.rev (by have := i.isLt; have := i'.isLt; rw [Fin.lt_def, Fin.val_rev] at hi'; rw [Fin.val_rev]; omega)

theorem PE_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 3) (j : Fin 3) :
    PE x j ↔ PE (Fin.init x) j ∧ x (Fin.last _) j.castSucc = x (Fin.last _) j.succ := by
  unfold PE; rw [Fin.forall_fin_succ']; rfl

theorem PF_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 3) (j : Fin 3) :
    PF x j ↔ PF (Fin.init x) j ∨ (PE (Fin.init x) j ∧ x (Fin.last _) j.castSucc < x (Fin.last _) j.succ) := by
  unfold PF PE
  rw [Fin.exists_fin_succ']
  apply or_congr
  · apply exists_congr; intro i
    apply and_congr_left; intro _
    rw [Fin.forall_fin_succ']
    simp only [Fin.val_castSucc, Fin.val_last]
    constructor
    · intro h i' hi'; exact h.1 i' hi'
    · intro h; exact ⟨h, fun hh => by have := i.isLt; omega⟩
  · apply and_congr_left; intro _
    rw [Fin.forall_fin_succ']
    simp only [Fin.val_castSucc, Fin.val_last, lt_self_iff_false, IsEmpty.forall_iff, and_true]
    constructor
    · intro h i'; exact h i' i'.isLt
    · intro h i' _; exact h i'

theorem PL_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 3) (j : Fin 3) :
    PL x j ↔ x (Fin.last _) j.succ < x (Fin.last _) j.castSucc ∨
      (x (Fin.last _) j.succ = x (Fin.last _) j.castSucc ∧ PL (Fin.init x) j) := by
  unfold PL
  rw [Fin.exists_fin_succ']
  simp only [Fin.val_castSucc, Fin.val_last]
  rw [or_comm]
  apply or_congr
  · constructor
    · rintro ⟨_, h⟩; exact h
    · intro h; exact ⟨fun i' hi' => by have := i'.isLt; omega, h⟩
  · constructor
    · rintro ⟨i, h1, h2⟩
      refine ⟨h1 (Fin.last _) (by simp; omega), i, fun i' hi' => h1 i'.castSucc (by simpa using hi'), h2⟩
    · rintro ⟨hl, i, h1, h2⟩
      refine ⟨i, fun i' hi' => ?_, h2⟩
      by_cases hc : i'.val < n + 1
      · exact h1 ⟨i'.val, hc⟩ hi'
      · have : i' = Fin.last _ := Fin.ext (by have := i'.isLt; simp; omega)
        subst this; exact hl

/-! The flag of a column pair. -/

open Classical in
noncomputable def flag {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) : Fin 3 :=
  if PE x j then 0 else if PL x j then 2 else 1

def colsOK {m : ℕ} (x : Fin m → Fin 4 → Fin 3) : Prop := ∀ j : Fin 3, PE x j ∨ PF x j

def rowsOK {m : ℕ} (x : Fin m → Fin 4 → Fin 3) : Prop :=
  ∀ i i' : Fin m, i'.val = i.val + 1 → rowOK (x i) (x i')

open Classical in
noncomputable def semS {n : ℕ} (x : Fin (n + 1) → Fin 4 → Fin 3) : St :=
  if rowsOK x ∧ colsOK x then
    some ((x (Fin.last n) 0, x (Fin.last n) 1, x (Fin.last n) 2, x (Fin.last n) 3),
      flag x 0, flag x 1, flag x 2)
  else none

noncomputable def sem (n : ℕ) (x : Fin (n + 1) → Fin 4 → Fin 3) : ℕ := enc (semS x)

theorem PE_PF {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) (h : PE x j) : ¬ PF x j := by
  rintro ⟨i, _, h2⟩; rw [h i] at h2; exact lt_irrefl _ h2

theorem PE_PL {m : ℕ} (x : Fin m → Fin 4 → Fin 3) (j : Fin 3) (h : PE x j) : ¬ PL x j := by
  rintro ⟨i, _, h2⟩; rw [h i] at h2; exact lt_irrefl _ h2

open Classical in
/-- One column pair under a new row: the flag update and liveness. -/
theorem upd_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 3) (j : Fin 3)
    (hy : PE (Fin.init x) j ∨ PF (Fin.init x) j) :
    upd (flag (Fin.init x) j) (x (Fin.last _) j.castSucc) (x (Fin.last _) j.succ) =
      if PE x j ∨ PF x j then some (flag x j) else none := by
  have hE := PE_snoc x j
  have hF := PF_snoc x j
  have hL := PL_snoc x j
  set a := x (Fin.last _) j.castSucc
  set b := x (Fin.last _) j.succ
  unfold flag upd
  by_cases hEy : PE (Fin.init x) j
  · have hLy := PE_PL _ _ hEy
    rw [if_pos hEy, if_pos rfl]
    by_cases hab : a = b
    · have hEx : PE x j := hE.mpr ⟨hEy, hab⟩
      rw [if_pos hab, if_pos (Or.inl hEx), if_pos hEx]
    · have hEx : ¬ PE x j := fun h => hab (hE.mp h).2
      rw [if_neg hab]
      by_cases hlt : a < b
      · have hFx : PF x j := hF.mpr (Or.inr ⟨hEy, hlt⟩)
        have hLx : ¬ PL x j := by
          rw [hL]; rintro (h | ⟨_, h⟩)
          · exact lt_asymm h hlt
          · exact hLy h
        rw [if_pos hlt, if_pos (Or.inr hFx), if_neg hEx, if_neg hLx]
      · have hFx : ¬ PF x j := by
          rw [hF]; rintro (h | ⟨_, h⟩)
          · exact PE_PF _ _ hEy h
          · exact hlt h
        rw [if_neg hlt, if_neg (by tauto)]
  · have hFy : PF (Fin.init x) j := hy.resolve_left hEy
    have hEx : ¬ PE x j := fun h => hEy (hE.mp h).1
    have hFx : PF x j := hF.mpr (Or.inl hFy)
    rw [if_neg hEy, if_pos (Or.inr hFx), if_neg hEx]
    have hne : (if PL (Fin.init x) j then (2 : Fin 3) else 1) ≠ 0 := by split_ifs <;> decide
    rw [if_neg hne]
    by_cases hab : a = b
    · rw [if_pos hab]
      have : PL x j ↔ PL (Fin.init x) j := by
        rw [hL]; constructor
        · rintro (h | ⟨_, h⟩)
          · rw [hab] at h; exact absurd h (lt_irrefl _)
          · exact h
        · intro h; exact Or.inr ⟨hab.symm, h⟩
      by_cases hLy : PL (Fin.init x) j
      · rw [if_pos hLy, if_pos (this.mpr hLy)]
      · rw [if_neg hLy, if_neg (fun h => hLy (this.mp h))]
    · rw [if_neg hab]
      by_cases hlt : a < b
      · have hLx : ¬ PL x j := by
          rw [hL]; rintro (h | ⟨h, _⟩)
          · exact lt_asymm h hlt
          · exact hab h.symm
        rw [if_pos hlt, if_neg hLx]
      · have hba : b < a := lt_of_le_of_ne (not_lt.mp hlt) (Ne.symm hab)
        rw [if_neg hlt, if_pos (hL.mpr (Or.inl hba))]

theorem PE_one (x : Fin 1 → Fin 4 → Fin 3) (j : Fin 3) : PE x j ↔ x 0 j.castSucc = x 0 j.succ := by
  unfold PE; rw [Fin.forall_fin_one]

theorem PF_one (x : Fin 1 → Fin 4 → Fin 3) (j : Fin 3) : PF x j ↔ x 0 j.castSucc < x 0 j.succ := by
  unfold PF; rw [Fin.exists_fin_one]
  constructor
  · exact fun h => h.2
  · intro h; exact ⟨fun i' hi' => by simp at hi', h⟩

theorem PL_one (x : Fin 1 → Fin 4 → Fin 3) (j : Fin 3) : PL x j ↔ x 0 j.succ < x 0 j.castSucc := by
  unfold PL; rw [Fin.exists_fin_one]
  constructor
  · exact fun h => h.2
  · intro h; exact ⟨fun i' hi' => absurd hi' (by have := i'.isLt; first | omega | simp | (simp; omega)), h⟩

open Classical in
theorem upd_zero (x : Fin 1 → Fin 4 → Fin 3) (j : Fin 3) :
    upd 0 (x 0 j.castSucc) (x 0 j.succ) = if PE x j ∨ PF x j then some (flag x j) else none := by
  unfold flag upd
  rw [PE_one, PF_one, PL_one, if_pos rfl]
  set a := x 0 j.castSucc
  set b := x 0 j.succ
  by_cases hab : a = b
  · rw [if_pos hab, if_pos (Or.inl hab), if_pos hab]
  · rw [if_neg hab, if_neg hab]
    by_cases hlt : a < b
    · rw [if_pos hlt, if_pos (Or.inr hlt), if_neg (not_lt.mpr hlt.le)]
    · rw [if_neg hlt, if_neg (by tauto)]

theorem pair_iff {Q : Fin 4 → Fin 4 → Prop} :
    (∀ j j' : Fin 4, j.val + 1 = j'.val → Q j j') ↔ ∀ j : Fin 3, Q j.castSucc j.succ := by
  constructor
  · intro H j; exact H _ _ (by simp)
  · intro H j j' h
    have hk : j.val < 3 := by have := j'.isLt; omega
    have e1 : j = (⟨j.val, hk⟩ : Fin 3).castSucc := Fin.ext rfl
    have e2 : j' = (⟨j.val, hk⟩ : Fin 3).succ := Fin.ext (by simp; omega)
    rw [e1, e2]; exact H _

theorem match_none (o1 o2 o3 : Option (Fin 3)) (r : Row) (h : o1 = none ∨ o2 = none ∨ o3 = none) :
    (match (match o1, o2, o3 with
      | some g0, some g1, some g2 => some (g0, g1, g2)
      | _, _, _ => none) with
      | some (g0, g1, g2) => some (r, g0, g1, g2)
      | none => (none : St)) = none := by
  rcases h with rfl | rfl | rfl <;> (try cases o1) <;> (try cases o2) <;> (try cases o3) <;> rfl

open Classical in
theorem semS_succ {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 3) :
    semS x = step (semS (Fin.init x)) (x (Fin.last _) 0, x (Fin.last _) 1, x (Fin.last _) 2, x (Fin.last _) 3) := by
  have hrows : rowsOK x ↔ rowsOK (Fin.init x) ∧ rowOK (x (Fin.last n).castSucc) (x (Fin.last _)) :=
    forall_pair_snoc (fun i i' => rowOK (x i) (x i'))
  have hcolsy : colsOK x → colsOK (Fin.init x) := by
    intro h j
    rcases h j with h | h
    · exact Or.inl ((PE_snoc x j).mp h).1
    · rcases (PF_snoc x j).mp h with h | h
      · exact Or.inr h
      · exact Or.inl h.1
  unfold semS
  by_cases hy : rowsOK (Fin.init x) ∧ colsOK (Fin.init x)
  · rw [if_pos hy]
    simp only [step, vec_eq]
    have u0 := upd_snoc x 0 (hy.2 0)
    have u1 := upd_snoc x 1 (hy.2 1)
    have u2 := upd_snoc x 2 (hy.2 2)
    simp only [show ((0 : Fin 3).castSucc : Fin 4) = 0 from rfl, show ((0 : Fin 3).succ : Fin 4) = 1 from rfl,
      show ((1 : Fin 3).castSucc : Fin 4) = 1 from rfl, show ((1 : Fin 3).succ : Fin 4) = 2 from rfl,
      show ((2 : Fin 3).castSucc : Fin 4) = 2 from rfl, show ((2 : Fin 3).succ : Fin 4) = 3 from rfl] at u0 u1 u2
    by_cases hr : rowOK (Fin.init x (Fin.last n)) (x (Fin.last _))
    · rw [if_pos hr]
      simp only [updAll]
      rw [u0, u1, u2]
      by_cases hc : colsOK x
      · rw [if_pos ⟨hrows.mpr ⟨hy.1, hr⟩, hc⟩, if_pos (hc 0), if_pos (hc 1), if_pos (hc 2)]
      · rw [if_neg (fun h => hc h.2)]
        symm
        apply match_none
        unfold colsOK at hc
        push_neg at hc
        obtain ⟨j, hj⟩ := hc
        fin_cases j
        · left; rw [if_neg (by simpa using hj)]
        · right; left; rw [if_neg (by simpa using hj)]
        · right; right; rw [if_neg (by simpa using hj)]
    · rw [if_neg hr, if_neg (fun h => hr (hrows.mp h.1).2)]
  · rw [if_neg hy, if_neg (fun h => hy ⟨(hrows.mp h.1).1, hcolsy h.2⟩)]
    rfl

theorem sem_succ (n : ℕ) (x : Fin (n + 2) → Fin 4 → Fin 3) :
    sem (n + 1) x = f (sem n (Fin.init x)) (e (x (Fin.last _))) := by
  unfold sem f
  rw [dec_enc, decR_e, semS_succ]

open Classical in
theorem sem_zero (x : Fin 1 → Fin 4 → Fin 3) : sem 0 x = ι (e (x 0)) := by
  unfold sem ι
  rw [decR_e]
  congr 1
  have hrows : rowsOK x := by
    intro i i' h; have := i.isLt; have := i'.isLt; omega
  have u0 := upd_zero x 0
  have u1 := upd_zero x 1
  have u2 := upd_zero x 2
  simp only [show ((0 : Fin 3).castSucc : Fin 4) = 0 from rfl, show ((0 : Fin 3).succ : Fin 4) = 1 from rfl,
    show ((1 : Fin 3).castSucc : Fin 4) = 1 from rfl, show ((1 : Fin 3).succ : Fin 4) = 2 from rfl,
    show ((2 : Fin 3).castSucc : Fin 4) = 2 from rfl, show ((2 : Fin 3).succ : Fin 4) = 3 from rfl] at u0 u1 u2
  unfold semS start
  simp only [updAll]
  rw [u0, u1, u2]
  by_cases hc : colsOK x
  · rw [if_pos ⟨hrows, hc⟩, if_pos (hc 0), if_pos (hc 1), if_pos (hc 2)]
    rfl
  · rw [if_neg (fun h => hc h.2)]
    symm
    apply match_none
    unfold colsOK at hc
    push_neg at hc
    obtain ⟨j, hj⟩ := hc
    fin_cases j
    · left; rw [if_neg (by simpa using hj)]
    · right; left; rw [if_neg (by simpa using hj)]
    · right; right; rw [if_neg (by simpa using hj)]

theorem good_iff {m : ℕ} (x : Fin m → Fin 4 → Fin 3) :
    good x ↔ rowsOK x ∧ ∀ j : Fin 3, (PE x j ∨ PF x j) ∧ (PE x j ∨ PL x j) := by
  unfold good rowsOK rowOK
  apply and_congr
  · constructor
    · intro H i i' h; exact H i i' h.symm
    · intro H i i' h; exact H i i' h.symm
  · rw [pair_iff]
    apply forall_congr'; intro j
    rw [lex_fwd, lex_bwd]

open Classical in
theorem acc_sem (n : ℕ) (x : Fin (n + 1) → Fin 4 → Fin 3) :
    acc (sem n x) = if good x then 1 else 0 := by
  unfold acc sem
  rw [dec_enc]
  have hflag : ∀ j, (PE x j ∨ PF x j) → (flag x j ≠ 1 ↔ PE x j ∨ PL x j) := by
    intro j _
    unfold flag
    by_cases h1 : PE x j
    · simp [h1]
    · by_cases h2 : PL x j
      · simp [h1, h2]
      · simp [h1, h2]
  unfold semS
  by_cases ha : rowsOK x ∧ colsOK x
  · rw [if_pos ha]
    simp only [accS]
    by_cases hg : good x
    · rw [if_pos hg]
      have := ((good_iff x).mp hg).2
      rw [if_pos ⟨(hflag 0 (ha.2 0)).mpr (this 0).2, (hflag 1 (ha.2 1)).mpr (this 1).2,
        (hflag 2 (ha.2 2)).mpr (this 2).2⟩]
    · rw [if_neg hg, if_neg]
      intro h
      apply hg
      refine (good_iff x).mpr ⟨ha.1, fun j => ⟨ha.2 j, ?_⟩⟩
      fin_cases j
      · exact (hflag 0 (ha.2 0)).mp h.1
      · exact (hflag 1 (ha.2 1)).mp h.2.1
      · exact (hflag 2 (ha.2 2)).mp h.2.2
  · rw [if_neg ha, if_neg]
    · rfl
    · intro hg
      have := (good_iff x).mp hg
      exact ha ⟨this.1, fun j => (this.2 j).1⟩

theorem a_succ (n : ℕ) : a (n + 1) = ∑ k ∈ range 81, (W f 81)^[n] acc (ι k) := by
  unfold a
  rw [Finset.card_filter, ← sum_sem e sem f ι sem_zero sem_succ n acc]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [acc_sem]

