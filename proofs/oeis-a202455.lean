  simp only [G4, step4C_eq]
  revert a b c
  decide +kernel

lemma G6 (a b c : Fin 9) : G a b c 6 = look t6 a b c := by
  rw [G_succ]
  simp only [G5, step4C_eq]
  revert a b c
  decide +kernel

lemma G7 (a b c : Fin 9) : G a b c 7 = look t7 a b c := by
