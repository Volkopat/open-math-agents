  revert a b c
  decide +kernel

/-- (E - 1)^5 G = 0 from m = 3 on, on every state. -/
theorem G_rec (m : ℕ) : ∀ a b c : Fin 9, (G a b c (m + 8) : ℤ) = 5 * G a b c (m + 7) - 10 * G a b c
    (m + 6) + 10 * G a b c (m + 5) - 5 * G a b c (m + 4) + G a b c (m + 3) := by
  induction m with
  | zero =>
    intro a b c
    rw [G8, G7, G6, G5, G4, G3]
    revert a b c
    decide +kernel
  | succ m ih =>
    intro a b c
    rw [G_succ a b c (m + 8), G_succ a b c (m + 7), G_succ a b c (m + 6), G_succ a b c (m + 5),
      G_succ a b c (m + 4), G_succ a b c (m + 3)]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    split_ifs
    · exact ih _ _ _
    · simp

lemma T_vals : T 0 = 729 ∧ T 1 = 1194 ∧ T 2 = 1876 ∧ T 3 = 2835 ∧ T 4 = 4137 ∧ T 5 = 5854 ∧ T 6 =
    8064 ∧ T 7 = 10851 := by
  unfold T
  simp only [G_zero, G1, G2, G3, G4, G5, G6, G7]
  decide +kernel

/-- The order-5 recurrence of T, for all m. -/
theorem T_rec (m : ℕ) : (T (m + 5) : ℤ) = 5 * T (m + 4) - 10 * T (m + 3) + 10 * T (m + 2) - 5 * T
    (m + 1) + T m := by
  rcases Nat.lt_or_ge m 3 with hm | hm
  · obtain ⟨v0, v1, v2, v3, v4, v5, v6, v7⟩ := T_vals
    interval_cases m <;> simp only [v0, v1, v2, v3, v4, v5, v6, v7] <;> norm_num
  · obtain ⟨k, rfl⟩ : ∃ k, m = k + 3 := ⟨m - 3, by omega⟩
    unfold T
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl
      (fun c _ => ?_)))
    have h := G_rec k a b c
    rw [show k + 3 + 5 = k + 8 by omega, show k + 3 + 4 = k + 7 by omega, show k + 3 + 3 = k + 6 by
      omega, show k + 3 + 2 = k + 5 by omega, show k + 3 + 1 = k + 4 by omega]
    linarith

/-- Barker's recurrence, for n > 5. -/
theorem recurrence (n : ℕ) (hn : 5 < n) : (a n : ℤ) = 5 * a (n - 1) - 10 * a (n - 2) + 10 * a (n -
    3) - 5 * a (n - 4) + a (n - 5) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
  rw [show k + 6 = (k + 5) + 1 from rfl, show k + 5 + 1 - 1 = (k + 4) + 1 by omega, show k + 5 + 1 -
    2 = (k + 3) + 1 by omega, show k + 5 + 1 - 3 = (k + 2) + 1 by omega, show k + 5 + 1 - 4 = (k +
    1) + 1 by omega, show k + 5 + 1 - 5 = k + 1 by omega]
  simp only [a_T]
  exact T_rec k

lemma values : a 1 = 729 ∧ a 2 = 1194 ∧ a 3 = 1876 ∧ a 4 = 2835 ∧ a 5 = 4137 := by
  obtain ⟨v0, v1, v2, v3, v4, v5, v6, v7⟩ := T_vals
  exact ⟨by rw [a_T, v0], by rw [a_T, v1], by rw [a_T, v2], by rw [a_T, v3], by rw [a_T, v4]⟩

/-- Barker's g.f., as A(x) (1 - x)^5 = N(x) in Z[[x]]. -/
theorem gf : PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 5 =
    X * (729 - 2451 * X + 3196 * X ^ 2 - 1895 * X ^ 3 + 427 * X ^ 4) := by
  set A : ℤ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) with hA
  have e1 : A * (1 - X) ^ 5 =
      A - C 5 * (A * X ^ 1) + C 10 * (A * X ^ 2) - C 10 * (A * X ^ 3) + C 5 * (A * X ^ 4) - A * X ^
        5 := by
    simp only [map_ofNat]; ring
  have e2 : (X * (729 - 2451 * X + 3196 * X ^ 2 - 1895 * X ^ 3 + 427 * X ^ 4) : ℤ⟦X⟧) =
      X ^ 1 * C 729 - X ^ 2 * C 2451 + X ^ 3 * C 3196 - X ^ 4 * C 1895 + X ^ 5 * C 427 := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℤ) else a k := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  have v := values
  rcases Nat.lt_or_ge n 6 with hn | hn
  · interval_cases n <;> simp_all
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 6 := ⟨n - 6, by omega⟩
    have h := recurrence (q + 6) (by omega)
    simp only [show q + 6 - 1 = q + 5 by omega, show q + 6 - 2 = q + 4 by omega, show q + 6 - 3 =
      q + 3 by omega, show q + 6 - 4 = q + 2 by omega, show q + 6 - 5 = q + 1 by omega] at h ⊢
    simp only [show ¬ q + 6 = 0 by omega, show ¬ q + 5 = 0 by omega, show ¬ q + 4 = 0 by omega, show
      ¬ q + 3 = 0 by omega, show ¬ q + 2 = 0 by omega, show ¬ q + 1 = 0 by omega, show 1 ≤ q + 6 by
      omega, show 2 ≤ q + 6 by omega, show 3 ≤ q + 6 by omega, show 4 ≤ q + 6 by omega, show 5 ≤ q +
      6 by omega, show ¬ q + 6 = 1 by omega, show ¬ q + 6 = 2 by omega, show ¬ q + 6 = 3 by omega,
      show ¬ q + 6 = 4 by omega, show ¬ q + 6 = 5 by omega, if_true, if_false]
    rw [h]
    ring

/-- Hardin's empirical formula, for n >= 1. -/
theorem empirical (n : ℕ) (hn : 1 ≤ n) : (a n : ℚ) = 1 / 4 * n ^ 4 + 15 / 2 * n ^ 3 + 229 / 4 * n ^
    2 + 237 * n + 427 := by
  obtain ⟨w1, w2, w3, w4, w5⟩ := values
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 6 with h7 | h7
    · interval_cases n
      · rw [w1]; norm_num
      · rw [w2]; norm_num
      · rw [w3]; norm_num
      · rw [w4]; norm_num
      · rw [w5]; norm_num
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
      have h := recurrence (k + 6) (by omega)
      simp only [show k + 6 - 1 = k + 5 by omega, show k + 6 - 2 = k + 4 by omega, show k + 6 - 3 =
        k + 3 by omega, show k + 6 - 4 = k + 2 by omega, show k + 6 - 5 = k + 1 by omega] at h
      have h' : (a (k + 6) : ℚ) = 5 * a (k + 5) - 10 * a (k + 4) + 10 * a (k + 3) - 5 * a (k + 2) +
          a (k + 1) := by exact_mod_cast h
      rw [h', ih (k + 5) (by omega) (by omega), ih (k + 4) (by omega) (by omega), ih (k + 3) (by
        omega) (by omega), ih (k + 2) (by omega) (by omega), ih (k + 1) (by omega) (by omega)]
      push_cast
      ring

