/-- Both of Barker's conjectures. -/
theorem conjecture :
    (∀ n : ℕ, 5 < n → (a n : ℤ) = 5 * a (n - 1) - 10 * a (n - 2) + 10 * a (n - 3) - 5 * a (n - 4) +
      a (n - 5)) ∧
    PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else a n) * (1 - X) ^ 5 =
      X * (729 - 2451 * X + 3196 * X ^ 2 - 1895 * X ^ 3 + 427 * X ^ 4) :=
  ⟨recurrence, gf⟩

