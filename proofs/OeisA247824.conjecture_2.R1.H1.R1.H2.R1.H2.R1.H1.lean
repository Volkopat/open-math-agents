import Mathlib.Data.Nat.GCD.BigOperators
import Mathlib.Algebra.BigOperators.Intervals

/-! Certificate for the first nine stages of the hard partial sieve.
The divisibility bijection follows @physbuzz's parent reduction #9315,
which credits Daniel Veljjanoski and @rleshner. The Möbius and wheel
computations use the ordinary-leaf algorithm in PR #16352's local companion.
The numeric interval tree is generated by build_tiny_certificate.py and
build_stage23_certificate.py and independently reduced by the Lean kernel. -/

open Finset ArithmeticFunction
namespace Astra247824.Leaves
def survivors (ps : List ℕ) (x : ℕ) : Finset ℕ :=
  (Icc 1 x).filter (fun n => ∀ p ∈ ps, ¬ p ∣ n)

def signedSieve (ps : List ℕ) (x : ℕ) : ℤ := (survivors ps x).card

private lemma mem_survivors {ps : List ℕ} {x n : ℕ} :
    n ∈ survivors ps x ↔ (1 ≤ n ∧ n ≤ x) ∧ ∀ p ∈ ps, ¬ p ∣ n := by simp [survivors]

@[simp] theorem signedSieve_nil (x : ℕ) : signedSieve [] x = x := by
  simp [signedSieve, survivors, Nat.card_Icc]

theorem signedSieve_cons {p : ℕ} {ps : List ℕ} (hp : p.Prime)
    (distinct : ∀ q ∈ ps, q.Prime ∧ q ≠ p) (x : ℕ) :
    signedSieve (p :: ps) x = signedSieve ps x - signedSieve ps (x/p) := by
  have split : survivors (p :: ps) x = (survivors ps x).filter (fun n => ¬ p ∣ n) := by
    ext n; simp [survivors, List.mem_cons]; tauto
  have mult : (survivors ps x).filter (fun n => p ∣ n) = (survivors ps (x/p)).image (p * ·) := by
    ext n
    simp only [Finset.mem_filter, mem_survivors, Finset.mem_image]
    constructor
    · rintro ⟨⟨⟨h1, hx⟩, hq⟩, ⟨m, rfl⟩⟩
      refine ⟨m, ⟨⟨?_, ?_⟩, ?_⟩, rfl⟩
      · rcases Nat.eq_zero_or_pos m with rfl | hm
        · simp at h1
        · exact hm
      · exact (Nat.le_div_iff_mul_le hp.pos).2 (by rwa [mul_comm])
      · intro q hm hdvd
        exact hq q hm (dvd_mul_of_dvd_right hdvd p)
    · rintro ⟨m, ⟨⟨h1, hm⟩, hq⟩, rfl⟩
      refine ⟨⟨⟨?_, ?_⟩, ?_⟩, dvd_mul_right p m⟩
      · exact Nat.one_le_iff_ne_zero.2 (mul_ne_zero hp.ne_zero (by omega))
      · rw [mul_comm]; exact (Nat.le_div_iff_mul_le hp.pos).1 hm
      · intro q hmem hdvd
        obtain ⟨prime, neq⟩ := distinct q hmem
        rcases prime.dvd_mul.mp hdvd with h | h
        · exact neq ((Nat.prime_dvd_prime_iff_eq prime hp).mp h)
        · exact hq q hmem h
  have card := Finset.card_filter_add_card_filter_not (s := survivors ps x) (fun n => p ∣ n)
  rw [mult, Finset.card_image_of_injective _ (mul_right_injective₀ hp.ne_zero)] at card
  unfold signedSieve
  rw [split]
  omega

def descendingPrimes (y : ℕ) : List ℕ :=
  ((List.range (y+1)).filter (fun p => decide p.Prime)).reverse

theorem mem_descending {p y : ℕ} : p ∈ descendingPrimes y ↔ p ∈ Nat.primesLE y := by
  simp [descendingPrimes, Nat.mem_primesLE]

def remainingBound (y d : ℕ) := if d = 1 then y else d.minFac-1

def denominators (y : ℕ) := (Icc 1 y).filter Squarefree

abbrev Edge := Sigma (fun _ : ℕ => ℕ)

def edges (y : ℕ) : Finset Edge :=
  (denominators y).sigma (fun d => Nat.primesLE (remainingBound y d))

def special (y : ℕ) := (edges y).filter (fun e => ¬e.1*e.2 ≤ y)

def edgeValue (x : ℕ) (e : Edge) : ℤ :=
  -moebius e.1 * signedSieve (descendingPrimes (e.2-1)) (x/(e.1*e.2))

end Astra247824.Leaves

namespace Astra247824
open OMA.R_OeisA247824_conjecture_2_R1_H1_R1
def sieveStep (p : ℕ) (f : ℕ → ℕ) (x : ℕ) : ℕ :=
  if x < p then (if x = 0 then 0 else 1) else f x - f (x / p)

/-- Sieve by the first `a` entries of an indexed ascending prime list. -/
def phi (p : ℕ → ℕ) : ℕ → ℕ → ℕ
  | 0 => id
  | a+1 => sieveStep (p a) (phi p a)

theorem phi_eq_fold (p : ℕ → ℕ) (a : ℕ) :
    phi p a = ((List.range a).map p).reverse.foldr sieveStep id := by
  induction a with
  | zero => rfl
  | succ a ih => simp [phi, List.range_succ, ih]

def rough (y x : ℕ) : ℕ :=
  ((Icc 1 x).filter (fun n => ∀ p ∈ Nat.primesLE y, ¬ p ∣ n)).card

theorem rough_eq_phi (p : ℕ → ℕ) (a y x : ℕ)
    (primeList : (List.range a).map p =
      (List.range (y+1)).filter (fun q => decide q.Prime)) :
    rough y x = phi p a x := by
  rw [phi_eq_fold, primeList]
  exact (legendre_range y x).symm

theorem rough_succ (y x : ℕ) :
    rough y (x+1) = rough y x + (if ∀ p ∈ Nat.primesLE y, ¬ p ∣ x+1 then 1 else 0) := by
  unfold rough
  have interval : insert (x+1) (Icc 1 x) = Icc 1 (x+1) :=
    insert_Icc_right_eq_Icc_succ (by omega : 1 ≤ x+1)
  rw [← interval, filter_insert]
  have fresh : x+1 ∉ (Icc 1 x).filter (fun n => ∀ p ∈ Nat.primesLE y, ¬ p ∣ n) := by simp
  split <;> simp_all

/-- A full wheel period adds a constant number of survivors. -/
theorem rough_period {w y : ℕ} (hw : ∀ p ∈ Nat.primesLE y, p ∣ w) (x : ℕ) :
    rough y (w+x) = rough y w + rough y x := by
  induction x with
  | zero => simp [rough]
  | succ x ih =>
    have equiv : (∀ p ∈ Nat.primesLE y, ¬ p ∣ w + (x+1)) ↔
        (∀ p ∈ Nat.primesLE y, ¬ p ∣ x+1) := by
      constructor
      · exact fun h p hp hd => h p hp ((Nat.dvd_add_iff_right (hw p hp)).mp hd)
      · exact fun h p hp hd => h p hp ((Nat.dvd_add_iff_right (hw p hp)).mpr hd)
    rw [← Nat.add_assoc, rough_succ y (w+x), ih, rough_succ y x, Nat.add_assoc w x 1]
    by_cases h : ∀ p ∈ Nat.primesLE y, ¬ p ∣ x+1
    · simp only [if_pos h, if_pos (equiv.mpr h), Nat.add_assoc]
    · simp only [if_neg h, if_neg (mt equiv.mp h), Nat.add_assoc]

/-- Evaluate a periodic wheel using a single table of residue prefix counts. -/
theorem rough_wheel {w y : ℕ} (hw : ∀ p ∈ Nat.primesLE y, p ∣ w) (x : ℕ) :
    rough y x = (x/w) * rough y w + rough y (x%w) := by
  have periods (k r : ℕ) : rough y (w*k+r) = k * rough y w + rough y r := by
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Nat.mul_succ, Nat.add_right_comm, Nat.add_comm (w*k+r), rough_period hw, ih,
        Nat.succ_mul]
      omega
  calc
    rough y x = rough y (w*(x/w)+x%w) := congrArg (rough y) (Nat.div_add_mod x w).symm
    _ = _ := periods _ _

open Leaves
def hardEdges (x y : ℕ) : Finset Edge :=
  (special y).filter (fun e => ¬ x/(e.1*e.2) < e.2^2)

end Astra247824

namespace Astra247824.Ordinary
private def trialAux (n : ℕ) : ℕ → ℕ → ℕ
  | 0, k => Nat.minFacAux n k
  | fuel+1, k => if n < k*k then n else if k ∣ n then k else trialAux n fuel (k+2)

private theorem trialAux_eq (n fuel k : ℕ) : trialAux n fuel k = Nat.minFacAux n k := by
  induction fuel generalizing k with
  | zero => rfl
  | succ fuel ih =>
    rw [trialAux, Nat.minFacAux]
    split <;> try rfl
    split <;> try rfl
    exact ih _

private def least (n : ℕ) : ℕ := if 2 ∣ n then 2 else trialAux n 105 3

private theorem least_eq (n : ℕ) : least n = n.minFac := by
  simp only [least, trialAux_eq, Nat.minFac]

/-- Strip a prime factor and detect repeated factors. Sixteen steps suffice
for the concrete range. The fallback makes the equivalence true for every input. -/
noncomputable def mu : ℕ → ℕ → ℤ
  | 0, d => moebius d
  | fuel+1, d =>
      if d = 0 then 0 else if d = 1 then 1 else
      let p := least d
      let q := d/p
      if p ∣ q then 0 else -mu fuel q

theorem mu_eq (fuel d : ℕ) : mu fuel d = moebius d := by
  induction fuel generalizing d with
  | zero => rfl
  | succ fuel ih =>
    by_cases hz : d=0
    · subst d; simp [mu]
    by_cases ho : d=1
    · subst d; simp [mu]
    rw [mu, if_neg hz, if_neg ho, least_eq]
    let p := d.minFac
    let q := d / p
    have hp : p.Prime := Nat.minFac_prime ho
    have prod : q*p = d := Nat.div_mul_cancel (Nat.minFac_dvd d)
    change (if p ∣ q then 0 else -mu fuel q) = moebius d
    split
    next hd =>
      apply Eq.symm
      apply moebius_eq_zero_of_not_squarefree
      intro sf
      apply Nat.squarefree_iff_prime_squarefree.mp sf p hp
      exact prod ▸ Nat.mul_dvd_mul hd (dvd_refl p)
    next hd =>
      rw [ih, ← prod, isMultiplicative_moebius.map_mul_of_coprime
        (hp.coprime_iff_not_dvd.mpr hd).symm, moebius_apply_prime hp, mul_neg_one]

end Astra247824.Ordinary
namespace Astra247824
open Finset Leaves ArithmeticFunction
def tinyPrime (j : ℕ) : ℕ := (#[2,3,5,7,11,13,17,19] : Array ℕ)[j]!
private def tinyCut (j : ℕ) : ℕ := (#[0,2,3,5,7] : Array ℕ)[j]!

/-- Five packed tables of prefix counts in the common period 210. -/
private def packedWheel (j : ℕ) : ℕ := (#[,
  ,
  ,
  ,
  ] : Array ℕ)[j]!

private def wheelEntry (j r : ℕ) : ℕ := ((packedWheel j) >>> (8*r)) % 256
private def baseWheel (j x : ℕ) : ℕ := (x/210)*wheelEntry j 210 + wheelEntry j (x%210)

private theorem baseWheel_correct {j : ℕ} (hj : j ≤ 4) (x : ℕ) :
    baseWheel j x = phi tinyPrime j x := by
  have roster : ∀ a : Fin 5, (List.range a.val).map tinyPrime =
      (List.range (tinyCut a.val+1)).filter (fun p => decide p.Prime) := by decide +kernel
  have divides : ∀ a : Fin 5, ∀ p ∈ Nat.primesLE (tinyCut a.val), p ∣ 210 := by decide +kernel
  have tab : ∀ a : Fin 5, ∀ r : Fin 211,
      wheelEntry a.val r.val = phi tinyPrime a.val r.val := by decide +kernel
  let a : Fin 5 := ⟨j, by omega⟩
  have rr (u : ℕ) := rough_eq_phi tinyPrime j (tinyCut j) u (roster a)
  have wheel := rough_wheel (divides a) x
  have one : wheelEntry j 210 = phi tinyPrime j 210 := tab a ⟨210, by decide⟩
  have tail : wheelEntry j (x%210) = phi tinyPrime j (x%210) :=
    tab a ⟨x%210,(Nat.mod_lt _ (by decide : 0<210)).trans_le (by decide)⟩
  change rough (tinyCut j) x = x/210*rough (tinyCut j) 210 + rough (tinyCut j) (x%210) at wheel
  rw [rr x, rr 210, rr (x%210)] at wheel
  unfold baseWheel
  rw [one,tail,wheel]

/-- At the remaining small stages, use only a few copies of the length-210 wheel. -/
private def aboveWheel : ℕ → ℕ → ℕ
  | 0 => baseWheel 4
  | r+1 => sieveStep (tinyPrime (4+r)) (aboveWheel r)

private theorem aboveWheel_correct (r : ℕ) : aboveWheel r = phi tinyPrime (4+r) := by
  induction r with
  | zero => funext x; exact baseWheel_correct (by decide) x
  | succ r ih => simp only [aboveWheel, ih, phi]; rfl

def smallRank (j x : ℕ) : ℕ := if j≤4 then baseWheel j x else aboveWheel (j-4) x

theorem smallRank_signed (j : Fin 8) (x : ℕ) :
    (smallRank j.val x : ℤ) = Leaves.signedSieve (Leaves.descendingPrimes (tinyPrime j.val-1)) x := by
  have roster : ∀ a : Fin 8, (List.range a.val).map tinyPrime =
      (List.range ((tinyPrime a.val-1)+1)).filter (fun p => decide p.Prime) := by decide +kernel
  have real : smallRank j.val x = phi tinyPrime j.val x := by
    by_cases h : j.val≤4
    · exact (if_pos h).trans (baseWheel_correct h x)
    · have size : 4+(j.val-4) = j.val := by omega
      simp only [smallRank,if_neg h,aboveWheel_correct,size]
  rw [real, ← rough_eq_phi tinyPrime j.val (tinyPrime j.val-1) x (roster j)]
  simp only [Leaves.signedSieve, Leaves.survivors, Leaves.mem_descending, rough]

open Leaves ArithmeticFunction

def edgeAllowed (x y d p : ℕ) : Prop :=
  p ≤ remainingBound y d ∧ y < d*p ∧ p^2 ≤ x/(d*p)

instance (x y d p : ℕ) : Decidable (edgeAllowed x y d p) := by unfold edgeAllowed; infer_instance

/-- The low-prime part of the hard sum can be enumerated by a rectangle of denominators and primes. -/
theorem hard_small_rectangle (x y z : ℕ) :
    ∑ e ∈ (hardEdges x y).filter (fun e => e.2 ≤ z), edgeValue x e =
      ∑ d ∈ Icc 1 y, ∑ p ∈ Nat.primesLE z, if edgeAllowed x y d p then
        -moebius d * signedSieve (descendingPrimes (p-1)) (x/(d*p)) else 0 := by
  classical
  have indices :
      (hardEdges x y).filter (fun e => e.2 ≤ z) =
      ((Icc 1 y).sigma (fun _ => Nat.primesLE z)).filter
        (fun e => Squarefree e.1 ∧ edgeAllowed x y e.1 e.2) := by
    ext e
    rcases e with ⟨d,p⟩
    constructor
    · intro h
      obtain ⟨hardEdge,limit⟩ := mem_filter.mp h
      obtain ⟨cut,hard⟩ := mem_filter.mp hardEdge
      obtain ⟨edge,cross⟩ := mem_filter.mp cut
      obtain ⟨ds,ps⟩ := mem_sigma.mp edge
      obtain ⟨dr,sq⟩ := mem_filter.mp ds
      obtain ⟨avail,prime⟩ := Nat.mem_primesLE.mp ps
      exact mem_filter.mpr ⟨mem_sigma.mpr ⟨dr,Nat.mem_primesLE.mpr ⟨limit,prime⟩⟩,
        sq,avail,not_le.mp cross,not_lt.mp hard⟩
    · intro h
      obtain ⟨base,sq,avail,cross,hard⟩ := mem_filter.mp h
      obtain ⟨dr,ps⟩ := mem_sigma.mp base
      obtain ⟨limit,prime⟩ := Nat.mem_primesLE.mp ps
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_filter.mpr
        ⟨mem_sigma.mpr ⟨mem_filter.mpr ⟨dr,sq⟩,Nat.mem_primesLE.mpr ⟨avail,prime⟩⟩,
          not_le.mpr cross⟩,not_lt.mpr hard⟩,limit⟩
  rw [indices, sum_filter, sum_sigma]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro p _
  by_cases sq : Squarefree d
  · simp only [sq, true_and, edgeValue]
  · simp only [sq, false_and, if_false, moebius_eq_zero_of_not_squarefree sq, neg_zero,
      zero_mul, ite_self]

private def smallWheel (j : ℕ) : ℕ := (#[2,6,30,210,2310,30030,510510,9699690] : Array ℕ)[j]!

private def tinyDivs (j : ℕ) := [2,3,5,7,11,13,17,19].take (j+1)

private theorem smallWheel_available {d y : ℕ} (hd : 1<d) (j : Fin 8) :
    tinyPrime j.val ≤ remainingBound y d ↔ d.gcd (smallWheel j.val) = 1 := by
  have lib : ∀ a : Fin 8, tinyDivs a.val =
      (List.range (tinyPrime a.val+1)).filter (fun p => decide p.Prime) := by decide +kernel
  have prod : ∀ a : Fin 8, smallWheel a.val = (tinyDivs a.val).prod := by decide +kernel
  have divP (p : ℕ) : p ∈ tinyDivs j.val ↔ p ≤ tinyPrime j.val ∧ p.Prime := by
    rw [lib j]
    simp only [List.mem_filter, List.mem_range, decide_eq_true_eq, Nat.lt_succ_iff]
  have hp : (tinyPrime j.val).Prime := by
    have hh : ∀ a : Fin 8, (tinyPrime a.val).Prime := by decide +kernel
    exact hh j
  have facPrime := Nat.minFac_prime (by omega : d≠1)
  rw [prod j]
  change tinyPrime j.val ≤ remainingBound y d ↔ d.Coprime (tinyDivs j.val).prod
  rw [Nat.coprime_list_prod_right_iff,remainingBound,if_neg (by omega : d≠1)]
  constructor
  · intro lim p mem
    obtain ⟨bound,prime⟩ := (divP p).mp mem
    apply Nat.Coprime.symm
    apply prime.coprime_iff_not_dvd.mpr
    intro dvd
    have lt : p < d.minFac := by have := hp.two_le; omega
    exact lt.not_ge (Nat.minFac_le_of_dvd prime.two_le dvd)
  · intro clean
    have h : tinyPrime j.val < d.minFac := by
      by_contra! lim
      have contradicts := (clean _ ((divP _).mpr ⟨lim,facPrime⟩)).symm
      exact (facPrime.coprime_iff_not_dvd.mp contradicts) (Nat.minFac_dvd d)
    omega

private def tinyPiece (j d : ℕ) : ℕ :=
  let p := tinyPrime j
  if 43399 < d*p ∧ d.gcd (smallWheel j) = 1
  then smallRank j (81744924555066/(d*p)) else 0

private noncomputable def tinyRow (d : ℕ) : ℤ :=
  if d≤2284 ∨ 43399<d then 0 else
  let mu := Ordinary.mu 16 d
  if mu=0 then 0 else
  -mu * ((tinyPiece 0 d + tinyPiece 1 d + tinyPiece 2 d + tinyPiece 3 d +
          tinyPiece 4 d + tinyPiece 5 d + tinyPiece 6 d + tinyPiece 7 d : ℕ) : ℤ)

private theorem sum_eight (f : ℕ → ℕ) :
    ((∑ j : Fin 8, (f j.val : ℤ)) : ℤ) =
      ((f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 + f 7 : ℕ) : ℤ) := by
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, Nat.cast_add]
  push_cast
  norm_num [Fin.val_ofNat, Fin.val_natCast, Fin.val_zero, Fin.val_succ]
  <;> ring

private theorem p19 (j : Fin 8) : tinyPrime j.val ≤ 19 := by
  have h : ∀ i : Fin 8, tinyPrime i.val ≤ 19 := by decide +kernel
  exact h j

private theorem tinyRow_spec {d : ℕ} (inRange : d ∈ Icc 1 43399) :
    (∑ p ∈ Nat.primesLE 19, if edgeAllowed 81744924555066 43399 d p then
        -moebius d * signedSieve (descendingPrimes (p-1)) (81744924555066/(d*p)) else 0) =
      tinyRow d := by
  classical
  obtain ⟨one,lim⟩ := mem_Icc.mp inRange
  by_cases low : d≤2284
  · rw [tinyRow,if_pos (Or.inl low)]
    apply sum_eq_zero
    intro p hp
    have bound := Nat.le_of_mem_primesLE hp
    have prod := Nat.mul_le_mul low bound
    have impossible : ¬ edgeAllowed 81744924555066 43399 d p := by
      intro h
      have cross := h.2.1
      omega
    exact if_neg impossible
  · have idset : Nat.primesLE 19 = (univ : Finset (Fin 8)).image (fun j => tinyPrime j.val) :=
      by decide +kernel
    have inject : ∀ j k : Fin 8, tinyPrime j.val=tinyPrime k.val → j=k := by decide +kernel
    rw [idset, sum_image (fun a _ b _ h => inject a b h)]
    have eq (j : Fin 8) :
        (if edgeAllowed 81744924555066 43399 d (tinyPrime j.val) then
            -moebius d * signedSieve (descendingPrimes (tinyPrime j.val-1))
              (81744924555066/(d*tinyPrime j.val)) else 0) =
          -moebius d * (tinyPiece j.val d : ℤ) := by
      let q := tinyPrime j.val
      have qp : q.Prime := by
        have h : ∀ i : Fin 8, (tinyPrime i.val).Prime := by decide +kernel
        exact h j
      have small := p19 j
      have hard : q^2 ≤ 81744924555066/(d*q) := by
        apply (Nat.le_div_iff_mul_le (Nat.mul_pos one qp.pos)).mpr
        have pBound := Nat.pow_le_pow_left small 2
        exact (Nat.mul_le_mul pBound (Nat.mul_le_mul lim small)).trans (by decide)
      have avail := smallWheel_available (d:=d) (y:=43399) (by omega) j
      have cond : edgeAllowed 81744924555066 43399 d q ↔ 43399<d*q ∧ d.gcd (smallWheel j.val)=1 := by
        constructor
        · exact fun h => ⟨h.2.1,avail.mp h.1⟩
        · exact fun h => ⟨avail.mpr h.2,h.1,hard⟩
      by_cases hit : 43399<d*q ∧ d.gcd (smallWheel j.val)=1
      · have good := cond.mpr hit
        rw [if_pos good]
        have rank := smallRank_signed j (81744924555066/(d*q))
        exact congrArg (fun z : ℤ => -moebius d * z)
          (rank.symm.trans (congrArg Int.ofNat (if_pos hit).symm))
      · have bad := mt cond.mp hit
        rw [if_neg bad]
        simp only [tinyPiece,show ¬ (43399<d*tinyPrime j.val ∧ d.gcd (smallWheel j.val)=1) from hit,
          if_false, Nat.cast_zero, mul_zero]
    calc
      _ = ∑ j : Fin 8, -moebius d * (tinyPiece j.val d : ℤ) := sum_congr rfl (fun j _ => eq j)
      _ = -moebius d * (∑ j : Fin 8, (tinyPiece j.val d : ℤ)) := (mul_sum ..).symm
      _ = _ := by
        rw [sum_eight (fun j => tinyPiece j d),tinyRow,if_neg (by omega),Ordinary.mu_eq]
        dsimp only
        by_cases zero : moebius d=0 <;> simp [zero]

private def tinySum (f : ℕ → ℤ) : ℕ → ℕ → ℤ
  | 0, lo => f lo
  | k+1, lo => tinySum f k lo + tinySum f k (lo+2^k)

private theorem tinySum_eq (f : ℕ → ℤ) (k lo : ℕ) :
    tinySum f k lo = ∑ d ∈ Ico lo (lo+2^k), f d := by
  induction k generalizing lo with
  | zero => simp [tinySum]
  | succ k ih =>
    rw [tinySum, ih, ih, Finset.sum_Ico_consecutive f (Nat.le_add_right lo _)
      (Nat.le_add_right (lo+2^k) _)]
    congr 2
    rw [pow_succ]
    omega

private theorem tiny_join {f : ℕ → ℤ} {k lo : ℕ} {a b : ℤ}
    (left : tinySum f k lo = a) (right : tinySum f k (lo+2^k) = b) :
    tinySum f (k+1) lo = a+b := congrArg₂ (·+·) left right

/-- All hard queries whose first unsieved prime is at most 19, as a genuine sub-sum. -/
