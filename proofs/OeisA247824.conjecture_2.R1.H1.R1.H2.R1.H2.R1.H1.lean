/-- The sum of all hard leaves with first unsieved prime 23. -/
theorem hard_stage23 :
    ∑ e ∈ (hardEdges 81744924555066 43399).filter (fun e => e.2=23),
      edgeValue 81744924555066 e = 109842275301 := publish _ c_16_0

