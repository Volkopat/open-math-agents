private theorem low23 (E : Finset Edge) (v : Edge → ℤ) (prime : ∀ e ∈ E, Nat.Prime e.2) :
    (∑ e ∈ E.filter (fun e => e.2≤19), v e) + (∑ e ∈ E.filter (fun e => e.2=23), v e) =
      ∑ e ∈ E.filter (fun e => e.2≤23), v e := by
  let S := E.filter (fun e => e.2≤23)
  have left : S.filter (fun e => e.2≤19) = E.filter (fun e => e.2≤19) := by
    ext e
    simp only [S,mem_filter]
    constructor
    · exact fun ⟨⟨he,_⟩,h⟩ => ⟨he,h⟩
    · exact fun ⟨he,h⟩ => ⟨⟨he,by omega⟩,h⟩
  have right : S.filter (fun e => ¬e.2≤19) = E.filter (fun e => e.2=23) := by
    ext e
    simp only [S,mem_filter,not_le]
    constructor
    · rintro ⟨⟨he,up⟩,above⟩
      have skip : ∀ i : Fin 24, (19 < i.val) → Nat.Prime i.val → i.val = 23 := by decide +kernel
      exact ⟨he,skip ⟨e.2,by omega⟩ above (prime e he)⟩
    · rintro ⟨he,h⟩
      exact ⟨⟨he,by omega⟩,by omega⟩
  have eq := sum_filter_add_sum_filter_not S (fun e => e.2≤19) v
  rw [left,right] at eq
  exact eq

private theorem hardPrime {x y : ℕ} {e : Edge} (h : e ∈ hardEdges x y) : e.2.Prime :=
  Nat.prime_of_mem_primesLE (mem_sigma.mp (mem_filter.mp (mem_filter.mp h).1).1).2

theorem first_nine :
    ∑ e ∈ (hardEdges 81744924555066 43399).filter (fun e => e.2≤23),
      edgeValue 81744924555066 e = 692145566297 := by
  have eq := low23 _ (edgeValue 81744924555066) (fun _ h => hardPrime (x:=81744924555066) (y:=43399) h)
  exact eq.symm.trans (congrArg₂ (·+·) hard_small_total Stage23.hard_stage23)

private theorem convert_to_card (x y z : ℕ) (value : ℤ)
    (proved : ∑ e ∈ (hardEdges x y).filter (fun e => e.2≤z), edgeValue x e = value) :
    let S := ((special y).filter (fun e => e.2^2≤x/(e.1*e.2))).filter (fun e => e.2≤z)
    ∑ e ∈ S, -moebius e.1 *
      (((Icc 1 (x/(e.1*e.2))).filter (fun n =>
        (descendingPrimes (e.2-1)).all (fun q => decide (¬q ∣ n)))).card : ℤ) = value := by
  dsimp only
  have idx : ((special y).filter (fun e => e.2^2≤x/(e.1*e.2))).filter (fun e => e.2≤z) =
      (hardEdges x y).filter (fun e => e.2≤z) := by
    ext e
    simp only [hardEdges,mem_filter,not_lt]
  rw [idx]
  refine Eq.trans (sum_congr rfl (fun e _ => ?_)) proved
  unfold edgeValue signedSieve survivors
  apply congrArg (fun s : Finset ℕ => -moebius e.1 * (s.card : ℤ))
  ext n
  simp only [mem_filter,List.all_eq_true,decide_eq_true_eq]
  
