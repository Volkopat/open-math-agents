/-- Isolating one fixed prime removes the sigma index. Vanishing Möbius values account for nonsquarefree denominators. -/
theorem single_rectangle (x y p : ℕ) (pp : p.Prime) :
    ∑ e ∈ (hardEdges x y).filter (fun e => e.2=p), edgeValue x e =
      ∑ d ∈ Icc 1 y, if edgeAllowed x y d p then
        -moebius d * signedSieve (descendingPrimes (p-1)) (x/(d*p)) else 0 := by
  classical
  let Q := (Icc 1 y).filter (fun d => Squarefree d ∧ edgeAllowed x y d p)
  have idx : (hardEdges x y).filter (fun e => e.2=p) = Q.image (fun d => (⟨d,p⟩ : Edge)) := by
    ext e
    obtain ⟨d,q⟩ := e
    constructor
    · intro h
      obtain ⟨he,rfl⟩ := mem_filter.mp h
      obtain ⟨sp,hard⟩ := mem_filter.mp he
      obtain ⟨origin,cross⟩ := mem_filter.mp sp
      obtain ⟨den,allowed⟩ := mem_sigma.mp origin
      obtain ⟨inside,sq⟩ := mem_filter.mp den
      exact mem_image.mpr ⟨d,mem_filter.mpr ⟨inside,sq,Nat.le_of_mem_primesLE allowed,
        not_le.mp cross, not_lt.mp hard⟩,rfl⟩
    · intro h
      obtain ⟨n,mem,eq⟩ := mem_image.mp h
      obtain rfl : n=d := congrArg Sigma.fst eq
      obtain rfl : p=q := congrArg (fun e : Edge => e.2) eq
      obtain ⟨inside,sq,allow,cross,hard⟩ := mem_filter.mp mem
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_filter.mpr ⟨mem_sigma.mpr
        ⟨mem_filter.mpr ⟨inside,sq⟩,Nat.mem_primesLE.mpr ⟨allow,pp⟩⟩,not_le.mpr cross⟩,
        not_lt.mpr hard⟩,rfl⟩
  rw [idx, sum_image (fun a _ b _ h => congrArg Sigma.fst h)]
  dsimp only [Q]
  rw [sum_filter]
  apply sum_congr rfl
  intro d _
  by_cases hs : Squarefree d
  · simp only [hs,true_and,edgeValue]
  · simp only [hs,false_and,moebius_eq_zero_of_not_squarefree hs,edgeValue,neg_zero,zero_mul,ite_self]

private def rank23 (t : ℕ) : ℤ := (smallRank 7 t : ℤ) - smallRank 7 (t/19)

private theorem rank23_spec (t : ℕ) : rank23 t = signedSieve (descendingPrimes 22) t := by
  have old (u : ℕ) : (smallRank 7 u : ℤ) = signedSieve (descendingPrimes 18) u := smallRank_signed 7 u
  have roster : descendingPrimes 22 = 19 :: descendingPrimes 18 := by decide
  have other : ∀ q ∈ descendingPrimes 18, q.Prime ∧ q ≠ 19 := by decide
  rw [rank23, old,old,roster,signedSieve_cons (by decide) other]

private theorem wheel_available {d : ℕ} (hd : 1 < d) :
    23 ≤ remainingBound 43399 d ↔ d.gcd 223092870=1 := by
  let ps : List ℕ := [2,3,5,7,11,13,17,19,23]
  have prod : 223092870 = ps.prod := by decide
  have roster : ps=(List.range 24).filter (fun p => decide p.Prime) := by decide
  have divP (p : ℕ) : p ∈ ps ↔ p ≤ 23 ∧ p.Prime := by
    rw [roster]
    simp only [List.mem_filter, List.mem_range, decide_eq_true_eq,Nat.lt_succ_iff]
  have fac := Nat.minFac_prime (by omega : d≠1)
  rw [prod]
  change 23 ≤ remainingBound 43399 d ↔ d.Coprime ps.prod
  rw [Nat.coprime_list_prod_right_iff, remainingBound,if_neg (by omega : d≠1)]
  constructor
  · intro bound p mem
    obtain ⟨lim,prime⟩ := (divP p).mp mem
    exact (prime.coprime_iff_not_dvd.mpr (fun dvd =>
      ((by omega : p<d.minFac).not_ge (Nat.minFac_le_of_dvd prime.two_le dvd)))).symm
  · intro clean
    have loc : 23 < d.minFac := by
      by_contra! lim
      have c := (clean _ ((divP _).mpr ⟨lim,fac⟩)).symm
      exact (fac.coprime_iff_not_dvd.mp c) (Nat.minFac_dvd d)
    omega

private noncomputable def row (d : ℕ) : ℤ :=
  if 1886<d ∧ d≤43399 ∧ d.gcd 223092870=1 then
    -Ordinary.mu 16 d * rank23 (81744924555066/(d*23)) else 0

private theorem row_spec {d : ℕ} (h : d ∈ Icc 1 43399) :
    (if edgeAllowed 81744924555066 43399 d 23 then
        -moebius d * signedSieve (descendingPrimes (23-1)) (81744924555066/(d*23)) else 0) = row d := by
  obtain ⟨lower,upper⟩ := mem_Icc.mp h
  have hard : 23^2 ≤ 81744924555066/(d*23) := by
    apply (Nat.le_div_iff_mul_le (Nat.mul_pos lower (by decide))).mpr
    exact (Nat.mul_le_mul_left (23^2) (Nat.mul_le_mul_right 23 upper)).trans (by decide)
  have cond : edgeAllowed 81744924555066 43399 d 23 ↔ 1886<d ∧ d≤43399 ∧ d.gcd 223092870=1 := by
    constructor
    · intro he
      have cross := he.2.1
      exact ⟨by omega,upper,(wheel_available (by omega)).mp he.1⟩
    · rintro ⟨hd,_,clean⟩
      exact ⟨(wheel_available (by omega)).mpr clean,by omega,hard⟩
  unfold row
  simp only [← cond, Ordinary.mu_eq, rank23_spec]
private def tree (f : ℕ → ℤ) : ℕ → ℕ → ℤ
  | 0, lo => f lo
  | k+1, lo => tree f k lo + tree f k (lo+2^k)

private theorem tree_eq (f : ℕ → ℤ) (k lo : ℕ) :
    tree f k lo = ∑ d ∈ Ico lo (lo+2^k), f d := by
  induction k generalizing lo with
  | zero => simp [tree]
  | succ k ih =>
    rw [tree, ih, ih, Finset.sum_Ico_consecutive f (Nat.le_add_right lo _)
      (Nat.le_add_right (lo+2^k) _)]
    congr 2
    rw [pow_succ]
    omega

private theorem join {f : ℕ → ℤ} {k lo : ℕ} {a b : ℤ}
    (left : tree f k lo = a) (right : tree f k (lo+2^k) = b) :
    tree f (k+1) lo = a+b := congrArg₂ (·+·) left right


private theorem publish (v : ℤ) (check : tree row 16 0=v) :
    ∑ e ∈ (hardEdges 81744924555066 43399).filter (fun e => e.2=23),
      edgeValue 81744924555066 e = v := by
  rw [single_rectangle _ _ _ (by decide : Nat.Prime 23)]
  have rows := sum_congr rfl (fun d hd => row_spec (d:=d) hd)
  have subset : Icc 1 43399 ⊆ Ico 0 (0+2^16) := by
    intro d hd
    obtain ⟨_,upper⟩ := mem_Icc.mp hd
    exact mem_Ico.mpr ⟨Nat.zero_le _,by omega⟩
  have expand := Finset.sum_subset (f:=row) subset (by
    intro d _ out
    have bad : ¬ (1886<d ∧ d≤43399 ∧ d.gcd 223092870=1) := by
      rintro ⟨lo,hi,_⟩
      exact out (mem_Icc.mpr ⟨by omega,hi⟩)
    exact if_neg bad)
  exact rows.trans (expand.trans ((tree_eq row 16 0).symm.trans check))


