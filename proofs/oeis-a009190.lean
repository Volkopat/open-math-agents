namespace PeakCover

private theorem fold_hits (l : List Nat) (t a : Nat) (h : a.testBit t = true ∨ t ∈ l) :
    (l.foldl (fun n i => n ||| (1 <<< i)) a).testBit t = true := by
  induction l generalizing a with
  | nil => simpa using h
  | cons i l ih =>
    apply ih
    rcases h with ha | hin
    · exact Or.inl (by simp [Nat.testBit_or, ha])
    · rcases List.mem_cons.mp hin with rfl | ht
      · exact Or.inl (by simp)
      · exact Or.inr ht

theorem mask_hits {p q t r : Nat} (ht : t ∈ offsets p) (heq : t%q = r) :
    (mask p q r).testBit t = true := by
  apply fold_hits
  exact Or.inr (List.mem_filter.mpr ⟨ht, by simpa using heq⟩)

theorem covers_of_residues {p : Nat} (qs : List Nat) (r : Nat → Nat) (s : List Nat)
    (hs : ∀ t ∈ s, t ∈ offsets p)
    (legal : ∀ q ∈ qs, r q < q ∧ r q ≠ 0 ∧ r q ≠ p%q)
    (hit : ∀ t ∈ s, ∃ q ∈ qs, t%q = r q) :
    Covers (rows p qs) s := by
  induction qs generalizing s with
  | nil =>
    change s = []
    cases s with
    | nil => rfl
    | cons t s =>
      obtain ⟨q,hq,_⟩ := hit t (List.mem_cons_self ..)
      exact False.elim (List.not_mem_nil hq)
  | cons q qs ih =>
    change ∃ m ∈ row p q, Covers (rows p qs) (remaining s m)
    obtain ⟨hr,hn,hp⟩ := legal q (List.mem_cons_self ..)
    have hmask : mask p q (r q) ∈ row p q := by
      apply List.mem_map.mpr
      exact ⟨r q, List.mem_filter.mpr ⟨List.mem_range.mpr hr, by simp [hn,hp]⟩,rfl⟩
    refine ⟨_,hmask,ih _ ?_ (fun v hv => legal _ (List.mem_cons_of_mem q hv)) ?_⟩
    · intro t ht
      exact hs t (List.mem_filter.mp ht).1
    · intro t ht
      obtain ⟨ht',hmiss⟩ := List.mem_filter.mp ht
      obtain ⟨v,hv,heq⟩ := hit t ht'
      rcases List.mem_cons.mp hv with rfl | hv
      · have hh := mask_hits (hs t ht') heq
        simp [hh] at hmiss
      · exact ⟨v,hv,heq⟩

end PeakCover

namespace PeakCover

private theorem offset_bounds {p t : Nat} (h : t ∈ offsets p) : 0 < t ∧ t < p := by
  simp only [offsets, List.range_eq_range', List.drop_range', Nat.mul_one, Nat.zero_add] at h
  obtain ⟨i,hi,e⟩ := List.mem_range'.mp h
  simp only [Nat.one_mul] at e
  omega

theorem residue_for_prime {x p q : Nat} (hq : q.Prime) (hq2 : 2 < q) (hqp : q < p)
    (hx : x.minFac = p) (hx' : (x + 2*p).minFac = p) :
    ∃ r, r < q ∧ r ≠ 0 ∧ r ≠ p%q ∧ ∀ t, q ∣ x + 2*t → t%q = r := by
  by_cases h : ∃ t, q ∣ x+2*t
  · obtain ⟨a,ha⟩ := h
    have ha0 := Nat.modEq_zero_iff_dvd.mpr ha
    have hend (b : Nat) (hab : a ≡ b [MOD q]) : q ∣ x+2*b := by
      exact Nat.modEq_zero_iff_dvd.mp (((hab.mul_left 2).add_left x).symm.trans ha0)
    refine ⟨a%q,Nat.mod_lt _ (by omega),?_,?_,?_⟩
    · intro hn
      have hr : a ≡ 0 [MOD q] := by simpa only [Nat.ModEq, Nat.zero_mod] using hn
      have hd : q ∣ x := by simpa using hend 0 hr
      have := Nat.minFac_le_of_dvd hq.two_le hd
      omega
    · intro hn
      have := Nat.minFac_le_of_dvd hq.two_le (hend p hn)
      omega
    · intro t ht
      have hxt := (Nat.modEq_zero_iff_dvd.mpr ht).trans ha0.symm
      have ht' := Nat.ModEq.add_left_cancel' x hxt
      exact Nat.ModEq.cancel_left_of_coprime ((Nat.coprime_primes hq Nat.prime_two).mpr (by omega)) ht'
  · refine ⟨if p%q = 1 then 2 else 1,?_,?_,?_,?_⟩
    · split <;> omega
    · split <;> omega
    · split <;> omega
    · intro t ht
      exact False.elim (h ⟨t,ht⟩)

theorem covers_of_peak {p x : Nat} (qs : List Nat) (hp : 2 < p)
    (qset : ∀ q, q ∈ qs ↔ q.Prime ∧ 2 < q ∧ q < p)
    (hx : 2 ≤ x) (hstart : x.minFac = p) (hend : (x + 2*p).minFac = p)
    (hint : ∀ y, x < y → y < x+2*p → y.minFac < p) :
    Covers (rows p qs) (offsets p) := by
  classical
  have pick (q : Nat) : ∃ r, q ∈ qs →
        r < q ∧ r ≠ 0 ∧ r ≠ p%q ∧ ∀ t, q ∣ x+2*t → t%q = r := by
    by_cases h : q ∈ qs
    · obtain ⟨hq,ht,hl⟩ := (qset q).mp h
      obtain ⟨r,hr⟩ := residue_for_prime hq ht hl hstart hend
      exact ⟨r, fun _ => hr⟩
    · exact ⟨0, fun hq => (h hq).elim⟩
  let r (q : Nat) := Classical.choose (pick q)
  have spec (q : Nat) := Classical.choose_spec (pick q)
  apply covers_of_residues qs r _ (fun _ h => h)
  · intro q hq
    exact ⟨(spec q hq).1,(spec q hq).2.1,(spec q hq).2.2.1⟩
  · intro t ht
    obtain ⟨ht0,htp⟩ := offset_bounds ht
    let q := (x+2*t).minFac
    have hq : q.Prime := Nat.minFac_prime (by omega)
    have hd : q ∣ x+2*t := Nat.minFac_dvd _
    have hq2 : 2 < q := by
      have h2 := hq.two_le
      by_contra! hsmall
      have he : q = 2 := by omega
      rw [he] at hd
      have hdx : 2 ∣ x := (Nat.dvd_add_iff_left (Nat.dvd_mul_right 2 t)).mpr hd
      have := Nat.minFac_le_of_dvd (by decide : 2 ≤ 2) hdx
      omega
    have hl : q < p := hint _ (by omega) (by omega)
    have hmem := (qset q).mpr ⟨hq,hq2,hl⟩
    exact ⟨q,hmem,(spec q hmem).2.2.2 t hd⟩

end PeakCover

namespace OMA.S_oeis_a009190

/-- The six candidate primes use the one-based indices in the OEIS entry. -/
theorem peak_prime_indices (n : ℕ) (hlo : 14 ≤ n) (hhi : n ≤ 19) :
    let p := Nat.nth Nat.Prime (n - 1)
    p = 43 ∨ p = 47 ∨ p = 53 ∨ p = 59 ∨ p = 61 ∨ p = 67 := by
  have h : n = 14 ∨ n = 15 ∨ n = 16 ∨ n = 17 ∨ n = 18 ∨ n = 19 := by omega
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl
  · exact .inl (Nat.nth_count (by decide : Nat.Prime 43))
  · exact .inr (.inl (Nat.nth_count (by decide : Nat.Prime 47)))
  · exact .inr (.inr (.inl (Nat.nth_count (by decide : Nat.Prime 53))))
  · exact .inr (.inr (.inr (.inl (Nat.nth_count (by decide : Nat.Prime 59)))))
  · exact .inr (.inr (.inr (.inr (.inl (Nat.nth_count (by decide : Nat.Prime 61))))))
  · exact .inr (.inr (.inr (.inr (.inr (Nat.nth_count (by decide : Nat.Prime 67))))))

end OMA.S_oeis_a009190

namespace PeakCover

private theorem no_peaks {p : ℕ} {qs : List ℕ}
    (obstruction : ¬ Covers (rows p qs) (offsets p)) (hp : 2 < p)
    (small : ∀ i : Fin p, i.val ∈ qs ↔ i.val.Prime ∧ 2 < i.val)
    (bounded : qs.all (fun q => decide (q < p)) = true) :
    ∀ x : ℕ, ¬ OMA.S_oeis_a009190.IsTwinPeak p x := by
  have primes (q : ℕ) : q ∈ qs ↔ q.Prime ∧ 2 < q ∧ q < p := by
    constructor
    · intro h
      have lt : q < p := of_decide_eq_true (List.all_eq_true.mp bounded q h)
      have hq := (small ⟨q,lt⟩).mp h
      exact ⟨hq.1,hq.2,lt⟩
    · rintro ⟨prime,odd,lt⟩
      exact (small ⟨q,lt⟩).mpr ⟨prime,odd⟩
  rintro x ⟨hx,ha,hb,hm⟩
  exact obstruction (covers_of_peak qs hp primes hx ha hb hm)

end PeakCover

theorem OMA.solution : type_of% @OMA.S_oeis_a009190.main := by
  intro n hlo hhi
  rcases OMA.S_oeis_a009190.peak_prime_indices n hlo hhi with hp | hp | hp | hp | hp | hp <;> rw [hp]
  · exact PeakCover.no_peaks PeakCover.no_cover_43 (by decide) (by decide) (by decide)
  · exact PeakCover.no_peaks PeakCover.no_cover_47 (by decide) (by decide) (by decide)
  · exact PeakCover.no_peaks PeakCover.no_cover_53 (by decide) (by decide) (by decide)
  · exact PeakCover.no_peaks PeakCover.no_cover_59 (by decide) (by decide) (by decide)
  · exact PeakCover.no_peaks PeakCover.no_cover_61 (by decide) (by decide) (by decide)
  · exact PeakCover.no_peaks PeakCover.no_cover_67 (by decide) (by decide) (by decide)
