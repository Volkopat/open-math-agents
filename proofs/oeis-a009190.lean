import OMAStatements.S_oeis_a009190
import Mathlib.Data.Nat.ModEq
import Mathlib.Data.Nat.Prime.Basic
import Mathlib.Data.Nat.Prime.Nth

/-!
# No twin peaks at prime indices 14 through 19

A twin peak would cover every offset t = 1,...,p−1 using one congruence
class for each odd prime q < p. The classes giving a factor of either endpoint
are unavailable. Each certificate branches on an admissible class or assigns
weights to offsets for which the sum of the remaining row maxima is too small.
The kernel checks both the masks and all leaves of the six certificates.

OEIS A009190, https://oeis.org/A009190. Credit: @hiattco
-/

namespace PeakCover

abbrev Row := List Nat
abbrev Rows := List Row

def remaining (s : List Nat) (mask : Nat) : List Nat :=
  s.filter fun i => !(mask.testBit i)

def Covers : Rows → List Nat → Prop
  | [], s => s = []
  | row :: rows, s => ∃ m ∈ row, Covers rows (remaining s m)

def offsets (p : Nat) : List Nat := (List.range p).drop 1

def mask (p q r : Nat) : Nat :=
  ((offsets p).filter (fun t => t % q == r)).foldl (fun a i => a ||| (1 <<< i)) 0

def row (p q : Nat) : Row :=
  ((List.range q).filter (fun r => r != 0 && r != p % q)).map (mask p q)

def rows (p : Nat) (qs : List Nat) := qs.map (row p)



abbrev Weights := List (Nat × Nat)

def weight : Weights → Nat
  | [] => 0
  | x :: xs => x.2 + weight xs

def weightHit (w : Weights) (m : Nat) : Nat :=
  weight (w.filter fun x => m.testBit x.1)

def weightMax (w : Weights) : Row → Nat
  | [] => 0
  | m :: ms => max (weightHit w m) (weightMax w ms)

def weightBudget (w : Weights) : Rows → Nat
  | [] => 0
  | ms :: rows => weightMax w ms + weightBudget w rows

theorem weight_mono {v w : Weights} (h : v.Sublist w) : weight v ≤ weight w := by
  induction h with
  | slnil => exact Nat.le_refl _
  | cons a h ih => simp only [weight]; omega
  | cons_cons a h ih => exact Nat.add_le_add_left ih _

private theorem weightMax_mono {v w : Weights} (h : v.Sublist w) (ms : Row) :
    weightMax v ms ≤ weightMax w ms := by
  induction ms with
  | nil => exact Nat.le_refl _
  | cons m ms ih =>
    have hh : weightHit v m ≤ weightHit w m := weight_mono (h.filter _)
    simp only [weightMax]; omega

private theorem weightBudget_mono {v w : Weights} (h : v.Sublist w) (rows : Rows) :
    weightBudget v rows ≤ weightBudget w rows := by
  induction rows with
  | nil => exact Nat.le_refl _
  | cons ms rows ih => exact Nat.add_le_add (weightMax_mono h ms) ih

private theorem weight_le_max (w : Weights) {m : Nat} {ms : Row} (hm : m ∈ ms) :
    weightHit w m ≤ weightMax w ms := by
  induction ms with
  | nil => simp at hm
  | cons a ms ih =>
    rcases List.mem_cons.mp hm with rfl | hm
    · exact Nat.le_max_left ..
    · exact Nat.le_trans (ih hm) (Nat.le_max_right ..)

private theorem weight_split (w : Weights) (m : Nat) :
    weight w = weightHit w m + weight (w.filter fun x => !(m.testBit x.1)) := by
  induction w with
  | nil => rfl
  | cons a w ih =>
    cases ha : m.testBit a.1 <;> simp [weight, weightHit, ha] at ih ⊢ <;> omega

/-- Every chosen mask contributes at most the heaviest admissible mask in its row. -/
theorem weighted_cover_le {rows : Rows} {s : List Nat} {w : Weights} (h : Covers rows s)
    (hw : ∀ x ∈ w, x.1 ∈ s) : weight w ≤ weightBudget w rows := by
  induction rows generalizing s w with
  | nil =>
    change s = [] at h
    cases w with
    | nil => exact Nat.le_refl _
    | cons x xs => simpa [h] using hw x (by simp)
  | cons ms rows ih =>
    obtain ⟨m, hm, tail⟩ := h
    let v := w.filter fun x => !(m.testBit x.1)
    have hv : ∀ x ∈ v, x.1 ∈ remaining s m := by
      intro x hx
      obtain ⟨hxw, hxoff⟩ := List.mem_filter.mp hx
      exact List.mem_filter.mpr ⟨hw x hxw, hxoff⟩
    have hrest := Nat.le_trans (ih tail hv) (weightBudget_mono (v := v) (w := w) List.filter_sublist rows)
    rw [weight_split w m]
    exact Nat.add_le_add (weight_le_max w hm) hrest

/-- A leaf lists nonnegative integer weights on uncovered offsets. At a branch,
the children follow the admissible residue classes in the order of the current row. -/
inductive Cert
  | leaf (w : Weights)
  | branch (children : List Cert)

def verified : Rows → List Nat → Cert → Bool
  | rows, s, .leaf w => (w.all fun x => s.contains x.1) && (weightBudget w rows < weight w)
  | [], _, .branch _ => false
  | ms :: rows, s, .branch cs => ms.all fun m =>
      verified rows (remaining s m) (cs.getD (ms.idxOf m) (.leaf []))

theorem excludes {rows : Rows} {s : List Nat} {c : Cert} (hv : verified rows s c = true) :
    ¬ Covers rows s := by
  intro hc
  induction rows generalizing s c with
  | nil =>
    cases c with
    | leaf w =>
      obtain ⟨hs, hb⟩ := Bool.and_eq_true_iff.mp hv
      have hw : ∀ x ∈ w, x.1 ∈ s := by simpa using hs
      have := weighted_cover_le hc hw
      exact Nat.not_lt.mpr this (of_decide_eq_true hb)
    | branch cs => simp [verified] at hv
  | cons ms rows ih =>
    cases c with
    | leaf w =>
      obtain ⟨hs, hb⟩ := Bool.and_eq_true_iff.mp hv
      have hw : ∀ x ∈ w, x.1 ∈ s := by simpa using hs
      have := weighted_cover_le hc hw
      exact Nat.not_lt.mpr this (of_decide_eq_true hb)
    | branch cs =>
      obtain ⟨m, hm, tail⟩ := hc
      exact ih (List.all_eq_true.mp hv m hm) tail



