-- Step OeisA55487.conjecture.R1.H1.R1.H1: hypothesis H1 of reduction OeisA55487.conjecture.R1.H1.R1
-- Credit: @JamesSlash
-- For each 100 < n <= 240 an explicit split n! = x * y with x + 1 and y + 1 prime.
-- Primality: Mathlib's lucas_primality with an explicit primitive root; the modular powers are
-- computed by the fuel-bounded square-and-multiply function pm and checked by the kernel.

namespace P25A55487

/-- Square-and-multiply modular power with fuel. -/
def pm (m : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 1 % m
  | f + 1, b, e =>
    if e = 0 then 1 % m
    else if e % 2 = 1 then b * pm m f (b * b % m) (e / 2) % m
    else pm m f (b * b % m) (e / 2)

theorem pm_spec (m : ℕ) : ∀ f b e : ℕ, e < 2 ^ f → pm m f b e = b ^ e % m
  | 0, b, e, h => by
    have he : e = 0 := by simpa using h
    subst he
    simp [pm]
  | f + 1, b, e, h => by
    rw [pm]
    by_cases he : e = 0
    · subst he
      simp
    · have hp := pow_succ 2 f
      have h2 : e / 2 < 2 ^ f := by omega
      have key : (b * b % m) ^ (e / 2) % m = (b * b) ^ (e / 2) % m := (Nat.pow_mod _ _ _).symm
      rw [if_neg he, pm_spec m f _ _ h2, key]
      by_cases ho : e % 2 = 1
      · rw [if_pos ho]
        have hb : b ^ e = b * (b * b) ^ (e / 2) := by
          have h3 : e = 2 * (e / 2) + 1 := by omega
          conv_lhs => rw [h3]
          rw [pow_succ, pow_mul, sq, mul_comm]
        rw [hb, Nat.mul_mod_mod]
      · rw [if_neg ho]
        have hb : b ^ e = (b * b) ^ (e / 2) := by
          have h3 : e = 2 * (e / 2) := by omega
          conv_lhs => rw [h3]
          rw [pow_mul, sq]
        rw [hb]

/-- A Boolean test passed by every prime. -/
def isP (q : ℕ) : Bool :=
  decide (2 ≤ q) && (List.range q).all (fun d => decide (d < 2) || decide (q % d ≠ 0))

theorem isP_of_prime {q : ℕ} (hq : q.Prime) : isP q = true := by
  rw [isP, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
  refine ⟨hq.two_le, ?_⟩
  intro d hd
  rw [List.mem_range] at hd
  by_cases h2 : d < 2
  · simp [h2]
  · have hnd : ¬ d ∣ q := by
      intro hdvd
      rcases (Nat.dvd_prime hq).1 hdvd with h | h <;> omega
    have : q % d ≠ 0 := fun h => hnd (Nat.dvd_of_mod_eq_zero h)
    simp [this]

/-- Lucas certificate for `x + 1`, where every prime factor of `x` is at most `n`. -/
def luc (n x a : ℕ) : Bool :=
  decide (pm (x + 1) 1600 a x = 1) &&
  (List.range (n + 1)).all (fun q =>
    decide (x % q ≠ 0) || !(isP q) || decide (pm (x + 1) 1600 a (x / q) ≠ 1))

theorem luc_sound (n x a : ℕ) (hx : x ∣ n.factorial) (h0 : 0 < x) (hlt : x < 2 ^ 1600)
    (h : luc n x a = true) : (x + 1).Prime := by
  rw [luc, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  have e1 : 1 % (x + 1) = 1 := Nat.mod_eq_of_lt (by omega)
  apply lucas_primality (x + 1) (a : ZMod (x + 1))
  · rw [Nat.add_sub_cancel]
    rw [pm_spec _ _ _ _ hlt] at h1
    have h3 := (ZMod.natCast_eq_natCast_iff' (a ^ x) 1 (x + 1)).2 (by rw [h1, e1])
    simpa using h3
  · intro q hq hdvd
    rw [Nat.add_sub_cancel] at hdvd ⊢
    have hqn : q ≤ n := (hq.dvd_factorial).1 (hdvd.trans hx)
    have h4 := h2 q (List.mem_range.2 (by omega))
    have h5 : x % q = 0 := Nat.mod_eq_zero_of_dvd hdvd
    have h6 : x / q < 2 ^ 1600 := lt_of_le_of_lt (Nat.div_le_self _ _) hlt
    simp only [h5, isP_of_prime hq, ne_eq, not_true_eq_false, decide_false, Bool.not_true,
      Bool.or_self, Bool.false_or, decide_eq_true_eq] at h4
    rw [pm_spec _ _ _ _ h6] at h4
    intro hc
    apply h4
    have h7 := (ZMod.natCast_eq_natCast_iff' (a ^ (x / q)) 1 (x + 1)).1 (by simpa using hc)
    rw [h7, e1]

/-- The whole certificate for one `n`. -/
def chk (n x y a b : ℕ) : Bool :=
  decide (n.factorial = x * y) && decide (0 < x) && decide (0 < y) &&
  decide (x < 2 ^ 1600) && decide (y < 2 ^ 1600) &&
  decide ((x + y + 1) ^ 3 ≤ n.factorial ^ 2) && luc n x a && luc n y b

theorem chk_sound (n x y a b : ℕ) (h : chk n x y a b = true) :
    ∃ x y : ℕ, n.factorial = x * y ∧ (x + 1).Prime ∧ (y + 1).Prime ∧
      (x + y + 1) ^ 3 ≤ n.factorial ^ 2 := by
  simp only [chk, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hf, hx0⟩, hy0⟩, hxl⟩, hyl⟩, hc⟩, hlx⟩, hly⟩ := h
  exact ⟨x, y, hf, luc_sound n x a (Dvd.intro _ hf.symm) hx0 hxl hlx,
    luc_sound n y b (Dvd.intro_left _ hf.symm) hy0 hyl hly, hc⟩

end P25A55487

