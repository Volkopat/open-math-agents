lemma sum_blockList_len :
    ((List.range 27).map (fun a =>
      ((List.range 20).map (fun b => (blockList (20 * a + b)).length)).sum)).sum = 3428 := by
  decide

lemma primeCounting_31957_le : Nat.primeCounting 31957 ≤ 3428 := by
  rw [← Nat.primesLE_card_eq_primeCounting]
  let U : Finset (ℕ × ℕ) :=
    (Finset.range 540).biUnion (fun i => (blockList i).toFinset.image (fun j => (i, j)))
  have hcard1 : (Nat.primesLE 31957).card ≤ U.card := by
    refine Finset.card_le_card_of_injOn (fun p => (p / 60, p % 60)) ?_ ?_
    · intro p hp
      simp only [Finset.mem_coe, Nat.mem_primesLE] at hp
      have hs : sievePred p = true := (sievePred_iff p).mpr hp
      have hdiv : 60 * (p / 60) + p % 60 = p := Nat.div_add_mod p 60
      simp only [U, blockList, Finset.mem_coe, Finset.mem_biUnion, Finset.mem_range,
        Finset.mem_image, List.mem_toFinset, List.mem_filter]
      refine ⟨p / 60, by omega, p % 60, ⟨List.mem_range.mpr (Nat.mod_lt p (by omega)), ?_⟩, rfl⟩
      rwa [hdiv]
    · intro a _ b _ hab
      have h1 : a / 60 = b / 60 := congrArg Prod.fst hab
      have h2 : a % 60 = b % 60 := congrArg Prod.snd hab
      have ha := Nat.div_add_mod a 60
      have hb := Nat.div_add_mod b 60
      omega
  have hcard2 : U.card ≤ ∑ i ∈ Finset.range 540, (blockList i).length := by
    refine Finset.card_biUnion_le.trans (Finset.sum_le_sum fun i _ => ?_)
    exact Finset.card_image_le.trans (List.toFinset_card_le _)
  have hsum2 : (∑ i ∈ Finset.range 540, (blockList i).length) =
      ((List.range 27).map (fun a =>
        ((List.range 20).map (fun b => (blockList (20 * a + b)).length)).sum)).sum := by
    have hsplit : ∀ n : ℕ, (∑ i ∈ Finset.range (20 * n), (blockList i).length) =
        ((List.range n).map (fun a =>
          ((List.range 20).map (fun b => (blockList (20 * a + b)).length)).sum)).sum := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Nat.mul_succ, Finset.sum_range_add, ih,
          show List.range (n + 1) = List.range n ++ [n] from List.range_succ,
          List.map_append, List.sum_append, List.map_singleton, List.sum_singleton]
        rfl
    exact hsplit 27
  linarith [hcard1, hcard2, hsum2, sum_blockList_len]

def prodVal : List (ℕ × ℕ) → ℕ
  | [] => 1
  | (p, e) :: rest => p ^ e * prodVal rest

def phiVal : List (ℕ × ℕ) → ℕ
  | [] => 1
  | (p, e) :: rest => p ^ (e - 1) * (p - 1) * phiVal rest

def isChainLtNat : List ℕ → Bool
  | [] => true
  | [_] => true
  | a :: b :: rest => Nat.ble (a + 1) b && isChainLtNat (b :: rest)

lemma isChainLtNat_pairwise : ∀ l : List ℕ, isChainLtNat l = true → List.Pairwise (· < ·) l
  | [], _ => List.Pairwise.nil
  | [_], _ => List.pairwise_singleton _ _
  | a :: b :: rest, h => by
    simp only [isChainLtNat, Bool.and_eq_true, Nat.ble_eq] at h
    have hab : a < b := h.1
    have ih := isChainLtNat_pairwise (b :: rest) h.2
    refine List.Pairwise.cons (fun x hx => ?_) ih
    simp only [List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact hab
    · exact lt_trans hab ((List.pairwise_cons.mp ih).1 x hx)

def entryValid (fs : List (ℕ × ℕ)) : Bool :=
  isChainLtNat (fs.map Prod.fst) && fs.all (fun pe => sievePred pe.1 && Nat.ble 1 pe.2)

lemma coprime_pow_prodVal {p e : ℕ} (hp : p.Prime) :
    ∀ rest : List (ℕ × ℕ),
      (∀ qf ∈ rest, qf.1.Prime ∧ p < qf.1) →
      Nat.Coprime (p ^ e) (prodVal rest)
  | [], _ => Nat.coprime_one_right _
  | (q, f) :: rest, h => by
    obtain ⟨hq, hpq⟩ := h (q, f) List.mem_cons_self
    have hcop1 : Nat.Coprime (p ^ e) (q ^ f) :=
      ((Nat.coprime_primes hp hq).mpr (ne_of_lt hpq)).pow e f
    have hcop2 : Nat.Coprime (p ^ e) (prodVal rest) :=
      coprime_pow_prodVal hp rest (fun qf hqf => h qf (List.mem_cons_of_mem _ hqf))
    exact hcop1.mul_right hcop2

lemma totient_prodVal_aux :
    ∀ fs : List (ℕ × ℕ),
      List.Pairwise (· < ·) (fs.map Prod.fst) →
      (∀ pe ∈ fs, pe.1.Prime ∧ 1 ≤ pe.2) →
      (prodVal fs).totient = phiVal fs
  | [], _, _ => Nat.totient_one
  | (p, e) :: rest, hpair, hall => by
    simp only [List.map_cons, List.pairwise_cons, List.mem_map] at hpair
    obtain ⟨hp, he⟩ := hall (p, e) List.mem_cons_self
    have hrest_all : ∀ pe ∈ rest, pe.1.Prime ∧ 1 ≤ pe.2 :=
      fun pe hpe => hall pe (List.mem_cons_of_mem _ hpe)
    have hcop : Nat.Coprime (p ^ e) (prodVal rest) :=
      coprime_pow_prodVal hp rest (fun qf hqf =>
        ⟨(hrest_all qf hqf).1, hpair.1 qf.1 ⟨qf, hqf, rfl⟩⟩)
    simp only [prodVal, phiVal]
    rw [Nat.totient_mul hcop, Nat.totient_prime_pow hp (by omega),
      totient_prodVal_aux rest hpair.2 hrest_all]

lemma totient_prodVal_of_valid {fs : List (ℕ × ℕ)} (h : entryValid fs = true) :
    (prodVal fs).totient = phiVal fs := by
  simp only [entryValid, Bool.and_eq_true, List.all_eq_true, Nat.ble_eq] at h
  refine totient_prodVal_aux fs (isChainLtNat_pairwise _ h.1) (fun pe hpe => ?_)
  obtain ⟨hs, he⟩ := h.2 pe hpe
  exact ⟨((sievePred_iff pe.1).mp hs).2, he⟩

def stepOk (a b : List (ℕ × ℕ)) : Prop :=
  prodVal a < prodVal b ∧ phiVal a ≤ phiVal b

def isChainStep : List (List (ℕ × ℕ)) → Bool
  | [] => true
  | [_] => true
  | a :: b :: rest =>
      Nat.ble (prodVal a + 1) (prodVal b) && Nat.ble (phiVal a) (phiVal b) &&
        isChainStep (b :: rest)

lemma isChainStep_pairwise : ∀ l : List (List (ℕ × ℕ)), isChainStep l = true → List.Pairwise stepOk l
  | [], _ => List.Pairwise.nil
  | [_], _ => List.pairwise_singleton _ _
  | a :: b :: rest, h => by
    simp only [isChainStep, Bool.and_eq_true, Nat.ble_eq] at h
    have hab : stepOk a b := ⟨h.1.1, h.1.2⟩
    have ih := isChainStep_pairwise (b :: rest) h.2
    refine List.Pairwise.cons (fun x hx => ?_) ih
    simp only [List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact hab
    · have hbx : stepOk b x := (List.pairwise_cons.mp ih).1 x hx
      exact ⟨lt_trans hab.1 hbx.1, le_trans hab.2 hbx.2⟩

lemma mem_le_getLast : ∀ (l : List (List (ℕ × ℕ))) (last : List (ℕ × ℕ)),
    List.Pairwise stepOk l → l.getLast? = some last →
    ∀ x ∈ l, prodVal x ≤ prodVal last ∧ phiVal x ≤ phiVal last
  | [], _, _, _, _, hx => by cases hx
  | [a], last, _, hlast, x, hx => by
    simp only [List.getLast?_singleton, Option.some.injEq] at hlast
    simp only [List.mem_singleton] at hx
    subst hlast; subst hx
    exact ⟨le_rfl, le_rfl⟩
  | a :: b :: rest, last, hp, hlast, x, hx => by
    rw [List.getLast?_cons_cons] at hlast
    have ih := mem_le_getLast (b :: rest) last (List.pairwise_cons.mp hp).2 hlast
    rcases List.mem_cons.mp hx with rfl | htail
    · have hb := ih b List.mem_cons_self
      have hab : stepOk x b := (List.pairwise_cons.mp hp).1 b List.mem_cons_self
      exact ⟨le_trans (le_of_lt hab.1) hb.1, le_trans hab.2 hb.2⟩
    · exact ih x htail

def allChunksChain : List (List (List (ℕ × ℕ))) → Bool
  | [] => true
  | [c] => isChainStep c
  | c1 :: c2 :: rest =>
      match c1.getLast?, c2.head? with
      | some last1, some head2 =>
          isChainStep c1 &&
            Nat.ble (prodVal last1 + 1) (prodVal head2) &&
            Nat.ble (phiVal last1) (phiVal head2) &&
            allChunksChain (c2 :: rest)
      | _, _ => false

lemma head_le_flatten : ∀ (cs : List (List (List (ℕ × ℕ)))) (c : List (List (ℕ × ℕ)))
    (hd : List (ℕ × ℕ)),
    allChunksChain (c :: cs) = true → c.head? = some hd →
    ∀ y ∈ (c :: cs).flatten, prodVal hd ≤ prodVal y ∧ phiVal hd ≤ phiVal y
  | [], c, hd, hchain, hhd, y, hy => by
    simp only [allChunksChain] at hchain
    have hp := isChainStep_pairwise c hchain
    cases c with
    | nil => simp at hhd
    | cons a tail =>
      simp only [List.head?_cons, Option.some.injEq] at hhd
      subst hhd
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons] at hy
      rcases hy with rfl | hy
      · exact ⟨le_rfl, le_rfl⟩
      · have hs := (List.pairwise_cons.mp hp).1 y hy
        exact ⟨le_of_lt hs.1, hs.2⟩
  | c2 :: rest, c1, hd, hchain, hhd, y, hy => by
    dsimp [allChunksChain] at hchain
    cases hlast1 : c1.getLast? with
    | none => simp [hlast1] at hchain
    | some last1 =>
      cases hhd2 : c2.head? with
      | none => simp [hlast1, hhd2] at hchain
      | some head2 =>
        simp only [hlast1, hhd2, Bool.and_eq_true, Nat.ble_eq] at hchain
        obtain ⟨⟨⟨hc1, hlt⟩, hle⟩, hrest⟩ := hchain
        have hp1 := isChainStep_pairwise c1 hc1
        rw [List.flatten_cons, List.mem_append] at hy
        rcases hy with hy1 | hy2
        · cases c1 with
          | nil => simp at hhd
          | cons a tail =>
            simp only [List.head?_cons, Option.some.injEq] at hhd
            subst hhd
            rcases List.mem_cons.mp hy1 with rfl | hy1'
            · exact ⟨le_rfl, le_rfl⟩
            · have hs := (List.pairwise_cons.mp hp1).1 y hy1'
              exact ⟨le_of_lt hs.1, hs.2⟩
        · have ih := head_le_flatten rest c2 head2 hrest hhd2 y hy2
          have hhd_mem : hd ∈ c1 := List.mem_of_head? hhd
          have hhd_last := mem_le_getLast c1 last1 hp1 hlast1 hd hhd_mem
          exact ⟨le_trans hhd_last.1 (le_trans (Nat.le_of_succ_le hlt) ih.1),
            le_trans hhd_last.2 (le_trans hle ih.2)⟩

lemma allChunksChain_pairwise : ∀ cs : List (List (List (ℕ × ℕ))),
    allChunksChain cs = true → List.Pairwise stepOk cs.flatten
  | [], _ => List.Pairwise.nil
  | [c], h => by
    simp only [allChunksChain] at h
    simpa using isChainStep_pairwise c h
  | c1 :: c2 :: rest, h => by
    dsimp [allChunksChain] at h
    cases hlast1 : c1.getLast? with
    | none => simp [hlast1] at h
    | some last1 =>
      cases hhd2 : c2.head? with
      | none => simp [hlast1, hhd2] at h
      | some head2 =>
        simp only [hlast1, hhd2, Bool.and_eq_true, Nat.ble_eq] at h
        obtain ⟨⟨⟨hc1, hlt⟩, hle⟩, hrest⟩ := h
        have hp1 := isChainStep_pairwise c1 hc1
        have hp2 := allChunksChain_pairwise (c2 :: rest) hrest
        rw [List.flatten_cons, List.pairwise_append]
        refine ⟨hp1, hp2, fun x hx y hy => ?_⟩
        have hx_last := mem_le_getLast c1 last1 hp1 hlast1 x hx
        have hy_hd := head_le_flatten rest c2 head2 hrest hhd2 y hy
        exact ⟨lt_of_le_of_lt hx_last.1 (lt_of_lt_of_le hlt hy_hd.1),
          le_trans hx_last.2 (le_trans hle hy_hd.2)⟩

lemma pairwise_stepOk_mono : ∀ W : List (List (ℕ × ℕ)),
    List.Pairwise stepOk W →
    (∀ fs ∈ W, (prodVal fs).totient = phiVal fs) →
    ∀ a ∈ W, ∀ b ∈ W, prodVal a ≤ prodVal b → (prodVal a).totient ≤ (prodVal b).totient
  | [], _, _, _, ha, _, _, _ => by cases ha
  | x :: xs, hp, htot, a, ha, b, hb, hab => by
    rw [List.pairwise_cons] at hp
    simp only [List.mem_cons] at ha hb
    rcases ha with rfl | ha <;> rcases hb with rfl | hb
    · exact le_rfl
    · rw [htot a List.mem_cons_self, htot b (List.mem_cons_of_mem _ hb)]
      exact (hp.1 b hb).2
    · exfalso
      have hlt := (hp.1 a ha).1
      omega
    · exact pairwise_stepOk_mono xs hp.2 (fun fs hfs => htot fs (List.mem_cons_of_mem _ hfs))
        a ha b hb hab

lemma pairwise_stepOk_nodup : ∀ W : List (List (ℕ × ℕ)),
    List.Pairwise stepOk W → (W.map prodVal).Nodup
  | [], _ => List.nodup_nil
  | x :: xs, hp => by
    rw [List.pairwise_cons] at hp
    rw [List.map_cons, List.nodup_cons]
    refine ⟨?_, pairwise_stepOk_nodup xs hp.2⟩
    rw [List.mem_map]
    rintro ⟨y, hy, hyx⟩
    exact ne_of_lt (hp.1 y hy).1 hyx.symm

