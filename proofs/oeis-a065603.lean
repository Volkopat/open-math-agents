import OMAStatements.S_oeis_a065603

-- Problem: A065603: Transposition diameter: maximal number of moves in an optimal sorting of n objects by moving blocks.
-- Credit: @sobrien032

/-! Phase-2a kernel for the oeis-a065603 disproof (generated by p2a/py/gen_core.py; mirrored by p2a/py/kref.py).
Node encoding (phase 1): with ext = 0 :: (l.map (· + 1)) ++ [18] and F = Σ (7·ext[i]) <<< 7i (i = 0..18),
a node is E = (F <<< 64) ||| (F % PR).  A black edge x₀ ∈ 0..17 is handled scaled, x = 7·x₀. -/
namespace K
noncomputable section

def PR : Nat := 2305843009213693951
/-- bits 0, 7, …, 119: every scaled black edge visited -/
def FULL : Nat := 669847178978225321778296471322378369
/-- encoding of the identity `List.range 17` (the poison value: it is never `Good`) -/
def ENCID : Nat := 199198447035793829881685811790849524360956905511631751026796

/-- shifted inverse: the 7-bit field at bit 7·(ext[i]+1) holds 7·i, for i = 1..17 (the field for value 0 is 0 = 7·pos 0).
It is literally `List.foldr (fun i acc => Nat.lor (Nat.shiftLeft (896 * i) (Nat.land (Nat.shiftRight E (64 + 7 * i)) 127)) acc) 0 [1, …, 17]`
unfolded. -/
def inv (E : Nat) : Nat := (Nat.lor (Nat.shiftLeft 896 (Nat.land (Nat.shiftRight E 71) 127)) (Nat.lor (Nat.shiftLeft 1792 (Nat.land (Nat.shiftRight E 78) 127)) (Nat.lor (Nat.shiftLeft 2688 (Nat.land (Nat.shiftRight E 85) 127)) (Nat.lor (Nat.shiftLeft 3584 (Nat.land (Nat.shiftRight E 92) 127)) (Nat.lor (Nat.shiftLeft 4480 (Nat.land (Nat.shiftRight E 99) 127)) (Nat.lor (Nat.shiftLeft 5376 (Nat.land (Nat.shiftRight E 106) 127)) (Nat.lor (Nat.shiftLeft 6272 (Nat.land (Nat.shiftRight E 113) 127)) (Nat.lor (Nat.shiftLeft 7168 (Nat.land (Nat.shiftRight E 120) 127)) (Nat.lor (Nat.shiftLeft 8064 (Nat.land (Nat.shiftRight E 127) 127)) (Nat.lor (Nat.shiftLeft 8960 (Nat.land (Nat.shiftRight E 134) 127)) (Nat.lor (Nat.shiftLeft 9856 (Nat.land (Nat.shiftRight E 141) 127)) (Nat.lor (Nat.shiftLeft 10752 (Nat.land (Nat.shiftRight E 148) 127)) (Nat.lor (Nat.shiftLeft 11648 (Nat.land (Nat.shiftRight E 155) 127)) (Nat.lor (Nat.shiftLeft 12544 (Nat.land (Nat.shiftRight E 162) 127)) (Nat.lor (Nat.shiftLeft 13440 (Nat.land (Nat.shiftRight E 169) 127)) (Nat.lor (Nat.shiftLeft 14336 (Nat.land (Nat.shiftRight E 176) 127)) (Nat.lor (Nat.shiftLeft 15232 (Nat.land (Nat.shiftRight E 183) 127)) 0)))))))))))))))))

/-- one-hot traversal of the cycle map x₀ ↦ pos(ext[x₀+1] - 1).
State: `X` = 2^x (current edge), `S` = one-hot of the current cycle's start, `vis` = OR of the processed one-hots,
`cur` = current cycle in reverse f-order without its start, `acc` = closed cycles.  A cycle closes when
2^(f x) = S; its start is recorded then, as f x.  The next start is the lowest unvisited bit of FULL.
After 18 steps the result is `acc` if every cycle closed and `vis = FULL`, else `[]` (failure). -/
def tnext (k : Nat → Nat → Nat → List Nat → List (List Nat) → List (List Nat)) (U vis : Nat) (acc : List (List Nat)) :
    List (List Nat) :=
  let S := Nat.land U (Nat.xor U (Nat.sub U 1))
  k S S vis [] acc
def tsel (k : Nat → Nat → Nat → List Nat → List (List Nat) → List (List Nat)) (y Y S vis : Nat) (cur : List Nat)
    (acc : List (List Nat)) : List (List Nat) :=
  Bool.rec (motive := fun _ => List (List Nat)) (k Y S vis (y :: cur) acc) (tnext k (Nat.xor FULL vis) vis ((y :: cur) :: acc))
    (Nat.beq Y S)
def tstep (Ep Ip : Nat) (k : Nat → Nat → Nat → List Nat → List (List Nat) → List (List Nat)) (X S vis : Nat)
    (cur : List Nat) (acc : List (List Nat)) : List (List Nat) :=
  let y := Nat.land (Nat.shiftRight Ip (Nat.land (Nat.div Ep X) 127)) 127
  tsel k y (Nat.shiftLeft 1 y) S (Nat.lor vis X) cur acc
def tend (vis : Nat) (cur : List Nat) (acc : List (List Nat)) : List (List Nat) :=
  List.casesOn (motive := fun _ => List (List Nat)) cur
    (Bool.rec (motive := fun _ => List (List Nat)) [] acc (Nat.beq vis FULL)) (fun _ _ => [])
def trav (Ep Ip : Nat) (fuel : Nat) : Nat → Nat → Nat → List Nat → List (List Nat) → List (List Nat) :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → List Nat → List (List Nat) → List (List Nat))
    (fun _ _ vis cur acc => tend vis cur acc)
    (fun _ ih X S vis cur acc => tstep Ep Ip ih X S vis cur acc) fuel

/-- the cycles of the node (each in reverse f-order, scaled), or `[]` if the traversal check failed -/
def cycles (E : Nat) : List (List Nat) := trav (Nat.shiftRight E 71) (inv E) 18 1 1 0 [] []

/-- child of the fields `F = E >>> 64` for scaled cut points a < b < c (block swap of l[a₀:b₀] and l[b₀:c₀]) -/
def mv (F a b c : Nat) : Nat :=
  let A := Nat.add a 7
  let B := Nat.add b 7
  let C := Nat.add c 7
  let G := Nat.lor (Nat.lor (Nat.land F (Nat.sub (Nat.shiftLeft 1 A) 1))
      (Nat.shiftLeft (Nat.land (Nat.shiftRight F B) (Nat.sub (Nat.shiftLeft 1 (Nat.sub C B)) 1)) A))
    (Nat.lor (Nat.shiftLeft (Nat.land (Nat.shiftRight F A) (Nat.sub (Nat.shiftLeft 1 (Nat.sub B A)) 1))
        (Nat.sub (Nat.add A C) B))
      (Nat.shiftLeft (Nat.shiftRight F C) C))
  Nat.lor (Nat.shiftLeft G 64) (Nat.mod G PR)

/-- the child for three distinct scaled edges in any order -/
def mvS (F u v w : Nat) : Nat :=
  Bool.rec (motive := fun _ => Nat)
    (Bool.rec (motive := fun _ => Nat) (mv F u v w)
      (Bool.rec (motive := fun _ => Nat) (mv F u w v) (mv F w u v) (Nat.ble w u)) (Nat.ble w v))
    (Bool.rec (motive := fun _ => Nat) (mv F v u w)
      (Bool.rec (motive := fun _ => Nat) (mv F v w u) (mv F w v u) (Nat.ble w v)) (Nat.ble w u))
    (Nat.ble v u)

/-- case 1 test for list positions p < q < r (values u v w): a 2-move iff u v w are cyclically increasing -/
def t3 (F u v w : Nat) (acc : List Nat) : List Nat :=
  Bool.rec (motive := fun _ => List Nat)
    (Bool.rec (motive := fun _ => List Nat) (mv F u v w :: acc)
      (Bool.rec (motive := fun _ => List Nat) (mv F w u v :: acc) acc (Nat.ble u w)) (Nat.ble w v))
    (Bool.rec (motive := fun _ => List Nat)
      (Bool.rec (motive := fun _ => List Nat) (mv F v w u :: acc) acc (Nat.ble u w)) acc (Nat.ble w v))
    (Nat.ble v u)

def cy3 (F u0 u1 u2 : Nat) (acc : List Nat) : List Nat := (t3 F u0 u1 u2 acc)
def cy4 (F u0 u1 u2 u3 : Nat) (acc : List Nat) : List Nat := (t3 F u1 u2 u3 (t3 F u0 u2 u3 (t3 F u0 u1 u3 (t3 F u0 u1 u2 acc))))
def cy5 (F u0 u1 u2 u3 u4 : Nat) (acc : List Nat) : List Nat := (t3 F u2 u3 u4 (t3 F u1 u2 u3 (t3 F u0 u3 u4 (t3 F u0 u1 u4 (t3 F u0 u1 u2 acc)))))
def cy7 (F u0 u1 u2 u3 u4 u5 u6 : Nat) (acc : List Nat) : List Nat := (t3 F u4 u5 u6 (t3 F u3 u4 u5 (t3 F u2 u5 u6 (t3 F u2 u3 u6 (t3 F u2 u3 u4 (t3 F u1 u4 u5 (t3 F u1 u2 u5 (t3 F u1 u2 u3 (t3 F u0 u5 u6 (t3 F u0 u3 u6 (t3 F u0 u3 u4 (t3 F u0 u1 u6 (t3 F u0 u1 u4 (t3 F u0 u1 u2 acc))))))))))))))

def len (l : List Nat) : Nat := List.rec (motive := fun _ => Nat) 0 (fun _ _ ih => Nat.succ ih) l

/-- general case 1 (any length): all p < q < r with the parity test -/
def par (Lodd o1 o2 : Nat) : Bool :=
  Nat.rec (motive := fun _ => Bool) (Nat.blt 0 (Nat.add o1 o2)) (fun _ _ => Nat.beq (Nat.add o1 o2) 2) Lodd
def c1w (F Lodd u v pa pb : Nat) (l : List Nat) : Nat → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun w _ ih pc acc =>
      Bool.rec (motive := fun _ => List Nat) (ih (Nat.succ pc) acc) (ih (Nat.succ pc) (t3 F u v w acc))
        (par Lodd (Nat.land (Nat.sub pb pa) 1) (Nat.land (Nat.sub pc pb) 1))) l
def c1v (F Lodd u pa : Nat) (l : List Nat) : Nat → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun v vs ih pb acc => ih (Nat.succ pb) (c1w F Lodd u v pa pb vs (Nat.succ pb) acc)) l
def c1u (F Lodd : Nat) (l : List Nat) : Nat → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun u us ih pa acc => ih (Nat.succ pa) (c1v F Lodd u pa us (Nat.succ pa) acc)) l

/-- case 2: two edges of an even cycle A at odd distance and one edge of another even cycle B -/
def c2z (F x y : Nat) (l : List Nat) : List Nat → List Nat :=
  List.rec (motive := fun _ => List Nat → List Nat) (fun acc => acc)
    (fun z _ ih acc => ih (mvS F x y z :: acc)) l
def c2y (F x pa : Nat) (B : List Nat) (l : List Nat) : Nat → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun y _ ih pb acc =>
      Bool.rec (motive := fun _ => List Nat) (ih (Nat.succ pb) (c2z F x y B acc)) (ih (Nat.succ pb) acc)
        (Nat.beq (Nat.land (Nat.sub pb pa) 1) 0)) l
def c2x (F : Nat) (B : List Nat) (l : List Nat) : Nat → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun x xs ih pa acc => ih (Nat.succ pa) (c2y F x pa B xs (Nat.succ pa) acc)) l
def c2B (F : Nat) (A : List Nat) (Bs : List (List Nat)) : List Nat → List Nat :=
  List.rec (motive := fun _ => List Nat → List Nat) (fun acc => acc)
    (fun B _ ih acc => ih (c2x F B A 0 acc)) Bs
def app (l r : List (List Nat)) : List (List Nat) :=
  List.rec (motive := fun _ => List (List Nat)) r (fun h _ ih => h :: ih) l
def case2 (F : Nat) (Es : List (List Nat)) : List (List Nat) → List Nat → List Nat :=
  List.rec (motive := fun _ => List (List Nat) → List Nat → List Nat) (fun _ acc => acc)
    (fun A As ih prev acc => ih (A :: prev) (c2B F A (app prev As) acc)) Es

/-- Φ of a node for the slack filter (0 if the traversal check failed, so the child is kept) -/
def coddC (Cs : List (List Nat)) : Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun C _ ih => Nat.add ih (Nat.land (len C) 1)) Cs
def phiS (E : Nat) : Nat :=
  let Cs := cycles E
  List.casesOn (motive := fun _ => Nat) Cs 0 (fun _ _ => Nat.shiftRight (Nat.sub 18 (coddC Cs)) 1)

/-- slack expansion: every move whose child has Φ ≤ b -/
def sK (F b a bb : Nat) (fuel : Nat) : Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun _ ih c acc =>
      let ch := mv F a bb c
      Bool.rec (motive := fun _ => List Nat) (ih (Nat.add c 7) acc) (ih (Nat.add c 7) (ch :: acc)) (Nat.ble (phiS ch) b)) fuel
def sJ (F b a : Nat) (fuel : Nat) : Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun _ ih bb acc => ih (Nat.add bb 7) (sK F b a bb (Nat.sub 17 (Nat.div bb 7)) (Nat.add bb 7) acc)) fuel
def sI (F b : Nat) (fuel : Nat) : Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ acc => acc)
    (fun _ ih a acc => ih (Nat.add a 7) (sJ F b a (Nat.sub 16 (Nat.div a 7)) (Nat.add a 7) acc)) fuel
def slack (F b : Nat) (acc : List Nat) : List Nat := sI F b 16 0 acc

/-- after the pass: tight → case 2 on top of the case-1 children; slack → slack children; Φ = 0 → poison -/
def fin (F b : Nat) (acc0 : List Nat) (co : Nat) (evs : List (List Nat)) (acc : List Nat) : List Nat :=
  let p := Nat.shiftRight (Nat.sub 18 co) 1
  Bool.rec (motive := fun _ => List Nat)
    (Bool.rec (motive := fun _ => List Nat) acc0
      (Bool.rec (motive := fun _ => List Nat) (slack F (Nat.sub b 1) acc0) (ENCID :: acc0) (Nat.beq p 0))
      (Nat.ble p b))
    (case2 F evs [] acc)
    (Nat.beq p b)

/-- one cycle of the pass: count odd cycles, collect even ones, add the case-1 children.
Each `List.casesOn` level is its own small definition (cheap kernel instantiation). -/
def dg (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) : List Nat :=
  Bool.rec (motive := fun _ => List Nat) (k co (C :: evs) (c1u F 0 C 0 acc)) (k (Nat.succ co) evs (c1u F 1 C 0 acc))
    (Nat.beq (Nat.land (len C) 1) 1)
def d7 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 u1 u2 u3 u4 u5 u6 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (k (Nat.succ co) evs (cy7 F u0 u1 u2 u3 u4 u5 u6 acc)) (fun _ _ => dg F C k co evs acc)
def d6 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 u1 u2 u3 u4 u5 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (dg F C k co evs acc) (fun u6 r6 => d7 F C k co evs acc u0 u1 u2 u3 u4 u5 u6 r6)
def d5 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 u1 u2 u3 u4 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (k (Nat.succ co) evs (cy5 F u0 u1 u2 u3 u4 acc)) (fun u5 r5 => d6 F C k co evs acc u0 u1 u2 u3 u4 u5 r5)
def d4 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 u1 u2 u3 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (k co (C :: evs) (cy4 F u0 u1 u2 u3 acc)) (fun u4 r4 => d5 F C k co evs acc u0 u1 u2 u3 u4 r4)
def d3 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 u1 u2 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (k (Nat.succ co) evs (cy3 F u0 u1 u2 acc)) (fun u3 r3 => d4 F C k co evs acc u0 u1 u2 u3 r3)
def d2 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 u1 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (k co (C :: evs) acc) (fun u2 r2 => d3 F C k co evs acc u0 u1 u2 r2)
def d1 (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) (u0 : Nat) (r : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) r (k (Nat.succ co) evs acc) (fun u1 r1 => d2 F C k co evs acc u0 u1 r1)
def disp (F : Nat) (C : List Nat) (k : Nat → List (List Nat) → List Nat → List Nat) (co : Nat) (evs : List (List Nat))
    (acc : List Nat) : List Nat :=
  List.casesOn (motive := fun _ => List Nat) C (k co evs acc) (fun u0 r0 => d1 F C k co evs acc u0 r0)

def pass (F b : Nat) (acc0 : List Nat) (Cs : List (List Nat)) : Nat → List (List Nat) → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → List (List Nat) → List Nat → List Nat)
    (fun co evs acc => fin F b acc0 co evs acc)
    (fun C _ ih co evs acc => disp F C ih co evs acc) Cs

/-- the children of node E at budget b, consed onto acc0 -/
def expA (b E : Nat) (acc0 : List Nat) : List Nat :=
  let Cs := cycles E
  List.casesOn (motive := fun _ => List Nat) Cs (ENCID :: acc0)
    (fun _ _ => pass (Nat.shiftRight E 64) b acc0 Cs 0 [] acc0)
def expand (b E : Nat) : List Nat := expA b E []

/-! ### deduplication: merge sort with a continuation merge (phase-1 M2) -/
def mAux (x : Nat) (k : List Nat → List Nat) (ys : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) (x :: k [])
    (fun y yt r => Bool.rec (motive := fun _ => List Nat)
      (Bool.rec (motive := fun _ => List Nat) (y :: r) (x :: k yt) (Nat.beq x y))
      (x :: k (y :: yt)) (Nat.blt x y)) ys
def merge (xs : List Nat) : List Nat → List Nat :=
  List.rec (motive := fun _ => List Nat → List Nat) (fun ys => ys) (fun x _ k => mAux x k) xs
def mergePairs (ls : List (List Nat)) : List (List Nat) :=
  (List.rec (motive := fun _ => Option (List Nat) → List (List Nat))
    (fun o => Option.casesOn (motive := fun _ => List (List Nat)) o [] (fun a => [a]))
    (fun l _ ih o => Option.casesOn (motive := fun _ => List (List Nat)) o (ih (some l)) (fun a => merge a l :: ih none)) ls) none
def single (l : List Nat) : List (List Nat) :=
  List.rec (motive := fun _ => List (List Nat)) [] (fun x _ ih => [x] :: ih) l
def flat (ls : List (List Nat)) : List Nat :=
  List.rec (motive := fun _ => List Nat) [] (fun l _ ih => List.rec (motive := fun _ => List Nat) ih (fun h _ r => h :: r) l) ls
def msortLoop (fuel : Nat) : List (List Nat) → List Nat :=
  Nat.rec (motive := fun _ => List (List Nat) → List Nat) (fun ls => flat ls)
    (fun _ ih ls =>
      List.casesOn (motive := fun _ => List Nat) ls [] (fun a r =>
        List.casesOn (motive := fun _ => List Nat) r a (fun _ _ => ih (mergePairs ls)))) fuel
def msort (l : List Nat) : List Nat := msortLoop 40 (single l)

/-! ### group search -/
/-! Every loop below takes each iteration through a named step definition: the kernel's `whnf_core` recursion
then unwinds after each iteration (delta steps run in the iterative `whnf` loop), so long lists cannot overflow
the kernel's stack ("deep recursion detected"). -/
def fxS (b E : Nat) (k : List Nat → List Nat) (a : List Nat) : List Nat := k (expA b E a)
def flatExp (b : Nat) (S : List Nat) (acc : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat → List Nat) (fun a => a) (fun E _ ih a => fxS b E ih a) S acc
def hd (rs : List (List Nat)) : List Nat := List.rec (motive := fun _ => List Nat) [] (fun h _ _ => h) rs
def tl (rs : List (List Nat)) : List (List Nat) := List.rec (motive := fun _ => List (List Nat)) [] (fun _ t _ => t) rs
def isNil (l : List Nat) : Bool := List.rec (motive := fun _ => Bool) true (fun _ _ _ => false) l
/-- `run n S rs`: S is the level at budget n+1, rs the extra roots for budgets n, n-1, …; the level at budget 1
must be empty -/
def run (n : Nat) : List Nat → List (List Nat) → Bool :=
  Nat.rec (motive := fun _ => List Nat → List (List Nat) → Bool) (fun S _ => isNil S)
    (fun k ih S rs => ih (msort (flatExp (Nat.succ (Nat.succ k)) S (hd rs))) (tl rs)) n

/-! ### naming nodes by move paths from L0 -/
/-- a move code m = a₀ + 18·b₀ + 324·c₀ (cut points a₀ < b₀ < c₀) -/
def mvp (E m : Nat) : Nat :=
  mv (Nat.shiftRight E 64) (Nat.mul 7 (Nat.mod m 18)) (Nat.mul 7 (Nat.mod (Nat.div m 18) 18)) (Nat.mul 7 (Nat.div m 324))
def L0E : Nat := 199026818009010115227304295350059632089161972406588670858503
def pathE (p : List Nat) : Nat := List.rec (motive := fun _ => Nat → Nat) (fun E => E) (fun m _ ih E => ih (mvp E m)) p L0E

/-! ### the split plan: glue vertices `gl = [(budget, path)]`, groups `sp = [(glue index, child moves)]` -/
def nthS {α : Type} (h : α) (k : Nat → α) (i : Nat) : α := Nat.casesOn (motive := fun _ => α) i h (fun j => k j)
def nth {α : Type} (l : List α) (i : Nat) (d : α) : α :=
  List.rec (motive := fun _ => Nat → α) (fun _ => d) (fun h _ ih i => nthS h ih i) l i
/-- roots of a group, as (budget, encoding): the listed children of its glue vertices -/
def rootsOf (gl : List (Nat × List Nat)) (sp : List (Nat × List Nat)) : List (Nat × Nat) :=
  List.rec (motive := fun _ => List (Nat × Nat)) []
    (fun e _ ih =>
      let g := nth gl e.1 (0, [])
      let E := pathE g.2
      let b := Nat.sub g.1 1
      List.rec (motive := fun _ => List (Nat × Nat)) ih (fun m _ r => (b, mvp E m) :: r) e.2) sp
def selS (b : Nat) (x : Nat × Nat) (k : List Nat) : List Nat :=
  Bool.rec (motive := fun _ => List Nat) k (x.2 :: k) (Nat.beq x.1 b)
def sel (b : Nat) (R : List (Nat × Nat)) : List Nat :=
  List.rec (motive := fun _ => List Nat) [] (fun x _ ih => selS b x ih) R
def maxS (x : Nat × Nat) (k : Nat → Nat) (m : Nat) : Nat := Bool.rec (motive := fun _ => Nat) (k x.1) (k m) (Nat.ble x.1 m)
def maxB (R : List (Nat × Nat)) : Nat :=
  List.rec (motive := fun _ => Nat → Nat) (fun m => m) (fun x _ ih m => maxS x ih m) R 0
def apS (x : Nat × Nat) (k : Bool) : Bool := Bool.rec (motive := fun _ => Bool) false k (Nat.ble 1 x.1)
def allPos (R : List (Nat × Nat)) : Bool := List.rec (motive := fun _ => Bool) true (fun x _ ih => apS x ih) R
/-- `runR R n S`: S is the level at budget n+1; each step adds the roots of the next budget; budget 1 must be empty -/
def runR (R : List (Nat × Nat)) (n : Nat) : List Nat → Bool :=
  Nat.rec (motive := fun _ => List Nat → Bool) (fun S => isNil S)
    (fun k ih S => ih (msort (flatExp (Nat.succ (Nat.succ k)) S (sel (Nat.succ k) R)))) n
/-- group check: BFS with deduplication from all roots, down to an empty level at budget 1 -/
def gcheck (gl : List (Nat × List Nat)) (sp : List (Nat × List Nat)) : Bool :=
  let R := rootsOf gl sp
  let t := maxB R
  Bool.rec (motive := fun _ => Bool) false (runR R (Nat.sub t 1) (sel t R)) (allPos R)
/-- every certified vertex: all group roots and all glue vertices, as (budget, encoding) -/
def appP (l r : List (Nat × Nat)) : List (Nat × Nat) :=
  List.rec (motive := fun _ => List (Nat × Nat)) r (fun h _ ih => h :: ih) l
def flatR (gl : List (Nat × List Nat)) (gs : List (List (Nat × List Nat))) : List (Nat × Nat) :=
  List.rec (motive := fun _ => List (Nat × Nat))
    (List.rec (motive := fun _ => List (Nat × Nat)) [] (fun g _ ih => (g.1, pathE g.2) :: ih) gl)
    (fun sp _ ih => appP (rootsOf gl sp) ih) gs
def certAt (gl : List (Nat × List Nat)) (gs : List (List (Nat × List Nat))) (b : Nat) : List Nat := msort (sel b (flatR gl gs))
/-- inclusion of sorted duplicate-free lists -/
def inclS (y : Nat) (k : List Nat → Bool) (xs : List Nat) : Bool :=
  List.casesOn (motive := fun _ => Bool) xs true (fun x xt =>
    Bool.rec (motive := fun _ => Bool) (Bool.rec (motive := fun _ => Bool) (k xs) (k xt) (Nat.beq x y)) false (Nat.blt x y))
def incl (xs ys : List Nat) : Bool :=
  List.rec (motive := fun _ => List Nat → Bool) (fun xs => isNil xs) (fun y _ ih xs => inclS y ih xs) ys xs
/-- encodings of the roots listed under glue vertex `i` (glue encoding `E`) in the group specs -/
def mapMv (E : Nat) (ms : List Nat) (k : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) k (fun m _ ih => mvp E m :: ih) ms
def kdS (i E : Nat) (e : Nat × List Nat) (k : List Nat) : List Nat :=
  Bool.rec (motive := fun _ => List Nat) k (mapMv E e.2 k) (Nat.beq e.1 i)
def kdSp (i E : Nat) (sp : List (Nat × List Nat)) (acc : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) acc (fun e _ ih => kdS i E e ih) sp
def kdG (i E : Nat) (sp : List (Nat × List Nat)) (k : List Nat) : List Nat := kdSp i E sp k
def kidsOf (gl : List (Nat × List Nat)) (gs : List (List (Nat × List Nat))) (i : Nat) (acc : List Nat) : List Nat :=
  let E := pathE (nth gl i (0, [])).2
  List.rec (motive := fun _ => List Nat) acc (fun sp _ ih => kdG i E sp ih) gs
def kdI (gl : List (Nat × List Nat)) (gs : List (List (Nat × List Nat))) (i : Nat) (k : List Nat) : List Nat := kidsOf gl gs i k
/-- certificate of a glue batch: the roots listed under its glue vertices, and every glue vertex of budget b-1 -/
def certB (gl : List (Nat × List Nat)) (gs : List (List (Nat × List Nat))) (b : Nat) (idx : List Nat) : List Nat :=
  msort (List.rec (motive := fun _ => List Nat)
    (sel (Nat.sub b 1) (List.rec (motive := fun _ => List (Nat × Nat)) [] (fun g _ ih => (g.1, pathE g.2) :: ih) gl))
    (fun i _ ih => kdI gl gs i ih) idx)
/-- glue check for the glue vertices `idx`, all of budget b: every child is certified at budget b-1 -/
def gbS (gl : List (Nat × List Nat)) (b : Nat) (i : Nat) (k : Bool) : Bool :=
  Bool.rec (motive := fun _ => Bool) false k (Nat.beq (nth gl i (0, [])).1 b)
def glE (gl : List (Nat × List Nat)) (idx : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) [] (fun i _ ih => pathE (nth gl i (0, [])).2 :: ih) idx
def glueOk (gl : List (Nat × List Nat)) (gs : List (List (Nat × List Nat))) (b : Nat) (idx : List Nat) : Bool :=
  Bool.rec (motive := fun _ => Bool) false
    (incl (msort (flatExp b (glE gl idx) [])) (certB gl gs b idx))
    (List.rec (motive := fun _ => Bool) true (fun i _ ih => gbS gl b i ih) idx)

def memS (i h : Nat) (k : Bool) : Bool := Bool.rec (motive := fun _ => Bool) k true (Nat.beq h i)
def memN (i : Nat) (l : List Nat) : Bool := List.rec (motive := fun _ => Bool) false (fun h _ ih => memS i h ih) l
def inS (i : Nat) (x : Nat × List Nat) (k : Bool) : Bool := Bool.rec (motive := fun _ => Bool) k true (memN i x.2)
def inSome (i : Nat) (bt : List (Nat × List Nat)) : Bool := List.rec (motive := fun _ => Bool) false (fun x _ ih => inS i x ih) bt
def poS (x : Nat × List Nat) (k : Bool) : Bool := Bool.rec (motive := fun _ => Bool) false k (Nat.ble 1 x.1)
def posAll (bt : List (Nat × List Nat)) : Bool := List.rec (motive := fun _ => Bool) true (fun x _ ih => poS x ih) bt
def cvS (bt : List (Nat × List Nat)) (k : Nat → Bool) (i : Nat) : Bool :=
  Bool.rec (motive := fun _ => Bool) false (k (Nat.succ i)) (inSome i bt)
/-- every glue vertex is in some batch `(budget, glue indices)`, and every batch has budget ≥ 1 -/
def covOk (gl : List (Nat × List Nat)) (bt : List (Nat × List Nat)) : Bool :=
  Bool.rec (motive := fun _ => Bool) false
    (List.rec (motive := fun _ => Nat → Bool) (fun _ => true) (fun _ _ ih i => cvS bt ih i) gl 0)
    (posAll bt)

end
