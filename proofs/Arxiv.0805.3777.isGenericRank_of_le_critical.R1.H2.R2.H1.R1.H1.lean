private def inverseRow (j : ℕ) : ℕ := (inverseBlocks[j/32]?.getD #[])[j%32]?.getD 0

private def correctRow (s : ℕ) : Bool :=
  imageRow 7 8 8 22 x y z inverseRow (s/64) (s/8%8) (s%8) == 2^s

set_option maxRecDepth 10000 in
set_option maxHeartbeats 4000000 in
private lemma allRows : (List.range 448).all correctRow = true := by
  decide +kernel

private def rowCode (s : Fin 7 × Fin 8 × Fin 8) : ℕ :=
  64 * s.1.val + 8 * s.2.1.val + s.2.2.val

private lemma decode (s : Fin 7 × Fin 8 × Fin 8) :
    rowCode s / 64 = s.1.val ∧ rowCode s / 8 % 8 = s.2.1.val ∧ rowCode s % 8 = s.2.2.val := by
  have := s.1.isLt
  have := s.2.1.isLt
  have := s.2.2.isLt
  dsimp [rowCode]
  omega

private lemma injectiveCode : Function.Injective rowCode := by
  intro s t h
  have hs := decode s
  rw [h] at hs
  have ht := decode t
  exact Prod.ext (Fin.ext (by omega)) (Prod.ext (Fin.ext (by omega)) (Fin.ext (by omega)))

private lemma bounded (a i : ℕ) : read a i < 897 := by
  simp only [read]
  split <;> decide

private lemma certificate : covers (a:=7) (b:=8) (c:=8) (r:=22)
    (fun t i => (x t.val i.val : ℂ)) (fun t j => (y t.val j.val : ℂ))
    (fun t k => (z t.val k.val : ℂ)) := by
  apply covers_of_rank
  apply checked id rowCode injectiveCode x y z inverseRow
  intro s
  have hs : rowCode s < 448 := by
    dsimp [rowCode]
    have := s.1.isLt
    have := s.2.1.isLt
    have := s.2.2.isLt
    omega
  have h := List.all_eq_true.mp allRows (rowCode s) (List.mem_range.mpr hs)
  change (imageRow 7 8 8 22 x y z inverseRow (rowCode s / 64) (rowCode s / 8 % 8)
    (rowCode s % 8) == 2 ^ rowCode s) = true at h
  rw [(decode s).1, (decode s).2.1, (decode s).2.2] at h
  exact eq_of_beq h

end OMA.Tensor788

open OMA.Tensor788

theorem OMA.solution : OMA.R_Arxiv_0805_3777_isGenericRank_of_le_critical_R1_H2_R2_H1_R1.H1 := by
  refine ⟨fun t i => ⟨x t.val i.val, bounded _ _⟩,
    fun t j => ⟨y t.val j.val, bounded _ _⟩,
    fun t k => ⟨z t.val k.val, bounded _ _⟩, ?_⟩
  exact certificate
