import OMAReductions.R_RamseyNumbers_ramsey_number_four_five_R1_H1_R1_H3_R1
import Mathlib

/-! Verified bitmask linear-resolution refutation for R(4,5) step H2. -/

namespace OMA.R45H2

def g16Mask : Nat := 0xacb96354eb266b51b2b6553699403b

def edgeBit (mask i j : Nat) : Bool :=
  mask.testBit (j * (j - 1) / 2 + i)

def symEdge (mask i j : Nat) : Bool :=
  if i < j then edgeBit mask i j else edgeBit mask j i

def bit (v : Nat) : Nat := Nat.shiftLeft 1 v

/- ### Part 1: Bitmask clauses and resolution soundness -/

def sat (a : Nat → Bool) (p n : Nat) : Prop :=
  ∃ v, (p.testBit v = true ∧ a v = true) ∨ (n.testBit v = true ∧ a v = false)

def validCl (a : Nat → Bool) (c : Nat × Nat) : Prop :=
  (c.1 &&& c.2 = 0) ∧ sat a c.1 c.2

def allBitsBelow (nv : Nat) (c : Nat × Nat) : Prop :=
  ∀ v, (c.1.testBit v = true ∨ c.2.testBit v = true) → v < nv

private lemma testBit_bit (v w : Nat) : (bit v).testBit w = decide (v = w) := by
  change (1 <<< v).testBit w = decide (v = w)
  rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]

private lemma testBit_lor (x y w : Nat) :
    (Nat.lor x y).testBit w = (x.testBit w || y.testBit w) :=
  Nat.testBit_or x y w

private lemma land_comm_local (x y : Nat) : x &&& y = y &&& x := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_and, Nat.testBit_and, Bool.and_comm]

private lemma lor_comm_local (x y : Nat) : x ||| y = y ||| x := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_or, Nat.testBit_or, Bool.or_comm]

private lemma testBit_eq_false_of_land_zero {x y : Nat} (h : x &&& y = 0) {v : Nat}
    (hx : x.testBit v = true) : y.testBit v = false := by
  have h0 : (x &&& y).testBit v = false := by rw [h]; simp
  rw [Nat.testBit_and, hx, Bool.true_and] at h0
  exact h0

private lemma exists_pow_two_of_land_pred_zero :
    ∀ d : Nat, d ≠ 0 → d &&& (d - 1) = 0 → ∃ v : Nat, d = 2 ^ v := by
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
    intro hd hland
    by_cases h1 : d = 1
    · exact ⟨0, h1⟩
    have hmod : d % 2 = 0 := by
      by_contra hodd
      let k := d / 2
      have hdk : d = 2 * k + 1 := by omega
      have hkp : 1 ≤ k := by omega
      have hpred : d - 1 = 2 * k := by omega
      have heq : d &&& (d - 1) = 2 * k := by
        apply Nat.eq_of_testBit_eq
        intro i
        cases i with
        | zero =>
          rw [Nat.testBit_and, hpred]
          simp [Nat.testBit_zero]
        | succ j =>
          rw [Nat.testBit_and, hpred, hdk, Nat.testBit_succ, Nat.testBit_succ]
          have h1' : (2 * k + 1) / 2 = k := by omega
          have h2' : (2 * k) / 2 = k := by omega
          rw [h1', h2', Bool.and_self]
      rw [hland] at heq
      omega
    let k := d / 2
    have hdk : d = 2 * k := by omega
    have hknz : k ≠ 0 := by omega
    have hkland : k &&& (k - 1) = 0 := by
      apply Nat.eq_of_testBit_eq
      intro i
      have hi : (d &&& (d - 1)).testBit (i + 1) = false := by rw [hland]; simp
      rw [Nat.testBit_and, Nat.testBit_succ, Nat.testBit_succ] at hi
      have hd1 : d / 2 = k := by omega
      have hd2 : (d - 1) / 2 = k - 1 := by omega
      rw [hd1, hd2] at hi
      rw [Nat.testBit_and, Nat.zero_testBit]
      exact hi
    obtain ⟨v, hv⟩ := ih k (by omega) hknz hkland
    refine ⟨v + 1, ?_⟩
    rw [hdk, hv, pow_succ']

def resStep : Nat × Nat → Nat × Nat → Option (Nat × Nat)
  | (p1, n1), (p2, n2) =>
    let d1 := Nat.land p1 n2
    let d2 := Nat.land n1 p2
    match Nat.beq d2 0 with
    | true =>
      match Nat.beq d1 0 with
      | false =>
        match Nat.beq (Nat.land d1 (Nat.sub d1 1)) 0 with
        | true => some (Nat.xor (Nat.lor p1 p2) d1, Nat.xor (Nat.lor n1 n2) d1)
        | false => none
      | true => none
    | false =>
      match Nat.beq d1 0 with
      | true =>
        match Nat.beq (Nat.land d2 (Nat.sub d2 1)) 0 with
        | true => some (Nat.xor (Nat.lor p1 p2) d2, Nat.xor (Nat.lor n1 n2) d2)
        | false => none
      | false => none

private lemma resDir_sound {a : Nat → Bool} {c1 c2 : Nat × Nat}
    (h1 : validCl a c1) (h2 : validCl a c2)
    (hd2 : c1.2 &&& c2.1 = 0) (hd1ne : c1.1 &&& c2.2 ≠ 0)
    (hpow : (c1.1 &&& c2.2) &&& ((c1.1 &&& c2.2) - 1) = 0) :
    validCl a ((c1.1 ||| c2.1) ^^^ (c1.1 &&& c2.2), (c1.2 ||| c2.2) ^^^ (c1.1 &&& c2.2)) := by
  set d1 := c1.1 &&& c2.2 with hd1def
  obtain ⟨v, hv⟩ := exists_pow_two_of_land_pred_zero d1 hd1ne hpow
  have hdv : ∀ w, d1.testBit w = decide (v = w) := by
    intro w; rw [hv, Nat.testBit_two_pow]
  have hp1v : c1.1.testBit v = true := by
    have h : d1.testBit v = true := by rw [hdv]; simp
    rw [hd1def, Nat.testBit_and, Bool.and_eq_true] at h
    exact h.1
  have hn2v : c2.2.testBit v = true := by
    have h : d1.testBit v = true := by rw [hdv]; simp
    rw [hd1def, Nat.testBit_and, Bool.and_eq_true] at h
    exact h.2
  have hn1v : c1.2.testBit v = false := testBit_eq_false_of_land_zero h1.1 hp1v
  have hp2v : c2.1.testBit v = false := by
    have h0 : (c2.1 &&& c2.2).testBit v = false := by rw [h2.1]; simp
    rw [Nat.testBit_and, hn2v, Bool.and_true] at h0; exact h0
  constructor
  · apply Nat.eq_of_testBit_eq
    intro w
    rw [Nat.zero_testBit, Nat.testBit_and, Nat.testBit_xor, Nat.testBit_xor,
        Nat.testBit_or, Nat.testBit_or, hdv]
    by_cases hvw : v = w
    · subst hvw
      simp [hp1v, hn2v, hn1v, hp2v]
    · simp only [decide_eq_false hvw, Bool.xor_false]
      have h12 : (c1.1 &&& c1.2).testBit w = false := by rw [h1.1]; simp
      have h22 : (c2.1 &&& c2.2).testBit w = false := by rw [h2.1]; simp
      have h12' : (c1.1 &&& c2.2).testBit w = false := by rw [← hd1def, hdv]; simp [hvw]
      have h21' : (c1.2 &&& c2.1).testBit w = false := by rw [hd2]; simp
      rw [Nat.testBit_and] at h12 h22 h12' h21'
      revert h12 h22 h12' h21'
      cases c1.1.testBit w <;> cases c2.1.testBit w <;>
        cases c1.2.testBit w <;> cases c2.2.testBit w <;> simp
  · cases hav : a v
    · obtain ⟨w, hw⟩ := h1.2
      have hne : v ≠ w := by
        rintro rfl
        rcases hw with ⟨_, ha⟩ | ⟨hn, _⟩
        · rw [hav] at ha; cases ha
        · rw [hn1v] at hn; cases hn
      refine ⟨w, ?_⟩
      rcases hw with ⟨hp, ha⟩ | ⟨hn, ha⟩
      · left; refine ⟨?_, ha⟩
        rw [Nat.testBit_xor, Nat.testBit_or, hdv, decide_eq_false hne, hp]; simp
      · right; refine ⟨?_, ha⟩
        rw [Nat.testBit_xor, Nat.testBit_or, hdv, decide_eq_false hne, hn]; simp
    · obtain ⟨w, hw⟩ := h2.2
      have hne : v ≠ w := by
        rintro rfl
        rcases hw with ⟨hp, _⟩ | ⟨_, ha⟩
        · rw [hp2v] at hp; cases hp
        · rw [hav] at ha; cases ha
      refine ⟨w, ?_⟩
      rcases hw with ⟨hp, ha⟩ | ⟨hn, ha⟩
      · left; refine ⟨?_, ha⟩
        rw [Nat.testBit_xor, Nat.testBit_or, hdv, decide_eq_false hne, hp]; simp
      · right; refine ⟨?_, ha⟩
        rw [Nat.testBit_xor, Nat.testBit_or, hdv, decide_eq_false hne, hn]; simp

theorem resStep_sound {a : Nat → Bool} {c1 c2 c3 : Nat × Nat}
    (h1 : validCl a c1) (h2 : validCl a c2) (hres : resStep c1 c2 = some c3) :
    validCl a c3 := by
  rcases c1 with ⟨p1, n1⟩
  rcases c2 with ⟨p2, n2⟩
  unfold resStep at hres
  dsimp only at hres
  cases he1 : Nat.beq (Nat.land n1 p2) 0 with
  | true =>
    rw [he1] at hres; dsimp only at hres
    cases he2 : Nat.beq (Nat.land p1 n2) 0 with
    | true => rw [he2] at hres; cases hres
    | false =>
      rw [he2] at hres; dsimp only at hres
      cases he3 : Nat.beq (Nat.land (Nat.land p1 n2) (Nat.sub (Nat.land p1 n2) 1)) 0 with
      | false => rw [he3] at hres; cases hres
      | true =>
        rw [he3] at hres; dsimp only at hres
        injection hres with h3; subst h3
        exact resDir_sound h1 h2 (Nat.eq_of_beq_eq_true he1)
          (Nat.ne_of_beq_eq_false he2) (Nat.eq_of_beq_eq_true he3)
  | false =>
    rw [he1] at hres; dsimp only at hres
    cases he2 : Nat.beq (Nat.land p1 n2) 0 with
    | false => rw [he2] at hres; cases hres
    | true =>
      rw [he2] at hres; dsimp only at hres
      cases he3 : Nat.beq (Nat.land (Nat.land n1 p2) (Nat.sub (Nat.land n1 p2) 1)) 0 with
      | false => rw [he3] at hres; cases hres
      | true =>
        rw [he3] at hres; dsimp only at hres
        injection hres with h3; subst h3
        have hcomm : p2 &&& n1 = n1 &&& p2 := land_comm_local _ _
        have hsym := resDir_sound h2 h1
          (by rw [land_comm_local]; exact Nat.eq_of_beq_eq_true he2)
          (by rw [hcomm]; exact Nat.ne_of_beq_eq_false he1)
          (by rw [hcomm]; exact Nat.eq_of_beq_eq_true he3)
        rw [lor_comm_local p2 p1, lor_comm_local n2 n1, hcomm] at hsym
        exact hsym

/- ### Part 2: Fixed-depth BTree store -/

inductive BTree (α : Type) where
  | leaf (v : α)
  | node (l r : BTree α)

def BTree.mkD {α : Type} (a : α) : Nat → BTree α
  | 0 => .leaf a
  | d + 1 => let sub := BTree.mkD a d; .node sub sub

def BTree.get {α : Type} : BTree α → Nat → α
  | .leaf v, _ => v
  | .node l r, k =>
    match Nat.beq (Nat.land k 1) 0 with
    | true => l.get (Nat.shiftRight k 1)
    | false => r.get (Nat.shiftRight k 1)

def BTree.set {α : Type} : BTree α → Nat → α → BTree α
  | .leaf _, _, x => .leaf x
  | .node l r, k, x =>
    match Nat.beq (Nat.land k 1) 0 with
    | true => .node (l.set (Nat.shiftRight k 1) x) r
    | false => .node l (r.set (Nat.shiftRight k 1) x)

def BTree.All {α : Type} (P : α → Prop) : BTree α → Prop
  | .leaf v => P v
  | .node l r => l.All P ∧ r.All P

private lemma BTree.all_mkD {α : Type} {P : α → Prop} {a : α} (ha : P a) :
    ∀ d, (BTree.mkD a d).All P
  | 0 => ha
  | d + 1 => ⟨BTree.all_mkD ha d, BTree.all_mkD ha d⟩

private lemma BTree.get_all {α : Type} {P : α → Prop} :
    ∀ (t : BTree α), t.All P → ∀ k, P (t.get k)
  | .leaf v, hv, _ => hv
  | .node l r, ⟨hl, hr⟩, k => by
    unfold BTree.get
    cases Nat.beq (Nat.land k 1) 0
    · exact r.get_all hr _
    · exact l.get_all hl _

private lemma BTree.set_all {α : Type} {P : α → Prop} :
    ∀ (t : BTree α), t.All P → ∀ k x, P x → (t.set k x).All P
  | .leaf _, _, _, _, hx => hx
  | .node l r, ⟨hl, hr⟩, k, x, hx => by
    unfold BTree.set
    cases Nat.beq (Nat.land k 1) 0
    · exact ⟨hl, r.set_all hr _ _ hx⟩
    · exact ⟨l.set_all hl _ _ hx, hr⟩

def filterMaskAux {α : Type} : Nat → List α → List α → List α
  | _, [], acc => acc.reverse
  | m, c :: cs, acc =>
    match Nat.beq (Nat.land m 1) 0 with
    | true => filterMaskAux (Nat.shiftRight m 1) cs acc
    | false => filterMaskAux (Nat.shiftRight m 1) cs (c :: acc)

def filterMask {α : Type} (m : Nat) (cs : List α) : List α :=
  filterMaskAux m cs []

private lemma mem_filterMaskAux {α : Type} :
    ∀ (cs acc : List α) (m : Nat) (x : α),
      x ∈ filterMaskAux m cs acc → x ∈ cs ∨ x ∈ acc
  | [], acc, _, x, hx => by
    simp [filterMaskAux] at hx
    exact Or.inr hx
  | c :: cs, acc, m, x, hx => by
    unfold filterMaskAux at hx
    cases h : Nat.beq (Nat.land m 1) 0
    · rw [h] at hx
      rcases mem_filterMaskAux cs (c :: acc) _ x hx with h1 | h2
      · exact Or.inl (List.mem_cons_of_mem c h1)
      · rcases List.mem_cons.mp h2 with rfl | h3
        · exact Or.inl List.mem_cons_self
        · exact Or.inr h3
    · rw [h] at hx
      rcases mem_filterMaskAux cs acc _ x hx with h1 | h2
      · exact Or.inl (List.mem_cons_of_mem c h1)
      · exact Or.inr h2

private lemma mem_filterMask {α : Type} {m : Nat} {cs : List α} {x : α}
    (hx : x ∈ filterMask m cs) : x ∈ cs := by
  rcases mem_filterMaskAux cs [] m x hx with h | h
  · exact h
  · cases h

def loadTreeAux {α : Type} : BTree α → Nat → List α → BTree α
  | t, _, [] => t
  | t, idx, c :: cs => loadTreeAux (t.set idx c) (idx + 1) cs

private lemma loadTreeAux_all {α : Type} {P : α → Prop} :
    ∀ (cs : List α) (t : BTree α) (idx : Nat),
      t.All P → (∀ c ∈ cs, P c) → (loadTreeAux t idx cs).All P
  | [], _t, _, ht, _ => ht
  | c :: cs, t, idx, ht, hcs =>
    loadTreeAux_all cs (t.set idx c) (idx + 1)
      (t.set_all ht idx c (hcs c List.mem_cons_self))
      (fun x hx => hcs x (List.mem_cons_of_mem c hx))

def loadTree (depth : Nat) (cs : List (Nat × Nat)) : Option (BTree (Nat × Nat)) :=
  match cs with
  | [] => none
  | c0 :: _ => some (loadTreeAux (BTree.mkD c0 depth) 0 cs)

private lemma loadTree_all {P : (Nat × Nat) → Prop} {depth : Nat} {cs : List (Nat × Nat)}
    {t : BTree (Nat × Nat)} (hcs : ∀ c ∈ cs, P c) (hload : loadTree depth cs = some t) :
    t.All P := by
  cases cs with
  | nil => simp [loadTree] at hload
  | cons c0 rest =>
    simp only [loadTree, Option.some.injEq] at hload
    subst hload
    exact loadTreeAux_all (c0 :: rest) (BTree.mkD c0 depth) 0
      (BTree.all_mkD (hcs c0 List.mem_cons_self) depth) hcs

/- ### Part 3: Chunked bit-stream resolution runner -/

inductive BitStream where
  | mk (cur rem : Nat) (chunks : List Nat)

def BitStream.next (bits mask perChunkM1 : Nat) : BitStream → Option (Nat × BitStream)
  | .mk cur rem chunks =>
    match rem with
    | 0 =>
      match chunks with
      | [] => none
      | w :: ws => some (Nat.land w mask, .mk (Nat.shiftRight w bits) perChunkM1 ws)
    | r + 1 =>
      some (Nat.land cur mask, .mk (Nat.shiftRight cur bits) r chunks)

def runChain (bits mask perChunkM1 : Nat) (t : BTree (Nat × Nat)) (st : BitStream)
    (acc : Nat × Nat) (fuel : Nat) : Option ((Nat × Nat) × BitStream) :=
  match fuel with
  | 0 => none
  | f + 1 =>
    match st.next bits mask perChunkM1 with
    | none => none
    | some (tok, st1) =>
      match tok with
      | 0 => some (acc, st1)
      | sl + 1 =>
        match resStep acc (t.get sl) with
        | none => none
        | some acc' => runChain bits mask perChunkM1 t st1 acc' f

private lemma runChain_sound {a : Nat → Bool} {bits mask perChunkM1 : Nat}
    {t : BTree (Nat × Nat)} (ht : t.All (validCl a)) :
    ∀ fuel st acc res st', validCl a acc →
      runChain bits mask perChunkM1 t st acc fuel = some (res, st') → validCl a res
  | 0, _, _, _, _, _, h => by simp [runChain] at h
  | f + 1, st, acc, res, st', hacc, h => by
    unfold runChain at h
    cases hnext : st.next bits mask perChunkM1 with
    | none => rw [hnext] at h; cases h
    | some p =>
      rcases p with ⟨tok, st1⟩
      rw [hnext] at h
      cases tok with
      | zero =>
        simp only at h
        injection h with hEq
        have : acc = res := congrArg Prod.fst hEq
        exact this ▸ hacc
      | succ sl =>
        dsimp only at h
        cases hres : resStep acc (t.get sl) with
        | none => rw [hres] at h; cases h
        | some acc' =>
          rw [hres] at h
          have hacc' : validCl a acc' := resStep_sound hacc (t.get_all ht sl) hres
          exact runChain_sound ht f st1 acc' res st' hacc' h

def runSteps (bits mask perChunkM1 : Nat) (t : BTree (Nat × Nat)) (st : BitStream)
    (steps : Nat) (chainFuel : Nat) : Bool :=
  match steps with
  | 0 => false
  | s + 1 =>
    match st.next bits mask perChunkM1 with
    | none => false
    | some (dstTok, st1) =>
      match dstTok with
      | 0 => false
      | dst + 1 =>
        match st1.next bits mask perChunkM1 with
        | none => false
        | some (firstTok, st2) =>
          match firstTok with
          | 0 => false
          | h0 + 1 =>
            match runChain bits mask perChunkM1 t st2 (t.get h0) chainFuel with
            | none => false
            | some ((p, n), st3) =>
              match Nat.beq p 0, Nat.beq n 0 with
              | true, true => true
              | _, _ => runSteps bits mask perChunkM1 (t.set dst (p, n)) st3 s chainFuel

theorem runSteps_sound {a : Nat → Bool} {bits mask perChunkM1 : Nat} :
    ∀ steps t st cf, t.All (validCl a) →
      runSteps bits mask perChunkM1 t st steps cf = true → False
  | 0, _, _, _, _, h => by simp [runSteps] at h
  | s + 1, t, st, cf, ht, h => by
    unfold runSteps at h
    cases h1 : st.next bits mask perChunkM1 with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rcases p1 with ⟨dstTok, st1⟩
      rw [h1] at h
      cases dstTok with
      | zero => cases h
      | succ dst =>
        dsimp only at h
        cases h2 : st1.next bits mask perChunkM1 with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rcases p2 with ⟨firstTok, st2⟩
          rw [h2] at h
          cases firstTok with
          | zero => cases h
          | succ h0 =>
            dsimp only at h
            cases h3 : runChain bits mask perChunkM1 t st2 (t.get h0) cf with
            | none => rw [h3] at h; cases h
            | some p3 =>
              rcases p3 with ⟨⟨p, n⟩, st3⟩
              rw [h3] at h
              dsimp only at h
              have hcl : validCl a (p, n) := runChain_sound ht cf st2 (t.get h0) (p, n) st3 (t.get_all ht h0) h3
              cases hb1 : Nat.beq p 0 <;> cases hb2 : Nat.beq n 0
              · rw [hb1, hb2] at h; exact runSteps_sound s _ st3 cf (t.set_all ht dst (p, n) hcl) h
              · rw [hb1, hb2] at h; exact runSteps_sound s _ st3 cf (t.set_all ht dst (p, n) hcl) h
              · rw [hb1, hb2] at h; exact runSteps_sound s _ st3 cf (t.set_all ht dst (p, n) hcl) h
              · have hc1 : p = 0 := Nat.eq_of_beq_eq_true hb1
                have hc2 : n = 0 := Nat.eq_of_beq_eq_true hb2
                obtain ⟨v, hv⟩ := hcl.2
                rw [hc1, hc2] at hv
                simp at hv

/- ### Part 4: Ramsey clauses and soundness -/

def HasClique (n mask : Nat) (rows : Fin n → Fin 16 → Bool) : Prop :=
  ∃ (c : Bool) (s : Finset (Fin n)) (t : Finset (Fin 16)),
    s.card + t.card = (if c then 4 else 5) ∧
    (∀ i ∈ s, ∀ j ∈ s, i < j → edgeBit mask i.val j.val = c) ∧
    (∀ i ∈ t, ∀ j ∈ t, i < j → edgeBit g16Mask i.val j.val = c) ∧
    ∀ i ∈ s, ∀ j ∈ t, rows i j = c

def cliquesAux (mask : Nat) (c : Bool) : Nat → Nat → Nat → List Nat → List (List Nat)
  | 0, _, _, acc => [acc.reverse]
  | _ + 1, 0, _, _ => []
  | k + 1, rem + 1, start, acc =>
    let withStart :=
      if acc.all (fun prev => edgeBit mask prev start == c) then
        cliquesAux mask c k rem (start + 1) (start :: acc)
      else []
    withStart ++ cliquesAux mask c (k + 1) rem (start + 1) acc

private lemma cliquesAux_spec (mask : Nat) (c : Bool) :
    ∀ (rem k start : Nat) (acc : List Nat),
      (∀ x ∈ acc, x < start) →
      acc.Pairwise (· > ·) →
      (∀ a ∈ acc, ∀ b ∈ acc, a < b → edgeBit mask a b = c) →
      ∀ L ∈ cliquesAux mask c k rem start acc,
        L.length = acc.length + k ∧
        L.Pairwise (· < ·) ∧
        (∀ x ∈ L, x < start + rem) ∧
        (∀ a ∈ L, ∀ b ∈ L, a < b → edgeBit mask a b = c)
  | rem, 0, start, acc, hlt, hpw, hedge, L, hL => by
    simp only [cliquesAux, List.mem_singleton] at hL
    subst hL
    refine ⟨by simp, ?_, ?_, ?_⟩
    · exact List.pairwise_reverse.mpr (hpw.imp (fun h => h))
    · intro x hx
      rw [List.mem_reverse] at hx
      exact Nat.lt_of_lt_of_le (hlt x hx) (Nat.le_add_right _ _)
    · intro a ha b hb hab
      rw [List.mem_reverse] at ha hb
      exact hedge a ha b hb hab
  | 0, k + 1, start, acc, _, _, _, L, hL => by
    simp [cliquesAux] at hL
  | rem + 1, k + 1, start, acc, hlt, hpw, hedge, L, hL => by
    unfold cliquesAux at hL
    rw [List.mem_append] at hL
    rcases hL with hL1 | hL2
    · split at hL1
      · rename_i hall
        have hall' : ∀ prev ∈ acc, edgeBit mask prev start = c := by
          intro prev hp
          exact beq_iff_eq.mp (List.all_eq_true.mp hall prev hp)
        have hlt' : ∀ x ∈ start :: acc, x < start + 1 := by
          intro x hx
          rcases List.mem_cons.mp hx with rfl | hx'
          · omega
          · exact Nat.lt_trans (hlt x hx') (Nat.lt_succ_self _)
        have hpw' : (start :: acc).Pairwise (· > ·) :=
          List.pairwise_cons.mpr ⟨fun x hx => hlt x hx, hpw⟩
        have hedge' : ∀ a ∈ start :: acc, ∀ b ∈ start :: acc, a < b → edgeBit mask a b = c := by
          intro a ha b hb hab
          rcases List.mem_cons.mp ha with rfl | ha' <;> rcases List.mem_cons.mp hb with rfl | hb'
          · omega
          · have := hlt b hb'; omega
          · exact hall' a ha'
          · exact hedge a ha' b hb' hab
        have hres := cliquesAux_spec mask c rem k (start + 1) (start :: acc) hlt' hpw' hedge' L hL1
        refine ⟨by simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hres.1,
                hres.2.1, ?_, hres.2.2.2⟩
        intro x hx
        have := hres.2.2.1 x hx
        omega
      · cases hL1
    · have hlt' : ∀ x ∈ acc, x < start + 1 := fun x hx => Nat.lt_trans (hlt x hx) (Nat.lt_succ_self _)
      have hres := cliquesAux_spec mask c rem (k + 1) (start + 1) acc hlt' hpw hedge L hL2
      refine ⟨hres.1, hres.2.1, ?_, hres.2.2.2⟩
      intro x hx
      have := hres.2.2.1 x hx
      omega

def rowBits (i : Nat) : List Nat → Nat
  | [] => 0
  | j :: js => Nat.lor (bit (i * 16 + j)) (rowBits i js)

def crossBits : List Nat → List Nat → Nat
  | [], _ => 0
  | i :: is, T => Nat.lor (rowBits i T) (crossBits is T)

private lemma testBit_rowBits (i : Nat) (T : List Nat) (w : Nat) :
    (rowBits i T).testBit w = true ↔ ∃ j ∈ T, i * 16 + j = w := by
  induction T with
  | nil => simp [rowBits]
  | cons j js ih =>
    simp [rowBits, Nat.testBit_or, testBit_bit, ih]

private lemma testBit_crossBits (S T : List Nat) (w : Nat) :
    (crossBits S T).testBit w = true ↔ ∃ i ∈ S, ∃ j ∈ T, i * 16 + j = w := by
  induction S with
  | nil => simp [crossBits]
  | cons i is ih =>
    simp [crossBits, Nat.testBit_or, testBit_rowBits, ih]

def ramseyColorClauses (n mask : Nat) (c : Bool) (sizes : List (Nat × Nat)) : List (Nat × Nat) :=
  sizes.flatMap fun (sl, tl) =>
    let ss := cliquesAux mask c sl n 0 []
    let ts := cliquesAux g16Mask c tl 16 0 []
    ss.flatMap fun S =>
      ts.map fun T =>
        let bits := crossBits S T
        if c then (0, bits) else (bits, 0)

def ramseyClauses (n mask : Nat) : List (Nat × Nat) :=
  ramseyColorClauses n mask true [(1, 3), (2, 2), (3, 1)] ++
  ramseyColorClauses n mask false [(1, 4), (2, 3), (3, 2), (4, 1)]

private lemma list_to_finset_fin {n : Nat} {L : List Nat}
    (hpw : L.Pairwise (· < ·)) (hlt : ∀ x ∈ L, x < n) :
    ∃ s : Finset (Fin n), s.card = L.length ∧ ∀ x : Fin n, x ∈ s ↔ x.val ∈ L := by
  let Lf : List (Fin n) := L.pmap (fun x hx => ⟨x, hx⟩) hlt
  have hnodupL : L.Nodup := hpw.imp (fun h => Nat.ne_of_lt h)
  have hnodupF : Lf.Nodup := by
    refine List.Nodup.pmap (fun a _ b _ h => congrArg Fin.val h) hnodupL
  refine ⟨Lf.toFinset, ?_, ?_⟩
  · rw [List.toFinset_card_of_nodup hnodupF, List.length_pmap]
  · intro x
    simp only [List.mem_toFinset, Lf, List.mem_pmap]
    constructor
    · rintro ⟨a, ha, hax⟩
      have : a = x.val := congrArg Fin.val hax
      exact this ▸ ha
    · intro hx
      exact ⟨x.val, hx, Fin.ext rfl⟩

private lemma ramseyColorClauses_sound {n mask : Nat} {rows : Fin n → Fin 16 → Bool}
    {a : Nat → Bool} (ha : ∀ (i : Fin n) (j : Fin 16), a (i.val * 16 + j.val) = rows i j)
    (hNo : ¬ HasClique n mask rows) (c : Bool) (sizes : List (Nat × Nat))
    (hsizes : ∀ p ∈ sizes, p.1 + p.2 = if c then 4 else 5) :
    ∀ cl ∈ ramseyColorClauses n mask c sizes, validCl a cl ∧ allBitsBelow (n * 16) cl := by
  intro cl hcl
  unfold ramseyColorClauses at hcl
  rw [List.mem_flatMap] at hcl
  rcases hcl with ⟨⟨sl, tl⟩, hst, hcl1⟩
  rw [List.mem_flatMap] at hcl1
  rcases hcl1 with ⟨S, hS, hcl2⟩
  rw [List.mem_map] at hcl2
  rcases hcl2 with ⟨T, hT, rfl⟩
  have hSspec := cliquesAux_spec mask c n sl 0 [] (by simp) (by simp) (by simp) S hS
  have hTspec := cliquesAux_spec g16Mask c 16 tl 0 [] (by simp) (by simp) (by simp) T hT
  have hSlt : ∀ x ∈ S, x < n := by simpa using hSspec.2.2.1
  have hTlt : ∀ x ∈ T, x < 16 := by simpa using hTspec.2.2.1
  obtain ⟨s, hscard, hsmem⟩ := list_to_finset_fin hSspec.2.1 hSlt
  obtain ⟨t, htcard, htmem⟩ := list_to_finset_fin hTspec.2.1 hTlt
  have hcard : s.card + t.card = if c then 4 else 5 := by
    rw [hscard, htcard, hSspec.1, hTspec.1]
    simpa using hsizes (sl, tl) hst
  have hsEdge : ∀ i ∈ s, ∀ j ∈ s, i < j → edgeBit mask i.val j.val = c := by
    intro i hi j hj hij
    exact hSspec.2.2.2 i.val ((hsmem i).mp hi) j.val ((hsmem j).mp hj) hij
  have htEdge : ∀ i ∈ t, ∀ j ∈ t, i < j → edgeBit g16Mask i.val j.val = c := by
    intro i hi j hj hij
    exact hTspec.2.2.2 i.val ((htmem i).mp hi) j.val ((htmem j).mp hj) hij
  have hNotAll : ¬ (∀ i ∈ s, ∀ j ∈ t, rows i j = c) := fun hcross =>
    hNo ⟨c, s, t, hcard, hsEdge, htEdge, hcross⟩
  push Not at hNotAll
  obtain ⟨i, hi, j, hj, hne⟩ := hNotAll
  have hbit : (crossBits S T).testBit (i.val * 16 + j.val) = true :=
    (testBit_crossBits S T _).mpr ⟨i.val, (hsmem i).mp hi, j.val, (htmem j).mp hj, rfl⟩
  have hbelow : ∀ v, (crossBits S T).testBit v = true → v < n * 16 := by
    intro v hv
    obtain ⟨x, hx, y, hy, rfl⟩ := (testBit_crossBits S T v).mp hv
    have hx' := hSlt x hx
    have hy' := hTlt y hy
    omega
  cases c
  · refine ⟨⟨by simp, ⟨i.val * 16 + j.val, Or.inl ⟨hbit, ?_⟩⟩⟩, ?_⟩
    · rw [ha i j]
      cases h : rows i j
      · exact (hne h).elim
      · rfl
    · intro v hv
      rcases hv with h1 | h2
      · exact hbelow v h1
      · simp at h2
  · refine ⟨⟨by simp, ⟨i.val * 16 + j.val, Or.inr ⟨hbit, ?_⟩⟩⟩, ?_⟩
    · rw [ha i j]
      cases h : rows i j
      · rfl
      · exact (hne h).elim
    · intro v hv
      rcases hv with h1 | h2
      · simp at h1
      · exact hbelow v h2

private lemma ramseyClauses_sound {n mask : Nat} {rows : Fin n → Fin 16 → Bool}
    {a : Nat → Bool} (ha : ∀ (i : Fin n) (j : Fin 16), a (i.val * 16 + j.val) = rows i j)
    (hNo : ¬ HasClique n mask rows) :
    ∀ cl ∈ ramseyClauses n mask, validCl a cl ∧ allBitsBelow (n * 16) cl := by
  intro cl hcl
  unfold ramseyClauses at hcl
  rw [List.mem_append] at hcl
  rcases hcl with h1 | h2
  · exact ramseyColorClauses_sound ha hNo true _ (by decide) cl h1
  · exact ramseyColorClauses_sound ha hNo false _ (by decide) cl h2

/- ### Part 5: Automorphisms, lex-MAX orbit representative, and Tseitin symmetry clauses -/

def IsAuto (n mask : Nat) (p : Fin n → Fin n) : Prop :=
  Function.Injective p ∧
  ∀ i j : Fin n, i ≠ j → symEdge mask (p i).val (p j).val = symEdge mask i.val j.val

private lemma isAuto_id (n mask : Nat) : IsAuto n mask id :=
  ⟨Function.injective_id, fun _ _ _ => rfl⟩

private lemma isAuto_comp {n mask : Nat} {p q : Fin n → Fin n}
    (hp : IsAuto n mask p) (hq : IsAuto n mask q) : IsAuto n mask (p ∘ q) :=
  ⟨hp.1.comp hq.1, fun i j hij => by
    show symEdge mask (p (q i)).val (p (q j)).val = symEdge mask i.val j.val
    rw [hp.2 (q i) (q j) (fun h => hij (hq.1 h)), hq.2 i j hij]⟩

private lemma hasClique_of_auto {n mask : Nat} {rows : Fin n → Fin 16 → Bool}
    {al : Fin n → Fin n} {ag : Fin 16 → Fin 16}
    (hal : IsAuto n mask al) (hag : IsAuto 16 g16Mask ag)
    (h : HasClique n mask (fun i j => rows (al i) (ag j))) :
    HasClique n mask rows := by
  classical
  obtain ⟨c, s, t, hcard, hs, ht, hcross⟩ := h
  refine ⟨c, s.image al, t.image ag, ?_, ?_, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hal.1, Finset.card_image_of_injective _ hag.1]
    exact hcard
  · intro x hx y hy hxy
    rcases Finset.mem_image.mp hx with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hy with ⟨j, hj, rfl⟩
    have hne : i ≠ j := fun heq => by subst heq; exact lt_irrefl _ hxy
    have h1 : edgeBit mask (al i).val (al j).val = symEdge mask (al i).val (al j).val := by
      simp [symEdge, show (al i).val < (al j).val from hxy]
    rw [h1, hal.2 i j hne]
    rcases lt_or_gt_of_ne hne with hij | hji
    · simpa [symEdge, show i.val < j.val from hij] using hs i hi j hj hij
    · have hnot : ¬ (i.val < j.val) := by omega
      simpa [symEdge, hnot] using hs j hj i hi hji
  · intro x hx y hy hxy
    rcases Finset.mem_image.mp hx with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hy with ⟨j, hj, rfl⟩
    have hne : i ≠ j := fun heq => by subst heq; exact lt_irrefl _ hxy
    have h1 : edgeBit g16Mask (ag i).val (ag j).val = symEdge g16Mask (ag i).val (ag j).val := by
      simp [symEdge, show (ag i).val < (ag j).val from hxy]
    rw [h1, hag.2 i j hne]
    rcases lt_or_gt_of_ne hne with hij | hji
    · simpa [symEdge, show i.val < j.val from hij] using ht i hi j hj hij
    · have hnot : ¬ (i.val < j.val) := by omega
      simpa [symEdge, hnot] using ht j hj i hi hji
  · intro x hx y hy
    rcases Finset.mem_image.mp hx with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hy with ⟨j, hj, rfl⟩
    exact hcross i hi j hj

def colOrderNat (n : Nat) : List (Nat × Nat) :=
  (List.range 16).flatMap (fun j => (List.range n).map (fun i => (i, j)))

private lemma mem_colOrderNat {n : Nat} {p : Nat × Nat} (hp : p ∈ colOrderNat n) :
    p.1 < n ∧ p.2 < 16 := by
  unfold colOrderNat at hp
  rw [List.mem_flatMap] at hp
  rcases hp with ⟨j, hj, hp1⟩
  rw [List.mem_map] at hp1
  rcases hp1 with ⟨i, hi, rfl⟩
  exact ⟨List.mem_range.mp hi, List.mem_range.mp hj⟩

def lexValNat (r : Nat → Nat → Bool) : List (Nat × Nat) → Nat
  | [] => 0
  | (i, j) :: rest => (if r i j then 2 ^ rest.length else 0) + lexValNat r rest

private lemma lexValNat_lt (r : Nat → Nat → Bool) :
    ∀ L : List (Nat × Nat), lexValNat r L < 2 ^ L.length
  | [] => by simp [lexValNat]
  | (i, j) :: rest => by
    have ih := lexValNat_lt r rest
    simp only [lexValNat, List.length_cons, pow_succ']
    cases r i j <;> simp <;> omega

private lemma lexValNat_head_ge {r1 r2 : Nat → Nat → Bool} {i j : Nat} {rest : List (Nat × Nat)}
    (hge : lexValNat r2 ((i, j) :: rest) ≤ lexValNat r1 ((i, j) :: rest)) :
    r2 i j = true → r1 i j = true := by
  intro hr2
  have h1 := lexValNat_lt r1 rest
  cases hr1 : r1 i j
  · simp [lexValNat, hr1, hr2] at hge
    omega
  · rfl

private lemma lexValNat_tail_ge {r1 r2 : Nat → Nat → Bool} {i j : Nat} {rest : List (Nat × Nat)}
    (hge : lexValNat r2 ((i, j) :: rest) ≤ lexValNat r1 ((i, j) :: rest))
    (heq : r1 i j = r2 i j) :
    lexValNat r2 rest ≤ lexValNat r1 rest := by
  simp only [lexValNat, heq] at hge
  omega

def extendRows (n : Nat) (rows : Fin n → Fin 16 → Bool) (i j : Nat) : Bool :=
  if h : i < n ∧ j < 16 then rows ⟨i, h.1⟩ ⟨j, h.2⟩ else false

private lemma exists_lexmax_orbit (n mask : Nat) (rows : Fin n → Fin 16 → Bool) :
    ∃ rows' : Fin n → Fin 16 → Bool,
      (HasClique n mask rows' → HasClique n mask rows) ∧
      ∀ (al : Fin n → Fin n) (ag : Fin 16 → Fin 16),
        IsAuto n mask al → IsAuto 16 g16Mask ag →
        lexValNat (extendRows n (fun i j => rows' (al i) (ag j))) (colOrderNat n) ≤
        lexValNat (extendRows n rows') (colOrderNat n) := by
  classical
  let S : Finset ((Fin n → Fin n) × (Fin 16 → Fin 16)) :=
    Finset.univ.filter (fun p => IsAuto n mask p.1 ∧ IsAuto 16 g16Mask p.2)
  have hne : S.Nonempty := ⟨(id, id), Finset.mem_filter.mpr ⟨Finset.mem_univ _, isAuto_id n mask, isAuto_id 16 g16Mask⟩⟩
  let f : ((Fin n → Fin n) × (Fin 16 → Fin 16)) → Nat :=
    fun p => lexValNat (extendRows n (fun i j => rows (p.1 i) (p.2 j))) (colOrderNat n)
  obtain ⟨⟨al0, ag0⟩, hmem, hmax⟩ := Finset.exists_max_image S f hne
  have hauto0 : IsAuto n mask al0 ∧ IsAuto 16 g16Mask ag0 := (Finset.mem_filter.mp hmem).2
  refine ⟨fun i j => rows (al0 i) (ag0 j), fun hc => hasClique_of_auto hauto0.1 hauto0.2 hc, ?_⟩
  intro al ag hal hag
  have h1 : IsAuto n mask (al0 ∘ al) := isAuto_comp hauto0.1 hal
  have h2 : IsAuto 16 g16Mask (ag0 ∘ ag) := isAuto_comp hauto0.2 hag
  have hmem' : (al0 ∘ al, ag0 ∘ ag) ∈ S :=
    Finset.mem_filter.mpr ⟨Finset.mem_univ _, h1, h2⟩
  exact hmax (al0 ∘ al, ag0 ∘ ag) hmem'

def getAt (p : List Nat) (i : Nat) : Nat := p.getD i 0

def checkAuto (n mask : Nat) (p : List Nat) : Bool :=
  (List.range n).all (fun i =>
    decide (getAt p i < n) &&
    (List.range n).all (fun j =>
      if i == j then true
      else decide (getAt p i != getAt p j) && (symEdge mask (getAt p i) (getAt p j) == symEdge mask i j)))

private lemma checkAuto_lt {n mask : Nat} {p : List Nat} (hc : checkAuto n mask p = true)
    {i : Nat} (hi : i < n) : getAt p i < n := by
  unfold checkAuto at hc
  have h1 := List.all_eq_true.mp hc i (List.mem_range.mpr hi)
  rw [Bool.and_eq_true] at h1
  exact of_decide_eq_true h1.1

private lemma checkAuto_isAuto {n mask : Nat} {p : List Nat} (hc : checkAuto n mask p = true) :
    IsAuto n mask (fun i => ⟨getAt p i.val, checkAuto_lt hc i.isLt⟩) := by
  have hpair : ∀ i j : Fin n, i ≠ j →
      getAt p i.val ≠ getAt p j.val ∧
      symEdge mask (getAt p i.val) (getAt p j.val) = symEdge mask i.val j.val := by
    intro i j hij
    unfold checkAuto at hc
    have h1 := List.all_eq_true.mp hc i.val (List.mem_range.mpr i.isLt)
    rw [Bool.and_eq_true] at h1
    have h2 := List.all_eq_true.mp h1.2 j.val (List.mem_range.mpr j.isLt)
    have hne : (i.val == j.val) = false := beq_false_of_ne (fun h => hij (Fin.ext h))
    rw [hne] at h2
    simp only [Bool.false_eq_true, ↓reduceIte, Bool.and_eq_true, bne_iff_ne, decide_eq_true_eq,
      beq_iff_eq] at h2
    exact h2
  refine ⟨fun i j hij => ?_, fun i j hij => (hpair i j hij).2⟩
  by_contra hne
  exact (hpair i j hne).1 (congrArg Fin.val hij)

def diffPairsAux (al ag : List Nat) : List (Nat × Nat) → Nat → List (Nat × Nat)
  | [], _ => []
  | (i, j) :: rest, d =>
    match d with
    | 0 => []
    | d' + 1 =>
      let u := i * 16 + j
      let v := getAt al i * 16 + getAt ag j
      if u == v then diffPairsAux al ag rest (d' + 1)
      else (u, v) :: diffPairsAux al ag rest d'

def symChainClauses : Option Nat → List (Nat × Nat) → Nat → List (Nat × Nat) × Nat
  | _, [], nv => ([], nv)
  | prev, (u, v) :: rest, nv =>
    let pneg := match prev with | none => 0 | some e => bit e
    let cIneq := (bit u, Nat.lor pneg (bit v))
    match rest with
    | [] => ([cIneq], nv)
    | _ :: _ =>
      let e := nv
      let cEq1 := (bit e, Nat.lor (Nat.lor pneg (bit u)) (bit v))
      let cEq2 := (Nat.lor (Nat.lor (bit u) (bit v)) (bit e), pneg)
      let (more, nv') := symChainClauses (some e) rest (nv + 1)
      (cIneq :: cEq1 :: cEq2 :: more, nv')

def symClausesAux (n : Nat) (autsL autsG : List (List Nat)) :
    List (Nat × Nat × Nat) → Nat → List (Nat × Nat)
  | [], _ => []
  | (ai, gi, d) :: specs, nv =>
    let al := autsL.getD ai []
    let ag := autsG.getD gi []
    let pairs := diffPairsAux al ag (colOrderNat n) d
    let (cls, nv') := symChainClauses none pairs nv
    cls ++ symClausesAux n autsL autsG specs nv'

private lemma validCl_agree {a a' : Nat → Bool} {nv : Nat} {c : Nat × Nat}
    (hv : validCl a c) (hb : allBitsBelow nv c) (hagree : ∀ v < nv, a' v = a v) :
    validCl a' c := by
  refine ⟨hv.1, ?_⟩
  obtain ⟨v, hw⟩ := hv.2
  refine ⟨v, ?_⟩
  rcases hw with ⟨hp, ha⟩ | ⟨hn, ha⟩
  · left; exact ⟨hp, by rw [hagree v (hb v (Or.inl hp)), ha]⟩
  · right; exact ⟨hn, by rw [hagree v (hb v (Or.inr hn)), ha]⟩

private lemma land_bit_zero_of_ne {u v : Nat} (hne : u ≠ v) : bit u &&& bit v = 0 := by
  apply Nat.eq_of_testBit_eq
  intro w
  rw [Nat.testBit_and, testBit_bit, testBit_bit, Nat.zero_testBit]
  by_cases hu : u = w
  · subst hu; simp [hne.symm]
  · simp [hu]

private lemma land_bit_lor {x y z : Nat} (h1 : x &&& y = 0) (h2 : x &&& z = 0) :
    x &&& (y ||| z) = 0 := by
  apply Nat.eq_of_testBit_eq
  intro w
  have h1' : (x &&& y).testBit w = false := by rw [h1]; simp
  have h2' : (x &&& z).testBit w = false := by rw [h2]; simp
  rw [Nat.testBit_and, Nat.testBit_or, Nat.zero_testBit]
  rw [Nat.testBit_and] at h1' h2'
  revert h1' h2'
  cases x.testBit w <;> cases y.testBit w <;> cases z.testBit w <;> simp

private lemma land_lor_bit {x y z : Nat} (h1 : x &&& z = 0) (h2 : y &&& z = 0) :
    (x ||| y) &&& z = 0 := by
  rw [land_comm_local]
  exact land_bit_lor (by rw [land_comm_local]; exact h1) (by rw [land_comm_local]; exact h2)

private lemma symChainClauses_sound {n : Nat} {al ag : List Nat}
    (hal : ∀ i < n, getAt al i < n) (hag : ∀ j < 16, getAt ag j < 16)
    {r1 r2 : Nat → Nat → Bool} :
    ∀ (L : List (Nat × Nat)) (d : Nat) (prev : Option Nat) (nv : Nat)
      (a : Nat → Bool) (prefOk : Bool),
      n * 16 ≤ nv →
      (∀ (i : Nat) (j : Nat), i < n → j < 16 →
        a (i * 16 + j) = r1 i j ∧ a (getAt al i * 16 + getAt ag j) = r2 i j) →
      (∀ p ∈ L, p.1 < n ∧ p.2 < 16) →
      (prev = none → prefOk = true) →
      (∀ p, prev = some p → p < nv ∧ n * 16 ≤ p ∧ a p = prefOk) →
      (prefOk = true → lexValNat r2 L ≤ lexValNat r1 L) →
      let res := symChainClauses prev (diffPairsAux al ag L d) nv
      nv ≤ res.2 ∧
      ∃ a' : Nat → Bool,
        (∀ v < nv, a' v = a v) ∧
        ∀ cl ∈ res.1, validCl a' cl ∧ allBitsBelow res.2 cl := by
  intro L
  induction L with
  | nil =>
    intro d prev nv a prefOk _ _ _ _ _ _
    simp only [diffPairsAux, symChainClauses]
    exact ⟨le_rfl, a, fun _ _ => rfl, by simp⟩
  | cons ij rest ih =>
    rcases ij with ⟨i, j⟩
    intro d prev nv a prefOk hnv ha hL hnone hsome hlex
    have hij : i < n ∧ j < 16 := hL (i, j) List.mem_cons_self
    have hrest : ∀ p ∈ rest, p.1 < n ∧ p.2 < 16 := fun p hp => hL p (List.mem_cons_of_mem _ hp)
    cases d with
    | zero =>
      simp only [diffPairsAux, symChainClauses]
      exact ⟨le_rfl, a, fun _ _ => rfl, by simp⟩
    | succ d' =>
      simp only [diffPairsAux]
      set u := i * 16 + j
      set v := getAt al i * 16 + getAt ag j
      have hu_lt : u < n * 16 := by have := hij.1; have := hij.2; omega
      have hv_lt : v < n * 16 := by
        have := hal i hij.1; have := hag j hij.2; omega
      have hau : a u = r1 i j := (ha i j hij.1 hij.2).1
      have hav : a v = r2 i j := (ha i j hij.1 hij.2).2
      by_cases huv : u = v
      · simp only [beq_iff_eq, huv, ↓reduceIte]
        have hreq : r1 i j = r2 i j := by rw [← hau, ← hav, huv]
        exact ih (d' + 1) prev nv a prefOk hnv ha hrest hnone hsome
          (fun hp => lexValNat_tail_ge (hlex hp) hreq)
      · have hbeq : (u == v) = false := beq_false_of_ne huv
        simp only [hbeq, Bool.false_eq_true, ↓reduceIte]
        unfold symChainClauses
        set pneg := match prev with | none => 0 | some e => bit e
        set cIneq := (bit u, Nat.lor pneg (bit v))
        have hpneg_lt : ∀ w, pneg.testBit w = true → w < nv := by
          intro w hw
          cases prev with
          | none => simp [pneg] at hw
          | some p =>
            simp only [pneg, testBit_bit, decide_eq_true_eq] at hw
            subst hw; exact (hsome p rfl).1
        have hpneg_u : bit u &&& pneg = 0 := by
          cases prev with
          | none => simp [pneg]
          | some p =>
            have hpge := (hsome p rfl).2.1
            exact land_bit_zero_of_ne (by omega)
        have hcIneq_below : allBitsBelow nv cIneq := by
          intro w hw
          rcases hw with h1 | h2
          · simp only [cIneq, testBit_bit, decide_eq_true_eq] at h1; omega
          · simp only [cIneq, testBit_lor, testBit_bit, Bool.or_eq_true, decide_eq_true_eq] at h2
            rcases h2 with h2a | rfl
            · exact hpneg_lt w h2a
            · omega
        have hcIneq_valid : validCl a cIneq := by
          refine ⟨land_bit_lor hpneg_u (land_bit_zero_of_ne huv), ?_⟩
          cases hpok : prefOk
          · cases prev with
            | none => have := hnone rfl; rw [hpok] at this; cases this
            | some p =>
              refine ⟨p, Or.inr ⟨?_, (hsome p rfl).2.2.trans hpok⟩⟩
              simp [cIneq, pneg, Nat.testBit_or, testBit_bit]
          · have hge := lexValNat_head_ge (hlex hpok)
            cases hrv : a v
            · exact ⟨v, Or.inr ⟨by simp [cIneq, Nat.testBit_or, testBit_bit], hrv⟩⟩
            · have hr2 : r2 i j = true := hav.symm.trans hrv
              have hr1 : r1 i j = true := hge hr2
              exact ⟨u, Or.inl ⟨by simp [cIneq, testBit_bit], hau.trans hr1⟩⟩
        cases htail : diffPairsAux al ag rest d' with
        | nil =>
          dsimp only
          refine ⟨le_rfl, a, fun _ _ => rfl, ?_⟩
          intro cl hcl
          simp only [List.mem_singleton] at hcl
          subst hcl
          exact ⟨hcIneq_valid, hcIneq_below⟩
        | cons hd tl =>
          dsimp only
          set e := nv
          set cEq1 := (bit e, Nat.lor (Nat.lor pneg (bit u)) (bit v))
          set cEq2 := (Nat.lor (Nat.lor (bit u) (bit v)) (bit e), pneg)
          let prefOk' : Bool := prefOk && (a u == a v)
          let a1 : Nat → Bool := fun w => if w = e then prefOk' else a w
          have ha1_lt : ∀ w < nv, a1 w = a w := fun w hw => if_neg (by omega)
          have ha1_e : a1 e = prefOk' := if_pos rfl
          have ha1_rows : ∀ (i' j' : Nat), i' < n → j' < 16 →
              a1 (i' * 16 + j') = r1 i' j' ∧ a1 (getAt al i' * 16 + getAt ag j') = r2 i' j' := by
            intro i' j' hi' hj'
            have h1 : i' * 16 + j' < nv := by omega
            have h2 : getAt al i' * 16 + getAt ag j' < nv := by
              have := hal i' hi'; have := hag j' hj'; omega
            rw [ha1_lt _ h1, ha1_lt _ h2]
            exact ha i' j' hi' hj'
          have hlex' : prefOk' = true → lexValNat r2 rest ≤ lexValNat r1 rest := by
            intro hp'
            simp only [prefOk', Bool.and_eq_true, beq_iff_eq] at hp'
            exact lexValNat_tail_ge (hlex hp'.1) (by rw [← hau, ← hav, hp'.2])
          have hrec := ih d' (some e) (nv + 1) a1 prefOk' (by omega) ha1_rows hrest
            (by intro h; cases h)
            (fun p hp => by
              injection hp with hpe; subst hpe
              exact ⟨Nat.lt_succ_self _, hnv, ha1_e⟩)
            hlex'
          rw [htail] at hrec
          set sub := symChainClauses (some e) (hd :: tl) (nv + 1)
          have hnv_le : nv + 1 ≤ sub.2 := hrec.1
          obtain ⟨a', ha'agree, hsub⟩ := hrec.2
          have ha'_lt : ∀ w < nv, a' w = a w := fun w hw =>
            (ha'agree w (by omega)).trans (ha1_lt w hw)
          have ha'_e : a' e = prefOk' := (ha'agree e (Nat.lt_succ_self _)).trans ha1_e
          have hpneg_e : bit e &&& pneg = 0 := by
            cases prev with
            | none => simp [pneg]
            | some p => exact land_bit_zero_of_ne (by have := (hsome p rfl).1; omega)
          have hpneg_v : bit v &&& pneg = 0 := by
            cases prev with
            | none => simp [pneg]
            | some p => exact land_bit_zero_of_ne (by have := (hsome p rfl).2.1; omega)
          have hcEq1_valid : validCl a' cEq1 := by
            refine ⟨land_bit_lor (land_bit_lor hpneg_e (land_bit_zero_of_ne (by omega)))
                     (land_bit_zero_of_ne (by omega)), ?_⟩
            cases hpok : prefOk
            · cases prev with
              | none => have := hnone rfl; rw [hpok] at this; cases this
              | some p =>
                refine ⟨p, Or.inr ⟨by simp [cEq1, pneg, Nat.testBit_or, testBit_bit],
                  (ha'_lt p (hsome p rfl).1).trans ((hsome p rfl).2.2.trans hpok)⟩⟩
            · cases h1 : a u
              · exact ⟨u, Or.inr ⟨by simp [cEq1, Nat.testBit_or, testBit_bit],
                  (ha'_lt u (by omega)).trans h1⟩⟩
              · cases h2 : a v
                · exact ⟨v, Or.inr ⟨by simp [cEq1, Nat.testBit_or, testBit_bit],
                    (ha'_lt v (by omega)).trans h2⟩⟩
                · exact ⟨e, Or.inl ⟨by simp [cEq1, testBit_bit], by simp [ha'_e, prefOk', hpok, h1, h2]⟩⟩
          have hcEq2_valid : validCl a' cEq2 := by
            refine ⟨land_lor_bit (land_lor_bit hpneg_u hpneg_v) hpneg_e, ?_⟩
            cases hpok : prefOk
            · cases prev with
              | none => have := hnone rfl; rw [hpok] at this; cases this
              | some p =>
                refine ⟨p, Or.inr ⟨by simp [cEq2, pneg, testBit_bit],
                  (ha'_lt p (hsome p rfl).1).trans ((hsome p rfl).2.2.trans hpok)⟩⟩
            · cases h1 : a u
              · cases h2 : a v
                · exact ⟨e, Or.inl ⟨by simp [cEq2, Nat.testBit_or, testBit_bit],
                    by simp [ha'_e, prefOk', hpok, h1, h2]⟩⟩
                · exact ⟨v, Or.inl ⟨by simp [cEq2, Nat.testBit_or, testBit_bit],
                    (ha'_lt v (by omega)).trans h2⟩⟩
              · exact ⟨u, Or.inl ⟨by simp [cEq2, Nat.testBit_or, testBit_bit],
                  (ha'_lt u (by omega)).trans h1⟩⟩
          have hcEq1_below : allBitsBelow sub.2 cEq1 := by
            intro w hw
            rcases hw with h1 | h2
            · simp only [cEq1, testBit_bit, decide_eq_true_eq] at h1; omega
            · simp only [cEq1, testBit_lor, testBit_bit, Bool.or_eq_true, decide_eq_true_eq] at h2
              rcases h2 with (h2a | rfl) | rfl
              · have := hpneg_lt w h2a; omega
              · omega
              · omega
          have hcEq2_below : allBitsBelow sub.2 cEq2 := by
            intro w hw
            rcases hw with h1 | h2
            · simp only [cEq2, testBit_lor, testBit_bit, Bool.or_eq_true, decide_eq_true_eq] at h1
              rcases h1 with (rfl | rfl) | rfl <;> omega
            · have := hpneg_lt w h2; omega
          refine ⟨by omega, a', ha'_lt, ?_⟩
          intro cl hcl
          rcases List.mem_cons.mp hcl with rfl | hcl1
          · exact ⟨validCl_agree hcIneq_valid hcIneq_below ha'_lt,
                   fun w hw => Nat.lt_of_lt_of_le (hcIneq_below w hw) (by omega)⟩
          · rcases List.mem_cons.mp hcl1 with rfl | hcl2
            · exact ⟨hcEq1_valid, hcEq1_below⟩
            · rcases List.mem_cons.mp hcl2 with rfl | hcl3
              · exact ⟨hcEq2_valid, hcEq2_below⟩
              · exact hsub cl hcl3

private lemma symClausesAux_sound {n mask : Nat}
    {rows : Fin n → Fin 16 → Bool}
    (hLex : ∀ (al : Fin n → Fin n) (ag : Fin 16 → Fin 16),
      IsAuto n mask al → IsAuto 16 g16Mask ag →
      lexValNat (extendRows n (fun i j => rows (al i) (ag j))) (colOrderNat n) ≤
      lexValNat (extendRows n rows) (colOrderNat n))
    {autsL autsG : List (List Nat)}
    (hAutsL : autsL.all (checkAuto n mask) = true)
    (hAutsG : autsG.all (checkAuto 16 g16Mask) = true) :
    ∀ (specs : List (Nat × Nat × Nat)) (nv : Nat) (a : Nat → Bool),
      n * 16 ≤ nv →
      (∀ (i : Fin n) (j : Fin 16), a (i.val * 16 + j.val) = rows i j) →
      (∀ sp ∈ specs, sp.1 < autsL.length ∧ sp.2.1 < autsG.length) →
      ∃ a' : Nat → Bool,
        (∀ v < nv, a' v = a v) ∧
        ∀ cl ∈ symClausesAux n autsL autsG specs nv, validCl a' cl := by
  intro specs
  induction specs with
  | nil =>
    intro nv a _ _ _
    exact ⟨a, fun _ _ => rfl, by simp [symClausesAux]⟩
  | cons sp rest ih =>
    rcases sp with ⟨ai, gi, d⟩
    intro nv a hnv ha hsp
    have hbd := hsp (ai, gi, d) List.mem_cons_self
    have hrest : ∀ s ∈ rest, s.1 < autsL.length ∧ s.2.1 < autsG.length :=
      fun s hs => hsp s (List.mem_cons_of_mem _ hs)
    have hal_mem : autsL.getD ai [] ∈ autsL := by
      simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hbd.1, Option.getD_some]
      exact List.getElem_mem hbd.1
    have hag_mem : autsG.getD gi [] ∈ autsG := by
      simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hbd.2, Option.getD_some]
      exact List.getElem_mem hbd.2
    have hal_chk : checkAuto n mask (autsL.getD ai []) = true :=
      List.all_eq_true.mp hAutsL _ hal_mem
    have hag_chk : checkAuto 16 g16Mask (autsG.getD gi []) = true :=
      List.all_eq_true.mp hAutsG _ hag_mem
    let alFn : Fin n → Fin n := fun i => ⟨getAt (autsL.getD ai []) i.val, checkAuto_lt hal_chk i.isLt⟩
    let agFn : Fin 16 → Fin 16 := fun j => ⟨getAt (autsG.getD gi []) j.val, checkAuto_lt hag_chk j.isLt⟩
    have hlex1 := hLex alFn agFn (checkAuto_isAuto hal_chk) (checkAuto_isAuto hag_chk)
    have ha_ext : ∀ i j, i < n → j < 16 →
        a (i * 16 + j) = extendRows n rows i j ∧
        a (getAt (autsL.getD ai []) i * 16 + getAt (autsG.getD gi []) j) =
          extendRows n (fun i' j' => rows (alFn i') (agFn j')) i j := by
      intro i j hi hj
      constructor
      · simp [extendRows, hi, hj, ha ⟨i, hi⟩ ⟨j, hj⟩]
      · simp only [extendRows, hi, hj, and_self, ↓reduceDIte]
        exact ha (alFn ⟨i, hi⟩) (agFn ⟨j, hj⟩)
    have hchain := symChainClauses_sound
      (fun i hi => checkAuto_lt hal_chk hi)
      (fun j hj => checkAuto_lt hag_chk hj)
      (colOrderNat n) d none nv a true hnv ha_ext
      (fun p hp => mem_colOrderNat hp)
      (fun _ => rfl) (fun p hp => by cases hp) (fun _ => hlex1)
    set res := symChainClauses none (diffPairsAux (autsL.getD ai []) (autsG.getD gi []) (colOrderNat n) d) nv
    have hnv_le : nv ≤ res.2 := hchain.1
    obtain ⟨a1, ha1_agree, hcls1⟩ := hchain.2
    have ha1_rows : ∀ (i : Fin n) (j : Fin 16), a1 (i.val * 16 + j.val) = rows i j := by
      intro i j
      have hlt : i.val * 16 + j.val < nv := by have := i.isLt; have := j.isLt; omega
      rw [ha1_agree _ hlt, ha i j]
    obtain ⟨a2, ha2_agree, hcls2⟩ := ih res.2 a1 (le_trans hnv hnv_le) ha1_rows hrest
    refine ⟨a2, fun v hv => (ha2_agree v (lt_of_lt_of_le hv hnv_le)).trans (ha1_agree v hv), ?_⟩
    intro cl hcl
    unfold symClausesAux at hcl
    rw [List.mem_append] at hcl
    rcases hcl with h1 | h2
    · exact validCl_agree (hcls1 cl h1).1 (hcls1 cl h1).2 ha2_agree
    · exact hcls2 cl h2

/- ### Part 6: End-to-end refutation and lifting -/

def checkInstance (n mask depth tokBits tokMask perChunkM1 steps chainFuel : Nat)
    (autsL autsG : List (List Nat)) (symSpec : List (Nat × Nat × Nat))
    (rMask sMask : Nat) (chunks : List Nat) : Bool :=
  let rCls := filterMask rMask (ramseyClauses n mask)
  let sCls := filterMask sMask (symClausesAux n autsL autsG symSpec (n * 16))
  match loadTree depth (rCls ++ sCls) with
  | none => false
  | some t =>
    runSteps tokBits tokMask perChunkM1 t (.mk 0 0 chunks) steps chainFuel

theorem refute_of_checkInstance (n mask depth tokBits tokMask perChunkM1 steps chainFuel : Nat)
    (autsL autsG : List (List Nat)) (symSpec : List (Nat × Nat × Nat))
    (rMask sMask : Nat) (chunks : List Nat)
    (hAutsL : autsL.all (checkAuto n mask) = true)
    (hAutsG : autsG.all (checkAuto 16 g16Mask) = true)
    (hSpec : symSpec.all (fun sp => decide (sp.1 < autsL.length) && decide (sp.2.1 < autsG.length)) = true)
    (hCheck : checkInstance n mask depth tokBits tokMask perChunkM1 steps chainFuel autsL autsG symSpec rMask sMask chunks = true)
    (rows : Fin n → Fin 16 → Bool) :
    HasClique n mask rows := by
  obtain ⟨rows', hlift, hLex⟩ := exists_lexmax_orbit n mask rows
  apply hlift
  by_contra hNo
  let a0 : Nat → Bool := fun v =>
    if h : v < n * 16 then rows' ⟨v / 16, by omega⟩ ⟨v % 16, by omega⟩ else false
  have ha0 : ∀ (i : Fin n) (j : Fin 16), a0 (i.val * 16 + j.val) = rows' i j := by
    intro i j
    have hlt : i.val * 16 + j.val < n * 16 := by have := i.isLt; have := j.isLt; omega
    simp only [a0, hlt, ↓reduceDIte]
    have hdiv : (i.val * 16 + j.val) / 16 = i.val := by have := j.isLt; omega
    have hmod : (i.val * 16 + j.val) % 16 = j.val := by have := j.isLt; omega
    congr 1 <;> exact Fin.ext (by assumption)
  have hSpec' : ∀ sp ∈ symSpec, sp.1 < autsL.length ∧ sp.2.1 < autsG.length := by
    intro sp hsp
    have h1 := List.all_eq_true.mp hSpec sp hsp
    rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at h1
    exact h1
  obtain ⟨aExt, hAgree, hSym⟩ := symClausesAux_sound hLex hAutsL hAutsG symSpec (n * 16) a0 le_rfl ha0 hSpec'
  have hRam := ramseyClauses_sound ha0 hNo
  have hAllValid : ∀ cl ∈ filterMask rMask (ramseyClauses n mask) ++
      filterMask sMask (symClausesAux n autsL autsG symSpec (n * 16)), validCl aExt cl := by
    intro cl hcl
    rw [List.mem_append] at hcl
    rcases hcl with h1 | h2
    · have hm := mem_filterMask h1
      exact validCl_agree (hRam cl hm).1 (hRam cl hm).2 hAgree
    · exact hSym cl (mem_filterMask h2)
  unfold checkInstance at hCheck
  dsimp only at hCheck
  cases hload : loadTree depth (filterMask rMask (ramseyClauses n mask) ++
      filterMask sMask (symClausesAux n autsL autsG symSpec (n * 16))) with
  | none => rw [hload] at hCheck; cases hCheck
  | some t =>
    rw [hload] at hCheck
    exact runSteps_sound steps t _ chainFuel (loadTree_all hAllValid hload) hCheck

lemma lift5to6 (m : Nat)
    (hm : ∀ i j : Fin 5, i < j → edgeBit m i.val j.val = edgeBit 64 i.val j.val)
    (h5 : ∀ rows : Fin 5 → Fin 16 → Bool, HasClique 5 64 rows)
    (rows : Fin 6 → Fin 16 → Bool) : HasClique 6 m rows := by
  obtain ⟨c, s, t, hcard, hs, ht, hcross⟩ := h5 (fun i j => rows i.castSucc j)
  refine ⟨c, s.map Fin.castSuccEmb, t, ?_, ?_, ht, ?_⟩
  · simpa [Finset.card_map] using hcard
  · intro i hi j hj hij
    rcases Finset.mem_map.mp hi with ⟨i', hi', rfl⟩
    rcases Finset.mem_map.mp hj with ⟨j', hj', rfl⟩
    have hlt : i' < j' := hij
    exact (hm i' j' hlt).trans (hs i' hi' j' hj' hlt)
  · intro i hi j hj
    rcases Finset.mem_map.mp hi with ⟨i', hi', rfl⟩
    exact hcross i' hi' j hj

