private def check (choose : Nat → Nat) : Nat → State → Bool
  | 0, _ => false
  | fuel+1, s =>
    let rest := pattern (selectSlot s) &&& s.1.2
    if rest = 0 then true else
      let p := pointIndex rest
      if rest = 1 <<< (5*p) then check choose fuel (leftStep s p) else
        let q := choose rest
        check choose fuel (leftStep s q) && check choose fuel (rightStep s q)

private theorem both {s : State} (q : Nat) (hl : Closed (leftStep s q))
    (hr : Closed (rightStep s q)) : Closed s := by
  intro R bound hn hit hs ha
  by_cases h : R q
  · exact hl R bound hn hit (join_good hs (mark_good hn h (bound _ h))) (add_safe hs ha h)
  · exact hr R bound hn hit hs (erase_safe ha h)

private theorem sound (choose : Nat → Nat) (n : Nat) (s : State) (ok : check choose n s = true) : Closed s := by
  induction n generalizing s with
  | zero => simp [check] at ok
  | succ n ih =>
    simp only [check] at ok
    split at ok
    · rename_i hz
      intro R bound hn hit hs ha
      obtain ⟨t, hb, ht⟩ := hit (selectSlot s)
      have h : (pattern (selectSlot s) &&& s.1.2).testBit (5*t) = true := by simp [hb, ha t ht]
      simp [hz] at h
    · split at ok
      · rename_i he
        intro R bound hn hit hs ha
        obtain ⟨t, hb, ht⟩ := hit (selectSlot s)
        have h : (pattern (selectSlot s) &&& s.1.2).testBit (5*t) = true := by simp [hb,ha t ht]
        rw [he, Nat.shiftLeft_eq, Nat.one_mul, Nat.testBit_two_pow] at h
        let p := pointIndex (pattern (selectSlot s) &&& s.1.2)
        have hp : R p := (show t = p by have := of_decide_eq_true h; dsimp [p]; omega) ▸ ht
        exact ih _ ok R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
      · exact both _ (ih _ (Bool.and_eq_true_iff.mp ok).1) (ih _ (Bool.and_eq_true_iff.mp ok).2)

private def densePoint (v : Nat) : Nat :=
  (( : Nat) >>> (8*((v ^^^ (v-1))%173)))%256

private def paint : Nat → Nat → Marks × Nat → Marks × Nat
  | 0, _, acc => acc
  | fuel+1, v, acc =>
    if v = 0 then acc else
      let p := densePoint v
      paint fuel (v &&& (v-1)) (join acc.1 (mark p), acc.2 ||| (1 <<< (5*p)))

