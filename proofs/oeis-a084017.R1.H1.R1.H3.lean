      ∧ ¬ (8 * b + 44 ≤ 5 ^ b * m * 3 ^ (v - 2)) ∧ (b ≠ 0 ∨ m ≠ 1))
  ∨ (1 ≤ a ∧ 1 ≤ b ∧ 2 ≤ v ∧ v ≤ 4
      ∧ ¬ (36 * 2 ^ (a - 2) ≤ 2 * (2 ^ a * 5 ^ b * 3 ^ (v - 2) * m)))
  ∨ (1 ≤ a ∧ b = 0 ∧ 2 ≤ v ∧ v ≤ 4
      ∧ ¬ (4 * a + 6 ≤ 2 ^ a * 3 ^ (v - 2) * m))
  ∨ (1 ≤ a ∧ 1 ≤ b ∧ v = 1
      ∧ ¬ (4 * m + 39 + 36 * 2 ^ (a - 2) + (a + b)
          ≤ 2 * (2 ^ a * 5 ^ b * m)))
  ∨ (a = 0 ∧ 1 ≤ b ∧ v = 1 ∧ ¬ (4 * m + 8 * b + 41 ≤ 5 ^ b * m))
  ∨ (a = 0 ∧ b = 0 ∧ v = 1 ∧ ¬ (8 * ((m - 1) / 9 + 1) + 41 ≤ m))
  ∨ (2 ≤ a ∧ b = 0 ∧ v = 1
      ∧ ¬ (4 * m + 2 ^ a + 8 * a + 8 + 2 ^ a * m ≤ 3 * (2 ^ a * m)))
  ∨ (a = 1 ∧ b = 0 ∧ v = 1 ∧ ¬ (8 * ((m - 1) / 9 + 1) + 18 ≤ 2 * m))


