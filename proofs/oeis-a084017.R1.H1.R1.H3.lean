theorem le_two_pow (a : ℕ) : a ≤ 2 ^ a := by
  induction a with
  | zero => norm_num
  | succ k ih =>
    calc k + 1 ≤ 2 ^ k + 1 := by omega
      _ ≤ 2 * 2 ^ k := by
        have : 1 ≤ 2 ^ k := Nat.one_le_pow _ _ (by norm_num)
        omega
      _ = 2 ^ (k + 1) := by ring


set_option maxHeartbeats 800000 in
theorem le_five_pow (b : ℕ) : b ≤ 5 ^ b := by
  induction b with
  | zero => norm_num
  | succ k ih =>
    calc k + 1 ≤ 5 ^ k + 1 := by omega
      _ ≤ 5 * 5 ^ k := by
        have : 1 ≤ 5 ^ k := Nat.one_le_pow _ _ (by norm_num)
        omega
      _ = 5 ^ (k + 1) := by ring


set_option maxHeartbeats 800000 in
theorem pow5_ge_8b44 {b : ℕ} (hb : 4 ≤ b) : 8 * b + 44 ≤ 5 ^ b := by
  induction b, hb using Nat.le_induction with
  | base => norm_num
  | succ k hk ih =>
    have hk5 : 5 ^ 4 ≤ 5 ^ k := Nat.pow_le_pow_right (by norm_num) hk
    calc 8 * (k + 1) + 44 = 8 * k + 44 + 8 := by ring
      _ ≤ 5 ^ k + 8 := by omega
      _ ≤ 5 * 5 ^ k := by omega
      _ = 5 ^ (k + 1) := by ring


