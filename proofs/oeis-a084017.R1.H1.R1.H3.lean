theorem wit_sound {n : ℕ}
    (h : decide (witSpec n (witL n).1 (witL n).2) = true) :
    ∃ P z : ℕ, P ≠ 0
      ∧ z = tz n
      ∧ (Nat.digits 10 P).Palindrome
      ∧ (Nat.digits 10 P).length + z = n
      ∧ n ∣ P * 10 ^ z
      ∧ n ∣ (Nat.digits 10 P).sum := by
  obtain ⟨h10, hne, hgl, hpal, hlen, hz10, hdvd, hσ⟩ :=
    of_decide_eq_true h
  have hlast : ∀ h' : (witL n).2 ≠ [], ((witL n).2).getLast h' ≠ 0 := by
    intro h' hh
    apply hgl
    rw [List.getLast?_eq_getLast_of_ne_nil h']
    rw [hh]
  have hdig : Nat.digits 10 (Nat.ofDigits 10 (witL n).2) = (witL n).2 :=
    Nat.digits_ofDigits 10 (by norm_num) _ h10 hlast
  refine ⟨Nat.ofDigits 10 (witL n).2, (witL n).1, ?_, hz10, ?_, ?_, ?_, ?_⟩
  · intro h0
    rw [h0, Nat.digits_zero] at hdig
    exact hne hdig.symm
  · rw [hdig]; exact hpal
  · rw [hdig]; exact hlen
  · exact hdvd
  · rw [hdig]; exact hσ


