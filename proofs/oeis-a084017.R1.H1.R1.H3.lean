abbrev witSpec (n z : ℕ) (L : List ℕ) : Prop :=
  (∀ x ∈ L, x < 10) ∧ L ≠ [] ∧ L.getLast? ≠ some 0
    ∧ L.Palindrome ∧ L.length + z = n
