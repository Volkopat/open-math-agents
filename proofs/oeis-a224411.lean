import OMAStatements.S_oeis_a224411
import Mathlib

namespace TMEngine2

open Finset

/-- One transfer step on weight vectors: `W f N w s = ∑ k < N, w (f s k)`. -/
def W (f : ℕ → ℕ → ℕ) (N : ℕ) (w : ℕ → ℕ) (s : ℕ) : ℕ := ∑ k ∈ range N, w (f s k)

theorem sum_sem {α : Type*} [Fintype α] {N : ℕ} (e : α ≃ Fin N)
    (sem : ∀ n : ℕ, (Fin (n + 1) → α) → ℕ) (f : ℕ → ℕ → ℕ) (ι : ℕ → ℕ)
    (h0 : ∀ x : Fin 1 → α, sem 0 x = ι (e (x 0)))
    (hs : ∀ n (x : Fin (n + 2) → α), sem (n + 1) x = f (sem n (Fin.init x)) (e (x (Fin.last _)))) :
    ∀ n (w : ℕ → ℕ), ∑ x : Fin (n + 1) → α, w (sem n x) = ∑ k ∈ range N, (W f N)^[n] w (ι k) := by
  intro n
  induction n with
  | zero =>
    intro w
    rw [← (Equiv.funUnique (Fin 1) α).symm.sum_comp]
    simp only [Function.iterate_zero, id]
    rw [← Fin.sum_univ_eq_sum_range (fun k => w (ι k)), ← e.sum_comp]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [h0]; rfl
  | succ n ih =>
    intro w
    rw [← (Fin.snocEquiv (fun _ => α)).sum_comp, Fintype.sum_prod_type_right]
    have : ∀ y : Fin (n + 1) → α, ∑ c : α, w (sem (n + 1) ((Fin.snocEquiv fun _ => α) (c, y)))
        = W f N w (sem n y) := by
      intro y
      unfold W
      rw [← Fin.sum_univ_eq_sum_range (fun k => w (f (sem n y) k)), ← e.sum_comp]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [hs, show ((Fin.snocEquiv fun _ => α) (c, y)) = Fin.snoc y c from
        funext fun i => Fin.snocEquiv_apply _ _ i, Fin.init_snoc, Fin.snoc_last]
    simp_rw [this]
    rw [ih, Function.iterate_succ_apply]

/-- Packed table lookup: field `s` of width `B` bits of the number `V`. -/
def pk (B V s : ℕ) : ℕ := V / 2 ^ (B * s) % 2 ^ B

theorem list_sum_filter (l : List ℕ) (w : ℕ → ℕ) (d : ℕ) (hd : w d = 0) :
    ((l.filter (fun t => t != d)).map w).sum = (l.map w).sum := by
  induction l with
  | nil => rfl
  | cons t l ih =>
    by_cases h : t = d
    · subst h; simp [List.filter_cons, hd, ih]
    · simp [List.filter_cons, h, ih]

theorem sum_range_list (N : ℕ) (g : ℕ → ℕ) : ∑ k ∈ range N, g k = ((List.range N).map g).sum := by
  induction N with
  | zero => rfl
  | succ N ih => rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append, List.sum_append]; simp

/-- The transfer step on a live state, through its list of live successors. -/
theorem W_list (f : ℕ → ℕ → ℕ) (N d : ℕ) (w : ℕ → ℕ) (hd : w d = 0) (s : ℕ) (L : List ℕ)
    (hL : ((List.range N).map (f s)).filter (fun t => t != d) = L) :
    W f N w s = (L.map w).sum := by
  unfold W
  rw [← hL, list_sum_filter _ _ _ hd, List.map_map, sum_range_list]
  rfl

theorem iter_dead (f : ℕ → ℕ → ℕ) (N d : ℕ) (hfd : ∀ k < N, f d k = d) (w : ℕ → ℕ) (hw : w d = 0) :
    ∀ j, (W f N)^[j] w d = 0 := by
  intro j
  induction j with
  | zero => exact hw
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    unfold W
    exact Finset.sum_eq_zero fun k hk => by rw [hfd k (Finset.mem_range.mp hk)]; exact ih

section
variable (f : ℕ → ℕ → ℕ) (N d : ℕ) (D : List (ℕ × List ℕ))
  (hD : ∀ p ∈ D, ((List.range N).map (f p.1)).filter (fun t => t != d) = p.2)
  (hcl : ∀ p ∈ D, ∀ t ∈ p.2, t ∈ D.map Prod.fst)
  (hfd : ∀ k < N, f d k = d)

include hD hcl hfd in
theorem iter_table (w : ℕ → ℕ) (hw : w d = 0) (T : ℕ → ℕ → ℕ) (h0 : ∀ p ∈ D, w p.1 = T 0 p.1)
    (J : ℕ) (hT : ∀ j < J, ∀ p ∈ D, (p.2.map (T j)).sum = T (j + 1) p.1) :
    ∀ j ≤ J, ∀ p ∈ D, (W f N)^[j] w p.1 = T j p.1 := by
  intro j
  induction j with
  | zero => intro _ p hp; exact h0 p hp
  | succ j ih =>
    intro hj p hp
    rw [Function.iterate_succ_apply', W_list f N d _ (iter_dead f N d hfd w hw j) p.1 p.2 (hD p hp),
      ← hT j (by omega) p hp]
    congr 1
    apply List.map_congr_left
    intro t ht
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcl p hp t ht)
    exact ih (by omega) q hq

/-- A nonnegative linear combination `∑ c * V (m + i) s` over a list of pairs `(c, i)`. -/
def lin (V : ℕ → ℕ → ℕ) (P : List (ℕ × ℕ)) (m s : ℕ) : ℕ := (P.map fun p => p.1 * V (m + p.2) s).sum

theorem lin_succ (w : ℕ → ℕ) (P : List (ℕ × ℕ)) (m s : ℕ) :
    lin (fun j => (W f N)^[j] w) P (m + 1) s
      = ∑ k ∈ range N, lin (fun j => (W f N)^[j] w) P m (f s k) := by
  induction P with
  | nil => simp [lin]
  | cons p P ih =>
    simp only [lin, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Finset.sum_add_distrib, ← Finset.mul_sum,
      show m + 1 + p.2 = (m + p.2) + 1 by omega, Function.iterate_succ_apply']
    rfl

include hD hcl hfd in
theorem rec_lift (w : ℕ → ℕ) (hw : w d = 0) (P Q : List (ℕ × ℕ)) (m0 : ℕ)
    (hbase : ∀ p ∈ D, lin (fun j => (W f N)^[j] w) P m0 p.1 = lin (fun j => (W f N)^[j] w) Q m0 p.1) :
    ∀ m, m0 ≤ m → ∀ p ∈ D,
      lin (fun j => (W f N)^[j] w) P m p.1 = lin (fun j => (W f N)^[j] w) Q m p.1 := by
  have hlin0 : ∀ (P : List (ℕ × ℕ)) m, lin (fun j => (W f N)^[j] w) P m d = 0 := by
    intro P m
    unfold lin
    apply List.sum_eq_zero
    intro x hx
    obtain ⟨q, _, rfl⟩ := List.mem_map.mp hx
    dsimp only
    rw [iter_dead f N d hfd w hw, mul_zero]
  intro m hm
  induction m, hm using Nat.le_induction with
  | base => exact hbase
  | succ m _ ih =>
    intro p hp
    rw [lin_succ, lin_succ]
    have e1 := W_list f N d (lin (fun j => (W f N)^[j] w) P m) (hlin0 P m) p.1 p.2 (hD p hp)
    have e2 := W_list f N d (lin (fun j => (W f N)^[j] w) Q m) (hlin0 Q m) p.1 p.2 (hD p hp)
    change W f N (lin (fun j => (W f N)^[j] w) P m) p.1 = W f N (lin (fun j => (W f N)^[j] w) Q m) p.1
    rw [e1, e2]
    congr 1
    apply List.map_congr_left
    intro t ht
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcl p hp t ht)
    exact ih q hq
end

theorem lin_sum (V : ℕ → ℕ → ℕ) (ι : ℕ → ℕ) (N : ℕ) (P : List (ℕ × ℕ)) (m : ℕ) :
    (P.map fun p => p.1 * ∑ k ∈ range N, V (m + p.2) (ι k)).sum
      = ∑ k ∈ range N, lin V P m (ι k) := by
  induction P with
  | nil => simp [lin]
  | cons p P ih =>
    simp only [lin, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Finset.sum_add_distrib, Finset.mul_sum]

end TMEngine2

namespace TMEngine2

theorem forall_pair_snoc {n : ℕ} (P : Fin (n + 2) → Fin (n + 2) → Prop) :
    (∀ i j : Fin (n + 2), j.val = i.val + 1 → P i j) ↔
      (∀ i j : Fin (n + 1), j.val = i.val + 1 → P i.castSucc j.castSucc) ∧
        P (Fin.last n).castSucc (Fin.last (n + 1)) := by
  constructor
  · intro H
    exact ⟨fun i j h => H _ _ (by simpa using h), H _ _ (by simp)⟩
  · rintro ⟨H, Hl⟩ i j h
    by_cases hj : j.val < n + 1
    · exact H ⟨i.val, by omega⟩ ⟨j.val, hj⟩ h
    · have hj' : j = Fin.last _ := Fin.ext (by have := j.isLt; simp; omega)
      have hi' : i = (Fin.last n).castSucc := Fin.ext (by simp; omega)
      subst hj' hi'
      exact Hl

theorem forall_triple_snoc {n : ℕ} (P : Fin (n + 2) → Fin (n + 2) → Fin (n + 2) → Prop) :
    (∀ i j l : Fin (n + 2), j.val = i.val + 1 → l.val = j.val + 1 → P i j l) ↔
      (∀ i j l : Fin (n + 1), j.val = i.val + 1 → l.val = j.val + 1 → P i.castSucc j.castSucc l.castSucc) ∧
        (∀ i j : Fin (n + 2), j.val = i.val + 1 → j.val = n → P i j (Fin.last (n + 1))) := by
  constructor
  · intro H
    refine ⟨fun i j l h1 h2 => H _ _ _ (by simpa using h1) (by simpa using h2), fun i j h1 h2 => H _ _ _ h1 ?_⟩
    simp; omega
  · rintro ⟨H, Hl⟩ i j l h1 h2
    by_cases hl : l.val < n + 1
    · exact H ⟨i.val, by omega⟩ ⟨j.val, by omega⟩ ⟨l.val, hl⟩ h1 h2
    · have hl' : l = Fin.last _ := Fin.ext (by have := l.isLt; simp; omega)
      subst hl'
      exact Hl i j h1 (by simp at h2; omega)

end TMEngine2

namespace A224411P

open Finset TMEngine2 OMA.S_oeis_a224411

/-! Unimodal lists under appending one entry. -/

def ND (l : List ℕ) : Prop := l.Pairwise (· ≤ ·)

theorem uni_snoc (l : List ℕ) (v : ℕ) (hl : l ≠ []) :
    Unimodal (l ++ [v]) ↔ ND l ∨ (Unimodal l ∧ v ≤ l.getLast hl) := by
  unfold Unimodal ND
  constructor
  · rintro ⟨m, h1, h2⟩
    by_cases hm : m ≤ l.length
    · rw [List.take_append_of_le_length hm] at h1
      rw [List.drop_append_of_le_length hm, List.pairwise_append] at h2
      by_cases he : m = l.length
      · left; rw [he, List.take_length] at h1; exact h1
      · right
        refine ⟨⟨m, h1, h2.1⟩, ?_⟩
        have hmem : l.getLast hl ∈ l.drop m := by
          rw [List.getLast_eq_getElem]
          apply List.mem_iff_getElem.mpr
          refine ⟨l.length - 1 - m, by simp; omega, ?_⟩
          rw [List.getElem_drop]; congr 1; omega
        exact h2.2.2 _ hmem v (by simp)
    · left
      push_neg at hm
      rw [List.take_of_length_le (by simp; omega), List.pairwise_append] at h1
      exact h1.1
  · rintro (h | ⟨⟨m, h1, h2⟩, hv⟩)
    · refine ⟨l.length, ?_, ?_⟩
      · rw [List.take_append_of_le_length le_rfl, List.take_length]; exact h
      · rw [List.drop_append_of_le_length le_rfl, List.drop_length]; simp
    · by_cases hm : m < l.length
      · refine ⟨m, ?_, ?_⟩
        · rw [List.take_append_of_le_length hm.le]; exact h1
        · rw [List.drop_append_of_le_length hm.le, List.pairwise_append]
          refine ⟨h2, by simp, ?_⟩
          intro a ha b hb
          simp only [List.mem_singleton] at hb
          subst hb
          refine le_trans hv ?_
          have hlast : l.getLast hl ∈ l.drop m := by
            rw [List.getLast_eq_getElem]
            apply List.mem_iff_getElem.mpr
            refine ⟨l.length - 1 - m, by simp; omega, ?_⟩
            rw [List.getElem_drop]; congr 1; omega
          obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp ha
          rw [List.getLast_eq_getElem]
          have hj : l.length - 1 - m < (l.drop m).length := by simp; omega
          have hl2 : (l.drop m)[l.length - 1 - m] = l[l.length - 1] := by
            rw [List.getElem_drop]; congr 1; omega
          rw [← hl2]
          by_cases hij : i = l.length - 1 - m
          · subst hij; exact le_rfl
          · exact List.pairwise_iff_getElem.mp h2 i _ hi hj (by simp at hi hj; omega)
      · push_neg at hm
        refine ⟨l.length, ?_, ?_⟩
        · rw [List.take_append_of_le_length le_rfl, List.take_length]
          rw [List.take_of_length_le hm] at h1; exact h1
        · rw [List.drop_append_of_le_length le_rfl, List.drop_length]; simp

theorem nd_snoc (l : List ℕ) (v : ℕ) : ND (l ++ [v]) ↔ ND l ∧ ∀ x ∈ l, x ≤ v := by
  unfold ND; rw [List.pairwise_append]; simp




abbrev Col := Fin 2 × Fin 2 × Fin 2 × Fin 2
abbrev Fl := (Bool × Bool) × (Bool × Bool) × (Bool × Bool) × (Bool × Bool)
abbrev St := Option (Col × Fl)

def encR (u : Col) : ℕ := (u.1).val + 2 * (u.2.1).val + 4 * (u.2.2.1).val + 8 * (u.2.2.2).val
def encF (fl : Fl) : ℕ := 1 * ((fl.1).1.toNat + 2 * (fl.1).2.toNat) + 4 * ((fl.2.1).1.toNat + 2 * (fl.2.1).2.toNat) + 16 * ((fl.2.2.1).1.toNat + 2 * (fl.2.2.1).2.toNat) + 64 * ((fl.2.2.2).1.toNat + 2 * (fl.2.2.2).2.toNat)
def enc : St → ℕ
  | none => 4096
  | some (u, fl) => encR u + 16 * encF fl

def decR (k : ℕ) : Col := ((⟨k / 1 % 2, Nat.mod_lt _ (by norm_num)⟩ : Fin 2), (⟨k / 2 % 2, Nat.mod_lt _ (by norm_num)⟩ : Fin 2), (⟨k / 4 % 2, Nat.mod_lt _ (by norm_num)⟩ : Fin 2), (⟨k / 8 % 2, Nat.mod_lt _ (by norm_num)⟩ : Fin 2))
def decF (k : ℕ) : Fl := ((decide (k / 1 % 2 = 1), decide (k / 2 % 2 = 1)), (decide (k / 4 % 2 = 1), decide (k / 8 % 2 = 1)), (decide (k / 16 % 2 = 1), decide (k / 32 % 2 = 1)), (decide (k / 64 % 2 = 1), decide (k / 128 % 2 = 1)))
def dec (s : ℕ) : St := if s < 4096 then some (decR s, decF (s / 16)) else none

set_option maxRecDepth 100000 in
set_option synthInstance.maxSize 1000 in
set_option synthInstance.maxHeartbeats 400000 in
theorem dec_enc : ∀ t : St, dec (enc t) = t := by decide +kernel

def vec (u : Col) : Fin 4 → Fin 2 := ![u.1, u.2.1, u.2.2.1, u.2.2.2]

theorem vec_eq (c : Fin 4 → Fin 2) : vec (c 0, c 1, c 2, c 3) = c := by
  funext i; fin_cases i <;> rfl

def chainP (u c : Fin 4 → Fin 2) : Prop := ∀ i : Fin 3, c i.castSucc ≤ u i.succ

instance (u c : Fin 4 → Fin 2) : Decidable (chainP u c) :=
  inferInstanceAs (Decidable (∀ i : Fin 3, c i.castSucc ≤ u i.succ))

def rowP (N : Bool) (p b : Fin 2) : Prop := N = true ∨ b ≤ p

instance (N : Bool) (p b : Fin 2) : Decidable (rowP N p b) := inferInstanceAs (Decidable (N = true ∨ b ≤ p))

def step : St → Col → St
  | none, _ => none
  | some (u, fl), c =>
    if chainP (vec u) (vec c) ∧ rowP fl.1.2 u.1 c.1 ∧ rowP fl.2.1.2 u.2.1 c.2.1 ∧ rowP fl.2.2.1.2 u.2.2.1 c.2.2.1 ∧ rowP fl.2.2.2.2 u.2.2.2 c.2.2.2 then
      some (c, ((fl.1.1 && decide (c.1 = 0), fl.1.2 && (decide (c.1 = 1) || fl.1.1)), (fl.2.1.1 && decide (c.2.1 = 0), fl.2.1.2 && (decide (c.2.1 = 1) || fl.2.1.1)), (fl.2.2.1.1 && decide (c.2.2.1 = 0), fl.2.2.1.2 && (decide (c.2.2.1 = 1) || fl.2.2.1.1)), (fl.2.2.2.1 && decide (c.2.2.2 = 0), fl.2.2.2.2 && (decide (c.2.2.2 = 1) || fl.2.2.2.1))))
    else none

def start (c : Col) : St := some (c, ((decide (c.1 = 0), true), (decide (c.2.1 = 0), true), (decide (c.2.2.1 = 0), true), (decide (c.2.2.2 = 0), true)))

def f (s k : ℕ) : ℕ := enc (step (dec s) (decR k))
def ι (k : ℕ) : ℕ := enc (start (decR k))
def acc (s : ℕ) : ℕ := if s < 4096 then 1 else 0

def eR (c : Fin 4 → Fin 2) : Fin 16 := ⟨encR (c 0, c 1, c 2, c 3), by
  show (c 0).val + 2 * (c 1).val + 4 * (c 2).val + 8 * (c 3).val < 16
  have := (c 0).isLt; have := (c 1).isLt; have := (c 2).isLt; have := (c 3).isLt
  omega⟩

set_option maxRecDepth 100000 in
theorem vec_decR_eR : ∀ c : Fin 4 → Fin 2, vec (decR (eR c)) = c := by decide +kernel
set_option maxRecDepth 100000 in
theorem eR_vec_decR : ∀ k : Fin 16, eR (vec (decR k)) = k := by decide +kernel
set_option maxRecDepth 100000 in
theorem decR_eR : ∀ c : Fin 4 → Fin 2, decR (eR c) = (c 0, c 1, c 2, c 3) := by decide +kernel

def e : (Fin 4 → Fin 2) ≃ Fin 16 where
  toFun := eR
  invFun k := vec (decR k)
  left_inv c := vec_decR_eR c
  right_inv k := eR_vec_decR k

theorem decR_e (c : Fin 4 → Fin 2) : decR (e c) = (c 0, c 1, c 2, c 3) := decR_eR c

/-! Row properties of an array given by its columns. -/

def rw' {m : ℕ} (x : Fin m → Fin 4 → Fin 2) (i : Fin 4) : List ℕ := List.ofFn (fun j => ((x j i : Fin 2) : ℕ))
def PZ {m : ℕ} (x : Fin m → Fin 4 → Fin 2) (i : Fin 4) : Prop := ∀ j, x j i = 0
def PN {m : ℕ} (x : Fin m → Fin 4 → Fin 2) (i : Fin 4) : Prop := ND (rw' x i)
def PU {m : ℕ} (x : Fin m → Fin 4 → Fin 2) (i : Fin 4) : Prop := Unimodal (rw' x i)
def chainX {m : ℕ} (x : Fin m → Fin 4 → Fin 2) : Prop :=
  ∀ j j' : Fin m, j'.val = j.val + 1 → chainP (x j) (x j')

theorem sol_iff {m : ℕ} (x : Fin m → Fin 4 → Fin 2) :
    IsSolution (List.ofFn x) ↔ (∀ i, PU x i) ∧ chainX x := by
  unfold IsSolution PU chainX rw' chainP
  apply and_congr
  · apply forall_congr'; intro i
    rw [List.map_ofFn]; rfl
  · rw [List.isChain_ofFn]
    constructor
    · intro H j j' h
      have := H j.val (by have := j'.isLt; omega)
      have e1 : (⟨j.val, by have := j'.isLt; omega⟩ : Fin m) = j := rfl
      have e2 : (⟨j.val + 1, by have := j'.isLt; omega⟩ : Fin m) = j' := Fin.ext h.symm
      rw [e2] at this; exact this
    · intro H k hk; exact H ⟨k, by omega⟩ ⟨k + 1, hk⟩ rfl

theorem rw_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 2) (i : Fin 4) :
    rw' x i = rw' (Fin.init x) i ++ [((x (Fin.last _) i : Fin 2) : ℕ)] := by
  unfold rw'
  rw [List.ofFn_succ', List.concat_eq_append]
  rfl

theorem rw_ne {n : ℕ} (x : Fin (n + 1) → Fin 4 → Fin 2) (i : Fin 4) : rw' x i ≠ [] := by
  simp [rw']

theorem rw_last {n : ℕ} (x : Fin (n + 1) → Fin 4 → Fin 2) (i : Fin 4) :
    (rw' x i).getLast (rw_ne x i) = ((x (Fin.last n) i : Fin 2) : ℕ) := by
  simp only [rw', List.getLast_eq_getElem, List.getElem_ofFn, List.length_ofFn]
  congr 3

theorem PZ_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 2) (i : Fin 4) :
    PZ x i ↔ PZ (Fin.init x) i ∧ x (Fin.last _) i = 0 := by
  unfold PZ; rw [Fin.forall_fin_succ']; rfl

theorem PN_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 2) (i : Fin 4) :
    PN x i ↔ PN (Fin.init x) i ∧ (x (Fin.last _) i = 1 ∨ PZ (Fin.init x) i) := by
  unfold PN
  rw [rw_snoc, nd_snoc]
  apply and_congr_right; intro _
  unfold rw' PZ
  simp only [List.mem_ofFn, forall_exists_index, forall_apply_eq_imp_iff]
  constructor
  · intro h
    by_cases hb : x (Fin.last _) i = 1
    · exact Or.inl hb
    · right; intro j
      have := h j
      have hb0 : x (Fin.last _) i = 0 := by omega
      rw [hb0] at this
      simpa using this
  · rintro (h | h) j
    · rw [h]; have := (x j.castSucc i).isLt; simp; omega
    · show ((Fin.init x j i : Fin 2) : ℕ) ≤ _
      rw [h j]; simp

theorem PU_snoc {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 2) (i : Fin 4) :
    PU x i ↔ PN (Fin.init x) i ∨ (PU (Fin.init x) i ∧ x (Fin.last _) i ≤ Fin.init x (Fin.last n) i) := by
  unfold PU PN
  rw [rw_snoc, uni_snoc _ _ (rw_ne (Fin.init x) i), rw_last]
  rfl

theorem PU_zero (x : Fin 1 → Fin 4 → Fin 2) (i : Fin 4) : PU x i := by
  refine ⟨1, ?_, ?_⟩ <;> simp [rw']

theorem PN_zero (x : Fin 1 → Fin 4 → Fin 2) (i : Fin 4) : PN x i := by
  simp [PN, rw', ND]

theorem PZ_zero (x : Fin 1 → Fin 4 → Fin 2) (i : Fin 4) : PZ x i ↔ x 0 i = 0 := by
  unfold PZ; rw [Fin.forall_fin_one]

open Classical in
noncomputable def semS {n : ℕ} (x : Fin (n + 1) → Fin 4 → Fin 2) : St :=
  if IsSolution (List.ofFn x) then some ((x (Fin.last n) 0, x (Fin.last n) 1, x (Fin.last n) 2, x (Fin.last n) 3), ((decide (PZ x 0), decide (PN x 0)), (decide (PZ x 1), decide (PN x 1)), (decide (PZ x 2), decide (PN x 2)), (decide (PZ x 3), decide (PN x 3)))) else none

noncomputable def sem (n : ℕ) (x : Fin (n + 1) → Fin 4 → Fin 2) : ℕ := enc (semS x)

theorem allPU (P : Fin 4 → Prop) : (∀ i, P i) ↔ P 0 ∧ P 1 ∧ P 2 ∧ P 3 := by
  constructor
  · intro h; exact ⟨h 0, h 1, h 2, h 3⟩
  · rintro ⟨h0, h1, h2, h3⟩ i; fin_cases i <;> assumption

open Classical in
theorem semS_succ {n : ℕ} (x : Fin (n + 2) → Fin 4 → Fin 2) :
    semS x = step (semS (Fin.init x)) (x (Fin.last _) 0, x (Fin.last _) 1, x (Fin.last _) 2, x (Fin.last _) 3) := by
  have hch : chainX x ↔ chainX (Fin.init x) ∧ chainP (x (Fin.last n).castSucc) (x (Fin.last _)) :=
    forall_pair_snoc (fun j j' => chainP (x j) (x j'))
  unfold semS
  by_cases hy : IsSolution (List.ofFn (Fin.init x))
  · rw [if_pos hy]
    have hy' := (sol_iff _).mp hy
    have key : IsSolution (List.ofFn x) ↔ chainP (Fin.init x (Fin.last n)) (x (Fin.last _)) ∧
        (PN (Fin.init x) 0 ∨ x (Fin.last _) 0 ≤ Fin.init x (Fin.last n) 0) ∧ (PN (Fin.init x) 1 ∨ x (Fin.last _) 1 ≤ Fin.init x (Fin.last n) 1) ∧ (PN (Fin.init x) 2 ∨ x (Fin.last _) 2 ≤ Fin.init x (Fin.last n) 2) ∧ (PN (Fin.init x) 3 ∨ x (Fin.last _) 3 ≤ Fin.init x (Fin.last n) 3) := by
      rw [sol_iff, hch, allPU (fun i => PU x i), PU_snoc, PU_snoc, PU_snoc, PU_snoc]
      have := hy'.1
      rw [allPU (fun i => PU (Fin.init x) i)] at this
      tauto
    simp only [step, vec_eq, rowP, decide_eq_true_eq]
    by_cases hx : IsSolution (List.ofFn x)
    · rw [if_pos hx, if_pos (key.mp hx)]
      simp only [Option.some.injEq, Prod.mk.injEq, true_and]
      simp only [PZ_snoc, PN_snoc, Bool.decide_and, Bool.decide_or]
      simp
    · rw [if_neg hx, if_neg (fun h => hx (key.mpr h))]
  · rw [if_neg hy, if_neg]
    · rfl
    · intro h
      apply hy
      rw [sol_iff] at h ⊢
      refine ⟨fun i => ?_, (hch.mp h.2).1⟩
      rcases (PU_snoc x i).mp (h.1 i) with h' | h'
      · unfold PU; unfold PN at h'
        exact ⟨(rw' (Fin.init x) i).length, by rw [List.take_length]; exact h', by simp⟩
      · exact h'.1

theorem sem_succ (n : ℕ) (x : Fin (n + 2) → Fin 4 → Fin 2) :
    sem (n + 1) x = f (sem n (Fin.init x)) (e (x (Fin.last _))) := by
  unfold sem f
  rw [dec_enc, decR_e, semS_succ]

open Classical in
theorem sem_zero (x : Fin 1 → Fin 4 → Fin 2) : sem 0 x = ι (e (x 0)) := by
  unfold sem ι
  rw [decR_e]
  congr 1
  have hs : IsSolution (List.ofFn x) := by
    rw [sol_iff]
    exact ⟨PU_zero x, fun j j' h => by have := j.isLt; have := j'.isLt; omega⟩
  unfold semS start
  rw [if_pos hs]
  simp only [PZ_zero, PN_zero, decide_true]
  rfl

