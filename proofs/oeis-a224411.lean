  · rw [if_neg h, if_neg h]; decide

theorem card_eq (n : ℕ) :
    a n = Nat.card {x : Fin n → Fin 4 → Fin 2 // IsSolution (List.ofFn x)} := by
  unfold a
  apply Nat.card_congr
  exact {
    toFun := fun l => ⟨fun i => l.1.get (Fin.cast l.2.1.symm i), by
      have : List.ofFn (fun i => l.1.get (Fin.cast l.2.1.symm i)) = l.1 := by
        apply List.ext_get (by simp [l.2.1]); intro k h1 h2; simp
      rw [this]; exact l.2.2⟩
    invFun := fun x => ⟨List.ofFn x.1, by simp, x.2⟩
    left_inv := fun l => by
      apply Subtype.ext
      apply List.ext_get (by simp [l.2.1]); intro k h1 h2; simp
    right_inv := fun x => by
      apply Subtype.ext; funext i; simp }

theorem a_eq (n : ℕ) : a (n + 1) = ∑ k ∈ range 16, (W f 16)^[n] acc (ι k) := by
