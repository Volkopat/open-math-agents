/-
Proof of OMA.S_oeis_a056737.main, with c = zeta(2) = pi^2/6 (written as the tsum of 1/n^2).
The only analytic input is theta(x) ~ x, taken from the PrimeNumberTheoremAnd port above
(OMALib.PNT.chebyshev_asymptotic); everything below this comment is new.

Notation: P(N) is the sum of the primes up to N and G(N) = N^2 / (2 log N).
* Abel summation turns theta(m) ~ m into the sum of p log p over p <= N being ~ N^2/2, and a
  split of the range at N / log N gives P(N) ~ G(N). The same split gives
  W(N) = sum over 2 <= n <= N of n / log n ~ G(N).
* Lower bound: if q is prime and k < q then a(kq) >= q - k, and distinct pairs (k, q) with
  k <= K < q give distinct n = kq. Hence S(x) >= sum over k <= K of P(x/k) - O(K^2 x).
* Upper bound: write n = d t with d the largest divisor with d^2 <= n, so a(n) = t - d. For every
  prime p dividing t one has t <= d p. With D = sqrt(sqrt x): if d >= D then a(n) <= x/D; if d < D
  and t is composite then a(n) <= t <= d^2 < D^2; otherwise t = q is prime, n = d q with d < D
  and a(n) <= q. Hence S(x) <= x (x/D + D^2) + sum over d < D of P(x/d).
* With P(x/d) ~ G(x)/d^2 for each fixed d, P(N) <= 2 G(N) for large N in the tail, and an
  epsilon-K squeeze, S(x) ~ zeta(2) G(x) ~ zeta(2) W(x).
-/

namespace OMA.A056737Proof

open Finset Filter Asymptotics Real Topology
open OMA.S_oeis_a056737


lemma sum_range_cast_id (n : ℕ) : ∑ i ∈ range n, (i : ℝ) = n * (n - 1) / 2 := by
  induction n with
  | zero => simp
  | succ n ih => rw [sum_range_succ, ih]; push_cast; ring

lemma abel_id (f : ℕ → ℝ) (N : ℕ) :
    ∑ n ∈ range (N + 1), (n : ℝ) * f n =
      N * ∑ n ∈ range (N + 1), f n - ∑ m ∈ range N, ∑ n ∈ range (m + 1), f n := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [sum_range_succ, ih, sum_range_succ (fun m => ∑ n ∈ range (m + 1), f n),
      sum_range_succ f (N + 1)]
    push_cast; ring

lemma abel_sq (f : ℕ → ℝ)
    (hF : (fun m : ℕ => ∑ n ∈ range (m + 1), f n) ~[atTop] (fun m => (m : ℝ))) :
    (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * f n) ~[atTop] (fun N => (N : ℝ) ^ 2 / 2) := by
  set F : ℕ → ℝ := fun m => ∑ n ∈ range (m + 1), f n with hFdef
  have h1 : (fun N : ℕ => (N : ℝ) * (F N - N)) =o[atTop] (fun N : ℕ => (N : ℝ) * N) :=
    (isBigO_refl (fun N : ℕ => (N : ℝ)) atTop).mul_isLittleO hF.isLittleO
  have hsum : Tendsto (fun n => ∑ i ∈ range n, (i : ℝ)) atTop atTop := by
    have : ∀ n : ℕ, (n : ℝ) / 2 - 1 ≤ ∑ i ∈ range n, (i : ℝ) := by
      intro n
      rw [sum_range_cast_id]
      nlinarith [sq_nonneg ((n : ℝ) - 1)]
    refine tendsto_atTop_mono this ?_
    exact tendsto_atTop_add_const_right _ _
      (tendsto_natCast_atTop_atTop.atTop_div_const (by norm_num : (0:ℝ) < 2))
  have h2 : (fun N => ∑ m ∈ range N, (F m - m)) =o[atTop] (fun N => ∑ i ∈ range N, (i : ℝ)) :=
    IsLittleO.sum_range hF.isLittleO (fun i => Nat.cast_nonneg i) hsum
  have h2' : (fun N => ∑ i ∈ range N, (i : ℝ)) =O[atTop] (fun N : ℕ => (N : ℝ) * N) := by
    refine IsBigO.of_bound 1 (Eventually.of_forall fun N => ?_)
    rw [sum_range_cast_id, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg, abs_of_nonneg]
    · nlinarith [(Nat.cast_nonneg N : (0 : ℝ) ≤ N)]
    · positivity
    · rcases Nat.eq_zero_or_pos N with h | h
      · subst h; simp
      · have : (1 : ℝ) ≤ N := by exact_mod_cast h
        have : 0 ≤ (N : ℝ) - 1 := by linarith
        positivity
  have h3 : (fun N : ℕ => (N : ℝ) / 2) =o[atTop] (fun N : ℕ => (N : ℝ) * N) := by
    have : (fun N : ℕ => (N : ℝ) / 2) =O[atTop] (fun N : ℕ => (N : ℝ) * 1) :=
      IsBigO.of_bound 1 (Eventually.of_forall fun N => by
        simp only [mul_one, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg (α := ℝ) N),
          abs_of_nonneg (by positivity : (0:ℝ) ≤ N / 2)]
        linarith [(Nat.cast_nonneg N : (0 : ℝ) ≤ N)])
    refine this.trans_isLittleO ?_
    refine (isBigO_refl (fun N : ℕ => (N : ℝ)) atTop).mul_isLittleO ?_
    exact (isLittleO_const_id_atTop (1 : ℝ)).comp_tendsto tendsto_natCast_atTop_atTop
  have hv : (fun N : ℕ => (N : ℝ) * N) =O[atTop] (fun N : ℕ => (N : ℝ) ^ 2 / 2) :=
    IsBigO.of_bound 2 (Eventually.of_forall fun N => by
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by positivity),
        abs_of_nonneg (by positivity)]
      nlinarith)
  have key : (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * f n - (N : ℝ) ^ 2 / 2) =
      (fun N : ℕ => (N : ℝ) * (F N - N) - ∑ m ∈ range N, (F m - m) + (N : ℝ) / 2) := by
    funext N
    rw [abel_id, sum_sub_distrib, sum_range_cast_id]
    ring
  show IsLittleO _ _ _
  rw [show (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * f n) - (fun N : ℕ => (N : ℝ) ^ 2 / 2) =
    (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * f n - (N : ℝ) ^ 2 / 2) from rfl, key]
  exact ((h1.sub (h2.trans_isBigO h2')).add h3).trans_isBigO hv


lemma split_bound (c : ℕ → ℝ) (hc0 : ∀ n, 0 ≤ c n) (hc1 : ∀ n, c n ≤ 2) (N : ℕ) (M : ℝ)
    (hM : 1 < M) :
    ∑ n ∈ range (N + 1), (n : ℝ) * c n ≤
      2 * M * (M + 1) + (∑ n ∈ range (N + 1), (n : ℝ) * (c n * log n)) / log M := by
  have hlM : 0 < log M := Real.log_pos hM
  have hterm : ∀ n ∈ range (N + 1), (n : ℝ) * c n ≤
      (if (n : ℝ) ≤ M then 2 * M else 0) + (n : ℝ) * (c n * log n) / log M := by
    intro n _
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hnn : 0 ≤ (n : ℝ) * (c n * log n) / log M :=
      div_nonneg (mul_nonneg hn0 (mul_nonneg (hc0 n) (Real.log_natCast_nonneg n))) hlM.le
    split_ifs with h
    · have : (n : ℝ) * c n ≤ 2 * M := by nlinarith [hc0 n, hc1 n]
      linarith
    · push Not at h
      have hlog : log M ≤ log n := Real.log_le_log (by linarith) h.le
      rw [zero_add, le_div_iff₀ hlM]
      have := mul_nonneg hn0 (hc0 n)
      nlinarith
  refine (sum_le_sum hterm).trans ?_
  rw [sum_add_distrib, ← sum_div]
  gcongr
  rw [← sum_filter, sum_const, nsmul_eq_mul]
  have hcard : ((range (N + 1)).filter (fun n : ℕ => (n : ℝ) ≤ M)).card ≤ ⌊M⌋₊ + 1 := by
    calc _ ≤ (range (⌊M⌋₊ + 1)).card := by
          apply card_le_card
          intro n hn
          simp only [mem_filter, mem_range] at hn ⊢
          exact Nat.lt_succ_of_le (Nat.le_floor hn.2)
      _ = ⌊M⌋₊ + 1 := card_range _
  have h1 : (((range (N + 1)).filter (fun n : ℕ => (n : ℝ) ≤ M)).card : ℝ) ≤ M + 1 := by
    have := Nat.floor_le (show 0 ≤ M by linarith)
    have h2 : (((range (N + 1)).filter (fun n : ℕ => (n : ℝ) ≤ M)).card : ℝ) ≤ ⌊M⌋₊ + 1 := by
      exact_mod_cast hcard
    linarith
  nlinarith

lemma split_equiv (c : ℕ → ℝ) (hc0 : ∀ n, 0 ≤ c n) (hc1 : ∀ n, c n ≤ 2)
    (hB : (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * (c n * log n)) ~[atTop]
      (fun N => (N : ℝ) ^ 2 / 2)) :
    (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * c n) ~[atTop]
      (fun N => (N : ℝ) ^ 2 / (2 * log N)) := by
  set A : ℕ → ℝ := fun N => ∑ n ∈ range (N + 1), (n : ℝ) * c n with hA
  set B : ℕ → ℝ := fun N => ∑ n ∈ range (N + 1), (n : ℝ) * (c n * log n) with hBdef
  have hev2 : ∀ᶠ N : ℕ in atTop, 2 ≤ N := eventually_ge_atTop 2
  have hBq : Tendsto (fun N : ℕ => B N / ((N : ℝ) ^ 2 / 2)) atTop (𝓝 1) := by
    have := (isEquivalent_iff_tendsto_one (hev2.mono fun N hN => by
      have : (0 : ℝ) < N := by exact_mod_cast (by omega : 0 < N)
      positivity)).mp hB
    exact this
  have hL : Tendsto (fun N : ℕ => log (N : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hr : Tendsto (fun N : ℕ => log (log (N : ℝ)) / log N) atTop (𝓝 0) :=
    Real.isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp hL
  have hU : Tendsto (fun N : ℕ => 4 / log (N : ℝ) + 4 / N +
      B N / ((N : ℝ) ^ 2 / 2) * (1 / (1 - log (log (N : ℝ)) / log N))) atTop (𝓝 1) := by
    have h4L : Tendsto (fun N : ℕ => 4 / log (N : ℝ)) atTop (𝓝 0) :=
      hL.const_div_atTop 4
    have h4N : Tendsto (fun N : ℕ => 4 / (N : ℝ)) atTop (𝓝 0) :=
      tendsto_natCast_atTop_atTop.const_div_atTop 4
    have h3 : Tendsto (fun N : ℕ => 1 / (1 - log (log (N : ℝ)) / log N)) atTop (𝓝 1) := by
      have := (tendsto_const_nhds (x := (1 : ℝ))).sub hr
      simpa using this.inv₀ (by norm_num)
    have := (h4L.add h4N).add (hBq.mul h3)
    simpa using this
  rw [isEquivalent_iff_tendsto_one (hev2.mono fun N hN => by
    have : (1 : ℝ) < N := by exact_mod_cast (by omega : 1 < N)
    have := Real.log_pos this
    positivity)]
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hBq hU ?_ ?_
  · filter_upwards [hev2] with N hN
    have hN1 : (1 : ℝ) < N := by exact_mod_cast (by omega : 1 < N)
    have hlN : 0 < log (N : ℝ) := Real.log_pos hN1
    have hle : B N ≤ A N * log N := by
      simp only [hA, hBdef, sum_mul]
      refine sum_le_sum fun n hn => ?_
      have hn : n ≤ N := Nat.lt_succ_iff.mp (mem_range.mp hn)
      have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      rcases Nat.eq_zero_or_pos n with h0 | h0
      · subst h0; simp
      · have : log (n : ℝ) ≤ log N :=
          Real.log_le_log (by exact_mod_cast h0) (by exact_mod_cast hn)
        have := mul_nonneg hn0 (hc0 n)
        nlinarith
    simp only [Pi.div_apply]
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    rw [show B N * ((N : ℝ) ^ 2 / (2 * log N)) = (B N / log N) * ((N : ℝ) ^ 2 / 2) by
      field_simp]
    gcongr
    rw [div_le_iff₀ hlN]; exact hle
  · filter_upwards [hev2] with N hN
    have hN1 : (1 : ℝ) < N := by exact_mod_cast (by omega : 1 < N)
    have hN0 : (0 : ℝ) < N := by linarith
    have hlN : 0 < log (N : ℝ) := Real.log_pos hN1
    have hll : log (log (N : ℝ)) < log N := by
      have := Real.log_le_sub_one_of_pos hlN; linarith
    have hlN' : log (N : ℝ) < N := by
      have := Real.log_le_sub_one_of_pos hN0; linarith
    set L := log (N : ℝ) with hLdef
    have hM : 1 < (N : ℝ) / L := by rw [lt_div_iff₀ hlN]; linarith
    have hlogM : log ((N : ℝ) / L) = L - log L := Real.log_div hN0.ne' hlN.ne'
    have hb := split_bound c hc0 hc1 N (N / L) hM
    rw [hlogM] at hb
    have hpos : 0 < L - log L := by linarith
    simp only [Pi.div_apply]
    rw [← hLdef, div_le_iff₀ (by positivity)]
    calc A N ≤ 2 * (N / L) * (N / L + 1) + B N / (L - log L) := hb
      _ = _ := by
        field_simp
        ring


lemma add_const_equiv (f : ℕ → ℝ) (C : ℝ) (hf : Tendsto f atTop atTop) :
    (fun x => f x + C) ~[atTop] f := by
  show IsLittleO _ _ _
  have : (fun x => f x + C) - f = fun _ => C := by funext x; simp
  rw [this]
  exact isLittleO_const_left.mpr (Or.inr (tendsto_norm_atTop_atTop.comp hf))

/-- sum of the primes up to `N` -/
noncomputable def P (N : ℕ) : ℝ := ∑ n ∈ range (N + 1), (n : ℝ) * (if n.Prime then 1 else 0)

/-- the comparison function `N ^ 2 / (2 log N)` -/
noncomputable def G (N : ℕ) : ℝ := (N : ℝ) ^ 2 / (2 * log N)

lemma range_eq_Icc (m : ℕ) : range (m + 1) = Icc 0 m := by
  ext n; simp only [mem_range, mem_Icc]; omega

lemma P_equiv : (fun N => P N) ~[atTop] G := by
  refine split_equiv (fun n => if n.Prime then 1 else 0) (fun n => by split_ifs <;> norm_num)
    (fun n => by split_ifs <;> norm_num) (abel_sq _ ?_)
  have h := OMALib.PNT.chebyshev_asymptotic.comp_tendsto (tendsto_natCast_atTop_atTop (R := ℝ))
  refine h.congr_left (Eventually.of_forall fun m => ?_)
  simp only [Function.comp_apply]
  rw [Chebyshev.theta_eq_sum_Icc, Nat.floor_natCast, sum_filter, ← range_eq_Icc]
  refine sum_congr rfl fun n _ => ?_
  split_ifs <;> simp

lemma W_equiv : (fun N : ℕ => ∑ n ∈ range (N + 1), (n : ℝ) * (if 2 ≤ n then 1 / log n else 0))
    ~[atTop] G := by
  refine split_equiv (fun n => if 2 ≤ n then 1 / log n else 0) (fun n => by
      split_ifs with h
      · have : (1 : ℝ) < n := by exact_mod_cast h
        exact (one_div_pos.mpr (Real.log_pos this)).le
      · exact le_refl _)
    (fun n => by
      split_ifs with h
      · have h2 : (2 : ℝ) ≤ n := by exact_mod_cast h
        have := Real.log_le_log (by norm_num) h2
        have := Real.log_two_gt_d9
        rw [div_le_iff₀ (by linarith)]
        linarith
      · norm_num) (abel_sq _ ?_)
  have hF : ∀ m : ℕ, 1 ≤ m →
      ∑ n ∈ range (m + 1), (if 2 ≤ n then 1 / log (n : ℝ) else 0) * log n = (m : ℝ) - 1 := by
    intro m hm
    induction m, hm using Nat.le_induction with
    | base => simp [sum_range_succ]
    | succ m hm ih =>
      rw [sum_range_succ, ih, if_pos (by omega)]
      have : (1 : ℝ) < ((m + 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 1 < m + 1)
      have := (Real.log_pos this).ne'
      field_simp
      push_cast; ring
  have h1 : (fun m : ℕ => (m : ℝ) + (-1)) ~[atTop] (fun m : ℕ => (m : ℝ)) :=
    add_const_equiv (fun m : ℕ => (m : ℝ)) (-1) tendsto_natCast_atTop_atTop
  refine h1.congr_left ?_
  filter_upwards [eventually_ge_atTop 1] with m hm
  rw [hF m hm]; ring

lemma P_div (k : ℕ) (hk : 0 < k) : (fun x : ℕ => P (x / k)) ~[atTop] (fun x => G x / (k : ℝ) ^ 2) := by
  have hk' : (0 : ℝ) < k := by exact_mod_cast hk
  have htk : Tendsto (fun x : ℕ => (x : ℝ) / k) atTop atTop :=
    tendsto_natCast_atTop_atTop.atTop_div_const hk'
  have h1 : (fun x : ℕ => P (x / k)) ~[atTop] (fun x => G (x / k)) :=
    P_equiv.comp_tendsto (Nat.tendsto_div_const_atTop hk.ne')
  have h2 : (fun x : ℕ => (((x / k : ℕ)) : ℝ)) ~[atTop] (fun x : ℕ => (x : ℝ) / k) := by
    rw [isEquivalent_iff_tendsto_one ((eventually_ge_atTop 1).mono fun x hx => by
      have : (0 : ℝ) < x := by exact_mod_cast hx
      positivity)]
    have := (tendsto_nat_floor_div_atTop (R := ℝ)).comp htk
    refine this.congr' (Eventually.of_forall fun x => ?_)
    simp only [Function.comp_apply, Pi.div_apply]
    rw [Nat.floor_div_eq_div]
  have h3 : (fun x : ℕ => log (((x / k : ℕ)) : ℝ)) ~[atTop] (fun x : ℕ => log ((x : ℝ) / k)) :=
    h2.log htk
  have hL : Tendsto (fun N : ℕ => log (N : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have h4 : (fun x : ℕ => log ((x : ℝ) / k)) ~[atTop] (fun x : ℕ => log (x : ℝ)) := by
    refine (add_const_equiv _ (-log k) hL).congr_left ?_
    filter_upwards [eventually_ge_atTop 1] with x hx
    have : (0 : ℝ) < x := by exact_mod_cast hx
    rw [Real.log_div this.ne' hk'.ne']; ring
  have h5 := (h2.pow 2).div ((IsEquivalent.refl (u := fun _ : ℕ => (2 : ℝ))).mul (h3.trans h4))
  refine (h1.trans (h5.congr_left (Eventually.of_forall fun x => ?_))).congr_right
    (Eventually.of_forall fun x => ?_)
  · simp [G]
  · simp only [G, Pi.div_apply, Pi.pow_apply, Pi.mul_apply]
    field_simp


lemma a_nonempty (n : ℕ) (hn : 0 < n) : {m | ∃ k : ℕ, 0 < k ∧ n = k * (k + m)}.Nonempty :=
  ⟨n - 1, 1, one_pos, by omega⟩

lemma a_le {n k m : ℕ} (hk : 0 < k) (h : n = k * (k + m)) : a n ≤ m :=
  Nat.sInf_le ⟨k, hk, h⟩

lemma a_spec {n : ℕ} (hn : 0 < n) : ∃ k : ℕ, 0 < k ∧ n = k * (k + a n) :=
  Nat.sInf_mem (a_nonempty n hn)

lemma a_ge {k q : ℕ} (hq : q.Prime) (hk : 0 < k) (hkq : k < q) : q - k ≤ a (k * q) := by
  obtain ⟨j, hj, hjq⟩ := a_spec (Nat.mul_pos hk hq.pos)
  have hdvd : j ∣ k * q := ⟨j + a (k * q), hjq⟩
  by_cases hqj : q ∣ j
  · obtain ⟨r, rfl⟩ := hqj
    have hr : 0 < r := Nat.pos_of_mul_pos_left hj
    have h1 : q ≤ q * r := Nat.le_mul_of_pos_right q hr
    have : q * q ≤ k * q := by
      rw [hjq]; exact Nat.mul_le_mul h1 (le_trans h1 (Nat.le_add_right _ _))
    have := Nat.le_of_mul_le_mul_right this hq.pos
    omega
  · have hcop : Nat.Coprime j q := (Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd hq).mpr hqj))
    have hjk : j ∣ k := hcop.dvd_of_dvd_mul_right hdvd
    obtain ⟨s, rfl⟩ := hjk
    have hs : 0 < s := Nat.pos_of_mul_pos_left hk
    have h2 : s * q = j + a (j * s * q) := by
      have : j * (s * q) = j * (j + a (j * s * q)) := by rw [← mul_assoc]; exact hjq
      exact Nat.eq_of_mul_eq_mul_left hj this
    have : q ≤ s * q := Nat.le_mul_of_pos_left q hs
    have : j ≤ j * s := Nat.le_mul_of_pos_right j hs
    omega

/-- the structure lemma used for the upper bound -/
lemma a_upper {n D : ℕ} (hn : 0 < n) (hD : 0 < D) :
    a n ≤ n / D + D ^ 2 ∨ ∃ d q : ℕ, 0 < d ∧ d < D ∧ q.Prime ∧ n = d * q ∧ a n ≤ q := by
  obtain ⟨d, hd, hdn⟩ := a_spec hn
  set t := d + a n with ht
  have hat : a n ≤ t := by omega
  -- minimality: every factorisation n = u * v with u ≤ v has v - u ≥ t - d
  have hmin : ∀ u v : ℕ, 0 < u → u ≤ v → n = u * v → t ≤ v - u + d := by
    intro u v hu huv h
    have := a_le (n := n) (k := u) (m := v - u) hu (by rw [h]; congr 1; omega)
    omega
  have ht0 : 0 < t := by omega
  -- for a prime p dividing t, t ≤ d * p
  have hp : ∀ p : ℕ, p.Prime → p ∣ t → t ≤ d * p := by
    intro p hpp hpt
    obtain ⟨s, hs⟩ := hpt
    have hp2 := hpp.two_le
    have hs0 : 0 < s := by
      rcases Nat.eq_zero_or_pos s with h | h
      · subst h; simp at hs; omega
      · exact h
    have hn' : n = (d * p) * s := by rw [hdn, hs]; ring
    rcases le_total (d * p) s with h | h
    · have := hmin (d * p) s (Nat.mul_pos hd hpp.pos) h hn'
      -- t = p * s ≥ 2 s, contradiction
      have : d < d * p := by nlinarith
      have : s ≤ p * s := Nat.le_mul_of_pos_left s hpp.pos
      omega
    · have := hmin s (d * p) hs0 h (by rw [hn']; ring)
      have hsd : s ≤ d := by
        -- p * s ≤ d * p - s + d  →  (p+1) s ≤ d (p+1)
        have h3 : p * s + s ≤ d * p + d := by omega
        nlinarith
      rw [hs]; nlinarith
  by_cases hdD : D ≤ d
  · left
    have : t ≤ n / D := by
      rw [Nat.le_div_iff_mul_le hD, hdn]
      nlinarith
    exact le_trans hat (le_trans this (Nat.le_add_right _ _))
  · push Not at hdD
    by_cases htp : t.Prime
    · right
      exact ⟨d, t, hd, hdD, htp, hdn, hat⟩
    · left
      rcases Nat.lt_or_ge t 2 with h1 | h1
      · have : 1 ≤ D ^ 2 := Nat.one_le_pow _ _ hD
        exact le_trans (by omega : a n ≤ 1) (le_trans this (Nat.le_add_left _ _))
      · have hmf := Nat.minFac_prime (show t ≠ 1 by omega)
        have h1' := hp _ hmf (Nat.minFac_dvd t)
        have h2 := Nat.minFac_sq_le_self ht0 htp
        have h3 : t.minFac ≤ d := by
          have : t.minFac * t.minFac ≤ d * t.minFac := by nlinarith
          exact Nat.le_of_mul_le_mul_right this hmf.pos
        have : t ≤ D ^ 2 := by nlinarith
        exact le_trans hat (le_trans this (Nat.le_add_left _ _))


lemma S_lower (K x : ℕ) :
    ∑ k ∈ Icc 1 K, (P (x / k) - K * (x + 1)) ≤ ∑ n ∈ Icc 1 x, (a n : ℝ) := by
  set R : ℕ → Finset ℕ := fun k => (range (x / k + 1)).filter (fun q => q.Prime ∧ K < q) with hR
  have step1 : ∀ k ∈ Icc 1 K, P (x / k) - K * (x + 1) ≤ ∑ q ∈ R k, ((q : ℝ) - K) := by
    intro k _
    have hterm : ∀ q ∈ range (x / k + 1), (q : ℝ) * (if q.Prime then 1 else 0) ≤
        (if q.Prime ∧ K < q then (q : ℝ) - K else 0) + K := by
      intro q _
      by_cases hq : q.Prime
      · by_cases hKq : K < q
        · simp [hq, hKq]
        · simp only [hq, if_true, mul_one, true_and, hKq, if_false, zero_add]
          exact_mod_cast (not_lt.mp hKq)
      · simp [hq]
    have h1 := sum_le_sum hterm
    rw [sum_add_distrib, sum_const, card_range, ← sum_filter, nsmul_eq_mul] at h1
    have h2 : ((x / k + 1 : ℕ) : ℝ) ≤ x + 1 := by
      have := Nat.div_le_self x k
      exact_mod_cast (by omega : x / k + 1 ≤ x + 1)
    have h3 : ((x / k + 1 : ℕ) : ℝ) * K ≤ K * (x + 1) := by nlinarith [(Nat.cast_nonneg K : (0:ℝ) ≤ K)]
    unfold P
    linarith
  refine (sum_le_sum step1).trans ?_
  rw [sum_sigma']
  set T := (Icc 1 K).sigma R
  have step3 : ∑ t ∈ T, ((t.2 : ℝ) - K) ≤ ∑ t ∈ T, (a (t.1 * t.2) : ℝ) := by
    refine sum_le_sum fun t ht => ?_
    simp only [T, hR, mem_sigma, mem_Icc, mem_filter, mem_range] at ht
    obtain ⟨⟨hk1, hkK⟩, _, hq, hKq⟩ := ht
    have := a_ge hq hk1 (by omega)
    have h' : ((t.2 - t.1 : ℕ) : ℝ) ≤ a (t.1 * t.2) := by exact_mod_cast this
    rw [Nat.cast_sub (by omega)] at h'
    have : (t.1 : ℝ) ≤ K := by exact_mod_cast hkK
    linarith
  refine step3.trans ?_
  have hinj : Set.InjOn (fun t : (_ : ℕ) × ℕ => t.1 * t.2) T := by
    intro t ht s hs hts
    simp only [T, hR, coe_sigma, Set.mem_sigma_iff, coe_Icc, Set.mem_Icc, coe_filter, mem_range,
      Set.mem_setOf_eq] at ht hs
    simp only at hts
    obtain ⟨⟨ht1, htK⟩, _, htq, hKt⟩ := ht
    obtain ⟨⟨hs1, hsK⟩, _, hsq, hKs⟩ := hs
    have hq : t.2 = s.2 := by
      have hdvd : t.2 ∣ s.1 * s.2 := ⟨t.1, by rw [← hts]; ring⟩
      rcases (Nat.Prime.dvd_mul htq).mp hdvd with h | h
      · have := Nat.le_of_dvd (by omega) h; omega
      · exact (Nat.prime_dvd_prime_iff_eq htq hsq).mp h
    have hk : t.1 = s.1 := by
      rw [hq] at hts
      exact Nat.eq_of_mul_eq_mul_right hsq.pos hts
    exact Sigma.ext hk (heq_of_eq hq)
  rw [← sum_image (f := fun n => (a n : ℝ)) hinj]
  refine sum_le_sum_of_subset_of_nonneg ?_ (fun _ _ _ => Nat.cast_nonneg _)
  intro n hn
  simp only [T, hR, mem_image, mem_sigma, mem_Icc, mem_filter, mem_range] at hn
  obtain ⟨t, ⟨⟨hk1, _⟩, hqx, hq, _⟩, rfl⟩ := hn
  simp only [mem_Icc]
  constructor
  · exact Nat.mul_pos (by omega) hq.pos
  · have := (Nat.le_div_iff_mul_le (by omega : 0 < t.1)).mp (Nat.lt_succ_iff.mp hqx)
    linarith [mul_comm t.1 t.2]

lemma S_upper (D x : ℕ) (hD : 0 < D) :
    ∑ n ∈ Icc 1 x, (a n : ℝ) ≤ x * ((x / D + D ^ 2 : ℕ) : ℝ) + ∑ d ∈ range D, P (x / d) := by
  set f : ℕ → ℕ → ℕ → ℝ := fun n d q => if q.Prime then (if n = d * q then (q : ℝ) else 0) else 0
    with hf
  have hf0 : ∀ n d q, 0 ≤ f n d q := by
    intro n d q; simp only [hf]; split_ifs <;> simp
  have hterm : ∀ n ∈ Icc 1 x, (a n : ℝ) ≤ ((x / D + D ^ 2 : ℕ) : ℝ) +
      ∑ d ∈ range D, ∑ q ∈ range (x / d + 1), f n d q := by
    intro n hn
    rw [mem_Icc] at hn
    have hS : 0 ≤ ∑ d ∈ range D, ∑ q ∈ range (x / d + 1), f n d q :=
      sum_nonneg fun d _ => sum_nonneg fun q _ => hf0 n d q
    rcases a_upper (by omega : 0 < n) hD with h | ⟨d, q, hd, hdD, hq, hn', haq⟩
    · have : a n ≤ x / D + D ^ 2 := le_trans h (by
        have := Nat.div_le_div_right (c := D) hn.2; omega)
      have : (a n : ℝ) ≤ ((x / D + D ^ 2 : ℕ) : ℝ) := by exact_mod_cast this
      linarith
    · have hqx : q ∈ range (x / d + 1) := by
        rw [mem_range, Nat.lt_succ_iff, Nat.le_div_iff_mul_le hd]
        rw [hn'] at hn; linarith [mul_comm d q]
      have h1 : f n d q ≤ ∑ q' ∈ range (x / d + 1), f n d q' :=
        single_le_sum (fun q' _ => hf0 n d q') hqx
      have h2 : ∑ q' ∈ range (x / d + 1), f n d q' ≤
          ∑ d' ∈ range D, ∑ q' ∈ range (x / d' + 1), f n d' q' :=
        single_le_sum (f := fun d' => ∑ q' ∈ range (x / d' + 1), f n d' q')
          (fun d' _ => sum_nonneg fun q' _ => hf0 n d' q') (mem_range.mpr hdD)
      have h3 : f n d q = q := by simp [hf, hq, hn']
      have : (a n : ℝ) ≤ q := by exact_mod_cast haq
      have : (0 : ℝ) ≤ ((x / D + D ^ 2 : ℕ) : ℝ) := Nat.cast_nonneg _
      linarith
  refine (sum_le_sum hterm).trans ?_
  rw [sum_add_distrib, sum_const, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel]
  gcongr
  rw [sum_comm]
  refine sum_le_sum fun d _ => ?_
  rw [sum_comm]
  unfold P
  refine sum_le_sum fun q _ => ?_
  by_cases hq : q.Prime
  · simp only [hf, hq, if_true, mul_one]
    rw [sum_ite_eq']
    split_ifs <;> simp
  · simp [hf, hq]


noncomputable def cz : ℝ := ∑' n : ℕ, 1 / (n : ℝ) ^ 2

noncomputable def cK (K : ℕ) : ℝ := ∑ n ∈ range (K + 1), 1 / (n : ℝ) ^ 2

lemma summable_inv_sq : Summable (fun n : ℕ => 1 / (n : ℝ) ^ 2) :=
  Real.summable_one_div_nat_pow.mpr one_lt_two

lemma cK_tendsto : Tendsto cK atTop (𝓝 cz) :=
  summable_inv_sq.hasSum.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)

lemma sum_range_le_cz (D : ℕ) : ∑ n ∈ range D, 1 / (n : ℝ) ^ 2 ≤ cz :=
  summable_inv_sq.sum_le_tsum _ (fun i _ => by positivity)

lemma cK_eq (K : ℕ) : cK K = ∑ k ∈ Icc 1 K, 1 / (k : ℝ) ^ 2 := by
  unfold cK
  rw [range_eq_Ico, sum_eq_sum_Ico_succ_bot (by omega), Finset.Ico_add_one_right_eq_Icc]
  simp

lemma cz_pos : 0 < cz := by
  have h := sum_range_le_cz 2
  simp [sum_range_succ] at h
  linarith

lemma G_nonneg (N : ℕ) : 0 ≤ G N :=
  div_nonneg (sq_nonneg _) (mul_nonneg two_pos.le (Real.log_natCast_nonneg N))

lemma P_zero : P 0 = 0 := by simp [P]

lemma P_tail : ∃ N₀, ∀ N ≥ N₀, P N ≤ 2 * G N := by
  obtain ⟨N₀, h⟩ := eventually_atTop.mp (P_equiv.isLittleO.bound one_pos)
  refine ⟨N₀, fun N hN => ?_⟩
  have h1 := h N hN
  simp only [Pi.sub_apply, Real.norm_eq_abs, one_mul, abs_of_nonneg (G_nonneg N)] at h1
  linarith [(abs_le.mp h1).2]

lemma sqrt_sqrt_four_le (x : ℕ) : (Nat.sqrt (Nat.sqrt x)) ^ 4 ≤ x := by
  have h1 := Nat.sqrt_le' (Nat.sqrt x)
  have h2 := Nat.sqrt_le' x
  calc (Nat.sqrt (Nat.sqrt x)) ^ 4 = ((Nat.sqrt (Nat.sqrt x)) ^ 2) ^ 2 := by ring
    _ ≤ (Nat.sqrt x) ^ 2 := Nat.pow_le_pow_left h1 2
    _ ≤ x := h2

lemma lt_sqrt_sqrt_four (x : ℕ) : x < (Nat.sqrt (Nat.sqrt x) + 1) ^ 4 := by
  have h1 := Nat.lt_succ_sqrt' (Nat.sqrt x)
  have h2 := Nat.lt_succ_sqrt' x
  have h3 : (Nat.sqrt x).succ ^ 2 ≤ ((Nat.sqrt (Nat.sqrt x)).succ ^ 2) ^ 2 :=
    Nat.pow_le_pow_left h1 2
  calc x < (Nat.sqrt x).succ ^ 2 := h2
    _ ≤ ((Nat.sqrt (Nat.sqrt x)).succ ^ 2) ^ 2 := h3
    _ = (Nat.sqrt (Nat.sqrt x) + 1) ^ 4 := by rw [Nat.succ_eq_add_one]; ring

lemma tendsto_sqrt_sqrt : Tendsto (fun x : ℕ => Nat.sqrt (Nat.sqrt x)) atTop atTop := by
  refine tendsto_atTop_atTop.mpr fun b => ⟨b ^ 4, fun x hx => ?_⟩
  rw [Nat.le_sqrt, Nat.le_sqrt]
  calc b * b * (b * b) = b ^ 4 := by ring
    _ ≤ x := hx

lemma tail_bound {x d D N₀ : ℕ} (hP : ∀ N ≥ N₀, P N ≤ 2 * G N) (hd : 1 ≤ d) (hdD : d < D)
    (hD2 : 2 ≤ D) (hDx : D ^ 4 ≤ x) (hN₀ : N₀ ≤ D) :
    P (x / d) ≤ 4 * G x / (d : ℝ) ^ 2 := by
  set N := x / d with hN
  have hd0 : 0 < d := hd
  have hDD : D * (D + 1) ≤ x := by
    have h2 : 4 ≤ D ^ 2 := by nlinarith
    have : D + 1 ≤ D ^ 3 := by
      calc D + 1 ≤ 4 * D := by omega
        _ ≤ D ^ 2 * D := Nat.mul_le_mul_right D h2
        _ = D ^ 3 := by ring
    calc D * (D + 1) ≤ D * D ^ 3 := Nat.mul_le_mul_left _ this
      _ = D ^ 4 := by ring
      _ ≤ x := hDx
  have hND : D + 1 ≤ N := by
    have : D + 1 ≤ x / D := (Nat.le_div_iff_mul_le (by omega)).mpr (by linarith [mul_comm D (D + 1)])
    exact le_trans this (Nat.div_le_div_left hdD.le hd0)
  have hxN : x ≤ N ^ 2 := by
    have h1 := Nat.lt_mul_div_succ x hd0
    have h2 : d + 1 ≤ N := by omega
    nlinarith
  have hNx : (N : ℝ) ≤ x / d := Nat.cast_div_le
  have hN2 : (1 : ℝ) < N := by exact_mod_cast (by omega : 1 < N)
  have hx16 : 16 ≤ x := le_trans (by simpa using Nat.pow_le_pow_left hD2 4) hDx
  have hx1 : (1 : ℝ) < x := by exact_mod_cast (by omega : 1 < x)
  have hlx : 0 < log (x : ℝ) := Real.log_pos hx1
  have hlN0 : 0 < log (N : ℝ) := Real.log_pos hN2
  have hlN : log (x : ℝ) ≤ 2 * log (N : ℝ) := by
    have : (x : ℝ) ≤ (N : ℝ) ^ 2 := by exact_mod_cast hxN
    calc log (x : ℝ) ≤ log ((N : ℝ) ^ 2) := Real.log_le_log (by positivity) this
      _ = 2 * log N := by rw [Real.log_pow]; push_cast; ring
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd0
  calc P N ≤ 2 * G N := hP N (by omega)
    _ = (N : ℝ) ^ 2 / log N := by unfold G; field_simp
    _ ≤ ((x : ℝ) / d) ^ 2 / (log x / 2) :=
        div_le_div₀ (by positivity) (pow_le_pow_left₀ (Nat.cast_nonneg _) hNx 2) (by positivity)
          (by linarith)
    _ = 4 * G x / (d : ℝ) ^ 2 := by unfold G; field_simp; ring

lemma err_upper (η : ℝ) (hη : 0 < η) : ∀ᶠ x : ℕ in atTop,
    (x : ℝ) * ((x / Nat.sqrt (Nat.sqrt x) + (Nat.sqrt (Nat.sqrt x)) ^ 2 : ℕ) : ℝ) ≤ η * G x := by
  have hlog : ∀ᶠ D : ℕ in atTop, 16 * log ((D : ℝ) + 1) ≤ η * D := by
    have h1 := Real.isLittleO_log_id_atTop.bound (show 0 < η / 32 by positivity)
    have h2 := (tendsto_atTop_add_const_right _ 1 (tendsto_natCast_atTop_atTop (R := ℝ))).eventually h1
    filter_upwards [h2, eventually_ge_atTop 1] with D hD hD1
    have hD1' : (1 : ℝ) ≤ D := by exact_mod_cast hD1
    have e1 : ‖log ((D : ℝ) + 1)‖ = |log ((D : ℝ) + 1)| := Real.norm_eq_abs _
    have e2 : ‖id ((D : ℝ) + 1)‖ = (D : ℝ) + 1 := by
      rw [id, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [e1, e2] at hD
    have h3 := le_trans (le_abs_self _) hD
    nlinarith
  filter_upwards [tendsto_sqrt_sqrt.eventually (hlog.and (eventually_ge_atTop 1)),
    eventually_ge_atTop 2] with x ⟨hx1, hx2⟩ hx3
  have h4 := sqrt_sqrt_four_le x
  have h5 := lt_sqrt_sqrt_four x
  set D := Nat.sqrt (Nat.sqrt x)
  have hD : (1 : ℝ) ≤ D := by exact_mod_cast hx2
  have hx : (1 : ℝ) < x := by exact_mod_cast (by omega : 1 < x)
  have hlx : 0 < log (x : ℝ) := Real.log_pos hx
  have hlx' : log (x : ℝ) < 4 * log ((D : ℝ) + 1) := by
    have : (x : ℝ) < ((D : ℝ) + 1) ^ 4 := by exact_mod_cast h5
    calc log (x : ℝ) < log (((D : ℝ) + 1) ^ 4) := Real.log_lt_log (by linarith) this
      _ = 4 * log ((D : ℝ) + 1) := by rw [Real.log_pow]; push_cast; ring
  have hD4 : (D : ℝ) ^ 4 ≤ x := by exact_mod_cast h4
  have hxD : ((x / D : ℕ) : ℝ) ≤ x / D := Nat.cast_div_le
  have hD2 : (D : ℝ) ^ 2 ≤ x / D := by
    rw [le_div_iff₀ (by linarith)]
    nlinarith
  have hsum : (((x / D + D ^ 2 : ℕ)) : ℝ) ≤ 2 * (x / D) := by push_cast; linarith
  have hx0 : (0 : ℝ) ≤ x := by linarith
  calc (x : ℝ) * (((x / D + D ^ 2 : ℕ)) : ℝ) ≤ x * (2 * (x / D)) :=
        mul_le_mul_of_nonneg_left hsum hx0
    _ ≤ η * G x := by
        unfold G
        have hDpos : (0 : ℝ) < D := by linarith
        have key : (x : ℝ) * (2 * (x / D)) = 2 * (x : ℝ) ^ 2 / D := by field_simp
        have key2 : η * ((x : ℝ) ^ 2 / (2 * log x)) = η * (x : ℝ) ^ 2 / (2 * log x) := by ring
        rw [key, key2, div_le_div_iff₀ hDpos (by positivity)]
        have : 4 * log (x : ℝ) ≤ η * D := by linarith
        have := mul_le_mul_of_nonneg_left this (sq_nonneg (x : ℝ))
        linarith

lemma err_lower (K : ℕ) (η : ℝ) (hη : 0 < η) : ∀ᶠ x : ℕ in atTop,
    (K : ℝ) * (K * (x + 1)) ≤ η * G x := by
  have hε : 0 < η / (4 * ((K : ℝ) ^ 2 + 1)) := by positivity
  set ε := η / (4 * ((K : ℝ) ^ 2 + 1)) with hεdef
  have h1 := (tendsto_natCast_atTop_atTop (R := ℝ)).eventually
    (Real.isLittleO_log_id_atTop.bound hε)
  filter_upwards [h1, eventually_ge_atTop 2] with x hx hx2
  have hx' : (1 : ℝ) < x := by exact_mod_cast (by omega : 1 < x)
  have hlx : 0 < log (x : ℝ) := Real.log_pos hx'
  have e1 : ‖log (x : ℝ)‖ = log x := by rw [Real.norm_eq_abs, abs_of_nonneg hlx.le]
  have e2 : ‖id (x : ℝ)‖ = x := by rw [id, Real.norm_eq_abs, abs_of_nonneg (by linarith)]
  rw [e1, e2] at hx
  have hε' : 4 * (K : ℝ) ^ 2 * ε ≤ η := by
    have : ε * (4 * ((K : ℝ) ^ 2 + 1)) = η := div_mul_cancel₀ _ (by positivity)
    nlinarith
  unfold G
  rw [show η * ((x : ℝ) ^ 2 / (2 * log x)) = η * (x : ℝ) ^ 2 / (2 * log x) by ring,
    le_div_iff₀ (by positivity)]
  have hK0 : (0 : ℝ) ≤ (K : ℝ) ^ 2 := sq_nonneg _
  calc (K : ℝ) * (K * (x + 1)) * (2 * log x) ≤ ((K : ℝ) ^ 2 * (2 * x)) * (2 * (ε * x)) := by
        rw [show (K : ℝ) * (K * (x + 1)) = (K : ℝ) ^ 2 * (x + 1) by ring]
        apply mul_le_mul (mul_le_mul_of_nonneg_left (by linarith) hK0) (by linarith)
          (by positivity) (by positivity)
    _ = (4 * (K : ℝ) ^ 2 * ε) * (x : ℝ) ^ 2 := by ring
    _ ≤ η * (x : ℝ) ^ 2 := mul_le_mul_of_nonneg_right hε' (sq_nonneg _)


lemma P_div_ev (K : ℕ) {δ : ℝ} (hδ : 0 < δ) : ∀ᶠ x : ℕ in atTop, ∀ d ∈ Icc 1 K,
    |P (x / d) - G x / (d : ℝ) ^ 2| ≤ δ * (G x / (d : ℝ) ^ 2) := by
  rw [eventually_all_finset]
  intro d hd
  have hd1 : 0 < d := by simp only [mem_Icc] at hd; omega
  filter_upwards [(P_div d hd1).isLittleO.bound hδ] with x hx
  simp only [Pi.sub_apply, Real.norm_eq_abs] at hx
  rwa [abs_of_nonneg (div_nonneg (G_nonneg x) (by positivity))] at hx

lemma exists_K (η : ℝ) (hη : 0 < η) : ∃ K : ℕ, 1 ≤ K ∧ cz - cK K < η := by
  obtain ⟨K, hK1, hK2⟩ := ((cK_tendsto.eventually (Ioi_mem_nhds
    (show cz - η < cz by linarith))).and (eventually_ge_atTop 1)).exists
  exact ⟨K, hK2, by linarith [hK1]⟩

lemma S_upper_ev (η : ℝ) (hη : 0 < η) :
    ∀ᶠ x : ℕ in atTop, ∑ n ∈ Icc 1 x, (a n : ℝ) ≤ (cz + η) * G x := by
  obtain ⟨K, hK1, hK⟩ := exists_K (η / 12) (by positivity)
  obtain ⟨N₀, hP⟩ := P_tail
  have hδ : 0 < η / (3 * (K + 1)) := by positivity
  filter_upwards [P_div_ev K hδ, tendsto_sqrt_sqrt.eventually (eventually_ge_atTop (K + 2 + N₀)),
    err_upper (η / 3) (by positivity)] with x h1 h2 h3
  have h4 := sqrt_sqrt_four_le x
  set D := Nat.sqrt (Nat.sqrt x)
  have hGx := G_nonneg x
  have hSu := S_upper D x (by omega)
  have hsplit : ∑ d ∈ range D, P (x / d) =
      ∑ d ∈ Icc 1 K, P (x / d) + ∑ d ∈ Ico (K + 1) D, P (x / d) := by
    rw [← sum_range_add_sum_Ico _ (by omega : K + 1 ≤ D), range_eq_Ico,
      sum_eq_sum_Ico_succ_bot (by omega), Nat.div_zero, P_zero, zero_add,
      Finset.Ico_add_one_right_eq_Icc]
  have hsmall : ∑ d ∈ Icc 1 K, P (x / d) ≤ cK K * G x + η / 3 * G x := by
    have : ∀ d ∈ Icc 1 K, P (x / d) ≤ G x * (1 / (d : ℝ) ^ 2) + η / (3 * (K + 1)) * G x := by
      intro d hd
      have hh := h1 d hd
      have hd1 : (1 : ℝ) ≤ d := by simp only [mem_Icc] at hd; exact_mod_cast hd.1
      have hle : G x / (d : ℝ) ^ 2 ≤ G x := div_le_self hGx (by nlinarith)
      have := (abs_le.mp hh).2
      have : η / (3 * (K + 1)) * (G x / (d : ℝ) ^ 2) ≤ η / (3 * (K + 1)) * G x :=
        mul_le_mul_of_nonneg_left hle hδ.le
      rw [mul_one_div]
      linarith
    refine (sum_le_sum this).trans ?_
    rw [sum_add_distrib, ← mul_sum, ← cK_eq, sum_const, Nat.card_Icc, nsmul_eq_mul,
      Nat.add_sub_cancel]
    have hK' : (K : ℝ) * (η / (3 * (K + 1))) ≤ η / 3 := by
      rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    have : (K : ℝ) * (η / (3 * (K + 1)) * G x) ≤ η / 3 * G x := by
      rw [← mul_assoc]; exact mul_le_mul_of_nonneg_right hK' hGx
    linarith [mul_comm (G x) (cK K)]
  have htail : ∑ d ∈ Ico (K + 1) D, P (x / d) ≤ 4 * G x * (cz - cK K) := by
    have : ∀ d ∈ Ico (K + 1) D, P (x / d) ≤ 4 * G x * (1 / (d : ℝ) ^ 2) := by
      intro d hd
      simp only [mem_Ico] at hd
      rw [mul_one_div]
      exact tail_bound hP (by omega) hd.2 (by omega) h4 (by omega)
    refine (sum_le_sum this).trans ?_
    rw [← mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    have h5 := sum_range_le_cz D
    rw [← sum_range_add_sum_Ico _ (by omega : K + 1 ≤ D)] at h5
    unfold cK
    linarith
  have hcK : cK K * G x ≤ cz * G x :=
    mul_le_mul_of_nonneg_right (show cK K ≤ cz from sum_range_le_cz (K + 1)) hGx
  have : 4 * G x * (cz - cK K) ≤ η / 3 * G x := by
    have : 4 * (cz - cK K) ≤ η / 3 := by linarith
    nlinarith
  linarith

lemma S_lower_ev (η : ℝ) (hη : 0 < η) :
    ∀ᶠ x : ℕ in atTop, (cz - η) * G x ≤ ∑ n ∈ Icc 1 x, (a n : ℝ) := by
  obtain ⟨K, hK1, hK⟩ := exists_K (η / 3) (by positivity)
  have hK0 : (0 : ℝ) < K := by exact_mod_cast hK1
  have hδ : 0 < η / (3 * K) := by positivity
  filter_upwards [P_div_ev K hδ, err_lower K (η / 3) (by positivity)] with x h1 h2
  have hGx := G_nonneg x
  have hSl := S_lower K x
  rw [sum_sub_distrib, sum_const, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel] at hSl
  have hbig : cK K * G x - η / 3 * G x ≤ ∑ k ∈ Icc 1 K, P (x / k) := by
    have : ∀ k ∈ Icc 1 K, G x * (1 / (k : ℝ) ^ 2) - η / (3 * K) * G x ≤ P (x / k) := by
      intro k hk
      have hh := h1 k hk
      have hk1 : (1 : ℝ) ≤ k := by simp only [mem_Icc] at hk; exact_mod_cast hk.1
      have hle : G x / (k : ℝ) ^ 2 ≤ G x := div_le_self hGx (by nlinarith)
      have := (abs_le.mp hh).1
      have : η / (3 * K) * (G x / (k : ℝ) ^ 2) ≤ η / (3 * K) * G x :=
        mul_le_mul_of_nonneg_left hle hδ.le
      rw [mul_one_div]
      linarith
    refine le_trans ?_ (sum_le_sum this)
    rw [sum_sub_distrib, ← mul_sum, ← cK_eq, sum_const, Nat.card_Icc, nsmul_eq_mul,
      Nat.add_sub_cancel]
    have : (K : ℝ) * (η / (3 * K) * G x) = η / 3 * G x := by field_simp
    linarith [mul_comm (G x) (cK K)]
  have hcK : cK K ≤ cz := sum_range_le_cz (K + 1)
  have : (cz - cK K) * G x ≤ η / 3 * G x := mul_le_mul_of_nonneg_right hK.le hGx
  nlinarith

theorem S_equiv : (fun x : ℕ => ∑ n ∈ Icc 1 x, (a n : ℝ)) ~[atTop] (fun x => cz * G x) := by
  show IsLittleO _ _ _
  rw [isLittleO_iff]
  intro ε hε
  have hη : 0 < ε * cz := mul_pos hε cz_pos
  filter_upwards [S_lower_ev _ hη, S_upper_ev _ hη] with x h1 h2
  have hGx := G_nonneg x
  have habs : ‖cz * G x‖ = cz * G x := by
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg cz_pos.le hGx)]
  rw [habs, Pi.sub_apply, Real.norm_eq_abs, abs_le]
  constructor <;> nlinarith

theorem main' : ∃ c : ℝ, 0 < c ∧
    (fun x : ℕ => ∑ n ∈ Finset.Icc 1 x, (a n : ℝ)) ~[atTop]
      fun x : ℕ => ∑ n ∈ Finset.Icc 2 x, c * n / log n := by
  refine ⟨cz, cz_pos, ?_⟩
  have hW := (IsEquivalent.refl (u := fun _ : ℕ => cz)).mul W_equiv
  refine (S_equiv.trans hW.symm).congr_right (Eventually.of_forall fun x => ?_)
  simp only [Pi.mul_apply]
