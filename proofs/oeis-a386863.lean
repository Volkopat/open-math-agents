/-- Shifting a factorial. -/
lemma fsh (E : ℕ) : ∀ j : ℕ, ((E + j).factorial : ℚ)
    = (∏ i ∈ Finset.range j, ((E : ℚ) + (i : ℚ) + 1)) * (E.factorial : ℚ)
  | 0 => by simp
  | j + 1 => by
    rw [show E + (j + 1) = (E + j) + 1 from rfl, Nat.factorial_succ, Finset.prod_range_succ]
    push_cast
    rw [fsh E j]
    ring

/-- The summand in factorial form, as a function of k and t = n - k. -/
noncomputable def Φ (k t : ℕ) : ℚ :=
  (1 : ℚ) ^ k * (2 : ℚ) ^ t * ((3 * k + 3 * t + 1).factorial : ℚ)
    / (((k).factorial : ℚ) * ((2 * k + 3 * t + 1).factorial : ℚ)) * ((2 * k + 3 * t).factorial : ℚ)
    / (((t).factorial : ℚ) * ((2 * k + 2 * t).factorial : ℚ))
    * ((2 * ((k : ℚ) + (t : ℚ))) / (2 * (k : ℚ) + 3 * (t : ℚ)))

/-- The summand of the sequence. -/
def F (n k : ℕ) : ℤ :=
  (1 : ℤ) ^ k * (2 : ℤ) ^ (n - k) * ((3 * n + 1).choose k : ℤ) * ((3 * n - k - 1).choose (n - k) : ℤ)

lemma a_eq (n : ℕ) : a n = ∑ k ∈ Finset.range (n + 1), F n k := by
  unfold a
  apply Finset.sum_congr rfl
  intro k _
  unfold F
  ring

lemma F_eq (k t : ℕ) (hkt : 1 ≤ k + t) : (F (k + t) k : ℚ) = Φ k t := by
  have h1 : ((3 * (k + t) + 1).choose k : ℚ)
      = ((3 * k + 3 * t + 1).factorial : ℚ) / ((k.factorial : ℚ) * ((2 * k + 3 * t + 1).factorial : ℚ)) := by
    rw [Nat.cast_choose ℚ (by omega : k ≤ 3 * (k + t) + 1)]
    rw [show 3 * (k + t) + 1 - k = 2 * k + 3 * t + 1 from by omega,
      show 3 * (k + t) + 1 = 3 * k + 3 * t + 1 from by ring]
  have hC : 1 ≤ 2 * k + 3 * t := by omega
  have hD : 1 ≤ 2 * k + 2 * t := by omega
  have fC : (((2 * k + 3 * t).factorial : ℕ) : ℚ) = ((2 * k + 3 * t : ℕ) : ℚ) * (((2 * k + 3 * t - 1).factorial : ℕ) : ℚ) := by
    rw [← Nat.mul_factorial_pred (by omega : 2 * k + 3 * t ≠ 0)]
    push_cast
    ring
  have fD : (((2 * k + 2 * t).factorial : ℕ) : ℚ) = ((2 * k + 2 * t : ℕ) : ℚ) * (((2 * k + 2 * t - 1).factorial : ℕ) : ℚ) := by
    rw [← Nat.mul_factorial_pred (by omega : 2 * k + 2 * t ≠ 0)]
    push_cast
    ring
  have h2 : ((3 * (k + t) - k - 1).choose t : ℚ)
      = (((2 * k + 3 * t - 1).factorial : ℕ) : ℚ) / ((t.factorial : ℚ) * (((2 * k + 2 * t - 1).factorial : ℕ) : ℚ)) := by
    rw [show 3 * (k + t) - k - 1 = 2 * k + 3 * t - 1 from by omega]
    rw [Nat.cast_choose ℚ (by omega : t ≤ 2 * k + 3 * t - 1)]
    rw [show 2 * k + 3 * t - 1 - t = 2 * k + 2 * t - 1 from by omega]
  have hCq : (((2 * k + 3 * t : ℕ) : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hDq : (((2 * k + 2 * t : ℕ) : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hC1 : ((((2 * k + 3 * t - 1).factorial : ℕ) : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hD1 : ((((2 * k + 2 * t - 1).factorial : ℕ) : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hk1 : ((k.factorial : ℕ) : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have ht1 : ((t.factorial : ℕ) : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hB1 : (((2 * k + 3 * t + 1).factorial : ℕ) : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hfac : ((2 * ((k : ℚ) + (t : ℚ))) / (2 * (k : ℚ) + 3 * (t : ℚ)))
      = ((2 * k + 2 * t : ℕ) : ℚ) / ((2 * k + 3 * t : ℕ) : ℚ) := by
    push_cast
    ring
  unfold F Φ
  push_cast [Nat.add_sub_cancel_left]
  rw [h1, h2]
  rw [fC, fD]
  have hktq : ((k : ℚ) + (t : ℚ)) ≠ 0 := by
    have h0 : (0 : ℚ) < (k : ℚ) + (t : ℚ) := by exact_mod_cast hkt
    exact h0.ne'
  have hfac' := hfac
  push_cast at hfac' hCq hDq ⊢
  rw [hfac']
  field_simp
  try ring


