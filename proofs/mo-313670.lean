import OMAStatements.S_mo_313670

/-! STATUS: NEW

Alireza Abdollahi asks whether the support size of a right annihilator
of 1+x±y bounds the exponent of the subgroup generated by x and y.
Source: https://mathoverflow.net/questions/313670

Seeking finite quotients of the (2,3,6) triangle group led to the
rotation and half turn below. Their six-cycle gives an annihilator of
support at most twelve, and their commutator translates by a vector
of arbitrarily large order. Kionke's related construction on
MathOverflow 313639 uses four terms in the first factor. Rickard's
three-term example on MathOverflow 208506 uses a fixed finite group.
Credit: @Mapika. -/
open Finset MonoidAlgebra
namespace TriangleAnnihilator

private abbrev V (m : ℕ) := ZMod m × ZMod m × ZMod m
private abbrev G (m : ℕ) := Equiv.Perm (V m)

private def rot (m : ℕ) : G m where
  toFun v := (v.2.2,v.1,v.2.1)
  invFun v := (v.2.1,v.2.2,v.1)
  left_inv _ := rfl
  right_inv _ := rfl

private def half (m : ℕ) : G m where
  toFun v := (1-v.1,-v.2.1,-v.2.2)
  invFun v := (1-v.1,-v.2.1,-v.2.2)
  left_inv v := by simp
  right_inv v := by simp

private abbrev turn (m : ℕ) := rot m * half m

private lemma rot_three (m : ℕ) : rot m ^ 3 = 1 := by
  ext v <;> rfl

private lemma half_two (m : ℕ) : half m ^ 2 = 1 := by
  apply Equiv.ext
  intro v
  change (1-(1-v.1),-(-v.2.1),-(-v.2.2)) = v
  simp

private lemma turn_six (m : ℕ) : turn m ^ 6 = 1 := by
  apply Equiv.ext
  intro v
  simp [turn, pow_succ, Equiv.Perm.mul_apply, rot, half]

private lemma orbit_moves (m : ℕ) [Fact (1 < m)] (j : Fin 5) :
    (turn m ^ (j.val+1)) (0,0,0) ≠ (0,0,0) := by
  fin_cases j <;> norm_num [turn, pow_succ, Equiv.Perm.mul_apply, rot, half]

private lemma rotation_moves (m : ℕ) [Fact (1 < m)] : rot m ≠ 1 := by
  intro h
  have := DFunLike.congr_fun h (1,0,0)
  simp [rot] at this

private lemma trans_power (m k : ℕ) (v : V m) :
    ((rot m * half m * (rot m)⁻¹ * half m)^k) v =
      (v.1 - (k:ZMod m),v.2.1 + (k:ZMod m),v.2.2) := by
  induction k generalizing v with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, Equiv.Perm.mul_apply, ih]
    simp [rot, half, Equiv.Perm.mul_apply]
    constructor <;> abel

private lemma exponent_bound (m : ℕ) [NeZero m] :
    m ≤ Monoid.exponent (Subgroup.closure ({rot m, rot m^2 * half m} : Set (G m))) := by
  let H := Subgroup.closure ({rot m, rot m^2 * half m} : Set (G m))
  have ha : rot m ∈ H := Subgroup.subset_closure (by simp)
  have hy : rot m^2 * half m ∈ H := Subgroup.subset_closure (by simp)
  have hb : half m ∈ H := by
    have h := H.mul_mem ha hy
    simpa [← mul_assoc, ← pow_succ', rot_three] using h
  let g : H := ⟨_, H.mul_mem (H.mul_mem (H.mul_mem ha hb) (H.inv_mem ha)) hb⟩
  let e := Monoid.exponent H
  have h := congrArg (fun u : H => (u.val (0,0,0)).2.1) (Monoid.pow_exponent_eq_one g)
  change (((rot m * half m * (rot m)⁻¹ * half m)^e) (0,0,0)).2.1 = 0 at h
  rw [trans_power] at h
  have hd : m ∣ e := (ZMod.natCast_eq_zero_iff e m).mp (by simpa using h)
  exact Nat.le_of_dvd (Monoid.exponent_pos.mpr Monoid.ExponentExists.of_finite) hd


private def alternating {R : Type*} [Ring R] (t : R) := 1-t+t^2-t^3+t^4-t^5

private lemma alternating_shift {R : Type*} [Ring R] {t : R} (ht : t^6=1) :
    t * alternating t = -alternating t := by
  apply eq_neg_of_add_eq_zero_left
  calc
    t * alternating t + alternating t = 1-t^6 := by unfold alternating; noncomm_ring
    _ = 0 := by rw [ht, sub_self]

private lemma sparse_annihilation {R : Type*} [Ring R] (a b : R)
    (ha : a^3=1) (hb : b^2=1) (ht : (a*b)^6=1) :
    (1+a+a^2*b)*((1-a^2)*alternating (a*b))=0 := by
  let u := alternating (a*b)
  have hturn : (a*b)*u = -u := alternating_shift ht
  have bru : b*u = -(a^2*u) := by
    calc
      b*u = (a^2*(a*b))*u := by rw [← mul_assoc, ← pow_succ, ha, one_mul]
      _ = a^2*((a*b)*u) := by rw [mul_assoc]
      _ = _ := by rw [hturn, mul_neg]
  have alt : (1-a^2)*u = (1+b)*u := by simp [add_mul, bru, sub_eq_add_neg]
  have fix : b*((1-a^2)*u)=(1-a^2)*u := by
    rw [alt, ← mul_assoc]
    congr 1
    rw [mul_add, mul_one, ← sq, hb, add_comm]
  change (1+a+a^2*b)*((1-a^2)*u)=0
  calc
    _ = (1+a+a^2)*((1-a^2)*u) := by rw [add_mul, mul_assoc (a^2), fix, ← add_mul]
    _ = ((1+a+a^2)*(1-a^2))*u := (mul_assoc ..).symm
    _ = 0 := by
      have h : (1+a+a^2)*(1-a^2)=1+a-a^3-a^3*a := by noncomm_ring
      rw [h,ha,one_mul]
      noncomm_ring

private lemma alternating_coeff {K : Type*} [Group K] [DecidableEq K] (t g : K) :
    (alternating (of ℂ K t)).coeff g =
        (if 1=g then 1 else 0) - (if t=g then 1 else 0) +
        (if t^2=g then 1 else 0) - (if t^3=g then 1 else 0) +
        (if t^4=g then 1 else 0) - (if t^5=g then 1 else 0) := by
  simp [alternating, MonoidAlgebra.one_def, of_apply, Finsupp.single_apply]

private lemma size_bound {K : Type*} [Group K] [DecidableEq K] (a t : K) :
    (((1-of ℂ K a) * alternating (of ℂ K t)).coeff.support.card) ≤ 12 := by
  let u := alternating (of ℂ K t)
  let s : Finset K := {1,t,t^2,t^3,t^4,t^5}
  have sub : u.coeff.support ⊆ s := by
    intro g hg
    by_contra hn
    have nh : g ≠ 1 ∧ g ≠ t ∧ g ≠ t^2 ∧ g ≠ t^3 ∧ g ≠ t^4 ∧ g ≠ t^5 := by
      simpa [s, not_or] using hn
    rcases nh with ⟨n₀,n₁,n₂,n₃,n₄,n₅⟩
    apply (Finsupp.mem_support_iff.mp hg)
    dsimp only [u]
    rw [alternating_coeff]
    simp [n₀.symm,n₁.symm,n₂.symm,n₃.symm,n₄.symm,n₅.symm]
  have sc : s.card ≤ 6 := by
    dsimp [s]
    calc
      _ ≤ _ := Finset.card_insert_le ..
      _ ≤ _ := by
        have h := Finset.card_insert_le  t ({t^2,t^3,t^4,t^5} : Finset K)
        have h' := Finset.card_insert_le (t^2) ({t^3,t^4,t^5} : Finset K)
        have h'' := Finset.card_insert_le (t^3) ({t^4,t^5} : Finset K)
        have h''' := Finset.card_insert_le (t^4) ({t^5} : Finset K)
        simp only [card_singleton] at h'''
        omega
  have cu := (card_le_card sub).trans sc
  have cm := card_le_card (support_coeff_single_mul_subset u (1:ℂ) a)
  have cb := Finsupp.support_sub (f := u.coeff) (g := ((of ℂ K a)*u).coeff)
  rw [sub_mul,one_mul, coeff_sub]
  exact (card_le_card cb).trans ((card_union_le ..).trans (by
    have ci := Finset.card_image_le (s := u.coeff.support) (f := (a * ·))
    change (single a 1 * u).coeff.support.card ≤ _ at cm
    change u.coeff.support.card + (single a 1 * u).coeff.support.card ≤ 12
    omega))


private lemma at_fixed_origin (m : ℕ) [Fact (1 < m)] (g : G m)
    (hg : g (0,0,0) = (0,0,0)) :
    (alternating (of ℂ (G m) (turn m))).coeff g = if 1=g then 1 else 0 := by
  have notEq (j : Fin 5) : turn m ^ (j.val+1) ≠ g := by
    intro eqn
    exact orbit_moves m j ((DFunLike.congr_fun eqn _).trans hg)
  have h₁ : turn m ≠ g := by simpa using notEq 0
  have h₂ : turn m ^ 2 ≠ g := notEq 1
  have h₃ : turn m ^ 3 ≠ g := notEq 2
  have h₄ : turn m ^ 4 ≠ g := notEq 3
  have h₅ : turn m ^ 5 ≠ g := notEq 4
  rw [alternating_coeff]
  simp only [if_neg h₁,if_neg h₂,if_neg h₃,if_neg h₄,if_neg h₅,sub_zero,add_zero]

private lemma witness_coeff (m : ℕ) [Fact (1 < m)] :
    (((1-of ℂ (G m) (rot m ^ 2)) * alternating (of ℂ (G m) (turn m))).coeff 1) = 1 := by
  rw [sub_mul,one_mul, coeff_sub, Finsupp.sub_apply]
  rw [at_fixed_origin m 1 rfl, if_pos rfl, of_apply, coeff_single_mul_apply]
  have hi : (rot m^2)⁻¹ = rot m := inv_eq_of_mul_eq_one_right (by rw [← pow_succ,rot_three])
  rw [mul_one,hi,at_fixed_origin m (rot m) rfl,if_neg (rotation_moves m).symm]
  ring

end TriangleAnnihilator

open TriangleAnnihilator in
theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_313670.main) := by
  classical
  rintro ⟨f,hf⟩
  let m := (Finset.range 13).sup f + 3
  have hm : 1 < m := by dsimp [m]; omega
  let : Fact (1 < m) := ⟨hm⟩
  let : NeZero m := ⟨by omega⟩
  let φ := of ℂ (G m)
  let β := (1-φ (rot m ^ 2)) * alternating (φ (turn m))
  have hc : β.coeff 1 = 1 := witness_coeff m
  have hn : β ≠ 0 := by intro h; simp [h] at hc
  have hs : (1 : G m) ∈ β.coeff.support := Finsupp.mem_support_iff.mpr (by rw [hc]; exact one_ne_zero)
  have ha : φ (rot m)^3=1 := by rw [← map_pow,rot_three,map_one]
  have hb : φ (half m)^2=1 := by rw [← map_pow,half_two,map_one]
  have ht : (φ (rot m)*φ (half m))^6=1 := by rw [← map_mul,← map_pow,turn_six,map_one]
  have hzero : (1+φ (rot m)+φ (rot m^2*half m))*β=0 := by
    simpa only [β,turn,map_mul,map_pow] using sparse_annihilation (φ (rot m)) (φ (half m)) ha hb ht
  have hmoves : (rot m^2*half m) (0,0,0) ≠ (0,0,0) := by
    simp [rot,half,pow_succ,Equiv.Perm.mul_apply]
  have hdistinct : rot m ≠ rot m^2*half m := fun h => hmoves ((DFunLike.congr_fun h _).symm.trans rfl)
  have hnon : rot m^2*half m ≠ 1 := fun h => hmoves (DFunLike.congr_fun h _)
  have hu := hf (G m) β (rot m) (rot m^2*half m) hn hs hdistinct (rotation_moves m) hnon (Or.inl hzero)
  have hc' : β.coeff.support.card ≤ 12 := size_bound (rot m^2) (turn m)
  have hf' : f β.coeff.support.card ≤ (Finset.range 13).sup f :=
    Finset.le_sup (Finset.mem_range.mpr (by omega))
  have hl := exponent_bound m
  exact (Nat.not_lt_of_ge (hl.trans (hu.trans hf'))) (by dsimp [m]; omega)
