import Mathlib

-- Step Erdos1160.erdos_1160.variants.sum.R1.H2.R1.H2.R1.H2.R1.H3.R2.H1.R1.H3 (Li-Qiao Theorem 7.1 (i) at p = 2), with C3 = 41.
-- Concatenation of the dev library files Alt2, Isotropic and N2A (without Prop 10.1), then the bridge.


/-! # Alt2: Li-Qiao Part II, linear algebra of alternating forms (pure, no group theory)

Li-Qiao (arXiv:2610.14509v3), Part II, Sec. 7-8, over an arbitrary field `F` (the paper's `F_q`;
the target is `F = ZMod 2`).  `X = Fin R → F`, alternating forms are `R × R` matrices.

* D.Alt : `IsAltMat`, the subspace `altSub F R = Alt(X)` with `finrank_altSub : dim = C(R,2)` and
  `card_altSub`; the form `bfL x y A = x ⬝ A y`; `Isotropic A U` (`A|_{U×U} = 0`),
  `FaithfulOn 𝒜 U` (the restriction map `res_U` is injective on `𝒜`), `IsHollowing 𝒜 h`,
  `IsMinHollowing`, `IsFaithfulDim 𝒜 d` (`d`-faithful); `rad A`, the isotropic locus
  `isoLocus A h = Z_h(A)` and `isoCount A h = I_h(A)`.
* An alternating map `β : ∧²X → W = F^M` is an `M`-tuple of alternating matrices.  `GensOn β U` is
  `β(∧²U) = W`; `simsRk β = s(β)` is eq. (91); `dualSpan β = A_β = β*(W*)`.
* Prop 7.2 : `gensOn_iff` (dual description), `gensOn_top_iff` (`β` surjective iff the tuple is
  linearly independent), `prop72_i`, `prop72_ii`, `prop72_iii`.
* `N2 r1 r2 s` : the number of `r2`-tuples of alternating `ZMod 2` matrices on `F_2^r1` whose values
  span `F_2^r2` and whose Sims rank is `s` (eq. (21) at `p = 2`); `N2_support` (empty unless
  `s ≤ r1`, `r2 ≤ C(r1,2)` and `2 ≤ s` when `r2 ≥ 1`) and `N2_le` (`N2 ≤ 2^(r2 C(r1,2))`).
* `N2_support_sims` : the CNT3 constraints `s - 1 ≤ r2 ≤ C(s, 2)` (Lemma 2.3 / 9.1, BNV 5.2), from
  `card_le_choose_simsRk` (`dim W ≤ C(s(β), 2)`) and `simsRk_le_succ` (`s(β) ≤ dim W + 1`, via the
  strict flags `chainW`, `IsStrictChainV`, `strictV_extend`, `exists_strict_top`).
  `N2_eq_ncard` (instance-free form) and `logN2` (the paper's `log_2` convention).
* Transport : `GensLin`, `simsRkLin` (Sims rank of an abstract bilinear `B : V × V → W`),
  `matTuple B bV bW` (coordinate tuple), `valL_matTuple`, `gensOn_matTuple_iff`,
  `simsRk_matTuple` (`simsRk (matTuple B bV bW) = simsRkLin B`), `matTuple_isAlt`. The
  group-level bridge (`simsRank G = simsRkLin lamLin`) is in `H2Dev.Alt2Bridge`.
* Lemma 2.7 (i) lower bound : `pow_le_ncard_grass` (`q^(k(n-k)) ≤ [n, k]_q`, via `graphL`).
* Lemma 2.7 (iii), subgroup part (crude) : `exists_closure_eq_of_card` (a subgroup of order `p^b`
  of a group of order `p^e` is generated by `b` elements), `ncard_subgroups_le` (at most
  `p^(e b)` subgroups of order `p^b`), and `exists_le_card_pow` (every subgroup of order
  `p^c ≤ p^b` lies in one of order `p^b`).
* Lemma 2.7 (crude forms) : `card_GL_le` (`|GL_d(q)| ≤ q^(d^2)`, part (iii)), `ncard_grass_le`
  (at most `q^(n k)` subspaces of dimension `k` in `F^n`), `exists_pivots` (pivot coordinates) and
  `ncard_grass_le_pivot` (`[n, k]_q ≤ 2^n q^(k(n-k))`, part (i) up to the constant), and
  `ncard_alt_rank_le` (part (ii) with constant `2^R`: at most `2^R q^((R-ρ)ρ + C(ρ,2))` alternating
  forms with `dim rad ≥ R - ρ`).
* Lemma 8.1 (structural part) : `isotropic_of_le_rad`, `isoLocus_smul` (`Z_h(cA) = Z_h(A)`),
  `isoCount_le_grass`, and `two_mul_finrank_le_of_isotropic` (an isotropic `h`-space satisfies
  `2h ≤ R + dim rad A`, so `Z_h(A) = ∅` for `h > R - a` when `rank A = 2a`).
-/

namespace OMA.SimsLite.Alt2

open Module Matrix

section Defs

variable {F : Type*} [Field F] {R M : ℕ}

/-- `A` is an alternating matrix: zero diagonal and `A j i = - A i j`. -/
def IsAltMat (A : Matrix (Fin R) (Fin R) F) : Prop :=
  (∀ i, A i i = 0) ∧ ∀ i j, A j i = -A i j

lemma isAltMat_iff_transpose (A : Matrix (Fin R) (Fin R) F) :
    IsAltMat A ↔ (∀ i, A i i = 0) ∧ A.transpose = -A := by
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨h1, by ext i j; exact h2 i j⟩
  · rintro ⟨h1, h2⟩
    refine ⟨h1, fun i j => ?_⟩
    have := congrArg (fun B : Matrix (Fin R) (Fin R) F => B i j) h2
    simpa using this

variable (F R) in
/-- `Alt(X)`: the subspace of alternating matrices. -/
def altSub : Submodule F (Matrix (Fin R) (Fin R) F) where
  carrier := {A | IsAltMat A}
  add_mem' := by
    intro A B hA hB
    refine ⟨fun i => ?_, fun i j => ?_⟩
    · show A i i + B i i = 0
      rw [hA.1 i, hB.1 i, add_zero]
    · show A j i + B j i = -(A i j + B i j)
      rw [hA.2 i j, hB.2 i j]
      ring
  zero_mem' := ⟨fun i => rfl, fun i j => by simp⟩
  smul_mem' := by
    intro c A hA
    refine ⟨fun i => ?_, fun i j => ?_⟩
    · show c * A i i = 0
      rw [hA.1 i, mul_zero]
    · show c * A j i = -(c * A i j)
      rw [hA.2 i j]
      ring

lemma mem_altSub {A : Matrix (Fin R) (Fin R) F} : A ∈ altSub F R ↔ IsAltMat A := Iff.rfl

variable (R) in
/-- Index set `{(i, j) : i < j}` of the free entries of an alternating matrix. -/
abbrev TPairs : Type := {p : Fin R × Fin R // p.1 < p.2}

/-- The alternating matrix with prescribed entries above the diagonal. -/
def altOf (f : TPairs R → F) : Matrix (Fin R) (Fin R) F := fun i j =>
  if h : i < j then f ⟨(i, j), h⟩ else if h' : j < i then -f ⟨(j, i), h'⟩ else 0

lemma altOf_isAlt (f : TPairs R → F) : IsAltMat (altOf f) := by
  refine ⟨fun i => ?_, fun i j => ?_⟩
  · simp [altOf]
  · rcases lt_trichotomy i j with h | h | h
    · have h' : ¬ j < i := not_lt.2 h.le
      simp only [altOf, dif_pos h, dif_neg h']
    · subst h
      simp [altOf]
    · have h' : ¬ i < j := not_lt.2 h.le
      simp only [altOf, dif_pos h, dif_neg h', neg_neg]

variable (F R) in
/-- `Alt(X) ≃ F^{pairs i<j}`. -/
def altEquiv : altSub F R ≃ₗ[F] (TPairs R → F) where
  toFun A p := (A : Matrix (Fin R) (Fin R) F) p.1.1 p.1.2
  map_add' A B := rfl
  map_smul' c A := rfl
  invFun f := ⟨altOf f, altOf_isAlt f⟩
  left_inv A := by
    apply Subtype.ext
    ext i j
    have hA := (mem_altSub.1 A.2)
    show altOf (fun p : TPairs R => (A : Matrix (Fin R) (Fin R) F) p.1.1 p.1.2) i j =
      (A : Matrix (Fin R) (Fin R) F) i j
    rcases lt_trichotomy i j with h | h | h
    · simp only [altOf, dif_pos h]
    · subst h
      simp [altOf, hA.1 i]
    · have h' : ¬ i < j := not_lt.2 h.le
      simp only [altOf, dif_pos h, dif_neg h']
      rw [hA.2 j i]
  right_inv f := by
    funext p
    obtain ⟨⟨i, j⟩, hij⟩ := p
    show altOf f i j = f ⟨(i, j), hij⟩
    simp only [altOf, dif_pos hij]

lemma card_TPairs (R : ℕ) : Fintype.card (TPairs R) = R.choose 2 := by
  have h1 : Fintype.card (TPairs R) =
      ∑ j : Fin R, ∑ i : Fin R, if i < j then 1 else 0 := by
    rw [Fintype.card_subtype, Finset.card_filter, Fintype.sum_prod_type, Finset.sum_comm]
  have h2 : ∀ j : Fin R, (∑ i : Fin R, if i < j then 1 else 0) = (j : ℕ) := by
    intro j
    rw [← Finset.card_filter, Finset.filter_gt_eq_Iio, Fin.card_Iio]
  have h3 : ∑ j : Fin R, (j : ℕ) = ∑ i ∈ Finset.range R, i :=
    Fin.sum_univ_eq_sum_range (fun i => i) R
  rw [h1, Finset.sum_congr rfl (fun j _ => h2 j), h3, Nat.choose_two_right,
    ← Finset.sum_range_id_mul_two, Nat.mul_div_cancel _ (by norm_num)]

variable (F R) in
/-- D.Alt : `dim Alt(X) = C(R, 2)`. -/
theorem finrank_altSub : finrank F (altSub F R) = R.choose 2 := by
  rw [(altEquiv F R).finrank_eq, Module.finrank_fintype_fun_eq_card, card_TPairs]

variable (F R) in
theorem card_altSub : Nat.card (altSub F R) = Nat.card F ^ R.choose 2 := by
  rw [Nat.card_congr (altEquiv F R).toEquiv, Nat.card_fun, Nat.card_eq_fintype_card (α := TPairs R),
    card_TPairs]

/-- The bilinear form `A(x, y) = x ⬝ A y`, as a linear function of the matrix `A`. -/
def bfL (x y : Fin R → F) : Matrix (Fin R) (Fin R) F →ₗ[F] F where
  toFun A := x ⬝ᵥ (A *ᵥ y)
  map_add' A B := by rw [Matrix.add_mulVec, dotProduct_add]
  map_smul' c A := by rw [Matrix.smul_mulVec, dotProduct_smul, RingHom.id_apply]

lemma bfL_apply (x y : Fin R → F) (A : Matrix (Fin R) (Fin R) F) :
    bfL x y A = x ⬝ᵥ (A *ᵥ y) := rfl

lemma bfL_single (A : Matrix (Fin R) (Fin R) F) (i j : Fin R) :
    bfL (Pi.single i 1) (Pi.single j 1) A = A i j := by
  simp [bfL, dotProduct, Matrix.mulVec, Pi.single_apply]

lemma bfL_sum (β : Fin M → Matrix (Fin R) (Fin R) F) (c : Fin M → F) (x y : Fin R → F) :
    bfL x y (∑ k, c k • β k) = ∑ k, c k * bfL x y (β k) := by
  rw [map_sum]
  simp only [map_smul, smul_eq_mul]

/-- An alternating form vanishes on the diagonal: `A(x, x) = 0`. -/
lemma bfL_self_eq_zero {A : Matrix (Fin R) (Fin R) F} (hA : IsAltMat A) (x : Fin R → F) :
    bfL x x A = 0 := by
  rw [bfL_apply, Matrix.dot_mulVec_eq_sum_sum]
  have e : ∑ j, ∑ i, x i * A i j * x j = ∑ p : Fin R × Fin R, x p.2 * A p.2 p.1 * x p.1 :=
    (Fintype.sum_prod_type' (fun j i => x i * A i j * x j)).symm
  rw [e]
  apply Finset.sum_ninvolution (fun p => (p.2, p.1))
  · rintro ⟨j, i⟩
    show x i * A i j * x j + x j * A j i * x i = 0
    rw [hA.2 i j]
    ring
  · rintro ⟨j, i⟩ hne heq
    have hij : i = j := congrArg Prod.fst heq
    apply hne
    show x i * A i j * x j = 0
    rw [hij, hA.1 j]
    ring
  · intro p
    exact Finset.mem_univ _
  · intro p
    rfl

/-- `A|_{U×U} = 0`: `U` is totally isotropic for `A`. -/
def Isotropic (A : Matrix (Fin R) (Fin R) F) (U : Submodule F (Fin R → F)) : Prop :=
  ∀ x ∈ U, ∀ y ∈ U, bfL x y A = 0

/-- `𝒜` is faithful on `U`: the restriction map `res_U : 𝒜 → Alt(U)` is injective. -/
def FaithfulOn (𝒜 : Submodule F (Matrix (Fin R) (Fin R) F)) (U : Submodule F (Fin R → F)) :
    Prop :=
  ∀ A ∈ 𝒜, Isotropic A U → A = 0

/-- `𝒜` is `d`-faithful: faithful on some `d`-dimensional subspace. -/
def IsFaithfulDim (𝒜 : Submodule F (Matrix (Fin R) (Fin R) F)) (d : ℕ) : Prop :=
  ∃ U : Submodule F (Fin R → F), finrank F U = d ∧ FaithfulOn 𝒜 U

/-- `𝒜` is `h`-hollowing: every `h`-space is totally isotropic for some nonzero `A ∈ 𝒜`. -/
def IsHollowing (𝒜 : Submodule F (Matrix (Fin R) (Fin R) F)) (h : ℕ) : Prop :=
  ∀ H : Submodule F (Fin R → F), finrank F H = h → ∃ A ∈ 𝒜, A ≠ 0 ∧ Isotropic A H

/-- `𝒜` is minimally `h`-hollowing. -/
def IsMinHollowing (𝒜 : Submodule F (Matrix (Fin R) (Fin R) F)) (h : ℕ) : Prop :=
  IsHollowing 𝒜 h ∧ ∀ 𝒝 : Submodule F (Matrix (Fin R) (Fin R) F), 𝒝 < 𝒜 → ¬ IsHollowing 𝒝 h

lemma isotropic_top_iff (A : Matrix (Fin R) (Fin R) F) : Isotropic A ⊤ ↔ A = 0 := by
  constructor
  · intro h
    ext i j
    have := h (Pi.single i 1) Submodule.mem_top (Pi.single j 1) Submodule.mem_top
    rw [bfL_single] at this
    simpa using this
  · rintro rfl x _ y _
    exact map_zero _

/-- The values `β(x, y)`, `x, y ∈ U`, of the tuple `β` (i.e. `β(∧²U)` as a set). -/
def vals (β : Fin M → Matrix (Fin R) (Fin R) F) (U : Submodule F (Fin R → F)) :
    Set (Fin M → F) :=
  {w | ∃ x ∈ U, ∃ y ∈ U, w = fun k => bfL x y (β k)}

/-- `β(∧²U) = W`. -/
def GensOn (β : Fin M → Matrix (Fin R) (Fin R) F) (U : Submodule F (Fin R → F)) : Prop :=
  Submodule.span F (vals β U) = ⊤

/-- The Sims rank (91): `s(β) = min {dim U : β(∧²U) = W}`. -/
noncomputable def simsRk (β : Fin M → Matrix (Fin R) (Fin R) F) : ℕ :=
  sInf {d | ∃ U : Submodule F (Fin R → F), finrank F U = d ∧ GensOn β U}

/-- `A_β = β*(W*)`, the span of the coordinate forms. -/
def dualSpan (β : Fin M → Matrix (Fin R) (Fin R) F) : Submodule F (Matrix (Fin R) (Fin R) F) :=
  Submodule.span F (Set.range β)

/-- `rad A = {x : A(x, y) = 0 for all y}`. -/
def rad (A : Matrix (Fin R) (Fin R) F) : Submodule F (Fin R → F) :=
  LinearMap.ker (Matrix.toBilin' A)

/-- The isotropic locus `Z_h(A)`. -/
def isoLocus (A : Matrix (Fin R) (Fin R) F) (h : ℕ) : Set (Submodule F (Fin R → F)) :=
  {H | finrank F H = h ∧ Isotropic A H}

/-- `I_h(A) = |Z_h(A)|`. -/
noncomputable def isoCount (A : Matrix (Fin R) (Fin R) F) (h : ℕ) : ℕ :=
  (isoLocus A h).ncard

end Defs

section Duality

variable {F : Type*} [Field F] {R M : ℕ}

/-- Duality: a family of vectors of `F^M` spans iff no nonzero functional kills all of them. -/
theorem span_range_eq_top_iff {ι : Type*} (g : ι → (Fin M → F)) :
    Submodule.span F (Set.range g) = ⊤ ↔
      ∀ c : Fin M → F, (∀ i, ∑ k, c k * g i k = 0) → c = 0 := by
  constructor
  · intro hg c hc
    let φ : (Fin M → F) →ₗ[F] F :=
      { toFun := fun v => ∑ k, c k * v k
        map_add' := by
          intro v w
          simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
        map_smul' := by
          intro a v
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun k _ => by ring) }
    have hle : Submodule.span F (Set.range g) ≤ LinearMap.ker φ := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact hc i
    funext j
    have hmem : (Pi.single j (1 : F) : Fin M → F) ∈ Submodule.span F (Set.range g) := by
      rw [hg]
      exact Submodule.mem_top
    have hj := LinearMap.mem_ker.1 (hle hmem)
    change ∑ k, c k * (Pi.single j (1 : F) : Fin M → F) k = 0 at hj
    simpa [Pi.single_apply] using hj
  · intro hc
    by_contra hne
    obtain ⟨φ, hφ0, hφ⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.2 hne)
    obtain ⟨c, key⟩ : ∃ c : Fin M → F, ∀ v, φ v = ∑ k, c k * v k :=
      ⟨fun k => φ (fun j => if k = j then 1 else 0), fun v => by
        rw [LinearMap.pi_apply_eq_sum_univ φ v]
        exact Finset.sum_congr rfl (fun k _ => by rw [smul_eq_mul, mul_comm])⟩
    have h0 : c = 0 := hc c (fun i => by
      rw [← key]
      exact LinearMap.mem_ker.1 (hφ (Submodule.subset_span ⟨i, rfl⟩)))
    apply hφ0
    exact LinearMap.ext fun v => by rw [key v, h0]; simp

/-- Prop 7.2, dual form: `β(∧²U) = W` iff no nonzero `λ ∈ W*` has `λ ∘ β` vanishing on `U`. -/
theorem gensOn_iff (β : Fin M → Matrix (Fin R) (Fin R) F) (U : Submodule F (Fin R → F)) :
    GensOn β U ↔ ∀ c : Fin M → F, Isotropic (∑ k, c k • β k) U → c = 0 := by
  have hv : vals β U = Set.range
      (fun p : {p : (Fin R → F) × (Fin R → F) // p.1 ∈ U ∧ p.2 ∈ U} =>
        fun k => bfL p.1.1 p.1.2 (β k)) := by
    ext w
    constructor
    · rintro ⟨x, hx, y, hy, rfl⟩
      exact ⟨⟨(x, y), hx, hy⟩, rfl⟩
    · rintro ⟨⟨⟨x, y⟩, hx, hy⟩, rfl⟩
      exact ⟨x, hx, y, hy, rfl⟩
  unfold GensOn
  rw [hv, span_range_eq_top_iff]
  constructor
  · intro h c hc
    apply h c
    rintro ⟨⟨x, y⟩, hx, hy⟩
    show ∑ k, c k * bfL x y (β k) = 0
    rw [← bfL_sum]
    exact hc x hx y hy
  · intro h c hc
    apply h c
    intro x hx y hy
    rw [bfL_sum]
    exact hc ⟨(x, y), hx, hy⟩

/-- `β : ∧²X → W` is surjective iff its coordinate forms are linearly independent. -/
theorem gensOn_top_iff (β : Fin M → Matrix (Fin R) (Fin R) F) :
    GensOn β ⊤ ↔ LinearIndependent F β := by
  rw [gensOn_iff, Fintype.linearIndependent_iff]
  simp only [isotropic_top_iff]
  constructor
  · intro h c hc
    exact congrFun (h c hc)
  · intro h c hc
    funext k
    exact h c hc k

/-- Prop 7.2 (i): `β(∧²U) = W` iff `A_β` is faithful on `U`. -/
theorem prop72_i (β : Fin M → Matrix (Fin R) (Fin R) F) (hβ : LinearIndependent F β)
    (U : Submodule F (Fin R → F)) : GensOn β U ↔ FaithfulOn (dualSpan β) U := by
  rw [gensOn_iff]
  constructor
  · intro h A hA hiso
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun F).1 hA
    rw [h c hiso]
    simp
  · intro h c hc
    have h0 := h _ ((Submodule.mem_span_range_iff_exists_fun F).2 ⟨c, rfl⟩) hc
    funext k
    exact Fintype.linearIndependent_iff.1 hβ c h0 k

lemma gensOn_mono (β : Fin M → Matrix (Fin R) (Fin R) F) {U U' : Submodule F (Fin R → F)}
    (hUU : U ≤ U') (h : GensOn β U) : GensOn β U' := by
  unfold GensOn at *
  apply top_unique
  rw [← h]
  apply Submodule.span_mono
  rintro w ⟨x, hx, y, hy, rfl⟩
  exact ⟨x, hUU hx, y, hUU hy, rfl⟩

/-- Every subspace extends to a subspace of any larger dimension `≤ R`. -/
lemma exists_le_finrank_eq (k : ℕ) :
    ∀ U : Submodule F (Fin R → F), finrank F U + k ≤ R →
      ∃ H : Submodule F (Fin R → F), U ≤ H ∧ finrank F H = finrank F U + k := by
  induction k with
  | zero => intro U _; exact ⟨U, le_rfl, rfl⟩
  | succ k ih =>
    intro U hU
    have hlt : U < ⊤ := by
      apply lt_top_iff_ne_top.2
      intro htop
      have : finrank F U = R := by rw [htop, finrank_top, Module.finrank_fin_fun]
      omega
    obtain ⟨v, -, hv⟩ := SetLike.exists_of_lt hlt
    have hv0 : v ≠ 0 := fun h => hv (by rw [h]; exact U.zero_mem)
    obtain ⟨U', hUU', hU'⟩ : ∃ U' : Submodule F (Fin R → F),
        U < U' ∧ finrank F U' ≤ finrank F U + 1 := by
      refine ⟨U ⊔ Submodule.span F {v}, ?_, ?_⟩
      · refine lt_of_le_of_ne le_sup_left ?_
        intro heq
        apply hv
        rw [heq]
        exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self v)
      · have := Submodule.finrank_add_le_finrank_add_finrank U (Submodule.span F {v})
        rwa [finrank_span_singleton hv0] at this
    have h1 : finrank F U < finrank F U' := Submodule.finrank_lt_finrank_of_lt hUU'
    obtain ⟨H, hH, hHf⟩ := ih U' (by omega)
    exact ⟨H, hUU'.le.trans hH, by omega⟩

lemma simsRk_le_of (β : Fin M → Matrix (Fin R) (Fin R) F) {U : Submodule F (Fin R → F)} {d : ℕ}
    (hU : finrank F U = d) (hg : GensOn β U) : simsRk β ≤ d :=
  Nat.sInf_le ⟨U, hU, hg⟩

lemma simsRk_le_R (β : Fin M → Matrix (Fin R) (Fin R) F) (hg : GensOn β ⊤) : simsRk β ≤ R :=
  simsRk_le_of β (by rw [finrank_top, Module.finrank_fin_fun]) hg

lemma exists_gens_of_simsRk (β : Fin M → Matrix (Fin R) (Fin R) F) (hg : GensOn β ⊤) :
    ∃ U : Submodule F (Fin R → F), finrank F U = simsRk β ∧ GensOn β U :=
  Nat.sInf_mem (s := {d | ∃ U : Submodule F (Fin R → F), finrank F U = d ∧ GensOn β U})
    ⟨R, ⊤, by rw [finrank_top, Module.finrank_fin_fun], hg⟩

/-- (92): `d < s(β)` iff no `d`-space generates `W`. -/
theorem lt_simsRk_iff (β : Fin M → Matrix (Fin R) (Fin R) F) (hg : GensOn β ⊤) {d : ℕ}
    (hd : d ≤ R) :
    d < simsRk β ↔ ∀ H : Submodule F (Fin R → F), finrank F H = d → ¬ GensOn β H := by
  constructor
  · intro hlt H hH hgH
    have := simsRk_le_of β hH hgH
    omega
  · intro hall
    by_contra hle
    push_neg at hle
    obtain ⟨U, hU, hgU⟩ := exists_gens_of_simsRk β hg
    obtain ⟨H, hUH, hH⟩ := exists_le_finrank_eq (d - finrank F U) U (by omega)
    exact hall H (by rw [hH]; omega) (gensOn_mono β hUH hgU)

/-- Prop 7.2 (ii): for `h ≤ dim X`, `A_β` is `h`-hollowing iff `s(β) > h`. -/
theorem prop72_ii (β : Fin M → Matrix (Fin R) (Fin R) F) (hβ : LinearIndependent F β) (h : ℕ)
    (hh : h ≤ R) : IsHollowing (dualSpan β) h ↔ h < simsRk β := by
  have hg := (gensOn_top_iff β).2 hβ
  rw [lt_simsRk_iff β hg hh]
  unfold IsHollowing
  refine forall_congr' fun H => forall_congr' fun _ => ?_
  rw [prop72_i β hβ H]
  unfold FaithfulOn
  push_neg
  constructor
  · rintro ⟨A, hA, h1, h2⟩
    exact ⟨A, hA, h2, h1⟩
  · rintro ⟨A, hA, h1, h2⟩
    exact ⟨A, hA, h2, h1⟩

/-- `s(β) ≤ d` iff `A_β` is `d`-faithful (for `d ≤ dim X`). -/
theorem faithfulDim_iff (β : Fin M → Matrix (Fin R) (Fin R) F) (hβ : LinearIndependent F β)
    (d : ℕ) (hd : d ≤ R) : IsFaithfulDim (dualSpan β) d ↔ simsRk β ≤ d := by
  have hg := (gensOn_top_iff β).2 hβ
  constructor
  · rintro ⟨U, hU, hf⟩
    exact simsRk_le_of β hU ((prop72_i β hβ U).2 hf)
  · intro hle
    obtain ⟨U, hU, hgU⟩ := exists_gens_of_simsRk β hg
    obtain ⟨H, hUH, hH⟩ := exists_le_finrank_eq (d - finrank F U) U (by omega)
    exact ⟨H, by rw [hH]; omega, (prop72_i β hβ H).1 (gensOn_mono β hUH hgU)⟩

/-- Prop 7.2 (iii): for `1 ≤ s ≤ dim X`, `s(β) = s` iff `A_β` is `(s-1)`-hollowing and
`s`-faithful. -/
theorem prop72_iii (β : Fin M → Matrix (Fin R) (Fin R) F) (hβ : LinearIndependent F β) (s : ℕ)
    (hs1 : 1 ≤ s) (hsR : s ≤ R) :
    simsRk β = s ↔ IsHollowing (dualSpan β) (s - 1) ∧ IsFaithfulDim (dualSpan β) s := by
  rw [prop72_ii β hβ (s - 1) (by omega), faithfulDim_iff β hβ s hsR]
  constructor
  · intro h
    omega
  · intro h
    omega

/-- For an alternating surjective `β` onto a nonzero `W`, `s(β) ≥ 2`. -/
theorem two_le_simsRk (β : Fin M → Matrix (Fin R) (Fin R) F) (hA : ∀ k, IsAltMat (β k))
    (hg : GensOn β ⊤) (hM : 1 ≤ M) : 2 ≤ simsRk β := by
  obtain ⟨U, hU, hgU⟩ := exists_gens_of_simsRk β hg
  by_contra hlt
  have h1 : finrank F U ≤ 1 := by omega
  obtain ⟨v, hv⟩ := finrank_le_one_iff.1 h1
  have hsub : vals β U ⊆ {0} := by
    rintro w ⟨x, hx, y, hy, rfl⟩
    rw [Set.mem_singleton_iff]
    obtain ⟨a, ha⟩ := hv ⟨x, hx⟩
    obtain ⟨b, hb⟩ := hv ⟨y, hy⟩
    have hx' : x = a • (v : Fin R → F) := (congrArg Subtype.val ha).symm
    have hy' : y = b • (v : Fin R → F) := (congrArg Subtype.val hb).symm
    funext k
    rw [hx', hy', bfL_apply, Matrix.mulVec_smul, smul_dotProduct, dotProduct_smul]
    have := bfL_self_eq_zero (hA k) (v : Fin R → F)
    rw [bfL_apply] at this
    simp only [this, smul_zero, Pi.zero_apply]
  have hle : Submodule.span F (vals β U) ≤ ⊥ :=
    Submodule.span_le.2 (fun w hw => by
      rw [Set.mem_singleton_iff.1 (hsub hw)]
      exact Submodule.zero_mem _)
  unfold GensOn at hgU
  rw [hgU] at hle
  have hmem : (Pi.single (⟨0, hM⟩ : Fin M) (1 : F) : Fin M → F) ∈ (⊥ : Submodule F (Fin M → F)) :=
    hle Submodule.mem_top
  rw [Submodule.mem_bot] at hmem
  have := congrFun hmem ⟨0, hM⟩
  simp at this

/-- `dim W ≤ dim Alt(X) = C(R, 2)` for a surjective alternating `β`. -/
theorem card_le_choose (β : Fin M → Matrix (Fin R) (Fin R) F) (hA : ∀ k, IsAltMat (β k))
    (hβ : LinearIndependent F β) : M ≤ R.choose 2 := by
  have h1 := finrank_span_eq_card hβ
  have h2 : Submodule.span F (Set.range β) ≤ altSub F R :=
    Submodule.span_le.2 (by rintro _ ⟨k, rfl⟩; exact hA k)
  have h3 := Submodule.finrank_mono h2
  rw [h1, Fintype.card_fin, finrank_altSub] at h3
  exact h3

end Duality

section N2

open Classical in
/-- `N_2(r1, r2, s)` as a count (not its `log_2`): the number of `r2`-tuples of alternating
`ZMod 2` matrices on `F_2^r1` whose values span `F_2^r2` and of Sims rank `s` (eq. (21)).

Conventions (frozen interface): the paper's `N_2` of (21) is `log_2` of this count, i.e.
`Real.logb 2 (N2 r1 r2 s)` (see `logN2`); the filter uses the classical decidability instance,
and `N2_eq_ncard` restates the count as an instance-free `Set.ncard`, which is the form to use
when matching statements across files. -/
noncomputable def N2 (r1 r2 s : ℕ) : ℕ :=
  (Finset.univ.filter (fun β : Fin r2 → Matrix (Fin r1) (Fin r1) (ZMod 2) =>
    (∀ k, IsAltMat (β k)) ∧ GensOn β ⊤ ∧ simsRk β = s)).card

/-- `N_2` without decidability instances: the `ncard` of the set of admissible tuples. -/
theorem N2_eq_ncard (r1 r2 s : ℕ) : N2 r1 r2 s =
    {β : Fin r2 → Matrix (Fin r1) (Fin r1) (ZMod 2) |
      (∀ k, IsAltMat (β k)) ∧ GensOn β ⊤ ∧ simsRk β = s}.ncard := by
  classical
  unfold N2
  rw [← Set.ncard_coe_finset]
  congr 1
  ext β
  simp

/-- The paper's `N_2(r1, r2, s)` of (21): `log_2` of the count `N2`. -/
noncomputable def logN2 (r1 r2 s : ℕ) : ℝ := Real.logb 2 (N2 r1 r2 s)

/-- Support of `N_2`: nonzero only if `s ≤ r1`, `r2 ≤ C(r1, 2)` and (`r2 ≥ 1 → s ≥ 2`). -/
theorem N2_support {r1 r2 s : ℕ} (h : 0 < N2 r1 r2 s) :
    s ≤ r1 ∧ r2 ≤ r1.choose 2 ∧ (1 ≤ r2 → 2 ≤ s) := by
  classical
  unfold N2 at h
  obtain ⟨β, hβ⟩ := Finset.card_pos.1 h
  obtain ⟨-, hA, hg, hs⟩ := Finset.mem_filter.1 hβ
  refine ⟨?_, ?_, ?_⟩
  · rw [← hs]
    exact simsRk_le_R β hg
  · exact card_le_choose β hA ((gensOn_top_iff β).1 hg)
  · intro h2
    rw [← hs]
    exact two_le_simsRk β hA hg h2

/-- Trivial bound `N_2(r1, r2, s) ≤ |Alt(F_2^r1)|^r2 = 2^(r2 C(r1,2))`. -/
theorem N2_le (r1 r2 s : ℕ) : N2 r1 r2 s ≤ 2 ^ (r2 * r1.choose 2) := by
  classical
  unfold N2
  rw [← Fintype.card_subtype, ← Nat.card_eq_fintype_card]
  refine (Nat.card_le_card_of_injective
    (fun β => fun k => (⟨β.1 k, β.2.1 k⟩ : altSub (ZMod 2) r1)) ?_).trans (le_of_eq ?_)
  · intro β γ h
    apply Subtype.ext
    funext k
    exact congrArg Subtype.val (congrFun h k)
  · rw [Nat.card_fun, Nat.card_fin, card_altSub, Nat.card_eq_fintype_card (α := ZMod 2), ZMod.card,
      ← pow_mul, mul_comm]

end N2

section Lemma27

variable {F : Type*} [Field F]

/-- Lemma 2.7 (iii), first part: `|GL_d(q)| ≤ q^(d^2)`. -/
theorem card_GL_le [Fintype F] (d : ℕ) :
    Nat.card (GL (Fin d) F) ≤ Fintype.card F ^ (d ^ 2) := by
  calc Nat.card (GL (Fin d) F) ≤ Nat.card (Matrix (Fin d) (Fin d) F) :=
        Nat.card_le_card_of_injective (fun g => (g : Matrix (Fin d) (Fin d) F))
          (fun g h hgh => Units.ext hgh)
    _ = Fintype.card F ^ (d ^ 2) := by
        show Nat.card (Fin d → Fin d → F) = _
        rw [Nat.card_fun, Nat.card_fun, Nat.card_fin, Nat.card_eq_fintype_card, ← pow_mul, sq]

/-- Every `k`-dimensional subspace of `F^n` is spanned by a `k`-tuple. -/
lemma grass_subset_range (n k : ℕ) :
    {U : Submodule F (Fin n → F) | finrank F U = k} ⊆
      Set.range (fun v : Fin k → (Fin n → F) => Submodule.span F (Set.range v)) := by
  intro U hU
  let B := Module.finBasisOfFinrankEq F U hU
  refine ⟨fun i => (B i : Fin n → F), ?_⟩
  have h := congrArg (Submodule.map U.subtype) B.span_eq
  rw [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp] at h
  exact h

lemma grass_finite [Finite F] (n k : ℕ) :
    {U : Submodule F (Fin n → F) | finrank F U = k}.Finite :=
  (Set.finite_range _).subset (grass_subset_range n k)

/-- Crude Lemma 2.7 (i)/(iii): `F^n` has at most `q^(n k)` subspaces of dimension `k`. -/
theorem ncard_grass_le [Finite F] (n k : ℕ) :
    {U : Submodule F (Fin n → F) | finrank F U = k}.ncard ≤ Nat.card F ^ (n * k) := by
  calc {U : Submodule F (Fin n → F) | finrank F U = k}.ncard
      ≤ (Set.range (fun v : Fin k → (Fin n → F) => Submodule.span F (Set.range v))).ncard :=
        Set.ncard_le_ncard (grass_subset_range n k) (Set.finite_range _)
    _ ≤ (Set.univ : Set (Fin k → (Fin n → F))).ncard := by
        rw [← Set.image_univ]
        exact Set.ncard_image_le (Set.toFinite _)
    _ = Nat.card F ^ (n * k) := by
        rw [Set.ncard_univ, Nat.card_fun, Nat.card_fun, Nat.card_fin, Nat.card_fin, ← pow_mul]

end Lemma27

section Grass

variable {F : Type*} [Field F] {n : ℕ}

/-- Pivot coordinates: every subspace `U ≤ F^n` has a coordinate set `S` with `|S| = dim U` such
that the coordinate projection `U → F^S` is bijective. -/
theorem exists_pivots (U : Submodule F (Fin n → F)) :
    ∃ S : Finset (Fin n), S.card = finrank F U ∧
      (∀ v ∈ U, (∀ i ∈ S, v i = 0) → v = 0) ∧
      (∀ w : S → F, ∃ v ∈ U, ∀ i : S, v i = w i) := by
  classical
  let P : Finset (Fin n) → Prop := fun S => ∀ v ∈ U, (∀ i ∈ S, v i = 0) → v = 0
  have hne : (Finset.univ.filter P).Nonempty :=
    ⟨Finset.univ, Finset.mem_filter.2 ⟨Finset.mem_univ _,
      fun v _ hv => funext fun i => hv i (Finset.mem_univ i)⟩⟩
  obtain ⟨S, hS, hmin⟩ := Finset.exists_min_image (Finset.univ.filter P) Finset.card hne
  have hPS : P S := (Finset.mem_filter.1 hS).2
  let L : U →ₗ[F] (S → F) := (LinearMap.funLeft F F (fun i : S => (i : Fin n))).comp U.subtype
  have hinj : Function.Injective L := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv
    apply Subtype.ext
    exact hPS v v.2 (fun i hi => congrFun hv ⟨i, hi⟩)
  have hsurj : Function.Surjective L := by
    rw [← LinearMap.range_eq_top]
    by_contra hne'
    obtain ⟨φ, hφ0, hφ⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.2 hne')
    obtain ⟨c, key⟩ : ∃ c : S → F, ∀ w, φ w = ∑ i, c i * w i :=
      ⟨fun i => φ (fun j => if i = j then 1 else 0), fun w => by
        rw [LinearMap.pi_apply_eq_sum_univ φ w]
        exact Finset.sum_congr rfl (fun i _ => by rw [smul_eq_mul, mul_comm])⟩
    have hc : c ≠ 0 := by
      intro h0
      apply hφ0
      exact LinearMap.ext fun w => by rw [key w, h0]; simp
    obtain ⟨i0, hi0⟩ : ∃ i0, c i0 ≠ 0 := by
      by_contra h
      push_neg at h
      exact hc (funext h)
    have hrel : ∀ v ∈ U, ∑ i : S, c i * v i = 0 := by
      intro v hv
      have := LinearMap.mem_ker.1 (hφ (LinearMap.mem_range_self L ⟨v, hv⟩))
      rw [key] at this
      exact this
    have hP' : P (S.erase (i0 : Fin n)) := by
      intro v hv hz
      apply hPS v hv
      have hv0 : v i0 = 0 := by
        have h1 := hrel v hv
        rw [Finset.sum_eq_single i0] at h1
        · exact (mul_eq_zero.1 h1).resolve_left hi0
        · intro b _ hb
          rw [hz b (Finset.mem_erase.2 ⟨fun h => hb (Subtype.ext h), b.2⟩), mul_zero]
        · intro h
          exact absurd (Finset.mem_univ _) h
      intro i hi
      by_cases h : i = (i0 : Fin n)
      · rw [h]
        exact hv0
      · exact hz i (Finset.mem_erase.2 ⟨h, hi⟩)
    have h1 := hmin (S.erase (i0 : Fin n)) (Finset.mem_filter.2 ⟨Finset.mem_univ _, hP'⟩)
    have h2 := Finset.card_erase_lt_of_mem i0.2
    omega
  refine ⟨S, ?_, hPS, fun w => ?_⟩
  · have e := (LinearEquiv.ofBijective L ⟨hinj, hsurj⟩).finrank_eq
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_coe] at e
    exact e.symm
  · obtain ⟨v, hv⟩ := hsurj w
    exact ⟨v, v.2, fun i => congrFun hv i⟩

/-- Lemma 2.7 (i), upper bound in crude form: `F^n` has at most `2^n q^(k(n-k))` subspaces of
dimension `k` (each is the graph over its pivot coordinates of a map `F^k → F^(n-k)`). -/
theorem ncard_grass_le_pivot [Finite F] (k : ℕ) :
    {U : Submodule F (Fin n → F) | finrank F U = k}.ncard ≤
      2 ^ n * Nat.card F ^ (k * (n - k)) := by
  classical
  have hdata : ∀ U : {U : Submodule F (Fin n → F) // finrank F U = k},
      ∃ S : Finset (Fin n), ∃ _ : S.card = k, ∃ u : Fin n → (Fin n → F),
        (∀ i, u i ∈ U.1) ∧ (∀ i ∈ S, ∀ j ∈ S, u i j = if j = i then 1 else 0) ∧
        (∀ v ∈ U.1, (∀ i ∈ S, v i = 0) → v = 0) := by
    intro U
    obtain ⟨S, hS, hinj, hsurj⟩ := exists_pivots U.1
    choose u' hu'U hu' using fun i : S => hsurj (Pi.single i 1)
    refine ⟨S, hS.trans U.2, fun i => if h : i ∈ S then u' ⟨i, h⟩ else 0, ?_, ?_, hinj⟩
    · intro i
      by_cases h : i ∈ S
      · dsimp only
        rw [dif_pos h]
        exact hu'U _
      · dsimp only
        rw [dif_neg h]
        exact U.1.zero_mem
    · intro i hi j hj
      dsimp only
      rw [dif_pos hi, hu' ⟨i, hi⟩ ⟨j, hj⟩]
      simp [Pi.single_apply]
  choose S hS u hu hpiv hinj using hdata
  have hc : ∀ U, ((S U)ᶜ).card = n - k := fun U => by
    rw [Finset.card_compl, Fintype.card_fin, hS U]
  let code : {U : Submodule F (Fin n → F) // finrank F U = k} →
      Finset (Fin n) × (Fin k → Fin (n - k) → F) := fun U =>
    (S U, fun a b => u U ((S U).orderEmbOfFin (hS U) a) (((S U)ᶜ).orderEmbOfFin (hc U) b))
  have hemb : ∀ (T T' : Finset (Fin n)) {m : ℕ} (h : T.card = m) (h' : T'.card = m), T = T' →
      ∀ a, T.orderEmbOfFin h a = T'.orderEmbOfFin h' a := by
    rintro T _ m h h' rfl a
    rfl
  have hle : ∀ U U', code U = code U' → U.1 ≤ U'.1 := by
    intro U U' h
    have hSS : S U = S U' := congrArg Prod.fst h
    have h2 := congrArg Prod.snd h
    have huu : ∀ i ∈ S U, u U i = u U' i := by
      intro i hi
      funext j
      by_cases hj : j ∈ S U
      · rw [hpiv U i hi j hj, hpiv U' i (hSS ▸ hi) j (hSS ▸ hj)]
      · have hjc : j ∈ (S U)ᶜ := Finset.mem_compl.2 hj
        obtain ⟨b, hb⟩ : j ∈ Set.range ((S U)ᶜ.orderEmbOfFin (hc U)) := by
          rw [Finset.range_orderEmbOfFin]
          exact hjc
        obtain ⟨a, ha⟩ : i ∈ Set.range ((S U).orderEmbOfFin (hS U)) := by
          rw [Finset.range_orderEmbOfFin]
          exact hi
        have h3 := congrFun (congrFun h2 a) b
        simp only [code] at h3
        rw [← hemb _ _ (hS U) (hS U') hSS a, ← hemb _ _ (hc U) (hc U') (by rw [hSS]) b, ha,
          hb] at h3
        exact h3
    intro v hv
    have hw : v - ∑ i ∈ S U, v i • u U i = 0 := by
      apply hinj U _ (sub_mem hv (sum_mem (fun i _ => Submodule.smul_mem _ _ (hu U i))))
      intro j hj
      have hsum : ∑ i ∈ S U, v i * u U i j = ∑ i ∈ S U, if j = i then v i else 0 :=
        Finset.sum_congr rfl (fun i hi => by rw [hpiv U i hi j hj]; split_ifs <;> simp)
      simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      rw [hsum, Finset.sum_ite_eq, if_pos hj, sub_self]
    have hv' : v = ∑ i ∈ S U, v i • u U i := sub_eq_zero.1 hw
    rw [hv']
    exact sum_mem (fun i hi => by rw [huu i hi]; exact Submodule.smul_mem _ _ (hu U' i))
  have hinjc : Function.Injective code := by
    intro U U' h
    exact Subtype.ext (le_antisymm (hle U U' h) (hle U' U h.symm))
  rw [← Nat.card_coe_set_eq]
  calc Nat.card {U : Submodule F (Fin n → F) | finrank F U = k}
      = Nat.card {U : Submodule F (Fin n → F) // finrank F U = k} := rfl
    _ ≤ Nat.card (Finset (Fin n) × (Fin k → Fin (n - k) → F)) :=
        Nat.card_le_card_of_injective code hinjc
    _ = 2 ^ n * Nat.card F ^ (k * (n - k)) := by
        rw [Nat.card_prod, Nat.card_fun, Nat.card_fun, Nat.card_fin, Nat.card_fin,
          Nat.card_eq_fintype_card (α := Finset (Fin n)), Fintype.card_finset, Fintype.card_fin,
          ← pow_mul, mul_comm (n - k) k]

end Grass

section Lemma27ii

variable {F : Type*} [Field F] {R : ℕ}

/-- Alternating forms are skew: `A(x, y) = - A(y, x)`. -/
lemma bfL_swap {A : Matrix (Fin R) (Fin R) F} (hA : IsAltMat A) (x y : Fin R → F) :
    bfL x y A = -bfL y x A := by
  have h := bfL_self_eq_zero hA (x + y)
  have hx := bfL_self_eq_zero hA x
  have hy := bfL_self_eq_zero hA y
  rw [bfL_apply, Matrix.mulVec_add, dotProduct_add, add_dotProduct, add_dotProduct] at h
  rw [bfL_apply] at hx hy
  rw [bfL_apply, bfL_apply]
  linear_combination h - hx - hy

lemma bfL_rad_left {A : Matrix (Fin R) (Fin R) F} {x : Fin R → F} (hx : x ∈ rad A)
    (y : Fin R → F) : bfL x y A = 0 := by
  have h := LinearMap.congr_fun (LinearMap.mem_ker.1 hx) y
  rw [Matrix.toBilin'_apply', LinearMap.zero_apply] at h
  exact h

lemma bfL_rad_right {A : Matrix (Fin R) (Fin R) F} (hA : IsAltMat A) {x : Fin R → F}
    (hx : x ∈ rad A) (y : Fin R → F) : bfL y x A = 0 := by
  rw [bfL_swap hA, bfL_rad_left hx, neg_zero]

/-- A subspace `U ≤ W` extends inside `W` to any dimension `≤ dim W`. -/
lemma exists_le_le_finrank_eq (W : Submodule F (Fin R → F)) (k : ℕ) :
    ∀ U : Submodule F (Fin R → F), U ≤ W → finrank F U + k ≤ finrank F W →
      ∃ H : Submodule F (Fin R → F), U ≤ H ∧ H ≤ W ∧ finrank F H = finrank F U + k := by
  induction k with
  | zero => intro U hU _; exact ⟨U, le_rfl, hU, rfl⟩
  | succ k ih =>
    intro U hUW hk
    have hlt : U < W := lt_of_le_of_ne hUW (fun h => by rw [h] at hk; omega)
    obtain ⟨v, hvW, hv⟩ := SetLike.exists_of_lt hlt
    have hv0 : v ≠ 0 := fun h => hv (by rw [h]; exact U.zero_mem)
    obtain ⟨U', hUU', hU'W, hU'⟩ : ∃ U' : Submodule F (Fin R → F),
        U < U' ∧ U' ≤ W ∧ finrank F U' ≤ finrank F U + 1 := by
      refine ⟨U ⊔ Submodule.span F {v}, ?_,
        sup_le hUW (Submodule.span_le.2 (Set.singleton_subset_iff.2 hvW)), ?_⟩
      · refine lt_of_le_of_ne le_sup_left ?_
        intro heq
        apply hv
        rw [heq]
        exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self v)
      · have := Submodule.finrank_add_le_finrank_add_finrank U (Submodule.span F {v})
        rwa [finrank_span_singleton hv0] at this
    have h1 : finrank F U < finrank F U' := Submodule.finrank_lt_finrank_of_lt hUU'
    obtain ⟨H, hH, hHW, hHf⟩ := ih U' hU'W (by omega)
    exact ⟨H, hUU'.le.trans hH, hHW, by omega⟩

/-- Two forms agreeing on the coordinates outside `P` agree on vectors vanishing on `P`. -/
lemma bfL_eq_of_agree {A A' : Matrix (Fin R) (Fin R) F} (P : Finset (Fin R))
    (hAA : ∀ p ∉ P, ∀ q ∉ P, A p q = A' p q) {c d : Fin R → F} (hc : ∀ i ∈ P, c i = 0)
    (hd : ∀ i ∈ P, d i = 0) : bfL c d A = bfL c d A' := by
  rw [bfL_apply, bfL_apply, Matrix.dot_mulVec_eq_sum_sum, Matrix.dot_mulVec_eq_sum_sum]
  refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => ?_))
  by_cases hj : j ∈ P
  · rw [hd j hj, mul_zero, mul_zero]
  · by_cases hi : i ∈ P
    · rw [hc i hi, zero_mul, zero_mul, zero_mul, zero_mul]
    · rw [hAA i hi j hj]

/-- Lemma 2.7 (ii), crude form: the alternating `R × R` forms of rank at most `ρ`
(`dim rad A ≥ R - ρ`) number at most `2^R q^((R-ρ)ρ + C(ρ,2))`; for `ρ = 2a` the exponent is
`a(2R - 2a - 1)`. -/
theorem ncard_alt_rank_le [Finite F] (ρ : ℕ) (hρ : ρ ≤ R) :
    {A : Matrix (Fin R) (Fin R) F | IsAltMat A ∧ R - ρ ≤ finrank F (rad A)}.ncard ≤
      2 ^ R * Nat.card F ^ ((R - ρ) * ρ + ρ.choose 2) := by
  classical
  have hK : ∀ A : {A : Matrix (Fin R) (Fin R) F // IsAltMat A ∧ R - ρ ≤ finrank F (rad A)},
      ∃ K : Submodule F (Fin R → F), K ≤ rad A.1 ∧ finrank F K = R - ρ := by
    intro A
    have h2 := A.2.2
    obtain ⟨H, -, hH, hf⟩ := exists_le_le_finrank_eq (rad A.1) (R - ρ) ⊥ bot_le
      (by rw [finrank_bot]; omega)
    exact ⟨H, hH, by rw [hf, finrank_bot, zero_add]⟩
  choose K hKrad hKdim using hK
  have hP : ∀ K : Submodule F (Fin R → F), ∃ P : Finset (Fin R), P.card = finrank F K ∧
      (∀ w : P → F, ∃ v ∈ K, ∀ i : P, v i = w i) := fun K => by
    obtain ⟨P, h1, -, h3⟩ := exists_pivots K
    exact ⟨P, h1, h3⟩
  choose P hPcard hPsurj using hP
  have hPc : ∀ A, ((P (K A))ᶜ).card = ρ := fun A => by
    rw [Finset.card_compl, Fintype.card_fin, hPcard, hKdim]
    omega
  let code : {A : Matrix (Fin R) (Fin R) F // IsAltMat A ∧ R - ρ ≤ finrank F (rad A)} →
      {U : Submodule F (Fin R → F) // finrank F U = R - ρ} × (TPairs ρ → F) := fun A =>
    (⟨K A, hKdim A⟩, fun p => A.1 (((P (K A))ᶜ).orderEmbOfFin (hPc A) p.1.1)
      (((P (K A))ᶜ).orderEmbOfFin (hPc A) p.1.2))
  have hemb : ∀ (T T' : Finset (Fin R)) {m : ℕ} (h : T.card = m) (h' : T'.card = m), T = T' →
      ∀ a, T.orderEmbOfFin h a = T'.orderEmbOfFin h' a := by
    rintro T _ m h h' rfl a
    rfl
  have hinjc : Function.Injective code := by
    intro A A' h
    have hKK : K A = K A' := congrArg Subtype.val (congrArg Prod.fst h)
    have h2 := congrArg Prod.snd h
    have hPP : (P (K A))ᶜ = (P (K A'))ᶜ := by rw [hKK]
    set τ := ((P (K A))ᶜ).orderEmbOfFin (hPc A) with hτ
    have hτ' : ∀ a, ((P (K A'))ᶜ).orderEmbOfFin (hPc A') a = τ a := fun a =>
      (hemb _ _ (hPc A) (hPc A') hPP a).symm
    have hent : ∀ p : TPairs ρ, A.1 (τ p.1.1) (τ p.1.2) = A'.1 (τ p.1.1) (τ p.1.2) := by
      intro p
      have h3 := congrFun h2 p
      simp only [code] at h3
      rw [hτ', hτ'] at h3
      exact h3
    have hagree : ∀ p ∉ P (K A), ∀ q ∉ P (K A), A.1 p q = A'.1 p q := by
      intro p hp q hq
      obtain ⟨a, rfl⟩ : p ∈ Set.range τ := by
        rw [hτ, Finset.range_orderEmbOfFin]
        exact Finset.mem_compl.2 hp
      obtain ⟨b, rfl⟩ : q ∈ Set.range τ := by
        rw [hτ, Finset.range_orderEmbOfFin]
        exact Finset.mem_compl.2 hq
      rcases lt_trichotomy a b with hab | hab | hab
      · exact hent ⟨(a, b), hab⟩
      · rw [hab, A.2.1.1, A'.2.1.1]
      · rw [A.2.1.2 (τ b) (τ a), A'.2.1.2 (τ b) (τ a)]
        congr 1
        exact hent ⟨(b, a), hab⟩
    apply Subtype.ext
    ext i j
    have hdec : ∀ i : Fin R, ∃ k ∈ K A, ∀ l ∈ P (K A), ((Pi.single i (1 : F) : Fin R → F) - k) l = 0 := by
      intro i
      obtain ⟨k, hk, hkP⟩ := hPsurj (K A) (fun l => (Pi.single i (1 : F) : Fin R → F) l)
      refine ⟨k, hk, fun l hl => ?_⟩
      show (Pi.single i (1 : F) : Fin R → F) l - k l = 0
      rw [hkP ⟨l, hl⟩]
      exact sub_self _
    obtain ⟨ki, hki, hci⟩ := hdec i
    obtain ⟨kj, hkj, hcj⟩ := hdec j
    have hki' : ki ∈ K A' := hKK ▸ hki
    have hkj' : kj ∈ K A' := hKK ▸ hkj
    have expand : ∀ B : Matrix (Fin R) (Fin R) F, IsAltMat B → ki ∈ rad B → kj ∈ rad B →
        B i j = bfL (Pi.single i 1 - ki) (Pi.single j 1 - kj) B := by
      intro B hB hri hrj
      have e1 : bfL (Pi.single i 1 - ki) (Pi.single j 1 - kj) B =
          bfL (Pi.single i 1) (Pi.single j 1) B - bfL (Pi.single i 1) kj B -
            (bfL ki (Pi.single j 1) B - bfL ki kj B) := by
        simp only [bfL_apply, Matrix.mulVec_sub, dotProduct_sub, sub_dotProduct]
        ring
      rw [e1, bfL_single, bfL_rad_right hB hrj, bfL_rad_left hri, bfL_rad_left hri]
      ring
    rw [expand A.1 A.2.1 (hKrad A hki) (hKrad A hkj),
      expand A'.1 A'.2.1 (hKrad A' hki') (hKrad A' hkj')]
    exact bfL_eq_of_agree (P (K A)) hagree hci hcj
  rw [← Nat.card_coe_set_eq]
  have hG := ncard_grass_le_pivot (F := F) (n := R) (R - ρ)
  have hRR : R - (R - ρ) = ρ := by omega
  rw [hRR] at hG
  calc Nat.card {A : Matrix (Fin R) (Fin R) F | IsAltMat A ∧ R - ρ ≤ finrank F (rad A)}
      = Nat.card {A : Matrix (Fin R) (Fin R) F // IsAltMat A ∧ R - ρ ≤ finrank F (rad A)} := rfl
    _ ≤ Nat.card ({U : Submodule F (Fin R → F) // finrank F U = R - ρ} × (TPairs ρ → F)) :=
        Nat.card_le_card_of_injective code hinjc
    _ = {U : Submodule F (Fin R → F) | finrank F U = R - ρ}.ncard * Nat.card F ^ ρ.choose 2 := by
        rw [Nat.card_prod, Nat.card_fun, Nat.card_eq_fintype_card (α := TPairs ρ), card_TPairs]
        try rfl
    _ ≤ 2 ^ R * Nat.card F ^ ((R - ρ) * ρ) * Nat.card F ^ ρ.choose 2 :=
        Nat.mul_le_mul_right _ hG
    _ = 2 ^ R * Nat.card F ^ ((R - ρ) * ρ + ρ.choose 2) := by
        rw [pow_add, mul_assoc]

end Lemma27ii

section Lemma81

variable {F : Type*} [Field F] {R : ℕ}

/-- Every subspace of the radical is totally isotropic. -/
theorem isotropic_of_le_rad {A : Matrix (Fin R) (Fin R) F} {U : Submodule F (Fin R → F)}
    (hU : U ≤ rad A) : Isotropic A U := by
  intro x hx y _
  have h := LinearMap.congr_fun (LinearMap.mem_ker.1 (hU hx)) y
  rw [Matrix.toBilin'_apply', LinearMap.zero_apply] at h
  exact h

/-- `Z_h(cA) = Z_h(A)` for `c ≠ 0`. -/
theorem isoLocus_smul (A : Matrix (Fin R) (Fin R) F) {c : F} (hc : c ≠ 0) (h : ℕ) :
    isoLocus (c • A) h = isoLocus A h := by
  ext H
  simp only [isoLocus, Set.mem_setOf_eq]
  apply and_congr_right
  intro _
  unfold Isotropic
  simp only [map_smul, smul_eq_mul, mul_eq_zero, hc, false_or]

/-- `I_h(A) ≤ |Gr(h, X)|`. -/
theorem isoCount_le_grass [Finite F] (A : Matrix (Fin R) (Fin R) F) (h : ℕ) :
    isoCount A h ≤ {H : Submodule F (Fin R → F) | finrank F H = h}.ncard :=
  Set.ncard_le_ncard (fun _ hH => hH.1) (grass_finite R h)

/-- `I_h(0) = |Gr(h, X)|`. -/
theorem isoLocus_zero (h : ℕ) :
    isoLocus (0 : Matrix (Fin R) (Fin R) F) h = {H : Submodule F (Fin R → F) | finrank F H = h} := by
  ext H
  simp only [isoLocus, Set.mem_setOf_eq, and_iff_left_iff_imp]
  intro _ x _ y _
  exact map_zero _

/-- Dimension bound behind Lemma 8.1: a totally isotropic `H` satisfies
`2 dim H ≤ dim X + dim rad A`. With `rank A = 2a` (`dim rad A = R - 2a`) this says
`h ≤ R - a`, i.e. `Z_h(A) = ∅` for `h > r_0 + a`. -/
theorem two_mul_finrank_le_of_isotropic {A : Matrix (Fin R) (Fin R) F}
    {H : Submodule F (Fin R → F)} (hiso : Isotropic A H) :
    2 * finrank F H ≤ R + finrank F (rad A) := by
  have key : finrank F H + finrank F ((Matrix.toBilin' A).orthogonal H) =
      R + finrank F (H ⊓ LinearMap.ker (Matrix.toBilin' A) : Submodule F (Fin R → F)) := by
    have := LinearMap.BilinForm.finrank_add_finrank_orthogonal' (B := Matrix.toBilin' A) H
    rwa [Module.finrank_fin_fun] at this
  have h1 : H ≤ (Matrix.toBilin' A).orthogonal H := by
    intro m hm
    rw [LinearMap.BilinForm.mem_orthogonal_iff]
    intro n hn
    rw [Matrix.toBilin'_apply']
    exact hiso n hn m hm
  have h2 := Submodule.finrank_mono h1
  have h3 : finrank F (H ⊓ LinearMap.ker (Matrix.toBilin' A) : Submodule F (Fin R → F)) ≤
      finrank F (rad A) := Submodule.finrank_mono inf_le_right
  omega

theorem isoLocus_eq_empty {A : Matrix (Fin R) (Fin R) F} {h : ℕ}
    (hh : R + finrank F (rad A) < 2 * h) : isoLocus A h = ∅ := by
  ext H
  simp only [isoLocus, Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_and]
  intro hH hiso
  have := two_mul_finrank_le_of_isotropic hiso
  omega

end Lemma81

section SimsBounds

variable {F : Type*} [Field F] {R M : ℕ}

/-- The value map `(x, y) ↦ β(x, y) = (x ⬝ β_k y)_k`, bilinear. -/
def valL (β : Fin M → Matrix (Fin R) (Fin R) F) :
    (Fin R → F) →ₗ[F] (Fin R → F) →ₗ[F] (Fin M → F) :=
  LinearMap.mk₂ F (fun x y k => bfL x y (β k))
    (fun x x' y => by funext k; simp [bfL_apply, add_dotProduct])
    (fun c x y => by funext k; simp [bfL_apply, smul_dotProduct])
    (fun x y y' => by funext k; simp [bfL_apply, Matrix.mulVec_add, dotProduct_add])
    (fun c x y => by funext k; simp [bfL_apply, Matrix.mulVec_smul, dotProduct_smul])

lemma valL_apply (β : Fin M → Matrix (Fin R) (Fin R) F) (x y : Fin R → F) :
    valL β x y = fun k => bfL x y (β k) := rfl

lemma valL_mem_vals (β : Fin M → Matrix (Fin R) (Fin R) F) {U : Submodule F (Fin R → F)}
    {x y : Fin R → F} (hx : x ∈ U) (hy : y ∈ U) : valL β x y ∈ vals β U :=
  ⟨x, hx, y, hy, rfl⟩

lemma valL_self (β : Fin M → Matrix (Fin R) (Fin R) F) (hA : ∀ k, IsAltMat (β k))
    (x : Fin R → F) : valL β x x = 0 := by
  funext k
  exact bfL_self_eq_zero (hA k) x

lemma valL_swap (β : Fin M → Matrix (Fin R) (Fin R) F) (hA : ∀ k, IsAltMat (β k))
    (x y : Fin R → F) : valL β y x = -valL β x y := by
  funext k
  exact bfL_swap (hA k) y x

/-- On `U = span (range v)`, the values of an alternating `β` lie in the span of the
`β(v_i, v_j)` with `i < j`. -/
lemma vals_subset_span_pairs (β : Fin M → Matrix (Fin R) (Fin R) F) (hA : ∀ k, IsAltMat (β k))
    {s : ℕ} (v : Fin s → (Fin R → F)) :
    vals β (Submodule.span F (Set.range v)) ⊆
      Submodule.span F (Set.range (fun q : TPairs s => valL β (v q.1.1) (v q.1.2))) := by
  set S := Submodule.span F (Set.range (fun q : TPairs s => valL β (v q.1.1) (v q.1.2)))
  have h1 : ∀ i j, valL β (v i) (v j) ∈ S := by
    intro i j
    rcases lt_trichotomy i j with h | h | h
    · exact Submodule.subset_span ⟨⟨(i, j), h⟩, rfl⟩
    · rw [h, valL_self β hA]
      exact S.zero_mem
    · rw [valL_swap β hA]
      exact S.neg_mem (Submodule.subset_span ⟨⟨(j, i), h⟩, rfl⟩)
  have h2 : ∀ j, ∀ x ∈ Submodule.span F (Set.range v), valL β x (v j) ∈ S := by
    intro j x hx
    have hle : Submodule.span F (Set.range v) ≤ S.comap ((valL β).flip (v j)) := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact h1 i j
    exact hle hx
  rintro w ⟨x, hx, y, hy, rfl⟩
  have hle : Submodule.span F (Set.range v) ≤ S.comap (valL β x) := by
    rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact h2 j x hx
  exact hle hy

/-- Lemma 2.3 / BNV 5.2, upper half: `dim W ≤ C(s(β), 2)` for a surjective alternating `β`. -/
theorem card_le_choose_simsRk (β : Fin M → Matrix (Fin R) (Fin R) F) (hA : ∀ k, IsAltMat (β k))
    (hg : GensOn β ⊤) : M ≤ (simsRk β).choose 2 := by
  obtain ⟨U, hU, hgU⟩ := exists_gens_of_simsRk β hg
  obtain ⟨v, hv⟩ := grass_subset_range (F := F) R (simsRk β) hU
  have hv' : Submodule.span F (Set.range v) = U := hv
  have hsub := vals_subset_span_pairs β hA v
  rw [hv'] at hsub
  have htop : Submodule.span F
      (Set.range (fun q : TPairs (simsRk β) => valL β (v q.1.1) (v q.1.2))) = ⊤ := by
    apply top_unique
    unfold GensOn at hgU
    rw [← hgU]
    exact Submodule.span_le.2 hsub
  have h1 : finrank F (Submodule.span F
      (Set.range (fun q : TPairs (simsRk β) => valL β (v q.1.1) (v q.1.2)))) ≤
      Fintype.card (TPairs (simsRk β)) :=
    finrank_range_le_card (fun q : TPairs (simsRk β) => valL β (v q.1.1) (v q.1.2))
  rw [htop, finrank_top, Module.finrank_fin_fun, card_TPairs] at h1
  exact h1

/-! Strict flags (BNV Prop 5.2, linear-algebra form of `CoreFlag`). -/

/-- `W_k(u) = span {β(u_a, u_b) : a < b < k}`. -/
def chainW (β : Fin M → Matrix (Fin R) (Fin R) F) (u : ℕ → (Fin R → F)) (k : ℕ) :
    Submodule F (Fin M → F) :=
  Submodule.span F {w | ∃ a b, a < b ∧ b < k ∧ w = valL β (u a) (u b)}

/-- `u` is strict of length `t`: `W_k < W_{k+1}` for `1 ≤ k < t`. -/
def IsStrictChainV (β : Fin M → Matrix (Fin R) (Fin R) F) (u : ℕ → (Fin R → F)) (t : ℕ) :
    Prop :=
  ∀ k, 1 ≤ k → k < t → chainW β u k ≠ chainW β u (k + 1)

lemma mem_chainW (β : Fin M → Matrix (Fin R) (Fin R) F) (u : ℕ → (Fin R → F)) {a b k : ℕ}
    (hab : a < b) (hbk : b < k) : valL β (u a) (u b) ∈ chainW β u k :=
  Submodule.subset_span ⟨a, b, hab, hbk, rfl⟩

lemma chainW_mono (β : Fin M → Matrix (Fin R) (Fin R) F) (u : ℕ → (Fin R → F)) {k l : ℕ}
    (hkl : k ≤ l) : chainW β u k ≤ chainW β u l := by
  apply Submodule.span_mono
  rintro _ ⟨a, b, hab, hbk, rfl⟩
  exact ⟨a, b, hab, by omega, rfl⟩

lemma chainW_le (β : Fin M → Matrix (Fin R) (Fin R) F) {u : ℕ → (Fin R → F)} {k : ℕ}
    {S : Submodule F (Fin M → F)} (h : ∀ a b, a < b → b < k → valL β (u a) (u b) ∈ S) :
    chainW β u k ≤ S := by
  rw [chainW, Submodule.span_le]
  rintro _ ⟨a, b, hab, hbk, rfl⟩
  exact h a b hab hbk

lemma chainW_congr (β : Fin M → Matrix (Fin R) (Fin R) F) {u u' : ℕ → (Fin R → F)} {k : ℕ}
    (h : ∀ i < k, u i = u' i) : chainW β u k = chainW β u' k := by
  apply le_antisymm
  · refine chainW_le β fun a b hab hbk => ?_
    rw [h a (by omega), h b hbk]
    exact mem_chainW β u' hab hbk
  · refine chainW_le β fun a b hab hbk => ?_
    rw [← h a (by omega), ← h b hbk]
    exact mem_chainW β u hab hbk

lemma chainW_one (β : Fin M → Matrix (Fin R) (Fin R) F) (u : ℕ → (Fin R → F)) :
    chainW β u 1 = ⊥ := by
  refine le_antisymm ?_ bot_le
  refine chainW_le β fun a b hab hb => ?_
  exact absurd hab (by omega)

/-- If `W_s ≠ W_{s+1}` then some `β(u_a, u_s)`, `a < s`, is not in `W_s`. -/
lemma exists_not_mem_chainW (β : Fin M → Matrix (Fin R) (Fin R) F) {u : ℕ → (Fin R → F)}
    {s : ℕ} (h : chainW β u s ≠ chainW β u (s + 1)) :
    ∃ a < s, valL β (u a) (u s) ∉ chainW β u s := by
  by_contra hc
  push_neg at hc
  apply h
  apply le_antisymm (chainW_mono β u (Nat.le_succ s))
  refine chainW_le β fun a b hab hb => ?_
  by_cases hbs : b < s
  · exact mem_chainW β u hab hbs
  · rw [show b = s by omega]
    exact hc a (by omega)

/-- `dim W_k ≥ k - 1` along a strict chain. -/
lemma finrank_chainW_ge (β : Fin M → Matrix (Fin R) (Fin R) F) {u : ℕ → (Fin R → F)} {t : ℕ}
    (hu : IsStrictChainV β u t) : ∀ k, 1 ≤ k → k ≤ t → k - 1 ≤ finrank F (chainW β u k) := by
  intro k
  induction k with
  | zero => intro h; exact absurd h (by norm_num)
  | succ k ih =>
    intro _ hkt
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      simp
    · have h1 := ih hk (by omega)
      have hlt : chainW β u k < chainW β u (k + 1) :=
        lt_of_le_of_ne (chainW_mono β u (Nat.le_succ k)) (hu k hk (by omega))
      have h2 := Submodule.finrank_lt_finrank_of_lt hlt
      omega

/-- A strict chain has length at most `dim W + 1`. -/
lemma strict_length_le (β : Fin M → Matrix (Fin R) (Fin R) F) {u : ℕ → (Fin R → F)} {t : ℕ}
    (hu : IsStrictChainV β u t) (ht : 1 ≤ t) : t ≤ M + 1 := by
  have h1 := finrank_chainW_ge β hu t ht le_rfl
  have h2 := Submodule.finrank_le (chainW β u t)
  rw [Module.finrank_fin_fun] at h2
  omega

/-- Extension of a strict chain (append, or the exchange `(u_0, ..., u_{s-1}, w, y)`). -/
lemma strictV_extend (β : Fin M → Matrix (Fin R) (Fin R) F) {u : ℕ → (Fin R → F)} {t : ℕ}
    (ht : 2 ≤ t) (hu : IsStrictChainV β u t) {x y : Fin R → F}
    (hxy : valL β x y ∉ chainW β u t) : ∃ u' : ℕ → (Fin R → F), IsStrictChainV β u' (t + 1) := by
  by_cases hc : ∃ a < t, ∃ v, valL β (u a) v ∉ chainW β u t
  · obtain ⟨a, ha, v, hv⟩ := hc
    set u' : ℕ → (Fin R → F) := fun i => if i < t then u i else v with hu'
    have hW : ∀ k ≤ t, chainW β u' k = chainW β u k := fun k hk =>
      chainW_congr β fun i hi => (if_pos (show i < t by omega) : u' i = u i)
    refine ⟨u', fun k hk1 hkt => ?_⟩
    rcases Nat.lt_or_ge k t with hk | hk
    · rw [hW k hk.le, hW (k + 1) (by omega)]
      exact hu k hk1 hk
    · rw [show k = t by omega, hW t le_rfl]
      intro heq
      apply hv
      have hm := mem_chainW β u' ha (show t < t + 1 by omega)
      have e1 : u' a = u a := if_pos ha
      have e2 : u' t = v := if_neg (lt_irrefl t)
      rw [e1, e2, ← heq] at hm
      exact hm
  · have hc' : ∀ a < t, ∀ v, valL β (u a) v ∈ chainW β u t := fun a ha v => by
      by_contra hn
      exact hc ⟨a, ha, v, hn⟩
    obtain ⟨s, rfl⟩ : ∃ s, t = s + 1 := ⟨t - 1, by omega⟩
    obtain ⟨a0, ha0, hna0⟩ := exists_not_mem_chainW β (hu s (by omega) (by omega))
    have hw : ∃ w, (∃ a < s, valL β (u a) w ∉ chainW β u s) ∧
        valL β w y ∉ chainW β u (s + 1) := by
      by_cases hx' : ∃ a < s, valL β (u a) x ∉ chainW β u s
      · exact ⟨x, hx', hxy⟩
      · push_neg at hx'
        refine ⟨u s + x, ⟨a0, ha0, ?_⟩, ?_⟩
        · rw [map_add, Submodule.add_mem_iff_left _ (hx' a0 ha0)]
          exact hna0
        · rw [map_add, LinearMap.add_apply,
            Submodule.add_mem_iff_right _ (hc' s (by omega) y)]
          exact hxy
    obtain ⟨w, hw1, hw2⟩ := hw
    set u' : ℕ → (Fin R → F) := fun i => if i < s then u i else if i = s then w else y with hu'
    have e1 : ∀ i < s, u' i = u i := fun i hi => if_pos hi
    have e2 : u' s = w := by
      show (if s < s then u s else if s = s then w else y) = w
      rw [if_neg (lt_irrefl s), if_pos rfl]
    have e3 : u' (s + 1) = y := by
      show (if s + 1 < s then u (s + 1) else if s + 1 = s then w else y) = y
      rw [if_neg (show ¬ (s + 1 < s) by omega), if_neg (show ¬ (s + 1 = s) by omega)]
    have hW : ∀ k ≤ s, chainW β u' k = chainW β u k := fun k hk =>
      chainW_congr β fun i hi => e1 i (by omega)
    have hle : chainW β u' (s + 1) ≤ chainW β u (s + 1) := by
      refine chainW_le β fun a b hab hb => ?_
      by_cases hbs : b < s
      · rw [e1 a (by omega), e1 b hbs]
        exact mem_chainW β u hab (by omega)
      · rw [show b = s by omega, e1 a (by omega), e2]
        exact hc' a (by omega) w
    refine ⟨u', fun k hk1 hkt => ?_⟩
    by_cases hks : k < s
    · rw [hW k (by omega), hW (k + 1) (by omega)]
      exact hu k hk1 (by omega)
    · by_cases hk' : k = s
      · rw [hk', hW s le_rfl]
        obtain ⟨a, ha, hna⟩ := hw1
        intro heq
        apply hna
        have hm := mem_chainW β u' ha (show s < s + 1 by omega)
        rw [e1 a ha, e2, ← heq] at hm
        exact hm
      · rw [show k = s + 1 by omega]
        intro heq
        apply hw2
        have hm := mem_chainW β u' (show s < s + 1 by omega) (show s + 1 < s + 1 + 1 by omega)
        rw [e2, e3, ← heq] at hm
        exact hle hm

/-- If the values of `β` span `W` but `S ≠ W`, some value `β(x, y)` lies outside `S`. -/
lemma exists_val_not_mem (β : Fin M → Matrix (Fin R) (Fin R) F) (hg : GensOn β ⊤)
    {S : Submodule F (Fin M → F)} (hS : S ≠ ⊤) : ∃ x y, valL β x y ∉ S := by
  by_contra hc
  push_neg at hc
  apply hS
  apply top_unique
  unfold GensOn at hg
  rw [← hg, Submodule.span_le]
  rintro _ ⟨x, -, y, -, rfl⟩
  exact hc x y

/-- BNV Prop 5.2 (linear form): a surjective alternating `β` onto `W ≠ 0` has a strict chain
`u_0, ..., u_{t-1}` with `W_t = W`. -/
theorem exists_strict_top (β : Fin M → Matrix (Fin R) (Fin R) F) (hg : GensOn β ⊤)
    (hM : 1 ≤ M) : ∃ u : ℕ → (Fin R → F), ∃ t, IsStrictChainV β u t ∧ 2 ≤ t ∧
      chainW β u t = ⊤ := by
  have hne : (⊥ : Submodule F (Fin M → F)) ≠ ⊤ := by
    intro h
    have hmem : (Pi.single (⟨0, hM⟩ : Fin M) (1 : F) : Fin M → F) ∈
        (⊥ : Submodule F (Fin M → F)) := by
      rw [h]
      exact Submodule.mem_top
    rw [Submodule.mem_bot] at hmem
    have := congrFun hmem ⟨0, hM⟩
    simp at this
  obtain ⟨x0, y0, h0⟩ := exists_val_not_mem β hg hne
  have step : ∀ j, ∃ u : ℕ → (Fin R → F), ∃ t, IsStrictChainV β u t ∧ 2 ≤ t ∧
      (chainW β u t = ⊤ ∨ j + 2 ≤ t) := by
    intro j
    induction j with
    | zero =>
      set u : ℕ → (Fin R → F) := fun i => if i = 0 then x0 else y0 with hu
      refine ⟨u, 2, fun k hk1 hk2 => ?_, le_rfl, Or.inr (by norm_num)⟩
      rw [show k = 1 by omega, chainW_one]
      intro heq
      apply h0
      have hm := mem_chainW β u (show 0 < 1 by norm_num) (show 1 < 1 + 1 by norm_num)
      have e0 : u 0 = x0 := if_pos rfl
      have e1 : u 1 = y0 := if_neg (by norm_num)
      rw [e0, e1, ← heq] at hm
      exact hm
    | succ j ih =>
      obtain ⟨u, t, hu, ht, hor⟩ := ih
      by_cases htop : chainW β u t = ⊤
      · exact ⟨u, t, hu, ht, Or.inl htop⟩
      · have hj : j + 2 ≤ t := hor.resolve_left htop
        obtain ⟨x, y, hxy⟩ := exists_val_not_mem β hg htop
        obtain ⟨u', hu'⟩ := strictV_extend β ht hu hxy
        exact ⟨u', t + 1, hu', by omega, Or.inr (by omega)⟩
  obtain ⟨u, t, hu, ht, hor⟩ := step M
  rcases hor with h | h
  · exact ⟨u, t, hu, ht, h⟩
  · have := strict_length_le β hu (by omega)
    omega

/-- Lemma 9.1 / BNV Prop 5.2: `s(β) ≤ dim W + 1` for a surjective alternating `β`. -/
theorem simsRk_le_succ (β : Fin M → Matrix (Fin R) (Fin R) F) (hg : GensOn β ⊤) :
    simsRk β ≤ M + 1 := by
  rcases Nat.eq_zero_or_pos M with hM | hM
  · subst hM
    have hbot : GensOn β ⊥ := by
      unfold GensOn
      apply eq_top_iff.2
      intro w _
      rw [Subsingleton.elim w 0]
      exact Submodule.zero_mem _
    have := simsRk_le_of β (U := ⊥) (d := 0) (by simp) hbot
    omega
  · obtain ⟨u, t, hu, ht, htop⟩ := exists_strict_top β hg hM
    set U : Submodule F (Fin R → F) := Submodule.span F (Set.range (fun i : Fin t => u i))
    have hmemU : ∀ i < t, u i ∈ U := fun i hi =>
      Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩
    have hgU : GensOn β U := by
      unfold GensOn
      apply top_unique
      rw [← htop]
      refine chainW_le β fun a b hab hb => ?_
      exact Submodule.subset_span (valL_mem_vals β (hmemU a (by omega)) (hmemU b hb))
    have h1 := simsRk_le_of β rfl hgU
    have h2 : finrank F U ≤ Fintype.card (Fin t) :=
      finrank_range_le_card (fun i : Fin t => u i)
    have h3 := strict_length_le β hu (by omega)
    rw [Fintype.card_fin] at h2
    omega

/-- The parameter constraints of CNT3 for `N_2` (Lemma 2.3 / 9.1, BNV 5.2):
`N_2(r1, r2, s) ≠ 0` forces `s - 1 ≤ r2 ≤ C(s, 2)` (and `2 ≤ s ≤ r1` when `r2 ≥ 1`). -/
theorem N2_support_sims {r1 r2 s : ℕ} (h : 0 < N2 r1 r2 s) :
    s ≤ r2 + 1 ∧ r2 ≤ s.choose 2 ∧ s ≤ r1 ∧ (1 ≤ r2 → 2 ≤ s) := by
  classical
  have hsup := N2_support h
  unfold N2 at h
  obtain ⟨β, hβ⟩ := Finset.card_pos.1 h
  obtain ⟨-, hA, hg, hs⟩ := Finset.mem_filter.1 hβ
  refine ⟨?_, ?_, hsup.1, hsup.2.2⟩
  · rw [← hs]
    exact simsRk_le_succ β hg
  · rw [← hs]
    exact card_le_choose_simsRk β hA hg

end SimsBounds

section GrassLower

variable {F : Type*} [Field F] {n k : ℕ}

/-- The graph map `c ↦ (c, c f)` from `F^k` to `F^n = F^k × F^(n-k)`. -/
def graphL (f : Fin k → Fin (n - k) → F) : (Fin k → F) →ₗ[F] (Fin n → F) where
  toFun c m := if h : (m : ℕ) < k then c ⟨m, h⟩ else
    ∑ i, c i * f i ⟨(m : ℕ) - k, by have := m.2; omega⟩
  map_add' c d := by
    funext m
    simp only [Pi.add_apply]
    split_ifs with h
    · rfl
    · rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun i _ => add_mul _ _ _)
  map_smul' a c := by
    funext m
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    split_ifs with h
    · rfl
    · rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => mul_assoc _ _ _)

lemma graphL_lt (f : Fin k → Fin (n - k) → F) (c : Fin k → F) (m : Fin n) (h : (m : ℕ) < k) :
    graphL f c m = c ⟨m, h⟩ := by
  simp only [graphL, LinearMap.coe_mk, AddHom.coe_mk]
  rw [dif_pos h]

lemma graphL_ge (f : Fin k → Fin (n - k) → F) (c : Fin k → F) (j : Fin (n - k))
    (hj : k + (j : ℕ) < n) : graphL f c ⟨k + j, hj⟩ = ∑ i, c i * f i j := by
  simp only [graphL, LinearMap.coe_mk, AddHom.coe_mk]
  split_ifs with h
  · exact absurd h (by first | omega | simp)
  · exact Finset.sum_congr rfl (fun i _ => congrArg (fun z => c i * f i z) (Fin.ext (by simp)))

lemma graphL_injective (hk : k ≤ n) (f : Fin k → Fin (n - k) → F) :
    Function.Injective (graphL f) := by
  intro c d h
  funext i
  have := congrFun h ⟨i, lt_of_lt_of_le i.2 hk⟩
  rwa [graphL_lt f c ⟨i, lt_of_lt_of_le i.2 hk⟩ i.2,
    graphL_lt f d ⟨i, lt_of_lt_of_le i.2 hk⟩ i.2] at this

/-- Lemma 2.7 (i), lower bound: `q^(k(n-k)) ≤ [n, k]_q` (graphs of maps `F^k → F^(n-k)`). -/
theorem pow_le_ncard_grass [Finite F] (hk : k ≤ n) :
    Nat.card F ^ (k * (n - k)) ≤ {U : Submodule F (Fin n → F) | finrank F U = k}.ncard := by
  let code : (Fin k → Fin (n - k) → F) → {U : Submodule F (Fin n → F) // finrank F U = k} :=
    fun f => ⟨LinearMap.range (graphL f), by
      rw [LinearMap.finrank_range_of_inj (graphL_injective hk f), Module.finrank_fin_fun]⟩
  have hc : Function.Injective code := by
    intro f g hfg
    have hr : LinearMap.range (graphL f) = LinearMap.range (graphL g) :=
      congrArg Subtype.val hfg
    funext i j
    have hmem : graphL f (Pi.single i 1) ∈ LinearMap.range (graphL g) := by
      rw [← hr]
      exact LinearMap.mem_range_self _ _
    obtain ⟨c, hc⟩ := hmem
    have hci : c = Pi.single i 1 := by
      funext l
      have := congrFun hc ⟨l, lt_of_lt_of_le l.2 hk⟩
      rwa [graphL_lt g c ⟨l, lt_of_lt_of_le l.2 hk⟩ l.2,
        graphL_lt f _ ⟨l, lt_of_lt_of_le l.2 hk⟩ l.2] at this
    have hj : k + (j : ℕ) < n := by have := j.2; omega
    have := congrFun hc ⟨k + j, hj⟩
    rw [graphL_ge g c j hj, graphL_ge f _ j hj, hci] at this
    simpa [Pi.single_apply] using this.symm
  rw [← Nat.card_coe_set_eq]
  calc Nat.card F ^ (k * (n - k)) = Nat.card (Fin k → Fin (n - k) → F) := by
        rw [Nat.card_fun, Nat.card_fun, Nat.card_fin, Nat.card_fin, ← pow_mul, mul_comm]
    _ ≤ Nat.card {U : Submodule F (Fin n → F) // finrank F U = k} :=
        Nat.card_le_card_of_injective code hc
    _ = Nat.card {U : Submodule F (Fin n → F) | finrank F U = k} := rfl

end GrassLower

section SubgroupCount

variable {G : Type*} [Group G]

/-- In a group of order `p ^ e`, a proper inclusion of subgroups multiplies the order by `p`. -/
lemma pmul_card_le [Finite G] {p e : ℕ} (hp : p.Prime) (hG : Nat.card G = p ^ e) {K L : Subgroup G}
    (hle : K ≤ L) (hne : K ≠ L) : p * Nat.card K ≤ Nat.card L := by
  have h2 : Nat.card L ∣ p ^ e := by
    rw [← hG]
    exact Subgroup.card_subgroup_dvd_card L
  have h1 : Nat.card K ∣ Nat.card L := Subgroup.card_dvd_of_le hle
  obtain ⟨b, -, hb⟩ := (Nat.dvd_prime_pow hp).mp h2
  obtain ⟨a, -, ha⟩ := (Nat.dvd_prime_pow hp).mp (h1.trans h2)
  have hab : a ≤ b := by
    rw [ha, hb] at h1
    exact (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp h1
  have hab' : a ≠ b := by
    rintro rfl
    exact hne (Subgroup.eq_of_le_of_card_ge hle (by rw [ha, hb]))
  rw [ha, hb, ← pow_succ']
  exact Nat.pow_le_pow_right hp.pos (by omega)

/-- A subgroup of order `p ^ b` of a group of order `p ^ e` is generated by `b` elements. -/
theorem exists_closure_eq_of_card [Finite G] {p e b : ℕ} (hp : p.Prime) (hG : Nat.card G = p ^ e)
    (K : Subgroup G) (hK : Nat.card K = p ^ b) :
    ∃ v : Fin b → G, Subgroup.closure (Set.range v) = K := by
  have step : ∀ j, ∃ v : ℕ → G, (∀ i, v i ∈ K) ∧
      (Subgroup.closure (v '' Set.Iio j) = K ∨
        p ^ j ≤ Nat.card (Subgroup.closure (v '' Set.Iio j))) := by
    intro j
    induction j with
    | zero => exact ⟨fun _ => 1, fun _ => K.one_mem, Or.inr (by rw [pow_zero]; exact Nat.card_pos)⟩
    | succ j ih =>
      obtain ⟨v, hvK, hor⟩ := ih
      have hle : ∀ w : ℕ → G, (∀ i, w i ∈ K) → ∀ l,
          Subgroup.closure (w '' Set.Iio l) ≤ K := by
        intro w hw l
        rw [Subgroup.closure_le]
        rintro _ ⟨i, -, rfl⟩
        exact hw i
      have hmono : ∀ w : ℕ → G, ∀ l, Subgroup.closure (w '' Set.Iio l) ≤
          Subgroup.closure (w '' Set.Iio (l + 1)) := fun w l =>
        Subgroup.closure_mono (Set.image_mono (Set.Iio_subset_Iio (Nat.le_succ l)))
      by_cases hc : Subgroup.closure (v '' Set.Iio j) = K
      · exact ⟨v, hvK, Or.inl (le_antisymm (hle v hvK (j + 1)) (by rw [← hc]; exact hmono v j))⟩
      · have hlt : Subgroup.closure (v '' Set.Iio j) < K :=
          lt_of_le_of_ne (hle v hvK j) hc
        obtain ⟨x, hxK, hx⟩ := SetLike.exists_of_lt hlt
        set w : ℕ → G := fun i => if i < j then v i else x with hw
        have hwK : ∀ i, w i ∈ K := fun i => by
          show (if i < j then v i else x) ∈ K
          split_ifs
          · exact hvK i
          · exact hxK
        have himg : w '' Set.Iio j = v '' Set.Iio j := by
          apply Set.image_congr
          intro i hi
          exact if_pos (Set.mem_Iio.mp hi)
        have hle' : Subgroup.closure (v '' Set.Iio j) ≤ Subgroup.closure (w '' Set.Iio (j + 1)) := by
          rw [← himg]
          exact hmono w j
        have hxmem : x ∈ Subgroup.closure (w '' Set.Iio (j + 1)) := by
          apply Subgroup.subset_closure
          exact ⟨j, Set.mem_Iio.mpr (show j < j + 1 by omega), if_neg (lt_irrefl j)⟩
        have hne : Subgroup.closure (v '' Set.Iio j) ≠ Subgroup.closure (w '' Set.Iio (j + 1)) := by
          intro h
          rw [← h] at hxmem
          exact hx hxmem
        have h1 := pmul_card_le hp hG hle' hne
        have h0 : p ^ j ≤ Nat.card (Subgroup.closure (v '' Set.Iio j)) := hor.resolve_left hc
        refine ⟨w, hwK, Or.inr ?_⟩
        rw [pow_succ']
        exact (Nat.mul_le_mul le_rfl h0).trans h1
  obtain ⟨v, hvK, hor⟩ := step b
  have hle : Subgroup.closure (v '' Set.Iio b) ≤ K := by
    rw [Subgroup.closure_le]
    rintro _ ⟨i, -, rfl⟩
    exact hvK i
  have heq : Subgroup.closure (v '' Set.Iio b) = K := by
    rcases hor with h | h
    · exact h
    · exact Subgroup.eq_of_le_of_card_ge hle (by rw [hK]; exact h)
  refine ⟨fun i => v i, ?_⟩
  rw [← heq]
  congr 1
  ext g
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, Set.mem_Iio.mpr i.2, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i, Set.mem_Iio.mp hi⟩, rfl⟩

/-- Lemma 2.7 (iii), crude form (BNV 20.15 up to the exponent): a group of order `p ^ e` has at
most `p ^ (e b)` subgroups of order `p ^ b`. -/
theorem ncard_subgroups_le [Finite G] {p e b : ℕ} (hp : p.Prime) (hG : Nat.card G = p ^ e) :
    {K : Subgroup G | Nat.card K = p ^ b}.ncard ≤ p ^ (e * b) := by
  have hsub : {K : Subgroup G | Nat.card K = p ^ b} ⊆
      Set.range (fun v : Fin b → G => Subgroup.closure (Set.range v)) := by
    intro K hK
    obtain ⟨v, hv⟩ := exists_closure_eq_of_card hp hG K hK
    exact ⟨v, hv⟩
  calc {K : Subgroup G | Nat.card K = p ^ b}.ncard
      ≤ (Set.range (fun v : Fin b → G => Subgroup.closure (Set.range v))).ncard :=
        Set.ncard_le_ncard hsub (Set.finite_range _)
    _ ≤ (Set.univ : Set (Fin b → G)).ncard := by
        rw [← Set.image_univ]
        exact Set.ncard_image_le (Set.toFinite _)
    _ = p ^ (e * b) := by
        rw [Set.ncard_univ, Nat.card_fun, Nat.card_fin, hG, ← pow_mul]

/-- Every subgroup of order `p ^ c ≤ p ^ b` (with `p ^ b ∣ |G|`) lies in one of order `p ^ b`. -/
theorem exists_le_card_pow [Finite G] {p b c : ℕ} [Fact p.Prime] (hdvd : p ^ b ∣ Nat.card G)
    (H : Subgroup G) (hH : Nat.card H = p ^ c) (hcb : c ≤ b) :
    ∃ K : Subgroup G, Nat.card K = p ^ b ∧ H ≤ K :=
  Sylow.exists_subgroup_card_pow_prime_le p hdvd H hH hcb

end SubgroupCount

section Transport

/-! Transport to an abstract bilinear map `B : V × V → W` (such as the group-level
`OMA.SimsLite.lamLin`): in bases `bV`, `bW` it becomes the tuple `matTuple B bV bW`, with the same
Sims rank. -/

variable {F V W : Type*} [Field F] [AddCommGroup V] [Module F V] [AddCommGroup W] [Module F W]
  {r1 r2 : ℕ}

/-- `B(U × U)` spans `W`. -/
def GensLin (B : V →ₗ[F] V →ₗ[F] W) (U : Submodule F V) : Prop :=
  Submodule.span F {w | ∃ x ∈ U, ∃ y ∈ U, w = B x y} = ⊤

/-- The Sims rank (91) of a bilinear map: `min {dim U : B(U × U)` spans `W}`. -/
noncomputable def simsRkLin (B : V →ₗ[F] V →ₗ[F] W) : ℕ :=
  sInf {d | ∃ U : Submodule F V, finrank F U = d ∧ GensLin B U}

/-- The coordinate tuple of `B` in bases `bV`, `bW`: `(β_k)_{ij} = bW*_k (B(bV_i, bV_j))`. -/
noncomputable def matTuple (B : V →ₗ[F] V →ₗ[F] W) (bV : Basis (Fin r1) F V) (bW : Basis (Fin r2) F W) :
    Fin r2 → Matrix (Fin r1) (Fin r1) F :=
  fun k i j => bW.repr (B (bV i) (bV j)) k

lemma equivFun_symm_single (b : Basis (Fin r1) F V) (i : Fin r1) :
    b.equivFun.symm (Pi.single i 1) = b i := by
  rw [Basis.equivFun_symm_apply]
  simp [Pi.single_apply]

/-- `β(x, y) = bW*(B(x, y))` in coordinates. -/
theorem valL_matTuple (B : V →ₗ[F] V →ₗ[F] W) (bV : Basis (Fin r1) F V)
    (bW : Basis (Fin r2) F W) (x y : Fin r1 → F) :
    valL (matTuple B bV bW) x y =
      bW.equivFun (B (bV.equivFun.symm x) (bV.equivFun.symm y)) := by
  have h : valL (matTuple B bV bW) =
      (B.compl₁₂ bV.equivFun.symm.toLinearMap bV.equivFun.symm.toLinearMap).compr₂
        bW.equivFun.toLinearMap := by
    refine LinearMap.ext_basis (Pi.basisFun F (Fin r1)) (Pi.basisFun F (Fin r1)) fun i j => ?_
    show valL (matTuple B bV bW) (Pi.basisFun F (Fin r1) i) (Pi.basisFun F (Fin r1) j) =
      bW.equivFun (B (bV.equivFun.symm (Pi.basisFun F (Fin r1) i))
        (bV.equivFun.symm (Pi.basisFun F (Fin r1) j)))
    rw [Pi.basisFun_apply, Pi.basisFun_apply, equivFun_symm_single, equivFun_symm_single,
      valL_apply]
    funext k
    rw [bfL_single, Basis.equivFun_apply]
    rfl
  rw [h]
  rfl

/-- For alternating `B` the coordinate matrices are alternating. -/
theorem matTuple_isAlt (B : V →ₗ[F] V →ₗ[F] W) (hB : ∀ x, B x x = 0) (bV : Basis (Fin r1) F V)
    (bW : Basis (Fin r2) F W) (k : Fin r2) : IsAltMat (matTuple B bV bW k) := by
  refine ⟨fun i => ?_, fun i j => ?_⟩
  · show bW.repr (B (bV i) (bV i)) k = 0
    rw [hB, map_zero, Finsupp.zero_apply]
  · have h2 : B (bV j) (bV i) = -B (bV i) (bV j) := by
      have := hB (bV i + bV j)
      simp only [map_add, LinearMap.add_apply, hB, zero_add, add_zero] at this
      rw [eq_neg_iff_add_eq_zero]
      first
        | exact this
        | exact (add_comm _ _).trans this
    show bW.repr (B (bV j) (bV i)) k = -bW.repr (B (bV i) (bV j)) k
    rw [h2, map_neg, Finsupp.neg_apply]

lemma map_map_equivFun (bV : Basis (Fin r1) F V) (U : Submodule F V) :
    (U.map bV.equivFun.toLinearMap).map bV.equivFun.symm.toLinearMap = U := by
  rw [← Submodule.map_comp]
  convert Submodule.map_id U
  ext v
  simp

/-- `β(∧²U) = W` iff `B(U' × U')` spans `W`, for `U'` the image of `U` in `V`. -/
theorem gensOn_matTuple_iff (B : V →ₗ[F] V →ₗ[F] W) (bV : Basis (Fin r1) F V)
    (bW : Basis (Fin r2) F W) (U : Submodule F (Fin r1 → F)) :
    GensOn (matTuple B bV bW) U ↔ GensLin B (U.map bV.equivFun.symm.toLinearMap) := by
  set U' := U.map bV.equivFun.symm.toLinearMap with hU'
  set S : Set W := {w | ∃ x ∈ U', ∃ y ∈ U', w = B x y} with hS
  have hv : vals (matTuple B bV bW) U = bW.equivFun.toLinearMap '' S := by
    ext w
    constructor
    · rintro ⟨x, hx, y, hy, rfl⟩
      refine ⟨B (bV.equivFun.symm x) (bV.equivFun.symm y),
        ⟨_, Submodule.mem_map_of_mem hx, _, Submodule.mem_map_of_mem hy, rfl⟩, ?_⟩
      exact (valL_matTuple B bV bW x y).symm
    · rintro ⟨_, ⟨x', hx', y', hy', rfl⟩, rfl⟩
      obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.1 hx'
      obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.1 hy'
      exact ⟨x, hx, y, hy, (valL_matTuple B bV bW x y).symm⟩
  unfold GensOn GensLin
  rw [hv, Submodule.span_image]
  first
    | exact Submodule.map_eq_top_iff
    | rw [Submodule.map_eq_top_iff (LinearEquiv.range _), LinearEquiv.ker, sup_bot_eq]

/-- The Sims rank of the coordinate tuple is the Sims rank of `B`. -/
theorem simsRk_matTuple (B : V →ₗ[F] V →ₗ[F] W) (bV : Basis (Fin r1) F V)
    (bW : Basis (Fin r2) F W) : simsRk (matTuple B bV bW) = simsRkLin B := by
  unfold simsRk simsRkLin
  congr 1
  ext d
  constructor
  · rintro ⟨U, hU, hg⟩
    exact ⟨U.map bV.equivFun.symm.toLinearMap, by rw [LinearEquiv.finrank_map_eq, hU],
      (gensOn_matTuple_iff B bV bW U).1 hg⟩
  · rintro ⟨U', hU', hg⟩
    refine ⟨U'.map bV.equivFun.toLinearMap, by rw [LinearEquiv.finrank_map_eq, hU'], ?_⟩
    rw [gensOn_matTuple_iff, map_map_equivFun]
    exact hg

/-- The coordinate tuple is surjective iff the values of `B` span `W`. -/
theorem gensOn_top_matTuple_iff (B : V →ₗ[F] V →ₗ[F] W) (bV : Basis (Fin r1) F V)
    (bW : Basis (Fin r2) F W) : GensOn (matTuple B bV bW) ⊤ ↔ GensLin B ⊤ := by
  rw [gensOn_matTuple_iff, Submodule.map_top, LinearEquiv.range]

end Transport

end OMA.SimsLite.Alt2


/-! # Isotropic: Li-Qiao Lemmas 8.1 and 8.2 (counting totally isotropic subspaces)

Li-Qiao (arXiv:2610.14509v3), Sec. 8, pp. 45-50, over a finite field `F` with `q = |F|`
(the target is `F = ZMod 2`), `X = Fin R → F`, `A` an alternating `R × R` matrix with
`dim rad A = r0` and `R = r0 + 2a` (rank `2a`).  All counts are normalised by `x = 1/q`.

Method (an ordered-basis version of the paper's `(J, L, f)` parametrisation).  Count the ordered
linearly independent, pairwise `A`-orthogonal `i`-tuples `v` whose span `S` meets `K = rad A` in
dimension `j` (`isoTupCount A i j`).  Appending a vector `y` to such a tuple keeps it isotropic and
independent iff `y ∈ S^⊥ \ S`; the new intersection with `K` has dimension `j + 1` iff `y ∈ S + K`.
Since `dim (S + K) = i + r0 - j` and `dim S^⊥ = R + j - i`, this gives the exact recursion

  `N(i+1, j+1) ≤ N(i, j) (q^(i+r0-j) - q^i) + N(i, j+1) (q^(R+j+1-i) - q^(i+r0-j-1))`

(`isoTupCount_succ_le`, `isoTupCount_succ_zero_le`).  The real potential

  `P(i, j) = x^E(i,j) · G(j) · S(i-j) · B(i, j)`, `E(i,j) = C(i-j,2) + j (2a - (i-j))`,
  `G(j) = ∏_{m<j} (1 - x^(r0-m))`, `S(l) = ∏_{t<l} (1 - x^(2a-2t))`, `B` = Gaussian binomial in `x`

is an exact solution of the normalised recursion, so `N(i, j) x^(iR) ≤ P(i, j)` (`isoTupCount_le`).
(For `i = h`, `x^(hR) N(h, j) / |GL_h|` is the paper's summand `T_{a, h-j}` of (93) divided by
`q^(h(R-h))`; cf. (100).)  Dividing by the number of ordered bases of an `h`-space gives

* `isoCount_mul_isoQ_le` (Lemma 8.1, upper bound, normalised):
  `I_h(A) · Q(h) ≤ |Gr(h, X)| · Σ_{j ≤ h} P(h, j)`, where `Q(h) = ∏_{t<h} (1 - x^(R-t))`
  (so `|Gr(h,X)| = q^(h(R-h)) π_R / (π_h π_(R-h))` corresponds to `Q(h) / (x^(h(R-h)) π_h)`).
* `isoCount_uniform` (Lemma 8.2, (95), constant `32` in place of `(4/3) π_∞(2)^(-4)`):
  `I_h(A) q^(κ_h(a)) ≤ 32 |Gr(h, X)|`, with `κ_h(a) = C(h,2) - C(h - a_h, 2)` (`kappaH`), which
  equals `a_h (2h - a_h - 1)/2` of (94), `a_h = min(a, max(h-1, 0))`.
* `isoCount_saturated` (Lemma 8.2, (96) with `γ_q ≤ 15/8 < 2` for every `q ≥ 2`):
  if `a ≥ h - 1` then `I_h(A) q^(C(h,2)) ≤ (15/8) |Gr(h, X)|`; `isoCount_saturated_two` is the
  `F = ZMod 2` case.  The paper only needs `γ_2 < 2` (proof of Prop 9.2 at `ℓ = 1`).

Auxiliary: `card_isoOrth` (`#{independent isotropic h-tuples} = I_h(A) · |GL_h|`-style basis
count), `card_isoOrth_eq_sum`, `grass_mul_card` (`|Gr(h,X)| ∏(q^h - q^t) = ∏(q^R - q^t)`),
`qBinom_mul_piQ_le` (`B(i,j) π_j ≤ 1`), `piQ_ge_quarter`, `isoQ_ge`, `isoE_ge_kappa`,
`isoE_two_mul`.
-/

namespace OMA.SimsLite.Alt2

open Module Finset

/-! ### Elementary natural-number facts -/

section NatFacts

lemma choose_two_succ (n : ℕ) : (n + 1).choose 2 = n.choose 2 + n := by
  show (n + 1).choose (1 + 1) = n.choose (1 + 1) + n
  rw [Nat.choose_succ_succ', Nat.choose_one_right, add_comm]

lemma two_mul_choose_two_add (n : ℕ) : 2 * n.choose 2 + n = n * n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [choose_two_succ]
    nlinarith [ih]

end NatFacts

/-! ### The potential -/

section Potential

/-- `E(i, j) = C(i - j, 2) + j (2a - (i - j))`, the exponent of `x` in the potential. -/
def isoE (a i j : ℕ) : ℕ := (i - j).choose 2 + j * (2 * a - (i - j))

/-- `G(j) = ∏_{m < j} (1 - x^(r0 - m))`: the radical factor. -/
noncomputable def isoG (x : ℝ) (r0 j : ℕ) : ℝ := ∏ m ∈ range j, (1 - x ^ (r0 - m))

/-- `S(l) = ∏_{t < l} (1 - x^(2a - 2t))`: the symplectic factor. -/
noncomputable def isoS (x : ℝ) (a l : ℕ) : ℝ := ∏ t ∈ range l, (1 - x ^ (2 * a - 2 * t))

/-- The Gaussian binomial in `x`, by the `q`-Pascal rule
`B(i+1, j+1) = B(i, j) + x^(j+1) B(i, j+1)`. -/
noncomputable def qBinom (x : ℝ) : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | _ + 1, 0 => 1
  | i + 1, j + 1 => qBinom x i j + x ^ (j + 1) * qBinom x i (j + 1)

/-- The potential `P(i, j) = x^E(i,j) G(j) S(i-j) B(i,j)`. -/
noncomputable def isoP (x : ℝ) (a r0 i j : ℕ) : ℝ :=
  x ^ isoE a i j * isoG x r0 j * isoS x a (i - j) * qBinom x i j

/-- `π_j(q) = ∏_{m < j} (1 - x^(m+1))`. -/
noncomputable def piQ (x : ℝ) (j : ℕ) : ℝ := ∏ m ∈ range j, (1 - x ^ (m + 1))

/-- `Q(h) = ∏_{t < h} (1 - x^(R - t)) = x^(hR) ∏_{t<h} (q^R - q^t)`. -/
noncomputable def isoQ (x : ℝ) (R h : ℕ) : ℝ := ∏ t ∈ range h, (1 - x ^ (R - t))

/-- `κ_h(a) = C(h, 2) - C(h - a_h, 2)` with `a_h = min(a, h - 1)`; this is `a_h(2h - a_h - 1)/2`,
eq. (94). -/
def kappaH (h a : ℕ) : ℕ := h.choose 2 - (h - min a (h - 1)).choose 2

variable {x : ℝ}

lemma one_sub_pow_nonneg (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (n : ℕ) : 0 ≤ 1 - x ^ n :=
  sub_nonneg.2 (pow_le_one₀ hx0 hx1)

lemma one_sub_pow_le_one (hx0 : 0 ≤ x) (n : ℕ) : 1 - x ^ n ≤ 1 :=
  sub_le_self _ (pow_nonneg hx0 n)

lemma isoG_nonneg (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (r0 j : ℕ) : 0 ≤ isoG x r0 j :=
  Finset.prod_nonneg fun _ _ => one_sub_pow_nonneg hx0 hx1 _

lemma isoG_le_one (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (r0 j : ℕ) : isoG x r0 j ≤ 1 :=
  Finset.prod_le_one (fun _ _ => one_sub_pow_nonneg hx0 hx1 _) (fun _ _ => one_sub_pow_le_one hx0 _)

lemma isoS_nonneg (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (a l : ℕ) : 0 ≤ isoS x a l :=
  Finset.prod_nonneg fun _ _ => one_sub_pow_nonneg hx0 hx1 _

lemma isoS_le_one (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (a l : ℕ) : isoS x a l ≤ 1 :=
  Finset.prod_le_one (fun _ _ => one_sub_pow_nonneg hx0 hx1 _) (fun _ _ => one_sub_pow_le_one hx0 _)

lemma piQ_nonneg (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (j : ℕ) : 0 ≤ piQ x j :=
  Finset.prod_nonneg fun _ _ => one_sub_pow_nonneg hx0 hx1 _

lemma isoQ_nonneg (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (R h : ℕ) : 0 ≤ isoQ x R h :=
  Finset.prod_nonneg fun _ _ => one_sub_pow_nonneg hx0 hx1 _

lemma isoG_eq_zero {r0 j : ℕ} (h : r0 < j) : isoG x r0 j = 0 :=
  Finset.prod_eq_zero (Finset.mem_range.2 h) (by simp)

lemma isoS_eq_zero {a l : ℕ} (h : a < l) : isoS x a l = 0 :=
  Finset.prod_eq_zero (Finset.mem_range.2 h) (by simp)

/-- `G(j) ≤ 1 - x^r0` for `j ≥ 1`. -/
lemma isoG_le_first (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (r0 n : ℕ) :
    isoG x r0 (n + 1) ≤ 1 - x ^ r0 := by
  unfold isoG
  rw [Finset.prod_range_succ', Nat.sub_zero]
  exact mul_le_of_le_one_left (one_sub_pow_nonneg hx0 hx1 _)
    (Finset.prod_le_one (fun _ _ => one_sub_pow_nonneg hx0 hx1 _)
      (fun _ _ => one_sub_pow_le_one hx0 _))

/-- `S(n+1) ≤ 1 - x^(2a - 2n)`. -/
lemma isoS_le_last (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (a n : ℕ) :
    isoS x a (n + 1) ≤ 1 - x ^ (2 * a - 2 * n) := by
  unfold isoS
  rw [Finset.prod_range_succ]
  exact mul_le_of_le_one_left (one_sub_pow_nonneg hx0 hx1 _)
    (Finset.prod_le_one (fun _ _ => one_sub_pow_nonneg hx0 hx1 _)
      (fun _ _ => one_sub_pow_le_one hx0 _))

lemma qBinom_zero_right (x : ℝ) : ∀ i, qBinom x i 0 = 1
  | 0 => rfl
  | _ + 1 => rfl

lemma qBinom_succ_succ (x : ℝ) (i j : ℕ) :
    qBinom x (i + 1) (j + 1) = qBinom x i j + x ^ (j + 1) * qBinom x i (j + 1) := rfl

lemma qBinom_eq_zero (x : ℝ) : ∀ i j, i < j → qBinom x i j = 0
  | 0, 0, h => absurd h (lt_irrefl 0)
  | 0, _ + 1, _ => rfl
  | _ + 1, 0, h => absurd h (Nat.not_lt_zero _)
  | i + 1, j + 1, h => by
    rw [qBinom_succ_succ, qBinom_eq_zero x i j (by omega), qBinom_eq_zero x i (j + 1) (by omega)]
    ring

lemma qBinom_nonneg (hx0 : 0 ≤ x) : ∀ i j, 0 ≤ qBinom x i j
  | 0, 0 => by rw [qBinom_zero_right]; exact zero_le_one
  | 0, _ + 1 => le_refl (0 : ℝ)
  | _ + 1, 0 => by rw [qBinom_zero_right]; exact zero_le_one
  | i + 1, j + 1 => by
    rw [qBinom_succ_succ]
    exact add_nonneg (qBinom_nonneg hx0 i j)
      (mul_nonneg (pow_nonneg hx0 _) (qBinom_nonneg hx0 i (j + 1)))

/-- `B(i, j) π_j ≤ 1`, i.e. the Gaussian binomial is at most `1/π_j`. -/
lemma qBinom_mul_piQ_le (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : ∀ i j, qBinom x i j * piQ x j ≤ 1
  | 0, 0 => by simp [qBinom_zero_right, piQ]
  | 0, j + 1 => by
    rw [show qBinom x 0 (j + 1) = 0 from rfl, zero_mul]
    exact zero_le_one
  | i + 1, 0 => by simp [qBinom_zero_right, piQ]
  | i + 1, j + 1 => by
    have h1 := qBinom_mul_piQ_le hx0 hx1 i j
    have h2 := qBinom_mul_piQ_le hx0 hx1 i (j + 1)
    have hp : piQ x (j + 1) = piQ x j * (1 - x ^ (j + 1)) := Finset.prod_range_succ _ _
    have hy0 : 0 ≤ x ^ (j + 1) := pow_nonneg hx0 _
    have hy1 : 0 ≤ 1 - x ^ (j + 1) := one_sub_pow_nonneg hx0 hx1 _
    rw [qBinom_succ_succ]
    calc (qBinom x i j + x ^ (j + 1) * qBinom x i (j + 1)) * piQ x (j + 1)
        = (qBinom x i j * piQ x j) * (1 - x ^ (j + 1)) +
            x ^ (j + 1) * (qBinom x i (j + 1) * piQ x (j + 1)) := by rw [hp]; ring
      _ ≤ 1 * (1 - x ^ (j + 1)) + x ^ (j + 1) * 1 :=
          add_le_add (mul_le_mul_of_nonneg_right h1 hy1) (mul_le_mul_of_nonneg_left h2 hy0)
      _ = 1 := by ring

lemma piQ_one (x : ℝ) : piQ x 1 = 1 - x := by simp [piQ]

lemma piQ_two (x : ℝ) : piQ x 2 = (1 - x) * (1 - x ^ 2) := by
  simp [piQ, Finset.prod_range_succ]

lemma piQ_succ_ge (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : ∀ n, 1 - x - x ^ 2 + x ^ (n + 2) ≤ piQ x (n + 1)
  | 0 => by
    simp only [zero_add]
    rw [piQ_one]
    linarith
  | n + 1 => by
    have ih := piQ_succ_ge hx0 hx1 n
    have hp : piQ x (n + 1 + 1) = piQ x (n + 1) * (1 - x ^ (n + 2)) := Finset.prod_range_succ _ _
    rw [hp]
    have hy0 : 0 ≤ x ^ (n + 2) := pow_nonneg hx0 _
    have hyx : x ^ (n + 2) ≤ x ^ 2 := pow_le_pow_of_le_one hx0 hx1 (by omega)
    have h1y : 0 ≤ 1 - x ^ (n + 2) := one_sub_pow_nonneg hx0 hx1 _
    have e3 : x ^ (n + 1 + 2) = x * x ^ (n + 2) := by
      rw [show n + 1 + 2 = (n + 2) + 1 by omega, pow_succ]; ring
    rw [e3]
    nlinarith [mul_nonneg (sub_nonneg.2 ih) h1y, mul_nonneg hy0 (sub_nonneg.2 hyx)]

lemma piQ_ge_quarter (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) (j : ℕ) : 1 / 4 ≤ piQ x j := by
  have hx1 : x ≤ 1 := by linarith
  rcases j with _ | n
  · simp only [piQ, Finset.range_zero, Finset.prod_empty]; norm_num
  · have h := piQ_succ_ge hx0 hx1 n
    have := pow_nonneg hx0 (n + 2)
    nlinarith

lemma qBinom_le_four (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) (i j : ℕ) : qBinom x i j ≤ 4 := by
  have hx1 : x ≤ 1 := by linarith
  have h1 := qBinom_mul_piQ_le hx0 hx1 i j
  have h2 := piQ_ge_quarter hx0 hx12 j
  have h3 := qBinom_nonneg hx0 i j
  nlinarith [mul_nonneg h3 (sub_nonneg.2 h2)]

lemma qBinom_one_le (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) (i : ℕ) :
    qBinom x i 1 * (1 - x) ≤ 1 := by
  have hx1 : x ≤ 1 := by linarith
  have h1 := qBinom_mul_piQ_le hx0 hx1 i 1
  rwa [piQ_one] at h1

lemma qBinom_two_le (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) (i : ℕ) : qBinom x i 2 ≤ 8 / 3 := by
  have hx1 : x ≤ 1 := by linarith
  have h1 := qBinom_mul_piQ_le hx0 hx1 i 2
  rw [piQ_two] at h1
  have h3 := qBinom_nonneg hx0 i 2
  have hq : 0 ≤ (1 / 2 - x) * (5 / 4 + x / 2 - x ^ 2) :=
    mul_nonneg (by linarith) (by nlinarith)
  have hp : 3 / 8 ≤ (1 - x) * (1 - x ^ 2) := by nlinarith
  nlinarith [mul_nonneg h3 (sub_nonneg.2 hp)]

/-- `Q(h) ≥ 1 - x^(R - h)` for `x ≤ 1/2`. -/
lemma isoQ_ge (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) {R : ℕ} :
    ∀ h, h ≤ R → 1 - x ^ (R - h) ≤ isoQ x R h
  | 0, _ => by
    simp only [isoQ, Finset.range_zero, Finset.prod_empty]
    linarith [pow_nonneg hx0 (R - 0)]
  | h + 1, hh => by
    have ih := isoQ_ge (R := R) hx0 hx12 h (by omega)
    have hp : isoQ x R (h + 1) = isoQ x R h * (1 - x ^ (R - h)) := Finset.prod_range_succ _ _
    rw [hp]
    have e : R - h = (R - (h + 1)) + 1 := by omega
    rw [e, pow_succ] at ih ⊢
    have hy0 : 0 ≤ x ^ (R - (h + 1)) := pow_nonneg hx0 _
    have hy1 : x ^ (R - (h + 1)) ≤ 1 := pow_le_one₀ hx0 (by linarith)
    have h1yx : 0 ≤ 1 - x ^ (R - (h + 1)) * x := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_right ih h1yx, mul_nonneg hy0 (by linarith : (0 : ℝ) ≤ 1 - 2 * x),
      sq_nonneg (x ^ (R - (h + 1)) * x)]

/-- `Q(h) ≥ π_h` for `h ≤ R`. -/
lemma piQ_le_isoQ (hx0 : 0 ≤ x) (hx1 : x ≤ 1) {R h : ℕ} (hh : h ≤ R) : piQ x h ≤ isoQ x R h := by
  calc piQ x h = ∏ t ∈ range h, (1 - x ^ ((h - 1 - t) + 1)) := by
        unfold piQ
        exact (Finset.prod_range_reflect (fun m => 1 - x ^ (m + 1)) h).symm
    _ ≤ isoQ x R h := by
        refine Finset.prod_le_prod (fun t _ => one_sub_pow_nonneg hx0 hx1 _) (fun t ht => ?_)
        have := Finset.mem_range.1 ht
        exact sub_le_sub_left (pow_le_pow_of_le_one hx0 hx1 (by omega : h - 1 - t + 1 ≤ R - t)) 1

lemma isoQ_pos (hx0 : 0 ≤ x) (hx1 : x < 1) {R h : ℕ} (hh : h ≤ R) : 0 < isoQ x R h :=
  Finset.prod_pos fun t ht => by
    have := Finset.mem_range.1 ht
    exact sub_pos.2 (pow_lt_one₀ hx0 hx1 (by omega))

lemma isoP_nonneg (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (a r0 i j : ℕ) : 0 ≤ isoP x a r0 i j := by
  unfold isoP
  exact mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hx0 _) (isoG_nonneg hx0 hx1 _ _))
    (isoS_nonneg hx0 hx1 _ _)) (qBinom_nonneg hx0 _ _)

/-- Generic upper bound for the potential, factor by factor. -/
lemma isoP_le_of (hx0 : 0 ≤ x) (hx1 : x ≤ 1) {a r0 i j e : ℕ} {g s b : ℝ}
    (he : e ≤ isoE a i j) (hg : isoG x r0 j ≤ g) (hs : isoS x a (i - j) ≤ s)
    (hb : qBinom x i j ≤ b) : isoP x a r0 i j ≤ x ^ e * g * s * b := by
  unfold isoP
  have g0 := isoG_nonneg hx0 hx1 r0 j
  have s0 := isoS_nonneg hx0 hx1 a (i - j)
  have b0 := qBinom_nonneg hx0 i j
  have hE : x ^ isoE a i j ≤ x ^ e := pow_le_pow_of_le_one hx0 hx1 he
  have e0 : 0 ≤ x ^ isoE a i j := pow_nonneg hx0 _
  have e0' : 0 ≤ x ^ e := pow_nonneg hx0 _
  apply mul_le_mul _ hb b0 (mul_nonneg (mul_nonneg e0' (g0.trans hg)) (s0.trans hs))
  apply mul_le_mul _ hs s0 (mul_nonneg e0' (g0.trans hg))
  exact mul_le_mul hE hg g0 e0'

lemma isoP_succ_succ (x : ℝ) (a r0 i j : ℕ) :
    isoP x a r0 (i + 1) (j + 1) =
      x ^ isoE a (i + 1) (j + 1) * isoG x r0 (j + 1) * isoS x a (i - j) * qBinom x i j +
      x ^ isoE a (i + 1) (j + 1) * isoG x r0 (j + 1) * isoS x a (i - j) *
        (x ^ (j + 1) * qBinom x i (j + 1)) := by
  unfold isoP
  rw [show i + 1 - (j + 1) = i - j by omega, qBinom_succ_succ]
  ring

end Potential

/-! ### The potential is a solution of the normalised recursion -/

section Steps

variable {x : ℝ} {qN : ℕ}

/-- The fiber sizes of the recursion: `q^(i+r0-j) - q^i` (append a vector of `(S+K) \ S`). -/
def isoC1 (q r0 i j : ℕ) : ℕ := q ^ (i + r0 - j) - q ^ i

/-- `q^(R+j-i) - q^(i+r0-j)` (append a vector of `S^⊥ \ (S+K)`). -/
def isoC2 (q R r0 i j : ℕ) : ℕ := q ^ (R + j - i) - q ^ (i + r0 - j)

lemma xq_pow (hxq : x * (qN : ℝ) = 1) {n m : ℕ} (h : m ≤ n) :
    x ^ n * (qN : ℝ) ^ m = x ^ (n - m) := by
  have e : x ^ n = x ^ (n - m) * x ^ m := by rw [← pow_add, Nat.sub_add_cancel h]
  rw [e, mul_assoc, ← mul_pow, hxq, one_pow, mul_one]

lemma cast_pow_sub (hq : 0 < qN) {m n : ℕ} (h : m ≤ n) :
    ((qN ^ n - qN ^ m : ℕ) : ℝ) = (qN : ℝ) ^ n - (qN : ℝ) ^ m := by
  rw [Nat.cast_sub (Nat.pow_le_pow_right hq h), Nat.cast_pow, Nat.cast_pow]

lemma isoP_stay0 (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (hxq : x * (qN : ℝ) = 1) (hq : 0 < qN)
    {a r0 R : ℕ} (hR : r0 + 2 * a = R) (i : ℕ) :
    isoP x a r0 i 0 * (x ^ R * (isoC2 qN R r0 i 0 : ℝ)) ≤ isoP x a r0 (i + 1) 0 := by
  by_cases hi : i ≤ a
  · apply le_of_eq
    unfold isoC2
    rw [cast_pow_sub hq (by omega : i + r0 - 0 ≤ R + 0 - i), mul_sub,
      xq_pow hxq (by omega : R + 0 - i ≤ R), xq_pow hxq (by omega : i + r0 - 0 ≤ R)]
    have e1 : R - (R + 0 - i) = i := by omega
    have e2 : R - (i + r0 - 0) = i + (2 * a - 2 * i) := by omega
    rw [e1, e2, pow_add x i (2 * a - 2 * i)]
    have hS : isoS x a (i + 1) = isoS x a i * (1 - x ^ (2 * a - 2 * i)) :=
      Finset.prod_range_succ _ _
    have hE0 : ∀ n, isoE a n 0 = n.choose 2 := fun n => by simp [isoE]
    have hG0 : isoG x r0 0 = 1 := by simp [isoG]
    unfold isoP
    rw [hE0, hE0, hG0, Nat.sub_zero, Nat.sub_zero, qBinom_zero_right, qBinom_zero_right, hS,
      choose_two_succ, pow_add]
    ring
  · push_neg at hi
    have h0 : isoP x a r0 i 0 = 0 := by
      unfold isoP
      rw [Nat.sub_zero, isoS_eq_zero hi]
      ring
    rw [h0, zero_mul]
    exact isoP_nonneg hx0 hx1 _ _ _ _

lemma isoP_inc (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (hxq : x * (qN : ℝ) = 1) (hq : 0 < qN)
    {a r0 R : ℕ} (hR : r0 + 2 * a = R) (i j : ℕ) :
    isoP x a r0 i j * (x ^ R * (isoC1 qN r0 i j : ℝ)) ≤
      x ^ isoE a (i + 1) (j + 1) * isoG x r0 (j + 1) * isoS x a (i - j) * qBinom x i j := by
  by_cases hf : j ≤ r0 ∧ j ≤ i ∧ i - j ≤ a
  · obtain ⟨h1, h2, h3⟩ := hf
    apply le_of_eq
    unfold isoC1
    rw [cast_pow_sub hq (by omega : i ≤ i + r0 - j), mul_sub,
      xq_pow hxq (by omega : i + r0 - j ≤ R), xq_pow hxq (by omega : i ≤ R)]
    have e1 : R - (i + r0 - j) = 2 * a - (i - j) := by omega
    have e2 : R - i = (2 * a - (i - j)) + (r0 - j) := by omega
    have eE : isoE a (i + 1) (j + 1) = isoE a i j + (2 * a - (i - j)) := by
      unfold isoE
      rw [show i + 1 - (j + 1) = i - j by omega]
      ring
    have eG : isoG x r0 (j + 1) = isoG x r0 j * (1 - x ^ (r0 - j)) := Finset.prod_range_succ _ _
    rw [e1, e2, eE, eG, pow_add x (2 * a - (i - j)) (r0 - j),
      pow_add x (isoE a i j) (2 * a - (i - j))]
    unfold isoP
    ring
  · push_neg at hf
    have h0 : isoP x a r0 i j = 0 := by
      unfold isoP
      by_cases h1 : j ≤ r0
      · by_cases h2 : j ≤ i
        · rw [isoS_eq_zero (hf h1 h2)]; ring
        · rw [qBinom_eq_zero x i j (by omega)]; ring
      · rw [isoG_eq_zero (by omega : r0 < j)]; ring
    rw [h0, zero_mul]
    exact mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hx0 _) (isoG_nonneg hx0 hx1 _ _))
      (isoS_nonneg hx0 hx1 _ _)) (qBinom_nonneg hx0 _ _)

lemma isoP_stay (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (hxq : x * (qN : ℝ) = 1) (hq : 0 < qN)
    {a r0 R : ℕ} (hR : r0 + 2 * a = R) (i j : ℕ) :
    isoP x a r0 i (j + 1) * (x ^ R * (isoC2 qN R r0 i (j + 1) : ℝ)) ≤
      x ^ isoE a (i + 1) (j + 1) * isoG x r0 (j + 1) * isoS x a (i - j) *
        (x ^ (j + 1) * qBinom x i (j + 1)) := by
  by_cases hf : j + 1 ≤ i ∧ i - (j + 1) ≤ a
  · obtain ⟨hji, hla⟩ := hf
    obtain ⟨l, rfl⟩ : ∃ l, i = l + (j + 1) := ⟨i - (j + 1), by omega⟩
    have el : l + (j + 1) - (j + 1) = l := by omega
    have el1 : l + (j + 1) - j = l + 1 := by omega
    rw [el] at hla
    apply le_of_eq
    unfold isoC2
    rw [cast_pow_sub hq (by omega : l + (j + 1) + r0 - (j + 1) ≤ R + (j + 1) - (l + (j + 1))),
      mul_sub, xq_pow hxq (by omega : R + (j + 1) - (l + (j + 1)) ≤ R),
      xq_pow hxq (by omega : l + (j + 1) + r0 - (j + 1) ≤ R)]
    have e1 : R - (R + (j + 1) - (l + (j + 1))) = l := by omega
    have e2 : R - (l + (j + 1) + r0 - (j + 1)) = l + (2 * a - 2 * l) := by omega
    rw [e1, e2, pow_add x l (2 * a - 2 * l), el1]
    have hS : isoS x a (l + 1) = isoS x a l * (1 - x ^ (2 * a - 2 * l)) :=
      Finset.prod_range_succ _ _
    rw [hS]
    unfold isoP
    rw [el]
    rcases Nat.lt_or_ge l a with hl | hl
    · have eE : isoE a (l + (j + 1)) (j + 1) + l = isoE a (l + (j + 1) + 1) (j + 1) + (j + 1) := by
        unfold isoE
        rw [el, show l + (j + 1) + 1 - (j + 1) = l + 1 by omega,
          show 2 * a - l = (2 * a - (l + 1)) + 1 by omega, choose_two_succ]
        ring
      have hpw : x ^ isoE a (l + (j + 1)) (j + 1) * x ^ l =
          x ^ isoE a (l + (j + 1) + 1) (j + 1) * x ^ (j + 1) := by
        rw [← pow_add, ← pow_add, eE]
      linear_combination (isoG x r0 (j + 1) * isoS x a l * qBinom x (l + (j + 1)) (j + 1) *
        (1 - x ^ (2 * a - 2 * l))) * hpw
    · rw [show 2 * a - 2 * l = 0 by omega, pow_zero]
      ring
  · push_neg at hf
    have h0 : isoP x a r0 i (j + 1) = 0 := by
      unfold isoP
      by_cases h2 : j + 1 ≤ i
      · rw [isoS_eq_zero (hf h2)]; ring
      · rw [qBinom_eq_zero x i (j + 1) (by omega)]; ring
    rw [h0, zero_mul]
    exact mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hx0 _) (isoG_nonneg hx0 hx1 _ _))
      (isoS_nonneg hx0 hx1 _ _)) (mul_nonneg (pow_nonneg hx0 _) (qBinom_nonneg hx0 _ _))

end Steps

/-! ### Counting isotropic tuples -/

section Count

open Classical

variable {F : Type*} [Field F] [Fintype F] {R : ℕ}

/-- Pairwise `A`-orthogonality of a tuple. -/
def PairOrth (A : Matrix (Fin R) (Fin R) F) {i : ℕ} (v : Fin i → (Fin R → F)) : Prop :=
  ∀ s t, bfL (v s) (v t) A = 0

/-- `v` is a linearly independent, pairwise orthogonal `i`-tuple whose span meets `rad A` in
dimension `j`. -/
def IsoTup (A : Matrix (Fin R) (Fin R) F) (i j : ℕ) (v : Fin i → (Fin R → F)) : Prop :=
  LinearIndependent F v ∧ PairOrth A v ∧
    finrank F (Submodule.span F (Set.range v) ⊓ rad A : Submodule F (Fin R → F)) = j

/-- `N(i, j)`: the number of such tuples. -/
noncomputable def isoTupCount (A : Matrix (Fin R) (Fin R) F) (i j : ℕ) : ℕ :=
  (univ.filter (fun v : Fin i → (Fin R → F) => IsoTup A i j v)).card

lemma IsoTup_unique {A : Matrix (Fin R) (Fin R) F} {i j j' : ℕ} {u : Fin i → (Fin R → F)}
    (h1 : IsoTup A i j u) (h2 : IsoTup A i j' u) : j = j' :=
  h1.2.2.symm.trans h2.2.2

lemma card_filter_mem (P : Submodule F (Fin R → F)) :
    (univ.filter (fun y : Fin R → F => y ∈ P)).card = Fintype.card F ^ finrank F P := by
  rw [← Fintype.card_subtype]
  convert Module.card_eq_pow_finrank (K := F) (V := P)

lemma finrank_span_sup {P : Submodule F (Fin R → F)} {y : Fin R → F} (hy : y ∉ P) :
    finrank F ↥(Submodule.span F {y} ⊔ P) = finrank F P + 1 := by
  have hy0 : y ≠ 0 := fun h => hy (h ▸ P.zero_mem)
  have hinf : Submodule.span F {y} ⊓ P = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    obtain ⟨hz1, hz2⟩ := Submodule.mem_inf.1 hz
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hz1
    by_cases hc : c = 0
    · simp [hc]
    · exfalso
      apply hy
      have := P.smul_mem c⁻¹ hz2
      rwa [smul_smul, inv_mul_cancel₀ hc, one_smul] at this
  have := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span F {y}) P
  rw [hinf, finrank_bot, finrank_span_singleton hy0] at this
  omega

lemma finrank_orth (A : Matrix (Fin R) (Fin R) F) (S : Submodule F (Fin R → F)) :
    finrank F S + finrank F ((Matrix.toBilin' A).orthogonal S) =
      R + finrank F (S ⊓ rad A : Submodule F (Fin R → F)) := by
  have := LinearMap.BilinForm.finrank_add_finrank_orthogonal' (B := Matrix.toBilin' A) S
  rwa [Module.finrank_fin_fun] at this

lemma mem_orth_of_forall {A : Matrix (Fin R) (Fin R) F} {i : ℕ} {u : Fin i → (Fin R → F)}
    {y : Fin R → F} (hy : ∀ s, bfL (u s) y A = 0) :
    y ∈ (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u)) := by
  have hle : Submodule.span F (Set.range u) ≤ LinearMap.ker ((Matrix.toBilin' A).flip y) := by
    rw [Submodule.span_le]
    rintro _ ⟨s, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker]
    show Matrix.toBilin' A (u s) y = 0
    rw [Matrix.toBilin'_apply', ← bfL_apply]
    exact hy s
  rw [LinearMap.BilinForm.mem_orthogonal_iff]
  intro n hn
  have := hle hn
  rw [LinearMap.mem_ker] at this
  exact this

lemma isotropic_span {A : Matrix (Fin R) (Fin R) F} {i : ℕ} {v : Fin i → (Fin R → F)}
    (hv : PairOrth A v) : Isotropic A (Submodule.span F (Set.range v)) := by
  have hle : Submodule.span F (Set.range v) ≤
      (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range v)) :=
    Submodule.span_le.2 (Set.range_subset_iff.2 fun t => mem_orth_of_forall fun s => hv s t)
  intro y hy z hz
  have := (LinearMap.BilinForm.mem_orthogonal_iff.1 (hle hz)) y hy
  rw [Matrix.toBilin'_apply'] at this
  rw [bfL_apply]
  exact this

lemma span_cons {i : ℕ} (y : Fin R → F) (u : Fin i → (Fin R → F)) :
    Submodule.span F (Set.range (Fin.cons y u : Fin (i + 1) → (Fin R → F))) =
      Submodule.span F {y} ⊔ Submodule.span F (Set.range u) := by
  rw [Fin.range_cons, Submodule.span_insert]

/-- Analysis of a one-vector extension `cons y u` of an isotropic tuple. -/
lemma cons_iso {A : Matrix (Fin R) (Fin R) F} (_hA : IsAltMat A) {r0 : ℕ}
    (hr : finrank F (rad A) = r0) {i J : ℕ} {u : Fin i → (Fin R → F)} {y : Fin R → F}
    (h : IsoTup A (i + 1) J (Fin.cons y u)) :
    LinearIndependent F u ∧ PairOrth A u ∧ y ∉ Submodule.span F (Set.range u) ∧
      y ∈ (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u)) ∧
      (y ∈ Submodule.span F (Set.range u) ⊔ rad A →
        J = finrank F (Submodule.span F (Set.range u) ⊓ rad A : Submodule F (Fin R → F)) + 1) ∧
      (y ∉ Submodule.span F (Set.range u) ⊔ rad A →
        J = finrank F (Submodule.span F (Set.range u) ⊓ rad A : Submodule F (Fin R → F))) := by
  obtain ⟨hli, hpo, hJ⟩ := h
  have hli' := hli
  rw [linearIndependent_finCons] at hli'
  obtain ⟨hu, hy⟩ := hli'
  have hpu : PairOrth A u := fun s t => by
    have := hpo s.succ t.succ
    rwa [Fin.cons_succ, Fin.cons_succ] at this
  have hyO : y ∈ (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u)) :=
    mem_orth_of_forall fun s => by
      have := hpo s.succ 0
      rwa [Fin.cons_succ, Fin.cons_zero] at this
  have hS : finrank F (Submodule.span F (Set.range u)) = i := by
    rw [finrank_span_eq_card hu, Fintype.card_fin]
  have hS' : finrank F (Submodule.span F (Set.range (Fin.cons y u : Fin (i + 1) → (Fin R → F))))
      = i + 1 := by
    rw [finrank_span_eq_card hli, Fintype.card_fin]
  rw [span_cons] at hS' hJ
  have e1 := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span F (Set.range u)) (rad A)
  have e2 := Submodule.finrank_sup_add_finrank_inf_eq
    (Submodule.span F {y} ⊔ Submodule.span F (Set.range u)) (rad A)
  rw [hS'] at e2
  rw [hS] at e1
  refine ⟨hu, hpu, hy, hyO, fun hyK => ?_, fun hyK => ?_⟩
  · have hsup : Submodule.span F {y} ⊔ Submodule.span F (Set.range u) ⊔ rad A =
        Submodule.span F (Set.range u) ⊔ rad A := by
      apply le_antisymm
      · exact sup_le (sup_le ((Submodule.span_singleton_le_iff_mem _ _).2 hyK) le_sup_left)
          le_sup_right
      · exact sup_le_sup_right le_sup_right _
    rw [hsup] at e2
    omega
  · have hsup : finrank F ↥(Submodule.span F {y} ⊔ Submodule.span F (Set.range u) ⊔ rad A) =
        finrank F ↥(Submodule.span F (Set.range u) ⊔ rad A) + 1 := by
      rw [sup_assoc]
      exact finrank_span_sup hyK
    rw [hsup] at e2
    omega

/-- The isotropic subspace `S + K` lies in `S^⊥`. -/
lemma sup_rad_le_orth {A : Matrix (Fin R) (Fin R) F} (hA : IsAltMat A) {i : ℕ}
    {u : Fin i → (Fin R → F)} (hpu : PairOrth A u) :
    Submodule.span F (Set.range u) ⊔ rad A ≤
      (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u)) := by
  apply sup_le
  · exact Submodule.span_le.2 (Set.range_subset_iff.2 fun t => mem_orth_of_forall fun s => hpu s t)
  · intro k hk
    exact mem_orth_of_forall fun s => bfL_rad_right hA hk (u s)

variable {A : Matrix (Fin R) (Fin R) F}

lemma card_ext_inc (hA : IsAltMat A) {r0 : ℕ} (hr : finrank F (rad A) = r0) {i j : ℕ}
    {u : Fin i → (Fin R → F)} (hj : IsoTup A i j u) :
    (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) (j + 1) (Fin.cons y u))).card ≤
      isoC1 (Fintype.card F) r0 i j := by
  have hsub : univ.filter (fun y : Fin R → F => IsoTup A (i + 1) (j + 1) (Fin.cons y u)) ⊆
      univ.filter (fun y => y ∈ Submodule.span F (Set.range u) ⊔ rad A) \
        univ.filter (fun y => y ∈ Submodule.span F (Set.range u)) := by
    intro y hy
    rw [Finset.mem_filter] at hy
    obtain ⟨_, _, hyS, _, _, hout⟩ := cons_iso hA hr hy.2
    rw [Finset.mem_sdiff, Finset.mem_filter, Finset.mem_filter]
    refine ⟨⟨Finset.mem_univ _, ?_⟩, fun h => hyS h.2⟩
    by_contra hyK
    have := hout hyK
    have := hj.2.2
    omega
  have hsub2 : univ.filter (fun y : Fin R → F => y ∈ Submodule.span F (Set.range u)) ⊆
      univ.filter (fun y => y ∈ Submodule.span F (Set.range u) ⊔ rad A) := by
    intro y hy
    rw [Finset.mem_filter] at hy ⊢
    exact ⟨hy.1, Submodule.mem_sup_left hy.2⟩
  have hdim : finrank F ↥(Submodule.span F (Set.range u) ⊔ rad A) = i + r0 - j := by
    have e1 := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span F (Set.range u)) (rad A)
    rw [finrank_span_eq_card hj.1, Fintype.card_fin, hr, hj.2.2] at e1
    omega
  calc _ ≤ _ := Finset.card_le_card hsub
    _ = _ := by
      rw [Finset.card_sdiff_of_subset hsub2, card_filter_mem, card_filter_mem, hdim,
        finrank_span_eq_card hj.1, Fintype.card_fin]
      rfl

lemma card_ext_stay (hA : IsAltMat A) {r0 : ℕ} (hr : finrank F (rad A) = r0) {i j : ℕ}
    {u : Fin i → (Fin R → F)} (hj : IsoTup A i j u) :
    (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) j (Fin.cons y u))).card ≤
      isoC2 (Fintype.card F) R r0 i j := by
  have hsub : univ.filter (fun y : Fin R → F => IsoTup A (i + 1) j (Fin.cons y u)) ⊆
      univ.filter (fun y => y ∈ (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u))) \
        univ.filter (fun y => y ∈ Submodule.span F (Set.range u) ⊔ rad A) := by
    intro y hy
    rw [Finset.mem_filter] at hy
    obtain ⟨_, _, _, hyO, hin, _⟩ := cons_iso hA hr hy.2
    rw [Finset.mem_sdiff, Finset.mem_filter, Finset.mem_filter]
    refine ⟨⟨Finset.mem_univ _, hyO⟩, fun h => ?_⟩
    have := hin h.2
    have := hj.2.2
    omega
  have hsub2 : univ.filter (fun y : Fin R → F => y ∈ Submodule.span F (Set.range u) ⊔ rad A) ⊆
      univ.filter (fun y => y ∈ (Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u))) := by
    intro y hy
    rw [Finset.mem_filter] at hy ⊢
    exact ⟨hy.1, sup_rad_le_orth hA hj.2.1 hy.2⟩
  have hdim : finrank F ↥(Submodule.span F (Set.range u) ⊔ rad A) = i + r0 - j := by
    have e1 := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span F (Set.range u)) (rad A)
    rw [finrank_span_eq_card hj.1, Fintype.card_fin, hr, hj.2.2] at e1
    omega
  have hdimO : finrank F ((Matrix.toBilin' A).orthogonal (Submodule.span F (Set.range u))) =
      R + j - i := by
    have e1 := finrank_orth A (Submodule.span F (Set.range u))
    rw [finrank_span_eq_card hj.1, Fintype.card_fin, hj.2.2] at e1
    omega
  calc _ ≤ _ := Finset.card_le_card hsub
    _ = _ := by
      rw [Finset.card_sdiff_of_subset hsub2, card_filter_mem, card_filter_mem, hdim, hdimO]
      rfl

lemma card_ext_other (hA : IsAltMat A) {r0 : ℕ} (hr : finrank F (rad A) = r0) {i j J : ℕ}
    {u : Fin i → (Fin R → F)} (hj : IsoTup A i j u) (h1 : J ≠ j) (h2 : J ≠ j + 1) :
    (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) J (Fin.cons y u))).card = 0 := by
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro y _ hy
  obtain ⟨_, _, _, _, hin, hout⟩ := cons_iso hA hr hy
  have := hj.2.2
  by_cases hyK : y ∈ Submodule.span F (Set.range u) ⊔ rad A
  · have := hin hyK; omega
  · have := hout hyK; omega

lemma card_ext_zero (hA : IsAltMat A) {r0 : ℕ} (hr : finrank F (rad A) = r0) {i J : ℕ}
    {u : Fin i → (Fin R → F)} (hu : ∀ j, ¬ IsoTup A i j u) :
    (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) J (Fin.cons y u))).card = 0 := by
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro y _ hy
  obtain ⟨hli, hpo, _⟩ := cons_iso hA hr hy
  exact hu _ ⟨hli, hpo, rfl⟩

lemma isoTupCount_succ_eq_sum (A : Matrix (Fin R) (Fin R) F) (i J : ℕ) :
    isoTupCount A (i + 1) J = ∑ u : Fin i → (Fin R → F),
      (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) J (Fin.cons y u))).card := by
  unfold isoTupCount
  rw [Finset.card_filter, ← (Fin.consEquiv fun _ : Fin (i + 1) => (Fin R → F)).sum_comp,
    Fintype.sum_prod_type_right]
  refine Finset.sum_congr rfl (fun u _ => ?_)
  rw [Finset.card_filter]
  rfl

/-- The recursion, `j + 1` case. -/
theorem isoTupCount_succ_le (hA : IsAltMat A) {r0 : ℕ} (hr : finrank F (rad A) = r0) (i j : ℕ) :
    isoTupCount A (i + 1) (j + 1) ≤ isoTupCount A i j * isoC1 (Fintype.card F) r0 i j +
      isoTupCount A i (j + 1) * isoC2 (Fintype.card F) R r0 i (j + 1) := by
  rw [isoTupCount_succ_eq_sum]
  have key : ∀ u : Fin i → (Fin R → F),
      (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) (j + 1) (Fin.cons y u))).card ≤
        (if IsoTup A i j u then isoC1 (Fintype.card F) r0 i j else 0) +
        (if IsoTup A i (j + 1) u then isoC2 (Fintype.card F) R r0 i (j + 1) else 0) := by
    intro u
    by_cases h1 : IsoTup A i j u
    · rw [if_pos h1]
      exact (card_ext_inc hA hr h1).trans (Nat.le_add_right _ _)
    · by_cases h2 : IsoTup A i (j + 1) u
      · rw [if_neg h1, if_pos h2, zero_add]
        exact card_ext_stay hA hr h2
      · rw [if_neg h1, if_neg h2, add_zero, Nat.le_zero]
        by_cases hu : ∃ j', IsoTup A i j' u
        · obtain ⟨j', hj'⟩ := hu
          apply card_ext_other hA hr hj'
          · intro h
            exact h2 (by rw [h]; exact hj')
          · intro h
            exact h1 (by rw [show j = j' by omega]; exact hj')
        · push_neg at hu
          exact card_ext_zero hA hr hu
  calc _ ≤ ∑ u : Fin i → (Fin R → F),
        ((if IsoTup A i j u then isoC1 (Fintype.card F) r0 i j else 0) +
        (if IsoTup A i (j + 1) u then isoC2 (Fintype.card F) R r0 i (j + 1) else 0)) :=
        Finset.sum_le_sum (fun u _ => key u)
    _ = _ := by
      rw [Finset.sum_add_distrib, ← Finset.sum_filter, ← Finset.sum_filter, Finset.sum_const,
        Finset.sum_const, smul_eq_mul, smul_eq_mul]
      rfl

/-- The recursion, `j = 0` case. -/
theorem isoTupCount_succ_zero_le (hA : IsAltMat A) {r0 : ℕ} (hr : finrank F (rad A) = r0)
    (i : ℕ) :
    isoTupCount A (i + 1) 0 ≤ isoTupCount A i 0 * isoC2 (Fintype.card F) R r0 i 0 := by
  rw [isoTupCount_succ_eq_sum]
  have key : ∀ u : Fin i → (Fin R → F),
      (univ.filter (fun y : Fin R → F => IsoTup A (i + 1) 0 (Fin.cons y u))).card ≤
        (if IsoTup A i 0 u then isoC2 (Fintype.card F) R r0 i 0 else 0) := by
    intro u
    by_cases h1 : IsoTup A i 0 u
    · rw [if_pos h1]
      exact card_ext_stay hA hr h1
    · rw [if_neg h1, Nat.le_zero]
      by_cases hu : ∃ j', IsoTup A i j' u
      · obtain ⟨j', hj'⟩ := hu
        apply card_ext_other hA hr hj'
        · intro h
          exact h1 (by rw [h]; exact hj')
        · omega
      · push_neg at hu
        exact card_ext_zero hA hr hu
  calc _ ≤ ∑ u : Fin i → (Fin R → F),
        (if IsoTup A i 0 u then isoC2 (Fintype.card F) R r0 i 0 else 0) :=
        Finset.sum_le_sum (fun u _ => key u)
    _ = _ := by
      rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul]
      rfl

lemma isoTupCount_zero_le (A : Matrix (Fin R) (Fin R) F) : isoTupCount A 0 0 ≤ 1 := by
  unfold isoTupCount
  exact (Finset.card_le_univ _).trans (by simp)

lemma isoTupCount_eq_zero_of_lt (A : Matrix (Fin R) (Fin R) F) {i j : ℕ} (h : i < j) :
    isoTupCount A i j = 0 := by
  unfold isoTupCount
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro v _ hv
  have h1 : finrank F (Submodule.span F (Set.range v) ⊓ rad A : Submodule F (Fin R → F)) ≤
      finrank F (Submodule.span F (Set.range v)) := Submodule.finrank_mono inf_le_left
  rw [finrank_span_eq_card hv.1, Fintype.card_fin, hv.2.2] at h1
  omega

/-- The normalised count is bounded by the potential: `N(i, j) x^(iR) ≤ P(i, j)`. -/
theorem isoTupCount_le (hA : IsAltMat A) {a r0 : ℕ} (hr : finrank F (rad A) = r0)
    (hR : r0 + 2 * a = R) {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1)
    (hxq : x * (Fintype.card F : ℝ) = 1) :
    ∀ i j, (isoTupCount A i j : ℝ) * x ^ (i * R) ≤ isoP x a r0 i j := by
  have hq : 0 < Fintype.card F := Fintype.card_pos
  intro i
  induction i with
  | zero =>
    intro j
    rcases j with _ | j
    · have h1 : isoP x a r0 0 0 = 1 := by
        simp [isoP, isoE, isoG, isoS, qBinom_zero_right]
      rw [h1, zero_mul, pow_zero, mul_one]
      exact_mod_cast isoTupCount_zero_le A
    · rw [isoTupCount_eq_zero_of_lt A (by omega : 0 < j + 1), Nat.cast_zero, zero_mul]
      exact isoP_nonneg hx0 hx1 _ _ _ _
  | succ i ih =>
    intro j
    have hpow : x ^ ((i + 1) * R) = x ^ (i * R) * x ^ R := by
      rw [← pow_add, add_mul, one_mul]
    rcases j with _ | j
    · have hc := isoTupCount_succ_zero_le hA hr i
      calc (isoTupCount A (i + 1) 0 : ℝ) * x ^ ((i + 1) * R)
          ≤ ((isoTupCount A i 0 * isoC2 (Fintype.card F) R r0 i 0 : ℕ) : ℝ) *
              x ^ ((i + 1) * R) :=
            mul_le_mul_of_nonneg_right (by exact_mod_cast hc) (pow_nonneg hx0 _)
        _ = ((isoTupCount A i 0 : ℝ) * x ^ (i * R)) *
              (x ^ R * (isoC2 (Fintype.card F) R r0 i 0 : ℝ)) := by
            rw [hpow, Nat.cast_mul]; ring
        _ ≤ isoP x a r0 i 0 * (x ^ R * (isoC2 (Fintype.card F) R r0 i 0 : ℝ)) :=
            mul_le_mul_of_nonneg_right (ih 0) (mul_nonneg (pow_nonneg hx0 _) (Nat.cast_nonneg _))
        _ ≤ isoP x a r0 (i + 1) 0 := isoP_stay0 hx0 hx1 hxq hq hR i
    · have hc := isoTupCount_succ_le hA hr i j
      calc (isoTupCount A (i + 1) (j + 1) : ℝ) * x ^ ((i + 1) * R)
          ≤ ((isoTupCount A i j * isoC1 (Fintype.card F) r0 i j +
              isoTupCount A i (j + 1) * isoC2 (Fintype.card F) R r0 i (j + 1) : ℕ) : ℝ) *
              x ^ ((i + 1) * R) :=
            mul_le_mul_of_nonneg_right (by exact_mod_cast hc) (pow_nonneg hx0 _)
        _ = ((isoTupCount A i j : ℝ) * x ^ (i * R)) *
              (x ^ R * (isoC1 (Fintype.card F) r0 i j : ℝ)) +
            ((isoTupCount A i (j + 1) : ℝ) * x ^ (i * R)) *
              (x ^ R * (isoC2 (Fintype.card F) R r0 i (j + 1) : ℝ)) := by
            rw [hpow, Nat.cast_add, Nat.cast_mul, Nat.cast_mul]; ring
        _ ≤ isoP x a r0 i j * (x ^ R * (isoC1 (Fintype.card F) r0 i j : ℝ)) +
            isoP x a r0 i (j + 1) * (x ^ R * (isoC2 (Fintype.card F) R r0 i (j + 1) : ℝ)) :=
            add_le_add
              (mul_le_mul_of_nonneg_right (ih j)
                (mul_nonneg (pow_nonneg hx0 _) (Nat.cast_nonneg _)))
              (mul_le_mul_of_nonneg_right (ih (j + 1))
                (mul_nonneg (pow_nonneg hx0 _) (Nat.cast_nonneg _)))
        _ ≤ isoP x a r0 (i + 1) (j + 1) := by
            rw [isoP_succ_succ]
            exact add_le_add (isoP_inc hx0 hx1 hxq hq hR i j) (isoP_stay hx0 hx1 hxq hq hR i j)

/-! ### From tuples to subspaces -/

/-- Ordered bases of an isotropic `h`-space `H` = linearly independent `h`-tuples in `H`. -/
noncomputable def fiberEquiv (A : Matrix (Fin R) (Fin R) F) {h : ℕ}
    {H : Submodule F (Fin R → F)} (hH : H ∈ isoLocus A h) :
    {v : Fin h → (Fin R → F) //
      (LinearIndependent F v ∧ PairOrth A v) ∧ Submodule.span F (Set.range v) = H} ≃
      {w : Fin h → H // LinearIndependent F w} where
  toFun v := ⟨fun s => ⟨v.1 s, by
      have hs : v.1 s ∈ Submodule.span F (Set.range v.1) :=
        Submodule.subset_span (Set.mem_range_self s)
      rw [v.2.2] at hs
      exact hs⟩,
    LinearIndependent.of_comp H.subtype v.2.1.1⟩
  invFun w := by
    have hli : LinearIndependent F (fun s => ((w.1 s : H) : Fin R → F)) :=
      w.2.map' H.subtype (by simp)
    exact ⟨fun s => (w.1 s : Fin R → F), ⟨hli, fun s t => hH.2 _ (w.1 s).2 _ (w.1 t).2⟩,
      Submodule.eq_of_le_of_finrank_eq
        (Submodule.span_le.2 (Set.range_subset_iff.2 fun s => (w.1 s).2))
        (by rw [finrank_span_eq_card hli, Fintype.card_fin, hH.1])⟩
  left_inv v := by ext s; rfl
  right_inv w := by ext s; rfl

lemma card_fiber_basis (A : Matrix (Fin R) (Fin R) F) {h : ℕ} {H : Submodule F (Fin R → F)}
    (hH : H ∈ isoLocus A h) :
    ((univ.filter (fun v : Fin h → (Fin R → F) => LinearIndependent F v ∧ PairOrth A v)).filter
      (fun v => Submodule.span F (Set.range v) = H)).card =
        ∏ t : Fin h, (Fintype.card F ^ h - Fintype.card F ^ (t : ℕ)) := by
  rw [Finset.filter_filter, ← Fintype.card_subtype]
  rw [Fintype.card_congr (fiberEquiv A hH), ← Nat.card_eq_fintype_card,
    card_linearIndependent (K := F) (V := H) (k := h) hH.1.ge]
  rw [hH.1]

/-- `#{independent pairwise orthogonal h-tuples} = I_h(A) · ∏_{t<h} (q^h - q^t)`. -/
theorem card_isoOrth (A : Matrix (Fin R) (Fin R) F) (h : ℕ) :
    (univ.filter (fun v : Fin h → (Fin R → F) => LinearIndependent F v ∧ PairOrth A v)).card =
      isoCount A h * ∏ t : Fin h, (Fintype.card F ^ h - Fintype.card F ^ (t : ℕ)) := by
  have hfin : (isoLocus A h).Finite := (grass_finite R h).subset (fun H hH => hH.1)
  have hmaps : Set.MapsTo (fun v : Fin h → (Fin R → F) => Submodule.span F (Set.range v))
      ↑(univ.filter (fun v : Fin h → (Fin R → F) => LinearIndependent F v ∧ PairOrth A v))
      ↑hfin.toFinset := by
    intro v hv
    rw [Finset.mem_coe, Finset.mem_filter] at hv
    rw [Finset.mem_coe, Set.Finite.mem_toFinset]
    exact ⟨by rw [finrank_span_eq_card hv.2.1, Fintype.card_fin], isotropic_span hv.2.2⟩
  rw [Finset.card_eq_sum_card_fiberwise hmaps, isoCount, Set.ncard_eq_toFinset_card _ hfin,
    Finset.card_eq_sum_ones, Finset.sum_mul, one_mul]
  refine Finset.sum_congr rfl (fun H hH => ?_)
  rw [Set.Finite.mem_toFinset] at hH
  exact card_fiber_basis A hH

theorem card_isoOrth_eq_sum (A : Matrix (Fin R) (Fin R) F) (h : ℕ) :
    (univ.filter (fun v : Fin h → (Fin R → F) => LinearIndependent F v ∧ PairOrth A v)).card =
      ∑ J ∈ range (h + 1), isoTupCount A h J := by
  have hmaps : Set.MapsTo
      (fun v : Fin h → (Fin R → F) =>
        finrank F (Submodule.span F (Set.range v) ⊓ rad A : Submodule F (Fin R → F)))
      ↑(univ.filter (fun v : Fin h → (Fin R → F) => LinearIndependent F v ∧ PairOrth A v))
      ↑(range (h + 1)) := by
    intro v hv
    rw [Finset.mem_coe, Finset.mem_filter] at hv
    rw [Finset.mem_coe, Finset.mem_range, Nat.lt_succ_iff]
    calc _ ≤ finrank F (Submodule.span F (Set.range v)) := Submodule.finrank_mono inf_le_left
      _ = h := by rw [finrank_span_eq_card hv.2.1, Fintype.card_fin]
  rw [Finset.card_eq_sum_card_fiberwise hmaps]
  refine Finset.sum_congr rfl (fun J _ => ?_)
  unfold isoTupCount
  congr 1
  ext v
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact and_assoc

/-- `|Gr(h, X)| · ∏_{t<h} (q^h - q^t) = ∏_{t<h} (q^R - q^t)`. -/
theorem grass_mul_card {h : ℕ} (hh : h ≤ R) :
    {H : Submodule F (Fin R → F) | finrank F H = h}.ncard *
        ∏ t : Fin h, (Fintype.card F ^ h - Fintype.card F ^ (t : ℕ)) =
      ∏ t : Fin h, (Fintype.card F ^ R - Fintype.card F ^ (t : ℕ)) := by
  have h0 := card_isoOrth (0 : Matrix (Fin R) (Fin R) F) h
  rw [isoCount, isoLocus_zero] at h0
  rw [← h0]
  have e : univ.filter (fun v : Fin h → (Fin R → F) =>
      LinearIndependent F v ∧ PairOrth (0 : Matrix (Fin R) (Fin R) F) v) =
      univ.filter (fun v : Fin h → (Fin R → F) => LinearIndependent F v) := by
    ext v
    simp [PairOrth]
  rw [e, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card,
    card_linearIndependent (K := F) (V := Fin R → F) (k := h)
      (by rw [Module.finrank_fin_fun]; exact hh), Module.finrank_fin_fun]

/-- `x^(hR) ∏_{t<h} (q^R - q^t) = Q(h)`. -/
lemma cast_prod_eq_isoQ {x : ℝ} (hxq : x * (Fintype.card F : ℝ) = 1) {h : ℕ} (hh : h ≤ R) :
    ((∏ t : Fin h, (Fintype.card F ^ R - Fintype.card F ^ (t : ℕ)) : ℕ) : ℝ) * x ^ (h * R) =
      isoQ x R h := by
  have hq : 0 < Fintype.card F := Fintype.card_pos
  have hx : x ^ (h * R) = ∏ _t : Fin h, x ^ R := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← pow_mul, mul_comm]
  rw [Nat.cast_prod, hx, ← Finset.prod_mul_distrib, isoQ, ← Fin.prod_univ_eq_prod_range]
  refine Finset.prod_congr rfl (fun t _ => ?_)
  have ht := t.isLt
  rw [cast_pow_sub hq (by omega : (t : ℕ) ≤ R), sub_mul]
  have h1 : (Fintype.card F : ℝ) ^ R * x ^ R = 1 := by rw [← mul_pow, mul_comm, hxq, one_pow]
  have h2 : (Fintype.card F : ℝ) ^ (t : ℕ) * x ^ R = x ^ (R - t) := by
    rw [mul_comm]; exact xq_pow hxq (by omega)
  rw [h1, h2]

/-- **Lemma 8.1 (upper bound, normalised form).** For an alternating `A` with `dim rad A = r0`
and `R = r0 + 2a`:  `I_h(A) · Q(h) ≤ |Gr(h, X)| · Σ_{j ≤ h} P(h, j)`, `x = 1/q`.
Only this upper bound is formalized: the equality (93) and the identification of `P(h, j)`
with the paper's summand are not proved here (the latter was checked numerically only).
Downstream uses go through (95)/(96) (`isoCount_uniform`, `isoCount_saturated`). -/
theorem isoCount_mul_isoQ_le (hA : IsAltMat A) {a r0 h : ℕ} (hr : finrank F (rad A) = r0)
    (hR : r0 + 2 * a = R) (hh : h ≤ R) {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1)
    (hxq : x * (Fintype.card F : ℝ) = 1) :
    (isoCount A h : ℝ) * isoQ x R h ≤
      ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) *
        ∑ J ∈ range (h + 1), isoP x a r0 h J := by
  have h1 : ((isoCount A h * ∏ t : Fin h, (Fintype.card F ^ h - Fintype.card F ^ (t : ℕ)) : ℕ)
      : ℝ) * x ^ (h * R) ≤ ∑ J ∈ range (h + 1), isoP x a r0 h J := by
    rw [← card_isoOrth, card_isoOrth_eq_sum, Nat.cast_sum, Finset.sum_mul]
    exact Finset.sum_le_sum fun J _ => isoTupCount_le hA hr hR hx0 hx1 hxq h J
  have h2 : (({H : Submodule F (Fin R → F) | finrank F H = h}.ncard *
      ∏ t : Fin h, (Fintype.card F ^ h - Fintype.card F ^ (t : ℕ)) : ℕ) : ℝ) *
      x ^ (h * R) = isoQ x R h := by
    rw [grass_mul_card hh]
    exact cast_prod_eq_isoQ hxq hh
  rw [← h2]
  rw [Nat.cast_mul] at h1 ⊢
  have h3 := mul_le_mul_of_nonneg_left h1
    (Nat.cast_nonneg (α := ℝ) {H : Submodule F (Fin R → F) | finrank F H = h}.ncard)
  linarith

/-! ### The rank of an alternating form is even

A maximal isotropic subspace `H` containing `rad A` satisfies `H^⊥ = H`; then
`2 dim H = R + dim rad A` by `finrank_orth`, so `R - dim rad A = 2 (dim H - dim rad A)`. -/

lemma toBilin'_eq_bfL (A : Matrix (Fin R) (Fin R) F) (x z : Fin R → F) :
    Matrix.toBilin' A x z = bfL x z A := by
  rw [Matrix.toBilin'_apply', bfL_apply]

lemma mem_orth_iff_bfL {A : Matrix (Fin R) (Fin R) F} {U : Submodule F (Fin R → F)}
    {y : Fin R → F} :
    y ∈ (Matrix.toBilin' A).orthogonal U ↔ ∀ u ∈ U, bfL u y A = 0 := by
  rw [LinearMap.BilinForm.mem_orthogonal_iff]
  refine forall₂_congr fun u _ => ?_
  show Matrix.toBilin' A u y = 0 ↔ _
  rw [toBilin'_eq_bfL]

/-- Adjoining a vector of `U^⊥` to an isotropic `U` keeps it isotropic. -/
lemma isotropic_sup_span {A : Matrix (Fin R) (Fin R) F} (hA : IsAltMat A)
    {U : Submodule F (Fin R → F)} (hU : Isotropic A U) {y : Fin R → F}
    (hy : y ∈ (Matrix.toBilin' A).orthogonal U) :
    Isotropic A (Submodule.span F {y} ⊔ U) := by
  have hy' := mem_orth_iff_bfL.1 hy
  intro w1 hw1 w2 hw2
  obtain ⟨a1, ha1, u1, hu1, rfl⟩ := Submodule.mem_sup.1 hw1
  obtain ⟨a2, ha2, u2, hu2, rfl⟩ := Submodule.mem_sup.1 hw2
  obtain ⟨c1, rfl⟩ := Submodule.mem_span_singleton.1 ha1
  obtain ⟨c2, rfl⟩ := Submodule.mem_span_singleton.1 ha2
  have e1 := bfL_self_eq_zero hA y
  have e2 : bfL y u2 A = 0 := by rw [bfL_swap hA, hy' u2 hu2, neg_zero]
  have e3 := hy' u1 hu1
  have e4 := hU u1 hu1 u2 hu2
  rw [← toBilin'_eq_bfL]
  simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
  simp only [toBilin'_eq_bfL, e1, e2, e3, e4, mul_zero, add_zero]

/-- Every isotropic `U ⊇ rad A` lies in an isotropic `H` with `H^⊥ ≤ H`. -/
lemma exists_isotropic_orth_le (hA : IsAltMat A) :
    ∀ n (U : Submodule F (Fin R → F)), Isotropic A U → rad A ≤ U → R - finrank F U = n →
      ∃ H : Submodule F (Fin R → F),
        Isotropic A H ∧ rad A ≤ H ∧ (Matrix.toBilin' A).orthogonal H ≤ H := by
  intro n
  induction n with
  | zero =>
    intro U hU hrU hn
    by_cases hle : (Matrix.toBilin' A).orthogonal U ≤ U
    · exact ⟨U, hU, hrU, hle⟩
    · exfalso
      obtain ⟨y, -, hyU⟩ := SetLike.not_le_iff_exists.1 hle
      have h1 := finrank_span_sup hyU
      have h2 := Submodule.finrank_le (Submodule.span F {y} ⊔ U)
      rw [Module.finrank_fin_fun] at h2
      omega
  | succ n ih =>
    intro U hU hrU hn
    by_cases hle : (Matrix.toBilin' A).orthogonal U ≤ U
    · exact ⟨U, hU, hrU, hle⟩
    · obtain ⟨y, hy, hyU⟩ := SetLike.not_le_iff_exists.1 hle
      refine ih _ (isotropic_sup_span hA hU hy) (hrU.trans le_sup_right) ?_
      rw [finrank_span_sup hyU]
      omega

/-- **The rank of an alternating form is even**: `dim rad A + 2a = R` for some `a`. -/
theorem exists_finrank_rad_add_two_mul (hA : IsAltMat A) :
    ∃ a : ℕ, finrank F (rad A) + 2 * a = R := by
  obtain ⟨H, hH, hrH, hHo⟩ := exists_isotropic_orth_le hA _ (rad A)
    (fun x hx y _ => bfL_rad_left hx y) le_rfl rfl
  have hle : H ≤ (Matrix.toBilin' A).orthogonal H :=
    fun y hy => mem_orth_iff_bfL.2 fun u hu => hH u hu y hy
  have hEq : (Matrix.toBilin' A).orthogonal H = H := le_antisymm hHo hle
  have hf := finrank_orth A H
  rw [hEq, inf_eq_right.2 hrH] at hf
  have hm := Submodule.finrank_mono hrH
  exact ⟨finrank F H - finrank F (rad A), by omega⟩

/-- `R - dim rad A` is even for alternating `A`. -/
theorem even_sub_finrank_rad (hA : IsAltMat A) : Even (R - finrank F (rad A)) := by
  obtain ⟨a, ha⟩ := exists_finrank_rad_add_two_mul hA
  exact ⟨a, by omega⟩

end Count

/-! ### Lemma 8.2: the exponent bounds and the final estimates -/

section Exponents

/-- `κ_h(a) + (j - j_0) ≤ E(h, j)` on the feasible range `h - a ≤ j ≤ h`, `j_0 = h - min(a, h)`
(the loss function (101) grows at least linearly from its minimum `κ_h(a)`). -/
lemma isoE_ge_kappa {a h J : ℕ} (hJ : J ≤ h) (hl : h - J ≤ a) :
    kappaH h a + (J - (h - min a h)) ≤ isoE a h J := by
  rcases Nat.eq_zero_or_pos h with rfl | hpos
  · obtain rfl : J = 0 := by omega
    simp [kappaH, isoE]
  · by_cases hah : a < h
    · obtain ⟨e, m, d, rfl, rfl, rfl⟩ : ∃ e m d, h = e + m + d ∧ a = e + m ∧ J = d + m :=
        ⟨h - J, J - (h - a), h - a, by omega, by omega, by omega⟩
      have k1 : min (e + m) (e + m + d - 1) = e + m := by omega
      have k2 : min (e + m) (e + m + d) = e + m := by omega
      unfold kappaH isoE
      rw [k1, k2, show e + m + d - (e + m) = d by omega, show e + m + d - (d + m) = e by omega,
        show 2 * (e + m) - e = e + 2 * m by omega, show d + m - d = m by omega]
      have T1 := two_mul_choose_two_add (e + m + d)
      have T2 := two_mul_choose_two_add d
      have T3 := two_mul_choose_two_add e
      have hle : d.choose 2 ≤ (e + m + d).choose 2 := Nat.choose_le_choose 2 (by omega)
      have key : (e + m + d).choose 2 + m ≤ e.choose 2 + (d + m) * (e + 2 * m) + d.choose 2 := by
        nlinarith [Nat.zero_le (d * m), Nat.le_mul_self m]
      omega
    · push_neg at hah
      obtain ⟨l, rfl⟩ : ∃ l, h = l + J := ⟨h - J, by omega⟩
      have k1 : min a (l + J - 1) = l + J - 1 := by omega
      have k2 : min a (l + J) = l + J := by omega
      unfold kappaH isoE
      rw [k1, k2, show l + J - (l + J - 1) = 1 by omega, show l + J - (l + J) = 0 by omega,
        show l + J - J = l by omega, Nat.sub_zero,
        Nat.choose_eq_zero_of_lt (by norm_num : 1 < 2), Nat.sub_zero]
      have c : l + 2 * J ≤ 2 * a - l := by omega
      have T1 := two_mul_choose_two_add (l + J)
      have T2 := two_mul_choose_two_add l
      have hc := Nat.mul_le_mul_left J c
      nlinarith [Nat.le_mul_self J]

/-- The exact identity `2 E(h, j) + 4hj = 2 C(h,2) + j (4a + 3j + 1)` (cf. (101)). -/
lemma isoE_two_mul {a h J : ℕ} (hJ : J ≤ h) (hl : h - J ≤ 2 * a) :
    2 * isoE a h J + 4 * h * J = 2 * h.choose 2 + J * (4 * a + 3 * J + 1) := by
  obtain ⟨l, rfl⟩ : ∃ l, h = l + J := ⟨h - J, by omega⟩
  unfold isoE
  rw [show l + J - J = l by omega]
  obtain ⟨c, hc⟩ : ∃ c, 2 * a = c + l := ⟨2 * a - l, by omega⟩
  rw [show 2 * a - l = c by omega]
  have T1 := two_mul_choose_two_add (l + J)
  have T2 := two_mul_choose_two_add l
  have hc' : J * (2 * a) = J * (c + l) := by rw [hc]
  apply le_antisymm <;> nlinarith [hc']

/-- `kappaH` is the paper's `κ_h(a) = a_h (2h - a_h - 1) / 2`, eq. (94), `a_h = min(a, h - 1)`. -/
lemma two_mul_kappaH (h a : ℕ) :
    2 * kappaH h a = min a (h - 1) * (2 * h - min a (h - 1) - 1) := by
  unfold kappaH
  rcases Nat.eq_zero_or_pos h with rfl | hpos
  · simp
  · obtain ⟨b, hb⟩ : ∃ b, min a (h - 1) = b := ⟨_, rfl⟩
    rw [hb]
    have hbh : b + 1 ≤ h := by omega
    obtain ⟨d, rfl⟩ : ∃ d, h = b + d := ⟨h - b, by omega⟩
    rw [show b + d - b = d by omega, show 2 * (b + d) - b - 1 = b + 2 * d - 1 by omega]
    have T1 := two_mul_choose_two_add (b + d)
    have T2 := two_mul_choose_two_add d
    have hle : d.choose 2 ≤ (b + d).choose 2 := Nat.choose_le_choose 2 (by omega)
    have h1 : b + 2 * d - 1 + 1 = b + 2 * d := by omega
    have hP : b * (b + 2 * d - 1) + b = b * (b + 2 * d) := by
      calc b * (b + 2 * d - 1) + b = b * (b + 2 * d - 1 + 1) := by ring
        _ = b * (b + 2 * d) := by rw [h1]
    have H : 2 * (b + d).choose 2 + b = b * (b + 2 * d) + 2 * d.choose 2 := by
      apply le_antisymm <;> nlinarith [T1, T2]
    omega

lemma kappaH_of_le {h a : ℕ} (hah : h ≤ a + 1) : kappaH h a = h.choose 2 := by
  unfold kappaH
  rw [show min a (h - 1) = h - 1 by omega,
    Nat.choose_eq_zero_of_lt (by omega : h - (h - 1) < 2), Nat.sub_zero]

lemma kappaH_mono (h : ℕ) {a b : ℕ} (hab : a ≤ b) : kappaH h a ≤ kappaH h b := by
  unfold kappaH
  exact Nat.sub_le_sub_left (Nat.choose_le_choose 2 (by omega)) _

/-- `κ_h(1) = h - 1`. -/
lemma kappaH_one (h : ℕ) : kappaH h 1 = h - 1 := by
  unfold kappaH
  rcases Nat.lt_or_ge h 2 with hh | hh
  · interval_cases h <;> rfl
  · obtain ⟨n, rfl⟩ : ∃ n, h = n + 2 := ⟨h - 2, by omega⟩
    rw [show min 1 (n + 2 - 1) = 1 by omega, show n + 2 - 1 = n + 1 by omega,
      show n + 2 = n + 1 + 1 by omega, choose_two_succ (n + 1)]
    omega

/-- `κ_h(a) ≥ κ_h(1) = h - 1` for `a ≥ 1`. -/
lemma sub_one_le_kappaH {h a : ℕ} (ha : 1 ≤ a) : h - 1 ≤ kappaH h a := by
  rw [← kappaH_one]
  exact kappaH_mono h ha

end Exponents

section Final

variable {x : ℝ}

lemma geom_le_two (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) : ∀ n, ∑ m ∈ range n, x ^ m ≤ 2 - 2 * x ^ n
  | 0 => by simp
  | n + 1 => by
    rw [Finset.sum_range_succ, pow_succ]
    have h1 := geom_le_two hx0 hx12 n
    have h2 := mul_nonneg (pow_nonneg hx0 n) (by linarith : (0 : ℝ) ≤ 1 - 2 * x)
    nlinarith

/-- Uniform estimate behind (95): `Σ_j P(h, j) ≤ 8 x^(κ_h(a))`. -/
lemma sum_isoP_le_uniform (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) (a r0 h : ℕ) :
    ∑ J ∈ range (h + 1), isoP x a r0 h J ≤ 8 * x ^ kappaH h a := by
  have hx1 : x ≤ 1 := by linarith
  have hsplit : h + 1 = (h - min a h) + (min a h + 1) := by omega
  rw [hsplit, Finset.sum_range_add]
  have hfirst : ∑ J ∈ range (h - min a h), isoP x a r0 h J = 0 := by
    refine Finset.sum_eq_zero (fun J hJ => ?_)
    have := Finset.mem_range.1 hJ
    unfold isoP
    rw [isoS_eq_zero (show a < h - J by omega)]
    ring
  rw [hfirst, zero_add]
  have hterm : ∀ m ∈ range (min a h + 1),
      isoP x a r0 h (h - min a h + m) ≤ 4 * x ^ kappaH h a * x ^ m := by
    intro m hm
    have hm' := Finset.mem_range.1 hm
    have hE := isoE_ge_kappa (a := a) (h := h) (J := h - min a h + m) (by omega) (by omega)
    rw [show h - min a h + m - (h - min a h) = m by omega] at hE
    have := isoP_le_of (a := a) (r0 := r0) (i := h) (j := h - min a h + m) hx0 hx1 hE
      (isoG_le_one hx0 hx1 _ _) (isoS_le_one hx0 hx1 _ _) (qBinom_le_four hx0 hx12 _ _)
    calc _ ≤ _ := this
      _ = 4 * x ^ kappaH h a * x ^ m := by rw [pow_add]; ring
  calc _ ≤ ∑ m ∈ range (min a h + 1), 4 * x ^ kappaH h a * x ^ m := Finset.sum_le_sum hterm
    _ = 4 * x ^ kappaH h a * ∑ m ∈ range (min a h + 1), x ^ m := by rw [Finset.mul_sum]
    _ ≤ 4 * x ^ kappaH h a * 2 := by
        refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (by norm_num) (pow_nonneg hx0 _))
        have := geom_le_two hx0 hx12 (min a h + 1)
        have := pow_nonneg hx0 (min a h + 1)
        linarith
    _ = 8 * x ^ kappaH h a := by ring

/-- Saturated estimate behind (96): for `a ≥ h - 1 ≥ 1`, `Σ_j P(h, j) ≤ (15/8) x^C(h,2) Q(h)`. -/
lemma sum_isoP_le_sat (hx0 : 0 ≤ x) (hx12 : x ≤ 1 / 2) {a r0 R h : ℕ} (hR : r0 + 2 * a = R)
    (h2 : 2 ≤ h) (hah : h ≤ a + 1) :
    ∑ J ∈ range (h + 1), isoP x a r0 h J ≤ 15 / 8 * x ^ h.choose 2 * isoQ x R h := by
  have hx1 : x ≤ 1 := by linarith
  have hhR : h ≤ R := by omega
  have hQ : 1 - x ^ (R - h) ≤ isoQ x R h := isoQ_ge hx0 hx12 h hhR
  have hQ0 : 0 ≤ isoQ x R h := isoQ_nonneg hx0 hx1 R h
  have hC0 : 0 ≤ x ^ h.choose 2 := pow_nonneg hx0 _
  have hCQ : 0 ≤ x ^ h.choose 2 * isoQ x R h := mul_nonneg hC0 hQ0
  have hGQ : ∀ n, isoG x r0 (n + 1) ≤ isoQ x R h := fun n =>
    (isoG_le_first hx0 hx1 r0 n).trans
      ((sub_le_sub_left (pow_le_pow_of_le_one hx0 hx1 (by omega : r0 ≤ R - h)) 1).trans hQ)
  have hx2 : x ^ 2 ≤ 1 / 4 := by nlinarith
  have hx3 : x ^ 3 ≤ 1 / 8 := by
    have : x ^ 3 = x ^ 2 * x := pow_succ x 2
    nlinarith [pow_nonneg hx0 2]
  have hE : ∀ J, J ≤ h → 2 * isoE a h J + 4 * h * J = 2 * h.choose 2 + J * (4 * a + 3 * J + 1) :=
    fun J hJ => isoE_two_mul hJ (by omega)
  rw [show h + 1 = 3 + (h - 2) by omega, Finset.sum_range_add]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add]
  -- the terms `j = 0, 1`
  have b01 : isoP x a r0 h 0 + isoP x a r0 h 1 ≤ 3 / 2 * (x ^ h.choose 2 * isoQ x R h) := by
    have hB1 := qBinom_one_le hx0 hx12 h
    have hB1' : qBinom x h 1 ≤ 2 := by nlinarith [qBinom_nonneg hx0 h 1]
    by_cases hah' : h ≤ a
    · have hE1 := hE 1 (by omega)
      have hSh : isoS x a h ≤ 1 - x ^ (2 * a - 2 * (h - 1)) := by
        have := isoS_le_last hx0 hx1 a (h - 1)
        rwa [show h - 1 + 1 = h by omega] at this
      have hsh : isoS x a (h - 0) ≤ isoQ x R h := by
        rw [Nat.sub_zero]
        exact hSh.trans ((sub_le_sub_left
          (pow_le_pow_of_le_one hx0 hx1 (by omega : 2 * a - 2 * (h - 1) ≤ R - h)) 1).trans hQ)
      have hE0 : h.choose 2 ≤ isoE a h 0 := by simp [isoE]
      have p0 : isoP x a r0 h 0 ≤ x ^ h.choose 2 * 1 * isoQ x R h * 1 :=
        isoP_le_of hx0 hx1 hE0 (isoG_le_one hx0 hx1 _ _) hsh (le_of_eq (qBinom_zero_right x h))
      have p1 : isoP x a r0 h 1 ≤ x ^ (h.choose 2 + 2) * isoQ x R h * 1 * 2 :=
        isoP_le_of hx0 hx1 (by omega) (hGQ 0) (isoS_le_one hx0 hx1 _ _) hB1'
      rw [pow_add] at p1
      nlinarith [mul_le_mul_of_nonneg_left hx2 hCQ]
    · have hah2 : a + 1 = h := by omega
      have p0 : isoP x a r0 h 0 = 0 := by
        unfold isoP
        rw [isoS_eq_zero (by omega : a < h - 0)]
        ring
      have hE1 := hE 1 (by omega)
      have hS : isoS x a (h - 1) ≤ 1 - x ^ 2 := by
        rw [show h - 1 = (h - 2) + 1 by omega]
        refine (isoS_le_last hx0 hx1 a (h - 2)).trans ?_
        rw [show 2 * a - 2 * (h - 2) = 2 by omega]
      have p1 : isoP x a r0 h 1 ≤ x ^ h.choose 2 * isoQ x R h * (1 - x ^ 2) * qBinom x h 1 :=
        isoP_le_of hx0 hx1 (by omega) (hGQ 0) hS le_rfl
      have hB : (1 - x ^ 2) * qBinom x h 1 ≤ 3 / 2 := by
        have : (1 - x ^ 2) * qBinom x h 1 = (1 + x) * (qBinom x h 1 * (1 - x)) := by ring
        rw [this]
        nlinarith
      rw [p0, zero_add]
      calc _ ≤ _ := p1
        _ = (x ^ h.choose 2 * isoQ x R h) * ((1 - x ^ 2) * qBinom x h 1) := by ring
        _ ≤ (x ^ h.choose 2 * isoQ x R h) * (3 / 2) := mul_le_mul_of_nonneg_left hB hCQ
        _ = _ := by ring
  -- the term `j = 2`
  have b2 : isoP x a r0 h 2 ≤ 1 / 3 * (x ^ h.choose 2 * isoQ x R h) := by
    have hE2 := hE 2 (by omega)
    have p2 : isoP x a r0 h 2 ≤ x ^ (h.choose 2 + 3) * isoQ x R h * 1 * (8 / 3) :=
      isoP_le_of hx0 hx1 (by omega) (hGQ 1) (isoS_le_one hx0 hx1 _ _) (qBinom_two_le hx0 hx12 h)
    rw [pow_add] at p2
    nlinarith [mul_le_mul_of_nonneg_left hx3 hCQ]
  -- the tail `j ≥ 3`
  have bt : ∑ k ∈ range (h - 2), isoP x a r0 h (3 + k) ≤
      1 / 64 * (x ^ h.choose 2 * isoQ x R h) := by
    have hterm : ∀ k ∈ range (h - 2),
        isoP x a r0 h (3 + k) ≤ (4 * x ^ 9 * (x ^ h.choose 2 * isoQ x R h)) * x ^ k := by
      intro k hk
      have hk' := Finset.mem_range.1 hk
      have hEk := hE (3 + k) (by omega)
      have hge : h.choose 2 + 9 + 6 * k ≤ isoE a h (3 + k) := by
        have hmul : (3 + k) * (4 * h) ≤ (3 + k) * (4 * a + 4) := Nat.mul_le_mul_left _ (by omega)
        nlinarith [hmul]
      have hGk : isoG x r0 (3 + k) ≤ isoQ x R h := by
        have := hGQ (2 + k)
        rwa [show 2 + k + 1 = 3 + k by omega] at this
      have pk := isoP_le_of (a := a) (r0 := r0) (i := h) (j := 3 + k) hx0 hx1 hge hGk
        (isoS_le_one hx0 hx1 _ _) (qBinom_le_four hx0 hx12 _ _)
      have hxk : x ^ (6 * k) ≤ x ^ k := pow_le_pow_of_le_one hx0 hx1 (by omega)
      have e : x ^ (h.choose 2 + 9 + 6 * k) = x ^ h.choose 2 * x ^ 9 * x ^ (6 * k) := by
        rw [pow_add, pow_add]
      rw [e] at pk
      have h9 : 0 ≤ x ^ 9 := pow_nonneg hx0 9
      calc _ ≤ _ := pk
        _ = (4 * x ^ 9 * (x ^ h.choose 2 * isoQ x R h)) * x ^ (6 * k) := by ring
        _ ≤ (4 * x ^ 9 * (x ^ h.choose 2 * isoQ x R h)) * x ^ k :=
            mul_le_mul_of_nonneg_left hxk (mul_nonneg (mul_nonneg (by norm_num) h9) hCQ)
    have hx9 : x ^ 9 ≤ 1 / 512 := by
      have : x ^ 9 = (x ^ 3) ^ 3 := by rw [← pow_mul]
      rw [this]
      have h30 : 0 ≤ x ^ 3 := pow_nonneg hx0 3
      calc (x ^ 3) ^ 3 ≤ (1 / 8) ^ 3 := pow_le_pow_left₀ h30 hx3 3
        _ = 1 / 512 := by norm_num
    have hg := geom_le_two hx0 hx12 (h - 2)
    have hg0 := pow_nonneg hx0 (h - 2)
    calc _ ≤ ∑ k ∈ range (h - 2), (4 * x ^ 9 * (x ^ h.choose 2 * isoQ x R h)) * x ^ k :=
          Finset.sum_le_sum hterm
      _ = (4 * x ^ 9 * (x ^ h.choose 2 * isoQ x R h)) * ∑ k ∈ range (h - 2), x ^ k := by
          rw [Finset.mul_sum]
      _ ≤ (4 * x ^ 9 * (x ^ h.choose 2 * isoQ x R h)) * 2 :=
          mul_le_mul_of_nonneg_left (by linarith)
            (mul_nonneg (mul_nonneg (by norm_num) (pow_nonneg hx0 9)) hCQ)
      _ ≤ _ := by nlinarith [mul_le_mul_of_nonneg_right hx9 hCQ]
  have hsum : isoP x a r0 h 0 + isoP x a r0 h 1 + isoP x a r0 h 2 +
      ∑ k ∈ range (h - 2), isoP x a r0 h (3 + k) ≤ 15 / 8 * x ^ h.choose 2 * isoQ x R h := by
    nlinarith
  linarith

variable {F : Type*} [Field F] [Fintype F] {R : ℕ} {A : Matrix (Fin R) (Fin R) F}

lemma inv_card_facts :
    0 ≤ (Fintype.card F : ℝ)⁻¹ ∧ (Fintype.card F : ℝ)⁻¹ ≤ 1 / 2 ∧
      (Fintype.card F : ℝ)⁻¹ * (Fintype.card F : ℝ) = 1 := by
  have hq : 1 < Fintype.card F := Fintype.one_lt_card
  have hq2 : (2 : ℝ) ≤ Fintype.card F := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < Fintype.card F := by linarith
  refine ⟨inv_nonneg.2 hq0.le, ?_, inv_mul_cancel₀ hq0.ne'⟩
  rw [inv_eq_one_div]
  exact one_div_le_one_div_of_le (by norm_num) hq2

lemma isoCount_eq_zero_of_lt {h : ℕ} (hh : R < h) : isoCount A h = 0 := by
  have hle := isoCount_le_grass A h
  have he : {H : Submodule F (Fin R → F) | finrank F H = h} = ∅ := by
    ext H
    simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
    intro hH
    have := Submodule.finrank_le H
    rw [Module.finrank_fin_fun] at this
    omega
  rw [he, Set.ncard_empty] at hle
  omega

/-- **Lemma 8.2, (95)** (crude constant `32`): `I_h(A) q^(κ_h(a)) ≤ 32 |Gr(h, X)|` when
`dim rad A = r0` and `R = r0 + 2a`. -/
theorem isoCount_uniform (hA : IsAltMat A) {a r0 : ℕ} (hr : finrank F (rad A) = r0)
    (hR : r0 + 2 * a = R) (h : ℕ) :
    (isoCount A h : ℝ) * (Fintype.card F : ℝ) ^ kappaH h a ≤
      32 * ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) := by
  obtain ⟨x, hx0, hx12, hxq⟩ : ∃ x : ℝ, 0 ≤ x ∧ x ≤ 1 / 2 ∧ x * (Fintype.card F : ℝ) = 1 :=
    ⟨_, inv_card_facts (F := F)⟩
  have hx1 : x ≤ 1 := by linarith
  by_cases hhR : h ≤ R
  · have main := isoCount_mul_isoQ_le hA hr hR hhR hx0 hx1 hxq
    have hs := sum_isoP_le_uniform hx0 hx12 a r0 h
    have hQ : 1 / 4 ≤ isoQ x R h := (piQ_ge_quarter hx0 hx12 h).trans (piQ_le_isoQ hx0 hx1 hhR)
    have hI0 : (0 : ℝ) ≤ isoCount A h := Nat.cast_nonneg _
    have hGr0 : (0 : ℝ) ≤ ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) :=
      Nat.cast_nonneg _
    have h1 : (isoCount A h : ℝ) * (1 / 4) ≤
        ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) * (8 * x ^ kappaH h a) :=
      (mul_le_mul_of_nonneg_left hQ hI0).trans (main.trans (mul_le_mul_of_nonneg_left hs hGr0))
    have hk : x ^ kappaH h a * (Fintype.card F : ℝ) ^ kappaH h a = 1 := by
      rw [← mul_pow, hxq, one_pow]
    have hpk : 0 ≤ (Fintype.card F : ℝ) ^ kappaH h a := by positivity
    have h2 := mul_le_mul_of_nonneg_right h1 hpk
    calc (isoCount A h : ℝ) * (Fintype.card F : ℝ) ^ kappaH h a
        = 4 * ((isoCount A h : ℝ) * (1 / 4) * (Fintype.card F : ℝ) ^ kappaH h a) := by ring
      _ ≤ 4 * (({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) *
            (8 * x ^ kappaH h a) * (Fintype.card F : ℝ) ^ kappaH h a) := by linarith
      _ = 32 * ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) *
            (x ^ kappaH h a * (Fintype.card F : ℝ) ^ kappaH h a) := by ring
      _ = _ := by rw [hk, mul_one]
  · push_neg at hhR
    rw [isoCount_eq_zero_of_lt hhR, Nat.cast_zero, zero_mul]
    positivity

/-- **Lemma 8.2, (96)** with `γ_q ≤ 15/8 < 2`: if `a ≥ h - 1` then
`I_h(A) q^(C(h,2)) ≤ (15/8) |Gr(h, X)|`. -/
theorem isoCount_saturated (hA : IsAltMat A) {a r0 : ℕ} (hr : finrank F (rad A) = r0)
    (hR : r0 + 2 * a = R) {h : ℕ} (hah : h ≤ a + 1) :
    (isoCount A h : ℝ) * (Fintype.card F : ℝ) ^ h.choose 2 ≤
      15 / 8 * ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) := by
  obtain ⟨x, hx0, hx12, hxq⟩ : ∃ x : ℝ, 0 ≤ x ∧ x ≤ 1 / 2 ∧ x * (Fintype.card F : ℝ) = 1 :=
    ⟨_, inv_card_facts (F := F)⟩
  have hx1 : x < 1 := by linarith
  have hx1' : x ≤ 1 := by linarith
  have hGr0 : (0 : ℝ) ≤ ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) :=
    Nat.cast_nonneg _
  by_cases h2 : 2 ≤ h
  · have hhR : h ≤ R := by omega
    have main := isoCount_mul_isoQ_le hA hr hR hhR hx0 hx1' hxq
    have hs := sum_isoP_le_sat hx0 hx12 hR h2 hah
    have hQpos : 0 < isoQ x R h := isoQ_pos hx0 hx1 hhR
    have h1 : (isoCount A h : ℝ) * isoQ x R h ≤
        (({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) * (15 / 8 * x ^ h.choose 2))
          * isoQ x R h := by
      calc _ ≤ _ := main.trans (mul_le_mul_of_nonneg_left hs hGr0)
        _ = _ := by ring
    have h3 := le_of_mul_le_mul_right h1 hQpos
    have hk : x ^ h.choose 2 * (Fintype.card F : ℝ) ^ h.choose 2 = 1 := by
      rw [← mul_pow, hxq, one_pow]
    have hpk : 0 ≤ (Fintype.card F : ℝ) ^ h.choose 2 := by positivity
    have h4 := mul_le_mul_of_nonneg_right h3 hpk
    calc _ ≤ _ := h4
      _ = 15 / 8 * ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) *
            (x ^ h.choose 2 * (Fintype.card F : ℝ) ^ h.choose 2) := by ring
      _ = _ := by rw [hk, mul_one]
  · push_neg at h2
    rw [Nat.choose_eq_zero_of_lt h2, pow_zero, mul_one]
    have := isoCount_le_grass A h
    have : (isoCount A h : ℝ) ≤ ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) := by
      exact_mod_cast this
    linarith

/-- (96) over `F_2`: `I_h(A) 2^(C(h,2)) ≤ (15/8) |Gr(h, F_2^R)|` for `rank A = 2a ≥ 2h - 2`. -/
theorem isoCount_saturated_two {A : Matrix (Fin R) (Fin R) (ZMod 2)} (hA : IsAltMat A)
    {a r0 : ℕ} (hr : finrank (ZMod 2) (rad A) = r0) (hR : r0 + 2 * a = R) {h : ℕ}
    (hah : h ≤ a + 1) :
    (isoCount A h : ℝ) * 2 ^ h.choose 2 ≤
      15 / 8 * ({H : Submodule (ZMod 2) (Fin R → ZMod 2) | finrank (ZMod 2) H = h}.ncard : ℝ) := by
  have := isoCount_saturated hA hr hR hah
  rwa [ZMod.card, Nat.cast_ofNat] at this

/-- (95) for an alternating `A` given only a rank lower bound: if `2b ≤ R - dim rad A` then
`I_h(A) q^(κ_h(b)) ≤ 32 |Gr(h, X)|` (uses evenness of the rank and monotonicity of `κ_h`). -/
theorem isoCount_uniform_of_le (hA : IsAltMat A) {b : ℕ} (hb : 2 * b ≤ R - finrank F (rad A))
    (h : ℕ) :
    (isoCount A h : ℝ) * (Fintype.card F : ℝ) ^ kappaH h b ≤
      32 * ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) := by
  obtain ⟨a, ha⟩ := exists_finrank_rad_add_two_mul hA
  have main := isoCount_uniform hA rfl ha h
  have hk : kappaH h b ≤ kappaH h a := kappaH_mono h (by omega)
  have hq : 0 < Fintype.card F := Fintype.card_pos
  have hpow : (Fintype.card F : ℝ) ^ kappaH h b ≤ (Fintype.card F : ℝ) ^ kappaH h a := by
    exact_mod_cast Nat.pow_le_pow_right hq hk
  have hI0 : (0 : ℝ) ≤ isoCount A h := Nat.cast_nonneg _
  exact (mul_le_mul_of_nonneg_left hpow hI0).trans main

/-- (96) for an alternating `A` given only a rank lower bound: if `2(h-1) ≤ R - dim rad A` then
`I_h(A) q^(C(h,2)) ≤ (15/8) |Gr(h, X)|`. -/
theorem isoCount_saturated_of_le (hA : IsAltMat A) {h : ℕ}
    (hh : 2 * (h - 1) ≤ R - finrank F (rad A)) :
    (isoCount A h : ℝ) * (Fintype.card F : ℝ) ^ h.choose 2 ≤
      15 / 8 * ({H : Submodule F (Fin R → F) | finrank F H = h}.ncard : ℝ) := by
  obtain ⟨a, ha⟩ := exists_finrank_rad_add_two_mul hA
  exact isoCount_saturated hA rfl ha (by omega)

/-- `isoCount_saturated_of_le` over `F_2`. -/
theorem isoCount_saturated_two_of_le {A : Matrix (Fin R) (Fin R) (ZMod 2)} (hA : IsAltMat A)
    {h : ℕ} (hh : 2 * (h - 1) ≤ R - finrank (ZMod 2) (rad A)) :
    (isoCount A h : ℝ) * 2 ^ h.choose 2 ≤
      15 / 8 * ({H : Submodule (ZMod 2) (Fin R → ZMod 2) | finrank (ZMod 2) H = h}.ncard : ℝ) := by
  have := isoCount_saturated_of_le hA hh
  rwa [ZMod.card, Nat.cast_ofNat] at this

end Final

end OMA.SimsLite.Alt2


/-! # N2A: Li-Qiao Lemma 9.1, Prop 9.2, Prop 10.1 and Thm 7.1 (i) at `p = 2`

Li-Qiao (arXiv:2610.14509v3), Part II, Sec. 9-11 (pp. 51-53, 66-67), pure linear algebra over
`F_2 = ZMod 2` (Lemma 9.1 over any field).  `X = Fin R → F`, `Alt(X) = altSub F R`, and a space
of alternating forms is a submodule `𝒜 ≤ altSub`.  Hypothesis N2A of the plan.

* `lemma91` (Lemma 9.1, minimum dimension): an `h`-hollowing `𝒜` (with `h ≤ dim X`) has
  `dim 𝒜 ≥ h`.  Proof as in the paper: a basis of `𝒜` is a surjective alternating tuple `β` with
  `A_β = 𝒜`; Prop 7.2 (ii) (`prop72_ii`) gives `h < s(β)` and BNV 5.2 (`simsRk_le_succ`) gives
  `s(β) ≤ dim 𝒜 + 1`.
* `hollowSet R M h` : the set `H_2(R, M, h)` of `M`-dimensional `h`-hollowing subspaces of
  `Alt(F_2^R)`.
* `hollow_lowrank_dim` (the covering step (104)-(105) of the proof of Prop 9.2): with the cutoff
  `a` satisfying either `M + 6 ≤ κ_h(a+1)` or (`h = a + 2` and `M + 1 ≤ C(h,2)`), the forms of
  rank `≤ 2a` in an `h`-hollowing `M`-space span a space of dimension `k_a ≥ h - 10`.  This uses
  Lemma 8.2 (95) (`isoCount_uniform_of_le`, constant `32`) for all forms and (96)
  (`isoCount_saturated_two_of_le`, `γ_2 ≤ 15/8`) for the forms of rank `≥ 2h - 2` at the
  endpoint cutoff `a = h - 2`.
* `exists_cutoff` : the choice of `a` (least `a` with `κ_h(a+1) ≥ M + 6`, else `a = h - 2`),
  with `a h ≤ 2M + 12` (the paper's `h a = O(M)`).
* `prop92` (Prop 9.2 at `q = 2` with explicit constant): for `h ≤ R` and `M ≤ C(h,2) - 1`,
  `|H_2(R, M, h)| ≤ 2^((M - h) C(R,2) + 40 (R^2 + M^2))`.  The counting is the paper's: every
  space is spanned by `h - 10` forms of rank `≤ 2a` (Lemma 2.7 (ii), `ncard_alt_rank_le`) and
  `M - (h - 10)` arbitrary alternating forms (`n2a_exists_tuple`, a greedy extension).
* `nonminSet`, `prop101` (Prop 10.1, nonminimal endpoint spaces, `M = C(h,2)`):
  `|A^nonmin_M| ≤ 2^((M - h) C(R,2) + 40 (R^2 + M^2))`.  A nonminimal `h`-hollowing `M`-space
  contains an `h`-hollowing hyperplane (hollowing is inherited upwards), counted by `prop92`, and
  is that hyperplane plus one form (`2^C(R,2)` choices).  This replaces the paper's Gaussian
  binomial count of overspaces of the minimal `B` by the one-step version.
* `N2_le_hollow` (the inequality of (123)): `N_2(r1, r2, s) ≤ |H_2(r1, r2, s-1)| · 2^(r2^2)`
  (`|GL_r2(2)| ≤ 2^(r2^2)` replaced by the count of coordinate tuples in a fixed basis).
* `thm71_i` (Thm 7.1 (i) at `p = 2`, explicit constant `41`): for `2 ≤ s ≤ r1`,
  `s - 1 ≤ r2 < C(s-1, 2)`,
  `logN2 r1 r2 s ≤ (r2 - s + 1) C(r1, 2) + 41 (r1^2 + r2^2)`; `thm71_i_exists` is the
  `O(r1^2 + r2^2)` form.

Auxiliary: `n2a_finrank_span_sup`, `n2a_exists_tuple`, `n2a_ncard_le_of_subset_range`,
`n2a_ncard_biUnion_le`, `n2a_card_filter_mem`, `n2a_two_le_rank`, `n2a_isHollowing_mono`,
`lowAlt`, `n2a_exp_le`, `nonmin_decomp`, `n2a_logb_le`, `n2a_finite_submodule`.
-/

namespace OMA.SimsLite.Alt2

open Module

/-! ### Generic linear algebra and counting helpers -/

section Helpers

variable {F V : Type*} [Field F] [AddCommGroup V] [Module F V]

lemma n2a_finrank_span_sup [FiniteDimensional F V] {P : Submodule F V} {y : V} (hy : y ∉ P) :
    finrank F ↥(Submodule.span F {y} ⊔ P) = finrank F P + 1 := by
  have hy0 : y ≠ 0 := fun h => hy (h ▸ P.zero_mem)
  have hinf : Submodule.span F {y} ⊓ P = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    obtain ⟨hz1, hz2⟩ := Submodule.mem_inf.1 hz
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hz1
    by_cases hc : c = 0
    · simp [hc]
    · exfalso
      apply hy
      have := P.smul_mem c⁻¹ hz2
      rwa [smul_smul, inv_mul_cancel₀ hc, one_smul] at this
  have := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span F {y}) P
  rw [hinf, finrank_bot, finrank_span_singleton hy0] at this
  omega

/-- Greedy extension: if `U ⊔ span S` has dimension at least `dim U + k`, then `k` vectors of `S`
extend `U` by exactly `k` dimensions. -/
theorem n2a_exists_tuple [FiniteDimensional F V] (S : Set V) : ∀ (k : ℕ) (U : Submodule F V),
    finrank F U + k ≤ finrank F ↥(U ⊔ Submodule.span F S) →
      ∃ w : Fin k → V, (∀ i, w i ∈ S) ∧
        finrank F ↥(U ⊔ Submodule.span F (Set.range w)) = finrank F U + k := by
  intro k
  induction k with
  | zero =>
    intro U _
    refine ⟨Fin.elim0, fun i => i.elim0, ?_⟩
    rw [Set.range_eq_empty, Submodule.span_empty, sup_bot_eq, add_zero]
  | succ k ih =>
    intro U hU
    obtain ⟨x, hxS, hxU⟩ : ∃ x ∈ S, x ∉ U := by
      by_contra hcon
      push_neg at hcon
      have hle : Submodule.span F S ≤ U := Submodule.span_le.2 hcon
      rw [sup_eq_left.2 hle] at hU
      omega
    have hU' := n2a_finrank_span_sup (F := F) hxU
    have hsup : (Submodule.span F {x} ⊔ U) ⊔ Submodule.span F S = U ⊔ Submodule.span F S := by
      have hx : Submodule.span F {x} ≤ Submodule.span F S :=
        Submodule.span_mono (Set.singleton_subset_iff.2 hxS)
      apply le_antisymm
      · exact sup_le (sup_le (hx.trans le_sup_right) le_sup_left) le_sup_right
      · exact sup_le (le_sup_right.trans le_sup_left) le_sup_right
    obtain ⟨w, hwS, hw⟩ := ih (Submodule.span F {x} ⊔ U) (by rw [hsup, hU']; omega)
    refine ⟨Fin.cons x w, ?_, ?_⟩
    · intro i
      cases i using Fin.cases with
      | zero => simpa using hxS
      | succ j => simpa using hwS j
    · have he : U ⊔ Submodule.span F (Set.range (Fin.cons x w : Fin (k + 1) → V)) =
          (Submodule.span F {x} ⊔ U) ⊔ Submodule.span F (Set.range w) := by
        rw [Fin.range_cons, Submodule.span_insert, ← sup_assoc, sup_comm U]
      rw [he, hw, hU']
      omega

/-- A set covered by the range of a map from a finite type has at most that many elements. -/
lemma n2a_ncard_le_of_subset_range {α β : Type*} [Finite α] (g : α → β) {S : Set β}
    (h : S ⊆ Set.range g) : S.ncard ≤ Nat.card α := by
  calc S.ncard ≤ (Set.range g).ncard := Set.ncard_le_ncard h (Set.finite_range g)
    _ ≤ (Set.univ : Set α).ncard := by
        rw [← Set.image_univ]
        exact Set.ncard_image_le (Set.toFinite _)
    _ = Nat.card α := by rw [Set.ncard_univ]

/-- Union bound. -/
lemma n2a_ncard_biUnion_le {ι α : Type*} [DecidableEq ι] (I : Finset ι) (T : ι → Set α) :
    (⋃ i ∈ I, T i).ncard ≤ ∑ i ∈ I, (T i).ncard := by
  refine Finset.induction_on I ?_ ?_
  · simp
  · intro a J ha ih
    rw [Finset.set_biUnion_insert, Finset.sum_insert ha]
    exact (Set.ncard_union_le _ _).trans (Nat.add_le_add_left ih _)

/-- Submodules of a finite module form a finite type. -/
lemma n2a_finite_submodule [Finite V] : Finite (Submodule F V) :=
  Finite.of_injective (fun p : Submodule F V => fun x : V => x ∈ p)
    (fun _ _ hpq => SetLike.ext fun x => Iff.of_eq (congrFun hpq x))

/-- `n ≤ 2 ^ k` gives `log_2 n ≤ k` in the reals. -/
theorem n2a_logb_le {n k : ℕ} (h : n ≤ 2 ^ k) : Real.logb 2 (n : ℝ) ≤ k := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  · have h1 : (n : ℝ) ≤ (2 : ℝ) ^ (k : ℝ) := by
      rw [Real.rpow_natCast]
      exact_mod_cast h
    have h2 : Real.logb 2 (n : ℝ) ≤ Real.logb 2 ((2 : ℝ) ^ (k : ℝ)) :=
      Real.logb_le_logb_of_le (by norm_num) (by exact_mod_cast hn) h1
    rwa [Real.logb_rpow (by norm_num) (by norm_num)] at h2

end Helpers

/-! ### Lemma 9.1 -/

section Lemma91

variable {F : Type*} [Field F] {R : ℕ}

lemma n2a_isHollowing_mono {𝒝 𝒜 : Submodule F (Matrix (Fin R) (Fin R) F)} {h : ℕ}
    (hle : 𝒝 ≤ 𝒜) (hB : IsHollowing 𝒝 h) : IsHollowing 𝒜 h := by
  intro H hH
  obtain ⟨A, hA, h0, hi⟩ := hB H hH
  exact ⟨A, hle hA, h0, hi⟩

/-- **Lemma 9.1** (minimum dimension): if `𝒜 ≤ Alt(X)` is `h`-hollowing with `h ≤ dim X`, then
`dim 𝒜 ≥ h`. -/
theorem lemma91 (𝒜 : Submodule F (Matrix (Fin R) (Fin R) F)) {h : ℕ} (hh : h ≤ R)
    (hA : IsHollowing 𝒜 h) : h ≤ finrank F 𝒜 := by
  obtain ⟨M, hM⟩ : ∃ M, finrank F 𝒜 = M := ⟨_, rfl⟩
  rw [hM]
  let b : Basis (Fin M) F 𝒜 := Module.finBasisOfFinrankEq F 𝒜 hM
  let β : Fin M → Matrix (Fin R) (Fin R) F := fun k => (b k : Matrix (Fin R) (Fin R) F)
  have hβ : LinearIndependent F β := b.linearIndependent.map' 𝒜.subtype (by simp)
  have hspan : dualSpan β = 𝒜 := by
    have h1 := congrArg (Submodule.map 𝒜.subtype) b.span_eq
    rw [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp] at h1
    exact h1
  have h2 := (prop72_ii β hβ h hh).1 (by rw [hspan]; exact hA)
  have h3 := simsRk_le_succ β ((gensOn_top_iff β).2 hβ)
  omega

end Lemma91

/-! ### Prop 9.2 over `F_2` -/

section Prop92

open Classical

variable {R : ℕ}

/-- `H_2(R, M, h)`: the `M`-dimensional `h`-hollowing subspaces of `Alt(F_2^R)`. -/
def hollowSet (R M h : ℕ) : Set (Submodule (ZMod 2) (Matrix (Fin R) (Fin R) (ZMod 2))) :=
  {𝒜 | 𝒜 ≤ altSub (ZMod 2) R ∧ finrank (ZMod 2) 𝒜 = M ∧ IsHollowing 𝒜 h}

lemma mem_hollowSet {M h : ℕ} {𝒜 : Submodule (ZMod 2) (Matrix (Fin R) (Fin R) (ZMod 2))} :
    𝒜 ∈ hollowSet R M h ↔
      𝒜 ≤ altSub (ZMod 2) R ∧ finrank (ZMod 2) 𝒜 = M ∧ IsHollowing 𝒜 h := Iff.rfl

/-- The alternating forms of rank at most `ρ` (`dim rad ≥ R - ρ`), as in `ncard_alt_rank_le`. -/
def lowAlt (R ρ : ℕ) : Set (Matrix (Fin R) (Fin R) (ZMod 2)) :=
  {A | IsAltMat A ∧ R - ρ ≤ finrank (ZMod 2) (rad A)}

lemma n2a_card_filter_mem {F : Type*} [Field F] [Fintype F]
    (P : Submodule F (Matrix (Fin R) (Fin R) F)) :
    (Finset.univ.filter (fun y => y ∈ P)).card = Fintype.card F ^ finrank F P := by
  rw [← Fintype.card_subtype]
  convert Module.card_eq_pow_finrank (K := F) (V := P)

/-- A nonzero alternating form has rank at least `2`. -/
lemma n2a_two_le_rank {F : Type*} [Field F] [Fintype F] {A : Matrix (Fin R) (Fin R) F}
    (hA : IsAltMat A) (h0 : A ≠ 0) : 2 * 1 ≤ R - finrank F (rad A) := by
  have hle : finrank F (rad A) ≤ R := by
    have := Submodule.finrank_le (rad A)
    rwa [Module.finrank_fin_fun] at this
  have hlt : finrank F (rad A) < R := by
    rcases lt_or_eq_of_le hle with h | h
    · exact h
    · exfalso
      apply h0
      have htop : rad A = ⊤ := Submodule.eq_top_of_finrank_eq (by rw [h, Module.finrank_fin_fun])
      apply (isotropic_top_iff A).1
      intro x _ y _
      exact bfL_rad_left (by rw [htop]; exact Submodule.mem_top) y
  obtain ⟨a, ha⟩ := exists_finrank_rad_add_two_mul hA
  omega

/-- The covering step of Prop 9.2, (104)-(105): at a cutoff `a` with either
`M + 6 ≤ κ_h(a+1)`, or `h = a + 2` and `M + 1 ≤ C(h,2)`, the forms of rank `≤ 2a` in an
`h`-hollowing `M`-space `𝒜 ≤ Alt(F_2^R)` span a subspace of dimension `≥ h - 10`. -/
theorem hollow_lowrank_dim {M h a : ℕ}
    {𝒜 : Submodule (ZMod 2) (Matrix (Fin R) (Fin R) (ZMod 2))}
    (hAlt : 𝒜 ≤ altSub (ZMod 2) R) (hM : finrank (ZMod 2) 𝒜 = M) (hH : IsHollowing 𝒜 h)
    (hhR : h ≤ R) (h1 : 1 ≤ h)
    (hcase : M + 6 ≤ kappaH h (a + 1) ∨ (h = a + 2 ∧ M + 1 ≤ h.choose 2)) :
    h ≤ finrank (ZMod 2) (Submodule.span (ZMod 2)
      {A | A ∈ 𝒜 ∧ R - finrank (ZMod 2) (rad A) ≤ 2 * a}) + 10 := by
  obtain ⟨k, hk⟩ : ∃ k, finrank (ZMod 2) (Submodule.span (ZMod 2)
      {A | A ∈ 𝒜 ∧ R - finrank (ZMod 2) (rad A) ≤ 2 * a}) = k := ⟨_, rfl⟩
  rw [hk]
  obtain ⟨G, hG⟩ : ∃ G : ℝ,
      G = ({H : Submodule (ZMod 2) (Fin R → ZMod 2) | finrank (ZMod 2) H = h}.ncard : ℝ) :=
    ⟨_, rfl⟩
  have hGpos : 0 < G := by
    rw [hG]
    have h0 : 0 < Nat.card (ZMod 2) ^ (h * (R - h)) := pow_pos Nat.card_pos _
    have := h0.trans_le (pow_le_ncard_grass (F := ZMod 2) hhR)
    exact_mod_cast this
  let T1 := Finset.univ.filter (fun A : Matrix (Fin R) (Fin R) (ZMod 2) =>
    A ∈ 𝒜 ∧ A ≠ 0 ∧ R - finrank (ZMod 2) (rad A) ≤ 2 * a)
  let T2 := Finset.univ.filter (fun A : Matrix (Fin R) (Fin R) (ZMod 2) =>
    A ∈ 𝒜 ∧ A ≠ 0 ∧ ¬ (R - finrank (ZMod 2) (rad A) ≤ 2 * a))
  -- the covering (104)
  have hcovN : {H : Submodule (ZMod 2) (Fin R → ZMod 2) | finrank (ZMod 2) H = h}.ncard ≤
      ∑ A ∈ T1, isoCount A h + ∑ A ∈ T2, isoCount A h := by
    have hsub : {H : Submodule (ZMod 2) (Fin R → ZMod 2) | finrank (ZMod 2) H = h} ⊆
        (⋃ A ∈ T1, isoLocus A h) ∪ (⋃ A ∈ T2, isoLocus A h) := by
      intro H hHd
      obtain ⟨A, hA, h0, hiso⟩ := hH H hHd
      by_cases hlow : R - finrank (ZMod 2) (rad A) ≤ 2 * a
      · left
        exact Set.mem_iUnion₂.2 ⟨A, Finset.mem_filter.2 ⟨Finset.mem_univ _, hA, h0, hlow⟩,
          show H ∈ isoLocus A h from ⟨hHd, hiso⟩⟩
      · right
        exact Set.mem_iUnion₂.2 ⟨A, Finset.mem_filter.2 ⟨Finset.mem_univ _, hA, h0, hlow⟩,
          show H ∈ isoLocus A h from ⟨hHd, hiso⟩⟩
    have hfin : ((⋃ A ∈ T1, isoLocus A h) ∪ (⋃ A ∈ T2, isoLocus A h)).Finite := by
      refine (grass_finite (F := ZMod 2) R h).subset ?_
      intro H hH
      rcases hH with hH | hH
      · obtain ⟨A, -, hA⟩ := Set.mem_iUnion₂.1 hH
        exact hA.1
      · obtain ⟨A, -, hA⟩ := Set.mem_iUnion₂.1 hH
        exact hA.1
    calc _ ≤ ((⋃ A ∈ T1, isoLocus A h) ∪ (⋃ A ∈ T2, isoLocus A h)).ncard :=
          Set.ncard_le_ncard hsub hfin
      _ ≤ (⋃ A ∈ T1, isoLocus A h).ncard + (⋃ A ∈ T2, isoLocus A h).ncard :=
          Set.ncard_union_le _ _
      _ ≤ _ := Nat.add_le_add (n2a_ncard_biUnion_le T1 _) (n2a_ncard_biUnion_le T2 _)
  have hcov : G ≤ (∑ A ∈ T1, (isoCount A h : ℝ)) + ∑ A ∈ T2, (isoCount A h : ℝ) := by
    rw [hG]
    exact_mod_cast hcovN
  -- the low-rank forms: each covers at most `32 · 2^(1-h)` of the Grassmannian
  have hT1 : ∀ A ∈ T1, (isoCount A h : ℝ) * 2 ^ (h - 1) ≤ 32 * G := by
    intro A hA
    obtain ⟨-, hA𝒜, h0, -⟩ := Finset.mem_filter.1 hA
    have hAlt' : IsAltMat A := mem_altSub.1 (hAlt hA𝒜)
    have := isoCount_uniform_of_le hAlt' (n2a_two_le_rank hAlt' h0) h
    rwa [ZMod.card, Nat.cast_ofNat, kappaH_one, ← hG] at this
  have hT1card : (T1.card : ℝ) ≤ 2 ^ k := by
    have : T1.card ≤ 2 ^ k := by
      calc T1.card ≤ (Finset.univ.filter (fun y => y ∈ Submodule.span (ZMod 2)
              {A | A ∈ 𝒜 ∧ R - finrank (ZMod 2) (rad A) ≤ 2 * a})).card :=
            Finset.card_le_card (fun A hA => by
              obtain ⟨-, hA𝒜, -, hlow⟩ := Finset.mem_filter.1 hA
              exact Finset.mem_filter.2 ⟨Finset.mem_univ _,
                Submodule.subset_span (show A ∈ {A | A ∈ 𝒜 ∧
                  R - finrank (ZMod 2) (rad A) ≤ 2 * a} from ⟨hA𝒜, hlow⟩)⟩)
        _ = 2 ^ k := by rw [n2a_card_filter_mem, ZMod.card, hk]
    exact_mod_cast this
  -- the high-rank forms
  have hT2rank : ∀ A ∈ T2, IsAltMat A ∧ 2 * (a + 1) ≤ R - finrank (ZMod 2) (rad A) := by
    intro A hA
    obtain ⟨-, hA𝒜, -, hhi⟩ := Finset.mem_filter.1 hA
    have hAlt' : IsAltMat A := mem_altSub.1 (hAlt hA𝒜)
    obtain ⟨b, hb⟩ := exists_finrank_rad_add_two_mul hAlt'
    exact ⟨hAlt', by omega⟩
  have hT2card : (T2.card : ℝ) ≤ 2 ^ M := by
    have : T2.card ≤ 2 ^ M := by
      calc T2.card ≤ (Finset.univ.filter (fun y => y ∈ 𝒜)).card :=
            Finset.card_le_card (fun A hA =>
              Finset.mem_filter.2 ⟨Finset.mem_univ _, (Finset.mem_filter.1 hA).2.1⟩)
        _ = 2 ^ M := by rw [n2a_card_filter_mem, ZMod.card, hM]
    exact_mod_cast this
  have hS2 : ∑ A ∈ T2, (isoCount A h : ℝ) ≤ 15 / 16 * G := by
    rcases hcase with hbig | ⟨hha, hMh⟩
    · have hterm : ∀ A ∈ T2, (isoCount A h : ℝ) * 2 ^ kappaH h (a + 1) ≤ 32 * G := by
        intro A hA'
        obtain ⟨hAlt', hr⟩ := hT2rank A hA'
        have := isoCount_uniform_of_le hAlt' hr h
        rwa [ZMod.card, Nat.cast_ofNat, ← hG] at this
      have hsum : (∑ A ∈ T2, (isoCount A h : ℝ)) * 2 ^ kappaH h (a + 1) ≤
          T2.card * (32 * G) := by
        rw [Finset.sum_mul]
        calc _ ≤ ∑ A ∈ T2, 32 * G := Finset.sum_le_sum hterm
          _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
      have hpow : (2 : ℝ) ^ M * 64 ≤ 2 ^ kappaH h (a + 1) := by
        have h' : 2 ^ (M + 6) ≤ 2 ^ kappaH h (a + 1) := Nat.pow_le_pow_right (by norm_num) hbig
        have h'' : (2 : ℝ) ^ (M + 6) ≤ (2 : ℝ) ^ kappaH h (a + 1) := by exact_mod_cast h'
        have h64 : (2 : ℝ) ^ 6 = 64 := by norm_num
        rw [pow_add, h64] at h''
        exact h''
      have hZ : (0 : ℝ) < 2 ^ kappaH h (a + 1) := by positivity
      have h3 : (T2.card : ℝ) * (32 * G) ≤ 2 ^ M * (32 * G) :=
        mul_le_mul_of_nonneg_right hT2card (by linarith)
      have h4 : (2 : ℝ) ^ M * 64 * G ≤ 2 ^ kappaH h (a + 1) * G :=
        mul_le_mul_of_nonneg_right hpow hGpos.le
      have key : (∑ A ∈ T2, (isoCount A h : ℝ)) * 2 ^ kappaH h (a + 1) ≤
          (G / 2) * 2 ^ kappaH h (a + 1) := by
        linarith
      have := le_of_mul_le_mul_right key hZ
      linarith
    · have hterm : ∀ A ∈ T2, (isoCount A h : ℝ) * 2 ^ h.choose 2 ≤ 15 / 8 * G := by
        intro A hA'
        obtain ⟨hAlt', hr⟩ := hT2rank A hA'
        have := isoCount_saturated_two_of_le hAlt' (h := h) (by omega)
        rwa [← hG] at this
      have hsum : (∑ A ∈ T2, (isoCount A h : ℝ)) * 2 ^ h.choose 2 ≤
          T2.card * (15 / 8 * G) := by
        rw [Finset.sum_mul]
        calc _ ≤ ∑ A ∈ T2, 15 / 8 * G := Finset.sum_le_sum hterm
          _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
      have hpow : (2 : ℝ) ^ M * 2 ≤ 2 ^ h.choose 2 := by
        have h' : 2 ^ (M + 1) ≤ 2 ^ h.choose 2 := Nat.pow_le_pow_right (by norm_num) hMh
        have h'' : (2 : ℝ) ^ (M + 1) ≤ (2 : ℝ) ^ h.choose 2 := by exact_mod_cast h'
        rwa [pow_succ] at h''
      have hZ : (0 : ℝ) < 2 ^ h.choose 2 := by positivity
      have h3 : (T2.card : ℝ) * (15 / 8 * G) ≤ 2 ^ M * (15 / 8 * G) :=
        mul_le_mul_of_nonneg_right hT2card (by linarith)
      have h4 : (2 : ℝ) ^ M * 2 * G ≤ 2 ^ h.choose 2 * G :=
        mul_le_mul_of_nonneg_right hpow hGpos.le
      have key : (∑ A ∈ T2, (isoCount A h : ℝ)) * 2 ^ h.choose 2 ≤
          (15 / 16 * G) * 2 ^ h.choose 2 := by
        linarith
      exact le_of_mul_le_mul_right key hZ
  -- conclusion of (105)
  have hS1 : (∑ A ∈ T1, (isoCount A h : ℝ)) * 2 ^ (h - 1) ≤ T1.card * (32 * G) := by
    rw [Finset.sum_mul]
    calc _ ≤ ∑ A ∈ T1, 32 * G := Finset.sum_le_sum hT1
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
  have hX0 : (0 : ℝ) < 2 ^ (h - 1) := by positivity
  have hS1' : G / 16 ≤ ∑ A ∈ T1, (isoCount A h : ℝ) := by linarith
  have h5 : G / 16 * 2 ^ (h - 1) ≤ (∑ A ∈ T1, (isoCount A h : ℝ)) * 2 ^ (h - 1) :=
    mul_le_mul_of_nonneg_right hS1' hX0.le
  have h6 : (T1.card : ℝ) * (32 * G) ≤ 2 ^ k * (32 * G) :=
    mul_le_mul_of_nonneg_right hT1card (by linarith)
  have h7 : G * 2 ^ (h - 1) ≤ G * (512 * 2 ^ k) := by linarith
  have h8 : (2 : ℝ) ^ (h - 1) ≤ 512 * 2 ^ k := le_of_mul_le_mul_left h7 hGpos
  have h9 : (2 : ℝ) ^ h ≤ 2 ^ (k + 10) := by
    have e1 : (2 : ℝ) ^ h = 2 * 2 ^ (h - 1) := by
      rw [← pow_succ', Nat.sub_add_cancel h1]
    have h1024 : (2 : ℝ) ^ 10 = 1024 := by norm_num
    rw [e1, pow_add, h1024]
    linarith
  have h10 : 2 ^ h ≤ 2 ^ (k + 10) := by exact_mod_cast h9
  exact (Nat.pow_le_pow_iff_right (by norm_num)).1 h10

lemma n2a_cutoff_bound {h M a : ℕ} (ha : a ≤ h - 2) (hmin : 1 ≤ a → kappaH h a < M + 6) :
    a * h ≤ 2 * M + 12 := by
  rcases Nat.eq_zero_or_pos a with h0 | hpos
  · rw [h0, zero_mul]
    omega
  · have hk := hmin hpos
    have h2k := two_mul_kappaH h a
    rw [min_eq_left (by omega : a ≤ h - 1)] at h2k
    have hmul : a * (h + 1) ≤ a * (2 * h - a - 1) := Nat.mul_le_mul_left _ (by omega)
    have he : a * (h + 1) = a * h + a := by ring
    omega

/-- The cutoff of the proof of Prop 9.2: the least `a` with `κ_h(a+1) ≥ M + 6` if
`C(h,2) ≥ M + 6`, else `a = h - 2`; in both cases `a h ≤ 2M + 12`. -/
theorem exists_cutoff {h M : ℕ} (h2 : 2 ≤ h) (hM : M + 1 ≤ h.choose 2) :
    ∃ a : ℕ, (M + 6 ≤ kappaH h (a + 1) ∨ (h = a + 2 ∧ M + 1 ≤ h.choose 2)) ∧
      a * h ≤ 2 * M + 12 := by
  by_cases hbig : M + 6 ≤ h.choose 2
  · have hw : M + 6 ≤ kappaH h (h - 2 + 1) := by
      rw [kappaH_of_le (by omega)]
      exact hbig
    have hex : ∃ a, M + 6 ≤ kappaH h (a + 1) := ⟨h - 2, hw⟩
    refine ⟨Nat.find hex, Or.inl (Nat.find_spec hex), ?_⟩
    have hle : Nat.find hex ≤ h - 2 := Nat.find_min' hex hw
    apply n2a_cutoff_bound hle
    intro hpos
    have hmin : ¬ (M + 6 ≤ kappaH h (Nat.find hex - 1 + 1)) := Nat.find_min hex (by omega)
    rw [Nat.sub_add_cancel hpos] at hmin
    omega
  · refine ⟨h - 2, Or.inr ⟨by omega, hM⟩, ?_⟩
    have t1 := two_mul_choose_two_add h
    have t2 : (h - 2) * h + 2 * h = h * h := by
      rw [← Nat.add_mul, Nat.sub_add_cancel h2]
    omega

lemma n2a_exp_le {M h a ρ : ℕ} (hρ : ρ ≤ 2 * a) (hρR : ρ ≤ R) (hah : a * h ≤ 2 * M + 12)
    (hhR : h ≤ R) (hhM : h ≤ M) :
    (R + ((R - ρ) * ρ + ρ.choose 2)) * (h - 10) + R.choose 2 * (M - (h - 10)) ≤
      (M - h) * R.choose 2 + 40 * (R ^ 2 + M ^ 2) := by
  have e1 : (R - ρ) * ρ + ρ.choose 2 ≤ R * ρ := by
    have t1 := two_mul_choose_two_add ρ
    have t2 : (R - ρ) * ρ + ρ * ρ = R * ρ := by rw [← Nat.add_mul, Nat.sub_add_cancel hρR]
    omega
  have e2 : (R + ((R - ρ) * ρ + ρ.choose 2)) * (h - 10) ≤ (R + R * ρ) * h :=
    Nat.mul_le_mul (Nat.add_le_add_left e1 R) (Nat.sub_le h 10)
  have e3 : (R + R * ρ) * h ≤ R * R + 2 * R * (2 * M + 12) := by
    have t1 : R * h ≤ R * R := Nat.mul_le_mul_left R hhR
    have t2 : R * ρ * h ≤ R * (2 * a) * h := Nat.mul_le_mul_right h (Nat.mul_le_mul_left R hρ)
    have t3 : R * (2 * a) * h = 2 * R * (a * h) := by ring
    have t4 : 2 * R * (a * h) ≤ 2 * R * (2 * M + 12) := Nat.mul_le_mul_left _ hah
    have t5 : (R + R * ρ) * h = R * h + R * ρ * h := by ring
    omega
  have e4 : R.choose 2 * (M - (h - 10)) ≤ (M - h) * R.choose 2 + 10 * (R * R) := by
    have hs : M - (h - 10) = (M - h) + (h - (h - 10)) := by omega
    have t1 : R.choose 2 * (M - (h - 10)) =
        (M - h) * R.choose 2 + (h - (h - 10)) * R.choose 2 := by
      rw [hs, Nat.mul_add, mul_comm (R.choose 2) (M - h), mul_comm (R.choose 2) (h - (h - 10))]
    have t2 : (h - (h - 10)) * R.choose 2 ≤ 10 * (R * R) := by
      have := two_mul_choose_two_add R
      exact Nat.mul_le_mul (by omega) (by omega)
    omega
  have e5 : 2 * R * M ≤ R ^ 2 + M ^ 2 := by
    have : ((2 * R * M : ℕ) : ℤ) ≤ ((R ^ 2 + M ^ 2 : ℕ) : ℤ) := by
      push_cast
      nlinarith [sq_nonneg ((R : ℤ) - M)]
    exact_mod_cast this
  have e6 : R ≤ R * R := Nat.le_mul_self R
  have e7 : R ^ 2 = R * R := sq R
  have e8 : 2 * R * (2 * M + 12) = 2 * (2 * R * M) + 24 * R := by ring
  omega

/-- **Prop 9.2** at `q = 2` (explicit constant): for `h ≤ R` and `M ≤ C(h,2) - 1`,
`|H_2(R, M, h)| ≤ 2^((M - h) C(R,2) + 40 (R^2 + M^2))`, i.e.
`log_2 |H_2(R, M, h)| ≤ (M - h) C(R, 2) + O(R^2 + M^2)` (103). -/
theorem prop92 {M h : ℕ} (hhR : h ≤ R) (hM : M + 1 ≤ h.choose 2) :
    (hollowSet R M h).ncard ≤ 2 ^ ((M - h) * R.choose 2 + 40 * (R ^ 2 + M ^ 2)) := by
  have h2 : 2 ≤ h := by
    by_contra hlt
    push_neg at hlt
    rw [Nat.choose_eq_zero_of_lt hlt] at hM
    omega
  by_cases hhM : h ≤ M
  swap
  · have he : hollowSet R M h = ∅ := by
      ext 𝒜
      simp only [Set.mem_empty_iff_false, iff_false]
      intro h𝒜
      obtain ⟨-, hdim, hH⟩ := mem_hollowSet.1 h𝒜
      have := lemma91 𝒜 hhR hH
      omega
    rw [he, Set.ncard_empty]
    exact Nat.zero_le _
  obtain ⟨a, hcase, hah⟩ := exists_cutoff h2 hM
  let g : (Fin (h - 10) → ↥(lowAlt R (min (2 * a) R))) ×
      (Fin (M - (h - 10)) → ↥(altSub (ZMod 2) R)) →
        Submodule (ZMod 2) (Matrix (Fin R) (Fin R) (ZMod 2)) := fun p =>
    Submodule.span (ZMod 2) (Set.range (fun i => (p.1 i : Matrix (Fin R) (Fin R) (ZMod 2)))) ⊔
      Submodule.span (ZMod 2) (Set.range (fun i => (p.2 i : Matrix (Fin R) (Fin R) (ZMod 2))))
  have hsub : hollowSet R M h ⊆ Set.range g := by
    intro 𝒜 h𝒜
    obtain ⟨hAlt, hdim, hH⟩ := mem_hollowSet.1 h𝒜
    have hk := hollow_lowrank_dim hAlt hdim hH hhR (by omega) hcase
    obtain ⟨v, hvS, hv⟩ := n2a_exists_tuple (F := ZMod 2)
      {A | A ∈ 𝒜 ∧ R - finrank (ZMod 2) (rad A) ≤ 2 * a} (h - 10) ⊥
      (by rw [bot_sup_eq, finrank_bot]; omega)
    rw [bot_sup_eq, finrank_bot, zero_add] at hv
    have hUle : Submodule.span (ZMod 2) (Set.range v) ≤ 𝒜 :=
      Submodule.span_le.2 (Set.range_subset_iff.2 fun i => (hvS i).1)
    obtain ⟨w, hwS, hw⟩ := n2a_exists_tuple (F := ZMod 2) (𝒜 : Set (Matrix (Fin R) (Fin R) (ZMod 2)))
      (M - (h - 10)) (Submodule.span (ZMod 2) (Set.range v))
      (by rw [Submodule.span_eq, sup_eq_right.2 hUle, hv, hdim]; omega)
    have heq : Submodule.span (ZMod 2) (Set.range v) ⊔ Submodule.span (ZMod 2) (Set.range w) =
        𝒜 :=
      Submodule.eq_of_le_of_finrank_eq
        (sup_le hUle (Submodule.span_le.2 (Set.range_subset_iff.2 hwS)))
        (by rw [hw, hv, hdim]; omega)
    have hlow : ∀ i, v i ∈ lowAlt R (min (2 * a) R) := by
      intro i
      have hA : IsAltMat (v i) := mem_altSub.1 (hAlt (hvS i).1)
      have hr := Submodule.finrank_le (rad (v i))
      rw [Module.finrank_fin_fun] at hr
      have h3 := (hvS i).2
      exact ⟨hA, by omega⟩
    exact ⟨(fun i => ⟨v i, hlow i⟩, fun i => ⟨w i, hAlt (hwS i)⟩), heq⟩
  have hLow : (lowAlt R (min (2 * a) R)).ncard ≤
      2 ^ R * 2 ^ ((R - min (2 * a) R) * min (2 * a) R + (min (2 * a) R).choose 2) := by
    have := ncard_alt_rank_le (F := ZMod 2) (R := R) (min (2 * a) R) (min_le_right _ _)
    rw [Nat.card_zmod] at this
    exact this
  calc (hollowSet R M h).ncard
      ≤ Nat.card ((Fin (h - 10) → ↥(lowAlt R (min (2 * a) R))) ×
          (Fin (M - (h - 10)) → ↥(altSub (ZMod 2) R))) := n2a_ncard_le_of_subset_range g hsub
    _ = (lowAlt R (min (2 * a) R)).ncard ^ (h - 10) * (2 ^ R.choose 2) ^ (M - (h - 10)) := by
        rw [Nat.card_prod, Nat.card_fun, Nat.card_fun, Nat.card_fin, Nat.card_fin,
          Nat.card_coe_set_eq, card_altSub, Nat.card_zmod]
    _ ≤ (2 ^ R * 2 ^ ((R - min (2 * a) R) * min (2 * a) R + (min (2 * a) R).choose 2)) ^
          (h - 10) * (2 ^ R.choose 2) ^ (M - (h - 10)) :=
        Nat.mul_le_mul_right _ (Nat.pow_le_pow_left hLow _)
    _ = 2 ^ ((R + ((R - min (2 * a) R) * min (2 * a) R + (min (2 * a) R).choose 2)) *
          (h - 10) + R.choose 2 * (M - (h - 10))) := by
        rw [← pow_add, ← pow_mul, ← pow_mul, ← pow_add]
    _ ≤ _ := Nat.pow_le_pow_right (by norm_num)
        (n2a_exp_le (min_le_left _ _) (min_le_right _ _) hah hhR hhM)

end Prop92

/-! ### Eq. (123) and Thm 7.1 (i) at `p = 2` -/

section Thm71

/-- The inequality of (123): `N_2(r1, r2, s) ≤ |H_2(r1, r2, s - 1)| · 2^(r2^2)`. -/
theorem N2_le_hollow (r1 r2 s : ℕ) (hs : s - 1 ≤ r1) (hs1 : 1 ≤ s) :
    N2 r1 r2 s ≤ (hollowSet r1 r2 (s - 1)).ncard * 2 ^ (r2 * r2) := by
  haveI := n2a_finite_submodule (F := ZMod 2) (V := Matrix (Fin r1) (Fin r1) (ZMod 2))
  let g3 : ↥(hollowSet r1 r2 (s - 1)) × (Fin r2 → Fin r2 → ZMod 2) →
      (Fin r2 → Matrix (Fin r1) (Fin r1) (ZMod 2)) := fun p k =>
    ∑ j, p.2 k j • ((Module.finBasisOfFinrankEq (ZMod 2) p.1.1
      (mem_hollowSet.1 p.1.2).2.1 j : ↥p.1.1) : Matrix (Fin r1) (Fin r1) (ZMod 2))
  have hsub : {β : Fin r2 → Matrix (Fin r1) (Fin r1) (ZMod 2) |
      (∀ k, IsAltMat (β k)) ∧ GensOn β ⊤ ∧ simsRk β = s} ⊆ Set.range g3 := by
    rintro β ⟨hA, hg, hsr⟩
    have hβ : LinearIndependent (ZMod 2) β := (gensOn_top_iff β).1 hg
    have hdim : finrank (ZMod 2) (dualSpan β) = r2 := by
      rw [dualSpan, finrank_span_eq_card hβ, Fintype.card_fin]
    have hmem : dualSpan β ∈ hollowSet r1 r2 (s - 1) := by
      refine mem_hollowSet.2 ⟨Submodule.span_le.2 ?_, hdim, ?_⟩
      · rintro _ ⟨k, rfl⟩
        exact hA k
      · exact (prop72_ii β hβ (s - 1) hs).2 (by omega)
    let b := Module.finBasisOfFinrankEq (ZMod 2) (dualSpan β) (mem_hollowSet.1 hmem).2.1
    have hk : ∀ k, β k ∈ dualSpan β := fun k => Submodule.subset_span ⟨k, rfl⟩
    refine ⟨(⟨dualSpan β, hmem⟩, fun k j => b.repr ⟨β k, hk k⟩ j), ?_⟩
    funext k
    have h1 := congrArg Subtype.val (b.sum_repr ⟨β k, hk k⟩)
    rw [Submodule.coe_sum] at h1
    simp only [Submodule.coe_smul] at h1
    exact h1
  rw [N2_eq_ncard]
  refine (n2a_ncard_le_of_subset_range g3 hsub).trans (le_of_eq ?_)
  rw [Nat.card_prod, Nat.card_coe_set_eq, Nat.card_fun, Nat.card_fun, Nat.card_fin,
    Nat.card_zmod, ← pow_mul]

/-- **Theorem 7.1 (i)** at `p = 2` (explicit constant `41`): for `2 ≤ s ≤ r1` and
`s - 1 ≤ r2 < C(s-1, 2)`, `N_2(r1, r2, s) ≤ (r2 - s + 1) C(r1, 2) + 41 (r1^2 + r2^2)`. -/
theorem thm71_i {r1 r2 s : ℕ} (hs : 2 ≤ s) (hsr : s ≤ r1) (hr2 : s - 1 ≤ r2)
    (hlt : r2 < (s - 1).choose 2) :
    logN2 r1 r2 s ≤
      ((r2 : ℝ) - s + 1) * (r1.choose 2 : ℝ) + 41 * ((r1 : ℝ) ^ 2 + (r2 : ℝ) ^ 2) := by
  have hN := N2_le_hollow r1 r2 s (by omega) (by omega)
  have h92 := prop92 (R := r1) (M := r2) (h := s - 1) (by omega) (by omega)
  obtain ⟨t, ht⟩ : ∃ t, r2 - (s - 1) = t := ⟨_, rfl⟩
  rw [ht] at h92
  have hN' : N2 r1 r2 s ≤ 2 ^ (t * r1.choose 2 + 40 * (r1 ^ 2 + r2 ^ 2) + r2 * r2) := by
    calc N2 r1 r2 s ≤ (hollowSet r1 r2 (s - 1)).ncard * 2 ^ (r2 * r2) := hN
      _ ≤ 2 ^ (t * r1.choose 2 + 40 * (r1 ^ 2 + r2 ^ 2)) * 2 ^ (r2 * r2) :=
          Nat.mul_le_mul_right _ h92
      _ = _ := by rw [← pow_add]
  have htR : (t : ℝ) = (r2 : ℝ) - s + 1 := by
    have e' : t + s = r2 + 1 := by omega
    have e'' : (t : ℝ) + s = r2 + 1 := by exact_mod_cast e'
    linarith
  have hlog := n2a_logb_le hN'
  unfold logN2
  refine hlog.trans ?_
  push_cast
  rw [htR]
  nlinarith [sq_nonneg (r1 : ℝ)]

/-- Thm 7.1 (i) at `p = 2` in the paper's `O(r1^2 + r2^2)` form. -/
theorem thm71_i_exists : ∃ C : ℝ, ∀ r1 r2 s : ℕ, 2 ≤ s → s ≤ r1 → s - 1 ≤ r2 →
    r2 < (s - 1).choose 2 →
      logN2 r1 r2 s ≤ ((r2 : ℝ) - s + 1) * (r1.choose 2 : ℝ) + C * ((r1 : ℝ) ^ 2 + (r2 : ℝ) ^ 2) :=
  ⟨41, fun _ _ _ hs hsr hr2 hlt => thm71_i hs hsr hr2 hlt⟩

end Thm71

section H3Bridge

/-- Theorem 7.1 (i) at `p = 2` as a bound on the natural number `N_2(r1, r2, s)`. -/
theorem thm71_i_nat {r1 r2 s : ℕ} (hs : 2 ≤ s) (hsr : s ≤ r1) (hr2 : s - 1 ≤ r2)
    (hlt : r2 < (s - 1).choose 2) :
    N2 r1 r2 s ≤ 2 ^ ((r2 + 1 - s) * r1.choose 2 + 41 * (r1 ^ 2 + r2 ^ 2)) := by
  have hN := N2_le_hollow r1 r2 s (by omega) (by omega)
  have h92 := prop92 (R := r1) (M := r2) (h := s - 1) (by omega) (by omega)
  have ht : r2 - (s - 1) = r2 + 1 - s := by omega
  rw [ht] at h92
  calc N2 r1 r2 s ≤ (hollowSet r1 r2 (s - 1)).ncard * 2 ^ (r2 * r2) := hN
    _ ≤ 2 ^ ((r2 + 1 - s) * r1.choose 2 + 40 * (r1 ^ 2 + r2 ^ 2)) * 2 ^ (r2 * r2) :=
        Nat.mul_le_mul_right _ h92
    _ = 2 ^ ((r2 + 1 - s) * r1.choose 2 + 40 * (r1 ^ 2 + r2 ^ 2) + r2 * r2) := by
        rw [← pow_add]
    _ ≤ 2 ^ ((r2 + 1 - s) * r1.choose 2 + 41 * (r1 ^ 2 + r2 ^ 2)) := by
        apply Nat.pow_le_pow_right (by norm_num)
        have h1 : r2 * r2 ≤ r1 ^ 2 + r2 ^ 2 := by
          rw [← sq]
          exact Nat.le_add_left _ _
