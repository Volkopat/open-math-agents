namespace TMEngine2

open Finset

/-- One transfer step on weight vectors: `W f N w s = ∑ k < N, w (f s k)`. -/
def W (f : ℕ → ℕ → ℕ) (N : ℕ) (w : ℕ → ℕ) (s : ℕ) : ℕ := ∑ k ∈ range N, w (f s k)

theorem sum_sem {α : Type*} [Fintype α] {N : ℕ} (e : α ≃ Fin N)
    (sem : ∀ n : ℕ, (Fin (n + 1) → α) → ℕ) (f : ℕ → ℕ → ℕ) (ι : ℕ → ℕ)
    (h0 : ∀ x : Fin 1 → α, sem 0 x = ι (e (x 0)))
    (hs : ∀ n (x : Fin (n + 2) → α), sem (n + 1) x = f (sem n (Fin.init x)) (e (x (Fin.last _)))) :
    ∀ n (w : ℕ → ℕ), ∑ x : Fin (n + 1) → α, w (sem n x) = ∑ k ∈ range N, (W f N)^[n] w (ι k) := by
  intro n
  induction n with
  | zero =>
    intro w
    rw [← (Equiv.funUnique (Fin 1) α).symm.sum_comp]
    simp only [Function.iterate_zero, id]
    rw [← Fin.sum_univ_eq_sum_range (fun k => w (ι k)), ← e.sum_comp]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [h0]; rfl
  | succ n ih =>
    intro w
    rw [← (Fin.snocEquiv (fun _ => α)).sum_comp, Fintype.sum_prod_type_right]
    have : ∀ y : Fin (n + 1) → α, ∑ c : α, w (sem (n + 1) ((Fin.snocEquiv fun _ => α) (c, y)))
        = W f N w (sem n y) := by
      intro y
      unfold W
      rw [← Fin.sum_univ_eq_sum_range (fun k => w (f (sem n y) k)), ← e.sum_comp]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [hs, show ((Fin.snocEquiv fun _ => α) (c, y)) = Fin.snoc y c from
        funext fun i => Fin.snocEquiv_apply _ _ i, Fin.init_snoc, Fin.snoc_last]
    simp_rw [this]
    rw [ih, Function.iterate_succ_apply]

/-- Packed table lookup: field `s` of width `B` bits of the number `V`. -/
def pk (B V s : ℕ) : ℕ := V / 2 ^ (B * s) % 2 ^ B

theorem list_sum_filter (l : List ℕ) (w : ℕ → ℕ) (d : ℕ) (hd : w d = 0) :
    ((l.filter (fun t => t != d)).map w).sum = (l.map w).sum := by
  induction l with
  | nil => rfl
  | cons t l ih =>
    by_cases h : t = d
    · subst h; simp [List.filter_cons, hd, ih]
    · simp [List.filter_cons, h, ih]

theorem sum_range_list (N : ℕ) (g : ℕ → ℕ) : ∑ k ∈ range N, g k = ((List.range N).map g).sum := by
  induction N with
  | zero => rfl
  | succ N ih => rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append, List.sum_append]; simp

/-- The transfer step on a live state, through its list of live successors. -/
theorem W_list (f : ℕ → ℕ → ℕ) (N d : ℕ) (w : ℕ → ℕ) (hd : w d = 0) (s : ℕ) (L : List ℕ)
    (hL : ((List.range N).map (f s)).filter (fun t => t != d) = L) :
    W f N w s = (L.map w).sum := by
  unfold W
  rw [← hL, list_sum_filter _ _ _ hd, List.map_map, sum_range_list]
  rfl

theorem iter_dead (f : ℕ → ℕ → ℕ) (N d : ℕ) (hfd : ∀ k < N, f d k = d) (w : ℕ → ℕ) (hw : w d = 0) :
    ∀ j, (W f N)^[j] w d = 0 := by
  intro j
  induction j with
  | zero => exact hw
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    unfold W
    exact Finset.sum_eq_zero fun k hk => by rw [hfd k (Finset.mem_range.mp hk)]; exact ih

section
variable (f : ℕ → ℕ → ℕ) (N d : ℕ) (D : List (ℕ × List ℕ))
  (hD : ∀ p ∈ D, ((List.range N).map (f p.1)).filter (fun t => t != d) = p.2)
  (hcl : ∀ p ∈ D, ∀ t ∈ p.2, t ∈ D.map Prod.fst)
  (hfd : ∀ k < N, f d k = d)

include hD hcl hfd in
theorem iter_table (w : ℕ → ℕ) (hw : w d = 0) (T : ℕ → ℕ → ℕ) (h0 : ∀ p ∈ D, w p.1 = T 0 p.1)
    (J : ℕ) (hT : ∀ j < J, ∀ p ∈ D, (p.2.map (T j)).sum = T (j + 1) p.1) :
    ∀ j ≤ J, ∀ p ∈ D, (W f N)^[j] w p.1 = T j p.1 := by
  intro j
  induction j with
  | zero => intro _ p hp; exact h0 p hp
  | succ j ih =>
    intro hj p hp
    rw [Function.iterate_succ_apply', W_list f N d _ (iter_dead f N d hfd w hw j) p.1 p.2 (hD p hp),
      ← hT j (by omega) p hp]
    congr 1
    apply List.map_congr_left
    intro t ht
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcl p hp t ht)
    exact ih (by omega) q hq

/-- A nonnegative linear combination `∑ c * V (m + i) s` over a list of pairs `(c, i)`. -/
def lin (V : ℕ → ℕ → ℕ) (P : List (ℕ × ℕ)) (m s : ℕ) : ℕ := (P.map fun p => p.1 * V (m + p.2) s).sum

theorem lin_succ (w : ℕ → ℕ) (P : List (ℕ × ℕ)) (m s : ℕ) :
    lin (fun j => (W f N)^[j] w) P (m + 1) s
      = ∑ k ∈ range N, lin (fun j => (W f N)^[j] w) P m (f s k) := by
  induction P with
  | nil => simp [lin]
  | cons p P ih =>
    simp only [lin, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Finset.sum_add_distrib, ← Finset.mul_sum,
      show m + 1 + p.2 = (m + p.2) + 1 by omega, Function.iterate_succ_apply']
    rfl

include hD hcl hfd in
theorem rec_lift (w : ℕ → ℕ) (hw : w d = 0) (P Q : List (ℕ × ℕ)) (m0 : ℕ)
    (hbase : ∀ p ∈ D, lin (fun j => (W f N)^[j] w) P m0 p.1 = lin (fun j => (W f N)^[j] w) Q m0 p.1) :
    ∀ m, m0 ≤ m → ∀ p ∈ D,
      lin (fun j => (W f N)^[j] w) P m p.1 = lin (fun j => (W f N)^[j] w) Q m p.1 := by
  have hlin0 : ∀ (P : List (ℕ × ℕ)) m, lin (fun j => (W f N)^[j] w) P m d = 0 := by
    intro P m
    unfold lin
    apply List.sum_eq_zero
    intro x hx
    obtain ⟨q, _, rfl⟩ := List.mem_map.mp hx
    dsimp only
    rw [iter_dead f N d hfd w hw, mul_zero]
  intro m hm
  induction m, hm using Nat.le_induction with
  | base => exact hbase
  | succ m _ ih =>
    intro p hp
    rw [lin_succ, lin_succ]
    have e1 := W_list f N d (lin (fun j => (W f N)^[j] w) P m) (hlin0 P m) p.1 p.2 (hD p hp)
    have e2 := W_list f N d (lin (fun j => (W f N)^[j] w) Q m) (hlin0 Q m) p.1 p.2 (hD p hp)
    change W f N (lin (fun j => (W f N)^[j] w) P m) p.1 = W f N (lin (fun j => (W f N)^[j] w) Q m) p.1
    rw [e1, e2]
    congr 1
    apply List.map_congr_left
    intro t ht
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcl p hp t ht)
    exact ih q hq
end

theorem lin_sum (V : ℕ → ℕ → ℕ) (ι : ℕ → ℕ) (N : ℕ) (P : List (ℕ × ℕ)) (m : ℕ) :
    (P.map fun p => p.1 * ∑ k ∈ range N, V (m + p.2) (ι k)).sum
      = ∑ k ∈ range N, lin V P m (ι k) := by
  induction P with
  | nil => simp [lin]
  | cons p P ih =>
    simp only [lin, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Finset.sum_add_distrib, Finset.mul_sum]

end TMEngine2

namespace TMEngine2

theorem forall_pair_snoc {n : ℕ} (P : Fin (n + 2) → Fin (n + 2) → Prop) :
    (∀ i j : Fin (n + 2), j.val = i.val + 1 → P i j) ↔
      (∀ i j : Fin (n + 1), j.val = i.val + 1 → P i.castSucc j.castSucc) ∧
        P (Fin.last n).castSucc (Fin.last (n + 1)) := by
  constructor
  · intro H
    exact ⟨fun i j h => H _ _ (by simpa using h), H _ _ (by simp)⟩
  · rintro ⟨H, Hl⟩ i j h
    by_cases hj : j.val < n + 1
    · exact H ⟨i.val, by omega⟩ ⟨j.val, hj⟩ h
    · have hj' : j = Fin.last _ := Fin.ext (by have := j.isLt; simp; omega)
      have hi' : i = (Fin.last n).castSucc := Fin.ext (by simp; omega)
      subst hj' hi'
      exact Hl

theorem forall_triple_snoc {n : ℕ} (P : Fin (n + 2) → Fin (n + 2) → Fin (n + 2) → Prop) :
    (∀ i j l : Fin (n + 2), j.val = i.val + 1 → l.val = j.val + 1 → P i j l) ↔
      (∀ i j l : Fin (n + 1), j.val = i.val + 1 → l.val = j.val + 1 → P i.castSucc j.castSucc l.castSucc) ∧
        (∀ i j : Fin (n + 2), j.val = i.val + 1 → j.val = n → P i j (Fin.last (n + 1))) := by
  constructor
  · intro H
    refine ⟨fun i j l h1 h2 => H _ _ _ (by simpa using h1) (by simpa using h2), fun i j h1 h2 => H _ _ _ h1 ?_⟩
    simp; omega
  · rintro ⟨H, Hl⟩ i j l h1 h2
    by_cases hl : l.val < n + 1
    · exact H ⟨i.val, by omega⟩ ⟨j.val, by omega⟩ ⟨l.val, hl⟩ h1 h2
    · have hl' : l = Fin.last _ := Fin.ext (by have := l.isLt; simp; omega)
      subst hl'
      exact Hl i j h1 (by simp at h2; omega)

end TMEngine2

namespace A224392P

open Finset TMEngine2 OMA.S_oeis_a224392

abbrev Col := Fin 4 × Fin 4 × Fin 4
abbrev St := Option (Option (Fin 4 × Fin 4) × Col)

def encC (c : Col) : ℕ := c.1.val + 4 * c.2.1.val + 16 * c.2.2.val

def enc : St → ℕ
  | none => 1088
  | some (none, c) => encC c
  | some (some (u0, u2), c) => encC c + 64 * (1 + u0.val + 4 * u2.val)

def decC (k : ℕ) : Col :=
  (⟨k % 4, Nat.mod_lt _ (by norm_num)⟩, ⟨k / 4 % 4, Nat.mod_lt _ (by norm_num)⟩,
    ⟨k / 16 % 4, Nat.mod_lt _ (by norm_num)⟩)

def dec (s : ℕ) : St :=
  if s < 64 then some (none, decC s)
  else if s < 1088 then
    some (some (⟨(s / 64 - 1) % 4, Nat.mod_lt _ (by norm_num)⟩, ⟨(s / 64 - 1) / 4 % 4, Nat.mod_lt _ (by norm_num)⟩),
      decC s)
  else none

set_option maxRecDepth 100000 in
theorem dec_enc : ∀ t : St, dec (enc t) = t := by decide

def vec (c : Col) : Fin 3 → Fin 4 := ![c.1, c.2.1, c.2.2]

def LOK (_c : Col) : Prop := True

instance (c : Col) : Decidable (LOK c) := inferInstanceAs (Decidable True)

instance (u v : Fin 3 → Fin 4) : Decidable (BlockOK u v) :=
  inferInstanceAs (Decidable (∀ i : Fin 3, u i ≤ v i))

instance (u v w : Fin 3 → Fin 4) : Decidable (TriOK u v w) :=
  inferInstanceAs (Decidable (¬ (v 1 < u 2 ∧ v 1 < w 0) ∧ ¬ (v 1 < u 0 ∧ v 1 < w 2)))


def triP : Option (Fin 4 × Fin 4) → Col → Col → Prop
  | none, _, _ => True
  | some (u0, u2), v, c => TriOK ![u0, 0, u2] (vec v) (vec c)

instance triPDec : ∀ p v c, Decidable (triP p v c)
  | none, _, _ => instDecidableTrue
  | some (u0, u2), v, c => inferInstanceAs (Decidable (TriOK ![u0, 0, u2] (vec v) (vec c)))

def step : St → Col → St
  | none, _ => none
  | some (p, v), c =>
    if LOK c ∧ BlockOK (vec v) (vec c) ∧ triP p v c then some (some (v.1, v.2.2), c)
    else none

def start (c : Col) : St := if LOK c then some (none, c) else none

def f (s k : ℕ) : ℕ := enc (step (dec s) (decC k))
def ι (k : ℕ) : ℕ := enc (start (decC k))
def acc (s : ℕ) : ℕ := if s < 1088 then 1 else 0

def e : (Fin 3 → Fin 4) ≃ Fin 64 := finFunctionFinEquiv

theorem e_val (c : Fin 3 → Fin 4) : (e c : ℕ) = (c 0).val + 4 * (c 1).val + 16 * (c 2).val := by
  unfold e
  rw [finFunctionFinEquiv_apply, Fin.sum_univ_three]
  simp only [Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one]
  ring

theorem decC_e (c : Fin 3 → Fin 4) : decC (e c) = (c 0, c 1, c 2) := by
  rw [e_val]
  have h0 := (c 0).isLt
  have h1 := (c 1).isLt
  have h2 := (c 2).isLt
  simp only [decC, Prod.mk.injEq, Fin.ext_iff]
  omega

theorem vec_eq (c : Fin 3 → Fin 4) : vec (c 0, c 1, c 2) = c := by
  funext i; fin_cases i <;> rfl

theorem Good_snoc {n : ℕ} (x : Fin (n + 2) → Fin 3 → Fin 4) :
    Good x ↔ Good (Fin.init x) ∧ LOK (x (Fin.last _) 0, x (Fin.last _) 1, x (Fin.last _) 2) ∧
      BlockOK (x (Fin.last n).castSucc) (x (Fin.last _)) ∧
      (∀ i j : Fin (n + 2), j.val = i.val + 1 → j.val = n → TriOK (x i) (x j) (x (Fin.last _))) := by
  unfold Good
  rw [forall_pair_snoc (fun i j => BlockOK (x i) (x j)),
    forall_triple_snoc (fun i j l => TriOK (x i) (x j) (x l))]
  unfold LOK
  tauto

open Classical in
noncomputable def semS : {n : ℕ} → (Fin (n + 1) → Fin 3 → Fin 4) → St
  | 0, x => if Good x then some (none, (x 0 0, x 0 1, x 0 2)) else none
  | n + 1, x =>
    if Good x then
      some (some (x (Fin.last n).castSucc 0, x (Fin.last n).castSucc 2),
        (x (Fin.last _) 0, x (Fin.last _) 1, x (Fin.last _) 2))
    else none

noncomputable def sem (n : ℕ) (x : Fin (n + 1) → Fin 3 → Fin 4) : ℕ := enc (semS x)

theorem tri_vec (u0 u2 : Fin 4) (v c : Fin 3 → Fin 4) (u : Fin 3 → Fin 4) (h0 : u 0 = u0) (h2 : u 2 = u2) :
    TriOK ![u0, 0, u2] v c ↔ TriOK u v c := by
  subst h0 h2
  unfold TriOK
  rfl

open Classical in
theorem semS_succ {n : ℕ} (x : Fin (n + 2) → Fin 3 → Fin 4) :
    semS x = step (semS (Fin.init x)) (x (Fin.last _) 0, x (Fin.last _) 1, x (Fin.last _) 2) := by
  cases n with
  | zero =>
    have hT : (∀ i j : Fin 2, j.val = i.val + 1 → j.val = 0 → TriOK (x i) (x j) (x (Fin.last _))) := by
      intro i j h1 h2; omega
    simp only [semS, step]
    by_cases hy : Good (Fin.init x)
    · rw [if_pos hy]
      simp only [vec_eq, triP, and_true]
      by_cases hx : Good x
      · rw [if_pos hx, if_pos]
        · rfl
        · have := (Good_snoc x).mp hx
          exact ⟨this.2.1, this.2.2.1⟩
      · rw [if_neg hx, if_neg]
        intro h
        exact hx ((Good_snoc x).mpr ⟨hy, h.1, h.2, hT⟩)
    · rw [if_neg hy, if_neg (fun h => hy ((Good_snoc x).mp h).1)]
  | succ m =>
    have hT : (∀ i j : Fin (m + 3), j.val = i.val + 1 → j.val = m + 1 → TriOK (x i) (x j) (x (Fin.last _))) ↔
        TriOK (x ⟨m, by omega⟩) (x ⟨m + 1, by omega⟩) (x (Fin.last _)) := by
      constructor
      · intro H; exact H _ _ rfl rfl
      · intro H i j h1 h2
        obtain ⟨i, hi⟩ := i
        obtain ⟨j, hj⟩ := j
        simp only at h1 h2
        subst h2
        obtain rfl : i = m := by omega
        exact H
    simp only [semS, step]
    by_cases hy : Good (Fin.init x)
    · rw [if_pos hy]
      simp only [vec_eq, triP]
      have htv := tri_vec (Fin.init x (Fin.last m).castSucc 0) (Fin.init x (Fin.last m).castSucc 2)
        (fun i => Fin.init x (Fin.last (m + 1)) i) (x (Fin.last _)) (x ⟨m, by omega⟩) rfl rfl
      by_cases hx : Good x
      · rw [if_pos hx, if_pos]
        · rfl
        · have := (Good_snoc x).mp hx
          refine ⟨this.2.1, this.2.2.1, ?_⟩
          rw [htv]
          exact hT.mp this.2.2.2
      · rw [if_neg hx, if_neg]
        intro h
        refine hx ((Good_snoc x).mpr ⟨hy, h.1, h.2.1, hT.mpr ?_⟩)
        exact (htv.mp h.2.2)
    · rw [if_neg hy, if_neg (fun h => hy ((Good_snoc x).mp h).1)]

theorem sem_succ (n : ℕ) (x : Fin (n + 2) → Fin 3 → Fin 4) :
    sem (n + 1) x = f (sem n (Fin.init x)) (e (x (Fin.last _))) := by
  unfold sem f
  rw [dec_enc, decC_e, semS_succ]

open Classical in
theorem sem_zero (x : Fin 1 → Fin 3 → Fin 4) : sem 0 x = ι (e (x 0)) := by
  unfold sem ι
  rw [decC_e]
  congr 1
  simp only [semS, start]
  have hg : Good x ↔ LOK (x 0 0, x 0 1, x 0 2) := by
    unfold Good
    unfold LOK
    constructor
    · intro _; trivial
    · intro _
      refine ⟨fun i j hh => ?_, fun i j l h1 h2 => ?_⟩
      · have := i.isLt; have := j.isLt; omega
      · have := i.isLt; have := j.isLt; omega
  by_cases h : LOK (x 0 0, x 0 1, x 0 2)
  · rw [if_pos (hg.mpr h), if_pos h]
  · rw [if_neg (fun h' => h (hg.mp h')), if_neg h]

theorem acc_sem (n : ℕ) (x : Fin (n + 1) → Fin 3 → Fin 4) :
    acc (sem n x) = @ite _ (Good x) (Classical.propDecidable _) 1 0 := by
  unfold acc sem
  cases n with
  | zero =>
    simp only [semS]
    split_ifs
    all_goals (try simp_all [enc, encC])
    all_goals omega
  | succ n =>
    simp only [semS]
    split_ifs
    all_goals (try simp_all [enc, encC])
    all_goals omega

theorem a_succ (n : ℕ) : a (n + 1) = ∑ k ∈ range 64, (W f 64)^[n] acc (ι k) := by
  classical
  unfold a
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter,
    ← sum_sem e sem f ι sem_zero sem_succ n acc]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [acc_sem]
  try congr 1

