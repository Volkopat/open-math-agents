theorem recur : ∀ n : ℕ, 10 < n → (a n : ℤ) = a (n - 4) + a (n - 5) - a (n - 9) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 11 := ⟨n - 11, by omega⟩
  rw [show q + 11 - 4 = q + 7 by omega, show q + 11 - 5 = q + 6 by omega, show q + 11 - 9 = q + 2 by omega]
  simp only [a_eq_b]
  exact b_recur q

