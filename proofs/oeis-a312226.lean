theorem drec_base : ∀ t : ℕ, t < 20 → (dv (t + 9) : ℤ) = (dv (t + 5) : ℤ) + (dv (t + 4) : ℤ) - (dv (t + 0) : ℤ) := by
  decide +kernel

theorem drec (t : ℕ) : (dv (t + 9) : ℤ) = (dv (t + 5) : ℤ) + (dv (t + 4) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 20 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 4, e 5, e 9]
  exact drec_base (t % 20) (Nat.mod_lt _ (by norm_num))

/-- The recurrence on its first 20 terms, by the kernel. -/
theorem recur_base : ∀ q : ℕ, q < 20 → (b (q + 11) : ℤ) = b (q + 7) + b (q + 6) - b (q + 2) := by
  decide +kernel

theorem b_recur (q : ℕ) : (b (q + 11) : ℤ) = b (q + 7) + b (q + 6) - b (q + 2) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 20 ∨ 20 ≤ q by omega) with hq | hq
    · exact recur_base q hq
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 20 := ⟨q - 20, by omega⟩
      have h0 : (b (v + 11) : ℤ) = b (v + 7) + b (v + 6) - b (v + 2) := ih (v + 0) (by omega)
      have s2 : b (v + 22) = b (v + 2) + dv (v + 0) := by
        have h := b_step (v + 2) (by omega)
        rw [show v + 2 + 20 = v + 22 by omega,
          show v + 2 - 2 = v + 0 by omega] at h
        exact h
      have s6 : b (v + 26) = b (v + 6) + dv (v + 4) := by
        have h := b_step (v + 6) (by omega)
        rw [show v + 6 + 20 = v + 26 by omega,
          show v + 6 - 2 = v + 4 by omega] at h
        exact h
      have s7 : b (v + 27) = b (v + 7) + dv (v + 5) := by
        have h := b_step (v + 7) (by omega)
        rw [show v + 7 + 20 = v + 27 by omega,
          show v + 7 - 2 = v + 5 by omega] at h
        exact h
      have s11 : b (v + 31) = b (v + 11) + dv (v + 9) := by
        have h := b_step (v + 11) (by omega)
        rw [show v + 11 + 20 = v + 31 by omega,
          show v + 11 - 2 = v + 9 by omega] at h
        exact h
      have hd := drec v
      show (b (v + 31) : ℤ) = b (v + 27) + b (v + 26) - b (v + 22)
      omega

