      rw [h] at hyp_z
      simp only [one_re, one_im, Left.neg_nonpos_iff, Nat.ofNat_nonneg, and_self, and_true] at hyp_z
      linarith [hσ₂.2]
  have zeta'_zeta_cont := (h_logDeriv_holo.mono subst).continuousOn
