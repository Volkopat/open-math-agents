    - deriv riemannZeta s / riemannZeta s = ∑' n, (vonMangoldt) n / (n : ℂ) ^ s := by
  rw [← ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs]
  dsimp [LSeries, LSeries.term]
