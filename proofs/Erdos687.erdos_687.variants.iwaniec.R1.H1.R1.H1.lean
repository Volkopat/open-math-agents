    calc
      ‖(deriv (riemannZeta)) (σ - (T : ℝ) * I) / (riemannZeta) (σ - (T : ℝ) * I)‖ = ‖(deriv (riemannZeta)) (σ + (-T : ℝ) * I) / (riemannZeta) (σ + (-T : ℝ) * I)‖ := by
