          · simp only [← cpow_neg, neg_add_rev]
            rw [cpow_add _ _ ((cast_ne_zero (R := ℂ)).mpr heq0), mul_comm]
            ring_nf
          · simp only [← cpow_neg, neg_add_rev]
            rw [cpow_add _ _ ((cast_ne_zero (R := ℂ)).mpr heq0), mul_comm]
