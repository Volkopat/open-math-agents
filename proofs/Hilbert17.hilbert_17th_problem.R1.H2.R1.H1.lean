import OMAReductions.R_Hilbert17_hilbert_17th_problem_R1_H2_R1
import Mathlib

/-! A positive nonsquare admits an ordered quadratic extension. The preordering
is generated by nonnegative base scalars times squares. Its elements have
nonnegative real coordinate since the radicand is positive.
The maximal-preordering argument adapts the merged Artin–Schreier step
for Hilbert 17 by @jared-jasinski. Original quadratic-extension proof by
@marcusbuffett (PR #4167); bundled preordering APIs simplify the order construction. -/

namespace Quad17

private lemma adjoin_total {K : Type} [Field K] (P : RingPreordering K)
    (hmax : IsMax P) (x : K) : x ∈ P ∨ -x ∈ P := by
  by_contra hneither
  push Not at hneither
  let Q : Set K := {z | ∃ u v : K, u ∈ P ∧ v ∈ P ∧ z = u + x * v}
  have hPQ : (P : Set K) ⊆ Q := fun u hu => ⟨u, 0, hu, zero_mem P, by ring⟩
  have hxQ : x ∈ Q := ⟨0, 1, zero_mem P, one_mem P, by ring⟩
  have hneg : (-1 : K) ∈ Q := by
    by_contra hneg1
    let Q' : RingPreordering K := RingPreordering.mk' Q
      (by
        rintro z1 z2 ⟨u1, v1, hu1, hv1, rfl⟩ ⟨u2, v2, hu2, hv2, rfl⟩
        exact ⟨u1 + u2, v1 + v2, add_mem hu1 hu2, add_mem hv1 hv2, by ring⟩)
      (by
        rintro z1 z2 ⟨u1, v1, hu1, hv1, rfl⟩ ⟨u2, v2, hu2, hv2, rfl⟩
        exact ⟨u1 * u2 + (x * x) * (v1 * v2), u1 * v2 + u2 * v1,
          add_mem (mul_mem hu1 hu2) (mul_mem (P.mul_self_mem x) (mul_mem hv1 hv2)),
          add_mem (mul_mem hu1 hv2) (mul_mem hu2 hv1), by ring⟩)
      (fun z => hPQ (P.mul_self_mem z)) hneg1
    exact hneither.1 (hmax (show P ≤ Q' from hPQ) hxQ)
  obtain ⟨u, v, hu, hv, hneg⟩ := hneg
  by_cases hv0 : v = 0
  · subst hv0
    have h1u : (-1 : K) = u := by linear_combination hneg
    exact P.neg_one_notMem (h1u ▸ hu)
  · apply hneither.2
    have hxv : -x * v = 1 + u := by linear_combination hneg
    have hnx_eq : -x = (1 + u) * v⁻¹ := by
      field_simp [hv0]
      linear_combination hxv
    rw [hnx_eq]
    exact mul_mem (add_mem (one_mem P) hu) (RingPreordering.inv_mem hv)

private lemma exists_max_preorder {K : Type} [Field K] (P₀ : RingPreordering K) :
    ∃ P : RingPreordering K, P₀ ≤ P ∧ IsMax P := by
  classical
  apply zorn_le_nonempty_Ici₀ P₀ ?_ P₀ le_rfl
  intro c hc hchain y hy
  letI : Nonempty c := ⟨⟨y, hy⟩⟩
  let U : Subsemiring K := ⨆ P : c, P.val.toSubsemiring
  have dir : Directed (· ≤ ·) (fun P : c => P.val.toSubsemiring) :=
    by
      intro A B
      obtain ⟨C, hA, hB⟩ := hchain.directedOn.directed_val A B
      exact ⟨C, hA, hB⟩
  have mem (x : K) : x ∈ U ↔ ∃ P : c, x ∈ P.val :=
    Subsemiring.mem_iSup_of_directed dir
  let Q : RingPreordering K := {
    U with
    mem_of_isSquare' := fun h => (mem _).mpr ⟨⟨y, hy⟩, y.mem_of_isSquare h⟩
    neg_one_notMem' := by
      intro h
      obtain ⟨P, hP⟩ := (mem _).mp h
      exact P.val.neg_one_notMem hP }
  exact ⟨Q, fun P hP x hx => (mem x).mpr ⟨⟨P, hP⟩, hx⟩⟩


section
variable {F : Type} [Field F] [LinearOrder F] [IsStrictOrderedRing F]
variable {E : Type} [Field E] [Algebra F E]

/-- Finite sums of squares weighted by nonnegative base-field scalars. -/
private inductive Weighted (F : Type) [Field F] [LinearOrder F]
    {E : Type} [CommRing E] [Algebra F E] : E → Prop where
  | term (c : F) (hc : 0≤c) (y : E) : Weighted F (algebraMap F E c * (y*y))
  | add {x y : E} : Weighted F x → Weighted F y → Weighted F (x+y)

private lemma weighted_mul {x y : E} (hx : Weighted F x) (hy : Weighted F y) :
    Weighted F (x*y) := by
  induction hx with
  | term c hc u =>
    induction hy with
    | term d hd v =>
      convert Weighted.term (c*d) (mul_nonneg hc hd) (u*v) using 1; rw [map_mul]; ring
    | add h₁ h₂ ih₁ ih₂ => rw [mul_add]; exact .add ih₁ ih₂
  | add h₁ h₂ ih₁ ih₂ => rw [add_mul]; exact .add ih₁ ih₂

private lemma weighted_re {a : F} (ha : 0≤a) {z : QuadraticAlgebra F a 0}
    (h : Weighted F z) : 0 ≤ z.re := by
  induction h with
  | term c hc u =>
    simp only [QuadraticAlgebra.re_mul,QuadraticAlgebra.algebraMap_re,
      QuadraticAlgebra.algebraMap_im,zero_mul,mul_zero,add_zero]
    exact mul_nonneg hc (by nlinarith [mul_self_nonneg u.re,mul_nonneg ha (mul_self_nonneg u.im)])
  | add _ _ ih₁ ih₂ => exact add_nonneg ih₁ ih₂

private lemma extend_cone (P₀ : RingPreordering E) :
    ∃ (_ : LinearOrder E) (_ : IsStrictOrderedRing E), ∀ x ∈ P₀, 0 ≤ x := by
  classical
  obtain ⟨P, hle, hmax⟩ := exists_max_preorder P₀
  let C : RingCone E := ⟨P.toSubsemiring, fun hp hn => RingPreordering.eq_zero_of_mem_of_neg_mem hp hn⟩
  letI : HasMemOrNegMem C := ⟨adjoin_total P hmax⟩
  letI : LinearOrder E := .mkOfAddGroupCone C
  letI : IsOrderedRing E := IsOrderedRing.mkOfCone C
  refine ⟨inferInstance,inferInstance,fun x hx => ?_⟩
  change x-0 ∈ P
  simpa using hle hx

end

end Quad17

theorem OMA.solution : OMA.R_Hilbert17_hilbert_17th_problem_R1_H2_R1.H1 := by
  classical
  intro F _ _ _ a ha hns
  letI : Fact (∀ r : F, r^2 ≠ a+0*r) := ⟨by
    intro r h
    exact hns ⟨r, by simpa [sq] using h.symm⟩⟩
  let E := QuadraticAlgebra F a 0
  let P : RingPreordering E := RingPreordering.mk' {z | Quad17.Weighted F z}
    Quad17.Weighted.add Quad17.weighted_mul
    (fun x => by simpa using Quad17.Weighted.term (1:F) zero_le_one x)
    (fun h => by
      have hh := Quad17.weighted_re (z := (-1 : QuadraticAlgebra F a 0)) ha h
      simpa only [QuadraticAlgebra.re_neg,QuadraticAlgebra.re_one,neg_nonneg,not_le_of_gt zero_lt_one] using hh)
  obtain ⟨order, strict, horder⟩ := Quad17.extend_cone P
  refine ⟨E,inferInstance,order,strict,inferInstance,inferInstance,fun x hx => horder _ ?_,?_⟩
  · simpa only [P, RingPreordering.mem_mk', Set.mem_setOf_eq, one_mul, mul_one] using Quad17.Weighted.term x hx (1:E)
  · exact ⟨(QuadraticAlgebra.omega : QuadraticAlgebra F a 0), by rw [QuadraticAlgebra.omega_mul_omega_eq_algebraMap]; simp [E]⟩
