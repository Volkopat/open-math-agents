theorem chunk_lt : ∀ a < 4 ^ 3, ∀ b < 4 ^ 3, (a * 64 + b) / 275 < 15 := by decide +kernel

theorem cntL (a b : ℕ) (ha : a < 4 ^ 3) (hb : b < 4 ^ 3) : ∀ c < 45,
    ((mem2 b c).filter (fun x => ok (dec a) ∧ compat (dec a) (dec b) ∧ tri (dec a) (dec b) (dec x))).length =
      Mt (cls2 (dec a) (dec b)) c := by
  have h := chunk_lt a ha b hb
  generalize hq : (a * 64 + b) / 275 = q at h
  interval_cases q
  · exact cntL_0 a ha b hb hq
  · exact cntL_1 a ha b hb hq
  · exact cntL_2 a ha b hb hq
  · exact cntL_3 a ha b hb hq
  · exact cntL_4 a ha b hb hq
  · exact cntL_5 a ha b hb hq
  · exact cntL_6 a ha b hb hq
  · exact cntL_7 a ha b hb hq
  · exact cntL_8 a ha b hb hq
  · exact cntL_9 a ha b hb hq
  · exact cntL_10 a ha b hb hq
  · exact cntL_11 a ha b hb hq
  · exact cntL_12 a ha b hb hq
  · exact cntL_13 a ha b hb hq
  · exact cntL_14 a ha b hb hq

theorem cnt (s t : R) (c : ℕ) (hc : c < 45) :
    (Finset.univ.filter (fun u : R => cls2 t u = c ∧ (ok s ∧ compat s t ∧ tri s t u))).card =
      Mt (cls2 s t) c := by
  rw [card_cls2 t c hc (fun u => ok s ∧ compat s t ∧ tri s t u)]
  have h := cntL (E s : ℕ) (E t : ℕ) (E s).isLt (E t).isLt c hc
  rw [dec_E, dec_E] at h
  exact h


theorem cnt0 : ∀ s t : R, (if (ok s ∧ ok t) ∧ compat s t then 1 else 0) = V 0 (cls2 s t) := by
  decide +kernel

theorem tcntL : ∀ c < 45, (∑ a ∈ Finset.range (4 ^ 3),
    ((mem2 a c).filter (fun _ => ini (dec a))).length) = ([1, 2, 2, 2, 2, 8, 8, 8, 3, 12, 18, 18, 4, 16, 24, 32, 59, 7, 14, 14, 11, 32, 32, 15, 44, 58, 22, 44, 31, 80, 50, 3269, 2, 4, 6, 36, 4, 8, 6, 12, 36, 6, 10, 12, 12] : List ℕ).getD c 0 := by decide +kernel

theorem tcnt (c : ℕ) (hc : c < 45) :
    (∑ s : R, (Finset.univ.filter (fun t : R => cls2 s t = c ∧ ini s)).card) =
      ([1, 2, 2, 2, 2, 8, 8, 8, 3, 12, 18, 18, 4, 16, 24, 32, 59, 7, 14, 14, 11, 32, 32, 15, 44, 58, 22, 44, 31, 80, 50, 3269, 2, 4, 6, 36, 4, 8, 6, 12, 36, 6, 10, 12, 12] : List ℕ).getD c 0 := by
  have h1 : ∀ s : R, (Finset.univ.filter (fun t : R => cls2 s t = c ∧ ini s)).card =
      ((mem2 (E s : ℕ) c).filter (fun _ => ini (dec (E s : ℕ)))).length := by
    intro s
    rw [card_cls2 s c hc (fun _ => ini s), dec_E]
  rw [Finset.sum_congr rfl (fun s _ => h1 s),
    Equiv.sum_comp E (fun a : Fin (4 ^ 3) => ((mem2 (a : ℕ) c).filter (fun _ => ini (dec (a : ℕ)))).length),
    Fin.sum_univ_eq_sum_range (fun a => ((mem2 a c).filter (fun _ => ini (dec a))).length) (4 ^ 3)]
  exact tcntL c hc

/-- Left-nested sum f 0 + f 1 + ... + f (k-1), unfolding definitionally. -/
def sumTo : ℕ → (ℕ → ℕ) → ℕ
  | 0, _ => 0
  | k + 1, f => sumTo k f + f k

theorem sum_range_sumTo (f : ℕ → ℕ) (k : ℕ) : (∑ c ∈ Finset.range k, f c) = sumTo k f := by
  induction k with
  | zero => simp [sumTo]
  | succ k ih => simp [sumTo, Finset.sum_range_succ, ih]

theorem step (n : ℕ) : ∀ i < 45, (∑ c ∈ Finset.range 45, Mt i c * V n c) = V (n + 1) i := by
  intro i hi
  rw [sum_range_sumTo]
  interval_cases i <;> rfl

theorem F2_eq (n : ℕ) : ∀ s t : R, F2 n s t = V n (cls2 s t) := by
  induction n with
  | zero => intro s t; rw [F2_zero]; exact cnt0 s t
  | succ n ih =>
    intro s t
    rw [F2_succ]
    simp only [ih]
    rw [sum_clsf (cls2 t) (cls2_lt t) (V n) (fun u => ok s ∧ compat s t ∧ tri s t u),
      ← step n (cls2 s t) (cls2_lt s t)]
    apply Finset.sum_congr rfl
    intro c hc
    rw [cnt s t c (Finset.mem_range.mp hc)]

