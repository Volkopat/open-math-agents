import OMAReductions.R_OeisA105210_conjecture_disjoint_starting_values_R1

/-!
A kernel certificate for the finite verification reported by Cormier and Selfridge.
The finite step is from the reduction by @eltociear. Proof by Bush Turkey Labs
(@megapodeai) with OpenAI Codex. The trace records prime factorizations, one for
each term. The proofs check the factors and recurrence, certify passage beyond
the cutoff, and compare the five increasing prefixes.
-/

namespace OeisOrbitCert

def trial (p : ℕ) : ℕ → ℕ → Bool
  | 0, a => decide (p % a ≠ 0)
  | d + 1, a =>
    if p < a*a then true
    else trial p d a && trial p d (a + 2^d)

def primeOK (p : ℕ) : Bool :=
  decide (2 ≤ p ∧ p < (2^14+2)^2) && trial p 14 2

theorem trial_sound {p : ℕ} (d a m : ℕ) (h : trial p d a = true)
    (hlo : a ≤ m) (hhi : m < a + 2^d) (hsq : m*m ≤ p) : ¬m ∣ p := by
  induction d generalizing a with
  | zero =>
    simp only [pow_zero] at hhi
    have hm : m = a := by omega
    subst m
    simpa [trial, Nat.dvd_iff_mod_eq_zero] using h
  | succ d ih =>
    simp only [trial] at h
    split at h
    · have hsq' := Nat.mul_le_mul hlo hlo
      omega
    · obtain ⟨hl, hr⟩ := Bool.and_eq_true_iff.mp h
      by_cases hb : m < a + 2^d
      · exact ih a hl hlo hb
      · apply ih (a + 2^d) hr (by omega)
        rw [pow_succ] at hhi
        omega

theorem primeOK_sound {p : ℕ} (h : primeOK p = true) : p.Prime := by
  obtain ⟨hb, ht⟩ := Bool.and_eq_true_iff.mp h
  have bounds : 2 ≤ p ∧ p < (2^14+2)^2 := of_decide_eq_true hb
  apply Nat.prime_def_le_sqrt.mpr
  refine ⟨bounds.1, ?_⟩
  intro m hm hs
  have hsq : m * m ≤ p := Nat.le_sqrt.mp hs
  apply trial_sound 14 2 m ht hm _ hsq
  by_contra! hbad
  have hbig := Nat.mul_le_mul hbad hbad
  have bound := bounds.2
  norm_num at hbig bound
  omega

theorem sum_proper_entries (x : ℕ) (ps : List ℕ) :
    (ps.map (fun p => if p < x then p else 0)).sum =
      (ps.filter (· < x)).sum := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    by_cases hp : p < x <;> simp [hp, ih]

theorem step_of_factors {x y : ℕ} (fs : List ℕ)
    (hpr : ∀ p ∈ fs, Nat.Prime p) (hprod : fs.prod = x)
    (hsum : x + 1 + (fs.dedup.filter (· < x)).sum = y) :
    OeisA105210.nextTermFn x = y := by
  have hp := Nat.primeFactorsList_unique hprod hpr
  have hset : x.primeFactors = fs.dedup.toFinset := by
    ext p
    change p ∈ x.primeFactorsList.toFinset ↔ _
    simpa only [List.mem_toFinset, List.mem_dedup] using (hp.mem_iff (a := p)).symm
  unfold OeisA105210.nextTermFn OeisA105210.sumRelevantPrimeFactors
  rw [hset, List.sum_toFinset _ (List.nodup_dedup _), sum_proper_entries]
  exact hsum

end OeisOrbitCert

