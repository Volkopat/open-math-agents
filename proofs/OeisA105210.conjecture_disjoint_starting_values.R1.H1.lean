private def orbitRows (k : ℕ) : List (List ℕ) :=
  if k = 1 then rows1 else if k = 393 then rows393 else if k = 412 then rows412
  else if k = 668 then rows668 else if k = 932 then rows932 else []

def orbitValues (k : ℕ) : List ℕ := (orbitRows k).map List.prod

private def edgesOK : List (List ℕ) → Bool
  | fs :: gs :: rs =>
    (fs.all primeOK &&
      decide (fs.prod+1+(fs.dedup.filter (· < fs.prod)).sum = gs.prod)) &&
      edgesOK (gs :: rs)
  | _ => true

private theorem edgesOK_sound {f : ℕ → ℕ}
    (step : ∀ fs : List ℕ, ∀ y : ℕ, fs.all primeOK = true →
      fs.prod+1+(fs.dedup.filter (· < fs.prod)).sum = y → f fs.prod = y) :
    ∀ rs : List (List ℕ), edgesOK rs = true →
      (rs.map List.prod).IsChain (fun x y => f x = y)
  | [], _ => List.IsChain.nil
  | [x], _ => List.IsChain.singleton _
  | fs :: gs :: rest, h => by
    obtain ⟨hk, hs⟩ := Bool.and_eq_true_iff.mp h
    obtain ⟨hp, he⟩ := Bool.and_eq_true_iff.mp hk
    exact List.IsChain.cons_cons (step fs gs.prod hp (of_decide_eq_true he))
      (edgesOK_sound step (gs :: rest) hs)
private theorem check1 : edgesOK rows1 = true := by decide +kernel

private theorem check393 : edgesOK rows393 = true := by decide +kernel

private theorem check412 : edgesOK rows412 = true := by decide +kernel

private theorem check668 : edgesOK rows668 = true := by decide +kernel

private theorem check932 : edgesOK rows932 = true := by decide +kernel

theorem orbitValues_chain {k : ℕ} (hk : k ∈ ([1,393,412,668,932] : List ℕ)) :
    (orbitValues k).IsChain (fun x y => OeisA105210.nextTermFn x = y) := by
  apply edgesOK_sound (f := OeisA105210.nextTermFn) (fun fs y hp he =>
    step_of_factors fs (fun p h => primeOK_sound (List.all_eq_true.mp hp p h)) rfl he)
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hk
  rcases hk with rfl | rfl | rfl | rfl | rfl
  · exact check1
  · exact check393
  · exact check412
  · exact check668
  · exact check932

end
end OeisOrbitCert

