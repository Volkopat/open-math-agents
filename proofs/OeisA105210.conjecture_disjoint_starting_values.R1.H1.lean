private theorem trace_covers (s : ℕ → ℕ) (f : ℕ → ℕ)
    (step : ∀ n, s (n+1) = f (s n)) (strict : ∀ x, x < f x)
    (cutoff : ℕ) {start first : ℕ} {tail : List ℕ}
    (head : s start = first)
    (chain : (first :: tail).IsChain (fun x y => f x = y))
    (last : cutoff < (first :: tail).getLastD 0) :
    ∀ n, start ≤ n → s n ≤ cutoff → s n ∈ first :: tail := by
  have monotonic : Monotone s :=
    (strictMono_nat_of_lt_succ (fun n => by rw [step]; exact strict _)).monotone
  induction tail generalizing start first with
  | nil =>
    intro n hn hc
    simp at last
    have h := monotonic hn
    omega
  | cons second rest ih =>
    intro n hn hc
    by_cases he : start = n
    · subst n
      simp [head]
    · have ⟨hstep,chain'⟩ := List.isChain_cons_cons.mp chain
      apply List.mem_cons_of_mem
      exact ih (start := start+1) (first := second) (by rw [step,head,hstep])
        chain' (by simpa using last) n (by omega) hc

private theorem cutoff_mem {k m : ℕ}
    (hm : m ∈ OeisA105210.sequenceSet k) (hc : m ≤ 100000000)
    (ends : ∃ tail, orbitValues k = k :: tail ∧ 100000000 < (k::tail).getLastD 0)
    (chain : (orbitValues k).IsChain (fun x y => OeisA105210.nextTermFn x = y)) :
    m ∈ orbitValues k := by
  obtain ⟨tail, he, hl⟩ := ends
  rw [he] at chain ⊢
  obtain ⟨n, hn, hval⟩ := hm
  cases n with
  | zero => omega
  | succ n =>
    rw [← hval]
    exact trace_covers (fun i => OeisA105210.sequenceStartingAt k (i+1))
      OeisA105210.nextTermFn (fun i => by simp [OeisA105210.sequenceStartingAt])
      (fun x => by unfold OeisA105210.nextTermFn; omega)
      100000000 (start := 0) (by simp [OeisA105210.sequenceStartingAt])
      chain hl n (Nat.zero_le _) (by simpa [hval] using hc)

private def apart : ℕ → List ℕ → List ℕ → Bool
  | 0, _, _ => false
  | _+1, [], _ => true
  | _+1, _, [] => true
  | fuel+1, a::as, b::bs =>
    if a < b then apart fuel as (b::bs)
    else if b < a then apart fuel (a::as) bs else false

private theorem head_le {a m : ℕ} {xs : List ℕ}
    (hs : (a::xs).Pairwise (· < ·)) (hm : m ∈ a::xs) : a ≤ m := by
  rcases List.mem_cons.mp hm with he | ht
  · omega
  · exact (List.pairwise_cons.mp hs |>.1 _ ht).le

private theorem apart_sound {fuel : ℕ} {xs ys : List ℕ} {m : ℕ}
    (hs : xs.Pairwise (· < ·)) (ht : ys.Pairwise (· < ·))
    (check : apart fuel xs ys = true) (hx : m ∈ xs) (hy : m ∈ ys) : False := by
  induction fuel generalizing xs ys with
  | zero => simp [apart] at check
  | succ fuel ih =>
    cases xs with
    | nil => simp at hx
    | cons a as =>
      cases ys with
      | nil => simp at hy
      | cons b bs =>
        have lowerX := head_le hs hx
        have lowerY := head_le ht hy
        by_cases hab : a < b
        · simp only [apart, if_pos hab] at check
          exact ih (List.pairwise_cons.mp hs).2 ht check
            ((List.mem_cons.mp hx).resolve_left (by omega)) hy
        · by_cases hba : b < a
          · simp only [apart, if_neg hab, if_pos hba] at check
            exact ih hs (List.pairwise_cons.mp ht).2 check hx
              ((List.mem_cons.mp hy).resolve_left (by omega))
          · simp [apart,hab,hba] at check

private def seeds : List ℕ := [1,393,412,668,932]

private theorem endpoints {k : ℕ} (hk : k ∈ seeds) :
    orbitValues k = k :: (orbitValues k).tail ∧ 100000000 < (orbitValues k).getLastD 0 := by
  simp only [seeds, List.mem_cons, List.not_mem_nil, or_false] at hk
  rcases hk with rfl | rfl | rfl | rfl | rfl <;> exact ⟨rfl, by decide +kernel⟩

set_option maxRecDepth 8192 in
set_option maxHeartbeats 0 in
private theorem pair_checks :
    seeds.all (fun j => seeds.all (fun k => decide (k ≤ j) || apart 800 (orbitValues j) (orbitValues k))) = true := by
  decide +kernel

private theorem disjoint_ordered {j k m : ℕ} (hj : j ∈ seeds) (hk : k ∈ seeds) (hjk : j < k)
    (cj : (orbitValues j).IsChain (fun x y => OeisA105210.nextTermFn x = y))
    (ck : (orbitValues k).IsChain (fun x y => OeisA105210.nextTermFn x = y))
    (hmj : m ∈ orbitValues j) (hmk : m ∈ orbitValues k) : False := by
  have growth : ∀ ⦃a b⦄, OeisA105210.nextTermFn a = b → a < b := by
    intro a b he
    unfold OeisA105210.nextTermFn at he
    omega
  have h := List.all_eq_true.mp (List.all_eq_true.mp pair_checks j hj) k hk
  exact apart_sound (cj.imp growth).pairwise (ck.imp growth).pairwise
    (by simpa [not_le.mpr hjk] using h) hmj hmk

theorem disjoint_up_to_cutoff :
    ∀ j k : ℕ, j ∈ ({1,393,412,668,932} : Set ℕ) → k ∈ ({1,393,412,668,932} : Set ℕ) →
    j ≠ k → ∀ m : ℕ, m ∈ OeisA105210.sequenceSet j → m ∈ OeisA105210.sequenceSet k →
    m ≤ 100000000 → False := by
  intro j k hj hk hne m hmj hmk hc
  have toSeeds {x : ℕ} (h : x ∈ ({1,393,412,668,932} : Set ℕ)) : x ∈ seeds := by
    simpa only [seeds, List.mem_cons, List.not_mem_nil, or_false, Set.mem_insert_iff,
      Set.mem_singleton_iff] using h
  have js := toSeeds hj
  have ks := toSeeds hk
  have cj := orbitValues_chain js
  have ck := orbitValues_chain ks
  have mass {x : ℕ} (hx : x ∈ seeds) (h : m ∈ OeisA105210.sequenceSet x)
      (c : (orbitValues x).IsChain (fun a b => OeisA105210.nextTermFn a = b)) :
      m ∈ orbitValues x := by
    obtain ⟨he, hl⟩ := endpoints hx
    exact cutoff_mem h hc ⟨(orbitValues x).tail, he, by rwa [← he]⟩ c
  rcases lt_or_gt_of_ne hne with h | h
  · exact disjoint_ordered js ks h cj ck (mass js hmj cj) (mass ks hmk ck)
  · exact disjoint_ordered ks js h ck cj (mass ks hmk ck) (mass js hmj cj)

end OeisOrbitCert

theorem OMA.solution : OMA.R_OeisA105210_conjecture_disjoint_starting_values_R1.H1 :=
  OeisOrbitCert.disjoint_up_to_cutoff
