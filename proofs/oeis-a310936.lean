def smallL : List V := smallV.map Prod.fst

theorem smallV_ok : (smallV.all fun q => decide (F q.1 = q.2)) = true := by
  decide +kernel

/-- The potentials, packed: Ac = ATV - 8, Bc = BTV - 8. -/
def ATV (k : ℕ) : ℕ := ctabN 112955561636860000 5 k

def ATN (k : ℕ) : ℤ := (ATV k : ℤ) - 8

def AT (i : Fin 12) : ℤ := ATN i.val

def BTV (k : ℕ) : ℕ := ctabN 374344586740465700 5 k

def BTN (k : ℕ) : ℤ := (BTV k : ℤ) - 8

def BT (i : Fin 12) : ℤ := BTN i.val

theorem AB_eq : ∀ i : Fin 12, AT i = Ac i ∧ BT i = Bc i := by
  decide +kernel

/-- Some potential exceeds 11 at the box point ((a : ℤ) - 3, (b : ℤ) - 3, s), in natural
numbers: the negative terms moved across. -/
def bigNat (a b s : ℕ) : Bool :=
  (List.range 12).any fun i =>
    Nat.blt (21 + ATV i * 3 + 8 * a + BTV i * 3 + 8 * b)
      (ATV i * a + 24 + BTV i * b + 24 + cTV (i + 12 * s))

theorem big_pot (a b : ℕ) (s : Fin 24) (h : bigNat a b s.val = true) :
    (11 : ℤ) < F ((a : ℤ) - 3, (b : ℤ) - 3, s) := by
  obtain ⟨i, hi, hb⟩ := List.any_eq_true.1 h
  rw [List.mem_range] at hi
  have hl := (Nat.cast_lt (α := ℤ)).mpr (Nat.blt_eq.mp hb)
  have hp := le_F ((a : ℤ) - 3, (b : ℤ) - 3, s) ⟨i, hi⟩
  obtain ⟨eA, eB⟩ := AB_eq ⟨i, hi⟩
  have e3 := cT_eq s ⟨i, hi⟩
  simp only [pot] at hp
  rw [← eA, ← eB, ← e3] at hp
  simp only [AT, BT, ATN, BTN, cT, cTN] at hp
  push_cast at hl hp
  ring_nf at hl hp ⊢
  linarith

def smallOK : Bool :=
  (List.range 7).all fun a => (List.range 7).all fun b => (List.finRange 24).all fun s =>
    bigNat a b s.val || decide (((a : ℤ) - 3, (b : ℤ) - 3, s) ∈ smallL)

theorem smallOK_eq : smallOK = true := by
  decide +kernel

theorem small_mem (v : V) (hF : F v ≤ 11) : v ∈ smallL := by
  obtain ⟨x, y, s⟩ := v
  obtain ⟨hx1, hx2, hy1, hy2⟩ := small_box x y s hF
  have h := smallOK_eq
  unfold smallOK at h
  simp only [List.all_eq_true, List.mem_range, List.mem_finRange, forall_const] at h
  have h' := h (x + 3).toNat (by omega) (y + 3).toNat (by omega) s
  have ex : (((x + 3).toNat : ℕ) : ℤ) - 3 = x := by omega
  have ey : (((y + 3).toNat : ℕ) : ℤ) - 3 = y := by omega
  simp only [Bool.or_eq_true, decide_eq_true_eq] at h'
  rcases h' with h1 | h1
  · have := big_pot _ _ s h1
    rw [ex, ey] at this
    omega
  · rw [ex, ey] at h1
    exact h1

theorem cnt_small (n : ℤ) (hn : n ≤ 11) :
    cnt n = (((smallV.filter (fun q => decide (q.2 = n))).map Prod.fst).toFinset).card := by
  rw [cnt, ← Set.ncard_coe_finset]
  congr 1
  ext v
  have hv := smallV_ok
  simp only [List.all_eq_true, decide_eq_true_eq] at hv
  simp only [Set.mem_ofPred_eq, List.coe_toFinset, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · intro h
    obtain ⟨q, hq, rfl⟩ := List.mem_map.1 (small_mem v (by omega))
    exact ⟨q, ⟨hq, by rw [← hv q hq]; exact h⟩, rfl⟩
  · rintro ⟨q, ⟨hq, h2⟩, rfl⟩
    rw [hv q hq]
    exact h2

/-- The small spheres from 6 on, in closed form. -/
theorem small_ok : ∀ n : ℕ, 6 ≤ n → n < 12 →
    (((smallV.filter (fun q => decide (q.2 = (n : ℤ)))).map Prod.fst).toFinset).card = b n := by
  decide +kernel

/-! ## The coordination sequence

`a n` counts the level set F = n from n = 6 on (`a_eq_cnt`, from `a_eq_F`), and `small_vals`
lists the terms below 6. The terms from 6 to 11 are counted in `smallL`, those from 12 on
are S(n), and all agree with the closed form b (`a_eq_b`). The step from n to n + 12, the closed form
per residue (`a_closed`), the controls, the recurrence and the g.f. follow, their base cases checked by
the kernel on b. -/

theorem a_eq_cnt (n : ℕ) (hn : 6 ≤ n) : a n = cnt n := by
  rw [a_eq_F n hn, cnt]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq]
  have := F_nonneg v
  omega

theorem a_eq_S (n : ℕ) (hn : 12 ≤ n) : (a n : ℤ) = S n := by
  rw [a_eq_cnt n (by omega)]
  exact cnt_eq_S n (by exact_mod_cast hn)

theorem a_lt_R0 (n : ℕ) (hn : n < 6) : a n = b n := by
  have h : (List.range 6).map a = (List.range 6).map b := by
    rw [small_vals]
    decide +kernel
  exact List.map_inj_left.1 h n (List.mem_range.2 hn)

/-- The coordination sequence in closed form. -/
theorem a_eq_b (n : ℕ) : a n = b n := by
  rcases (show n < 6 ∨ (6 ≤ n ∧ n < 12) ∨ 12 ≤ n by omega) with h | ⟨h1, h2⟩ | h
  · exact a_lt_R0 n h
  · rw [a_eq_cnt n h1, cnt_small _ (by omega)]
    exact small_ok n h1 h2
  · have h1 := a_eq_S n h
    rw [S_eq_b n h] at h1
    exact_mod_cast h1

/-- The step a(n + 12) = a(n) + dv (n - 6) for n ≥ 6. -/
theorem a_step (n : ℕ) (hn : 6 ≤ n) : a (n + 12) = a n + dv (n - 6) := by
  rw [a_eq_b, a_eq_b]
  exact b_step n hn

/-- The steps and the values on one period, by the kernel. -/
theorem closed_vals : dv 0 = 38 ∧ tblV 0 = 17 ∧ dv 1 = 36 ∧ tblV 1 = 24 ∧ dv 2 = 34 ∧ tblV 2 = 28 ∧ dv 3 = 36 ∧ tblV 3 = 28 ∧ dv 4 = 38 ∧ tblV 4 = 27 ∧ dv 5 = 36 ∧ tblV 5 = 28 ∧ dv 6 = 34 ∧ tblV 6 = 32 ∧ dv 7 = 36 ∧ tblV 7 = 40 ∧ dv 8 = 38 ∧ tblV 8 = 47 ∧ dv 9 = 36 ∧ tblV 9 = 48 ∧ dv 10 = 34 ∧ tblV 10 = 46 ∧ dv 11 = 36 ∧ tblV 11 = 48 := by
  decide +kernel

/-- The closed form per residue of n mod 12, for n ≥ 6. -/
theorem a_closed (k : ℕ) :
    a (12 * k + 6) = 38 * k + 17 ∧
    a (12 * k + 7) = 36 * k + 24 ∧
    a (12 * k + 8) = 34 * k + 28 ∧
    a (12 * k + 9) = 36 * k + 28 ∧
    a (12 * k + 10) = 38 * k + 27 ∧
    a (12 * k + 11) = 36 * k + 28 ∧
    a (12 * k + 12) = 34 * k + 32 ∧
    a (12 * k + 13) = 36 * k + 40 ∧
    a (12 * k + 14) = 38 * k + 47 ∧
    a (12 * k + 15) = 36 * k + 48 ∧
    a (12 * k + 16) = 34 * k + 46 ∧
    a (12 * k + 17) = 36 * k + 48 := by
  obtain ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23⟩ := closed_vals
  simp only [a_eq_b]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [show 12 * k + 6 = 12 * k + (6 + 0) from rfl, b_res k 0 (by norm_num), c0, c1]
  · rw [show 12 * k + 7 = 12 * k + (6 + 1) from rfl, b_res k 1 (by norm_num), c2, c3]
  · rw [show 12 * k + 8 = 12 * k + (6 + 2) from rfl, b_res k 2 (by norm_num), c4, c5]
  · rw [show 12 * k + 9 = 12 * k + (6 + 3) from rfl, b_res k 3 (by norm_num), c6, c7]
  · rw [show 12 * k + 10 = 12 * k + (6 + 4) from rfl, b_res k 4 (by norm_num), c8, c9]
  · rw [show 12 * k + 11 = 12 * k + (6 + 5) from rfl, b_res k 5 (by norm_num), c10, c11]
  · rw [show 12 * k + 12 = 12 * k + (6 + 6) from rfl, b_res k 6 (by norm_num), c12, c13]
  · rw [show 12 * k + 13 = 12 * k + (6 + 7) from rfl, b_res k 7 (by norm_num), c14, c15]
  · rw [show 12 * k + 14 = 12 * k + (6 + 8) from rfl, b_res k 8 (by norm_num), c16, c17]
  · rw [show 12 * k + 15 = 12 * k + (6 + 9) from rfl, b_res k 9 (by norm_num), c18, c19]
  · rw [show 12 * k + 16 = 12 * k + (6 + 10) from rfl, b_res k 10 (by norm_num), c20, c21]
  · rw [show 12 * k + 17 = 12 * k + (6 + 11) from rfl, b_res k 11 (by norm_num), c22, c23]

/-- Controls: the entry's data a(0..49). -/
theorem controls : (List.range 50).map a =
    [1, 4, 7, 8, 8, 10, 17, 24, 28, 28, 27, 28, 32, 40, 47, 48, 46, 48, 55, 60, 62, 64, 65, 64, 66, 76, 85, 84, 80, 84, 93, 96, 96, 100, 103, 100, 100, 112, 123, 120, 114, 120, 131, 132, 130, 136, 141, 136, 134, 148] := by
  rw [show a = b from funext a_eq_b]
  decide +kernel

/-- The steps satisfy the recurrence, on one period of the residues. -/
theorem drec_base : ∀ t : ℕ, t < 12 → (dv (t + 12) : ℤ) = 3 * (dv (t + 11) : ℤ) - 5 * (dv (t + 10) : ℤ) + 6 * (dv (t + 9) : ℤ) - 5 * (dv (t + 8) : ℤ) + 3 * (dv (t + 7) : ℤ) - 2 * (dv (t + 6) : ℤ) + 3 * (dv (t + 5) : ℤ) - 5 * (dv (t + 4) : ℤ) + 6 * (dv (t + 3) : ℤ) - 5 * (dv (t + 2) : ℤ) + 3 * (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
  decide +kernel

theorem drec (t : ℕ) : (dv (t + 12) : ℤ) = 3 * (dv (t + 11) : ℤ) - 5 * (dv (t + 10) : ℤ) + 6 * (dv (t + 9) : ℤ) - 5 * (dv (t + 8) : ℤ) + 3 * (dv (t + 7) : ℤ) - 2 * (dv (t + 6) : ℤ) + 3 * (dv (t + 5) : ℤ) - 5 * (dv (t + 4) : ℤ) + 6 * (dv (t + 3) : ℤ) - 5 * (dv (t + 2) : ℤ) + 3 * (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 12 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 1, e 2, e 3, e 4, e 5, e 6, e 7, e 8, e 9, e 10, e 11, e 12]
  exact drec_base (t % 12) (Nat.mod_lt _ (by norm_num))

/-- The recurrence on its first 12 terms, by the kernel. -/
theorem recur_base : ∀ q : ℕ, q < 12 → (b (q + 18) : ℤ) = 3 * b (q + 17) - 5 * b (q + 16) + 6 * b (q + 15) - 5 * b (q + 14) + 3 * b (q + 13) - 2 * b (q + 12) + 3 * b (q + 11) - 5 * b (q + 10) + 6 * b (q + 9) - 5 * b (q + 8) + 3 * b (q + 7) - b (q + 6) := by
  decide +kernel

theorem b_recur (q : ℕ) : (b (q + 18) : ℤ) = 3 * b (q + 17) - 5 * b (q + 16) + 6 * b (q + 15) - 5 * b (q + 14) + 3 * b (q + 13) - 2 * b (q + 12) + 3 * b (q + 11) - 5 * b (q + 10) + 6 * b (q + 9) - 5 * b (q + 8) + 3 * b (q + 7) - b (q + 6) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 12 ∨ 12 ≤ q by omega) with hq | hq
    · exact recur_base q hq
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 12 := ⟨q - 12, by omega⟩
      have h0 : (b (v + 18) : ℤ) = 3 * b (v + 17) - 5 * b (v + 16) + 6 * b (v + 15) - 5 * b (v + 14) + 3 * b (v + 13) - 2 * b (v + 12) + 3 * b (v + 11) - 5 * b (v + 10) + 6 * b (v + 9) - 5 * b (v + 8) + 3 * b (v + 7) - b (v + 6) := ih (v + 0) (by omega)
      have s6 : b (v + 18) = b (v + 6) + dv (v + 0) := by
        have h := b_step (v + 6) (by omega)
        rw [show v + 6 + 12 = v + 18 by omega,
          show v + 6 - 6 = v + 0 by omega] at h
        exact h
      have s7 : b (v + 19) = b (v + 7) + dv (v + 1) := by
        have h := b_step (v + 7) (by omega)
        rw [show v + 7 + 12 = v + 19 by omega,
          show v + 7 - 6 = v + 1 by omega] at h
        exact h
      have s8 : b (v + 20) = b (v + 8) + dv (v + 2) := by
        have h := b_step (v + 8) (by omega)
        rw [show v + 8 + 12 = v + 20 by omega,
          show v + 8 - 6 = v + 2 by omega] at h
        exact h
      have s9 : b (v + 21) = b (v + 9) + dv (v + 3) := by
        have h := b_step (v + 9) (by omega)
        rw [show v + 9 + 12 = v + 21 by omega,
          show v + 9 - 6 = v + 3 by omega] at h
        exact h
      have s10 : b (v + 22) = b (v + 10) + dv (v + 4) := by
        have h := b_step (v + 10) (by omega)
        rw [show v + 10 + 12 = v + 22 by omega,
          show v + 10 - 6 = v + 4 by omega] at h
        exact h
      have s11 : b (v + 23) = b (v + 11) + dv (v + 5) := by
        have h := b_step (v + 11) (by omega)
        rw [show v + 11 + 12 = v + 23 by omega,
          show v + 11 - 6 = v + 5 by omega] at h
        exact h
      have s12 : b (v + 24) = b (v + 12) + dv (v + 6) := by
        have h := b_step (v + 12) (by omega)
        rw [show v + 12 + 12 = v + 24 by omega,
          show v + 12 - 6 = v + 6 by omega] at h
        exact h
      have s13 : b (v + 25) = b (v + 13) + dv (v + 7) := by
        have h := b_step (v + 13) (by omega)
        rw [show v + 13 + 12 = v + 25 by omega,
          show v + 13 - 6 = v + 7 by omega] at h
        exact h
      have s14 : b (v + 26) = b (v + 14) + dv (v + 8) := by
        have h := b_step (v + 14) (by omega)
        rw [show v + 14 + 12 = v + 26 by omega,
          show v + 14 - 6 = v + 8 by omega] at h
        exact h
      have s15 : b (v + 27) = b (v + 15) + dv (v + 9) := by
        have h := b_step (v + 15) (by omega)
        rw [show v + 15 + 12 = v + 27 by omega,
          show v + 15 - 6 = v + 9 by omega] at h
        exact h
      have s16 : b (v + 28) = b (v + 16) + dv (v + 10) := by
        have h := b_step (v + 16) (by omega)
        rw [show v + 16 + 12 = v + 28 by omega,
          show v + 16 - 6 = v + 10 by omega] at h
        exact h
      have s17 : b (v + 29) = b (v + 17) + dv (v + 11) := by
        have h := b_step (v + 17) (by omega)
        rw [show v + 17 + 12 = v + 29 by omega,
          show v + 17 - 6 = v + 11 by omega] at h
        exact h
      have s18 : b (v + 30) = b (v + 18) + dv (v + 12) := by
        have h := b_step (v + 18) (by omega)
        rw [show v + 18 + 12 = v + 30 by omega,
          show v + 18 - 6 = v + 12 by omega] at h
        exact h
      have hd := drec v
      show (b (v + 30) : ℤ) = 3 * b (v + 29) - 5 * b (v + 28) + 6 * b (v + 27) - 5 * b (v + 26) + 3 * b (v + 25) - 2 * b (v + 24) + 3 * b (v + 23) - 5 * b (v + 22) + 6 * b (v + 21) - 5 * b (v + 20) + 3 * b (v + 19) - b (v + 18)
      omega

/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 17 < n → (a n : ℤ) = 3 * a (n - 1) - 5 * a (n - 2) + 6 * a (n - 3) - 5 * a (n - 4) + 3 * a (n - 5) - 2 * a (n - 6) + 3 * a (n - 7) - 5 * a (n - 8) + 6 * a (n - 9) - 5 * a (n - 10) + 3 * a (n - 11) - a (n - 12) := by
