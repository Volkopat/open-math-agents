import Mathlib

/-!
# OEIS A006697: conjectured generating function for a factor complexity

Source: https://oeis.org/A006697
`a n` is the number of subwords (factors) of length `n` of the infinite word generated by
`a ↦ aab`, `b ↦ b` (starting from `a`). Conjectured g.f.:
`1 + 1/(1-x) + 1/(1-x)² · [1/(1-x) - ∑_{k ≥ 1} x^(2^k + k - 1)]`.

Conventions. Letters are `a = true`, `b = false`. `σ^m(a)` is a prefix of `σ^(m+1)(a)`, so
the infinite word is `w i = (σ^(i+1)(a))[i]` (`σ^m(a)` has length `≥ m + 1`). Extracting
coefficients, the g.f. has `x^m`-coefficient
`1 + binom(m+2, 2) - ∑_{k ≥ 1, 2^k+k-1 ≤ m} (m - (2^k + k - 1) + 1)` for `m ≥ 1`. Matching the
data (`a 2 = 4, a 3 = 6, a 4 = 9, …`), the g.f. is read with offset 1 (its `x^m` coefficient is
`a (m+1)`). Its constant term `3` does not match `a 1 = 2`, so `main` states the identity for
`n = m + 1 ≥ 2`.

-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)
-/

namespace OMA.S_oeis_a006697

/-- The substitution `a ↦ aab`, `b ↦ b` on words over `Bool` (`a = true`). -/
def σ (l : List Bool) : List Bool := l.flatMap fun c => if c then [true, true, false] else [false]

/-- The infinite fixed point starting with `a`. -/
def w (i : ℕ) : Bool := ((σ^[i + 1] [true]).getD i false)

/-- The number of distinct factors of length `n` of `w`. -/
noncomputable def a (n : ℕ) : ℕ :=
  Set.ncard {u : Fin n → Bool | ∃ i : ℕ, ∀ j : Fin n, w (i + j) = u j}

theorem main :
    ∀ m : ℕ, 1 ≤ m → (a (m + 1) : ℤ) =
      1 + ((m + 2).choose 2 : ℤ) -
        ∑ k ∈ (Finset.Icc 1 m).filter (fun k => 2 ^ k + k - 1 ≤ m),
          ((m : ℤ) - (2 ^ k + k - 1) + 1) := by
  sorry

end OMA.S_oeis_a006697
