import Mathlib

/-!
# OEIS A069755: Frobenius number of three consecutive triangular numbers

Source: https://oeis.org/A069755
Credit: @sntntHb

A069755: Frobenius number of the numerical semigroup generated by 3 consecutive triangular
numbers (offset 2: 17, 29, 89, 125, 251, 323, 539, ...), i.e. `a(n)` is the Frobenius number of
`T(n), T(n+1), T(n+2)` with `T(k) = k*(k+1)/2`.

Conjecture (Colin Barker, Nov 22 2012):
`a(n) = (-14 + 6*(-1)^n + (3+9*(-1)^n)*n + 3*(5+(-1)^n)*n^2 + 6*n^3)/8`.

Formalized: `main` states, for every `n >= 2`, that Barker's expression (computed in `ℤ`, where it
is an exact multiple of 8 and positive) is the Frobenius number, in the sense of Mathlib's
`FrobeniusNumber`, of the set `{T n, T (n+1), T (n+2)}`.
-/

namespace OMA.S_oeis_a069755

/-- The triangular number `T(k) = k*(k+1)/2`. -/
def T (k : ℕ) : ℕ := k * (k + 1) / 2

/-- Barker's conjectured closed form, in `ℤ`. -/
def f (n : ℕ) : ℤ :=
  (-14 + 6 * (-1) ^ n + (3 + 9 * (-1) ^ n) * (n : ℤ) + 3 * (5 + (-1) ^ n) * (n : ℤ) ^ 2 +
    6 * (n : ℤ) ^ 3) / 8

theorem main : ∀ n : ℕ, 2 ≤ n → FrobeniusNumber (f n).toNat {T n, T (n + 1), T (n + 2)} := by
  sorry

end OMA.S_oeis_a069755
