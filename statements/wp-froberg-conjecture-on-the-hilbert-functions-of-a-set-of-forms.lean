import Mathlib

/-!
# Fröberg conjecture on the Hilbert functions of a set of forms

Source: https://en.wikipedia.org/wiki/Fr%C3%B6berg_conjecture
Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)

Fröberg's conjecture: if `f₁, …, f_r` are generic forms of degrees `d₁, …, d_r` in
`R = k[x₁, …, xₙ]`, then the Hilbert series of `R / (f₁, …, f_r)` is
`[∏ᵢ (1 - t^{dᵢ}) / (1 - t)ⁿ]₊`, the power series truncated just before its first non-positive
coefficient.

## Encoding

* `k = ℂ`, `n ≥ 1`, `dᵢ ≥ 1`. The Hilbert function in degree `j` is
  `dim R_j - dim (I ∩ R_j)` with `R_j` the homogeneous polynomials of degree `j`
  (`MvPolynomial.homogeneousSubmodule`) and `I` the ideal generated by the forms.
* The `j`-th coefficient of `∏ᵢ (1 - t^{dᵢ}) / (1 - t)ⁿ` is
  `∑_{S ⊆ [r]} (-1)^{|S|} C(j - d_S + n - 1, n - 1)` (terms with `d_S = ∑_{i ∈ S} dᵢ > j`
  omitted); the truncation `[·]₊` keeps the coefficient in degree `j` iff all coefficients in
  degrees `≤ j` are positive, and is `0` otherwise.
* "Generic forms have Hilbert series `E`" is stated as "some forms have Hilbert series `E`".
  These are equivalent: each `dim (I ∩ R_j)` is the rank of a linear map depending polynomially
  on the coefficients, so generic forms minimise every value of the Hilbert function, and
  Fröberg proved that the Hilbert series of generic forms is lexicographically at least `E`;
  hence forms attaining `E` exist iff generic forms attain it.
-/

namespace OMA.S_wp_froberg_conjecture_on_the_hilbert_functions_of_a_set_of_forms

open MvPolynomial

/-- Hilbert function in degree `j` of `ℂ[x₁, …, xₙ] / (f₁, …, f_r)`. -/
noncomputable def hilbertFn {n r : ℕ} (f : Fin r → MvPolynomial (Fin n) ℂ) (j : ℕ) : ℤ :=
  (Module.finrank ℂ (homogeneousSubmodule (Fin n) ℂ j) : ℤ) -
    Module.finrank ℂ ↥((Ideal.span (Set.range f)).restrictScalars ℂ ⊓
      homogeneousSubmodule (Fin n) ℂ j)

/-- The `j`-th coefficient of `∏ᵢ (1 - t^{dᵢ}) / (1 - t)ⁿ`. -/
def coeffE {r : ℕ} (n : ℕ) (d : Fin r → ℕ) (j : ℕ) : ℤ :=
  ∑ S : Finset (Fin r), (-1) ^ S.card *
    (if ∑ i ∈ S, d i ≤ j then ((j - ∑ i ∈ S, d i + n - 1).choose (n - 1) : ℤ) else 0)

/-- The truncated series `[∏ᵢ (1 - t^{dᵢ}) / (1 - t)ⁿ]₊`, coefficient `j`. -/
def expected {r : ℕ} (n : ℕ) (d : Fin r → ℕ) (j : ℕ) : ℤ :=
  if ∀ i ≤ j, 0 < coeffE n d i then coeffE n d j else 0

theorem main :
    ∀ (n r : ℕ) (d : Fin r → ℕ), 1 ≤ n → (∀ i, 1 ≤ d i) →
      ∃ f : Fin r → MvPolynomial (Fin n) ℂ, (∀ i, (f i).IsHomogeneous (d i)) ∧
        ∀ j : ℕ, hilbertFn f j = expected n d j := by
  sorry

end OMA.S_wp_froberg_conjecture_on_the_hilbert_functions_of_a_set_of_forms
