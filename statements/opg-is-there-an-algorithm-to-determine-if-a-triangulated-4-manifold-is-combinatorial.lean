import Mathlib

/-!
# Is there an algorithm to determine if a triangulated 4-manifold is combinatorially equivalent
to the 4-sphere?

Source: https://www.openproblemgarden.org/op/is_there_an_algorithm_to_determine_if_a_triangulated_4_manifold_is_combinatorial
-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)

Problem (Novikov): is there an algorithm which takes as input a triangulated 4-manifold and
determines whether or not it is combinatorially equivalent to the 4-sphere?

Conventions:
* A pure `n`-dimensional simplicial complex on vertex set `ℕ` is given by its set of facets,
  finite sets of `n + 1` naturals. Inputs are encoded as `List (List ℕ)` (a list of facets).
* Combinatorial equivalence is, as in the source, the equivalence generated by Pachner
  (bistellar) moves; we also allow renaming vertices by an injection of `ℕ`. A Pachner move on an
  `n`-complex: for disjoint nonempty `σ, τ` with `|σ| + |τ| = n + 2`, if the facets containing `σ`
  are exactly the sets `(σ ∪ τ) \ {x}`, `x ∈ τ`, and `τ` is not a face, replace them by the
  sets `(σ ∪ τ) \ {y}`, `y ∈ σ`.
* A triangulated (closed) 4-manifold is taken to be a combinatorial one: a nonempty pure
  4-complex in which the link of every vertex is combinatorially equivalent to the boundary of
  the 4-simplex. In dimension 4 every triangulation of a topological manifold is of this kind
  (vertex links are simply connected closed 3-manifolds, hence PL 3-spheres).
* The 4-sphere is the boundary of the 5-simplex.
* The source asks a yes/no question; `main` states the answer yes, and a disproof would answer
  no.
-/

namespace OMA.S_opg_is_there_an_algorithm_to_determine_if_a_triangulated_4_manifold_is_combinatorial

/-- A single Pachner move on a pure `n`-complex given by its facets. -/
def PachnerMove (n : ℕ) (K K' : Finset (Finset ℕ)) : Prop :=
  ∃ σ τ : Finset ℕ, σ.Nonempty ∧ τ.Nonempty ∧ Disjoint σ τ ∧ σ.card + τ.card = n + 2 ∧
    K.filter (fun f => σ ⊆ f) = τ.image (fun x => (σ ∪ τ).erase x) ∧
    (∀ f ∈ K, ¬ τ ⊆ f) ∧
    K' = K.filter (fun f => ¬ σ ⊆ f) ∪ σ.image (fun y => (σ ∪ τ).erase y)

/-- Renaming the vertices by an injection. -/
def Relabel (K K' : Finset (Finset ℕ)) : Prop :=
  ∃ e : ℕ ↪ ℕ, K' = K.image (Finset.map e)

/-- Combinatorial equivalence of pure `n`-complexes. -/
def CombEquiv (n : ℕ) : Finset (Finset ℕ) → Finset (Finset ℕ) → Prop :=
  Relation.EqvGen (fun K K' => PachnerMove n K K' ∨ Relabel K K')

/-- The boundary of the `(n+1)`-simplex, a triangulated `n`-sphere. -/
def sphere (n : ℕ) : Finset (Finset ℕ) := (Finset.range (n + 2)).powersetCard (n + 1)

/-- The link of a vertex, as a set of facets. -/
def link (K : Finset (Finset ℕ)) (v : ℕ) : Finset (Finset ℕ) :=
  (K.filter (fun f => v ∈ f)).image (fun f => f.erase v)

/-- A closed combinatorial 4-manifold. -/
def IsComb4Manifold (K : Finset (Finset ℕ)) : Prop :=
  K.Nonempty ∧ (∀ f ∈ K, f.card = 5) ∧
    ∀ f ∈ K, ∀ v ∈ f, CombEquiv 3 (link K v) (sphere 3)

/-- The complex encoded by a list of facets. -/
def decode (L : List (List ℕ)) : Finset (Finset ℕ) := (L.map List.toFinset).toFinset

theorem main :
    ∃ f : List (List ℕ) → Bool, Computable f ∧
      ∀ L : List (List ℕ), IsComb4Manifold (decode L) →
        (f L = true ↔ CombEquiv 4 (decode L) (sphere 4)) := by
  sorry

end OMA.S_opg_is_there_an_algorithm_to_determine_if_a_triangulated_4_manifold_is_combinatorial
