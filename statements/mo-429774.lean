import Mathlib

/-!
# Total variation for permutations generated by all transposition words of bounded length

Source: KhashF, https://mathoverflow.net/questions/429774 (CC BY-SA 4.0).
Credit: @connoranderson.

The experiment chooses uniformly from all words of length at most k, including
the empty word. An edge is an unordered pair of distinct indices, represented
by its increasing ordering. For n at least two the parity imbalance gives a
lower bound. It is exact for every sufficiently large k at fixed n, so every
sufficiently large odd k minimizes the distance. In the growing-dimension
regime k=n-1 the distance instead tends to one.
-/

namespace OMA.S_mo_429774
open Filter Finset Equiv
open scoped Topology

abbrev G (n : ℕ) := Equiv.Perm (Fin n)
abbrev Edge (n : ℕ) := {p : Fin n × Fin n // p.1<p.2}
def step {n : ℕ} (e : Edge n) : G n := Equiv.swap e.val.1 e.val.2
def endpoint {n t : ℕ} (w : Fin t → Edge n) : G n := (List.ofFn (fun j => step (w j))).prod

noncomputable def paths (n t : ℕ) (g : G n) : ℕ := (univ.filter (fun w : Fin t → Edge n => endpoint w=g)).card
def countEdges (n : ℕ) : ℕ := Fintype.card (Edge n)
def total (n k : ℕ) : ℕ := ∑ t ∈ range (k+1), (countEdges n)^t
noncomputable def mass (n k : ℕ) (g : G n) : ℝ :=
  (∑ t ∈ range (k+1), (paths n t g : ℝ))/(total n k:ℝ)
noncomputable def tv (n k : ℕ) : ℝ :=
  (∑ g : G n, |mass n k g - (Fintype.card (G n):ℝ)⁻¹|)/2
noncomputable def parityGap (n k : ℕ) : ℝ :=
  |∑ t ∈ range (k+1), (-(countEdges n:ℝ))^t|/(2*(total n k:ℝ))
noncomputable def minimumGap (n : ℕ) : ℝ :=
  ((countEdges n:ℝ)-1)/(2*((countEdges n:ℝ)+1))

theorem main :
    (∀ k, tv 1 k=0) ∧
    (∀ n, 2≤n → (∀ k, minimumGap n ≤ parityGap n k ∧ parityGap n k ≤ tv n k) ∧
      (∀ᶠ k in atTop, tv n k=parityGap n k) ∧
      (∀ᶠ j in atTop, tv n (2*j+1)=minimumGap n) ∧
      (∀ j, minimumGap n < tv n (2*j))) ∧
    Tendsto (fun n => tv n (n-1)) atTop (𝓝 1) := by
  sorry

end OMA.S_mo_429774
