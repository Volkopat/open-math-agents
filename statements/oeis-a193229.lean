import Mathlib.Data.Nat.Factorial.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Basic

namespace OMA.S_oeis_a193229

/-- OEIS A193229: double factorial triangle `T(n, k)` generated by the production matrix
`M[i, j] = i + 1` for `j ≤ i + 1` and `0` otherwise (`0`-indexed), so that `T(0, 0) = 1`,
`T(0, k + 1) = 0`, and `T(n + 1, k) = ∑_{i = 0}^{n} (if k ≤ i + 1 then (i + 1) * T(n, i) else 0)`. -/
def a193229 : ℕ → ℕ → ℕ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, k => ∑ i ∈ Finset.range (n + 1), if k ≤ i + 1 then (i + 1) * a193229 n i else 0

/-- OEIS A193229 conjecture (Peter Bala, Jul 09 2012):
For all `n : ℕ` and `k ≤ n`, `T(n, k) = (2 * n - k)! / (2^(n - k) * (n - k)!)`,
written integrally as `2^(n - k) * (n - k)! * T(n, k) = (2 * n - k)!`. -/
theorem main :
    ∀ n k : ℕ, k ≤ n →
      2 ^ (n - k) * (n - k).factorial * a193229 n k = (2 * n - k).factorial := by
  sorry

end OMA.S_oeis_a193229
