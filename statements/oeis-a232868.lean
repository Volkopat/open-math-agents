import Mathlib

/-!
# OEIS A232868: positions of the integers in Kimberling's tree of x + 1 and i x

Source: https://oeis.org/A232868 (OEIS Foundation, CC BY-SA 4.0).
Formalization: AI-generated with Claude Code (model claude-opus-5-5), submitted by @jleguina.

Entry (Clark Kimberling, Dec 01 2013), offset 1: Positions of the integers in the sequence (or
tree) of complex numbers generated by these rules: 0 is in S, and if x is in S, then x + 1 and i*x
are in S, where duplicates are deleted as they occur. Mathematica: x = {0}; Do[x =
DeleteDuplicates[Flatten[Transpose[{x, x + 1, I*x}]]], {40}]; t1 = positions of n (n >= 0),
t2 = positions of -n (n >= 1), Union[t1, t2]. Data: 1, 2, 3, 5, 8, 9, 12, 16, 19, 27, 30, 42,
... Formulas (Chai Wah Wu, Feb 20 2018, both marked conjectured): a(n) = a(n-1) + 2*a(n-2) -
2*a(n-3) - a(n-4) + a(n-5) for n > 10. G.f.: x*(-x^9 - 4*x^7 + 2*x^6 + 2*x^5 - 2*x^4 + x^2 - x -
1)/((x - 1)^3*(x + 1)^2).

Formalization notes:
* The elements of S are Gaussian integers (`GaussianInt`), i is ⟨0, 1⟩. `step` is one pass of
  the Mathematica loop (each x followed by x + 1 and i*x, then duplicates deleted keeping first
  occurrences, `List.eraseDups`); `Lst t` is the list after t passes. Each pass appends to the
  previous list (proved in the proof file), so `elt p`, the entry at index p - 1 of `Lst p`, is
  the p-th element of S (the list after p passes has more than p elements).
* The integers of S are its elements with imaginary part 0, and a(n) is the n-th position, in
  increasing order and counted from 1, holding an integer (`Nat.nth`, offset 1).
* The g.f. is Sum_{n >= 1} a(n) x^n, stated as A(x)*(x - 1)^3*(x + 1)^2 = N(x) in Z[[x]],
  equivalent because the denominator has constant term -1. `main` is the conjunction of both.
* Controls proved in the proof file: a(1..10) = 1, 2, 3, 5, 8, 9, 12, 16, 19, 27.
-/

namespace OMA.S_oeis_a232868

/-- The imaginary unit in the Gaussian integers. -/
def iu : GaussianInt := ⟨0, 1⟩

/-- One round of the construction: each element x of the list is followed by x + 1 and i*x, and
duplicates are then deleted, keeping first occurrences (Mathematica's DeleteDuplicates). -/
def step (L : List GaussianInt) : List GaussianInt :=
  (L.flatMap fun x => [x, x + 1, iu * x]).eraseDups

/-- The list after t rounds, starting from (0). -/
def Lst : ℕ → List GaussianInt
  | 0 => [0]
  | t + 1 => step (Lst t)

/-- The p-th element of S, counted from 1 (read off the list after p rounds). -/
def elt (p : ℕ) : GaussianInt := (Lst p).getD (p - 1) 0

/-- A232868 (offset 1): the n-th position, in increasing order, at which S has an integer. -/
noncomputable def a (n : ℕ) : ℕ := Nat.nth (fun p => 1 ≤ p ∧ (elt p).im = 0) (n - 1)

/-- Wu's two conjectures. -/
theorem main :
    (∀ n : ℕ, 10 < n →
      (a n : ℤ) = a (n - 1) + 2 * a (n - 2) - 2 * a (n - 3) - a (n - 4) + a (n - 5)) ∧
    PowerSeries.mk (fun n => if n = 0 then (0 : ℤ) else (a n : ℤ)) *
        ((PowerSeries.X - 1) ^ 3 * (PowerSeries.X + 1) ^ 2) =
      PowerSeries.X * (-PowerSeries.X ^ 9 - 4 * PowerSeries.X ^ 7 + 2 * PowerSeries.X ^ 6 +
        2 * PowerSeries.X ^ 5 - 2 * PowerSeries.X ^ 4 + PowerSeries.X ^ 2 - PowerSeries.X - 1) := by
  sorry

end OMA.S_oeis_a232868
