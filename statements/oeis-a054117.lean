import Mathlib

/-!
# Mathar's recurrence conjecture for OEIS A054117

Source: https://oeis.org/A054117
Source data: https://raw.githubusercontent.com/oeis/oeisdata/main/seq/A054/A054117.seq
Credit: @sntntHb

OEIS A054117 (offset 2) is a(n) = T(n, n-2), where T is the triangle A054115, generated by its
row sums: T(n, 0) = 1 for n >= 1, T(n, 1) = r(n-1), T(n, k) = T(n, k-1) + r(n-k) for
k = 2, ..., n (n >= 2), with r(h) the sum of the numbers in row h of T and T(0, 0) = 1.
Thus T(n, k) = r(n-1) + ... + r(n-k) for 1 <= k <= n. The first terms are
1, 6, 30, 150, 870, 5910.

Conjecture (R. J. Mathar, Jun 13 2013, quoted from the entry):
a(n) -(n+1)*a(n-1) +n*a(n-2) = 0.
The entry gives no range. At the first index n = 4 where a(n-2) is defined the left side is
30 - 5*6 + 4*1 = 4, so the recurrence is stated here for every n >= 5.
-/

namespace OMA.S_oeis_a054117

/-- The row sums r(h) of A054115: r(0) = 1, and for h >= 0 row h + 1 is
1, r(h), r(h) + r(h-1), ..., r(h) + ... + r(0). -/
def r : ℕ → ℕ
  | 0 => 1
  | h + 1 => 1 + ∑ k ∈ Finset.range (h + 1), ∑ j ∈ Finset.range (k + 1), r (h - j)
decreasing_by omega

/-- The triangle A054115: T(n, 0) = 1 and T(n, k) = r(n-1) + ... + r(n-k) for 1 <= k <= n. -/
def T (n k : ℕ) : ℕ :=
  if k = 0 then 1 else ∑ j ∈ Finset.Icc 1 k, r (n - j)

/-- OEIS A054117: a(n) = T(n, n-2), for n >= 2. -/
def a (n : ℕ) : ℤ := T n (n - 2)

/-- Mathar's conjectured recurrence, for every n >= 5. -/
theorem main : ∀ n : ℕ, 5 ≤ n →
    a n - ((n : ℤ) + 1) * a (n - 1) + (n : ℤ) * a (n - 2) = 0 := by
  sorry

end OMA.S_oeis_a054117
