import Mathlib

namespace OMA.S_arxiv_2504_14475

/-- An interior operator on a poset `L`: contractive, monotone, and idempotent. -/
def IsInteriorOp {L : Type*} [PartialOrder L] (i : L → L) : Prop :=
  (∀ x, i x ≤ x) ∧ Monotone i ∧ (∀ x, i (i x) = i x)

/-- A pseudocomplement operator on a poset `L`, characterized by the Galois condition
`a ≤ n x ↔ x ≤ n a` (Ciraulo 2025; Bowron, arXiv:2504.14475). -/
def IsPseudoComp {L : Type*} [PartialOrder L] (n : L → L) : Prop :=
  ∀ a x, a ≤ n x ↔ x ≤ n a

/-- Evaluate a word over `{i, -}` (`false = i`, `true = -`), rightmost letter applied first. -/
def evalIPWord {L : Type*} (i n : L → L) : List Bool → L → L
  | [], x => x
  | false :: w, x => i (evalIPWord i n w x)
  | true :: w, x => n (evalIPWord i n w x)

/-- The 31 operators in Ciraulo's interior--pseudocomplement monoid `M` (Figure 2 of
arXiv:2504.14475), with `b = - i -`. Indices `0..16` form the upper component and `17..30`
form the lower component. -/
def ipOpWord (k : Fin 31) : List Bool :=
  match k.val with
  | 0  => [false]                                                        -- i
  | 1  => [false, true, true, false]                                     -- i--i
  | 2  => [false, true, true]                                            -- i--
  | 3  => [false, true, false, true, false]                              -- ibi
  | 4  => [true, true, false]                                            -- --i
  | 5  => [false, true, false, true, false, true, true]                  -- ibi--
  | 6  => [true, true, false, true, true]                                -- -b-
  | 7  => [true, true, false, true, false, true, false]                  -- --ibi
  | 8  => [false, true, false, true]                                     -- ib
  | 9  => [true, true, false, true, false, true, false, true, true]      -- --ibi--
  | 10 => [true, false, true, false]                                     -- bi
  | 11 => [true, true, false, true, false, true]                         -- --ib
  | 12 => [true, false, true, false, true, true]                         -- bi--
  | 13 => [true, false, true, false, true, false, true]                  -- bib
  | 14 => [true, false, true]                                            -- b
  | 15 => []                                                             -- id
  | 16 => [true, true]                                                   -- --
  | 17 => [false, true]                                                  -- i-
  | 18 => [true, true, false, true]                                      -- -b
  | 19 => [true]                                                         -- -
  | 20 => [true, true, false, true, false, true, false, true]            -- -bib
  | 21 => [false, true, false, true, false, true]                        -- ibi-
  | 22 => [false, true, false, true, true]                               -- ib-
  | 23 => [true, false, true, false, true]                               -- -ib
  | 24 => [true, true, false, true, false, true, true]                   -- -bi--
  | 25 => [false, true, false]                                           -- i-i
  | 26 => [true, false, true, false, true, false, true, true]            -- bib-
  | 27 => [true, true, false, true, false]                               -- -bi
  | 28 => [true, false, true, true]                                      -- b-
  | 29 => [true, false, true, false, true, false]                        -- -ibi
  | _  => [true, false]                                                  -- -i

/-- The 46 covering edges of Ciraulo's Hasse diagram of `M` (Figure 2 of arXiv:2504.14475). -/
def ipHasseEdges : List (Fin 31 × Fin 31) :=
  -- Upper component (26 edges)
  [(0, 1), (1, 2), (2, 6),
   (1, 3), (3, 5), (5, 8), (8, 11), (11, 13), (13, 14),
   (1, 4), (4, 6), (6, 9), (9, 11),
   (3, 7), (7, 9), (9, 12), (12, 13),
   (5, 9),
   (7, 10), (10, 12),
   (2, 5),
   (4, 7),
   (0, 15), (15, 16), (16, 14),
   (6, 16),
   -- Lower component (20 edges)
   (17, 18), (18, 19), (19, 28), (28, 30),
   (18, 20), (20, 23), (23, 26), (26, 28),
   (17, 21), (21, 20), (20, 24), (24, 26), (26, 29), (29, 30),
   (21, 22), (22, 24), (24, 27), (27, 29),
   (22, 25), (25, 27)]

/-- Partial order on `M` generated by the Hasse diagram in Figure 2 of arXiv:2504.14475. -/
def IPOpLE (u v : Fin 31) : Prop :=
  Relation.ReflTransGen (fun a b => (a, b) ∈ ipHasseEdges) u v

/-- The closed nucleus `x ↦ a ⊔ x` corresponding to the closed sublocale `↑a` of a frame `L`. -/
def closedNucleus {L : Type*} [Order.Frame L] (a : L) : Nucleus L where
  toFun x := a ⊔ x
  map_inf' x y := sup_inf_left a x y
  idempotent' x := by simp
  le_apply' x := le_sup_right

/-- The open nucleus `x ↦ a ⇨ x` corresponding to the open sublocale `O_a` of a frame `L`. -/
def openNucleus {L : Type*} [Order.Frame L] (a : L) : Nucleus L where
  toFun x := a ⇨ x
  map_inf' x y := himp_inf_distrib a x y
  idempotent' x := by rw [himp_himp, inf_idem]
  le_apply' x := le_himp

/-- Closure of a sublocale (represented as a nucleus in `(Nucleus L, ≤) ≅ (S(L), ⊇)`):
the largest closed nucleus `≤ m`, i.e., `closedNucleus (m ⊥)`. -/
def sublocaleClosure {L : Type*} [Order.Frame L] (m : Nucleus L) : Nucleus L :=
  closedNucleus (m ⊥)

/-- Interior of a sublocale (represented as a nucleus in `(Nucleus L, ≤) ≅ (S(L), ⊇)`):
the largest open sublocale contained in `m`, i.e., the infimum in `Nucleus L` of all open
nuclei `≥ m`. -/
def sublocaleInterior {L : Type*} [Order.Frame L] (m : Nucleus L) : Nucleus L :=
  ⨅ (a : L) (_ : m ≤ openNucleus a), openNucleus a

/-- Generators of the localic closure--interior--supplement monoid on `(S(L), ⊆)`. -/
inductive LocGen where
  | c -- closure
  | i -- interior
  | s -- supplement (co-pseudocomplement in `(S(L), ⊆)`, i.e., `compl` in `Nucleus L`)
  deriving DecidableEq

/-- Evaluate a word over `{c, i, -}` on `Nucleus L`, rightmost letter applied first. -/
def evalLocWord {L : Type*} [Order.Frame L] : List LocGen → Nucleus L → Nucleus L
  | [], m => m
  | .c :: w, m => sublocaleClosure (evalLocWord w m)
  | .i :: w, m => sublocaleInterior (evalLocWord w m)
  | .s :: w, m => (evalLocWord w m)ᶜ

/-- The 21 operators in Ciraulo's localic closure--supplement Hasse diagram on `(S(L), ⊆)`
(lower diagram of Figure 3 of arXiv:2504.14475). -/
def locOpWord (k : Fin 21) : List LocGen :=
  match k.val with
  | 0  => [.i]                      -- i
  | 1  => [.i, .c, .i]              -- ici
  | 2  => [.i, .c, .s, .s]          -- ic--
  | 3  => [.i, .c]                  -- ic
  | 4  => [.c, .i]                  -- ci
  | 5  => [.c, .i, .c, .s, .s]      -- cic--
  | 6  => [.c, .i, .c]              -- cic
  | 7  => [.c, .s, .s]              -- c--
  | 8  => [.c]                      -- c
  | 9  => [.s, .s]                  -- --
  | 10 => []                        -- id
  | 11 => [.s, .c]                  -- -c
  | 12 => [.i, .s]                  -- i-
  | 13 => [.s, .c, .i, .c]          -- -cic
  | 14 => [.i, .c, .i, .s]          -- ici-
  | 15 => [.s, .i, .c]              -- -ic
  | 16 => [.s]                      -- -
  | 17 => [.s, .c, .i]              -- -ci
  | 18 => [.c, .i, .s]              -- ci-
  | 19 => [.s, .i, .c, .i]          -- -ici
  | _  => [.s, .i]                  -- -i

/-- The 28 covering edges of the localic closure--supplement Hasse diagram on `(S(L), ⊆)`
(lower diagram of Figure 3 of arXiv:2504.14475), directed from smaller to larger sublocale. -/
def locHasseEdges : List (Fin 21 × Fin 21) :=
  -- Left component (15 edges)
  [(0, 1), (1, 2), (2, 3), (3, 6), (6, 8),
   (1, 4), (4, 5), (5, 6),
   (2, 5), (5, 7),
   (0, 9), (9, 10), (10, 8),
   (9, 7), (7, 8),
   -- Right component (13 edges)
   (11, 12), (12, 16), (16, 20),
   (11, 13), (13, 14), (14, 17), (17, 19), (19, 20),
   (12, 14), (14, 18), (18, 19),
   (13, 15), (15, 18)]

/-- Partial order on the 21 localic operators generated by the lower Hasse diagram of Figure 3
of arXiv:2504.14475 (in the sublocale inclusion order `⊆`, which reverses the order on `Nucleus L`). -/
def LocOpLE (u v : Fin 21) : Prop :=
  Relation.ReflTransGen (fun a b => (a, b) ∈ locHasseEdges) u v

/-- Bowron (arXiv:2504.14475), Proposition 1 and Theorem 3, resolving both diagram-completeness
problems left open by Ciraulo (2025):
1. The 31-operator Hasse diagram of the interior--pseudocomplement monoid `M` on posets is
   sound and complete: `u ≤ v` holds universally across all posets `(L, ≤)` with interior `i`
   and pseudocomplement `n` if and only if `IPOpLE u v`.
2. The 21-operator Hasse diagram of the closure--supplement monoid on sublocales `(S(L), ⊆)`
   (equivalently `(Nucleus L, ≥)`) is sound and complete: `u(S) ⊆ v(S)` holds universally
   across all frames `L` and sublocales `S` if and only if `LocOpLE u v`. -/
theorem main :
    (∀ u v : Fin 31,
      (∀ (L : Type) [PartialOrder L] (i n : L → L),
        IsInteriorOp i → IsPseudoComp n →
        ∀ x : L, evalIPWord i n (ipOpWord u) x ≤ evalIPWord i n (ipOpWord v) x) ↔
      IPOpLE u v) ∧
    (∀ u v : Fin 21,
      (∀ (L : Type) [Order.Frame L] (m : Nucleus L),
        evalLocWord (locOpWord v) m ≤ evalLocWord (locOpWord u) m) ↔
      LocOpLE u v) := by
  sorry

end OMA.S_arxiv_2504_14475
