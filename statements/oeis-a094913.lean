import Mathlib

/-!
# A094913: Maximal number of distinct nonempty substrings of any binary string of length n.

Source: https://oeis.org/A094913
Credit: @mscheuern

Conjecture (Vladeta Jovovic, Sep 19 2005; restated by M. F. Hasler, Dec 17 2007):
`a(n) = A006697(n) - 1`, where A006697(n) is the number of subwords (factors) of length `n` of
the infinite word generated by `a ↦ aab`, `b ↦ b`. The OEIS notes that all computed values
confirm it. Both sequences have offset 0:
`A094913 = 0, 1, 3, 5, 8, 12, 16, 21, 27, 34, 42, 50, 59, …` and
`A006697 = 1, 2, 4, 6, 9, 13, 17, 22, 28, 35, 43, 51, 60, …`.
`main` states it in the subtraction-free form `a n + 1 = A006697 n` for every `n`.

Formalization notes:
* A binary string of length `n` is `u : Fin n → Bool`, read as the list `List.ofFn u`.
  A substring is a contiguous factor: `v <:+: List.ofFn u` (`List.IsInfix`). Only nonempty
  substrings are counted, as in the OEIS name, and equal substrings at different positions
  count once (a set of lists). `a n` is the maximum of this count over all `2^n` strings,
  written as `Finset.sup` over `Finset.univ`. For `n = 0` the only string is empty and
  `a 0 = 0`.
* A006697 uses the conventions of the merged statement `statements/oeis-a006697.lean`
  (copied here, since statements do not import each other): letters `a = true`, `b = false`,
  `σ` is the substitution, `w i = (σ^(i+1)(a))[i]` is the infinite fixed point, and
  `A006697 n` is the number of distinct length-`n` factors of `w`, with `A006697 0 = 1`
  (the empty factor).
* Checked numerically before writing: brute force over all strings gives
  `a 0, …, a 14 = 0, 1, 3, 5, 8, 12, 16, 21, 27, 34, 42, 50, 59, 69, 80`, and counting factors
  of a 2,097,151-letter prefix of `w` gives `A006697 n - 1` equal to these values (and to the
  OEIS data through `n = 18`).
-/

namespace OMA.S_oeis_a094913

/-- A094913: the maximal number of distinct nonempty substrings of a binary string of
length `n`. -/
noncomputable def a (n : ℕ) : ℕ :=
  (Finset.univ : Finset (Fin n → Bool)).sup fun u =>
    Set.ncard {v : List Bool | v ≠ [] ∧ v <:+: List.ofFn u}

/-- The substitution `a ↦ aab`, `b ↦ b` on words over `Bool` (`a = true`). -/
def σ (l : List Bool) : List Bool := l.flatMap fun c => if c then [true, true, false] else [false]

/-- The infinite fixed point of `σ` starting with `a`. -/
def w (i : ℕ) : Bool := ((σ^[i + 1] [true]).getD i false)

/-- A006697: the number of distinct factors of length `n` of `w`. -/
noncomputable def A006697 (n : ℕ) : ℕ :=
  Set.ncard {u : Fin n → Bool | ∃ i : ℕ, ∀ j : Fin n, w (i + j) = u j}

/-- Jovovic's conjecture: `A094913(n) = A006697(n) - 1` for every `n`. -/
theorem main : ∀ n : ℕ, a n + 1 = A006697 n := by
  sorry

end OMA.S_oeis_a094913
