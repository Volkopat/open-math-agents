import Mathlib

/-!
# Do we have independence if we let the indices of the events increase?

Source: https://mathoverflow.net/questions/229136
Credit: @zarnab222-dev

Both indices start at zero here, so column n has (n+1)-wise independence.
Independence of measurable events means factorization of every finite intersection.
Tail membership means measurability in the sigma algebra generated by each suffix of a row.
-/

namespace OMA.S_mo_229136

open MeasureTheory

def Factors {Ω : Type} [MeasurableSpace Ω] (μ : Measure Ω) (A : ℕ → Set Ω)
    (s : Finset ℕ) : Prop :=
  μ.real (⋂ i ∈ s, A i) = ∏ i ∈ s, μ.real (A i)

theorem main :
    ∀ (Ω : Type) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
      (A : ℕ → ℕ → Set Ω) (B : ℕ → Set Ω),
      (∀ i n, MeasurableSet (A i n)) →
      (∀ n s, s.card ≤ n + 1 → Factors μ (fun i => A i n) s) →
      (∀ i N, MeasurableSet[MeasurableSpace.generateFrom (Set.range (fun k => A i (N+k)))] (B i)) →
      ∀ s, Factors μ B s := by
  sorry

end OMA.S_mo_229136
