import Mathlib

/-!
# A080578: a(1)=1; for n > 1, a(n) = a(n-1) + 1 if n is already in the sequence, a(n) = a(n-1) + 3 otherwise.

Source: https://oeis.org/A080578
Credit: @agchua

Formula line of A080578, by Ralf Stephan, Dec 27 2013:
  a(n) = A055938(n-1) + 2 (conjectured).
A055938 (offset 1) is the list, in increasing order, of the integers not generated by
b(n) = b(floor(n/2)) + n, i.e. the complement of A005187 (b(0) = 0); so A055938(j) is
Nat.nth NotGen (j - 1). A080578 has offset 1 and A055938(n-1) exists for n ≥ 2, so the claim is
stated for n ≥ 2. In the definition of a(n), n is already in the sequence when it is one of
a(1), ..., a(n-1); terms k is the list [a(1), ..., a(k+1)].
-/

namespace OMA.S_oeis_a080578

/-- The list [a(1), ..., a(k+1)] of the first k+1 terms of A080578. -/
def terms : ℕ → List ℕ
  | 0 => [1]
  | k + 1 => terms k ++ [(terms k).getLast?.getD 0 + if k + 2 ∈ terms k then 1 else 3]

/-- A080578(n), n ≥ 1: the last entry of [a(1), ..., a(n)]. -/
def a (n : ℕ) : ℕ := (terms (n - 1)).getLast?.getD 0

/-- A005187: b(0) = 0, b(n) = b(floor(n/2)) + n. -/
def b : ℕ → ℕ
  | 0 => 0
  | n + 1 => b ((n + 1) / 2) + (n + 1)

/-- x is not generated by b; A055938 lists these integers in increasing order. -/
def NotGen (x : ℕ) : Prop := ∀ m : ℕ, b m ≠ x

/-- The conjecture: a(n) = A055938(n-1) + 2 for n ≥ 2. -/
theorem main : ∀ n : ℕ, 2 ≤ n → a n = Nat.nth NotGen (n - 2) + 2 := by
  sorry

end OMA.S_oeis_a080578
