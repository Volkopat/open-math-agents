import Mathlib

open Polynomial

namespace OMA.S_arxiv_2602_07467

/-- The 8 spectral/Jordan types `(A)`–`(H)` of `3 × 3` matrices over `GF(p)`. -/
inductive M3Type
  | A | B | C | D | E | F | G | H
  deriving DecidableEq

instance : Fintype M3Type where
  elems := {.A, .B, .C, .D, .E, .F, .G, .H}
  complete := fun x => by cases x <;> decide

/-- A `3 × 3` matrix `A` over `ZMod p` has type `t` according to its characteristic
    and minimal polynomials (Section 3 of Boroja–Kokol Bukovšek–Stopar). -/
def HasM3Type {p : ℕ} [Fact p.Prime] (A : Matrix (Fin 3) (Fin 3) (ZMod p)) : M3Type → Prop
  | .A => ∃ l : ZMod p, A.charpoly = (X - C l) ^ 3 ∧ minpoly (ZMod p) A = X - C l
  | .B => ∃ l m : ZMod p, l ≠ m ∧
      A.charpoly = (X - C l) * (X - C m) ^ 2 ∧ minpoly (ZMod p) A = (X - C l) * (X - C m)
  | .C => ∃ l m n : ZMod p, l ≠ m ∧ l ≠ n ∧ m ≠ n ∧
      A.charpoly = (X - C l) * (X - C m) * (X - C n) ∧ minpoly (ZMod p) A = A.charpoly
  | .D => ∃ l : ZMod p, A.charpoly = (X - C l) ^ 3 ∧ minpoly (ZMod p) A = (X - C l) ^ 3
  | .E => ∃ l : ZMod p, A.charpoly = (X - C l) ^ 3 ∧ minpoly (ZMod p) A = (X - C l) ^ 2
  | .F => ∃ l m : ZMod p, l ≠ m ∧
      A.charpoly = (X - C l) ^ 2 * (X - C m) ∧ minpoly (ZMod p) A = A.charpoly
  | .G => Irreducible A.charpoly ∧ minpoly (ZMod p) A = A.charpoly
  | .H => ∃ (l : ZMod p) (q : Polynomial (ZMod p)),
      q.Monic ∧ q.natDegree = 2 ∧ Irreducible q ∧
      A.charpoly = (X - C l) * q ∧ minpoly (ZMod p) A = A.charpoly

/-- Vertices of the unital compressed commuting graph `Λ¹(M_3(GF(p)))`:
    unital subrings of `M_3(ZMod p)` generated by a single matrix. -/
def UCCGVert (p : ℕ) :=
  { S : Subring (Matrix (Fin 3) (Fin 3) (ZMod p)) // ∃ A, S = Subring.closure ({A} : Set _) }

/-- Adjacency in `Λ¹(M_3(GF(p)))`: two vertices commute iff their elements pairwise commute. -/
def UCCGAdj {p : ℕ} (v₁ v₂ : UCCGVert p) : Prop :=
  ∀ A ∈ v₁.val, ∀ B ∈ v₂.val, A * B = B * A

/-- The set of single generators of a vertex `v` of `Λ¹(M_3(GF(p)))`. -/
def SingleGens {p : ℕ} (v : UCCGVert p) : Set (Matrix (Fin 3) (Fin 3) (ZMod p)) :=
  { A | Subring.closure ({A} : Set _) = v.val }

/-- A vertex `v` has type `t` if some (equivalently every) single generator of `v` has type `t`. -/
def VertHasType {p : ℕ} [Fact p.Prime] (v : UCCGVert p) (t : M3Type) : Prop :=
  ∃ A ∈ SingleGens v, HasM3Type A t

/-- Vertices of `Λ¹(M_3(GF(p)))` of type `t`. -/
def VertsOfType (p : ℕ) [Fact p.Prime] (t : M3Type) : Set (UCCGVert p) :=
  { v | VertHasType v t }

/-- Table 1 vertex counts `|V_(X)|` for `Λ¹(M_3(GF(p)))`. -/
def expectedVertCount (p : ℕ) : M3Type → ℕ
  | .A => 1
  | .B => (p ^ 2 + p + 1) * p ^ 2
  | .C => if p = 2 then 0 else (p ^ 2 + p + 1) * p ^ 3 * (p + 1) / 6
  | .D => (p ^ 3 - 1) * (p + 1)
  | .E => (p ^ 2 + p + 1) * (p + 1)
  | .F => (p ^ 2 + p + 1) * p ^ 2 * (p + 1)
  | .G => (p ^ 3 - p) * (p ^ 3 - p ^ 2) / 3
  | .H => (p ^ 3 - 1) * p ^ 3 / 2

/-- Table 1 single-generator counts `gen_(X)` for each vertex of type `(X)`. -/
def expectedGenCount (p : ℕ) : M3Type → ℕ
  | .A => p
  | .B => p * (p - 1)
  | .C => p * (p - 1) * (p - 2)
  | .D => p ^ 2 * (p - 1)
  | .E => p * (p - 1)
  | .F => p * (p - 1) ^ 2
  | .G => p ^ 3 - p
  | .H => p ^ 2 * (p - 1)

/-- Points of `PG(2, p)`: 1-dimensional subspaces of `GF(p)^3`. -/
def PGPoint (p : ℕ) [Fact p.Prime] :=
  { P : Submodule (ZMod p) (Fin 3 → ZMod p) // Module.finrank (ZMod p) P = 1 }

/-- Lines of `PG(2, p)`: 2-dimensional subspaces of `GF(p)^3`. -/
def PGLine (p : ℕ) [Fact p.Prime] :=
  { L : Submodule (ZMod p) (Fin 3 → ZMod p) // Module.finrank (ZMod p) L = 2 }

/-- Incidence adjacency `DeltaAdj` on `PG(2, p) × PG(2, p)^*` from Theorem 4.1 (conditions (a)–(e)). -/
def DeltaAdj {p : ℕ} [Fact p.Prime] (x₁ x₂ : PGPoint p × PGLine p) : Prop :=
  let P₁ := x₁.1.val
  let L₁ := x₁.2.val
  let P₂ := x₂.1.val
  let L₂ := x₂.2.val
  (P₁ = P₂ ∧ L₁ = L₂) ∨
  (P₁ ≤ L₁ ∧ P₂ ≤ L₂ ∧ (P₁ = P₂ ∨ L₁ = L₂)) ∨
  (P₁ ≠ P₂ ∧ L₁ ≠ L₂ ∧ (P₂ ≤ L₁ ∧ P₂ ≤ L₂) ∧ (P₁ ≤ L₂ ∧ ¬ P₁ ≤ L₁)) ∨
  (P₁ ≠ P₂ ∧ L₁ ≠ L₂ ∧ (P₁ ≤ L₁ ∧ P₁ ≤ L₂) ∧ (P₂ ≤ L₁ ∧ ¬ P₂ ≤ L₂)) ∨
  (P₁ ≠ P₂ ∧ L₁ ≠ L₂ ∧ (P₁ ≤ L₂ ∧ ¬ P₁ ≤ L₁) ∧ (P₂ ≤ L₁ ∧ ¬ P₂ ≤ L₂))

/-- Non-central elements of `M_3(GF(p))`, the vertex set of the ordinary commuting graph `Γ(M_3(GF(p)))`. -/
def NonCentralM3 (p : ℕ) :=
  { A : Matrix (Fin 3) (Fin 3) (ZMod p) // ¬ ∀ B, A * B = B * A }

/-- Adjacency in the ordinary commuting graph `Γ(M_3(GF(p)))`. -/
def CommAdj {p : ℕ} (A B : NonCentralM3 p) : Prop :=
  A ≠ B ∧ A.val * B.val = B.val * A.val

/-- Complete structural description of the unital compressed commuting graph `Λ¹(M_3(GF(p)))`
    and the ordinary commuting graph `Γ(M_3(GF(p)))` (Boroja–Kokol Bukovšek–Stopar, arXiv:2602.07467):
    (1) Type invariance and Table 1 vertex & generator counts for all 8 types `(A)`–`(H)`;
    (2) Projective-plane graph isomorphism `V_(B) ∪ V_(E) ≃ Δ(p)` (Theorem 4.1);
    (3) Complete attachment of types `(A),(C),(D),(F),(G),(H)` to the `(B)`–`(E)` subgraph (Section 5);
    (4) Blow-up characterization of `Γ(M_3(GF(p)))` from `Λ¹(M_3(GF(p))) \ V_(A)` (Section 6). -/
theorem main :
    ∀ (p : ℕ) [Fact p.Prime],
      -- (1) Every matrix has a unique type, preserved across single generators of a vertex,
      --     with exact Table 1 cardinalities `|V_(X)|` and `gen_(X)`.
      ((∀ A : Matrix (Fin 3) (Fin 3) (ZMod p), ∃! t : M3Type, HasM3Type A t) ∧
       (∀ A B : Matrix (Fin 3) (Fin 3) (ZMod p),
          Subring.closure ({A} : Set _) = Subring.closure ({B} : Set _) →
          ∀ t : M3Type, HasM3Type A t ↔ HasM3Type B t) ∧
       (∀ t : M3Type, Nat.card (VertsOfType p t) = expectedVertCount p t) ∧
       (∀ t : M3Type, ∀ v ∈ VertsOfType p t, Nat.card (SingleGens v) = expectedGenCount p t)) ∧
      -- (2) Theorem 4.1: Graph isomorphism `Φ : (V_(B) ∪ V_(E)) ≃ PGPoint p × PGLine p`
      --     sending `V_(B)` to non-incident pairs, `V_(E)` to incident pairs, and preserving adjacency.
      (∃ Φ : { v : UCCGVert p // VertHasType v .B ∨ VertHasType v .E } ≃ PGPoint p × PGLine p,
        (∀ v, VertHasType v.val .B ↔ ¬ (Φ v).1.val ≤ (Φ v).2.val) ∧
        (∀ v, VertHasType v.val .E ↔ (Φ v).1.val ≤ (Φ v).2.val) ∧
        (∀ v₁ v₂, UCCGAdj v₁.val v₂.val ↔ DeltaAdj (Φ v₁) (Φ v₂))) ∧
      -- (3) Section 5: Complete attachment of types `(A),(C),(D),(F),(G),(H)` to `V_(B) ∪ V_(E)`.
      ((∀ v ∈ VertsOfType p .A, ∀ w : UCCGVert p, UCCGAdj v w) ∧
       (∀ v₁ v₂ : UCCGVert p, v₁ ≠ v₂ →
          (VertHasType v₁ .C ∨ VertHasType v₁ .D ∨ VertHasType v₁ .F ∨ VertHasType v₁ .G ∨ VertHasType v₁ .H) →
          (VertHasType v₂ .C ∨ VertHasType v₂ .D ∨ VertHasType v₂ .F ∨ VertHasType v₂ .G ∨ VertHasType v₂ .H) →
          ¬ UCCGAdj v₁ v₂) ∧
       (∀ v ∈ VertsOfType p .G, ∀ w : UCCGVert p, UCCGAdj v w ↔ w = v ∨ VertHasType w .A) ∧
       -- Type (C): for `p ≥ 3`, bijection with triangles in `V_(B)` (and no `(E)` neighbors)
       (∀ v ∈ VertsOfType p .C, ∀ e ∈ VertsOfType p .E, ¬ UCCGAdj v e) ∧
       (3 ≤ p →
         ∃ ψC : VertsOfType p .C ≃
           { T : Finset (UCCGVert p) // T.card = 3 ∧
               (∀ b ∈ T, VertHasType b .B) ∧ (∀ b₁ ∈ T, ∀ b₂ ∈ T, UCCGAdj b₁ b₂) },
         ∀ v b, b ∈ (ψC v).val ↔ (VertHasType b .B ∧ UCCGAdj v.val b)) ∧
       -- Type (F): bijection with `(B)`–`(E)` edges
       (∃ ψF : VertsOfType p .F ≃
           { pair : VertsOfType p .B × VertsOfType p .E // UCCGAdj pair.1.val pair.2.val },
         ∀ v,
           (∀ b ∈ VertsOfType p .B, UCCGAdj v.val b ↔ b = (ψF v).val.1.val) ∧
           (∀ e ∈ VertsOfType p .E, UCCGAdj v.val e ↔ e = (ψF v).val.2.val)) ∧
       -- Type (H): each `v ∈ V_(H)` attaches to a unique `b ∈ V_(B)` (no `(E)` neighbor),
       --           with `p*(p-1)/2` vertices of type `(H)` per `b ∈ V_(B)`
       (∀ v ∈ VertsOfType p .H,
          (∃! b : UCCGVert p, VertHasType b .B ∧ UCCGAdj v b) ∧
          (∀ e ∈ VertsOfType p .E, ¬ UCCGAdj v e)) ∧
       (∀ b ∈ VertsOfType p .B,
          Nat.card { h : UCCGVert p // VertHasType h .H ∧ UCCGAdj b h } = p * (p - 1) / 2) ∧
       -- Type (D): each `v ∈ V_(D)` attaches to a unique `e ∈ V_(E)` (no `(B)` neighbor),
       --           with `p - 1` vertices of type `(D)` per `e ∈ V_(E)`
       (∀ v ∈ VertsOfType p .D,
          (∃! e : UCCGVert p, VertHasType e .E ∧ UCCGAdj v e) ∧
          (∀ b ∈ VertsOfType p .B, ¬ UCCGAdj v b)) ∧
       (∀ e ∈ VertsOfType p .E,
          Nat.card { d : UCCGVert p // VertHasType d .D ∧ UCCGAdj e d } = p - 1)) ∧
      -- (4) Section 6: Blow-up description of `Γ(M_3(GF(p)))`
      ((∀ A : Matrix (Fin 3) (Fin 3) (ZMod p), (∀ B, A * B = B * A) ↔ HasM3Type A .A) ∧
       (∀ A B : NonCentralM3 p,
          CommAdj A B ↔
            A ≠ B ∧ UCCGAdj ⟨Subring.closure {A.val}, ⟨A.val, rfl⟩⟩
                            ⟨Subring.closure {B.val}, ⟨B.val, rfl⟩⟩) ∧
       (∀ v ∈ VertsOfType p .G, ∀ A B : NonCentralM3 p,
          A.val ∈ SingleGens v → CommAdj A B → B.val ∈ SingleGens v)) := by
  sorry

end OMA.S_arxiv_2602_07467
