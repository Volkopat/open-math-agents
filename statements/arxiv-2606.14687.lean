import Mathlib

/-!
# Kunisky's conjecture on spiked-matrix eigenvector fluctuations

Source: D. Kunisky, arXiv:2606.14687, Conjecture 1.19 (both clauses).
Credit: @hehz2020

The coordinates of each Gaussian noise matrix are generated by independent standard
real normals. The two admissible covariance predictions are the unique optimizer
of the reduced dual in Theorem 1.9 and, under Proposition 7.9, the certificate in Definition 7.8. Weak convergence
is expressed by convergence of characteristic functions (including singular limits).
The sequence index starts at zero, so the matrix dimension at index n is n+1.
-/

namespace OMA.S_arxiv_2606_14687

open Filter MeasureTheory ProbabilityTheory
open scoped BigOperators Topology ComplexOrder

noncomputable section

abbrev Vec (d : ℕ) := Fin d → ℝ
abbrev Mat (d : ℕ) := Matrix (Fin d) (Fin d) ℝ
abbrev CMat (d : ℕ) := Matrix (Fin d) (Fin d) ℂ

def realDot {d : ℕ} (x y : Vec d) : ℝ := ∑ i, x i * y i

def projector {d : ℕ} (x : Vec d) : Mat d := fun i j => x i * x j

def complexMatrix {d : ℕ} (M : Mat d) : CMat d := fun i j => (M i j : ℂ)

def covarianceMap {d k : ℕ} (A : Fin k → Mat d) (S : CMat d) : CMat d :=
  ∑ j, complexMatrix (A j) * S * complexMatrix (A j)

/-- Equivalent small SDP in Theorem 1.9; optimizing over T recovers its reduced dual. -/
def dualFeasible {d k : ℕ} (A : Fin k → Mat d) (S T : CMat d) : Prop :=
  S.trace = 1 ∧ (Matrix.fromBlocks S (-T) (-T.conjTranspose) (covarianceMap A S)).PosSemidef

def dualObjective {d : ℕ} (a : Mat d) (S T : CMat d) : ℝ :=
  ((complexMatrix a * S).trace).re + 2 * T.trace.re

def dualOptimizer {d k : ℕ} (a : Mat d) (A : Fin k → Mat d) (S : CMat d) : Prop :=
  ∃ T : CMat d, dualFeasible A S T ∧
    ∀ U V : CMat d, dualFeasible A U V → dualObjective a U V ≤ dualObjective a S T

/-- The two conditions of Proposition 7.9. Irreducibility means there are no common
nontrivial invariant complex subspaces for the coefficient matrices. -/
def certificateHypotheses {d k : ℕ} (A : Fin k → Mat d) : Prop :=
  (∀ L : Submodule ℂ (Fin d → ℂ),
    (∀ j x, x ∈ L → (complexMatrix (A j)).mulVec x ∈ L) → L = ⊥ ∨ L = ⊤) ∧
  (1 : Mat d) ∈ Submodule.span ℝ (Set.range A)

/-- The positive square root of Z(alpha), computed on the signal and its complement. -/
def certificateRoot {d : ℕ} (θ α : ℝ) (v : Vec d) : CMat d :=
  complexMatrix (Real.sqrt α • projector v + Real.sqrt θ⁻¹ • (1 - projector v))

def tiltedMap {d k : ℕ} (A : Fin k → Mat d) (H U : CMat d) : CMat d :=
  H * covarianceMap A (H * U * H) * H

/-- Definition 7.8. The eigenmatrix and Rayleigh bound assert that the largest
eigenvalue on the Hermitian matrices is one. S is the trace-normalized conjugate
of this positive eigenmatrix by the square root H of Z(alpha). -/
def estimatedCertificate {d k : ℕ} (θ : ℝ) (v : Vec d) (A : Fin k → Mat d)
    (S : CMat d) : Prop :=
  ∃ α : ℝ, 0 < α ∧ ∃ U : CMat d, U.PosSemidef ∧ U ≠ 0 ∧
    let H := certificateRoot θ α v
    tiltedMap A H U = U ∧
    (∀ V : CMat d, V.IsHermitian → ((V * tiltedMap A H V).trace).re ≤ ((V * V).trace).re) ∧
    S = ((H * U * H).trace)⁻¹ • (H * U * H)

def standardInputs (k : ℕ) : Measure (Vec k) :=
  Measure.pi (fun _ : Fin k => gaussianReal 0 1)

/-- Rayleigh's characterization, without making an arbitrary choice on a tie. -/
def isTopUnitVector {d : ℕ} (M : Mat d) (w : Vec d) : Prop :=
  realDot w w = 1 ∧ ∃ eigval : ℝ, M.mulVec w = eigval • w ∧
    ∀ z : Vec d, realDot z (M.mulVec z) ≤ eigval * realDot z z

/-- A bound on the covariance operator norm of the vectorized Gaussian entries,
with Frobenius norm on the test matrix B. Its least nonnegative value is v(W). -/
def boundsCovariance {d k : ℕ} (A : Fin k → Mat d) (b : ℝ) : Prop :=
  0 ≤ b ∧ ∀ B : Mat d, (∑ j, (∑ u, ∑ v, A j u v * B u v) ^ 2) ≤
    b ^ 2 * (∑ u, ∑ v, B u v ^ 2)

def predictedCov {d : ℕ} (θ : ℝ) (v : Vec d) (S : CMat d) : Mat d :=
  (show Mat d from fun i j => (S i j).re) - (1 - θ⁻¹ ^ 2) • projector v

/-- Conjecture 1.19. The projected optimizer is real by conjugation invariance and
uniqueness, as is the certificate of Definition 7.8 under Proposition 7.9.
In the last sentence of Conjecture 1.19 the estimated covariance replaces the optimizer-based covariance in the convergence hypothesis; the asserted Gaussian limit uses that same Γ. The target cosine/sine transforms
are combined in the complex characteristic function of the centered Gaussian. -/
theorem main :
    ∀ (θ : ℝ), 1 < θ →
    ∀ (k : ℕ → ℕ) (A : (n : ℕ) → Fin (k n) → Mat (n + 1))
      (v : (n : ℕ) → Vec (n + 1))
      (w : (n : ℕ) → Vec (k n) → Vec (n + 1)),
    (∀ n j, (A n j).IsSymm) →
    (∀ n, ∑ j, A n j * A n j = 1) →
    (∃ b : ℕ → ℝ, (∀ n, boundsCovariance (A n) (b n)) ∧
      Tendsto (fun n : ℕ => b n * (Real.log (n + 1 : ℝ)) ^ (3 / 2 : ℝ)) atTop (𝓝 0)) →
    (∀ n, realDot (v n) (v n) = 1) →
    (∀ n, AEMeasurable (w n) (standardInputs (k n))) →
    (∀ n, ∀ᵐ g ∂standardInputs (k n),
      isTopUnitVector (θ • projector (v n) + ∑ j, (g j) • A n j) (w n g) ∧
      0 < realDot (w n g) (v n)) →
    (∀ n, ∃! S : CMat (n + 1), dualOptimizer (θ • projector (v n)) (A n) S) →
    ∀ (S : (n : ℕ) → CMat (n + 1)),
    ((∀ n, dualOptimizer (θ • projector (v n)) (A n) (S n)) ∨
      (∀ n, certificateHypotheses (A n) ∧ estimatedCertificate θ (v n) (A n) (S n))) →
    ∀ (r : ℕ), 0 < r →
    ∀ (R : (n : ℕ) → Matrix (Fin r) (Fin (n + 1)) ℝ) (Γ : Mat r),
    Γ.IsSymm →
    (∀ n, (R n).mulVec (v n) = 0) →
    (∃ C : ℝ, ∀ n x, realDot ((R n).mulVec x) ((R n).mulVec x) ≤ C ^ 2 * realDot x x) →
    (∀ i j, Tendsto (fun n : ℕ => (n + 1 : ℝ) *
      (R n * predictedCov θ (v n) (S n) * (R n).transpose) i j) atTop (𝓝 (Γ i j))) →
    ∀ t : Vec r, Tendsto (fun n : ℕ =>
      ∫ g, Complex.exp (Complex.I * ((Real.sqrt (n + 1 : ℝ) *
        realDot t ((R n).mulVec (w n g - Real.sqrt (1 - θ⁻¹ ^ 2) • v n))) : ℂ))
          ∂standardInputs (k n)) atTop
      (𝓝 (Complex.exp ((-(realDot t (Γ.mulVec t)) / 2 : ℝ) : ℂ))) := by
  sorry

end

end OMA.S_arxiv_2606_14687
