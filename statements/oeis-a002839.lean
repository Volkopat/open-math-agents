import Mathlib

/-!
# Tutte's conjectured asymptotic for simple perfect squared rectangles (OEIS A002839)

Source: https://oeis.org/A002839
-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)
Drafted in an earlier generic agent run; audited against the source statement before submission.

Let `a(n)` be the number of simple perfect squared rectangles of order `n`
(dissections of a rectangle, squares included as in OEIS a(n) = A006983(n) + A219766(n), into `n` pairwise distinct squares with
no proper subset of `≥ 2` squares forming a sub-rectangle) up to scaling and
rectangle symmetries.
Conjecture (William Tutte, A Census of Planar Maps, p. 267):
`a(n) ~ n^(-5/2) * 4^n / (243 * √π)` as `n → ∞`.

Conventions:
- Every squared rectangle has rational proportions, so scaling is fixed
  canonically by requiring integer coordinates and side lengths with `gcd = 1`.
- Symmetries are generated by horizontal reflection, vertical reflection, and
  transposition of axes.
-/

namespace OMA.S_oeis_a002839

structure SquaredRect (n : ℕ) where
  W : ℕ
  H : ℕ
  squares : Finset (ℕ × ℕ × ℕ)
  hW : 0 < W
  hH : 0 < H
  hCard : squares.card = n
  hPos : ∀ q ∈ squares, 0 < q.2.2
  hBound : ∀ q ∈ squares, q.1 + q.2.2 ≤ W ∧ q.2.1 + q.2.2 ≤ H
  hDisj : ∀ p ∈ squares, ∀ q ∈ squares, p ≠ q →
    p.1 + p.2.2 ≤ q.1 ∨ q.1 + q.2.2 ≤ p.1 ∨
    p.2.1 + p.2.2 ≤ q.2.1 ∨ q.2.1 + q.2.2 ≤ p.2.1
  hArea : ∑ q ∈ squares, q.2.2 ^ 2 = W * H
  hPrim : squares.gcd (fun q => q.2.2) = 1
  hPerfect : ∀ p ∈ squares, ∀ q ∈ squares, p.2.2 = q.2.2 → p = q
  hSimple : ∀ T : Finset (ℕ × ℕ × ℕ), T ⊆ squares → 2 ≤ T.card → T.card < n →
    ∀ x0 x1 y0 y1 : ℕ,
      (∀ q ∈ T, x0 ≤ q.1 ∧ q.1 + q.2.2 ≤ x1 ∧ y0 ≤ q.2.1 ∧ q.2.1 + q.2.2 ≤ y1) →
      ∑ q ∈ T, q.2.2 ^ 2 < (x1 - x0) * (y1 - y0)

def applySym (W H : ℕ) (fx fy tr : Bool) (q : ℕ × ℕ × ℕ) : ℕ × ℕ × ℕ :=
  let x := if fx then W - q.1 - q.2.2 else q.1
  let y := if fy then H - q.2.1 - q.2.2 else q.2.1
  if tr then (y, x, q.2.2) else (x, y, q.2.2)

def RectSymEq {n : ℕ} (R₁ R₂ : SquaredRect n) : Prop :=
  ∃ fx fy tr : Bool,
    (if tr then (R₁.H, R₁.W) else (R₁.W, R₁.H)) = (R₂.W, R₂.H) ∧
    R₂.squares = R₁.squares.image (applySym R₁.W R₁.H fx fy tr)

noncomputable def simplePerfectSquaredRectCount (n : ℕ) : ℕ :=
  Nat.card (Quot (@RectSymEq n))

theorem main :
    Filter.Tendsto
      (fun n : ℕ =>
        (simplePerfectSquaredRectCount n : ℝ) /
          ((n : ℝ) ^ (-(5 : ℝ) / 2) * (4 : ℝ) ^ n / (243 * Real.sqrt Real.pi)))
      Filter.atTop (nhds 1) := by
  sorry

end OMA.S_oeis_a002839
