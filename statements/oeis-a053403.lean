import Mathlib

/-!
# OEIS A053403: finitely many missing numbers

Source: https://oeis.org/A053403
Let `P` be the set of pairs generated by: `(1, 1) ∈ P`; if `(a, b) ∈ P` then
`(b, a + b) ∈ P`; if `(a, b), (a', b') ∈ P` then `(a a', b b') ∈ P`. The sequence lists the
numbers not appearing in `P` (7, 11, 19, 29, …; 508 known terms, the largest 55487).
Conjecturally it is finite.

Conventions. A number appears in `P` when it is a component of some pair of `P`; we consider
positive integers.

-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)
-/

namespace OMA.S_oeis_a053403

/-- The set `P` of pairs. -/
inductive InP : ℕ × ℕ → Prop
  | base : InP (1, 1)
  | step {a b : ℕ} : InP (a, b) → InP (b, a + b)
  | mul {a b a' b' : ℕ} : InP (a, b) → InP (a', b') → InP (a * a', b * b')

theorem main :
    {n : ℕ | 0 < n ∧ ¬ ∃ p : ℕ × ℕ, InP p ∧ (p.1 = n ∨ p.2 = n)}.Finite := by
  sorry

end OMA.S_oeis_a053403
