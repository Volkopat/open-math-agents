def neighbors (v : Vertex) : Finset Vertex :=
  ((adj v.2.2).map (fun d => (v.1 + d.1, v.2.1 + d.2.1, d.2.2))).toFinset

/-- The vertices at graph distance at most `n` from the base vertex `(0, 0, 18)`. -/
def ball : ℕ → Finset Vertex
  | 0 => {(0, 0, 18)}
  | n + 1 => ball n ∪ (ball n).biUnion neighbors

/-- The coordination sequence: the number of vertices at distance exactly `n`. -/
def a : ℕ → ℤ
  | 0 => 1
  | n + 1 => ((ball (n + 1)).card : ℤ) - (ball n).card

open PowerSeries in
theorem main :
    (∀ n : ℕ, 15 < n → a n = a (n - 1) + a (n - 9) - a (n - 10)) ∧
      mk a * (X^10 - X^9 - X + 1 : PowerSeries ℤ) =
        -X^15 + X^13 + X^10 + 5*X^9 + 6*X^8 + 5*X^7 + 7*X^6 + 5*X^5 + 7*X^4 + 4*X^3 + 6*X^2 + 5*X + 1 := by
  sorry

