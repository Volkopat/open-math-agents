import Mathlib

/-!
# A degree-27 polynomial over a ramified 3-adic field

Source: Learner, https://mathoverflow.net/questions/503889 (CC BY-SA 4.0).
Credit: @connoranderson

Choose a thirteenth root t of 3 in an algebraic closure of the 3-adic
numbers. The coefficient field is the intermediate field generated by t.
-/

namespace OMA.S_mo_503889
open Polynomial IntermediateField

noncomputable abbrev Base (t : PadicAlgCl 3) := ℚ_[3]⟮t⟯

noncomputable def generator (t : PadicAlgCl 3) : Base t :=
  ⟨t, mem_adjoin_simple_self ℚ_[3] t⟩

noncomputable def equation (t : PadicAlgCl 3) : (Base t)[X] :=
  (X^9 - C ((generator t)^2))^3 - (3: (Base t)[X])^4*X + C (3^3*(generator t)^5)

theorem main : ∀ t : PadicAlgCl 3, t^13 = 3 → Irreducible (equation t) := by
  sorry

end OMA.S_mo_503889
