import Mathlib

namespace OMA.S_mo_328165

abbrev Alphabet := Computability.Γ'
abbrev IntegralGL (n : ℕ) := Matrix.GeneralLinearGroup (Fin n) ℤ

def encodeNat (n : ℕ) : List Alphabet :=
  (Computability.encodeNat n).map Computability.Γ'.bit ++ [.comma]

def encodeInt (z : ℤ) : List Alphabet :=
  [.bit (decide (z < 0))] ++ encodeNat z.natAbs

def encodeMatrix {n : ℕ} (A : IntegralGL n) : List Alphabet :=
  (List.ofFn fun i : Fin n =>
    (List.ofFn fun j : Fin n => encodeInt (A.val i j)).flatten).flatten

/-- The subgroup generated by the given pair is free of rank two. -/
def GeneratesFreeGroup {n : ℕ} (A B : IntegralGL n) : Prop :=
  Nonempty
    (Subgroup.closure ({A, B} : Set (IntegralGL n)) ≃* FreeGroup (Fin 2))

/-- Is there a uniform decision procedure for freeness of two integral matrices? -/
theorem main :
    ∃ (machine : Turing.TM2ComputableAux Alphabet Bool)
      (answer : (n : ℕ) → IntegralGL n → IntegralGL n → Bool),
      ∀ (n : ℕ) (A B : IntegralGL n),
        let word := encodeNat n ++ encodeMatrix A ++ encodeMatrix B
        (answer n A B = true ↔ GeneratesFreeGroup A B) ∧
        ∃ time : ℕ, Nonempty
          (Turing.TM2OutputsInTime machine.tm
            (word.map machine.inputAlphabet.symm)
            (some ([answer n A B].map machine.outputAlphabet.symm)) time) := by
  sorry

end OMA.S_mo_328165
