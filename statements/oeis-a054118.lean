import Mathlib

/-!
# A054118: Subdiagonal T(n,n-3), array T as in A054115

Source: https://oeis.org/A054118
Credit: @jagong-cmu

A054115 is the triangular array generated by its row sums: T(n,0) = 1 for n >= 1,
T(n,1) = r(n-1), T(n,k) = T(n,k-1) + r(n-k) for k = 2, 3, ..., n (n >= 2), where
r(h) is the sum of the numbers in row h of T. Row 0 is the single number 1.
A054118 is the subdiagonal a(n) = T(n,n-3), with offset 3; it starts 1, 24, 144, 864, 5904, ...

Conjecture (R. J. Mathar, 2013): a(n) = (n+1)*a(n-1) - n*a(n-2) for n >= 6.

Conventions:
* `T n k` is defined for all `n k : ℕ` by the rules above; the row sum `r(h)` is written
  inline as `∑ j ∈ Finset.range (h + 1), T h j`. Row 0 is `T 0 0 = 1`.
  Values with `k > n` lie outside the triangle and are never used by the conjecture.
* In the rule for `T (n+1) (k+2)`, the index `n + 1 - (k + 2)` is the OEIS `n - k`; it is a
  true subtraction inside the triangle (`k + 2 ≤ n + 1`).
* `a n = T n (n - 3)`. The recurrence is stated in `ℤ`, for every `n ≥ 6`, as in OEIS.
  (It fails at `n = 5`, because `a(3) = 1` is the entry `T(3,0)`.)
-/

namespace OMA.S_oeis_a054118

/-- The triangle A054115: `T(n,0) = 1`, `T(n,1) = r(n-1)`, `T(n,k) = T(n,k-1) + r(n-k)`,
where `r(h) = ∑_{j=0..h} T(h,j)` is the sum of row `h`; row 0 is `1`. -/
def T : ℕ → ℕ → ℕ
  | 0, _ => 1
  | _ + 1, 0 => 1
  | n + 1, 1 => ∑ j ∈ Finset.range (n + 1), T n j
  | n + 1, k + 2 =>
      T (n + 1) (k + 1) + ∑ j ∈ Finset.range (n + 1 - (k + 2) + 1), T (n + 1 - (k + 2)) j
termination_by n k => (n, k)
decreasing_by
  all_goals first
    | exact Prod.Lex.left _ _ (by omega)
    | exact Prod.Lex.right _ (by omega)

/-- A054118 (offset 3): `a(n) = T(n, n-3)`. -/
def a (n : ℕ) : ℕ := T n (n - 3)

/-- Mathar's conjecture: `a(n) = (n+1) a(n-1) - n a(n-2)` for `n ≥ 6`. -/
theorem main : ∀ n : ℕ, 6 ≤ n →
    (a n : ℤ) = ((n : ℤ) + 1) * a (n - 1) - (n : ℤ) * a (n - 2) := by
  sorry

end OMA.S_oeis_a054118
