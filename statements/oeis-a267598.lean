import Mathlib

/-!
# A267598: Triangle read by rows giving successive states of cellular automaton generated by 'Rule 177' initiated with a single ON (black) cell.

Source: https://oeis.org/A267598
Credit: @neutroxium

The conjecture listed in the entry (Velin Yanev, Nov 15 2016):
* a(n) = (1 - (-1)^(n + floor(sqrt(n + 2))))/2

Conventions (as in Wolfram's numbering and the OEIS data): the automaton runs on the integers,
starting from one ON cell at position 0 on an all-OFF background, and the rule is applied to every
cell, including the background, at each step (Rule 177 sends 000 to 1, so the background is ON from
step 1 on). Offset 0. Row r (r = 0, 1, 2, ...) has length 2r + 1: the cells at positions -r..r
after r steps, read left to right. Rows are concatenated, so row r starts at index r^2.
The definition below reproduces every term listed in the OEIS entry.
-/

namespace OMA.S_oeis_a267598

/-- The new value of a cell under the elementary cellular automaton with Wolfram rule
number `rule`, given its left neighbour, itself, and its right neighbour. -/
def ruleOut (rule : ℕ) (l c r : Bool) : Bool :=
  rule.testBit (4 * l.toNat + 2 * c.toNat + r.toNat)

/-- `cell rule t i` is the value of the cell at position `i` after `t` steps, starting
from a single ON cell at position 0 on an all-OFF background. -/
def cell (rule : ℕ) : ℕ → ℤ → Bool
  | 0 => fun i => decide (i = 0)
  | t + 1 => fun i => ruleOut rule (cell rule t (i - 1)) (cell rule t i) (cell rule t (i + 1))

/-- Linearized triangle of Rule 177 (offset 0): entry `n` lies in row `r = Nat.sqrt n`
at tape coordinate `(n - r^2) - r`. -/
def a (n : ℕ) : ℤ :=
  let r := Nat.sqrt n
  if cell 177 r (((n - r * r : ℕ) : ℤ) - (r : ℤ)) then 1 else 0

/-- Velin Yanev's conjecture for OEIS A267598. -/
theorem main : ∀ n : ℕ, a n = (1 - (-1 : ℤ) ^ (n + Nat.sqrt (n + 2))) / 2 := by
  sorry

end OMA.S_oeis_a267598
