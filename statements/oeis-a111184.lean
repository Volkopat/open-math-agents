import Mathlib

namespace OMA.S_oeis_a111184

open Polynomial PowerSeries BigOperators

/-- Coefficient sequence `c_k = r_k + X * s_k` for the Deléham DELTA operator
`[0, 2, 1, 3, 2, 4, ...] DELTA [1, 0, 1, 0, ...]`. -/
noncomputable def deltaC (k : ℕ) : Polynomial ℚ :=
  if k % 2 = 0 then Polynomial.C ((k / 2 : ℕ) : ℚ) + Polynomial.X
  else Polynomial.C ((k / 2 + 2 : ℕ) : ℚ)

/-- Stieltjes-Dyck transfer table for `r DELTA s`:
`deltaDyck 0 k = [k = 0]`,
`deltaDyck (m + 1) k = (if k = 0 then 0 else deltaDyck m (k - 1)) + deltaC k * deltaDyck m (k + 1)`.
The `n`-th row polynomial of A111184 is `deltaDyck (2 * n) 0`. -/
noncomputable def deltaDyck : ℕ → ℕ → Polynomial ℚ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | m + 1, k =>
      (if k = 0 then 0 else deltaDyck m (k - 1)) + deltaC k * deltaDyck m (k + 1)

/-- The `n`-th row polynomial `∑_{k=0}^n T(n, k) X^k` of OEIS A111184. -/
noncomputable def a111184Poly (n : ℕ) : Polynomial ℚ :=
  deltaDyck (2 * n) 0

/-- The `(n, k)` entry `T(n, k)` of OEIS A111184. -/
noncomputable def a111184 (n k : ℕ) : ℚ :=
  (a111184Poly n).coeff k

/-- Rising factorial `(a)_n = a * (a + 1) * ... * (a + n - 1)`. -/
def risingFact {R : Type*} [Semiring R] (a : R) : ℕ → R
  | 0 => 1
  | n + 1 => risingFact a n * (a + (n : R))

/-- Rising-factorial power series `W_q(t) = ∑_{n ≥ 0} (q)_n t^n` over `ℚ`. -/
noncomputable def risingSeries (q : ℚ) : PowerSeries ℚ :=
  PowerSeries.mk fun n => risingFact q n

/-- OEIS A111528(q, n) for `q : ℕ`, `n ≥ 1`:
for `q = 0`, `A111528(0, n) = n!`;
for `q > 0`, row `q` is generated by the logarithmic derivative of `W_q(t) = ∑_{m ≥ 0} (q)_m t^m`,
i.e. `W_q(t) * (q * ∑_{n ≥ 1} A111528(q, n) t^n) = t * W_q'(t)`. -/
noncomputable def a111528 (q n : ℕ) : ℚ :=
  if q = 0 then (Nat.factorial n : ℚ)
  else
    PowerSeries.coeff n
      ((PowerSeries.X * PowerSeries.derivative ℚ (risingSeries (q : ℚ))) *
        (risingSeries (q : ℚ))⁻¹) / (q : ℚ)

/-- Inner loop of Mikhail Kurkov's Conjecture 3 vector algorithm (0-indexed):
given `i`, accumulator `A`, current vector `v`, and index `j`, updates `v` for `j, j+1, ..., m-1`. -/
noncomputable def kurkovInner (m i : ℕ) : ℕ → Polynomial ℚ → (ℕ → Polynomial ℚ) → (ℕ → Polynomial ℚ)
  | 0, _, v => v
  | rem + 1, A, v =>
      let j := m - (rem + 1)
      let A' := A + v j
      let vj' := (Polynomial.C (((j - i : ℕ) : ℚ) - 1) + Polynomial.X) * v j + A'
      kurkovInner m i rem A' (Function.update v j vj')

/-- Outer loop of Mikhail Kurkov's Conjecture 3 vector algorithm:
starts from `v_j = 1` for all `j` and runs `i = 0, ..., m - 2`. -/
noncomputable def kurkovOuter (m : ℕ) : ℕ → (ℕ → Polynomial ℚ) → (ℕ → Polynomial ℚ)
  | 0, v => v
  | steps + 1, v =>
      let i := (m - 1) - (steps + 1)
      let rem := m - (i + 1)
      kurkovOuter m steps (kurkovInner m i rem (v i) v)

/-- Resulting vector of length `m` from Kurkov's Conjecture 3 algorithm. -/
noncomputable def kurkovVec (m : ℕ) : ℕ → Polynomial ℚ :=
  if m ≤ 1 then fun _ => 1
  else kurkovOuter m (m - 1) (fun _ => 1)

/-- Formal power series `S_q(t) = ∑_{n ≥ 1} R(n, q) t^n` from Kurkov's Conjecture 2, where
`R(n, q) = q^(n - 1) * ∑_{k=1}^n T(n, k) * (-1 / q)^(k - 1)`. -/
noncomputable def kurkovR (n : ℕ) (q : ℚ) : ℚ :=
  q ^ (n - 1) * ∑ k ∈ Finset.Icc 1 n, a111184 n k * (-1 / q) ^ (k - 1)

/-- Conjectures 1, 2, and 3 of Mikhail Kurkov (Jul 15 2025) on OEIS A111184:
1. For `n > 0` and `q : ℕ`, `∑_{k=1}^n T(n, k) q^(k-1) = A111528(q, n)`.
2. For `q : ℚ` with `q > 0`, letting `S(t) = ∑_{k ≥ 1} R(k, q) t^k` and
   `L(t) = ∑_{k ≥ 1} R(k, q) / k * t^k`, the logarithmic identity
   `log(1 + t + q * t * S(t)) = L(t)` holds as formal power series, expressed via its
   exact derivative equation `(1 + t + q * t * S(t))' = (1 + t + q * t * S(t)) * L'(t)`.
3. For `n > 0` and `m ≥ n`, the `n`-th row polynomial of A111184 equals
   `X * kurkovVec m (n - 1)`. -/
theorem main :
    (∀ n : ℕ, 0 < n → ∀ q : ℕ,
      ∑ k ∈ Finset.Icc 1 n, a111184 n k * (q : ℚ) ^ (k - 1) = a111528 q n) ∧
    (∀ q : ℚ, 0 < q →
      let S : PowerSeries ℚ := PowerSeries.mk fun k => if k = 0 then 0 else kurkovR k q
      let L : PowerSeries ℚ := PowerSeries.mk fun k => if k = 0 then 0 else kurkovR k q / (k : ℚ)
      let G : PowerSeries ℚ := 1 + PowerSeries.X + PowerSeries.C q * PowerSeries.X * S
      PowerSeries.derivative ℚ G = G * PowerSeries.derivative ℚ L) ∧
    (∀ n m : ℕ, 0 < n → n ≤ m →
      a111184Poly n = Polynomial.X * kurkovVec m (n - 1)) := by
  sorry

end OMA.S_oeis_a111184
