import Mathlib.NumberTheory.NumberField.Discriminant.Defs
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Analysis.Real.Sqrt

/-!
# Kimberling's discriminant divisibility conjecture

Start with 4 and iterate the positive real root of Y² - xY - 1 = 0.
The term at index n is the field discriminant of the simple number
field generated by the n-th iterate. The zeroth field is the rationals
and the displayed OEIS divisibility conjecture starts at n = 1.

Source: https://oeis.org/A260843
-/

namespace OMA.S_oeis_a260843

noncomputable def point : ℕ → {x : ℝ // IsIntegral ℚ x}
  | 0 => ⟨algebraMap ℚ ℝ 4, isIntegral_algebraMap⟩
  | n + 1 =>
    let x := point n
    let y := Real.sqrt (x.val ^ 2 + 4)
    have hy : IsIntegral ℚ y := by
      refine IsIntegral.of_pow (n := 2) (by decide) ?_
      rw [show y ^ 2 = x.val ^ 2 + 4 from Real.sq_sqrt (by positivity)]
      exact (x.property.pow 2).add (by exact_mod_cast (isIntegral_algebraMap :
        IsIntegral ℚ (algebraMap ℚ ℝ 4)))
    ⟨(x.val + y) * algebraMap ℚ ℝ (2⁻¹ : ℚ), (x.property.add hy).mul isIntegral_algebraMap⟩

noncomputable def K (n : ℕ) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ {(point n).val}

noncomputable instance (n : ℕ) : NumberField (K n) where
  to_charZero := inferInstance
  to_finiteDimensional := IntermediateField.adjoin.finiteDimensional (point n).property

theorem main : ∀ n : ℕ, 1 ≤ n →
    (NumberField.discr (K n)) ^ 2 ∣ NumberField.discr (K (n + 1)) := by
  sorry

end OMA.S_oeis_a260843
