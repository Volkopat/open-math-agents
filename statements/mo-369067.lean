import Mathlib

/-!
# Generating `PGL_3(F_q)` by three involutions

Source: https://mathoverflow.net/questions/369067
Asked by MathOverflow user THC (Presentations of PGL_3(F_q) by three involutions).

The asker states that the group `PGL_3(F_q)`, for `F_q` the finite field with `q`
elements, can be generated by three involutions, and asks where to find such
presentations.

Translation choices.
* `F_q` is any finite field `F`, and `PGL_3(F)` is Mathlib's `Matrix.ProjGenLinGroup (Fin 3) F`,
  the quotient of `GL_3(F)` by its center.
* An involution is an element `x` with `x ^ 2 = 1` and `x ≠ 1`.
* `main` is the asserted claim: for every finite field `F` there are three involutions
  generating `PGL_3(F)`.
-/

namespace OMA.S_mo_369067

/-- `x` is an involution. -/
def IsInvolution {G : Type} [Group G] (x : G) : Prop := x ^ 2 = 1 ∧ x ≠ 1

theorem main :
    ∀ (F : Type) [Field F] [Fintype F],
      ∃ a b c : Matrix.ProjGenLinGroup (Fin 3) F, IsInvolution a ∧ IsInvolution b ∧
        IsInvolution c ∧ Subgroup.closure {a, b, c} = ⊤ := by
  sorry

end OMA.S_mo_369067
