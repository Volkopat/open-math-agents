For a prime $p$, is there a (unital, not necessarily commutative) ring $R$ whose group of
units $R^\times$ is isomorphic to the $p$-Prüfer group $\mathbb{Z}[1/p] / \mathbb{Z}$?

Conventions:
- The $p$-Prüfer group is realized concretely as the subgroup of $\mathbb{C}^\times$
  generated by all $p^n$-th roots of unity ($n \in \mathbb{N}$).
-/

namespace OMA.S_mse_5011183

/-- The $p$-Prüfer group realized as the subgroup of $p$-power roots of unity in `ℂˣ`. -/
def pruferGroup (p : ℕ) : Subgroup ℂˣ :=
  Subgroup.closure {z : ℂˣ | ∃ n : ℕ, z ^ (p ^ n) = 1}

theorem main :
    ∀ p : ℕ, p.Prime →
      ∃ (R : Type) (_ : Ring R), Nonempty (Rˣ ≃* pruferGroup p) := by
  sorry

end OMA.S_mse_5011183
