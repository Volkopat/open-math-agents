import Mathlib

namespace OMA.S_arxiv_2608_00482

/-- The three main AdaGrad preconditioner variants of Algorithm 1 in arXiv:2608.00482. -/
inductive AdaGradVariant : Type
  | adaNorm
  | adaDiag
  | adaFull
  deriving DecidableEq

/-- The accumulated Gram/preconditioner matrix `G_k` at iteration `k` for each AdaGrad variant:
- `adaNorm`: `G_k = (δ^2 + ∑_{s=0}^k ‖∇f(x_s)‖^2) I`
- `adaDiag`: `G_k = diag(δ^2 + ∑_{s=0}^k (∇f(x_s))_i^2)`
- `adaFull`: `G_k = δ^2 I + ∑_{s=0}^k ∇f(x_s) ∇f(x_s)^⊤`. -/
noncomputable def adaGradMatrix {n : ℕ} (variant : AdaGradVariant)
    (grad : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (δ : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n)) (k : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
  match variant with
  | .adaNorm =>
      (δ ^ 2 + ∑ s ∈ Finset.range (k + 1), ‖grad (x s)‖ ^ 2) • (1 : Matrix (Fin n) (Fin n) ℝ)
  | .adaDiag =>
      Matrix.diagonal (fun i => δ ^ 2 + ∑ s ∈ Finset.range (k + 1), (grad (x s)).ofLp i ^ 2)
  | .adaFull =>
      δ ^ 2 • (1 : Matrix (Fin n) (Fin n) ℝ) +
        ∑ s ∈ Finset.range (k + 1), Matrix.vecMulVec (grad (x s)).ofLp (grad (x s)).ofLp

/-- A sequence `x : ℕ → ℝ^n` is generated by the AdaGrad template (`Algorithm 1` of
arXiv:2608.00482) with variant `variant`, regularization `δ > 0`, and step size `η > 0`
if at every step `k`, `x_{k+1} = x_k - η G_k^{-1/2} ∇f(x_k)` where `Γ = G_k^{-1/2}` is
the unique symmetric positive definite inverse square root of `G_k`. -/
def IsAdaGradSeq {n : ℕ} (variant : AdaGradVariant)
    (grad : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (δ η : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n)) : Prop :=
  ∀ k : ℕ, ∃ Γ : Matrix (Fin n) (Fin n) ℝ,
    Γ.PosDef ∧
    Γ * Γ * adaGradMatrix variant grad δ x k = 1 ∧
    x (k + 1) = x k - η • WithLp.toLp 2 (Γ.mulVec (grad (x k)).ofLp)

/-- Necessary and sufficient conditions for iterate convergence of all three AdaGrad variants
(`AdaNorm`, `AdaDiag`, `AdaFull`) in convex locally Lipschitz-smooth optimization
(Theorem 1 / `theorem:unified-framework` of arXiv:2608.00482): for any convex function
`f : ℝ^n → ℝ` with locally Lipschitz gradient and nonempty `argmin f`, any `δ > 0`, `η > 0`,
and any AdaGrad iterate sequence `(x_k)`, the following three properties are equivalent:
(1) `(x_k)` converges to a global minimizer `x* ∈ argmin f`;
(2) `(x_k)` is bounded;
(3) `∑_k ‖∇f(x_k)‖^2 < ∞`. -/
theorem main :
    ∀ (n : ℕ) (variant : AdaGradVariant)
      (f : EuclideanSpace ℝ (Fin n) → ℝ)
      (grad : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
      (δ η : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n)),
      0 < δ →
      0 < η →
      ConvexOn ℝ Set.univ f →
      (∀ y, HasGradientAt f (grad y) y) →
      LocallyLipschitz grad →
      (∃ z : EuclideanSpace ℝ (Fin n), ∀ y, f z ≤ f y) →
      IsAdaGradSeq variant grad δ η x →
      ((∃ xStar : EuclideanSpace ℝ (Fin n),
          (∀ y, f xStar ≤ f y) ∧ Filter.Tendsto x Filter.atTop (nhds xStar)) ↔
        Bornology.IsBounded (Set.range x)) ∧
      (Bornology.IsBounded (Set.range x) ↔
        Summable (fun k => ‖grad (x k)‖ ^ 2)) := by sorry

end OMA.S_arxiv_2608_00482
