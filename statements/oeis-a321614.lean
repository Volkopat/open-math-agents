import Mathlib

/-!
# A321614: Nonattacking kings on a 4 × 2n chessboard under rectangle symmetries

Source: https://oeis.org/A321614 (OEIS Foundation, CC BY-SA 4.0).
Credit: @mbilenko03

OEIS A321614 counts the number of nonequivalent ways to place `2n` nonattacking kings on a
`4 × 2n` chessboard under all symmetry operations of the rectangle (offset 0:
`1, 4, 23, 106, 473, 1939, 7618, ...`).

The rectangle symmetry group consists of the four operations generated by vertical reflection
`(r, c) ↦ (3 - r, c)` and horizontal reflection `(r, c) ↦ (r, 2n - 1 - c)` (including at `n = 2`,
where the OEIS entry uses the four symmetries of the rectangle, giving `a(2) = 23`).

Both conjectures of Colin Barker (Dec 22 2018) are stated:
1. The ordinary generating function identity over `ℤ` (cleared of its denominator).
2. The order-10 linear recurrence for `n > 9`.
-/

namespace OMA.S_oeis_a321614

/-- A square of the `4 × 2n` chessboard. -/
abbrev Square (n : ℕ) := Fin 4 × Fin (2 * n)

/-- Two distinct squares attack each other as chess kings. -/
def attacks {n : ℕ} (p q : Square n) : Prop :=
  p ≠ q ∧ Nat.dist p.1.val q.1.val ≤ 1 ∧ Nat.dist p.2.val q.2.val ≤ 1

/-- A valid placement of `2n` pairwise nonattacking kings on the `4 × 2n` board. -/
def valid {n : ℕ} (s : Finset (Square n)) : Prop :=
  s.card = 2 * n ∧ ∀ p ∈ s, ∀ q ∈ s, ¬ attacks p q

/-- The four rectangle symmetry operations on squares: vertical and/or horizontal reflection. -/
def symSquare {n : ℕ} (v h : Bool) (p : Square n) : Square n :=
  (if v then p.1.rev else p.1, if h then p.2.rev else p.2)

/-- Action of a rectangle symmetry on a placement of kings. -/
def symBoard {n : ℕ} (v h : Bool) (s : Finset (Square n)) : Finset (Square n) :=
  s.image (symSquare v h)

/-- Two valid placements are equivalent under rectangle symmetries. -/
def symEquiv {n : ℕ} (s t : {s : Finset (Square n) // valid s}) : Prop :=
  ∃ v h : Bool, symBoard v h s.1 = t.1

/-- The setoid of valid placements modulo rectangle symmetries. -/
def symSetoid (n : ℕ) : Setoid {s : Finset (Square n) // valid s} where
  r := symEquiv
  iseqv :=
    { refl := fun s => ⟨false, false, by
        ext p
        simp [symBoard, symSquare]⟩
      symm := by
        rintro s t ⟨v, h, hst⟩
        refine ⟨v, h, ?_⟩
        rw [← hst]
        ext p
        simp only [symBoard, Finset.mem_image]
        constructor
        · rintro ⟨q, ⟨r, hr, rfl⟩, rfl⟩
          cases v <;> cases h <;> simp [symSquare] at * <;> exact hr
        · intro hp
          refine ⟨symSquare v h p, ⟨p, hp, rfl⟩, ?_⟩
          cases v <;> cases h <;> simp [symSquare]
      trans := by
        rintro s t u ⟨v1, h1, hst⟩ ⟨v2, h2, htu⟩
        refine ⟨xor v1 v2, xor h1 h2, ?_⟩
        rw [← htu, ← hst]
        ext p
        simp only [symBoard, Finset.mem_image]
        constructor
        · rintro ⟨q, hq, rfl⟩
          refine ⟨symSquare v1 h1 q, ⟨q, hq, rfl⟩, ?_⟩
          cases v1 <;> cases v2 <;> cases h1 <;> cases h2 <;> simp [symSquare]
        · rintro ⟨r, ⟨q, hq, rfl⟩, rfl⟩
          refine ⟨q, hq, ?_⟩
          cases v1 <;> cases v2 <;> cases h1 <;> cases h2 <;> simp [symSquare] }

/-- OEIS A321614: number of nonequivalent placements of `2n` nonattacking kings on a `4 × 2n`
chessboard under the symmetry operations of the rectangle. -/
noncomputable def a (n : ℕ) : ℕ := by
  classical
  exact Fintype.card (Quotient (symSetoid n))

/-- Colin Barker's conjectured generating function and linear recurrence for A321614. -/
theorem main :
    (PowerSeries.mk (fun n => (a n : ℤ)) *
        ((1 - PowerSeries.X) ^ 2 * (1 - 3 * PowerSeries.X) ^ 2 *
          (1 - 3 * PowerSeries.X + PowerSeries.X ^ 2) *
          (1 - PowerSeries.X - PowerSeries.X ^ 2) *
          (1 - 3 * PowerSeries.X ^ 2)) =
      (1 - 2 * PowerSeries.X) *
        (1 - 6 * PowerSeries.X + 17 * PowerSeries.X ^ 2 - 18 * PowerSeries.X ^ 3 -
          2 * PowerSeries.X ^ 4 + 7 * PowerSeries.X ^ 5 + 6 * PowerSeries.X ^ 6 -
          3 * PowerSeries.X ^ 7)) ∧
    (∀ n : ℕ, 9 < n →
      (a n : ℤ) = 12 * a (n - 1) - 54 * a (n - 2) + 98 * a (n - 3) + 17 * a (n - 4) -
        346 * a (n - 5) + 505 * a (n - 6) - 210 * a (n - 7) - 120 * a (n - 8) +
        126 * a (n - 9) - 27 * a (n - 10)) := by
  sorry

end OMA.S_oeis_a321614
