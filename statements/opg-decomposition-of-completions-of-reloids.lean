import Mathlib.Order.Filter.Cofinite

/-!
# Decomposition of completions of reloids

Source: https://www.openproblemgarden.org/op/decomposition_of_completions_of_reloids
Victor Porton, Algebraic General Topology, volume 1, Conjecture 1057.
https://crypto4ngo.org/binaries/volume-1.pdf
Credit: @pmaster
-/

namespace OMA.S_opg_decomposition_of_completions_of_reloids

/-- A reloid from A to B is a filter of binary relations on A × B. -/
abbrev ReLoid (A B : Type*) := Filter (A × B)

/-- The ordinary relational composite, with the right-hand relation applied first. -/
def relComp {A B C : Type*} (s : Set (B × C)) (r : Set (A × B)) : Set (A × C) :=
  {p | ∃ b, (p.1,b) ∈ r ∧ (b,p.2) ∈ s}

/-- ReLoid composition is generated by the composites of members of the two filters. -/
def compose {A B C : Type*} (g : ReLoid B C) (f : ReLoid A B) : ReLoid A C where
  sets := {t | ∃ r ∈ f, ∃ s ∈ g, relComp s r ⊆ t}
  univ_sets := ⟨_, f.univ_sets, _, g.univ_sets, Set.subset_univ _⟩
  sets_of_superset := by
    rintro _ _ ⟨r,hr,s,hs,h⟩ h'
    exact ⟨r,hr,s,hs,h.trans h'⟩
  inter_sets := by
    rintro _ _ ⟨r,hr,s,hs,h⟩ ⟨r',hr',s',hs',h'⟩
    refine ⟨r ∩ r', f.inter_sets hr hr', s ∩ s', g.inter_sets hs hs', ?_⟩
    rintro p ⟨b, ⟨hbr,hbr'⟩, ⟨hbs,hbs'⟩⟩
    exact ⟨h ⟨b,hbr,hbs⟩,h' ⟨b,hbr',hbs'⟩⟩

/-- Join of the restrictions to the individual fibers of c. Membership may use a
different filter member on each fiber. See Proposition 7.58 of the TeXmacs edition. -/
def fiberJoin {X I : Type*} (c : X → I) (f : Filter X) : Filter X where
  sets := {t | ∀ i, ∃ r ∈ f, ∀ x ∈ r, c x = i → x ∈ t}
  univ_sets := fun _ => ⟨_, f.univ_sets, fun _ _ _ => Set.mem_univ _⟩
  sets_of_superset := by
    intro s t hs hst i
    obtain ⟨r,hr,h⟩ := hs i
    exact ⟨r,hr,fun x hx hxi => hst (h x hx hxi)⟩
  inter_sets := by
    intro s t hs ht i
    obtain ⟨r,hr,h⟩ := hs i
    obtain ⟨q,hq,h'⟩ := ht i
    exact ⟨r ∩ q, f.inter_sets hr hq, fun x hx hxi => ⟨h x hx.1 hxi,h' x hx.2 hxi⟩⟩

/-- Completion takes the join of row restrictions, and co-completion uses columns. -/
def compl {A B : Type*} (f : ReLoid A B) := fiberJoin Prod.fst f

def coCompl {A B : Type*} (f : ReLoid A B) := fiberJoin Prod.snd f

universe u v w

/-- All five claims, with f : A → B followed by g : B → C. The second clause
renames the two composable arguments of the source's second identity. -/
theorem main : ∀ (A : Type u) (B : Type v) (C : Type w) (f : ReLoid A B) (g : ReLoid B C),
    (coCompl f = f → compl (compose g f) = compose (compl g) f) ∧
    (compl g = g → coCompl (compose g f) = compose g (coCompl f)) ∧
    (coCompl (compose (compl g) f) = compl (compose g (coCompl f)) ∧
      compl (compose g (coCompl f)) = compose (compl g) (coCompl f)) ∧
    compl (compose g (compl f)) = compl (compose g f) ∧
    coCompl (compose (coCompl g) f) = coCompl (compose g f) := by
  sorry

end OMA.S_opg_decomposition_of_completions_of_reloids

