import Mathlib

/-!
# Outward reloid of composition vs composition of outward reloids

Source: https://www.openproblemgarden.org/op/outward_reloid_of_composition_vs_composition_of_outward_reloids
-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)

Conjecture (Porton): for all composable funcoids `f` and `g`,
`(RLD)_out (g ∘ f) ⊒ (RLD)_out g ∘ (RLD)_out f`.

Conventions (Porton, *Algebraic General Topology*):
* A funcoid `f` from `A` to `B` is encoded by its relation `X [f] Y` on subsets (Porton's theorem
  identifies funcoids with such relations): it fails when `X` or `Y` is empty and it is
  binary-additive in each argument.
* Composition of funcoids: `X [g ∘ f] Z ↔ ⟨f⟩ X ⊓ ⟨g⁻¹⟩ Z ≠ ⊥`, where `⟨f⟩ X = {Y | ¬ X [f] Yᶜ}`
  and `⟨g⁻¹⟩ Z = {Y | ¬ Yᶜ [g] Z}`; unfolded, `X [g ∘ f] Z ↔ ∀ Y, X [f] Yᶜ ∨ Y [g] Z`.
* A reloid from `A` to `B` is a filter on `A × B`; Porton's order `⊑` is Mathlib's `≤`.
  Composition of reloids: `g ∘ f = ⋂^RLD {G ∘ F | F ∈ up f, G ∈ up g}` (the filter generated by
  the relational compositions).
* `(RLD)_out f = ⋂^RLD up f`, where `up f` is the set of relations `K ⊆ A × B` with `f ⊑ K` as
  funcoids, i.e. `X [f] Y → (X × Y) ∩ K ≠ ∅`.
-/

namespace OMA.S_opg_outward_reloid_of_composition_vs_composition_of_outward_reloids

/-- `δ` is (the relation of) a funcoid from `A` to `B`. -/
def IsFuncoid {A B : Type} (δ : Set A → Set B → Prop) : Prop :=
  (∀ Y, ¬ δ ∅ Y) ∧ (∀ X, ¬ δ X ∅) ∧
    (∀ X X' Y, δ (X ∪ X') Y ↔ δ X Y ∨ δ X' Y) ∧
    (∀ X Y Y', δ X (Y ∪ Y') ↔ δ X Y ∨ δ X Y')

/-- Composition `g ∘ f` of funcoids. -/
def fcdComp {A B C : Type} (g : Set B → Set C → Prop) (f : Set A → Set B → Prop) :
    Set A → Set C → Prop :=
  fun X Z => ∀ Y : Set B, f X Yᶜ ∨ g Y Z

/-- Composition of relations. -/
def relComp {A B C : Type} (G : Set (B × C)) (F : Set (A × B)) : Set (A × C) :=
  {p | ∃ b, (p.1, b) ∈ F ∧ (b, p.2) ∈ G}

/-- Composition `g ∘ f` of reloids. -/
def rldComp {A B C : Type} (g : Filter (B × C)) (f : Filter (A × B)) : Filter (A × C) :=
  Filter.generate {K | ∃ F ∈ f, ∃ G ∈ g, K = relComp G F}

/-- `(RLD)_out f`. -/
def rldOut {A B : Type} (δ : Set A → Set B → Prop) : Filter (A × B) :=
  Filter.generate {K | ∀ X Y, δ X Y → (X ×ˢ Y ∩ K).Nonempty}

theorem main :
    ∀ (A B C : Type) (f : Set A → Set B → Prop) (g : Set B → Set C → Prop),
      IsFuncoid f → IsFuncoid g →
        rldComp (rldOut g) (rldOut f) ≤ rldOut (fcdComp g f) := by
  sorry

end OMA.S_opg_outward_reloid_of_composition_vs_composition_of_outward_reloids
