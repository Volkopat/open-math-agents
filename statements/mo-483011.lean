import Mathlib

namespace OMA.S_mo_483011

noncomputable abbrev L2 (G : Type) := lp (fun _ : G => ℂ) 2
noncomputable abbrev Operator (G : Type) := L2 G →L[ℂ] L2 G

noncomputable def delta {G : Type} (g : G) : L2 G := by
  classical
  exact lp.single 2 g 1

/-- The reduced group algebra is the operator-norm closure of the algebra
generated by all left regular translations. -/
noncomputable def reducedAlgebra {G : Type} (regular : G → Operator G) : Set (Operator G) :=
  closure (Algebra.adjoin ℂ (Set.range regular) : Set (Operator G))

/-- Can two elements of a torsion-free group become conjugate only after
passing to its reduced group C-star algebra? -/
theorem main :
    ∃ (G : Type) (group : Group G),
      letI : Group G := group
      (∀ (g : G) (n : ℕ), 0 < n → g ^ n = 1 → g = 1) ∧
      ∃ (x y : G) (regular : G → Operator G),
        (∀ h : G, h * x * h⁻¹ ≠ y) ∧
        (∀ g h : G, regular g (delta h) = delta (g * h)) ∧
        ∃ u v : Operator G,
          u ∈ reducedAlgebra regular ∧ v ∈ reducedAlgebra regular ∧
          u * v = 1 ∧ v * u = 1 ∧ u * regular x = regular y * u := by
  sorry

end OMA.S_mo_483011
