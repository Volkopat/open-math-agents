import Mathlib

/-!
# A187235: Nonattacking semi-bishops on an n × n board

Source: https://oeis.org/A187235
Credit: @mbilenko03

The number of ways to place `n` nonattacking semi-bishops on an `n × n` board.
Two distinct squares attack precisely when they lie on the same
NorthEast–SouthWest diagonal, that is, when the sums of their zero-based
coordinates agree. A placement is a set of `n` squares whose sums are pairwise
distinct.

Peter Luschny conjectured (February 9, 2015) that this count equals the number
of parity-preserving permutations of `{1, ..., 2n+1}` with exactly `n + 1`
cycles. On `Fin (2 * n + 1)` the same parity condition is
`(σ i).val % 2 = i.val % 2`. The number of cycles, including fixed points, is
the number of orbits of the cyclic subgroup generated by `σ`.
-/

namespace OMA.S_oeis_a187235

/-- Distinct squares attack when they share a NorthEast–SouthWest diagonal. -/
def Nonattacking (n : ℕ) (S : Finset (Fin n × Fin n)) : Prop :=
  ∀ s ∈ S, ∀ t ∈ S, s ≠ t → s.1.val + s.2.val ≠ t.1.val + t.2.val

/-- A placement of `n` nonattacking semi-bishops on an `n × n` board. -/
def Placement (n : ℕ) : Type :=
  { S : Finset (Fin n × Fin n) // S.card = n ∧ Nonattacking n S }

/-- A permutation of `Fin (2 * n + 1)` preserves parity of indices. -/
def ParityPreserving (n : ℕ) (σ : Equiv.Perm (Fin (2 * n + 1))) : Prop :=
  ∀ i : Fin (2 * n + 1), (σ i).val % 2 = i.val % 2

/-- The number of cycles of `σ`, counting fixed points as cycles. -/
noncomputable def cycleCount {α : Type*} [Fintype α] [DecidableEq α]
    (σ : Equiv.Perm α) : ℕ :=
  Nat.card (Quotient (MulAction.orbitRel (Subgroup.zpowers σ) α))

/-- Luschny's conjecture: semi-bishop placements and parity-preserving
permutations with `n + 1` cycles are equinumerous for every positive `n`. -/
theorem main :
    ∀ n : ℕ, 1 ≤ n →
      Nat.card (Placement n) =
        Nat.card { σ : Equiv.Perm (Fin (2 * n + 1)) //
          ParityPreserving n σ ∧ cycleCount σ = n + 1 } := by
  sorry

end OMA.S_oeis_a187235
