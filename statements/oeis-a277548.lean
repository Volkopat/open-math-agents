import Mathlib

/-!
# Rank of an integer with rightmost nonzero base-five digit four

A277548 is the increasing list of positive integers whose rightmost
nonzero digit in base five is 4. Removing trailing zeroes by repeated
division by five gives that digit. At zero we set the digit to zero.
A033042 consists of sums of distinct nonnegative powers of five, so
its base-five representations consist of 0s and 1s. Its members are
generated by appending either digit, with zero as the starting value.

David A. Corneth conjectured that the nth member of A277548 equals 4n
exactly for positive n belonging to A033042. The OEIS index is one-based.
Sources: https://oeis.org/A277548 and https://oeis.org/A033042
Formalization: @KoaOkano
-/

namespace OMA.S_oeis_a277548

def lastDigit (m : ℕ) : ℕ :=
  if m = 0 then 0 else if m % 5 = 0 then lastDigit (m / 5) else m % 5
termination_by m
decreasing_by omega

abbrev lastFour (m : ℕ) : Prop := lastDigit m = 4

inductive Digits01 : ℕ → Prop where
  | zero : Digits01 0
  | append0 {s} : Digits01 s → Digits01 (5*s)
  | append1 {s} : Digits01 s → Digits01 (5*s+1)

theorem main : ∀ n : ℕ, 0 < n →
    (Nat.nth lastFour (n-1) = 4*n ↔ Digits01 n) := by
  sorry

end OMA.S_oeis_a277548
