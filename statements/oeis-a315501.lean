  [(0, 0, 0), (0, 0, 2), (0, 0, 13), (0, 0, 14), (0, 0, 18), (0, 0, 19)],
  [(-1, 0, 12), (-1, 0, 18), (0, 0, 1), (0, 0, 3), (0, 0, 16), (0, 0, 21)],
  [(0, 0, 2), (0, 0, 3), (0, 0, 14), (0, 0, 16), (0, 0, 20), (0, 0, 22)],
  [(0, -1, 12), (0, 0, 15), (0, 0, 20), (0, 0, 23), (1, -1, 1), (1, 0, 5)],
