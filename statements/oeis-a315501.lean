  [(0, 0, 0), (0, 0, 6), (0, 0, 12), (0, 0, 18), (0, 1, 11), (0, 1, 23)],
  [(0, 0, 2), (0, 0, 6), (0, 0, 8), (0, 0, 15), (0, 0, 19), (0, 0, 20)],
  [(0, 0, 9), (0, 0, 14), (0, 0, 19), (0, 0, 20), (1, 0, 5), (1, 0, 10)],
