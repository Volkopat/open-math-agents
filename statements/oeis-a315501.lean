  [(0, -1, 12), (0, -1, 13), (0, 0, 9), (0, 0, 11), (0, 0, 20), (0, 0, 22)]]

def neighbors (v : Vertex) : Finset Vertex :=
  ((adj v.2.2).map (fun d => (v.1 + d.1, v.2.1 + d.2.1, d.2.2))).toFinset

/-- The vertices at graph distance at most `n` from the base vertex `(0, 0, 12)`. -/
def ball : ℕ → Finset Vertex
  | 0 => {(0, 0, 12)}
  | n + 1 => ball n ∪ (ball n).biUnion neighbors

/-- The coordination sequence: the number of vertices at distance exactly `n`. -/
def a : ℕ → ℤ
  | 0 => 1
  | n + 1 => ((ball (n + 1)).card : ℤ) - (ball n).card

open PowerSeries in
theorem main :
    (∀ n : ℕ, 13 < n → a n = 2 * a (n - 5) - a (n - 10)) ∧
      mk a * (X^10 - 2*X^5 + 1 : PowerSeries ℤ) =
        (X + 1)^2*(-X^11 + X^10 - X^9 + 2*X^8 + 4*X^7 + 3*X^6 + 8*X^5 + 5*X^4 + 8*X^3 + 2*X^2 + 4*X + 1) := by
  sorry

end OMA.S_oeis_a315501
