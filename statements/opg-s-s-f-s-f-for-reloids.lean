import Mathlib

/-!
# S(S(f)) = S(f) for reloids

Source: https://www.openproblemgarden.org/op/s_s_f_s_f_for_reloids
-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)

Question (Porton): is `S(S(f)) = S(f)` for every endo-reloid `f`? The source asks a yes/no
question; `main` states the answer yes.

Conventions (Porton, *Algebraic General Topology*, chapter on connectedness):
* An endo-reloid on `A` is a filter on `A × A`; Porton's order `⊑` is Mathlib's `≤`, so the join
  `⋃^RLD` of a family is its `⨆`.
* Composition of reloids: `g ∘ f = ⋂^RLD {G ∘ F | F ∈ up f, G ∈ up g}` (the filter generated by
  the relational compositions); the identity reloid is the principal filter of the diagonal, and
  `f⁰ = id`, `fⁿ⁺¹ = f ∘ fⁿ`.
* `S(f) = ⋃^RLD {fⁿ | n ∈ ℕ}`.
-/

namespace OMA.S_opg_s_s_f_s_f_for_reloids

/-- Composition of relations. -/
def relComp {A : Type} (G F : Set (A × A)) : Set (A × A) :=
  {p | ∃ b, (p.1, b) ∈ F ∧ (b, p.2) ∈ G}

/-- Composition `g ∘ f` of endo-reloids. -/
def rldComp {A : Type} (g f : Filter (A × A)) : Filter (A × A) :=
  Filter.generate {K | ∃ F ∈ f, ∃ G ∈ g, K = relComp G F}

/-- The identity reloid. -/
def rldId (A : Type) : Filter (A × A) := Filter.principal {p | p.1 = p.2}

/-- `fⁿ`. -/
def rldPow {A : Type} (f : Filter (A × A)) : ℕ → Filter (A × A)
  | 0 => rldId A
  | n + 1 => rldComp f (rldPow f n)

/-- `S(f) = ⋃ₙ fⁿ`. -/
def S {A : Type} (f : Filter (A × A)) : Filter (A × A) := ⨆ n, rldPow f n

theorem main : ∀ (A : Type) (f : Filter (A × A)), S (S f) = S f := by
  sorry

end OMA.S_opg_s_s_f_s_f_for_reloids
