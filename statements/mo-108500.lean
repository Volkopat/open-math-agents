import Mathlib

/-!
# Convex hull of doubly normalized pairs of real matrices

Source: jo1, https://mathoverflow.net/questions/108500 (CC BY-SA 3.0).
Credit: @connoranderson.

In every dimension the hull is a linear projection of a two-equation affine
slice of the cone generated by all real symmetric fourth powers in 2n²+1
variables. The lifted equations impose normalized mass and zero integral of
the sum of squares of the homogeneous row and column Gram residuals.

The two positive semidefinite contraction inequalities give an outer bound.
A rational three-dimensional pair is an extreme point of that bound and lies
outside the hull, answering the equivalent extreme-point question the author
posed in a comment. The fourth-power cone description is exact; no claim about
the complexity of deciding membership in this cone is required.
-/

namespace OMA.S_mo_108500
open Matrix Finset Set
abbrev Mat (n : ℕ) := Matrix (Fin n) (Fin n) ℝ
abbrev P (n : ℕ) := Mat n × Mat n
def rowGram {n : ℕ} (X : P n) : Mat n := X.1 * X.1.transpose + X.2 * X.2.transpose
def colGram {n : ℕ} (X : P n) : Mat n := X.1.transpose * X.1 + X.2.transpose * X.2
def balanced (n : ℕ) : Set (P n) := {X | rowGram X = 1 ∧ colGram X = 1}
def relaxed (n : ℕ) : Set (P n) :=
  {X | ((1:Mat n)-rowGram X).PosSemidef ∧ ((1:Mat n)-colGram X).PosSemidef}
noncomputable def examplePair : P 3 :=
  ( !![0,0,3/5; 0,4/5,0; 3/5,0,0], !![4/5,0,0; 0,0,3/5; 0,3/5,0] )

/-- Homogeneous coordinates: the extra coordinate, followed by the entries of the two matrices. -/
abbrev Coord (n : ℕ) := Option (Bool × Fin n × Fin n)
abbrev Tensor4 (n : ℕ) := Coord n → Coord n → Coord n → Coord n → ℝ
def power4 {n : ℕ} (u : Coord n → ℝ) : Tensor4 n :=
  fun i j k l => u i * u j * u k * u l

/-- The cone of finite nonnegative combinations of real symmetric fourth powers. -/
def fourthCone (n : ℕ) : Set (Tensor4 n) :=
  {T | ∃ (ι : Type) (_ : Fintype ι) (c : ι → ℝ) (u : ι → Coord n → ℝ),
    (∀ a, 0 ≤ c a) ∧ T = ∑ a, c a • power4 (u a)}

def entry4 {n : ℕ} (i j k l : Coord n) : Tensor4 n →ₗ[ℝ] ℝ where
  toFun T := T i j k l
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The summands of a homogeneous row- or column-Gram residual. -/
abbrev Term (n : ℕ) := Option (Bool × Fin n)
def termWeight {n : ℕ} (i j : Fin n) : Term n → ℝ
  | none => -(1 : Mat n) i j
  | some _ => 1
def termSlot {n : ℕ} (column : Bool) (i : Fin n) : Term n → Coord n
  | none => none
  | some (b, k) => if column then some (b, k, i) else some (b, i, k)

/-- Linear contraction that evaluates the square of one Gram residual on each fourth power. -/
noncomputable def squareTest {n : ℕ} (column : Bool) (i j : Fin n) : Tensor4 n →ₗ[ℝ] ℝ :=
  ∑ a : Term n, ∑ b : Term n, (termWeight i j a * termWeight i j b) •
    entry4 (termSlot column i a) (termSlot column j a) (termSlot column i b) (termSlot column j b)

noncomputable def energy (n : ℕ) : Tensor4 n →ₗ[ℝ] ℝ :=
  ∑ i, ∑ j, (squareTest false i j + squareTest true i j)

def project4 (n : ℕ) : Tensor4 n →ₗ[ℝ] P n where
  toFun T := (fun i j => T none none none (some (false,i,j)),
              fun i j => T none none none (some (true,i,j)))
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- An explicit linear image of an affine slice of the fourth-power cone. -/
def quarticHull (n : ℕ) : Set (P n) :=
  {X | ∃ T ∈ fourthCone n, T none none none none = 1 ∧ energy n T = 0 ∧ project4 n T = X}

theorem main :
    (∀ n : ℕ, convexHull ℝ (balanced n) = quarticHull n) ∧
    (∀ n : ℕ, convexHull ℝ (balanced n) ⊆ relaxed n) ∧
    examplePair ∈ (relaxed 3).extremePoints ℝ ∧
    examplePair ∉ convexHull ℝ (balanced 3) := by
  sorry
end OMA.S_mo_108500
