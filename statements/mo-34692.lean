import Mathlib.Algebra.Star.NonUnitalSubalgebra
import Mathlib.Algebra.Star.Subalgebra
import Mathlib.Analysis.Complex.Basic
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.InnerProductSpace.l2Space
import Mathlib.Topology.Constructions

open scoped InnerProductSpace

namespace OMA.S_mo_34692

abbrev Operators (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  H →L[ℂ] H

abbrev SquareSummable (H : Type*) [NormedAddCommGroup H] :=
  ↥(lp (fun _ : ℕ => H) 2)

/-- The ultraweak topology is generated by the sums of matrix
coefficients for pairs of square-summable vector sequences. -/
noncomputable abbrev ultraweak (H : Type*) [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] : TopologicalSpace (Operators H) :=
  TopologicalSpace.induced
    (fun (T : Operators H) (xy : SquareSummable H × SquareSummable H) =>
      ∑' n : ℕ, ⟪xy.1 n, T (xy.2 n)⟫_ℂ)
    inferInstance

/-- A maximal abelian star-subalgebra of the possibly nonunital
star-subalgebra B. -/
def isMaximalAbelian {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (B C : NonUnitalStarSubalgebra ℂ (Operators H)) : Prop :=
  C ≤ B ∧ (∀ x ∈ C, ∀ y ∈ C, Commute x y) ∧
    ∀ D : NonUnitalStarSubalgebra ℂ (Operators H),
      C ≤ D → D ≤ B → (∀ x ∈ D, ∀ y ∈ D, Commute x y) → D = C

/-- An ultraweakly dense star-subalgebra of a von Neumann algebra
equals the ambient algebra if all its maximal abelian subalgebras
are ultraweakly closed. -/
theorem main :
    ∀ (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
      (A : StarSubalgebra ℂ (Operators H))
      (B : NonUnitalStarSubalgebra ℂ (Operators H)),
      @IsClosed (Operators H) (ultraweak H) (A : Set (Operators H)) →
      @closure (Operators H) (ultraweak H) (B : Set (Operators H)) =
        (A : Set (Operators H)) →
      (∀ C : NonUnitalStarSubalgebra ℂ (Operators H),
        isMaximalAbelian B C → @IsClosed (Operators H) (ultraweak H) (C : Set (Operators H))) →
      (B : Set (Operators H)) = (A : Set (Operators H)) := by
  sorry

end OMA.S_mo_34692
