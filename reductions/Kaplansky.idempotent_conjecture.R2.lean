import FormalConjectures.Wikipedia.Kaplansky

/-!
# Kaplansky idempotent conjecture: reduction to the zero-divisor core
An idempotent of `K[G]` lies in the image of `F[H]`, where `H` is the subgroup generated
by its support (finitely generated) and `F` is the subfield generated by its coefficients
(countable). Both are moved to `Type` with `Shrink`. If `F[H]` has no zero divisors the
idempotent is trivial. A torsion-free abelian group embeds in its localization at the
nonzero integers, a vector space over the rationals, so it has unique products and its
group algebra has no zero divisors. What is left: finitely generated, torsion-free,
non-abelian groups without unique products whose group algebra has zero divisors
(so a counterexample would also refute the zero-divisor conjecture), split by characteristic.
-/

namespace OMA.R_Kaplansky_idempotent_conjecture_R2

universe u v

/-- The open core in characteristic zero: finitely generated, countable coefficients,
torsion-free, non-abelian, without unique products, and the group algebra has zero divisors. -/
def H1 : Prop :=
  ∀ (K : Type) [Field K] [Countable K] [CharZero K] (G : Type) [Group G] [Group.FG G],
    Monoid.IsTorsionFree G → (∃ x y : G, x * y ≠ y * x) → ¬ UniqueProds G →
    ¬ NoZeroDivisors (MonoidAlgebra K G) →
    ∀ a : MonoidAlgebra K G, IsIdempotentElem a → a = 0 ∨ a = 1

/-- The same open core in prime characteristic. -/
def H2 : Prop :=
  ∀ (p : ℕ) (K : Type) [Field K] [Countable K] [CharP K p] (G : Type) [Group G] [Group.FG G],
    p.Prime → Monoid.IsTorsionFree G → (∃ x y : G, x * y ≠ y * x) → ¬ UniqueProds G →
    ¬ NoZeroDivisors (MonoidAlgebra K G) →
    ∀ a : MonoidAlgebra K G, IsIdempotentElem a → a = 0 ∨ a = 1

/-- A torsion-free abelian additive group has unique sums. -/
theorem uniqueSums_of_torsionFree {M : Type v} [AddCommGroup M]
    (hM : ∀ m : M, ∀ n : ℕ, 0 < n → n • m = 0 → m = 0) : UniqueSums M := by
  let S := nonZeroDivisors ℤ
  let L := LocalizedModule S M
  let e : ℚ ≃ₐ[ℤ] Localization S := IsLocalization.algEquiv S ℚ (Localization S)
  let _ : Module ℚ L := Module.compHom L e.toRingEquiv.toRingHom
  let f : M →+ L :=
    { toFun := fun m => LocalizedModule.mk m 1
      map_zero' := LocalizedModule.zero_mk 1
      map_add' := fun m m' => by
        rw [LocalizedModule.mk_add_mk]; simp }
  have inj : Function.Injective f := by
    rw [injective_iff_map_eq_zero]
    intro m hm
    rw [← LocalizedModule.zero_mk (1 : S)] at hm
    change LocalizedModule.mk m (1 : S) = _ at hm
    obtain ⟨⟨r, hr⟩, hrm⟩ := LocalizedModule.mk_eq.mp hm
    simp only [one_smul, smul_zero, Submonoid.smul_def] at hrm
    have r0 : r ≠ 0 := nonZeroDivisors.ne_zero hr
    apply hM m r.natAbs (Int.natAbs_pos.mpr r0)
    rcases Int.natAbs_eq r with h | h
    · rw [h] at hrm; simpa [natCast_zsmul] using hrm
    · rw [h, neg_smul, neg_eq_zero] at hrm; simpa [natCast_zsmul] using hrm
  exact (TwoUniqueSums.of_injective_addHom (G := L) f.toAddHom inj inferInstance).toUniqueSums

/-- A torsion-free abelian group has unique products. -/
theorem uniqueProds_of_comm {G : Type v} [Group G] (hc : ∀ x y : G, x * y = y * x)
    (hG : Monoid.IsTorsionFree G) : UniqueProds G := by
  let _ : CommGroup G := { ‹Group G› with mul_comm := hc }
  have : UniqueSums (Additive G) := by
    apply uniqueSums_of_torsionFree
    intro m n hn hm
    by_contra hne
    apply hG (Additive.toMul m) hne
    exact isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, hm⟩
  exact (inferInstance : UniqueProds (Multiplicative (Additive G)))

/-- No zero divisors give trivial idempotents. -/
theorem idem_of_nzd {R : Type*} [Ring R] [NoZeroDivisors R] (a : R) (h : IsIdempotentElem a) :
    a = 0 ∨ a = 1 := by
  have : a * (a - 1) = 0 := by rw [mul_sub, mul_one, h.eq, sub_self]
  rcases mul_eq_zero.mp this with h0 | h1
  · exact Or.inl h0
  · exact Or.inr (sub_eq_zero.mp h1)

/-- The countable, finitely generated case (all hypotheses but the residual ones discharged). -/
theorem small_case (h1 : H1) (h2 : H2) (K : Type) [Field K] [Countable K] (G : Type) [Group G]
    [Group.FG G] (hG : Monoid.IsTorsionFree G) (a : MonoidAlgebra K G) (ha : IsIdempotentElem a) :
    a = 0 ∨ a = 1 := by
  by_cases hnzd : NoZeroDivisors (MonoidAlgebra K G)
  · exact idem_of_nzd a ha
  by_cases hcomm : ∀ x y : G, x * y = y * x
  · have := uniqueProds_of_comm hcomm hG
    exact absurd (inferInstance : NoZeroDivisors (MonoidAlgebra K G)) hnzd
  push Not at hcomm
  have hup : ¬ UniqueProds G := fun _ => hnzd inferInstance
  rcases CharP.char_is_prime_or_zero K (ringChar K) with hp | hp
  · exact h2 (ringChar K) K G hp hG hcomm hup hnzd a ha
  · have : CharP K 0 := hp ▸ ringChar.charP K
    have : CharZero K := CharP.charP_to_charZero K
    exact h1 K G hG hcomm hup hnzd a ha

theorem main : H1 → H2 → type_of% @Kaplansky.idempotent_conjecture := by
  intro h1 h2 K _ G _ hG a ha
  classical
  -- the subgroup generated by the support
  let s : Set G := a.coeff.support
  let H : Subgroup G := Subgroup.closure s
  have hHc : Countable H := by
    have : (H : Set G) = Set.range (FreeGroup.lift ((↑) : s → G)) := by
      rw [← MonoidHom.coe_range, ← FreeGroup.closure_eq_range]
    exact (this ▸ Set.countable_range _ : (H : Set G).Countable).to_subtype
  have hHfg : Group.FG H := (Group.fg_iff_subgroup_fg H).mpr ⟨a.coeff.support, rfl⟩
  have : Small.{0} H := Countable.toSmall H
  let H' := Shrink.{0} H
  let eH : H' ≃* H := Shrink.mulEquiv
  have : Group.FG H' := Group.fg_of_surjective (f := eH.symm.toMonoidHom) eH.symm.surjective
  let ι : H' →* G := H.subtype.comp eH.toMonoidHom
  have hι : Function.Injective ι := Subtype.val_injective.comp eH.injective
  have hG' : Monoid.IsTorsionFree H' := by
    intro g hg hfin
    apply hG (ι g) (fun h => hg (hι (h.trans (map_one ι).symm)))
    exact hι.isOfFinOrder_iff.mpr hfin
  -- the subfield generated by the coefficients
  let F : Subfield K := Subfield.closure (a.coeff.frange : Set K)
  have hFc : Countable F := by
    rw [← Cardinal.mk_le_aleph0_iff]
    exact (Subfield.cardinalMk_closure_le_max _).trans (max_le Cardinal.mk_le_aleph0 le_rfl)
  have : Small.{0} F := Countable.toSmall F
  let F' := Shrink.{0} F
  let eF : F' ≃+* F := Shrink.ringEquiv F
  have : Countable F' := Countable.of_equiv F (equivShrink F)
  let ψ : F' →+* K := F.subtype.comp eF.toRingHom
  have hψ : Function.Injective ψ := Subtype.val_injective.comp eF.injective
  -- pull a back
  let φ : MonoidAlgebra F' H' →+* MonoidAlgebra K G :=
    (MonoidAlgebra.mapDomainRingHom K ι).comp (MonoidAlgebra.mapRingHom H' ψ)
  have hφ : Function.Injective φ :=
    (MonoidAlgebra.mapDomain_injective hι).comp
      (MonoidAlgebra.map_injective ψ.toAddMonoidHom hψ)
  have hsupp : (a.coeff.support : Set G) ⊆ Set.range ι := by
    intro g hg
    exact ⟨eH.symm ⟨g, Subgroup.subset_closure hg⟩, by simp [ι]⟩
  let c := MonoidAlgebra.comapDomain ι hι a
  have hc : c ∈ Set.range (MonoidAlgebra.map (M := H') ψ.toAddMonoidHom) := by
    rw [MonoidAlgebra.range_map]
    intro i
    simp only [c, MonoidAlgebra.coeff_comapDomain, Finsupp.comapDomain_apply]
    by_cases h0 : a.coeff (ι i) = 0
    · exact ⟨0, by simp [h0]⟩
    · have hmem : a.coeff (ι i) ∈ F :=
        Subfield.subset_closure (Finsupp.mem_frange.mpr ⟨h0, ι i, rfl⟩)
      exact ⟨eF.symm ⟨_, hmem⟩, by simp [ψ]⟩
  obtain ⟨b, hb⟩ := hc
  have hab : φ b = a := by
    change MonoidAlgebra.mapDomain ι (MonoidAlgebra.map ψ.toAddMonoidHom b) = a
    rw [hb]
    exact MonoidAlgebra.mapDomain_comapDomain hsupp hι
  have hbi : IsIdempotentElem b := hφ (by rw [map_mul, hab]; exact ha)
  rcases small_case h1 h2 F' H' hG' b hbi with h | h
  · left; rw [← hab, h, map_zero]
  · right; rw [← hab, h, map_one]

end OMA.R_Kaplansky_idempotent_conjecture_R2
