import OMAStatements.S_mo_514611

/-!
For a prime degree irreducible polynomial the faithful Galois action contains a full cycle.
One transposition then generates the entire symmetric group together with that cycle.
The irreducibility argument uses Frobenius in the residue field and Gauss's lemma over
the integers, as in the setup of Philip Weiss's MathOverflow question.
-/

namespace OMA.R_mo_514611_R1

open Polynomial OMA.S_mo_514611
open scoped Classical

/-- Irreducibility of the product polynomial with constant term shifted by one. -/
def H1 : Prop :=
  ∀ p : ℕ, p.Prime → Irreducible (f p)

/-- The action on the roots contains a permutation exchanging exactly two roots. -/
def H2 : Prop :=
  ∀ p : ℕ, p.Prime →
    letI : Fact (((f p).map (algebraMap ℚ (f p).SplittingField)).Splits) :=
      ⟨SplittingField.splits (f p)⟩
    ∃ σ : (f p).Gal, (Gal.galActionHom (f p) (f p).SplittingField σ).IsSwap

lemma f_degree {p : ℕ} (hp : 0 < p) : (f p).natDegree = p := by
  have h : (∏ i ∈ Finset.range p, (X - C (i : ℚ))).natDegree = p := by
    rw [natDegree_finsetProd_X_sub_C_eq_card, Finset.card_range]
  unfold f
  rw [natDegree_add_eq_left_of_natDegree_lt, h]
  simpa only [natDegree_one, h] using hp

theorem main : H1 → H2 → type_of% @OMA.S_mo_514611.main := by
  intro irreducible hasSwap p hp
  classical
  let P := f p
  let E := P.SplittingField
  have : Fact ((P.map (algebraMap ℚ E)).Splits) := ⟨SplittingField.splits P⟩
  let ρ := Gal.galActionHom P E
  have hfaithful : Function.Injective ρ := Gal.galActionHom_injective P E
  have hdegree : P.natDegree = p := f_degree hp.pos
  have hirr : Irreducible P := irreducible p hp
  have hcard : Fintype.card (P.rootSet E) = p :=
    (card_rootSet_eq_natDegree hirr.separable (SplittingField.splits P)).trans hdegree
  have hdiv : p ∣ Nat.card P.Gal := by
    rw [← hdegree]
    exact Gal.prime_degree_dvd_card hirr (hdegree ▸ hp)
  have hrange : p ∣ Nat.card ρ.range := by
    rw [← Nat.card_congr (MonoidHom.ofInjective hfaithful).toEquiv]
    exact hdiv
  obtain ⟨σ, hσ⟩ := hasSwap p hp
  have htop : ρ.range = ⊤ := Equiv.Perm.subgroup_eq_top_of_swap_mem
    (hcard ▸ hp) (by rw [hcard, Fintype.card_eq_nat_card]; exact hrange)
    (show ρ σ ∈ ρ.range from ⟨σ, rfl⟩) hσ
  have hsurj : Function.Surjective ρ := by
    intro g
    have hg : g ∈ ρ.range := by rw [htop]; exact Subgroup.mem_top g
    exact hg
  let e : P.rootSet E ≃ Fin p := Fintype.equivFinOfCardEq hcard
  exact ⟨(MulEquiv.ofBijective ρ ⟨hfaithful, hsurj⟩).trans e.permCongrHom⟩

/-- Frobenius translates a root by minus one. The finite field generated by the root
therefore has degree divisible by the characteristic. -/
private lemma modPolynomial_irreducible (p : ℕ) [Fact p.Prime] :
    Irreducible (X ^ p - X + 1 : (ZMod p)[X]) := by
  classical
  have hp : p.Prime := Fact.out
  let P : (ZMod p)[X] := X ^ p - X + 1
  have hdeg : P.natDegree = p := by
    have h := FiniteField.X_pow_card_sub_X_natDegree_eq (ZMod p) hp.one_lt
    dsimp [P]
    rw [natDegree_add_eq_left_of_natDegree_lt, h]
    simpa only [natDegree_one, h] using hp.pos
  have hP0 : P ≠ 0 := ne_zero_of_natDegree_gt (hdeg ▸ hp.pos)
  have hPu : ¬ IsUnit P := by
    rw [isUnit_iff_degree_eq_zero, degree_eq_natDegree hP0, hdeg]
    exact_mod_cast hp.ne_zero
  obtain ⟨q, hq, hqP⟩ := WfDvdMonoid.exists_irreducible_factor hPu hP0
  let E := AdjoinRoot q
  have : Fact (Irreducible q) := ⟨hq⟩
  let B := AdjoinRoot.powerBasis hq.ne_zero
  have : Module.Finite (ZMod p) E := Module.Finite.of_basis B.basis
  have : Finite E := Module.finite_of_finite (ZMod p)
  let _ : Fintype E := Fintype.ofFinite E
  have : CharP E p := charP_of_injective_algebraMap (algebraMap (ZMod p) E).injective p
  let a : E := AdjoinRoot.root q
  have hqroot : aeval a q = 0 := by
    rw [show a = AdjoinRoot.root q from rfl, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  have hroot := aeval_eq_zero_of_dvd_aeval_eq_zero hqP hqroot
  have ha : a ^ p = a - 1 := by
    simp only [P, map_add, map_sub, map_pow, map_one, aeval_X] at hroot
    linear_combination hroot
  have hpow (i : ℕ) : a ^ (p ^ i) = a - (i : E) := by
    induction i with
    | zero => simp
    | succ i ih =>
      have hbase : (i : ZMod p) ^ p = (i : ZMod p) := by
        simpa only [ZMod.card] using FiniteField.pow_card (i : ZMod p)
      have hcast : (i : E) ^ p = (i : E) := by
        simpa only [map_pow, map_natCast] using congrArg (algebraMap (ZMod p) E) hbase
      rw [pow_succ p i, pow_mul, ih, sub_pow_char, ha, hcast, Nat.cast_succ]
      ring
  have hcard : Fintype.card E = p ^ q.natDegree := by
    rw [Module.card_eq_pow_finrank (K := ZMod p), ZMod.card, B.finrank, AdjoinRoot.powerBasis_dim]
  have hperiod := FiniteField.pow_card a
  rw [hcard, hpow] at hperiod
  have hzero : (q.natDegree : E) = 0 := by linear_combination -hperiod
  have hdvd := (CharP.cast_eq_zero_iff E p q.natDegree).mp hzero
  have hqpos : 0 < q.natDegree := by
    by_contra! h
    apply hq.not_isUnit
    rw [isUnit_iff_degree_eq_zero, degree_eq_natDegree hq.ne_zero, Nat.eq_zero_of_le_zero h]
    rfl
  have hqdegree : q.natDegree = p := le_antisymm
    (by simpa only [hdeg] using natDegree_le_of_dvd hqP hP0) (Nat.le_of_dvd hqpos hdvd)
  obtain ⟨r, hr⟩ := hqP
  have hr0 : r ≠ 0 := fun h => hP0 (by simp [hr, h])
  have hrdeg : r.natDegree = 0 := by
    have he := natDegree_mul hq.ne_zero hr0
    rw [← hr, hdeg, hqdegree] at he
    omega
  have hru : IsUnit r := by rw [isUnit_iff_degree_eq_zero, degree_eq_natDegree hr0, hrdeg]; rfl
  rw [show (X ^ p - X + 1 : (ZMod p)[X]) = P from rfl, hr, irreducible_mul_isUnit hru]
  exact hq


/-- The (p) consecutive linear factors run through all of the residues mod (p). -/
private lemma prod_mod_prime (p : ℕ) [Fact p.Prime] :
    (∏ i ∈ Finset.range p, (X - C (i : ZMod p))) = X ^ p - X := by
  classical
  have hp : p.Prime := Fact.out
  have roots_eq : (X ^ p - X : (ZMod p)[X]).roots = (Finset.univ : Finset (ZMod p)).val := by
    simpa only [ZMod.card] using FiniteField.roots_X_pow_card_sub_X (ZMod p)
  have hsplit : (X ^ p - X : (ZMod p)[X]).Splits := by
    rw [splits_iff_card_roots, roots_eq, FiniteField.X_pow_card_sub_X_natDegree_eq _ hp.one_lt,
      ← Finset.card_def, Finset.card_univ, ZMod.card]
  have hmonic : (X ^ p - X : (ZMod p)[X]).Monic := (monic_X.pow p).sub_of_left (by
    rw [degree_X, degree_X_pow]
    exact_mod_cast hp.one_lt)
  calc
    _ = ∏ x : ZMod p, (X - C x) := by
      apply Finset.prod_bij (s := Finset.range p) (t := (Finset.univ : Finset (ZMod p)))
        (fun (i : ℕ) _ => (i : ZMod p))
      · intro i _
        exact Finset.mem_univ (i : ZMod p)
      · intro a ha b hb hab
        have he := congrArg ZMod.val hab
        simpa only [ZMod.val_natCast, Nat.mod_eq_of_lt (Finset.mem_range.mp ha),
          Nat.mod_eq_of_lt (Finset.mem_range.mp hb)] using he
      · intro x _
        exact ⟨x.val, Finset.mem_range.mpr (ZMod.val_lt x), ZMod.natCast_zmod_val x⟩
      · intro _ _
        rfl
    _ = _ := by
      change ((Finset.univ : Finset (ZMod p)).val.map (fun x => X - C x)).prod = X ^ p - X
      simpa only [roots_eq] using (hsplit.eq_prod_roots_of_monic hmonic).symm

theorem f_irreducible (p : ℕ) (hp : p.Prime) : Irreducible (OMA.S_mo_514611.f p) := by
  have : Fact p.Prime := ⟨hp⟩
  let F : ℤ[X] := (∏ i ∈ Finset.range p, (X - C (i : ℤ))) + 1
  have hmono : F.Monic := by
    have hm : (∏ i ∈ Finset.range p, (X - C (i : ℤ))).Monic :=
      monic_prod_of_monic _ _ (fun _ _ => monic_X_sub_C _)
    apply hm.add_of_left
    rw [degree_one, degree_eq_natDegree hm.ne_zero, natDegree_finsetProd_X_sub_C_eq_card,
      Finset.card_range]
    exact_mod_cast hp.pos
  have hMap (R : Type) [CommRing R] :
      F.map (Int.castRingHom R) = (∏ i ∈ Finset.range p, (X - C (i : R))) + 1 := by
    dsimp [F]
    rw [Polynomial.map_add, Polynomial.map_prod, Polynomial.map_one]
    congr 1
    apply Finset.prod_congr rfl
    intro i _
    rw [Polynomial.map_sub, map_X, map_C, map_natCast]
  have hfinite : Irreducible (F.map (Int.castRingHom (ZMod p))) := by
    rw [hMap, prod_mod_prime p]
    exact modPolynomial_irreducible p
  have hInt := Monic.irreducible_of_irreducible_map _ F hmono hfinite
  have hQ := (hmono.irreducible_iff_irreducible_map_fraction_map (K := ℚ)).mp hInt
  change Irreducible (F.map (Int.castRingHom ℚ)) at hQ
  rwa [hMap] at hQ

/-- Irreducibility holds for every prime, so the conjecture is equivalent to the
presence of a transposition in each root action. -/
theorem equivalent_to_transpositions : (type_of% @OMA.S_mo_514611.main) ↔ H2 := by
  constructor
  · intro symmetric p hp
    classical
    let P := f p
    let E := P.SplittingField
    have : Fact ((P.map (algebraMap ℚ E)).Splits) := ⟨SplittingField.splits P⟩
    let ρ := Gal.galActionHom P E
    have hcard : Fintype.card (P.rootSet E) = p :=
      (card_rootSet_eq_natDegree (f_irreducible p hp).separable (SplittingField.splits P)).trans
        (f_degree hp.pos)
    let e : P.rootSet E ≃ Fin p := Fintype.equivFinOfCardEq hcard
    obtain ⟨g⟩ := symmetric p hp
    let _ : Fintype P.Gal := Fintype.ofFinite P.Gal
    have heq : Fintype.card P.Gal = Fintype.card (Equiv.Perm (P.rootSet E)) :=
      Fintype.card_congr (g.toEquiv.trans e.permCongr.symm)
    have hsurj : Function.Surjective ρ :=
      ((Fintype.bijective_iff_injective_and_card ρ).mpr
        ⟨Gal.galActionHom_injective P E, heq⟩).2
    let x : Fin p := ⟨0, hp.pos⟩
    let y : Fin p := ⟨1, hp.one_lt⟩
    have hxy : e.symm x ≠ e.symm y := e.symm.injective.ne (by
      intro h
      exact Nat.zero_ne_one (congrArg Fin.val h))
    obtain ⟨σ, hσ⟩ := hsurj (Equiv.swap (e.symm x) (e.symm y))
    exact ⟨σ, e.symm x, e.symm y, hxy, hσ⟩
  · exact main f_irreducible

end OMA.R_mo_514611_R1
