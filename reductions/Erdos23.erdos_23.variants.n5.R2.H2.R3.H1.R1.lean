      ∀ s : Fin 32, if val k s<9 then ∀ i,(!s.val.testBit i.val || adj (t k) (a k s) (b k i))=true
        else (s.val.testBit (l k s).val && s.val.testBit (r k s).val && link k (l k s) (r k s))=true := by decide +kernel
  intro k tri
  have check := verified k
  cases flag : (word k).testBit 0 with
  | true =>
    simp only [flag,if_true,Bool.and_eq_true] at check
    exact Bool.noConfusion ((tri _ _ _ check.1.1 check.1.2).symm.trans check.2)
  | false =>
