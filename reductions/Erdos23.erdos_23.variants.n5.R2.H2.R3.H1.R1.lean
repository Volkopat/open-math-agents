  let b (k i) : Fin 9 := Fin.ofNat 9 (d k i)
  let val (k : Fin 1024) (s : Fin 32) := ((word k) >>> (22+6*s.val))%64
  let a (k s) : Fin 9 := Fin.ofNat 9 (val k s)
  let l (k s) : Fin 5 := Fin.ofNat 5 ((val k s-9)/5)
  let r (k s) : Fin 5 := Fin.ofNat 5 (val k s-9)
