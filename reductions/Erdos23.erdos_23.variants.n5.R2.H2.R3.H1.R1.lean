import OMAReductions.R_Erdos23_erdos_23_variants_n5_R2_H2_R3
import Mathlib
/-! Small open-neighborhood quotients in the order-22 extremal catalogue.

The nine-vertex template and the graph6 witness with its pentagon packing
are from PR #32841. The witness is record 198 (one-based) in Brendan McKay's
minbip22_17.g6. All finite certificates below are checked by the Lean kernel.
The Wagner graph is represented by its twelve unordered edges in wagner_weights. -/
namespace OMA.R_Erdos23_erdos_23_variants_n5_R2_H2_R3_H1_R1
open Finset SimpleGraph
open scoped Classical

/-- The surjectively nine-class case already covered by the order-22 argument in PR #32841. -/
def H1 : Prop :=
  let E : Finset (Fin 9 × Fin 9) := {(2,1),(3,2),(4,1),(5,3),(5,4),(6,0),(6,2),(6,5),(7,0),(7,1),(7,3),(8,0),(8,2),(8,4)}
  ∀ G : SimpleGraph (Fin 22), G.CliqueFree 3 →
    (∃ f : Fin 22 → Fin 9, Function.Surjective f ∧
      ∀ i j,G.Adj i j → (f i,f j)∈E ∨ (f j,f i)∈E) →
    ∃ c : Fin 22 → Bool, (∑ i,∑ j,if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) ≤ 34

/-- Remaining upper bound on maximal extremizers outside the nine-class
family with at least ten open-neighborhood classes. -/
def H2 : Prop :=
  let E : Finset (Fin 9 × Fin 9) := {(2,1),(3,2),(4,1),(5,3),(5,4),(6,0),(6,2),(6,5),(7,0),(7,1),(7,3),(8,0),(8,2),(8,4)}
  ∀ G : SimpleGraph (Fin 22), Maximal (fun K : SimpleGraph (Fin 22) => K.CliqueFree 3) G →
  let loss (K : SimpleGraph (Fin 22)) (c : Fin 22 → Bool) :=
    ∑ i,∑ j,if K.Adj i j ∧ c i=c j then (1:ℕ) else 0
  let best (K : SimpleGraph (Fin 22)) := (univ.image (loss K)).min' (univ_nonempty.image _)
  (∀ K : SimpleGraph (Fin 22), K.CliqueFree 3 → best K ≤ best G) →
  10 ≤ (univ.image (fun i => G.neighborFinset i)).card →
  (¬ ∃ f : Fin 22 → Fin 9, Function.Surjective f ∧
      ∀ i j,G.Adj i j → (f i,f j)∈E ∨ (f j,f i)∈E) →
  ∃ c : Fin 22 → Bool, (∑ i,∑ j,if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) ≤ 34

section SmallQuotients

private lemma among_neighbors {V : Type*} [DecidableEq V] (G : SimpleGraph V) (tri : G.CliqueFree 3)
    (S : Finset V) (v : V) {k : ℕ} (h : k≤(S.filter (G.Adj v)).card) :
    ∃ T⊆S,T.card=k ∧ ∀ a∈T,∀ b∈T,¬G.Adj a b := by
  obtain ⟨T,sub,card⟩ := exists_subset_card_eq h
  refine ⟨T,fun _ ha => (mem_filter.mp (sub ha)).1,card,?_⟩
  intro a ha b hb ab
  exact tri _ (is3Clique_triple_iff.mpr ⟨(mem_filter.mp (sub ha)).2,(mem_filter.mp (sub hb)).2,ab⟩)

private lemma nonneighbors {V : Type*} [DecidableEq V] (G : SimpleGraph V)
    {S : Finset V} {v : V} (hv : v∈S) :
    ∃ B⊆S,B.card+(S.filter (G.Adj v)).card+1=S.card ∧ ∀ i∈B,i≠v ∧ ¬G.Adj v i := by
  let A := S.filter (G.Adj v)
  let B := S.erase v \ A
  have sub : A ⊆ S.erase v := by
    intro i hi
    obtain ⟨hs,he⟩ := mem_filter.mp hi
    exact mem_erase.mpr ⟨he.ne.symm,hs⟩
  have rem := card_sdiff_add_card_eq_card sub
  have n := card_erase_of_mem hv
  refine ⟨B,fun _ h => (mem_erase.mp (mem_sdiff.mp h).1).2,?_,?_⟩
  · change (S.erase v \ A).card+A.card+1=S.card
    rw [rem,n]; have := card_pos.mpr ⟨v,hv⟩; omega
  · intro i hi
    obtain ⟨hs,hn⟩ := mem_sdiff.mp hi
    exact ⟨(mem_erase.mp hs).1,fun e => hn (mem_filter.mpr ⟨(mem_erase.mp hs).2,e⟩)⟩

private lemma add_independent {V : Type*} [DecidableEq V] (G : SimpleGraph V) {v : V} {T : Finset V}
    (free : ∀ a∈T,∀ b∈T,¬G.Adj a b) (away : ∀ i∈T,i≠v ∧ ¬G.Adj v i) :
    (insert v T).card=T.card+1 ∧ ∀ a∈insert v T,∀ b∈insert v T,¬G.Adj a b := by
  refine ⟨card_insert_of_notMem (fun h => (away v h).1 rfl),?_⟩
  intro a ha b hb
  rcases mem_insert.mp ha with ea|ha <;> rcases mem_insert.mp hb with eb|hb
  · rw [ea,eb]; exact G.loopless.irrefl _
  · rw [ea]; exact (away _ hb).2
  · rw [eb]; exact fun e => (away _ ha).2 e.symm
  · exact free _ ha _ hb

private lemma stable_pair {V : Type*} [DecidableEq V] (G : SimpleGraph V) (tri : G.CliqueFree 3)
    (S : Finset V) (n : 3≤S.card) :
    ∃ T⊆S,T.card=2 ∧ ∀ a∈T,∀ b∈T,¬G.Adj a b := by
  have ex : ∃ a∈S,∃ b∈S,a≠b ∧ ¬G.Adj a b := by
    by_contra! complete
    obtain ⟨U,sub,card⟩ := exists_subset_card_eq n
    obtain ⟨a,b,c,ab,ac,bc,rfl⟩ := card_eq_three.mp card
    have ha : a∈S := sub (by simp)
    have hb : b∈S := sub (by simp)
    have hc : c∈S := sub (by simp)
    exact tri _ (is3Clique_triple_iff.mpr ⟨complete a ha b hb ab,complete a ha c hc ac,complete b hb c hc bc⟩)
  obtain ⟨a,ha,b,hb,ne,missing⟩ := ex
  have one : ∀ x∈({b} : Finset V),∀ y∈({b} : Finset V),¬G.Adj x y := by simp
  have z := add_independent (v:=a) G one (by simpa using And.intro ne.symm missing)
  exact ⟨{a,b},insert_subset ha (singleton_subset_iff.mpr hb),by simpa using z.1,z.2⟩

private lemma stable_three {V : Type*} [DecidableEq V] (G : SimpleGraph V) (tri : G.CliqueFree 3)
    (S : Finset V) (n : 6≤S.card) :
    ∃ T⊆S,T.card=3 ∧ ∀ a∈T,∀ b∈T,¬G.Adj a b := by
  obtain ⟨v,hv⟩ := card_pos.mp (show 0<S.card by omega)
  by_cases big : 3≤(S.filter (G.Adj v)).card
  · exact among_neighbors G tri S v big
  obtain ⟨B,sub,count,away⟩ := nonneighbors G hv
  obtain ⟨T,small,card,free⟩ := stable_pair G tri B (by omega)
  have z := add_independent G free (fun i h => away i (small h))
  exact ⟨insert v T,insert_subset hv (small.trans sub),by omega,z.2⟩

/-- The Ramsey bound R(3,4) ≤ 9. A graph on nine vertices cannot be cubic.
A vertex of degree at most two leaves six nonneighbors, which contain
an independent triple. -/
lemma independent_four (G : SimpleGraph (Fin 9)) (tri : G.CliqueFree 3) :
    ∃ T : Finset (Fin 9),T.card=4 ∧ ∀ a∈T,∀ b∈T,¬G.Adj a b := by
  classical
  have deg (v) : (univ.filter (G.Adj v)).card=G.degree v := by
    rw [←G.neighborFinset_eq_filter,G.card_neighborFinset_eq_degree]
  by_cases big : ∃ v,4≤G.degree v
  · obtain ⟨v,hv⟩ := big
    obtain ⟨T,_,h,ht⟩ := among_neighbors G tri univ v (by simpa only [deg] using hv)
    exact ⟨T,h,ht⟩
  have low : ∃ v,G.degree v≤2 := by
    by_contra! h
    have cubic (v) : G.degree v=3 := by have := h v; have h' : ¬4≤G.degree v := fun z => big ⟨v,z⟩; omega
    have total := G.sum_degrees_eq_twice_card_edges
    simp only [cubic,sum_const,card_univ,Fintype.card_fin,smul_eq_mul] at total
    omega
  obtain ⟨v,hv⟩ := low
  obtain ⟨B,_,count,away⟩ := nonneighbors G (mem_univ v)
  rw [deg,card_univ,Fintype.card_fin] at count
  obtain ⟨T,sub,card,free⟩ := stable_three G tri B (by omega)
  have z := add_independent G free (fun i h => away i (sub h))
  exact ⟨insert v T,by omega,z.2⟩

private lemma pack_bits {n : ℕ} (f : Fin n → Bool) :
    ∃ k : Fin (2^n),∀ i,k.val.testBit i.val=f i := by
  induction n with
  | zero => exact ⟨0,fun i => Fin.elim0 i⟩
  | succ n ih =>
    obtain ⟨k,hk⟩ := ih (fun i => f i.succ)
    have bound : Nat.bit (f 0) k.val < 2^(n+1) := by
      have h := k.isLt
      cases val : f 0 <;> simp [Nat.bit,pow_succ] <;> omega
    refine ⟨⟨_,bound⟩,Fin.cases ?_ (fun i => ?_)⟩
    · exact Nat.testBit_bit_zero _ _
    · exact (Nat.testBit_bit_succ _ _ _).trans (hk i)

