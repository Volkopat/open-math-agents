  let cost (x : Fin 8 → ℕ) (m : ℕ) := ∑ e∈E,
    if m.testBit e.1.val=m.testBit e.2.val then x e.1*x e.2 else 0
  ∀ x : Fin 8 → ℕ, (∑ i,x i)=22 → ∃ m,cost x m≤16 := by
  intro E cost x mass
  let leaf (s : ℕ) (lo hi : Fin 8 → ℕ) :=
    let sl := ∑ i,lo i
    let sh := ∑ i,hi i
    let h (i : Fin 8) := min (hi i) (22+lo i-sl)
    if s=255 then decide (22<sl ∨ sh<22) else decide (cost h s≤16)
