        simpa only [hi,Bool.not_true,Bool.false_or] using ck i
      · rw [if_neg cap] at ck
        simp only [Bool.and_eq_true] at ck
        exact Bool.noConfusion ((stable _ _ ck.1.1 ck.1.2).symm.trans ck.2)

private lemma target_choice {V : Type*} (G : SimpleGraph V) (t : Bool) (lab : V → Fin 9) :
  let adj (t : Bool) (i j : Fin 9) := (if t then (0x1505894b1225252929c0 : ℕ) else 0xe0a8a8a260a84a20e).testBit (9*i.val+j.val)
  (∀ i j,G.Adj i j → adj t (lab i) (lab j)=true) →
  (∃ f : V → Fin 9,∀ i j,G.Adj i j → adj false (f i) (f j)=true) ∨
  (∃ f : V → Fin 9,Function.Surjective f ∧ ∀ i j,G.Adj i j → adj true (f i) (f j)=true) := by
  intro adj mapped
  cases t with
  | false => exact Or.inl ⟨lab,mapped⟩
  | true =>
    by_cases onto : Function.Surjective lab
    · exact Or.inr ⟨lab,onto,mapped⟩
    · obtain ⟨d,miss⟩ : ∃ d,∀ v,lab v≠d := by simpa [Function.Surjective] using onto
      let reroute : Fin 9 → Fin 9 → Fin 9 := ![![0,1,0,2,4,5,2,0,1],![0,0,6,5,7,4,1,2,3],![0,6,0,7,5,4,1,3,2],![0,5,6,0,4,7,3,2,1],![5,1,0,1,0,0,2,4,2],![5,1,0,1,0,0,2,4,2],![4,0,3,6,2,5,0,1,7],![0,2,0,1,5,4,1,0,2],![7,0,1,6,2,5,4,3,0]]
      have route : ∀ d i j,i≠d → j≠d → adj true i j=true →
          adj false (reroute d i) (reroute d j)=true := by decide +kernel
      exact Or.inl ⟨fun v => reroute d (lab v),fun i j h => route _ _ _ (miss i) (miss j) (mapped i j h)⟩

/-- Five labelled vertices covering every edge suffice to map into the
Wagner graph or surject onto the nine-vertex graph from PR #32841. -/
lemma five_cover_targets {V : Type*} (G : SimpleGraph V) (tri : G.CliqueFree 3)
    (u : Fin 5 → V) (cover : ∀ i j,G.Adj i j → i∈Set.range u ∨ j∈Set.range u) :
  let adj (t : Bool) (i j : Fin 9) := (if t then (0x1505894b1225252929c0 : ℕ) else 0xe0a8a8a260a84a20e).testBit (9*i.val+j.val)
  (∃ f : V → Fin 9,∀ i j,G.Adj i j → adj false (f i) (f j)=true) ∨
  (∃ f : V → Fin 9,Function.Surjective f ∧ ∀ i j,G.Adj i j → adj true (f i) (f j)=true) := by
  intro adj
  let pair : Fin 10 → Fin 5 × Fin 5 := ![(0,1),(0,2),(0,3),(0,4),(1,2),(1,3),(1,4),(2,3),(2,4),(3,4)]
  let ix : Fin 5 → Fin 5 → Fin 10 := ![![0,0,1,2,3],![0,0,4,5,6],![1,4,0,7,8],![2,5,7,0,9],![3,6,8,9,0]]
  let link (k : Fin 1024) (i j : Fin 5) := decide (i≠j) && k.val.testBit (ix i j).val
  obtain ⟨k,bits⟩ := pack_bits (fun h : Fin 10 => decide (G.Adj (u (pair h).1) (u (pair h).2)))
  have order : ∀ i j : Fin 5,i≠j → pair (ix i j)=(i,j) ∨ pair (ix i j)=(j,i) := by decide +kernel
  have decode (i j) : link k i j=true ↔ G.Adj (u i) (u j) := by
    by_cases h : i=j
    · subst j; simp [link]
    · rcases order i j h with direct|rev
      · simp only [link,decide_eq_true h,Bool.true_and,bits,direct,decide_eq_true_eq]
      · simp only [link,decide_eq_true h,Bool.true_and,bits,rev,decide_eq_true_eq]
        exact G.adj_comm _ _
  have safe (i j l) (ij : link k i j=true) (il : link k i l=true) : link k j l=false := by
    cases jl : link k j l with
    | false => rfl
    | true => exact False.elim (tri _ (is3Clique_triple_iff.mpr
        ⟨(decode _ _).1 ij,(decode _ _).1 il,(decode _ _).1 jl⟩))
  obtain ⟨t,b,a,bb,extend⟩ := cover_certificates k safe
  have masks (v : V) := pack_bits (fun i : Fin 5 => decide (G.Adj v (u i)))
  choose m hm using masks
  have mask (v i) : (m v).val.testBit i.val=true ↔ G.Adj v (u i) := by rw [hm]; simp
  have stable (v i j) (hi : (m v).val.testBit i.val=true) (hj : (m v).val.testBit j.val=true) :
      link k i j=false := by
    cases e : link k i j with
    | false => rfl
    | true => exact False.elim (tri _ (is3Clique_triple_iff.mpr
        ⟨(mask _ _).1 hi,(mask _ _).1 hj,(decode _ _).1 e⟩))
  let lab (v : V) := if v∈Set.range u then b (Function.invFun u v) else a (m v)
  have sym : ∀ h i j,adj h i j=adj h j i := by decide +kernel
  have hu {v : V} (h : v∈Set.range u) : u (Function.invFun u v)=v := Function.invFun_eq h
  have mapped (i j) (edge : G.Adj i j) : adj t (lab i) (lab j)=true := by
    by_cases hi : i∈Set.range u
    · by_cases hj : j∈Set.range u
      · simp only [lab,hi,hj,if_true]
        apply bb; apply (decode _ _).2; simpa only [hu hi,hu hj] using edge
      · simp only [lab,hi,hj,if_true,if_false]
        rw [sym]
        apply extend (m j) (stable j)
        apply (mask _ _).2; simpa only [hu hi] using edge.symm
    · have hj := (cover i j edge).resolve_left hi
      simp only [lab,hi,hj,if_true,if_false]
      apply extend (m i) (stable i)
      apply (mask _ _).2; simpa only [hu hj] using edge
  exact target_choice G t lab mapped

/-- Project equal open neighborhoods to the same vertex. Unused labels in
the padded nine-vertex graph can be represented by any original vertex. -/
lemma quotient_targets (G : SimpleGraph (Fin 22)) (tri : G.CliqueFree 3)
    (small : (univ.image (fun i => G.neighborFinset i)).card≤9) :
  let adj (t : Bool) (i j : Fin 9) := (if t then (0x1505894b1225252929c0 : ℕ) else 0xe0a8a8a260a84a20e).testBit (9*i.val+j.val)
  (∃ f : Fin 22 → Fin 9,∀ i j,G.Adj i j → adj false (f i) (f j)=true) ∨
  (∃ f : Fin 22 → Fin 9,Function.Surjective f ∧ ∀ i j,G.Adj i j → adj true (f i) (f j)=true) := by
  intro adj
  let S := univ.image (fun i => G.neighborFinset i)
  have sz : Fintype.card S ≤ 9 := (Fintype.card_coe S).le.trans small
  let e : S ↪ Fin 9 := (Fintype.equivFin S).toEmbedding.trans
    (Fin.castLEEmb sz)
  let q (i : Fin 22) := e ⟨G.neighborFinset i,mem_image_of_mem _ (mem_univ i)⟩
  let g := Function.invFun q
  have same (i) : G.neighborFinset (g (q i))=G.neighborFinset i :=
    congrArg Subtype.val (e.injective (show q (g (q i))=q i from Function.apply_invFun_apply))
  have rep (i j) : G.Adj (g (q i)) j ↔ G.Adj i j := by
    simpa only [G.mem_neighborFinset] using
      (show j∈G.neighborFinset (g (q i)) ↔ j∈G.neighborFinset i by rw [same])
  let Q := G.comap g
  have hQ (i j) (h : G.Adj i j) : Q.Adj (q i) (q j) := (rep i _).2 ((rep j i).2 h.symm).symm
  have clean : Q.CliqueFree 3 := by
    intro s h
    obtain ⟨i,j,k,ij,ik,jk,_⟩ := is3Clique_iff.mp h
    exact tri _ (is3Clique_triple_iff.mpr
      ⟨show G.Adj (g i) (g j) from ij,show G.Adj (g i) (g k) from ik,show G.Adj (g j) (g k) from jk⟩)
  obtain ⟨T,ht,free⟩ := independent_four Q clean
  let B := (univ : Finset (Fin 9)) \ T
  have size : B.card=5 := by simp only [B,card_sdiff_of_subset (subset_univ T),card_univ,Fintype.card_fin,ht]
  let label : Fin 5 ≃ B := (Fintype.equivFinOfCardEq (α := B) ((Fintype.card_coe B).trans size)).symm
  let u (i : Fin 5) := (label i).val
  have hit (i) (hi : i∉T) : i∈Set.range u := by
    have hb : i∈B := mem_sdiff.mpr ⟨mem_univ i,hi⟩
    exact ⟨label.symm ⟨i,hb⟩,by simp [u]⟩
  have cover (i j) (edge : Q.Adj i j) : i∈Set.range u ∨ j∈Set.range u := by
    by_cases hi : i∈T
    · exact Or.inr (hit j (fun hj => free i hi j hj edge))
    · exact Or.inl (hit i hi)
  rcases five_cover_targets Q clean u cover with ⟨w,hw⟩|⟨n,_,hn⟩
  · exact Or.inl ⟨w ∘ q,fun i j h => hw _ _ (hQ i j h)⟩
  · exact target_choice G true (n ∘ q) (fun i j h => hn _ _ (hQ i j h))

private lemma search_boxes (x : Fin 8 → ℕ) (P : Prop)
    (leaf : ℕ → (Fin 8 → ℕ) → (Fin 8 → ℕ) → Bool)
    (valid : ∀ s lo hi, (∀ i,lo i ≤ x i) → (∀ i,x i ≤ hi i) → leaf s lo hi=true → P) :
    let run (t : BinaryTree ℕ) := BinaryTree.rec (motive:=fun _ => (Fin 8 → ℕ) → (Fin 8 → ℕ) → Bool)
      (fun _ _ => false) (fun s _ _ l r lo hi =>
        if s<256 then leaf s lo hi else
          l lo (Function.update hi (Fin.ofNat 8 ((s-256)%8)) ((s-256)/8)) &&
          r (Function.update lo (Fin.ofNat 8 ((s-256)%8)) ((s-256)/8+1)) hi) t
    ∀ t lo hi, (∀ i,lo i ≤ x i) → (∀ i,x i ≤ hi i) → run t lo hi=true → P := by
  intro run t
  induction t with
  | nil => simp [run]
  | node s l r hl hr =>
    intro lo hi low high h
    by_cases tip : s<256
    · exact valid s lo hi low high (by simpa only [run,BinaryTree.rec,tip,if_true] using h)
    let k := Fin.ofNat 8 ((s-256)%8)
    change (if s<256 then _ else _ && _)=true at h
    rw [if_neg tip,Bool.and_eq_true] at h
    by_cases side : x k ≤ (s-256)/8
    · apply hl lo _ low _ h.1
      intro i
      by_cases eq : i=k
      · subst i; simpa [k] using side
      · rw [Function.update_of_ne eq]; exact high i
    · apply hr _ hi _ high h.2
      intro i
      by_cases eq : i=k
      · subst i; simpa [k] using (show (s-256)/8+1 ≤ x k by omega)
      · rw [Function.update_of_ne eq]; exact low i

private lemma tighten (x lo hi : Fin 8 → ℕ) (mass : ∑ i,x i=22)
    (low : ∀ i,lo i≤x i) (high : ∀ i,x i≤hi i) (i : Fin 8) :
    max (lo i) (22+hi i-(∑ j,hi j)) ≤ x i ∧
    x i ≤ min (hi i) (22+lo i-(∑ j,lo j)) := by
  have sl := sum_erase_add univ lo (mem_univ i)
  have sh := sum_erase_add univ hi (mem_univ i)
  have sx := sum_erase_add univ x (mem_univ i)
  have al := sum_le_sum (s:=univ.erase i) (fun j _ => low j)
  have au := sum_le_sum (s:=univ.erase i) (fun j _ => high j)
  exact ⟨max_le (low i) (by omega),le_min (high i) (by omega)⟩

