namespace A067126Prefix
open OMA.S_oeis_a067126 A067126Deficit

/-- All composite weak records through the certified bound are the two
exceptions from the source conjecture. -/
theorem full_finite (n : ℕ) (hn : 1 < n) (hi : n ≤ 64000000000)
    (rec : IsTerm n) (composite : ¬n.Prime) : n=4 ∨ n=9 :=
  full_of_square_intervals 64000000000 252982 (by decide) TotientMesh.finite_part
    TotientMesh.square_prime n hn hi rec composite

/-- An unconditional exclusion at every height for composite records sharing
a nontrivial divisor of size at most 1200. -/
theorem small_factor_record {n d : ℕ} (hn : 1 < n) (rec : IsTerm n) (composite : ¬n.Prime)
    (hd : 1 < d) (small : d ≤ 1200) (div : d ∣ n) : n=4 ∨ n=9 := by
  by_cases hi : n ≤ 64000000000
  · exact full_finite n hn hi rec composite
  · exact False.elim (small.not_gt (rough_1200 TotientMesh.finite_prime (by omega) rec d hd div))

end A067126Prefix

namespace OMA.R_oeis_a067126_R1_H2_R1
open OMA.S_oeis_a067126 A067126Gap A067126Deficit

/-- The indicated finite portion of Sorenson and Webster's Oppermann computation. -/
def H1 : Prop :=
  ∀ k : ℕ, 100000 ≤ k → k ≤ 70500000000000 →
    (∃ r : ℕ, r.Prime ∧ k^2 < r ∧ r < k*(k+1)) ∧
    (∃ r : ℕ, r.Prime ∧ k*(k+1) < r ∧ r < (k+1)^2)

/-- Only gaps violating the square-root bound enter this short-interval estimate.
The exponent 10/19 exceeds the asymptotic exponent 0.525 of Baker, Harman and Pintz. -/
def H2 : Prop :=
  ∀ a b : ℕ, 70500000000000^2 ≤ a → a.Prime → b.Prime → a < b →
    (∀ r : ℕ, a < r → r < b → ¬r.Prime) → 4*a < (b-a-1)^2 → (b-a)^19 ≤ a^10

/-- Legendre's prime interval only at the lower member of a large twin pair. -/
def H3 : Prop :=
  ∀ p : ℕ, p.Prime → (p+2).Prime → 70500000000000^2 < p*(p+2) →
    ∃ r : ℕ, r.Prime ∧ p^2 < r ∧ r < (p+1)^2

/-- An exceptional, non-twin semiprime with no better earlier prime needs
a better product of two primes strictly between its factors. Equal factors
are permitted, so the witness can be a prime square. -/
def H4 : Prop :=
  ∀ p q a b : ℕ, p.Prime → q.Prime → p+2 < q → q^9 < p^10 → 32*q < p^2 →
    70500000000000^2 ≤ a → a.Prime → b.Prime → a < p*q → p*q < b →
    (∀ r : ℕ, a < r → r < b → ¬r.Prime) → 4*a < (b-a-1)^2 →
    (b-a)^19 ≤ a^10 → a ≤ (p-1)*(q-1)+1 →
    ∃ r s : ℕ, r.Prime ∧ s.Prime ∧ p < r ∧ r ≤ s ∧ s < q ∧ r*s < p*q ∧
      (p-1)*(q-1) < (r*s).totient

theorem sorted_factors {n : ℕ} (hn : 1 < n) (many : ¬IsPrimePow n) :
    ∃ p q m : ℕ, p.Prime ∧ q.Prime ∧ p < q ∧ 0 < m ∧ n = p*q*m := by
  obtain ⟨p,q,m,hp,hq,ne,hm,eq⟩ := distinct_prime_factors hn many
  rcases lt_or_gt_of_ne ne with h|h
  · exact ⟨p,q,m,hp,hq,h,hm,eq⟩
  · exact ⟨q,p,m,hq,hp,h,hm,by simpa only [mul_comm p q] using eq⟩

theorem min_record_index {n : ℕ} (hn : 1 < n) (odd : Odd n)
    (many : ¬IsPrimePow n) (composite : ¬n.Prime) : 15 ≤ n := by
  obtain ⟨w,hw⟩ := odd
  by_contra! small
  have h : n = 3 ∨ n = 5 ∨ n = 7 ∨ n = 9 ∨ n = 11 ∨ n = 13 := by omega
  rcases h with h|h|h|h|h|h <;> rw [h] at many composite <;>
    first | exact composite (by decide) | exact many ((isPrimePow_nat_iff _).mpr
      ⟨3,2,by decide,by decide,by decide⟩)

theorem main : H1 → H2 → H3 → H4 → OMA.R_oeis_a067126_R1.H2 := by
  intro intervals gaps twins interior n hn odd many composite rec
  have lo := min_record_index hn odd many composite
  have deficit := four_mul_le_deficit_sq hn many
  by_cases initial : n ≤ 64000000000
  · exact TotientMesh.finite_part n lo initial deficit rec
  obtain ⟨a,b,alen,pa,pb,left,right,empty⟩ := prime_bracket (by omega : 3 ≤ n) composite
  obtain ⟨violation,short⟩ := record_gap rec odd alen pa pb left right deficit
  have beyond : 70500000000000^2 ≤ a := by
    by_contra! small
    have half := lower_prime_from_bertrand (by omega : 5 ≤ n) odd right empty
    have floor : 100000^2 ≤ a := by norm_num; omega
    exact violation.not_ge (finite_oppermann_gap small floor left right empty intervals)
  have bound := gaps a b beyond pa pb (left.trans right) empty violation
  obtain ⟨p,q,m,hp,hq,order,hm,eq⟩ := sorted_factors hn many
  have one : m = 1 := by
    by_contra! multi
    have cube := sq_le_deficit_cube hp.two_le hq.two_le (by omega : 2 ≤ m) eq
    have cap := cube_gap_lt left (by omega : 0 < b-a) bound
    exact cap.not_ge (cube.trans (Nat.pow_le_pow_left short.le 3))
  rw [one,mul_one] at eq
  subst n
  have phi : (p*q).totient = (p-1)*(q-1) := by
    rw [Nat.totient_mul ((Nat.coprime_primes hp hq).2 order.ne),Nat.totient_prime hp,Nat.totient_prime hq]
  have d := deficit_two_primes (n:=p*q) hp hq order.ne (show p*q = p*q*1 by simp)
  simp only [one_mul] at d
  have hqgap : q ≤ b-a := by have := hp.two_le; omega
  have bal := semiprime_balance hq.pos left hqgap bound
  have large := beyond.trans_lt left
  have ratio := balance_ratio large bal
  have oddp : Odd p := hp.odd_of_ne_two (by
    rintro rfl; exact odd.not_two_dvd_nat (dvd_mul_right 2 q))
  have oddq : Odd q := hq.odd_of_ne_two (by have := hp.two_le; omega)
  by_cases twin : q = p+2
  · subst q
    exact (A067126Twin.twin_record_iff_no_prime p hp hq).mp rec (twins p hp hq large)
  · have apart : p+2 < q := by obtain ⟨u,hu⟩ := oddp; obtain ⟨v,hv⟩ := oddq; omega
    have hprev := rec a pa.pos left
    rw [Nat.totient_prime pa,phi] at hprev
    obtain ⟨r,s,pr,ps,_,_,_,near,better⟩ := interior p q a b hp hq apart bal ratio beyond pa pb
      left right empty violation bound (by omega)
    have test := rec (r*s) (Nat.mul_pos pr.pos ps.pos) near
    rw [phi] at test
    exact test.not_gt better

end OMA.R_oeis_a067126_R1_H2_R1
