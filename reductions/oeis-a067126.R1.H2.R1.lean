theorem cubic_to_square {n d : ℕ} (lo : 64 ≤ n) (h : n^2 ≤ d^3) :
    4*n ≤ (d+1)^2 := by
  by_contra! bad
  have ds : d^2 < 4*n := by nlinarith only [bad,Nat.zero_le d]
  have h₂ := Nat.pow_le_pow_left h 2
  have h₃ := Nat.pow_lt_pow_left ds (by decide : (3 : ℕ) ≠ 0)
  have h₄ := Nat.mul_le_mul_right (n^3) lo
  nlinarith only [h₂,h₃,h₄]

theorem check_small {n : ℕ} (hn : 1 < n) (small : n < 64)
    (rec : IsTerm n) (composite : ¬n.Prime) : n = 4 ∨ n = 9 := by
  have check : ∀ i : Fin 64, 1 < i.val → ¬i.val.Prime →
      (∀ k : Fin 64, 1 ≤ k.val → k.val < i.val → k.val.totient ≤ i.val.totient) →
      i.val = 4 ∨ i.val = 9 := by decide +kernel
  exact check ⟨n,small⟩ hn composite (fun k lo hi => rec k.val lo hi)

/-- Once prime squares have an earlier prime in their totient window, the
same certified cover excludes all other composite records through the cutoff. -/
theorem full_of_square_intervals (B T : ℕ) (maxSq : B < (T+1)^2)
    (cover : ∀ n : ℕ, 15 ≤ n → n ≤ B → 4*n ≤ (n-n.totient+1)^2 → IsTerm n → False)
    (squares : ∀ p : ℕ, p.Prime → 3 < p → p ≤ T →
      ∃ r : ℕ, r.Prime ∧ p*(p-1)+1 < r ∧ r < p^2)
    (n : ℕ) (hn : 1 < n) (hi : n ≤ B) (rec : IsTerm n) (composite : ¬n.Prime) :
    n = 4 ∨ n = 9 := by
  by_cases small : n < 64
  · exact check_small hn small rec composite
  exfalso
  by_cases pp : IsPrimePow n
  · obtain ⟨p,e,hp,ep,he⟩ := (isPrimePow_nat_iff _).mp pp
    have h1 : e ≠ 1 := by rintro rfl; rw [pow_one] at he; exact composite (he ▸ hp)
    by_cases two : e = 2
    · subst e
      have pl : 3 < p := by
        by_contra! bound
        have h := Nat.pow_le_pow_left bound 2
        norm_num at h
        omega
      have pu : p ≤ T := by
        by_contra! h
        have h' := Nat.pow_le_pow_left (show T+1 ≤ p by omega) 2
        omega
      obtain ⟨r,pr,low,high⟩ := squares p hp pl pu
      have test := rec r pr.pos (he ▸ high)
      rw [←he,Nat.totient_prime_pow_succ hp 1,Nat.totient_prime pr,pow_one] at test
      omega
    · have ee : e = 1+1+(e-2) := by omega
      have he' : n = p*p*p^(e-2) := by
        rw [←he,ee,pow_add]
        simp only [Nat.reduceAdd,pow_two]
        congr 2; omega
      have big : 2 ≤ p^(e-2) := calc
        2 ≤ p := hp.two_le
        _ = p^1 := (pow_one _).symm
        _ ≤ p^(e-2) := Nat.pow_le_pow_right hp.pos (by omega)
      apply cover n (by omega) hi _ rec
      exact cubic_to_square (by omega) (sq_le_deficit_cube hp.two_le hp.two_le big he')
  · exact cover n (by omega) hi (four_mul_le_deficit_sq hn pp) rec

end A067126Prefix

/- A primality sieve and a prime sufficiently close below each bounded index. -/
namespace TotientMesh
open OMA.S_oeis_a067126

lemma prime_from_wheel {v b W : ℕ} (hw : ∀ t ≤ b, 2 ≤ t → ¬W.Coprime t)
    (small : v < (b+1)^2) (big : 2 ≤ v) (cop : W.Coprime v) : v.Prime := by
  refine Nat.prime_def_le_sqrt.mpr ⟨big,?_⟩
  intro t ht hs dv
  have bound : v.sqrt < b+1 := Nat.sqrt_lt.mpr (by simpa only [pow_two] using small)
  exact hw t (by omega) ht (cop.coprime_dvd_right dv)

lemma mesh_block {W b : ℕ} (hw : ∀ t ≤ b, 2 ≤ t → ¬W.Coprime t)
    (a stop step grid len data : ℕ) :
    let primeOK (v : ℕ) := if v ≤ b then decide v.Prime else decide (v < (b+1)^2 ∧ 2 ≤ v ∧ W.Coprime v)
    let run : ℕ → ℕ → ℕ → Bool := Nat.rec (fun x _ => x == stop)
      (fun _ next x bits =>
        let rank := if bits%16=15 then 15+(bits >>> 4)%128 else bits%16
        let shift := if bits%16=15 then 11 else 4
        let stride := if step=0 then (4*x-1).sqrt-2 else step
        let y := x+stride-grid*rank
        decide ((y-x+2)^2 < 4*x) && primeOK y && next y (bits >>> shift))
    (primeOK a && run len a data) = true →
    ∀ n, a < n → n ≤ stop → ∃ r : ℕ, r.Prime ∧ r < n ∧ (n-r+2)^2 < 4*n := by
  intro primeOK run hc
  have true_prime (z : ℕ) (hz : primeOK z = true) : z.Prime := by
    by_cases small : z ≤ b
    · simpa [primeOK,small] using hz
    · have h : z < (b+1)^2 ∧ 2 ≤ z ∧ W.Coprime z := by simpa [primeOK,small] using hz
      exact prime_from_wheel hw h.1 h.2.1 h.2.2
  have aux : ∀ k x bits, primeOK x = true → run k x bits = true →
      ∀ n, x < n → n ≤ stop → ∃ r : ℕ, r.Prime ∧ r < n ∧ (n-r+2)^2 < 4*n := by
    intro k
    induction k with
    | zero =>
      intro x bits hx hr n lo hi
      change (x == stop) = true at hr
      have := beq_iff_eq.mp hr
      omega
    | succ k ih =>
      intro x bits hx hr n lo hi
      let rank := if bits%16=15 then 15+(bits >>> 4)%128 else bits%16
      let shift := if bits%16=15 then 11 else 4
      let stride := if step=0 then (4*x-1).sqrt-2 else step
      let y := x+stride-grid*rank
      change (decide ((y-x+2)^2 < 4*x) && primeOK y && run k y (bits >>> shift))=true at hr
      simp only [Bool.and_eq_true,decide_eq_true_eq] at hr
      by_cases ny : n ≤ y
      · have he : n-x+2 ≤ y-x+2 := by omega
        exact ⟨x,true_prime x hx,lo,
          ((Nat.pow_le_pow_left he 2).trans_lt hr.1.1).trans_le (by omega)⟩
      · exact ih y _ hr.1.2 hr.2 n (by omega) hi
  simp only [Bool.and_eq_true] at hc
  exact aux len a data hc.1 hc.2

lemma record_contradiction (n : ℕ)
    (prime : ∃ r : ℕ, r.Prime ∧ r < n ∧ (n-r+2)^2 < 4*n)
    (deficit : 4*n ≤ (n-n.totient+1)^2) (term : IsTerm n) : False := by
  obtain ⟨r,hr,hrn,small⟩ := prime
  have bound := term r hr.pos hrn
  rw [Nat.totient_prime hr] at bound
  have h : n-n.totient+1 ≤ n-r+2 := by omega
  have := Nat.pow_le_pow_left h 2
  omega

