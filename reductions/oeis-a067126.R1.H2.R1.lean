/-- A square interval needs to be searched only for possible prime bases.
The small sieve excludes most candidates before testing them against the full sieve. -/
lemma square_chunk {W b S s : ℕ} (hw : ∀ t ≤ b, 2 ≤ t → ¬W.Coprime t)
    (hs : ∀ t ≤ s, 2 ≤ t → ¬S.Coprime t) (sf : S ∣ Nat.factorial s)
    (a len : ℕ) :
    let candidate (v : ℕ) := if v ≤ s then decide v.Prime else
      decide (S.Coprime v) && (decide (v < (s+1)^2) || decide (W.Coprime v))
    let base (p : ℕ) := if p ≤ s then decide p.Prime else decide (S.Coprime p)
    let ok (p : ℕ) := decide (p ≤ 3) || !(base p) || (List.range 97).any (fun i =>
      let r := p^2-2*(i+1)
      decide (p*(p-1)+1 < r ∧ r < p^2) && candidate r)
    (List.range' a len).all ok = true →
    ∀ p, p.Prime → 3 < p → p ≤ b → a ≤ p → p < a+len →
      ∃ r : ℕ, r.Prime ∧ p*(p-1)+1 < r ∧ r < p^2 := by
  intro candidate base ok h p hp lo hi pa pm
  have hf : base p = true := by
    by_cases ps : p ≤ s
    · simp [base,ps,hp]
    · have fc : p.Coprime (Nat.factorial s) :=
        (Nat.coprime_factorial_iff hp.ne_one).mpr (by simpa [hp.minFac_eq] using (Nat.lt_of_not_ge ps))
      simp only [base,ps,if_false,decide_eq_true_eq]
      exact (fc.coprime_dvd_right sf).symm
  have member : p ∈ List.range' a len := by simpa using And.intro pa pm
  have test := List.all_eq_true.mp h p member
  change (decide (p ≤ 3) || !(base p) || _) = true at test
  simp only [show decide (p≤3)=false by simpa using lo,hf,Bool.not_true,Bool.false_or] at test
  obtain ⟨i,_,good⟩ := List.any_eq_true.mp test
  let r := p^2-2*(i+1)
  change (decide (p*(p-1)+1 < r ∧ r < p^2) && candidate r) = true at good
  simp only [Bool.and_eq_true,decide_eq_true_eq] at good
  obtain ⟨gap,check⟩ := good
  refine ⟨r,?_,gap⟩
  by_cases little : r ≤ s
  · simpa [candidate,little] using check
  · have checks : S.Coprime r ∧ (r < (s+1)^2 ∨ W.Coprime r) := by
      simpa [candidate,little] using check
    obtain ⟨sm,short|big⟩ := checks
    · exact prime_from_wheel hs short (by omega) sm
    · have le := (Nat.pow_le_pow_left hi 2).trans (Nat.pow_le_pow_left (Nat.le_succ _) 2)
      exact prime_from_wheel hw (gap.2.trans_le le) (by omega) big


