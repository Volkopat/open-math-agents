import OMAReductions.R_oeis_a067126_R1
import Mathlib.NumberTheory.SumPrimeReciprocals
import Mathlib.Data.Nat.Factorization.PrimePow
import Mathlib.Data.Nat.Factorization.Induction

/-! Weak totient records with at least two distinct prime factors.
Compare the previous prime to the totient deficit, prove the exact condition
on balanced semiprimes, and verify a finite exclusion using prime waypoints. -/

namespace A067126Deficit

theorem distinct_prime_factors {n : ℕ} (hn : 1 < n) (h : ¬ IsPrimePow n) :
    ∃ p q m : ℕ, p.Prime ∧ q.Prime ∧ p ≠ q ∧ 0 < m ∧ n = p * q * m := by
  obtain ⟨p, hp, q, hq, hne⟩ := (Nat.not_isPrimePow_iff_nontrivial_of_two_le hn).mp h
  obtain ⟨m, hm⟩ := Nat.Prime.dvd_mul_of_dvd_ne hne (Nat.prime_of_mem_primeFactors hp)
    (Nat.prime_of_mem_primeFactors hq) (Nat.dvd_of_mem_primeFactors hp)
    (Nat.dvd_of_mem_primeFactors hq)
  refine ⟨p, q, m, Nat.prime_of_mem_primeFactors hp, Nat.prime_of_mem_primeFactors hq,
    hne, ?_, hm⟩
  by_contra! hz
  simp [Nat.eq_zero_of_le_zero hz] at hm
  omega

theorem totient_mul_le (a m : ℕ) : (m * a).totient ≤ m * a.totient := by
  induction m using induction_on_primes with
  | zero => simp
  | one => simp
  | prime_mul p b hp ih =>
    rw [mul_assoc, mul_assoc]
    calc
      (p * (b * a)).totient ≤ p * (b * a).totient := by
        by_cases hd : p ∣ b * a
        · rw [Nat.totient_mul_of_prime_of_dvd hp hd]
        · rw [Nat.totient_mul_of_prime_of_not_dvd hp hd]
          exact Nat.mul_le_mul_right _ (Nat.sub_le _ _)
      _ ≤ _ := Nat.mul_le_mul_left p ih

theorem totient_two_primes {n p q m : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q)
    (he : n = p * q * m) : n.totient ≤ m * (p - 1) * (q - 1) := by
  simpa [he, mul_comm m (p * q), Nat.totient_mul ((Nat.coprime_primes hp hq).2 hne),
    Nat.totient_prime hp, Nat.totient_prime hq, mul_assoc] using totient_mul_le (p * q) m

theorem deficit_two_primes {n p q m : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q)
    (he : n = p * q * m) : m * (p + q - 1) ≤ n - n.totient := by
  have H := totient_two_primes hp hq hne he
  have hp1 := hp.pos
  have hq1 := hq.pos
  obtain ⟨u, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hp1.ne'
  obtain ⟨v, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hq1.ne'
  simp only [Nat.succ_eq_add_one, Nat.add_sub_cancel] at H
  suffices n.totient + m * (u + 1 + v) ≤ n by
    have hsum : u + 1 + (v + 1) - 1 = u + 1 + v := by omega
    simpa only [Nat.succ_eq_add_one, hsum] using (by omega : m * (u + 1 + v) ≤ n - n.totient)
  nlinarith only [H, he]

theorem four_mul_le_deficit_sq {n : ℕ} (hn : 1 < n) (h : ¬ IsPrimePow n) :
    4 * n ≤ (n - n.totient + 1) ^ 2 := by
  obtain ⟨p, q, m, hp, hq, hpq, hm, he⟩ := distinct_prime_factors hn h
  have hd := deficit_two_primes hp hq hpq he
  have hsum : m * p + q ≤ n - n.totient + 1 := by
    obtain ⟨v, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hq.ne_zero
    obtain ⟨a, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hm.ne'
    have hv : p + v.succ - 1 = p + v := by omega
    rw [hv] at hd
    nlinarith
  calc
    4 * n = 4 * (m * p) * q := by rw [he]; ring
    _ ≤ (m * p + q)^2 := four_mul_le_sq_add _ _
    _ ≤ _ := Nat.pow_le_pow_left hsum 2

/-- Any three nontrivial factors suffice; repeated prime factors are allowed. -/
theorem sq_le_deficit_cube {n a b c : ℕ} (ha : 2 ≤ a) (hb : 2 ≤ b) (hc : 2 ≤ c)
    (he : n = a * b * c) : n ^ 2 ≤ (n - n.totient) ^ 3 := by
  have hn : 1 < n := by
    rw [he]
    calc
      1 < 2 * 2 * 2 := by decide
      _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul ha hb) hc
  let p := n.minFac
  have hp : p.Prime := Nat.minFac_prime (by omega)
  have hpa : p ≤ a := Nat.minFac_le_of_dvd ha ⟨b * c, by rw [he, mul_assoc]⟩
  have hpb : p ≤ b := Nat.minFac_le_of_dvd hb ⟨a * c, by rw [he]; ring⟩
  have hpc : p ≤ c := Nat.minFac_le_of_dvd hc ⟨a * b, by rw [he]; ring⟩
  obtain ⟨m, hm⟩ := Nat.minFac_dvd n
  change n = p * m at hm
  have hcubic : p * (p * p) ≤ p * m := by
    rw [← hm, he, ← mul_assoc]
    exact Nat.mul_le_mul (Nat.mul_le_mul hpa hpb) hpc
  have hm2 := Nat.le_of_mul_le_mul_left hcubic hp.pos
  have ht : n.totient ≤ m * (p - 1) := by
    simpa [mul_comm m p, ← hm, Nat.totient_prime hp] using totient_mul_le p m
  have hd : m ≤ n - n.totient := by
    have hp' := Nat.sub_add_cancel (show 1 ≤ p from hp.pos)
    have hprod := congrArg (m * ·) hp'
    simp only [Nat.mul_add, Nat.mul_one] at hprod
    rw [mul_comm m p, ← hm] at hprod
    omega
  calc
    n^2 = (p * p) * (m * m) := by rw [hm]; ring
    _ ≤ m * (m * m) := Nat.mul_le_mul_right _ hm2
    _ = m ^ 3 := by ring
    _ ≤ _ := Nat.pow_le_pow_left hd 3

end A067126Deficit

/- Comparing a weak totient record with the adjacent primes. -/
namespace A067126Gap
open OMA.S_oeis_a067126

theorem prime_bracket {n : ℕ} (lo : 3 ≤ n) (composite : ¬n.Prime) :
    ∃ a b : ℕ, 3 ≤ a ∧ a.Prime ∧ b.Prime ∧ a<n ∧ n<b ∧
      (∀ r : ℕ, a<r → r<b → ¬r.Prime) := by
  let a := Nat.findGreatest Nat.Prime n
  let b := Nat.find (Nat.exists_infinite_primes (n+1))
  have pa : a.Prime := Nat.findGreatest_spec lo (by decide : Nat.Prime 3)
  have h₁ : a≤n := Nat.findGreatest_le _
  have h₂ : n+1≤b ∧ b.Prime := Nat.find_spec (Nat.exists_infinite_primes (n+1))
  refine ⟨a,b,Nat.le_findGreatest lo (by decide : Nat.Prime 3),pa,h₂.2,
    lt_of_le_of_ne h₁ (fun e => composite (e ▸ pa)),by omega,?_⟩
  intro r left right pr
  by_cases mid : r ≤ n
  · exact Nat.findGreatest_is_greatest left mid pr
  · have := Nat.find_min' (Nat.exists_infinite_primes (n+1)) (show n+1≤r ∧ r.Prime from ⟨by omega,pr⟩)
    change b≤r at this
    omega

theorem deficit_le {n a : ℕ} (rec : IsTerm n) (pa : a.Prime) (left : a < n) :
    n-n.totient ≤ n-a+1 := by
  have h := rec a pa.pos left
  rw [Nat.totient_prime pa] at h
  omega

theorem record_gap {n a b : ℕ} (rec : IsTerm n) (odd : Odd n)
    (lo : 3 ≤ a) (pa : a.Prime) (pb : b.Prime) (left : a<n) (right : n<b)
    (deficit : 4*n ≤ (n-n.totient+1)^2) :
    4*a < (b-a-1)^2 ∧ n-n.totient < b-a := by
  have d := deficit_le rec pa left
  obtain ⟨u,hu⟩ := pa.odd_of_ne_two (by omega)
  obtain ⟨v,hv⟩ := pb.odd_of_ne_two (by omega)
  obtain ⟨w,hw⟩ := odd
  have x : 2 ≤ n-a := by omega
  have diff : a+(n-a)=n := by omega
  have near := Nat.pow_le_pow_left (show n-n.totient+1 ≤ n-a+2 by omega) 2
  have outer := Nat.pow_le_pow_left (show n-a+1 ≤ b-a-1 by omega) 2
  constructor
  · nlinarith only [deficit,near,outer,diff,x]
  · omega

theorem sqrt_gap_of_integer {a b : ℕ} (left : a+1≤b)
    (bad : 4*a < (b-a-1)^2) : 1 < Real.sqrt b - Real.sqrt a := by
  by_contra! hyp
  have rel : Real.sqrt b ≤ Real.sqrt a+1 := by linarith
  have sq := mul_self_le_mul_self (Real.sqrt_nonneg _) rel
  have ar := Real.sq_sqrt (by positivity : (0:ℝ) ≤ a)
  have br := Real.sq_sqrt (by positivity : (0:ℝ) ≤ b)
  have eqn : (b-a-1)+a+1=b := by omega
  have eqr : ((b-a-1 : ℕ) : ℝ) + a + 1 = b := by exact_mod_cast eqn
  have gap : ((b-a-1 : ℕ):ℝ) ≤ 2*Real.sqrt a := by nlinarith
  have gap2 := mul_self_le_mul_self (by positivity : (0:ℝ)≤(b-a-1 : ℕ)) gap
  have bad' : 4*(a:ℝ) < ((b-a-1 : ℕ) : ℝ)^2 := by exact_mod_cast bad
  nlinarith

/-- A cutoff for the ordinary prime-gap estimate with exponent 10/19 also
bounds the cube of the gap, sufficient when n has at least three factors. -/
theorem cube_gap_lt {a n g : ℕ} (left : a<n) (gpos : 0<g)
    (estimate : g^19 ≤ a^10) : g^3 < n^2 := by
  have lo : g^18 ≤ g^19 := Nat.pow_le_pow_right gpos (by decide)
  have comp := Nat.pow_lt_pow_left left (by decide : (10:ℕ) ≠ 0)
  have hi : n^10 ≤ n^12 := Nat.pow_le_pow_right (by omega) (by decide)
  have eq : (g^3)^6 < (n^2)^6 := by
    simpa only [←pow_mul] using (lo.trans estimate).trans_lt (comp.trans_le hi)
  exact (Nat.pow_lt_pow_iff_left (by decide : 6 ≠ 0)).mp eq

theorem semiprime_balance {p q a g : ℕ} (qpos : 0<q) (left : a<p*q)
    (qgap : q≤g) (estimate : g^19 ≤ a^10) : q^9 < p^10 := by
  have h := (Nat.pow_le_pow_left qgap 19).trans estimate
  have h' := h.trans_lt (Nat.pow_lt_pow_left left (by decide : (10:ℕ) ≠ 0))
  rw [mul_pow] at h'
  have eq : q^19=q^9*q^10 := by ring
  rw [eq] at h'
  exact (Nat.mul_lt_mul_right (pow_pos qpos _)).mp h'

theorem nth_pair {a b : ℕ} (pa : a.Prime) (pb : b.Prime) (ab : a<b)
    (empty : ∀ r : ℕ, a<r → r<b → ¬r.Prime) :
    ∃ i : ℕ, Nat.nth Nat.Prime i = a ∧ Nat.nth Nat.Prime (i+1) = b := by
  let i := Nat.count Nat.Prime a
  have eq : Nat.nth Nat.Prime i = a := Nat.nth_count pa
  have inf : (Set.ofPred Nat.Prime).Infinite := Nat.infinite_setOfPred_prime
  let c := Nat.nth Nat.Prime (i+1)
  have pc : c.Prime := Nat.nth_mem_of_infinite inf _
  have ac : a<c := by
    rw [←eq]
    exact Nat.nth_strictMono inf (Nat.lt_succ_self i)
  refine ⟨i,eq,le_antisymm ?_ ?_⟩
  · by_contra! bc
    have h := Nat.le_nth_of_lt_nth_succ bc pb
    rw [eq] at h
    omega
  · by_contra! cb
    exact empty _ ac cb pc

end A067126Gap

namespace A067126Gap

/-- Two half-square intervals at adjacent indices bound a gap crossing
their common square. A gap left of that square needs just one interval. -/
theorem half_intervals_bound {a b k : ℕ} (ab : a<b) (lower : k^2≤a)
    (upper : a<(k+1)^2) (empty : ∀ r : ℕ, a<r → r<b → ¬r.Prime)
    (right : ∃ r : ℕ, r.Prime ∧ k*(k+1)<r ∧ r<(k+1)^2)
    (next : ∃ r : ℕ, r.Prime ∧ (k+1)^2<r ∧ r<(k+1)*(k+2))
    : (b-a-1)^2 ≤ 4*a := by
  have width : b-a-1 ≤ 2*k := by
    by_cases first : a < k*(k+1)
    · obtain ⟨r,pr,lo,hi⟩ := right
      have br : b≤r := by by_contra! h; exact empty r (first.trans lo) h pr
      have high : r < k^2+2*k+1 := by nlinarith only [hi]
      omega
    · obtain ⟨r,pr,lo,hi⟩ := next
      have br : b≤r := by by_contra! h; exact empty r (upper.trans lo) h pr
      have high : r < k*(k+1)+2*k+2 := by nlinarith only [hi]
      omega
  have h := Nat.pow_le_pow_left width 2
  nlinarith only [lower,h]

theorem lower_prime_from_bertrand {n a b : ℕ} (hn : 5≤n) (odd : Odd n)
    (above : n<b) (empty : ∀ r : ℕ, a<r → r<b → ¬r.Prime) : n/2<a := by
  obtain ⟨r,hr,lo,hi⟩ := Nat.exists_prime_lt_and_le_two_mul (n/2) (by omega)
  obtain ⟨t,ht⟩ := odd
  have ra : r≤a := by by_contra! bad; exact empty _ bad (by omega) hr
  omega

theorem finite_oppermann_gap {a b n S : ℕ} (small : a<S^2) (floor : 100000^2≤a)
    (left : a<n) (right : n<b)
    (empty : ∀ r : ℕ, a<r → r<b → ¬r.Prime)
    (cert : ∀ k : ℕ, 100000≤k → k≤S →
      (∃ r : ℕ, r.Prime ∧ k^2<r ∧ r<k*(k+1)) ∧
      (∃ r : ℕ, r.Prime ∧ k*(k+1)<r ∧ r<(k+1)^2)) :
    (b-a-1)^2 ≤ 4*a := by
  let k := a.sqrt
  have kl : 100000≤k := Nat.le_sqrt'.mpr floor
  have ku : k<S := by
    by_contra! bad
    have h := (Nat.pow_le_pow_left bad 2).trans (Nat.sqrt_le' a)
    omega
  have sqlo : k^2≤a := Nat.sqrt_le' a
  have sqhi : a<(k+1)^2 := Nat.lt_succ_sqrt' a
  apply half_intervals_bound (left.trans right) sqlo sqhi empty
    (cert k kl (by omega)).2 (cert (k+1) (by omega) (by omega)).1

/-- At the large discriminant cutoff, the balanced semiprime branch is
sufficiently narrow that products of three factors cannot improve on it. -/
theorem balance_ratio {p q : ℕ}
    (large : 70500000000000^2 < p*q) (bal : q^9<p^10) : 32*q < p^2 := by
  have pbig : 256 ≤ p := by
    by_contra! small
    have bound := Nat.pow_le_pow_left (show p ≤ 255 by omega) 10
    have qlim : q < 1000 := by
      by_contra! h
      have huge := Nat.pow_le_pow_left h 9
      norm_num at bound huge
      omega
    have prod := Nat.mul_le_mul (show p≤255 by omega) (show q≤1000 by omega)
    norm_num at large prod
    omega
  have grow : 32^9 < p^8 := by
    have h := Nat.pow_le_pow_left pbig 8
    norm_num at h ⊢
    omega
  have base : (32*q)^9 < (p^2)^9 := by
    calc
      (32*q)^9 = 32^9*q^9 := by ring
      _ < p^8*p^10 := Nat.mul_lt_mul_of_lt_of_lt grow bal
      _ = (p^2)^9 := by ring
  exact (Nat.pow_lt_pow_iff_left (by decide : 9≠0)).mp base

end A067126Gap

namespace A067126Gap
open OMA.S_oeis_a067126 A067126Deficit

theorem record_violates_andrica {n : ℕ} (hn : 1<n) (odd : Odd n)
    (many : ¬IsPrimePow n) (composite : ¬n.Prime) (rec : IsTerm n) :
    ∃ i : ℕ, 1 < Real.sqrt (Nat.nth Nat.Prime (i+1)) - Real.sqrt (Nat.nth Nat.Prime i) := by
  have lo : 3 ≤ n := by obtain ⟨w,hw⟩ := odd; omega
  obtain ⟨a,b,alen,pa,pb,left,right,empty⟩ := prime_bracket lo composite
  have gap := (record_gap rec odd alen pa pb left right (four_mul_le_deficit_sq hn many)).1
  obtain ⟨i,hi,hj⟩ := nth_pair pa pb (left.trans right) empty
  exact ⟨i,by rw [hi,hj]; exact sqrt_gap_of_integer (by omega) gap⟩

theorem of_andrica (h : ∀ i : ℕ,
    Real.sqrt (Nat.nth Nat.Prime (i+1)) - Real.sqrt (Nat.nth Nat.Prime i) ≤ 1) :
    OMA.R_oeis_a067126_R1.H2 := by
  intro n hn odd many composite rec
  obtain ⟨i,violation⟩ := record_violates_andrica hn odd many composite rec
  exact (h i).not_gt violation

end A067126Gap

/- A composite cannot displace a twin-prime semiprime from a weak totient record. -/

namespace A067126Twin

open OMA.S_oeis_a067126 OMA.R_oeis_a067126_R1

private theorem composite_below_pronic {p m : ℕ} (hp : 8 ≤ p) (hm : ¬m.Prime)
    (hm1 : 1 < m) (hi : m < p*(p+2)) : m.totient < p^2 := by
  by_cases low : m ≤ p^2
  · exact (Nat.totient_lt m hm1).trans_le low
  have lo : p^2 < m := by omega
  have sub := Nat.sub_add_cancel (Nat.totient_le m)
  suffices deficit : 2*p ≤ m-m.totient by nlinarith only [deficit, sub, hi]
  by_cases power : IsPrimePow m
  · obtain ⟨r,e,pr,he,eq⟩ := (isPrimePow_nat_iff m).mp power
    have three : 3 ≤ e := by
      by_contra! h
      interval_cases e
      · apply hm
        rwa [←eq, pow_one]
      · have hi' : r^2 < (p+1)^2 := by nlinarith only [eq, hi]
        have lo' : p < r := by
          by_contra! h
          nlinarith only [Nat.pow_le_pow_left h 2,eq,lo]
        exact (not_lt_of_ge (Nat.pow_le_pow_left lo' 2)) hi'
    let c := r^(e-2)
    have hc : 2 ≤ c := by
      calc
        2 ≤ r := pr.two_le
        _ = r^1 := (pow_one _).symm
        _ ≤ c := Nat.pow_le_pow_right pr.pos (by omega)
    have fact : m = r*r*c := by
      rw [←eq, ←pow_two, ←pow_add]
      congr 1
      omega
    have cube := A067126Deficit.sq_le_deficit_cube pr.two_le pr.two_le hc fact
    by_contra! h
    have ll : (p^2)^2 ≤ m^2 := Nat.pow_le_pow_left lo.le 2
    have uu : (m-m.totient)^3 < (2*p)^3 := Nat.pow_lt_pow_left h (by decide)
    have scale := Nat.mul_le_mul_right (p^3) hp
    nlinarith only [ll, uu, cube, scale]
  · have sq := A067126Deficit.four_mul_le_deficit_sq hm1 power
    by_contra! h
    have t : m-m.totient+1 ≤ 2*p := by omega
    nlinarith only [Nat.pow_le_pow_left t 2, sq, lo]

private theorem twin_phi {p : ℕ} (h : p.Prime) (h' : (p+2).Prime) :
    (p*(p+2)).totient + 1 = p^2 := by
  rw [Nat.totient_mul ((Nat.coprime_primes h h').2 (by omega)), Nat.totient_prime h,
    Nat.totient_prime h']
  have hp := Nat.sub_add_cancel h.pos
  rw [show p+2-1=p+1 by omega]
  nlinarith [congrArg (fun x : ℕ => x*(p+1)) hp]

private theorem small_twin_gap (p : ℕ) (h : p.Prime) (hs : p < 8) :
    ∃ r : ℕ, r.Prime ∧ p^2 < r ∧ r < (p+1)^2 := by
  have table : ∀ x : Fin 8, x.val.Prime →
      ∃ r : Fin 65, r.val.Prime ∧ x.val^2 < r.val ∧ r.val < (x.val+1)^2 := by decide +kernel
  obtain ⟨r,hr⟩ := table ⟨p,hs⟩ h
  exact ⟨r,hr⟩

theorem twin_record_iff_no_prime (p : ℕ) (hp : p.Prime) (hq : (p+2).Prime) :
    IsTerm (p*(p+2)) ↔ ¬∃ r : ℕ, r.Prime ∧ p^2 < r ∧ r < (p+1)^2 := by
  have phi := twin_phi hp hq
  have np : ¬(p*(p+2)).Prime := Nat.not_prime_mul hp.ne_one (by omega)
  constructor
  · rintro rec ⟨r,hr,lower,upper⟩
    have hne : r ≠ p*(p+2) := fun he => np (he ▸ hr)
    have hi : r < p*(p+2) := by
      rw [show (p+1)^2=p*(p+2)+1 by ring] at upper
      omega
    have hit := rec r hr.pos hi
    rw [Nat.totient_prime hr] at hit
    omega
  · intro gap k hk hi
    have pbig : 8 ≤ p := by
      by_contra! hs
      exact gap (small_twin_gap p hp hs)
    by_cases pp : k.Prime
    · have small : k ≤ p^2 := by
        by_contra! bad
        exact gap ⟨k,pp,bad,by nlinarith only [hi]⟩
      rw [Nat.totient_prime pp]
      omega
    by_cases h1 : 1 < k
    · have lim := composite_below_pronic pbig pp h1 hi
      omega
    · have : k = 1 := by omega
      have large : 4 ≤ p^2 := by nlinarith only [Nat.pow_le_pow_left hp.two_le 2]
      simp only [this, Nat.totient_one]
      omega

theorem square_interval_of_h2 (sol : H2) (p : ℕ) (hp : p.Prime) (hq : (p+2).Prime) :
    ∃ r : ℕ, r.Prime ∧ p^2 < r ∧ r < (p+1)^2 := by
  by_cases small : p < 8
  · exact small_twin_gap p hp small
  by_contra none
  have record :=  (twin_record_iff_no_prime p hp hq).mpr none
  have odd : Odd (p*(p+2)) := (hp.odd_of_ne_two (by omega)).mul (hq.odd_of_ne_two (by omega))
  have no : ¬IsPrimePow (p*(p+2)) := by
    intro h
    obtain ⟨r,e,hr,_,eq⟩ := (isPrimePow_nat_iff _).mp h
    have dv1 : p ∣ r^e := by rw [eq]; exact dvd_mul_right p (p+2)
    have dv2 : p+2 ∣ r^e := by rw [eq]; exact dvd_mul_left (p+2) p
    have e1 := (Nat.prime_dvd_prime_iff_eq hp hr).mp (hp.dvd_of_dvd_pow dv1)
    have e2 := (Nat.prime_dvd_prime_iff_eq hq hr).mp (hq.dvd_of_dvd_pow dv2)
    omega
  exact sol _ (by nlinarith only [hp.two_le]) odd no (Nat.not_prime_mul hp.ne_one (by omega)) record

end A067126Twin

/- Competitors for a balanced semiprime record come from primes and interior prime pairs. -/

namespace A067126Interior

open OMA.S_oeis_a067126

private theorem no_triple {p q k a b c : ℕ} (hp : 5 ≤ p) (hpq : p < q)
    (balance : 32*q < p^2) (hi : k < p*q) (beats : (p-1)*(q-1) < k.totient)
    (ha : 2 ≤ a) (hb : 2 ≤ b) (hc : 2 ≤ c) (eq : k=a*b*c) : False := by
  have half : p*q ≤ 2*((p-1)*(q-1)) := by
    obtain ⟨u,hu⟩ : ∃ u : ℕ, p=u+5 := ⟨p-5,by omega⟩
    obtain ⟨v,hv⟩ : ∃ v : ℕ, q=v+5 := ⟨q-5,by omega⟩
    rw [hu,hv,show u+5-1=u+4 by omega,show v+5-1=v+4 by omega]
    nlinarith only [Nat.zero_le (u*v),Nat.zero_le u,Nat.zero_le v]
  have tot : (p-1)*(q-1) + p+q = p*q+1 := by
    obtain ⟨u,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (show p ≠ 0 by omega)
    obtain ⟨v,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (show q ≠ 0 by omega)
    simp only [Nat.succ_eq_add_one, Nat.add_sub_cancel]
    ring
  have lk := Nat.totient_le k
  have lower : p*q < 2*k := by omega
  have deficit : k-k.totient ≤ 2*q := by omega
  have cube := A067126Deficit.sq_le_deficit_cube ha hb hc eq
  have lo := Nat.pow_lt_pow_left lower (by decide : 2 ≠ 0)
  have up := Nat.pow_le_pow_left deficit 3
  have bad := Nat.mul_lt_mul_of_pos_right balance (pow_pos (show 0 < q by omega) 2)
  nlinarith only [lo, up, cube, bad]

private theorem outer_distinct {p q r s : ℕ}
    (hr : r.Prime) (hs : s.Prime) (hne : r ≠ s) (rp : r ≤ p) (pq : p < q)
    (sm : r*s < p*q) : (r*s).totient ≤ (p-1)*(q-1) := by
  rw [Nat.totient_mul ((Nat.coprime_primes hr hs).2 hne), Nat.totient_prime hr, Nat.totient_prime hs]
  obtain ⟨u,rfl⟩ := Nat.exists_eq_succ_of_ne_zero hr.ne_zero
  obtain ⟨v,rfl⟩ := Nat.exists_eq_succ_of_ne_zero hs.ne_zero
  obtain ⟨x,hx⟩ : ∃ x : ℕ, p=(u+1)+x := ⟨p-(u+1),by omega⟩
  obtain ⟨y,hy⟩ : ∃ y : ℕ, q=(u+1)+y := ⟨q-(u+1),by omega⟩
  rw [hx,hy] at sm ⊢
  simp only [Nat.succ_eq_add_one,Nat.add_sub_cancel,
    show u+1+x-1=u+x by omega, show u+1+y-1=u+y by omega]
  apply Nat.le_of_mul_le_mul_left _ (Nat.succ_pos u)
  have slim := Nat.mul_le_mul_left u sm.le
  nlinarith only [slim,Nat.zero_le (x*y)]

theorem balanced_record_iff {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p<q)
    (lo : 5≤p) (balance : 32*q < p^2) :
    IsTerm (p*q) ↔
      (¬∃ r : ℕ, r.Prime ∧ (p-1)*(q-1)+1 < r ∧ r < p*q) ∧
      (¬∃ r s : ℕ, r.Prime ∧ s.Prime ∧ p < r ∧ r ≤ s ∧ s < q ∧ r*s < p*q ∧
        (p-1)*(q-1) < (r*s).totient) := by
  have tot : (p*q).totient = (p-1)*(q-1) := by
    rw [Nat.totient_mul ((Nat.coprime_primes hp hq).2 hpq.ne),Nat.totient_prime hp,Nat.totient_prime hq]
  constructor
  · intro rec
    constructor
    · rintro ⟨r,hr,hbeat,hlt⟩
      have test := rec r hr.pos hlt
      rw [Nat.totient_prime hr,tot] at test
      omega
    · rintro ⟨r,s,hr,hs,_,_,_,hlt,hbeat⟩
      have test := rec _ (Nat.mul_pos hr.pos hs.pos) hlt
      omega
  · rintro ⟨primes,inside⟩ k hpos hi
    rw [tot]
    by_contra! hb
    by_cases pk : k.Prime
    · have ht := Nat.totient_prime pk
      exact primes ⟨k,pk,by omega,hi⟩
    have hk : k ≠ 1 := by
      rintro rfl
      have e : 1 ≤ (p-1)*(q-1) := Nat.mul_pos (by omega) (by omega)
      simp at hb
      omega
    let r := k.minFac
    have hr : r.Prime := Nat.minFac_prime hk
    obtain ⟨s,eq⟩ := Nat.minFac_dvd k
    change k = r*s at eq
    have hs : 2 ≤ s := by
      by_contra! ht
      interval_cases s <;> simp_all
    have rs : r ≤ s := Nat.minFac_le_of_dvd hs ⟨r,by rw [eq,mul_comm]⟩
    have ps : s.Prime := by
      by_contra notp
      obtain ⟨a,b,ha,hb',hab⟩ := (Nat.not_prime_iff_exists_mul_eq hs).mp notp
      have a2 : 2≤a := by by_contra! h; interval_cases a <;> simp_all
      have b2 : 2≤b := by by_contra! h; interval_cases b <;> simp_all
      exact no_triple lo hpq balance hi hb hr.two_le a2 b2 (by rw [eq, ←hab, mul_assoc])
    rw [eq] at hi hb
    by_cases greater : p < r
    · have sq : s < q := by
        by_contra! h
        exact (Nat.not_le_of_gt hi) (Nat.mul_le_mul greater.le h)
      exact inside ⟨r,s,hr,ps,greater,rs,sq,hi,hb⟩
    have rp : r ≤ p := by omega
    by_cases same : r=s
    · subst s
      have ht : (r*r).totient = r*(r-1) := by
        simpa [pow_succ] using Nat.totient_prime_pow_succ hr 1
      rw [ht] at hb
      apply (Nat.not_le_of_gt hb)
      calc r*(r-1) ≤ (q-1)*(p-1) := Nat.mul_le_mul (by omega) (by omega)
           _ = _ := mul_comm _ _
    exact (Nat.not_le_of_gt hb) (outer_distinct hr ps same rp hpq hi)

theorem adjacent_record_iff {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p<q)
    (lo : 5≤p) (balance : 32*q < p^2) (adj : ∀ r, p<r → r<q → ¬Nat.Prime r) :
    IsTerm (p*q) ↔ ¬∃ r : ℕ, r.Prime ∧ (p-1)*(q-1)+1 < r ∧ r<p*q := by
  rw [balanced_record_iff hp hq hpq lo balance]
  apply and_iff_left_of_imp
  rintro _ ⟨r,s,hr,_,h1,h2,h3,_⟩
  exact adj r h1 (by omega) hr

set_option maxRecDepth 8192 in
/-- In a consecutive prime pair every semiprime competitor is excluded. -/
theorem consecutive_record_iff {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p < q)
    (adj : ∀ r, p < r → r < q → ¬ r.Prime) :
    IsTerm (p*q) ↔ ¬∃ r : ℕ, r.Prime ∧ (p-1)*(q-1)+1 < r ∧ r < p*q := by
  by_cases big : 65 ≤ p
  · obtain ⟨b,hb,pb,upper⟩ := Nat.exists_prime_lt_and_le_two_mul p hp.ne_zero
    have qb : q ≤ b := by by_contra! fail; exact adj b pb fail hb
    have scale := Nat.mul_le_mul_right p big
    apply adjacent_record_iff hp hq hpq (by omega) _ adj
    nlinarith only [scale, qb, upper, hp.pos]
  let W : List (ℕ × ℕ) := [(3,5), (5,11), (7,29), (11,67), (13,127), (17,197), (19,293), (23,401), (29,619), (31,853), (37,1087), (41,1447), (43,1693), (47,1949), (53,2399), (59,3019), (61,3491), (67,3967)]
  have cover : ∀ i : Fin 65, i.val.Prime → ∃ z ∈ W,
      i.val < z.1 ∧ z.1.Prime ∧ (∀ t ∈ Finset.Ioo i.val z.1, ¬ t.Prime) ∧
      2 ≤ z.2 ∧ (∀ a ∈ Finset.Icc 2 z.2.sqrt, ¬a ∣ z.2) ∧
      (i.val-1)*(z.1-1)+1 < z.2 ∧ z.2 < i.val*z.1 := by
    dsimp only [W]
    decide +kernel
  obtain ⟨z,_,pz,primez,noinner,two,trial,beat,under⟩ := cover ⟨p,by omega⟩ hp
  have primew : z.2.Prime := Nat.prime_def_le_sqrt.mpr
    ⟨two,fun a lo hi => trial a (Finset.mem_Icc.mpr ⟨lo,hi⟩)⟩
  have eq : q = z.1 := by
    apply le_antisymm
    · by_contra! h
      exact adj z.1 pz h primez
    · by_contra! h
      exact noinner q (Finset.mem_Ioo.mpr ⟨hpq,h⟩) hq
  have witness : ∃ r : ℕ, r.Prime ∧ (p-1)*(q-1)+1 < r ∧ r < p*q := by
    rw [eq]
    exact ⟨z.2,primew,beat,under⟩
  constructor
  · intro record
    rintro ⟨r,prime,lower,above⟩
    have hit := record r prime.pos above
    rw [Nat.totient_prime prime,
      Nat.totient_mul ((Nat.coprime_primes hp hq).2 hpq.ne),
      Nat.totient_prime hp, Nat.totient_prime hq] at hit
    omega
  · intro absent
    exact (absent witness).elim

end A067126Interior

namespace A067126Deficit

open OMA.S_oeis_a067126

/-- A fixed relative gap between every pair of large consecutive primes would make
the series of their reciprocals converge by the ratio test. -/
theorem exists_close_primes (K : ℕ) (hK : 1 < K) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ K ≤ p ∧ p < q ∧ K * q < K * p + q := by
  let e : ℕ ≃o {p : ℕ // p.Prime} := @Nat.Subtype.orderIsoOfNat {n : ℕ | n.Prime}
    Nat.infinite_setOfPred_prime.to_subtype
  let f : ℕ → ℝ := fun i => 1 / ((e i).val : ℝ)
  by_contra! H
  apply Nat.Primes.not_summable_one_div
  apply (e.toEquiv.summable_iff).mp
  change Summable f
  have hK' : (0 : ℝ) < K := by positivity
  apply summable_of_ratio_norm_eventually_le (r := ((K : ℝ) - 1) / K)
    ((div_lt_iff₀ hK').mpr (by linarith))
  rw [Filter.eventually_atTop]
  refine ⟨K, fun i hi => ?_⟩
  have hmono : StrictMono (fun j => (e j).val) := fun a b h => e.strictMono h
  have hpq := hmono (Nat.lt_succ_self i)
  have hgap := H (e i).val (e (i+1)).val (e i).property (e (i+1)).property
    (hi.trans (hmono.id_le i)) hpq
  have P : (0 : ℝ) < (e i).val := by exact_mod_cast (e i).property.pos
  have Q : (0 : ℝ) < (e (i+1)).val := by exact_mod_cast (e (i+1)).property.pos
  have G : (K : ℝ) * (e i).val + (e (i+1)).val ≤ K * ((e (i+1)).val : ℝ) := by
    exact_mod_cast hgap
  simp only [f, Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr P),
    abs_of_pos (one_div_pos.mpr Q)]
  field_simp
  nlinarith only [G]

/-- Products of powers of p and q eventually leave no multiplicative gap
wider than q/p. -/
theorem smooth_approx {p q : ℕ} (hp : 1 < p) (hpq : p < q) :
    ∃ N : ℕ, ∀ n ≥ N, ∃ a b : ℕ,
      p ^ a * q ^ b < n ∧ p * n ≤ q * (p ^ a * q ^ b) := by
  have hpR : (0 : ℝ) < p := by positivity
  have hr : 1 < (q : ℝ) / p := (one_lt_div hpR).mpr (by exact_mod_cast hpq)
  obtain ⟨K, hK⟩ := pow_unbounded_of_one_lt (p : ℝ) hr
  have hstart : p ^ (K+1) ≤ q ^ K := by
    rw [div_pow, lt_div_iff₀ (pow_pos hpR _)] at hK
    exact_mod_cast (show (p : ℝ) ^ (K+1) ≤ q ^ K by rw [pow_succ, mul_comm]; exact hK.le)
  have hcover (s : ℕ) (hs : K ≤ s) : p ^ (s+1) ≤ q ^ s := by
    obtain ⟨z, rfl⟩ := Nat.exists_eq_add_of_le hs
    rw [Nat.add_right_comm K z 1, pow_add p (K+1) z, pow_add q K z]
    exact Nat.mul_le_mul hstart (Nat.pow_le_pow_left hpq.le _)
  refine ⟨p ^ K + 1, fun n hn => ?_⟩
  have hpow : 0 < p ^ K := by positivity
  let s := Nat.log p (n - 1)
  have hs : K ≤ s := Nat.le_log_of_pow_le hp (by omega)
  have hlo : p ^ s < n := by
    have h := Nat.pow_log_le_self p (show n - 1 ≠ 0 by omega)
    dsimp [s]
    omega
  have hhi : n ≤ q ^ s := by
    have h := Nat.lt_pow_succ_log_self hp (n - 1)
    change n - 1 < p ^ (Nat.log p (n-1) + 1) at h
    exact le_trans (by change n ≤ p ^ (Nat.log p (n-1) + 1); omega) (hcover s hs)
  let F := fun i => p ^ (s - i) * q ^ i
  have hex : ∃ i, n ≤ F i := ⟨s, by simpa [F] using hhi⟩
  let j := Nat.find hex
  have hmin : n ≤ F j := Nat.find_spec hex
  have hj : j ≤ s := Nat.find_min' hex (by simpa [F] using hhi)
  have hj0 : j ≠ 0 := by
    intro hz
    simp [hz, F] at hmin
    omega
  obtain ⟨b, hb⟩ := Nat.exists_eq_succ_of_ne_zero hj0
  have hprev : F b < n := Nat.lt_of_not_ge (Nat.find_min hex (show b < j by omega))
  have hstep : p * F j = q * F b := by
    simp only [F, hb, pow_succ q]
    rw [show s - b = (s - b.succ) + 1 by omega, pow_succ]
    ring
  exact ⟨s-b, b, hprev, (Nat.mul_le_mul_left p hmin).trans_eq hstep⟩

theorem totient_smooth_lower {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (a b : ℕ) :
    ((p-1)*(q-1)) * (p^a*q^b) ≤ (p*q) * (p^a*q^b).totient := by
  have H (r : ℕ) (hr : r.Prime) (c : ℕ) : (r-1)*r^c ≤ r*(r^c).totient := by
    cases c with
    | zero => simp
    | succ k =>
      rw [Nat.totient_prime_pow_succ hr, pow_succ]
      exact le_of_eq (by ring)
  calc
    _ = ((p-1)*p^a) * ((q-1)*q^b) := by ring
    _ ≤ (p*(p^a).totient) * (q*(q^b).totient) := Nat.mul_le_mul (H _ hp _) (H _ hq _)
    _ = (p*q) * ((p^a).totient * (q^b).totient) := by ring
    _ ≤ _ := Nat.mul_le_mul_left _ (Nat.totient_super_multiplicative _ _)

/-- The totient of a record is eventually greater than (1 - 1/d) times its index.
The witness below each large index can be chosen with at most two prime factors. -/
theorem record_relative_lower (d : ℕ) (hd : 0 < d) :
    ∃ N : ℕ, ∀ n ≥ N, IsTerm n → (d-1)*n < d*n.totient := by
  obtain ⟨p, q, hp, hq, hlarge, hpq, hclose⟩ := exists_close_primes (4*d) (by omega)
  have shift : q - p + p = q := Nat.sub_add_cancel hpq.le
  have multshift := congrArg ((4*d)*·) shift
  have hmargin : d*(q-p+2) < q := by
    nlinarith only [multshift, hlarge, hpq, hclose]
  have split : q = (q-p+1) + (p-1) := by have := hp.pos; omega
  have Qsplit : q = (q-1)+1 := by have := hq.pos; omega
  have Esplit := congrArg (· * q) split
  have Eprod := congrArg ((p-1) * ·) Qsplit
  have hu : q*q ≤ (q-p+2)*q + (p-1)*(q-1) := by
    nlinarith only [Esplit, Eprod, hpq, Nat.sub_le p 1]
  have ds : (d-1) + 1 = d := Nat.sub_add_cancel hd
  have ds' := congrArg (· * (q*q)) ds
  have coeff : ((d-1)*q)*q < d*((p-1)*(q-1)) := by
    nlinarith only [ds', Nat.mul_lt_mul_of_pos_right hmargin hq.pos, Nat.mul_le_mul_left d hu]
  obtain ⟨N, hN⟩ := smooth_approx hp.one_lt hpq
  refine ⟨N, fun n hn hrec => ?_⟩
  obtain ⟨a,b, hlt, hnear⟩ := hN n hn
  let x := p^a*q^b
  have hx : 0 < x := by dsimp [x]; exact Nat.mul_pos (Nat.pow_pos hp.pos) (Nat.pow_pos hq.pos)
  have htt : (p-1)*(q-1)*x ≤ (p*q)*x.totient := totient_smooth_lower hp hq a b
  have hh : (p*q)*((d-1)*n) < (p*q)*(d*x.totient) := calc
    _ = ((d-1)*q)*(p*n) := by ring
    _ ≤ ((d-1)*q)*(q*x) := Nat.mul_le_mul_left _ hnear
    _ = (((d-1)*q)*q)*x := by ring
    _ < (d*((p-1)*(q-1)))*x := Nat.mul_lt_mul_of_pos_right coeff hx
    _ = d*((p-1)*(q-1)*x) := by ring
    _ ≤ d*((p*q)*x.totient) := Nat.mul_le_mul_left d htt
    _ = _ := by ring
  exact (Nat.lt_of_mul_lt_mul_left hh).trans_le (Nat.mul_le_mul_left d (hrec x hx hlt))

/-- For every fixed nontrivial divisor, only finitely many multiples are totient records. -/
theorem fixed_divisor_eventually {d : ℕ} (hd : 1 < d) :
    ∃ N : ℕ, ∀ n ≥ N, d ∣ n → ¬ IsTerm n := by
  obtain ⟨N, hN⟩ := record_relative_lower d (by omega)
  refine ⟨N, fun n hn hdiv hrec => ?_⟩
  obtain ⟨m, he⟩ := hdiv
  have hphi := Nat.totient_lt d hd
  have hbound : n.totient ≤ m * (d-1) := calc
    _ = (m*d).totient := by rw [he, mul_comm]
    _ ≤ m * d.totient := totient_mul_le d m
    _ ≤ _ := Nat.mul_le_mul_left _ (by omega)
  have hrec' := hN n hn hrec
  have hh : d*n.totient ≤ (d-1)*n := calc
    _ ≤ d*(m*(d-1)) := Nat.mul_le_mul_left d hbound
    _ = _ := by rw [he]; ring
  omega

/-- Uniformly in all nontrivial divisors up to B. -/
theorem record_eventually_rough (B : ℕ) :
    ∃ N : ℕ, ∀ n ≥ N, IsTerm n → ∀ d : ℕ, 1 < d → d ∣ n → B < d := by
  by_cases hB : 0 < B
  · obtain ⟨N, hN⟩ := record_relative_lower B hB
    refine ⟨N, fun n hn hrec d hd hdiv => ?_⟩
    by_contra! hdB
    obtain ⟨m, he⟩ := hdiv
    have hphi := Nat.totient_lt d hd
    have hbound : n.totient ≤ m * (d-1) := calc
      _ = (m*d).totient := by rw [he, mul_comm]
      _ ≤ m * d.totient := totient_mul_le d m
      _ ≤ _ := Nat.mul_le_mul_left _ (by omega)
    have prod : B*(d-1) ≤ (B-1)*d := by
      have hd' := congrArg (B*·) (Nat.sub_add_cancel (by omega : 1 ≤ d))
      have hB' := congrArg (· * d) (Nat.sub_add_cancel hB)
      nlinarith only [hd', hB', hdB]
    have contra : B*n.totient ≤ (B-1)*n := calc
      _ ≤ B*(m*(d-1)) := Nat.mul_le_mul_left _ hbound
      _ = (B*(d-1))*m := by ring
      _ ≤ ((B-1)*d)*m := Nat.mul_le_mul_right _ prod
      _ = _ := by rw [he]; ring
    exact (hN n hn hrec).not_ge contra
  · exact ⟨0, fun _ _ _ _ hd _ => by omega⟩

/-- An effective exclusion when the totient of the fixed divisor is small enough. -/
theorem bertrand_excludes_multiple (d m : ℕ) (h : 2*(m*d.totient+1) < m*d) :
    ¬ IsTerm (m*d) := by
  obtain ⟨r, hr, hlo, hhi⟩ := Nat.exists_prime_lt_and_le_two_mul (m*d.totient+1) (by omega)
  intro hrec
  have hcomp := hrec r hr.pos (hhi.trans_lt h)
  rw [Nat.totient_prime hr] at hcomp
  have hbound := totient_mul_le d m
  omega

theorem not_record_multiple_105 (m : ℕ) (hm : 0 < m) : ¬ IsTerm (m*105) := by
  apply bertrand_excludes_multiple
  rw [show Nat.totient 105 = 48 by decide]
  omega

