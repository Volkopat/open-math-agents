/-- Scale an integer into the fixed band [T, PT) by a power of P. -/
theorem scale_band (P T : ℕ) (hP : 1 < P) :
    ∀ n : ℕ, T ≤ n → 0 < T → ∃ a t : ℕ, T ≤ t ∧ t < P*T ∧
        P^a*t ≤ n ∧ n < P^a*(t+1) := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn hT
    by_cases hsmall : n < P*T
    · exact ⟨0, n, hn, hsmall, by simp, by simp⟩
    have hP0 : 0 < P := by omega
    have hband : T ≤ n/P := (Nat.le_div_iff_mul_le hP0).mpr (by simpa [mul_comm] using le_of_not_gt hsmall)
    obtain ⟨a,t,hTt,ht,lo,hi⟩ := ih (n/P) (Nat.div_lt_self (by omega) hP) hband hT
    refine ⟨a+1,t,hTt,ht,?_,?_⟩
    · simpa only [pow_succ, mul_assoc, mul_left_comm, mul_comm] using
        (Nat.le_div_iff_mul_le hP0).mp lo
    · simpa only [pow_succ, mul_assoc, mul_left_comm, mul_comm] using
        (Nat.div_lt_iff_lt_mul hP0).mp hi

/-- The finite prime-gap check on one band suffices for all indices beyond its start. -/
theorem scaled_record_relative_1200
    (cover : ∀ t : ℕ, 14 ≤ t → t ≤ 64000000000 →
      ∃ r : ℕ, r.Prime ∧ r < t ∧ (t-r+2)^2 < 4*t)
    {n : ℕ} (hn : 15000000 ≤ n) (rec : IsTerm n) :
    1199 * n < 1200 * n.totient := by
  obtain ⟨a,t,ht,hup,hlo,hhi⟩ := scale_band 4001 15000000 (by decide) n hn (by decide)
  obtain ⟨r,hr,hrt,hgap⟩ := cover t (by omega) (by omega)
  let g := t-r+2
  have hgap' : g*g < 4*t := by simpa [g, pow_two] using hgap
  have hshort : 1900*g < t := by
    by_contra! bad
    have H := Nat.mul_le_mul bad bad
    have H' := Nat.mul_lt_mul_of_pos_left hgap' (show 0 < 1900*1900 by decide)
    have H'' := Nat.mul_le_mul_right t (show 14440000 ≤ t by omega)
    nlinarith only [H, H', H'']
  have hprime : 1199*4001*(t+1) < 1200*4000*(r-1) := by
    have hr0 := hr.pos
    dsimp [g] at hshort
    omega
  let x := 4001^a*r
  have hx : 0 < x := by dsimp [x]; exact Nat.mul_pos (by positivity) hr.pos
  have hxn : x < n := (Nat.mul_lt_mul_of_pos_left hrt (by positivity : 0 < 4001^a)).trans_le hlo
  have hp : Nat.Prime 4001 := by norm_num
  have hpp : 4000 * 4001^a ≤ 4001 * (4001^a).totient := by
    cases a with
    | zero => decide
    | succ b =>
      rw [Nat.totient_prime_pow_succ hp b, pow_succ]
      norm_num
      exact le_of_eq (by ring)
  have hprod : 4000*4001^a*(r-1) ≤ 4001*x.totient := calc
    _ ≤ 4001*(4001^a).totient*(r-1) := Nat.mul_le_mul_right _ hpp
    _ = 4001*((4001^a).totient*r.totient) := by rw [Nat.totient_prime hr]; ring
    _ ≤ _ := Nat.mul_le_mul_left _ (Nat.totient_super_multiplicative _ _)
  have hs : 4001*(1199*n) < 4001*(1200*x.totient) := calc
    _ < (1199*4001)*(4001^a*(t+1)) := by
      simpa only [mul_comm, mul_left_comm, mul_assoc] using Nat.mul_lt_mul_of_pos_left hhi
        (show 0 < 1199*4001 by decide)
    _ = (1199*4001*(t+1))*4001^a := by ring
    _ < (1200*4000*(r-1))*4001^a := Nat.mul_lt_mul_of_pos_right hprime (by positivity)
    _ = 1200*(4000*4001^a*(r-1)) := by ring
    _ ≤ 1200*(4001*x.totient) := Nat.mul_le_mul_left _ hprod
    _ = _ := by ring
  exact (Nat.lt_of_mul_lt_mul_left hs).trans_le (Nat.mul_le_mul_left _ (rec x hx hxn))

/-- Each nontrivial divisor of a record beyond the cutoff exceeds 1200. -/
theorem rough_1200
    (cover : ∀ t : ℕ, 14 ≤ t → t ≤ 64000000000 →
      ∃ r : ℕ, r.Prime ∧ r < t ∧ (t-r+2)^2 < 4*t)
    {n : ℕ} (hn : 15000000 ≤ n) (rec : IsTerm n) :
    ∀ d : ℕ, 1 < d → d ∣ n → 1200 < d := by
  intro d hd hdiv
  by_contra! hsmall
  obtain ⟨m, he⟩ := hdiv
  have hphi := Nat.totient_lt d hd
  have hbound : n.totient ≤ m * (d-1) := calc
    _ = (m*d).totient := by rw [he, mul_comm]
    _ ≤ m * d.totient := totient_mul_le d m
    _ ≤ _ := Nat.mul_le_mul_left _ (by omega)
  have ratio : 1200*(d-1) ≤ 1199*d := by omega
  have contra : 1200*n.totient ≤ 1199*n := calc
    _ ≤ 1200*(m*(d-1)) := Nat.mul_le_mul_left _ hbound
    _ = (1200*(d-1))*m := by ring
    _ ≤ (1199*d)*m := Nat.mul_le_mul_right _ ratio
    _ = _ := by rw [he]; ring
  exact (scaled_record_relative_1200 cover hn rec).not_ge contra

end A067126Deficit

