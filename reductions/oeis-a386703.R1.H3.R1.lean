/- Addition and shifting of nonnegative integers in a fixed radix, with explicit carry bounds. -/
namespace A386Table

lemma shift_digit (x B d n : ℕ) (hb : 0<B) :
    x*B^d / B^n % B = if d≤n then x/B^(n-d) % B else 0 := by
  split
  next h =>
    rw [show B^n=B^(n-d)*B^d by rw [←pow_add]; congr 1; omega,
      Nat.mul_div_mul_right x _ (Nat.pow_pos hb)]
  next h =>
    obtain ⟨l,rfl⟩ : ∃ l, d=n+1+l := ⟨d-(n+1),by omega⟩
    rw [show B^(n+1+l)=B^(l+1)*B^n by rw [←pow_add]; congr 1; omega,
      ←Nat.mul_assoc,Nat.mul_div_cancel _ (Nat.pow_pos hb),pow_succ,←Nat.mul_assoc,
      Nat.mul_mod_left]

end A386Table

/- Radix digits of the monomials in the doubled-exponent Euler polynomial. -/
namespace A386Table

lemma doubled_digits (terms : List (ℕ × ℤ)) (B n : ℕ) (hb : 1 < B) :
    (terms.map (fun z => z.2 * (((B^(2*z.1) / B^n % B : ℕ) : ℤ)))).sum =
      if n % 2 = 0 then (terms.map fun z => if z.1 ≤ n/2 then
        (if n/2-z.1=0 then (1:ℤ) else 0) * z.2 else 0).sum else 0 := by
  have mono (i : ℕ) : B^i / B^n % B = if i = n then 1 else 0 := by
    rcases lt_trichotomy i n with lt | rfl | gt
    · rw [Nat.div_eq_of_lt (Nat.pow_lt_pow_right hb lt),Nat.zero_mod,if_neg lt.ne]
    · rw [Nat.div_self (Nat.pow_pos (by omega)),Nat.mod_eq_of_lt hb,if_pos rfl]
    · obtain ⟨j,eq⟩ : ∃ j, i = j+1+n := ⟨i-(n+1),by omega⟩
      rw [if_neg gt.ne',eq,pow_add,Nat.mul_div_cancel _ (Nat.pow_pos (by omega)),pow_succ,Nat.mul_mod_left]
  simp_rw [mono]
  split_ifs with even
  · congr 1
    apply List.map_congr_left
    rintro ⟨i,a⟩ _
    change a * ((if 2*i=n then 1 else 0 : ℕ) : ℤ) =
      if i ≤ n/2 then (if n/2-i=0 then 1 else 0) * a else 0
    split_ifs <;> simp <;> omega
  · have no_match (i : ℕ) : 2*i ≠ n := by omega
    simp [no_match]

end A386Table

/- Signed radix sums below the radix have no carries when the packed total vanishes. -/

namespace A386Table

theorem packed_zeros (L : List (ℕ × ℤ)) (B N : ℕ) (hb : 0 < B)
    (div : (B : ℤ)^(N+1) ∣ (L.map (fun z => z.2 * (z.1 : ℤ))).sum)
    (bound : ∀ i ≤ N, |(L.map (fun z => z.2 * ((z.1 / B^i % B : ℕ) : ℤ))).sum| < (B : ℤ)) :
    ∀ i ≤ N, (L.map (fun z => z.2 * ((z.1 / B^i % B : ℕ) : ℤ))).sum = 0 := by
  let value (T : List (ℕ × ℤ)) := (T.map (fun z => z.2 * (z.1 : ℤ))).sum
  let digit (i : ℕ) (T : List (ℕ × ℤ)) :=
    (T.map (fun z => z.2 * ((z.1 / B^i % B : ℕ) : ℤ))).sum
  let lower (T : List (ℕ × ℤ)) := T.map (fun z => (z.1 / B, z.2))
  have split (T : List (ℕ × ℤ)) : value T = digit 0 T + B * value (lower T) := by
    induction T with
    | nil => simp [value, digit, lower]
    | cons z T ih =>
      have part : (z.1 : ℤ) = (z.1 % B : ℕ) + (B : ℤ)*(z.1 / B : ℕ) := by
        exact_mod_cast (Nat.mod_add_div z.1 B).symm
      change z.2 * (z.1 : ℤ) + value T =
        (z.2 * ((z.1 / B^0 % B : ℕ) : ℤ) + digit 0 T) +
        B * (z.2 * ((z.1 / B : ℕ) : ℤ) + value (lower T))
      simp only [pow_zero, Nat.div_one, ih]
      linear_combination z.2 * part
  have shifted (T : List (ℕ × ℤ)) (i : ℕ) : digit i (lower T) = digit (i+1) T := by
    simp only [digit, lower, List.map_map, Function.comp_def, Nat.div_div_eq_div_mul, pow_succ']
  have strip {T : List (ℕ × ℤ)} {m : ℕ} (h : (B : ℤ)^(m+1) ∣ value T)
      (small : |digit 0 T| < (B : ℤ)) : digit 0 T = 0 ∧ (B : ℤ)^m ∣ value (lower T) := by
    obtain ⟨t, ht⟩ := h
    have d : (B : ℤ) ∣ digit 0 T := by
      refine ⟨(B : ℤ)^m*t - value (lower T), ?_⟩
      rw [pow_succ'] at ht
      linear_combination ht - split T
    have zero : digit 0 T = 0 := by
      apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs d
      rw [← Int.ofNat_lt, Int.natCast_natAbs, Int.natCast_natAbs, abs_of_nonneg (by positivity : (0:ℤ) ≤ B)]
      exact small
    refine ⟨zero, t, ?_⟩
    apply mul_left_cancel₀ (show (B : ℤ) ≠ 0 by exact_mod_cast hb.ne')
    rw [pow_succ'] at ht
    rw [split T, zero, zero_add] at ht
    linear_combination ht
  change (B : ℤ)^(N+1) ∣ value L at div
  change ∀ i ≤ N, |digit i L| < (B : ℤ) at bound
  change ∀ i ≤ N, digit i L = 0
  induction N generalizing L with
  | zero =>
    intro i hi
    obtain rfl : i = 0 := by omega
    exact (strip div (bound 0 (by omega))).1
  | succ N ih =>
    obtain ⟨zero, rest⟩ := strip div (bound 0 (by omega))
    intro i hi
    cases i with
    | zero => exact zero
    | succ i =>
      rw [← shifted]
      exact ih (lower L) rest (fun j hj => by rw [shifted]; exact bound _ (by omega)) _ (by omega)

end A386Table

namespace A386Table
open OMA.S_oeis_a386703

lemma signed_row (T : List (ℕ × ℤ)) (X B n : ℕ) (hb : 0<B) :
    (T.map (fun z => z.2 * ((X*B^z.1 / B^n % B : ℕ) : ℤ))).sum =
      (T.map fun z => if z.1 ≤ n then ((X / B^(n-z.1) % B : ℕ) : ℤ) * z.2 else 0).sum := by
  congr 1
  apply List.map_congr_left
  intro z _
  rw [shift_digit _ _ _ _ hb]
  split <;> simp_all [mul_comm]

lemma sum_magnitude (L : List (ℕ × ℤ)) (B i m : ℕ)
    (h : ∀ z ∈ L, z.1 / B^i % B ≤ m ∧ |z.2| ≤ 1) :
    |(L.map (fun z => z.2 * ((z.1 / B^i % B : ℕ) : ℤ))).sum| ≤ (L.length : ℤ)*m := by
  induction L with
  | nil => simp
  | cons z zs ih =>
    obtain ⟨hz,hw⟩ := h z (by simp)
    have ht := ih (fun x hx => h x (List.mem_cons_of_mem _ hx))
    simp only [List.map_cons,List.sum_cons,List.length_cons,Nat.cast_add,Nat.cast_one]
    apply (abs_add_le _ _).trans
    rw [abs_mul,abs_of_nonneg (by positivity : (0 : ℤ) ≤ (z.1 / B^i % B : ℕ))]
    have hz' : ((z.1 / B^i % B : ℕ) : ℤ) ≤ m := by exact_mod_cast hz
    nlinarith [mul_le_mul_of_nonneg_right hw (by positivity : (0 : ℤ) ≤ (z.1 / B^i % B : ℕ))]

lemma packed_rows (T : List (ℕ × ℤ)) (N B X m : ℕ) (hb : 1 < B) (hm : 0 < m)
    (size : (2*T.length + 4)*m < B)
    (weights : ∀ z ∈ T, |z.2| ≤ 1)
    (caps : ∀ i ≤ N, X / B^i % B ≤ m) (double : Bool) :
    let full := (0,(1:ℤ)) :: T
    let shifts := full.map (fun z => (X*B^z.1,z.2))
    let rest := if double then full.map (fun z => (B^(2*z.1),-z.2)) else [(1,(-1:ℤ))]
    let L := shifts ++ rest
    ((B:ℤ)^(N+1) ∣ (L.map (fun z => z.2*(z.1:ℤ))).sum) →
    let value (n : ℕ) : ℤ := (X/B^n % B : ℕ)
    let row (f : ℕ → ℤ) (n : ℕ) := f n + (T.map fun z => if z.1 ≤ n then f (n-z.1)*z.2 else 0).sum
    let delta (n : ℕ) : ℤ := if n=0 then 1 else 0
    ∀ n ≤ N, row value n = (if double then (if n%2=0 then row delta (n/2) else 0) else delta n) := by
  intro full shifts rest L div value row delta
  have wfull : ∀ z ∈ full, |z.2| ≤ 1 := by
    intro z hz
    rcases List.mem_cons.mp hz with rfl|h
    · norm_num
    · exact weights _ h
  have length : L.length ≤ 2*T.length+4 := by
    cases double <;> simp [L,shifts,rest,full] <;> omega
  have dp (j : ℕ) (i : ℕ) : B^j / B^i % B ≤ 1 := by
    have h := shift_digit 1 B j i (by omega)
    rw [one_mul] at h
    rw [h]
    split
    · exact (Nat.mod_le _ _).trans (Nat.div_le_self _ _)
    · omega
  have van := packed_zeros L B N (by omega) div (by
    intro i hi
    apply (sum_magnitude L B i m ?_).trans_lt
    · exact_mod_cast (Nat.mul_le_mul_right m length).trans_lt size
    · intro z hz
      rcases List.mem_append.mp hz with h|h
      · obtain ⟨a,ha,rfl⟩ := List.mem_map.mp h
        dsimp
        rw [shift_digit _ _ _ _ (by omega)]
        refine ⟨?_,wfull _ ha⟩
        split
        · exact caps _ (by omega)
        · omega
      · cases hd : double with
        | false =>
          simp [rest,hd] at h
          subst z
          exact ⟨by simpa using (dp 0 i).trans (show 1 ≤ m by omega),by norm_num⟩
        | true =>
          simp only [rest,hd,if_true,List.mem_map] at h
          obtain ⟨a,ha,rfl⟩ := h
          exact ⟨(dp _ i).trans (by omega), by simpa using wfull a ha⟩)
  intro n hn
  have hh := van n hn
  change (((shifts ++ rest).map _).sum : ℤ) = 0 at hh
  rw [List.map_append,List.sum_append] at hh
  have main : (shifts.map (fun z => z.2 * ((z.1 / B^n % B : ℕ) : ℤ))).sum = row value n := by
    simp only [shifts,List.map_map,Function.comp_def]
    rw [signed_row full X B n (by omega)]
    simp [full,row,value]
  rw [main] at hh
  cases hd : double with
  | false =>
    simp only [rest,hd,Bool.false_eq_true,if_false,List.map_cons,List.map_nil,List.sum_cons,
      List.sum_nil,add_zero,neg_one_mul] at hh ⊢
    have one : 1 / B^n % B = (if n=0 then 1 else 0) := by
      cases n with
      | zero => simp [Nat.mod_eq_of_lt hb]
      | succ n =>
        have h : 1 < B^(n+1) := Nat.one_lt_pow (by omega) hb
        simp [Nat.div_eq_of_lt h]
    rw [one] at hh
    split at hh <;> simp_all [delta] <;> omega
  | true =>
    simp only [rest,hd,if_true,List.map_map,Function.comp_def,neg_mul] at hh
    have negsum (xs : List (ℕ × ℤ)) :
        (xs.map fun z => -(z.2 * ((B^(2*z.1) / B^n % B : ℕ) : ℤ))).sum =
          -(xs.map fun z => z.2 * ((B^(2*z.1) / B^n % B : ℕ) : ℤ)).sum := by
      induction xs with
      | nil => simp
      | cons z xs ih =>
        simp only [List.map_cons,List.sum_cons,ih]
        abel
    rw [negsum,doubled_digits full B n hb] at hh
    simp only [if_true]
    by_cases he : n%2=0
    · simp [he,full,row,delta] at hh ⊢
      omega
    · simp [he] at hh ⊢
      exact hh
end A386Table

namespace A386Table
lemma scan_at (B D : ℕ) (f : ℕ → ℕ → ℕ → Bool) :
    let scan : ℕ → ℕ → ℕ → ℕ → Bool := Nat.rec (fun _ _ _ => true)
      (fun _ next a x y => f a (x%B) (y%D) && next (a+1) (x/B) (y/D))
    ∀ a len x y n, scan len a (x/B^a) (y/D^a) = true → a ≤ n → n < a+len →
      f n (x/B^n%B) (y/D^n%D) = true := by
  intro scan a len
  induction len generalizing a with
  | zero => omega
  | succ len ih =>
    intro x y n h lo hi
    change (f a (x/B^a%B) (y/D^a%D) && scan len (a+1) (x/B^a/B) (y/D^a/D)) = true at h
    simp only [Bool.and_eq_true] at h
    have hs := h
    by_cases eq : n=a
    · subst n; exact hs.1
    · apply ih (a+1) x y n ?_ (by omega) (by omega)
      simpa only [Nat.div_div_eq_div_mul,pow_succ] using hs.2
end A386Table

