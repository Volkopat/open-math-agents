import OMAReductions.R_oeis_a386703_R1

/-! The positive-one residue for unrestricted partitions modulo distinct partitions.
An integral Euler product supplies the finite certificate. The expansion modulo
four identifies the possible residue two with an odd count of representations
by a pentagonal number plus a positive square. The divisor-count implication
in Merca, Theorem 7 (doi:10.2478/auom-2022-0040), is isolated in H1. -/

/- The integral partition inverse adapts the coefficient argument of @LordMike
in the project proof of PartitionParity.kolberg. -/
namespace A386Series
open PowerSeries PowerSeries.WithPiTopology Finset OMA.S_oeis_a386703

theorem prod_eq_one :
    (PowerSeries.mk fun n => (p n : ℤ)) * pentagonalSeries ℤ = 1 := by
  have h1 : (PowerSeries.mk fun n => (p n : ℤ)) =
      ∏' i, ∑' j : ℕ, (X ^ ((i + 1) * j) : ℤ⟦X⟧) := by
    have := Nat.Partition.powerSeriesMk_card_restricted_eq_tprod ℤ (fun _ => True)
    simpa [Nat.Partition.restricted, p] using this
  have hm : Multipliable (fun i : ℕ => ∑' j : ℕ, (X ^ ((i + 1) * j) : ℤ⟦X⟧)) := by
    simpa using Nat.Partition.multipliable_powerSeriesMk_card_restricted ℤ (fun _ => True)
  rw [← tprod_one_sub_X_pow, h1, ← hm.tprod_mul (multipliable_one_sub_X_pow _)]
  have h2 : ∀ i : ℕ, (∑' j : ℕ, (X ^ ((i + 1) * j) : ℤ⟦X⟧)) * (1 - X ^ (i + 1)) = 1 := by
    intro i
    have := tsum_pow_mul_one_sub_of_constantCoeff_eq_zero (R := ℤ)
      (f := (X ^ (i+1) : ℤ⟦X⟧)) (by simp)
    simpa [pow_mul] using this
  simp_rw [h2]
  exact tprod_one


theorem expanded_product :
    (PowerSeries.mk fun n => (q n : ℤ)) * pentagonalSeries ℤ =
      (pentagonalSeries ℤ).expand 2 (by decide) := by
  let e := PowerSeries.expand (R := ℤ) 2 (by decide)
  have cont : Continuous e := by
    rw [continuous_iff_continuousAt]
    intro x
    apply (tendsto_iff_coeff_tendsto ℤ _ _ _).mpr
    intro d
    change Filter.Tendsto (fun z : ℤ⟦X⟧ => (z.expand 2 (by decide)).coeff d) _
      (nhds ((x.expand 2 (by decide)).coeff d))
    simp only [PowerSeries.coeff_expand]
    split
    · exact (continuous_coeff ℤ _).continuousAt
    · exact tendsto_const_nhds
  have hp := Nat.Partition.hasProd_powerSeriesMk_card_countRestricted ℤ (m := 2) (by decide)
  simp_rw [Nat.Partition.countRestricted_two] at hp
  have he := hasProd_one_sub_X_pow ℤ
  have prod := hp.mul he
  have exp := he.map e.toMonoidHom cont
  apply prod.unique
  apply exp.congr_fun
  intro i
  change (∑ j ∈ range 2, (X : ℤ⟦X⟧)^((i+1)*j)) * (1-X^(i+1)) =
    e (1 - X^(i+1))
  simp only [sum_range_succ,sum_range_zero,zero_add,mul_zero,pow_zero,mul_one,
    e,map_sub,map_one,map_pow,expand_X]
  ring

theorem p_convolution (n : ℕ) :
    (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, (p ij.1 : ℤ) * (pentagonalSeries ℤ).coeff ij.2) =
      (if n = 0 then 1 else 0) := by
  have h := congrArg (fun f : ℤ⟦X⟧ => f.coeff n) prod_eq_one
  simpa only [coeff_mul,coeff_mk,coeff_one] using h

theorem q_convolution (n : ℕ) :
    (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, (q ij.1 : ℤ) * (pentagonalSeries ℤ).coeff ij.2) =
      (if n % 2 = 0 then (pentagonalSeries ℤ).coeff (n/2) else 0) := by
  have h := congrArg (fun f : ℤ⟦X⟧ => f.coeff n) expanded_product
  simpa only [coeff_mul,coeff_mk,coeff_expand,Nat.dvd_iff_mod_eq_zero] using h

end A386Series

/- A first-order Euler-product expansion for distinct partitions modulo four. -/

open Filter Finset PowerSeries PowerSeries.WithPiTopology
open OMA.S_oeis_a386703
open scoped BigOperators Topology

namespace PartitionModFour

private theorem single_factor (k : ℕ) (hk : 0 < k) :
    (1 - (X : (ZMod 4)⟦X⟧)^k) *
      (1 + 2 * PowerSeries.mk (fun n => if n ≠ 0 ∧ k ∣ n then (1 : ZMod 4) else 0)) =
      1 + X^k := by
  let D := PowerSeries.mk (fun n => if n ≠ 0 ∧ k ∣ n then (1 : ZMod 4) else 0)
  have h : (1 - (X : (ZMod 4)⟦X⟧)^k) * D = X^k := by
    ext n
    rw [sub_mul, one_mul, map_sub, PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_X_pow]
    simp only [D, PowerSeries.coeff_mk]
    rcases lt_trichotomy n k with hlt | rfl | hgt
    · have hn : ¬ (n ≠ 0 ∧ k ∣ n) := fun ⟨h, d⟩ => (not_le_of_gt hlt) (Nat.le_of_dvd (by omega) d)
      simp [hn, hlt.ne, not_le.mpr hlt]
    · simp [hk.ne']
    · have hd : k ∣ n - k ↔ k ∣ n := Nat.dvd_sub_iff_left (Nat.le_of_lt hgt) (dvd_refl k)
      simp [Nat.ne_of_gt (show n > 0 by omega), (show n - k ≠ 0 by omega), hd, hgt.le, Ne.symm hgt.ne]
  change (1 - X^k) * (1 + 2 * D) = 1 + X^k
  linear_combination 2 * h

private theorem truncated (s : Finset ℕ) :
    (∏ i ∈ s, (1 + (X : (ZMod 4)⟦X⟧)^(i+1))) =
      (∏ i ∈ s, (1 - X^(i+1))) *
      (1 + 2 * ∑ i ∈ s, PowerSeries.mk
        (fun n => if n ≠ 0 ∧ i+1 ∣ n then (1 : ZMod 4) else 0)) := by
  classical
  let D (i : ℕ) := PowerSeries.mk (fun n => if n ≠ 0 ∧ i+1 ∣ n then (1 : ZMod 4) else 0)
  change _ = _ * (1 + 2 * ∑ i ∈ s, D i)
  have zero4 : (4 : (ZMod 4)⟦X⟧) = 0 := by
    have e : (4 : ZMod 4) = 0 := by decide
    calc (4 : (ZMod 4)⟦X⟧) = PowerSeries.C (4 : ZMod 4) := (map_ofNat _ _).symm
         _ = 0 := by rw [e, map_zero]
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [prod_insert hi, prod_insert hi, sum_insert hi, ih, ← single_factor (i+1) (by omega)]
    change ((1 - X^(i+1)) * (1 + 2 * D i)) * _ = _
    linear_combination ((1-X^(i+1)) * (∏ j ∈ s, (1-X^(j+1))) * D i * (∑ j ∈ s, D j)) * zero4

private theorem divisor_hasSum [TopologicalSpace (ZMod 4)] [DiscreteTopology (ZMod 4)] :
    HasSum (fun i : ℕ => PowerSeries.mk
      (fun n => if n ≠ 0 ∧ i+1 ∣ n then (1 : ZMod 4) else 0))
      (PowerSeries.mk (fun n => (n.divisors.card : ZMod 4))) := by
  classical
  rw [HasSum, tendsto_iff_coeff_tendsto]
  intro n
  apply tendsto_nhds_of_eventually_eq
  filter_upwards [eventually_ge_atTop (n.divisors.image Nat.pred)] with s hs
  rw [map_sum]
  simp only [PowerSeries.coeff_mk]
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_one]
  congr 1
  apply Finset.card_nbij' Nat.succ Nat.pred
  · intro i hi
    obtain ⟨_, hn, hd⟩ := Finset.mem_filter.mp hi
    exact Nat.mem_divisors.mpr ⟨hd, hn⟩
  · intro i hi
    obtain ⟨hd, hn⟩ := Nat.mem_divisors.mp hi
    have pos := Nat.pos_of_mem_divisors hi
    exact Finset.mem_filter.mpr ⟨hs (Finset.mem_image_of_mem _ hi), hn, by change i.pred.succ ∣ n; rwa [Nat.succ_pred_eq_of_pos pos]⟩
  · intro i _
    simp
  · intro i hi
    exact Nat.succ_pred_eq_of_pos (Nat.pos_of_mem_divisors hi)

theorem strict_series_mod_four :
    PowerSeries.mk (fun n => (q n : ZMod 4)) = pentagonalSeries (ZMod 4) *
      (1 + 2 * PowerSeries.mk (fun n => (n.divisors.card : ZMod 4))) := by
  let : TopologicalSpace (ZMod 4) := ⊥
  let : DiscreteTopology (ZMod 4) := ⟨rfl⟩
  have hp := Nat.Partition.hasProd_powerSeriesMk_card_countRestricted (ZMod 4) (m := 2) (by decide)
  simp_rw [Nat.Partition.countRestricted_two] at hp
  have factor (i : ℕ) : (∑ j ∈ range 2, (X : (ZMod 4)⟦X⟧)^((i+1)*j)) = 1 + X^(i+1) := by
    rw [Finset.sum_range_succ, Finset.sum_range_one]
    simp
  simp_rw [factor] at hp
  have he := hasProd_one_sub_X_pow (ZMod 4)
  have hd := divisor_hasSum
  change Tendsto _ _ _ at he hd hp
  have hlim := he.mul ((tendsto_const_nhds (x := (1 : (ZMod 4)⟦X⟧))).add
    ((tendsto_const_nhds (x := (2 : (ZMod 4)⟦X⟧))).mul hd))
  apply tendsto_nhds_unique hp
  exact hlim.congr (fun s => (truncated s).symm)



theorem twice_divisor_card (n : ℕ) :
    2 * (n.divisors.card : ZMod 4) = if n ≠ 0 ∧ IsSquare n then 2 else 0 := by
  classical
  let D := n.divisorsAntidiagonal
  let diag := D.filter (fun x => x.1 = x.2)
  let off := D.filter (fun x => ¬x.1 = x.2)
  have hc : n.divisors.card = diag.card + off.card := by
    dsimp [diag,off,D]
    rw [Finset.card_filter_add_card_filter_not, ← Nat.map_div_right_divisors, Finset.card_map]
  have cancel : (∑ _ ∈ off, (2 : ZMod 4)) = 0 := by
    have sw (x : ℕ × ℕ) (hx : x ∈ off) : x.swap ∈ off := by
      obtain ⟨hD, hne⟩ := mem_filter.mp hx
      exact mem_filter.mpr ⟨Nat.swap_mem_divisorsAntidiagonal.mpr hD, Ne.symm hne⟩
    refine Finset.sum_involution (fun x _ => x.swap) ?_ ?_ sw (fun _ _ => rfl)
    · intro _ _
      decide
    · intro x hx _ e
      exact (mem_filter.mp hx).2 (congrArg Prod.fst e).symm
  have hoff : (2 : ZMod 4) * (off.card : ZMod 4) = 0 := by
    simpa [Finset.sum_const, nsmul_eq_mul, mul_comm] using cancel
  rw [hc, Nat.cast_add, mul_add, hoff, add_zero]
  split_ifs with h
  · obtain ⟨hn, a, ha⟩ := h
    have he : diag = {(a,a)} := by
      ext ⟨x,y⟩
      simp only [diag, D, mem_filter, Nat.mem_divisorsAntidiagonal, mem_singleton,
        Prod.mk.injEq]
      constructor
      · rintro ⟨e, rfl⟩
        have hxa : x = a := Nat.pow_left_injective (by decide : 2 ≠ 0) (by simpa [pow_two, ha] using e.1)
        exact ⟨hxa,hxa⟩
      · rintro ⟨rfl, rfl⟩
        exact ⟨⟨ha.symm, hn⟩, rfl⟩
    simp [he]
  · have he : diag = ∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      rintro ⟨x,y⟩ hx
      obtain ⟨hxy, heq⟩ := mem_filter.mp hx
      change x = y at heq
      subst y
      obtain ⟨e, hn⟩ := Nat.mem_divisorsAntidiagonal.mp hxy
      exact h ⟨hn, x, e.symm⟩
    simp [he]


theorem strict_coeff_mod_four (n : ℕ) :
    (q n : ZMod 4) = (pentagonalSeries (ZMod 4)).coeff n +
      2 * ∑ j ∈ Icc 1 n.sqrt, (pentagonalSeries (ZMod 4)).coeff (n-j^2) := by
  classical
  let E := pentagonalSeries (ZMod 4)
  let D := PowerSeries.mk (fun k : ℕ => (k.divisors.card : ZMod 4))
  have h := congrArg (PowerSeries.coeff n) strict_series_mod_four
  rw [PowerSeries.coeff_mk] at h
  change (q n : ZMod 4) = PowerSeries.coeff n (E * (1 + 2 * D)) at h
  rw [mul_add, mul_one, (show E*(2*D) = 2*(D*E) by ring), two_mul, map_add, map_add,
    PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk] at h
  change (q n : ZMod 4) = E.coeff n + 2 * _
  rw [h, ← two_mul, Finset.mul_sum, Finset.mul_sum]
  congr 1
  let F := (range (n+1)).filter (fun k => k ≠ 0 ∧ IsSquare k)
  have step : (∑ k ∈ range (n+1), 2 * ((k.divisors.card : ZMod 4) * E.coeff (n-k))) =
      ∑ k ∈ F, 2 * E.coeff (n-k) := by
    dsimp [F]
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro k _
    rw [← mul_assoc, twice_divisor_card]
    split_ifs <;> simp
  simp only [D, PowerSeries.coeff_mk]
  change (∑ k ∈ range (n+1), 2 * ((k.divisors.card : ZMod 4) * E.coeff (n-k))) = _
  rw [step]
  have him : F = (Icc 1 n.sqrt).image (fun j => j^2) := by
    ext k
    constructor
    · intro hk
      obtain ⟨hr, hn, j, hj⟩ := mem_filter.mp hk
      have hr' := mem_range.mp hr
      refine mem_image.mpr ⟨j, mem_Icc.mpr ⟨?_, ?_⟩, by simpa [pow_two] using hj.symm⟩
      · by_contra! hz
        have : j = 0 := by omega
        simp [this] at hj
        exact hn hj
      · exact Nat.le_sqrt.mpr (by omega)
    · intro hk
      obtain ⟨j,hj,rfl⟩ := mem_image.mp hk
      obtain ⟨hpos,hs⟩ := mem_Icc.mp hj
      exact mem_filter.mpr ⟨mem_range.mpr (by have := Nat.le_sqrt'.mp hs; omega),
        pow_ne_zero _ (by omega), j, pow_two j⟩
  rw [him, Finset.sum_image]
  exact fun _ _ _ _ e => Nat.pow_left_injective (by decide : 2 ≠ 0) e

/-- The finite representation count determines the mod-four residue at a nonpentagonal index. -/
theorem nonpentagonal_residue (n : ℕ) (hn : ¬ IsSquare (24*n+1)) :
    q n % 4 = (2 * ((Icc 1 n.sqrt).filter
      (fun j => IsSquare (24*(n-j^2)+1))).card) % 4 := by
  classical
  let E := pentagonalSeries (ZMod 4)
  have twice (k : ℕ) : 2 * E.coeff k = if IsSquare (24*k+1) then 2 else 0 := by
    split_ifs with h
    · obtain ⟨a,rfl⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square k).mpr h
      rw [show E = pentagonalSeries (ZMod 4) from rfl, coeff_pentagonalSeries_pentagonal]
      rcases Int.even_or_odd a with h | h
      · rw [Int.negOnePow_even _ h]
        norm_num
      · rw [Int.negOnePow_odd _ h]
        decide
    · have z := coeff_pentagonalSeries_eq_zero (ZMod 4)
        (fun hk => h ((OMA.R_oeis_a386703_R1.pentagonal_iff_square k).mp hk))
      simp [E, z]
  have e := strict_coeff_mod_four n
  rw [coeff_pentagonalSeries_eq_zero (ZMod 4)
    (fun hk => hn ((OMA.R_oeis_a386703_R1.pentagonal_iff_square n).mp hk)), zero_add,
    Finset.mul_sum] at e
  change (q n : ZMod 4) = ∑ j ∈ Icc 1 n.sqrt, 2 * E.coeff (n-j^2) at e
  simp_rw [twice] at e
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm] at e
  apply (ZMod.natCast_eq_natCast_iff' _ _ _).mp
  simpa using e

theorem four_dvd_of_no_rep {n : ℕ} (h : ∀ k : ℤ, ∀ j : ℕ, n ≠ pentagonal k + j^2) :
    4 ∣ q n := by
  have nonsq : ¬ IsSquare (24*n+1) := by
    intro hs
    obtain ⟨k,hk⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square n).mpr hs
    exact h k 0 (by simp [hk])
  have e := nonpentagonal_residue n nonsq
  have empty : ((Icc 1 n.sqrt).filter (fun j => IsSquare (24*(n-j^2)+1))) = ∅ := by
    apply eq_empty_iff_forall_notMem.mpr
    intro j hj
    obtain ⟨mem,sq⟩ := mem_filter.mp hj
    obtain ⟨k,hk⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square _).mpr sq
    have hjn := Nat.le_sqrt'.mp (mem_Icc.mp mem).2
    exact h k j (by omega)
  rw [empty] at e
  exact Nat.dvd_of_mod_eq_zero (by simpa using e)

end PartitionModFour

/- Local obstructions for a generalized pentagonal number plus a square. -/
namespace A386703Quadratic

theorem norm_iff_rep (n j : ℕ) :
    (∃ k : ℤ, n = pentagonal k + j^2) ↔
      ∃ u : ℕ, 24*n+1 = u^2 + 24*j^2 := by
  constructor
  · rintro ⟨k,rfl⟩
    obtain ⟨u,hu⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square (pentagonal k)).mp ⟨k,rfl⟩
    exact ⟨u,by nlinarith only [hu]⟩
  · rintro ⟨u,hu⟩
    have hj : j^2 ≤ n := by omega
    have hs : IsSquare (24*(n-j^2)+1) := ⟨u,by rw [← pow_two]; omega⟩
    obtain ⟨k,hk⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square _).mpr hs
    exact ⟨k,by omega⟩

theorem divides_coordinates {l u j : ℕ} (prime : l.Prime) (inert : ¬IsSquare (-24 : ZMod l))
    (divides : l ∣ u^2 + 24*j^2) : l ∣ u ∧ l ∣ j := by
  let : Fact l.Prime := ⟨prime⟩
  have e : (u : ZMod l)^2 + 24*(j : ZMod l)^2 = 0 := by
    simpa using (ZMod.natCast_eq_zero_iff _ _).mpr divides
  by_cases zero : (j : ZMod l) = 0
  · rw [zero] at e
    have uzero : (u : ZMod l) = 0 := by simpa using e
    exact ⟨(ZMod.natCast_eq_zero_iff _ _).mp uzero,(ZMod.natCast_eq_zero_iff _ _).mp zero⟩
  · exfalso
    apply inert
    refine ⟨(u : ZMod l)/(j : ZMod l),?_⟩
    rw [← pow_two,div_pow]
    apply (eq_div_iff (pow_ne_zero 2 zero)).mpr
    linear_combination -e

theorem norm_descent {l N u j : ℕ} (prime : l.Prime) (inert : ¬IsSquare (-24 : ZMod l))
    (divides : l ∣ N) (norm : N = u^2+24*j^2) :
    ∃ a b : ℕ, N = l^2*(a^2+24*b^2) := by
  obtain ⟨⟨a,hu⟩,⟨b,hj⟩⟩ := divides_coordinates prime inert (norm ▸ divides)
  exact ⟨a,b,by rw [norm,hu,hj]; ring⟩

theorem odd_valuation_no_norm {l m : ℕ} (prime : l.Prime)
    (inert : ¬IsSquare (-24 : ZMod l)) (unit : ¬ l ∣ m) (t : ℕ) :
    ¬ ∃ u j : ℕ, l^(2*t+1)*m = u^2+24*j^2 := by
  induction t with
  | zero =>
    rintro ⟨u,j,h⟩
    have h0 : l*m = u^2+24*j^2 := by simpa using h
    obtain ⟨a,b,he⟩ := norm_descent prime inert (dvd_mul_right l m) h0
    apply unit
    refine ⟨a^2+24*b^2,Nat.eq_of_mul_eq_mul_left prime.pos ?_⟩
    simpa only [pow_two,Nat.mul_assoc] using he
  | succ t ih =>
    rintro ⟨u,j,h⟩
    have he : 2*(t+1)+1 = 2+(2*t+1) := by omega
    rw [he,pow_add,Nat.mul_assoc] at h
    have div : l ∣ l^2*(l^(2*t+1)*m) := by
      rw [pow_two,Nat.mul_assoc]
      exact dvd_mul_right _ _
    obtain ⟨a,b,hr⟩ := norm_descent prime inert div h
    exact ih ⟨a,b,Nat.eq_of_mul_eq_mul_left (pow_pos prime.pos 2) hr⟩

theorem once_no_rep {l n : ℕ} (prime : l.Prime) (inert : ¬IsSquare (-24 : ZMod l))
    (one : l ∣ 24*n+1) (two : ¬l^2 ∣ 24*n+1) (k : ℤ) (j : ℕ) :
    n ≠ pentagonal k + j^2 := by
  intro h
  obtain ⟨u,hu⟩ := (norm_iff_rep n j).mp ⟨k,h⟩
  obtain ⟨a,b,hab⟩ := norm_descent prime inert one hu
  exact two ⟨a^2+24*b^2,hab⟩

theorem mod13_no_rep {n : ℕ} (hn : n % 13 = 7) (hl : n % 169 ≠ 7) (k : ℤ) (j : ℕ) :
    n ≠ pentagonal k + j^2 := by
  apply once_no_rep (l := 13) (by decide)
  · change ¬∃ x : ZMod 13, (-24 : ZMod 13) = x * x
    decide +kernel
  · omega
  · norm_num
    intro d
    obtain ⟨z,hz⟩ := d
    apply hl
    have h : n + 7*(169*z) = 169*n+7 := by omega
    omega

theorem odd_valuation_no_rep {l m n : ℕ} (prime : l.Prime)
    (inert : ¬IsSquare (-24 : ZMod l)) (unit : ¬ l ∣ m) (t : ℕ)
    (valuation : 24*n+1 = l^(2*t+1)*m) (k : ℤ) (j : ℕ) : n ≠ pentagonal k + j^2 := by
  intro h
  obtain ⟨u,hu⟩ := (norm_iff_rep n j).mp ⟨k,h⟩
  exact odd_valuation_no_norm prime inert unit t ⟨u,j,valuation.symm.trans hu⟩

theorem progression_no_rep {l r t : ℕ} (prime : l.Prime) (inert : ¬IsSquare (-24 : ZMod l))
    (origin : 24*r+1 = l^2) (away : ¬l ∣ 24) (unit : ¬l ∣ t)
    (k : ℤ) (j : ℕ) : r+l*t ≠ pentagonal k + j^2 := by
  have factor : 24*(r+l*t)+1 = l*(l+24*t) := by nlinarith only [origin]
  apply once_no_rep prime inert (factor ▸ dvd_mul_right _ _)
  rw [factor]
  rintro ⟨a,ha⟩
  have div : l ∣ l+24*t := ⟨a,Nat.eq_of_mul_eq_mul_left prime.pos
    (by simpa only [pow_two,Nat.mul_assoc] using ha)⟩
  have d : l ∣ 24*t := by simpa using Nat.dvd_sub div (dvd_refl l)
  exact (prime.dvd_mul.mp d).elim away unit

theorem four_progressions (l r : ℕ) (choice : (l,r) ∈ ([(13,7),(17,12),(19,15),(23,22)] : List (ℕ × ℕ)))
    (t : ℕ) (unit : ¬l ∣ t) (k : ℤ) (j : ℕ) : r+l*t ≠ pentagonal k + j^2 := by
  simp only [List.mem_cons,List.not_mem_nil,or_false,Prod.mk.injEq] at choice
  rcases choice with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ <;>
    apply progression_no_rep (by decide) _ (by decide) (by decide) unit <;>
    unfold IsSquare <;> decide +kernel

theorem mod13_lifts (n : ℕ) :
    n%13 = 7 ∧ n%169 ≠ 7 ↔ n%169 ∈ ([20,33,46,59,72,85,98,111,124,137,150,163] : List ℕ) := by
  have localCheck : ∀ t : Fin 169, t.val%13 = 7 ∧ t.val ≠ 7 ↔
      t.val ∈ ([20,33,46,59,72,85,98,111,124,137,150,163] : List ℕ) := by decide +kernel
  simpa only [Nat.mod_mod_of_dvd _ (by decide : 13 ∣ 169)] using
    localCheck ⟨n%169,Nat.mod_lt _ (by decide)⟩

end A386703Quadratic

/- Count the positive-square corrections and apply the local norm exclusions. -/
namespace A386703Quadratic

open OMA.S_oeis_a386703 Finset
open scoped Classical

theorem q_mod_four_eq_twice (n : ℕ) (nonsquare : ¬IsSquare (24*n+1)) :
    q n % 4 = (2 * ((Icc 1 n.sqrt).filter
      (fun j => ∃ k : ℤ, n = pentagonal k + j^2)).card) % 4 := by
  classical
  rw [PartitionModFour.nonpentagonal_residue n nonsquare]
  congr 3
  apply Finset.filter_congr
  intro j hj
  have hle := Nat.le_sqrt'.mp (mem_Icc.mp hj).2
  rw [← OMA.R_oeis_a386703_R1.pentagonal_iff_square]
  constructor
  · rintro ⟨k,hk⟩
    exact ⟨k,by omega⟩
  · rintro ⟨k,hk⟩
    exact ⟨k,by omega⟩

theorem q_mod_four_two_iff (n : ℕ) (nonsquare : ¬IsSquare (24*n+1)) :
    q n % 4 = 2 ↔ Odd (((Icc 1 n.sqrt).filter
      (fun j => ∃ k : ℤ, n = pentagonal k + j^2)).card) := by
  rw [q_mod_four_eq_twice n nonsquare,Nat.odd_iff]
  omega

theorem four_dvd_of_no_rep (n : ℕ) (nonsquare : ¬IsSquare (24*n+1))
    (none : ∀ k : ℤ, ∀ j : ℕ, 0 < j → n ≠ pentagonal k + j^2) : 4 ∣ q n := by
  apply Nat.dvd_of_mod_eq_zero
  rw [q_mod_four_eq_twice n nonsquare]
  have empty : (Icc 1 n.sqrt).filter (fun j => ∃ k : ℤ, n = pentagonal k + j^2) = ∅ := by
    apply eq_empty_iff_forall_notMem.mpr
    intro j hj
    obtain ⟨mem,k,eq⟩ := mem_filter.mp hj
    exact none k j (by have := (mem_Icc.mp mem).1; omega) eq
  rw [empty]
  rfl

theorem four_dvd_excludes {n : ℕ} (divides : 4 ∣ q n) (part : p n % 4 = 3) :
    ¬(q n : ℤ) ∣ (p n : ℤ)-1 := by
  intro bad
  have d : (4 : ℤ) ∣ (q n : ℤ) := by exact_mod_cast divides
  have := dvd_trans d bad
  omega

theorem progression_excludes_divisibility (l r : ℕ)
    (choice : (l,r) ∈ ([(13,7),(17,12),(19,15),(23,22)] : List (ℕ × ℕ)))
    (t : ℕ) (unit : ¬l ∣ t) (part : p (r+l*t) % 4 = 3) :
    ¬(q (r+l*t) : ℤ) ∣ (p (r+l*t) : ℤ)-1 := by
  apply four_dvd_excludes _ part
  apply four_dvd_of_no_rep
  · intro sq
    obtain ⟨k,hk⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square _).mpr sq
    exact four_progressions l r choice t unit k 0 (by simpa using hk.symm)
  · exact fun k j _ => four_progressions l r choice t unit k j

end A386703Quadratic

/- Multiplication of the discriminant by the square of an inert prime preserves
the residue of the strict partition count at every nonpentagonal index. -/
namespace A386703Quadratic

open OMA.S_oeis_a386703 Finset
open scoped Classical

theorem descend_square_index {l n m j : ℕ} (prime : l.Prime)
    (inert : ¬IsSquare (-24 : ZMod l)) (scaled : 24*m+1=l^2*(24*n+1))
    (source : ∃ k : ℤ, m = pentagonal k+j^2) :
    ∃ b : ℕ, j=l*b ∧ ∃ k : ℤ, n = pentagonal k + b^2 := by
  obtain ⟨u,hu⟩ := (norm_iff_rep m j).mp source
  have div : l ∣ l^2*(24*n+1) := ⟨l*(24*n+1),by ring⟩
  obtain ⟨⟨a,ha⟩,⟨b,hb⟩⟩ := divides_coordinates prime inert
    ((scaled.symm.trans hu) ▸ div)
  refine ⟨b,hb,(norm_iff_rep n b).mpr ⟨a,?_⟩⟩
  apply Nat.eq_of_mul_eq_mul_left (pow_pos prime.pos 2)
  calc
    l^2*(24*n+1) = u^2+24*j^2 := scaled.symm.trans hu
    _ = l^2*(a^2+24*b^2) := by rw [ha,hb]; ring

theorem ascend_square_index {l n m j : ℕ} (scaled : 24*m+1=l^2*(24*n+1))
    (source : ∃ k : ℤ, n = pentagonal k+j^2) :
    ∃ k : ℤ, m = pentagonal k+(l*j)^2 := by
  obtain ⟨u,hu⟩ := (norm_iff_rep n j).mp source
  refine (norm_iff_rep m (l*j)).mpr ⟨l*u,?_⟩
  rw [scaled,hu]; ring

theorem nonsquare_inert_square {l n m : ℕ} (prime : l.Prime)
    (inert : ¬IsSquare (-24 : ZMod l)) (scaled : 24*m+1=l^2*(24*n+1))
    (nonpent : ¬IsSquare (24*n+1)) : ¬IsSquare (24*m+1) := by
  intro h
  obtain ⟨k,hk⟩ := (OMA.R_oeis_a386703_R1.pentagonal_iff_square _).mpr h
  obtain ⟨b,hb,k',hk'⟩ := descend_square_index (j:=0) prime inert scaled ⟨k,by simpa using hk.symm⟩
  have bz : b=0 := (Nat.mul_eq_zero.mp hb.symm).resolve_left prime.ne_zero
  exact nonpent ((OMA.R_oeis_a386703_R1.pentagonal_iff_square _).mp ⟨k',by simpa [bz] using hk'.symm⟩)

theorem q_mod_four_inert_square {l n m : ℕ} (prime : l.Prime)
    (inert : ¬IsSquare (-24 : ZMod l)) (scaled : 24*m+1=l^2*(24*n+1))
    (nonpent : ¬IsSquare (24*n+1)) : q m%4=q n%4 := by
  classical
  have nonpent' := nonsquare_inert_square prime inert scaled nonpent
  rw [q_mod_four_eq_twice m nonpent',q_mod_four_eq_twice n nonpent]
  congr 2
  symm
  apply card_bij (fun j _ => l*j)
  · intro j hj
    obtain ⟨range,rep⟩ := mem_filter.mp hj
    have pos := (mem_Icc.mp range).1
    have rep' := ascend_square_index scaled rep
    refine mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.mul_pos prime.pos pos,?_⟩,rep'⟩
    obtain ⟨k,hk⟩ := rep'
    apply Nat.le_sqrt'.mpr
    omega
  · intro a _ b _ eq
    exact Nat.eq_of_mul_eq_mul_left prime.pos eq
  · intro j hj
    obtain ⟨range,rep⟩ := mem_filter.mp hj
    obtain ⟨b,hb,rep'⟩ := descend_square_index prime inert scaled rep
    refine ⟨b,mem_filter.mpr ⟨mem_Icc.mpr ⟨?_,?_⟩,rep'⟩,hb.symm⟩
    · have pos := (mem_Icc.mp range).1
      by_contra! bad
      have : b=0 := by omega
      simp [this] at hb
      omega
    · obtain ⟨k,hk⟩ := rep'
      apply Nat.le_sqrt'.mpr
      omega

/-- The residue-two case persists on this explicit increasing sequence. -/
theorem q_two_iterate_thirteen (a : ℕ) :
    let n := (fun x : ℕ => 169*x+7)^[a] 3
    ¬IsSquare (24*n+1) ∧ q n%4=2 := by
  induction a with
  | zero =>
    change ¬IsSquare (24*3+1 : ℕ) ∧ q 3%4=2
    have nonsq : ¬IsSquare (24*3+1 : ℕ) := by decide +kernel
    refine ⟨nonsq,?_⟩
    rw [PartitionModFour.nonpentagonal_residue 3 nonsq]
    have one : ((Icc 1 (3 : ℕ).sqrt).filter (fun j => IsSquare (24*(3-j^2)+1))) = {1} := by
      ext j
      simp only [mem_filter,mem_Icc,mem_singleton]
      rw [show (3 : ℕ).sqrt = 1 by decide +kernel]
      constructor
      · omega
      · rintro rfl
        exact ⟨⟨by decide,by decide⟩,⟨7,by decide⟩⟩
    rw [one,Finset.card_singleton]
  | succ a ih =>
    dsimp only at ih ⊢
    rw [Function.iterate_succ_apply']
    let n := (fun x : ℕ => 169*x+7)^[a] 3
    have h : 24*(169*n+7)+1=13^2*(24*n+1) := by ring
    have inert : ¬IsSquare (-24 : ZMod 13) := by unfold IsSquare; decide +kernel
    exact ⟨nonsquare_inert_square (by decide : Nat.Prime 13) inert h ih.1,
      (q_mod_four_inert_square (by decide : Nat.Prime 13) inert h ih.1).trans ih.2⟩

end A386703Quadratic

/- The primes inert for the norm form include four residue classes modulo 24. -/
namespace A386703Quadratic

open OMA.S_oeis_a386703

theorem inert_prime_classes {l : ℕ} (prime : l.Prime)
    (cls : l%24 ∈ ([13,17,19,23] : List ℕ)) : ¬IsSquare (-24 : ZMod l) := by
  have odd : Odd l := prime.odd_of_ne_two (by rintro rfl; norm_num at cls)
  have period := jacobiSym.mod_right (-24) odd
  change jacobiSym (-24) l = jacobiSym (-24) (l%96) at period
  have rem := Nat.mod_mod_of_dvd l (by decide : 24 ∣ 96)
  simp only [List.mem_cons,List.not_mem_nil,or_false] at cls
  have cases : l%96=13 ∨ l%96=17 ∨ l%96=19 ∨ l%96=23 ∨
      l%96=37 ∨ l%96=41 ∨ l%96=43 ∨ l%96=47 ∨
      l%96=61 ∨ l%96=65 ∨ l%96=67 ∨ l%96=71 ∨
      l%96=85 ∨ l%96=89 ∨ l%96=91 ∨ l%96=95 := by omega
  have sign : jacobiSym (-24) l = -1 := by
    rw [period]
    rcases cases with h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h <;> rw [h] <;> norm_num
  simpa only [Int.cast_neg,Int.cast_ofNat] using ZMod.nonsquare_of_jacobiSym_eq_neg_one sign

theorem odd_inert_four_dvd {l m n : ℕ} (prime : l.Prime)
    (cls : l%24 ∈ ([13,17,19,23] : List ℕ)) (unit : ¬ l ∣ m) (t : ℕ)
    (valuation : 24*n+1 = l^(2*t+1)*m) : 4 ∣ q n :=
  PartitionModFour.four_dvd_of_no_rep
    (odd_valuation_no_rep prime (inert_prime_classes prime cls) unit t valuation)

theorem odd_inert_mod_four {l m n : ℕ} (prime : l.Prime)
    (cls : l%24 ∈ ([13,17,19,23] : List ℕ)) (unit : ¬ l ∣ m) (t : ℕ)
    (valuation : 24*n+1 = l^(2*t+1)*m) : q n % 4 = 0 :=
  Nat.mod_eq_zero_of_dvd (odd_inert_four_dvd prime cls unit t valuation)

theorem odd_factorization_mod_four {l n : ℕ} (prime : l.Prime)
    (cls : l%24 ∈ ([13,17,19,23] : List ℕ)) (valuation : Odd ((24*n+1).factorization l)) :
    q n % 4 = 0 := by
  obtain ⟨t,ht⟩ := valuation
  have unit := Nat.not_dvd_ordCompl prime (show 24*n+1 ≠ 0 by omega)
  apply odd_inert_mod_four prime cls unit t
  simpa only [ht] using (Nat.ordProj_mul_ordCompl_eq_self (24*n+1) l).symm

theorem odd_inert_excludes {l m n : ℕ} (prime : l.Prime)
    (cls : l%24 ∈ ([13,17,19,23] : List ℕ)) (unit : ¬ l ∣ m) (t : ℕ)
    (valuation : 24*n+1 = l^(2*t+1)*m) (part : p n % 4 = 3) :
    ¬(q n : ℤ) ∣ (p n : ℤ)-1 :=
  four_dvd_excludes (odd_inert_four_dvd prime cls unit t valuation) part

end A386703Quadratic

/- The prime-power shape forced by a divisor count congruent to two modulo four. -/

open Finset
open scoped BigOperators

namespace PartitionDivisorShape

theorem prime_times_square {N : ℕ} (hn : N ≠ 0) (hc : N.divisors.card % 4 = 2) :
    ∃ l s : ℕ, l.Prime ∧ N = l*s^2 ∧ N.factorization l % 4 = 1 := by
  classical
  let f (r : ℕ) := N.factorization r + 1
  have count : N.divisors.card = N.primeFactors.prod f := Nat.card_divisors hn
  have he : 2 ∣ N.primeFactors.prod f := by rw [← count]; omega
  have hfour : ¬4 ∣ N.primeFactors.prod f := by rw [← count]; omega
  obtain ⟨l,hl,h2⟩ := (Nat.prime_two.prime.dvd_finsetProd_iff f).mp he
  have h4 : ¬4 ∣ f l := fun h => hfour (h.trans (dvd_prod_of_mem f hl))
  have hval : N.factorization l % 4 = 1 := by dsimp [f] at h2 h4; omega
  let g (r : ℕ) := r^(N.factorization r / 2)
  have hrest (r : ℕ) (hr : r ∈ N.primeFactors.erase l) : r^N.factorization r = (g r)^2 := by
    have hodd : ¬2 ∣ f r := by
      intro hd
      apply hfour
      rw [← Finset.mul_prod_erase N.primeFactors f hl]
      exact Nat.mul_dvd_mul h2 (hd.trans (dvd_prod_of_mem f hr))
    dsimp [f] at hodd
    dsimp [g]
    rw [← pow_mul]
    congr 1
    omega
  have hhead : l^N.factorization l = l*(g l)^2 := by
    dsimp [g]
    rw [← pow_mul, ← pow_succ']
    congr 1
    omega
  refine ⟨l, g l * (N.primeFactors.erase l).prod g, Nat.prime_of_mem_primeFactors hl, ?_, hval⟩
  calc
    N = ∏ r ∈ N.primeFactors, r^N.factorization r := Nat.prod_primeFactors_pow_factorization hn
    _ = l^N.factorization l * ∏ r ∈ N.primeFactors.erase l, r^N.factorization r :=
      (Finset.mul_prod_erase _ _ hl).symm
    _ = l*(g l)^2 * ∏ r ∈ N.primeFactors.erase l, (g r)^2 := by
      rw [hhead, Finset.prod_congr rfl hrest]
    _ = l*(g l * (N.primeFactors.erase l).prod g)^2 := by rw [Finset.prod_pow]; ring

theorem progression_prime_times_square (n : ℕ) (hc : (24*n+1).divisors.card % 4 = 2) :
    ∃ l s : ℕ, l.Prime ∧ l % 24 = 1 ∧ 24*n+1 = l*s^2 ∧ (24*n+1).factorization l % 4 = 1 := by
  obtain ⟨l,s,hp,he,hv⟩ := prime_times_square (by omega) hc
  have units : ∀ a b : ZMod 24, a*b^2 = 1 → a = 1 := by decide +kernel
  have product : (l : ZMod 24)*(s : ZMod 24)^2 = 1 := by
    rw [← Nat.cast_pow, ← Nat.cast_mul, ← he]
    norm_num
    rw [show (24 : ZMod 24) = 0 by decide, zero_mul]
  have hl := units _ _ product
  refine ⟨l,s,hp,?_,he,hv⟩
  exact (ZMod.natCast_eq_natCast_iff' l 1 24).mp (by simpa using hl)

end PartitionDivisorShape

/- Check the ordinary and strict partition counts through 4096 in parallel radix digits.
Euler's pentagonal convolution modulo a power of the radix verifies the generating
series. A signed coefficient bound prevents cancellation by a carry. The digit scan
checks that none of the three residue classes is attained. -/

/- Truncating the generalized pentagonal expansion gives a sparse certificate
for the ordinary and strict partition recurrences. -/
namespace A386Table
open Finset PowerSeries

lemma pent_bound {k : ℤ} {n : ℕ} (hk : pentagonal k ≤ n) (hn : n ≤ 12000) :
    k ∈ Finset.Icc (-100 : ℤ) 100 := by
  have h : (pentagonal k : ℤ) ≤ 12000 := by exact_mod_cast hk.trans hn
  have eq := two_mul_natCast_pentagonal k
  apply Finset.mem_Icc.mpr
  constructor <;> by_contra! bad
  · nlinarith [sq_nonneg (k+100)]
  · nlinarith [sq_nonneg (k-100)]

lemma sparse (f : ℕ → ℤ) (n : ℕ) (hn : n ≤ 12000) :
    (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, f ij.1 * (pentagonalSeries ℤ).coeff ij.2) =
      f n + ∑ k ∈ (Finset.Icc (-100 : ℤ) 100).erase 0,
        if pentagonal k ≤ n then f (n-pentagonal k) * (Int.negOnePow k : ℤ) else 0 := by
  let K := Finset.Icc (-100 : ℤ) 100
  let U := K.image pentagonal
  let A := Finset.range (n+1)
  let v (i : ℕ) := f (n-i) * (pentagonalSeries ℤ).coeff i
  have full (i : ℕ) (hi : i ∈ A) (hU : i ∉ U) : v i = 0 := by
    have small := Finset.mem_range.mp hi
    have miss : i ∉ Set.range pentagonal := by
      rintro ⟨k,rfl⟩
      exact hU (Finset.mem_image.mpr ⟨k,pent_bound (by omega) hn,rfl⟩)
    simp [v,PowerSeries.coeff_pentagonalSeries_eq_zero ℤ miss]
  have mask : (∑ i ∈ A, v i) = ∑ i ∈ U, if i ≤ n then v i else 0 := by
    rw [← Finset.sum_filter]
    let T := U.filter fun i => i ≤ n
    apply (Finset.sum_subset (s₁:=T) (s₂:=A) ?_ ?_).symm
    · intro i hi
      exact Finset.mem_range.mpr (by have := (Finset.mem_filter.mp hi).2; omega)
    · intro i hi hnot
      apply full i hi
      intro inside
      exact hnot (Finset.mem_filter.mpr ⟨inside,by have := Finset.mem_range.mp hi; omega⟩)
  have conv : (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, f ij.1 * (pentagonalSeries ℤ).coeff ij.2) = ∑ i ∈ A, v i := by
    calc
      _ = ∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, f ij.2 * (pentagonalSeries ℤ).coeff ij.1 :=
        Finset.Nat.sum_antidiagonal_swap (f := fun ij => f ij.2 * (pentagonalSeries ℤ).coeff ij.1)
      _ = _ := Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk _ n
  rw [conv,mask]
  change (∑ i ∈ K.image pentagonal, _) = _
  rw [Finset.sum_image (fun a _ b _ h => pentagonal_injective h)]
  simp only [v,PowerSeries.coeff_pentagonalSeries_pentagonal]
  have z : (0 : ℤ) ∈ K := by decide
  calc
    _ = _ + ∑ k ∈ K.erase 0, if pentagonal k ≤ n then f (n-pentagonal k) * (Int.negOnePow k : ℤ) else 0 :=
      (Finset.add_sum_erase K _ z).symm
    _ = _ := by congr 1; simp [pentagonal_def]

end A386Table

namespace A386Table
open Finset PowerSeries OMA.S_oeis_a386703

lemma sparse_list (keys : List ℤ) (terms : List (ℕ × ℤ)) (hnod : keys.Nodup)
    (hkeys : keys.toFinset = (Finset.Icc (-100 : ℤ) 100).erase 0)
    (hterms : keys.map (fun k => (pentagonal k,(Int.negOnePow k : ℤ))) = terms)
    (f : ℕ → ℤ) (n : ℕ) (hn : n ≤ 12000) :
    (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, f ij.1 * (pentagonalSeries ℤ).coeff ij.2) =
      f n + (terms.map fun z => if z.1 ≤ n then f (n-z.1) * z.2 else 0).sum := by
  rw [sparse f n hn,←hkeys,List.sum_toFinset _ hnod,←hterms,List.map_map]
  rfl

lemma delta_convolution (n : ℕ) :
    (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, (if ij.1 = 0 then (1 : ℤ) else 0) *
      (pentagonalSeries ℤ).coeff ij.2) = (pentagonalSeries ℤ).coeff n := by
  simpa only [one_mul,PowerSeries.coeff_one] using
    (PowerSeries.coeff_mul n (1 : ℤ⟦X⟧) (pentagonalSeries ℤ)).symm

lemma uniqueness (terms : List (ℕ × ℤ)) (hp : ∀ z ∈ terms, 0 < z.1) (N : ℕ) (f g : ℕ → ℤ)
    (row : ∀ n ≤ N, f n + (terms.map fun z => if z.1 ≤ n then f (n-z.1)*z.2 else 0).sum =
      g n + (terms.map fun z => if z.1 ≤ n then g (n-z.1)*z.2 else 0).sum) :
    ∀ n ≤ N, f n = g n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    have h := row n hn
    have maps : (terms.map fun z => if z.1 ≤ n then f (n-z.1)*z.2 else 0) =
        (terms.map fun z => if z.1 ≤ n then g (n-z.1)*z.2 else 0) := by
      apply List.map_congr_left
      intro z hz
      by_cases hs : z.1 ≤ n
      · rw [if_pos hs,if_pos hs,ih (n-z.1) (by have := hp z hz; omega) (by omega)]
      · simp [hs]
    rw [maps] at h
    omega

lemma from_table (N : ℕ) (hN : N ≤ 12000)
    (keys : List ℤ) (terms : List (ℕ × ℤ)) (hnod : keys.Nodup)
    (hkeys : keys.toFinset = (Finset.Icc (-100 : ℤ) 100).erase 0)
    (hterms : keys.map (fun k => (pentagonal k,(Int.negOnePow k : ℤ))) = terms)
    (hp : ∀ z ∈ terms, 0 < z.1) (u v : ℕ → ℤ) :
    let row (f : ℕ → ℤ) (n : ℕ) := f n + (terms.map fun z =>
      if z.1 ≤ n then f (n-z.1)*z.2 else 0).sum
    let delta (n : ℕ) : ℤ := if n=0 then 1 else 0
    (∀ n ≤ N, row u n = delta n ∧ row v n = (if n%2=0 then row delta (n/2) else 0) ∧
        (8 ≤ n → (¬ v n ∣ u n-1) ∧ (¬ v n ∣ u n) ∧ (¬ v n ∣ u n+1))) →
    ∀ n, 8 ≤ n → n ≤ N → (¬(q n : ℤ) ∣ (p n : ℤ)-1) ∧
      (¬(q n : ℤ) ∣ (p n : ℤ)) ∧ (¬(q n : ℤ) ∣ (p n : ℤ)+1) := by
  intro row delta check
  have form := sparse_list keys terms hnod hkeys hterms
  have pu := uniqueness terms hp N (fun n => (p n : ℤ)) u (by
    intro n hn
    change _ = row u n
    rw [← form (fun j => (p j : ℤ)) n (by omega), A386Series.p_convolution,(check n hn).1])
