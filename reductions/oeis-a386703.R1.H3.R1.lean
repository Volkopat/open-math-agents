              · exact scan_at pB qB test 3968 128 pBits qBits n (by decide +kernel) (by omega) (by omega)
              · exact scan_at pB qB test 4096 1 pBits qBits n (by decide +kernel) (by omega) (by omega)
  have truth (n : ℕ) (hn : n ≤ 4096) : digitP n ≤ pM ∧ digitQ n ≤ qM ∧
      (8 ≤ n → (¬(digitQ n : ℤ) ∣ (digitP n : ℤ)-1) ∧ (¬(digitQ n : ℤ) ∣ (digitP n : ℤ)) ∧
        (¬(digitQ n : ℤ) ∣ (digitP n : ℤ)+1)) := of_decide_eq_true (num n hn)
  have weights : ∀ z ∈ T, |z.2| ≤ 1 := by decide +kernel
  have pu := packed_rows T 4096 pB pBits pM (by decide +kernel) (by decide +kernel)
    (by decide +kernel) weights (fun i hi => (truth i hi).1) false (by decide +kernel)
  have qv := packed_rows T 4096 qB qBits qM (by decide +kernel) (by decide +kernel)
    (by decide +kernel) weights (fun i hi => (truth i hi).2.1) true (by decide +kernel)
  apply from_table 4096 (by decide) K T (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (fun n => (digitP n : ℤ)) (fun n => (digitQ n : ℤ))
  intro n hn
  exact ⟨pu n hn,qv n hn,(truth n hn).2.2⟩
end A386Table

namespace OMA.R_oeis_a386703_R1_H3_R1
open OMA.S_oeis_a386703

/-- The needed direction of Merca's Theorem 7 at the even residue two. -/
def H1 : Prop :=
  ∀ n : ℕ, 4096 < n → ¬ IsSquare (24*n+1) → Odd (p n) → q n % 4 = 2 →
    (24*n+1).divisors.card % 4 = 2

/-- When four divides the strict partition count, only the one class for p can remain. -/
def H2 : Prop :=
  ∀ n : ℕ, 4096 < n → ¬ IsSquare (24*n+1) → p n % 4 = 1 → 4 ∣ q n →
    ¬ (q n/4) ∣ ((p n-1)/4)

/-- For a strict partition count congruent to two modulo four, test the odd
quotient only on the specified prime-times-square and quadratic-form values. -/
def H3 : Prop :=
  ∀ n l s : ℕ, 4096 < n → l.Prime → l % 24 = 1 → 24*n+1 = l*s^2 →
    (24*n+1).factorization l % 4 = 1 →
    (∃ u j : ℕ, 0 < j ∧ 24*n+1 = u^2+24*j^2) → Odd (p n) → q n % 4 = 2 →
    ¬ (q n/2) ∣ ((p n-1)/2)

theorem divide_obstruction {a b d : ℕ} (pos : 0 < d) (ha : d ∣ a) (ab : a ∣ b) :
    a/d ∣ b/d := by
  obtain ⟨t,rfl⟩ := ha
  obtain ⟨u,rfl⟩ := ab
  refine ⟨u,?_⟩
  simp only [Nat.mul_assoc,Nat.mul_div_cancel_left _ pos]

/-- The finite certificate also covers the zero and negative-one branches of the parent. -/
theorem centered_finite (n : ℕ) (hn : 8 ≤ n) (small : n ≤ 4096)
    (r : ℤ) (hr : IsCenteredResidue n r) : 1 < |r| := by
  by_contra! bound
  have h := abs_le.mp bound
  obtain ⟨plus,zero,minus⟩ := A386Table.finite_part n hn small
  have cases : r = -1 ∨ r = 0 ∨ r = 1 := by omega
  rcases cases with h | h | h <;> subst r
  · exact minus (by simpa using hr.1.dvd)
  · exact zero (by simpa using hr.1.dvd)
  · exact plus hr.1.dvd

theorem main : H1 → H2 → H3 → OMA.R_oeis_a386703_R1.H3 := by
  intro table fourCase twice n lo nonsquare odd dvd
  by_cases small : n ≤ 4096
  · exact (A386Table.finite_part n (by omega) small).1 dvd
  have pos : 1 ≤ p n := odd.pos
  have natDvd : q n ∣ p n-1 := by
    rw [←Nat.cast_one (R := ℤ),←Nat.cast_sub pos] at dvd
    exact_mod_cast dvd
  have even := (OMA.R_oeis_a386703_R1.even_q_iff_nonsquare n).mpr nonsquare
  by_cases four : 4 ∣ q n
  · have p4 : 4 ∣ p n-1 := dvd_trans four natDvd
    exact fourCase n (by omega) nonsquare (by omega) four (divide_obstruction (by decide) four natDvd)
  · have qr : q n % 4 = 2 := by obtain ⟨d,hd⟩ := even; omega
    have count := table n (by omega) nonsquare odd qr
    obtain ⟨l,s,prime,mod24,mul,vℓ⟩ := PartitionDivisorShape.progression_prime_times_square n count
    have form : ∃ u j : ℕ, 0 < j ∧ 24*n+1=u^2+24*j^2 := by
      by_contra! empty
      apply four
      apply A386703Quadratic.four_dvd_of_no_rep n nonsquare
      intro k j hj eq
      obtain ⟨u,hu⟩ := (A386703Quadratic.norm_iff_rep n j).mp ⟨k,eq⟩
      exact empty u j hj hu
    exact twice n l s (by omega) prime mod24 mul vℓ form odd qr
      (divide_obstruction (by decide) (even_iff_two_dvd.mp even) natDvd)

end OMA.R_oeis_a386703_R1_H3_R1

