  ∃ mask ∈ [36169948434793600,70781333153792], ∃ e : Fin 8 ↪ Fin 8, ∀ i j, G.Adj i j →
    mask.testBit ((min (e i) (e j)).val*8+(max (e i) (e j)).val) = false

