  ∃ mask ∈ [14855280693082744087392632874,4951760378943817067685560330,604831853708092460023990,40564825856395375891792278241302], ∃ e : Fin 12 ↪ Fin 12, ∀ i j, G.Adj i j →
    mask.testBit ((min (e i) (e j)).val*12+(max (e i) (e j)).val) = false)

open SimpleGraph List OMA.R_Erdos1182_erdos_1182_variants_small_values_R1_H1_R1

set_option maxHeartbeats 600000000 in
