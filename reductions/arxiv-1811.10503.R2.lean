import OMAStatements.S_arxiv_1811_10503
import Mathlib

-- Reduction arxiv-1811.10503.R2 of On permutations of $\{1,\ldots,n\}$ and related topics
-- Credit: @ethduke
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# Sun's Conjecture 4.1 reduces to fully blocked sets in finite abelian groups

Hypothesis on `G` at level `n`: no element has order in `[2, n+1]`. Call `b ∈ A` (with `|A| = n`)
*blocked* if `b ^ n = a ^ k` for some `a ∈ A`, `a ≠ b`, `1 ≤ k < n`; call `A` *fully blocked* if every
element is blocked. This file proves, with no further assumption:

1. `sun_le_three`: the conjecture for `n ≤ 3` in every group (Sun's Theorem 1.4(ii); the Lean proof
   here uses a different counting argument on the 18 failure relations).
2. Peeling (`peel`): an element that is not blocked takes exponent `n`, and the rest is numbered at
   level `n - 1`. So a minimal counterexample is fully blocked.
3. `fb_torsion`: every element of a fully blocked set has finite order, in any group. Following
   `b ↦ a` with `b ^ n = a ^ k` until an element repeats gives `c ^ (n ^ m) = c ^ K` with
   `K ≤ (n - 1) ^ m < n ^ m`. In particular the conjecture holds for every torsion-free group.
4. `model`: if every element of `A` has finite order, `x ^ r = y ^ s` with `1 ≤ r, s ≤ n` forces
   `zpowers x = zpowers y` (the exponents are prime to the orders). So `A` embeds into the finite
   abelian group `∏_{c ∈ A} zpowers c`, keeping every such relation and the order hypothesis.
   (D. Ma, arXiv:2611.13582, uses the same observation for finite groups.) A fully blocked set stays
   fully blocked, and a numbering there pulls back.

What remains is the conjecture for fully blocked subsets of finite abelian groups:
* `H1`: `4 ≤ n ≤ 7`. For each fixed `n` this is a finite computation: blocking keeps every element in
  a cyclic class of size at least 2 whose modulus divides some `n ^ L - ∏ k_t`. Our exhaustive enumeration
  (64, 2619, 27045 and 4,381,328 configurations for `n = 4, 5, 6, 7`) found no failure. A second,
  independent program agrees for `n ≤ 5`; `n = 6, 7` rest on one program. Ma's preprint claims finite
  groups for `n ≤ 6`.
* `H2`: `n ≥ 8` (open).

The statement quantifies over `G : Type u`. It is first moved to `Type` through the quotient of the
free group on `n` letters that maps onto the subgroup generated by `A` (the same device as in the
reduction of PR 20250).
-/

namespace OMA.R_arxiv_1811_10503_R2

def H1 : Prop := ∀ n : ℕ, 4 ≤ n → n ≤ 7 → ∀ (G : Type) [CommGroup G] [Finite G],
  (∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) → ∀ A : Finset G, A.card = n →
  (∀ b ∈ A, ∃ a ∈ A, a ≠ b ∧ ∃ k : ℕ, 1 ≤ k ∧ k < n ∧ b ^ n = a ^ k) →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val + 1))

def H2 : Prop := ∀ n : ℕ, 8 ≤ n → ∀ (G : Type) [CommGroup G] [Finite G],
  (∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) → ∀ A : Finset G, A.card = n →
  (∀ b ∈ A, ∃ a ∈ A, a ≠ b ∧ ∃ k : ℕ, 1 ≤ k ∧ k < n ∧ b ^ n = a ^ k) →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val + 1))

namespace SunLeThree

theorem eq_one_of_prime_pow {G : Type*} [Group G] {n p : ℕ} (hp : p.Prime) (hpn : p ≤ n + 1)
    (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) (g : G) (hg : g ^ p = 1) : g = 1 := by
  rcases (Nat.dvd_prime hp).mp (orderOf_dvd_of_pow_eq_one hg) with h | h
  · exact orderOf_eq_one_iff.mp h
  · exfalso
    apply hG g
    rw [h, Finset.mem_Icc]
    exact ⟨hp.two_le, hpn⟩

theorem cancel_pow {G : Type*} [Group G] {v : G} {m n : ℕ} (b : ℕ) (hb : n = m + b)
    (h : v ^ n = v ^ m) : v ^ b = 1 := by
  subst hb
  apply mul_left_cancel (a := v ^ m)
  rw [← pow_add, h, mul_one]

/-! Incompatible pairs of relations on one pair of distinct elements. -/

theorem inc1 {G : Type*} [Group G] {u v : G} (huv : u ≠ v) (h1 : u = v ^ 2) (h2 : u = v ^ 3) :
    False := by
  have e : v ^ 3 = v ^ 2 := h2.symm.trans h1
  have hv : v = 1 := by
    have := cancel_pow 1 rfl e
    rwa [pow_one] at this
  exact huv (by rw [h1, hv, one_pow])

theorem inc2 {G : Type*} [Group G] {u v : G} (huv : u ≠ v) (h1 : u = v ^ 2)
    (h2 : u ^ 2 = v ^ 3) : False := by
  have e : v ^ 4 = v ^ 3 := by
    have e1 : v ^ 4 = (v ^ 2) ^ 2 := pow_mul v 2 2
    rw [e1, ← h1]
    exact h2
  have hv : v = 1 := by
    have := cancel_pow 1 rfl e
    rwa [pow_one] at this
  exact huv (by rw [h1, hv, one_pow])

theorem inc3 {G : Type*} [Group G] (t3 : ∀ g : G, g ^ 3 = 1 → g = 1) {u v : G} (huv : u ≠ v)
    (h1 : u = v ^ 2) (h2 : v = u ^ 2) : False := by
  have e : v ^ 4 = v ^ 1 := by
    have e1 : v ^ 4 = (v ^ 2) ^ 2 := pow_mul v 2 2
    rw [e1, ← h1, ← h2, pow_one]
  have hv : v = 1 := t3 v (cancel_pow 3 rfl e)
  exact huv (by rw [h1, hv, one_pow])

theorem inc4 {G : Type*} [Group G] (t2 : ∀ g : G, g ^ 2 = 1 → g = 1) {u v : G} (huv : u ≠ v)
    (h1 : u = v ^ 2) (h2 : v ^ 2 = u ^ 3) : False := by
  have e : u ^ 3 = u ^ 1 := by rw [← h2, ← h1, pow_one]
  have hu : u = 1 := t2 u (cancel_pow 2 rfl e)
  have hv : v = 1 := t2 v (by rw [← h1, hu])
  exact huv (by rw [hu, hv])

theorem inc5 {G : Type*} [Group G] (t3 : ∀ g : G, g ^ 3 = 1 → g = 1) {u v : G} (huv : u ≠ v)
    (h1 : u = v ^ 3) (h2 : u ^ 2 = v ^ 3) : False := by
  have e : u ^ 2 = u ^ 1 := by rw [h2, ← h1, pow_one]
  have hu : u = 1 := by
    have := cancel_pow 1 rfl e
    rwa [pow_one] at this
  have hv : v = 1 := t3 v (by rw [← h1, hu])
  exact huv (by rw [hu, hv])

theorem inc6 {G : Type*} [Group G] (t2 : ∀ g : G, g ^ 2 = 1 → g = 1) {u v : G} (huv : u ≠ v)
    (h1 : u = v ^ 3) (h2 : v = u ^ 3) : False := by
  have e : v ^ 9 = v ^ 1 := by
    have e1 : v ^ 9 = (v ^ 3) ^ 3 := pow_mul v 3 3
    rw [e1, ← h1, ← h2, pow_one]
  have e8 : v ^ 8 = 1 := cancel_pow 8 rfl e
  have e4 : v ^ 4 = 1 := t2 (v ^ 4) (by rw [← pow_mul]; exact e8)
  have e2 : v ^ 2 = 1 := t2 (v ^ 2) (by rw [← pow_mul]; exact e4)
  have hv : v = 1 := t2 v e2
  exact huv (by rw [h1, hv, one_pow])

/-! The patterns that survive the pairwise test. -/

theorem five {G : Type*} [Group G] {u v : G} (h1 : u ^ 2 = v ^ 3) (h2 : v ^ 2 = u ^ 3) :
    u ^ 5 = 1 := by
  have e : u ^ 9 = u ^ 4 := by
    have e1 : u ^ 9 = (u ^ 3) ^ 3 := pow_mul u 3 3
    have e2 : u ^ 4 = (u ^ 2) ^ 2 := pow_mul u 2 2
    have e3 : (v ^ 2) ^ 3 = (v ^ 3) ^ 2 := by rw [← pow_mul, ← pow_mul]
    rw [e1, e2, ← h2, h1]
    exact e3
  exact cancel_pow 5 rfl e

theorem seven {G : Type*} [Group G] {u w : G} (h1 : u = w ^ 3) (h2 : w ^ 2 = u ^ 3) :
    u ^ 7 = 1 := by
  have e : w ^ 9 = w ^ 2 := by
    have e1 : w ^ 9 = (w ^ 3) ^ 3 := pow_mul w 3 3
    rw [e1, ← h1, h2]
  have hw : w ^ 7 = 1 := cancel_pow 7 rfl e
  rw [h1, ← pow_mul, mul_comm, pow_mul, hw, one_pow]

theorem mix57 {G : Type*} [Group G] (t2 : ∀ g : G, g ^ 2 = 1 → g = 1)
    (t3 : ∀ g : G, g ^ 3 = 1 → g = 1) {u v w : G} (huv : u ≠ v)
    (h1 : u ^ 2 = v ^ 3) (h2 : v ^ 2 = u ^ 3) (h3 : u = w ^ 3) (h4 : w ^ 2 = u ^ 3) : False := by
  have e5 : u ^ 5 = 1 := five h1 h2
  have e7 : u ^ 7 = 1 := seven h3 h4
  have e : u ^ 7 = u ^ 5 := by rw [e5, e7]
  have hu : u = 1 := t2 u (cancel_pow 2 rfl e)
  have hv : v = 1 := t3 v (by rw [← h1, hu, one_pow])
  exact huv (by rw [hu, hv])

theorem mix55 {G : Type*} [Group G] {u v w : G} (hvw : v ≠ w)
    (h1 : u ^ 2 = v ^ 3) (h2 : v ^ 2 = u ^ 3) (h3 : u ^ 2 = w ^ 3) (h4 : w ^ 2 = u ^ 3) :
    False := by
  have e2 : v ^ 2 = w ^ 2 := h2.trans h4.symm
  have e3 : v ^ 3 = w ^ 3 := h1.symm.trans h3
  apply hvw
  apply mul_left_cancel (a := v ^ 2)
  rw [← pow_succ, e3, e2, ← pow_succ]

/-! A numbering (p, q, r) that does not fail gives the required map. -/

theorem fails {G : Type*} [Group G] (A : Finset G) (p q r : G) (hpq : p ≠ q) (hpr : p ≠ r)
    (hqr : q ≠ r) (hS : (A : Set G) = {p, q, r})
    (H : ¬ ∃ a : Fin 3 → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin 3 => a i ^ (i.val + 1))) :
    p = q ^ 2 ∨ p = r ^ 3 ∨ q ^ 2 = r ^ 3 := by
  by_contra hc
  obtain ⟨c1, hc'⟩ := not_or.mp hc
  obtain ⟨c2, c3⟩ := not_or.mp hc'
  apply H
  refine ⟨![p, q, r], ?_, ?_, ?_⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp at hij ⊢
    all_goals first
      | exact hpq hij | exact hpq hij.symm | exact hpr hij | exact hpr hij.symm
      | exact hqr hij | exact hqr hij.symm
  · rw [hS]
    ext g
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff, Fin.exists_fin_succ,
      Fin.exists_fin_zero]
    simp
    tauto
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp at hij ⊢
    all_goals first
      | exact c1 hij | exact c1 hij.symm | exact c2 hij | exact c2 hij.symm
      | exact c3 hij | exact c3 hij.symm

/-! The cases n = 0, 1, 2. -/

theorem zero {G : Type*} [Group G] (A : Finset G) (hA : A.card = 0) :
    ∃ a : Fin 0 → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin 0 => a i ^ (i.val + 1)) := by
  refine ⟨![], fun i => Fin.elim0 i, ?_, fun i => Fin.elim0 i⟩
  rw [Finset.card_eq_zero.mp hA]
  ext g
  simp

theorem one {G : Type*} [Group G] (A : Finset G) (hA : A.card = 1) :
    ∃ a : Fin 1 → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin 1 => a i ^ (i.val + 1)) := by
  obtain ⟨x, hx⟩ := Finset.card_eq_one.mp hA
  refine ⟨![x], Function.injective_of_subsingleton _, ?_, Function.injective_of_subsingleton _⟩
  rw [hx]
  ext g
  simp

theorem fails2 {G : Type*} [Group G] (A : Finset G) (p q : G) (hpq : p ≠ q)
    (hS : (A : Set G) = {p, q})
    (H : ¬ ∃ a : Fin 2 → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin 2 => a i ^ (i.val + 1))) :
    p = q ^ 2 := by
  by_contra c1
  apply H
  refine ⟨![p, q], ?_, ?_, ?_⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp at hij ⊢
    all_goals first | exact hpq hij | exact hpq hij.symm
  · rw [hS]
    ext g
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff, Fin.exists_fin_succ,
      Fin.exists_fin_zero]
    simp
    tauto
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp at hij ⊢
    all_goals first | exact c1 hij | exact c1 hij.symm

theorem two {G : Type*} [Group G] (t3 : ∀ g : G, g ^ 3 = 1 → g = 1) (A : Finset G)
    (hA : A.card = 2) :
    ∃ a : Fin 2 → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin 2 => a i ^ (i.val + 1)) := by
  classical
  obtain ⟨x, y, hxy, hAeq⟩ := Finset.card_eq_two.mp hA
  have hS : (A : Set G) = {x, y} := by rw [hAeq]; simp
  by_contra H
  have f1 : x = y ^ 2 := fails2 A x y hxy hS H
  have f2 : y = x ^ 2 := fails2 A y x hxy.symm (hS.trans (Set.pair_comm x y)) H
  exact inc3 t3 hxy f1 f2

/-! The case n = 3. -/

theorem set_perms {G : Type*} (x y z : G) :
    ({x, z, y} : Set G) = {x, y, z} ∧ ({y, x, z} : Set G) = {x, y, z} ∧
      ({y, z, x} : Set G) = {x, y, z} ∧ ({z, x, y} : Set G) = {x, y, z} ∧
      ({z, y, x} : Set G) = {x, y, z} := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> ext g <;>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] <;> tauto

theorem three {G : Type*} [Group G] (t2 : ∀ g : G, g ^ 2 = 1 → g = 1)
    (t3 : ∀ g : G, g ^ 3 = 1 → g = 1) (A : Finset G) (hA : A.card = 3) :
    ∃ a : Fin 3 → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin 3 => a i ^ (i.val + 1)) := by
  classical
  obtain ⟨x, y, z, hxy, hxz, hyz, hAeq⟩ := Finset.card_eq_three.mp hA
  have hS : (A : Set G) = {x, y, z} := by rw [hAeq]; simp
  have hyx : y ≠ x := hxy.symm
  have hzx : z ≠ x := hxz.symm
  have hzy : z ≠ y := hyz.symm
  by_contra H
  have f1 : x = y ^ 2 ∨ x = z ^ 3 ∨ y ^ 2 = z ^ 3 := fails A x y z hxy hxz hyz hS H
  have f2 : x = z ^ 2 ∨ x = y ^ 3 ∨ z ^ 2 = y ^ 3 := fails A x z y hxz hxy hzy
    (hS.trans (set_perms x y z).1.symm) H
  have f3 : y = x ^ 2 ∨ y = z ^ 3 ∨ x ^ 2 = z ^ 3 := fails A y x z hyx hyz hxz
    (hS.trans (set_perms x y z).2.1.symm) H
  have f4 : y = z ^ 2 ∨ y = x ^ 3 ∨ z ^ 2 = x ^ 3 := fails A y z x hyz hyx hzx
    (hS.trans (set_perms x y z).2.2.1.symm) H
  have f5 : z = x ^ 2 ∨ z = y ^ 3 ∨ x ^ 2 = y ^ 3 := fails A z x y hzx hzy hxy
    (hS.trans (set_perms x y z).2.2.2.1.symm) H
  have f6 : z = y ^ 2 ∨ z = x ^ 3 ∨ y ^ 2 = x ^ 3 := fails A z y x hzy hzx hyx
    (hS.trans (set_perms x y z).2.2.2.2.symm) H
  rcases f1 with e1 | e1 | e1
  · rcases f3 with e3 | e3 | e3
    · exact inc3 t3 hyx e3 e1
    · rcases f5 with e5 | e5 | e5
      · rcases f6 with e6 | e6 | e6
        · rcases f2 with e2 | e2 | e2
          · exact inc3 t3 hxz e2 e5
          · exact inc1 hxy e1 e2
          · exact inc2 hzy e6 e2
        · exact inc1 hzx e5 e6
        · exact inc4 t2 hxy e1 e6
      · exact inc6 t2 hzy e5 e3
      · exact inc2 hxy e1 e5
    · rcases f5 with e5 | e5 | e5
      · exact inc4 t2 hzx e5 e3
      · rcases f6 with e6 | e6 | e6
        · exact inc1 hzy e6 e5
        · rcases f2 with e2 | e2 | e2
          · exact inc2 hxz e2 e3
          · exact inc1 hxy e1 e2
          · exact inc5 t3 hzy e5 e2
        · exact inc4 t2 hxy e1 e6
      · exact inc2 hxy e1 e5
  · rcases f3 with e3 | e3 | e3
    · rcases f5 with e5 | e5 | e5
      · rcases f6 with e6 | e6 | e6
        · rcases f2 with e2 | e2 | e2
          · exact inc1 hxz e2 e1
          · rcases f4 with e4 | e4 | e4
            · exact inc3 t3 hyz e4 e6
            · exact inc1 hyx e3 e4
            · exact inc2 hzx e5 e4
          · exact inc2 hzy e6 e2
        · exact inc6 t2 hzx e6 e1
        · exact inc2 hyx e3 e6
      · rcases f6 with e6 | e6 | e6
        · exact inc1 hzy e6 e5
        · exact inc6 t2 hzx e6 e1
        · exact inc2 hyx e3 e6
      · exact inc4 t2 hyx e3 e5
    · rcases f5 with e5 | e5 | e5
      · rcases f6 with e6 | e6 | e6
        · rcases f2 with e2 | e2 | e2
          · exact inc1 hxz e2 e1
          · rcases f4 with e4 | e4 | e4
            · exact inc1 hyz e4 e3
            · exact inc6 t2 hyx e4 e2
            · exact inc2 hzx e5 e4
          · exact inc2 hzy e6 e2
        · exact inc6 t2 hzx e6 e1
        · rcases f2 with e2 | e2 | e2
          · exact inc1 hxz e2 e1
          · rcases f4 with e4 | e4 | e4
            · exact inc1 hyz e4 e3
            · exact inc5 t3 hyx e4 e6
            · exact inc2 hzx e5 e4
          · rcases f4 with e4 | e4 | e4
            · exact inc1 hyz e4 e3
            · exact inc5 t3 hyx e4 e6
            · exact inc2 hzx e5 e4
      · exact inc6 t2 hzy e5 e3
      · rcases f6 with e6 | e6 | e6
        · rcases f2 with e2 | e2 | e2
          · exact inc1 hxz e2 e1
          · exact inc5 t3 hxy e2 e5
          · exact inc2 hzy e6 e2
        · exact inc6 t2 hzx e6 e1
        · rcases f2 with e2 | e2 | e2
          · exact inc1 hxz e2 e1
          · exact inc5 t3 hxy e2 e5
          · rcases f4 with e4 | e4 | e4
            · exact inc1 hyz e4 e3
            · exact inc5 t3 hyx e4 e6
            · exact mix57 t2 t3 hxy e5 e6 e1 e4
    · exact inc5 t3 hxz e1 e3
  · rcases f3 with e3 | e3 | e3
    · rcases f5 with e5 | e5 | e5
      · rcases f6 with e6 | e6 | e6
        · exact inc4 t2 hzy e6 e1
        · exact inc1 hzx e5 e6
        · exact inc2 hyx e3 e6
      · rcases f6 with e6 | e6 | e6
        · exact inc4 t2 hzy e6 e1
        · rcases f2 with e2 | e2 | e2
          · rcases f4 with e4 | e4 | e4
            · exact inc2 hyz e4 e1
            · exact inc1 hyx e3 e4
            · exact inc5 t3 hzx e6 e4
          · rcases f4 with e4 | e4 | e4
            · exact inc2 hyz e4 e1
            · exact inc1 hyx e3 e4
            · exact inc5 t3 hzx e6 e4
          · exact inc5 t3 hzy e5 e2
        · exact inc2 hyx e3 e6
      · exact inc4 t2 hyx e3 e5
    · exact inc5 t3 hyz e3 e1
    · rcases f5 with e5 | e5 | e5
      · exact inc4 t2 hzx e5 e3
      · rcases f6 with e6 | e6 | e6
        · exact inc4 t2 hzy e6 e1
        · rcases f2 with e2 | e2 | e2
          · exact inc2 hxz e2 e3
          · rcases f4 with e4 | e4 | e4
            · exact inc2 hyz e4 e1
            · exact inc6 t2 hyx e4 e2
            · exact inc5 t3 hzx e6 e4
          · exact inc5 t3 hzy e5 e2
        · rcases f2 with e2 | e2 | e2
          · exact inc2 hxz e2 e3
          · rcases f4 with e4 | e4 | e4
            · exact inc2 hyz e4 e1
            · exact inc5 t3 hyx e4 e6
            · exact mix57 t2 t3 hxz e3 e4 e2 e6
          · exact inc5 t3 hzy e5 e2
      · rcases f6 with e6 | e6 | e6
        · exact inc4 t2 hzy e6 e1
        · rcases f2 with e2 | e2 | e2
          · exact inc2 hxz e2 e3
          · exact inc5 t3 hxy e2 e5
          · rcases f4 with e4 | e4 | e4
            · exact inc2 hyz e4 e1
            · exact mix57 t2 t3 hyz e1 e2 e4 e5
            · exact inc5 t3 hzx e6 e4
        · rcases f2 with e2 | e2 | e2
          · exact inc2 hxz e2 e3
          · exact inc5 t3 hxy e2 e5
          · rcases f4 with e4 | e4 | e4
            · exact inc2 hyz e4 e1
            · exact inc5 t3 hyx e4 e6
            · exact mix55 hyz e5 e6 e3 e4

end SunLeThree

theorem sun_le_three (n : ℕ) (hn : n ≤ 3) (G : Type*) [Group G]
    (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) (A : Finset G) (hA : A.card = n) :
    ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin n => a i ^ (i.val + 1)) := by
  interval_cases n
  · exact SunLeThree.zero A hA
  · exact SunLeThree.one A hA
  · exact SunLeThree.two
      (SunLeThree.eq_one_of_prime_pow Nat.prime_three (by norm_num) hG) A hA
  · exact SunLeThree.three
      (SunLeThree.eq_one_of_prime_pow Nat.prime_two (by norm_num) hG)
      (SunLeThree.eq_one_of_prime_pow Nat.prime_three (by norm_num) hG) A hA

section Torsion

variable {G : Type} [Group G]

/-- An exponent `1 ≤ r ≤ n` is prime to the order of every element. -/
lemma coprime_of_noSmall {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1))
    (x : G) (hx : orderOf x ≠ 0) {r : ℕ} (hr : 1 ≤ r) (hrn : r ≤ n) :
    r.Coprime (orderOf x) := by
  by_contra h
  obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd h
  have hpr : p ∣ r := hpd.trans (Nat.gcd_dvd_left _ _)
  have hpo : p ∣ orderOf x := hpd.trans (Nat.gcd_dvd_right _ _)
  apply hG (x ^ (orderOf x / p))
  rw [orderOf_pow_orderOf_div hx hpo, Finset.mem_Icc]
  exact ⟨hp.two_le, (Nat.le_of_dvd (by omega) hpr).trans (by omega)⟩

lemma zpowers_pow_eq {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1))
    (x : G) (hx : orderOf x ≠ 0) {r : ℕ} (hr : 1 ≤ r) (hrn : r ≤ n) :
    Subgroup.zpowers (x ^ r) = Subgroup.zpowers x := by
  apply le_antisymm
  · rw [Subgroup.zpowers_le]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers x) r
  · rw [Subgroup.zpowers_le]
    obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime (coprime_of_noSmall hG x hx hr hrn)
    have hmem : (x ^ r) ^ m ∈ Subgroup.zpowers (x ^ r) :=
      Subgroup.pow_mem _ (Subgroup.mem_zpowers (x ^ r)) m
    rwa [hm] at hmem

/-- Two elements of finite order collide only inside one cyclic subgroup. -/
lemma collide {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) {x y : G}
    (hx : orderOf x ≠ 0) (hy : orderOf y ≠ 0) {r s : ℕ} (hr : 1 ≤ r) (hrn : r ≤ n)
    (hs : 1 ≤ s) (hsn : s ≤ n) (h : x ^ r = y ^ s) :
    Subgroup.zpowers x = Subgroup.zpowers y := by
  rw [← zpowers_pow_eq hG x hx hr hrn, ← zpowers_pow_eq hG y hy hs hsn, h]

/-- The abelian model of a set of elements of finite order. -/
lemma model {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) (A : Finset G)
    (hA : ∀ x ∈ A, orderOf x ≠ 0) :
    ∃ (H : Type) (_ : CommGroup H) (_ : Finite H) (f : G → H), Set.InjOn f A ∧
      (∀ h : H, orderOf h ∉ Finset.Icc 2 (n + 1)) ∧
      ∀ x ∈ A, ∀ y ∈ A, ∀ r s : ℕ, 1 ≤ r → r ≤ n → 1 ≤ s → s ≤ n →
        x ^ r = y ^ s → f x ^ r = f y ^ s := by
  classical
  have hfin : ∀ c : A, Finite (Subgroup.zpowers (c : G)) := fun c =>
    (finite_zpowers.mpr (orderOf_pos_iff.mp (Nat.pos_of_ne_zero (hA c c.2)))).to_subtype
  let f : G → ((c : A) → Subgroup.zpowers (c : G)) := fun y c =>
    if h : Subgroup.zpowers y = Subgroup.zpowers (c : G) then
      ⟨y, h ▸ Subgroup.mem_zpowers y⟩ else 1
  have hf : ∀ (y x : G) (hx : x ∈ A), ((f y ⟨x, hx⟩ : Subgroup.zpowers x) : G) =
      if Subgroup.zpowers y = Subgroup.zpowers x then y else 1 := by
    intro y x hx
    simp only [f]
    split_ifs <;> rfl
  have hf' : ∀ (y : G) (c : A), ((f y c : Subgroup.zpowers (c : G)) : G) =
      if Subgroup.zpowers y = Subgroup.zpowers (c : G) then y else 1 := fun y c => hf y c c.2
  let hcomm : ∀ c : A, CommGroup (Subgroup.zpowers (c : G)) := fun c =>
    { (inferInstance : Group (Subgroup.zpowers (c : G))) with
      mul_comm := fun a b => (IsMulCommutative.is_comm (M := Subgroup.zpowers (c : G))).comm a b }
  refine ⟨(c : A) → Subgroup.zpowers (c : G), inferInstance, Pi.finite, f, ?_, ?_, ?_⟩
  · intro y hy z hz hyz
    by_contra hne
    have key : ∀ (x : G) (hx : x ∈ A),
        ((f y ⟨x, hx⟩ : Subgroup.zpowers x) : G) = (f z ⟨x, hx⟩ : Subgroup.zpowers x) := by
      intro x hx
      rw [hyz]
    by_cases hy1 : y = 1
    · have h := key z hz
      rw [hf, hf, if_pos (Eq.refl (Subgroup.zpowers z))] at h
      split_ifs at h with h''
      · exact hne h
      · exact hne (by rw [hy1, h])
    · have h := key y hy
      rw [hf, hf, if_pos (Eq.refl (Subgroup.zpowers y))] at h
      split_ifs at h with h''
      · exact hne h
      · exact hy1 h
  · intro h hmem
    rw [Finset.mem_Icc] at hmem
    have hne : h ≠ 1 := by
      intro h1
      rw [h1, orderOf_one] at hmem
      omega
    obtain ⟨c, hc⟩ : ∃ c, h c ≠ 1 := by
      by_contra hc
      push Not at hc
      exact hne (funext hc)
    have hdvd : orderOf (h c) ∣ orderOf h := by
      apply orderOf_dvd_of_pow_eq_one
      rw [← Pi.pow_apply, pow_orderOf_eq_one]
      rfl
    have hpos : 0 < orderOf (h c) := Nat.pos_of_dvd_of_pos hdvd (by omega)
    have h1 : orderOf (h c) ≠ 1 := by
      rwa [Ne, orderOf_eq_one_iff]
    apply hG (h c : G)
    rw [Subgroup.orderOf_coe, Finset.mem_Icc]
    exact ⟨by omega, (Nat.le_of_dvd (by omega) hdvd).trans hmem.2⟩
  · intro x hx y hy r s hr hrn hs hsn hxy
    have hz := collide hG (hA x hx) (hA y hy) hr hrn hs hsn hxy
    funext c
    rw [Pi.pow_apply, Pi.pow_apply]
    apply Subtype.ext
    rw [Subgroup.coe_pow, Subgroup.coe_pow, hf', hf']
    by_cases hc : Subgroup.zpowers x = Subgroup.zpowers (c : G)
    · rw [if_pos hc, if_pos (hz ▸ hc), hxy]
    · rw [if_neg hc, if_neg (hz ▸ hc), one_pow, one_pow]

/-- Every element of a fully blocked set has finite order. -/
lemma fb_torsion {n : ℕ} (A : Finset G)
    (hfb : ∀ b ∈ A, ∃ a ∈ A, a ≠ b ∧ ∃ k : ℕ, 1 ≤ k ∧ k < n ∧ b ^ n = a ^ k) :
    ∀ x ∈ A, orderOf x ≠ 0 := by
  classical
  intro x hxA hx0
  -- an element of infinite order is blocked by an element of infinite order
  have hstep : ∀ y : G, y ∈ A ∧ orderOf y = 0 →
      ∃ a : G, ∃ k : ℕ, (a ∈ A ∧ orderOf a = 0) ∧ k < n ∧ y ^ n = a ^ k := by
    rintro y ⟨hyA, hy0⟩
    obtain ⟨a, haA, -, k, -, hkn, hyk⟩ := hfb y hyA
    refine ⟨a, k, ⟨haA, ?_⟩, hkn, hyk⟩
    by_contra ha0
    apply (orderOf_eq_zero_iff'.mp hy0) (n * orderOf a)
      (Nat.mul_pos (by omega) (Nat.pos_of_ne_zero ha0))
    rw [pow_mul, hyk, ← pow_mul, mul_comm, pow_mul, pow_orderOf_eq_one, one_pow]
  choose! σ κ hσ using hstep
  let c : ℕ → G := fun m => σ^[m] x
  have hcs : ∀ m, c (m + 1) = σ (c m) := fun m => Function.iterate_succ_apply' σ m x
  have hc : ∀ m, c m ∈ A ∧ orderOf (c m) = 0 := by
    intro m
    induction m with
    | zero => exact ⟨hxA, hx0⟩
    | succ m ihm =>
      rw [hcs]
      exact (hσ _ ihm).1
  have hn1 : 1 ≤ n := by
    have := (hσ _ (hc 0)).2.1
    omega
  -- c i ^ (n ^ m) = c (i + m) ^ K with K ≤ (n - 1) ^ m
  have hpow : ∀ i m : ℕ, ∃ K : ℕ, K ≤ (n - 1) ^ m ∧ c i ^ (n ^ m) = c (i + m) ^ K := by
    intro i m
    induction m with
    | zero => exact ⟨1, by simp, by simp⟩
    | succ m ihm =>
      obtain ⟨K, hK, hKe⟩ := ihm
      obtain ⟨-, hkn, hyk⟩ := hσ _ (hc (i + m))
      refine ⟨κ (c (i + m)) * K, ?_, ?_⟩
      · rw [pow_succ']
        exact Nat.mul_le_mul (by omega) hK
      · rw [pow_succ, pow_mul, hKe, ← pow_mul, mul_comm K n, pow_mul, hyk, ← pow_mul,
          show i + (m + 1) = i + m + 1 by omega, hcs]
  have key : ∀ i j : ℕ, i < j → c i = c j → False := by
    intro i j hlt heq
    obtain ⟨K, hK, hKe⟩ := hpow i (j - i)
    rw [show i + (j - i) = j by omega, ← heq] at hKe
    have hlt' : K < n ^ (j - i) :=
      lt_of_le_of_lt hK (Nat.pow_lt_pow_left (by omega) (by omega))
    apply (orderOf_eq_zero_iff'.mp (hc i).2) (n ^ (j - i) - K) (by omega)
    rw [pow_sub _ hlt'.le, hKe, mul_inv_cancel]
  obtain ⟨i, -, j, -, hij, hcij⟩ := Finset.exists_ne_map_eq_of_card_lt_of_maps_to
    (s := Finset.range (A.card + 1)) (t := A) (f := c) (by simp) (fun m _ => (hc m).1)
  rcases lt_or_gt_of_ne hij with h | h
  · exact key i j h hcij
  · exact key j i h hcij.symm

/-- A numbering of the image of `A` in a model pulls back to `A`. -/
lemma pullback {H : Type} [Group H] [DecidableEq H] {N : ℕ} (A : Finset G) (f : G → H)
    (hinj : Set.InjOn f A)
    (hcol : ∀ x ∈ A, ∀ y ∈ A, ∀ r s : ℕ, 1 ≤ r → r ≤ N → 1 ≤ s → s ≤ N →
      x ^ r = y ^ s → f x ^ r = f y ^ s)
    (b : Fin N → H) (hb : Function.Injective b)
    (hbr : Set.range b = ((A.image f : Finset H) : Set H))
    (hbp : Function.Injective (fun i : Fin N => b i ^ (i.val + 1))) :
    ∃ a : Fin N → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin N => a i ^ (i.val + 1)) := by
  have hpre : ∀ i, ∃ x ∈ A, f x = b i := by
    intro i
    have hi : b i ∈ ((A.image f : Finset H) : Set H) := hbr ▸ Set.mem_range_self i
    simpa using hi
  choose a ha hfa using hpre
  refine ⟨a, ?_, ?_, ?_⟩
  · intro i j hij
    apply hb
    rw [← hfa i, ← hfa j, hij]
  · ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ha i
    · intro hx
      have hx' : f x ∈ Set.range b := by
        rw [hbr]
        simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe]
        exact ⟨x, hx, rfl⟩
      obtain ⟨i, hi⟩ := hx'
      exact ⟨i, hinj (ha i) hx (by rw [hfa i, hi])⟩
  · intro i j hij
    apply hbp
    simp only at hij ⊢
    rw [← hfa i, ← hfa j]
    exact hcol _ (ha i) _ (ha j) _ _ (by omega) (by omega) (by omega) (by omega) hij

/-- Peeling: an element that is not blocked takes the top exponent. -/
lemma peel [DecidableEq G] {n : ℕ} (A : Finset G) (b : G) (hbA : b ∈ A)
    (hb : ∀ a ∈ A, a ≠ b → ∀ k : ℕ, 1 ≤ k → k < n + 1 → b ^ (n + 1) ≠ a ^ k)
    (a' : Fin n → G) (ha'inj : Function.Injective a')
    (ha'r : Set.range a' = ((A.erase b : Finset G) : Set G))
    (ha'p : Function.Injective (fun i : Fin n => a' i ^ (i.val + 1))) :
    ∃ a : Fin (n + 1) → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin (n + 1) => a i ^ (i.val + 1)) := by
  have hmem : ∀ i, a' i ∈ A.erase b := fun i => by
    have h : a' i ∈ Set.range a' := Set.mem_range_self i
    rw [ha'r] at h
    exact h
  have hne : ∀ i, a' i ≠ b := fun i => Finset.ne_of_mem_erase (hmem i)
  have hA : ∀ i, a' i ∈ A := fun i => Finset.mem_of_mem_erase (hmem i)
  have hpb : ∀ i : Fin n, b ^ (n + 1) ≠ a' i ^ (i.val + 1) := fun i =>
    hb (a' i) (hA i) (hne i) (i.val + 1) (by omega) (by omega)
  let a : Fin (n + 1) → G := Fin.snoc a' b
  have hlast : a (Fin.last n) = b := Fin.snoc_last (α := fun _ => G) _ _
  have hcast : ∀ i : Fin n, a i.castSucc = a' i := fun i => Fin.snoc_castSucc (α := fun _ => G) _ _ _
  refine ⟨a, ?_, ?_, ?_⟩
  · intro i j hij
    induction i using Fin.lastCases with
    | last =>
      induction j using Fin.lastCases with
      | last => rfl
      | cast j =>
        rw [hlast, hcast] at hij
        exact absurd hij.symm (hne j)
    | cast i =>
      induction j using Fin.lastCases with
      | last =>
        rw [hlast, hcast] at hij
        exact absurd hij (hne i)
      | cast j =>
        rw [hcast, hcast] at hij
        rw [ha'inj hij]
  · ext x
    constructor
    · rintro ⟨i, rfl⟩
      induction i using Fin.lastCases with
      | last => rw [hlast]; exact hbA
      | cast i => rw [hcast]; exact hA i
    · intro hx
      by_cases hxb : x = b
      · exact ⟨Fin.last n, by rw [hlast, hxb]⟩
      · have hx' : x ∈ Set.range a' := by
          rw [ha'r]
          exact Finset.mem_erase.mpr ⟨hxb, hx⟩
        obtain ⟨i, hi⟩ := hx'
        exact ⟨i.castSucc, by rw [hcast, hi]⟩
  · intro i j hij
    simp only at hij
    induction i using Fin.lastCases with
    | last =>
      induction j using Fin.lastCases with
      | last => rfl
      | cast j =>
        rw [hlast, hcast, Fin.val_last, Fin.val_castSucc] at hij
        exact absurd hij (hpb j)
    | cast i =>
      induction j using Fin.lastCases with
      | last =>
        rw [hlast, hcast, Fin.val_last, Fin.val_castSucc] at hij
        exact absurd hij.symm (hpb i)
      | cast j =>
        rw [hcast, hcast, Fin.val_castSucc, Fin.val_castSucc] at hij
        rw [ha'p hij]

end Torsion


/-- The statement for groups in `Type`, from `H1` and `H2`, by induction on `n`. -/
lemma typeVersion (h1 : H1) (h2 : H2) : ∀ (n : ℕ) (G : Type) [Group G],
    (∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) → ∀ A : Finset G, A.card = n →
    ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin n => a i ^ (i.val + 1)) := by
  intro n
  induction n with
  | zero =>
    intro G _ hG A hA
    exact sun_le_three 0 (by norm_num) G hG A hA
  | succ n ih =>
    intro G _ hG A hA
    classical
    by_cases hsmall : n + 1 ≤ 3
    · exact sun_le_three (n + 1) hsmall G hG A hA
    by_cases hfb : ∀ b ∈ A, ∃ a ∈ A, a ≠ b ∧ ∃ k : ℕ, 1 ≤ k ∧ k < n + 1 ∧ b ^ (n + 1) = a ^ k
    · -- fully blocked: realize it in a finite abelian group
      have htor := fb_torsion A hfb
      obtain ⟨H, _, _, f, hinj, hH, hcol⟩ := model hG A htor
      have hcard : (A.image f).card = n + 1 := by rw [Finset.card_image_of_injOn hinj, hA]
      have hfbB : ∀ y ∈ A.image f, ∃ z ∈ A.image f, z ≠ y ∧
          ∃ k : ℕ, 1 ≤ k ∧ k < n + 1 ∧ y ^ (n + 1) = z ^ k := by
        intro y hy
        obtain ⟨b, hbA, rfl⟩ := Finset.mem_image.mp hy
        obtain ⟨a, haA, hab, k, hk1, hkn, hbk⟩ := hfb b hbA
        refine ⟨f a, Finset.mem_image_of_mem f haA, fun h => hab (hinj haA hbA h), k, hk1, hkn, ?_⟩
        exact hcol b hbA a haA (n + 1) k (by omega) le_rfl hk1 (by omega) hbk
      obtain ⟨b, hb, hbr, hbp⟩ : ∃ b : Fin (n + 1) → H, Function.Injective b ∧
          Set.range b = ((A.image f : Finset H) : Set H) ∧
          Function.Injective (fun i : Fin (n + 1) => b i ^ (i.val + 1)) := by
        by_cases h7 : n + 1 ≤ 7
        · exact h1 (n + 1) (by omega) h7 H hH (A.image f) hcard hfbB
        · exact h2 (n + 1) (by omega) H hH (A.image f) hcard hfbB
      exact pullback A f hinj hcol b hb hbr hbp
    · -- some element is not blocked: peel it
      obtain ⟨b, hbA, hb⟩ : ∃ b ∈ A, ∀ a ∈ A, a ≠ b → ∀ k : ℕ, 1 ≤ k → k < n + 1 →
          b ^ (n + 1) ≠ a ^ k := by
        by_contra hc
        apply hfb
        intro b hbA
        by_contra hc'
        apply hc
        refine ⟨b, hbA, ?_⟩
        intro a haA hab k hk1 hkn hbk
        exact hc' ⟨a, haA, hab, k, hk1, hkn, hbk⟩
      have hG' : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1) := by
        intro g hg
        apply hG g
        rw [Finset.mem_Icc] at hg ⊢
        omega
      obtain ⟨a', ha'inj, ha'r, ha'p⟩ :=
        ih G hG' (A.erase b) (by rw [Finset.card_erase_of_mem hbA, hA]; rfl)
      exact peel A b hbA hb a' ha'inj ha'r ha'p

theorem main : H1 → H2 → type_of% @OMA.S_arxiv_1811_10503.main := by
  classical
  intro h1 h2 n hn G _ hord A hA
  -- move to `Type`: the subgroup generated by `A` is a quotient of the free group on `n` letters
  let e : Fin n ≃ A := (Finset.equivFinOfCardEq hA).symm
  let φ : FreeGroup (Fin n) →* G := FreeGroup.lift (fun i => (e i : G))
  let Q := FreeGroup (Fin n) ⧸ φ.ker
  let ι : Q →* G := QuotientGroup.kerLift φ
  have hi : Function.Injective ι := QuotientGroup.kerLift_injective _
  let g (i : Fin n) : Q := QuotientGroup.mk (FreeGroup.of i)
  have he (i : Fin n) : ι (g i) = (e i : G) := by
    change QuotientGroup.kerLift φ (QuotientGroup.mk (FreeGroup.of i)) = _
    rw [QuotientGroup.kerLift_mk]
    exact FreeGroup.lift_apply_of
  have hg : Function.Injective g := by
    intro i j h
    apply e.injective
    apply Subtype.ext
    rw [← he, ← he, h]
  let B := Finset.univ.image g
  have hB : B.card = n := by simp [B, Finset.card_image_of_injective _ hg]
  have hQ (q : Q) : orderOf q ∉ Finset.Icc 2 (n + 1) := by
    rw [← orderOf_injective ι hi]
    exact hord _
  obtain ⟨b, hb, hr, hp⟩ := typeVersion h1 h2 n Q hQ B hB
  refine ⟨ι ∘ b, hi.comp hb, ?_, ?_⟩
  · rw [Set.range_comp, hr]
    ext x
    constructor
    · rintro ⟨q, hq, rfl⟩
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hq
      rw [he]
      exact (e i).property
    · intro hx
      let i := e.symm ⟨x, hx⟩
      refine ⟨g i, Finset.mem_image_of_mem _ (Finset.mem_univ _), ?_⟩
      simp [he, i]
  · intro i j h
    apply hp
    apply hi
    simpa only [map_pow, Function.comp_apply] using h

end OMA.R_arxiv_1811_10503_R2
