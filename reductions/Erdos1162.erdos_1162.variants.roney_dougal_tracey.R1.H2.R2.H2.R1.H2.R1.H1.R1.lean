import OMAReductions.R_Erdos1162_erdos_1162_variants_roney_dougal_tracey_R1_H2_R2_H2_R1_H2_R1

/-! Generation of a finite direct power by conjugate Sylow subgroups. -/

namespace OMA.Erdos1162SolvableGeneration

open Subgroup

/-- A conjugate Sylow generating pair for one group gives such a pair
for every finite direct power, with the same prime. -/
theorem sylow_conjugates_direct_power {S : Type} [Group S] [Finite S]
    {p : ℕ} (hp : p.Prime) (P : Sylow p S) (x : S)
    (h : (P : Subgroup S) ⊔ (P : Subgroup S).map (MulAut.conj x).toMonoidHom = ⊤)
    (n : ℕ) :
    ∃ (Q : Sylow p (Fin n → S)) (y : Fin n → S),
      (Q : Subgroup (Fin n → S)) ⊔
        (Q : Subgroup (Fin n → S)).map (MulAut.conj y).toMonoidHom = ⊤ := by
  classical
  let _ : Fact p.Prime := ⟨hp⟩
  let Q : Subgroup (Fin n → S) := Subgroup.pi Set.univ (fun _ => (P : Subgroup S))
  have memQ (v : Fin n → S) : v ∈ Q ↔ ∀ i, v i ∈ (P : Subgroup S) := by
    simp [Q, Subgroup.mem_pi]
  let e : (Fin n → (P : Subgroup S)) ≃* Q :=
    { toFun := fun v => ⟨fun i => v i, (memQ _).mpr fun i => (v i).2⟩
      invFun := fun v i => ⟨v.1 i, (memQ _).mp v.2 i⟩
      left_inv := fun v => funext fun i => Subtype.ext rfl
      right_inv := fun v => Subtype.ext rfl
      map_mul' := fun a b => Subtype.ext rfl }
  have hQ : IsPGroup p Q := by
    obtain ⟨k,hk⟩ := P.isPGroup'.exists_card_eq
    apply IsPGroup.of_card (n := k*n)
    rw [Nat.card_congr e.symm.toEquiv, Nat.card_fun, Nat.card_fin, hk, pow_mul]
  have hindex : ¬ p ∣ Q.index := by
    intro hd
    have he : Q.index = (P : Subgroup S).index ^ n := by
      rw [Subgroup.index_pi]
      simp
    rw [he] at hd
    exact P.not_dvd_index (hp.dvd_of_dvd_pow hd)
  let y : Fin n → S := fun _ => x
  let L := Q ⊔ Q.map (MulAut.conj y).toMonoidHom
  have hL₁ : Q ≤ L := le_sup_left
  have hL₂ : Q.map (MulAut.conj y).toMonoidHom ≤ L := le_sup_right
  have hsingle (i : Fin n) (a : S) (ha : a ∈ (P : Subgroup S)) :
      Pi.mulSingle (M := fun _ : Fin n => S) i a ∈ Q := by
    apply (memQ _).mpr
    intro j
    by_cases hji : j = i
    · subst j
      simpa using ha
    · simp [Pi.mulSingle_eq_of_ne hji]
  have hsingleL (i : Fin n) (a : S) : Pi.mulSingle (M := fun _ : Fin n => S) i a ∈ L := by
    let f := MonoidHom.mulSingle (fun _ : Fin n => S) i
    have hind : (⊤ : Subgroup S) ≤ L.comap f := by
      rw [← h]
      apply sup_le
      · intro b hb
        exact hL₁ (hsingle i b hb)
      · rintro _ ⟨b,hb,rfl⟩
        apply hL₂
        refine ⟨Pi.mulSingle i b, hsingle i b hb, ?_⟩
        change MulAut.conj y (Pi.mulSingle i b) = Pi.mulSingle i (MulAut.conj x b)
        ext j
        by_cases hij : j = i
        · subst j
          simp [MulAut.conj_apply, y]
        · simp [MulAut.conj_apply, y, Pi.mulSingle_eq_of_ne hij]
    exact hind (Subgroup.mem_top a)
  have htop : L = ⊤ := by
    apply top_le_iff.mp
    intro a _
    exact Subgroup.pi_mem_of_mulSingle_mem a (fun i => hsingleL i (a i))
  exact ⟨hQ.toSylow hindex,y,htop⟩

end OMA.Erdos1162SolvableGeneration

namespace OMA.R_Erdos1162_erdos_1162_variants_roney_dougal_tracey_R1_H2_R2_H2_R1_H2_R1_H1_R1

/-!
Generation by conjugate Sylow subgroups, separated into the alternating and
nonalternating simple-group cases. Section 2 of Aschbacher and Guralnick,
"Solvable generation of groups and Sylow subgroups of the lower central
series", J. Algebra 77 (1982), 189–201, treats the simple-group inputs.
See https://doi.org/10.1016/0021-8693(82)90286-1.
-/

open OMA.Erdos1162SolvableGeneration

private theorem conjugate_sylow_pair_of_mulEquiv {A B : Type} [Group A] [Group B] [Finite B]
    {p : ℕ} (hp : p.Prime) (e : A ≃* B) (P : Sylow p B) (x : B)
    (hP : (P : Subgroup B) ⊔ (P : Subgroup B).map (MulAut.conj x).toMonoidHom = ⊤) :
    ∃ (Q : Sylow p A) (y : A),
      (Q : Subgroup A) ⊔ (Q : Subgroup A).map (MulAut.conj y).toMonoidHom = ⊤ := by
  let _ : Fact p.Prime := ⟨hp⟩
  let f := e.symm.toMonoidHom
  have hf : Function.Surjective f := e.symm.surjective
  have hconj : (MulAut.conj (f x)).toMonoidHom.comp f =
      f.comp (MulAut.conj x).toMonoidHom := by
    ext b
    simp [MulAut.conj_apply, map_mul, map_inv]
  have hmap := congrArg (Subgroup.map f) hP
  rw [Subgroup.map_sup, Subgroup.map_map, ← hconj, ← Subgroup.map_map,
    ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.mpr hf] at hmap
  exact ⟨P.mapSurjective hf, f x, by simpa only [Sylow.coe_mapSurjective] using hmap⟩

/-- Alternating groups are generated by a pair of conjugate Sylow three-subgroups. -/
def H1 : Prop :=
  ∀ d : ℕ, 3 ≤ d →
    ∃ (P : Sylow 3 (alternatingGroup (Fin d))) (x : alternatingGroup (Fin d)),
      (P : Subgroup (alternatingGroup (Fin d))) ⊔
        (P : Subgroup (alternatingGroup (Fin d))).map (MulAut.conj x).toMonoidHom = ⊤

/-- The nonalternating simple groups have a conjugate generating Sylow pair
for some prime, in the group itself. -/
def H2 : Prop :=
  ∀ (S : Type) [Group S] [Finite S] [IsSimpleGroup S],
    ¬ IsMulCommutative S →
    (¬ ∃ d : ℕ, 3 ≤ d ∧ Nonempty (S ≃* alternatingGroup (Fin d))) →
    ∃ p : ℕ, p.Prime ∧ ∃ (P : Sylow p S) (x : S),
      (P : Subgroup S) ⊔ (P : Subgroup S).map (MulAut.conj x).toMonoidHom = ⊤

theorem main : H1 → H2 → OMA.R_Erdos1162_erdos_1162_variants_roney_dougal_tracey_R1_H2_R2_H2_R1_H2_R1.H1 := by

  intro hAlt hOther S _ _ _ hS n
  by_cases hs : ∃ d : ℕ, 3 ≤ d ∧ Nonempty (S ≃* alternatingGroup (Fin d))
  · obtain ⟨d, hd, ⟨e⟩⟩ := hs
    obtain ⟨P, x, hP⟩ := hAlt d hd
    have hthree : Nat.Prime 3 := by decide
    obtain ⟨Q, y, hQ⟩ := conjugate_sylow_pair_of_mulEquiv hthree e P x hP
    exact ⟨3, hthree, sylow_conjugates_direct_power hthree Q y hQ n⟩
  · obtain ⟨p, hp, P, x, hP⟩ := hOther S hS hs
    exact ⟨p, hp, sylow_conjugates_direct_power hp P x hP n⟩

end OMA.R_Erdos1162_erdos_1162_variants_roney_dougal_tracey_R1_H2_R2_H2_R1_H2_R1_H1_R1
