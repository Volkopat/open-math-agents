/-- Splitting the optional first datum of an order-three template. -/
theorem card_option_split {X : Type*} [Finite X] (A : X → Type*) (B : X → Type*)
    [∀ x, Finite (A x)] [∀ x, Finite (B x)] :
    Nat.card (Σ x, Option (A x) × B x) = Nat.card (Σ x, B x) + Nat.card (Σ x, A x × B x) := by
  have : Fintype X := Fintype.ofFinite X
  rw [Nat.card_sigma, Nat.card_sigma, Nat.card_sigma, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Nat.card_prod, Nat.card_prod, Finite.card_option]
  ring

/-- Adding two moment bounds costs a constant in the linear term. -/
theorem sum_moment {P Q E b C1 C2 C : ℕ} (hP : P ^ 27 * 2 ^ (8 * b ^ 2) ≤ 2 ^ (E + C1 * (b + 1)))
    (hQ : Q ^ 27 * 2 ^ (8 * b ^ 2) ≤ 2 ^ (E + C2 * (b + 1))) (hC1 : C1 + 27 ≤ C)
    (hC2 : C2 + 27 ≤ C) :
    (P + Q) ^ 27 * 2 ^ (8 * b ^ 2) ≤ 2 ^ (E + C * (b + 1)) := by
  wlog hPQ : Q ≤ P generalizing P Q C1 C2
  · rw [add_comm]
    exact this hQ hP hC2 hC1 (by omega)
  have h1 : (P + Q) ^ 27 ≤ 2 ^ 27 * P ^ 27 := by
    rw [← mul_pow]
    exact Nat.pow_le_pow_left (by omega) 27
  have h2 : C1 * (b + 1) + 27 ≤ C * (b + 1) := by nlinarith
  calc (P + Q) ^ 27 * 2 ^ (8 * b ^ 2) ≤ 2 ^ 27 * P ^ 27 * 2 ^ (8 * b ^ 2) :=
        Nat.mul_le_mul_right _ h1
    _ = 2 ^ 27 * (P ^ 27 * 2 ^ (8 * b ^ 2)) := by ring
    _ ≤ 2 ^ 27 * 2 ^ (E + C1 * (b + 1)) := Nat.mul_le_mul_left _ hP
    _ = 2 ^ (E + (C1 * (b + 1) + 27)) := by rw [← pow_add]; ring_nf
    _ ≤ 2 ^ (E + C * (b + 1)) := Nat.pow_le_pow_right (by norm_num) (by omega)

/-- Cofactors other than `q' = 3, s = 2`: the quotient of order `2^c q'` is generated by
`c + Ω(q') ≤ c + s - 2` elements, and the plain moment H1 bounds the templates. -/
theorem case_omega (h1 : H1) (a s q' : ℕ) (hodd : Odd q') (hs : 3 ≤ s) (hq : q' < 2 ^ s) :
    ∃ C : ℕ, ∃ M : ℕ → ℕ → ℕ, (∀ k c, c ≤ q'.factorial →
      M k c ^ 27 * 2 ^ (8 * (k + a - c) ^ 2) ≤
        2 ^ (2 * (k + a - c) ^ 3 + 6 * (c + s - 2) * (k + a - c) ^ 2 + C * (k + a - c + 1))) ∧
      ∀ k, g (2 ^ k * (2 ^ a * q')) ≤ (∑ c ∈ Finset.range (q'.factorial + 1),
        g (2 ^ c * q') * M k c) * 2 ^ ((k + a) * (2 ^ q'.factorial * q') ^ 2) := by
  classical
  choose Cf hCf using h1
  refine ⟨∑ c ∈ Finset.range (q'.factorial + 1), Cf (c + s - 2),
    fun k c => Nat.card (Σ x : ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = 2 ^ (k + a - c)}),
      (Fin (c + s - 2) → MulAut (Quotient.out x.1 : FiniteGrp.{0}))), ?_, ?_⟩
  · intro k c hc
    refine (hCf (c + s - 2) (k + a - c)).trans (Nat.pow_le_pow_right (by norm_num) ?_)
    apply Nat.add_le_add_left
    apply Nat.mul_le_mul_right
    exact Finset.single_le_sum (f := fun c => Cf (c + s - 2)) (fun _ _ => Nat.zero_le _)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hc))
  · intro k
    have hgen : ∀ (c : ℕ) (y : ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {X : FiniteGrp.{0} | Nat.card X = 2 ^ c * q'})),
        ∃ gen : Fin (c + s - 2) → (Quotient.out y.1 : FiniteGrp.{0}),
          Subgroup.closure (Set.range gen) = ⊤ := by
      intro c y
      apply exists_gen_omega
      rw [card_out y.2, ArithmeticFunction.cardFactors_mul (by positivity) hodd.pos.ne',
        ArithmeticFunction.cardFactors_apply_prime_pow Nat.prime_two]
      have := cardFactors_odd_le hodd hs hq
      omega
    choose gen hgen using hgen
    have hsurj : ∀ c y, Function.Surjective (FreeGroup.lift (gen c y)) := fun c y =>
      FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr (hgen c y)
    refine generic_templates (2 ^ k * (2 ^ a * q')) q'.factorial (k + a) q' (fun c => c + s - 2)
      (fun c x => Fin (c + s - 2) → MulAut (Quotient.out x.1 : FiniteGrp.{0})) gen hsurj
      (fun c x e => e) ?_
    intro G hG
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨c, hcL, -, xN, hxN, xH, hxH, S, -⟩ :=
      cover hodd G (Classical.arbitrary (Sylow 2 G)) hG
    exact ⟨c, hcL, ⟨xN, hxN⟩, ⟨xH, hxH⟩,
      fun i => S.conjAct (Function.surjInv S.rightHom_surjective (gen c ⟨xH, hxH⟩ i)), S,
      fun i => Function.surjInv S.rightHom_surjective (gen c ⟨xH, hxH⟩ i),
      fun i => Function.surjInv_eq _ _, fun i => rfl⟩

/-- The cofactor `q' = 3` with `s = 2`. The quotient is generated by an element `γ` of order
three and `c` further elements. The element `γ` lifts to an element of order dividing three,
whose automorphism of the kernel is trivial or, after relabeling the kernel, the chosen
representative of its conjugacy class. The plain moment H1 and the order-three moment H2
bound the templates. -/
theorem case_three (h1 : H1) (h2 : H2) (a : ℕ) :
    ∃ C : ℕ, ∃ M : ℕ → ℕ → ℕ, (∀ k c, c ≤ (3 : ℕ).factorial →
      M k c ^ 27 * 2 ^ (8 * (k + a - c) ^ 2) ≤
        2 ^ (2 * (k + a - c) ^ 3 + 6 * (c + 2 - 2) * (k + a - c) ^ 2 + C * (k + a - c + 1))) ∧
      ∀ k, g (2 ^ k * (2 ^ a * 3)) ≤ (∑ c ∈ Finset.range ((3 : ℕ).factorial + 1),
        g (2 ^ c * 3) * M k c) * 2 ^ ((k + a) * (2 ^ (3 : ℕ).factorial * 3) ^ 2) := by
  classical
  choose Cf hCf using h1
  choose Cg hCg using h2
  refine ⟨∑ c ∈ Finset.range ((3 : ℕ).factorial + 1), (Cf c + Cg c) + 27,
    fun k c => Nat.card (Σ x : ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = 2 ^ (k + a - c)}),
      Option {cl : ConjClasses (MulAut (Quotient.out x.1 : FiniteGrp.{0})) //
        ∃ α : MulAut (Quotient.out x.1 : FiniteGrp.{0}),
          ConjClasses.mk α = cl ∧ α ≠ 1 ∧ α ^ 3 = 1} ×
      (Fin c → MulAut (Quotient.out x.1 : FiniteGrp.{0}))), ?_, ?_⟩
  · intro k c hc
    have hfin : Finite ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = 2 ^ (k + a - c)}) := (classes_finite _).to_subtype
    dsimp only
    rw [Nat.add_sub_cancel, card_option_split]
    have hle : Cf c + Cg c ≤ ∑ c ∈ Finset.range ((3 : ℕ).factorial + 1), (Cf c + Cg c) :=
      Finset.single_le_sum (f := fun c => Cf c + Cg c) (fun _ _ => Nat.zero_le _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hc))
    exact sum_moment (hCf c (k + a - c)) (hCg c (k + a - c)) (by omega) (by omega)
  · intro k
    have hgen : ∀ (c : ℕ) (y : ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {X : FiniteGrp.{0} | Nat.card X = 2 ^ c * 3})),
        ∃ gen : Fin (c + 1) → (Quotient.out y.1 : FiniteGrp.{0}),
          Subgroup.closure (Set.range gen) = ⊤ ∧ gen 0 ^ 3 = 1 := by
      intro c y
      have hcard := card_out y.2
      haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
      letI : Fintype (Quotient.out y.1 : FiniteGrp.{0}) := Fintype.ofFinite _
      obtain ⟨γ, hγ⟩ := exists_prime_orderOf_dvd_card
        (G := (Quotient.out y.1 : FiniteGrp.{0})) 3
        (by rw [← Nat.card_eq_fintype_card, hcard]; exact Dvd.intro_left _ rfl)
      have hidx : (Subgroup.zpowers γ).index = 2 ^ c := by
        have := Subgroup.index_mul_card (Subgroup.zpowers γ)
        rw [Nat.card_zpowers, hγ, hcard] at this
        omega
      obtain ⟨gen', hgen'⟩ := exists_gen_aux _ (Subgroup.zpowers γ) le_rfl c
        (by rw [hidx, Nat.log_pow (by norm_num)])
      refine ⟨Fin.cons γ gen', ?_, ?_⟩
      · rw [eq_top_iff, ← hgen']
        refine sup_le ?_ ?_
        · rw [Subgroup.zpowers_le]
          exact Subgroup.subset_closure ⟨0, rfl⟩
        · refine Subgroup.closure_mono ?_
          rintro _ ⟨i, rfl⟩
          exact ⟨i.succ, rfl⟩
      · simp only [Fin.cons_zero]
        have hp := pow_orderOf_eq_one γ
        rwa [hγ] at hp
    choose gen hgen h0 using hgen
    have hsurj : ∀ c y, Function.Surjective (FreeGroup.lift (gen c y)) := fun c y =>
      FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr (hgen c y)
    refine generic_templates (2 ^ k * (2 ^ a * 3)) (3 : ℕ).factorial (k + a) 3 (fun c => c + 1)
      (fun c x => Option {cl : ConjClasses (MulAut (Quotient.out x.1 : FiniteGrp.{0})) //
        ∃ α : MulAut (Quotient.out x.1 : FiniteGrp.{0}),
          ConjClasses.mk α = cl ∧ α ≠ 1 ∧ α ^ 3 = 1} ×
        (Fin c → MulAut (Quotient.out x.1 : FiniteGrp.{0}))) gen hsurj
      (fun c x e => Fin.cons (Option.elim e.1 1 (fun cl => Classical.choose cl.2)) e.2) ?_
    intro G hG
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨c, hcL, -, xN, hxN, xH, hxH, S, -⟩ :=
      cover (by decide : Odd 3) G (Classical.arbitrary (Sylow 2 G)) hG
    have hN := card_out hxN
    obtain ⟨e0, he03, he0⟩ :=
      exists_lift_pow_three S (k + a - c) hN (gen c ⟨xH, hxH⟩ 0) (h0 c ⟨xH, hxH⟩)
    have hα3 : S.conjAct e0 ^ 3 = 1 := by rw [← map_pow, he03, map_one]
    by_cases hα : S.conjAct e0 = 1
    · refine ⟨c, hcL, ⟨xN, hxN⟩, ⟨xH, hxH⟩,
        (none, fun i => S.conjAct
          (Function.surjInv S.rightHom_surjective (gen c ⟨xH, hxH⟩ i.succ))), S,
        Fin.cons e0 (fun i => Function.surjInv S.rightHom_surjective (gen c ⟨xH, hxH⟩ i.succ)),
        ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simpa using he0
        · simp only [Fin.cons_succ]
          exact Function.surjInv_eq _ _
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simpa using hα
        · simp only [Fin.cons_succ]
    · have hex : ∃ α : MulAut (Quotient.out xN : FiniteGrp.{0}),
          ConjClasses.mk α = ConjClasses.mk (S.conjAct e0) ∧ α ≠ 1 ∧ α ^ 3 = 1 :=
        ⟨S.conjAct e0, rfl, hα, hα3⟩
      obtain ⟨φ, hφ⟩ := isConj_iff.mp
        ((ConjClasses.mk_eq_mk_iff_isConj).mp (Classical.choose_spec hex).1).symm
      obtain ⟨S', hS'r, hS'c⟩ := exists_twist S φ
      have hsurj' : Function.Surjective S'.rightHom := S'.rightHom_surjective
      refine ⟨c, hcL, ⟨xN, hxN⟩, ⟨xH, hxH⟩,
        (some ⟨ConjClasses.mk (S.conjAct e0), hex⟩, fun i => S'.conjAct
          (Function.surjInv hsurj' (gen c ⟨xH, hxH⟩ i.succ))), S',
        Fin.cons e0 (fun i => Function.surjInv hsurj' (gen c ⟨xH, hxH⟩ i.succ)), ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cons_zero]
          rw [hS'r]
          exact he0
        · simp only [Fin.cons_succ]
          exact Function.surjInv_eq _ _
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cons_zero]
          show S'.conjAct e0 = Classical.choose hex
          rw [hS'c, hφ]
        · simp only [Fin.cons_succ]

theorem main_thm (h1 : H1) (h2 : H2) (h3 : H3) : ∀ r q : ℕ, 0 < r → q < 2 ^ r →
    (∀ j : ℕ, q ≠ 2 ^ j) → ∀ᶠ k : ℕ in atTop,
      2 ^ (r + 2) * g (2 ^ k * q) ≤ g (2 ^ (k + r - 1)) := by
  intro r q hr hqr hnp
  rcases Nat.eq_zero_or_pos q with rfl | hq
  · exact Filter.Eventually.of_forall fun k => by
      rw [mul_zero, g_zero, mul_zero]
      exact Nat.zero_le _
  obtain ⟨a, q', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hq.ne'
  have hq'1 : q' ≠ 1 := fun h => hnp a (by rw [h, mul_one])
  have hq'3 : 3 ≤ q' := by
    obtain ⟨m, rfl⟩ := hodd
    omega
  have har : a < r := by
    by_contra hcon
    have e1 : 2 ^ r ≤ 2 ^ a := Nat.pow_le_pow_right (by norm_num) (by omega)
    have e2 : 2 ^ a ≤ 2 ^ a * q' := Nat.le_mul_of_pos_right _ (by omega)
    omega
  obtain ⟨s, rfl⟩ : ∃ s, r = a + s := ⟨r - a, by omega⟩
  have hq's : q' < 2 ^ s := by
    have e1 : 2 ^ a * q' < 2 ^ a * 2 ^ s := by rw [← pow_add]; exact hqr
    exact Nat.lt_of_mul_lt_mul_left e1
  have hs2 : 2 ≤ s := by
    by_contra hcon
    have : 2 ^ s ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  obtain ⟨C, M, hM, hcount⟩ : ∃ C : ℕ, ∃ M : ℕ → ℕ → ℕ, (∀ k c, c ≤ q'.factorial →
      M k c ^ 27 * 2 ^ (8 * (k + a - c) ^ 2) ≤
        2 ^ (2 * (k + a - c) ^ 3 + 6 * (c + s - 2) * (k + a - c) ^ 2 + C * (k + a - c + 1))) ∧
      ∀ k, g (2 ^ k * (2 ^ a * q')) ≤ (∑ c ∈ Finset.range (q'.factorial + 1),
        g (2 ^ c * q') * M k c) * 2 ^ ((k + a) * (2 ^ q'.factorial * q') ^ 2) := by
    by_cases hc : s = 2 ∧ q' = 3
    · obtain ⟨rfl, rfl⟩ := hc
      exact case_three h1 h2 a
    · have hs3 : 3 ≤ s := by
        by_contra hcon
        have hs : s = 2 := by omega
        subst hs
        apply hc
        refine ⟨rfl, ?_⟩
        have e1 : q' < 4 := by simpa using hq's
        obtain ⟨m, rfl⟩ := hodd
        omega
