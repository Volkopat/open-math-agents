import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R1_H1_R1_H2_R1

-- Reduction Erdos1160.erdos_1160.variants.sum.R1.H1.R1.H2.R1.H2.R1 of step Erdos1160.erdos_1160.variants.sum.R1.H1.R1.H2.R1.H2
-- Credit: @maxko87

/-!
Bounded deficit by templates, following Li and Qiao, arXiv:2610.14509, Section 15
(Lemmas 15.2, 15.4, 15.5 and Corollary 1.5, which gives F(x) ~ f(2^floor(log2 x))).

Write q = 2^a q' with q' odd, so q' >= 3 and q' < 2^s where r = a + s, s >= 2. A group G of
order 2^k q is an extension of the normal core N of a Sylow 2-subgroup (order 2^(k+a-c)) by a
quotient H of order 2^c q', c <= q'!. Counting extensions by templates (kernel class, quotient
class, automorphisms attached to a generating tuple of H, central factor sets) gives
g(2^k q) <= sum_c g(2^c q') * M_c * 2^((k+a)(2^(q'!) q')^2), where M_c counts the
automorphism data over the classes N. Against Higman's bound for g(2^(k+r-1)) this closes as
soon as the automorphism data cost at most c + s - 2 free automorphisms (the moment exponent
is then 2b^3 + 6(S-1)b^2 - 8b^2 against 2(b+S)^3 - 13(b+S)^2 with S = c + s - 1).

* If s >= 3, H is generated by c + Omega(q') <= c + s - 2 elements (3^Omega(q') <= q' < 2^s),
  and the plain automorphism moment H1 suffices.
* If s = 2 (so q' = 3, the family q = 3 * 2^(r-2), where the plain moment ties at the
  quadratic level), H is generated by an element of order three and c more elements. The
  element of order three lifts to an element of G of order dividing three; its automorphism of
  N is trivial or, after relabeling N, the fixed representative of its conjugacy class in
  Aut N. The count of these classes is the order-three moment H2 (Li and Qiao handle the odd
  first generator in the same way, Lemma 15.4, weighting it by a(N) only).

H3 is Higman's lower bound, the statement of R3.H2.R1.H2.R2.H4 (merged proof, PR 393 by
@kamaleshanantha retargeted). The template machinery (cover, generators, poly_ineq) is
copied from reduction R3.H2.R1.H2.R2 (PR 9599), the counting from reduction R3.H2.R1
(PR 1719), and the factor-set encoding from the proof of R3.H2.R1.H1 by @ahmeterdempmk
(PR 5770).
-/

open CategoryTheory Filter Erdos1160

namespace OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H1_R1_H2_R1_H2_R1

/-- Automorphism moment of 2-groups (all classes of 2-groups of order `2^b`, weighted by
`|Aut N|^t`): the bound announced by Li and Qiao (arXiv:2610.14509, Lemma 15.5) with the
weakened quadratic coefficient used in reduction R3.H2.R1.H2.R2 (this is the conclusion of
its theorem `total_moment`, obtained there from its hypotheses H1, H2, H3). -/
def H1 : Prop := ∀ t : ℕ, ∃ C : ℕ, ∀ b : ℕ,
  Nat.card (Σ x : (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = 2 ^ b}),
      (Fin t → MulAut (Quotient.out x.1 : FiniteGrp.{0}))) ^ 27 * 2 ^ (8 * b ^ 2) ≤
    2 ^ (2 * b ^ 3 + 6 * t * b ^ 2 + C * (b + 1))

/-- Order-three moment of 2-groups: the classes of 2-groups of order `2^b`, each weighted by
the number of conjugacy classes of nontrivial automorphisms of order dividing three, times
`|Aut N|^t`, satisfy the same bound as the plain moment H1. An automorphism of odd order is
determined up to conjugacy by its image on the Frattini quotient (Sylow conjugacy in the
preimage), so this follows from Li and Qiao, Lemma 15.5, where the first generator of odd
prime order carries the weight a(N) only. -/
def H2 : Prop := ∀ t : ℕ, ∃ C : ℕ, ∀ b : ℕ,
  Nat.card (Σ x : (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = 2 ^ b}),
      {c : ConjClasses (MulAut (Quotient.out x.1 : FiniteGrp.{0})) //
        ∃ α : MulAut (Quotient.out x.1 : FiniteGrp.{0}),
          ConjClasses.mk α = c ∧ α ≠ 1 ∧ α ^ 3 = 1} ×
      (Fin t → MulAut (Quotient.out x.1 : FiniteGrp.{0}))) ^ 27 * 2 ^ (8 * b ^ 2) ≤
    2 ^ (2 * b ^ 3 + 6 * t * b ^ 2 + C * (b + 1))

/-- Higman's lower bound for the number of groups of order `2^m` (the statement of
R3.H2.R1.H2.R2.H4, proved in the merged proof of that step, PR 393 retargeted). -/
def H3 : Prop := ∀ᶠ m : ℕ in atTop, 2 ^ (2 * m ^ 3) ≤ g (2 ^ m) ^ 27 * 2 ^ (13 * m ^ 2)

/-- An isomorphism in `FiniteGrp` gives a group isomorphism. -/
theorem nonempty_mulEquiv_of_iso {X Y : FiniteGrp.{0}} (i : X ≅ Y) : Nonempty (X ≃* Y) :=
  ⟨Iso.groupIsoToMulEquiv ((inducedFunctor FiniteGrp.toGrp).mapIso i)⟩

/-- The chosen representative of a class of groups of order `n` has order `n`. -/
theorem card_out {n : ℕ} {x : Quotient (isIsomorphicSetoid FiniteGrp.{0})}
    (hx : x ∈ Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = n}) :
    Nat.card (Quotient.out x : FiniteGrp.{0}) = n := by
  obtain ⟨G, hG, rfl⟩ := hx
  have h : Nonempty (Quotient.out (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) G) ≅ G) :=
    Quotient.mk_out (s := isIsomorphicSetoid FiniteGrp.{0}) G
  obtain ⟨i⟩ := h
  obtain ⟨e⟩ := nonempty_mulEquiv_of_iso i
  rw [Nat.card_congr e.toEquiv]
  exact hG

/-- There are finitely many classes of groups of order `n`. -/
theorem classes_finite (n : ℕ) :
    (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = n}).Finite := by
  classical
  set S := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = n} with hS
  let e : ∀ x : S, (Quotient.out x.1 : FiniteGrp.{0}) ≃ Fin n := fun x =>
    (Finite.equivFin _).trans (finCongr (card_out x.2))
  let tab : S → Fin n → Fin n → Fin n := fun x a b => e x ((e x).symm a * (e x).symm b)
  have hinj : Function.Injective tab := by
    intro x y hxy
    let f : (Quotient.out x.1 : FiniteGrp.{0}) ≃* (Quotient.out y.1 : FiniteGrp.{0}) :=
      { toEquiv := (e x).trans (e y).symm
        map_mul' := fun a b => by
          have h := congrFun (congrFun hxy (e x a)) (e x b)
          simp only [tab, Equiv.symm_apply_apply] at h
          show (e y).symm (e x (a * b)) = (e y).symm (e x a) * (e y).symm (e x b)
          rw [h, Equiv.symm_apply_apply] }
    apply Subtype.ext
    calc x.1 = Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) (Quotient.out x.1) :=
          (Quotient.out_eq _).symm
      _ = Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) (Quotient.out y.1) :=
          Quotient.sound ⟨InducedCategory.isoMk (MulEquiv.toGrpIso
            (X := (Quotient.out x.1).toGrp) (Y := (Quotient.out y.1).toGrp) f)⟩
      _ = y.1 := Quotient.out_eq _
  have : Finite S := Finite.of_injective tab hinj
  exact Set.toFinite S

/-- Conjugating by the image of `n` acts on the kernel as the inner automorphism of `n`. -/
theorem conjAct_inl {N E G : Type*} [Group N] [Group E] [Group G]
    (S : GroupExtension N E G) (n : N) : S.conjAct (S.inl n) = MulAut.conj n := by
  refine MulEquiv.ext fun x => ?_
  apply S.inl_injective
  rw [GroupExtension.inl_conjAct_comm, MulAut.conj_apply, map_mul S.inl, map_mul S.inl,
    map_inv S.inl]

/-- Two extensions with sections inducing the same automorphisms of the kernel and the
same factor set are equivalent. (Proof by @ahmeterdempmk, PR 5770.) -/
theorem equiv_of_factor {N G E E' : Type*} [Group N] [Group G] [Group E] [Group E']
    (S : GroupExtension N E G) (S' : GroupExtension N E' G) (s : G → E) (s' : G → E')
    (hs : ∀ g, S.rightHom (s g) = g) (hs' : ∀ g, S'.rightHom (s' g) = g)
    (hc : ∀ g, S.conjAct (s g) = S'.conjAct (s' g)) (f : G → G → N)
    (hf : ∀ a b, S.inl (f a b) = s a * s b * (s (a * b))⁻¹)
    (hf' : ∀ a b, S'.inl (f a b) = s' a * s' b * (s' (a * b))⁻¹) :
    Nonempty (S.Equiv S') := by
  have hmem : ∀ x : E, ∃ n : N, S.inl n = x * (s (S.rightHom x))⁻¹ := by
    intro x
    have hx : x * (s (S.rightHom x))⁻¹ ∈ S.rightHom.ker := by
      rw [MonoidHom.mem_ker, map_mul S.rightHom, map_inv S.rightHom, hs, mul_inv_cancel]
    rw [← S.range_inl_eq_ker_rightHom] at hx
    exact MonoidHom.mem_range.mp hx
  choose ν hν using hmem
  have key : ∀ x y : E, ν (x * y) =
      ν x * S.conjAct (s (S.rightHom x)) (ν y) * f (S.rightHom x) (S.rightHom y) := by
    intro x y
    apply S.inl_injective
    rw [map_mul S.inl, map_mul S.inl, hν (x * y), hν x, hf, S.inl_conjAct_comm, hν y,
      map_mul S.rightHom]
    group
  have hψ : ∀ x y : E, S'.inl (ν (x * y)) * s' (S.rightHom (x * y)) =
      S'.inl (ν x) * s' (S.rightHom x) * (S'.inl (ν y) * s' (S.rightHom y)) := by
    intro x y
    rw [key x y, map_mul S.rightHom, map_mul S'.inl, map_mul S'.inl, hc, S'.inl_conjAct_comm,
      hf']
    group
  have e1 : S.inl (f 1 1) = s 1 := by
    rw [hf, mul_one (1 : G), mul_inv_cancel_right]
  have e1' : S'.inl (f 1 1) = s' 1 := by
    rw [hf', mul_one (1 : G), mul_inv_cancel_right]
  refine ⟨GroupExtension.Equiv.ofMonoidHom
    (MonoidHom.mk' (fun x => S'.inl (ν x) * s' (S.rightHom x)) hψ) ?_ ?_⟩
  · refine MonoidHom.ext fun n => ?_
    show S'.inl (ν (S.inl n)) * s' (S.rightHom (S.inl n)) = S'.inl n
    have e2 : ν (S.inl n) = n * (f 1 1)⁻¹ := by
      apply S.inl_injective
      rw [hν, S.rightHom_inl, map_mul S.inl, map_inv S.inl, e1]
    rw [e2, S.rightHom_inl, map_mul S'.inl, map_inv S'.inl, e1', inv_mul_cancel_right]
  · refine MonoidHom.ext fun x => ?_
    show S'.rightHom (S'.inl (ν x) * s' (S.rightHom x)) = S.rightHom x
    rw [map_mul S'.rightHom, S'.rightHom_inl, one_mul, hs']

/-- With kernel, quotient and outer action fixed, inequivalent extensions inject into the
central factor sets. (The statement of R3.H2.R1.H1; proof by @ahmeterdempmk, PR 5770.) -/
theorem encode_ext : ∀ (N H : FiniteGrp.{0}) (I : Type 1) (D : I → FiniteGrp.{0})
    (S : ∀ i, GroupExtension N (D i) H) (action : H → MulAut N),
    (∀ i h, ∃ e : D i, ∃ n : N, (S i).rightHom e = h ∧
      MulAut.conj n * (S i).conjAct e = action h) →
    (∀ i j, Nonempty ((S i).Equiv (S j)) → i = j) →
    Nonempty (I ↪ (H × H → Subgroup.center N)) := by
  intro N H I D S action hact hinj
  classical
  obtain ⟨s, hs, hc⟩ : ∃ s : ∀ i, H → D i, (∀ i h, (S i).rightHom (s i h) = h) ∧
      (∀ i h, (S i).conjAct (s i h) = action h) := by
    choose e n he hn using hact
    refine ⟨fun i h => (S i).inl (n i h) * e i h, ?_, ?_⟩
    · intro i h
      show (S i).rightHom ((S i).inl (n i h) * e i h) = h
      rw [map_mul (S i).rightHom, GroupExtension.rightHom_inl, one_mul, he]
    · intro i h
      show (S i).conjAct ((S i).inl (n i h) * e i h) = action h
      rw [map_mul (S i).conjAct, conjAct_inl, hn]
  have hfac : ∀ i a b, ∃ m : N, (S i).inl m = s i a * s i b * (s i (a * b))⁻¹ := by
    intro i a b
    have hm : s i a * s i b * (s i (a * b))⁻¹ ∈ (S i).rightHom.ker := by
      rw [MonoidHom.mem_ker, map_mul (S i).rightHom, map_mul (S i).rightHom,
        map_inv (S i).rightHom, hs, hs, hs, mul_inv_cancel]
    rw [← (S i).range_inl_eq_ker_rightHom] at hm
    exact MonoidHom.mem_range.mp hm
  choose f hf using hfac
  have hconj : ∀ i a b, MulAut.conj (f i a b) = action a * action b * (action (a * b))⁻¹ := by
    intro i a b
    rw [← conjAct_inl (S i), hf, map_mul (S i).conjAct, map_mul (S i).conjAct,
      map_inv (S i).conjAct, hc, hc, hc]
  rcases isEmpty_or_nonempty I with hI | ⟨⟨i₀⟩⟩
  · exact ⟨Function.Embedding.ofIsEmpty⟩
  · have hcen : ∀ i a b, f i a b * (f i₀ a b)⁻¹ ∈ Subgroup.center N := by
      intro i a b
      rw [Subgroup.mem_center_iff]
      intro g
      have h1 : MulAut.conj (f i a b * (f i₀ a b)⁻¹) = 1 := by
        rw [map_mul MulAut.conj, map_inv MulAut.conj, hconj, hconj, mul_inv_cancel]
      have h2 := DFunLike.congr_fun h1 g
      rw [MulAut.conj_apply, MulAut.one_apply, mul_inv_eq_iff_eq_mul] at h2
      exact h2.symm
    refine ⟨⟨fun i p => ⟨f i p.1 p.2 * (f i₀ p.1 p.2)⁻¹, hcen i p.1 p.2⟩, ?_⟩⟩
    intro i j hij
    apply hinj
    have hfij : ∀ a b, f i a b = f j a b := by
      intro a b
      have h3 : (f i a b * (f i₀ a b)⁻¹ : N) = f j a b * (f i₀ a b)⁻¹ :=
        congrArg Subtype.val (congrFun hij (a, b))
      exact mul_right_cancel h3
    exact equiv_of_factor (S i) (S j) (s i) (s j) (hs i) (hs j)
      (fun g => (hc i g).trans (hc j g).symm) (f i) (hf i)
      (fun a b => by rw [hfij a b]; exact hf j a b)

/-- Counting groups of order `n` by templates (kernel, quotient, lifted outer action):
each template carries at most `|Z(N)|^(|H|^2)` classes. Adapted from the main theorem of
reduction R3.H2.R1. -/
theorem count_by_templates {I : Type*} [Fintype I] (N H : I → FiniteGrp.{0})
    (action : ∀ i, H i → MulAut (N i)) (n : ℕ)
    (covered : ∀ G : FiniteGrp.{0}, Nat.card G = n → ∃ i, ∃ S : GroupExtension (N i) G (H i),
      ∀ h, ∃ e : G, ∃ m : N i, S.rightHom e = h ∧ MulAut.conj m * S.conjAct e = action i h) :
    g n ≤ ∑ i, Nat.card (Subgroup.center (N i)) ^ (Nat.card (H i) ^ 2) := by
  classical
  let C := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = n}
  let rep (x : C) : FiniteGrp.{0} := x.property.choose
  have spec (x : C) : Nat.card (rep x) = n ∧
      Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) (rep x) = x.val := x.property.choose_spec
  have assign (x : C) := covered (rep x) (spec x).1
  let j (x : C) : I := (assign x).choose
  let F (i : I) := {x : C // j x = i}
  have encode (i : I) : Nonempty (F i ↪ (H i × H i → Subgroup.center (N i))) := by
    have data (x : F i) : ∃ S : GroupExtension (N i) (rep x.val) (H i),
        ∀ h, ∃ e : rep x.val, ∃ m : N i, S.rightHom e = h ∧
          MulAut.conj m * S.conjAct e = action i h := by
      obtain ⟨z, rfl⟩ := x
      exact (assign z).choose_spec
    choose seq hseq using data
    apply encode_ext (N i) (H i) (F i) (fun x => rep x.val) seq (action i) hseq
    intro x y hxy
    obtain ⟨e⟩ := hxy
    apply Subtype.ext
    apply Subtype.ext
    rw [← (spec x.val).2, ← (spec y.val).2]
    exact Quotient.sound ⟨InducedCategory.isoMk (F := FiniteGrp.toGrp)
      (MulEquiv.toGrpIso (X := (rep x.val).toGrp) (Y := (rep y.val).toGrp) e.toMulEquiv)⟩
  have hfin (i : I) : Finite (F i) := Finite.of_injective _ (encode i).some.injective
  calc
    g n = Nat.card C := rfl
    _ = Nat.card ((i : I) × F i) := (Nat.card_congr (Equiv.sigmaFiberEquiv j)).symm
    _ = ∑ i, Nat.card (F i) := Nat.card_sigma
    _ ≤ ∑ i, Nat.card (Subgroup.center (N i)) ^ (Nat.card (H i) ^ 2) := by
      apply Finset.sum_le_sum
      intro i _
      have hb := Nat.card_le_card_of_injective _ (encode i).some.injective
      simpa only [Nat.card_fun, Nat.card_prod, pow_two] using hb


/-- A finite group is generated, over any subgroup `K`, by `log₂ [G : K]` elements.
(Copied from reduction R3.H2.R1.H2.R2.) -/
theorem exists_gen_aux {H : Type*} [Group H] [Finite H] :
    ∀ (n : ℕ) (K : Subgroup H), K.index ≤ n → ∀ m : ℕ, Nat.log 2 K.index ≤ m →
      ∃ gen : Fin m → H, K ⊔ Subgroup.closure (Set.range gen) = ⊤ := by
  intro n
  induction n with
  | zero =>
    intro K hK
    exact absurd (Nat.le_zero.mp hK) Subgroup.index_ne_zero_of_finite
  | succ n ih =>
    intro K hK m hm
    by_cases hKt : K = ⊤
    · exact ⟨fun _ => 1, by rw [hKt]; exact top_sup_eq _⟩
    · obtain ⟨x, hx⟩ : ∃ x, x ∉ K := by
        by_contra h
        exact hKt (eq_top_iff.mpr fun y _ => by_contra fun hy => h ⟨y, hy⟩)
      have hle : K ≤ K ⊔ Subgroup.zpowers x := le_sup_left
      have hmul := Subgroup.relIndex_mul_index hle
      have hrel1 : K.relIndex (K ⊔ Subgroup.zpowers x) ≠ 1 := by
        rw [Ne, Subgroup.relIndex_eq_one]
        intro h
        exact hx (h (le_sup_right (a := K) (Subgroup.mem_zpowers x)))
      have hK0 : K.index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have hrel0 : K.relIndex (K ⊔ Subgroup.zpowers x) ≠ 0 := by
        intro h
        rw [h, zero_mul] at hmul
        exact hK0 hmul.symm
      have hK'0 : (K ⊔ Subgroup.zpowers x).index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have h2 : (K ⊔ Subgroup.zpowers x).index * 2 ≤ K.index := by
        rw [← hmul, mul_comm]
        exact Nat.mul_le_mul_right _ (by omega)
      have hlog : Nat.log 2 (K ⊔ Subgroup.zpowers x).index + 1 ≤ Nat.log 2 K.index := by
        rw [← Nat.log_mul_base (by norm_num) hK'0]
        exact Nat.log_mono_right h2
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      obtain ⟨gen', hgen'⟩ := ih (K ⊔ Subgroup.zpowers x) (by omega) m' (by omega)
      refine ⟨Fin.cons x gen', ?_⟩
      rw [eq_top_iff, ← hgen']
      refine sup_le (sup_le le_sup_left ?_) ?_
      · rw [Subgroup.zpowers_le]
        exact le_sup_right (a := K) (Subgroup.subset_closure ⟨0, rfl⟩)
      · refine le_sup_of_le_right (Subgroup.closure_mono ?_)
        rintro _ ⟨i, rfl⟩
        exact ⟨i.succ, rfl⟩

/-- A finite group is generated, over any subgroup `K`, by `Ω [G : K]` elements, where `Ω`
counts prime factors with multiplicity. -/
theorem exists_gen_omega_aux {H : Type*} [Group H] [Finite H] :
    ∀ (n : ℕ) (K : Subgroup H), K.index ≤ n → ∀ m : ℕ,
      ArithmeticFunction.cardFactors K.index ≤ m →
      ∃ gen : Fin m → H, K ⊔ Subgroup.closure (Set.range gen) = ⊤ := by
  intro n
  induction n with
  | zero =>
    intro K hK
    exact absurd (Nat.le_zero.mp hK) Subgroup.index_ne_zero_of_finite
  | succ n ih =>
    intro K hK m hm
    by_cases hKt : K = ⊤
    · exact ⟨fun _ => 1, by rw [hKt]; exact top_sup_eq _⟩
    · obtain ⟨x, hx⟩ : ∃ x, x ∉ K := by
        by_contra h
        exact hKt (eq_top_iff.mpr fun y _ => by_contra fun hy => h ⟨y, hy⟩)
      have hle : K ≤ K ⊔ Subgroup.zpowers x := le_sup_left
      have hmul := Subgroup.relIndex_mul_index hle
      have hrel1 : K.relIndex (K ⊔ Subgroup.zpowers x) ≠ 1 := by
        rw [Ne, Subgroup.relIndex_eq_one]
        intro h
        exact hx (h (le_sup_right (a := K) (Subgroup.mem_zpowers x)))
      have hK0 : K.index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have hrel0 : K.relIndex (K ⊔ Subgroup.zpowers x) ≠ 0 := by
        intro h
        rw [h, zero_mul] at hmul
        exact hK0 hmul.symm
      have hK'0 : (K ⊔ Subgroup.zpowers x).index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have h2 : (K ⊔ Subgroup.zpowers x).index * 2 ≤ K.index := by
        rw [← hmul, mul_comm]
        exact Nat.mul_le_mul_right _ (by omega)
      have hone : 1 ≤ ArithmeticFunction.cardFactors (K.relIndex (K ⊔ Subgroup.zpowers x)) := by
        rw [ArithmeticFunction.cardFactors_apply]
        apply Nat.one_le_iff_ne_zero.mpr
        rw [Ne, List.length_eq_zero_iff, Nat.primeFactorsList_eq_nil]
        omega
      have hΩ : ArithmeticFunction.cardFactors (K ⊔ Subgroup.zpowers x).index + 1 ≤
          ArithmeticFunction.cardFactors K.index := by
        rw [← hmul, ArithmeticFunction.cardFactors_mul hrel0 hK'0]
        omega
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      obtain ⟨gen', hgen'⟩ := ih (K ⊔ Subgroup.zpowers x) (by omega) m' (by omega)
      refine ⟨Fin.cons x gen', ?_⟩
      rw [eq_top_iff, ← hgen']
      refine sup_le (sup_le le_sup_left ?_) ?_
      · rw [Subgroup.zpowers_le]
        exact le_sup_right (a := K) (Subgroup.subset_closure ⟨0, rfl⟩)
      · refine le_sup_of_le_right (Subgroup.closure_mono ?_)
        rintro _ ⟨i, rfl⟩
        exact ⟨i.succ, rfl⟩

/-- A finite group of order `h` is generated by `Ω(h)` elements (padded to any larger length). -/
theorem exists_gen_omega {H : Type*} [Group H] [Finite H] (m : ℕ)
    (hm : ArithmeticFunction.cardFactors (Nat.card H) ≤ m) :
    ∃ gen : Fin m → H, Subgroup.closure (Set.range gen) = ⊤ := by
  obtain ⟨gen, h⟩ := exists_gen_omega_aux _ (⊥ : Subgroup H) le_rfl m
    (by rwa [Subgroup.index_bot])
  exact ⟨gen, by rwa [bot_sup_eq] at h⟩

/-- Every prime factor of an odd number is at least three. -/
theorem three_pow_cardFactors_le {n : ℕ} (hn : Odd n) :
    3 ^ ArithmeticFunction.cardFactors n ≤ n := by
  rw [ArithmeticFunction.cardFactors_apply]
  conv_rhs => rw [← Nat.prod_primeFactorsList hn.pos.ne']
  apply List.pow_card_le_prod
  intro p hp
  have hpp := Nat.prime_of_mem_primeFactorsList hp
  have hpd := Nat.dvd_of_mem_primeFactorsList hp
  have hp2 : p ≠ 2 := by
    rintro rfl
    exact (Nat.not_even_iff_odd.mpr hn) (even_iff_two_dvd.mpr hpd)
  have := hpp.two_le
  omega

/-- An odd number below `2^s` with `s ≥ 3` has at most `s - 2` prime factors. -/
theorem cardFactors_odd_le {q' s : ℕ} (hodd : Odd q') (hs : 3 ≤ s) (hq : q' < 2 ^ s) :
    ArithmeticFunction.cardFactors q' ≤ s - 2 := by
  have h1 := three_pow_cardFactors_le hodd
  have h2 : 2 ^ s ≤ 3 ^ (s - 1) := by
    obtain ⟨u, rfl⟩ : ∃ u, s = u + 3 := ⟨s - 3, by omega⟩
    have hu : 2 ^ u ≤ 3 ^ u := Nat.pow_le_pow_left (by norm_num) u
    have e1 : 2 ^ (u + 3) = 2 ^ u * 8 := by rw [pow_add]; norm_num
    have e2 : 3 ^ (u + 3 - 1) = 3 ^ u * 9 := by
      rw [show u + 3 - 1 = u + 2 by omega, pow_add]; norm_num
    rw [e1, e2]
    omega
  have h3 : 3 ^ ArithmeticFunction.cardFactors q' < 3 ^ (s - 1) := by omega
  have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 3)).mp h3
  omega

/-- In an extension, the conjugation action along words in given lifts of generators of the
quotient realizes the corresponding word in the lifted automorphisms. -/
theorem action_cover' {N G H : Type*} [Group N] [Group G] [Group H] (S : GroupExtension N G H)
    {t : ℕ} (gen : Fin t → H) (lift : Fin t → G) (hl : ∀ i, S.rightHom (lift i) = gen i)
    (w : H → FreeGroup (Fin t)) (hw : ∀ h, FreeGroup.lift gen (w h) = h) :
    ∀ h, ∃ e : G, ∃ n : N, S.rightHom e = h ∧
      MulAut.conj n * S.conjAct e = FreeGroup.lift (fun i => S.conjAct (lift i)) (w h) := by
  intro h
  refine ⟨FreeGroup.lift lift (w h), 1, ?_, ?_⟩
  · have hc : S.rightHom.comp (FreeGroup.lift lift) = FreeGroup.lift gen :=
      FreeGroup.ext_hom _ _ fun i => by simp [hl]
    calc S.rightHom (FreeGroup.lift lift (w h))
        = (S.rightHom.comp (FreeGroup.lift lift)) (w h) := rfl
      _ = FreeGroup.lift gen (w h) := by rw [hc]
      _ = h := hw h
  · have hc : S.conjAct.comp (FreeGroup.lift lift) =
        FreeGroup.lift (fun i => S.conjAct (lift i)) :=
      FreeGroup.ext_hom _ _ fun i => by simp
    rw [map_one, one_mul]
    exact DFunLike.congr_fun hc (w h)

/-- Relabeling the kernel of an extension by an automorphism `φ` conjugates its action by `φ`. -/
theorem exists_twist {N E G : Type*} [Group N] [Group E] [Group G] (S : GroupExtension N E G)
    (φ : MulAut N) : ∃ S' : GroupExtension N E G, S'.rightHom = S.rightHom ∧
      ∀ e, S'.conjAct e = φ * S.conjAct e * φ⁻¹ := by
  have hrange : (S.inl.comp (φ⁻¹ : MulAut N).toMonoidHom).range = S.inl.range := by
    ext x
    constructor
    · rintro ⟨n, rfl⟩
      exact ⟨_, rfl⟩
    · rintro ⟨n, rfl⟩
      refine ⟨φ n, ?_⟩
      simp
  let S' : GroupExtension N E G :=
    { inl := S.inl.comp (φ⁻¹ : MulAut N).toMonoidHom
      rightHom := S.rightHom
      inl_injective := S.inl_injective.comp (φ⁻¹ : MulAut N).injective
      range_inl_eq_ker_rightHom := hrange.trans S.range_inl_eq_ker_rightHom
      rightHom_surjective := S.rightHom_surjective }
  refine ⟨S', rfl, fun e => ?_⟩
  refine MulEquiv.ext fun n => ?_
  apply S'.inl_injective
  rw [GroupExtension.inl_conjAct_comm]
  show e * S.inl ((φ⁻¹ : MulAut N) n) * e⁻¹ = S.inl ((φ⁻¹ : MulAut N) ((φ * S.conjAct e * φ⁻¹) n))
  rw [← GroupExtension.inl_conjAct_comm]
  congr 1
  simp only [MulAut.mul_apply, MulAut.inv_apply, MulEquiv.symm_apply_apply]

/-- In an extension with kernel a `2`-group, an element of order dividing three in the
quotient lifts to an element of order dividing three. -/
theorem exists_lift_pow_three {N E G : Type*} [Group N] [Group E] [Group G]
    (S : GroupExtension N E G) (B : ℕ) (hN : Nat.card N = 2 ^ B) (γ : G) (hγ : γ ^ 3 = 1) :
    ∃ e : E, e ^ 3 = 1 ∧ S.rightHom e = γ := by
  obtain ⟨e0, he0⟩ := S.rightHom_surjective γ
  have hk : e0 ^ 3 ∈ S.rightHom.ker := by
    rw [MonoidHom.mem_ker, map_pow, he0, hγ]
  rw [← S.range_inl_eq_ker_rightHom] at hk
  obtain ⟨m, hm⟩ := hk
  have hm1 : m ^ (2 ^ B) = 1 := by rw [← hN]; exact pow_card_eq_one'
  have h4 : 4 ^ B = 3 * (4 ^ B / 3) + 1 := by
    have : 4 ^ B % 3 = 1 := by rw [Nat.pow_mod]; norm_num
    omega
  have h44 : 4 ^ B = 2 ^ B * 2 ^ B := by rw [← mul_pow]; norm_num
  refine ⟨e0 ^ (4 ^ B), ?_, ?_⟩
  · calc (e0 ^ (4 ^ B)) ^ 3 = (e0 ^ 3) ^ (4 ^ B) := by rw [← pow_mul, ← pow_mul, mul_comm]
      _ = S.inl (m ^ (4 ^ B)) := by rw [← hm, map_pow]
      _ = 1 := by rw [h44, pow_mul, hm1, one_pow, map_one]
  · rw [map_pow, he0, h4, pow_succ, pow_mul, hγ, one_pow, one_mul]

/-- Counting a sigma type over a product whose fibres depend on the first factor only. -/
theorem card_sigma_prod_fst {α β : Type*} (F : α → Type*) :
    Nat.card (Σ x : α × β, F x.1) = Nat.card β * Nat.card (Σ a : α, F a) := by
  rw [← Nat.card_prod]
  exact Nat.card_congr
    { toFun := fun p => (p.1.2, ⟨p.1.1, p.2⟩)
      invFun := fun p => ⟨(p.2.1, p.1), p.2.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }

/-- Generic template count. A family of templates is indexed by the cofactor exponent
`c ≤ L`, the class of the kernel (order `2^(K-c)`), the class of the quotient
(order `2^c q'`), and extra data `E c x` which determines the automorphisms attached to a
fixed generating tuple of the quotient. If every group of order `n` is covered, then `g n`
is bounded by the number of templates times the factor-set weight. -/
theorem generic_templates (n L K q' : ℕ) (t : ℕ → ℕ)
    (E : ∀ c : ℕ, ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {X : FiniteGrp.{0} | Nat.card X = 2 ^ (K - c)}) → Type)
    [hE : ∀ c x, Finite (E c x)]
    (gen : ∀ (c : ℕ) (y : ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {X : FiniteGrp.{0} | Nat.card X = 2 ^ c * q'})),
      Fin (t c) → (Quotient.out y.1 : FiniteGrp.{0}))
    (hsurj : ∀ c y, Function.Surjective (FreeGroup.lift (gen c y)))
    (img : ∀ c x, E c x → Fin (t c) → MulAut (Quotient.out x.1 : FiniteGrp.{0}))
    (cov : ∀ G : FiniteGrp.{0}, Nat.card G = n → ∃ c ≤ L, ∃ x, ∃ y, ∃ e : E c x,
      ∃ S : GroupExtension (Quotient.out x.1 : FiniteGrp.{0}) G
        (Quotient.out y.1 : FiniteGrp.{0}),
      ∃ lift : Fin (t c) → G, (∀ i, S.rightHom (lift i) = gen c y i) ∧
        (∀ i, S.conjAct (lift i) = img c x e i)) :
    g n ≤ (∑ c ∈ Finset.range (L + 1), g (2 ^ c * q') * Nat.card (Σ x, E c x)) *
      2 ^ (K * (2 ^ L * q') ^ 2) := by
  classical
  have hfinC : ∀ m, Finite ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {X : FiniteGrp.{0} | Nat.card X = m}) := fun m => (classes_finite m).to_subtype
  let I := Σ c : Fin (L + 1), Σ p : (↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {X : FiniteGrp.{0} | Nat.card X = 2 ^ (K - (c : ℕ))}) ×
      ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {X : FiniteGrp.{0} | Nat.card X = 2 ^ (c : ℕ) * q'})), E c p.1
  have : Finite I := inferInstance
  let _ : Fintype I := Fintype.ofFinite I
  have key := count_by_templates (I := I) (fun i => Quotient.out i.2.1.1.1)
    (fun i => Quotient.out i.2.1.2.1)
    (fun i h => FreeGroup.lift (img i.1 i.2.1.1 i.2.2) (Function.surjInv (hsurj i.1 i.2.1.2) h))
    n (by
      intro G hG
      obtain ⟨c, hc, x, y, e, S, lift, hl, hconj⟩ := cov G hG
      refine ⟨⟨⟨c, Nat.lt_succ_of_le hc⟩, (x, y), e⟩, S, ?_⟩
      have hcov := action_cover' S (gen c y) lift hl (Function.surjInv (hsurj c y))
        (Function.surjInv_eq (hsurj c y))
      have hfun : (fun i => S.conjAct (lift i)) = img c x e := funext hconj
      rw [hfun] at hcov
      exact hcov)
  have hterm : ∀ i : I, Nat.card (Subgroup.center (Quotient.out i.2.1.1.1 : FiniteGrp.{0})) ^
      (Nat.card (Quotient.out i.2.1.2.1 : FiniteGrp.{0}) ^ 2) ≤ 2 ^ (K * (2 ^ L * q') ^ 2) := by
    intro i
    have hN := card_out i.2.1.1.2
    have hH := card_out i.2.1.2.2
    have hcb : ((i.1 : ℕ)) ≤ L := Nat.lt_succ_iff.mp i.1.2
    calc _ ≤ (2 ^ K) ^ (Nat.card (Quotient.out i.2.1.2.1 : FiniteGrp.{0}) ^ 2) := by
          apply Nat.pow_le_pow_left
          calc Nat.card (Subgroup.center (Quotient.out i.2.1.1.1 : FiniteGrp.{0}))
              ≤ Nat.card (Quotient.out i.2.1.1.1 : FiniteGrp.{0}) :=
                Subgroup.card_le_card_group _
            _ = 2 ^ (K - (i.1 : ℕ)) := hN
            _ ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) (Nat.sub_le _ _)
      _ ≤ (2 ^ K) ^ ((2 ^ L * q') ^ 2) := by
          apply Nat.pow_le_pow_right (by positivity)
          rw [hH]
          exact Nat.pow_le_pow_left
            (Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) hcb)) 2
      _ = 2 ^ (K * (2 ^ L * q') ^ 2) := by rw [← pow_mul]
  have hcardI : Nat.card I =
      ∑ c ∈ Finset.range (L + 1), g (2 ^ c * q') * Nat.card (Σ x, E c x) := by
    rw [Nat.card_sigma]
    rw [← Fin.sum_univ_eq_sum_range (fun c => g (2 ^ c * q') * Nat.card (Σ x, E c x)) (L + 1)]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [card_sigma_prod_fst (fun x : ↥(Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {X : FiniteGrp.{0} | Nat.card X = 2 ^ (K - (c : ℕ))}) => E c x)]
    rw [Nat.card_coe_set_eq]
    rfl
  calc g n ≤ _ := key
    _ ≤ ∑ _i : I, 2 ^ (K * (2 ^ L * q') ^ 2) := Finset.sum_le_sum fun i _ => hterm i
    _ = Nat.card I * 2 ^ (K * (2 ^ L * q') ^ 2) := by
        rw [Finset.sum_const, Finset.card_univ, smul_eq_mul, Nat.card_eq_fintype_card]
    _ = _ := by rw [hcardI]

theorem self_le_two_pow (n : ℕ) : n ≤ 2 ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    have := Nat.one_le_two_pow (n := n)
    rw [pow_succ]
    omega

/-- The polynomial inequality behind the final count. -/
theorem poly_ineq (b s P : ℕ) (hs : 1 ≤ s) (hb : P + 31 ≤ b) :
    P * b + 2 * b ^ 3 + 6 * (s - 1) * b ^ 2 + 13 * (b + s) ^ 2 ≤
      2 * (b + s) ^ 3 + 8 * b ^ 2 := by
  have hbb : (P + 31) * b ≤ b * b := Nat.mul_le_mul_right b hb
  have key : P * b + 28 * b + 80 ≤ b ^ 2 := by nlinarith
  obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
  rw [Nat.add_sub_cancel]
  rcases Nat.lt_or_ge s' 6 with h6 | h6
  · interval_cases s' <;> nlinarith [key]
  · obtain ⟨u, rfl⟩ : ∃ u, s' = u + 6 := ⟨s' - 6, by omega⟩
    nlinarith [key, Nat.zero_le (b * (u + 7) * (3 * u + 8)), Nat.zero_le ((u + 7) ^ 2 * (2 * u + 1))]

/-- A group of order `2^k * (2^j * q')` with `q'` odd is an extension, with kernel the normal
core of a given Sylow 2-subgroup, of a group of order `2^c * q'` by a group of order
`2^(k+j-c)`, where `c ≤ q'!` because the quotient acts faithfully on the `q'` cosets of the
Sylow subgroup. Both groups are replaced by the chosen representatives of their classes. -/
theorem cover {k j q' : ℕ} (hq' : Odd q') (G : FiniteGrp.{0}) (P : Sylow 2 G)
    (hG : Nat.card G = 2 ^ k * (2 ^ j * q')) :
    ∃ c : ℕ, c ≤ q'.factorial ∧ c ≤ k + j ∧
      ∃ xN ∈ Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
          {X : FiniteGrp.{0} | Nat.card X = 2 ^ (k + j - c)},
      ∃ xH ∈ Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
          {X : FiniteGrp.{0} | Nat.card X = 2 ^ c * q'},
      ∃ S : GroupExtension (Quotient.out xN : FiniteGrp.{0}) G (Quotient.out xH : FiniteGrp.{0}),
        S.inl.range = P.normalCore := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hq0 : q' ≠ 0 := hq'.pos.ne'
  have h2q : ¬ 2 ∣ q' := by
    rcases hq' with ⟨m, rfl⟩
    omega
  have hfac : Nat.factorization (2 ^ k * (2 ^ j * q')) 2 = k + j := by
    rw [Nat.factorization_mul (by positivity) (by positivity),
      Nat.factorization_mul (by positivity) hq0]
    simp [Nat.Prime.factorization_self Nat.prime_two, Nat.factorization_eq_zero_of_not_dvd h2q]
  have hP : Nat.card P.toSubgroup = 2 ^ (k + j) := by
    have := Sylow.card_eq_multiplicity P
    rw [hG, hfac] at this
    exact this
  set K : Subgroup G := P.normalCore with hKdef
  haveI hKn : K.Normal := Subgroup.normalCore_normal _
  have hKdvd : Nat.card K ∣ 2 ^ (k + j) := by
    have := Subgroup.card_dvd_of_le (Subgroup.normalCore_le P.toSubgroup)
    rwa [hP] at this
  obtain ⟨e, he, hKe⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hKdvd
  have hGK := Subgroup.card_eq_card_quotient_mul_card_subgroup K
  have hGP := Subgroup.card_eq_card_quotient_mul_card_subgroup P.toSubgroup
  rw [hG, hKe] at hGK
  rw [hG, hP] at hGP
  have hpow : 2 ^ (k + j - e) * 2 ^ e = 2 ^ k * 2 ^ j := by
    rw [← pow_add, ← pow_add, Nat.sub_add_cancel he]
  have hQ : Nat.card (G ⧸ K) = 2 ^ (k + j - e) * q' := by
    apply Nat.eq_of_mul_eq_mul_right (show 0 < 2 ^ e by positivity)
    rw [← hGK]
    calc 2 ^ k * (2 ^ j * q') = (2 ^ (k + j - e) * 2 ^ e) * q' := by rw [hpow]; ring
      _ = 2 ^ (k + j - e) * q' * 2 ^ e := by ring
  have hQP : Nat.card (G ⧸ P.toSubgroup) = q' := by
    apply Nat.eq_of_mul_eq_mul_right (show 0 < 2 ^ (k + j) by positivity)
    rw [← hGP, pow_add]
    ring
  have hdvd : Nat.card (G ⧸ K) ∣ q'.factorial := by
    letI : Fintype (G ⧸ P.toSubgroup) := Fintype.ofFinite _
    have hker : K = (MulAction.toPermHom G (G ⧸ P.toSubgroup)).ker :=
      Subgroup.normalCore_eq_ker _
    have h1 := Subgroup.card_dvd_of_injective _
      (QuotientGroup.kerLift_injective (MulAction.toPermHom G (G ⧸ P.toSubgroup)))
    rw [← hker, Nat.card_eq_fintype_card (α := Equiv.Perm (G ⧸ P.toSubgroup)),
      Fintype.card_perm, ← Nat.card_eq_fintype_card, hQP] at h1
    exact h1
  have hc : k + j - e ≤ q'.factorial := by
    have h1 : 2 ^ (k + j - e) ≤ q'.factorial :=
      calc 2 ^ (k + j - e) ≤ 2 ^ (k + j - e) * q' := Nat.le_mul_of_pos_right _ hq'.pos
        _ = Nat.card (G ⧸ K) := hQ.symm
        _ ≤ q'.factorial := Nat.le_of_dvd (Nat.factorial_pos _) hdvd
    exact (self_le_two_pow _).trans h1
  refine ⟨k + j - e, hc, Nat.sub_le _ _, ?_⟩
  rw [Nat.sub_sub_self he]
  refine ⟨Quotient.mk _ (FiniteGrp.of K), ⟨FiniteGrp.of K, hKe, rfl⟩,
    Quotient.mk _ (FiniteGrp.of (G ⧸ K)), ⟨FiniteGrp.of (G ⧸ K), hQ, rfl⟩, ?_⟩
  obtain ⟨i1⟩ : Nonempty (Quotient.out (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0})
      (FiniteGrp.of K)) ≅ FiniteGrp.of K) :=
    Quotient.mk_out (s := isIsomorphicSetoid FiniteGrp.{0}) _
  obtain ⟨i2⟩ : Nonempty (Quotient.out (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0})
      (FiniteGrp.of (G ⧸ K))) ≅ FiniteGrp.of (G ⧸ K)) :=
    Quotient.mk_out (s := isIsomorphicSetoid FiniteGrp.{0}) _
  obtain ⟨ι⟩ : Nonempty ((Quotient.out (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0})
      (FiniteGrp.of K)) : FiniteGrp.{0}) ≃* K) := nonempty_mulEquiv_of_iso i1
  obtain ⟨θ⟩ : Nonempty ((Quotient.out (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0})
      (FiniteGrp.of (G ⧸ K))) : FiniteGrp.{0}) ≃* (G ⧸ K)) := nonempty_mulEquiv_of_iso i2
  have hrange : (K.subtype.comp ι.toMonoidHom).range = K := by
    ext x
    constructor
    · rintro ⟨n, rfl⟩
      exact (ι n).2
    · intro hx
      exact ⟨ι.symm ⟨x, hx⟩, congrArg Subtype.val (ι.apply_symm_apply ⟨x, hx⟩)⟩
  have hker : (θ.symm.toMonoidHom.comp (QuotientGroup.mk' K)).ker = K := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  refine ⟨{ inl := K.subtype.comp ι.toMonoidHom
            rightHom := θ.symm.toMonoidHom.comp (QuotientGroup.mk' K)
            inl_injective := Subtype.val_injective.comp ι.injective
            range_inl_eq_ker_rightHom := hrange.trans hker.symm
            rightHom_surjective := θ.symm.surjective.comp (QuotientGroup.mk'_surjective K) }, ?_⟩
  exact hrange

/-- The final comparison. If the template counts `M k c` (kernel order `2^(k+a-c)`,
`c + s - 2` free generators) satisfy the moment bound, then the weighted template total for
order `2^k * 2^a * q'` is eventually at most `g(2^(k+a+s-1)) / 2^(a+s+2)`, by Higman's
bound. The comparison is `poly_ineq` with `S = c + s - 1`. -/
theorem final_bound (hlow : ∀ᶠ m : ℕ in atTop, 2 ^ (2 * m ^ 3) ≤ g (2 ^ m) ^ 27 * 2 ^ (13 * m ^ 2))
    (a s q' L C : ℕ) (hs : 2 ≤ s) (M : ℕ → ℕ → ℕ)
    (hM : ∀ k c, c ≤ L → M k c ^ 27 * 2 ^ (8 * (k + a - c) ^ 2) ≤
      2 ^ (2 * (k + a - c) ^ 3 + 6 * (c + s - 2) * (k + a - c) ^ 2 + C * (k + a - c + 1))) :
    ∀ᶠ k : ℕ in atTop, 2 ^ (a + s + 2) *
      ((∑ c ∈ Finset.range (L + 1), g (2 ^ c * q') * M k c) *
        2 ^ ((k + a) * (2 ^ L * q') ^ 2)) ≤ g (2 ^ (k + (a + s) - 1)) := by
  obtain ⟨A, hA⟩ : ∃ A, A = ∑ c ∈ Finset.range (L + 1), g (2 ^ c * q') := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D, D = (2 ^ L * q') ^ 2 := ⟨_, rfl⟩
  obtain ⟨P0, hP0⟩ : ∃ P0, P0 = 27 + 27 * (a + s + 2 + L) + 27 * A + 2 * C + 27 * D +
      27 * (L * D) := ⟨_, rfl⟩
