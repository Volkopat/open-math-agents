import Mathlib

-- Reduction Erdos985.erdos_985.variants.two_three_five_primitive_root.R2 of Erdős Problem 985 — two three five primitive root
-- Credit: @pyaf
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
Heath-Brown's argument (D. R. Heath-Brown, Artin's conjecture for primitive roots,
Quart. J. Math. Oxford 37 (1986), 27–38) split into its analytic input and its elementary part.

* H1 is the sieve input (Heath-Brown, Lemma 2.1, from Chen's switching principle and
  Fouvry–Iwaniec): many primes `p ≡ 53 (mod 120)` have `(p - 1) / 4` prime or a product
  `q₁ q₂` of two primes with `x ^ (1/4 + δ) < q₁ < x ^ (1/2 - δ)`.
* H2 is Heath-Brown's elementary counting lemma for three generators: the primes `p` for which
  `2, 3, 5` generate a group of exponent at most `y` number `O(y ^ (4/3))` (pigeonhole on
  `2 ^ i 3 ^ j 5 ^ k` with `i, j, k ≤ y ^ (1/3)`, then count prime factors of the differences).

Proved here: for `p ≡ 53 (mod 120)` quadratic reciprocity makes `2, 3, 5` nonresidues, so each of
them is a primitive root unless its order divides `4 q₁` or `4 q₂`. The first case is counted by the
one-generator lemma (at most `3 y ^ 2` primes, proved below via prime factors of `a ^ N - 1`), the
second (for all three at once) by H2, and both counts are `o(x / log² x)`.
-/

namespace OMA.R_Erdos985_erdos_985_variants_two_three_five_primitive_root_R2

open Filter Finset

open scoped Classical in
/-- Sieve input (Heath-Brown, Lemma 2.1, after Chen and Fouvry–Iwaniec). -/
def H1 : Prop := ∃ δ : ℝ, 0 < δ ∧ ∃ c : ℝ, 0 < c ∧ ∀ᶠ x : ℕ in atTop,
  c * x / Real.log x ^ 2 ≤ (#((range (x + 1)).filter fun p => p.Prime ∧ p % 120 = 53 ∧
    (((p - 1) / 4).Prime ∨ ∃ q₁ q₂ : ℕ, q₁.Prime ∧ q₂.Prime ∧ (p - 1) / 4 = q₁ * q₂ ∧
      (x : ℝ) ^ (1 / 4 + δ) < q₁ ∧ (q₁ : ℝ) < (x : ℝ) ^ (1 / 2 - δ))) : ℝ)

open scoped Classical in
/-- Few primes make the group generated by 2, 3, 5 have exponent at most y. -/
def H2 : Prop := ∃ C : ℝ, ∀ x y : ℕ,
  (#((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 y,
      (2 : ZMod p) ^ N = 1 ∧ (3 : ZMod p) ^ N = 1 ∧ (5 : ZMod p) ^ N = 1) : ℝ)
    ≤ C * (y : ℝ) ^ ((4 : ℝ) / 3)


lemma nat_case2 {g q1 q2 : ℕ} (h1 : q1.Prime) (h2 : q2.Prime) (hg : g ∣ 4 * (q1 * q2))
    (hn : ¬ g ∣ 2 * (q1 * q2)) : g = 4 * (q1 * q2) ∨ g ∣ 4 * q1 ∨ g ∣ 4 * q2 := by
  obtain ⟨y, z, hy, hz, rfl⟩ := Nat.dvd_mul.mp (show g ∣ (4 * q1) * q2 by rwa [← mul_assoc] at hg)
  rcases h2.eq_one_or_self_of_dvd z hz with rfl | rfl
  · exact Or.inr (Or.inl (by simpa using hy))
  obtain ⟨u, v, hu, hv, rfl⟩ := Nat.dvd_mul.mp hy
  rcases h1.eq_one_or_self_of_dvd v hv with rfl | rfl
  · exact Or.inr (Or.inr (by simpa [mul_comm] using Nat.mul_dvd_mul_right hu z))
  have hu4 : u ≤ 4 := Nat.le_of_dvd (by norm_num) hu
  interval_cases u <;> simp_all [mul_assoc, Nat.mul_dvd_mul_right] <;> omega

lemma nat_case1 {g q : ℕ} (h : q.Prime) (hg : g ∣ 4 * q) (hn : ¬ g ∣ 2 * q) :
    g = 4 * q ∨ g ∣ 4 := by
  obtain ⟨y, z, hy, hz, rfl⟩ := Nat.dvd_mul.mp hg
  rcases h.eq_one_or_self_of_dvd z hz with rfl | rfl
  · exact Or.inr (by simpa using hy)
  have hy4 : y ≤ 4 := Nat.le_of_dvd (by norm_num) hy
  interval_cases y <;> simp_all

lemma ns3 : ¬ IsSquare ((2 : ℕ) : ZMod 3) := by unfold IsSquare; decide
lemma ns5 : ¬ IsSquare ((3 : ℕ) : ZMod 5) := by unfold IsSquare; decide

section
variable {p : ℕ} [hp : Fact p.Prime]

lemma two_pow (h : p % 120 = 53) : (2 : ZMod p) ^ (p / 2) = -1 := by
  have h2 : (2 : ZMod p) ≠ 0 := by
    intro h0
    have := Nat.le_of_dvd (by norm_num) ((ZMod.natCast_eq_zero_iff 2 p).mp (by exact_mod_cast h0))
    omega
  have hns : ¬ IsSquare (2 : ZMod p) := by
    rw [ZMod.exists_sq_eq_two_iff (by omega)]; omega
  rcases ZMod.pow_div_two_eq_neg_one_or_one p h2 with h' | h'
  · exact absurd ((ZMod.euler_criterion p h2).mpr h') hns
  · exact h'

lemma odd_pow (q : ℕ) [Fact q.Prime] (hq : q ≠ 2) (hqp : q < p) (h : p % 4 = 1)
    (hs : ¬ IsSquare (p : ZMod q)) : (q : ZMod p) ^ (p / 2) = -1 := by
  have h2 : (q : ZMod p) ≠ 0 := by
    intro h0
    have := Nat.le_of_dvd (Fact.out : q.Prime).pos ((ZMod.natCast_eq_zero_iff q p).mp h0)
    omega
  have hns : ¬ IsSquare (q : ZMod p) := by
    rwa [ZMod.exists_sq_eq_prime_iff_of_mod_four_eq_one h hq]
  rcases ZMod.pow_div_two_eq_neg_one_or_one p h2 with h' | h'
  · exact absurd ((ZMod.euler_criterion p h2).mpr h') hns
  · exact h'

lemma three_pow (h : p % 120 = 53) : (3 : ZMod p) ^ (p / 2) = -1 := by
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have := odd_pow (p := p) 3 (by norm_num) (by omega) (by omega) (by
    rw [← ZMod.natCast_mod, show p % 3 = 2 by omega]; exact ns3)
  exact_mod_cast this

lemma five_pow (h : p % 120 = 53) : (5 : ZMod p) ^ (p / 2) = -1 := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have := odd_pow (p := p) 5 (by norm_num) (by omega) (by omega) (by
    rw [← ZMod.natCast_mod, show p % 5 = 3 by omega]; exact ns5)
  exact_mod_cast this

/-- A quadratic nonresidue is a primitive root unless a small power kills it. -/
lemma key (h : p % 120 = 53) {a : ZMod p} (ha : a ^ (p / 2) = -1) :
    (((p - 1) / 4).Prime → orderOf a = p - 1 ∨ a ^ 4 = 1) ∧
    (∀ q1 q2, q1.Prime → q2.Prime → (p - 1) / 4 = q1 * q2 →
      orderOf a = p - 1 ∨ a ^ (4 * q1) = 1 ∨ a ^ (4 * q2) = 1) := by
  have hp1 : p - 1 = 4 * ((p - 1) / 4) := by omega
  have hp2 : p / 2 = 2 * ((p - 1) / 4) := by omega
  have ha0 : a ≠ 0 := by rintro rfl; rw [zero_pow (by omega)] at ha; exact one_ne_zero (neg_eq_zero.mp ha.symm)
  have hf : orderOf a ∣ 4 * ((p - 1) / 4) := by
    rw [orderOf_dvd_iff_pow_eq_one, ← hp1]; exact ZMod.pow_card_sub_one_eq_one ha0
  have hn : ¬ orderOf a ∣ 2 * ((p - 1) / 4) := by
    rw [orderOf_dvd_iff_pow_eq_one, ← hp2, ha]
    exact fun e => by
      have : (2 : ZMod p) = 0 := by linear_combination -e
      exact absurd this (by
        intro h0
        have := Nat.le_of_dvd (by norm_num) ((ZMod.natCast_eq_zero_iff 2 p).mp (by exact_mod_cast h0))
        omega)
  refine ⟨fun hq => ?_, fun q1 q2 h1 h2 hm => ?_⟩
  · rcases nat_case1 hq hf hn with e | e
    · exact Or.inl (e.trans hp1.symm)
    · exact Or.inr (orderOf_dvd_iff_pow_eq_one.mp e)
  · rw [hm] at hf hn hp1
    rcases nat_case2 h1 h2 hf hn with e | e | e
    · exact Or.inl (e.trans hp1.symm)
    · exact Or.inr (Or.inl (orderOf_dvd_iff_pow_eq_one.mp e))
    · exact Or.inr (Or.inr (orderOf_dvd_iff_pow_eq_one.mp e))

end


lemma card5 {R A B D E : Finset ℕ} : #(R ∪ (A ∪ B ∪ D ∪ E)) ≤ #R + #A + #B + #D + #E := by
  have := card_union_le R (A ∪ B ∪ D ∪ E)
  have := card_union_le (A ∪ B ∪ D) E
  have := card_union_le (A ∪ B) D
  have := card_union_le A B
  omega

lemma card_pf_lt {n k : ℕ} (hn : n ≠ 0) (h : n < 2 ^ k) : #n.primeFactors < k := by
  have h1 : 2 ^ #n.primeFactors ≤ ∏ p ∈ n.primeFactors, p :=
    pow_card_le_prod _ _ _ fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le
  have h2 := Nat.le_of_dvd (Nat.pos_of_ne_zero hn) (Nat.prod_primeFactors_dvd n)
  exact (Nat.pow_lt_pow_iff_right (a := 2) (by norm_num)).mp (by omega)

open scoped Classical in
lemma single_order_count : ∃ C : ℝ, ∀ a ∈ ({2, 3, 5} : Finset ℕ), ∀ x y : ℕ,
  (#((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 y, ((a : ℕ) : ZMod p) ^ N = 1) : ℝ)
    ≤ C * (y : ℝ) ^ 2 := by
  refine ⟨3, fun a ha x y => ?_⟩
  have ha2 : 2 ≤ a := by simp at ha; omega
  have ha8 : a < 2 ^ 3 := by simp at ha; omega
  have hsub : ((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 y, ((a : ℕ) : ZMod p) ^ N = 1)
      ⊆ (Icc 1 y).biUnion fun N => (a ^ N - 1).primeFactors := by
    intro p hp
    simp only [mem_filter] at hp
    obtain ⟨-, hpp, N, hN, he⟩ := hp
    have hN1 := (mem_Icc.mp hN).1
    have hpos : 1 < a ^ N := Nat.one_lt_pow (by omega) (by omega)
    refine mem_biUnion.mpr ⟨N, hN, Nat.mem_primeFactors.mpr ⟨hpp, ?_, by omega⟩⟩
    rw [← ZMod.natCast_eq_zero_iff, Nat.cast_sub hpos.le]
    push_cast; rw [he, sub_self]
  have hb : ∀ N ∈ Icc 1 y, #(a ^ N - 1).primeFactors ≤ 3 * y := by
    intro N hN
    have hN := mem_Icc.mp hN
    have hpos : 1 < a ^ N := Nat.one_lt_pow (by omega) (by omega)
    have : a ^ N - 1 < 2 ^ (3 * N) := by
      rw [pow_mul]; have := Nat.pow_lt_pow_left ha8 (n := N) (by omega); omega
    have := card_pf_lt (by omega) this
    omega
  have hc : #((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 y, ((a : ℕ) : ZMod p) ^ N = 1)
      ≤ 3 * y ^ 2 := by
    calc _ ≤ _ := card_le_card hsub
      _ ≤ ∑ N ∈ Icc 1 y, #(a ^ N - 1).primeFactors := card_biUnion_le
      _ ≤ #(Icc 1 y) • (3 * y) := sum_le_card_nsmul _ _ _ hb
      _ = 3 * y ^ 2 := by simp; ring
  exact_mod_cast hc

lemma asym_bound {c A B δ : ℝ} (hc : 0 < c) (hA : 0 ≤ A) (hB : 0 ≤ B) (hδ : 0 < δ) :
    ∀ᶠ x : ℕ in atTop, A + B * (x : ℝ) ^ (1 - δ) < c * x / Real.log x ^ 2 := by
  set d := min δ (1 / 2) with hd
  have hd0 : 0 < d := lt_min hδ (by norm_num)
  have hd1 : d ≤ 1 / 2 := min_le_right _ _
  have hlo := ((isLittleO_log_rpow_rpow_atTop 2 hd0).comp_tendsto
    tendsto_natCast_atTop_atTop).bound (c := c / (A + B + 1)) (by positivity)
  filter_upwards [hlo, eventually_ge_atTop 3] with x hx hx3
  have hx1 : (1 : ℝ) ≤ x := by exact_mod_cast (by omega : 1 ≤ x)
  have hx0 : (0 : ℝ) < x := by linarith
  have hlog : 0 < Real.log x := Real.log_pos (by exact_mod_cast (by omega : 1 < x))
  simp only [Function.comp, Real.norm_eq_abs] at hx
  rw [abs_of_pos (by positivity), abs_of_pos (by positivity), Real.rpow_two] at hx
  have he : (x : ℝ) ^ (1 - δ) ≤ (x : ℝ) ^ (1 - d) :=
    Real.rpow_le_rpow_of_exponent_le hx1 (by linarith [min_le_left δ (1/2)])
  have hg : (1 : ℝ) ≤ (x : ℝ) ^ (1 - d) := Real.one_le_rpow hx1 (by linarith)
  have hsplit : (x : ℝ) = x ^ (1 - d) * x ^ d := by
    rw [← Real.rpow_add hx0]; simp
  have key : (A + B + 1) * x ^ (1 - d) ≤ c * x / Real.log x ^ 2 := by
    rw [le_div_iff₀ (by positivity)]
    have h1 : Real.log x ^ 2 * (A + B + 1) ≤ c * x ^ d := by
      have := mul_le_mul_of_nonneg_right hx (by positivity : (0:ℝ) ≤ A + B + 1)
      calc Real.log x ^ 2 * (A + B + 1) ≤ c / (A + B + 1) * x ^ d * (A + B + 1) := this
        _ = c * x ^ d := by field_simp
    calc (A + B + 1) * x ^ (1 - d) * Real.log x ^ 2
        = x ^ (1 - d) * (Real.log x ^ 2 * (A + B + 1)) := by ring
      _ ≤ x ^ (1 - d) * (c * x ^ d) := by gcongr
      _ = c * (x ^ (1 - d) * x ^ d) := by ring
      _ = c * x := by rw [← hsplit]
  nlinarith [mul_le_mul_of_nonneg_left he hB]

open scoped Classical in
theorem main : H1 → H2 →
    type_of% @Erdos985.erdos_985.variants.two_three_five_primitive_root := by
  rintro ⟨δ, hδ, c, hc, hev⟩ ⟨C3, h3⟩
  obtain ⟨C2, h2⟩ := single_order_count
  by_contra hG
  obtain ⟨K, hK⟩ := (Set.not_infinite.mp hG).bddAbove
  have hC2 : 0 ≤ C2 := by
    have := h2 2 (by simp) 0 1
    simp only [Nat.cast_one, one_pow, mul_one] at this
    exact le_trans (Nat.cast_nonneg _) this
  have hC3 : 0 ≤ C3 := by
    have := h3 0 1
    simp only [Nat.cast_one, Real.one_rpow, mul_one] at this
    exact le_trans (Nat.cast_nonneg _) this
  obtain ⟨x, hx, hxa, hx1⟩ := (hev.and ((asym_bound (A := K + 1) (B := 48 * C2 + C3) hc
    (by positivity) (by positivity) hδ).and (eventually_ge_atTop 1))).exists
  have hx1' : (1 : ℝ) ≤ x := by exact_mod_cast hx1
  have hx0 : (0 : ℝ) < x := by linarith
  set Y1 := ⌊4 * (x : ℝ) ^ (1 / 2 - δ)⌋₊
  set Y3 := ⌊(x : ℝ) ^ (3 / 4 - δ)⌋₊
  have hsub : ((range (x + 1)).filter fun p => p.Prime ∧ p % 120 = 53 ∧
      (((p - 1) / 4).Prime ∨ ∃ q₁ q₂ : ℕ, q₁.Prime ∧ q₂.Prime ∧ (p - 1) / 4 = q₁ * q₂ ∧
        (x : ℝ) ^ (1 / 4 + δ) < q₁ ∧ (q₁ : ℝ) < (x : ℝ) ^ (1 / 2 - δ))) ⊆
      range (K + 1) ∪
      (((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 Y1, ((2 : ℕ) : ZMod p) ^ N = 1) ∪
      ((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 Y1, ((3 : ℕ) : ZMod p) ^ N = 1) ∪
      ((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 Y1, ((5 : ℕ) : ZMod p) ^ N = 1) ∪
      ((range (x + 1)).filter fun p => p.Prime ∧ ∃ N ∈ Icc 1 Y3,
        (2 : ZMod p) ^ N = 1 ∧ (3 : ZMod p) ^ N = 1 ∧ (5 : ZMod p) ^ N = 1)) := by
    intro p hp
    simp only [mem_union, mem_filter, mem_range] at hp ⊢
    obtain ⟨hpx, hpp, h120, hcase⟩ := hp
    by_cases hpK : p ≤ K
    · exact Or.inl (by omega)
    have hnG : ∀ a : ZMod p, (a = 2 ∨ a = 3 ∨ a = 5) → orderOf a ≠ p - 1 := by
      rintro a ha he
      exact hpK (hK ⟨hpp, by rcases ha with rfl | rfl | rfl <;> simp [he]⟩)
    have : Fact p.Prime := ⟨hpp⟩
    have hrx : p < x + 1 := hpx
    rcases hcase with hq | ⟨q₁, q₂, h1, h2', hm, hlo, hhi⟩
    · exfalso
      rcases (key h120 (two_pow h120)).1 hq with e | e
      · exact hnG 2 (Or.inl rfl) e
      · have h15 : ((15 : ℕ) : ZMod p) = 0 := by
          push_cast; linear_combination e
        have := Nat.le_of_dvd (by norm_num) ((ZMod.natCast_eq_zero_iff 15 p).mp h15)
        omega
    have hp4 : p = 4 * (q₁ * q₂) + 1 := by rw [← hm]; omega
    have hq1pos : 0 < q₁ := h1.pos
    have hY1 : 1 ≤ 4 * q₁ ∧ 4 * q₁ ≤ Y1 := ⟨by omega, Nat.le_floor (by push_cast; linarith)⟩
    have hY3 : 1 ≤ 4 * q₂ ∧ 4 * q₂ ≤ Y3 := by
      refine ⟨by have := h2'.pos; omega, Nat.le_floor ?_⟩
      have hpxr : ((4 * q₂ : ℕ) : ℝ) * q₁ < x := by
        have : 4 * q₂ * q₁ < x := by rw [hp4] at hrx; nlinarith
        exact_mod_cast this
      have hsplit : (x : ℝ) = x ^ (3 / 4 - δ) * x ^ (1 / 4 + δ) := by
        rw [← Real.rpow_add hx0]; norm_num
      have hpos : (0 : ℝ) < x ^ (1 / 4 + δ) := Real.rpow_pos_of_pos hx0 _
      refine le_of_lt (lt_of_mul_lt_mul_right ?_ hpos.le)
      rw [← hsplit]
      calc ((4 * q₂ : ℕ) : ℝ) * x ^ (1 / 4 + δ) ≤ ((4 * q₂ : ℕ) : ℝ) * q₁ :=
            mul_le_mul_of_nonneg_left hlo.le (Nat.cast_nonneg _)
        _ < x := hpxr
    have kq := fun (a : ZMod p) (ha : a ^ (p / 2) = -1) => (key h120 ha).2 q₁ q₂ h1 h2' hm
    rcases kq 2 (two_pow h120) with e2 | e2 | e2
    · exact absurd e2 (hnG 2 (Or.inl rfl))
    · exact Or.inr (Or.inl (Or.inl (Or.inl ⟨hpx, hpp, 4 * q₁, mem_Icc.mpr hY1, by simpa using e2⟩)))
    rcases kq 3 (three_pow h120) with e3 | e3 | e3
    · exact absurd e3 (hnG 3 (Or.inr (Or.inl rfl)))
    · exact Or.inr (Or.inl (Or.inl (Or.inr ⟨hpx, hpp, 4 * q₁, mem_Icc.mpr hY1, by simpa using e3⟩)))
    rcases kq 5 (five_pow h120) with e5 | e5 | e5
    · exact absurd e5 (hnG 5 (Or.inr (Or.inr rfl)))
    · exact Or.inr (Or.inl (Or.inr ⟨hpx, hpp, 4 * q₁, mem_Icc.mpr hY1, by simpa using e5⟩))
    exact Or.inr (Or.inr ⟨hpx, hpp, 4 * q₂, mem_Icc.mpr hY3, e2, e3, e5⟩)
  have hu := (Nat.cast_le (α := ℝ)).mpr ((card_le_card hsub).trans card5)
  simp only [card_range] at hu
  push_cast at hu
  have hb1 : (Y1 : ℝ) ^ 2 ≤ 16 * (x : ℝ) ^ (1 - δ) := by
    have hf : (Y1 : ℝ) ≤ 4 * (x : ℝ) ^ (1 / 2 - δ) := Nat.floor_le (by positivity)
    calc (Y1 : ℝ) ^ 2 ≤ (4 * (x : ℝ) ^ (1 / 2 - δ)) ^ 2 := by gcongr
      _ = 16 * (x : ℝ) ^ ((1 / 2 - δ) * (2 : ℕ)) := by
        rw [Real.rpow_mul_natCast hx0.le]; ring
      _ ≤ 16 * (x : ℝ) ^ (1 - δ) := by
        have := Real.rpow_le_rpow_of_exponent_le hx1'
          (show (1 / 2 - δ) * ((2 : ℕ) : ℝ) ≤ 1 - δ by push_cast; linarith)
        linarith
  have hb3 : (Y3 : ℝ) ^ ((4 : ℝ) / 3) ≤ (x : ℝ) ^ (1 - δ) := by
    have hf : (Y3 : ℝ) ≤ (x : ℝ) ^ (3 / 4 - δ) := Nat.floor_le (by positivity)
    calc (Y3 : ℝ) ^ ((4 : ℝ) / 3) ≤ ((x : ℝ) ^ (3 / 4 - δ)) ^ ((4 : ℝ) / 3) :=
          Real.rpow_le_rpow (Nat.cast_nonneg _) hf (by norm_num)
      _ = (x : ℝ) ^ ((3 / 4 - δ) * (4 / 3)) := by rw [Real.rpow_mul hx0.le]
      _ ≤ (x : ℝ) ^ (1 - δ) := Real.rpow_le_rpow_of_exponent_le hx1' (by linarith)
  have e2 := h2 2 (by simp) x Y1
  have e3 := h2 3 (by simp) x Y1
  have e5 := h2 5 (by simp) x Y1
  have e35 := h3 x Y3
  push_cast at e2 e3 e5
  have k1 := le_trans hx hu
  have k2 : _ ≤ (K : ℝ) + 1 + C2 * Y1 ^ 2 + C2 * Y1 ^ 2 + C2 * Y1 ^ 2 + C3 * Y3 ^ ((4 : ℝ) / 3) :=
    k1.trans (by gcongr; convert e35 using 3 <;> first | rfl | (ext; simp only [mem_filter]))
  nlinarith [mul_le_mul_of_nonneg_left hb1 hC2, mul_le_mul_of_nonneg_left hb3 hC3]

