/-- A coordinatewise larger exponent vector represents a multiple of the witnessed number. -/
private theorem positiveMultiple (q a b c d e f g : ℕ)
    (hw : (5^a*7^b*11^c*13^d*17^e*19^f*q^g).Weird) (A B C D E F G : ℕ)
    (h : (5^A*7^B*11^C*13^D*17^E*19^F*q^G).Pseudoperfect)
    (ha : A≤a) (hb : B≤b) (hc : C≤c) (hd : D≤d) (he : E≤e) (hf : F≤f) (hg : G≤g) : False := by
  apply hw.2 (OMA.R_Erdos470_erdos_470_variants_odd_weird_10_pow_21_R1.pp_of_dvd ?_ hw.1.pos h)
  exact Nat.mul_dvd_mul (Nat.mul_dvd_mul (Nat.mul_dvd_mul (Nat.mul_dvd_mul (Nat.mul_dvd_mul
    (Nat.mul_dvd_mul (pow_dvd_pow 5 ha) (pow_dvd_pow 7 hb)) (pow_dvd_pow 11 hc))
    (pow_dvd_pow 13 hd)) (pow_dvd_pow 17 he)) (pow_dvd_pow 19 hf)) (pow_dvd_pow q hg)

