  have length_blocks : blocks.length = 391 := by decide
  let pass (n r : ℕ) := decide (n ≤ 8 ∨ n=32 ∨ n=152 ∨ 100000<n) || works n r
  let digit (w i : ℕ) := (w >>> (10*i)) % 1024
  have table : (blocks.zipIdx.all fun z => (List.range 128).all fun i =>
      pass (2 * (128*z.2+i)) (digit z.1 i)) = true := by decide +kernel
  obtain ⟨k,hk⟩ := hEven
  have heq : m=2*k := by omega
  have hblock : k / 128 < blocks.length := by omega
  let w := blocks[k / 128]
  have hmem : (w,k/128) ∈ blocks.zipIdx := List.mk_mem_zipIdx_iff_getElem?.mpr
    (by simp [w,hblock])
  have hits := List.all_eq_true.mp (List.all_eq_true.mp table _ hmem) (k%128)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have hi : 2*(128*(k/128)+k%128) = m := by omega
  let r := digit w (k%128)
  change pass (2*(128*(k/128)+k%128)) r = true at hits
  rw [hi] at hits
  have hn32 : m ≠ 32 := fun h => hnot (by simp [h])
  have hn152 : m ≠ 152 := fun h => hnot (by simp [h])
  have good : works m r = true := by
    simpa [pass, not_le.mpr hm, hn32, hn152, not_lt.mpr hb] using hits
  let q := 2*(r*r % (m+1))-1
  have hh : ((2*q ≤ m ∧ P q = true) ∧ P (m-q) = true) ∧ r.Coprime (m+1) := by
    simpa only [works, q, Bool.and_eq_true, decide_eq_true_eq] using good
  obtain ⟨⟨⟨hle,hq⟩,hp⟩,hr⟩ := hh
  have hqp := hprime q (by omega) hq
  refine ⟨m-q,q,hprime _ (by omega) hp,hqp,by omega,by omega,sun191004_symbol hr ?_⟩
  have h2 := hqp.two_le
  have hmR : (q+1)/2 = r*r % (m+1) := by dsimp [q] at *; omega
  rw [hmR, sq]
  exact Nat.mod_modEq _ _

/-- At a prime-power successor it is enough to work modulo the underlying prime.
The two family exclusions remove pairs already supplied by an integer square
or by a primitive representation of m+1 by x²−2y². -/
def H1 : Prop := ∀ m r k : ℕ, 100000 < m → Even m → r.Prime → m+1=r^(k+1) →
    ¬(m/2).Prime →
    (∀ q s : ℕ, q.Prime → q ≤ m/2 → q+1=2*s^2 → ¬(m-q).Prime) →
    ¬((m-3).Prime ∧ ∃ x y : ℤ, IsCoprime x y ∧ (m : ℤ)+1=x^2-2*y^2) →
    ∃ p : ℕ, p ≤ m ∧ m ≤ 2*p ∧ p.Prime ∧ (m-p).Prime ∧
      ∃ z : (ZMod r)ˣ, 2*(z : ZMod r)^2 = -(p : ZMod r)

/-- For the remaining successors, a unit z determines the larger prime
as the least nonnegative residue of −2z² and thereby determines both primes. -/
def H2 : Prop := ∀ m : ℕ, 100000 < m → Even m →
    (¬∃ r k : ℕ, r.Prime ∧ m+1=r^(k+1)) → ¬(m/2).Prime →
    (∀ q s : ℕ, q.Prime → q ≤ m/2 → q+1=2*s^2 → ¬(m-q).Prime) →
    ¬((m-3).Prime ∧ ∃ x y : ℤ, IsCoprime x y ∧ (m : ℤ)+1=x^2-2*y^2) →
    ∃ z : (ZMod (m+1))ˣ,
      let p := (-(2*(z : ZMod (m+1))^2)).val
      p.Prime ∧ (m-p).Prime ∧ m ≤ 2*p

theorem main : H1 → H2 → type_of% @OeisA191004.conjecture_3 := by
  intro single composite m hm he hnot
  by_cases hfinite : m ≤ 100000
  · exact sun191004_finite m hm hfinite he hnot
  have hlarge := Nat.lt_of_not_ge hfinite
  by_cases hdiag : (m/2).Prime
  · obtain ⟨j,hj⟩ := he
    have hmj : m=2*j := by omega
    have hjp : j.Prime := by simpa [hmj] using hdiag
    have hhalf : j ≤ m/2 := by omega
    refine ⟨j,j,hjp,hjp,hj,hhalf,(Sun191004CRT.goldbach_iff_square hm ⟨j,hj⟩ hjp hjp hj hhalf).mpr ?_⟩
    rw [hmj]
    exact Sun191004Special.diagonal_root j
  by_cases hs : ∃ q s : ℕ, q.Prime ∧ q ≤ m/2 ∧ q+1=2*s^2 ∧ (m-q).Prime
  · obtain ⟨q,s,hq,hle,hsq,hp⟩ := hs
    have hadd : m=(m-q)+q := by omega
    exact ⟨m-q,q,hp,hq,hadd,hle,Sun191004Special.square_small hp hq hadd hle hsq⟩
  have hse q s hq hle heq hp := hs ⟨q,s,hq,hle,heq,hp⟩
  by_cases hn : (m-3).Prime ∧ ∃ x y : ℤ, IsCoprime x y ∧ (m : ℤ)+1=x^2-2*y^2
  · obtain ⟨hp,x,y,hxy,hrep⟩ := hn
    have heq : m = (m-3)+3 := by omega
    obtain ⟨hle,hjac⟩ := sun191004_primitive_norm (q:=3) (d:=2) hp (by decide)
      (by omega) (by decide) hxy (by rw [heq] at hrep; simpa only [Nat.cast_add, Nat.cast_ofNat] using hrep)
    refine ⟨m-3,3,hp,by decide,heq,by omega,?_⟩
    rwa [← heq] at hjac
  by_cases hpow : ∃ r k : ℕ, r.Prime ∧ m+1=r^(k+1)
  · obtain ⟨r,k,hr,hpow⟩ := hpow
    obtain ⟨p,hpm,hmp,hp,hq,z,hz⟩ := single m r k hlarge he hr hpow hdiag hse hn
    have hsum : m = p+(m-p) := by omega
    refine ⟨p,m-p,hp,hq,hsum,by omega,?_⟩
    exact Sun191004CRT.primePowerGoldbach hm he hp hq hsum (by omega) hr hpow
      (z : ZMod r) z.isUnit hz
  obtain ⟨z,hz⟩ := composite m hlarge he hpow hdiag hse hn
  let p := (-(2*(z : ZMod (m+1))^2)).val
  change p.Prime ∧ (m-p).Prime ∧ m ≤ 2*p at hz
  obtain ⟨hp,hq,hmp⟩ := hz
  have hpm : p < m+1 := ZMod.val_lt _
  have hsum : m = p+(m-p) := by omega
  refine ⟨p,m-p,hp,hq,hsum,by omega,(Sun191004CRT.goldbach_iff_square hm he hp hq hsum (by omega)).mpr ?_⟩
  exact ⟨z,z.isUnit,by simp [p]⟩

end OMA.R_OeisA191004_conjecture_3_R1
