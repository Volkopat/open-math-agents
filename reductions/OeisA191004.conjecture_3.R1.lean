import FormalConjectures.OEIS.«191004»
import Mathlib

/-!
A prime pair for Zhi-Wei Sun's even Goldbach refinement is admissible precisely
when the larger prime is −2 times a unit square modulo m+1. The proof below
lifts square roots through arbitrary odd prime powers and combines them by CRT.
For a prime-power successor only the root modulo its prime is needed. For all
other successors its full-modulus root determines both primes.

The numerical range and the exceptional values are checked by the Lean kernel.
Primitive binary quadratic forms, integer-square numerators and diagonal pairs
give further classes of witnesses. Credit: @AlfredMelson.
-/

namespace OMA.R_OeisA191004_conjecture_3_R1

/- Local quadratic characters and unit squares at an odd modulus. -/

namespace Sun191004CRT

private theorem lift_square {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) (a : ℤ)
    (ha : (a : ZMod p) ≠ 0) (hs : IsSquare (a : ZMod p)) (e : ℕ) :
    IsSquare (a : ZMod (p^e)) := by
  have hbase : ∃ r : ℤ, (p : ℤ) ∣ a-r^2 := by
    obtain ⟨b,hb⟩ := (isSquare_iff_exists_sq _).mp hs
    refine ⟨b.valMinAbs, (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp ?_⟩
    simp [hb]
  have lift (k : ℕ) : ∃ r : ℤ, (p : ℤ)^(k+1) ∣ a-r^2 := by
    induction k with
    | zero => simpa using hbase
    | succ k ih =>
      obtain ⟨r,w,hw⟩ := ih
      let P : ℤ := (p:ℤ)^(k+1)
      have hpP : (p:ℤ) ∣ P := dvd_pow_self _ (by omega)
      have hPr : P ∣ a-r^2 := ⟨w,hw⟩
      have hr : (r : ZMod p) ≠ 0 := by
        have hh := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr (hpP.trans hPr)
        intro hzero
        simp [hzero, ha] at hh
      have h2 : (2 : ZMod p) ≠ 0 := by
        change ((2:ℕ) : ZMod p) ≠ 0
        intro hz
        exact hp2 ((Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).mp ((ZMod.natCast_eq_zero_iff 2 p).mp hz))
      let d : ℤ := ((w : ZMod p) / (2*r)).valMinAbs
      have hd : (p:ℤ) ∣ w - 2*r*d := by
        apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp
        simp only [Int.cast_sub, Int.cast_mul, Int.cast_ofNat, d, ZMod.coe_valMinAbs]
        rw [mul_div_cancel₀ _ (mul_ne_zero h2 hr), sub_self]
      obtain ⟨j,hj⟩ := hd
      obtain ⟨l, hl⟩ := hpP
      refine ⟨r+P*d, j-l*d^2, ?_⟩
      change a-(r+P*d)^2 = P*p*(j-l*d^2)
      change a-r^2=P*w at hw
      linear_combination hw + P * hj - P*d^2*hl
  rcases e with _ | e
  · rw [pow_zero]
    exact ⟨1, Subsingleton.elim _ _⟩
  · obtain ⟨r,hr⟩ := lift e
    refine (isSquare_iff_exists_sq _).2 ⟨(r:ZMod _), ?_⟩
    apply sub_eq_zero.mp
    have hh := (ZMod.intCast_zmod_eq_zero_iff_dvd (a-r^2) (p^(e+1))).mpr (by exact_mod_cast hr)
    simpa only [Int.cast_sub, Int.cast_pow] using hh

/-- CRT lifts unit squares at all prime divisors to one square modulo the
full odd modulus, with arbitrary prime factor multiplicities. -/
theorem local_iff_square {a N : ℕ} (ho : Odd N) (hc : a.Coprime N) :
    (∀ p ∈ N.primeFactors, jacobiSym (a : ℤ) p = 1) ↔ IsSquare (a : ZMod N) := by
  classical
  have hn (p : ℕ) (hm : p ∈ N.primeFactors) : (a : ZMod p) ≠ 0 := by
    intro hz
    have hd := Nat.dvd_gcd ((ZMod.natCast_eq_zero_iff a p).mp hz) (Nat.dvd_of_mem_primeFactors hm)
    rw [hc.gcd_eq_one] at hd
    exact (Nat.prime_of_mem_primeFactors hm).not_dvd_one hd
  constructor
  · intro h
    let F := ZMod.equivPi N ho.pos.ne'
    have localSq (p : N.primeFactors) : IsSquare ((a:ℕ) : ZMod (p.val^(N.factorization p.val))) := by
      have : Fact p.val.Prime := ⟨Nat.prime_of_mem_primeFactors p.property⟩
      have hz := ZMod.isSquare_of_jacobiSym_eq_one (h p.val p.property)
      simpa only [Int.cast_natCast] using lift_square
        (ho.ne_two_of_dvd_nat (Nat.dvd_of_mem_primeFactors p.property)) (a:ℤ)
        (by exact_mod_cast hn p.val p.property) hz (N.factorization p.val)
    choose r hr using fun p => (isSquare_iff_exists_sq _).1 (localSq p)
    refine (isSquare_iff_exists_sq _).2 ⟨F.symm r, F.injective ?_⟩
    rw [map_natCast, map_pow, RingEquiv.apply_symm_apply]
    funext p
    exact hr p
  · intro h p hm
    have : Fact p.Prime := ⟨Nat.prime_of_mem_primeFactors hm⟩
    rw [← jacobiSym.legendreSym.to_jacobiSym, legendreSym.eq_one_iff' p (hn p hm)]
    simpa only [map_natCast] using h.map (ZMod.castHom (Nat.dvd_of_mem_primeFactors hm) (ZMod p))


/-- For an oriented even Goldbach representation the character test is a
single quadratic congruence on the larger prime modulo the full successor. -/
theorem goldbach_iff_square {m p q : ℕ} (h8 : 8 < m) (he : Even m)
    (hp : p.Prime) (hq : q.Prime) (hs : m = p+q) (hle : q ≤ m/2) :
    (∀ r ∈ (m+1).primeFactors, jacobiSym (((q+1)/2) : ℤ) r = 1) ↔
      ∃ z : ZMod (m+1), IsUnit z ∧ 2*z^2 = -(p : ZMod (m+1)) := by
  let a := (q+1)/2
  obtain ⟨u, hu⟩ := he
  have hN : Odd (m+1) := ⟨u,by omega⟩
  have hqo : q%2=1 := by
    rcases hq.eq_two_or_odd with h | h
    · rcases hp.eq_two_or_odd with h' | h' <;> omega
    · exact h
  have hqpos := hq.two_le
  have h2a : p+2*a = m+1 := by dsimp [a]; omega
  have ha : 0 < a := by dsimp [a]; omega
  have hlt : a < p := by dsimp [a]; omega
  have hc : a.Coprime (m+1) := by
    let d := a.gcd (m+1)
    have hd : d ∣ a := Nat.gcd_dvd_left _ _
    have hdp : d ∣ p := by
      have h := Nat.dvd_sub (Nat.gcd_dvd_right a (m+1)) (hd.trans (dvd_mul_left a 2))
      rwa [show m+1-2*a=p by omega] at h
    rcases (Nat.dvd_prime hp).mp hdp with h | h
    · exact h
    · have hp_le := Nat.le_of_dvd ha hd
      omega
  have hc2 : IsUnit (2 : ZMod (m+1)) := (ZMod.isUnit_iff_coprime 2 _).2 hN.coprime_two_left
  have hneg : 2*(a : ZMod (m+1)) = -(p : ZMod (m+1)) := by
    have h := congrArg (fun x : ℕ => (x : ZMod (m+1))) h2a
    change ((p+2*a : ℕ) : ZMod (m+1)) = ((m+1 : ℕ) : ZMod (m+1)) at h
    rw [ZMod.natCast_self, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] at h
    exact eq_neg_of_add_eq_zero_right h
  have haj : (((q : ℤ)+1)/2) = (a : ℤ) := rfl
  rw [haj, local_iff_square hN hc, isSquare_iff_exists_sq]
  constructor
  · rintro ⟨z,hz⟩
    refine ⟨z, (isUnit_pow_iff (by decide : 2 ≠ 0)).1 ?_, ?_⟩
    · rw [← hz]
      exact (ZMod.isUnit_iff_coprime _ _).2 hc
    · rwa [← hz]
  · rintro ⟨z, _, hz⟩
    exact ⟨z, hc2.mul_left_cancel (hneg.trans hz.symm)⟩

end Sun191004CRT

/- The local test for a prime-power successor in Sun's Goldbach refinement. -/

namespace Sun191004CRT

theorem primePowerGoldbach {m p q r k : ℕ} (h8 : 8 < m) (he : Even m)
    (hp : p.Prime) (hq : q.Prime) (hs : m=p+q) (_hle : q ≤ m/2)
    (hr : r.Prime) (hpow : m+1 = r^(k+1)) (z : ZMod r) (hz : IsUnit z)
    (heq : 2*z^2 = -(p:ZMod r)) :
    ∀ s ∈ (m+1).primeFactors, jacobiSym (((q+1)/2):ℤ) s = 1 := by
  let : Fact r.Prime := ⟨hr⟩
  have hrd : r ∣ m+1 := hpow ▸ dvd_pow_self _ (by omega)
  have ho : Odd (m+1) := by obtain ⟨u, hu⟩ := he; exact ⟨u,by omega⟩
  have hro : r ≠ 2 := ho.ne_two_of_dvd_nat hrd
  have h2 : (2:ZMod r) ≠ 0 := fun h =>
    hro ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).mp ((ZMod.natCast_eq_zero_iff 2 r).mp h))
  have hqo : q%2=1 := by
    obtain ⟨u, hu⟩ := he
    rcases hq.eq_two_or_odd with h | h
    · rcases hp.eq_two_or_odd with h' | h' <;> omega
    · exact h
  let a := (q+1)/2
  have hsum : p+2*a=m+1 := by dsimp [a]; omega
  have haj : (((q : ℤ)+1)/2) = (a : ℤ) := rfl
  have hzero := (ZMod.natCast_eq_zero_iff _ r).2 hrd
  rw [← hsum, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] at hzero
  have hloc : (a:ZMod r) = z^2 :=
    mul_left_cancel₀ h2 ((eq_neg_of_add_eq_zero_right hzero).trans heq.symm)
  intro s hmem
  have hsp := Nat.prime_of_mem_primeFactors hmem
  have hsd := Nat.dvd_of_mem_primeFactors hmem
  rw [hpow] at hsd
  have hsr : s = r := (Nat.prime_dvd_prime_iff_eq hsp hr).1 (hsp.dvd_of_dvd_pow hsd)
  subst s
  rw [haj, ← jacobiSym.legendreSym.to_jacobiSym]
  exact (legendreSym.eq_one_iff' r (hloc ▸ pow_ne_zero _ hz.ne_zero)).2
    ((isSquare_iff_exists_sq _).2 ⟨z, hloc⟩)

end Sun191004CRT

namespace Sun191004Special

/-- Every ordered Goldbach pair with (q+1)/2 an integer square meets all the
local character tests. A prime factor of its square root and of m+1 would have
to be the larger Goldbach prime, which is strictly larger than the root. -/
theorem square_small {m p q s : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hs : m = p+q) (hle : q ≤ m/2) (hsq : q+1=2*s^2) :
    ∀ r ∈ (m+1).primeFactors, jacobiSym (((q+1)/2) : ℤ) r = 1 := by
  have hs1 : 1 < s := by
    have := hq.two_le
    by_contra! h
    interval_cases s <;> simp_all
  have hqp : q ≤ p := by omega
  have hl : s < p := by have := Nat.le_mul_self s; nlinarith
  intro r hr
  have hrp := Nat.prime_of_mem_primeFactors hr
  have hcop : r.Coprime s := hrp.coprime_iff_not_dvd.mpr (by
    intro hrs
    have hsq' : r ∣ q+1 := hsq ▸ (hrs.trans (by exact ⟨2*s,by ring⟩))
    have hdp := Nat.dvd_sub (Nat.dvd_of_mem_primeFactors hr) hsq'
    rw [show m+1-(q+1) = p by omega] at hdp
    have hpr : r=p := (Nat.prime_dvd_prime_iff_eq hrp hp).mp hdp
    exact (Nat.not_dvd_of_pos_of_lt (by omega : 0 < s) hl) (hpr ▸ hrs))
  have hsqz : (((q : ℤ)+1)/2) = (s:ℤ)^2 := by
    have hh : (q:ℤ)+1=2*(s:ℤ)^2 := by exact_mod_cast hsq
    omega
  rw [hsqz]
  exact jacobiSym.sq_one' ((Int.gcd_natCast_natCast s r) ▸ hcop.symm.gcd_eq_one)

/-- Doubling any odd prime p gives a witness p+p. In ZMod (2*p+1),
twice −p is one, so −p itself is the required invertible square root. -/
theorem diagonal_root (p : ℕ) :
    ∃ z : ZMod (2*p+1), IsUnit z ∧ 2*z^2 = -(p : ZMod (2*p+1)) := by
  have hx : ((2*p+1 : ℕ) : ZMod (2*p+1)) = 0 := ZMod.natCast_self _
  push_cast at hx
  have hh : 2*(-(p : ZMod (2*p+1))) = 1 := by linear_combination -hx
  refine ⟨-(p : ZMod (2*p+1)), isUnit_iff_exists_inv'.mpr ⟨2,hh⟩, ?_⟩
  calc 2 * (-(p : ZMod (2*p+1)))^2 = (2 * -(p : ZMod (2*p+1))) * -(p : ZMod (2*p+1)) := by ring
       _ = _ := by rw [hh, one_mul]

end Sun191004Special

/- Local residue counts for the Goldbach refinement of A191004. -/
open scoped BigOperators

namespace Sun191004Local

/-- For an odd prime r and a nonzero excluded residue a, the number of nonzero
squares other than a is (r−2−χ(a))/2. For r dividing m+1 the two prohibited
residues of (q+1)/2 for a pair of units q, m−q are zero and 1/2. -/
theorem local_count {r : ℕ} [Fact r.Prime] (hr : r ≠ 2) (a : ZMod r) (ha : a ≠ 0) :
    2 * ((Finset.univ.filter fun x : ZMod r =>
      x ≠ 0 ∧ x ≠ a ∧ quadraticChar (ZMod r) x = 1).card : ℤ) =
      (r : ℤ) - 2 - quadraticChar (ZMod r) a := by
  classical
  let χ := quadraticChar (ZMod r)
  have point (x : ZMod r) :
      (if x ≠ 0 ∧ x ≠ a ∧ χ x = 1 then (2:ℤ) else 0) +
      (if x=0 then 1 else 0) + (if x=a then 1+χ a else 0) = 1+χ x := by
    by_cases hx : x = 0
    · subst x; simp [χ, ha.symm]
    by_cases hxa : x = a
    · subst x; simp [ha]
    rcases quadraticChar_dichotomy (F := ZMod r) hx with h|h <;> simp [χ,hx,hxa,h]
  have hsum := Finset.sum_congr (s₁ := (Finset.univ : Finset (ZMod r))) rfl (fun x _ => point x)
  have hchar : ∑ x, χ x = 0 := quadraticChar_sum_zero (by rwa [ZMod.ringChar_zmod_n r])
  simp only [Finset.sum_add_distrib, Finset.sum_ite, Finset.sum_const_zero, add_zero,
    Finset.sum_const, nsmul_eq_mul, Finset.card_univ, ZMod.card, mul_one, hchar] at hsum
  simpa [χ, mul_comm, ha] using (show
    2 * ((Finset.univ.filter fun x : ZMod r => x ≠ 0 ∧ x ≠ a ∧ χ x = 1).card : ℤ) =
      (r : ℤ)-2-χ a by
      have hsingleton (z : ZMod r) : (Finset.univ.filter fun x : ZMod r => x=z) = {z} := by ext x; simp
      simp [hsingleton] at hsum
      linarith)

end Sun191004Local

/- Primitive norm values give witnesses for the even refinement in OEIS A191004.
The prime supply used in the last implication is an instance of Theorem 1.1 in
E. Fuchs, C. Hsu, J. Rickards, D. Schindler and K. E. Stange, arXiv:2504.20289. -/

theorem sun191004_primitive_norm {p q d : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hqp : q ≤ p) (hd : q+1 = 2*d)
    {x y : ℤ} (hcop : IsCoprime x y) (hnorm : (p : ℤ) + q + 1 = x^2 - (d : ℤ)*y^2) :
    q ≤ (p+q)/2 ∧
      ∀ r ∈ (p+q+1).primeFactors, jacobiSym (((q+1)/2) : ℤ) r = 1 := by
  refine ⟨by omega, ?_⟩
  intro r hr
  have hrp := Nat.prime_of_mem_primeFactors hr
  have : Fact r.Prime := ⟨hrp⟩
  have hrdiv := Nat.dvd_of_mem_primeFactors hr
  have hdlt : d < p := by have := hq.two_le; omega
  have hdpos : 0 < d := by omega
  have hdn : ¬r ∣ d := by
    intro hrD
    have hsum : r ∣ q+1 := hd ▸ dvd_mul_of_dvd_right hrD 2
    have hpdiv : r ∣ p := (Nat.dvd_add_left hsum).mp (by rwa [← Nat.add_assoc])
    have hrp' := (Nat.dvd_prime hp).mp hpdiv
    rcases hrp' with h | h
    · exact hrp.ne_one h
    · have := Nat.le_of_dvd hdpos hrD; omega
  have hhalf : ((q : ℤ)+1)/2 = (d : ℤ) := by omega
  rw [hhalf, ← jacobiSym.legendreSym.to_jacobiSym]
  have dnon : ((d : ℤ) : ZMod r) ≠ 0 := by
    exact_mod_cast (mt (ZMod.natCast_eq_zero_iff d r).mp hdn)
  have hdivZ : (r : ℤ) ∣ x^2 - (d : ℤ)*y^2 := by
    rw [← hnorm]
    exact_mod_cast hrdiv
  have eqz := (ZMod.intCast_zmod_eq_zero_iff_dvd _ r).mpr hdivZ
  push_cast at eqz
  have ynon : (y : ZMod r) ≠ 0 := by
    intro hy
    have hx : (x : ZMod r) = 0 := by simpa [hy] using eqz
    obtain ⟨a,b,h⟩ := hcop.map (Int.castRingHom (ZMod r))
    simp [hx,hy] at h
  exact legendreSym.eq_one_of_sq_sub_mul_sq_eq_zero dnon ynon (by simpa using eqz)

theorem sun191004_q3_family
    (primes : ∀ N : ℕ, ∃ p : ℕ, N ≤ p ∧ p.Prime ∧ p % 5 = 2 ∧
      ∃ x y : ℤ, IsCoprime x y ∧ (p : ℤ) = x^2 - 2*y^2 - 4) (N : ℕ) :
    ∃ m p : ℕ, N ≤ m ∧ 8 < m ∧ 10 ∣ m ∧ ¬(m/2).Prime ∧
      p.Prime ∧ m = p+3 ∧ 3 ≤ m/2 ∧
      ∀ r ∈ (m+1).primeFactors, jacobiSym 2 r = 1 := by
  obtain ⟨p,hpN,hp,hp5,x,y,hcop,hrep⟩ := primes (max N 11)
  have hpN' : N ≤ p := le_trans (le_max_left _ _) hpN
  have hp11 : 11 ≤ p := le_trans (le_max_right _ _) hpN
  have oddp := hp.odd_of_ne_two (by omega)
  have h := sun191004_primitive_norm (q:=3) (d:=2) hp (by decide) (by omega)
    (by decide) hcop (by push_cast; linarith)
  have h10 : 10 ∣ p+3 := by rcases oddp with ⟨t,ht⟩; omega
  have hnprime : ¬((p+3)/2).Prime := by
    intro hpr
    have h5 : 5 ∣ (p+3)/2 := by omega
    rcases (Nat.dvd_prime hpr).mp h5 with h5 | h5 <;> omega
  exact ⟨p+3, p, by omega, by omega, h10, hnprime, hp, rfl, h.1, by simpa using h.2⟩

/-- A unit square modulo m+1 has Jacobi symbol one at every prime factor. -/
private lemma sun191004_symbol {m q r : ℕ} (hr : r.Coprime (m+1))
    (hs : (q+1)/2 ≡ r^2 [MOD m+1]) :
    ∀ p ∈ (m+1).primeFactors, jacobiSym (((q+1)/2) : ℤ) p = 1 := by
  intro p hp
  have hd := Nat.dvd_of_mem_primeFactors hp
  have he := Int.natCast_modEq_iff.mpr (hs.of_dvd hd)
  have he' : ((q+1)/2 : ℤ) ≡ (r : ℤ)^2 [ZMOD (p : ℤ)] := by
    simpa only [Int.natCast_ediv, Nat.cast_ofNat, Nat.cast_add, Nat.cast_one,
      Nat.cast_pow] using he
  rw [jacobiSym.mod_left' he']
  apply jacobiSym.sq_one'
  exact Int.gcd_natCast_natCast r p ▸ Nat.Coprime.of_dvd_right hd hr

/-- The exceptional integers in Sun's statement really have no admissible representation. -/
theorem sun191004_exceptions (m : ℕ) (hm : m = 32 ∨ m = 152) :
    ¬ ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ m = p + q ∧ q ≤ m/2 ∧
      ∀ l ∈ (m+1).primeFactors, jacobiSym (((q+1)/2) : ℤ) l = 1 := by
  rintro ⟨p,q,hp,hq,hs,hle,hj⟩
  have aux (n : ℕ) (key : ∀ i : Fin (n/2+1), ¬ ((n-i.val).Prime ∧ i.val.Prime ∧
      ∀ l ∈ (n+1).primeFactors, jacobiSym (((i.val+1)/2) : ℤ) l = 1)) (hn : m=n) :
      False := by
    subst n
    exact key ⟨q, by omega⟩ ⟨by simpa [hs] using hp,hq,hj⟩
  rcases hm with h | h
  · exact aux 32 (by decide +kernel) h
  · exact aux 152 (by decide +kernel) h

