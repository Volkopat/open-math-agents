/-- Every even integer from 10 through 100,000, apart from the two exceptions, has
a representation whose half-prime numerator is a unit square modulo m+1. -/
theorem sun191004_finite (m : ℕ) (hm : 8 < m) (hb : m ≤ 100000) (hEven : Even m)
    (hnot : m ∉ ({32,152} : Finset ℕ)) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ m = p+q ∧ q ≤ m/2 ∧
      ∀ l ∈ (m+1).primeFactors, jacobiSym (((q+1)/2) : ℤ) l = 1 := by
  let D : ℕ := 61076929465933196099278943388997855150356143888238371488665496574810764573680243467182799164806563626522181311132959748531230210
  have hD : ∀ j : Fin 317, j.val.Prime → D % j.val = 0 := by decide +kernel
  let small : ℕ := 0x28800200a20a08208028228800800a28028208820a00a08800228a20208828828208a20a08a28ac
  have hsmall : ∀ j : Fin 317, small.testBit j.val = true → j.val.Prime := by decide +kernel
  let P (n : ℕ) : Bool := if n ≤ 316 then small.testBit n else n.gcd D == 1
  have hprime (n : ℕ) (hn : n ≤ 100000) (h : P n = true) : n.Prime := by
    by_cases hs : n ≤ 316
    · exact hsmall ⟨n, by omega⟩ (by simpa [P,hs] using h)
    have hh : n.Coprime D := by simpa [P, hs, Nat.Coprime] using h
    by_contra hnp
    have hl := Nat.minFac_sq_le_self (show 0 < n by omega) hnp
    have hq : n.minFac ≤ 316 := by nlinarith [sq_nonneg (n.minFac - 317 : ℤ)]
    have hpr := Nat.minFac_prime (show n ≠ 1 by omega)
    exact (Nat.not_coprime_of_dvd_of_dvd hpr.one_lt (Nat.minFac_dvd n)
      (Nat.dvd_of_mod_eq_zero (hD ⟨n.minFac, by omega⟩ hpr))) hh
