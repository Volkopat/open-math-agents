set_option maxHeartbeats 4000000 in
/-- The initial 'V' encodes order 23. Bits after it are the upper triangle
by columns, most significant bit first in each six-bit character. -/
lemma catalogue_counts :
  let rows : Fin 6 → ℕ := ![
    0x10202010020f41e41e20f17c3ef87af8797c3c3ff007fe007fe003ff0000,
    0x20004140a02802f02f0179fa1ff43bf439fa1c7d780faf00faf007d78000,
    0x208000a0302304603981cdf8cff19bf199f8cc7dcc0fb980fb9807dcc000,
    0x20810000681601c04381e3f877f0ebf0e9f8747de20fbc40fbc407de2000,
    0x20810100801f03e03e01f1f83ff07bf079f83c7df00fbe00fbe007df0000,
    0x34803ad970f000000000000000107fe0ffa0ff907fc3e1f07c3e07c3e03e1f000]
  let bit (word : ℕ) (i j : Fin 23) :=
    let hi := max i.val j.val
    let pos := hi * (hi-1) / 2 + min i.val j.val
    decide (i≠j) && word.testBit (257-pos)
  ∀ k : Fin 6, (∑ i, ∑ j, if bit (rows k) i j then (1:ℕ) else 0) =
    2 * (![104,103,102,101,105,100] : Fin 6 → ℕ) k := by
  decide +kernel

private lemma degree_sum {V : Type*} [Fintype V] (G : SimpleGraph V) (i : V) :
    G.degree i = ∑ j, if G.Adj i j then (1:ℕ) else 0 := by
  classical
  rw [←G.card_neighborFinset_eq_degree,G.neighborFinset_eq_filter,card_filter]

private lemma sum_on {V : Type*} {W : Finset V} {n : ℕ} (e : Fin n ≃ W) (h : V → ℕ) :
    (∑ j,h (e j)) = ∑ j ∈ W,h j :=
  (Equiv.sum_comp e (fun x : W => h x)).trans (sum_coe_sort W h)

private lemma twice_loss {n : ℕ} (G : SimpleGraph (Fin n)) (c : Fin n → Bool) :
    (∑ i,∑ j,if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) =
    2*(∑ i,∑ j,if i<j ∧ G.Adj i j ∧ c i=c j then (1:ℕ) else 0) := by
  let h (i j : Fin n) := if i<j ∧ G.Adj i j ∧ c i=c j then (1:ℕ) else 0
  have split (i j) : (if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) = h i j+h j i := by
    rcases lt_trichotomy i j with l|rfl|l
    · simp [h,l,not_lt_of_gt l]
    · simp [h]
    · simp [h,l,not_lt_of_gt l,G.adj_comm i j,eq_comm (a:=c i) (b:=c j)]
  calc
    _ = ∑ i, ∑ j, (h i j+h j i) := sum_congr rfl fun i _ => sum_congr rfl fun j _ => split i j
    _ = _ := by
      simp only [sum_add_distrib]
      rw [sum_comm (f:=fun i j => h j i)]
      change _ + _ = 2*(∑ i,∑ j,h i j)
      omega

/-- At order 23 the only candidate for a loss above twenty has minimum
degree eight or nine. Deleting a minimum-degree vertex in this range
would leave a 17-loss extremizer with at most nine small-degree vertices. -/
lemma upper23 (small : H1) (profile : H2) (G : SimpleGraph (Fin 23)) (tri : G.CliqueFree 3) :
    ∃ c : Fin 23 → Bool, (∑ i,∑ j,if i<j ∧ G.Adj i j ∧ c i=c j then (1:ℕ) else 0) ≤ 20 := by
  classical
  by_cases high : 10 ≤ G.minDegree
  · obtain ⟨paint⟩ := colorable_of_cliqueFree_lt_minDegree (G:=G) (r:=2) tri
        (by simpa using (show 9<G.minDegree by omega))
    let b := (Fintype.equivFin Bool).symm
    refine ⟨fun i => b (paint i),?_⟩
    have proper (i j : Fin 23) : ¬(i<j ∧ G.Adj i j ∧ b (paint i)=b (paint j)) :=
      fun h => paint.valid h.2.1 (b.injective h.2.2)
    simp only [if_neg (proper _ _),sum_const_zero,Nat.zero_le]
  obtain ⟨v,hv⟩ := G.exists_minimal_degree_vertex
  let U := (univ : Finset (Fin 23)).erase v
  have cardU : U.card=22 := by simp [U]
  let e : Fin 22 ≃ U := (Fintype.equivFinOfCardEq (by simpa using cardU : Fintype.card U=22)).symm
  let inc := e.toEmbedding.trans (Function.Embedding.subtype (fun i : Fin 23 => i∈U))
  let K := G.comap inc
  have trK : K.CliqueFree 3 := CliqueFree.comap (Embedding.comap inc G).isContained tri
  let w (i j : Fin 23) := if G.Adj i j then (1:ℕ) else 0
  have sym (i j) : w i j=w j i := by simp only [w,G.adj_comm i j]
  have diag (i) : w i i=0 := by simp [w]
  have dcore (i : Fin 22) : G.degree (e i) = K.degree i + w (e i) v := by
    have eq : K.degree i = ∑ j ∈ U, w (e i) j :=
      (degree_sum K i).trans (sum_on e (w (e i)))
    rw [degree_sum,eq]
    exact (sum_erase_add univ (w (e i)) (mem_univ v)).symm
  have dv : (∑ j ∈ U,w v j)=G.degree v := by
    have eq := sum_erase_add univ (w v) (mem_univ v)
    simpa only [diag,add_zero,degree_sum,U,w] using eq
  let loss (c : Fin 22 → Bool) := ∑ i,∑ j, if K.Adj i j ∧ c i=c j then (1:ℕ) else 0
  obtain ⟨f,hf⟩ := small K trK
  change loss f ≤ 34 at hf
  obtain ⟨c,hc⟩ : ∃ c, loss c+2*(G.degree v/2) ≤ 40 := by
    by_cases low : G.degree v ≤ 7
    · exact ⟨f,by omega⟩
    by_cases cheaper : ∃ c, loss c ≤ 32
    · obtain ⟨c,hc⟩ := cheaper
      exact ⟨c,by omega⟩
    have floor (c) : 34 ≤ loss c := by
      have bound : ¬loss c ≤ 32 := fun h => cheaper ⟨c,h⟩
      have even := twice_loss K c
      change loss c=_ at even
      omega
    have least : IsLeast (Set.range loss) 34 := by
      refine ⟨⟨f,le_antisymm hf (floor f)⟩,?_⟩
      rintro _ ⟨c,rfl⟩; exact floor c
    have lower (i : Fin 22) := G.minDegree_le_degree (e i)
    have atLeast (i : Fin 22) : 7 ≤ K.degree i := by
      have a := lower i; have b := dcore i
      have h : w (e i) v ≤ 1 := by dsimp [w]; split <;> omega
      omega
    have mustSee (i : Fin 22) (hi : K.degree i ≤ 7) : G.Adj v (e i) := by
      by_contra h
      have h' : ¬G.Adj (e i) v := fun a => h a.symm
      have a := lower i; have b := dcore i
      simp only [w,h',if_false,add_zero] at b
      omega
    rcases profile K trK least with ⟨i,hi⟩|many
    · exact False.elim ((by decide : ¬7 ≤ 6) ((atLeast i).trans hi))
    · have sub : (univ.filter (fun i : Fin 22 => K.degree i ≤ 7)) ⊆
          univ.filter (fun i : Fin 22 => G.Adj v (e i)) :=
        fun i hi => mem_filter.mpr ⟨mem_univ _,mustSee i (mem_filter.mp hi).2⟩
      have h := card_le_card sub
      have count : (univ.filter (fun i : Fin 22 => G.Adj v (e i))).card=G.degree v := by
        rw [card_filter]
        exact (sum_on e (w v)).trans dv
      have ten : 10 ≤ G.degree v := many.trans (h.trans count.le)
      omega
  let f' (x : Fin 23) := if h : x∈U then c (e.symm ⟨x,h⟩) else false
  have agrees (i : Fin 22) : f' (e i)=c i := by simp [f']
  let mono (i j : Fin 23) := if f' i=f' j then w i j else 0
  have transport : (∑ i ∈ U,∑ j ∈ U, mono i j)=loss c := by
    rw [←sum_on e (fun i => ∑ j ∈ U,mono i j)]
    apply sum_congr rfl; intro i _
    rw [←sum_on e (mono (e i))]
    apply sum_congr rfl; intro j _
    have adj : K.Adj i j ↔ G.Adj (e i) (e j) := Iff.rfl
    by_cases z : c i=c j <;> simp [mono,w,agrees,adj,z]
  obtain ⟨g,hg⟩ := OMA.R_Erdos23_erdos_23_variants_n5_R2.extend_color
    univ (mem_univ v) w sym diag f'
  change (∑ i,∑ j,if g i=g j then w i j else 0) ≤
    (∑ i ∈ U,∑ j ∈ U,mono i j)+2*((∑ j ∈ U,w v j)/2) at hg
  rw [transport,dv] at hg
  have cell (i j) : (if g i=g j then w i j else 0) =
      (if G.Adj i j ∧ g i=g j then 1 else 0) := by by_cases h : g i=g j <;> simp [h,w]
  simp_rw [cell] at hg
  have even := twice_loss G g
  exact ⟨g,by omega⟩

private lemma cut_subgraph23 (G : SimpleGraph (Fin 23)) (c : Fin 23 → Bool)
    (cut : (∑ i,∑ j, if G.Adj i j ∧ c i=c j then 1 else 0) ≤ (40:ℕ)) :
    ∃ H : SimpleGraph (Fin 23), H ≤ G ∧ H.IsBipartite ∧ (G.edgeFinset \ H.edgeFinset).card ≤ 20 := by
  let H : SimpleGraph (Fin 23) := {
    Adj := fun i j => G.Adj i j ∧ c i≠c j
    symm := ⟨fun _ _ h => ⟨h.1.symm,Ne.symm h.2⟩⟩
    loopless := ⟨fun v h => h.2 rfl⟩ }
  let M : SimpleGraph (Fin 23) := {
    Adj := fun i j => G.Adj i j ∧ c i=c j
    symm := ⟨fun _ _ h => ⟨h.1.symm,h.2.symm⟩⟩
    loopless := ⟨fun v h => G.loopless.irrefl v h.1⟩ }
  let : DecidableRel H.Adj := fun _ _ => Classical.propDecidable _
  let : DecidableRel M.Adj := fun _ _ => Classical.propDecidable _
  let e : Bool ≃ Fin 2 := Fintype.equivFin Bool
  refine ⟨H,fun _ _ h => h.1,⟨SimpleGraph.Coloring.mk (fun i => e (c i))
    (fun h eq => h.2 (e.injective eq))⟩,?_⟩
  have diff : G.edgeFinset \ H.edgeFinset = M.edgeFinset := by
    apply Finset.ext
    intro t
    induction t using Sym2.inductionOn with
    | _ i j =>
      constructor
      · intro h
        obtain ⟨hg,hn⟩ := Finset.mem_sdiff.mp h
        have ge : G.Adj i j := SimpleGraph.mem_edgeFinset.mp hg
        have eq : c i=c j := by
          by_contra ne
          exact hn (SimpleGraph.mem_edgeFinset.mpr (show H.Adj i j from ⟨ge,ne⟩))
        exact SimpleGraph.mem_edgeFinset.mpr (show M.Adj i j from ⟨ge,eq⟩)
      · intro h
        have mh : M.Adj i j := SimpleGraph.mem_edgeFinset.mp h
        apply Finset.mem_sdiff.mpr
        exact ⟨SimpleGraph.mem_edgeFinset.mpr mh.1,fun hh =>
          (show H.Adj i j from SimpleGraph.mem_edgeFinset.mp hh).2 mh.2⟩
  have edges := OMA.R_Erdos23_erdos_23_variants_n5_R2.edge_sum M
  have bound : 2*M.edgeFinset.card ≤ (40:ℕ) := by
    apply edges.symm.le.trans
    apply le_trans _ cut
    apply le_of_eq
    apply sum_congr rfl; intro i _; apply sum_congr rfl; intro j _
    by_cases h : G.Adj i j ∧ c i=c j
    · simp [h,show M.Adj i j from h]
    · simp [h,show ¬M.Adj i j from h]
  rw [diff]; omega

/-- In graph language, a spanning bipartite subgraph misses at most twenty edges. -/
lemma bipartize23 (small : H1) (profile : H2) (G : SimpleGraph (Fin 23)) (tri : G.CliqueFree 3) :
    ∃ H : SimpleGraph (Fin 23), H ≤ G ∧ H.IsBipartite ∧ (G.edgeFinset \ H.edgeFinset).card ≤ 20 := by
  obtain ⟨c,hc⟩ := upper23 small profile G tri
  apply cut_subgraph23 G c
  rw [twice_loss]
  omega

private lemma sum_perm22 (e : Equiv.Perm (Fin 22)) (F : Fin 22 → Fin 22 → ℕ) :
    (∑ i,∑ j,F (e i) (e j)) = ∑ i,∑ j,F i j := by
  calc
    _ = ∑ i,∑ j,F (e i) j := sum_congr rfl fun i _ => Equiv.sum_comp e (F (e i))
    _ = _ := Equiv.sum_comp e (fun i => ∑ j,F i j)

