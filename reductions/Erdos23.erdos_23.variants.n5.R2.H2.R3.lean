import OMAReductions.R_Erdos23_erdos_23_variants_n5_R2
import Mathlib

/-! # The order-23 upper bound from McKay's order-22 catalogue

Delete a minimum-degree vertex. In the degree-eight and degree-nine cases
its deletion cannot leave an order-22 extremizer: all the small-degree
vertices of that core would have to be adjacent to the deleted vertex.
The catalogue data are from minbip22_17.g6 in Brendan McKay's archive
https://users.cecs.anu.edu.au/~bdm/data/graphs.html .
The cut extension is from the merged parent reduction by @steveDOTdigital.
The order-23 relabeling and catalogue step are adapted from PR #26053. -/

namespace OMA.R_Erdos23_erdos_23_variants_n5_R2_H2_R3
open Finset SimpleGraph
open scoped Classical

/-- The universal order-22 bound counts both orientations. -/
def H1 : Prop := ∀ K : SimpleGraph (Fin 22), K.CliqueFree 3 →
  ∃ c : Fin 22 → Bool, (∑ i,∑ j, if K.Adj i j ∧ c i=c j then (1:ℕ) else 0) ≤ 34

/-- Degree obstruction at the order-22 extremal value. -/
def H2 : Prop := ∀ K : SimpleGraph (Fin 22), K.CliqueFree 3 →
  IsLeast (Set.range (fun c : Fin 22 → Bool =>
    ∑ i,∑ j, if K.Adj i j ∧ c i=c j then (1:ℕ) else 0)) 34 →
  (∃ i,K.degree i ≤ 6) ∨ 10 ≤ (univ.filter (fun i => K.degree i ≤ 7)).card

/-- Completeness of the extremal catalogue at cost exactly twenty.
The permutation sends graph6 vertex numbers to vertices of K. -/
def H3 : Prop :=
  let rows : Fin 6 → ℕ := ![
    0x10202010020f41e41e20f17c3ef87af8797c3c3ff007fe007fe003ff0000,
    0x20004140a02802f02f0179fa1ff43bf439fa1c7d780faf00faf007d78000,
    0x208000a0302304603981cdf8cff19bf199f8cc7dcc0fb980fb9807dcc000,
    0x20810000681601c04381e3f877f0ebf0e9f8747de20fbc40fbc407de2000,
    0x20810100801f03e03e01f1f83ff07bf079f83c7df00fbe00fbe007df0000,
    0x34803ad970f000000000000000107fe0ffa0ff907fc3e1f07c3e07c3e03e1f000]
  let bit (word : ℕ) (i j : Fin 23) :=
    let hi := max i.val j.val
    let pos := hi * (hi-1) / 2 + min i.val j.val
    decide (i≠j) && word.testBit (257-pos)
  ∀ K : SimpleGraph (Fin 23), K.CliqueFree 3 →
  let cost (c : Fin 23 → Bool) := ∑ i, ∑ j,
    if i<j ∧ K.Adj i j ∧ c i=c j then (1:ℕ) else 0
  IsLeast (Set.range cost) 20 → ∃ (k : Fin 6) (e : Equiv.Perm (Fin 23)),
    ∀ i j, K.Adj (e i) (e j) ↔ bit (rows k) i j = true

