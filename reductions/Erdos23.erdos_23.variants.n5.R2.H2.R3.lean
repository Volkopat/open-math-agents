  let bit (word : ℕ) (i j : Fin 22) :=
    let hi := max i.val j.val
    let pos := hi*(hi-1)/2 + min i.val j.val
    decide (i≠j) && word.testBit (233-pos)
  let loss (K : SimpleGraph (Fin 22)) (c : Fin 22 → Bool) :=
    ∑ i,∑ j,if K.Adj i j ∧ c i=c j then (1:ℕ) else 0
  let best (K : SimpleGraph (Fin 22)) :=
    (univ.image (loss K)).min' (univ_nonempty.image _)
  (∀ K : SimpleGraph (Fin 22), Maximal (fun T : SimpleGraph (Fin 22) => T.CliqueFree 3) K →
    (∀ L : SimpleGraph (Fin 22), L.CliqueFree 3 → best L ≤ best K) →
    ∃ r ∈ records, ∃ e : Equiv.Perm (Fin 22),
      ∀ i j, K.Adj (e i) (e j) ↔ bit r.1 i j=true) → H1 ∧ H2 ∧
    (∀ G : SimpleGraph (Fin 23), G.CliqueFree 3 →
      ∃ H : SimpleGraph (Fin 23), H ≤ G ∧ H.IsBipartite ∧ (G.edgeFinset \ H.edgeFinset).card ≤ 20) := by
  intro records bit loss best covers
  let audited (r : ℕ × ℕ × Fin 22) :=
    let deg (i : Fin 22) := ∑ j, if bit r.1 i j then (1:ℕ) else 0
    decide ((∑ i : Fin 22, ∑ j : Fin 22, if bit r.1 i j=true ∧
      r.2.1.testBit i.val=r.2.1.testBit j.val then (1:ℕ) else 0) ≤ 34 ∧
      (deg r.2.2 ≤ 6 ∨ 10 ≤ (univ.filter (fun i => deg i ≤ 7)).card))
  have passed : records.all audited=true := by decide +kernel
  have certificate (r) (hr : r∈records) := (List.all_eq_true.mp passed) r hr
  have rowFacts (K : SimpleGraph (Fin 22)) (r) (hr : r∈records) (e : Equiv.Perm (Fin 22))
      (adj : ∀ i j, K.Adj (e i) (e j) ↔ bit r.1 i j=true) :
      (∃ c, loss K c ≤ 34) ∧ ((∃ i,K.degree i ≤ 6) ∨
        10 ≤ (univ.filter (fun i => K.degree i ≤ 7)).card) := by
    obtain ⟨cut,prof⟩ := of_decide_eq_true (certificate r hr)
    let f (x : Fin 22) := r.2.1.testBit (e.symm x).val
    have agree (i) : f (e i)=r.2.1.testBit i.val := by simp [f]
    have deg (i : Fin 22) : K.degree (e i) =
        ∑ j,if bit r.1 i j then (1:ℕ) else 0 := by
      rw [degree_sum,←Equiv.sum_comp e (fun j => if K.Adj (e i) j then (1:ℕ) else 0)]
      simp_rw [adj]
    constructor
    · refine ⟨f,?_⟩
      change (∑ i,∑ j,if K.Adj i j ∧ f i=f j then (1:ℕ) else 0) ≤ 34
      rw [←sum_perm22 e (fun i j => if K.Adj i j ∧ f i=f j then (1:ℕ) else 0)]
      simpa only [adj,agree] using cut
    · rcases prof with short|many
      · exact Or.inl ⟨e r.2.2,(deg _).trans_le short⟩
      · right
        rw [card_filter,←Equiv.sum_comp e (fun i => if K.degree i ≤ 7 then (1:ℕ) else 0)]
        simpa only [card_filter,deg] using many
  have attained (K : SimpleGraph (Fin 22)) : ∃ c,loss K c=best K :=
    by simpa only [mem_image,mem_univ,true_and] using
         (min'_mem (univ.image (loss K)) (univ_nonempty.image _))
  have below (K : SimpleGraph (Fin 22)) (c) : best K ≤ loss K c :=
    min'_le _ _ (mem_image_of_mem _ (mem_univ c))
  have maximumInputs (K : SimpleGraph (Fin 22)) (tr : K.CliqueFree 3)
      (mx : ∀ L : SimpleGraph (Fin 22), L.CliqueFree 3 → best L ≤ best K) :
      (∃ c,loss K c ≤ 34) ∧ ((∃ i,K.degree i ≤ 6) ∨
        10 ≤ (univ.filter (fun i => K.degree i ≤ 7)).card) := by
    classical
    obtain ⟨T,sub,maximal⟩ := @Finite.exists_le_maximal _ _ _
      (fun M : SimpleGraph (Fin 22) => M.CliqueFree 3) K tr
    have loss_mono (f) : loss K f ≤ loss T f := by
      apply sum_le_sum; intro i _
      apply sum_le_sum; intro j _
      by_cases h : K.Adj i j ∧ f i=f j
      · simp [h,show T.Adj i j ∧ f i=f j from ⟨sub h.1,h.2⟩]
      · simp [h]
    obtain ⟨f,hf⟩ := attained T
    have tk : best K ≤ best T := (below K f).trans ((loss_mono f).trans hf.le)
    obtain ⟨r,hr,e,adj⟩ := covers T maximal (fun L hl => (mx L hl).trans tk)
    obtain ⟨⟨g,hg⟩,prof⟩ := rowFacts T r hr e adj
    refine ⟨⟨g,(loss_mono g).trans hg⟩,?_⟩
    have de (i : Fin 22) : K.degree i ≤ T.degree i := K.degree_le_of_le sub
    rcases prof with ⟨i,hi⟩|many
    · exact Or.inl ⟨i,(de i).trans hi⟩
    · apply Or.inr
      apply many.trans
      exact card_le_card (fun i hi => mem_filter.mpr ⟨mem_univ _,(de i).trans (mem_filter.mp hi).2⟩)
  have small : H1 := by
    intro K tr
    classical
    let F := {T : SimpleGraph (Fin 22) // T.CliqueFree 3}
    have : Nonempty F := ⟨⟨K,tr⟩⟩
    obtain ⟨T,largest⟩ := Finite.exists_max (fun T : F => best T.val)
    have mx (L : SimpleGraph (Fin 22)) (h : L.CliqueFree 3) : best L ≤ best T.val :=
      largest ⟨L,h⟩
    obtain ⟨f,hf⟩ := (maximumInputs T.val T.property mx).1
    obtain ⟨g,hg⟩ := attained K
    exact ⟨g,hg.le.trans ((mx K tr).trans ((below T.val f).trans hf))⟩
  have profile : H2 := by
    intro K tr least
    obtain ⟨g,hg⟩ := attained K
    have minimum : 34 ≤ best K := by
      rw [←hg]; exact least.2 ⟨g,rfl⟩
    apply (maximumInputs K tr ?_).2
    intro L hL
    obtain ⟨f,hf⟩ := small L hL
    exact (below L f).trans (hf.trans minimum)
  exact ⟨small,profile,bipartize23 small profile⟩
private lemma twice_upper (w : Fin 23 → Fin 23 → ℕ)
    (sym : ∀ i j, w i j=w j i) (diag : ∀ i, w i i=0) :
    (∑ i, ∑ j, w i j) = 2 * ∑ i, ∑ j, if i<j then w i j else 0 := by
  let u (i j : Fin 23) := if i<j then w i j else 0
  have split (i j) : w i j=u i j+u j i := by
    rcases lt_trichotomy i j with h|rfl|h
    · simp [u,h,not_lt_of_gt h]
    · simp [u,diag]
    · simp [u,h,not_lt_of_gt h,sym i j]
  calc
    _ = ∑ i, ∑ j, (u i j+u j i) := sum_congr rfl fun i _ => sum_congr rfl fun j _ => split i j
    _ = _ := by
      simp only [sum_add_distrib]
      rw [sum_comm (f:=fun i j => u j i)]
      change _ + _ = 2 * (∑ i,∑ j,u i j)
      omega

private lemma reindex {α β : Type*} [Fintype α] [Fintype β] (e : α ≃ β) (h : β → β → ℕ) :
    (∑ i,∑ j, h (e i) (e j)) = ∑ i,∑ j,h i j := by
  calc
    _ = ∑ i, ∑ j : β, h (e i) j := sum_congr rfl fun i _ => Equiv.sum_comp e (h (e i))
    _ = _ := Equiv.sum_comp e (fun i => ∑ j,h i j)

/-- Relabel a double sum on a vertex set by any bijection onto that set. -/
private lemma relabel (W : Finset (Fin 25)) (e : Fin 23 ≃ W)
    (h : Fin 25 → Fin 25 → ℕ) :
    (∑ i, ∑ j, h (e i) (e j)) = ∑ i ∈ W, ∑ j ∈ W, h i j := by
  calc
    _ = ∑ i : W, ∑ j : W, h i j := reindex e (fun x y : W => h x y)
    _ = ∑ i : W, ∑ j ∈ W, h i j := sum_congr rfl fun i _ => sum_coe_sort W (h i)
    _ = _ := sum_coe_sort W (fun i => ∑ j ∈ W, h i j)

private lemma ordered_cost (K : SimpleGraph (Fin 23)) (f : Fin 23 → Bool) (b : ℕ)
    (hf : (∑ i,∑ j,if i<j ∧ K.Adj i j ∧ f i=f j then (1:ℕ) else 0) ≤ b) :
    (∑ i,∑ j, if K.Adj i j ∧ f i=f j then (1:ℕ) else 0) ≤ 2*b := by
  let w (i j : Fin 23) := if K.Adj i j ∧ f i=f j then 1 else (0:ℕ)
  have sym (i j) : w i j=w j i := by simp only [w,K.adj_comm i j,eq_comm (a:=f i) (b:=f j)]
  have doubled := twice_upper w sym (by simp [w])
  have single (i j : Fin 23) : (if i<j then w i j else 0) =
      (if i<j ∧ K.Adj i j ∧ f i=f j then 1 else 0) := by by_cases h : i<j <;> simp [h,w]
  simp_rw [single] at doubled
  change (∑ i,∑ j,w i j)=2*(∑ i,∑ j,if i<j ∧ K.Adj i j ∧ f i=f j then 1 else 0) at doubled
  change (∑ i,∑ j,w i j) ≤ 2*b
  omega

/-- No graph of order 23 and at most 99 edges can attain the McKay maximum,
since each of the six records has at least 100 edges. -/
lemma sparse_cut23 (small : H1) (profile : H2) (complete : H3) (K : SimpleGraph (Fin 23))
    (tri : K.CliqueFree 3)
    (size : (∑ i,∑ j, if K.Adj i j then (1:ℕ) else 0) ≤ 198) :
    ∃ c : Fin 23 → Bool, (∑ i,∑ j, if K.Adj i j ∧ c i=c j then (1:ℕ) else 0) ≤ 38 := by
  classical
  let rows : Fin 6 → ℕ := ![
    0x10202010020f41e41e20f17c3ef87af8797c3c3ff007fe007fe003ff0000,
    0x20004140a02802f02f0179fa1ff43bf439fa1c7d780faf00faf007d78000,
    0x208000a0302304603981cdf8cff19bf199f8cc7dcc0fb980fb9807dcc000,
    0x20810000681601c04381e3f877f0ebf0e9f8747de20fbc40fbc407de2000,
    0x20810100801f03e03e01f1f83ff07bf079f83c7df00fbe00fbe007df0000,
    0x34803ad970f000000000000000107fe0ffa0ff907fc3e1f07c3e07c3e03e1f000]
  let bit (word : ℕ) (i j : Fin 23) :=
    let hi := max i.val j.val
    let pos := hi * (hi-1) / 2 + min i.val j.val
    decide (i≠j) && word.testBit (257-pos)

  let cost (c : Fin 23 → Bool) := ∑ i, ∑ j,
    if i<j ∧ K.Adj i j ∧ c i=c j then (1:ℕ) else 0

  obtain ⟨c,hc⟩ := upper23 small profile K tri
  change cost c ≤ 20 at hc
  have small : ∃ f, cost f ≤ 19 := by
    by_contra! fail
    have least : IsLeast (Set.range cost) 20 := by
      refine ⟨⟨c,by have h := fail c; omega⟩,?_⟩
      rintro _ ⟨g,rfl⟩
      have h := fail g
      omega
    obtain ⟨k,e,he⟩ := complete K tri least
    change ∀ i j, K.Adj (e i) (e j) ↔ bit (rows k) i j=true at he
    have count : (∑ i, ∑ j, if K.Adj i j then (1:ℕ) else 0) =
        2 * (![104,103,102,101,105,100] : Fin 6 → ℕ) k := by
      calc
        _ = ∑ i, ∑ j, if K.Adj (e i) (e j) then (1:ℕ) else 0 :=
          (reindex e (fun i j => if K.Adj i j then (1:ℕ) else 0)).symm
        _ = ∑ i, ∑ j, if bit (rows k) i j then (1:ℕ) else 0 := by simp_rw [he]
        _ = _ := catalogue_counts k
    have many : ∀ t : Fin 6, 100 ≤ (![104,103,102,101,105,100] : Fin 6 → ℕ) t := by decide
    have h := many k
    omega
  obtain ⟨f,hf⟩ := small
  exact ⟨f,ordered_cost K f 19 hf⟩

private lemma lift23 (cap budget : ℕ)
    (finiteBound : ∀ K : SimpleGraph (Fin 23), K.CliqueFree 3 →
      (∑ i,∑ j, if K.Adj i j then (1:ℕ) else 0) ≤ 2*cap →
      ∃ g : Fin 23 → Bool, (∑ i,∑ j,if K.Adj i j ∧ g i=g j then (1:ℕ) else 0) ≤ 2*budget)
    (G : SimpleGraph (Fin 25)) (tri : G.CliqueFree 3) (W : Finset (Fin 25)) (card : W.card=23)
    (size : (∑ i ∈ W, ∑ j ∈ W, if G.Adj i j then (1:ℕ) else 0) ≤ 2*cap) :
    ∃ f : Fin 25 → Bool,
      (∑ i ∈ W, ∑ j ∈ W, if G.Adj i j ∧ f i=f j then (1:ℕ) else 0) ≤ 2*budget := by
  classical
  let e : Fin 23 ≃ W := (Fintype.equivFinOfCardEq (by simpa using card : Fintype.card W=23)).symm
  let inc : Fin 23 ↪ Fin 25 := e.toEmbedding.trans (Function.Embedding.subtype _)
  let K := G.comap inc
  have triK : K.CliqueFree 3 := CliqueFree.comap (Embedding.comap inc G).isContained tri
  have sk : (∑ i,∑ j, if K.Adj i j then (1:ℕ) else 0) ≤ 2*cap :=
    (relabel W e (fun i j => if G.Adj i j then (1:ℕ) else 0)).le.trans size
  obtain ⟨g,hg⟩ := finiteBound K triK sk
  let f (x : Fin 25) := if h : x∈W then g (e.symm ⟨x,h⟩) else false
  have fg (i : Fin 23) : f (e i)=g i := by simp [f]
  refine ⟨f,?_⟩
  rw [← relabel W e (fun i j => if G.Adj i j ∧ f i=f j then (1:ℕ) else 0)]
  have adj (i j : Fin 23) : K.Adj i j ↔ G.Adj (e i) (e j) := Iff.rfl
  simpa only [fg,adj] using hg


theorem main : H1 → H2 → H3 → OMA.R_Erdos23_erdos_23_variants_n5_R2.H2 := by
  intro small profile complete G tri W card size
  exact lift23 99 19 (sparse_cut23 small profile complete) G tri W card size

end OMA.R_Erdos23_erdos_23_variants_n5_R2_H2_R3
