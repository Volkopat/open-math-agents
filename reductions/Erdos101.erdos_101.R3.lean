import FormalConjectures.ErdosProblems.«101»

-- Reduction Erdos101.erdos_101.R3 of Erdős Problem 101
-- Credit: @ubuwaits

/-!
# Four-point lines generated by a small set of anchors

The first step extracts a large subset in which every point outside a set of
anchors is the intersection of two distinct lines through pairs of anchors.
The extraction retains a positive density of four-point lines. We give an
unconditional proof of this step by sampling pairs in the pencils through
individual points. The second step asks for sparsity just for configurations
generated in this one intersection step from at most a constant times the
square root of the number of points.
-/

namespace OMA.R_Erdos101_erdos_101_R3
open EuclideanGeometry Filter Asymptotics
open scoped Classical

/-- At fixed positive density one can retain a positive fraction of the points
and a positive density of four-point lines in a subset generated by few anchors. -/
def H1 : Prop :=
  ∀ s : ℕ, 0 < s → ∃ N : ℕ, ∀ S : Finset ℝ², N ≤ S.card →
    NonCollinearFor 5 (S : Set ℝ²) →
    S.card ^ 2 ≤ s * (linesWithPointsFor 4 (S : Set ℝ²)).ncard →
    ∃ T B : Finset ℝ², T ⊆ S ∧ B ⊆ T ∧ S.card ≤ 4 * s * T.card ∧
      B.card ^ 2 ≤ 4096 * s ^ 3 * T.card ∧
      T.card ^ 2 ≤ 4 * s * (linesWithPointsFor 4 (T : Set ℝ²)).ncard ∧
      ∀ p ∈ T, p ∈ B ∨ ∃ a ∈ B, ∃ b ∈ B, ∃ c ∈ B, ∃ d ∈ B,
        a ≠ b ∧ c ≠ d ∧ line[ℝ,a,b] ≠ line[ℝ,c,d] ∧
        p ∈ line[ℝ,a,b] ∧ p ∈ line[ℝ,c,d]

/-- Uniform sparsity for sets generated in one intersection step from few anchors. -/
def H2 : Prop :=
  ∀ s C : ℕ, 0 < s → ∃ N : ℕ, ∀ T B : Finset ℝ², N ≤ T.card →
    NonCollinearFor 5 (T : Set ℝ²) → B ⊆ T → B.card ^ 2 ≤ C * T.card →
    (∀ p ∈ T, p ∈ B ∨ ∃ a ∈ B, ∃ b ∈ B, ∃ c ∈ B, ∃ d ∈ B,
      a ≠ b ∧ c ≠ d ∧ line[ℝ,a,b] ≠ line[ℝ,c,d] ∧
      p ∈ line[ℝ,a,b] ∧ p ∈ line[ℝ,c,d]) →
    s * (linesWithPointsFor 4 (T : Set ℝ²)).ncard < T.card ^ 2

theorem main : H1 → H2 → type_of% @Erdos101.erdos_101 := by
  intro extract sparse
  apply IsLittleO.of_bound
  intro ε ep
  obtain ⟨s,inv⟩ := exists_nat_gt (1 / ε)
  have pos : (0 : ℝ) < s := (one_div_pos.mpr ep).trans inv
  have sp := Nat.cast_pos.mp pos
  have prod : 1 ≤ ε * s := by simpa [mul_comm] using ((div_lt_iff₀ ep).mp inv).le
  obtain ⟨N,take⟩ := extract s sp
  obtain ⟨M,gap⟩ := sparse (4*s) (4096*s^3) (by positivity)
  filter_upwards [eventually_ge_atTop (max N (4*s*M))] with n large
  rw [Real.norm_of_nonneg (Nat.cast_nonneg _), Real.norm_of_nonneg (sq_nonneg _)]
  have upper : Erdos101.numLinesWithFourPointMax n ≤ ⌊ε * (n : ℝ)^2⌋₊ := by
    apply csSup_le'
    rintro _ ⟨U,uc,finite,cap,rfl⟩
    let S := finite.toFinset
    have eq : (S : Set ℝ²) = U := finite.coe_toFinset
    have sc : S.card = n := (Set.ncard_eq_toFinset_card U finite).symm.trans uc
    have small : s * (linesWithPointsFor 4 U).ncard < n^2 := by
      by_contra! dense
      obtain ⟨T,B,ts,bt,size,cheap,count,generated⟩ := take S
        (sc ▸ (le_max_left ..).trans large) (eq ▸ cap) (by simpa only [eq,sc] using dense)
      rw [sc] at size
      have mt := Nat.le_of_mul_le_mul_left (((le_max_right ..).trans large).trans size)
        (show 0 < 4*s by positivity)
      have tcap := NonCollinearFor.subset (Finset.coe_subset.mpr ts) (show NonCollinearFor 5 (S : Set ℝ²) from eq ▸ cap)
      exact (gap T B mt tcap bt cheap generated).not_ge count
    apply Nat.le_floor
    have rr : (s : ℝ) * (linesWithPointsFor 4 U).ncard ≤ (n : ℝ)^2 := by exact_mod_cast small.le
    apply le_of_mul_le_mul_left (a := (s : ℝ)) _ pos
    calc (s : ℝ) * (linesWithPointsFor 4 U).ncard ≤ (n : ℝ)^2 := rr
         _ = 1 * (n : ℝ)^2 := (one_mul _).symm
         _ ≤ (ε * s) * (n : ℝ)^2 := mul_le_mul_of_nonneg_right prod (sq_nonneg _)
         _ = s * (ε * (n : ℝ)^2) := by ring
  exact (Nat.cast_le.mpr upper).trans (Nat.floor_le (mul_nonneg ep.le (sq_nonneg _)))

end OMA.R_Erdos101_erdos_101_R3
