private theorem trap_lower {k m t : ℕ} (pos : 0 < m) (slope : t ≤ k)
    (eqn : Nat.nth Nat.Prime (m-1)+20868473=k*(m+1322164)) (j : ℕ) :
    ((fun a : ℕ => max a (min 1748116320732 (Nat.primeCounting' (t*(a+1322164)-20868473)+1)))^[j]) 1 ≤ m := by
  induction j with
  | zero => exact pos
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    apply max_le ih
    apply le_trans (min_le_right _ _)
    have le := Nat.mul_le_mul slope (Nat.add_le_add_right ih 1322164)
    have qle := Nat.sub_le_of_le_add (le.trans_eq eqn.symm)
    have bound := Nat.monotone_primeCounting' qle
    rw [Nat.primeCounting'_nth_eq] at bound
    omega

private theorem trap_upper {k m t : ℕ} (pos : 0 < m) (limit : m < 1748116320732) (slope : k ≤ t)
    (eqn : Nat.nth Nat.Prime (m-1)+20868473=k*(m+1322164)) (j : ℕ) :
    m ≤ ((fun b : ℕ => min b (Nat.primeCounting (t*(b+1322164)-20868473)))^[j]) 1748116320731 := by
  induction j with
  | zero => exact (show m ≤ 1748116320731 by omega)
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    apply le_min ih
    have le := Nat.mul_le_mul slope (Nat.add_le_add_right ih 1322164)
    have qle := Nat.le_sub_of_add_le (eqn.le.trans le)
    have bound := Nat.monotone_primeCounting qle
    change Nat.count Nat.Prime (Nat.nth Nat.Prime (m-1)+1) ≤ _ at bound
    rw [Nat.count_nth_succ_of_infinite Nat.infinite_setOfPred_prime] at bound
    omega

private theorem mark {k a m : ℕ} (ds keys : List ℕ)
    (cert : ∀ i : Fin ds.length, let t := a+i.val; let v := k*(t+1322164)-20868473;
       (1 < ds[i] ∧ ds[i] < v ∧ v%ds[i]=0) ∨ 32*t+k∈keys)
    (lo : a ≤ m) (hi : m < a+ds.length) (prime : (k*(m+1322164)-20868473).Prime) :
    32*m+k∈keys := by
  let i : Fin ds.length := ⟨m-a,by omega⟩
  have test := cert i
  dsimp only at test
  rw [show a+i.val=m by dsimp [i]; omega] at test
  rcases test with ⟨gt,lt,rem⟩ | hit
  · have alternatives := (Nat.dvd_prime prime).mp (Nat.dvd_of_mod_eq_zero rem)
    omega
  · exact hit

