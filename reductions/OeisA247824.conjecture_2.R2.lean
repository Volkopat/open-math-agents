theorem main : H1 → H2 → H3 → H4 → type_of% @OeisA247824.conjecture_2 := by
  intro witness lower upper ranks hall
  obtain ⟨smallPrime,divisible⟩ := witness
  let S := {m : ℕ | 0 < m ∧ (m+1322164) ∣ Nat.nth Nat.Prime (m-1)+Nat.nth Nat.Prime (1322164-1)}
  have nonempty : S.Nonempty := by
    refine ⟨2636932401176,by decide,?_⟩
    change (2636932401176+1322164) ∣ Nat.nth Nat.Prime 2636932401175 + Nat.nth Nat.Prime 1322163
    rwa [smallPrime]
  let m := sInf S
  obtain ⟨pos,k,eqn⟩ := (show m ∈ S from csInf_mem nonempty)
  have limit := hall 1322164 (by decide)
  change m < 1748116320732 at limit
  change Nat.nth Nat.Prime (m-1) + Nat.nth Nat.Prime 1322163 = (m+1322164)*k at eqn
  rw [smallPrime,Nat.mul_comm (m+1322164) k] at eqn
  by_cases bottom : k ≤ 15
  · have cut := (trap_upper pos limit bottom eqn 850).trans (upper 15 (by decide) (by decide))
    change m ≤ 0 at cut
    omega
  by_cases top : 31 ≤ k
  · have cut := (lower 31 (by decide) (by decide)).trans (trap_lower pos top eqn 850)
    change 1748116320732 ≤ m at cut
    omega
  have kl : 16 ≤ k := by omega
  have kh : k ≤ 30 := by omega
  have ll := (lower k kl (by omega)).trans (trap_lower pos (Nat.le_refl k) eqn 850)
  have hh := (trap_upper pos limit (Nat.le_refl k) eqn 850).trans (upper k (by omega) kh)
  have prEq : Nat.nth Nat.Prime (m-1) = k*(m+1322164)-20868473 := by omega
  have prime : (k*(m+1322164)-20868473).Prime := prEq ▸ Nat.prime_nth_prime (m-1)
  have count : Nat.primeCounting (k*(m+1322164)-20868473) = m := by
    rw [← prEq]
    change Nat.count Nat.Prime (Nat.nth Nat.Prime (m-1)+1) = m
    rw [Nat.count_nth_succ_of_infinite Nat.infinite_setOfPred_prime]
    omega
  refine ranks k m kl kh ?_ count
  interval_cases k
  · change 1868322 ≤ m at ll
