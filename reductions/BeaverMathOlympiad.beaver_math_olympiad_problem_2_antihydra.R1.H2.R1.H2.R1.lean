import OMAReductions.R_BeaverMathOlympiad_beaver_math_olympiad_problem_2_antihydra_R1_H2_R1

/-! Check a longer finite prefix and locate any later failure at an odd-run endpoint. -/

namespace OMA.R_BeaverMathOlympiad_beaver_math_olympiad_problem_2_antihydra_R1_H2_R1_H2_R1

private theorem odd_triple {a : Nat → Nat} (ha : ∀ i, a (i + 1) = 3 * a i / 2) (i : Nat) :
    a i % 8 = 1 ↔ a i % 2 ≠ 0 ∧ a (i + 1) % 2 ≠ 0 ∧ a (i + 2) % 2 ≠ 0 := by
  rw [show i + 2 = (i + 1) + 1 by omega, ha (i + 1), ha i]
  omega

private theorem end_of_four_odds {a : Nat → Nat} (ha : ∀ i, a (i + 1) = 3 * a i / 2) (i : Nat)
    (h0 : a i % 2 ≠ 0) (h1 : a (i + 1) % 2 ≠ 0) (h2 : a (i + 2) % 2 ≠ 0)
    (h3 : a (i + 3) % 2 ≠ 0) (h4 : a (i + 4) % 2 = 0) : a i % 32 = 17 := by
  have he1 := ha i
  have he2 := ha (i + 1)
  have he3 := ha (i + 2)
  have he4 := ha (i + 3)
  have e2 : i + 1 + 1 = i + 2 := by omega
  have e3 : i + 2 + 1 = i + 3 := by omega
  have e4 : i + 3 + 1 = i + 4 := by omega
  rw [e2] at he2
  rw [e3] at he3
  rw [e4] at he4
  have h8 : a i % 8 = 1 := (odd_triple ha i).mpr ⟨h0,h1,h2⟩
  have h8' : a (i + 1) % 8 = 1 := by
    apply (odd_triple ha (i + 1)).mpr
    refine ⟨h1, ?_, ?_⟩
    · rwa [e2]
    · exact h3
  omega

private theorem power_dvd_of_odd_run {a : Nat → Nat} (ha : ∀ i, a (i + 1) = 3 * a i / 2) :
    ∀ k j : Nat, (∀ i < k, a (j + i) % 2 ≠ 0) → 2 ^ k ∣ a j - 1 := by
  intro k
  induction k with
  | zero => intro j _; simp
  | succ k ih =>
    intro j odd
    have htail := ih (j + 1) (fun i hi => by
      rw [show j + 1 + i = j + (i + 1) by omega]
      exact odd (i + 1) (by omega))
    have hodd : a j % 2 ≠ 0 := by simpa using odd 0 (by omega)
    have hstep := ha j
    have hh : 2 * (a (j + 1) - 1) = 3 * (a j - 1) := by omega
    have hdiv : 2 ^ (k + 1) ∣ 3 * (a j - 1) := by
      rw [← hh, pow_succ, Nat.mul_comm (2 ^ k)]
      exact Nat.mul_dvd_mul_left 2 htail
    exact ((show Nat.Coprime 2 3 by decide).pow_left (k + 1)).dvd_of_dvd_mul_left hdiv

private theorem even_term_after {a : Nat → Nat} (h0 : a 0 = 8)
    (ha : ∀ i, a (i + 1) = 3 * a i / 2) (j : Nat) :
    ∃ i, j ≤ i ∧ a i % 2 = 0 := by
  have lower (i : Nat) : 8 ≤ a i := by
    induction i with
    | zero => omega
    | succ i ih => rw [ha]; omega
  by_contra h
  have odd (i : Nat) : a (j + i) % 2 ≠ 0 := fun hi => h ⟨j + i, by omega, hi⟩
  have hd := power_dvd_of_odd_run ha (a j) j (fun i _ => odd i)
  have hle := Nat.le_of_dvd (by have := lower j; omega : 0 < a j - 1) hd
  have hp := Nat.lt_two_pow_self (n := a j)
  omega

private theorem completed_count_succ (a : Nat → Nat) {n : Nat} (hn : 2 ≤ n) :
    (List.range (n + 1 - 2)).countP (fun i => a i % 8 == 1) =
      (List.range (n - 2)).countP (fun i => a i % 8 == 1) + (if a (n - 2) % 8 = 1 then 1 else 0) := by
  rw [show n + 1 - 2 = (n - 2) + 1 by omega, List.range_succ, List.countP_append,
    List.countP_cons, List.countP_nil, Nat.zero_add]
  simp only [beq_iff_eq]

set_option maxHeartbeats 50000000 in
set_option maxRecDepth 12000 in
/-- Check the prefix with binary recursion. The natural counter stores
`k + 2 - 4 * count` after inspecting the first `k` terms. -/
theorem checked_prefix (a : Nat → Nat) (h0 : a 0 = 8)
    (ha : ∀ i, a (i + 1) = 3 * a i / 2) {n : Nat} (hn : n ≤ 1048576) :
    4 * (List.range (n - 2)).countP (fun i => a i % 8 == 1) ≤ n := by
  let C (k : Nat) := (List.range k).countP (fun i => a i % 8 == 1)
  have inc (k : Nat) : C (k + 1) = C k + (if a k % 8 = 1 then 1 else 0) := by
    unfold C
    rw [List.range_succ, List.countP_append, List.countP_cons, List.countP_nil, Nat.zero_add]
    simp only [beq_iff_eq]
  let step (s : Nat × Nat) : Option (Nat × Nat) :=
    if s.1 % 8 = 1 then
      if s.2 < 3 then none else some (3 * s.1 / 2, s.2 - 3)
    else some (3 * s.1 / 2, s.2 + 1)
  let run := Nat.rec (motive := fun _ => Nat × Nat → Option (Nat × Nat)) step
    (fun _ f s => (f s).bind f)
  have sound : ∀ (j k credit : Nat) (s : Nat × Nat),
      credit + 4 * C k = k + 2 → run j (a k, credit) = some s →
      (∀ i ≤ 2 ^ j, 4 * C (k + i) ≤ k + i + 2) ∧
      s.1 = a (k + 2 ^ j) ∧ s.2 + 4 * C (k + 2 ^ j) = k + 2 ^ j + 2 := by
    intro j
    induction j with
    | zero =>
      intro k credit s hcredit hrun
      change step (a k, credit) = some s at hrun
      have hstep (d : Nat) (hout : s = (a (k + 1), d)) (hd : d + 4 * C (k + 1) = k + 1 + 2) :
          (∀ i ≤ 2 ^ 0, 4 * C (k + i) ≤ k + i + 2) ∧
          s.1 = a (k + 2 ^ 0) ∧ s.2 + 4 * C (k + 2 ^ 0) = k + 2 ^ 0 + 2 := by
        simp only [pow_zero]
        refine ⟨?_, ?_, ?_⟩
        · intro i hi
          rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hi with rfl | rfl
          · simpa only [Nat.add_zero] using (show 4 * C k ≤ k + 2 by omega)
          · omega
        · simp [hout]
        · simpa [hout] using hd
      by_cases hhit : a k % 8 = 1
      · by_cases hlow : credit < 3
        · simp [step, hhit, hlow] at hrun
        · have hout : s = (a (k + 1), credit - 3) := by
            simpa [step, hhit, hlow, ha k] using hrun.symm
          apply hstep _ hout
          rw [inc, if_pos hhit]
          omega
      · have hout : s = (a (k + 1), credit + 1) := by
          simpa [step, hhit, ha k] using hrun.symm
        apply hstep _ hout
        rw [inc, if_neg hhit]
        omega
    | succ j ih =>
      intro k credit s hcredit hrun
      change (run j (a k, credit)).bind (run j) = some s at hrun
      cases hmid : run j (a k, credit) with
      | none => simp [hmid] at hrun
      | some mid =>
        have ⟨hfirst, hstate, hcount⟩ := ih k credit mid hcredit hmid
        have htail : run j (a (k + 2 ^ j), mid.2) = some s := by
          simpa [hmid, ← hstate] using hrun
        have ⟨hsecond, hlast, hcreditlast⟩ := ih (k + 2 ^ j) mid.2 s hcount htail
        have endpoint : k + 2 ^ j + 2 ^ j = k + 2 ^ (j + 1) := by rw [pow_succ]; omega
        refine ⟨?_, endpoint ▸ hlast, endpoint ▸ hcreditlast⟩
        intro i hi
        by_cases his : i ≤ 2 ^ j
        · exact hfirst i his
        · have hlim : i - 2 ^ j ≤ 2 ^ j := by rw [pow_succ] at hi; omega
          have heq : k + 2 ^ j + (i - 2 ^ j) = k + i := by omega
          simpa only [heq] using hsecond (i - 2 ^ j) hlim
  -- Large terms only enter at block boundaries. Inside a block, the high
  -- part of the input cannot change any residue modulo eight being counted.
  have translate : ∀ j x credit q : Nat,
      run j (x + 2 ^ (2 ^ j + 2) * q, credit) =
        (run j (x, credit)).map (fun t => (t.1 + 4 * 3 ^ (2 ^ j) * q, t.2)) := by
    intro j
    induction j with
    | zero =>
      intro x credit q
      change step (x + 8 * q, credit) =
        (step (x, credit)).map (fun t => (t.1 + 12 * q, t.2))
      have hm : (x + 8 * q) % 8 = x % 8 := by omega
      have hf : 3 * (x + 8 * q) / 2 = 3 * x / 2 + 12 * q := by omega
      simp only [step, hm, hf]
      split <;> (try split) <;> rfl
    | succ j ih =>
      intro x credit q
      change (run j (x + 2 ^ (2 ^ (j + 1) + 2) * q, credit)).bind (run j) =
        ((run j (x, credit)).bind (run j)).map (fun t => (t.1 + 4 * 3 ^ (2 ^ (j + 1)) * q, t.2))
      have hpower : 2 ^ (j + 1) = 2 ^ j + 2 ^ j := by rw [pow_succ]; omega
      have hsplit : 2 ^ (2 ^ (j + 1) + 2) * q = 2 ^ (2 ^ j + 2) * (2 ^ (2 ^ j) * q) := by
        rw [hpower, show 2 ^ j + 2 ^ j + 2 = (2 ^ j + 2) + 2 ^ j by omega, pow_add]
        ac_rfl
      rw [hsplit, ih]
      cases hm : run j (x, credit) with
      | none => rfl
      | some t =>
        simp only [Option.map_some, Option.bind_some]
        have hcarry : 4 * 3 ^ (2 ^ j) * (2 ^ (2 ^ j) * q) =
            2 ^ (2 ^ j + 2) * (3 ^ (2 ^ j) * q) := by
          rw [pow_add, show (2 : Nat) ^ 2 = 4 by rfl]
          ac_rfl
        rw [hcarry, ih]
        have houtput : 4 * 3 ^ (2 ^ j) * (3 ^ (2 ^ j) * q) = 4 * 3 ^ (2 ^ (j + 1)) * q := by
          rw [hpower, pow_add]
          ac_rfl
        cases run j (t.1, t.2) <;> simp [houtput]
  let fastStep (s : Nat × Nat) : Option (Nat × Nat) :=
    let modulus := 2 ^ (2 ^ 7 + 2)
    (run 7 (s.1 % modulus, s.2)).map fun v =>
      (v.1 + 4 * 3 ^ (2 ^ 7) * (s.1 / modulus), v.2)
  have fastStep_eq : fastStep = run 7 := by
    funext ⟨x,credit⟩
    have h := translate 7 (x % 2 ^ (2 ^ 7 + 2)) credit (x / 2 ^ (2 ^ 7 + 2))
    have hx : x % 2 ^ (2 ^ 7 + 2) + 2 ^ (2 ^ 7 + 2) * (x / 2 ^ (2 ^ 7 + 2)) = x :=
      Nat.mod_add_div _ _
    rw [hx] at h
    exact h.symm
  let fastRun := Nat.rec (motive := fun _ => Nat × Nat → Option (Nat × Nat)) fastStep
    (fun _ f s => (f s).bind f)
  have fastRun_eq : ∀ j, fastRun j = run (j + 7) := by
    intro j
    induction j with
    | zero => exact fastStep_eq
    | succ j ih =>
      rw [show j + 1 + 7 = (j + 7) + 1 by omega]
      funext s
      change (fastRun j s).bind (fastRun j) = (run (j + 7) s).bind (run (j + 7))
      rw [ih]
  -- The four independently checked blocks share exact endpoint states.
  let x₁ : Nat := 
  let x₂ : Nat := 
  let x₃ : Nat := 
  have hfast₁ : fastRun 11 (8, 2) = some (x₁, 131090) := by decide +kernel
  have hfast₂ : fastRun 11 (x₁, 131090) = some (x₂, 260566) := by decide +kernel
  have hfast₃ : fastRun 11 (x₂, 260566) = some (x₃, 392434) := by decide +kernel
  have hfast₄ : (fastRun 11 (x₃, 392434)).isSome = true := by decide +kernel
  rw [fastRun_eq 11, show 11 + 7 = 18 by decide] at hfast₁ hfast₂ hfast₃ hfast₄
  have hcheck : (run 20 (8, 2)).isSome = true := by
    change (((run 18 (8, 2)).bind (run 18)).bind
      (fun t => (run 18 t).bind (run 18))).isSome = true
    rw [hfast₁, Option.bind_some, hfast₂, Option.bind_some, hfast₃, Option.bind_some]
    exact hfast₄
  obtain ⟨s, hs⟩ := Option.isSome_iff_exists.mp hcheck
  have hraw := (sound 20 0 2 s (by simp [C]) (by simpa only [h0] using hs)).1
  by_cases hsmall : n < 2
  · simp [show n - 2 = 0 by omega]
  · have hcap : n - 2 ≤ 2 ^ 20 := by norm_num; omega
    simpa only [Nat.zero_add, show n - 2 + 2 = n by omega] using hraw (n - 2) hcap

/-- Endpoints of odd runs with at least five terms. -/
def H1 : Prop :=
  ∀ (a : Nat → Nat), a 0 = 8 → (∀ n, a (n + 1) = 3 * a n / 2) →
    ∀ n, 1048576 < n → a (n - 4) % 32 = 17 → a (n - 5) % 2 ≠ 0 →
      4 * (List.range (n - 2)).countP (fun i => a i % 8 == 1) ≤ n

/-- Endpoints of four-term odd runs preceded by fewer than four even terms. -/
def H2 : Prop :=
  ∀ (a : Nat → Nat), a 0 = 8 → (∀ n, a (n + 1) = 3 * a n / 2) →
    ∀ n, 1048576 < n → a (n - 4) % 32 = 17 → a (n - 5) % 2 = 0 →
      (a (n - 6) % 2 ≠ 0 ∨ a (n - 7) % 2 ≠ 0 ∨ a (n - 8) % 2 ≠ 0) →
      4 * (List.range (n - 2)).countP (fun i => a i % 8 == 1) ≤ n

theorem main : H1 → H2 → OMA.R_BeaverMathOlympiad_beaver_math_olympiad_problem_2_antihydra_R1_H2_R1.H2 := by
  intro hLong hShort a h0 ha n _
  let C (j : Nat) := (List.range (j - 2)).countP (fun i => a i % 8 == 1)
  change 4 * C n ≤ n
  by_contra hbad
  let fail : Nat → Prop := fun m => m < 4 * C m
  have existsFail : ∃ m, fail m := ⟨n, by omega⟩
  let m := Nat.find existsFail
  have hm : m < 4 * C m := Nat.find_spec existsFail
  have before (j : Nat) (hj : j < m) : 4 * C j ≤ j := by
    have hn := Nat.find_min existsFail hj
    change ¬j < 4 * C j at hn
    omega
  have hLarge : 1048576 < m := by
    by_contra! hcap
    have hcheck := checked_prefix a h0 ha hcap
    change 4 * C m ≤ m at hcheck
    omega
  have advance (t : Nat) (ht : 2 ≤ t) :
      C (t + 1) = C t + (if a (t - 2) % 8 = 1 then 1 else 0) := completed_count_succ a ht
  have parity (t : Nat) (ht : 2 ≤ t) : a (t - 2) % 8 = 1 ↔
      a (t - 2) % 2 ≠ 0 ∧ a (t - 1) % 2 ≠ 0 ∧ a t % 2 ≠ 0 := by
    simpa only [show t - 2 + 1 = t - 1 by omega, show t - 2 + 2 = t by omega] using
      odd_triple ha (t - 2)
  have noHit (t i : Nat) (ht : 2 ≤ t) (hlo : t - 2 ≤ i) (hhi : i ≤ t) (heven : a i % 2 = 0) :
      C (t + 1) = C t := by
    have hno : a (t - 2) % 8 ≠ 1 := by
      intro hh
      have ⟨h₀,h₁,h₂⟩ := (parity t ht).mp hh
      obtain rfl | rfl | rfl : i = t - 2 ∨ i = t - 1 ∨ i = t := by omega
      · exact h₀ heven
      · exact h₁ heven
      · exact h₂ heven
    simpa [hno] using advance t ht
  have lastHit : a (m - 1 - 2) % 8 = 1 := by
    by_contra hh
    have hstep := advance (m - 1) (by omega)
    rw [if_neg hh] at hstep
    have hprev := before (m - 1) (by omega)
    have heq : m - 1 + 1 = m := by omega
    rw [heq] at hstep
    omega
  obtain ⟨hm₃,hm₂,hm₁⟩ := (parity (m - 1) (by omega)).mp lastHit
  rw [show m - 1 - 2 = m - 3 by omega] at hm₃
  rw [show m - 1 - 1 = m - 2 by omega] at hm₂
  have hm₄ : a (m - 4) % 2 ≠ 0 := by
    intro he
    have h₁ := noHit (m - 4) (m - 4) (by omega) (by omega) (by omega) he
    have h₂ := noHit (m - 3) (m - 4) (by omega) (by omega) (by omega) he
    have h₃ := noHit (m - 2) (m - 4) (by omega) (by omega) (by omega) he
    have h₄ := advance (m - 1) (by omega)
    rw [if_pos lastHit] at h₄
    have hprev := before (m - 4) (by omega)
    rw [show m - 4 + 1 = m - 3 by omega] at h₁
    rw [show m - 3 + 1 = m - 2 by omega] at h₂
    rw [show m - 2 + 1 = m - 1 by omega] at h₃
    rw [show m - 1 + 1 = m by omega] at h₄
    omega
  have existsEven := even_term_after h0 ha m
  let e := Nat.find existsEven
  have he : m ≤ e ∧ a e % 2 = 0 := Nat.find_spec existsEven
  have oddToEnd (j : Nat) (hlo : m - 4 ≤ j) (hhi : j < e) : a j % 2 ≠ 0 := by
    by_cases hj : j < m
    · obtain rfl | rfl | rfl | rfl : j = m - 4 ∨ j = m - 3 ∨ j = m - 2 ∨ j = m - 1 := by omega
      · exact hm₄
      · exact hm₃
      · exact hm₂
      · exact hm₁
    · intro heven
      exact Nat.find_min existsEven hhi ⟨by omega,heven⟩
  have extend (d : Nat) (hd : m + d ≤ e) : C (m + d) = C m + d := by
    induction d with
    | zero => simp
    | succ d ih =>
      have hstep := advance (m + d) (by omega)
      have hhit : a (m + d - 2) % 8 = 1 := (parity (m + d) (by omega)).mpr
        ⟨oddToEnd _ (by omega) (by omega), oddToEnd _ (by omega) (by omega),
          oddToEnd _ (by omega) (by omega)⟩
      rw [if_pos hhit, ih (by omega)] at hstep
      exact hstep
  have heq : m + (e - m) = e := by omega
  have hcount := extend (e - m) (by omega)
  rw [heq] at hcount
  have hefail : e < 4 * C e := by omega
  have hres : a (e - 4) % 32 = 17 := by
    apply end_of_four_odds ha
    · exact oddToEnd _ (by omega) (by omega)
    · exact oddToEnd _ (by omega) (by omega)
    · exact oddToEnd _ (by omega) (by omega)
    · exact oddToEnd _ (by omega) (by omega)
    · simpa only [show e - 4 + 4 = e by omega] using he.2
  by_cases he₅ : a (e - 5) % 2 = 0
  · by_cases hgap : a (e - 6) % 2 ≠ 0 ∨ a (e - 7) % 2 ≠ 0 ∨ a (e - 8) % 2 ≠ 0
    · have h := hShort a h0 ha e (by omega) hres he₅ hgap
      change 4 * C e ≤ e at h
      omega
    have heqm : e = m := by
      by_contra hne
      exact oddToEnd (e - 5) (by omega) (by omega) he₅
    rw [heqm] at he₅ hgap
    push Not at hgap
    have h₁ := noHit (m - 8) (m - 8) (by omega) (by omega) (by omega) hgap.2.2
    have h₂ := noHit (m - 7) (m - 7) (by omega) (by omega) (by omega) hgap.2.1
    have h₃ := noHit (m - 6) (m - 6) (by omega) (by omega) (by omega) hgap.1
    have h₄ := noHit (m - 5) (m - 5) (by omega) (by omega) (by omega) he₅
    have h₅ := noHit (m - 4) (m - 5) (by omega) (by omega) (by omega) he₅
    have h₆ := noHit (m - 3) (m - 5) (by omega) (by omega) (by omega) he₅
    have h₇ := advance (m - 2) (by omega)
    have h₈ := advance (m - 1) (by omega)
    have hprev := before (m - 8) (by omega)
    rw [show m - 8 + 1 = m - 7 by omega] at h₁
    rw [show m - 7 + 1 = m - 6 by omega] at h₂
    rw [show m - 6 + 1 = m - 5 by omega] at h₃
    rw [show m - 5 + 1 = m - 4 by omega] at h₄
    rw [show m - 4 + 1 = m - 3 by omega] at h₅
    rw [show m - 3 + 1 = m - 2 by omega] at h₆
    rw [show m - 2 + 1 = m - 1 by omega] at h₇
    rw [show m - 1 + 1 = m by omega] at h₈
    split at h₇ <;> split at h₈ <;> omega
  · have h := hLong a h0 ha e (by omega) hres he₅
    change 4 * C e ≤ e at h
    omega

end OMA.R_BeaverMathOlympiad_beaver_math_olympiad_problem_2_antihydra_R1_H2_R1_H2_R1
