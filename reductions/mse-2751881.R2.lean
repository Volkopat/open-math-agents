import OMAStatements.S_mse_2751881

/-!
# Four cubes in the two exceptional residue classes
Every integer from 1 through 10,000,000 has an expression as three positive
cubes minus a positive cube with subtracted base at most 2347. The bit masks for residues 4 and 5 use
(3i+1)³ = 9A(i)+1 and (3i+2)³ = 9B(i)-1. Each finite check uses an
interval offset and records any supplementary witnesses in packed radix
digits. The signed problem outside the finite range and two infinite
families reduces to a quadratic representation condition for each residue.
The explicit example and reproducible search at `window_bound_witness`
show where the uniform bound is attained.
-/

namespace OMA.R_mse_2751881_R2

private theorem union_bits {α : Type} (xs : List α) (f : α → ℕ) (i : ℕ) :
    (xs.foldr (fun x acc => f x ||| acc) 0).testBit i = true ↔
      ∃ x ∈ xs, (f x).testBit i = true := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [List.foldr, Nat.testBit_or, ih]

private theorem peel (xs : List ℕ) (f : ℕ → ℕ) (mask i : ℕ)
    (h : (xs.foldr (fun a s => (mask <<< f a) ||| s) 0).testBit i = true) :
    ∃ x j : ℕ, i = j + f x ∧ mask.testBit j = true := by
  obtain ⟨a, _, ha⟩ := (union_bits xs _ i).mp h
  rw [Nat.testBit_shiftLeft, Bool.and_eq_true] at ha
  have hle := of_decide_eq_true ha.1
  exact ⟨a, i-f a, by omega, ha.2⟩

private theorem peel_capped (xs : List ℕ) (f : ℕ → ℕ) (mask cap i : ℕ)
    (h : (xs.foldr (fun a s => ((mask <<< f a) &&& cap) ||| s) 0).testBit i = true) :
    ∃ x j : ℕ, i = j + f x ∧ mask.testBit j = true := by
  obtain ⟨a, _, ha⟩ := (union_bits xs _ i).mp h
  rw [Nat.testBit_and, Bool.and_eq_true] at ha
  have hm := ha.1
  rw [Nat.testBit_shiftLeft, Bool.and_eq_true] at hm
  have hle := of_decide_eq_true hm.1
  exact ⟨a,i-f a,by omega,hm.2⟩

/-- The bit at i records a representation offset+i + g(d) = f(x)+f(y)+f(z).
For the dense mask, x and y have separate upper bounds, and z starts at
a lower index. After putting the three summands in increasing order, the
smallest is at most one third of the allowed total, the middle one is at
most one half, and the largest is at least one third of the minimum total.
The final left shifts are clipped at the largest possible total. Each supplementary row
encodes the indices d,x,y,z in four digits in the given radix. Eight rows
form a block. A row sets the bit of its actual nonnegative difference.
The window uses local bit positions so the temporary masks for sparse rows
are bounded by its width. A set bit of skip is handled by the caller. -/
private theorem window_certificate (f g : ℕ → ℕ) (bound offset top radix skip nx ny startZ cap : ℕ)
    (blocks : List ℕ) :
    let ids := List.range bound
    let xs := List.range nx
    let ys := List.range ny
    let zs := (List.range (bound-startZ)).map (fun i => startZ+i)
    let one := xs.foldr (fun i a => ((1:ℕ) <<< f i) ||| a) 0
    let two := ys.foldr (fun i a => (one <<< f i) ||| a) 0
    let quarter := (cap+1)/4
    let lead := (1:ℕ) <<< (quarter+(cap+1)%4)
    let limit := (((lead <<< quarter) <<< quarter) <<< quarter)-1
    let triple := zs.foldr (fun i a => ((two <<< f i) &&& limit) ||| a) 0
    let window := (2:ℕ)^(top+1)-1
    let small := ids.foldr (fun i a => ((triple >>> (g i + offset)) &&& window) ||| a) 0
    let d (w : ℕ) := w / radix^3
    let x (w : ℕ) := w / radix^2 % radix
    let y (w : ℕ) := w / radix % radix
    let z (w : ℕ) := w % radix
    let total (w : ℕ) := f (x w) + f (y w) + f (z w)
    let entry (block j : ℕ) := block / (radix^4)^j % (radix^4)
    let mark (w : ℕ) := if g (d w) + offset ≤ total w ∧ total w - (g (d w) + offset) ≤ top
      then 2 ^ (total w - (g (d w) + offset)) else 0
    let blockMask (block : ℕ) := (List.range 8).foldr (fun j a => mark (entry block j) ||| a) 0
    let extra := blocks.foldr (fun block a => blockMask block ||| a) 0
    0 < radix → (small ||| extra ||| skip) &&& window = window →
      ∀ i, i ≤ top → skip.testBit i = false →
        ∃ d x y z : ℕ, d < max bound radix ∧ offset + i + g d = f x + f y + f z := by
  intro ids xs ys zs one two quarter lead limit triple window small d x y z total entry mark blockMask extra hradix coverage i hi hskip
  have hw : window.testBit i = true := by
    simpa only [window, Nat.testBit_two_pow_sub_one, decide_eq_true_eq] using
      (show i < top+1 by omega)
  have hm := congrArg (fun mask : ℕ => mask.testBit i) coverage
  change ((small ||| extra ||| skip) &&& window).testBit i = window.testBit i at hm
  simp only [Nat.testBit_and, Nat.testBit_or, hw, hskip, Bool.and_true, Bool.or_false,
    Bool.or_eq_true] at hm
  rcases hm with hs | he
  · obtain ⟨a, haMem, ha⟩ := (union_bits ids _ i).mp hs
    rw [Nat.testBit_and, Bool.and_eq_true, Nat.testBit_shiftRight] at ha
    obtain ⟨ha,_⟩ := ha
    obtain ⟨u, j, e₁, hj⟩ := peel_capped zs f two limit _ ha
    obtain ⟨v, k, e₂, hk⟩ := peel ys f one _ hj
    obtain ⟨w, l, e₃, hl⟩ := peel xs f 1 k hk
    rw [← Nat.pow_zero 2, Nat.testBit_two_pow, decide_eq_true_eq] at hl
    have hindex : a < bound := List.mem_range.mp haMem
    exact ⟨a,u,v,w,lt_of_lt_of_le hindex (Nat.le_max_left _ _),by omega⟩
  · obtain ⟨block, _, hb⟩ := (union_bits blocks blockMask i).mp he
    obtain ⟨j, _, hr⟩ := (union_bits (List.range 8) (fun j => mark (entry block j)) i).mp hb
    let w := entry block j
    change (mark w).testBit i = true at hr
    by_cases good : g (d w) + offset ≤ total w ∧ total w - (g (d w) + offset) ≤ top
    · simp only [mark, if_pos good, Nat.testBit_two_pow, decide_eq_true_eq] at hr
      have hwlt : w < radix^4 := Nat.mod_lt _ (Nat.pow_pos hradix)
      have hdlt : d w < radix := by
        change w / radix^3 < radix
        apply (Nat.div_lt_iff_lt_mul (Nat.pow_pos (n := 3) hradix)).mpr
        simpa only [pow_succ, Nat.mul_comm] using hwlt
      exact ⟨d w,x w,y w,z w,lt_of_lt_of_le hdlt (Nat.le_max_right _ _),by change offset + i + g (d w) = total w; omega⟩
    · simp only [mark, if_neg good, Nat.zero_testBit, Bool.false_eq_true] at hr

/-- Doubling a period by a multiple of nine preserves these two residue classes. -/
private theorem only_four_five (steps : List ℕ) (seed : ℕ)
    (hseed : ∀ i, seed.testBit i = true → i%9=4 ∨ i%9=5) :
    ∀ i, (steps.foldl (fun m j => m ||| (m <<< (9*2^j))) seed).testBit i = true →
      i%9=4 ∨ i%9=5 := by
  induction steps generalizing seed with
  | nil => exact hseed
  | cons j rest ih =>
    apply ih
    intro i hi
    simp only [Nat.testBit_or, Nat.testBit_shiftLeft, Bool.or_eq_true,
      Bool.and_eq_true, decide_eq_true_eq] at hi
    rcases hi with old | ⟨hle, hprev⟩
    · exact hseed i old
    · have hp := hseed (i-9*2^j) hprev
      omega

