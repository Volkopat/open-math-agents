/-- Each positive input in the window has the sign pattern of OEIS A389852. -/
theorem positive_window {n : ℕ} (hn : 0 < n) (hb : n ≤ 10000000) :
    ∃ d x y z : ℕ, 0 < d ∧ 0 < x ∧ 0 < y ∧ 0 < z ∧ n+d^3=x^3+y^3+z^3 := by
  obtain ⟨d,x,y,z,hd,hx,hy,hz,_,h⟩ := positive_window_bounded hn hb
  exact ⟨d,x,y,z,hd,hx,hy,hz,h⟩

/-- Scaling the four bases gives a representation for every positive cube
multiple of the window. Its subtracted base is at most 2347 times the scale. -/
theorem positive_cube_multiples {n t : ℕ} (hn : 0 < n) (hb : n ≤ 10000000) (ht : 0 < t) :
    ∃ d x y z : ℕ, 0 < d ∧ 0 < x ∧ 0 < y ∧ 0 < z ∧ d ≤ t*2347 ∧
      t^3*n+d^3 = x^3+y^3+z^3 := by
  obtain ⟨d,x,y,z,hd,hx,hy,hz,cap,h⟩ := positive_window_bounded hn hb
  refine ⟨t*d,t*x,t*y,t*z,by positivity,by positivity,by positivity,by positivity,
    Nat.mul_le_mul_left t cap,?_⟩
  simp only [mul_pow, ← Nat.mul_add, h]

/-- Cubes modulo nine are represented by the balanced residue of the base modulo three. -/
private theorem cube_residue (a : ℤ) :
    ∃ e p r : ℤ, -1 ≤ e ∧ e ≤ 1 ∧ a = 3*p+e ∧ a^3 = 9*r+e := by
  let e := (a+1) % 3 - 1
  let p := (a+1) / 3
  have low : -1 ≤ e := by dsimp [e]; omega
  have high : e ≤ 1 := by dsimp [e]; omega
  have h : a = 3*p+e := by dsimp [p,e]; omega
  have he : e^3=e := by
    rcases (show e = -1 ∨ e = 0 ∨ e = 1 by omega) with h | h | h <;> rw [h] <;> norm_num
  refine ⟨e, p, 3*p^3+3*p^2*e+p*e^2, low, high, h, ?_⟩
  calc
    a^3 = (3*p+e)^3 := congrArg (fun z : ℤ => z^3) h
    _ = 9*(3*p^3+3*p^2*e+p*e^2)+e^3 := by ring
    _ = _ := by rw [he]

/-- If a sum of four cubes is 4 modulo 9, all four bases are 1 modulo 3. -/
theorem bases_of_four {n a b c d : ℤ} (hn : n % 9 = 4)
    (h : n = a^3+b^3+c^3+d^3) :
    ∃ p q r s : ℤ, a = 3*p+1 ∧ b = 3*q+1 ∧ c = 3*r+1 ∧ d = 3*s+1 := by
  obtain ⟨ea,p,pa,la,ua,ha,hca⟩ := cube_residue a
  obtain ⟨eb,q,pb,lb,ub,hb,hcb⟩ := cube_residue b
  obtain ⟨ec,r,pc,lc,uc,hc,hcc⟩ := cube_residue c
  obtain ⟨ed,s,pd,ld,ud,hd,hcd⟩ := cube_residue d
  have esum : ea+eb+ec+ed=4 := by omega
  exact ⟨p,q,r,s,by omega,by omega,by omega,by omega⟩

/-- For a target congruent to five modulo nine, this gives the complete
finite search ranges when the next cube exceeds the largest possible total. -/
theorem search_bounds_of_five {n D d x y z : ℕ} (hn : n % 9 = 5) (hd : d ≤ D)
    (hgap : n + D^3 < (D + 1)^3) (h : n + d^3 = x^3 + y^3 + z^3) :
    d % 3 = 1 ∧ x % 3 = 2 ∧ y % 3 = 2 ∧ z % 3 = 2 ∧ x ≤ D ∧ y ≤ D ∧ z ≤ D := by
  have hcast : (n : ℤ) + (d : ℤ)^3 = (x : ℤ)^3 + (y : ℤ)^3 + (z : ℤ)^3 := by
    exact_mod_cast h
  have hmod : (n : ℤ) % 9 = 5 := by exact_mod_cast hn
  have hsigned : -(n : ℤ) = (-(x : ℤ))^3 + (-(y : ℤ))^3 + (-(z : ℤ))^3 + (d : ℤ)^3 := by
    linarith only [hcast]
  obtain ⟨a, b, c, k, hx, hy, hz, hk⟩ :=
    bases_of_four (show (-(n : ℤ)) % 9 = 4 by omega) hsigned
  have hsum : x^3 + y^3 + z^3 < (D + 1)^3 := calc
    _ = n + d^3 := h.symm
    _ ≤ n + D^3 := Nat.add_le_add_left (Nat.pow_le_pow_left hd 3) n
    _ < _ := hgap
  have bound (w : ℕ) (hw : w^3 ≤ x^3 + y^3 + z^3) : w ≤ D := by
    by_contra! hlarge
    have := Nat.pow_le_pow_left (show D + 1 ≤ w by omega) 3
    omega
  exact ⟨by omega, by omega, by omega, by omega,
    bound x (by omega), bound y (by omega), bound z (by omega)⟩

/-- An explicit representation attaining the window's uniform bound.
For this input, the following independent Python computation rules out every
smaller positive subtracted base. `search_bounds_of_five` proves completeness
of the residue and size restrictions used in the search.

```python
n, D = 4_469_756, 2347
assert n % 9 == 5 and n + D**3 < (D + 1)**3
cubes = [b**3 for b in range(2, D + 1, 3)]
pairs = {u + v for i, u in enumerate(cubes) for v in cubes[:i + 1]}

def represents(d):
    total = n + d**3
    return any(total - z in pairs for z in cubes if z < total)

least = next(d for d in range(1, D + 1, 3) if represents(d))
assert least == D
assert n + D**3 == 500**3 + 1400**3 + 2159**3
print(least)
```
-/
theorem window_bound_witness :
    4469756 + (2347 : ℕ)^3 = 500^3 + 1400^3 + 2159^3 := by decide

/-- Pair sums s,t and one third of the pair differences u,v give an exact
criterion. The two divisibility conditions ensure integral recovery of the bases. -/
theorem pair_criterion {n : ℤ} (hn : n % 9 = 4) :
    (∃ a b c d : ℤ, n = a^3+b^3+c^3+d^3) ↔
    ∃ s t u v : ℤ, s % 3 = 2 ∧ t % 3 = 2 ∧ 2 ∣ s-3*u ∧ 2 ∣ t-3*v ∧
      4*n = s^3+t^3+27*(s*u^2+t*v^2) := by
  constructor
  · rintro ⟨a,b,c,d,h⟩
    obtain ⟨p,q,r,k,ha,hb,hc,hd⟩ := bases_of_four hn h
    refine ⟨a+b,c+d,p-q,r-k,by omega,by omega,⟨b,by omega⟩,⟨d,by omega⟩,?_⟩
    rw [h,ha,hb,hc,hd]
    ring
  · rintro ⟨s,t,u,v,_,_,⟨b,hb⟩,⟨d,hd⟩,h⟩
    refine ⟨b+3*u,b,d+3*v,d,?_⟩
    have hs : s = 2*b+3*u := by omega
    have ht : t = 2*d+3*v := by omega
    have eq : 4*n = 4*((b+3*u)^3+b^3+(d+3*v)^3+d^3) := by
      calc
        _ = s^3+t^3+27*(s*u^2+t*v^2) := h
        _ = _ := by rw [hs,ht]; ring
    omega

/-- Taking the last positive cube one or two units above the subtracted
cube gives infinite families in both exceptional classes modulo nine. -/
theorem gap_families {n : ℕ}
    (h : (∃ a b k : ℕ, n = (3*a+1)^3+(3*b+1)^3+54*(k+1)^2+2) ∨
         (∃ a b k : ℕ, n = (3*a+2)^3+(3*b+2)^3+27*k*(k+1)+7)) :
    ∃ d x y z : ℕ, 0 < d ∧ 0 < x ∧ 0 < y ∧ 0 < z ∧
      n + d^3 = x^3+y^3+z^3 := by
  rcases h with ⟨a,b,k,rfl⟩ | ⟨a,b,k,rfl⟩
  · exact ⟨3*k+2,3*a+1,3*b+1,3*k+4,by positivity,by positivity,by positivity,
      by positivity,by ring⟩
  · exact ⟨3*k+1,3*a+2,3*b+2,3*k+2,by positivity,by positivity,by positivity,
      by positivity,by ring⟩

private theorem signed_of_positive {n : ℕ}
    (h : ∃ d x y z : ℕ, 0 < d ∧ 0 < x ∧ 0 < y ∧ 0 < z ∧
      n+d^3=x^3+y^3+z^3) :
    ∃ a b c d : ℤ, (n:ℤ) = a^3+b^3+c^3+d^3 := by
  obtain ⟨d,x,y,z,_,_,_,_,he⟩ := h
  refine ⟨x,y,z,-(d:ℤ),?_⟩
  have he' : (n:ℤ)+(d:ℤ)^3=(x:ℤ)^3+(y:ℤ)^3+(z:ℤ)^3 := by exact_mod_cast he
  linear_combination he'

private theorem negated {n : ℤ} (h : ∃ a b c d : ℤ, n=a^3+b^3+c^3+d^3) :
    ∃ a b c d : ℤ, -n=a^3+b^3+c^3+d^3 := by
  obtain ⟨a,b,c,d,rfl⟩ := h
  exact ⟨-a,-b,-c,-d,by ring⟩

/-- Positive residual inputs in the class 4 modulo 9. -/
def H1 : Prop := ∀ n : ℕ, 10000000 < n → n % 9 = 4 →
    (¬ ∃ a b k : ℕ, n = (3*a+1)^3+(3*b+1)^3+54*(k+1)^2+2) →
    ∃ s t u v : ℤ, s % 3 = 2 ∧ t % 3 = 2 ∧ 2 ∣ s-3*u ∧ 2 ∣ t-3*v ∧
      4*(n:ℤ) = s^3+t^3+27*(s*u^2+t*v^2)

/-- Class 5 modulo 9, normalized by negating n for the same pair criterion. -/
def H2 : Prop := ∀ n : ℕ, 10000000 < n → n % 9 = 5 →
    (¬ ∃ a b k : ℕ, n = (3*a+2)^3+(3*b+2)^3+27*k*(k+1)+7) →
    ∃ s t u v : ℤ, s % 3 = 2 ∧ t % 3 = 2 ∧ 2 ∣ s-3*u ∧ 2 ∣ t-3*v ∧
      4*(-(n:ℤ)) = s^3+t^3+27*(s*u^2+t*v^2)

theorem main : H1 → H2 → type_of% @OMA.S_mse_2751881.main := by
  intro h₁ h₂
  have pos (n : ℕ) (hr : n % 9 = 4 ∨ n % 9 = 5) :
      ∃ a b c d : ℤ, (n:ℤ)=a^3+b^3+c^3+d^3 := by
    by_cases small : n ≤ 10000000
    · exact signed_of_positive (positive_window (by omega) small)
    have large : 10000000 < n := by omega
    rcases hr with h4 | h5
    · by_cases gap : ∃ a b k : ℕ, n = (3*a+1)^3+(3*b+1)^3+54*(k+1)^2+2
      · exact signed_of_positive (gap_families (Or.inl gap))
      · exact (pair_criterion (n := (n:ℤ)) (by omega)).mpr (h₁ n large h4 gap)
    · by_cases gap : ∃ a b k : ℕ, n = (3*a+2)^3+(3*b+2)^3+27*k*(k+1)+7
      · exact signed_of_positive (gap_families (Or.inr gap))
      · have hneg := (pair_criterion (n := -(n:ℤ)) (by omega)).mpr (h₂ n large h5 gap)
        simpa only [neg_neg] using negated hneg
  intro n hn
  by_cases nonneg : 0 ≤ n
  · obtain ⟨m,rfl⟩ := Int.eq_ofNat_of_zero_le nonneg
    exact pos m (by omega)
  · have hn' : 0 ≤ -n := by omega
    obtain ⟨m,hm⟩ := Int.eq_ofNat_of_zero_le hn'
    have h : m % 9 = 4 ∨ m % 9 = 5 := by omega
    simpa only [← hm, neg_neg] using negated (pos m h)

