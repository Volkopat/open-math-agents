  let verify (j : ℕ) : Bool := (List.range 64).all fun i =>
    decide (valid (shape (64*j+i)) (digit blocks[j]! i))
  have table : (List.range 384).all verify = true := by decide +kernel
  have classified {k : ℕ} (hk : k < 24576) (hp : Erdos1140Prop (shape k)) : known (shape k) := by
    have block := List.all_eq_true.mp table (k/64) (List.mem_range.mpr (by omega))
    have item := List.all_eq_true.mp block (k%64) (List.mem_range.mpr (by omega))
    have ok := of_decide_eq_true item
    rw [show 64*(k/64)+k%64=k by omega] at ok
    exact sound ok hp
  change known n
  rcases hs with ⟨t,ht⟩ | ⟨y,hy⟩
  · have ht' : t < 32768 := by
      by_contra! h
      have := Nat.pow_le_pow_left h 2
      omega
    have parity : t%2=1 := by
      by_contra! h
      have ht0 : t = 2*(t/2) := by omega
      have he : t^2 = 4*(t/2)^2 := by
        calc t^2 = (2*(t/2))^2 := congrArg (fun a : ℕ => a^2) ht0
             _ = _ := by ring
      omega
    have hk : t/2 < 16384 := by omega
    have eq : shape (t/2) = n := by
      simp only [shape, if_pos hk]
      rw [show 2*(t/2)+1=t by omega, ← ht]
      omega
    rw [← eq] at hp ⊢
    exact classified (by omega) hp
  · have pos : 0 < y := by by_contra! h; interval_cases y; omega
    have hy' : y ≤ 8192 := by
      by_contra! h
      have m : 4*8193 ≤ 4*y := by omega
      have := Nat.pow_le_pow_left m 2
      omega
    let k := 16384+y-1
    have hk : 16384 ≤ k := by dsimp [k]; omega
    have eq : shape k = n := by
      simp only [shape, if_neg (Nat.not_lt.mpr hk)]
      rw [show k-16384+1=y by dsimp [k]; omega]
      have he : 8*y^2 = n+1 := by nlinarith [hy]
      omega
    rw [← eq] at hp ⊢
    exact classified (by dsimp [k]; omega) hp

private lemma shapeOne (n : ℕ) (hbig : 199<n) (hp : n.Prime) (hm : n%4 ≠ 3) (good : Erdos1140Prop n) :
    ∃ t : ℕ, t.Prime ∧ Odd t ∧ 2*n=t^2+1 := by
  letI : Fact n.Prime := ⟨hp⟩
  obtain ⟨a,b,h⟩ := Nat.Prime.sq_add_sq hm
  have go (a b : ℕ) (hle : b ≤ a) (eq : a^2+b^2=n) :
      ∃ t : ℕ, t.Prime ∧ Odd t ∧ 2*n=t^2+1 := by
    have hne : a ≠ b := by
      rintro rfl
      have dvd : 2 ∣ n := ⟨a^2,by omega⟩
      have := (Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp dvd
      omega
    obtain ⟨d,hd⟩ := Nat.exists_eq_add_of_le hle
    have dp : 0 < d := by omega
    have lt : 2*b^2<n := by nlinarith [Nat.pow_lt_pow_left (show b<a by omega) (by decide : 2≠0)]
    have diff : n-2*b^2 = d*(a+b) := by
      apply Nat.sub_eq_of_eq_add
      rw [← eq,hd]
      ring
    have pm := good.2 b lt
    rw [diff] at pm
    rcases Nat.prime_mul_iff.mp pm with ⟨_,one⟩|⟨pt,one⟩
    · have small : a = 1 ∧ b = 0 := by omega
      rw [small.1,small.2] at eq
      norm_num at eq
      omega
    · refine ⟨a+b,pt,pt.odd_of_ne_two (by omega),?_⟩
      rw [one] at hd
      rw [← eq,hd]
      ring
  rcases le_total a b with ab|ba
  · exact go b a ab (by rwa [add_comm])
  · exact go a b ba h

private lemma square_mod (x : ℕ) : x^2%8=0 ∨ x^2%8=1 ∨ x^2%8=4 := by
  have h : ∀ a : Fin 8, a.val^2%8=0 ∨ a.val^2%8=1 ∨ a.val^2%8=4 := by decide
  simpa [Nat.pow_mod] using h ⟨x%8,Nat.mod_lt _ (by decide)⟩

private lemma no_root {n : ℕ} (res : n%4=3) (prop : Erdos1140Prop n)
    {p : ℕ} (hp : p.Prime) (odd : p ≠ 2) (le : p^2 ≤ 2*n) (a : ZMod p) :
    2*a^2 ≠ (n : ZMod p) := by
  intro eq
  let _ : Fact p.Prime := ⟨hp⟩
  let r := a.valMinAbs.natAbs
  have hr : r ≤ p/2 := ZMod.natAbs_valMinAbs_le a
  have oddp := hp.eq_two_or_odd.resolve_left odd
  have pr : 2*r+1 ≤ p := by omega
  have sp := square_mod p
  have gap : p^2+1 < 2*n := by omega
  have hsq := Nat.pow_le_pow_left pr 2
  have room : 2*r^2+p < n := by
    zify at pr gap ⊢
    nlinarith [mul_nonneg (show 0 ≤ (p:ℤ) - (2*r+1) by omega)
      (show 0 ≤ (p:ℤ) + (2*r+1) - 2 by omega)]
  have er : 2*(r:ZMod p)^2=(n:ZMod p) := by
    change 2*(a.valMinAbs.natAbs:ZMod p)^2 = _
    rw [ZMod.natCast_natAbs_valMinAbs]
    split <;> simpa using eq
  have hd : p ∣ n-2*r^2 := by
    apply (ZMod.natCast_eq_zero_iff ..).mp
    rw [Nat.cast_sub (by omega)]
    push_cast
    rw [er,sub_self]
  have prime := prop.2 r (by omega)
  have e := (Nat.prime_dvd_prime_iff_eq hp prime).mp hd
  omega

private lemma nearest (n : ℕ) : ∃ k d : ℕ, d ≤ (2*n).sqrt ∧
    (n=2*k^2+d ∨ 2*k^2=n+d) := by
  let s := (2*n).sqrt
  let j := s/2
  have lo : s^2 ≤ 2*n := Nat.sqrt_le' _
  have hi : 2*n < (s+1)^2 := Nat.lt_succ_sqrt' _
  have cases : s=2*j ∨ s=2*j+1 := by dsimp [j]; omega
  rcases cases with e | e
  · rw [e] at lo hi
    have low : 2*j^2 ≤ n := by nlinarith
    refine ⟨j,n-2*j^2,?_,Or.inl (by omega)⟩
    change n-2*j^2 ≤ s
    rw [e]
    have up : n ≤ 2*j^2+2*j := by nlinarith
    omega
  · rw [e] at lo hi
    have up : n ≤ 2*(j+1)^2 := by nlinarith
    refine ⟨j+1,2*(j+1)^2-n,?_,Or.inr (by omega)⟩
    change 2*(j+1)^2-n ≤ s
    rw [e]
    have h : 2*(j+1)^2 ≤ n+(2*j+1) := by nlinarith
    omega

private lemma shapeThree {n : ℕ} (res : n%4=3) (prop : Erdos1140Prop n)
    (one : ∀ x : ℕ, n ≠ 2*x^2+1) : ∃ y : ℕ, 2*n+2=(4*y)^2 := by
  obtain ⟨k,d,le,h⟩ := nearest n
  have odd : d%2=1 := by rcases h with h|h <;> omega
  have d1 : d=1 := by
    by_contra hn
    let p := d.minFac
    have hp : p.Prime := Nat.minFac_prime hn
    have pd : p ∣ d := Nat.minFac_dvd _
    have pn : p ≠ 2 := by intro e; rw [e] at pd; omega
    have small : p^2 ≤ 2*n := Nat.le_sqrt'.mp ((Nat.le_of_dvd (by omega) pd).trans le)
    apply no_root res prop hp pn small (k : ZMod p)
    have zero := (ZMod.natCast_eq_zero_iff d p).mpr pd
    rcases h with h | h
    · have e := congrArg (fun x : ℕ => (x : ZMod p)) h
      push_cast at e
      simpa [zero] using e.symm
    · have e := congrArg (fun x : ℕ => (x : ZMod p)) h
      push_cast at e
      simpa [zero] using e
  subst d
  rcases h with h | h
  · exact (one k h).elim
  have ke : k%2=0 := by
    have ks := square_mod k
    by_contra hn
    have : k^2%2=1 := by rw [Nat.pow_mod]; simp [show k%2=1 by omega]
    omega
  refine ⟨k/2,?_⟩
  have ek : k=2*(k/2) := by omega
  conv_lhs at h => rw [ek]
  nlinarith


private theorem small : ∀ n : Fin 200, Erdos1140Prop n.val → n.val ∈ ([2,5,7,13,31,61,181,199] : List ℕ) := by decide +kernel

theorem classified_through_cutoff {n : ℕ} (hn : n ≤ 2^29) (hp : Erdos1140Prop n) : n ∈ ([2,5,7,13,31,61,181,199] : List ℕ) := by
  by_cases h : n < 200
  · exact small ⟨n,h⟩ hp
  apply classified_of_shapes hn hp
  by_cases hm : n%4 = 3
  · right
    apply shapeThree hm hp
    intro x eq
    have v := hp.2 x (by omega : 2*x^2 < n)
    rw [show n-2*x^2=1 by omega] at v
    exact Nat.not_prime_one v
  · left
    have prime := hp.2 0 (by simpa using hp.1)
    simp at prime
    obtain ⟨t,_,_,eq⟩ := shapeOne n (by omega) prime hm hp
    exact ⟨t,eq⟩
theorem cutoff {x r : ℝ} (hx : 4 ≤ x)
    (lower : 1 / (25*x) ≤ r) (upper : r ≤ 4 * Real.log (x^16) / x^8) : False := by
  have pos : 0 < x := by linarith
  have h := lower.trans upper
  rw [Real.log_pow] at h
  have bound := (div_le_div_iff₀ (by positivity : 0 < 25*x) (pow_pos pos 8)).mp h
  have logBound := Real.log_le_sub_one_of_pos pos
  have high : (4:ℝ)^6 ≤ x^6 := by gcongr
  have scaled := mul_le_mul_of_nonneg_right high (sq_nonneg x)
  have ub : x^8 ≤ 1600 * x^2 := by
    calc
      x^8 ≤ 1600 * (Real.log x * x) := by ring_nf at bound ⊢; exact bound
      _ ≤ 1600 * (x * x) := by gcongr; linarith
      _ = _ := by ring
  have lb : 4096*x^2 ≤ x^8 := by ring_nf at scaled ⊢; exact scaled
  linarith only [ub, lb, sq_pos_of_pos pos]

theorem discriminant_cutoff {D r : ℝ} (large : 2^32 ≤ D)
    (lower : (25:ℝ)⁻¹ * D ^ (-(1/16:ℝ)) ≤ r)
    (upper : r ≤ 4 * Real.log D / Real.sqrt D) : False := by
  have hd : 0 ≤ D := by linarith
  let x := D ^ (1/16:ℝ)
  have power : x^16 = D := by
    dsimp [x]
    rw [← Real.rpow_mul_natCast hd]
    norm_num
  have root : x^8 = Real.sqrt D := by
    dsimp [x]
    rw [← Real.rpow_mul_natCast hd, Real.sqrt_eq_rpow]
    norm_num
  have hx : 4 ≤ x := by
    by_contra! h
    have hp := pow_lt_pow_left₀ h (Real.rpow_nonneg hd _) (by decide : 16 ≠ 0)
    rw [power] at hp
    norm_num at hp large
    linarith
  apply cutoff hx (r := r)
  · simpa [Real.rpow_neg hd, x, div_eq_mul_inv, mul_comm, mul_left_comm] using lower
  · simpa [power, root] using upper


def H1 : Prop :=
  ∀ n : ℕ, 2^29 < n → Erdos1140Prop n →
    ∃ (K : Type) (_ : Field K) (_ : NumberField K),
      Module.finrank ℚ K = 2 ∧ nrComplexPlaces K = 0 ∧ discr K = 8*(n:ℤ) ∧
      dedekindZeta_residue K ≤ 4*Real.log (8*(n:ℝ))/Real.sqrt (8*(n:ℝ))

def H2 : Prop :=
  ∃ E : Set ℤ, E.Subsingleton ∧
    ∀ (K : Type) [Field K] [NumberField K], Module.finrank ℚ K = 2 →
      nrComplexPlaces K = 0 → discr K ∉ E → (2:ℤ)^32 ≤ discr K →
      (25:ℝ)⁻¹ * (discr K : ℝ)^(-(1/16:ℝ)) ≤ dedekindZeta_residue K

theorem main : H1 → H2 → type_of% @Erdos1140.erdos_1140.variants.at_most_one_exception := by
  intro fields ⟨E,unique,lb⟩
  have mem {n : ℕ} (good : Erdos1140Prop n)
      (unlisted : n ∉ ({2,5,7,13,31,61,181,199} : Set ℕ)) : 8*(n:ℤ) ∈ E := by
    have large : 2^29 < n := by
      by_contra! h
      have hmem := classified_through_cutoff h good
      exact unlisted (by simpa using hmem)
    obtain ⟨K,instF,instN,rank,real,disc,upper⟩ := fields n large good
    letI := instF
    letI := instN
    by_contra outside
    have db : (2:ℤ)^32 ≤ discr K := by rw [disc]; omega
    have lower := lb K rank real (disc ▸ outside) db
    rw [disc] at lower
    push_cast at lower
    apply discriminant_cutoff (D := 8*(n:ℝ)) (r := dedekindZeta_residue K) _ lower upper
    exact_mod_cast (show (2:ℕ)^32 ≤ 8*n by omega)
  intro n hn m hm
  have eq := unique (mem hn.1 hn.2) (mem hm.1 hm.2)
  omega

end OMA.R_Erdos1140_erdos_1140_variants_at_most_one_exception_R2
