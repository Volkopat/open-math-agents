import FormalConjectures.ErdosProblems.«1140»
import Mathlib

/-! Explicit finite classification through 2^29, followed by a reduction to two estimates
for real quadratic fields. The cutoff and proposed estimates are from MechaNuggan's
desk note 114249. The scalar inequalities follow PanPapag's note 124764. The shape
arguments below are copied from the merged H1.R1 and H2.R1 reductions of R1.
The packed table contains divisor witnesses generated independently by trial division. -/
namespace OMA.R_Erdos1140_erdos_1140_variants_at_most_one_exception_R2
open Erdos1140 NumberField NumberField.InfinitePlace

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
private theorem classified_of_shapes {n : ℕ} (hn : n ≤ 2^29) (hp : Erdos1140Prop n)
    (hs : (∃ t : ℕ, 2*n = t^2+1) ∨ (∃ y : ℕ, 2*n+2 = (4*y)^2)) :
    n ∈ ([2,5,7,13,31,61,181,199] : List ℕ) := by
  let known (n : ℕ) := n ∈ ([2,5,7,13,31,61,181,199] : List ℕ)
  let shape (k : ℕ) := if k < 16384 then ((2*k+1)^2+1)/2 else 8*(k-16384+1)^2-1
  let valid (n w : ℕ) : Prop :=
    let x := w / 65536
    let d := w % 65536
    let v := n - 2*x^2
    n ∈ ([2,5,7,13,31,61,181,199] : List ℕ) ∨ n = 0 ∨ (2*x^2 < n ∧ (v = 1 ∨ (1 < d ∧ d < v ∧ v % d = 0)))
  letI (n w : ℕ) : Decidable (valid n w) := by dsimp [valid, known]; infer_instance
  have sound {n w : ℕ} (h : valid n w) (hp : Erdos1140Prop n) : known n := by
    rcases h with h | hz | ⟨hx,h⟩
    · exact h
    · have := hp.1
      omega
    · have pr := hp.2 _ hx
      rcases h with h | ⟨hd, hv, hmod⟩
      · have := pr.two_le
        omega
      · have := pr.eq_one_or_self_of_dvd _ (Nat.dvd_of_mod_eq_zero hmod)
        omega
  let digit (z i : ℕ) := (z >>> (32*i)) % 4294967296
  let blocks : Array ℕ := #[
