/-- A middle column is sparse. The outer anchors are the highest red points. -/
def H1 : Prop := ∀ (R : Finset ℕ) (i j k l : Fin 13),
    (∀ x ∈ R, ∀ y ∈ R, ∀ z ∈ R, x + z = 2*y → x = z) →
    (∀ a d : ℕ, 0 < d → d ≤ 12 → a+12*d < 160 → ∃ t : Fin 13, a+t.val*d ∈ R) →
    13*i.val ∈ R → 13*j.val+1 ∈ R → 13*k.val+2 ∈ R → 13*l.val+3 ∈ R →
    2*j.val < i.val+k.val → 2*k.val < j.val+l.val →
    (∀ u : Fin 13, i.val < u.val → 13*u.val ∉ R) →
    (∀ u : Fin 13, l.val < u.val → 13*u.val+3 ∉ R) →
    (∀ s : ℕ, 0 < s → s ≤ j.val → s ≤ k.val →
      ¬ (13*(j.val-s)+1 ∈ R ∧ 13*(k.val-s)+2 ∈ R)) →
    let count (r : ℕ) := ((Finset.range 13).filter fun u => 13*u+r ∈ R).card
    (count 1 ≤ 5 ∨ count 2 ≤ 5) → False

/-- Both middle columns are dense, forcing both outer columns to be sparse. -/
def H2 : Prop := ∀ (R : Finset ℕ) (i j k l : Fin 13),
    (∀ x ∈ R, ∀ y ∈ R, ∀ z ∈ R, x + z = 2*y → x = z) →
    (∀ a d : ℕ, 0 < d → d ≤ 12 → a+12*d < 160 → ∃ t : Fin 13, a+t.val*d ∈ R) →
    13*i.val ∈ R → 13*j.val+1 ∈ R → 13*k.val+2 ∈ R → 13*l.val+3 ∈ R →
    2*j.val < i.val+k.val → 2*k.val < j.val+l.val →
    (∀ u : Fin 13, i.val < u.val → 13*u.val ∉ R) →
    (∀ u : Fin 13, l.val < u.val → 13*u.val+3 ∉ R) →
    (∀ s : ℕ, 0 < s → s ≤ j.val → s ≤ k.val →
      ¬ (13*(j.val-s)+1 ∈ R ∧ 13*(k.val-s)+2 ∈ R)) →
    let count (r : ℕ) := ((Finset.range 13).filter fun u => 13*u+r ∈ R).card
    (6 ≤ count 1 ∧ 6 ≤ count 2 ∧ count 0 ≤ 5 ∧ count 3 ≤ 5) → False


theorem main : H1 → H2 → OMA.R_Green14_W_3_13_R2.H1 := by
  intro inner outer R i j k l free hit hi hj hk hl convex1 convex2
  have hits := all_hits R i j k l hit hi hj hk hl
  let height (r : ℕ) := (Finset.range 13).filter (fun u => 13*u+r ∈ R)
