    have pm : p.val ∈ height r := Finset.mem_filter.mpr ⟨Finset.mem_range.mpr p.isLt,rp⟩
    obtain ⟨v,hv,hmax⟩ := (height r).exists_max_image id ⟨_,pm⟩
    obtain ⟨vlt,vr⟩ := Finset.mem_filter.mp hv
    refine ⟨⟨v,Finset.mem_range.mp vlt⟩,hmax _ pm,vr,?_⟩
    intro u hul hur
