import OMAReductions.R_Green14_W_3_13_R2

/-!
# Sparse anchor columns in the strictly convex case for W(3,13)

The four columns consist of the sites 13u+r for 0 ≤ u ≤ 12 and 0 ≤ r ≤ 3.
Three consecutive columns cannot each contain six reds. Select six sites per
column. Red triples within each column leave 78 possible height sets. For the
first two sets U and V, remove every height z with x+z=2y for x in U and y in V.
Only four ordered triples of six-sets survive. The eight short search tapes
exclude them in both placements on the board. Each tape node picks a 13-term
progression and checks every possible red witness against previously known reds.

To reduce repeated search, maximize the outer anchor heights and minimize
the inner sum over strictly convex choices. The inner heights cannot then
both be lowered by the same positive amount to two further red positions.
The two remaining cases separate a sparse inner column from two dense inner
columns flanked by sparse outer columns.
-/

namespace OMA.R_Green14_W_3_13_R2_H1_R1

private theorem tape_sound (R : Finset ℕ)
    (free : ∀ x ∈ R, ∀ y ∈ R, ∀ z ∈ R, x + z = 2*y → x = z)
    (hit : ∀ a d : ℕ, 0 < d → a+12*d < 160 → ∃ t : Fin 13, a+t.val*d ∈ R)
    (tape : List (List ℕ × ℕ × ℕ))
    (cert : ∀ v ∈ tape, v.1.length < 160 ∧ 0 < v.2.2 ∧ v.2.1 + 12*v.2.2 < 160 ∧
      ∀ t : Fin 13, let x := v.2.1+t.val*v.2.2
        (∃ u ∈ v.1, ∃ w ∈ v.1, u ≠ w ∧ (u+w=2*x ∨ x+u=2*w)) ∨
        ∃ child ∈ tape, child.1 = x :: v.1) :
    ∀ v ∈ tape, (∀ x ∈ v.1, x ∈ R) → False := by
  have kill (k : ℕ) : ∀ v ∈ tape, 160-v.1.length=k → (∀ x ∈ v.1, x ∈ R) → False := by
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro v hv hk hs
      obtain ⟨hlen,hd,hend,step⟩ := cert v hv
      obtain ⟨t,ht⟩ := hit _ _ hd hend
      rcases step t with ⟨u,hu,w,hw,hn,he | he⟩ | ⟨c,hc,eqn⟩
      · exact hn (free _ (hs _ hu) _ ht _ (hs _ hw) he)
      · have hh := free _ ht _ (hs _ hw) _ (hs _ hu) he
        omega
      · apply ih (160-c.1.length) (by rw [eqn,List.length_cons]; omega) c hc rfl
        simp only [eqn,List.mem_cons,forall_eq_or_imp]
        exact ⟨ht,hs⟩
  exact fun v hv => kill _ v hv rfl

private theorem all_hits (R : Finset ℕ) (i j k l : Fin 13)
    (hit : ∀ a d : ℕ, 0 < d → d ≤ 12 → a+12*d < 160 → ∃ t : Fin 13, a+t.val*d ∈ R)
    (hi : 13*i.val ∈ R) (hj : 13*j.val+1 ∈ R)
    (hk : 13*k.val+2 ∈ R) (hl : 13*l.val+3 ∈ R) :
    ∀ a d : ℕ, 0 < d → a+12*d < 160 → ∃ t : Fin 13, a+t.val*d ∈ R := by
  intro a d hd he
  by_cases small : d ≤ 12
  · exact hit _ _ hd small he
  have : d = 13 := by omega
  subst d
  have cases : a=0 ∨ a=1 ∨ a=2 ∨ a=3 := by omega
  rcases cases with rfl | rfl | rfl | rfl
  · exact ⟨i, by simpa [Nat.mul_comm] using hi⟩
  · exact ⟨j, by simpa [Nat.mul_comm, Nat.add_comm] using hj⟩
  · exact ⟨k, by simpa [Nat.mul_comm, Nat.add_comm] using hk⟩
  · exact ⟨l, by simpa [Nat.mul_comm, Nat.add_comm] using hl⟩

