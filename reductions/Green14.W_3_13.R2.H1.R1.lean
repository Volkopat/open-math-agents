private theorem sparse_three (R : Finset ℕ) (o : ℕ) (ho : o ≤ 1)
    (free : ∀ x ∈ R, ∀ y ∈ R, ∀ z ∈ R, x + z = 2*y → x = z)
    (hit : ∀ a d : ℕ, 0 < d → a+12*d < 160 → ∃ t : Fin 13, a+t.val*d ∈ R) :
    ∃ r ∈ [o,o+1,o+2], ((Finset.range 13).filter fun u => 13*u+r ∈ R).card ≤ 5 := by
  by_contra! h
  have take (r : ℕ) (hr : r ∈ [o,o+1,o+2]) :
      ∃ S : Finset ℕ, (S ⊆ Finset.range 13 ∧ S.card = 6 ∧
        ∀ x ∈ S, ∀ y ∈ S, ∀ z ∈ S, x+z=2*y → x=z) ∧
        ∀ x ∈ S, 13*x+r ∈ R := by
    obtain ⟨S,sub,hsize⟩ := Finset.exists_subset_card_eq (h r hr)
    have red (x) (hx : x ∈ S) := (Finset.mem_filter.mp (sub hx)).2
    refine ⟨S,⟨fun x hx => (Finset.mem_filter.mp (sub hx)).1,hsize,?_⟩,red⟩
    intro x hx y hy z hz eqn
    have he := free _ (red _ hx) _ (red _ hy) _ (red _ hz) (by omega)
    omega
  obtain ⟨A,hA,ra⟩ := take o (by simp)
  obtain ⟨B,hB,rb⟩ := take (o+1) (by simp)
