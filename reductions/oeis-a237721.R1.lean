private theorem prime_of_factorial {p t : ℕ} (hp : 2 ≤ p) (h : p ≤ t*t)
    (hcop : p.gcd t.factorial = 1) : p.Prime := by
  by_contra hn
  have hm := Nat.minFac_prime (by omega : p ≠ 1)
  have hs := Nat.minFac_sq_le_self (by omega : 0 < p) hn
  have ht : p.minFac ≤ t := by
    by_contra! he
    have h' := Nat.mul_self_lt_mul_self he
    nlinarith
  have e := Nat.dvd_gcd (Nat.minFac_dvd p) (Nat.dvd_factorial hm.pos ht)
  rw [hcop] at e
  exact hm.not_dvd_one e

theorem prime_from_test (p : ℕ)
    (h : decide ((p ≤ 20 ∧ p.Prime) ∨
      (20 < p ∧ p ≤ 400 ∧ p.gcd (Nat.factorial 20) = 1) ∨
      (400 < p ∧ p ≤ 370*370 ∧ p.gcd (Nat.factorial 370) = 1)) = true) : p.Prime := by
  rcases decide_eq_true_eq.mp h with h|h|h
  · exact h.2
  · exact prime_of_factorial (by omega) h.2.1 h.2.2
  · exact prime_of_factorial (by omega) h.2.1 h.2.2

theorem small_rows {k first last : ℕ} {rows : List (ℕ × ℕ × ℕ × ℕ)} {ok : ℕ → Bool}
    (hok : ∀ p, ok p = true → p.Prime)
    (hc : rows.foldr (fun (row : ℕ × ℕ × ℕ × ℕ) (rest : ℕ → Bool) (i : ℕ) =>
        let (p,t,q,s) := row
        ok p && ok q && decide (p ≠ q ∧ p+t^4 ≤ i ∧ q+s^4 ≤ i) &&
          rest (min (p+t^4+2*t^2) (q+s^4+2*s^2)+1))
      (fun i => decide (last ≤ i)) first = true)
    (hl : first ≤ k) (hh : k < last) : 2 ≤ a k := by
  induction rows generalizing first with
  | nil => simp at hc; omega
  | cons row tail ih =>
    obtain ⟨p,t,q,s⟩ := row
    simp only [List.foldr_cons, Bool.and_eq_true, decide_eq_true_eq] at hc
    by_cases he : k ≤ min (p+t^4+2*t^2) (q+s^4+2*s^2)
    · rcases hc.1 with ⟨⟨hp,hq⟩,hne,hpL,hqL⟩
      exact two_of_windows (t := t) (s := s) (hok _ hp) (hok _ hq) hne (by omega)
        (le_trans he (min_le_left _ _)) (by omega) (le_trans he (min_le_right _ _))
    · exact ih hc.2 (by omega)

