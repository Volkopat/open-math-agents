/-- The sharp Schoenfeld estimate for the second Chebyshev function. -/
def H1 : Prop := ∀ z : ℝ, 73.2 ≤ z →
  |Chebyshev.psi z-z| < Real.sqrt z*(Real.log z)^2/(8*Real.pi)

/-- A finite net of prime pairs with an integer certificate for the allowed window width. -/
def H2 : Prop := ∀ R : ℕ, 131072 ≤ R → R ≤ 281474976972799 →
  ∃ b p q : ℕ, 9*b^3 ≤ R ∧ p.Prime ∧ q.Prime ∧ p < q ∧ q ≤ R ∧ R ≤ p+2*b^2

theorem main : H1 → H2 → type_of% @OMA.S_oeis_a237721.main := by
  intro h1 h2
  have hlarge : ∀ n : ℕ, 18 ≤ n → 2 ≤ a n := by
    intro n hn
    by_cases hs : n < 33^4
    · exact two_small hn hs
    · exact large_from_supply (analytic_tail h1) h2 (by omega)
  constructor
  · intro n hn
    by_cases hs : n < 18
    · exact (small_exact hs).1 hn
    · exact (show 0 < 2 by decide).trans_le (hlarge n (by omega))
  · intro n
    by_cases hs : n < 18
    · exact (small_exact hs).2
    · have ha := hlarge n (by omega)
      simp only [Finset.mem_insert, Finset.mem_singleton]
      omega

