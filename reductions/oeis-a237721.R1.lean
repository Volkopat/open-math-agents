import OMAStatements.S_oeis_a237721

/-!
# A prime in two quartic windows
Sun's question appeared in OEIS A237721 in February 2014. The proof uses the square-root
window t^4 through t^4+2t^2. The large case uses Schoenfeld's explicit estimate for psi,
Math. Comp. 30 (1976), 337–360. The finite hypothesis asks for prime pairs on a specified
interval and contains no reference to Sun's sequence. The smaller inputs are checked here.
-/

namespace OMA.R_oeis_a237721_R1

section


open Real Chebyshev

private theorem pp_loss {x : ℝ} (hx : 1 ≤ x) : psi x-theta x ≤ 17*sqrt x := by
  have h (n : ℕ) (hn : 2 ≤ n) : psi (x^(1/(n:ℝ))) ≤ (log 4+4)*sqrt x := by
    grw [psi_le_const_mul_self (by positivity),sqrt_eq_rpow x]; gcongr; norm_cast
  have hc : log 4+4 ≤ 17/3 := by
    rw [show (4:ℝ)=2^2 by norm_num,log_pow]; norm_num; linarith [log_two_lt_d9]
  linarith [psi_sub_theta_le_psi_add_psi_add_psi x,h 2 (by decide),h 3 (by decide),h 5 (by decide),
    mul_le_mul_of_nonneg_right hc (sqrt_nonneg x)]

private theorem large_theta
    (hs : ∀ z : ℝ, 73.2 ≤ z → |psi z-z| < sqrt z*(log z)^2/(8*Real.pi))
    {t R : ℝ} (ht : 32768 ≤ t) (h1 : 4*t^3 ≤ R) (h2 : R ≤ 9*t^3) :
    log R < theta R-theta (R-2*t^2) := by
  let u:=t^((4:ℝ)⁻¹)
  let s:=sqrt t
  let V:=R-2*t^2
  have ht0 : 0<t := by linarith
  have hts : s^2=t := sq_sqrt ht0.le
  have hs0 : 0 ≤ s := sqrt_nonneg _
  have hs180 : 180 ≤ s := by nlinarith
  have hu : 13 ≤ u := calc
    (13:ℝ) = ((13:ℝ)^4)^((4:ℝ)⁻¹) := by simpa using (pow_rpow_inv_natCast (x:=(13:ℝ)) (by norm_num) (by decide : (4:ℕ)≠0)).symm
    _ ≤ u := rpow_le_rpow (by norm_num) (by norm_num; linarith) (by norm_num)
  have hu0 : 0<u := by linarith
  have hu2 : u^2=s := by dsimp [u,s];rw [←rpow_mul_natCast ht0.le _ 2,sqrt_eq_rpow];norm_num
  have hV : 73.2 ≤ V := by
    dsimp [V];nlinarith [mul_nonneg (show 0 ≤ t-3 by linarith) (sq_nonneg t),sq_nonneg (t-1)]
  have hVR : V ≤ R := by dsimp [V];nlinarith [sq_nonneg t]
  have hR0 : 0<R := by linarith
  have hV0 : 0<V := by linarith
  have hlog13 : log (13:ℝ)<13/5 := by
    have h:=log_le_sub_one_of_pos (by norm_num : 0<(13:ℝ)/16)
    rw [log_div (by norm_num) (by norm_num),show (16:ℝ)=2^4 by norm_num,log_pow] at h
    norm_num at h; linarith [log_two_lt_d9]
  have hlog9 : log (9:ℝ)<9/4 := by
    have h:=log_le_sub_one_of_pos (by norm_num : 0<(9:ℝ)/8)
    rw [log_div (by norm_num) (by norm_num),show (8:ℝ)=2^3 by norm_num,log_pow] at h
    norm_num at h; linarith [log_two_lt_d9]
  have hlog : log R ≤ (13/5)*u := by
    have h:=log_le_log hR0 h2
    rw [log_mul (by norm_num) (by positivity),log_pow] at h
    have h':=log_le_sub_one_of_pos (show 0<u/13 by positivity)
    rw [log_div hu0.ne' (by norm_num), show log u=(4:ℝ)⁻¹*log t from log_rpow ht0 _] at h'
    norm_num at h h';linarith
  have hlog0 : 0 ≤ log R := log_nonneg (by linarith)
  have hVlog0 : 0 ≤ log V := log_nonneg (by linarith)
  have hlog2 : (log R)^2 ≤ (169/25)*s := by
    have h:=pow_le_pow_left₀ hlog0 hlog 2
    rw [mul_pow,hu2] at h;norm_num at h ⊢;linarith
  have hroot : sqrt R ≤ 3*t*s := by
    apply le_of_sq_le_sq _ (by positivity)
    rw [mul_pow,mul_pow, sq_sqrt hR0.le,hts];nlinarith
  have hn : (3*t*s)*((169/25)*s) = (507/25)*t^2 := by
    calc _ = (507/25)*t*s^2 := by ring
         _ = _ := by rw [hts];ring
  have hscale : sqrt R*(log R)^2 ≤ (507/25)*t^2 := hn ▸ (mul_le_mul hroot hlog2 (sq_nonneg _) (by positivity))
  have hnum : sqrt V*(log V)^2 ≤ sqrt R*(log R)^2 := by
    gcongr
  have hpi : (24:ℝ) ≤ 8*Real.pi := by linarith [Real.pi_gt_three]
  have he {w : ℝ} (hw0 : 0 ≤ w) (hw : w ≤ (507/25)*t^2) : w/(8*Real.pi) ≤ (169/200)*t^2 := calc
    _ ≤ w/24 := div_le_div_of_nonneg_left hw0 (by norm_num) hpi
    _ ≤ _ := by linarith
  have hpp : 17*sqrt R ≤ (17/60)*t^2 := by
    have hsq : 180*s ≤ t := by nlinarith [mul_nonneg (sub_nonneg.mpr hs180) hs0]
    nlinarith [mul_le_mul_of_nonneg_left hsq ht0.le]
  have hdiff : t^2/40 ≤ theta R-theta V := by
    have h:= (abs_lt.mp (hs R (by linarith))).1
    have h' := (abs_lt.mp (hs V hV)).2
    have hpp':=pp_loss (show 1 ≤ R by linarith)
    have htt:=theta_le_psi V
    have e1:=he (show 0 ≤ sqrt R*(log R)^2 by positivity) hscale
    have e2:=he (show 0 ≤ sqrt V*(log V)^2 by positivity) (hnum.trans hscale)
    dsimp [V] at *;linarith [sq_nonneg t]
  apply lt_of_lt_of_le _ hdiff
  have hut : u ≤ t := by nlinarith [sq_nonneg (u-1),sq_nonneg (s-1)]
  nlinarith [mul_nonneg (show 0 ≤ t-105 by linarith) ht0.le]

theorem analytic_tail
    (hs : ∀ z : ℝ, 73.2 ≤ z → |psi z-z| < sqrt z*(log z)^2/(8*Real.pi))
    (t R : ℕ) (ht : 32768 ≤ t) (hl : (t+1)^4-t^4 ≤ R) (hu : R<(t+2)^4-t^4) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p<q ∧ q ≤ R ∧ R ≤ p+2*t^2 := by
  have hl' := Nat.sub_le_iff_le_add.mp hl
  have hu' : R+t^4 < (t+2)^4 := by omega
  have h1 : 4*t^3 ≤ R := by nlinarith
  have h2 : R ≤ 9*t^3 := by
    nlinarith [Nat.mul_le_mul_right (t^2) (show 32 ≤ t by omega),Nat.mul_le_mul_right t (show 32 ≤ t by omega)]
  have hv : 2*t^2 ≤ R := by nlinarith [Nat.mul_le_mul_right (t^2) (show 2 ≤ t by omega)]
  let V := R-2*t^2
  have hVR : V ≤ R := Nat.sub_le ..
  have tau := large_theta (t:=(t:ℝ)) (R:=(R:ℝ)) hs (by exact_mod_cast ht) (by exact_mod_cast h1) (by exact_mod_cast h2)
  have hcast : (V:ℝ)=(R:ℝ)-2*(t:ℝ)^2 := by dsimp [V];rw [Nat.cast_sub hv];push_cast;ring
  rw [←hcast,theta_eq_sum_primesLE_log,theta_eq_sum_primesLE_log] at tau
  let A:=Nat.primesLE R
  let B:=Nat.primesLE V
  let S:=A\B
  have hAB : B⊆A := Nat.primesLE_mono hVR
  have hsum := Finset.sum_sdiff hAB (f:=fun p:ℕ => log (p:ℝ))
  have hw : ∑ p ∈ S, log (p:ℝ) ≤ ∑ _p ∈ S, log (R:ℝ) := by
    refine Finset.sum_le_sum (fun p hp => ?_)
    have h:=Nat.mem_primesLE.mp (Finset.mem_sdiff.mp hp).1
    exact log_le_log (by exact_mod_cast h.2.pos) (by exact_mod_cast h.1)
  rw [Finset.sum_const,nsmul_eq_mul] at hw
  have hcard : 1<S.card := by
    by_contra! hh
    have hRpos : 0<R := lt_of_lt_of_le (Nat.mul_pos (by decide : 0<4) (pow_pos (by omega : 0<t) 3)) h1
    have hlog : 0 ≤ log (R:ℝ) := log_nonneg (by exact_mod_cast (by omega : 1 ≤ R))
    have hprod := mul_le_mul_of_nonneg_right (by exact_mod_cast hh : (S.card:ℝ) ≤ 1) hlog
    change log (R:ℝ)<(∑p∈A,log (p:ℝ))-(∑p∈B,log (p:ℝ)) at tau
    change (∑p∈S,log (p:ℝ))+(∑p∈B,log (p:ℝ))=∑p∈A,log (p:ℝ) at hsum
    linarith
  have mem {p : ℕ} (hp : p∈S) : p.Prime ∧ p ≤ R ∧ V<p := by
    obtain ⟨ha,hb⟩:=Finset.mem_sdiff.mp hp
    obtain ⟨hbnd,hp'⟩:=Nat.mem_primesLE.mp ha
    refine ⟨hp',hbnd,?_⟩
    by_contra! h; exact hb (Nat.mem_primesLE.mpr ⟨h,hp'⟩)
  obtain ⟨p,hp,q,hq,hne⟩:=Finset.one_lt_card.mp hcard
  have a:=mem hp;have b:=mem hq
  dsimp [V] at a b
  rcases lt_or_gt_of_ne hne with h|h
  · exact ⟨p,q,a.1,b.1,h,b.2.1,by omega⟩
  · exact ⟨q,p,b.1,a.1,h,a.2.1,by omega⟩


end

open OMA.S_oeis_a237721

theorem count_formula (n : ℕ) : a n =
    ((Finset.range (n+1)).filter (fun p => p.Prime ∧ IsSquare ((n-p).sqrt))).card := by
  unfold a
  rw [← Set.ncard_coe_finset]
  congr 1
  ext p
  simp

theorem quartic_window {n p t : ℕ} (hl : p+t^4 ≤ n) (hu : n ≤ p+t^4+2*t^2) :
    p ≤ n ∧ IsSquare ((n-p).sqrt) := by
  have he : t^2 = (n-p).sqrt := Nat.eq_sqrt'.2 ⟨by
    rw [← pow_mul]
    change t^4 ≤ n-p
    omega, by
    have h : (t^2+1)^2 = t^4+2*t^2+1 := by ring
    omega⟩
  exact ⟨by omega, t, by rw [← he,pow_two]⟩

theorem two_of_windows {n p q t s : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q)
    (lp : p+t^4 ≤ n) (up : n ≤ p+t^4+2*t^2) (lq : q+s^4 ≤ n) (uq : n ≤ q+s^4+2*s^2) :
    2 ≤ a n := by
  rw [count_formula]
  have pp := quartic_window lp up
  have qq := quartic_window lq uq
  have hs : ({p,q} : Finset ℕ) ⊆
      (Finset.range (n+1)).filter (fun v => v.Prime ∧ IsSquare ((n-v).sqrt)) := by
    intro v hv
    simp only [Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl|rfl
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega),hp,pp.2⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega),hq,qq.2⟩
  simpa [hne] using Finset.card_le_card hs

theorem small_exact {n : ℕ} (hn : n < 18) :
    (1 < n → 0 < a n) ∧ (a n = 1 ↔ n ∈ ({2,9,10,11,12,15,16,17} : Finset ℕ)) := by
  rw [count_formula]
  have hall : ∀ k : Fin 18,
      (1 < k.val → 0 < ((Finset.range (k.val+1)).filter
        (fun p => p.Prime ∧ IsSquare ((k.val-p).sqrt))).card) ∧
      (((Finset.range (k.val+1)).filter (fun p => p.Prime ∧ IsSquare ((k.val-p).sqrt))).card = 1 ↔
        k.val ∈ ({2,9,10,11,12,15,16,17} : Finset ℕ)) := by decide +kernel
  exact hall ⟨n,hn⟩

theorem large_from_supply
    (hA : ∀ t R : ℕ, 32768 ≤ t → (t+1)^4-t^4 ≤ R → R < (t+2)^4-t^4 →
        ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p < q ∧ q ≤ R ∧ R ≤ p+2*t^2)
    (hB : ∀ R : ℕ, 131072 ≤ R → R ≤ 281474976972799 →
        ∃ b p q : ℕ, 9*b^3 ≤ R ∧ p.Prime ∧ q.Prime ∧ p < q ∧ q ≤ R ∧ R ≤ p+2*b^2)
    {n : ℕ} (hn : 33^4 ≤ n) : 2 ≤ a n := by
  let j := n.sqrt.sqrt
  have low : j^4 ≤ n := by
    have e : (j^2)^2 = j^4 := by ring
    rw [← e]
    refine (Nat.pow_le_pow_left ?_ 2).trans (Nat.le_sqrt'.mp (le_refl n.sqrt))
    exact Nat.le_sqrt'.mp (le_refl j)
  have high : n < (j+1)^4 := by
    have h1 : n.sqrt < (j+1)^2 := Nat.lt_succ_sqrt' _
    have h2 : n.sqrt+1 ≤ (j+1)^2 := by omega
    have he : ((j+1)^2)^2 = (j+1)^4 := by ring
    exact ((Nat.lt_succ_sqrt' n).trans_le (Nat.pow_le_pow_left h2 2)).trans_eq he
  have h33 : 33 ≤ j := by
    by_contra! hs
    have he := Nat.pow_le_pow_left (show j+1 ≤ 33 by omega) 4
    omega
  let t := j-1
  have h32 : 32 ≤ t := by dsimp [t]; omega
  have ej : j = t+1 := by dsimp [t]; omega
  rw [ej] at low high
  have hhi : n < (t+2)^4 := by exact high
  let R := n-t^4
  have htl : t^4 ≤ n := (Nat.pow_le_pow_left (Nat.le_succ t) 4).trans low
  have hl : (t+1)^4-t^4 ≤ R := Nat.sub_le_sub_right low _
  have hh : R < (t+2)^4-t^4 := by dsimp [R]; omega
  have hw : ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p < q ∧ q ≤ R ∧ R ≤ p+2*t^2 := by
    by_cases ht : 32768 ≤ t
    · exact hA t R ht hl hh
    have e1 : (t+1)^4 - t^4 = 4*t^3+6*t^2+4*t+1 := by
      have he : (t+1)^4 = t^4+(4*t^3+6*t^2+4*t+1) := by ring
      omega
    have e2 : (t+2)^4 - t^4 = 8*t^3+24*t^2+32*t+16 := by
      have he : (t+2)^4 = t^4+(8*t^3+24*t^2+32*t+16) := by ring
      omega
    rw [e1] at hl
    rw [e2] at hh
    have hRL : 131072 ≤ R := by
      have e := Nat.pow_le_pow_left h32 3
      norm_num at e
      omega
    have hRU : R ≤ 281474976972799 := by
      have tmax : t ≤ 32767 := by omega
      have e := Nat.pow_le_pow_left tmax 3
      have f := Nat.pow_le_pow_left tmax 2
      norm_num at e f
      omega
    obtain ⟨b,p,q,hb,hp,hq,hpq,hqR,hRp⟩ := hB R hRL hRU
    have hlt : R < 9*t^3 := by
      obtain ⟨v,hv⟩ := Nat.exists_eq_add_of_le h32
      rw [hv] at hh ⊢
      nlinarith only [hh, Nat.zero_le v, Nat.zero_le (v^2), Nat.zero_le (v^3)]
    have hbt : b ≤ t := by
      by_contra! hc
      have e := Nat.pow_lt_pow_left hc (by decide : 3 ≠ 0)
      omega
    have hbt2 := Nat.pow_le_pow_left hbt 2
    exact ⟨p,q,hp,hq,hpq,hqR,by omega⟩
  obtain ⟨p,q,hp,hq,hpq,hqR,hRp⟩ := hw
  have eR : R+t^4 = n := Nat.sub_add_cancel htl
  exact two_of_windows (t := t) (s := t) hp hq hpq.ne (by omega) (by omega) (by omega) (by omega)

