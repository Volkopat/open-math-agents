lemma digit_at_mem (j n : ℕ) (h : 10^j ≤ n) :
    n / 10^j % 10 ∈ Nat.digits 10 n := by
  induction j generalizing n with
  | zero =>
    have hn : 0 < n := by simp only [pow_zero] at h; omega
    rw [Nat.digits_def' (by decide) hn]
    simp
  | succ j ih =>
    have hn : 0 < n := lt_of_lt_of_le (by positivity) h
    rw [Nat.digits_def' (by decide) hn]
    apply List.mem_cons_of_mem
    have div : 10^j ≤ n / 10 := (Nat.le_div_iff_mul_le (by decide)).2 (by simpa [pow_succ] using h)
    simpa [Nat.div_div_eq_div_mul, pow_succ, Nat.mul_comm 10] using ih (n/10) div

lemma suffix_digit (n j e : ℕ) :
    ((n % (10^j * 10))^e / 10^j) % 10 = n^e / 10^j % 10 := by
  have congr := (Nat.mod_modEq n (10^j * 10)).pow e
  simpa only [Nat.mod_mul_right_div_self] using congrArg (fun v : ℕ => v / 10^j) congr


lemma digits_after (n j : ℕ) : (Nat.digits 10 (n / 10^j)).Sublist (Nat.digits 10 n) := by
  induction j generalizing n with
  | zero => simp
  | succ j ih =>
    rw [pow_succ, Nat.mul_comm, ← Nat.div_div_eq_div_mul]
    apply (ih (n/10)).trans
    by_cases h : n = 0
    · simp [h]
    · conv_rhs => rw [Nat.digits_def' (by decide) (Nat.pos_of_ne_zero h)]
      exact List.Sublist.cons _ (List.Sublist.refl _)

lemma all_halves {α : Type} (i : ℕ) {l : List α} {pred : α → Bool}
    (h₁ : (l.take i).all pred = true) (h₂ : (l.drop i).all pred = true) :
    l.all pred = true := by
  calc
    l.all pred = (l.take i ++ l.drop i).all pred := congrArg (List.all · pred) (List.take_append_drop i l).symm
    _ = true := by rw [List.all_append, h₁, h₂]; rfl

lemma bounded_digits {digits : ℕ → ℕ → List ℕ} (zero : ∀ n, digits 0 n = [])
    (step : ∀ f n, digits (f+1) n = if n = 0 then [] else n % 10 :: digits f (n/10))
    (f n : ℕ) : (digits f n).Sublist (Nat.digits 10 n) ∧
      (n < 10^f → digits f n = Nat.digits 10 n) := by
  induction f generalizing n with
  | zero =>
    rw [zero]
    exact ⟨List.nil_sublist _, fun h => by simp [show n = 0 by simpa using h]⟩
  | succ f ih =>
    rw [step]
    by_cases hn : n = 0
    · simp [hn]
    · rw [if_neg hn, Nat.digits_def' (by decide) (Nat.pos_of_ne_zero hn)]
      obtain ⟨sub, eq⟩ := ih (n/10)
      refine ⟨sub.cons_cons _, fun h => ?_⟩
      rw [eq ((Nat.div_lt_iff_lt_mul (by decide)).2 (by simpa [pow_succ] using h))]

