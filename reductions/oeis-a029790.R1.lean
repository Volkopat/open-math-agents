    (fun _ next n => if n = 0 then [] else n % 10 :: next (n/10))
  have digitSpec := bounded_digits (digits := digits) (fun _ => rfl) (fun _ _ => rfl)
  let hit (D : List ℕ) := Nat.rec (motive := fun _ => ℕ → Bool)
