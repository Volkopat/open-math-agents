/-- Sharpened open cycle core: no periodic point `n >= 350000` in the 367 surviving mod-8192
classes with `k >= 4229`, `o >= 1636`, `e >= 2593`, `1054 * o < 665 * e`, `971 * e < 1539 * o`,
`3 ^ o < 2 ^ e`, and `2 ^ e * n ^ o <= (3 * n + 1) ^ o` is the minimum of its cycle. -/
def H3 : Prop :=
  ∀ n k : ℕ,
    350000 ≤ n →
    n % 1024 ∈ ([27, 31, 47, 63, 71, 91, 103, 111, 127, 155, 159, 167, 191, 207, 223, 231, 239, 251, 255, 283, 303, 319, 327, 359, 383, 411, 415, 447, 463, 479, 487, 495, 511, 539, 543, 559, 603, 615, 623, 639, 667, 671, 679, 703, 719, 743, 751, 763, 767, 795, 799, 831, 839, 859, 871, 879, 895, 927, 935, 959, 991, 1007, 1019, 1023] : List ℕ) →
    n % 8192 ∉ ([191, 207, 231, 255, 303, 383, 463, 539, 543, 615, 623, 679, 719, 799, 879, 935, 1019, 1071, 1087, 1135, 1191, 1215, 1231, 1247, 1327, 1435, 1563, 1567, 1647, 1703, 1727, 1787, 1823, 1855, 1983, 2015, 2031, 2075, 2079, 2095, 2203, 2239, 2271, 2331, 2351, 2431, 2587, 2591, 2607, 2663, 2907, 2975, 3039, 3067, 3119, 3135, 3143, 3295, 3455, 3483, 3551, 3559, 3675, 3687, 3835, 3903, 3911, 3967, 4063, 4079, 4091, 4159, 4199, 4223, 4251, 4327, 4455, 4479, 4507, 4559, 4711, 4859, 4927, 4955, 4975, 5023, 5031, 5103, 5115, 5183, 5191, 5275, 5327, 5371, 5439, 5531, 5607, 5615, 5723, 5743, 5787, 5799, 5871, 5883, 5919, 5951, 5959, 5979, 6047, 6127, 6215, 6299, 6335, 6375, 6447, 6559, 6607, 6631, 6683, 6687, 6747, 6815, 6983, 7003, 7023, 7071, 7079, 7215, 7239, 7259, 7375, 7391, 7399, 7495, 7631, 7655, 7771, 7791, 7847, 7911, 7967, 8007, 8047, 8103, 8159] : List ℕ) →
    4229 ≤ k →
    collatzStep^[k] n = n →
    let e := ((Finset.range k).filter (fun i => collatzStep^[i] n % 2 = 0)).card
    let o := ((Finset.range k).filter (fun i => collatzStep^[i] n % 2 = 1)).card
    1636 ≤ o →
    2593 ≤ e →
    1054 * o < 665 * e →
    971 * e < 1539 * o →
    3 ^ o < 2 ^ e →
    2 ^ e * n ^ o ≤ (3 * n + 1) ^ o →
    ∃ i : ℕ, collatzStep^[i] n < n

lemma upper_conv_350k :
    3 * 350000 * 3 ^ 971 < (3 * 350000 - 971) * 2 ^ 1539 := by decide +kernel

lemma upper_cutoff_pow_350k :
    (3 * 350000 + 1) ^ 971 < 2 ^ 1539 * 350000 ^ 971 := by
  have hb := bernoulli_pow_bound (3 * 350000) 971 (by omega)
  have hpow : (3 * 350000) ^ (971 + 1) =
      (3 * 350000 * 3 ^ 971) * 350000 ^ 971 := by
    rw [pow_succ', mul_pow]
    simp only [mul_assoc]
  rw [hpow] at hb
  have hlt : (3 * 350000 - 971) * (3 * 350000 + 1) ^ 971 <
      (3 * 350000 - 971) * (2 ^ 1539 * 350000 ^ 971) := by
    calc (3 * 350000 - 971) * (3 * 350000 + 1) ^ 971
        ≤ (3 * 350000 * 3 ^ 971) * 350000 ^ 971 := hb
      _ < ((3 * 350000 - 971) * 2 ^ 1539) * 350000 ^ 971 :=
          Nat.mul_lt_mul_of_pos_right upper_conv_350k (pow_pos (by omega) 971)
      _ = (3 * 350000 - 971) * (2 ^ 1539 * 350000 ^ 971) := by rw [mul_assoc]
  exact Nat.lt_of_mul_lt_mul_left hlt

theorem main : H1 → H2 → H3 → OMA.R_CollatzConjecture_collatz_conjecture_R1_H2_R1_H3_R2_H3_R1.H3 := by
  intro h1 h2 h3 n k hn h1024 _ hper e o ho971 _ hlow _ h32 hbound
  by_cases h8192 : n % 8192 ∈ ([191, 207, 231, 255, 303, 383, 463, 539, 543, 615, 623, 679, 719, 799, 879, 935, 1019, 1071, 1087, 1135, 1191, 1215, 1231, 1247, 1327, 1435, 1563, 1567, 1647, 1703, 1727, 1787, 1823, 1855, 1983, 2015, 2031, 2075, 2079, 2095, 2203, 2239, 2271, 2331, 2351, 2431, 2587, 2591, 2607, 2663, 2907, 2975, 3039, 3067, 3119, 3135, 3143, 3295, 3455, 3483, 3551, 3559, 3675, 3687, 3835, 3903, 3911, 3967, 4063, 4079, 4091, 4159, 4199, 4223, 4251, 4327, 4455, 4479, 4507, 4559, 4711, 4859, 4927, 4955, 4975, 5023, 5031, 5103, 5115, 5183, 5191, 5275, 5327, 5371, 5439, 5531, 5607, 5615, 5723, 5743, 5787, 5799, 5871, 5883, 5919, 5951, 5959, 5979, 6047, 6127, 6215, 6299, 6335, 6375, 6447, 6559, 6607, 6631, 6683, 6687, 6747, 6815, 6983, 7003, 7023, 7071, 7079, 7215, 7239, 7259, 7375, 7391, 7399, 7495, 7631, 7655, 7771, 7791, 7847, 7911, 7967, 8007, 8047, 8103, 8159] : List ℕ)
  · exact h1 n hn h8192
  · by_cases hlt : n < 350000
    · exact h2 n hn hlt h1024 h8192
    · have hn35 : 350000 ≤ n := by omega
      have ho_pos : 0 < o := by omega
      have h35 : 2 ^ e * 350000 ^ o ≤ (3 * 350000 + 1) ^ o :=
        ratio_mono hn35 (by omega) hbound
      have hhigh : 971 * e < 1539 * o := by
        have h1' : (2 ^ e * 350000 ^ o) ^ 971 ≤ ((3 * 350000 + 1) ^ o) ^ 971 :=
          Nat.pow_le_pow_left h35 971
        have h2' : ((3 * 350000 + 1) ^ 971) ^ o < (2 ^ 1539 * 350000 ^ 971) ^ o :=
          Nat.pow_lt_pow_left upper_cutoff_pow_350k (Nat.ne_of_gt ho_pos)
        have h3' : 2 ^ (971 * e) * 350000 ^ (971 * o) <
            2 ^ (1539 * o) * 350000 ^ (971 * o) := by
          calc 2 ^ (971 * e) * 350000 ^ (971 * o)
              = (2 ^ e * 350000 ^ o) ^ 971 := by
                rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm e 971, mul_comm o 971]
            _ ≤ ((3 * 350000 + 1) ^ o) ^ 971 := h1'
            _ = ((3 * 350000 + 1) ^ 971) ^ o := by
                rw [← pow_mul, ← pow_mul, mul_comm o 971]
            _ < (2 ^ 1539 * 350000 ^ 971) ^ o := h2'
            _ = 2 ^ (1539 * o) * 350000 ^ (971 * o) := by
                rw [mul_pow, ← pow_mul, ← pow_mul]
        have h4' : 2 ^ (971 * e) < 2 ^ (1539 * o) := Nat.lt_of_mul_lt_mul_right h3'
        exact (Nat.pow_lt_pow_iff_right (by omega : 1 < 2)).mp h4'
      have hsum : e + o = k := filter_even_add_odd n k
      have ho_ge : 1636 ≤ o := by omega
      have he_ge : 2593 ≤ e := by omega
      have hk_ge : 4229 ≤ k := by omega
      exact h3 n k hn35 h1024 h8192 hk_ge hper ho_ge he_ge hlow hhigh h32 hbound

