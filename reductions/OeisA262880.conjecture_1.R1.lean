import FormalConjectures.OEIS.«262880»

/-!
A triangular number and three weighted cubes. Completing the triangular
square gives a dilation on 8n+1 by odd sixth powers. The transport step
also allows a zero triangular index at the source, since dilation by
a nontrivial odd factor makes the new index positive. Direct certificates
cover n up to 128 for the eighteen coefficient pairs. Only larger inputs
with sixth-power-free 8n+1 remain.
-/

namespace OMA.R_OeisA262880_conjecture_1_R1

def H1 : Prop := ∀ b c n r d w x y z : ℕ,
    2 ≤ d → Odd d → 8*n+1 = d^6*(8*r+1) →
    r = Nat.triangular w + x^3 + b*y^3 + c*z^3 →
    ∃ W X Y Z : ℕ, 0 < W ∧ n = Nat.triangular W + X^3 + b*Y^3 + c*Z^3

def H2 : Prop := ∀ p ∈ OeisA262880.pairs1, ∀ n : ℕ, 128 < n →
    (∀ d : ℕ, 2 ≤ d → ¬d^6 ∣ 8*n+1) →
    ∃ w x y z : ℕ, 0 < w ∧ n = Nat.triangular w + x^3 + p.1*y^3 + p.2*z^3

section

private theorem cofactor_shape (n d k : ℕ) (he : 8*n+1 = d^6*k) :
    Odd d ∧ k = 8*(k/8)+1 := by
  have hm := congrArg (fun a : ℕ => a%8) he
  have hdlt := Nat.mod_lt d (by decide : 0<8)
  simp only [Nat.add_mod, Nat.mul_mod, Nat.pow_mod d, Nat.mod_self, zero_mul,
    Nat.zero_mod, zero_add, Nat.one_mod, Nat.mod_mod] at hm
  generalize ha : d%8 = a at hm hdlt
  have hcases : a=1 ∨ a=3 ∨ a=5 ∨ a=7 := by
    interval_cases a <;> first | decide | norm_num at hm
  have hod : Odd d := by
    rw [Nat.odd_iff]
    omega
  refine ⟨hod,?_⟩
  rcases hcases with rfl|rfl|rfl|rfl <;> norm_num at hm <;> omega

private theorem cofactor_lt (n d k : ℕ) (hd : 2 ≤ d) (he : 8*n+1 = d^6*k) :
    k/8 < n := by
  have hpow := Nat.pow_le_pow_left hd 6
  have hk : 0 < k := by
    by_contra! h
    simp [Nat.eq_zero_of_le_zero h] at he
  have hbound := Nat.mul_le_mul_right k hpow
  omega

private theorem initial (p : ℕ × ℕ) (hp : p ∈ OeisA262880.pairs1)
    (n : ℕ) (hn : 0 < n) (hb : n ≤ 128) :
    ∃ w x y z : ℕ, 0 < w ∧ n = Nat.triangular w + x^3 + p.1*y^3 + p.2*z^3 := by
  let table : ℕ × ℕ → ℕ
    | (1,2) => 
    | (1,3) => 
    | (1,4) => 
    | (1,6) => 
    | (2,2) => 
    | (2,3) => 
    | (2,4) => 
    | (2,5) => 
    | (2,6) => 
    | (2,7) => 
    | (2,20) => 
    | (2,21) => 
    | (2,34) => 
    | (3,3) => 
    | (3,4) => 
    | (3,5) => 
    | (3,6) => 
    | (4,10) => 
    | _ => 0
  let entry := fun (bc : ℕ × ℕ) (i : Fin 128) => table bc >>> (16*i.val)
  let valid := fun (bc : ℕ × ℕ) (i : Fin 128) =>
    let e := entry bc i
    0 < e%32 ∧ i.val+1 = Nat.triangular (e%32) + (e/32%8)^3 +
      bc.1*(e/256%8)^3 + bc.2*(e/2048%8)^3
  have covered : ∀ bc ∈ OeisA262880.pairs1, ∀ i, valid bc i := by decide +kernel
  let i : Fin 128 := ⟨n-1,by omega⟩
  let e := entry p i
  obtain ⟨hw,he⟩ := covered p hp i
  exact ⟨e%32,e/32%8,e/256%8,e/2048%8,hw,by simpa [i,Nat.sub_add_cancel hn] using he⟩

end

theorem main : H1 → H2 → type_of% @OeisA262880.conjecture_1 := by
  intro lift core p hp n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    by_cases hs : n ≤ 128
    · exact initial p hp n hn hs
    by_cases prim : ∀ d : ℕ, 2 ≤ d → ¬ d^6 ∣ 8*n+1
    · exact core p hp n (by omega) prim
    push Not at prim
    obtain ⟨d,hd,k,he⟩ := prim
    obtain ⟨ho,hk⟩ := cofactor_shape n d k he
    have he' : 8*n+1 = d^6*(8*(k/8)+1) := by simpa only [← hk] using he
    by_cases hz : k/8 = 0
    · exact lift p.1 p.2 n (k/8) d 0 0 0 0 hd ho he' (by simp [hz])
    obtain ⟨w,x,y,z,_,hr⟩ := ih (k/8) (cofactor_lt n d k hd he) (by omega)
    exact lift p.1 p.2 n (k/8) d w x y z hd ho he' hr

end OMA.R_OeisA262880_conjecture_1_R1
