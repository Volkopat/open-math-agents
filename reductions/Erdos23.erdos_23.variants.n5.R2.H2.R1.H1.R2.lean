/- A split code above 299 stores a coordinate and its dividing value. Leaves
   below 256 select a cut mask, 256 through 273 select a labelled size
   vector, and 299 certifies an impossible total mass. -/
private lemma search_boxes (x : Fin 9 → ℕ) (P : Prop)
    (leaf : ℕ → (Fin 9 → ℕ) → (Fin 9 → ℕ) → Bool)
    (valid : ∀ s lo hi, (∀ i,lo i ≤ x i) → (∀ i,x i ≤ hi i) → leaf s lo hi=true → P) :
    let run (t : BinaryTree ℕ) := BinaryTree.rec (motive:=fun _ => (Fin 9 → ℕ) → (Fin 9 → ℕ) → Bool)
      (fun _ _ => false) (fun s _ _ l r lo hi =>
        if s<300 then leaf s lo hi else
          l lo (Function.update hi (Fin.ofNat 9 ((s-300)%9)) ((s-300)/9)) &&
          r (Function.update lo (Fin.ofNat 9 ((s-300)%9)) ((s-300)/9+1)) hi) t
    ∀ t lo hi, (∀ i,lo i ≤ x i) → (∀ i,x i ≤ hi i) → run t lo hi=true → P := by
  intro run t
  induction t with
  | nil => simp [run]
  | node s l r hl hr =>
    intro lo hi low high h
    by_cases tip : s<300
    · exact valid s lo hi low high (by simpa only [run,BinaryTree.rec,tip,if_true] using h)
    let k := Fin.ofNat 9 ((s-300)%9)
    change (if s<300 then _ else _ && _)=true at h
    rw [if_neg tip,Bool.and_eq_true] at h
    by_cases side : x k ≤ (s-300)/9
    · apply hl lo _ low _ h.1
      intro i
      by_cases eq : i=k
      · subst i; simpa [k] using side
      · rw [Function.update_of_ne eq]; exact high i
    · apply hr _ hi _ high h.2
      intro i
      by_cases eq : i=k
      · subst i; simpa [k] using (show (s-300)/9+1 ≤ x k by omega)
      · rw [Function.update_of_ne eq]; exact low i

private lemma tighten (x lo hi : Fin 9 → ℕ) (mass : ∑ i,x i=22)
    (low : ∀ i,lo i≤x i) (high : ∀ i,x i≤hi i) (i : Fin 9) :
    max (lo i) (22+hi i-(∑ j,hi j)) ≤ x i ∧
    x i ≤ min (hi i) (22+lo i-(∑ j,lo j)) := by
  have sl := sum_erase_add univ lo (mem_univ i)
  have sh := sum_erase_add univ hi (mem_univ i)
  have sx := sum_erase_add univ x (mem_univ i)
  have al := sum_le_sum (s:=univ.erase i) (fun j _ => low j)
  have au := sum_le_sum (s:=univ.erase i) (fun j _ => high j)
  exact ⟨max_le (low i) (by omega),le_min (high i) (by omega)⟩

