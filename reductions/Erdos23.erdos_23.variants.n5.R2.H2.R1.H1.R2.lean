/-- Every surviving graph is triangle-free, and adding any missing edge
between distinct vertices creates a triangle. -/
lemma four_maximal :
  let rows : Fin 4 → ℕ := ![0x941d3a2a00e0701c5285282941a0e341c341c0521fd23f0290fca47e00,
    0x941d3a2a00e0701c5285282941a0e341c341c0521fd23f0250fca47e00,
    0x941d3a2a00e0701c5285282941a0e341c341c0521fd23f0250fca87e00,
    0x941d3a2a00e0701c5285282941a0e341c341c0521fd43f0290fca87e00]
  let bit (word : ℕ) (i j : Fin 22) :=
    let hi := max i.val j.val
    let pos := hi*(hi-1)/2+min i.val j.val
    decide (i≠j) && word.testBit (233-pos)
  ∀ k : Fin 4,∃ B : SimpleGraph (Fin 22),
    (∀ i j,B.Adj i j ↔ bit (rows k) i j=true) ∧
    Maximal (fun T : SimpleGraph (Fin 22) => T.CliqueFree 3) B := by
  intro rows bit
  have sym : ∀ k i j,bit (rows k) i j=bit (rows k) j i := by decide +kernel
  have diag : ∀ k i,bit (rows k) i i=false := by decide +kernel
  have triangles : ∀ k i j v,bit (rows k) i j=true → bit (rows k) i v=true →
      bit (rows k) j v=false := by decide +kernel
  have saturated : ∀ k i j,i≠j → bit (rows k) i j=false →
      ∃ v,bit (rows k) i v=true ∧ bit (rows k) j v=true := by decide +kernel
  intro k
  let B : SimpleGraph (Fin 22) := {
    Adj := fun i j => bit (rows k) i j=true
    symm := ⟨fun i j h => (sym k i j).symm.trans h⟩
    loopless := ⟨fun i h => Bool.noConfusion ((diag k i).symm.trans h)⟩ }
  refine ⟨B,fun _ _ => Iff.rfl,?_,?_⟩
  · rintro s h
    obtain ⟨a,b,c,ab,ac,bc,_⟩ := is3Clique_iff.mp h
    exact Bool.noConfusion ((triangles k _ _ _ ab ac).symm.trans bc)
  · intro T cf sub i j adj
    by_contra absent
    change ¬bit (rows k) i j=true at absent
    obtain ⟨v,iv,jv⟩ := saturated k i j adj.ne (by simpa using absent)
    exact cf _ (is3Clique_triple_iff.mpr ⟨adj,sub (show B.Adj i v from iv),sub (show B.Adj j v from jv)⟩)

private lemma twice_loss {n : ℕ} (G : SimpleGraph (Fin n)) (c : Fin n → Bool) :
    (∑ i,∑ j,if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) =
    2*(∑ i,∑ j,if i<j ∧ G.Adj i j ∧ c i=c j then (1:ℕ) else 0) := by
  let h (i j : Fin n) := if i<j ∧ G.Adj i j ∧ c i=c j then (1:ℕ) else 0
  have split (i j) : (if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) = h i j+h j i := by
    rcases lt_trichotomy i j with l|rfl|l
    · simp [h,l,not_lt_of_gt l]
    · simp [h]
    · simp [h,l,not_lt_of_gt l,G.adj_comm i j,eq_comm (a:=c i) (b:=c j)]
  calc
    _ = ∑ i, ∑ j, (h i j+h j i) := sum_congr rfl fun i _ => sum_congr rfl fun j _ => split i j
    _ = _ := by
      simp only [sum_add_distrib]
      rw [sum_comm (f:=fun i j => h j i)]
      change _ + _ = 2*(∑ i,∑ j,h i j)
      omega

/-- Every graph mapping onto the nine classes on a 22-vertex set admits
a 17-edge cut; no maximality is needed for this upper bound. -/
lemma nine_class_cut {V : Type*} [DecidableEq V] (W : Finset V) (G : SimpleGraph V)
    (card : W.card=22) (f : V → Fin 9) :
  let edges : Finset (Fin 9 × Fin 9) := {(2,1),(3,2),(4,1),(5,3),(5,4),(6,0),(6,2),(6,5),(7,0),(7,1),(7,3),(8,0),(8,2),(8,4)}
  (∀ a,∃ i∈W,f i=a) →
  (∀ i∈W,∀ j∈W,G.Adj i j → (f i,f j)∈edges ∨ (f j,f i)∈edges) →
  ∃ c : V → Bool,(∑ i∈W,∑ j∈W,if G.Adj i j ∧ c i=c j then (1:ℕ) else 0) ≤ 34 := by
  intro edges onto hom
  let cost (x : Fin 9 → ℕ) (mask : ℕ) := ∑ e ∈ edges,
    if mask.testBit e.1.val=mask.testBit e.2.val then x e.1*x e.2 else 0
  let sizes : Fin 18 → ℕ := ![0x143111434,0x341113414,0x311443411,0x113441431,0x143112424,0x341112424,0x211443421,0x112442431,0x213441421,0x312442411,0x242111434,0x242113414,0x242112424,0x212442421,0x341111434,0x143113414,0x313441411,0x111443431]
  let shape (r : Fin 18) (i : Fin 9) := ((sizes r) >>> (4*i.val))%16
  let x (a : Fin 9) := (W.filter (fun i => f i=a)).card
  have pos (a) : 1 ≤ x a := by
    obtain ⟨i,hi,ha⟩ := onto a
    exact card_pos.mpr ⟨i,mem_filter.mpr ⟨hi,ha⟩⟩
  have mass : ∑ a,x a=22 := (fiber_mass W f).trans card
  let masks : Fin 18 → ℕ := ![39,29,29,39,39,29,91,149,39,29,53,53,53,149,29,39,29,91]
  have short : ∀ r : Fin 18,cost (shape r) (masks r) ≤ 17 := by decide +kernel
  obtain ⟨m,hm⟩ : ∃ m : ℕ,cost x m ≤ 17 := by
    rcases classify_sizes x pos mass with ⟨m,hm⟩|⟨r,hr⟩
    · exact ⟨m,hm.trans (by decide : 16≤17)⟩
    · refine ⟨masks r,?_⟩
      rw [show x=shape r from funext hr]; exact short r
  have hit := fiber_cut W G f edges hom m
  change _ ≤ 2*cost x m at hit
  exact ⟨fun i => m.testBit (f i).val,hit.trans (by omega : 2*cost x m ≤ 34)⟩
