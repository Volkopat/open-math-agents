/-! # One quotient in the order-22 bipartization catalogue

Entries 198 to 201 of Brendan McKay's minbip22_17.g6, numbered from one,
have the same nine-vertex quotient by equality of open neighborhoods.
This file proves completeness for all positive blow-ups of that quotient.
The 18 labelled surviving multiplicities map to four raw graph6 payloads.
Integer-weighted pentagons certify the four lower bounds.
The low-degree extension and maximal completion are adapted from PR #20487.
Source: https://users.cecs.anu.edu.au/~bdm/data/graphs.html -/
namespace OMA.R_Erdos23_erdos_23_variants_n5_R2_H2_R1_H1_R2
open Finset SimpleGraph
open scoped Classical
def H1 : Prop :=
  ∀ (G : SimpleGraph (Fin 25)), G.CliqueFree 3 → ∀ W : Finset (Fin 25),
    W.card = 21 → ∃ c : Fin 25 → Bool,
      (∑ i ∈ W, ∑ j ∈ W, if G.Adj i j ∧ c i = c j then 1 else 0) ≤ (32 : ℕ)

def H2 : Prop :=
  let edges : Finset (Fin 9 × Fin 9) := {(2,1),(3,2),(4,1),(5,3),(5,4),(6,0),(6,2),(6,5),(7,0),(7,1),(7,3),(8,0),(8,2),(8,4)}
  ∀ (W : Finset (Fin 25)), W.card = 22 → ∀ K : SimpleGraph (Fin 25),
    K.CliqueFree 3 → (∀ i j, K.Adj i j → i ∈ W ∧ j ∈ W) →
    (∀ H : SimpleGraph (Fin 25), K ≤ H → H.CliqueFree 3 →
      (∀ i j, H.Adj i j → i ∈ W ∧ j ∈ W) → H = K) →
    (∀ i ∈ W, 4 ≤ (W.filter (K.Adj i)).card) →
    (¬ ∃ f : Fin 25 → Fin 9, (∀ a,∃ i∈W,f i=a) ∧
      ∀ i∈W,∀ j∈W,K.Adj i j → (f i,f j)∈edges ∨ (f j,f i)∈edges) →
    ∃ c : Fin 25 → Bool,
      (∑ i ∈ W, ∑ j ∈ W, if K.Adj i j ∧ c i = c j then 1 else 0) ≤ (34 : ℕ)

