/-! Restrictions on the prime-square branch of Erdős problem 889. -/

/- A sparse sieve using the smallest prime missing from a possible exceptional integer. -/

namespace Erdos889.MissingPrimeSieve

open OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2

private def products : List ℕ → ℕ → List ℕ
  | [], _ => [1]
  | p::ps, B => (List.range (p.log B + 1)).flatMap fun j =>
      (products ps (B / p^j)).map (fun m => p^j*m)

private theorem products_complete {bs : List ℕ} {B m : ℕ}
    (prime : ∀ q ∈ bs, q.Prime) (pos : 0 < m) (bound : m≤B)
    (smooth : ∀ q : ℕ, q.Prime → q∣m → q∈bs) : m ∈ products bs B := by
  induction bs generalizing m B with
  | nil =>
    have one : m=1 := by
      by_contra ne
      obtain ⟨q,pq,dq⟩ := Nat.exists_prime_and_dvd ne
      simpa using smooth q pq dq
    simp [products,one]
  | cons p ps ih =>
    have pp := prime p (by simp)
    let e := m.factorization p
    let y := m / p^e
    have fact : p^e*y=m := Nat.ordProj_mul_ordCompl_eq_self m p
    have yp : 0 < y := Nat.ordCompl_pos p pos.ne'
    have ep : 0 < p^e := pow_pos pp.pos _
    have cp : p^e≤B := (Nat.le_of_dvd pos (fact ▸ dvd_mul_right (p^e) y)).trans bound
    have ye : y≤B/p^e := (Nat.le_div_iff_mul_le ep).mpr (by rwa [Nat.mul_comm,fact])
    have fresh : ∀ q : ℕ, q.Prime → q∣y → q∈ps := by
      intro q pq dq
      have mem := smooth q pq (dq.trans (Nat.ordCompl_dvd m p))
      rcases List.mem_cons.mp mem with rfl|rest
      · exact (Nat.not_dvd_ordCompl pp pos.ne' dq).elim
      · exact rest
    simp only [products,List.mem_flatMap,List.mem_range,List.mem_map]
    exact ⟨e,Nat.lt_succ_of_le (Nat.le_log_of_pow_le pp.one_lt cp),y,
      ih (fun q hq => prime q (List.mem_cons_of_mem _ hq)) yp ye fresh,fact⟩

private def bases (p k : ℕ) : List ℕ :=
  p :: (List.range (k+1)).filter (fun q => decide (q.Prime ∧ q∣k))

private theorem bases_prime {p k q : ℕ} (pp : p.Prime) (mem : q∈bases p k) : q.Prime := by
  simp only [bases,List.mem_cons,List.mem_filter,decide_eq_true_eq] at mem
  rcases mem with rfl|⟨_,pq,_⟩
  · exact pp
  · exact pq

private theorem witness_test {n u v : ℕ}
    (h : (let k := u-n%u
      decide (u.Prime ∧ v.Prime ∧ u < v ∧ 0 < k ∧ k < u ∧ u∣n+k ∧ v∣n+k)) = true) :
    v_l 1 n ≠ 1 := by
  dsimp only at h
  obtain ⟨pu,pv,lt,kp,ku,du,dv⟩ := of_decide_eq_true h
  exact two_primes kp pu pv lt.ne ku (ku.trans lt) du dv

private def checkRows : List ℕ → List (ℕ×ℕ) → Bool
  | [], [] => true
  | n::ns, (u,v)::rows =>
    (let k := u-n%u
     decide (u.Prime ∧ v.Prime ∧ u < v ∧ 0 < k ∧ k < u ∧ u∣n+k ∧ v∣n+k)) && checkRows ns rows
  | _, _ => false

private theorem matches_sound {ns : List ℕ} {rows : List (ℕ×ℕ)} (h : checkRows ns rows=true)
    {n : ℕ} (mem : n∈ns) : v_l 1 n≠1 := by
  induction ns generalizing rows with
  | nil => simp at mem
  | cons x xs ih =>
    cases rows with
    | nil => simp [checkRows] at h
    | cons r rs =>
      obtain ⟨u,v⟩ := r
      simp only [checkRows,Bool.and_eq_true] at h
      rcases List.mem_cons.mp mem with rfl|tail
      · exact witness_test h.1
      · exact ih h.2 tail

private def candidates (B M p k : ℕ) : List ℕ :=
  ((products (bases p k) (B+k)).map (fun x => x-k)).filter
      (fun n => decide (330 < n ∧ n≤B ∧ M∣n ∧ p∣n+k))

private theorem candidate_complete {B M p k n : ℕ} (pp : p.Prime) (kp : 0 < k)
    (lo : 330 < n) (hi : n≤B) (dm : M∣n) (dp : p∣n+k)
    (smooth : ∀ q : ℕ, q.Prime → q∣n+k → q=p ∨ q∣k) : n∈candidates B M p k := by
  simp only [candidates,List.mem_filter,List.mem_map,decide_eq_true_eq]
  refine ⟨⟨n+k,products_complete (fun _ => bases_prime pp) (by omega) (by omega) ?_,by omega⟩,
    lo,hi,dm,dp⟩
  intro q pq dq
  simp only [bases,List.mem_cons,List.mem_filter,List.mem_range,decide_eq_true_eq]
  rcases smooth q pq dq with eq|dk
  · exact Or.inl eq
  · exact Or.inr ⟨Nat.lt_succ_of_le (Nat.le_of_dvd kp dk),pq,dk⟩

private theorem prime_step {B M p n : ℕ} (pp : p.Prime) (cop : M.Coprime p)
    (small : ∀ q∈List.range p, q.Prime → q∣M)
    (rows : ∀ k : ℕ, 0 < k → k < p → ∀ n∈candidates B M p k, v_l 1 n≠1)
    (lo : 330 < n) (hi : n≤B) (sol : v_l 1 n=1) (dm : M∣n) : M*p∣n := by
  apply cop.mul_dvd_of_dvd_of_dvd dm
  by_contra miss
  let k := p-n%p
  have nz : n%p≠0 := fun h => miss (Nat.dvd_of_mod_eq_zero h)
  have rem := Nat.mod_lt n pp.pos
  have kp : 0 < k := by dsimp only [k]; omega
  have kl : k < p := by dsimp only [k]; omega
  have dp : p∣n+k := by
    apply Nat.dvd_of_mod_eq_zero
    rw [Nat.add_mod, Nat.mod_eq_of_lt kl]
    have e : n%p+k=p := by dsimp only [k]; omega
    rw [e,Nat.mod_self]
  apply rows k kp kl n (candidate_complete pp kp lo hi dm dp ?_) sol
  intro q pq dq
  by_cases same : q=p
  · exact Or.inl same
  by_cases low : q≤k
  · have dn := (small q (List.mem_range.mpr (by omega)) pq).trans dm
    exact Or.inr ((Nat.dvd_add_iff_right dn).mpr dq)
  · exact (two_primes kp pp pq (Ne.symm same) kl (by omega) dp dq sol).elim



private def powerBucket (B M p k j : ℕ) : List ℕ :=
  ((products ((bases p k).tail) ((B+k)/p^j)).map (fun z => p^j*z-k)).filter
    (fun n => decide (330<n ∧ n≤B ∧ M∣n ∧ p∣n+k))

private theorem candidate_bucket {B M p k n : ℕ} (mem : n∈candidates B M p k) :
    ∃ j ∈ List.range (p.log (B+k)+1), n∈powerBucket B M p k j := by
  simp only [candidates,List.mem_filter,List.mem_map] at mem
  obtain ⟨⟨y,hy,ey⟩,hn⟩ := mem
  simp only [bases,products,List.mem_flatMap,List.mem_map] at hy
  obtain ⟨j,hj,z,hz,ez⟩ := hy
  refine ⟨j,hj,?_⟩
  simp only [powerBucket,bases,List.tail_cons,List.mem_filter,List.mem_map]
  exact ⟨⟨z,hz,by simpa only [ez] using ey⟩,hn⟩

private theorem empty_bucket {ns : List ℕ} {n : ℕ} (h : checkRows ns [] = true)
    (mem : n∈ns) : False := by
  cases ns with
  | nil => simp at mem
  | cons _ _ => simp [checkRows] at h

