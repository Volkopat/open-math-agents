theorem no_new_solutions {n : ℕ} (lo : 330<n) (hi : n≤1000000000000000000) : v_l 1 n≠1 := by
  intro sol
  have d1 : 1∣n := one_dvd _
  have d2 := step_2 lo hi sol d1
  have d6 := step_3 lo hi sol d2
  have d30 := step_5 lo hi sol d6
  have d210 := step_7 lo hi sol d30
  have d2310 := step_11 lo hi sol d210
  have d30030 := step_13 lo hi sol d2310
  have d510510 := step_17 lo hi sol d30030
  have d9699690 := step_19 lo hi sol d510510
  have d223092870 := step_23 lo hi sol d9699690
  have d6469693230 := step_29 lo hi sol d223092870
  have d200560490130 := step_31 lo hi sol d6469693230
  have d7420738134810 := step_37 lo hi sol d200560490130
  have d304250263527210 := step_41 lo hi sol d7420738134810
  obtain ⟨j,hj⟩ := d304250263527210
  have bound : j≤1000000000000000000/304250263527210 := (Nat.le_div_iff_mul_le (by decide)).mpr (by rwa [Nat.mul_comm,←hj])
  have equal : j*304250263527210=n := by simpa only [Nat.mul_comm j] using hj.symm
  rw [←equal] at lo sol
  exact terminal_progression bound lo sol

theorem solutions_through_bound {n : ℕ} (pos : 0 < n) (bound : n≤1000000000000000000) :
    v_l 1 n=1 ↔ n ∈ [1,2,3,4,6,7,8,10,12,15,16,18,22,24,26,30,36,42,46,48,60,70,78,80,96,120,190,222,330] := by
  by_cases small : n≤330
  · exact solutions_through_330 pos small
  · constructor
    · intro sol
      exact (no_new_solutions (by omega) bound sol).elim
    · intro mem
      have cap : ∀ x ∈ ([1,2,3,4,6,7,8,10,12,15,16,18,22,24,26,30,36,42,46,48,60,70,78,80,96,120,190,222,330] : List ℕ), x≤330 := by decide
      exact (small (cap n mem)).elim



