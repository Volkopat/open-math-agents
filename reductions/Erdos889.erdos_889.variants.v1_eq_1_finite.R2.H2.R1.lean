/- The effective bound refines the argument of @MrSeizy in #23442, commit f7262ba898537178015c15584f3cf24431c39961. The new window has length B^12, the cells have width B^2, and the approximation order is 146t. -/
/-
# Finiteness of the even exceptions for Erdős 889

For an exceptional starting value, every prime up to P that does not divide n
has a distinct first multiple in (n,n+P] whose prime factors are all at most P.
The first-hit argument uses the two-prime observation of @rorcores in the
merged sibling proof OMA.E889.one_lt_v₀_of_two_primes.

Take P to be a sufficiently large fixed power of the binary logarithmic
scale of n. Discard the few hits with large residual cofactor. A prime power
above P can occur at only one hit, so many of the remaining hits are small
multiples of a single large prime power. Grouping their bases and exponents
would give two nearby weighted powers that the polynomial estimate excludes.
-/

namespace Erdos889.EffectiveBound
open Finset Polynomial

/-- Each step multiplies the coefficient at degree j by j minus the selected degree. -/
private noncomputable def strip (s : ℕ) (f : ℤ[X]) : ℕ → ℤ[X]
  | 0 => f
  | i+1 => X * (strip s f i).derivative - C ((s : ℤ)+i) * strip s f i

private lemma strip_coeff (s j : ℕ) (f : ℤ[X]) (i : ℕ) :
    (strip s f i).coeff j = f.coeff j * ∏ l ∈ range i, ((j : ℤ) - (s+l)) := by
  induction i with
  | zero => simp [strip]
  | succ i ih =>
    simp only [strip, coeff_sub, coeff_C_mul, prod_range_succ]
    have h (g : ℤ[X]) : (X * g.derivative).coeff j = j * g.coeff j := by
      cases j with
      | zero => simp
      | succ j => rw [coeff_X_mul, coeff_derivative]; push_cast; ring
    rw [h, ih]
    ring

private lemma strip_dvd (s i b : ℕ) (g f : ℤ[X]) (h : g ^ (b+i) ∣ f) :
    g ^ b ∣ strip s f i := by
  induction i generalizing b with
  | zero => simpa [strip] using h
  | succ i ih =>
    obtain ⟨w, hw⟩ := ih (b+1) (by rwa [show b+1+i = b+(i+1) by omega])
    rw [strip, hw, derivative_mul, derivative_pow_succ]
    refine dvd_sub ?_ ?_
    · apply dvd_mul_of_dvd_right
      apply dvd_add
      · apply dvd_mul_of_dvd_left; apply dvd_mul_of_dvd_left; exact dvd_mul_left _ _
      · exact dvd_mul_of_dvd_left (pow_dvd_pow _ (by omega)) _
    · exact dvd_mul_of_dvd_right (dvd_mul_of_dvd_left (pow_dvd_pow _ (by omega)) _) _


private lemma binomial_tail (N b u h : ℕ) (hb : b ≤ N) :
    ∑ j ∈ Ico b (N+1), h^j * u^(N-j) * N.choose j ≤
      N^b * h^b * (h+u)^(N-b) := by
  rw [add_pow, mul_sum, sum_Ico_eq_sum_range, show N+1-b=N-b+1 by omega]
  apply sum_le_sum
  intro j hj
  have hc : N.choose (b+j) ≤ N^b * (N-b).choose j := calc
    _ ≤ N.choose (b+j) * (b+j).choose b := Nat.le_mul_of_pos_right _ (Nat.choose_pos (by omega))
    _ = _ := by rw [Nat.choose_mul (by omega : b ≤ b+j), Nat.add_sub_cancel_left]
    _ ≤ _ := Nat.mul_le_mul_right _ (Nat.choose_le_pow _ _)
  rw [pow_add]
  calc
    _ ≤ (h^b*h^j) * u^(N-(b+j)) * (N^b*(N-b).choose j) := Nat.mul_le_mul_left _ hc
    _ = _ := by rw [Nat.sub_sub]; simp only [Nat.cast_id]; ring

/-- Apply the Euler operators at degrees d+1 through 2d to the binomial of
degree a+d. Its evaluation at h is divisible by (u+h)^a. The terms through
degree d are divisible by u^a, and all remaining nonzero terms are positive.
The first and last estimates on this tail give the integer separation below. -/
private lemma nearby_power_approx (a d u h : ℕ) (ha : d+1 ≤ a) (hu : 0 < u) (hh : 0 < h) :
    ∃ U V E : ℤ,
      ((u+h : ℕ) : ℤ)^a * V - (u : ℤ)^a * U = E ∧
      (u : ℤ)^(a-d-1) ≤ E ∧
      E ≤ ((a+d : ℕ) : ℤ)^(d+(2*d+1)) * (h : ℤ)^(2*d+1) *
        ((u+h : ℕ) : ℤ)^(a-d-1) ∧
      |V| ≤ (((a+d)*(u+h) : ℕ) : ℤ)^d := by
  let N := a+d
  let b := 2*d+1
  let v := u+h
  have hb : b ≤ N := by dsimp [N,b]; omega
  let f := strip (d+1) ((X+C (u : ℤ))^N) d
  let w (j : ℕ) := ∏ l ∈ range d, ((j : ℤ) - ((d+1 : ℕ)+ (l:ℤ)))
  let T (j : ℕ) := (h : ℤ)^j * (u : ℤ)^(N-j) * (N.choose j : ℤ) * w j
  have hf (j : ℕ) : f.coeff j * (h : ℤ)^j = T j := by
    simp only [f, strip_coeff, coeff_X_add_C_pow, w, T]; ring
  have hdeg : f.natDegree ≤ N := by
    apply natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    simp only [f, strip_coeff, coeff_X_add_C_pow, Nat.choose_eq_zero_of_lt hj, Nat.cast_zero, mul_zero, zero_mul]
  obtain ⟨g,hg⟩ := strip_dvd (d+1) d a (X+C (u:ℤ)) ((X+C (u:ℤ))^N) (dvd_refl _)
  let V := g.eval (h:ℤ)
  have hs : (v:ℤ)^a * V = ∑ j ∈ range (N+1), T j := by
    calc
      _ = f.eval (h:ℤ) := by simp [f,hg,V,v,add_comm]
      _ = _ := by rw [eval_eq_sum_range' (by omega : f.natDegree < N+1)]; simp_rw [hf]
  have low : (u:ℤ)^a ∣ ∑ j ∈ range b, T j := by
    apply dvd_sum
    intro j hj
    have hj' := mem_range.mp hj
    by_cases hjd : j ≤ d
    · have he : a ≤ N-j := by dsimp [N]; omega
      exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (pow_dvd_pow _ he) _) _) _
    · have hz : w j = 0 := by
        apply prod_eq_zero (i := j-(d+1)) (mem_range.mpr ?_)
        · have he : j-(d+1)+(d+1) = j := by omega
          exact_mod_cast (show (j:ℤ)-((d+1:ℕ)+(↑(j-(d+1)):ℤ))=0 by omega)
        · dsimp [b] at hj'; omega
      simp [T,hz]
  obtain ⟨U,hU⟩ := low
  let E := ∑ j ∈ Ico b (N+1), T j
  have hsplit := sum_range_add_sum_Ico T (by omega : b ≤ N+1)
  have hw (j : ℕ) (hj : j ≤ N) : |w j| ≤ (N:ℤ)^d := by
    dsimp only [w]; rw [abs_prod]
    have hh₁ : ∀ l ∈ range d, |(j:ℤ)-((d+1:ℕ)+(l:ℤ))| ≤ N := by
      intro l hl
      have := mem_range.mp hl
      dsimp [b] at hb
      exact abs_le.mpr ⟨by omega, by omega⟩
    simpa using prod_le_prod (fun l _ => abs_nonneg _) hh₁
  have hwpos (j : ℕ) (hj : b ≤ j) : 1 ≤ w j := by
    apply Finset.one_le_prod
    intro l hl
    have := mem_range.mp hl
    dsimp [b] at hj
    omega
  have hwT (j : ℕ) (hj : j ≤ N) :
      |T j| ≤ (N:ℤ)^d * ((h:ℤ)^j * (u:ℤ)^(N-j) * N.choose j) := by
    simp only [T, abs_mul, abs_pow, abs_of_nonneg (Int.natCast_nonneg _)]
    rw [mul_comm ((N:ℤ)^d)]
    exact mul_le_mul_of_nonneg_left (hw j hj) (by positivity)
  have htail₀ (j : ℕ) (hj : b ≤ j) (hj' : j ≤ N) : (u:ℤ)^(N-j) ≤ T j := by
    have hc : (1:ℤ) ≤ N.choose j := by exact_mod_cast Nat.choose_pos hj'
    have hh' : (1:ℤ) ≤ (h:ℤ)^j := one_le_pow₀ (by exact_mod_cast hh)
    dsimp [T]
    calc
      _ = 1 * (u:ℤ)^(N-j) * 1 * 1 := by ring
      _ ≤ _ := by gcongr; exact hwpos _ hj
  refine ⟨U,V,E,?_,?_,?_,?_⟩
  · change (v:ℤ)^a * V - (u:ℤ)^a * U = E
    dsimp [E]; omega
  · have hsingle := single_le_sum (f := T) (fun i hi => (by positivity : 0 ≤ (u:ℤ)^(N-i)).trans
        (htail₀ i (mem_Ico.mp hi).1 (by have := (mem_Ico.mp hi).2; omega))) (mem_Ico.mpr ⟨le_rfl, (show b < N+1 by omega)⟩)
    simpa [N,b, show a+d-(2*d+1) = a-d-1 by omega] using (htail₀ b le_rfl hb).trans hsingle
  · calc
      E ≤ ∑ j ∈ Ico b (N+1), (N:ℤ)^d * ((h:ℤ)^j * (u:ℤ)^(N-j) * N.choose j) :=
        sum_le_sum fun j hj => (le_abs_self _).trans (hwT _ (by have := (mem_Ico.mp hj).2; omega))
      _ = _ := (mul_sum ..).symm
      _ ≤ (N:ℤ)^d * ((N:ℤ)^b * (h:ℤ)^b * ((h+u:ℕ):ℤ)^(N-b)) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity); exact_mod_cast binomial_tail N b u h hb
      _ = _ := by rw [show N-b=a-d-1 by dsimp [N,b]; omega, Nat.add_comm h u, pow_add]; dsimp [N,b]; ring
  · have hsum : |(v:ℤ)^a * V| ≤ (N:ℤ)^d * (v:ℤ)^N := by
      rw [hs]
      calc
        _ ≤ _ := abs_sum_le_sum_abs _ _
        _ ≤ _ := sum_le_sum (fun j hj => hwT j (by have := mem_range.mp hj; omega))
        _ = _ := by rw [← mul_sum]; congr 1; simp [v, Nat.cast_add, add_comm (u:ℤ), add_pow]
    rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ (v:ℤ)^a)] at hsum
    have H : (v:ℤ)^a * |V| ≤ (v:ℤ)^a * ((N:ℤ)*(v:ℤ))^d := by
      convert hsum using 1; dsimp [N]; rw [pow_add,mul_pow]; ring
    exact (le_of_mul_le_mul_left H (by dsimp [v]; positivity))

/-- A sufficiently close pair would give a positive multiple of c*u^a strictly
below c*u^a, using the integer coefficients of the approximation. -/
private lemma short_power_gap (B d a u h c e : ℕ)
    (hB : 2 ≤ B) (ha : (5*d+6)/2 ≤ a) (hN : a+d ≤ B)
    (hu : B^11 ≤ u) (hv : u+h ≤ B^12) (hh : 0 < h) (hsmall : h ≤ B^2)
    (hc : 0 < c) (he : 0 < e) (hc' : c ≤ B^(2*d)) (he' : e ≤ B^(2*d)) :
    ¬ |(c*u^a : ℕ) - ((e*(u+h)^a : ℕ) : ℤ)| ≤ (B:ℤ)^12 := by
  intro hclose
  let v := u+h
  let N := a+d
  let b := 2*d+1
  let r := a-d-1
  have har : a = r+(d+1) := by dsimp [r]; omega
  have h4 : 4 ≤ B^2 := by nlinarith
  have hbig : 4*c*e*N^(d+b)*h^b < v^(d+1) := calc
    _ ≤ B^2*B^(2*d)*B^(2*d)*B^(d+b)*(B^2)^b := by gcongr
    _ = B^(2+2*d+2*d+(d+b)+2*b) := by simp only [pow_add,pow_mul]
    _ < (B^11)^(d+1) := by rw [← pow_mul]; apply Nat.pow_lt_pow_right (by omega); dsimp [b]; omega
    _ ≤ _ := Nat.pow_le_pow_left (by dsimp [v]; omega) _
  have hlow : 4*c*(N*v)^d*B^12 < u^r := calc
    _ ≤ B^2*B^(2*d)*(B*B^12)^d*B^12 := by gcongr
    _ = B^(2+2*d+(1+12)*d+12) := by simp only [pow_add,pow_mul,pow_one]
    _ < (B^11)^r := by rw [← pow_mul]; apply Nat.pow_lt_pow_right (by omega); dsimp [r]; omega
    _ ≤ _ := Nat.pow_le_pow_left hu _
  have hupos : 0 < u := lt_of_lt_of_le (pow_pos (by omega : 0 < B) _) hu
  obtain ⟨U,V,E,hid,hEₗ,hEᵤ,hV⟩ := nearby_power_approx a d u h (by omega) hupos hh
  change (v:ℤ)^a*V - (u:ℤ)^a*U = E at hid
  change (u:ℤ)^r ≤ E at hEₗ
  change E ≤ (N:ℤ)^(d+b)*(h:ℤ)^b*(v:ℤ)^r at hEᵤ
  push_cast at hV hclose
  change |V| ≤ ((N:ℤ)*(v:ℤ))^d at hV
  change |(c:ℤ)*(u:ℤ)^a - (e:ℤ)*(v:ℤ)^a| ≤ (B:ℤ)^12 at hclose
  have hl : 4*(c:ℤ)*|V| *(B:ℤ)^12 < (u:ℤ)^r := by
    apply lt_of_le_of_lt _ (by exact_mod_cast hlow : (4:ℤ)*c*((N:ℤ)*v)^d*(B:ℤ)^12 < (u:ℤ)^r)
    gcongr
  have hbE : 4*(c:ℤ)*e*E < (v:ℤ)^a := calc
    _ ≤ 4*(c:ℤ)*e*((N:ℤ)^(d+b)*(h:ℤ)^b*(v:ℤ)^r) := by gcongr
    _ = (4*(c:ℤ)*e*(N:ℤ)^(d+b)*(h:ℤ)^b)*(v:ℤ)^r := by ring
    _ < (v:ℤ)^(d+1)*(v:ℤ)^r := by
      apply mul_lt_mul_of_pos_right _ (by dsimp [v]; positivity); exact_mod_cast hbig
    _ = _ := by rw [← pow_add]; congr 1; omega
  have hur : (u:ℤ)^r ≤ (u:ℤ)^a := pow_le_pow_right₀ (by exact_mod_cast hupos) (by omega)
  have hc1 : (1:ℤ) ≤ c := by exact_mod_cast hc
  have he1 : (1:ℤ) ≤ e := by exact_mod_cast he
  let x : ℤ := c*(u:ℤ)^a
  let y : ℤ := e*(v:ℤ)^a
  let M : ℤ := (c:ℤ)*e*E
  let err : ℤ := (c:ℤ)*V*(x-y)
  have hx : (u:ℤ)^a ≤ x := le_mul_of_one_le_left (by positivity) hc1
  have hy : (v:ℤ)^a ≤ y := le_mul_of_one_le_left (by positivity) he1
  have hM : E ≤ M := le_mul_of_one_le_left (le_trans (by positivity) hEₗ)
    (one_le_mul_of_one_le_of_one_le hc1 he1)
  have herr : |err| ≤ (c:ℤ)*|V| *(B:ℤ)^12 := by
    dsimp [err]; simp only [abs_mul, abs_of_nonneg (Int.natCast_nonneg c)]
    exact mul_le_mul_of_nonneg_left hclose (by positivity)
  have hdist : (B:ℤ)^12 < x := by
    have hnv : 0 < (N*v)^d := pow_pos (Nat.mul_pos (by dsimp [N]; omega) (by dsimp [v]; omega)) _
    have hh' : B^12 < u^r := by
      apply lt_of_le_of_lt _ hlow
      exact Nat.le_mul_of_pos_left _ (by positivity)
    exact (by exact_mod_cast hh' : (B:ℤ)^12 < (u:ℤ)^r).trans_le (hur.trans hx)
  change |x-y| ≤ _ at hclose
  have hid' : x * (c*V - e*U) = M+err := by
    dsimp [M,err,x,y]; rw [← hid]; ring
  have hstrict : 0 < M+err ∧ M+err < x := by
    have hse : -|err| ≤ err := neg_abs_le _
    have hse' := le_abs_self err
    have hd := abs_le.mp hclose
    have hm4 : 4*M < (v:ℤ)^a := by dsimp [M]; linarith only [hbE]
    have he4 : 4*((c:ℤ)*|V| *(B:ℤ)^12) < (u:ℤ)^r := by linarith only [hl]
    constructor <;> omega
  have hz : 1 ≤ (c:ℤ)*V-e*U := by
    by_contra! H
    have hn := mul_nonpos_of_nonneg_of_nonpos (show 0 ≤ x by omega) (show (c:ℤ)*V-e*U ≤ 0 by omega)
    omega
  have := le_mul_of_one_le_right (show 0 ≤ x by omega) hz
  omega

private def giants (P x : ℕ) := P.primesLE.filter (fun q => P < q ^ x.factorization q)
private def smallExp (P x q : ℕ) := if q ^ x.factorization q ≤ P then x.factorization q else 0
private def residue (P x : ℕ) := ∏ q ∈ P.primesLE, q ^ smallExp P x q

private lemma residue_pos (P x : ℕ) : 0 < residue P x :=
  prod_pos fun _ hq => pow_pos (Nat.mem_primesLE.mp hq).2.pos _

private lemma split_residue {P x : ℕ} (hx : x ≠ 0) (hs : x.primeFactors ⊆ P.primesLE) :
    residue P x * (∏ q ∈ giants P x, q ^ x.factorization q) = x := by
  have hd : residue P x = ∏ q ∈ P.primesLE with ¬ P < q ^ x.factorization q, q ^ x.factorization q := by
    simp [residue, smallExp, prod_filter]
  rw [hd, mul_comm, giants, prod_filter_mul_prod_filter_not]
  rw [← prod_subset hs (fun q _ hq => by
    have : x.factorization q = 0 := Finsupp.notMem_support_iff.mp hq
    simp [this])]
  exact Nat.prod_factorization_pow_eq_self hx

private lemma interval_count {P n m : ℕ} (hm : 0 < m) (hmP : m ≤ P) :
    ((Ioc n (n+P)).filter fun x => m ∣ x).card ≤ P/m+1 := by
  have hsub : (Ioc 0 n).filter (fun x => m ∣ x) ⊆ (Ioc 0 (n+P)).filter (fun x => m ∣ x) := by
    intro x hx
    simp only [mem_filter,mem_Ioc] at hx ⊢; omega
  have he : (Ioc n (n+P)).filter (fun x => m ∣ x) =
      ((Ioc 0 (n+P)).filter fun x => m ∣ x) \ ((Ioc 0 n).filter fun x => m ∣ x) := by
    ext x
    simp only [mem_filter, mem_Ioc, mem_sdiff]; omega
  rw [he,card_sdiff_of_subset hsub, Nat.Ioc_filter_dvd_card_eq_div, Nat.Ioc_filter_dvd_card_eq_div,
    Nat.add_div hm]
  have := Nat.div_pos hmP hm
  split <;> omega

private lemma residual_exp_le {P n q : ℕ} (hP : P ≠ 0) (hq : q.Prime) (S : Finset ℕ)
    (hS : S ⊆ Ioc n (n+P)) :
    ∑ x ∈ S, smallExp P x q ≤ P.factorial.factorization q + Nat.log q P := by
  let L := Nat.log q P
  have he (x : ℕ) : smallExp P x q ≤ L := by
    dsimp [smallExp]; split
    · exact Nat.le_log_of_pow_le hq.one_lt ‹_›
    · omega
  have hex (x : ℕ) : smallExp P x q = ∑ i ∈ Ico 1 (L+1), if i ≤ smallExp P x q then 1 else 0 := by
    rw [sum_boole]
    have H : (Ico 1 (L+1)).filter (fun i => i ≤ smallExp P x q) = Ico 1 (smallExp P x q+1) := by
      ext i; simp only [mem_filter,mem_Ico]; have := he x; omega
    simp [H,Nat.card_Ico]
  rw [sum_congr rfl (fun x _ => hex x)]
  rw [sum_comm,Nat.factorization_factorial hq (Nat.lt_succ_self L)]
  have ones : (∑ _i ∈ Ico 1 (L+1), (1:ℕ))=L := by simp [Nat.card_Ico]
  change _ ≤ _ + L
  conv_rhs => rhs; rw [← ones]
  rw [← sum_add_distrib]
  apply sum_le_sum
  intro i hi
  rw [sum_boole]
  have hsub : S.filter (fun x => i ≤ smallExp P x q) ⊆ (Ioc n (n+P)).filter (fun x => q^i ∣ x) := by
    intro x hx
    obtain ⟨hxS,he⟩ := mem_filter.mp hx
    have hxI := mem_Ioc.mp (hS hxS)
    apply mem_filter.mpr ⟨hS hxS, (hq.pow_dvd_iff_le_factorization (by omega)).mpr ?_⟩
    dsimp [smallExp] at he
    split at he <;> omega
  apply (card_le_card hsub).trans
  apply interval_count (pow_pos hq.pos _)
  have := (mem_Ico.mp hi).2
  exact (Nat.pow_le_pow_right hq.pos (by omega : i ≤ L)).trans (Nat.pow_log_le_self _ hP)

/-- For each prime, count its powers up to P across the interval. A modulus
m ≤ P has at most floor(P/m)+1 multiples there. Legendre's formula supplies the
factorial term, leaving at most one extra power q^floor(log_q P) for that prime. -/
private lemma residual_product {P n : ℕ} (hP : P ≠ 0) (S : Finset ℕ) (hS : S ⊆ Ioc n (n+P)) :
    ∏ x ∈ S, residue P x ≤ P.factorial*P^P.primesLE.card := by
  simp only [residue, prod_comm (s := S) (t := P.primesLE), Finset.prod_pow_eq_pow_sum]
  calc
    _ ≤ ∏ q ∈ P.primesLE, q ^ (P.factorial.factorization q + Nat.log q P) := by
      apply prod_le_prod (fun _ _ => Nat.zero_le _)
      intro q hq
      exact Nat.pow_le_pow_right (Nat.mem_primesLE.mp hq).2.pos (residual_exp_le hP (Nat.mem_primesLE.mp hq).2 S hS)
    _ ≤ _ := by
      simp only [pow_add,prod_mul_distrib]
      apply Nat.mul_le_mul
      · apply le_of_eq
        have hsub : P.factorial.primeFactors ⊆ P.primesLE := by
          intro q hq
          obtain ⟨hqp,hqd,_⟩ := Nat.mem_primeFactors.mp hq
          exact Nat.mem_primesLE.mpr ⟨(hqp.dvd_factorial.mp hqd), hqp⟩
        rw [← prod_subset hsub (fun q _ hq => by
          have h : P.factorial.factorization q = 0 := Finsupp.notMem_support_iff.mp hq
          simp [h])]
        exact Nat.prod_factorization_pow_eq_self (Nat.factorial_ne_zero _)


      · calc
          _ ≤ ∏ _q ∈ P.primesLE, P :=
            prod_le_prod (fun _ _ => Nat.zero_le _) (fun q _ => Nat.pow_log_le_self q hP)
          _ = _ := by simp

private def smoothHits (n P : ℕ) :=
  (Ioc n (n+P)).filter (fun x => x.primeFactors ⊆ P.primesLE)

private lemma card_hits {n P : ℕ} (hnP : P^2 < n)
    (hwin : ∀ k : ℕ, 1 ≤ k → k^2 < n →
      ((n+k).primeFactors.filter fun q => k < q).card ≤ 1) :
    P.primesLE.card ≤ (smoothHits n P).card + n.primeFactors.card := by
  classical
  let D := P.primesLE.filter (fun p => ¬ p ∣ n)
  let k (p : ℕ) := p - n%p
  have hhit (p : ℕ) (hp : p ∈ D) :
      n+k p ∈ smoothHits n P ∧ p ∣ n+k p ∧ k p < p := by
    obtain ⟨hmem,hnd⟩ := mem_filter.mp hp
    obtain ⟨hpP,hprime⟩ := Nat.mem_primesLE.mp hmem
    have hrem := Nat.mod_lt n hprime.pos
    have hrem₁ : n%p ≠ 0 := fun h => hnd (Nat.dvd_of_mod_eq_zero h)
    have hk : 0 < k p ∧ k p < p := by dsimp [k]; omega
    have hplus : n+k p = p*(n/p+1) := by
      rw [Nat.mul_add,Nat.mul_one]; dsimp [k]; have := Nat.mod_add_div n p; omega
    have hpd : p ∣ n+k p := hplus ▸ dvd_mul_right _ _
    have hc := hwin (k p) hk.1 ((Nat.pow_le_pow_left (by omega : k p ≤ P) 2).trans_lt hnP)
    have hpm : p ∈ (n+k p).primeFactors.filter (fun r => k p < r) := mem_filter.mpr
      ⟨Nat.mem_primeFactors.mpr ⟨hprime,hpd,by omega⟩, hk.2⟩
    refine ⟨mem_filter.mpr ⟨mem_Ioc.mpr ⟨by omega,by omega⟩,?_⟩,hpd,hk.2⟩
    intro q hq
    apply Nat.mem_primesLE.mpr ⟨?_,(Nat.mem_primeFactors.mp hq).1⟩
    by_contra! H
    have := card_le_one.mp hc p hpm q (mem_filter.mpr ⟨hq,by omega⟩)
    omega
  have hcard := card_le_card_of_injOn (s := D) (t := smoothHits n P) (fun p => n+k p)
    (fun p hp => (hhit p hp).1) (by
      intro p hp q hq heq
      have hpc := (hhit p hp).2; have hqc := (hhit q hq).2
      have hP := Nat.mem_primesLE.mp (mem_filter.mp hp).1
      have hQ := Nat.mem_primesLE.mp (mem_filter.mp hq).1
      change n+k p = n+k q at heq
      have hk : k p = k q := by omega
      have hkp : 0 < k p := by dsimp [k]; have := Nat.mod_lt n hP.2.pos; omega
      have hc := hwin (k p) hkp ((Nat.pow_le_pow_left (by omega : k p ≤ P) 2).trans_lt hnP)
      rw [← hk] at hqc
      exact card_le_one.mp hc p (mem_filter.mpr ⟨Nat.mem_primeFactors.mpr ⟨hP.2,hpc.1,by omega⟩,hpc.2⟩)
        q (mem_filter.mpr ⟨Nat.mem_primeFactors.mpr ⟨hQ.2,hqc.1,by omega⟩,hqc.2⟩))
  have HD : P.primesLE \ D ⊆ n.primeFactors := by
    intro p hp
    obtain ⟨hp₁,hp₂⟩ := mem_sdiff.mp hp
    exact Nat.mem_primeFactors.mpr ⟨(Nat.mem_primesLE.mp hp₁).2, by simpa [D,hp₁] using hp₂, by omega⟩
  have := card_le_card HD
  rw [card_sdiff_of_subset (show D ⊆ P.primesLE from filter_subset ..)] at this
  omega

private lemma primeFactors_count {n : ℕ} (hn : n ≠ 0) : n.primeFactors.card ≤ Nat.log 2 n := by
  apply Nat.le_log_of_pow_le (by decide)
  calc
    2 ^ n.primeFactors.card = ∏ _p ∈ n.primeFactors, 2 := by simp
    _ ≤ ∏ p ∈ n.primeFactors, p := prod_le_prod (fun _ _ => by decide) (fun _ hp => (Nat.mem_primeFactors.mp hp).1.two_le)
    _ ≤ n := Nat.le_of_dvd (by omega) (Nat.prod_primeFactors_dvd n)

private lemma disjoint_giants {P n x y : ℕ} (hx : x ∈ Ioc n (n+P)) (hy : y ∈ Ioc n (n+P))
    (hne : x ≠ y) : Disjoint (giants P x) (giants P y) := by
  rw [disjoint_left]
  intro q hqx hqy
  obtain ⟨hxp,hxg⟩ := mem_filter.mp hqx
  obtain ⟨_,hyg⟩ := mem_filter.mp hqy
  have hq := (Nat.mem_primesLE.mp hxp).2
  obtain ⟨hx₁,hx₂⟩ := mem_Ioc.mp hx; obtain ⟨hy₁,hy₂⟩ := mem_Ioc.mp hy
  let m := min (x.factorization q) (y.factorization q)
  have hxD : q^m ∣ x := (hq.pow_dvd_iff_le_factorization (by omega)).mpr (min_le_left ..)
  have hyD : q^m ∣ y := (hq.pow_dvd_iff_le_factorization (by omega)).mpr (min_le_right ..)
  have hlarge : P < q^m := by
    dsimp [m]; rcases le_total (x.factorization q) (y.factorization q) with he|he
    · simpa [min_eq_left he] using hxg
    · simpa [min_eq_right he] using hyg
  rcases lt_or_gt_of_ne hne with h|h
  · have := Nat.le_of_dvd (by omega : 0 < y-x) (Nat.dvd_sub hyD hxD); omega
  · have := Nat.le_of_dvd (by omega : 0 < x-y) (Nat.dvd_sub hxD hyD); omega

private lemma giant_budget {P n : ℕ} (S : Finset ℕ) (hS : S ⊆ Ioc n (n+P)) :
    ∑ x ∈ S, (giants P x).card ≤ P.primesLE.card := by
  rw [← card_biUnion (fun x hx y hy hne => disjoint_giants (hS hx) (hS hy) hne)]
  exact card_le_card (biUnion_subset.mpr fun _ _ => filter_subset ..)

private lemma primes_lower (L : ℕ) (hL : 0 < L) :
    2^L ≤ L*(2^L).primesLE.card+(L+1) := by
  let P := (2:ℕ)^L
  have hP : 1 < P := Nat.one_lt_two_pow hL.ne'
  have hc := Chebyshev.pi_ge P
  have hl : 0 < Real.log (P:ℝ) := Real.log_pos (by exact_mod_cast hP)
  have hc' := (div_le_iff₀ hl).mp hc
  have hlog : Real.log (P:ℝ) = L*Real.log 2 := by simp [P,Real.log_pow]
  have hlog' : Real.log (P+1:ℝ) ≤ Real.log (P:ℝ) + Real.log 2 := by
    rw [← Real.log_mul (by positivity : (P:ℝ) ≠ 0) (by norm_num)]
    apply Real.log_le_log (by positivity); have : (1:ℝ) ≤ P := by exact_mod_cast hP.le
    linarith
  have h₂ := Real.log_pos (by norm_num : (1:ℝ) < 2)
  rw [hlog] at hlog' hc'
  rw [← Nat.primesLE_card_eq_primeCounting] at hc'
  change P ≤ L*P.primesLE.card + (L+1)
  have h : (P:ℝ)*Real.log 2 ≤ ((L:ℝ)*P.primesLE.card + (L+1))*Real.log 2 := by
    linarith only [hc',hlog']
  exact_mod_cast (le_of_mul_le_mul_right h h₂)

private def base (P x : ℕ) := (giants P x).sup id

private lemma base_single {P x : ℕ} (h : (giants P x).card = 1) :
    giants P x = {base P x} := by
  obtain ⟨q,hq⟩ := card_eq_one.mp h
  simp [base,hq]

/-- A singleton hit with large base is determined by its exponent and the
quotient of its base by B^2. The separation lemma proves injectivity. -/
private lemma singles_bound {B t d n : ℕ} (hB : 2 ≤ B) (hBt : B=2^t)
    (hlo : 2^B ≤ n) (hhi : n+B^12 < 2^(3*B)) (hN : 4*d ≤ B)
    (hexp : t*(2*d)+12*t*(((5*d+6)/2)) < B)
    (T : Finset ℕ) (hT : T ⊆ smoothHits n (B^12))
    (hres : ∀ x ∈ T, residue (B^12) x ≤ B^(2*d))
    (hone : ∀ x ∈ T, (giants (B^12) x).card = 1) :
    T.card ≤ B^11+(B^10+1)*(3*B+1) := by
  classical
  let P := B^12
  let q := base P
  let a (x : ℕ) := x.factorization (q x)
  let c := residue P
  have hxI {x : ℕ} (hx : x ∈ T) := (mem_filter.mp (hT hx)).1
  have qmem {x : ℕ} (hx : x ∈ T) : q x ∈ giants P x := by
    rw [base_single (hone x hx)]; exact mem_singleton_self _
  have hrepr {x : ℕ} (hx : x ∈ T) : c x * q x ^ a x = x := by
    have hlo' := (mem_Ioc.mp (hxI hx)).1
    have H := split_residue (by omega : x ≠ 0) (mem_filter.mp (hT hx)).2
    rw [base_single (hone x hx), prod_singleton] at H
    exact H
  have qbound {x : ℕ} (hx : x ∈ T) := Nat.mem_primesLE.mp (mem_filter.mp (qmem hx)).1
  have hqa {x : ℕ} (hx : x ∈ T) : a x ≤ 3*B := by
    have hpow : 2^a x ≤ q x ^ a x := Nat.pow_le_pow_left (qbound hx).2.two_le _
    have hrepr' := hrepr hx
    have hc := residue_pos P x
    have hu := (mem_Ioc.mp (hxI hx)).2
    have hxle : 2^a x ≤ x := hpow.trans ((Nat.le_mul_of_pos_left _ hc).trans_eq hrepr')
    by_contra! H
    have := Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 3*B ≤ a x)
    omega
  have hqa' {x : ℕ} (hx : x ∈ T) : ((5*d+6)/2) ≤ a x := by
    by_contra! h
    have hP : P = 2^(12*t) := by dsimp [P]; rw [hBt,← pow_mul]; congr 1; omega
    have hle : x ≤ 2^(t*(2*d)+12*t*(((5*d+6)/2))) := calc
      _ = c x * q x ^ a x := (hrepr hx).symm
      _ ≤ B^(2*d) * P ^ (((5*d+6)/2)) := by
        apply Nat.mul_le_mul (hres x hx)
        exact (Nat.pow_le_pow_left (qbound hx).1 _).trans (Nat.pow_le_pow_right (by dsimp [P]; positivity) h.le)
      _ = _ := by simp only [hP,hBt,pow_add,pow_mul]
    have ht := Nat.pow_lt_pow_right (by decide : 1 < 2) hexp
    have := (mem_Ioc.mp (hxI hx)).1
    omega
  have hinj {x y : ℕ} (hx : x ∈ T) (hy : y ∈ T) (heq : q x = q y) : x=y := by
    by_contra h
    exact (disjoint_left.mp (disjoint_giants (hxI hx) (hxI hy) h) (qmem hx)) (heq ▸ qmem hy)
  let S := T.filter (fun x => q x < B^11)
  have hsm : S.card ≤ B^11 := by
    rw [← card_range (B^11)]
    apply card_le_card_of_injOn q (fun x hx => mem_range.mpr (mem_filter.mp hx).2)
    intro x hx y hy; exact hinj (mem_filter.mp hx).1 (mem_filter.mp hy).1
  let R := T \ S
  let H := B^2
  let key (x : ℕ) := (q x / H, a x)
  have hR {x : ℕ} (hx : x ∈ R) : x ∈ T ∧ B^11 ≤ q x := by
    obtain ⟨hx,hn⟩ := mem_sdiff.mp hx
    exact ⟨hx,by simpa [S,hx] using hn⟩
  have hcoll {x y : ℕ} (hxR : x ∈ R) (hyR : y ∈ R) (hkey : key x = key y) :
      ¬ q x < q y := by
    intro hlt
    obtain ⟨hx,hqx⟩ := hR hxR
    obtain ⟨hy,_⟩ := hR hyR
    have hj : q x / H = q y / H := congrArg Prod.fst hkey
    have he : a x = a y := congrArg Prod.snd hkey
    let h := q y - q x
    have hadd : q x + h = q y := by dsimp [h]; omega
    have hh : h ≤ H := by
      have h₁ := Nat.mod_add_div (q x) H; have h₂ := Nat.mod_add_div (q y) H
      rw [hj] at h₁
      have := Nat.mod_lt (q y) (show 0 < H by dsimp [H]; positivity)
      dsimp [h]; omega
    have q16 : 16 ≤ q x := by
      have z := Nat.pow_le_pow_left hB 11
      norm_num at z
      omega
    have power4 : 2^(4*a x) ≤ x := calc
      _ = 16^(a x) := by rw [pow_mul]; rfl
      _ ≤ (q x)^(a x) := Nat.pow_le_pow_left q16 _
      _ ≤ c x * (q x)^(a x) := Nat.le_mul_of_pos_left _ (residue_pos _ _)
      _ = _ := hrepr hx
    have close := (mem_Ioc.mp (hxI hx)).2
    have ax : 4*a x < 3*B := (Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp
      (power4.trans_lt (close.trans_lt hhi))
    have hgap := short_power_gap B d (a x) (q x) h (c x) (c y) hB (hqa' hx)
      (by omega) hqx (hadd ▸ (qbound hy).1) (by dsimp [h]; omega) hh
      (residue_pos _ _) (residue_pos _ _) (hres x hx)
      (hres y hy)
    rw [hadd,hrepr hx,he,hrepr hy] at hgap
    have hxi := mem_Ioc.mp (hxI hx); have hyi := mem_Ioc.mp (hxI hy)
    apply hgap
    have H₁ : (x:ℤ) ≤ n+(B:ℤ)^12 := by exact_mod_cast hxi.2
    have H₂ : (y:ℤ) ≤ n+(B:ℤ)^12 := by exact_mod_cast hyi.2
    exact abs_le.mpr ⟨by omega,by omega⟩
  have hcard : R.card ≤ ((range (B^10+1)) ×ˢ (range (3*B+1))).card := by
    apply card_le_card_of_injOn key
    · intro x hx
      have hp := (qbound (hR hx).1).1
      have hdiv : q x / H ≤ B^10 := by
        apply (Nat.div_le_div_right hp).trans
        dsimp [P,H]; rw [show B^12 = B^10 * B^2 by ring, Nat.mul_div_cancel _ (by positivity)]
      exact mem_product.mpr ⟨mem_range.mpr (by dsimp [key]; omega), mem_range.mpr (Nat.lt_succ_of_le (hqa (hR hx).1))⟩
    · intro x hx y hy he
      exact hinj (hR hx).1 (hR hy).1 (by have := hcoll hx hy he; have := hcoll hy hx he.symm; omega)
  rw [card_product,card_range,card_range] at hcard
  have ht : R.card = T.card - S.card := card_sdiff_of_subset (filter_subset ..)
  omega

/-- The length of the interval is the twelfth power of the scale. -/
private lemma exclude_large (t n : ℕ) (ht : 21 ≤ t)
    (hhuge : 4672*t^2+36*t < 2^t)
    (hlo : 2^(2^t) ≤ n) (hhi : n < 2^(2*2^t))
    (hwin : ∀ k : ℕ, 1 ≤ k → k^2 < n →
      ((n+k).primeFactors.filter fun q => k < q).card ≤ 1) : False := by
  classical
  let B := 2^t
  let L := 12*t
  let P := B^12
  let d := 146*t
  have hP : P = 2^L := by dsimp [P,L,B]; rw [← pow_mul]; congr 1; omega
  have ht2 : 21*t ≤ t^2 := by nlinarith only [Nat.mul_le_mul_right t ht]
  have hB : 100 ≤ B := by change _ < B at hhuge; omega
  have hx : t*(2*d)+12*t*(((5*d+6)/2)) < B := by
    change _ < B at hhuge
    dsimp [d]
    rw [show (5*(146*t)+6)/2 = 365*t+3 by omega]
    nlinarith only [hhuge]
  have hLB : 2190*L < B := by dsimp [L]; change _ < B at hhuge; omega
  have hsmallP : P^2 < n := by
    apply lt_of_lt_of_le _ hlo
    rw [hP,← pow_mul]; apply Nat.pow_lt_pow_right (by decide); omega
  have hsum : n+P < 2^(3*B) := by
    have hle : P ≤ 2^(2*B) := hP ▸ Nat.pow_le_pow_right (by decide) (by omega)
    have hle' := Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 2*B+1 ≤ 3*B)
    rw [pow_succ] at hle'; change n < 2^(2*B) at hhi; omega
  have hN : 4*d ≤ B := by
    dsimp [d]
    change _ < B at hhuge
    omega
  let S := smoothHits n P
  let D := S.filter (fun x => B^(2*d) < residue P x)
  let G := S \ D
  let T := G.filter (fun x => (giants P x).card = 1)
  have hSI : S ⊆ Ioc n (n+P) := filter_subset ..
  have hDS : D ⊆ S := filter_subset ..
  have hGS : G ⊆ S := sdiff_subset
  have hTG : T ⊆ G := filter_subset ..
  have hres {x : ℕ} (hx : x ∈ G) : residue P x ≤ B^(2*d) := by
    obtain ⟨hxS,hxD⟩ := mem_sdiff.mp hx; simpa [D,hxS] using hxD
  have htc := singles_bound (by omega : 2 ≤ B) (rfl : B=2^t) hlo hsum hN hx T
    (hTG.trans hGS) (fun _ hx => hres (hTG hx)) (fun _ hx => (mem_filter.mp hx).2)
  have hdcount : (t*(2*d))*D.card ≤ L*(P+P.primesLE.card) := by
    apply (pow_le_pow_iff_right₀ (by decide : 1 < (2:ℕ))).mp
    calc
      2^((t*(2*d))*D.card) = ∏ _x ∈ D, B^(2*d) := by simp [B,pow_mul]
      _ ≤ ∏ x ∈ D, residue P x := prod_le_prod (fun _ _ => Nat.zero_le _) (fun _ hx => (mem_filter.mp hx).2.le)
      _ ≤ P.factorial*P^P.primesLE.card := residual_product (by dsimp [P,B]; positivity) D (hDS.trans hSI)
      _ ≤ P^P*P^P.primesLE.card := Nat.mul_le_mul_right _ (Nat.factorial_le_pow _)
      _ = 2^(L*(P+P.primesLE.card)) := by
        rw [← pow_add]
        rw [pow_mul 2 L (P+P.primesLE.card)]
        exact congrArg (fun x : ℕ => x^(P+P.primesLE.card)) hP
  have hpos {x : ℕ} (hxG : x ∈ G) : 0 < (giants P x).card := by
    have hxS := hGS hxG
    have hxI := mem_Ioc.mp (hSI hxS)
    by_contra! H
    have he := card_eq_zero.mp (Nat.eq_zero_of_le_zero H)
    have hr := split_residue (by omega : x ≠ 0) (mem_filter.mp hxS).2
    rw [he,prod_empty,mul_one] at hr
    have hm := hres hxG
    rw [hr] at hm
    have hrB : B^(2*d)=2^(t*(2*d)) := (pow_mul 2 t (2*d)).symm
    rw [hrB] at hm
    exact (not_lt_of_ge (hm.trans ((Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : t*(2*d) ≤ B)).trans hlo))) hxI.1
  have hgb : 2*G.card ≤ P.primesLE.card + T.card := calc
    _ = ∑ _x ∈ G, 2 := by simp [Nat.mul_comm]
    _ ≤ ∑ x ∈ G, ((giants P x).card + if (giants P x).card=1 then 1 else 0) := by
      apply sum_le_sum
      intro x hxG
      have := hpos hxG
      split <;> omega
    _ = (∑ x ∈ G, (giants P x).card) + T.card := by rw [sum_add_distrib,sum_boole]; rfl
    _ ≤ _ := Nat.add_le_add_right (giant_budget G (hGS.trans hSI)) _
  have hw : n.primeFactors.card ≤ 2*B := by
    have hn : n ≠ 0 := by have hh := pow_pos (by decide : 0 < 2) B; omega
    exact (primeFactors_count hn).trans (Nat.log_lt_of_lt_pow hn hhi).le
  have hch := card_hits hsmallP hwin
  change P.primesLE.card ≤ S.card+n.primeFactors.card at hch
  have hgcard : G.card = S.card-D.card := card_sdiff_of_subset hDS
  have hpcount : P.primesLE.card ≤ 2*D.card+(4*B+B^11+(B^10+1)*(3*B+1)) := by omega
  have hpl := primes_lower L (by dsimp [L]; omega)
  rw [← hP] at hpl
  have hbad : 73*L*D.card ≤ 36*(P+P.primesLE.card) := by
    have hh : t*(73*L*D.card) ≤ t*(36*(P+P.primesLE.card)) := by
      dsimp [L,d] at hdcount ⊢
      have h1 : 3*(t*(2*(146*t))*D.card) = t*(73*(12*t)*D.card) := by ring
      have h2 : 3*((12*t)*(P+P.primesLE.card)) = t*(36*(P+P.primesLE.card)) := by ring
      simpa only [h1,h2] using Nat.mul_le_mul_left 3 hdcount
    exact Nat.le_of_mul_le_mul_left hh (by omega)
  have h1 : B ≤ B^11 := by simpa using (Nat.pow_le_pow_right (by omega : 0 < B) (by decide : 1 ≤ 11))
  have h11 : 1 ≤ B^10 := one_le_pow₀ (by omega)
  have h12 : 1 ≤ B^11 := one_le_pow₀ (by omega)
  have hrest : 4*B+B^11+(B^10+1)*(3*B+1) ≤ 13*B^11 := calc
    _ ≤ 4*B^11+B^11+(B^10+B^10)*(3*B+B) := by gcongr; omega
    _ = _ := by ring
  have hnum : 146*(L*(4*B+B^11+(B^10+1)*(3*B+1))+(L+1)) < P := by
    have lpos : 0 < L := by dsimp [L]; omega
    have slack : L+1 ≤ 2*L*B^11 := by
      have := Nat.mul_le_mul_left (2*L) h12
      omega
    calc
      _ ≤ 146*(L*(13*B^11)+2*L*B^11) := by gcongr
      _ = (2190*L)*B^11 := by ring
      _ < B*B^11 := Nat.mul_lt_mul_of_pos_right hLB (by positivity)
      _ = P := by dsimp [P]; ring
  have hfinal := Nat.mul_le_mul_left L hpcount
  have ratio := Nat.mul_le_mul_right P.primesLE.card (show 144 ≤ L by dsimp [L]; omega)
  nlinarith only [hpl,hbad,hnum,hfinal,ratio]

private theorem polynomial_scale {t : ℕ} (ht : 21 ≤ t) : 4672*t^2+36*t < 2^t := by
  obtain ⟨k,rfl⟩ := Nat.exists_eq_add_of_le ht
  induction k with
  | zero => decide
  | succ k ih =>
    rw [show 21+(k+1)=(21+k)+1 by omega]
    have grow : 4672*(21+k+1)^2+36*(21+k+1) ≤ 2*(4672*(21+k)^2+36*(21+k)) := by
      ring_nf
      omega
    calc
      _ ≤ 2*(4672*(21+k)^2+36*(21+k)) := grow
      _ < 2*2^(21+k) := Nat.mul_lt_mul_of_pos_left (ih (by omega)) (by decide)
      _ = _ := by rw [pow_succ 2 (21+k),Nat.mul_comm]

theorem below_cutoff_of_window {n : ℕ} (hnpos : 0 < n)
    (hwin : ∀ k : ℕ, 1 ≤ k → k ^ 2 < n →
      ((n + k).primeFactors.filter (fun p ↦ k < p)).card ≤ 1) :
    n < 2^(2^21) := by
  let s : ℕ := 21
  have hs : 21 ≤ s := le_rfl
  change n < 2^(2^s)
  by_contra! H
  let l := Nat.log 2 n
  let t := Nat.log 2 l
  have hl : 2^s ≤ l := Nat.le_log_of_pow_le (by decide) H
  have ht : s ≤ t := Nat.le_log_of_pow_le (by decide) hl
  have hlo : 2^(2^t) ≤ n :=
    (Nat.pow_le_pow_right (by decide) (Nat.pow_log_le_self 2 (by
      have := pow_pos (by decide : 0 < 2) s; omega : l ≠ 0))).trans (Nat.pow_log_le_self _ hnpos.ne')
  have hhi : n < 2^(2*2^t) := by
    have hh := Nat.lt_pow_succ_log_self (by decide : 1 < 2) l
    change l < 2^(t+1) at hh
    rw [pow_succ] at hh
    exact (Nat.lt_pow_succ_log_self (by decide : 1 < 2) n).trans_le
      (Nat.pow_le_pow_right (by decide) (show l+1 ≤ 2*2^t by omega))
  exact exclude_large t n (hs.trans ht) (polynomial_scale (hs.trans ht)) hlo hhi hwin


end Erdos889.EffectiveBound

/-- Every positive solution has at most 2,097,152 binary digits. -/
theorem Erdos889.effective_binary_cutoff {n : ℕ} (h : Erdos889.v_l 1 n=1) : n<2^(2^21) := by
  rcases Nat.eq_zero_or_pos n with rfl|hn
  · exact pow_pos (by decide : 0<(2:ℕ)) _
  · apply Erdos889.EffectiveBound.below_cutoff_of_window hn
    intro k hk _
    rw [←OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2.v_as_card]
    exact OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2.offset_le_one h hk




/- Classification of large exceptions missing the prime three. -/

/- The imaginary coordinate of a Pell power at squared prime divisors of its discriminant. -/

namespace Erdos889.PellValuation

-- BEGIN PELL VALUATION
private theorem pell_expansion_remainder {d : ℤ} (z : Pell.Solution₁ d) (n : ℕ) :
    ∃ L K : ℤ, (z^(n+1)).x=z.x^(n+1)+d*L ∧
      (z^(n+1)).y=z.y*((n+1 : ℕ)*(z.x^n)+d*K) := by
  induction n with
  | zero => exact ⟨0,0,by simp,by simp⟩
  | succ n ih =>
    obtain ⟨L,K,hx,hy⟩ := ih
    refine ⟨L*z.x+(z^(n+1)).y*z.y,L+K*z.x,?_,?_⟩
    · change (z^(n+1)*z).x=z.x^(n+1+1)+d*(L*z.x+(z^(n+1)).y*z.y)
      rw [Pell.Solution₁.x_mul,hx,pow_succ z.x (n+1)]
      ring
    · change (z^(n+1)*z).y=z.y*((n+1+1:ℕ)*z.x^(n+1)+d*(L+K*z.x))
      rw [Pell.Solution₁.y_mul,hx,hy,pow_succ z.x n]
      push_cast
      ring

private theorem pell_prime_multiplier {D l q : ℕ} (z : Pell.Solution₁ (D:ℤ))
    (pl : l.Prime) (pq : q.Prime) (dq : q^2∣D) :
    ∃ k : ℕ, (z^l).y.natAbs=z.y.natAbs*k ∧ k≠0 ∧ k.factorization q=l.factorization q := by
  let _ : Fact q.Prime := ⟨pq⟩
  obtain ⟨_,K,_,hy⟩ := pell_expansion_remainder z (l-1)
  rw [Nat.sub_add_cancel pl.one_le] at hy
  obtain ⟨h,dh⟩ := dq
  have dint : (D:ℤ)=(q:ℤ)^2*h := by exact_mod_cast dh
  have zd : (D:ZMod q)=0 := (ZMod.natCast_eq_zero_iff _ _).mpr (dh ▸ dvd_mul_of_dvd_left (dvd_pow_self q (by decide : (2:ℕ)≠0)) h)
  have xz : (z.x:ZMod q)≠0 := by
    intro zero
    have f := congrArg (fun v:ℤ => (v:ZMod q)) z.prop
    push_cast at f
    rw [zd,zero,zero_pow two_ne_zero,zero_mul,sub_zero] at f
    exact zero_ne_one f
  let a := z.x^(l-1)
  have an : (a:ZMod q)≠0 := by dsimp [a]; push_cast; exact pow_ne_zero _ xz
  have no {c : ℤ} (hc : (c:ZMod q)≠0) : ¬q∣c.natAbs :=
    fun dd => hc ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr (Int.natCast_dvd.mpr dd))
  by_cases same : l=q
  · subst l
    let c := a+(q:ℤ)*h*K
    have cn : ¬q∣c.natAbs := no (by simpa [c] using an)
    have nc : c.natAbs≠0 := fun e => cn (e ▸ dvd_zero q)
    have yq : (z^q).y=z.y*((q:ℤ)*c) := by
      rw [hy]
      dsimp only [a,c]
      linear_combination z.y*K*dint
    refine ⟨q*c.natAbs,?_,mul_ne_zero pq.ne_zero nc,?_⟩
    · rw [yq]; simp only [Int.natAbs_mul,Int.natAbs_natCast]
    · rw [Nat.factorization_mul pq.ne_zero nc,Finsupp.add_apply,Nat.factorization_eq_zero_of_not_dvd cn,add_zero]
  · have nl : ¬q∣l := fun h => same ((Nat.prime_dvd_prime_iff_eq pq pl).mp h).symm
    have lv : (l:ZMod q)≠0 := fun h => nl ((ZMod.natCast_eq_zero_iff _ _).mp h)
    let c := (l:ℤ)*a+(D:ℤ)*K
    have cn : ¬q∣c.natAbs := no (by
      dsimp only [c]
      push_cast
      rw [zd,zero_mul,add_zero]
      exact mul_ne_zero lv an)
    have nc : c.natAbs≠0 := fun e => cn (e ▸ dvd_zero q)
    refine ⟨c.natAbs,?_,nc,?_⟩
    · rw [hy,Int.natAbs_mul]
    · rw [Nat.factorization_eq_zero_of_not_dvd cn,Nat.factorization_eq_zero_of_not_dvd nl]

/-- At a prime whose square divides D, the imaginary coordinate of a Pell power gains exactly the exponent's valuation. -/
theorem pell_factorization_y_pow {D q n : ℕ} (eps : Pell.Solution₁ (D : ℤ))
    (pq : q.Prime) (dq : q^2∣D) (hn : 0<n) :
    (eps^n).y.natAbs.factorization q = (n*eps.y.natAbs).factorization q := by
  by_cases hzero : eps.y=0
  · obtain ⟨_,_,_,hy⟩ := pell_expansion_remainder eps (n-1)
    rw [Nat.sub_add_cancel hn,hzero,zero_mul] at hy
    simp [hy,hzero]
  have base : eps.y.natAbs≠0 := fun h => hzero (Int.natAbs_eq_zero.mp h)
  have all : ∀ j : ℕ, j≠0 → (eps^j).y.natAbs≠0 ∧
      (eps^j).y.natAbs.factorization q=(j*eps.y.natAbs).factorization q := by
    apply induction_on_primes
    · simp
    · simp [base]
    · intro l a pl ih nz
      have ap : a≠0 := fun e => nz (by rw [e,mul_zero])
      obtain ⟨nonzero,ihv⟩ := ih ap
      obtain ⟨k,mult,kpos,kv⟩ := pell_prime_multiplier (eps^a) pl pq dq
      have e : eps^(l*a)=(eps^a)^l := by rw [←pow_mul,Nat.mul_comm]
      rw [e,mult]
      refine ⟨mul_ne_zero nonzero kpos,?_⟩
      rw [Nat.factorization_mul nonzero kpos,Finsupp.add_apply,kv,ihv,Nat.mul_assoc,
        Nat.factorization_mul pl.ne_zero (mul_ne_zero ap base),Finsupp.add_apply,Nat.add_comm]
  exact (all n hn.ne').2
-- END PELL VALUATION

end Erdos889.PellValuation

namespace Erdos889.PellValuation

private theorem y_dvd_y_pow {D : ℤ} (z : Pell.Solution₁ D) (n : ℕ) : z.y ∣ (z^n).y := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ,Pell.Solution₁.y_mul]
    exact dvd_add (dvd_mul_left _ _) (dvd_mul_of_dvd_left ih _)

/-- An imaginary-coordinate zero modulo q at any fixed index h bounds the
q-adic valuation at every positive index by that of n times this coordinate. -/
theorem pell_factorization_y_le {D q n h : ℕ} (eps : Pell.Solution₁ (D:ℤ)) (pq : q.Prime)
    (hn : 0<n) (hp : 0<h) (hx : 0<eps.x) (hy : 0<eps.y)
    (hit : q∣(eps^h).y.natAbs) :
    ((eps^n).y.natAbs).factorization q ≤ (n*(eps^h).y.natAbs).factorization q := by
  let w := eps^h
  let M := w.y.natAbs
  have pos : 0<w.y := by
    obtain ⟨k,ek⟩ := Nat.exists_eq_succ_of_ne_zero hp.ne'
    change 0<(eps^h).y
    rw [ek]
    exact Pell.Solution₁.y_pow_succ_pos hx hy k
  have mp : 0<M := Int.natAbs_pos.mpr pos.ne'
  have castM : (M:ℤ)=w.y := Int.natAbs_of_nonneg pos.le
  let D' := D*M^2
  let u : Pell.Solution₁ (D':ℤ) := Pell.Solution₁.mk w.x 1 (by
    dsimp only [D']
    push_cast
    rw [castM]
    simpa only [one_pow,mul_one] using w.prop)
  have lift (i : ℕ) : (w^i).x=(u^i).x ∧ (w^i).y=w.y*(u^i).y := by
    induction i with
    | zero => simp
    | succ i ih =>
      rw [pow_succ,pow_succ]
      simp only [Pell.Solution₁.x_mul,Pell.Solution₁.y_mul,ih.1,ih.2]
      change _ = (u^i).x*w.x+(D':ℤ)*((u^i).y*1) ∧ _ = w.y*((u^i).x*1+(u^i).y*w.x)
      dsimp only [D']
      push_cast
      constructor
      · linear_combination -(D:ℤ)*(u^i).y*(w.y+(M:ℤ))*castM
      · ring
  have imag : ((eps^h)^n).y.natAbs=M*(u^n).y.natAbs := by rw [(lift n).2,Int.natAbs_mul]
  have md : q^2∣D' := dvd_mul_of_dvd_right (pow_dvd_pow_of_dvd hit 2) D
  have lte := pell_factorization_y_pow u pq md hn
  have un : (u^n).y.natAbs≠0 := by
    obtain ⟨k,ek⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
    have posU : 0<u.x := Pell.Solution₁.x_pow_pos hx h
    exact Int.natAbs_ne_zero.mpr (ek ▸ (Pell.Solution₁.y_pow_succ_pos posU (by change (0:ℤ)<1; decide) k).ne')
  have big : (((eps^h)^n).y).natAbs ≠ 0 := by rw [imag]; exact mul_ne_zero mp.ne' un
  have dv : (eps^n).y.natAbs∣((eps^h)^n).y.natAbs := by
    rw [←pow_mul,Nat.mul_comm,pow_mul]
    exact Int.natAbs_dvd_natAbs.mpr (y_dvd_y_pow (eps^n) h)
  have ns : 0<(eps^n).y := by
    obtain ⟨k,ek⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
    rw [ek]
    exact Pell.Solution₁.y_pow_succ_pos hx hy k
  have le := (Nat.factorization_le_iff_dvd (Int.natAbs_ne_zero.mpr ns.ne') big).mpr dv q
  rw [imag,Nat.factorization_mul mp.ne' un,Finsupp.add_apply,lte] at le
  change _ ≤ _ + (n*1).factorization q at le
  rw [Nat.factorization_mul hn.ne' mp.ne',Finsupp.add_apply]
  simpa only [mul_one,Nat.add_comm] using le

end Erdos889.PellValuation

namespace Erdos889.SevenSmooth

private theorem pell_growth {D : ℤ} (eps : Pell.Solution₁ D) (hx : 1 < eps.x)
    (hy : 0 < eps.y) (n : ℕ) : (2:ℤ)^n*eps.y ≤ (eps^(n+1)).y := by
  induction n with
  | zero => simp
  | succ n ih =>
    have sx := Pell.Solution₁.x_pow_pos (show 0 < eps.x by omega) (n+1)
    have sy := Pell.Solution₁.y_pow_succ_pos (show 0 < eps.x by omega) hy n
    have grow := mul_le_mul_of_nonneg_left (show (2:ℤ) ≤ eps.x by omega) sy.le
    rw [pow_succ, show n+1+1=(n+1)+1 by rfl, pow_succ eps (n+1),Pell.Solution₁.y_mul]
    nlinarith [mul_pos sx hy]


private structure Row where
  d : ℕ
  a : ℕ
  b : ℕ
  deriving DecidableEq

private def rows : List Row := [
  ⟨2,3,2⟩,⟨3,2,1⟩,⟨5,9,4⟩,⟨6,5,2⟩,⟨7,8,3⟩,⟨10,19,6⟩,⟨14,15,4⟩,⟨15,4,1⟩,
  ⟨21,55,12⟩,⟨30,11,2⟩,⟨35,6,1⟩,⟨42,13,2⟩,⟨70,251,30⟩,⟨105,41,4⟩,⟨210,29,2⟩]

private def factors : List (ℕ × ℕ) := [(2,4),(3,4),(5,2),(7,2)]

private def coord (r : Row) : ℕ → ℕ × ℕ
  | 0 => (1,0)
  | k+1 =>
    let v := coord r k
    (v.1*r.a+r.d*v.2*r.b,v.1*r.b+v.2*r.a)

private theorem row_ok : ∀ r ∈ rows, 1<r.a ∧ 0<r.b ∧ r.a^2=r.d*r.b^2+1 := by decide +kernel

private theorem row_min : ∀ r ∈ rows, ∀ a ∈ List.range (r.a+1), ∀ b ∈ List.range (r.b+1),
    1<a → 0<b → a^2=r.d*b^2+1 → a=r.a ∧ b=r.b := by decide +kernel

private theorem row_hit : ∀ r ∈ rows, ∀ v ∈ factors, ∃ h : Fin 9, 0 < h.val ∧
    v.1∣(coord r h.val).2 ∧ ¬v.1^(v.2+1)∣(coord r h.val).2 := by decide +kernel

private theorem index_check : ∀ r ∈ rows, ∀ k : Fin 33, (coord r k.val).2∣k.val*1587600 →
    (coord r k.val).1≤8749 := by decide +kernel

private theorem row_unit {r : Row} (hr : r∈rows) :
    ∃ g : Pell.Solution₁ (r.d:ℤ), Pell.IsFundamental g ∧ g.x=(r.a:ℤ) ∧ g.y=(r.b:ℤ) := by
  obtain ⟨ha,hb,eq⟩ := row_ok r hr
  have e : (r.a:ℤ)^2=(r.d:ℤ)*(r.b:ℤ)^2+1 := by exact_mod_cast eq
  let u : Pell.Solution₁ (r.d:ℤ) := Pell.Solution₁.mk r.a r.b (by linarith)
  have ux : 1<u.x := by change 1<(r.a:ℤ); exact_mod_cast ha
  have uy : 0<u.y := by change 0<(r.b:ℤ); exact_mod_cast hb
  obtain ⟨g,hg⟩ := Pell.IsFundamental.exists_of_not_isSquare
    (Pell.Solution₁.d_pos_of_one_lt_x ux) (Pell.Solution₁.d_nonsquare_of_one_lt_x ux)
  have gx := hg.1
  have gy := hg.2.1
  have leA := hg.x_le_x ux
  have leB := hg.y_le_y ux uy
  change g.x≤(r.a:ℤ) at leA
  change g.y≤(r.b:ℤ) at leB
  have norm : g.x.toNat^2=r.d*g.y.toNat^2+1 := by
    zify
    rw [Int.toNat_of_nonneg (by omega),Int.toNat_of_nonneg (by omega)]
    linarith [g.prop]
  have hit := row_min r hr g.x.toNat (List.mem_range.mpr (by omega)) g.y.toNat
    (List.mem_range.mpr (by omega)) (by omega) (by omega) norm
  exact ⟨g,hg,by omega,by omega⟩

private theorem coord_eq {r : Row} (g : Pell.Solution₁ (r.d:ℤ)) (ga : g.x=(r.a:ℤ))
    (gb : g.y=(r.b:ℤ)) (i : ℕ) :
    (g^i).x=((coord r i).1:ℤ) ∧ (g^i).y=((coord r i).2:ℤ) := by
  induction i with
  | zero => simp [coord]
  | succ i ih =>
    rw [pow_succ]
    simp only [Pell.Solution₁.x_mul,Pell.Solution₁.y_mul,ih.1,ih.2,ga,gb,coord,Nat.cast_add,Nat.cast_mul]
    simp [mul_assoc]

private theorem smooth_y_dvd {r : Row} (hr : r∈rows) (g : Pell.Solution₁ (r.d:ℤ))
    (hg : Pell.IsFundamental g) (ga : g.x=(r.a:ℤ)) (gb : g.y=(r.b:ℤ)) (i : ℕ) (hi : 0 < i)
    (smooth : ∀ p : ℕ, p.Prime → p∣(g^i).y.natAbs → p≤7) : (g^i).y.natAbs∣i*1587600 := by
  have nonzero (k : ℕ) (hk : 0<k) : (g^k).y.natAbs≠0 := by
    obtain ⟨t,ht⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
    exact Int.natAbs_ne_zero.mpr (ht ▸ (Pell.Solution₁.y_pow_succ_pos hg.x_pos hg.2.1 t).ne')
  apply (Nat.factorization_le_iff_dvd (nonzero i hi) (Nat.mul_pos hi (by decide)).ne').mp
  intro p
  by_cases yes : p.Prime ∧ p∣(g^i).y.natAbs
  · obtain ⟨pp,dp⟩ := yes
    have small := smooth p pp dp
    have pick : ∀ j : Fin 8, j.val.Prime → j.val ∈ factors.map Prod.fst := by decide +kernel
    obtain ⟨⟨q,e⟩,row,same⟩ := List.mem_map.mp (pick ⟨p,by omega⟩ pp)
    change q=p at same
    subst q
    obtain ⟨h,hh,dv,nd⟩ := row_hit r hr (p,e) row
    have Y : (g^h.val).y.natAbs=(coord r h.val).2 := by rw [(coord_eq g ga gb h.val).2]; rfl
    change p ∣ (coord r h.val).2 at dv
    change ¬p^(e+1)∣(coord r h.val).2 at nd
    rw [←Y] at dv nd
    have le := Erdos889.PellValuation.pell_factorization_y_le g pp hi hh hg.x_pos hg.2.1 dv
    have ee : ((g^h.val).y.natAbs).factorization p ≤ e := by
      rw [pp.pow_dvd_iff_le_factorization (nonzero h.val hh)] at nd
      omega
    have power : ∀ v ∈ factors, v.1^v.2∣1587600 := by decide +kernel
    have EC := (pp.pow_dvd_iff_le_factorization (by decide : (1587600:ℕ)≠0)).mp (power (p,e) row)
    rw [Nat.factorization_mul hi.ne' (nonzero h.val hh),Finsupp.add_apply] at le
    rw [Nat.factorization_mul hi.ne' (by decide),Finsupp.add_apply]
    omega
  · by_cases pp : p.Prime
    · have nd : ¬p∣(g^i).y.natAbs := fun d => yes ⟨pp,d⟩
      simp [Nat.factorization_eq_zero_of_not_dvd nd]
    · simp [Nat.factorization_eq_zero_of_not_prime _ pp]

private theorem linear_exp (k : ℕ) : 1587600*(k+33) < 2^(k+32) := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [show k+1+32=(k+32)+1 by omega,pow_succ]
    omega

private theorem seven_pell {r : Row} (hr : r∈rows) {x y : ℕ} (hx : 1 < x) (hy : 0 < y)
    (eq : x^2=r.d*y^2+1) (smooth : ∀ p : ℕ, p.Prime → p∣y → p≤7) : x≤8749 := by
  obtain ⟨g,hg,ga,gb⟩ := row_unit hr
  have e : (x:ℤ)^2=(r.d:ℤ)*(y:ℤ)^2+1 := by exact_mod_cast eq
  let w : Pell.Solution₁ (r.d:ℤ) := Pell.Solution₁.mk x y (by linarith)
  obtain ⟨i,hi⟩ := hg.eq_pow_of_nonneg (a:=w) (by change 0<(x:ℤ); omega) (by change 0≤(y:ℤ); positivity)
  have xx : (g^i).x=(x:ℤ) := by rw [←hi]; rfl
  have yy : (g^i).y=(y:ℤ) := by rw [←hi]; rfl
  have yi : (g^i).y.natAbs=y := by rw [yy]; rfl
  have ip : 0 < i := by
    by_contra! low
    have zi : i=0 := by omega
    rw [zi,pow_zero,Pell.Solution₁.y_one] at yy
    omega
  have dv := smooth_y_dvd hr g hg ga gb i ip (by rwa [yi])
  have le := Nat.le_of_dvd (Nat.mul_pos ip (by decide)) dv
  rw [yi] at le
  have i32 : i≤32 := by
    by_contra! high
    obtain ⟨k,ek⟩ := Nat.exists_eq_add_of_le (show 33 ≤ i by omega)
    have growth := pell_growth g hg.1 hg.2.1 (k+32)
    rw [show k+32+1=i by omega,yy,gb] at growth
    have gN : 2^(k+32)*r.b≤y := by exact_mod_cast growth
    have bb := (row_ok r hr).2.1
    have small := linear_exp k
    have lower := Nat.le_mul_of_pos_right (2^(k+32)) bb
    rw [Nat.mul_comm i 1587600] at le
    omega
  have coords := coord_eq g ga gb i
  have xc : (coord r i).1=x := by omega
  have yc : (coord r i).2=(g^i).y.natAbs := by rw [coords.2]; rfl
  have bound := index_check r hr ⟨i,by omega⟩ (yc ▸ dv)
  simpa only [xc] using bound


/-- The smaller member of a pair of consecutive 7-smooth positive integers
is at most 4374. The endpoint is attained by 4374 and 4375. -/
theorem consecutive_smooth_seven (a : ℕ) (smooth : ∀ p : ℕ, p.Prime → p∣a*(a+1) → p≤7) :
    a≤4374 := by
  by_cases az : a=0
  · omega
  have ap : 0 < a := Nat.pos_of_ne_zero az
  obtain ⟨D,z,dp,zp,fac,free⟩ := Nat.sq_mul_squarefree_of_pos (Nat.mul_pos ap (by omega : 0<a+1))
  have divD : D∣a*(a+1) := by rw [←fac]; exact dvd_mul_left _ _
  have d210 : D∣210 := by
    rw [←Nat.prod_primeFactors_of_squarefree free,Nat.prod_primeFactors_dvd_iff (by decide)]
    intro p hp
    have pp := Nat.prime_of_mem_primeFactors hp
    have small := smooth p pp ((Nat.dvd_of_mem_primeFactors hp).trans divD)
    have cert : ∀ k : Fin 8, k.val.Prime → k.val∣210 := by decide +kernel
    exact pp.mem_primeFactors (cert ⟨p,by omega⟩ pp) (by decide)
  have pell : (2*a+1)^2=D*(2*z)^2+1 := by nlinarith [fac]
  have dn : D≠1 := by
    intro one
    rw [one,one_mul] at pell
    have a1 : 2*z<2*a+1 := by nlinarith
    have a2 : 2*z+1≤2*a+1 := by omega
    have bad := Nat.pow_le_pow_left a2 2
    nlinarith
  have good : ∀ i : Fin 211, i.val∣210 → i.val≠1 → i.val∈rows.map Row.d := by decide +kernel
  have cap := Nat.le_of_dvd (by decide : 0<210) d210
  obtain ⟨r,hr,same⟩ := List.mem_map.mp (good ⟨D,by omega⟩ d210 dn)
  change r.d=D at same
  have sup (p : ℕ) (pp : p.Prime) (dv : p∣2*z) : p≤7 := by
    rcases pp.dvd_mul.mp dv with two|hit
    · have := Nat.le_of_dvd (by decide : 0<2) two; omega
    · apply smooth p pp
      rw [←fac]
      exact dvd_mul_of_dvd_left (hit.trans (dvd_pow_self z (by decide : (2:ℕ)≠0))) D
  have result := seven_pell hr (x:=2*a+1) (y:=2*z) (by omega) (by omega)
    (by rwa [same]) sup
  omega

theorem gap_two_smooth_seven (a : ℕ) (smooth : ∀ p : ℕ, p.Prime → p∣a*(a+2) → p≤7) :
    a≤8748 := by
  by_cases az : a=0
  · omega
  have ap : 0 < a := Nat.pos_of_ne_zero az
  obtain ⟨D,z,dp,zp,fac,free⟩ := Nat.sq_mul_squarefree_of_pos (Nat.mul_pos ap (by omega : 0<a+2))
  have divD : D∣a*(a+2) := by rw [←fac]; exact dvd_mul_left _ _
  have d210 : D∣210 := by
    rw [←Nat.prod_primeFactors_of_squarefree free,Nat.prod_primeFactors_dvd_iff (by decide)]
    intro p hp
    have pp := Nat.prime_of_mem_primeFactors hp
    have small := smooth p pp ((Nat.dvd_of_mem_primeFactors hp).trans divD)
    have cert : ∀ k : Fin 8, k.val.Prime → k.val∣210 := by decide +kernel
    exact pp.mem_primeFactors (cert ⟨p,by omega⟩ pp) (by decide)
  have pell : (a+1)^2=D*z^2+1 := by nlinarith [fac]
  have dn : D≠1 := by
    intro one
    rw [one,one_mul] at pell
    have a1 : z<a+1 := by nlinarith
    have a2 : z+1≤a+1 := by omega
    have bad := Nat.pow_le_pow_left a2 2
    nlinarith
  have good : ∀ i : Fin 211, i.val∣210 → i.val≠1 → i.val∈rows.map Row.d := by decide +kernel
  have cap := Nat.le_of_dvd (by decide : 0<210) d210
  obtain ⟨r,hr,same⟩ := List.mem_map.mp (good ⟨D,by omega⟩ d210 dn)
  change r.d=D at same
  have sup (p : ℕ) (pp : p.Prime) (dv : p∣z) : p≤7 := by
    apply smooth p pp
    rw [←fac]
    exact dvd_mul_of_dvd_left (dv.trans (dvd_pow_self z (by decide : (2:ℕ)≠0))) D
  have result := seven_pell hr (x:=a+1) (y:=z) (by omega) zp (by rwa [same]) sup
  omega

end Erdos889.SevenSmooth

namespace Erdos889.FiveMissingSeven

private theorem cycle {x t m : ℕ} (h : Nat.ModEq m (x^t) 1) (b : ℕ) :
    Nat.ModEq m (x^b) (x^(b%t)) := by
  calc
    x^b = x^(b%t)*(x^t)^(b/t) := by rw [←pow_mul,←pow_add,Nat.mod_add_div]
    _ ≡ x^(b%t)*1^(b/t) [MOD m] := (h.pow _).mul_left _
    _ = _ := by simp

private theorem supported {n j p : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (pp : p.Prime) (jp : 0 < j)
    (small : j<p) (dv : p∣n+j) {q : ℕ} (pq : q.Prime) (dq : q∣n+j) : q=p ∨ q≤j := by
  by_contra! h
  exact sparse j p q jp pp pq h.1.symm small h.2 dv dq

set_option maxHeartbeats 1200000 in
private theorem five_seven_at_one {n : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (large : 18000<n) (three : 3∣n)
    (d5 : 5∣n+4) (d7 : 7∣n+1) : False := by
  have pure : n+1=7^(n+1).primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd (by omega) (by
    intro p pp d
    rcases supported sparse (by decide : Nat.Prime 7) (by decide) (by decide) d7 pp d with h|h
    · exact h
    · have := pp.two_le; omega)
  let b := (n+1).primeFactorsList.length
  change n+1=7^b at pure
  have cyc := cycle (by decide : Nat.ModEq 200 (7^4) 1) b
  change 7^b%200=7^(b%4)%200 at cyc
  have mod200 : (n+4)%200=10 := by
    have low := Nat.mod_lt b (by decide : 0<4)
    interval_cases b%4 <;> norm_num at cyc <;> omega
  clear cyc pure b
  let t := (n+4)/200
  have lift : 10+200*t=n+4 := by simpa only [t,mod200] using Nat.mod_add_div (n+4) 200
  let m := 1+20*t
  have fac : n+4=10*m := by dsimp only [m]; omega
  obtain ⟨p,pp,dm⟩ := Nat.exists_prime_and_dvd (show m≠1 by omega)
  have d : p∣n+4 := fac ▸ dvd_mul_of_dvd_right dm 10
  rcases supported sparse (by decide : Nat.Prime 5) (by decide) (by decide) d5 pp d with e|h
  · subst p; dsimp only [m] at dm; omega
  · have pick : ∀ i : Fin 5, i.val.Prime → i.val=2 ∨ i.val=3 := by decide +kernel
    rcases pick ⟨p,by omega⟩ pp with e|e
    · change p=2 at e
      subst p; dsimp only [m] at dm; omega
    · change p=3 at e
      subst p; omega

/-- If the first positive multiple of five is reached at offset 2, 3, or 4,
seven divides every large exceptional multiple of six. -/
theorem seven_divides_of_five_shift {n j : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (large : 18000<n)
    (two : 2∣n) (three : 3∣n) (jlo : 2≤j) (jhi : j≤4) (dj : 5∣n+j) : 7∣n := by
  by_contra miss
  let k := 7-n%7
  have mod7 : n%7≠0 := fun e => miss (Nat.dvd_of_mod_eq_zero e)
  have smaller := Nat.mod_lt n (by decide : 0<7)
  have kp : 0<k := by dsimp only [k]; omega
  have kh : k<7 := by dsimp only [k]; omega
  have dk : 7∣n+k := by
    refine ⟨n/7+1,?_⟩
    have eq := Nat.mod_add_div n 7
    dsimp only [k]
    omega
  have sJ (p : ℕ) (pp : p.Prime) (d : p∣n+j) : p≤7 := by
    rcases supported sparse (by decide : Nat.Prime 5) (by omega) (by omega) dj pp d with h|h <;> omega
  have sK (p : ℕ) (pp : p.Prime) (d : p∣n+k) : p≤7 := by
    rcases supported sparse (by decide : Nat.Prime 7) kp kh dk pp d with h|h <;> omega
  have ne : k≠j := by
    intro h
    rw [h] at dk
    exact sparse j 5 7 (by omega) (by decide) (by decide) (by decide) (by omega) (by omega) dj dk
  have gap {a g d : ℕ} (kind : d=1 ∨ d=2) (size : 8748<a)
      (lo : g*a=n+j ∨ g*a=n+k) (hi : g*(a+d)=n+j ∨ g*(a+d)=n+k) : False := by
    have lift {p u : ℕ} (pp : p.Prime) (dv : p∣u) (side : g*u=n+j ∨ g*u=n+k) : p≤7 := by
      have sh := dvd_mul_of_dvd_right dv g
      rcases side with h|h
      · exact sJ p pp (h ▸ sh)
      · exact sK p pp (h ▸ sh)
    have factors (p : ℕ) (pp : p.Prime) (dv : p∣a*(a+d)) : p≤7 := by
      rcases pp.dvd_mul.mp dv with h|h
      · exact lift pp h lo
      · exact lift pp h hi
    rcases kind with rfl|rfl
    · have := Erdos889.SevenSmooth.consecutive_smooth_seven a factors; omega
    · have := Erdos889.SevenSmooth.gap_two_smooth_seven a factors; omega
  by_cases near : j≤k+2 ∧ k≤j+2
  · by_cases ord : j≤k
    · exact gap (g:=1) (a:=n+j) (d:=k-j) (by omega) (by omega) (Or.inl (by omega)) (Or.inr (by omega))
    · exact gap (g:=1) (a:=n+k) (d:=j-k) (by omega) (by omega) (Or.inr (by omega)) (Or.inl (by omega))
  have cases : (j=2 ∧ k=5) ∨ (j=2 ∧ k=6) ∨ (j=3 ∧ k=6) ∨ (j=4 ∧ k=1) := by omega
  rcases cases with h|h|h|h
  · obtain ⟨hj,hk⟩ := h
    have pure : n+5=7^(n+5).primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd (by omega) (by
      intro p pp dp
      have dv : p∣n+k := by rwa [hk]
      rcases supported sparse (by decide : Nat.Prime 7) kp kh dk pp dv with e|e
      · exact e
      · have pick : ∀ i : Fin 6, i.val.Prime → i.val=2 ∨ i.val=3 ∨ i.val=5 := by decide +kernel
        rcases pick ⟨p,by omega⟩ pp with z|z|z <;> change p=_ at z <;> subst p <;> omega)
    have mod3 := (show Nat.ModEq 3 7 1 by decide).pow (n+5).primeFactorsList.length
    rw [one_pow,←pure] at mod3
    change (n+5)%3=1 at mod3
    omega
  · obtain ⟨hj,hk⟩ := h
    exact gap (g:=2) (a:=(n+2)/2) (d:=2) (Or.inr rfl) (by omega) (Or.inl (by omega)) (Or.inr (by omega))
  · obtain ⟨hj,hk⟩ := h
    have threeGap {a : ℕ} (dv : ∀ p : ℕ, p.Prime → p∣a*(a+1) → p≤7) : a≤4374 :=
      Erdos889.SevenSmooth.consecutive_smooth_seven a dv
    let a := (n+3)/3
    have eq₁ : n+j=3*a := by dsimp only [a]; omega
    have eq₂ : n+k=3*(a+1) := by dsimp only [a]; omega
    have small : a≤4374 := threeGap (by
      intro p pp dp
      rcases pp.dvd_mul.mp dp with dv|dv
      · exact sJ _ pp (eq₁ ▸ dvd_mul_of_dvd_right dv 3)
      · exact sK _ pp (eq₂ ▸ dvd_mul_of_dvd_right dv 3))
    dsimp only [a] at small
    omega
  · obtain ⟨rfl,hk⟩ := h
    exact five_seven_at_one sparse large three dj (by rwa [hk] at dk)


private theorem five_binary_at_four {n : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (three : 3∣n) (dj : 5∣n+4) :
    ∃ a b : ℕ, n+4=2^a*5^b := by
  let m := (n+4)/2^(n+4).factorization 2
  have form : 2^(n+4).factorization 2*m=n+4 := Nat.ordProj_mul_ordCompl_eq_self _ _
  have nz : n+4≠0 := by omega
  have pos : 0 < m := Nat.ordCompl_pos 2 nz
  have nd : ¬2∣m := Nat.not_dvd_ordCompl Nat.prime_two nz
  have pure : m=5^m.primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd pos.ne' (by
    intro p pp dm
    have d : p∣n+4 := form ▸ dvd_mul_of_dvd_right dm _
    rcases supported sparse (by decide : Nat.Prime 5) (by decide) (by decide) dj pp d with e|h
    · exact e
    · have pick : ∀ i : Fin 5, i.val.Prime → i.val=2 ∨ i.val=3 := by decide +kernel
      rcases pick ⟨p,by omega⟩ pp with z|z
      · change p=2 at z
        subst p; contradiction
      · change p=3 at z
        subst p; omega)
  exact ⟨_,_,by rw [←pure]; exact form.symm⟩

private theorem large_neighbour {z : ℕ} (large : 4375 < z) (smooth : ∀ p : ℕ, p.Prime → p∣z → p≤7) :
    (∃ p : ℕ, p.Prime ∧ 7<p ∧ p∣z-1) ∧ (∃ p : ℕ, p.Prime ∧ 7<p ∧ p∣z+1) := by
  constructor
  · by_contra missing
    have bound := Erdos889.SevenSmooth.consecutive_smooth_seven (z-1) (by
      intro p pp d
      rcases pp.dvd_mul.mp d with dv|dv
      · by_contra! high
        exact missing ⟨p,pp,high,dv⟩
      · exact smooth p pp (by rwa [show z-1+1=z by omega] at dv))
    omega
  · by_contra missing
    have bound := Erdos889.SevenSmooth.consecutive_smooth_seven z (by
      intro p pp d
      rcases pp.dvd_mul.mp d with dv|dv
      · exact smooth p pp dv
      · by_contra! high
        exact missing ⟨p,pp,high,dv⟩)
    omega

/-- A large exceptional multiple of six cannot be one modulo five. -/
theorem no_five_at_four {n : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (large : 20000000<n)
    (two : 2∣n) (three : 3∣n) (dj : 5∣n+4) : False := by
  have seven := seven_divides_of_five_shift sparse (by omega) two three (by decide : 2≤4) (by decide) dj
  have full : 21∣n := (by decide : Nat.Coprime 3 7).mul_dvd_of_dvd_of_dvd three seven
  obtain ⟨a,b,eq⟩ := five_binary_at_four sparse three dj
  have res := (cycle (by decide : Nat.ModEq 21 (2^6) 1) a).mul (cycle (by decide : Nat.ModEq 21 (5^6) 1) b)
  change (2^a*5^b)%21=(2^(a%6)*5^(b%6))%21 at res
  rw [←eq] at res
  have tab : ∀ i j : Fin 6, (2^i.val*5^j.val)%21=4 → i.val%2=0 ∧ j.val%2=0 := by decide +kernel
  have pars := tab ⟨a%6,Nat.mod_lt _ (by decide)⟩ ⟨b%6,Nat.mod_lt _ (by decide)⟩ (by simp only; omega)
  change (a%6)%2=0 ∧ (b%6)%2=0 at pars
  let z := 2^(a/2)*5^(b/2)
  have square : n+4=z^2 := by
    rw [eq]
    dsimp only [z]
    rw [mul_pow,←pow_mul,←pow_mul]
    congr 2 <;> omega
  have lz : 4375 < z := by
    by_contra! small
    have := Nat.pow_le_pow_left small 2
    omega
  have smooth (p : ℕ) (pp : p.Prime) (d : p∣z) : p≤7 := by
    dsimp only [z] at d
    rcases pp.dvd_mul.mp d with h|h
    · have := Nat.le_of_dvd (by decide : 0<2) (pp.dvd_of_dvd_pow h); omega
    · have := Nat.le_of_dvd (by decide : 0<5) (pp.dvd_of_dvd_pow h); omega
  obtain ⟨⟨p,pp,lp,dp⟩,⟨q,pq,lq,dq⟩⟩ := large_neighbour lz smooth
  have fac : n+3=(z-1)*(z+1) := by
    have pos : z-1+1=z := by omega
    nlinarith [congrArg (fun t : ℕ => t*(z+1)) pos]
  have ne : p≠q := by
    rintro rfl
    have d2 := Nat.dvd_sub dq dp
    rw [show z+1-(z-1)=2 by omega] at d2
    have := Nat.le_of_dvd (by decide : 0<2) d2
    omega
  exact sparse 3 p q (by decide) pp pq ne (by omega) (by omega)
    (fac ▸ dvd_mul_of_dvd_left dp _) (fac ▸ dvd_mul_of_dvd_right dq _)


private theorem large_cubic_cofactor (u : ℕ) (hu : 5<u) :
    ∃ p : ℕ, p.Prime ∧ 6<p ∧ p∣u^2+u+1 := by
  let R := u^2+u+1
  have table : ∀ t : Fin 90, let v := t.val^2+t.val+1
    ¬2∣v ∧ ¬5∣v ∧ ¬9∣v := by decide +kernel
  have small := table ⟨u%90,Nat.mod_lt _ (by decide)⟩
  let r := u%90
  change ¬2∣r^2+r+1 ∧ ¬5∣r^2+r+1 ∧ ¬9∣r^2+r+1 at small
  have mod := (((Nat.mod_modEq u 90).pow 2).add (Nat.mod_modEq u 90)).add_right 1
  change Nat.ModEq 90 (r^2+r+1) R at mod
  have pass {c : ℕ} (cd : c∣90) (d : c∣R) : c∣r^2+r+1 :=
    Nat.modEq_zero_iff_dvd.mp ((mod.of_dvd cd).trans (Nat.modEq_zero_iff_dvd.mpr d))
  by_contra missing
  have f : R=3^R.primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd (by dsimp only [R]; omega) (by
    intro p pp d
    have low : p≤6 := by by_contra! high; exact missing ⟨p,pp,high,d⟩
    have tab : ∀ t : Fin 7, t.val.Prime → t.val=2 ∨ t.val=3 ∨ t.val=5 := by decide +kernel
    rcases tab ⟨p,by omega⟩ pp with a|a|a <;> change p=_ at a <;> subst p
    · exact (small.1 (pass (by decide) d)).elim
    · rfl
    · exact (small.2.1 (pass (by decide) d)).elim)
  have len : 2≤R.primeFactorsList.length := by
    by_contra! h
    have smallE : R.primeFactorsList.length=0 ∨ R.primeFactorsList.length=1 := by omega
    rcases smallE with e|e <;> rw [e] at f <;> dsimp [R] at f <;> omega
  exact small.2.2 (pass (by decide : 9∣90) (f ▸ pow_dvd_pow 3 len))

private theorem normalized_cube {n k z : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (large : 1000000000000<n)
    (kp : 0<k) (kh : k≤3) (eq : n+k=k*z^3) (smooth : ∀ p : ℕ, p.Prime → p∣z → p≤7) : False := by
  have huge : 4375 < z := by
    by_contra! low
    have := Nat.mul_le_mul kh (Nat.pow_le_pow_left low 3)
    omega
  obtain ⟨q,pq,lq,dq⟩ := (large_neighbour huge smooth).2
  let u := z-1
  have eu : z=u+1 := by dsimp only [u]; omega
  obtain ⟨r,pr,lr,dr⟩ := large_cubic_cofactor u (by omega)
  have ne : q≠r := by
    rintro rfl
    change q∣u^2+u+1 at dr
    have de : q∣u+2 := by rwa [show u+2=z+1 by omega]
    have mult : q∣(u-1)*(u+2) := dvd_mul_of_dvd_right de (u-1)
    have fac : u^2+u+1=(u-1)*(u+2)+3 := by
      have up : u-1+1=u := by omega
      nlinarith [congrArg (fun t : ℕ => t*(u+2)) up]
    rw [fac] at dr
    have d3 := (Nat.dvd_add_iff_right mult).mpr dr
    have := Nat.le_of_dvd (by decide : 0<3) d3
    omega
  have off : n+2*k=k*((z+1)*(u^2+u+1)) := by
    have ident : (z+1)*(u^2+u+1)=z^3+1 := by rw [eu]; ring
    rw [ident,Nat.mul_add,mul_one]
    omega
  exact sparse (2*k) q r (by omega) pq pr ne (by omega) (by omega)
    (off ▸ dvd_mul_of_dvd_right (dvd_mul_of_dvd_left dq _) _)
    (off ▸ dvd_mul_of_dvd_right (dvd_mul_of_dvd_right dr _) _)

/-- The exponent of five in either remaining shift is indivisible by three. -/
theorem no_cube_at_five_shift {n k a b : ℕ} (sparse : (∀ k p q : ℕ, 0 < k → p.Prime → q.Prime → p≠q →
  k<p → k<q → p∣n+k → q∣n+k → False)) (large : 1000000000000<n)
    (two : 2∣n) (three : 3∣n) (offset : k=2 ∨ k=3) (bp : 0<b)
    (eq : n+k=k^a*5^b) : ¬3∣b := by
  intro db
  have kp : 0<k := by omega
  have kh : k≤3 := by omega
  have dj : 5∣n+k := eq ▸ dvd_mul_of_dvd_right (dvd_pow_self _ bp.ne') _
  have seven := seven_divides_of_five_shift sparse (by omega) two three (by omega) (by omega) dj
  have cycleK : Nat.ModEq 7 (k^6) 1 := by rcases offset with rfl|rfl <;> decide
  have residue := (cycle cycleK a).mul (cycle (by decide : Nat.ModEq 7 (5^6) 1) b)
  change (k^a*5^b)%7=(k^(a%6)*5^(b%6))%7 at residue
  rw [←eq] at residue
  have target : (k^(a%6)*5^(b%6))%7=k := by omega
  have tab : ∀ w ∈ [2,3], ∀ i j : Fin 6, (w^i.val*5^j.val)%7=w → j.val%3=0 → i.val%3=1 := by decide +kernel
  have par := tab k (by simpa using offset) ⟨a%6,Nat.mod_lt _ (by decide)⟩ ⟨b%6,Nat.mod_lt _ (by decide)⟩
    target (by change b%6%3=0; omega)
  change a%6%3=1 at par
  let z := k^(a/3)*5^(b/3)
  have cube : n+k=k*z^3 := by
    rw [eq]
    dsimp only [z]
    rw [mul_pow,←pow_mul,←pow_mul]
    have ae : a=1+(a/3)*3 := by omega
    have be : b=(b/3)*3 := by omega
    calc
      _ = k^(1+(a/3)*3)*5^((b/3)*3) := by rw [←ae,←be]
      _ = _ := by rw [pow_add,pow_one]; ring
  apply normalized_cube sparse large kp kh cube
  intro p pp d
  dsimp only [z] at d
  rcases pp.dvd_mul.mp d with h|h
  · have := Nat.le_of_dvd kp (pp.dvd_of_dvd_pow h); omega
  · have := Nat.le_of_dvd (by decide : 0<5) (pp.dvd_of_dvd_pow h); omega

end Erdos889.FiveMissingSeven
namespace Erdos889.QuadraticTwenty

private theorem pell_growth {D : ℤ} (eps : Pell.Solution₁ D) (hx : 1 < eps.x)
    (hy : 0 < eps.y) (n : ℕ) : (2:ℤ)^n*eps.y ≤ (eps^(n+1)).y := by
  induction n with
  | zero => simp
  | succ n ih =>
    have sx := Pell.Solution₁.x_pow_pos (show 0 < eps.x by omega) (n+1)
    have sy := Pell.Solution₁.y_pow_succ_pos (show 0 < eps.x by omega) hy n
    have grow := mul_le_mul_of_nonneg_left (show (2:ℤ) ≤ eps.x by omega) sy.le
    rw [pow_succ, show n+1+1=(n+1)+1 by rfl, pow_succ eps (n+1),Pell.Solution₁.y_mul]
    nlinarith [mul_pos sx hy]


private structure Row where
  d : ℕ
  a : ℕ
  b : ℕ
  deriving DecidableEq

private def rows : List Row := [
  ⟨2,3,2⟩,⟨10,19,6⟩,⟨26,51,10⟩,⟨34,35,6⟩,
  ⟨130,6499,570⟩,⟨170,339,26⟩,⟨442,883,42⟩,⟨2210,4419,94⟩]

private def factors : List (ℕ × ℕ) := [(5,1),(13,2),(17,1)]

private def coord (r : Row) : ℕ → ℕ × ℕ
  | 0 => (1,0)
  | k+1 =>
    let v := coord r k
    (v.1*r.a+r.d*v.2*r.b,v.1*r.b+v.2*r.a)

private theorem row_ok : ∀ r ∈ rows, 1<r.a ∧ 0<r.b ∧ r.a^2=r.d*r.b^2+1 := by decide +kernel

private theorem row_min : ∀ r ∈ rows, ∀ b ∈ List.range (r.b+1),
    0<b → let a := (r.d*b^2+1).sqrt
    a^2=r.d*b^2+1 → a=r.a ∧ b=r.b := by decide +kernel

private theorem row_hit : ∀ r ∈ rows, ∀ v ∈ factors, ∃ h : Fin 18, 0 < h.val ∧
    v.1∣(coord r h.val).2 ∧ ¬v.1^(v.2+1)∣(coord r h.val).2 := by decide +kernel

private theorem index_check : ∀ r ∈ rows, ∀ k : Fin 65, let A := (coord r k.val).1
    A+1≤2*r.d*(k.val*14365)^2 → let Y := ((A+1)/(2*r.d)).sqrt
    A+1=2*r.d*Y^2 → Y∣k.val*14365 → A≤2*239^2+1 := by decide +kernel

private theorem row_unit {r : Row} (hr : r∈rows) :
    ∃ g : Pell.Solution₁ (r.d:ℤ), Pell.IsFundamental g ∧ g.x=(r.a:ℤ) ∧ g.y=(r.b:ℤ) := by
  obtain ⟨ha,hb,eq⟩ := row_ok r hr
  have e : (r.a:ℤ)^2=(r.d:ℤ)*(r.b:ℤ)^2+1 := by exact_mod_cast eq
  let u : Pell.Solution₁ (r.d:ℤ) := Pell.Solution₁.mk r.a r.b (by linarith)
  have ux : 1<u.x := by change 1<(r.a:ℤ); exact_mod_cast ha
  have uy : 0<u.y := by change 0<(r.b:ℤ); exact_mod_cast hb
  obtain ⟨g,hg⟩ := Pell.IsFundamental.exists_of_not_isSquare
    (Pell.Solution₁.d_pos_of_one_lt_x ux) (Pell.Solution₁.d_nonsquare_of_one_lt_x ux)
  have gx := hg.1
  have gy := hg.2.1
  have leA := hg.x_le_x ux
  have leB := hg.y_le_y ux uy
  change g.x≤(r.a:ℤ) at leA
  change g.y≤(r.b:ℤ) at leB
  have norm : g.x.toNat^2=r.d*g.y.toNat^2+1 := by
    zify
    rw [Int.toNat_of_nonneg (by omega),Int.toNat_of_nonneg (by omega)]
    linarith [g.prop]
  have root : (r.d*g.y.toNat^2+1).sqrt=g.x.toNat := by rw [←norm,Nat.sqrt_eq']
  have hit := row_min r hr g.y.toNat (List.mem_range.mpr (by omega)) (by omega)
  dsimp only at hit
  rw [root] at hit
  specialize hit norm
  exact ⟨g,hg,by omega,by omega⟩

private theorem coord_eq {r : Row} (g : Pell.Solution₁ (r.d:ℤ)) (ga : g.x=(r.a:ℤ))
    (gb : g.y=(r.b:ℤ)) (i : ℕ) :
    (g^i).x=((coord r i).1:ℤ) ∧ (g^i).y=((coord r i).2:ℤ) := by
  induction i with
  | zero => simp [coord]
  | succ i ih =>
    rw [pow_succ]
    simp only [Pell.Solution₁.x_mul,Pell.Solution₁.y_mul,ih.1,ih.2,ga,gb,coord,Nat.cast_add,Nat.cast_mul]
    simp [mul_assoc]

private theorem smooth_divides {r : Row} (hr : r∈rows) (g : Pell.Solution₁ (r.d:ℤ))
    (hg : Pell.IsFundamental g) (ga : g.x=(r.a:ℤ)) (gb : g.y=(r.b:ℤ)) (i y : ℕ) (hi : 0 < i)
    (hy : 0 < y) (dvy : y∣(g^i).y.natAbs)
    (smooth : ∀ p : ℕ, p.Prime → p∣y → p=5 ∨ p=13 ∨ p=17) : y∣i*14365 := by
  have nonzero (k : ℕ) (hk : 0<k) : (g^k).y.natAbs≠0 := by
    obtain ⟨t,ht⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
    exact Int.natAbs_ne_zero.mpr (ht ▸ (Pell.Solution₁.y_pow_succ_pos hg.x_pos hg.2.1 t).ne')
  apply (Nat.factorization_le_iff_dvd hy.ne' (Nat.mul_pos hi (by decide)).ne').mp
  intro p
  by_cases yes : p.Prime ∧ p∣y
  · obtain ⟨pp,dp⟩ := yes
    have small := smooth p pp dp
    have pick : p ∈ factors.map Prod.fst := by rcases small with rfl|rfl|rfl <;> decide
    obtain ⟨⟨q,e⟩,row,same⟩ := List.mem_map.mp pick
    change q=p at same
    subst q
    obtain ⟨h,hh,dv,nd⟩ := row_hit r hr (p,e) row
    have Y : (g^h.val).y.natAbs=(coord r h.val).2 := by rw [(coord_eq g ga gb h.val).2]; rfl
    change p ∣ (coord r h.val).2 at dv
    change ¬p^(e+1)∣(coord r h.val).2 at nd
    rw [←Y] at dv nd
    have le := Erdos889.PellValuation.pell_factorization_y_le g pp hi hh hg.x_pos hg.2.1 dv
    have sub := (Nat.factorization_le_iff_dvd hy.ne' (nonzero i hi)).mpr dvy p
    have ee : ((g^h.val).y.natAbs).factorization p ≤ e := by
      rw [pp.pow_dvd_iff_le_factorization (nonzero h.val hh)] at nd
      omega
    have power : ∀ v ∈ factors, v.1^v.2∣14365 := by decide +kernel
    have EC := (pp.pow_dvd_iff_le_factorization (by decide : (14365:ℕ)≠0)).mp (power (p,e) row)
    rw [Nat.factorization_mul hi.ne' (nonzero h.val hh),Finsupp.add_apply] at le
    rw [Nat.factorization_mul hi.ne' (by decide),Finsupp.add_apply]
    omega
  · by_cases pp : p.Prime
    · have nd : ¬p∣y := fun d => yes ⟨pp,d⟩
      simp [Nat.factorization_eq_zero_of_not_dvd nd]
    · simp [Nat.factorization_eq_zero_of_not_prime _ pp]


private theorem index_exp (k : ℕ) : 2*2210*((k+65)*14365)^2 < 2^(k+64) := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [show k+1+64=(k+64)+1 by omega,pow_succ 2 (k+64)]
    have h : 2*2210*((k+1+65)*14365)^2 ≤ 2*(2*2210*((k+65)*14365)^2) := by ring_nf; omega
    exact h.trans_lt (by rw [Nat.mul_comm (2^(k+64)) 2]; exact Nat.mul_lt_mul_of_pos_left ih (by decide))

private theorem quadratic_pell {r : Row} (hr : r∈rows) {x y : ℕ} (hx : 0 < x) (hy : 0 < y)
    (eq : x^2+1=r.d*y^2) (smooth : ∀ p : ℕ, p.Prime → p∣y → p=5 ∨ p=13 ∨ p=17) : x≤239 := by
  obtain ⟨g,hg,ga,gb⟩ := row_unit hr
  have e : (x:ℤ)^2+1=(r.d:ℤ)*(y:ℤ)^2 := by exact_mod_cast eq
  have norm : ((2:ℤ)*x^2+1)^2-r.d*(2*(x:ℤ)*y)^2=1 := by linear_combination 4*(x:ℤ)^2*e
  let w : Pell.Solution₁ (r.d:ℤ) := Pell.Solution₁.mk _ _ norm
  obtain ⟨i,hi⟩ := hg.eq_pow_of_nonneg (a:=w)
    (by change 0<2*(x:ℤ)^2+1; positivity) (by change 0≤2*(x:ℤ)*y; positivity)
  have xx : (g^i).x=2*(x:ℤ)^2+1 := by rw [←hi]; rfl
  have yy : (g^i).y=2*(x:ℤ)*y := by rw [←hi]; rfl
  have ydiv : y∣(g^i).y.natAbs := by rw [yy,Int.natAbs_mul,Int.natAbs_natCast]; exact dvd_mul_left _ _
  have ip : 0 < i := by
    by_contra! low
    have zi : i=0 := by omega
    rw [zi,pow_zero,Pell.Solution₁.y_one] at yy
    have : 0<2*(x:ℤ)*y := by positivity
    omega
  have dv := smooth_divides hr g hg ga gb i y ip hy ydiv smooth
  have le := Nat.le_of_dvd (Nat.mul_pos ip (by decide)) dv
  have range : ∀ r ∈ rows, 0<r.d ∧ r.d≤2210 := by decide +kernel
  obtain ⟨dpos,dcap⟩ := range r hr
  have xdy : x≤r.d*y := by
    by_contra! bad
    have h := Nat.mul_le_mul (show 1 ≤ r.d by omega) (Nat.le_refl (r.d*y^2))
    nlinarith [Nat.mul_self_lt_mul_self bad]
  have i64 : i≤64 := by
    by_contra! big
    obtain ⟨k,ek⟩ := Nat.exists_eq_add_of_le (show 65 ≤ i by omega)
    have growth := pell_growth g hg.1 hg.2.1 (k+64)
    rw [show k+64+1=i by omega,yy,gb] at growth
    have gN : 2^(k+64)*r.b≤2*x*y := by exact_mod_cast growth
    have lb := Nat.le_mul_of_pos_right (2^(k+64)) (row_ok r hr).2.1
    have ub : 2*x*y ≤ 2*2210*((k+65)*14365)^2 := by
      rw [show k+65=i by omega]
      calc
        _ ≤ 2*(r.d*y)*y := Nat.mul_le_mul_right y (Nat.mul_le_mul_left 2 xdy)
        _ = 2*r.d*y^2 := by ring
        _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul_left 2 dcap) (Nat.pow_le_pow_left le 2)
    have := index_exp k
    omega
  have coords := coord_eq g ga gb i
  have xc : (coord r i).1=2*x^2+1 := by exact_mod_cast (coords.1.symm.trans xx)
  have image : (coord r i).1+1=2*r.d*y^2 := by rw [xc]; nlinarith
  have root : (((coord r i).1+1)/(2*r.d)).sqrt=y := by
    rw [image,Nat.mul_div_cancel_left _ (by omega : 0 < 2*r.d),Nat.sqrt_eq']
  have ub : (coord r i).1+1≤2*r.d*(i*14365)^2 := by
    rw [image]
    exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left le 2)
  have small := index_check r hr ⟨i,by omega⟩ ub
  change (coord r i).1+1=2*r.d*((((coord r i).1+1)/(2*r.d)).sqrt)^2 → _ at small
  rw [root] at small
  have := small image dv
  nlinarith

/-- Exact largest odd x whose square plus one has the given four-prime support. -/
theorem square_add_one_smooth_twenty {x i j k : ℕ} (eq : x^2+1=2*5^i*13^j*17^k) : x≤239 := by
  by_cases xz : x=0
  · omega
  let D := 2*5^(i%2)*13^(j%2)*17^(k%2)
  let y := 5^(i/2)*13^(j/2)*17^(k/2)
  have fac (q b : ℕ) : q^b=q^(b%2)*(q^(b/2))^2 := by
    rw [←pow_mul,←pow_add,Nat.mul_comm (b/2) 2,Nat.mod_add_div]
  have shape : x^2+1=D*y^2 := by
    rw [eq,fac 5 i,fac 13 j,fac 17 k]
    dsimp [D,y]
    ring
  have table : ∀ a b c : Fin 2, 2*5^a.val*13^b.val*17^c.val ∈ rows.map Row.d := by decide +kernel
  obtain ⟨r,hr,same⟩ := List.mem_map.mp
    (table ⟨i%2,Nat.mod_lt _ (by decide)⟩ ⟨j%2,Nat.mod_lt _ (by decide)⟩ ⟨k%2,Nat.mod_lt _ (by decide)⟩)
  change r.d=D at same
  apply quadratic_pell hr (Nat.pos_of_ne_zero xz) (show 0<y by dsimp [y]; positivity) (by rwa [same])
  intro p pp dv
  dsimp only [y] at dv
  rcases pp.dvd_mul.mp dv with h|h
  · rcases pp.dvd_mul.mp h with h|h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq pp (by decide : Nat.Prime 5)).mp (pp.dvd_of_dvd_pow h))
    · exact Or.inr (Or.inl ((Nat.prime_dvd_prime_iff_eq pp (by decide : Nat.Prime 13)).mp (pp.dvd_of_dvd_pow h)))
  · exact Or.inr (Or.inr ((Nat.prime_dvd_prime_iff_eq pp (by decide : Nat.Prime 17)).mp (pp.dvd_of_dvd_pow h)))

end Erdos889.QuadraticTwenty


namespace Erdos889.ExactTwiceFourth

private theorem cube_le_two_pow {m : ℕ} (hm : 10 ≤ m) : m^3≤2^m := by
  induction m,hm using Nat.le_induction with
  | base => decide
  | succ k hk ih =>
    rw [pow_succ 2 k]
    have step : (k+1)^3≤2*k^3 := by
      have k2 : 5*k ≤ k^2 := by nlinarith [Nat.mul_le_mul_right k (show 5 ≤ k by omega)]
      nlinarith [Nat.mul_le_mul_right (k^2) (show 5 ≤ k by omega)]
    omega

private theorem pell_growth {D : ℤ} (eps : Pell.Solution₁ D) (hx : 1 < eps.x)
    (hy : 0 < eps.y) (n : ℕ) : (2:ℤ)^n*eps.y ≤ (eps^(n+1)).y := by
  induction n with
  | zero => simp
  | succ n ih =>
    have sx := Pell.Solution₁.x_pow_pos (show 0 < eps.x by omega) (n+1)
    have sy := Pell.Solution₁.y_pow_succ_pos (show 0 < eps.x by omega) hy n
    have grow := mul_le_mul_of_nonneg_left (show (2:ℤ) ≤ eps.x by omega) sy.le
    rw [pow_succ, show n+1+1=(n+1)+1 by rfl, pow_succ eps (n+1),Pell.Solution₁.y_mul]
    nlinarith [mul_pos sx hy]

private theorem explicit_twist_bound (D : ℕ) (upper : Pell.Solution₁ (D : ℤ))
    (ux : 1 < upper.x) (uy : 0 < upper.y) (x y : ℕ) (hy : 0 < y) (eq : x^2+1=D*y^2)
    (support : ∀ q : ℕ, q.Prime → q∣y → q^2∣D) :
    x ≤ D*(10+4*D*upper.y.natAbs)*upper.y.natAbs := by
  obtain ⟨eps,he⟩ := Pell.IsFundamental.exists_of_not_isSquare
    (Pell.Solution₁.d_pos_of_one_lt_x ux) (Pell.Solution₁.d_nonsquare_of_one_lt_x ux)
  let Y := eps.y.natAbs
  by_cases hx : x=0
  · omega
  have castEq : (x:ℤ)^2+1=(D:ℤ)*(y:ℤ)^2 := by exact_mod_cast eq
  have id : ((2:ℤ)*x^2+1)^2-D*(2*(x:ℤ)*y)^2=1 := by
    linear_combination -4*(x:ℤ)^2*(castEq.symm)
  let sol : Pell.Solution₁ (D:ℤ) := Pell.Solution₁.mk _ _ id
  have sx : sol.x=2*(x:ℤ)^2+1 := rfl
  have sy : sol.y=2*(x:ℤ)*y := rfl
  obtain ⟨n,hn⟩ := he.eq_pow_of_nonneg (a:=sol) (by rw [sx]; positivity) (by rw [sy]; positivity)
  have nz : 0 < n := by
    by_contra! h
    have : n=0 := by omega
    rw [this,pow_zero] at hn
    have eqy := congrArg Pell.Solution₁.y hn
    rw [sy,Pell.Solution₁.y_one] at eqy
    have : 0<(x:ℤ) := by exact_mod_cast Nat.pos_of_ne_zero hx
    have pos : 0<2*(x:ℤ)*y := by positivity
    omega
  have YY : 0 < Y := by dsimp [Y]; exact Int.natAbs_pos.mpr he.2.1.ne'
  have imag : (eps^n).y.natAbs=2*x*y := by
    rw [←hn,sy,Int.natAbs_mul,Int.natAbs_mul]
    rfl
  have ydiv : y∣n*Y := by
    apply (Nat.factorization_le_iff_dvd hy.ne' (Nat.mul_pos nz YY).ne').mp
    intro q
    by_cases pq : q.Prime
    · by_cases dy : q∣y
      · have div : y∣2*x*y := dvd_mul_left _ _
        have nonz : 2*x*y≠0 := by positivity
        have le := (Nat.factorization_le_iff_dvd hy.ne' nonz).mpr div q
        rw [←imag,Erdos889.PellValuation.pell_factorization_y_pow eps pq (support q pq dy) nz] at le
        exact le
      · simp [Nat.factorization_eq_zero_of_not_dvd dy]
    · simp [Nat.factorization_eq_zero_of_not_prime _ pq]
  have ybound := Nat.le_of_dvd (Nat.mul_pos nz YY) ydiv
  have Dx : x ≤ D*y := by
    have hD : 0 < D := by exact_mod_cast he.d_pos
    by_contra! large
    have h := Nat.mul_le_mul (show 1 ≤ D by omega) (Nat.le_refl (D*y^2))
    nlinarith [Nat.mul_self_lt_mul_self large]
  have expBound : 2^n*Y ≤ 4*x*y := by
    obtain ⟨j,rfl⟩ := Nat.exists_eq_succ_of_ne_zero nz.ne'
    have low := pell_growth eps he.1 he.2.1 j
    have eqy := congrArg Pell.Solution₁.y hn
    rw [←eqy,sy] at low
    have castY : (Y:ℤ)=eps.y := Int.natAbs_of_nonneg he.2.1.le
    change (2:ℕ)^(j+1)*Y ≤ 4*x*y
    zify
    rw [castY,pow_succ]
    linarith
  have nbound : n≤10+4*D*Y := by
    by_cases big : 10 ≤ n
    · have cube := cube_le_two_pow big
      have upper := Nat.mul_le_mul Dx ybound
      have upper' := Nat.mul_le_mul (Nat.mul_le_mul_left D ybound) (Nat.le_refl (n*Y))
      have all : n^3*Y≤(4*D*Y)*(n^2*Y) := by
        nlinarith [Nat.mul_le_mul_right Y cube]
      have eqN : n^3*Y=n*(n^2*Y) := by ring
      rw [eqN] at all
      have := Nat.le_of_mul_le_mul_right all (by positivity : 0 < n^2*Y)
      omega
    · omega
  have Yle : Y ≤ upper.y.natAbs := by have := he.y_le_y ux uy; have := he.2.1; dsimp only [Y]; omega
  exact Dx.trans (by calc
    D*y ≤ D*(n*Y) := Nat.mul_le_mul_left _ ybound
    _ ≤ D*((10+4*D*Y)*Y) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ nbound)
    _ = D*(10+4*D*Y)*Y := by ring
    _ ≤ _ := by gcongr)


private theorem cap_even (x i : ℕ) (eq : x^2+1=50*(5^i)^2) : x ≤ 1967000 := by
  let u : Pell.Solution₁ (50:ℤ) := Pell.Solution₁.mk 99 14 (by norm_num)
  have b := explicit_twist_bound 50 u (by change 1 < (99:ℤ); norm_num) (by change 0 < (14:ℤ); norm_num)
    x _ (by positivity) eq (by
      intro q pq dv
      have e := (Nat.prime_dvd_prime_iff_eq pq (by decide : Nat.Prime 5)).mp (pq.dvd_of_dvd_pow dv)
      rw [e]; decide)
  change x ≤ 50*(10+4*50*14)*14 at b
  norm_num at b
  exact b

private theorem cap_odd (x i : ℕ) (eq : x^2+1=250*(5^i)^2) : x ≤ 1558709807531415000 := by
  let u : Pell.Solution₁ (250:ℤ) := Pell.Solution₁.mk 39480499 2496966 (by norm_num)
  have b := explicit_twist_bound 250 u (by change 1 < (39480499:ℤ); norm_num)
    (by change 0 < (2496966:ℤ); norm_num) x _ (by positivity) eq (by
      intro q pq dv
      have e := (Nat.prime_dvd_prime_iff_eq pq (by decide : Nat.Prime 5)).mp (pq.dvd_of_dvd_pow dv)
      rw [e]; decide)
  change x ≤ 250*(10+4*250*2496966)*2496966 at b
  norm_num at b
  exact b

private theorem exp_cap (x j : ℕ) (eq : x^2+1=2*5^j) (cap : x≤1558709807531415000) : j≤54 := by
  by_contra! high
  have lo := Nat.pow_le_pow_right (by decide : 0<5) (show 55≤j by omega)
  have sq := Nat.pow_le_pow_left cap 2
  norm_num at sq lo
  omega

private theorem five_power_bound {x j : ℕ} (eq : x^2+1=2*5^j) : j≤54 := by
  by_cases small : j<2
  · omega
  let i := (j-2)/2
  apply exp_cap x j eq
  by_cases ev : j%2=0
  · have ej : j=2+2*i := by dsimp [i]; omega
    have eq' : x^2+1=50*(5^i)^2 := by rw [eq,ej,pow_add,pow_mul']; ring
    have := cap_even x i eq'
    omega
  · have ej : j=3+2*i := by dsimp [i]; omega
    have eq' : x^2+1=250*(5^i)^2 := by rw [eq,ej,pow_add,pow_mul']; ring
    exact cap_odd x i eq'

/-- The only positive x with x²+1 equal to twice a power of five. -/
theorem square_add_one_twice_five {x j : ℕ} (eq : x^2+1=2*5^j) : x=1 ∨ x=3 ∨ x=7 := by
  have bound := five_power_bound eq
  have cert : ∀ k : Fin 55, let a := 2*5^k.val-1
    a.sqrt^2=a → a.sqrt=1 ∨ a.sqrt=3 ∨ a.sqrt=7 := by decide +kernel
  have t := cert ⟨j,by omega⟩
  have sub : 2*5^j-1=x^2 := by omega
  change (2*5^j-1).sqrt^2=2*5^j-1 → _ at t
  simpa [sub] using t

theorem two_quadratic_factors {T u : ℕ} (hT : 4 ≤ T)
    (h₁ : ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣u^2+1)
    (h₂ : ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣(u+2)^2+1) :
    ∃ q s : ℕ, q.Prime ∧ s.Prime ∧ q≠s ∧ T < q ∧ T < s ∧ q∣(u+1)^4+4 ∧ s∣(u+1)^4+4 := by
  obtain ⟨q,pq,hq,dq⟩ := h₁
  obtain ⟨s,ps,hs,ds⟩ := h₂
  let z := u+1
  let L := u^2+1
  let R := (u+2)^2+1
  change q∣L at dq
  change s∣R at ds
  have fac : (u+1)^4+4=L*R := by dsimp only [L,R]; ring
  refine ⟨q,s,pq,ps,?_,hq,hs,fac ▸ dvd_mul_of_dvd_left dq _,fac ▸ dvd_mul_of_dvd_right ds _⟩
  rintro rfl
  have diff : R=L+4*z := by dsimp only [R,L,z]; ring
  rw [diff] at ds
  have d4 := (Nat.dvd_add_iff_right dq).mpr ds
  have dz : q∣z := (pq.dvd_mul.mp d4).resolve_left (by
    intro dv; have := Nat.le_of_dvd (by decide : 0<4) dv; omega)
  have sum := dvd_add dq (dvd_mul_of_dvd_right dz 2)
  rw [show L+2*z=z^2+2 by dsimp only [L,z]; ring] at sum
  have sq : q∣z^2 := dz.trans (dvd_pow_self z (by decide : 2≠0))
  have bad := (Nat.dvd_add_iff_right sq).mpr sum
  have := Nat.le_of_dvd (by decide : 0<2) bad
  omega


private theorem prime_above_ten {x : ℕ} (hx : 7 < x) (ox : Odd x) :
    ∃ q : ℕ, q.Prime ∧ 10 < q ∧ q∣x^2+1 := by
  by_contra missing
  obtain ⟨h,form⟩ := ox
  let m := 2*h^2+2*h+1
  have shape : x^2+1=2*m := by rw [form]; dsimp [m]; ring
  have pure : m=5^m.primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd (by dsimp [m]; omega) (by
    intro p pp dp
    have dv : p∣x^2+1 := by rw [shape]; exact dvd_mul_of_dvd_right dp 2
    have small : p≤10 := by by_contra! high; exact missing ⟨p,pp,high,dv⟩
    have opts : p=2 ∨ p=3 ∨ p=5 ∨ p=7 := by interval_cases p <;> norm_num at *
    have nonres (q : ℕ) (pq : q=3 ∨ q=7) : ¬q∣x^2+1 := by
      intro d
      have hn : 0 < q := by omega
      have row : ∀ k : Fin q, (k.val^2+1)%q ≠ 0 := by rcases pq with rfl|rfl <;> decide +kernel
      have eq := (((Nat.mod_modEq x q).pow 2).add_right 1).trans (Nat.modEq_zero_iff_dvd.mpr d)
      exact row ⟨x%q,Nat.mod_lt _ hn⟩ (by simpa [Nat.ModEq] using eq)
    rcases opts with rfl|rfl|rfl|rfl
    · dsimp [m] at dp; omega
    · exact (nonres 3 (Or.inl rfl) dv).elim
    · rfl
    · exact (nonres 7 (Or.inr rfl) dv).elim)
  rw [pure] at shape
  rcases square_add_one_twice_five shape with e|e|e <;> omega

/-- Offset ten gives two fresh prime divisors throughout this quartic family. -/
theorem twice_fourth_shift {n z : ℕ} (eq : n+2=2*z^4) (even : Even z) (large : 10≤z) :
    ∃ q s : ℕ, q.Prime ∧ s.Prime ∧ q≠s ∧ 10 < q ∧ 10 < s ∧ q∣n+10 ∧ s∣n+10 := by
  let u := z-1
  have zu : z=u+1 := by dsimp [u]; omega
  have ou : Odd u := by obtain ⟨b,hb⟩ := even; exact ⟨b-1,by dsimp [u]; omega⟩
  have ov : Odd (u+2) := by obtain ⟨b,hb⟩ := ou; exact ⟨b+1,by omega⟩
  have lu : 7 < u := by omega
  obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ :=
    two_quadratic_factors (by decide : 4≤10) (prime_above_ten lu ou) (prime_above_ten (by omega) ov)
  have fac : n+10=2*((u+1)^4+4) := by rw [←zu]; omega
  exact ⟨q,s,pq,ps,ne,hq,hs,fac ▸ dvd_mul_of_dvd_right dq 2,fac ▸ dvd_mul_of_dvd_right ds 2⟩


/-- When n+2 is twelve times a fourth power, offset five has two large primes. -/
theorem twelve_fourth_shift {n z : ℕ} (eq : n+2=12*z^4) (large : 5≤z) :
    ∃ q s : ℕ, q.Prime ∧ s.Prime ∧ q≠s ∧ 10 < q ∧ 10 < s ∧ q∣n+5 ∧ s∣n+5 := by
  let u := 2*z-1
  have zu : u+1=2*z := by dsimp [u]; omega
  have ou : Odd u := ⟨z-1,by dsimp [u]; omega⟩
  have ov : Odd (u+2) := by obtain ⟨b,hb⟩ := ou; exact ⟨b+1,by omega⟩
  have lu : 7 < u := by omega
  obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ :=
    two_quadratic_factors (by decide : 4≤10) (prime_above_ten lu ou) (prime_above_ten (by omega) ov)
  have fac : (u+1)^4+4=4*(4*z^4+1) := by rw [zu]; ring
  have target : n+5=3*(4*z^4+1) := by omega
  have peel (p : ℕ) (pp : p.Prime) (big : 10 < p) (d : p∣(u+1)^4+4) : p∣n+5 := by
    rw [fac] at d
    rw [target]
    exact dvd_mul_of_dvd_right ((pp.dvd_mul.mp d).resolve_left
      (by intro dv; have := Nat.le_of_dvd (by decide : 0<4) dv; omega)) 3
  exact ⟨q,s,pq,ps,ne,hq,hs,peel q pq hq dq,peel s ps hs ds⟩

end Erdos889.ExactTwiceFourth



/- Exceptional starting values above 330 must be divisible by three or five. -/
namespace Erdos889.SmallMissing
open OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2
open Polynomial

private theorem power_cyclotomic_order {p n q : ℕ} (hn : 0 < n) (pq : q.Prime)
    (hd : q ∣ ((cyclotomic n ℤ).eval (p : ℤ)).natAbs) :
    orderOf (p : ZMod q) = n / q ^ n.factorization q ∧
      n / q ^ n.factorization q ∣ q - 1 := by
  let : Fact q.Prime := ⟨pq⟩
  have hr : IsRoot (cyclotomic n (ZMod q)) (Nat.castRingHom (ZMod q) p) := by
    have c : ((p : ℤ) : ZMod q) = ↑(Int.castRingHom (ZMod q) p) := by simp
    rw [IsRoot.def, ← map_cyclotomic_int n (ZMod q), eval_map, Nat.coe_castRingHom,
      ← Int.cast_natCast, c, eval₂_hom, Int.coe_castRingHom, ZMod.intCast_zmod_eq_zero_iff_dvd]
    apply Int.dvd_natAbs.1
    exact_mod_cast hd
  have hc : ¬q ∣ p := pq.coprime_iff_not_dvd.mp (coprime_of_root_cyclotomic hn hr).symm
  let m := n / q ^ n.factorization q
  let : NeZero (m : ZMod q) := NeZero.of_not_dvd _ (Nat.not_dvd_ordCompl pq hn.ne')
  have form : q ^ n.factorization q * m = n := Nat.ordProj_mul_ordCompl_eq_self n q
  have hr' : (cyclotomic (q ^ n.factorization q * m) (ZMod q)).IsRoot (p : ZMod q) := by
    rw [form]
    exact hr
  have eqn := (isRoot_cyclotomic_prime_pow_mul_iff_of_charP.mp hr').eq_orderOf
  refine ⟨eqn.symm, ?_⟩
  rw [show n / q ^ n.factorization q = orderOf (p : ZMod q) from eqn]
  exact ZMod.orderOf_dvd_card_sub_one (mt (CharP.cast_eq_zero_iff _ _ _).1 hc)

private theorem power_cyclotomic_div {p n d : ℕ} (hp : 1 ≤ p) (hd : d ∈ n.properDivisors) :
    (p ^ d - 1) * ((cyclotomic n ℤ).eval (p : ℤ)).natAbs ∣ p ^ n - 1 := by
  have h := eval_dvd (x := (p : ℤ))
    (X_pow_sub_one_mul_cyclotomic_dvd_X_pow_sub_one_of_dvd ℤ hd)
  simp only [eval_mul, eval_sub, eval_X_pow, eval_one] at h
  have castpow (k : ℕ) : (p : ℤ)^k - 1 = ((p^k-1 : ℕ) : ℤ) := by
    rw [Nat.cast_sub (Nat.one_le_pow _ _ hp), Nat.cast_pow, Nat.cast_one]
  have h' := Int.natAbs_dvd_natAbs.mpr h
  simpa only [castpow, Int.natAbs_mul, Int.natAbs_natCast] using h'

private theorem power_cyclotomic_no_square {p n q : ℕ} (hp : 3 ≤ p) (oddp : Odd p)
    (hn : 2 < n) (pq : q.Prime) (dn : q ∣ n)
    (hF : q ∣ ((cyclotomic n ℤ).eval (p : ℤ)).natAbs) :
    ¬ q^2 ∣ ((cyclotomic n ℤ).eval (p : ℤ)).natAbs := by
  let : Fact q.Prime := ⟨pq⟩
  let d := n / q
  let a := p^d
  have form : d*q=n := Nat.div_mul_cancel dn
  have dpos : 0 < d := Nat.div_pos (Nat.le_of_dvd (by omega) dn) pq.pos
  have apos : 1 < a := Nat.one_lt_pow dpos.ne' (by omega : 1 < p)
  have dmem : d ∈ n.properDivisors := Nat.mem_properDivisors.mpr
    ⟨⟨q,form.symm⟩, Nat.div_lt_self (by omega) pq.one_lt⟩
  have divF := power_cyclotomic_div (p := p) (by omega) dmem
  have power : a^q=p^n := by rw [show a = p ^ d by rfl, ← pow_mul, form]
  rw [← power] at divF
  change (a-1) * _ ∣ a^q-1 at divF
  obtain ⟨ordp,orddiv⟩ := power_cyclotomic_order (by omega) pq hF
  have total : q ^ n.factorization q * (n / q ^ n.factorization q) = n :=
    Nat.ordProj_mul_ordCompl_eq_self n q
  intro hs
  have div2 : (a-1)*q^2 ∣ a^q-1 := (Nat.mul_dvd_mul_left _ hs).trans divF
  by_cases qt : q=2
  · subst q
    have m1 : n / 2 ^ n.factorization 2 = 1 := Nat.dvd_one.mp orddiv
    rw [m1, mul_one] at total
    have ee : 2 ≤ n.factorization 2 := by
      by_contra! h
      interval_cases h' : n.factorization 2 <;> simp at total <;> omega
    obtain ⟨k,hk⟩ : ∃ k, n.factorization 2 = k+2 := ⟨_, (Nat.sub_add_cancel ee).symm⟩
    have dk : d = 2^k*2 := by rw [hk, pow_succ, pow_succ] at total; omega
    have ak : a = (p^(2^k))^2 := by change p^d = _; rw [dk,pow_mul]
    have neq : a^2-1=(a-1)*(a+1) := by
      have hh : a-1+1=a := by omega
      rw [← hh]
      simp only [Nat.add_sub_cancel]
      have e : (a-1+1)^2=(a-1)*(a-1+1+1)+1 := by ring
      omega
    rw [neq] at div2
    have ff := Nat.dvd_of_mul_dvd_mul_left (by omega : 0 < a-1) div2
    obtain ⟨j,hj⟩ := oddp.pow (n:=2^k)
    rw [ak,hj] at ff
    obtain ⟨z,hz⟩ := ff
    have eh : (2*j+1)^2+1 = 4*(j*j+j)+2 := by ring
    omega

  · have md : orderOf (p : ZMod q) ∣ n := ⟨q^n.factorization q, by
      rw [ordp,mul_comm,total]⟩
    have ax : (a : ZMod q)^q = 1 := by
      rw [show a = p^d from rfl, Nat.cast_pow, ← pow_mul, form]
      exact orderOf_dvd_iff_pow_eq_one.mp md
    rw [ZMod.pow_card] at ax
    have hdiv : q ∣ a-1 := by
      apply (ZMod.natCast_eq_zero_iff _ _).mp
      rw [Nat.cast_sub (by omega : 1 ≤ a), Nat.cast_one, ax, sub_self]
    have na : ¬ q ∣ a := by
      intro h
      have := (ZMod.natCast_eq_zero_iff _ _).mpr h
      rw [ax] at this
      exact one_ne_zero this
    have vv := padicValNat.pow_sub_pow (p:=q) (x:=a) (y:=1)
      (pq.odd_of_ne_two qt) apos hdiv na pq.ne_zero
    simp only [one_pow,padicValNat_self] at vv
    obtain ⟨u,hu⟩ := div2
    have hpos := Nat.one_lt_pow pq.ne_zero apos
    have u0 : u ≠ 0 := by intro e; rw [e,mul_zero] at hu; omega
    rw [hu, padicValNat.mul (Nat.mul_ne_zero (by omega) (pow_ne_zero _ pq.ne_zero)) u0,
      padicValNat.mul (by omega) (pow_ne_zero _ pq.ne_zero), padicValNat.pow,
      padicValNat_self] at vv
    omega

private theorem power_primitive_prime {p n : ℕ} (hp : 3 ≤ p) (oddp : Odd p) (hn : 2 < n) :
    ∃ q : ℕ, q.Prime ∧ orderOf (p : ZMod q) = n := by
  let F := ((cyclotomic n ℤ).eval (p : ℤ)).natAbs
  have hF : 1 < F := lt_of_le_of_lt (by omega : 1 ≤ p-1)
    (sub_one_lt_natAbs_cyclotomic_eval (n:=n) (by omega) (by omega))
  by_contra miss
  have dividing {q : ℕ} (pq : q.Prime) (dv : q ∣ F) : q ∣ n := by
    by_contra nd
    have o := (power_cyclotomic_order (p:=p) (n:=n) (by omega) pq dv).1
    simp [Nat.factorization_eq_zero_of_not_dvd nd] at o
    exact miss ⟨q,pq,o⟩
  have lesser {q s : ℕ} (pq : q.Prime) (ps : s.Prime) (hq : q ∣ F)
      (hs : s ∣ F) (ne : s ≠ q) : s < q := by
    have hd := dividing ps hs
    have form := Nat.ordProj_mul_ordCompl_eq_self n q
    change q^n.factorization q * (n/q^n.factorization q)=n at form
    rw [← form] at hd
    rcases ps.dvd_mul.mp hd with h | h
    · exact (ne ((Nat.prime_dvd_prime_iff_eq ps pq).mp (ps.dvd_of_dvd_pow h))).elim
    · have hlt := Nat.le_of_dvd (by have := pq.one_lt; omega : 0 < q-1)
        (h.trans (power_cyclotomic_order (p:=p) (n:=n) (by omega) pq hq).2)
      omega
  obtain ⟨q,pq,hq⟩ := Nat.exists_prime_and_dvd (n:=F) (by omega)
  have fpow := Nat.eq_prime_pow_of_unique_prime_dvd (by omega : F ≠ 0) (p:=q) (by
    intro s ps hs
    by_contra ne
    have h := lesser pq ps hq hs ne
    have h' := lesser ps pq hs hq (Ne.symm ne)
    omega)
  have dn := dividing pq hq
  have tdiv := Nat.totient_dvd_of_dvd dn
  rw [Nat.totient_prime pq] at tdiv
  have tle := Nat.le_of_dvd (Nat.totient_pos.mpr (by omega : 0 < n)) tdiv
  have qF : q < F := calc
    q ≤ 2^(q-1) := by have h : q-1 < 2^(q-1) := Nat.lt_two_pow_self; omega
    _ ≤ (p-1)^n.totient := by gcongr <;> omega
    _ < F := sub_one_pow_totient_lt_natAbs_cyclotomic_eval (by omega) (by omega)
  have len : 2 ≤ F.primeFactorsList.length := by
    by_contra! h
    interval_cases he : F.primeFactorsList.length <;> simp at fpow <;> omega
  apply power_cyclotomic_no_square hp oddp hn pq dn hq
  change q^2 ∣ F
  conv_rhs => rw [fpow]
  exact pow_dvd_pow q len

private theorem power_primitive_plus {p k : ℕ} (hp : 3 ≤ p) (oddp : Odd p) (hk : 1 < k) :
    ∃ q : ℕ, q.Prime ∧ orderOf (p : ZMod q) = 2*k ∧ 2*k < q ∧ q ∣ p^k+1 := by
  obtain ⟨q,pq,eqo⟩ := power_primitive_prime hp oddp (n:=2*k) (by omega)
  let : Fact q.Prime := ⟨pq⟩
  have eq1 := pow_orderOf_eq_one (p : ZMod q)
  rw [eqo] at eq1
  have p0 : (p : ZMod q) ≠ 0 := by
    intro h
    rw [h, zero_pow (by omega : 2*k ≠ 0)] at eq1
    exact zero_ne_one eq1
  have dl := ZMod.orderOf_dvd_card_sub_one p0
  rw [eqo] at dl
  have small := Nat.le_of_dvd (by have := pq.one_lt; omega : 0 < q-1) dl
  refine ⟨q,pq,eqo,by omega,?_⟩
  have sq1 : ((p : ZMod q)^k)^2 = 1 := by rw [← pow_mul,Nat.mul_comm k 2]; exact eq1
  rcases sq_eq_one_iff.mp sq1 with bad | good
  · have dk := orderOf_dvd_of_pow_eq_one bad
    rw [eqo] at dk
    have := Nat.le_of_dvd (by omega : 0 < k) dk
    omega
  · apply (ZMod.natCast_eq_zero_iff _ _).mp
    rw [Nat.cast_add,Nat.cast_one,Nat.cast_pow,good,neg_add_cancel]

private theorem primitive_minus {p e : ℕ} (hp : 3 ≤ p) (op : Odd p) (he : 2 < e) :
    ∃ q : ℕ, q.Prime ∧ e < q ∧ q ∣ p^e-1 := by
  obtain ⟨q,pq,ord⟩ := power_primitive_prime hp op he
  let : Fact q.Prime := ⟨pq⟩
  have one := pow_orderOf_eq_one (p : ZMod q)
  rw [ord] at one
  have nz : (p : ZMod q) ≠ 0 := by
    intro z
    rw [z,zero_pow (by omega : e≠0)] at one
    exact zero_ne_one one
  have div := ZMod.orderOf_dvd_card_sub_one nz
  rw [ord] at div
  have small := Nat.le_of_dvd (by have := pq.one_lt; omega : 0 < q-1) div
  refine ⟨q,pq,by omega,(ZMod.natCast_eq_zero_iff _ _).mp ?_⟩
  rw [Nat.cast_sub (Nat.one_le_pow _ _ (by omega)),Nat.cast_one,Nat.cast_pow,one,sub_self]

private theorem supported {n k p q : ℕ} (sol : Erdos889.v_l 1 n=1) (kp : 0 < k)
    (pp : p.Prime) (eligible : k < p) (dp : p∣n+k) (pq : q.Prime) (dq : q∣n+k) :
    q=p ∨ q ≤ k := by
  by_contra! bad
  exact two_primes kp pp pq bad.1.symm eligible (by omega) dp dq sol

private theorem pure_at {n k p : ℕ} (sol : Erdos889.v_l 1 n=1) (kp : 0 < k)
    (pp : p.Prime) (eligible : k < p) (dp : p∣n+k)
    (small : ∀ q : ℕ, q.Prime → q ≤ k → ¬q∣n+k) : ∃ e : ℕ, n+k=p^e := by
  refine ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd (by omega) ?_⟩
  intro q pq dq
  exact (supported sol kp pp eligible dp pq dq).resolve_right (fun h => small q pq h dq)

private theorem offset_of_missing {p n : ℕ} (hp : 0 < p) (miss : ¬p∣n) :
    ∃ k : ℕ, 0 < k ∧ k < p ∧ p∣n+k := by
  have nonzero : n%p≠0 := fun eq => miss (Nat.dvd_of_mod_eq_zero eq)
  have low := Nat.mod_lt n hp
  refine ⟨p-n%p,by omega,by omega,n/p+1,?_⟩
  rw [Nat.mul_add,mul_one]
  have eq := Nat.mod_add_div n p
  omega

/-- Every exception above the known list is divisible by three or five. -/
theorem three_or_five {n : ℕ} (big : 330 < n) (sol : Erdos889.v_l 1 n=1) : 3∣n ∨ 5∣n := by
  by_contra! miss
  have even : 2∣n := by
    by_contra h
    have odd : Odd n := by rw [Nat.odd_iff]; omega
    rcases (odd_classification odd).mp sol with e|e|e|e <;> omega
  by_cases d : 3∣n+1
  · obtain ⟨a,ha⟩ := pure_at (k:=1) sol (by decide) Nat.prime_three (by decide) d
      (by intro q pq low; have := pq.two_le; omega)
    rcases (three_successor_solution (by omega) ha).mp sol with h|h|h|h <;> omega
  have d3 : 3∣n+2 := by
    obtain ⟨k,hk,hi,dv⟩ := offset_of_missing (by decide : 0<3) miss.1
    interval_cases k <;> first | assumption | contradiction
  have smooth {q : ℕ} (pq : q.Prime) (div : q∣n+2) : q≤3 := by
    rcases supported (k:=2) sol (by decide) Nat.prime_three (by decide) d3 pq div with h|h <;> omega
  have plus {e : ℕ} (eq : n+1=5^e) : False := by
    by_cases he : e≤1
    · interval_cases e <;> norm_num at eq <;> omega
    obtain ⟨q,pq,_,hq,dq⟩ := power_primitive_plus (p:=5) (by decide) (by decide) (by omega : 1 < e)
    have := smooth pq (show q∣n+2 by rwa [show n+2=5^e+1 by omega])
    omega
  have minus {e : ℕ} (eq : n+3=5^e) : False := by
    by_cases he : e≤2
    · interval_cases e <;> norm_num at eq <;> omega
    obtain ⟨q,pq,hq,dq⟩ := primitive_minus (p:=5) (by decide) (by decide) (by omega : 2 < e)
    have := smooth pq (show q∣n+2 by rwa [show n+2=5^e-1 by omega])
    omega
  by_cases d1 : 5∣n+1
  · obtain ⟨a,ha⟩ := pure_at (k:=1) sol (by decide) (by decide : Nat.Prime 5) (by decide) d1
      (by intro q pq low; have := pq.two_le; omega)
    exact plus ha
  by_cases d2 : 5∣n+2
  · have := smooth (by decide : Nat.Prime 5) d2
    omega
  by_cases dt : 5∣n+3
  · obtain ⟨e,eq⟩ := pure_at (k:=3) sol (by decide) (by decide : Nat.Prime 5) (by decide) dt (by
      intro q pq low dv
      have := pq.two_le
      interval_cases q <;> omega)
    exact minus eq
  have df : 5∣n+4 := by
    obtain ⟨k,hk,hi,dv⟩ := offset_of_missing (by decide : 0<5) miss.2
    interval_cases k <;> first | assumption | contradiction
  have small4 {q : ℕ} (pq : q.Prime) (dv : q∣n+4) : q=5 ∨ q=2 := by
    rcases supported (k:=4) sol (by decide) (by decide : Nat.Prime 5) (by decide) df pq dv with h|h
    · exact Or.inl h
    · have := pq.two_le
      interval_cases q
      · exact Or.inr rfl
      · have sub := Nat.dvd_sub dv d3
        omega
      · norm_num at pq
  by_cases four : 4∣n+2
  · let y := (n+4)/2
    have ey : n+4=2*y := by dsimp [y]; omega
    have py : y=5^y.primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd (by omega) (by
      intro q pq dv
      have h := small4 pq (ey ▸ dvd_mul_of_dvd_right dv 2)
      rcases h with h|rfl
      · exact h
      · omega)
    let e := y.primeFactorsList.length
    change y=5^e at py
    by_cases he : e≤2
    · interval_cases e <;> norm_num at py <;> omega
    obtain ⟨q,pq,hq,dq⟩ := primitive_minus (p:=5) (by decide) (by decide) (by omega : 2 < e)
    have eq : n+2=2*(5^e-1) := by omega
    have := smooth pq (eq ▸ dvd_mul_of_dvd_right dq 2)
    omega
  · let y := (n+2)/2
    have ey : n+2=2*y := by dsimp [y]; omega
    have py : y=3^y.primeFactorsList.length := Nat.eq_prime_pow_of_unique_prime_dvd (by omega) (by
      intro q pq dv
      have h := smooth pq (ey ▸ dvd_mul_of_dvd_right dv 2)
      have := pq.two_le
      interval_cases q <;> omega)
    let e := y.primeFactorsList.length
    change y=3^e at py
    by_cases he : e≤2
    · interval_cases e <;> norm_num at py <;> omega
    obtain ⟨q,pq,_,hq,dq⟩ := power_primitive_plus (p:=3) (by decide) (by decide) (by omega : 1 < e)
    have eq : n+4=2*(3^e+1) := by omega
    rcases small4 pq (eq ▸ dvd_mul_of_dvd_right dq 2) with h|h <;> omega

private theorem cycle {x t m : ℕ} (h : Nat.ModEq m (x^t) 1) (b : ℕ) :
    Nat.ModEq m (x^b) (x^(b%t)) := by
  calc
    x^b = x^(b%t)*(x^t)^(b/t) := by rw [←pow_mul,←pow_add,Nat.mod_add_div]
    _ ≡ x^(b%t)*1^(b/t) [MOD m] := (h.pow _).mul_left _
    _ = _ := by simp

private theorem smooth_shape {n : ℕ} (big : 330<n) (sol : Erdos889.v_l 1 n=1) (miss : ¬3∣n) :
    ∃ a b : ℕ, 0<a ∧ 0<b ∧ n+2=2^a*3^b := by
  have even : 2∣n := by
    by_contra h
    have odd : Odd n := by rw [Nat.odd_iff]; omega
    rcases (odd_classification odd).mp sol with h|h|h|h <;> omega
  have no : ¬3∣n+1 := by
    intro d
    obtain ⟨a,ha⟩ := pure_at (k:=1) sol (by decide) Nat.prime_three (by decide) d
      (by intro q pq low; have := pq.two_le; omega)
    rcases (three_successor_solution (by omega) ha).mp sol with h|h|h|h <;> omega
  have d3 : 3∣n+2 := by
    obtain ⟨k,hk,hi,dv⟩ := offset_of_missing (by decide : 0<3) miss
    interval_cases k <;> first | assumption | contradiction
  let a := (n+2).factorization 2
  let y := (n+2)/2^a
  have fact : 2^a*y=n+2 := Nat.ordProj_mul_ordCompl_eq_self _ _
  have yodd : ¬2∣y := Nat.not_dvd_ordCompl Nat.prime_two (by omega : n+2≠0)
  let b := y.primeFactorsList.length
  have ey : y=3^b := Nat.eq_prime_pow_of_unique_prime_dvd (Nat.ordCompl_pos 2 (by omega : n+2≠0)).ne' (by
    intro q pq dq
    have div : q∣n+2 := dq.trans (Nat.ordCompl_dvd _ _)
    rcases supported (k:=2) sol (by decide) Nat.prime_three (by decide) d3 pq div with h|h
    · exact h
    · have := pq.two_le
      have hq : q=2 := by omega
      exact (yodd (hq ▸ dq)).elim)
  have ha : 0<a := Nat.Prime.factorization_pos_of_dvd Nat.prime_two (by omega) (by omega)
  have hb : 0<b := by
    by_contra! zero
    rw [show b=0 by omega, pow_zero] at ey
    rw [ey,mul_one] at fact
    rw [←fact] at d3
    exact (by decide : ¬3∣2) (Nat.prime_three.dvd_of_dvd_pow d3)
  exact ⟨a,b,ha,hb,by rw [←ey,fact]⟩

private theorem quartic (a b : ℕ) :
    2^a*3^b=(2^(a%4)*3^(b%4))*(2^(a/4)*3^(b/4))^4 := by
  have split (p e : ℕ) : p^e=p^(e%4)*(p^(e/4))^4 := by
    rw [←pow_mul,←pow_add,Nat.mul_comm (e/4) 4,Nat.mod_add_div]
  rw [split 2 a,split 3 b,mul_pow]
  ring

private theorem reduced {a b n p : ℕ} (d : p∣n) (hp : 2<p) (eq : n+2=2^a*3^b)
    (c2 : Nat.ModEq p (2^12) 1) (c3 : Nat.ModEq p (3^12) 1) :
    (2^(a%12)*3^(b%12))%p=2 := by
  have ec := (cycle c2 a).mul (cycle c3 b)
  change (2^a*3^b)%p=_ at ec
  rw [←eq,Nat.add_mod,Nat.mod_eq_zero_of_dvd d,zero_add,Nat.mod_eq_of_lt hp,Nat.mod_eq_of_lt hp] at ec
  exact ec.symm

private theorem quartic_coeff {a b n : ℕ} (d : 5∣n) (eq : n+2=2^a*3^b) :
    (a%4=1 ∧ b%4=0) ∨ (a%4=2 ∧ b%4=1) ∨ (a%4=3 ∧ b%4=2) ∨ (a%4=0 ∧ b%4=3) := by
  have tab : ∀ i j : Fin 12, (2^i.val*3^j.val)%5=2 →
      (i.val%4=1 ∧ j.val%4=0) ∨ (i.val%4=2 ∧ j.val%4=1) ∨
      (i.val%4=3 ∧ j.val%4=2) ∨ (i.val%4=0 ∧ j.val%4=3) := by decide +kernel
  have h := tab ⟨a%12,by omega⟩ ⟨b%12,by omega⟩ (reduced d (by decide) eq (by decide) (by decide))
  simpa only [Nat.mod_mod_of_dvd _ (by decide : 4∣12)] using h

private theorem odd_quartic {z : ℕ} (odd : Odd z) (big : 3<z) :
    ∃ q s : ℕ, q.Prime ∧ s.Prime ∧ q≠s ∧ 10<q ∧ 10<s ∧ q∣z^4+4 ∧ s∣z^4+4 := by
  obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ := fourth_power_witness odd big
  have large (p : ℕ) (pp : p.Prime) (h : 5<p) (dv : p∣z^4+4) : 10<p := by
    by_contra! low
    have seven : p=7 := by interval_cases p <;> first | rfl | norm_num at pp
    subst p
    have tab : ∀ j : Fin 7, (j.val^4+4)%7≠0 := by decide
    have eq := (((Nat.mod_modEq z 7).pow 4).add_right 4).trans (Nat.modEq_zero_iff_dvd.mpr dv)
    exact tab ⟨z%7,by omega⟩ (by simpa [Nat.ModEq] using eq)
  exact ⟨q,s,pq,ps,ne,large q pq hq dq,large s ps hs ds,dq,ds⟩

/-- Outside the known range, a solution missing three has one of two quartic forms. -/
theorem missing_three_quartics {n : ℕ} (big : 1000000<n) (sol : Erdos889.v_l 1 n=1) (miss : ¬3∣n) :
    ∃ z : ℕ, n+2=72*z^4 ∨ n+2=27*z^4 := by
  obtain ⟨a,b,_,_,eq⟩ := smooth_shape (by omega) sol miss
  have d := (three_or_five (by omega) sol).resolve_left miss
  let z := 2^(a/4)*3^(b/4)
  have shape : n+2=(2^(a%4)*3^(b%4))*z^4 := eq.trans (quartic a b)
  rcases quartic_coeff d eq with ⟨ha,hb⟩|⟨ha,hb⟩|⟨ha,hb⟩|⟨ha,hb⟩ <;> rw [ha,hb] at shape <;> norm_num at shape
  · have large : 10≤z := by
      by_contra! low
      have := Nat.pow_le_pow_left (show z≤9 by omega) 4
      omega
    rcases Nat.even_or_odd z with even|odd
    · obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ := Erdos889.ExactTwiceFourth.twice_fourth_shift shape even large
      exact (two_primes (by decide : 0<10) pq ps ne hq hs dq ds sol).elim
    · obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ := odd_quartic odd (by omega)
      have ex : n+10=2*(z^4+4) := by omega
      exact (two_primes (by decide : 0<10) pq ps ne hq hs (ex ▸ dvd_mul_of_dvd_right dq 2) (ex ▸ dvd_mul_of_dvd_right ds 2) sol).elim
  · have large : 5≤z := by
      by_contra! low
      have := Nat.pow_le_pow_left (show z≤4 by omega) 4
      omega
    obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ := Erdos889.ExactTwiceFourth.twelve_fourth_shift shape large
    exact (two_primes (by decide : 0<5) pq ps ne (by omega) (by omega) dq ds sol).elim
  · exact ⟨z,Or.inl shape⟩
  · exact ⟨z,Or.inr shape⟩

private theorem no_twenty {x : ℕ} (bound : ∀ {y i j k : ℕ}, y^2+1=2*5^i*13^j*17^k → y≤239)
    (big : 239<x) (odd : Odd x) : ∃ p : ℕ, p.Prime ∧ 20<p ∧ p∣x^2+1 := by
  by_contra missing
  obtain ⟨h,hx⟩ := odd
  let m := 2*h^2+2*h+1
  have shape : x^2+1=2*m := by rw [hx]; dsimp [m]; ring
  have mp : 0 < m := by dsimp [m]; omega
  have small {p : ℕ} (pp : p.Prime) (dp : p∣m) : p=5 ∨ p=13 ∨ p=17 := by
    have dv : p∣x^2+1 := shape ▸ dvd_mul_of_dvd_right dp 2
    have cap : p≤20 := by by_contra! high; exact missing ⟨p,pp,high,dv⟩
    have row : ∀ q : Fin 21, q.val.Prime → ∀ j : Fin q.val, (j.val^2+1)%q.val=0 →
        q.val=2 ∨ q.val=5 ∨ q.val=13 ∨ q.val=17 := by decide +kernel
    have eq := (((Nat.mod_modEq x p).pow 2).add_right 1).trans (Nat.modEq_zero_iff_dvd.mpr dv)
    have result := row ⟨p,by omega⟩ pp ⟨x%p,Nat.mod_lt _ pp.pos⟩ (by simpa [Nat.ModEq] using eq)
    exact result.resolve_left (by intro same; change p=2 at same; subst p; dsimp [m] at dp; omega)
  let a := m.factorization 5
  let m₁ := m/5^a
  let b := m₁.factorization 13
  let m₂ := m₁/13^b
  have f₁ : 5^a*m₁=m := Nat.ordProj_mul_ordCompl_eq_self _ _
  have f₂ : 13^b*m₂=m₁ := Nat.ordProj_mul_ordCompl_eq_self _ _
  have pos₁ : 0 < m₁ := Nat.ordCompl_pos 5 mp.ne'
  have pos₂ : 0 < m₂ := Nat.ordCompl_pos 13 pos₁.ne'
  have pow := Nat.eq_prime_pow_of_unique_prime_dvd (p:=17) pos₂.ne' (by
    intro q pq dq
    have d₁ : q∣m₁ := dq.trans (Nat.ordCompl_dvd _ _)
    rcases small pq (d₁.trans (Nat.ordCompl_dvd _ _)) with rfl|rfl|eq
    · exact (Nat.not_dvd_ordCompl (by decide : Nat.Prime 5) mp.ne' d₁).elim
    · exact (Nat.not_dvd_ordCompl (by decide : Nat.Prime 13) pos₁.ne' dq).elim
    · exact eq)
  have eq : x^2+1=2*5^a*13^b*17^m₂.primeFactorsList.length := by
    rw [←pow,shape,←f₁,←f₂]
    ring
  exact (Nat.not_lt_of_ge (bound eq)) big

private theorem seventy_two {n z : ℕ} (bounds : ∀ {x i j k : ℕ}, x^2+1=2*5^i*13^j*17^k → x≤239)
    (eq : n+2=72*z^4) (large : 121≤z) : Erdos889.v_l 1 n ≠ 1 := by
  let u := 2*z-1
  have zu : u+1=2*z := by dsimp [u]; omega
  have ou : Odd u := ⟨z-1,by dsimp [u]; omega⟩
  have ov : Odd (u+2) := by obtain ⟨b,hb⟩ := ou; exact ⟨b+1,by omega⟩
  have lu : 239<u := by omega
  obtain ⟨q,s,pq,ps,ne,hq,hs,dq,ds⟩ :=
    Erdos889.ExactTwiceFourth.two_quadratic_factors (by decide : 4≤20)
      (no_twenty bounds lu ou) (no_twenty bounds (by omega) ov)
  have fac : (u+1)^4+4=4*(4*z^4+1) := by rw [zu]; ring
  have target : n+20=18*(4*z^4+1) := by omega
  have peel (p : ℕ) (pp : p.Prime) (big : 20<p) (d : p∣(u+1)^4+4) : p∣n+20 := by
    rw [fac] at d
    rw [target]
    exact dvd_mul_of_dvd_right ((pp.dvd_mul.mp d).resolve_left
      (by intro dv; have := Nat.le_of_dvd (by decide : 0<4) dv; omega)) 18
  exact two_primes (by decide : 0<20) pq ps ne hq hs (peel q pq hq dq) (peel s ps hs ds)

private theorem smooth_gap {n k : ℕ} (seven : ∀ a : ℕ, (∀ p : ℕ, p.Prime → p∣a*(a+1) → p≤7) → a≤4374)
    (big : 1000000<n) (hk : 0<k) (hi : k<7) (ne : k≠2)
    (four : 4∣n+2) (three : 3∣n+2)
    (s₂ : ∀ q : ℕ, q.Prime → q∣n+2 → q≤7) (sk : ∀ q : ℕ, q.Prime → q∣n+k → q≤7) : False := by
  have pair {a g : ℕ} (f₁ : g*a=n+2 ∨ g*a=n+k)
      (f₂ : g*(a+1)=n+2 ∨ g*(a+1)=n+k) (size : 4374<a) : False := by
    have lift {p u : ℕ} (pp : p.Prime) (d : p∣u) (f : g*u=n+2 ∨ g*u=n+k) : p≤7 := by
      have dv := dvd_mul_of_dvd_right d g
      rcases f with h|h
      · exact s₂ p pp (h ▸ dv)
      · exact sk p pp (h ▸ dv)
    apply (Nat.not_lt_of_ge (seven a ?_)) size
    intro p pp dp
    rcases pp.dvd_mul.mp dp with d|d
    · exact lift pp d f₁
    · exact lift pp d f₂
  interval_cases k
  · exact pair (a:=n+1) (g:=1) (Or.inr (by omega)) (Or.inl (by omega)) (by omega)
  · contradiction
  · exact pair (a:=n+2) (g:=1) (Or.inl (by omega)) (Or.inr (by omega)) (by omega)
  · exact pair (a:=(n+2)/2) (g:=2) (Or.inl (by omega)) (Or.inr (by omega)) (by omega)
  · exact pair (a:=(n+2)/3) (g:=3) (Or.inl (by omega)) (Or.inr (by omega)) (by omega)
  · exact pair (a:=(n+2)/4) (g:=4) (Or.inl (by omega)) (Or.inr (by omega)) (by omega)

private theorem twenty_seven {n z : ℕ} (seven : ∀ a : ℕ, (∀ p : ℕ, p.Prime → p∣a*(a+1) → p≤7) → a≤4374)
    (big : 1000000<n) (sol : Erdos889.v_l 1 n=1) (miss : ¬3∣n) (shape : n+2=27*z^4) : False := by
  obtain ⟨a,b,ha,_,eq⟩ := smooth_shape (by omega) sol miss
  have s₂ {q : ℕ} (pq : q.Prime) (dv : q∣n+2) : q≤3 := by
    rw [eq] at dv
    rcases pq.dvd_mul.mp dv with d|d
    · have := Nat.le_of_dvd (by decide : 0<2) (pq.dvd_of_dvd_pow d); omega
    · exact Nat.le_of_dvd (by decide : 0<3) (pq.dvd_of_dvd_pow d)
  have two : 2∣n+2 := by rw [eq]; exact dvd_mul_of_dvd_left (dvd_pow_self 2 ha.ne') _
  have dz : 2∣z := by
    rw [shape] at two
    exact Nat.prime_two.dvd_of_dvd_pow ((Nat.prime_two.dvd_mul.mp two).resolve_left (by decide))
  obtain ⟨t,et⟩ := dz
  have four : 4∣n+2 := by rw [shape,et]; exact ⟨108*t^4,by ring⟩
  have three : 3∣n+2 := by rw [shape]; exact dvd_mul_of_dvd_left (by decide : 3∣27) _
  have miss7 : ¬7∣n := by
    intro d
    have eq7 := (((Nat.mod_modEq z 7).pow 4).mul_left 27)
    change (27*(z%7)^4)%7=(27*z^4)%7 at eq7
    have tab : ∀ t : Fin 7, (27*t.val^4)%7≠2 := by decide
    apply tab ⟨z%7,by omega⟩
    rw [eq7,←shape,Nat.add_mod,Nat.mod_eq_zero_of_dvd d]
  obtain ⟨k,hk,hi,dv⟩ := offset_of_missing (by decide : 0<7) miss7
  have pq7 : Nat.Prime 7 := by decide
  have ne : k≠2 := by intro e; subst k; have := s₂ pq7 dv; omega
  exact smooth_gap seven big hk hi ne four three (fun q pq d => (s₂ pq d).trans (by decide))
    (by intro q pq d; rcases supported sol hk pq7 hi dv pq d with h|h <;> omega)

/-- The two explicit smooth-number bounds exclude every large solution missing three. -/
theorem missing_three_from_smooth_bounds {n : ℕ}
    (seven : ∀ a : ℕ, (∀ p : ℕ, p.Prime → p∣a*(a+1) → p≤7) → a≤4374)
    (twenty : ∀ {x i j k : ℕ}, x^2+1=2*5^i*13^j*17^k → x≤239)
    (big : 1000000000000<n) (sol : Erdos889.v_l 1 n=1) : 3∣n := by
  by_contra miss
  obtain ⟨z,eq|eq⟩ := missing_three_quartics (by omega) sol miss
  · have large : 121≤z := by
      by_contra! low
      have small := Nat.pow_le_pow_left (show z≤120 by omega) 4
      omega
    exact seventy_two twenty eq large sol
  · exact twenty_seven seven (by omega) sol miss eq

theorem three_dvd_of_large_solution {n : ℕ} (big : 1000000000000<n) (sol : Erdos889.v_l 1 n=1) : 3∣n :=
  missing_three_from_smooth_bounds Erdos889.SevenSmooth.consecutive_smooth_seven
    Erdos889.QuadraticTwenty.square_add_one_smooth_twenty big sol


end Erdos889.SmallMissing

namespace Erdos889.FiveSuccessor

open OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2

/-- A non-Mersenne prime greater than three dividing the successor forces
the successor to be either the prime itself or its square. -/
theorem non_mersenne_successor {n p : ℕ} (hn : 0 < n) (hp : p.Prime)
    (large : 3 < p) (non_mersenne : ∀ b : ℕ, p+1 ≠ 2^b)
    (hd : p ∣ n+1) (sol : v_l 1 n = 1) :
    n+1 = p ∨ n+1 = p^2 := by
  obtain ⟨q,e,hq,ep,eq⟩ := (isPrimePow_nat_iff _).mp (prime_power_succ hn sol)
  have dp : p ∣ q^e := eq ▸ hd
  have same := (Nat.prime_dvd_prime_iff_eq hp hq).mp (hp.dvd_of_dvd_pow dp)
  subst q
  have oddp := hp.odd_of_ne_two (by omega)
  rcases successor_exponent hp oddp ep eq.symm sol with ⟨t,ht⟩ | ⟨_,_,b,hb⟩
  · subst e
    cases t with
    | zero => left; simpa using eq.symm
    | succ j =>
      cases j with
      | zero => right; exact eq.symm
      | succ j =>
        let x := p^(2^j)
        have fourth : n+1 = x^4 := by
          rw [← eq]
          change p^(2^(j+1+1)) = (p^(2^j))^4
          rw [← pow_mul,show j+1+1=j+2 by omega,pow_add]
          rfl
        have hx : 3 < x := large.trans_le (Nat.le_self_pow (n:=2^j) (by positivity) p)
        obtain ⟨u,w,pu,pw,ne,lu,lw,du,dw⟩ := fourth_power_witness (x:=x) oddp.pow hx
        have shift : n+5 = x^4+4 := by omega
        exact False.elim (two_primes (k:=5) (by decide) pu pw ne lu lw (shift ▸ du) (shift ▸ dw) sol)
  · exact False.elim (non_mersenne b hb)

/-- All solutions in the residue class four modulo five. -/
theorem four_mod_five {n : ℕ} (res : n % 5 = 4) :
    v_l 1 n = 1 ↔ n = 4 ∨ n = 24 := by
  constructor
  · intro sol
    have no (b : ℕ) : 5+1 ≠ 2^b := by
      intro h
      have d : 3 ∣ 2^b := h ▸ (by decide : 3 ∣ 5+1)
      exact (by decide : ¬3 ∣ 2) (Nat.prime_three.dvd_of_dvd_pow d)
    rcases non_mersenne_successor (by omega : 0 < n) (by decide : Nat.Prime 5)
      (by decide) no (by omega) sol with h | h <;> norm_num at h <;> omega
  · rintro (rfl|rfl) <;> apply (solutions_through_330 (by decide) (by decide)).mpr <;> decide

end Erdos889.FiveSuccessor



namespace Erdos889.MissingPrimeSieve
open OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2

/-- All the positive solutions outside the multiples of three, with no upper cutoff. -/
theorem solutions_missing_three {n : ℕ} (pos : 0<n) (miss : ¬3∣n) :
    v_l 1 n=1 ↔ n ∈ [1,2,4,7,8,10,16,22,26,46,70,80,190] := by
  by_cases small : n≤330
  · rw [solutions_through_330 pos small]
    simp only [List.mem_cons,List.not_mem_nil,or_false]
    omega
  constructor
  · intro sol
    by_cases finite : n≤1000000000000000000
    · exact (no_new_solutions (by omega) finite sol).elim
    · exact (miss (Erdos889.SmallMissing.three_dvd_of_large_solution (by omega) sol)).elim
  · intro mem
    simp only [List.mem_cons,List.not_mem_nil,or_false] at mem
    omega

/-- Every additional solution lies in this interval and is a multiple of six. -/
theorem further_solution_bounds {n : ℕ} (big : 330<n) (sol : v_l 1 n=1) :
    1000000000000000000<n ∧ n<2^(2^21) ∧ (30∣n ∨ (42∣n ∧ (n%5=2 ∨ n%5=3))) := by
  have lower : 1000000000000000000<n := by by_contra! low; exact no_new_solutions big low sol
  have three := Erdos889.SmallMissing.three_dvd_of_large_solution (n:=n) (by omega) sol
  have two : 2∣n := by
    by_contra missing
    have odd : Odd n := by rw [Nat.odd_iff]; omega
    rcases (odd_classification odd).mp sol with h|h|h|h <;> omega
  have residue : n%5≠4 := by
    intro r
    rcases (Erdos889.FiveSuccessor.four_mod_five r).mp sol with h|h <;> omega
  have sparse (k p q : ℕ) (hk : 0<k) (pp : p.Prime) (pq : q.Prime) (ne : p≠q)
      (lp : k<p) (lq : k<q) (dp : p∣n+k) (dq : q∣n+k) : False := two_primes hk pp pq ne lp lq dp dq sol
  have r1 : n%5≠1 := by
    intro r
    exact Erdos889.FiveMissingSeven.no_five_at_four sparse (by omega) two three (by omega)
  refine ⟨lower,Erdos889.effective_binary_cutoff sol,?_⟩
  by_cases five : 5∣n
  · exact Or.inl (by omega)
  · have opts : n%5=2 ∨ n%5=3 := by omega
    have seven : 7∣n := by
      rcases opts with r|r
      · exact Erdos889.FiveMissingSeven.seven_divides_of_five_shift (j:=3) sparse (by omega) two three (by decide) (by decide) (by omega)
      · exact Erdos889.FiveMissingSeven.seven_divides_of_five_shift (j:=2) sparse (by omega) two three (by decide) (by decide) (by omega)
    exact Or.inr ⟨by omega,opts⟩
end Erdos889.MissingPrimeSieve

namespace Erdos889.Missing
open Finset

lemma fresh_iff {n k p : ℕ} (hp : 0 < p) (hd : p ∣ n+k) :
    (∀ i ∈ range k, ¬p ∣ n+i) ↔ k < p := by
  constructor
  · intro h
    by_contra! hle
    have hdiff : n + (k-p) = n+k-p := by omega
    exact h (k-p) (mem_range.mpr (by omega)) (hdiff ▸ Nat.dvd_sub hd (dvd_refl p))
  · intro h i hi hdiv
    have hi' := mem_range.mp hi
    have hsub : n+k-(n+i) = k-i := by omega
    have hd' : p ∣ k-i := hsub ▸ Nat.dvd_sub hd hdiv
    have := Nat.le_of_dvd (by omega : 0 < k-i) hd'
    omega

theorem v_as_card (n k : ℕ) :
    v n k = ((n+k).primeFactors.filter (k < ·)).card := by
  unfold v
  congr 1
  ext p
  simp only [mem_filter]
  exact and_congr_right fun h => fresh_iff (Nat.prime_of_mem_primeFactors h).pos
    (Nat.dvd_of_mem_primeFactors h)

-- BEGIN MISSING WITNESS
/-- Absence of a two-prime witness exactly bounds every count at the predecessor, and offset one attains the bound. -/
theorem predecessor_solution_of_missing {N : ℕ} (big : 1 < N)
    (none : ¬ ∃ d q s : ℕ, q.Prime ∧ s.Prime ∧ q ≠ s ∧ d+1 < q ∧ d+1 < s ∧
      q ∣ N+d ∧ s ∣ N+d) : v_l 1 (N-1)=1 := by
  apply le_antisymm
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    have bound : v (N-1) k ≤ 1 := by
      rw [v_as_card,Finset.card_le_one]
      intro q hq s hs
      obtain ⟨cq,bq⟩ := Finset.mem_filter.mp hq
      obtain ⟨cs,bs⟩ := Finset.mem_filter.mp hs
      have eq : N+(k-1)=(N-1)+k := by omega
      by_contra ne
      exact none ⟨k-1,q,s,Nat.prime_of_mem_primeFactors cq,Nat.prime_of_mem_primeFactors cs,ne,
        by omega,by omega,eq ▸ Nat.dvd_of_mem_primeFactors cq,eq ▸ Nat.dvd_of_mem_primeFactors cs⟩
    exact_mod_cast bound
  · obtain ⟨q,pq,dq⟩ := Nat.exists_prime_and_dvd (show N≠1 by omega)
    have eq : N-1+1=N := by omega
    have first : 1 ≤ v (N-1) 1 := by
      rw [v_as_card,eq]
      exact Finset.card_pos.mpr ⟨q,Finset.mem_filter.mpr ⟨pq.mem_primeFactors dq (by omega),pq.one_lt⟩⟩
    exact (show (1 : ℕ∞) ≤ (v (N-1) 1 : ℕ∞) by exact_mod_cast first).trans
      (le_iSup_of_le 1 (le_iSup_of_le (by decide : 1≤1) le_rfl))
-- END MISSING WITNESS

end Erdos889.Missing

namespace OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2_H2_R1

private theorem split_factor_exponent (e : ℕ) :
    ∃ i j : ℕ, e=i+j*2 ∧ i≤3 ∧ (0 < j → 2 ≤ i) := by
  by_cases small : e≤3
  · exact ⟨e,0,by omega,small,by omega⟩
  · exact ⟨2+e%2,(e-2)/2,by omega,by omega,by omega⟩

private theorem smooth_square_decomposition (T n : ℕ) (hn : 0 < n)
    (smooth : ∀ q : ℕ, q.Prime → q∣n → q ≤ T) :
    ∃ D y : ℕ, D≤(T+1).factorial^3 ∧ 0 < D ∧ 0 < y ∧ n=D*y^2 ∧
      ∀ q : ℕ, q.Prime → q∣y → q^2∣D := by
  induction T generalizing n with
  | zero =>
    have unit : n=1 := by
      by_contra ne
      obtain ⟨q,pq,dq⟩ := Nat.exists_prime_and_dvd ne
      have := smooth q pq dq
      have := pq.two_le
      omega
    refine ⟨1,1,by decide,by decide,by decide,by simpa only [one_pow,mul_one] using unit,?_⟩
    intro q pq div
    have := Nat.le_of_dvd (by decide : 0<1) div
    have := pq.two_le
    omega
  | succ t ih =>
    let p := t+1
    let e := n.factorization p
    let m := n/p^e
    have fac : p^e*m=n := Nat.ordProj_mul_ordCompl_eq_self n p
    have dm : m∣n := Nat.ordCompl_dvd n p
    have pos : 0 < m := Nat.ordCompl_pos p hn.ne'
    have smaller (q : ℕ) (pq : q.Prime) (dq : q∣m) : q ≤ t := by
      have upper := smooth q pq (dq.trans dm)
      by_contra! high
      have equal : q=p := by dsimp [p]; omega
      rw [equal] at pq dq
      exact (Nat.not_dvd_ordCompl pq hn.ne') dq
    obtain ⟨D,y,cap,hD,hy,form,divisors⟩ := ih m pos smaller
    obtain ⟨i,j,ei,i3,ji⟩ := split_factor_exponent e
    have small : p^i ≤ (t+2)^3 :=
      (Nat.pow_le_pow_right (show 0 < p by dsimp [p]; omega) i3).trans
        (Nat.pow_le_pow_left (show p ≤ t+2 by dsimp [p]; omega) 3)
    have total : D*p^i ≤ (t+1+1).factorial^3 := by
      have bound := Nat.mul_le_mul cap small
      rw [Nat.factorial_succ (t+1),mul_pow,Nat.mul_comm ((t+1+1)^3)]
      exact bound
    refine ⟨D*p^i,y*p^j,total,Nat.mul_pos hD (pow_pos (by dsimp [p]; omega) _),
      Nat.mul_pos hy (pow_pos (by dsimp [p]; omega) _),?_,?_⟩
    · calc
        n = p^e*m := fac.symm
        _ = _ := by rw [form,ei,pow_add,pow_mul,mul_pow]; ring
    · intro q pq dq
      rcases pq.dvd_mul.mp dq with fromY|fromP
      · exact dvd_mul_of_dvd_left (divisors q pq fromY) _
      · have jp : 0 < j := by
          by_contra! low
          have zero : j=0 := by omega
          rw [zero,pow_zero] at fromP
          have := Nat.le_of_dvd (by decide : 0<1) fromP
          have := pq.two_le
          omega
        have pp : p.Prime := by
          by_contra np
          have zero : e=0 := Nat.factorization_eq_zero_of_not_prime n np
          omega
        have same := (Nat.prime_dvd_prime_iff_eq pq pp).mp (pq.dvd_of_dvd_pow fromP)
        rw [same]
        exact dvd_mul_of_dvd_right (pow_dvd_pow p (ji jp)) _

/-- Every square-plus-one supported on primes at most T gives a negative Pell
equation with D in an explicit finite interval. Each prime dividing its
positive y-coordinate has its square dividing D. -/
theorem quadratic_smooth_decomposition (T x : ℕ)
    (smooth : ∀ q : ℕ, q.Prime → q∣x^2+1 → q ≤ T) :
    ∃ D ∈ Finset.Icc 1 ((T+1).factorial^3), ∃ y : ℕ, 0 < D ∧ 0 < y ∧
      x^2+1=D*y^2 ∧ ∀ q : ℕ, q.Prime → q∣y → q^2∣D := by
  obtain ⟨D,y,cap,hD,hy,form,divisors⟩ := smooth_square_decomposition T (x^2+1) (by omega) smooth
  exact ⟨D,Finset.mem_Icc.mpr ⟨hD,cap⟩,y,hD,hy,form,divisors⟩



-- BEGIN PELL VALUATION
private theorem pell_expansion_remainder {d : ℤ} (z : Pell.Solution₁ d) (n : ℕ) :
    ∃ L K : ℤ, (z^(n+1)).x=z.x^(n+1)+d*L ∧
      (z^(n+1)).y=z.y*((n+1 : ℕ)*(z.x^n)+d*K) := by
  induction n with
  | zero => exact ⟨0,0,by simp,by simp⟩
  | succ n ih =>
    obtain ⟨L,K,hx,hy⟩ := ih
    refine ⟨L*z.x+(z^(n+1)).y*z.y,L+K*z.x,?_,?_⟩
    · change (z^(n+1)*z).x=z.x^(n+1+1)+d*(L*z.x+(z^(n+1)).y*z.y)
      rw [Pell.Solution₁.x_mul,hx,pow_succ z.x (n+1)]
      ring
    · change (z^(n+1)*z).y=z.y*((n+1+1:ℕ)*z.x^(n+1)+d*(L+K*z.x))
      rw [Pell.Solution₁.y_mul,hx,hy,pow_succ z.x n]
      push_cast
      ring

private theorem pell_prime_multiplier {D l q : ℕ} (z : Pell.Solution₁ (D:ℤ))
    (pl : l.Prime) (pq : q.Prime) (dq : q^2∣D) :
    ∃ k : ℕ, (z^l).y.natAbs=z.y.natAbs*k ∧ k≠0 ∧ k.factorization q=l.factorization q := by
  let _ : Fact q.Prime := ⟨pq⟩
  obtain ⟨_,K,_,hy⟩ := pell_expansion_remainder z (l-1)
  rw [Nat.sub_add_cancel pl.one_le] at hy
  obtain ⟨h,dh⟩ := dq
  have dint : (D:ℤ)=(q:ℤ)^2*h := by exact_mod_cast dh
  have zd : (D:ZMod q)=0 := (ZMod.natCast_eq_zero_iff _ _).mpr (dh ▸ dvd_mul_of_dvd_left (dvd_pow_self q (by decide : (2:ℕ)≠0)) h)
  have xz : (z.x:ZMod q)≠0 := by
    intro zero
    have f := congrArg (fun v:ℤ => (v:ZMod q)) z.prop
    push_cast at f
    rw [zd,zero,zero_pow two_ne_zero,zero_mul,sub_zero] at f
    exact zero_ne_one f
  let a := z.x^(l-1)
  have an : (a:ZMod q)≠0 := by dsimp [a]; push_cast; exact pow_ne_zero _ xz
  have no {c : ℤ} (hc : (c:ZMod q)≠0) : ¬q∣c.natAbs :=
    fun dd => hc ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr (Int.natCast_dvd.mpr dd))
  by_cases same : l=q
  · subst l
    let c := a+(q:ℤ)*h*K
    have cn : ¬q∣c.natAbs := no (by simpa [c] using an)
    have nc : c.natAbs≠0 := fun e => cn (e ▸ dvd_zero q)
    have yq : (z^q).y=z.y*((q:ℤ)*c) := by
      rw [hy]
      dsimp only [a,c]
      linear_combination z.y*K*dint
    refine ⟨q*c.natAbs,?_,mul_ne_zero pq.ne_zero nc,?_⟩
    · rw [yq]; simp only [Int.natAbs_mul,Int.natAbs_natCast]
    · rw [Nat.factorization_mul pq.ne_zero nc,Finsupp.add_apply,Nat.factorization_eq_zero_of_not_dvd cn,add_zero]
  · have nl : ¬q∣l := fun h => same ((Nat.prime_dvd_prime_iff_eq pq pl).mp h).symm
    have lv : (l:ZMod q)≠0 := fun h => nl ((ZMod.natCast_eq_zero_iff _ _).mp h)
    let c := (l:ℤ)*a+(D:ℤ)*K
    have cn : ¬q∣c.natAbs := no (by
      dsimp only [c]
      push_cast
      rw [zd,zero_mul,add_zero]
      exact mul_ne_zero lv an)
    have nc : c.natAbs≠0 := fun e => cn (e ▸ dvd_zero q)
    refine ⟨c.natAbs,?_,nc,?_⟩
    · rw [hy,Int.natAbs_mul]
    · rw [Nat.factorization_eq_zero_of_not_dvd cn,Nat.factorization_eq_zero_of_not_dvd nl]

/-- At a prime whose square divides D, the imaginary coordinate of a Pell power gains exactly the exponent's valuation. -/
theorem pell_factorization_y_pow {D q n : ℕ} (eps : Pell.Solution₁ (D : ℤ))
    (pq : q.Prime) (dq : q^2∣D) (hn : 0 < n) :
    (eps^n).y.natAbs.factorization q = (n*eps.y.natAbs).factorization q := by
  by_cases hzero : eps.y=0
  · obtain ⟨_,_,_,hy⟩ := pell_expansion_remainder eps (n-1)
    rw [Nat.sub_add_cancel hn,hzero,zero_mul] at hy
    simp [hy,hzero]
  have base : eps.y.natAbs≠0 := fun h => hzero (Int.natAbs_eq_zero.mp h)
  have all : ∀ j : ℕ, j≠0 → (eps^j).y.natAbs≠0 ∧
      (eps^j).y.natAbs.factorization q=(j*eps.y.natAbs).factorization q := by
    apply induction_on_primes
    · simp
    · simp [base]
    · intro l a pl ih nz
      have ap : a≠0 := fun e => nz (by rw [e,mul_zero])
      obtain ⟨nonzero,ihv⟩ := ih ap
      obtain ⟨k,mult,kpos,kv⟩ := pell_prime_multiplier (eps^a) pl pq dq
      have e : eps^(l*a)=(eps^a)^l := by rw [←pow_mul,Nat.mul_comm]
      rw [e,mult]
      refine ⟨mul_ne_zero nonzero kpos,?_⟩
      rw [Nat.factorization_mul nonzero kpos,Finsupp.add_apply,kv,ihv,Nat.mul_assoc,
        Nat.factorization_mul pl.ne_zero (mul_ne_zero ap base),Finsupp.add_apply,Nat.add_comm]
  exact (all n hn.ne').2
-- END PELL VALUATION


private theorem cube_le_two_pow {m : ℕ} (hm : 10 ≤ m) : m^3≤2^m := by
  induction m,hm using Nat.le_induction with
  | base => decide
  | succ k hk ih =>
    rw [pow_succ 2 k]
    have step : (k+1)^3≤2*k^3 := by
      have k2 : 5*k ≤ k^2 := by nlinarith [Nat.mul_le_mul_right k (show 5 ≤ k by omega)]
      nlinarith [Nat.mul_le_mul_right (k^2) (show 5 ≤ k by omega)]
    omega

private theorem pell_growth {D : ℤ} (eps : Pell.Solution₁ D) (hx : 1 < eps.x)
    (hy : 0 < eps.y) (n : ℕ) : (2:ℤ)^n*eps.y ≤ (eps^(n+1)).y := by
  induction n with
  | zero => simp
  | succ n ih =>
    have sx := Pell.Solution₁.x_pow_pos (show 0 < eps.x by omega) (n+1)
    have sy := Pell.Solution₁.y_pow_succ_pos (show 0 < eps.x by omega) hy n
    have grow := mul_le_mul_of_nonneg_left (show (2:ℤ) ≤ eps.x by omega) sy.le
    rw [pow_succ, show n+1+1=(n+1)+1 by rfl, pow_succ eps (n+1),Pell.Solution₁.y_mul]
    nlinarith [mul_pos sx hy]

private theorem quadratic_twist_bound (D : ℕ)
    (valuation : ∀ (eps : Pell.Solution₁ (D:ℤ)) (q n : ℕ), q.Prime → q^2∣D →
      0 < n → 1 < eps.x → 0 < eps.y →
      ((eps^n).y.natAbs).factorization q=(n*eps.y.natAbs).factorization q) :
    ∃ B : ℕ, ∀ x y : ℕ, 0 < y → x^2+1=D*y^2 →
      (∀ q : ℕ, q.Prime → q∣y → q^2∣D) → x ≤ B := by
  classical
  by_cases has : ∃ e : Pell.Solution₁ (D:ℤ), Pell.IsFundamental e
  · obtain ⟨eps,he⟩ := has
    let Y := eps.y.natAbs
    refine ⟨D*(10+4*D*Y)*Y,?_⟩
    intro x y hy eq support
    by_cases hx : x=0
    · omega
    have castEq : (x:ℤ)^2+1=(D:ℤ)*(y:ℤ)^2 := by exact_mod_cast eq
    have id : ((2:ℤ)*x^2+1)^2-D*(2*(x:ℤ)*y)^2=1 := by
      linear_combination -4*(x:ℤ)^2*(castEq.symm)
    let sol : Pell.Solution₁ (D:ℤ) := Pell.Solution₁.mk _ _ id
    have sx : sol.x=2*(x:ℤ)^2+1 := rfl
    have sy : sol.y=2*(x:ℤ)*y := rfl
    obtain ⟨n,hn⟩ := he.eq_pow_of_nonneg (a:=sol) (by rw [sx]; positivity) (by rw [sy]; positivity)
    have nz : 0 < n := by
      by_contra! h
      have : n=0 := by omega
      rw [this,pow_zero] at hn
      have eqy := congrArg Pell.Solution₁.y hn
      rw [sy,Pell.Solution₁.y_one] at eqy
      have : 0<(x:ℤ) := by exact_mod_cast Nat.pos_of_ne_zero hx
      have pos : 0<2*(x:ℤ)*y := by positivity
      omega
    have YY : 0 < Y := by dsimp [Y]; exact Int.natAbs_pos.mpr he.2.1.ne'
    have imag : (eps^n).y.natAbs=2*x*y := by
      rw [←hn,sy,Int.natAbs_mul,Int.natAbs_mul]
      rfl
    have ydiv : y∣n*Y := by
      apply (Nat.factorization_le_iff_dvd hy.ne' (Nat.mul_pos nz YY).ne').mp
      intro q
      by_cases pq : q.Prime
      · by_cases dy : q∣y
        · have div : y∣2*x*y := dvd_mul_left _ _
          have nonz : 2*x*y≠0 := by positivity
          have le := (Nat.factorization_le_iff_dvd hy.ne' nonz).mpr div q
          rw [←imag,valuation eps q n pq (support q pq dy) nz he.1 he.2.1] at le
          exact le
        · simp [Nat.factorization_eq_zero_of_not_dvd dy]
      · simp [Nat.factorization_eq_zero_of_not_prime _ pq]
    have ybound := Nat.le_of_dvd (Nat.mul_pos nz YY) ydiv
    have Dx : x ≤ D*y := by
      have hD : 0 < D := by exact_mod_cast he.d_pos
      by_contra! large
      have h := Nat.mul_le_mul (show 1 ≤ D by omega) (Nat.le_refl (D*y^2))
      nlinarith [Nat.mul_self_lt_mul_self large]
    have expBound : 2^n*Y ≤ 4*x*y := by
      obtain ⟨j,rfl⟩ := Nat.exists_eq_succ_of_ne_zero nz.ne'
      have low := pell_growth eps he.1 he.2.1 j
      have eqy := congrArg Pell.Solution₁.y hn
      rw [←eqy,sy] at low
      have castY : (Y:ℤ)=eps.y := Int.natAbs_of_nonneg he.2.1.le
      change (2:ℕ)^(j+1)*Y ≤ 4*x*y
      zify
      rw [castY,pow_succ]
      linarith
    have nbound : n≤10+4*D*Y := by
      by_cases big : 10 ≤ n
      · have cube := cube_le_two_pow big
        have upper := Nat.mul_le_mul Dx ybound
        have upper' := Nat.mul_le_mul (Nat.mul_le_mul_left D ybound) (Nat.le_refl (n*Y))
        have all : n^3*Y≤(4*D*Y)*(n^2*Y) := by
          nlinarith [Nat.mul_le_mul_right Y cube]
        have eqN : n^3*Y=n*(n^2*Y) := by ring
        rw [eqN] at all
        have := Nat.le_of_mul_le_mul_right all (by positivity : 0 < n^2*Y)
        omega
      · omega
    exact Dx.trans (by calc
      D*y ≤ D*(n*Y) := Nat.mul_le_mul_left _ ybound
      _ ≤ D*((10+4*D*Y)*Y) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ nbound)
      _ = _ := by ring)
  · refine ⟨0,?_⟩
    intro x y hy eq _
    by_contra! xbig
    have castEq : (x:ℤ)^2+1=(D:ℤ)*(y:ℤ)^2 := by exact_mod_cast eq
    have id : ((2:ℤ)*x^2+1)^2-D*(2*(x:ℤ)*y)^2=1 := by
      linear_combination -4*(x:ℤ)^2*(castEq.symm)
    let sol : Pell.Solution₁ (D:ℤ) := Pell.Solution₁.mk _ _ id
    have sx : 1 < sol.x := by
      change 1<2*(x:ℤ)^2+1
      have hxZ : 0<(x:ℤ) := by exact_mod_cast xbig
      nlinarith [sq_pos_of_pos hxZ]
    exact has (Pell.IsFundamental.exists_of_not_isSquare
      (Pell.Solution₁.d_pos_of_one_lt_x sx) (Pell.Solution₁.d_nonsquare_of_one_lt_x sx))


/-- The greatest prime factor of x²+1 eventually exceeds each fixed bound. -/
theorem large_prime_of_square_add_one (T : ℕ) : ∃ B : ℕ, ∀ x : ℕ, B < x →
    ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1 := by
  classical
  have bounds (D : ℕ) := quadratic_twist_bound D (fun eps q n pr dv hn _ _ =>
    pell_factorization_y_pow eps pr dv hn)
  choose bound covers using bounds
  let ds := Finset.Icc 1 ((T+1).factorial^3)
  refine ⟨ds.sup bound,?_⟩
  intro x hx
  by_contra missing
  have smooth (q : ℕ) (pr : q.Prime) (dv : q∣x^2+1) : q ≤ T := by
    by_contra! big
    exact missing ⟨q,pr,big,dv⟩
  obtain ⟨D,hd,y,_,hy,eq,dv⟩ := quadratic_smooth_decomposition T x smooth
  exact (not_lt_of_ge ((covers D x y hy eq dv).trans (Finset.le_sup (f:=bound) hd))) hx

private theorem two_primes {n k p q : ℕ} (hk : 0 < k) (pp : p.Prime) (pq : q.Prime)
    (ne : p≠q) (hp : k < p) (hq : k < q) (dp : p∣n+k) (dq : q∣n+k) : (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → False :=
  fun missing => missing ⟨k,p,q,hk,pp,pq,ne,hp,hq,dp,dq⟩

lemma odd_cofactor {x r : ℕ} (ox : Odd x) (hx : 1 < x) (orr : Odd r) (hr : 1 < r) :
    ∃ c : ℕ, Odd c ∧ r < c ∧ x^r+1 = (x+1)*c := by
  obtain ⟨w, hw⟩ := ox
  obtain ⟨j, rfl⟩ := orr
  have wp : 0 < w := by omega
  have hx3 : 3 ≤ x := by omega
  have aux (i : ℕ) : ∃ z : ℕ, 2*i ≤ z ∧ x^(2*i+1)+1 = (x+1)*(2*z+1) := by
    induction i with
    | zero => exact ⟨0, by decide, by simp⟩
    | succ i ih =>
      obtain ⟨z, hz, he⟩ := ih
      refine ⟨x^2*z+w*x, ?_, ?_⟩
      · have mulz : z ≤ x^2*z := by
          simpa using Nat.mul_le_mul_right z (show 1 ≤ x^2 by exact Nat.one_le_pow _ _ (by omega))
        have mulw : 3 ≤ w*x := by simpa using Nat.mul_le_mul wp hx3
        omega
      · rw [show 2*(i+1)+1 = (2*i+1)+2 by omega, pow_add]
        have scaled := congrArg (fun m : ℕ => m*x^2) he
        rw [hw] at scaled ⊢
        nlinarith only [scaled]
  obtain ⟨z, hz, he⟩ := aux j
  exact ⟨2*z+1, ⟨z,rfl⟩, by omega, he⟩

private theorem smooth_fourth_decomposition (T n : ℕ) (hn : 0 < n)
    (smooth : ∀ q : ℕ, q.Prime → q∣n → q ≤ T) :
    ∃ C z : ℕ, C ≤ T.factorial^3 ∧ 0 < C ∧ 0 < z ∧ n=C*z^4 := by
  induction T generalizing n with
  | zero =>
    have unit : n=1 := by
      by_contra ne
      obtain ⟨q,pq,dq⟩ := Nat.exists_prime_and_dvd ne
      have := smooth q pq dq
      have := pq.two_le
      omega
    exact ⟨1,1,by decide,by decide,by decide,by simpa only [one_pow,mul_one] using unit⟩
  | succ t ih =>
    let p := t+1
    let e := n.factorization p
    let m := n/p^e
    have fac : p^e*m=n := Nat.ordProj_mul_ordCompl_eq_self n p
    have dm : m∣n := Nat.ordCompl_dvd n p
    have pos : 0 < m := Nat.ordCompl_pos p hn.ne'
    have smaller (q : ℕ) (pq : q.Prime) (dq : q∣m) : q ≤ t := by
      have upper := smooth q pq (dq.trans dm)
      by_contra! high
      have equal : q=p := by dsimp [p]; omega
      rw [equal] at pq dq
      exact (Nat.not_dvd_ordCompl pq hn.ne') dq
    obtain ⟨C,z,cap,hC,hz,form⟩ := ih m pos smaller
    have ppos : 0 < p := by dsimp [p]; omega
    have small : p^(e%4) ≤ p^3 := Nat.pow_le_pow_right ppos (by omega)
    have total : C*p^(e%4)≤(t+1).factorial^3 := by
      rw [Nat.factorial_succ,mul_pow,Nat.mul_comm ((t+1)^3)]
      exact Nat.mul_le_mul cap small
    refine ⟨C*p^(e%4),z*p^(e/4),total,Nat.mul_pos hC (pow_pos ppos _),
      Nat.mul_pos hz (pow_pos ppos _),?_⟩
    have ei : e=e%4+(e/4)*4 := by rw [Nat.mul_comm (e/4) 4,Nat.mod_add_div]
    calc
      n = p^e*m := fac.symm
      _ = p^(e%4+(e/4)*4)*(C*z^4) := by rw [←ei,form]
      _ = _ := by rw [pow_add,pow_mul,mul_pow]; ring

private theorem two_quadratic_factors {T u : ℕ} (hT : 4 ≤ T)
    (h₁ : ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣u^2+1)
    (h₂ : ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣(u+2)^2+1) :
    ∃ q s : ℕ, q.Prime ∧ s.Prime ∧ q≠s ∧ T < q ∧ T < s ∧ q∣(u+1)^4+4 ∧ s∣(u+1)^4+4 := by
  obtain ⟨q,pq,hq,dq⟩ := h₁
  obtain ⟨s,ps,hs,ds⟩ := h₂
  let z := u+1
  let L := u^2+1
  let R := (u+2)^2+1
  change q∣L at dq
  change s∣R at ds
  have fac : (u+1)^4+4=L*R := by dsimp only [L,R]; ring
  refine ⟨q,s,pq,ps,?_,hq,hs,fac ▸ dvd_mul_of_dvd_left dq _,fac ▸ dvd_mul_of_dvd_right ds _⟩
  rintro rfl
  have diff : R=L+4*z := by dsimp only [R,L,z]; ring
  rw [diff] at ds
  have d4 := (Nat.dvd_add_iff_right dq).mpr ds
  have dz : q∣z := (pq.dvd_mul.mp d4).resolve_left (by
    intro dv; have := Nat.le_of_dvd (by decide : 0<4) dv; omega)
  have sum := dvd_add dq (dvd_mul_of_dvd_right dz 2)
  rw [show L+2*z=z^2+2 by dsimp only [L,z]; ring] at sum
  have sq : q∣z^2 := dz.trans (dvd_pow_self z (by decide : 2≠0))
  have bad := (Nat.dvd_add_iff_right sq).mpr sum
  have := Nat.le_of_dvd (by decide : 0<2) bad
  omega

/-- Uniformly over each fixed initial interval of offsets, a sufficiently large
solution has a prime factor above any prescribed threshold at every offset. -/
theorem eventual_large_prime_at_offsets
    (quadratic : ∀ T : ℕ, ∃ B : ℕ, ∀ x : ℕ, B < x → ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1)
    (L T : ℕ) :
    ∃ B : ℕ, ∀ n : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → ∀ k : ℕ, 0 < k → k ≤ L →
      ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣n+k := by
  let M := T.factorial^3
  let bound := L+4*M
  have mp : 0 < M := pow_pos T.factorial_pos 3
  have top : 4 ≤ bound := by dsimp only [bound]; omega
  obtain ⟨K,hK⟩ := quadratic bound
  refine ⟨M*(K+2)^4,?_⟩
  intro n hn sol k kp kl
  by_contra! noLarge
  have smooth (q : ℕ) (pq : q.Prime) (dq : q∣n+k) : q ≤ T := by
    by_contra! large
    exact noLarge q pq large dq
  obtain ⟨C,z,cap,_cp,_zp,form⟩ := smooth_fourth_decomposition T (n+k) (by omega) smooth
  change C ≤ M at cap
  have large : K+2 < z := by
    by_contra! low
    have cmp := Nat.mul_le_mul cap (Nat.pow_le_pow_left low 4)
    omega
  let u := z-1
  have zu : z=u+1 := by dsimp only [u]; omega
  have ku : K < u := by omega
  obtain ⟨a,b,pa,pb,ne,ha,hb,da,db⟩ := two_quadratic_factors top (hK u ku) (hK (u+2) (by omega))
  have fac : n+(k+4*C)=C*((u+1)^4+4) := by
    rw [zu] at form
    calc
      _ = (n+k)+4*C := by omega
      _ = _ := by rw [form]; ring
  have ub : k+4*C ≤ bound := by dsimp only [bound]; omega
  exact two_primes (k:=k+4*C) (by omega) pa pb ne (by omega) (by omega)
    (fac ▸ dvd_mul_of_dvd_right da C) (fac ▸ dvd_mul_of_dvd_right db C) sol

/-- Every fixed prime divides all sufficiently large lowercase Erdős 889
solutions when the largest prime factor of x²+1 tends to infinity. -/
theorem eventual_prime_divisibility
    (quadratic : ∀ T : ℕ, ∃ B : ℕ, ∀ x : ℕ, B < x → ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1)
    (q : ℕ) (pq : q.Prime) :
    ∃ B : ℕ, ∀ n : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → q∣n := by
  obtain ⟨B,h⟩ := eventual_large_prime_at_offsets quadratic q q
  refine ⟨B,?_⟩
  intro n hn sol
  by_contra avoid
  let k := q-n%q
  have rem := Nat.mod_lt n pq.pos
  have nr : n%q≠0 := fun z => avoid (Nat.dvd_of_mod_eq_zero z)
  have kp : 0 < k := by dsimp only [k]; omega
  have kq : k < q := by dsimp only [k]; omega
  have qd : q∣n+k := by
    refine ⟨n/q+1,?_⟩
    have sum := Nat.mod_add_div n q
    rw [Nat.mul_add,mul_one]
    dsimp only [k]
    omega
  obtain ⟨r,pr,hr,dr⟩ := h n hn sol k kp kq.le
  exact two_primes kp pq pr (by omega) kq (by omega) qd dr sol

/-- Over a fixed initial interval of offsets, every prime dividing n+k
eventually divides k itself, with exactly one exception above any fixed threshold. -/
theorem eventual_prime_support
    (quadratic : ∀ T : ℕ, ∃ B : ℕ, ∀ x : ℕ, B < x → ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1)
    (K T : ℕ) :
    ∃ B : ℕ, ∀ n : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → ∀ k : ℕ, 0 < k → k ≤ K →
      ∃ q : ℕ, q.Prime ∧ max K T < q ∧ q∣n+k ∧
        ∀ r : ℕ, r.Prime → (r∣n+k ↔ r∣k ∨ r=q) := by
  have small (L : ℕ) : ∃ B : ℕ, ∀ n : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) →
      ∀ r : ℕ, r ≤ L → r.Prime → r∣n := by
    induction L with
    | zero =>
      refine ⟨0,?_⟩
      intro n hn sol r low pr
      have := pr.two_le
      omega
    | succ l ih =>
      obtain ⟨A,hA⟩ := ih
      by_cases prime : (l+1).Prime
      · obtain ⟨B,hB⟩ := eventual_prime_divisibility quadratic (l+1) prime
        refine ⟨max A B,?_⟩
        intro n hn sol r le pr
        by_cases e : r=l+1
        · exact e ▸ hB n (lt_of_le_of_lt (Nat.le_max_right _ _) hn) sol
        · exact hA n (lt_of_le_of_lt (Nat.le_max_left _ _) hn) sol r (by omega) pr
      · refine ⟨A,?_⟩
        intro n hn sol r le pr
        have ne : r≠l+1 := by rintro rfl; exact prime pr
        exact hA n hn sol r (by omega) pr
  obtain ⟨A,ha⟩ := small K
  obtain ⟨B,hb⟩ := eventual_large_prime_at_offsets quadratic K (max K T)
  refine ⟨max A B,?_⟩
  intro n hn sol k kp kk
  obtain ⟨q,pq,hq,dq⟩ := hb n (lt_of_le_of_lt (Nat.le_max_right _ _) hn) sol k kp kk
  refine ⟨q,pq,hq,dq,?_⟩
  intro r pr
  constructor
  · intro dr
    by_cases low : r ≤ K
    · have dn := ha n (lt_of_le_of_lt (Nat.le_max_left _ _) hn) sol r low pr
      exact Or.inl ((Nat.dvd_add_iff_right dn).mpr dr)
    · right
      by_contra different
      have := Nat.le_max_left K T
      exact two_primes kp pr pq different (by omega) (by omega) dr dq sol
  · rintro (dk|rfl)
    · have low := (Nat.le_of_dvd kp dk).trans kk
      exact dvd_add (ha n (lt_of_le_of_lt (Nat.le_max_left _ _) hn) sol r low pr) dk
    · exact dq

private theorem universal_odd_cofactor {x d : ℕ} (hx : 3 ≤ x) (hd : 1 < d) (od : Odd d) :
    ∃ c : ℕ, Odd c ∧ d < c ∧ x^d+1=(x+1)*c := by
  rcases Nat.even_or_odd x with ev|ox
  · obtain ⟨c,fac⟩ : x+1∣x^d+1 := by simpa only [one_pow] using od.nat_add_dvd_pow_add_pow x 1
    have oddC : Odd c := by
      have e := ev.pow_of_ne_zero (by omega : d≠0)
      have o : Odd (x^d+1) := by obtain ⟨j,hj⟩ := e; exact ⟨j,by omega⟩
      rw [fac,Nat.odd_mul] at o
      exact o.2
    have growth (j : ℕ) : (j+3)*(x+1) < x^(j+3) := by
      induction j with
      | zero =>
        have xs : 4 < x^2 := lt_of_lt_of_le (by decide : 4<9) (Nat.pow_le_pow_left hx 2)
        have mul := Nat.mul_lt_mul_of_pos_right xs (by omega : 0 < x)
        change 3*(x+1) < x^3
        rw [pow_succ]
        omega
      | succ j ih =>
        have z := Nat.mul_le_mul_right (x+1) (by omega : 1 ≤ j+3)
        simp only [one_mul] at z
        have lower := Nat.mul_le_mul_left (x^(j+3)) (by omega : 2 ≤ x)
        rw [show j+1+3=j+3+1 by omega,pow_succ,Nat.add_mul,one_mul]
        omega
    have d3 : 3 ≤ d := by obtain ⟨j,hj⟩ := od; omega
    have h := growth (d-3)
    rw [Nat.sub_add_cancel d3] at h
    refine ⟨c,oddC,?_,fac⟩
    by_contra! low
    have := Nat.mul_le_mul_left (x+1) low
    rw [Nat.mul_comm d (x+1)] at h
    omega
  · exact odd_cofactor ox (by omega) od hd

private theorem fresh_prime_for_odd_power {x d : ℕ} (hx : 3 ≤ x) (hd : 1 < d) (od : Odd d) :
    ∃ q : ℕ, q.Prime ∧ 3 < q ∧ q∣x^d+1 ∧ ¬q∣x+1 := by
  obtain ⟨c,oc,hc,fac⟩ := universal_odd_cofactor hx hd od
  by_contra missing
  have cd : c∣d := by
    apply (Nat.factorization_le_iff_dvd (by omega : c≠0) (by omega : d≠0)).mp
    intro q
    by_cases pq : q.Prime
    · by_cases dq : q∣c
      · have hi : 2 < q := by
          have := pq.two_le
          by_contra! low
          have q2 : q=2 := by omega
          rw [q2] at dq
          obtain ⟨j,hj⟩ := oc
          omega
        have df : q∣x^d+1 := fac ▸ dvd_mul_of_dvd_right dq _
        have dx : q∣x+1 := by
          by_contra nx
          by_cases three : q=3
          · subst q
            have nz : x%3≠0 := by
              intro modzero
              have dv := (Nat.dvd_of_mod_eq_zero modzero).trans (dvd_pow_self x (by omega : d≠0))
              omega
            have one : x%3=1 := by omega
            have co := (Nat.mod_modEq x 3).pow d
            change (x%3)^d%3=x^d%3 at co
            rw [one,one_pow] at co
            omega
          · exact missing ⟨q,pq,by omega,df,nx⟩
        let _ : Fact q.Prime := ⟨pq⟩
        have nd : ¬q∣x := by
          intro div
          have one := (Nat.dvd_add_iff_right div).mpr dx
          have := Nat.le_of_dvd Nat.one_pos one
          omega
        have val := padicValNat.pow_add_pow (x:=x) (y:=1) (pq.odd_of_ne_two (by omega)) dx nd od
        rw [one_pow,fac,padicValNat.mul (by omega) (by omega)] at val
        change c.factorization q ≤ d.factorization q
        rw [Nat.factorization_def _ pq,Nat.factorization_def _ pq]
        omega
      · exact (Nat.factorization_eq_zero_of_not_dvd dq).trans_le (Nat.zero_le _)
    · exact (Nat.factorization_eq_zero_of_not_prime c pq).trans_le (Nat.zero_le _)
  exact (Nat.not_le_of_gt hc) (Nat.le_of_dvd (by omega) cd)

private theorem odd_dvd_pullback {p d x : ℕ} (pp : p.Prime) (od : Odd d) (hd : 1 < d)
    (cop : d.Coprime (p-1)) (div : p∣x^d+1) : p∣x+1 := by
  let _ : Fact p.Prime := ⟨pp⟩
  have eq := (ZMod.natCast_eq_zero_iff (x^d+1) p).mpr div
  push_cast at eq
  have odd : (-(x:ZMod p))^d=1 := by
    rw [neg_pow,od.neg_one_pow]
    linear_combination -eq
  have nz : -(x:ZMod p)≠0 := by
    intro z
    rw [z,zero_pow (by omega : d≠0)] at odd
    exact zero_ne_one odd
  have dn := Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one odd)
    (orderOf_dvd_of_pow_eq_one (ZMod.pow_card_sub_one_eq_one nz))
  rw [cop.gcd_eq_one] at dn
  have one := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_one dn)
  apply (ZMod.natCast_eq_zero_iff (x+1) p).mp
  push_cast
  linear_combination -one

/-- For every fixed odd exponent greater than one and fixed positive offset k
whose prime divisors have p−1 coprime to d, sufficiently large solutions cannot have n+k=k z^d. -/
theorem normalized_odd_power_exclusion
    (quadratic : ∀ T : ℕ, ∃ B : ℕ, ∀ x : ℕ, B < x → ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1)
    (k d : ℕ) (kp : 0 < k) (compatible : ∀ q : ℕ, q.Prime → q∣k → d.Coprime (q-1))
    (hd : 1 < d) (od : Odd d) :
    ∃ B : ℕ, ∀ n z : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → n+k≠k*z^d := by
  let M := (2*k).factorial^3
  let S := 1+4*M
  have mp : 0 < M := pow_pos (Nat.factorial_pos _) _
  have s5 : 5 ≤ S := by dsimp only [S]; omega
  let T := k*(1+S^d)
  have t4 : 4 ≤ T := by
    have s : S ≤ S^d := Nat.le_self_pow (by omega : d≠0) S
    have r := Nat.mul_le_mul_right (1+S^d) kp
    dsimp only [T]
    omega
  obtain ⟨K,hK⟩ := quadratic T
  let Z := M*(K+3)^4+4
  obtain ⟨A,hA⟩ := eventual_prime_support quadratic (2*k) 3
  refine ⟨max A (k*Z^d),?_⟩
  intro n z big sol eq
  have lowA := Nat.le_max_left A (k*Z^d)
  have lowZ := Nat.le_max_right A (k*Z^d)
  have zlarge : Z < z := by
    by_contra! low
    have := Nat.mul_le_mul_left k (Nat.pow_le_pow_left low d)
    omega
  have z3 : 3 ≤ z := by dsimp only [Z] at zlarge; omega
  obtain ⟨q,pq,hq,dq,notOld⟩ := fresh_prime_for_odd_power z3 hd od
  have next : n+2*k=k*(z^d+1) := by
    calc
      _ = (n+k)+k := by omega
      _ = _ := by rw [eq]; ring
  have dqn : q∣n+2*k := next ▸ dvd_mul_of_dvd_right dq _
  obtain ⟨r,pr,hr,dr,all⟩ := hA n (by omega) sol (2*k) (by omega) le_rfl
  have qnk : ¬q∣2*k := by
    intro ds
    rcases pq.dvd_mul.mp ds with d2|dk
    · have := Nat.le_of_dvd (by decide : 0<2) d2; omega
    · exact notOld (odd_dvd_pullback pq od hd (compatible q pq dk) dq)
  have qr : q=r := ((all q pq).mp dqn).resolve_left qnk
  have smoothZ (s : ℕ) (ps : s.Prime) (ds : s∣z+1) : s≤2*k := by
    by_contra! high
    have af : z+1∣z^d+1 := by simpa only [one_pow] using od.nat_add_dvd_pow_add_pow z 1
    have dsn : s∣n+2*k := next ▸ dvd_mul_of_dvd_right (ds.trans af) _
    have sr := ((all s ps).mp dsn).resolve_left (by intro d; have := Nat.le_of_dvd (by omega) d; omega)
    have sq : s=q := sr.trans qr.symm
    exact notOld (sq ▸ ds)
  obtain ⟨C,y,cap,_cp,_yp,form⟩ := smooth_fourth_decomposition (2*k) (z+1) (by omega) smoothZ
  change C ≤ M at cap
  have ybig : K+3 < y := by
    by_contra! low
    have cmp := Nat.mul_le_mul cap (Nat.pow_le_pow_left low 4)
    dsimp only [Z] at zlarge
    omega
  let u := y-1
  have yu : y=u+1 := by dsimp only [u]; omega
  obtain ⟨a,b,pa,pb,ne,ha,hb,da,db⟩ := two_quadratic_factors t4 (hK u (by omega)) (hK (u+2) (by omega))
  let s := 1+4*C
  have sh : z+s=C*((u+1)^4+4) := by
    dsimp only [s]
    rw [yu] at form
    calc
      _ = (z+1)+4*C := by omega
      _ = _ := by rw [form]; ring
  have up : s ≤ S := by dsimp only [s,S]; omega
  have pos : 0 < k*(1+s^d) := Nat.mul_pos kp (by omega)
  have bound : k*(1+s^d) ≤ T :=
    Nat.mul_le_mul_left k (Nat.add_le_add_left (Nat.pow_le_pow_left up d) 1)
  have offset : n+k*(1+s^d)=k*(z^d+s^d) := by
    calc
      _ = (n+k)+k*s^d := by ring
      _ = _ := by rw [eq]; ring
  have both : z+s∣n+k*(1+s^d) := offset ▸ dvd_mul_of_dvd_right (od.nat_add_dvd_pow_add_pow z s) _
  exact two_primes pos pa pb ne (by omega) (by omega)
    ((sh ▸ dvd_mul_of_dvd_right da C).trans both) ((sh ▸ dvd_mul_of_dvd_right db C).trans both) sol

/-- A prime modulus detects the coefficient exponent modulo a prime l.
The residue x^m has multiplicative order l. -/
private theorem detect_exponent {n x j a t e l Q m : ℕ} (pl : l.Prime) (pQ : Q.Prime)
    (xpos : 0 < x) (xQ : x < Q) (qr : Q-1=m*l) (nonres : x^m%Q≠1)
    (dn : Q∣n) (ep : 0 < e) (ed : l∣e) (eq : n+x^j=x^a*t^e) : a%l=j%l := by
  let _ : Fact Q.Prime := ⟨pQ⟩
  let X : ZMod Q := x
  let V : ZMod Q := t
  let W := X^m
  have Xnz : X≠0 := by
    intro z
    have := Nat.le_of_dvd xpos ((ZMod.natCast_eq_zero_iff x Q).mp z)
    omega
  have zn := (ZMod.natCast_eq_zero_iff n Q).mpr dn
  have zeq := congrArg (fun y : ℕ => (y:ZMod Q)) eq
  push_cast at zeq
  rw [zn,zero_add] at zeq
  change X^j=X^a*V^e at zeq
  have Vnz : V≠0 := by
    intro z
    rw [z,zero_pow ep.ne',mul_zero] at zeq
    exact (pow_ne_zero j Xnz) zeq
  have Wpow : W^l=1 := by
    dsimp only [W]; rw [←pow_mul,←qr]; exact ZMod.pow_card_sub_one_eq_one Xnz
  have Wne : W≠1 := by
    intro z
    have co : ((x^m:ℕ):ZMod Q)=(1:ℕ) := by simpa only [Nat.cast_pow,Nat.cast_one] using z
    have h := (ZMod.natCast_eq_natCast_iff _ _ _).mp co
    change x^m%Q=1%Q at h
    rw [Nat.mod_eq_of_lt pQ.one_lt] at h
    exact nonres h
  have ord : orderOf W=l := ((Nat.dvd_prime pl).mp (orderOf_dvd_of_pow_eq_one Wpow)).resolve_left
    (fun h => Wne (orderOf_eq_one_iff.mp h))
  obtain ⟨k,hk⟩ := ed
  have vp : (V^e)^m=1 := by
    rw [←pow_mul,hk,show l*k*m=(m*l)*k by ring,←qr,pow_mul,ZMod.pow_card_sub_one_eq_one Vnz,one_pow]
  have h := congrArg (fun v : ZMod Q => v^m) zeq
  change (X^j)^m=(X^a*V^e)^m at h
  rw [mul_pow,vp,mul_one,←pow_mul,←pow_mul,Nat.mul_comm j m,Nat.mul_comm a m,pow_mul,pow_mul] at h
  have finite := isOfFinOrder_iff_pow_eq_one.mpr ⟨l,pl.pos,Wpow⟩
  have ex := finite.pow_inj_mod.mp (show W^a=W^j from h.symm)
  rwa [ord] at ex

/-- A modular certificate excludes the prime exponent divisor l in the factorization
of a fixed shift by a power of x and a power of one variable base t. -/
theorem fixed_prime_exponent_exclusion
    (quadratic : ∀ T : ℕ, ∃ B : ℕ, ∀ x : ℕ, B < x → ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1)
    (x j l Q m : ℕ) (xpos : 0 < x) (jl : j < l) (pl : l.Prime) (ol : Odd l)
    (compatible : ∀ q : ℕ, q.Prime → q∣x^j → l.Coprime (q-1))
    (pQ : Q.Prime) (xQ : x < Q) (qr : Q-1=m*l) (nonres : x^m%Q≠1) :
    ∃ B : ℕ, ∀ n a t e : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → 0 < e →
      n+x^j=x^a*t^e → ¬l∣e := by
  obtain ⟨A,hA⟩ := normalized_odd_power_exclusion quadratic (x^j) l (pow_pos xpos j) compatible
    pl.one_lt ol
  obtain ⟨F,hF⟩ := eventual_prime_divisibility quadratic Q pQ
  refine ⟨max A F,?_⟩
  intro n a t e hn sol ep eq de
  have dQ := hF n (lt_of_le_of_lt (Nat.le_max_right _ _) hn) sol
  have aligned := detect_exponent pl pQ xpos xQ qr nonres dQ ep de eq
  rw [Nat.mod_eq_of_lt jl] at aligned
  have rem : a=j+a/l*l := by rw [←aligned,Nat.mul_comm (a/l) l,Nat.mod_add_div]
  obtain ⟨v,hv⟩ := de
  apply hA n (x^(a/l)*t^v) (lt_of_le_of_lt (Nat.le_max_left _ _) hn) sol
  calc
    _ = x^(j+a/l*l)*t^(v*l) := by rw [←rem,Nat.mul_comm v l,←hv,eq]
    _ = _ := by rw [pow_add,pow_mul,pow_mul,mul_pow]; ring

/-- Common prime moduli certify the exclusions for each base 2, 3 and 5. -/
theorem initial_odd_exponent_exclusions
    (quadratic : ∀ T : ℕ, ∃ B : ℕ, ∀ x : ℕ, B < x → ∃ q : ℕ, q.Prime ∧ T < q ∧ q∣x^2+1)
    (x j l Q : ℕ) (base : x=2 ∨ x=3 ∨ x=5) (jl : j < l)
    (row : (l,Q) ∈ ([(3,7),(5,11),(7,29),(11,23),(13,53),(17,103),(19,191),(23,47),
      (29,59),(31,311),(37,149),(41,83),(43,173),(47,283),(53,107)] : List (ℕ×ℕ))) :
    ∃ B : ℕ, ∀ n a t e : ℕ, B < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → 0 < e → n+x^j=x^a*t^e → ¬l∣e := by
  let rows : List (ℕ×ℕ) := [(3,7),(5,11),(7,29),(11,23),(13,53),(17,103),(19,191),(23,47),
    (29,59),(31,311),(37,149),(41,83),(43,173),(47,283),(53,107)]
  have table : ∀ r ∈ rows, ∀ v ∈ [2,3,5], r.1.Prime ∧ Odd r.1 ∧ r.2.Prime ∧ v < r.2 ∧
      r.2-1=(r.2-1)/r.1*r.1 ∧ v^((r.2-1)/r.1)%r.2≠1 := by decide +kernel
  obtain ⟨pl,ol,pQ,xQ,qr,nonres⟩ := table (l,Q) row x (by simpa using base)
  have px : x.Prime := by rcases base with rfl|rfl|rfl <;> decide
  apply fixed_prime_exponent_exclusion quadratic x j l Q ((Q-1)/l) px.pos jl pl ol _ pQ xQ qr nonres
  intro q pq dq
  have eq := (Nat.prime_dvd_prime_iff_eq pq px).mp (pq.dvd_of_dvd_pow dq)
  rw [eq]
  apply pl.coprime_iff_not_dvd.mpr
  have l3 : 2 < l := by obtain ⟨k,hk⟩ := ol; have := pl.two_le; omega
  rcases base with rfl|rfl|rfl
  · intro dv; have := Nat.le_of_dvd (by decide : 0<2-1) dv; omega
  · intro dv; have := Nat.le_of_dvd (by decide : 0<3-1) dv; omega
  · intro dv
    have small := pl.dvd_of_dvd_pow (show l∣(2:ℕ)^2 from dv)
    have := Nat.le_of_dvd (by decide : 0<2) small
    omega


theorem square_middle_pell_exclusion {p t r : ℕ} (op : Odd p) (hp : 5 < p)
    (pr : r.Prime) (outer : p^2+3=4*r) (middle : p^2+2=3*t^2) : False := by
  have oddProd : Odd (p^2+2) := (op.pow (n:=2)).add_even (by decide : Even 2)
  rw [middle,Nat.odd_mul,Nat.odd_pow_iff (by decide : 2 ≠ 0)] at oddProd
  obtain ⟨i,hi⟩ := op
  obtain ⟨j,hj⟩ := oddProd.2
  have lower : p<3*t := by
    by_contra! bad
    nlinarith [Nat.mul_le_mul bad bad]
  have upper : 3*t<2*p := by
    by_contra! bad
    nlinarith [Nat.mul_le_mul bad bad,Nat.mul_le_mul hp.le hp.le]
  let L := (3*t-p)/2
  have eqL : 2*L+p=3*t := by dsimp only [L]; omega
  have fact : L*(L+p)=2*r := by
    have sq := congrArg (fun x : ℕ => x^2) eqL
    nlinarith
  have small : L+p < r := by
    nlinarith [Nat.mul_le_mul (show 6 ≤ p by omega) (Nat.le_refl p)]
  have rd : r∣L*(L+p) := fact ▸ dvd_mul_left _ _
  rcases pr.dvd_mul.mp rd with h | h
  · have pos : 0 < L := by omega
    have := Nat.le_of_dvd pos h
    omega
  · have := Nat.le_of_dvd (show 0 < L+p by omega) h
    omega

private theorem three_power_pell_bound {t w e : ℕ} (hi : 3 < t) (power : t = 3^e)
    (pell : t^2 = 2*w^2+1) : False := by
  have pos : 0 < e := by
    by_contra! h
    have ze : e=0 := by omega
    rw [ze,pow_zero] at power
    omega
  have three : 3 ∣ t := power ▸ dvd_pow_self _ pos.ne'
  have oddt : Odd t := power ▸ (show Odd (3:ℕ) by decide).pow
  obtain ⟨u,tu⟩ := oddt
  let v := u+1
  have uv : u.Coprime v := by simp [v]
  have eq : v*(2*u)=w^2 := by dsimp [v]; nlinarith [pell,tu]
  have extract {x y : ℕ} (h : x.Coprime y) (e' : x*y=w^2) : ∃ s : ℕ, x=s^2 := by
    apply exists_eq_pow_of_mul_eq_pow _ e'
    change IsUnit (Nat.gcd x y)
    rw [show Nat.gcd x y = 1 from h]
    exact isUnit_one
  have sq : ∃ s : ℕ, t+1=s^2 := by
    rcases Nat.even_or_odd v with ev|ov
    · have ou : Odd u := by rw [Nat.odd_iff]; dsimp [v] at ev; obtain ⟨k,hk⟩ := ev; omega
      obtain ⟨s,hs⟩ := extract (ou.coprime_two_left.mul_left uv.symm) (show (2*v)*u=w^2 by nlinarith [eq])
      exact ⟨s,by dsimp [v] at hs; omega⟩
    · obtain ⟨s,hs⟩ := extract (ov.coprime_two_right.mul_right uv.symm) eq
      have mm := congrArg (· % 3) hs
      rw [Nat.pow_mod] at mm
      have modv : v%3=2 := by dsimp [v]; omega
      rw [modv] at mm
      have tab : ∀ i : Fin 3, i.val^2%3≠2 := by decide
      exact False.elim (tab ⟨s%3,Nat.mod_lt _ (by decide)⟩ mm.symm)
  obtain ⟨s,hs⟩ := sq
  have sl : 2 < s := by by_contra! h; interval_cases s <;> norm_num at hs <;> omega
  obtain ⟨j,rfl⟩ : ∃ j : ℕ, s=j+1 := ⟨s-1,by omega⟩
  have prod : j*(j+2)=3^e := by nlinarith [hs,power]
  have both {z : ℕ} (hz : 1 < z) (dz : z ∣ 3^e) : 3 ∣ z := by
    have hit := (Nat.dvd_prime_pow Nat.prime_three).mp dz
    obtain ⟨k,_,rfl⟩ := hit
    cases k with
    | zero => simp at hz
    | succ k => exact dvd_pow_self _ (by omega)
  have da := both (show 1 < j by omega) (prod ▸ dvd_mul_right j (j+2))
  have db := both (show 1 < j+2 by omega) (prod ▸ dvd_mul_left (j+2) j)
  omega

private theorem five_times_square_split {x y z : ℕ} (xy : x.Coprime y) (eq : x*y=5*z^2) :
    (∃ h : ℕ, x=h^2) ∨ ∃ h : ℕ, y=h^2 := by
  have extract {u v : ℕ} (uv : u.Coprime v) (sq : u*v=(5*z)^2) : ∃ h : ℕ, u=h^2 := by
    apply exists_eq_pow_of_mul_eq_pow _ sq
    change IsUnit (Nat.gcd u v)
    rw [show Nat.gcd u v=1 from uv]
    exact isUnit_one
  have pf : Nat.Prime 5 := by decide
  by_cases d : 5∣x
  · have ny : ¬5∣y := by
      intro dd
      have r := Nat.dvd_gcd d dd
      rw [Nat.coprime_iff_gcd_eq_one.mp xy] at r
      omega
    exact Or.inr (extract ((pf.coprime_iff_not_dvd.mpr ny).symm.mul_right xy.symm)
      (show y*(5*x)=(5*z)^2 by nlinarith only [eq]))
  · exact Or.inl (extract ((pf.coprime_iff_not_dvd.mpr d).symm.mul_right xy)
      (show x*(5*y)=(5*z)^2 by nlinarith only [eq]))

private theorem no_square_two_mod_three {x v : ℕ} (rem : v%3=2) (sq : v=x^2) : False := by
  have eq := (Nat.mod_modEq x 3).pow 2
  have t : ∀ i ∈ List.range 3, i^2%3≠2 := by decide +kernel
  apply t (x%3) (List.mem_range.mpr (by omega))
  exact Eq.trans eq (sq ▸ rem)

private theorem pell_four_smooth_bound {T w a : ℕ} (eq : T^2=5*w^2+4)
    (shape : T=3^a ∨ T=2*3^a) : T≤27 := by
  by_contra! large
  have posa : 0 < a := by
    by_contra! h
    have z : a=0 := by omega
    rw [z,pow_zero] at shape
    omega
  have da : 3∣3^a := dvd_pow_self 3 posa.ne'
  rcases shape with pow | twice
  · let X := T-2
    have eX : X+2=T := by dsimp only [X]; omega
    have ot : Odd T := pow ▸ (show Odd (3:ℕ) by decide).pow
    have ox : Odd X := by obtain ⟨h,hh⟩ := ot; exact Nat.odd_iff.mpr (by omega)
    have cop : X.Coprime (X+4) := Nat.coprime_self_add_right.mpr ((Nat.coprime_two_right.mpr ox).pow_right 2)
    have fac : X*(X+4)=5*w^2 := by rw [←eX] at eq; nlinarith only [eq]
    rcases five_times_square_split cop fac with ⟨h,eh⟩ | ⟨h,eh⟩
    · have sm := OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2.square_plus_two_three
        (show h^2+2=3^a by omega)
      nlinarith [Nat.mul_le_mul sm sm]
    · exact no_square_two_mod_three (by omega : (X+4)%3=2) eh
  · obtain ⟨x,hx⟩ := (show Odd (3:ℕ) by decide).pow (n:=a)
    have four : 4∣w := by
      have div : 16∣5*w^2 := ⟨x^2+x,by rw [twice,hx] at eq; nlinarith only [eq]⟩
      have dd : 16∣w^2 := (show Nat.Coprime 16 5 by decide).dvd_of_dvd_mul_left div
      exact (Nat.pow_dvd_pow_iff (by decide : 2≠0)).mp dd
    obtain ⟨j,hj⟩ := four
    have fac : x*(x+1)=5*j^2 := by rw [twice,hx,hj] at eq; nlinarith only [eq]
    rcases five_times_square_split (by simp : x.Coprime (x+1)) fac with ⟨v,hv⟩ | ⟨v,hv⟩
    · have ea : Even a := by
        apply Nat.not_odd_iff_even.mp
        rintro ⟨k,hk⟩
        have sq5 : (3^a)^2 ≡ 4 [MOD 5] := by
          calc
            (3^a)^2 = (3^2)^a := by rw [←pow_mul,←pow_mul,Nat.mul_comm a 2]
            _ = ((3^2)^2)^k*(3^2) := by rw [hk,pow_succ,pow_mul]
            _ ≡ 1^k*9 [MOD 5] := ((show (3^2)^2 ≡ 1 [MOD 5] by decide).pow k).mul_right 9
            _ ≡ 4 [MOD 5] := by simp only [one_pow,one_mul]; decide
        have norm : (2*3^a)^2%5=4 := by rw [←twice,eq]; omega
        have bad : (2*3^a)^2 ≡ 16 [MOD 5] := by simpa [mul_pow] using sq5.mul_left 4
        change (2*3^a)^2%5=16%5 at bad
        omega
      obtain ⟨k,hk⟩ := ea
      have shape : 3^a=(3^k)^2 := by rw [hk,pow_add,pow_two]
      have high : 3<3^k := by
        by_contra! low
        nlinarith [Nat.mul_le_mul low low]
      exact three_power_pell_bound high rfl (show (3^k)^2=2*v^2+1 by omega)
    · exact no_square_two_mod_three (by omega : (x+1)%3=2) hv

private theorem pell_four_large_prime {T w : ℕ} (large : 27 < T) (eq : T^2=5*w^2+4)
    (no4 : ¬4∣T) : ∃ q : ℕ, q.Prime ∧ 6 < q ∧ q∣T := by
  by_contra missing
  have no5 : ¬5∣T := by
    intro d
    have sq := d.trans (dvd_pow_self T (by decide : 2≠0))
    omega
  have pure {v : ℕ} (dv : v∣T) (nz : v≠0) (odd : ¬2∣v) : v=3^v.primeFactorsList.length := by
    apply Nat.eq_prime_pow_of_unique_prime_dvd nz
    intro q pq dq
    have bound : q≤6 := by by_contra! h; exact missing ⟨q,pq,h,dq.trans dv⟩
    have tab : ∀ i ∈ List.range 7, Nat.Prime i → i=2 ∨ i=3 ∨ i=5 := by decide +kernel
    rcases tab q (List.mem_range.mpr (by omega)) pq with rfl | same | rfl
    · exact (odd dq).elim
    · exact same
    · exact (no5 (dq.trans dv)).elim
  by_cases two : 2∣T
  · obtain ⟨v,hv⟩ := two
    have d : v∣T := hv ▸ dvd_mul_left _ _
    have odd : ¬2∣v := by intro hh; exact no4 (hv ▸ Nat.mul_dvd_mul_left 2 hh)
    have pw := pure d (by omega) odd
    exact (not_le_of_gt large) (pell_four_smooth_bound eq (Or.inr (show T=2*3^v.primeFactorsList.length by omega)))
  · exact (not_le_of_gt large) (pell_four_smooth_bound eq (Or.inl (pure (dvd_refl T) (by omega) two)))

theorem square_fourth_even_witness {p u : ℕ} (pp : p.Prime) (op : Odd p)
    (hp : 81 < p) (ou : Odd u) (eq : p^2+4=5*u^2) :
    ∃ d q s : ℕ, q.Prime ∧ s.Prime ∧ q≠s ∧ d+1 < q ∧ d+1 < s ∧ q∣p^2+d ∧ s∣p^2+d := by
  obtain ⟨k,hk⟩ := op
  obtain ⟨j,hj⟩ := ou
  have upper : u < p := by by_contra! bad; nlinarith [Nat.mul_le_mul bad bad,Nat.mul_le_mul hp.le hp.le]
  have lower : p<3*u := by by_contra! bad; nlinarith [Nat.mul_le_mul bad bad]
  have bound : 5*u<3*p := by by_contra! bad; nlinarith [Nat.mul_le_mul bad bad,Nat.mul_le_mul hp.le hp.le]
  let w := (p-u)/2
  let v := u-w
  have uu : u=v+w := by dsimp only [v,w]; omega
  have pu : p=v+3*w := by dsimp only [v,w]; omega
  let A := 2*v+w
  let B := 3*v+4*w
  have pure := eq
  rw [pu,uu] at pure
  have ab : A*B=p^2+5 := by rw [pu]; dsimp only [A,B]; nlinarith only [pure]
  have ae : A^2=5*w^2+4 := by dsimp only [A]; nlinarith only [pure]
  have be : B^2=5*(v+2*w)^2+4 := by dsimp only [B]; nlinarith only [pure]
  have ways : A+p=B ∧ A < p := by dsimp only [A,B]; omega
  have aL : 27 < A := by dsimp only [A]; omega
  have bL : 27 < B := by omega
  have no4 : ¬4∣p^2+5 := by
    have e : p^2+5=4*(k^2+k+1)+2 := by rw [hk]; ring
    omega
  have dA : A∣p^2+5 := ab ▸ dvd_mul_right _ _
  have dB : B∣p^2+5 := ab ▸ dvd_mul_left _ _
  obtain ⟨q,pq,lq,dq⟩ := pell_four_large_prime aL ae (fun h => no4 (h.trans dA))
  obtain ⟨s,ps,ls,ds⟩ := pell_four_large_prime bL be (fun h => no4 (h.trans dB))
  have ne : q≠s := by
    rintro rfl
    have dp : q∣p := (Nat.dvd_add_right dq).mp (ways.1 ▸ ds)
    have qp := (Nat.prime_dvd_prime_iff_eq pq pp).mp dp
    have lb := Nat.le_of_dvd (show 0 < A by omega) dq
    omega
  exact ⟨5,q,s,pq,ps,ne,lq,ls,dq.trans dA,ds.trans dB⟩

private theorem square_fourth_coprime {p r s a b : ℕ} (pr : r.Prime) (hs : 5 < s)
    (hb : 0 < b) (outer : p^2+3=4*r) (eq : p^2+4=5^a*s^b) : a.Coprime b := by
  by_contra bad
  obtain ⟨d,pd,da,db⟩ := Nat.Prime.not_coprime_iff_dvd.mp bad
  obtain ⟨i,hi⟩ := da
  obtain ⟨j,hj⟩ := db
  have jp : j≠0 := by rintro rfl; simp at hj; omega
  let x := 5^i*s^j
  have xb : 5 < x := by
    have sl := Nat.le_self_pow jp s
    have fi : 0<5^i := pow_pos (by decide) _
    have lb := Nat.mul_le_mul_right (s^j) fi
    dsimp only [x]; omega
  have power : p^2+4=x^d := by
    dsimp only [x]
    rw [eq,hi,hj,mul_pow,←pow_mul,←pow_mul,Nat.mul_comm i d,Nat.mul_comm j d]
  have sq : x^2 ≤ x^d := Nat.pow_le_pow_right (by omega) pd.two_le
  let L := x-1
  have lx : L+1=x := by dsimp only [L]; omega
  have lf : L∣4*r := by
    have h : x-1∣x^d-1 := by simpa using (Nat.sub_dvd_pow_sub_pow (x:=x) (y:=1) (n:=d))
    have e : x^d-1=4*r := by omega
    exact e ▸ h
  have small : L < r := by
    have up : x^2≤4*r+1 := by omega
    rw [←lx] at up
    nlinarith [Nat.mul_le_mul (show 4 ≤ L by omega) (Nat.le_refl L)]
  have cop : L.Coprime r := (pr.coprime_iff_not_dvd.mpr (by
    intro dv
    have := Nat.le_of_dvd (show 0 < L by omega) dv
    omega)).symm
  have div := cop.dvd_of_dvd_mul_right lf
  have bound := Nat.le_of_dvd (by decide : 0<4) div
  omega

private theorem square_fourth_cofactor {p q r : ℕ} (pp : p.Prime) (op : Odd p)
    (hp : 81 < p) (pq : q.Prime) (first : p^2+1=2*q) (pr : r.Prime) (outer : p^2+3=4*r)
    (missing : ¬∃ d a b : ℕ, a.Prime ∧ b.Prime ∧ a≠b ∧ d+1 < a ∧ d+1 < b ∧
      a∣p^2+d ∧ b∣p^2+d) :
    ∃ s a b : ℕ, s.Prime ∧ 5 < s ∧ s%4=1 ∧ 0 < a ∧ 0 < b ∧ Odd b ∧ a.Coprime b ∧ p^2+4=5^a*s^b := by
  have p5 : p%5≠0 := by
    intro h
    have ds := (Nat.dvd_prime pp).mp (Nat.dvd_of_mod_eq_zero h)
    omega
  have q5 : ¬5∣p^2+1 := by
    intro div
    rw [first] at div
    have ds := (show Nat.Prime 5 by decide).dvd_mul.mp div
    rcases ds with d | d
    · omega
    · have same := (Nat.dvd_prime pq).mp d
      rcases same with impossible | same
      · omega
      · nlinarith [Nat.mul_le_mul hp.le hp.le]
  have div5 : 5∣p^2+4 := by
    have sq := Nat.pow_mod p 2 5
    have rem := Nat.mod_lt p (by decide : 0<5)
    interval_cases h : p%5 <;> norm_num [h] at sq <;> omega
  let n := p^2+4
  let a := n.factorization 5
  let m := n / 5^a
  have nz : n≠0 := by dsimp only [n]; omega
  have fac : 5^a*m=n := Nat.ordProj_mul_ordCompl_eq_self n 5
  have dm : m∣n := Nat.ordCompl_dvd n 5
  have pos : 0 < m := Nat.ordCompl_pos 5 nz
  have no5 : ¬5∣m := Nat.not_dvd_ordCompl (by decide : Nat.Prime 5) nz
  have ha : 0 < a := (Nat.Prime.dvd_iff_one_le_factorization (by decide : Nat.Prime 5) nz).mp div5
  have big : 2 ≤ m := by
    by_contra! small
    have one : m=1 := by omega
    have pure : p^2+4=5^a := by simpa only [one,mul_one,n] using fac.symm
    rcases Nat.even_or_odd a with ⟨j,hj⟩ | ⟨j,hj⟩
    · have sq : p^2+4=(5^j)^2 := by rw [pure,hj,pow_add,pow_two]
      by_cases low : 5^j ≤ p
      · nlinarith [Nat.mul_le_mul low low]
      · nlinarith [Nat.mul_le_mul (show p+1≤5^j by omega) (show p+1≤5^j by omega)]
    · have form : p^2+4=5*(5^j)^2 := by rw [pure,hj,pow_succ,Nat.mul_comm 2 j,pow_mul]; ring
      exact missing (square_fourth_even_witness pp op hp ((by decide : Odd 5).pow) form)
  have no2 : ¬2∣n := by
    intro d
    exact (Nat.not_even_iff_odd.mpr ((op.pow (n:=2)).add_even (by decide : Even 4))) (even_iff_two_dvd.mpr d)
  have no3 : ¬3∣n := by
    have sq := Nat.pow_mod p 2 3
    have rem := Nat.mod_lt p (by decide : 0<3)
    dsimp only [n]
    interval_cases h : p%3 <;> norm_num [h] at sq <;> omega
  have eligible {l : ℕ} (pl : l.Prime) (d : l∣m) : 5 < l := by
    by_contra! small
    have tab : ∀ z ∈ List.range 6, Nat.Prime z → z=2 ∨ z=3 ∨ z=5 := by decide +kernel
    rcases tab l (List.mem_range.mpr (by omega)) pl with rfl | rfl | rfl
    · exact no2 (d.trans dm)
    · exact no3 (d.trans dm)
    · exact no5 d
  have pure : IsPrimePow m := by
    by_contra bad
    obtain ⟨x,hx,y,hy,ne⟩ := (Nat.not_isPrimePow_iff_nontrivial_of_two_le big).mp bad
    obtain ⟨px,dx,_⟩ := Nat.mem_primeFactors.mp hx
    obtain ⟨py,dy,_⟩ := Nat.mem_primeFactors.mp hy
    exact missing ⟨4,x,y,px,py,ne,eligible px dx,eligible py dy,dx.trans dm,dy.trans dm⟩
  obtain ⟨s,b,ps,hb,ep⟩ := (isPrimePow_nat_iff _).mp pure
  have ds : s∣m := ep ▸ dvd_pow_self s hb.ne'
  have lb := eligible ps ds
  have smod : s%4=1 := by
    let _ : Fact s.Prime := ⟨ps⟩
    have ns : ¬s∣2 := by intro h; have := Nat.le_of_dvd (by decide : 0<2) h; omega
    have two : (2:ZMod s)≠0 := by simpa using (ZMod.natCast_eq_zero_iff 2 s).not.mpr ns
    have hz := (ZMod.natCast_eq_zero_iff (p^2+4) s).mpr (ds.trans dm)
    push_cast at hz
    have hs : IsSquare (-1 : ZMod s) := by
      refine ⟨(p:ZMod s)/2,?_⟩
      field_simp
      linear_combination -hz
    have n3 := ZMod.exists_sq_eq_neg_one_iff.mp hs
    obtain ⟨j,hj⟩ := ps.odd_of_ne_two (by omega)
    omega
  have eqf : p^2+4=5^a*s^b := by rw [ep]; exact fac.symm
  have ob : Odd b := by
    apply Nat.not_even_iff_odd.mp
    rintro ⟨k,hk⟩
    rcases Nat.even_or_odd a with ⟨j,hj⟩ | ⟨j,hj⟩
    · let w := 5^j*s^k
      have sq : p^2+4=w^2 := by rw [eqf,hj,hk,pow_add,pow_add]; dsimp only [w]; ring
      by_cases low : w ≤ p
      · nlinarith [Nat.mul_le_mul low low]
      · nlinarith [Nat.mul_le_mul (show p+1 ≤ w by omega) (show p+1 ≤ w by omega)]
    · let u := 5^j*s^k
      have form : p^2+4=5*u^2 := by
        rw [eqf,hj,hk,pow_succ,Nat.mul_comm 2 j,pow_mul,pow_add]; dsimp only [u]; ring
      have ou : Odd u := (show Odd 5 by decide).pow.mul (ps.odd_of_ne_two (by omega)).pow
      exact missing (square_fourth_even_witness pp op hp ou form)
  exact ⟨s,a,b,ps,lb,smod,ha,hb,ob,square_fourth_coprime pr lb hb outer eqf,eqf⟩


private theorem square_exponent_cutoff :
    ∃ C : ℕ, ∀ n x a t e : ℕ, C < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) → (x=3 ∨ x=5) → 0 < e →
      n+x=x^a*t^e → (∀ l : ℕ, l.Prime → 2 < l → l≤53 → ¬l∣e) := by
  let rows : List (ℕ×ℕ) := [(3,7),(5,11),(7,29),(11,23),(13,53),(17,103),(19,191),(23,47),(29,59),(31,311),(37,149),(41,83),(43,173),(47,283),(53,107)]
  have good (x : ℕ) (r : ℕ×ℕ) : ∃ D : ℕ, ∀ n a t e : ℕ,
      (x=3 ∨ x=5) → r∈rows → D < n → (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) →
      0 < e → n+x=x^a*t^e → ¬r.1∣e := by
    by_cases ok : (x=3 ∨ x=5) ∧ r∈rows
    · have table : ∀ v∈rows, 1 < v.1 := by decide +kernel
      obtain ⟨D,hD⟩ := initial_odd_exponent_exclusions large_prime_of_square_add_one
        x 1 r.1 r.2 (Or.inr ok.1) (table _ ok.2) ok.2
      exact ⟨D,fun n a t e _ _ hn hsol he eq => hD n a t e hn hsol he (by simpa using eq)⟩
    · exact ⟨0,fun _ _ _ _ hx hr => (ok ⟨hx,hr⟩).elim⟩
  choose cap hcap using good
  let C := rows.toFinset.sup (fun r => max (cap 3 r) (cap 5 r))
  refine ⟨C,?_⟩
  intro n x a t e hn sol hx he eq l pl l2 l53
  have cover : ∀ i ∈ List.range 54, i.Prime → 2 < i → ∃ r∈rows, r.1=i := by decide +kernel
  obtain ⟨r,hr,rl⟩ := cover l (List.mem_range.mpr (by omega)) pl l2
  have bound : max (cap 3 r) (cap 5 r) ≤ C :=
    Finset.le_sup (f:=fun i => max (cap 3 i) (cap 5 i)) (List.mem_toFinset.mpr hr)
  rw [←rl]
  rcases hx with rfl|rfl
  · exact hcap 3 r n a t e (Or.inl rfl) hr (lt_of_le_of_lt ((Nat.le_max_left _ _).trans bound) hn) sol he eq
  · exact hcap 5 r n a t e (Or.inr rfl) hr (lt_of_le_of_lt ((Nat.le_max_right _ _).trans bound) hn) sol he eq

/-- The middle factor at the third offset contains one copy of its prime above three. -/
def H1 : Prop := ∃ T B : ℕ, ∀ p : ℕ, p.Prime → Odd p → B < p^2 →
    (∀ l : ℕ, l.Prime → l ≤ T → l∣p^2-1) →
    (∃ q r : ℕ, q.Prime ∧ r.Prime ∧ q≠r ∧ q%4=1 ∧ r%3=1 ∧
      p^2+1=2*q ∧ p^2+3=4*r) →
