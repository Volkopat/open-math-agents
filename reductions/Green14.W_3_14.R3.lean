open OMA.Green14Palindromes

/-- The red positions on a fourteen-term progression in one of the two
orientations about the centre of the 186-point board. -/
private def support (c : Nat → Bool) (a d : Nat) (reflected : Bool) : Finset (Fin 14) :=
  Finset.univ.filter fun i =>
    c (if reflected then 185-(a+i.val*d) else a+i.val*d) = true

private def free (s : Finset (Fin 14)) : Prop :=
  ∀ x ∈ s, ∀ y ∈ s, ∀ z ∈ s, x.val+z.val=2*y.val → x=z

/-- Red and blue covers in every translated window of either certified length. -/
private def Windows (c : Nat → Bool) : Prop :=
  ∀ n o : Nat, n = 175 ∨ n = 184 → o+n ≤ 186 →
    (∃ a d : Nat, 0 < d ∧ a+2*d < n ∧ ∀ t ≤ 2,
      c (o+(a+t*d)) = true ∨ c (o+(n-1-(a+t*d))) = true) ∧
    (∃ a d : Nat, 0 < d ∧ a+13*d < n ∧ ∀ t ≤ 13,
      c (o+(a+t*d)) = false ∨ c (o+(n-1-(a+t*d))) = false)

/-- Both red supports are nonempty and contain no three-term progression.
They occupy disjoint indices, and together omit at least two indices. -/
private def Paired (c : Nat → Bool) (a d : Nat) : Prop :=
  0 < a ∧ 0 < d ∧ a+13*d < 185 ∧
  let A := support c a d false
  let B := support c a d true
  A.Nonempty ∧ B.Nonempty ∧ Disjoint A B ∧ free A ∧ free B ∧ A.card+B.card ≤ 12

/-- One of the two specified progressions contains at most five red points. -/
def H1 : Prop :=
  ∀ (c : Nat → Bool) (a d : Nat),
    let A := Finset.univ.filter (fun i : Fin 14 => c (a+i.val*d) = true)
    let B := Finset.univ.filter (fun i : Fin 14 => c (185-(a+i.val*d)) = true)
    (∀ n o : Nat, n = 175 ∨ n = 184 → o+n ≤ 186 →
      (∃ p e : Nat, 0 < e ∧ p+2*e < n ∧ ∀ t ≤ 2,
        c (o+(p+t*e)) = true ∨ c (o+(n-1-(p+t*e))) = true) ∧
      (∃ p e : Nat, 0 < e ∧ p+13*e < n ∧ ∀ t ≤ 13,
        c (o+(p+t*e)) = false ∨ c (o+(n-1-(p+t*e))) = false)) →
    (0 < a ∧ 0 < d ∧ a+13*d < 185 ∧ A.Nonempty ∧ B.Nonempty ∧ Disjoint A B ∧
      (∀ x ∈ A, ∀ y ∈ A, ∀ z ∈ A, x.val+z.val=2*y.val → x=z) ∧
      (∀ x ∈ B, ∀ y ∈ B, ∀ z ∈ B, x.val+z.val=2*y.val → x=z) ∧
      A.card+B.card ≤ 12) →
    (A.card ≤ 5 ∨ B.card ≤ 5) →
    ∃ (b : Bool) (p e : Nat), 0 < e ∧ p+(if b then 2 else 13)*e < 186 ∧
      ∀ t ≤ (if b then 2 else 13 : Nat), c (p+t*e) = b

/-- Six red points on each progression specify twelve of the fourteen indices. -/
def H2 : Prop :=
  ∀ (c : Nat → Bool) (a d : Nat),
    let A := Finset.univ.filter (fun i : Fin 14 => c (a+i.val*d) = true)
    let B := Finset.univ.filter (fun i : Fin 14 => c (185-(a+i.val*d)) = true)
    (∀ n o : Nat, n = 175 ∨ n = 184 → o+n ≤ 186 →
      (∃ p e : Nat, 0 < e ∧ p+2*e < n ∧ ∀ t ≤ 2,
        c (o+(p+t*e)) = true ∨ c (o+(n-1-(p+t*e))) = true) ∧
      (∃ p e : Nat, 0 < e ∧ p+13*e < n ∧ ∀ t ≤ 13,
        c (o+(p+t*e)) = false ∨ c (o+(n-1-(p+t*e))) = false)) →
    (0 < a ∧ 0 < d ∧ a+13*d < 185 ∧ A.Nonempty ∧ B.Nonempty ∧ Disjoint A B ∧
      (∀ x ∈ A, ∀ y ∈ A, ∀ z ∈ A, x.val+z.val=2*y.val → x=z) ∧
      (∀ x ∈ B, ∀ y ∈ B, ∀ z ∈ B, x.val+z.val=2*y.val → x=z) ∧
      A.card+B.card ≤ 12) →
    A.card = 6 → B.card = 6 →
    ∃ (b : Bool) (p e : Nat), 0 < e ∧ p+(if b then 2 else 13)*e < 186 ∧
      ∀ t ≤ (if b then 2 else 13 : Nat), c (p+t*e) = b

theorem covers (c : Nat → Bool) (bad : ¬Progression 186 c) : Windows c := by
  intro n o hn ho
  let p (x : Nat) := c (o+x)
  have avoid (b : Bool) (a d : Nat) (hd : 0 < d)
      (he : a + (if b then 2 else 13)*d < n)
      (hm : ∀ t ≤ (if b then 2 else 13 : Nat), p (a+t*d) = b) : False := by
    apply bad
    refine ⟨b, o+a, d, hd, by omega, ?_⟩
    intro t ht
    simpa only [p, Nat.add_assoc] using hm t ht
  constructor
  · let cover (x : Nat) := p x || p (n-1-x)
    have symm (x : Nat) (hx : x < n) : cover (n-1-x) = cover x := by
      simp only [cover, show n-1-(n-1-x)=x by omega, Bool.or_comm (p (n-1-x)) (p x)]
    obtain ⟨b, a, d, hd, he, hm⟩ := palindromic n hn cover symm
    cases b
    · exfalso
      apply avoid false a d hd he
      intro t ht
      exact (Bool.or_eq_false_iff.mp (hm t ht)).1
    · exact ⟨a, d, hd, he, fun t ht => by simpa only [cover, p, Bool.or_eq_true] using hm t ht⟩
  · let core (x : Nat) := p x && p (n-1-x)
    have symm (x : Nat) (hx : x < n) : core (n-1-x) = core x := by
      simp only [core, show n-1-(n-1-x)=x by omega, Bool.and_comm (p (n-1-x)) (p x)]
    obtain ⟨b, a, d, hd, he, hm⟩ := palindromic n hn core symm
    cases b
    · exact ⟨a, d, hd, he, fun t ht => Bool.and_eq_false_iff.mp (hm t ht)⟩
    · exfalso
      apply avoid true a d hd he
      intro t ht
      exact (Bool.and_eq_true_iff.mp (hm t ht)).1

private lemma small_union {A B : Finset (Fin 14)} (ha : free A) (hb : free B)
    (disj : Disjoint A B) : A.card + B.card ≤ 12 := by
  classical
  have hole (u : Fin 14) : ∃ v : Fin 14, v ≠ u ∧ v ∉ A ∪ B := by
    by_contra! full
    obtain ⟨x,y,z,mid,ne,hx,hy,hz,xy,yz⟩ := punctured u (fun i => decide (i ∈ A))
    by_cases red : x ∈ A
    · have ry : y ∈ A := of_decide_eq_true (xy.symm.trans (decide_eq_true red))
      have rz : z ∈ A := of_decide_eq_true (yz.symm.trans (decide_eq_true ry))
      exact ne (ha x red y ry z rz mid)
    · have ry : y ∉ A := of_decide_eq_false (xy.symm.trans (decide_eq_false red))
      have rz : z ∉ A := of_decide_eq_false (yz.symm.trans (decide_eq_false ry))
      exact ne (hb x ((Finset.mem_union.mp (full x hx)).resolve_left red)
        y ((Finset.mem_union.mp (full y hy)).resolve_left ry)
        z ((Finset.mem_union.mp (full z hz)).resolve_left rz) mid)
  obtain ⟨u,_,hu⟩ := hole 0
  obtain ⟨v,hvu,hv⟩ := hole u
  have incl : A ∪ B ⊆ ((Finset.univ : Finset (Fin 14)).erase u).erase v := by
    intro x hx
    exact Finset.mem_erase.mpr ⟨fun e => hv (e ▸ hx),
      Finset.mem_erase.mpr ⟨fun e => hu (e ▸ hx), Finset.mem_univ _⟩⟩
  have lim := Finset.card_le_card incl
  have mem : v ∈ (Finset.univ : Finset (Fin 14)).erase u := by simp [hvu]
  rw [Finset.card_union_of_disjoint disj, Finset.card_erase_of_mem mem,
    Finset.card_erase_of_mem (Finset.mem_univ u)] at lim
  exact lim

private lemma no_three {c : Nat → Bool} (bad : ¬Progression 186 c)
    {x y z : Nat} (hx : x < 186) (hz : z < 186)
    (rx : c x = true) (ry : c y = true) (rz : c z = true)
    (eq : x+z = 2*y) : x = z := by
  by_contra ne
  have ordered {u v : Nat} (lt : u < v) (bound : v < 186)
      (ru : c u = true) (rv : c v = true) (align : u+v = 2*y) : False := by
    apply bad
    refine ⟨true, u, y-u, by omega, by change u+2*(y-u) < 186; omega, ?_⟩
    intro t ht
    change t ≤ 2 at ht
    rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with rfl | rfl | rfl
    · simpa using ru
    · simpa only [one_mul,show u+(y-u)=y by omega] using ry
    · simpa only [show u+2*(y-u)=v by omega] using rv
  rcases lt_or_gt_of_ne ne with lt | gt
  · exact ordered lt hz rx rz eq
  · exact ordered gt hx rz rx (by omega)

private lemma paired (c : Nat → Bool) (bad : ¬Progression 186 c) (windows : Windows c) :
    ∃ a d, Paired c a d := by
  obtain ⟨_, ⟨localStart,d,hd,stop,covered⟩⟩ := windows 184 1 (Or.inr rfl) (by decide)
  let a := 1+localStart
  have ha : 0<a := by dsimp [a]; omega
  have endBound : a+13*d < 185 := by dsimp [a]; omega
  let row (i : Fin 14) := a+i.val*d
  have inside (i : Fin 14) : row i < 185 := by
    dsimp [row]
    have := Nat.mul_le_mul_right d (show i.val ≤ 13 by omega)
    omega
  have blue (i : Fin 14) : c (row i) = false ∨ c (185-row i) = false := by
    have hi := Nat.mul_le_mul_right d (show i.val ≤ 13 by omega)
    have h₁ : row i = 1+(localStart+i.val*d) := by dsimp [row,a]; omega
    have h₂ : 185-row i = 1+(184-1-(localStart+i.val*d)) := by dsimp [row,a]; omega
    rw [h₂,h₁]
    exact covered i.val (by omega)
  let A := support c a d false
  let B := support c a d true
  have left (i : Fin 14) : i ∈ A ↔ c (row i) = true := by simp [A,support,row]
  have right (i : Fin 14) : i ∈ B ↔ c (185-row i) = true := by simp [B,support,row]
  have nonemptyA : A.Nonempty := by
    by_contra none
    apply bad
    refine ⟨false,a,d,hd,by change a+13*d<186; omega,?_⟩
    intro t ht
    change t ≤ 13 at ht
    apply Bool.eq_false_iff.mpr
    intro h
    exact none ⟨⟨t,by omega⟩, (left _).2 h⟩
  have nonemptyB : B.Nonempty := by
    by_contra none
    apply bad
    refine ⟨false,185-(a+13*d),d,hd,by change 185-(a+13*d)+13*d<186; omega,?_⟩
    intro t ht
    change t ≤ 13 at ht
    apply Bool.eq_false_iff.mpr
    intro h
    let i : Fin 14 := ⟨13-t,by omega⟩
    apply none ⟨i, (right i).2 ?_⟩
    have hm := Nat.mul_le_mul_right d ht
    simpa only [row,i,Nat.sub_mul,
      show 185-(a+(13*d-t*d))=185-(a+13*d)+t*d by omega] using h
  have dj : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro i ai bi
    rcases blue i with h | h
    · exact Bool.false_ne_true (h.symm.trans ((left i).1 ai))
    · exact Bool.false_ne_true (h.symm.trans ((right i).1 bi))
  have mid {x y z : Fin 14} (e : x.val+z.val=2*y.val) : row x+row z=2*row y := by
    have hm := congrArg (fun m : Nat => m*d) e
    simp only [Nat.add_mul, Nat.mul_assoc] at hm
    dsimp [row]
    omega
  have inj : Function.Injective row := by
    intro x z h
    apply Fin.ext
    exact Nat.eq_of_mul_eq_mul_right hd (Nat.add_left_cancel h)
  have fa : free A := by
    intro x ax y ay z az e
    apply inj
    exact no_three bad (by have := inside x; omega) (by have := inside z; omega)
      ((left x).1 ax) ((left y).1 ay) ((left z).1 az) (mid e)
  have fb : free B := by
    intro x bx y by' z bz e
    have hx := inside x
    have hy := inside y
    have hz := inside z
    have eq := mid e
    have out := no_three bad (x := 185-row x) (y := 185-row y) (z := 185-row z)
      (by omega) (by omega) ((right x).1 bx) ((right y).1 by') ((right z).1 bz) (by omega)
    exact inj (by omega)
  exact ⟨a,d,ha,hd,endBound,nonemptyA,nonemptyB,dj,fa,fb,small_union fa fb dj⟩

private theorem allColorings (h₁ : H1) (h₂ : H2) (c : Nat → Bool) : Progression 186 c := by
  by_contra bad
  have windows := covers c bad
  obtain ⟨a,d,seed⟩ := paired c bad windows
  by_cases sparse : (support c a d false).card ≤ 5 ∨ (support c a d true).card ≤ 5
  · exact bad (h₁ c a d windows seed sparse)
  · have copy := seed
    obtain ⟨_,_,_,_,_,_,_,_,lim⟩ := copy
    push Not at sparse
    exact bad (h₂ c a d windows seed
      (show (support c a d false).card = 6 by omega)
      (show (support c a d true).card = 6 by omega))



theorem mixedMonoAPGuaranteeSet_upward (k r : ℕ) {M N : ℕ} (hMN : M ≤ N)
    (hM : M ∈ mixedMonoAPGuaranteeSet k r) :
    N ∈ mixedMonoAPGuaranteeSet k r := by
  intro coloring
  let emb : Icc 1 M ↪ Icc 1 N :=
    ⟨fun x ↦ ⟨x, x.2.1, x.2.2.trans hMN⟩, by
      intro x y h
      apply Subtype.ext
      exact congrArg (fun z : Icc 1 N ↦ (z : Nat)) h⟩
  let restricted : Icc 1 M → Fin 2 := fun x ↦ coloring (emb x)
  rcases hM restricted with hzero | hone
  · left
    rcases hzero with ⟨s, hsAP, hsColor⟩
    let t : Finset (Icc 1 N) := s.map emb
    have hsets : ({(x : Nat) | x ∈ t} : Set Nat) = {(x : Nat) | x ∈ s} := by
      ext z
      constructor
      · rintro ⟨x,hx,rfl⟩
        obtain ⟨y,hy,rfl⟩ := Finset.mem_map.mp hx
        exact ⟨y,hy,rfl⟩
      · rintro ⟨y,hy,rfl⟩
        exact ⟨emb y,Finset.mem_map.mpr ⟨y,hy,rfl⟩,rfl⟩
    refine ⟨t, ?_, ?_⟩
    · rw [hsets]
      exact hsAP
    · intro x hx
      rcases Finset.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [restricted] using hsColor y hy
  · right
    rcases hone with ⟨s, hsAP, hsColor⟩
    let t : Finset (Icc 1 N) := s.map emb
    have hsets : ({(x : Nat) | x ∈ t} : Set Nat) = {(x : Nat) | x ∈ s} := by
      ext z
      constructor
      · rintro ⟨x,hx,rfl⟩
        obtain ⟨y,hy,rfl⟩ := Finset.mem_map.mp hx
        exact ⟨y,hy,rfl⟩
      · rintro ⟨y,hy,rfl⟩
        exact ⟨emb y,Finset.mem_map.mpr ⟨y,hy,rfl⟩,rfl⟩
    refine ⟨t, ?_, ?_⟩
    · rw [hsets]
      exact hsAP
    · intro x hx
      rcases Finset.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [restricted] using hsColor y hy

/-- One bad coloring of `{1, ..., N}` proves the numerical lower bound
`W(k,r) ≥ N+1`. -/
private theorem W_ge_succ_of_not_mem (k r N : ℕ)
    (hne : (mixedMonoAPGuaranteeSet k r).Nonempty) (hbad : N ∉ mixedMonoAPGuaranteeSet k r) :
    N + 1 ≤ W k r := by
  rw [W]
  apply le_csInf hne
  intro b hb
  by_contra hle
  have hbN : b ≤ N := Nat.lt_succ_iff.mp (Nat.lt_of_not_ge hle)
  exact hbad (mixedMonoAPGuaranteeSet_upward k r hbN hb)

private lemma progression_at {N k a d : Nat} (hd : 0 < d)
    (c : Icc 1 N → Fin 2) (color : Fin 2)
    (bound : ∀ i : Fin k, a+i.val*d < N)
    (mono : ∀ (i : Fin k) (hi : a+i.val*d < N), c ⟨a+i.val*d+1, by constructor <;> omega⟩ = color) :
    ∃ s : Finset (Icc 1 N), ({(z : Nat) | z ∈ s}).IsAPOfLength k ∧
      ∀ z ∈ s, c z = color := by
  classical
  let value (i : Fin k) := a + i.val*d + 1
  have inj : Function.Injective value := by
    intro i j h
    apply Fin.ext
    exact Nat.eq_of_mul_eq_mul_right hd (by simpa [value] using h)
  let point : Fin k ↪ Icc 1 N := ⟨fun i => ⟨value i, by
    have := bound i
    dsimp [value]
    constructor <;> omega⟩, fun i j h => inj (congrArg Subtype.val h)⟩
  let s := Finset.univ.map point
  have eqs : ({(z : Nat) | z ∈ s} : Set Nat) = range value := by
    ext z
    constructor
    · rintro ⟨y,hy,rfl⟩
      obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hy
      exact ⟨i,rfl⟩
    · rintro ⟨i,rfl⟩
      exact ⟨point i,Finset.mem_map.mpr ⟨i,Finset.mem_univ _,rfl⟩,rfl⟩
  refine ⟨s, ?_, ?_⟩
  · rw [eqs]
    refine ⟨a+1,d,?_,?_⟩
    · rw [ENat.card_coe_set_eq, ← Set.image_univ, inj.encard_image]
      simp
    · ext z
      constructor
      · rintro ⟨i,rfl⟩
        exact ⟨i.val,by exact_mod_cast i.isLt,by simp [value]; omega⟩
      · rintro ⟨i,hi,rfl⟩
        exact ⟨⟨i,by exact_mod_cast hi⟩,by simp [value]; omega⟩
  · intro z hz
    obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hz
    exact mono i (bound i)


private lemma extract_progression {N k : ℕ} (hk : 2 ≤ k) (q : ℕ → Fin 2) (col : Fin 2)
    (h : ∃ s : Finset (Icc 1 N), ({(x : ℕ) | x ∈ s}).IsAPOfLength k ∧
      ∀ x ∈ s, q (x.val-1) = col) :
    ∃ a d : Fin N, 0 < d.val ∧ a.val + (k-1)*d.val < N ∧
      ∀ i : Fin k, q (a.val + i.val*d.val) = col := by
  obtain ⟨s,⟨a,d,hcard,hset⟩,hc⟩ := h
  have term (i : ℕ) (hi : i < k) :
      ∃ x ∈ s, (x : ℕ) = a + i*d := by
    change a + i*d ∈ ({(x : ℕ) | x ∈ s} : Set ℕ)
    rw [hset]
    exact ⟨i, by exact_mod_cast hi, by simp⟩
  obtain ⟨x₀, -, hx₀⟩ := term 0 (by omega)
  simp only [Nat.zero_mul, Nat.add_zero] at hx₀
  obtain ⟨x₁, -, hx₁⟩ := term (k-1) (by omega)
  have ha : 1 ≤ a := hx₀ ▸ x₀.property.1
  have hb : a + (k-1)*d ≤ N := hx₁ ▸ x₁.property.2
  have hpos : 0 < d := by
    by_contra! hz
    have hd : d = 0 := by omega
    have heq : ({(x : ℕ) | x ∈ s} : Set ℕ) = {a} := by
      rw [hset]
      ext z
      simp only [hd, nsmul_zero, add_zero, Set.mem_ofPred_eq, Set.mem_singleton_iff]
      constructor
      · rintro ⟨i,hi,rfl⟩
        rfl
      · rintro rfl
        exact ⟨0, by exact_mod_cast (show 0 < k by omega), rfl⟩
    have hone : (k : ℕ∞) = 1 := by rw [← hcard, heq]; simp
    have : k = 1 := by exact_mod_cast hone
    omega
  have hd' : d ≤ (k-1)*d := by
    simpa using Nat.mul_le_mul_right d (show 1 ≤ k-1 by omega)
  refine ⟨⟨a-1,by omega⟩,⟨d,by omega⟩,hpos,by change a-1+(k-1)*d < N; omega,?_⟩
  intro i
  obtain ⟨x,hx,hval⟩ := term i.val i.isLt
  have he := hc x hx
  change q (a - 1 + i.val*d) = col
  convert he using 2; omega

