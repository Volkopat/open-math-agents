private theorem lower_witness : 185 ∉ mixedMonoAPGuaranteeSet 3 14 := by
  let q (i : ℕ) : Fin 2 := if (0x84010c002200504020a006400118020201402020c0014 : ℕ).testBit i then 0 else 1
  have red : ∀ a d : Fin 185, 0 < d.val → a.val + 2*d.val < 185 →
      ¬ ∀ i : Fin 3, q (a.val + i.val*d.val) = 0 := by decide +kernel
  have blue : ∀ a d : Fin 185, 0 < d.val → a.val + 13*d.val < 185 →
      ¬ ∀ i : Fin 14, q (a.val + i.val*d.val) = 1 := by decide +kernel
  intro h
  rcases h (fun x => q (x.val-1)) with hr | hb
  · obtain ⟨a,d,hd,hbound,hc⟩ := extract_progression (by decide : 2 ≤ 3) q 0 hr
    exact red a d hd hbound hc
  · obtain ⟨a,d,hd,hbound,hc⟩ := extract_progression (by decide : 2 ≤ 14) q 1 hb
    exact blue a d hd hbound hc

private lemma idx_val (i : ℕ) (hi : i < 186) : (Fin.ofNat 186 i).val = i :=
  Nat.mod_eq_of_lt hi


/-- Hales--Jewett supplies an interval on which a monochromatic 14-term
progression is forced. This establishes the numerical lower bound independently
of both finite upper-bound hypotheses. -/
theorem lower_bound : 186 ≤ W 3 14 := by
  classical
  apply W_ge_succ_of_not_mem 3 14 185 _ lower_witness
  obtain ⟨ι, inst, cube⟩ := Combinatorics.Line.exists_mono_in_high_dimension (Fin 14) (Fin 2)
  let : Fintype ι := inst
  let N := Fintype.card ι * 13 + 1
  let point (v : ι → Fin 14) : Icc 1 N :=
    ⟨1 + ∑ i, (v i).val, by
      have hsum : ∑ i, (v i).val ≤ ∑ _i : ι, 13 :=
        Finset.sum_le_sum (fun i _ => show (v i).val ≤ 13 by omega)
      simp only [Finset.sum_const, Finset.card_univ, Nat.nsmul_eq_mul] at hsum
      dsimp only [N]
      constructor <;> omega⟩
  refine ⟨N, ?_⟩
  intro c
  obtain ⟨line, col, mono⟩ := cube (fun v => c (point v))
  let active : Finset ι := Finset.univ.filter (fun u => line.idxFun u = none)
  let d := active.card
  let b : ℕ := ∑ u ∈ activeᶜ, ((line.idxFun u).map Fin.val).getD 0
  have hd : 0 < d := Finset.card_pos.mpr
    ⟨line.proper.choose, Finset.mem_filter.mpr ⟨Finset.mem_univ _, line.proper.choose_spec⟩⟩
  have linePoint (x : Fin 14) : (point (line x)).val = b + x.val*d + 1 := by
    change 1 + ∑ u, (line x u).val = _
    rw [← Finset.sum_add_sum_compl active]
    have moving : ∑ u ∈ active, (line x u).val = x.val*d := by
      calc
        ∑ u ∈ active, (line x u).val = ∑ _u ∈ active, x.val := by
          apply Finset.sum_congr rfl
          intro u hu
          rw [line.apply_none x u (Finset.mem_filter.mp hu).2]
        _ = x.val*d := by simp [d, Nat.mul_comm]
    have fixed : ∑ u ∈ activeᶜ, (line x u).val = b := by
      apply Finset.sum_congr rfl
      intro u hu
      cases ho : line.idxFun u with
      | none => exact (Finset.mem_compl.mp hu (Finset.mem_filter.mpr ⟨Finset.mem_univ _, ho⟩)).elim
      | some v => simp [Combinatorics.Line.coe_apply, ho]
    rw [moving, fixed]
    omega
  have build (q : ℕ) (hq : q ≤ 14) : ∃ s : Finset (Icc 1 N),
      ({(z : ℕ) | z ∈ s}).IsAPOfLength q ∧ ∀ z ∈ s, c z = col := by
    apply progression_at (a := b) hd c col
    · intro i
      have hp := (point (line (Fin.castLE hq i))).property.2
      rw [linePoint] at hp
      change b + i.val*d + 1 ≤ N at hp
      omega
    · intro i hi
      have hp := linePoint (Fin.castLE hq i)
      have eqp : (⟨b + i.val*d + 1, by constructor <;> omega⟩ : Icc 1 N) =
          point (line (Fin.castLE hq i)) := Subtype.ext hp.symm
      rw [eqp]
      exact mono _
  fin_cases col
  · exact Or.inl (build 3 (by decide))
  · exact Or.inr (build 14 (by decide))


theorem main : H1 → H2 → type_of% @Green14.W_3_14 := by
  intro h₁ h₂
  have upper : 186 ∈ mixedMonoAPGuaranteeSet 3 14 := by
    intro c
    let r (i : Fin 186) := decide (c ⟨i.val+1, by constructor <;> omega⟩ = 0)
    obtain ⟨b,a,d,hd,he,hm⟩ := allColorings h₁ h₂ (fun x => r (Fin.ofNat 186 x))
    cases b
    · right
      apply progression_at (a := a) hd c 1
      · intro i
        have := Nat.mul_le_mul_right d (show i.val ≤ 13 by omega)
        simp only [Bool.false_eq_true,if_false] at he
        omega
      · intro i hi
        have hh := hm i.val (by change i.val ≤ 13; omega)
        have hx : Fin.ofNat 186 (a+i.val*d) = ⟨a+i.val*d,hi⟩ := Fin.ext (idx_val _ hi)
        change r (Fin.ofNat 186 (a+i.val*d)) = _ at hh
        rw [hx] at hh
        dsimp only [r] at hh
        have hv : c ⟨a+i.val*d+1,by constructor <;> omega⟩ ≠ 0 := of_decide_eq_false hh
        exact (show ∀ x : Fin 2, x ≠ 0 → x = 1 by decide) _ hv
    · left
      apply progression_at (a := a) hd c 0
      · intro i
        have := Nat.mul_le_mul_right d (show i.val ≤ 2 by omega)
        simp only [if_true] at he
        omega
      · intro i hi
        have hh := hm i.val (by change i.val ≤ 2; omega)
        have hx : Fin.ofNat 186 (a+i.val*d) = ⟨a+i.val*d,hi⟩ := Fin.ext (idx_val _ hi)
        change r (Fin.ofNat 186 (a+i.val*d)) = _ at hh
        rw [hx] at hh
        dsimp only [r] at hh
        exact of_decide_eq_true hh
  exact le_antisymm (Nat.sInf_le upper)
    lower_bound


