private def Punctured (h : Fin 14) (f : Fin 14 → Bool) : Prop :=
  ∃ x y z : Fin 14, x.val+z.val=2*y.val ∧ x ≠ z ∧ x ≠ h ∧ y ≠ h ∧ z ≠ h ∧
    f x = f y ∧ f y = f z

private lemma found (h x y z : Fin 14) (f : Fin 14 → Bool)
    (bounds : x.val+z.val=2*y.val ∧ x ≠ z ∧ x ≠ h ∧ y ≠ h ∧ z ≠ h)
    (color : f x = f y ∧ f y = f z) : Punctured h f :=
  ⟨x, y, z, bounds.1, bounds.2.1, bounds.2.2.1, bounds.2.2.2.1, bounds.2.2.2.2, color⟩

