/-!
# Red supports on reflected progressions for W(3,14)

The palindromic obstructions at lengths 175 and 184 are certified below.
KoaOkano's reduction R2 uses the union and intersection of the red set with
its reflection in each such window. On the central 184 points the intersection
gives a fourteen-term progression and its mirror whose red index sets are
disjoint. Each set is nonempty and has no three-term progression.

Deleting any one vertex of the fourteen-index interval still leaves a
two-color Ramsey configuration for triples. Thus at least two indices are
blue in both progressions. Either one progression contains at most five red
points or each contains exactly six. These are the two remaining cases.

The 185-site coloring and the interval lemmas are from NickLeko's R1,
following Halldon and Dominic Dabish. The independent Hales--Jewett
nonemptiness proof adapts ZedingZhang's Green14.W_3_13.R2. The two
palindromic search certificates and the punctured interval certificates were
generated for this reduction. See Ahmed, Kullmann and Snevily,
*On the van der Waerden numbers w(2;3,t)*, Tables 1 and 6.
-/

-- Credit: @deepqntm

/-!
# Two palindromic obstructions for the mixed van der Waerden number W(3,14)

A search branches on pairs of reflected positions. Choosing a red pair rules out
completions of red triples. Each leaf exhibits a fourteen-term progression
with no remaining red candidate. The search instructions only select a point
or a progression. The proof checks each choice with the kernel.

The obstruction lengths are from Ahmed, Kullmann and Snevily,
*On the van der Waerden numbers w(2;3,t)*, §5.2, Table 6.
The four masks for detecting red triples adapt the Apache-2.0 bit-mask
argument of MrSeizy in the reduction Green14.W_3_13.R3, following Vincent
T. Mossman and PanPapag.
-/

namespace OMA.Green14Palindromes

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (185-q), 1 <<< (2*q),
    if q%2=0 then 1 <<< (q/2) else 0,
    if q%2=1 then 1 <<< (q/2) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (2*p)) >>> 185) ||| (s.dbl >>> p) |||
    ((if p%2=0 then s.ev else s.od) <<< ((p+1)/2))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit t = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 185) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< p))



private abbrev State := Marks × Nat

/-- An avoiding red set in a symmetric window of length n. -/
private structure Avoids (n : Nat) (R : Nat → Prop) : Prop where
  inside : ∀ p, R p → p < n
  mirror : ∀ p, R p → R (n-1-p)
  triple : NoTriple R
  hit : ∀ a d, 0 < d → a+13*d < n → ∃ t : Fin 14, R (a+t.val*d)

private def Compatible (R : Nat → Prop) (s : State) :=
  Good R s.1 ∧ ∀ p, R p → s.2.testBit p = true

private def retainRed (s : State) (p : Nat) := addRed s.1 s.2 p

private lemma singleBit (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
  rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]

private lemma retainRed_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    (width : n ≤ 186) {s : State} (hs : Compatible R s) {p : Nat}
    (hp : R p) : Compatible R (retainRed s p) := by
  have bound := h.inside p hp
  refine ⟨join_good hs.1 (mark_good h.triple hp (by omega)), ?_⟩
  intro x hx
  by_cases he : x = p
  · simp [retainRed, addRed, he]
  · simp [retainRed, addRed, Nat.testBit_xor, hs.2 x hx, hs.1 p x hp hx he]

/-- If p is red, the mirror pair {x,n-1-x} cannot both be red when these
three distinct positions form a progression. -/
private def filterPartners (n p candidates : Nat) : Nat :=
  if 2*p = n-1 then candidates &&& (1 <<< p) else
  if (n-1+p)%3 = 0 then
    let x := (n-1+p)/3
    let bad := (1 <<< x) ||| (1 <<< (n-1-x))
    candidates ^^^ (candidates &&& bad)
  else candidates

private lemma filterPartners_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    {p a : Nat} (hp : R p) (ha : ∀ x, R x → a.testBit x = true) :
    ∀ x, R x → (filterPartners n p a).testBit x = true := by
  intro x hx
  have bx := h.inside x hx
  have bp := h.inside p hp
  unfold filterPartners
  split
  · rename_i central
    have same : x = p := by
      by_contra different
      exact distinct_terms h.triple hx hp (h.mirror x hx) (by omega) (by omega)
    simp [Nat.testBit_and, same, ha p hp]
  · rename_i central
    split
    · rename_i div
      have avoid (u : Nat) (hu : R u) : 3*u ≠ n-1+p := by
        intro eq
        have bu := h.inside u hu
        exact distinct_terms h.triple hp hu (h.mirror u hu) (by omega) (by omega)
      have hx₁ := avoid x hx
      have hx₂ := avoid (n-1-x) (h.mirror x hx)
      have e₁ : (n-1+p)/3 ≠ x := by omega
      have e₂ : n-1-(n-1+p)/3 ≠ x := by omega
      simp only [Nat.testBit_xor, Nat.testBit_and, Nat.testBit_or, singleBit, ha x hx]
      simp [e₁, e₂]
    · exact ha x hx

private def setRedPair (n : Nat) (s : State) (p : Nat) : State :=
  let q := n-1-p
  let u := retainRed (retainRed s p) q
  (u.1, filterPartners n q (filterPartners n p u.2))

private lemma setRedPair_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    (width : n ≤ 186) {s : State} (hs : Compatible R s) {p : Nat} (hp : R p) :
    Compatible R (setRedPair n s p) := by
  have hq := h.mirror p hp
  have bundle := retainRed_sound h width (retainRed_sound h width hs hp) hq
  exact ⟨bundle.1, filterPartners_sound h hq (filterPartners_sound h hp bundle.2)⟩

private def setBluePair (n : Nat) (s : State) (p : Nat) : State :=
  let bad := (1 <<< p) ||| (1 <<< (n-1-p))
  (s.1, s.2 ^^^ (s.2 &&& bad))

private lemma setBluePair_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    {s : State} (hs : Compatible R s) {p : Nat} (bound : p < n) (hp : ¬ R p) :
    Compatible R (setBluePair n s p) := by
  refine ⟨hs.1, ?_⟩
  intro x hx
  have hx' := h.mirror x hx
  have bx := h.inside x hx
  have e₁ : p ≠ x := by rintro rfl; exact hp hx
  have e₂ : n-1-p ≠ x := by
    intro eq
    exact hp (show R p from (show n-1-x = p by omega) ▸ hx')
  simp only [setBluePair, Nat.testBit_xor, Nat.testBit_and, Nat.testBit_or, singleBit, hs.2 x hx]
  simp [e₁, e₂]

/-- Column t of the row of common difference d has its bit at t*d. -/
private def bases : Array Nat := #[0x1,
  0x3fff,
  0x5555555,
  0x9249249249,
  0x11111111111111,
  0x21084210842108421,
  0x41041041041041041041,
  0x81020408102040810204081,
  0x101010101010101010101010101,
  0x201008040201008040201008040201,
  0x401004010040100401004010040100401,
  0x801002004008010020040080100200400801,
  0x1001001001001001001001001001001001001001,
  0x2001000800400200100080040020010008004002001,
  0x4001000400100040010004001000400100040010004001]

private lemma bases_valid : ∀ d : Fin 15, ∀ t : Fin 14,
    (bases[d.val]!).testBit (t.val*d.val) = true := by decide +kernel

private def blueConflict (n candidates a d : Nat) : Bool :=
  decide (0 < d ∧ d ≤ 14 ∧ a+13*d < n ∧ candidates &&& (bases[d]! <<< a) = 0)

private lemma blueConflict_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    {s : State} (hs : Compatible R s) {a d : Nat}
    (hc : blueConflict n s.2 a d = true) : False := by
  obtain ⟨pos,lim,inside,empty⟩ := of_decide_eq_true hc
  obtain ⟨t,ht⟩ := h.hit a d pos inside
  have hb := congrArg (fun m : Nat => m.testBit (a+t.val*d)) empty
  simp [Nat.testBit_and, Nat.testBit_shiftLeft, hs.2 _ ht,
    bases_valid ⟨d, by omega⟩ t] at hb

/-- Preorder instructions below 256 split on a mirror pair. Higher values
encode a prospective blue progression by its start and common difference.
A successful visit returns the next instruction index. -/
private def visit (n : Nat) (word : Nat → Nat) : Nat → Nat → State → Nat
  | 0, _, _ => 0
  | fuel+1, i, s =>
    let w := word i
    if w < 256 then
      if w < n then
        match visit n word fuel (i+1) (setRedPair n s w) with
        | 0 => 0
        | j+1 => visit n word fuel (j+1) (setBluePair n s w)
      else 0
    else if blueConflict n s.2 (w%256) (w/256-1) then i+1 else 0

private lemma visit_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    (width : n ≤ 186) (word : Nat → Nat) (fuel i : Nat) (s : State)
    (hs : Compatible R s) (ok : visit n word fuel i s ≠ 0) : False := by
  induction fuel generalizing i s with
  | zero => exact ok rfl
  | succ k ih =>
    rw [visit] at ok

    split at ok
    · split at ok
      · rename_i bound
        cases left : visit n word k (i+1) (setRedPair n s (word i)) with
        | zero => exact ok (by rw [left])
        | succ j =>
          by_cases hp : R (word i)
          · exact ih (i+1) _ (setRedPair_sound h width hs hp) (by rw [left]; omega)
          · exact ih (j+1) _ (setBluePair_sound h hs bound hp) (by simpa only [left] using ok)
      · exact ok rfl
    · split at ok
      · rename_i conflict
        exact blueConflict_sound h hs conflict
      · exact ok rfl

private def initial : State := (⟨0,0,0,0⟩, 2^186-1)

private lemma initial_sound {n : Nat} {R : Nat → Prop} (h : Avoids n R)
    (width : n ≤ 186) : Compatible R initial := by
  constructor
  · intro p t _ _ _
    simp [initial, forbidden]
  · intro p hp
    have bp := h.inside p hp
    have hm : ∀ i : Fin 186, (2^186-1 : Nat).testBit i.val = true := by decide +kernel
    exact hm ⟨p, by omega⟩

private def readWord (packets : Array Nat) (i : Nat) : Nat :=
  (packets[i/64]?.getD 0 >>> (16*(i%64))) % 65536

private def Progression (n : Nat) (c : Nat → Bool) : Prop :=
  ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13)*d < n ∧
    ∀ t ≤ (if b then 2 else 13 : Nat), c (a+t*d) = b

private def Closed (n : Nat) (s : State) : Prop :=
  ∀ R : Nat → Prop, Avoids n R → Compatible R s → False

private lemma slice {n : Nat} {s : State} (width : n ≤ 186) (word : Nat → Nat)
    (fuel : Nat) (checked : visit n word fuel 0 s ≠ 0) : Closed n s :=
  fun _ h hs => visit_sound h width word fuel 0 s hs checked

private lemma fork {n p : Nat} {s : State} (width : n ≤ 186) (bound : p < n)
    (left : Closed n (setRedPair n s p)) (right : Closed n (setBluePair n s p)) : Closed n s := by
  intro R h hs
  by_cases red : R p
  · exact left R h (setRedPair_sound h width hs red)
  · exact right R h (setBluePair_sound h hs bound red)

private lemma force {n : Nat} (width : n ≤ 186) (checked : Closed n initial)
    (c : Nat → Bool) (pal : ∀ x < n, c (n-1-x) = c x) : Progression n c := by
  by_contra no
  let R (x : Nat) := x < n ∧ c x = true
  have h : Avoids n R := by
    constructor
    · exact fun _ hx => hx.1
    · intro p hp
      exact ⟨by have := hp.1; omega, (pal p hp.1).trans hp.2⟩
    · intro a d hd h₀ h₁ h₂
      apply no
      refine ⟨true, a, d, hd, h₂.1, ?_⟩
      intro t ht
      change t ≤ 2 at ht
      rcases (show t = 0 ∨ t = 1 ∨ t = 2 by omega) with rfl | rfl | rfl
      · simpa using h₀.2
      · simpa using h₁.2
      · exact h₂.2
    · intro a d hd bound
      by_contra! none
      apply no
      refine ⟨false, a, d, hd, bound, ?_⟩
      intro t ht
      change t ≤ 13 at ht
      apply Bool.eq_false_iff.mpr
      intro red
      have hm := Nat.mul_le_mul_right d ht
      apply none ⟨t,by omega⟩
      exact (show R (a+t*d) from ⟨by omega,red⟩)
  exact checked R h (initial_sound h width)


