import FormalConjectures.ErdosProblems.«967»

-- Reduction Erdos967.erdos_967.variants.finite.R1 of the Erdős–Ingham question for finite sets
-- Credit: @LordMike
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# `1 + ∑_{n ∈ A} n^(-1-it) ≠ 0` for every finite `A` from Schanuel's conjecture

This is an UPWARD reduction: `H1` is Schanuel's conjecture (the catalogue problem
`Schanuel.schanuel_conjecture`, word for word), which is far stronger than the target. The other
three hypotheses are elementary algebra.

* `H1`: Schanuel's conjecture (open, deep).
* `H2`: the logarithms of distinct primes are linearly independent over `ℚ` (unique
  factorisation).
* `H3`: a common zero `z ∈ ℂ^m` of two coprime polynomials over `ℚ` has transcendence degree at
  most `m - 2`: all coordinates are algebraic over the field generated by `m - 2` of them (Gauss's
  lemma and a Bézout identity).
* `H4`: for distinct primes `p_i`, a polynomial `∑_{f ∈ E} x^f / p^f` with constant term `1`
  (so `0 ∈ E`) is coprime to its reciprocal `∑_{f ∈ E} x^(D - f) / p^f`. (Order the monomials by
  the value of `p^f`. By Gauss's lemma a divisor `Q` of the first polynomial has, after the
  substitution `x_i ↦ p_i x_i`, leading and trailing coefficients of the same absolute value; if
  `Q` also divides the reciprocal the same holds for the reversed `Q`. The two relations give
  `p^(2 v_max) = p^(2 v_min)`, so `Q` is a monomial, hence a constant.)

Proof of the target. For `t = 0` the sum is positive. Let `t ≠ 0`, let `p_1, ..., p_k` be the
primes dividing the elements of `A` and put `u_i = p_i^(-it)`. Then
`1 + ∑ n^(-1-it) = P(u)` with `P = ∑_{n ∈ A ∪ {1}} x^(e(n)) / n`, and since `|u_i| = 1` the
conjugate equation says that the reciprocal polynomial vanishes at `u` as well. By `H4` and `H3`
all `u_i` are algebraic over the field generated by `k - 2` of them. By `H2` and `t ≠ 0` the `2k`
numbers `log p_i`, `-it log p_i` are linearly independent over `ℚ`; their exponentials are `p_i`
and `u_i`. All `4k` numbers are algebraic over the field generated by the `log p_i`, one number
`-it log p_1` and `k - 2` of the `u_i`, so the transcendence degree is at most `2k - 1`,
against `H1`.

The lemmas `trdeg_adjoin_le`, `summand_eq`, `conj_exp` and `re_im_of` are taken from our
reduction `Erdos967.erdos_967.variants.two_three_five.R1` (the case `A = {2, 3, 5}`).
-/

namespace OMA.R_Erdos967_erdos_967_variants_finite_R1

open IntermediateField

/-- Schanuel's conjecture, in the wording of the catalogue row `Schanuel.schanuel_conjecture`. -/
def H1 : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℂ), LinearIndependent ℚ z →
    (n : Cardinal) ≤ Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))

/-- The logarithms of distinct primes are linearly independent over `ℚ`. -/
def H2 : Prop :=
  ∀ (k : ℕ) (p : Fin k → ℕ), (∀ i, (p i).Prime) → Function.Injective p →
    LinearIndependent ℚ (fun i => Real.log (p i))

/-- A common zero of two coprime rational polynomials in `m` variables has transcendence degree
at most `m - 2`: all its coordinates are algebraic over the field generated by the coordinates in
a set `I` of at most `m - 2` indices. -/
def H3 : Prop :=
  ∀ (m : ℕ) (z : Fin m → ℂ) (P Q : MvPolynomial (Fin m) ℚ), IsRelPrime P Q →
    MvPolynomial.aeval z P = 0 → MvPolynomial.aeval z Q = 0 →
    ∃ I : Finset (Fin m), I.card + 2 ≤ m ∧
      ∀ l, IsAlgebraic (adjoin ℚ (z '' (I : Set (Fin m)))) (z l)

/-- For distinct primes `p_i`, the polynomial `∑_{f ∈ E} x^f / p^f` with `0 ∈ E` is coprime to
its reciprocal `∑_{f ∈ E} x^(D - f) / p^f`. -/
def H4 : Prop :=
  ∀ (k : ℕ) (p : Fin k → ℕ), (∀ i, (p i).Prime) → Function.Injective p →
    ∀ (E : Finset (Fin k →₀ ℕ)) (D : Fin k →₀ ℕ), 0 ∈ E → (∀ f ∈ E, f ≤ D) →
      IsRelPrime (∑ f ∈ E, MvPolynomial.monomial f (1 / ∏ i, (p i : ℚ) ^ f i))
        (∑ f ∈ E, MvPolynomial.monomial (D - f) (1 / ∏ i, (p i : ℚ) ^ f i))

/-- A field generated by a set `S`, all of whose elements are algebraic over the field generated
by a finite family in `S`, has transcendence degree at most the size of the family. -/
lemma trdeg_adjoin_le {S : Set ℂ} {ι : Type} [Fintype ι] (t : ι → ℂ) (hTS : Set.range t ⊆ S)
    (halg : ∀ s ∈ S, IsAlgebraic (adjoin ℚ (Set.range t)) s) :
    Algebra.trdeg ℚ (adjoin ℚ S) ≤ (Fintype.card ι : Cardinal) := by
  open IntermediateField.algebraAdjoinAdjoin in
  have h1 : Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range t)) ≤ (Fintype.card ι : Cardinal) := by
    have hB : Algebra.adjoin ℚ (Set.range t) = (MvPolynomial.aeval t).range :=
      Algebra.adjoin_range_eq_range_aeval ℚ t
    let f : MvPolynomial ι ℚ →ₐ[ℚ] Algebra.adjoin ℚ (Set.range t) :=
      (MvPolynomial.aeval t).codRestrict _ (fun p => by rw [hB]; exact ⟨p, rfl⟩)
    have hf : Function.Surjective f := by
      rintro ⟨b, hb⟩
      rw [hB] at hb
      obtain ⟨p, hp⟩ := hb
      exact ⟨p, Subtype.ext hp⟩
    have := trdeg_le_of_surjective f hf
    rw [MvPolynomial.trdeg_of_isDomain] at this
    simpa using this
  have hBK : Algebra.adjoin ℚ (Set.range t) ≤ (adjoin ℚ S).toSubalgebra :=
    Algebra.adjoin_le (fun x hx => subset_adjoin ℚ S (hTS hx))
  let _ : Algebra (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    (Subalgebra.inclusion hBK).toAlgebra
  have : IsScalarTower ℚ (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.isScalarTower_left hBK _
  have : FaithfulSMul (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.faithfulSMul hBK
  have hle : adjoin ℚ S ≤ (algebraicClosure (adjoin ℚ (Set.range t)) ℂ).restrictScalars ℚ := by
    rw [adjoin_le_iff]
    intro s hs
    exact mem_algebraicClosure_iff.mpr (halg s hs)
  have : Algebra.IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) := by
    refine ⟨fun x => ?_⟩
    have hx : IsAlgebraic (adjoin ℚ (Set.range t)) (x : ℂ) :=
      mem_algebraicClosure_iff.mp (hle x.2)
    have hx' : IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (x : ℂ) :=
      (IsFractionRing.isAlgebraic_iff (Algebra.adjoin ℚ (Set.range t))
        (adjoin ℚ (Set.range t)) ℂ).mpr hx
    let g : (adjoin ℚ S) →ₐ[Algebra.adjoin ℚ (Set.range t)] ℂ :=
      { (adjoin ℚ S).val.toRingHom with commutes' := fun _ => rfl }
    exact (isAlgebraic_algHom_iff g Subtype.val_injective).mp hx'
  have h2 := trdeg_add_eq ℚ (Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S)
  rw [trdeg_eq_zero (R := Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S), add_zero] at h2
  rw [← h2]
  exact h1

/-- An element of an intermediate field is algebraic over it. -/
lemma alg_mem (F : IntermediateField ℚ ℂ) {x : ℂ} (hx : x ∈ F) : IsAlgebraic F x :=
  isAlgebraic_algebraMap (⟨x, hx⟩ : F)

/-- Algebraicity passes to a larger intermediate field. -/
lemma alg_mono {E F : IntermediateField ℚ ℂ} (h : E ≤ F) {x : ℂ} (hx : IsAlgebraic E x) :
    IsAlgebraic F x := by
  obtain ⟨q, hq0, hq⟩ := hx
  refine ⟨q.map (IntermediateField.inclusion h : E →+* F), ?_, ?_⟩
  · exact (Polynomial.map_ne_zero_iff (RingHom.injective _)).mpr hq0
  · rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    exact hq

/-- Real and imaginary parts of `x + y i = 0`. -/
lemma re_im_of (x y : ℝ) (h : (x : ℂ) + (y : ℂ) * Complex.I = 0) : x = 0 ∧ y = 0 := by
  have h' := Complex.ext_iff.mp h
  simpa using h'

/-- The summand as an exponential. -/
lemma summand_eq (t : ℝ) (n : ℕ) (hn : 0 < n) :
    Erdos967.summand t n =
      Complex.exp (-(t * Complex.I) * ((Real.log n : ℝ) : ℂ)) / (n : ℂ) := by
  have hn0 : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have hlog : Complex.log (n : ℂ) = ((Real.log n : ℝ) : ℂ) := by
    rw [Complex.ofReal_log (Nat.cast_nonneg n)]
    simp
  have hexp : Complex.exp ((Real.log n : ℝ) : ℂ) = (n : ℂ) := by
    rw [← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast hn)]
    simp
  unfold Erdos967.summand
  rw [Complex.cpow_def_of_ne_zero hn0, hlog, mul_add, mul_one, Complex.exp_add, hexp,
    show -(t * Complex.I) * ((Real.log n : ℝ) : ℂ) = -(((Real.log n : ℝ) : ℂ) * (t * Complex.I)) by
      ring, Complex.exp_neg]
  field_simp

/-- The numbers `p^(-it)` have modulus one: the conjugate is the inverse. -/
lemma conj_exp (t L : ℝ) :
    (starRingEnd ℂ) (Complex.exp (-(t * Complex.I) * (L : ℂ))) =
      (Complex.exp (-(t * Complex.I) * (L : ℂ)))⁻¹ := by
  rw [← Complex.exp_conj, ← Complex.exp_neg]
  congr 1
  simp

/-- `n^(-it)` is the product of the `p_i^(-it)` when `n = ∏ p_i^(f i)`. -/
lemma exp_prod {k : ℕ} (p : Fin k → ℕ) (hp : ∀ i, 0 < p i) (t : ℝ) (f : Fin k → ℕ) :
    Complex.exp (-(t * Complex.I) * ((Real.log ((∏ i, p i ^ f i : ℕ) : ℝ) : ℝ) : ℂ)) =
      ∏ i, Complex.exp (-(t * Complex.I) * ((Real.log (p i) : ℝ) : ℂ)) ^ f i := by
  have h : Real.log ((∏ i, p i ^ f i : ℕ) : ℝ) = ∑ i, (f i : ℝ) * Real.log (p i) := by
    push_cast
    rw [Real.log_prod (fun i _ => pow_ne_zero _ (Nat.cast_ne_zero.mpr (hp i).ne'))]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Real.log_pow]
  rw [h]
  push_cast
  rw [Finset.mul_sum, Complex.exp_sum]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [← Complex.exp_nat_mul]
  congr 1
  ring

/-- One term of the polynomial, evaluated at the `p_i^(-it)`. -/
lemma term_eq {k : ℕ} (p : Fin k → ℕ) (hp : ∀ i, 0 < p i) (t : ℝ) (f : Fin k →₀ ℕ) :
    (algebraMap ℚ ℂ (1 / ∏ i, (p i : ℚ) ^ f i)) *
      ∏ i, Complex.exp (-(t * Complex.I) * ((Real.log (p i) : ℝ) : ℂ)) ^ f i =
    Complex.exp (-(t * Complex.I) * ((Real.log ((∏ i, p i ^ f i : ℕ) : ℝ) : ℝ) : ℂ)) /
      ((∏ i, p i ^ f i : ℕ) : ℂ) := by
  rw [exp_prod p hp t f]
  simp only [map_div₀, map_one, map_prod, map_pow, map_natCast]
  push_cast
  ring

/-- The value of the polynomial at the `p_i^(-it)`. -/
lemma aeval1 {k : ℕ} (p : Fin k → ℕ) (hp : ∀ i, 0 < p i) (t : ℝ) (E : Finset (Fin k →₀ ℕ)) :
    MvPolynomial.aeval (fun i => Complex.exp (-(t * Complex.I) * ((Real.log (p i) : ℝ) : ℂ)))
      (∑ f ∈ E, MvPolynomial.monomial f (1 / ∏ i, (p i : ℚ) ^ f i)) =
    ∑ f ∈ E, Complex.exp (-(t * Complex.I) * ((Real.log ((∏ i, p i ^ f i : ℕ) : ℝ) : ℝ) : ℂ)) /
      ((∏ i, p i ^ f i : ℕ) : ℂ) := by
  rw [map_sum]
  refine Finset.sum_congr rfl fun f _ => ?_
  rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
  exact term_eq p hp t f

/-- The value of the reciprocal polynomial is a multiple of the conjugate value. -/
lemma aeval2 {k : ℕ} (p : Fin k → ℕ) (t : ℝ) (E : Finset (Fin k →₀ ℕ)) (D : Fin k →₀ ℕ)
    (hD : ∀ f ∈ E, f ≤ D) :
    MvPolynomial.aeval (fun i => Complex.exp (-(t * Complex.I) * ((Real.log (p i) : ℝ) : ℂ)))
      (∑ f ∈ E, MvPolynomial.monomial (D - f) (1 / ∏ i, (p i : ℚ) ^ f i)) =
    (∏ i, Complex.exp (-(t * Complex.I) * ((Real.log (p i) : ℝ) : ℂ)) ^ D i) *
      (starRingEnd ℂ) (MvPolynomial.aeval
        (fun i => Complex.exp (-(t * Complex.I) * ((Real.log (p i) : ℝ) : ℂ)))
        (∑ f ∈ E, MvPolynomial.monomial f (1 / ∏ i, (p i : ℚ) ^ f i))) := by
  rw [map_sum, map_sum, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun f hf => ?_
  rw [MvPolynomial.aeval_monomial, MvPolynomial.aeval_monomial,
    Finsupp.prod_fintype _ _ (fun i => pow_zero _), Finsupp.prod_fintype _ _ (fun i => pow_zero _),
    map_mul, map_prod]
  have hc : (starRingEnd ℂ) (algebraMap ℚ ℂ (1 / ∏ i, (p i : ℚ) ^ f i)) =
      algebraMap ℚ ℂ (1 / ∏ i, (p i : ℚ) ^ f i) := by
    rw [eq_ratCast]
    exact map_ratCast (starRingEnd ℂ) _
  rw [hc, mul_left_comm, ← Finset.prod_mul_distrib]
  congr 1
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_pow, conj_exp, Finsupp.tsub_apply,
    pow_sub₀ _ (Complex.exp_ne_zero _) (Finsupp.le_def.mp (hD f hf) i), inv_pow]

/-- A number is the product of the prime powers given by its factorisation. -/
lemma prod_pow_eq {k : ℕ} (s : Finset ℕ) (p : Fin k → ℕ) (hinj : Function.Injective p)
    (hs : Finset.univ.image p = s) (n : ℕ) (hn : n ≠ 0) (hns : n.primeFactors ⊆ s) :
    ∏ i, p i ^ n.factorization (p i) = n := by
  have h1 : ∏ i, p i ^ n.factorization (p i) = ∏ q ∈ s, q ^ n.factorization q := by
    rw [← hs, Finset.prod_image (fun a _ b _ h => hinj h)]
  rw [h1, ← Finset.prod_subset hns (fun q _ hq => by
    rw [← Nat.support_factorization, Finsupp.notMem_support_iff] at hq
    rw [hq, pow_zero])]
  conv_rhs => rw [← Nat.prod_factorization_pow_eq_self hn]
  rw [Finsupp.prod, Nat.support_factorization]

/-- The `2k` numbers `l_i`, `-it l_i` are linearly independent over `ℚ`. -/
lemma lin2k {k : ℕ} (l : Fin k → ℝ) (hl : LinearIndependent ℚ l) (t : ℝ) (ht : t ≠ 0) :
    LinearIndependent ℚ (Fin.append (fun i => ((l i : ℝ) : ℂ))
      (fun i => -(t * Complex.I) * ((l i : ℝ) : ℂ))) := by
  rw [Fintype.linearIndependent_iff] at hl ⊢
  intro g hg
  rw [Fin.sum_univ_add] at hg
  simp only [Fin.append_left, Fin.append_right, Rat.smul_def] at hg
  have key : (((∑ i, (g (Fin.castAdd k i) : ℝ) * l i : ℝ)) : ℂ) +
      ((-t * ∑ i, (g (Fin.natAdd k i) : ℝ) * l i : ℝ) : ℂ) * Complex.I = 0 := by
    rw [← hg]
    push_cast
    rw [Finset.mul_sum, Finset.sum_mul]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  obtain ⟨hx, hy⟩ := re_im_of _ _ key
  have hy' : ∑ i, (g (Fin.natAdd k i) : ℝ) * l i = 0 := by
    rcases mul_eq_zero.mp hy with h | h
    · exact absurd (neg_eq_zero.mp h) ht
    · exact h
  have a := hl (fun i => g (Fin.castAdd k i)) (by simpa [Rat.smul_def] using hx)
  have b := hl (fun i => g (Fin.natAdd k i)) (by simpa [Rat.smul_def] using hy')
  intro i
  induction i using Fin.addCases with
  | left i => exact a i
  | right i => exact b i

/-- The upper bound for the transcendence degree of the Schanuel field. -/
lemma upper {k : ℕ} (L : Fin k → ℂ) (hL0 : ∀ i, L i ≠ 0)
    (hexp : ∀ i, ∃ n : ℕ, Complex.exp (L i) = n) (c : ℂ) (I : Finset (Fin k))
    (hI : I.card + 2 ≤ k)
    (halg : ∀ l, IsAlgebraic
      (adjoin ℚ ((fun i => Complex.exp (c * L i)) '' (I : Set (Fin k))))
      (Complex.exp (c * L l))) :
    Algebra.trdeg ℚ (adjoin ℚ (Set.range (Fin.append L (fun i => c * L i)) ∪
      Set.range (Complex.exp ∘ Fin.append L (fun i => c * L i)))) ≤
      ((k + (1 + I.card) : ℕ) : Cardinal) := by
  obtain ⟨i0⟩ : Nonempty (Fin k) := ⟨⟨0, by omega⟩⟩
  have hcard : Fintype.card (Fin k ⊕ (Unit ⊕ I)) = k + (1 + I.card) := by simp
  rw [← hcard]
  refine trdeg_adjoin_le
    (Sum.elim L (Sum.elim (fun _ => c * L i0) (fun l : I => Complex.exp (c * L l)))) ?_ ?_
  · rintro _ ⟨(i | ⟨⟨⟩⟩ | l), rfl⟩
    · exact Or.inl ⟨Fin.castAdd k i, by simp⟩
    · exact Or.inl ⟨Fin.natAdd k i0, Fin.append_right L _ i0⟩
    · exact Or.inr ⟨Fin.natAdd k l, congrArg Complex.exp (Fin.append_right L _ (l : Fin k))⟩
  · set F := adjoin ℚ (Set.range
      (Sum.elim L (Sum.elim (fun _ => c * L i0) (fun l : I => Complex.exp (c * L l))))) with hF
    have mL : ∀ i, L i ∈ F := fun i => subset_adjoin ℚ _ ⟨Sum.inl i, rfl⟩
    have mM0 : c * L i0 ∈ F := subset_adjoin ℚ _ ⟨Sum.inr (Sum.inl ()), rfl⟩
    have mM : ∀ i, c * L i ∈ F := by
      intro i
      have : c * L i = c * L i0 * L i / L i0 := by
        have := hL0 i0
        field_simp
      rw [this]
      exact div_mem (mul_mem mM0 (mL i)) (mL i0)
    have hsub : adjoin ℚ ((fun i => Complex.exp (c * L i)) '' (I : Set (Fin k))) ≤ F := by
      rw [adjoin_le_iff]
      rintro _ ⟨l, hl, rfl⟩
      exact subset_adjoin ℚ _ ⟨Sum.inr (Sum.inr ⟨l, hl⟩), rfl⟩
    rintro x (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · induction j using Fin.addCases with
      | left i => rw [Fin.append_left]; exact alg_mem _ (mL i)
      | right i => rw [Fin.append_right]; exact alg_mem _ (mM i)
    · induction j using Fin.addCases with
      | left i =>
        rw [Function.comp_apply, Fin.append_left]
        obtain ⟨n, hn⟩ := hexp i
        rw [hn]
        exact alg_mem _ (IntermediateField.natCast_mem _ n)
      | right i =>
        rw [Function.comp_apply, Fin.append_right]
        exact alg_mono hsub (halg i)

/-- The case `t ≠ 0`. -/
lemma core (h1 : H1) (h2 : H2) (h3 : H3) (h4 : H4) (A : Finset ℕ) (hA : ∀ n ∈ A, 1 < n)
    (t : ℝ) (ht : t ≠ 0) (hsum : 1 + ∑ n ∈ A, Erdos967.summand t n = 0) : False := by
  classical
  obtain ⟨k, hk⟩ : ∃ k, (A.biUnion Nat.primeFactors).card = k := ⟨_, rfl⟩
  have hinj : Function.Injective (fun i => (A.biUnion Nat.primeFactors).orderEmbOfFin hk i) :=
    ((A.biUnion Nat.primeFactors).orderEmbOfFin hk).injective
  have himg : Finset.univ.image (fun i => (A.biUnion Nat.primeFactors).orderEmbOfFin hk i) =
      A.biUnion Nat.primeFactors := Finset.image_orderEmbOfFin_univ _ hk
  generalize (fun i => (A.biUnion Nat.primeFactors).orderEmbOfFin hk i) = p at hinj himg
  have hprime : ∀ i, (p i).Prime := by
    intro i
    have : p i ∈ A.biUnion Nat.primeFactors := by
      rw [← himg]
      exact Finset.mem_image_of_mem p (Finset.mem_univ i)
    rw [Finset.mem_biUnion] at this
    obtain ⟨n, -, hn⟩ := this
    exact Nat.prime_of_mem_primeFactors hn
  have hpos : ∀ i, 0 < p i := fun i => (hprime i).pos
  have hN : ∀ n ∈ insert 1 A, ∏ i, p i ^ n.factorization (p i) = n := by
    intro n hn
    rcases Finset.mem_insert.mp hn with rfl | hnA
    · simp
    · exact prod_pow_eq _ p hinj himg n (by have := hA n hnA; omega)
        (Finset.subset_biUnion_of_mem Nat.primeFactors hnA)
  obtain ⟨e, he⟩ : ∃ e : ℕ → (Fin k →₀ ℕ), ∀ n i, e n i = n.factorization (p i) :=
    ⟨fun n => Finsupp.equivFunOnFinite.symm (fun i => n.factorization (p i)), fun n i => rfl⟩
  have hN' : ∀ n ∈ insert 1 A, ∏ i, p i ^ e n i = n := by
    intro n hn
    simp only [he]
    exact hN n hn
  have einj : Set.InjOn e ((insert 1 A : Finset ℕ) : Set ℕ) := by
    intro a ha b hb hab
    rw [← hN' a ha, ← hN' b hb, hab]
  have hle : ∀ f ∈ (insert 1 A).image e, f ≤ ((insert 1 A).image e).sup id :=
    fun f hf => Finset.le_sup (f := id) hf
  have h0E : (0 : Fin k →₀ ℕ) ∈ (insert 1 A).image e := by
    rw [Finset.mem_image]
    refine ⟨1, Finset.mem_insert_self _ _, ?_⟩
