/-- In every finite odd solvable generated marking the exponent k of the
simple cycle satisfies 25^k ≤ 625 times the fourth power of the group order. -/
theorem solvable_bound (geom : H1) {A : Type} [Group A] [Finite A] [Group.IsSolvable A]
    (oddA : Odd (Nat.card A)) (a₀ b₀ : A) (a₁ : a₀≠1) (b₁ : b₀≠1) (ab₀ : a₀≠b₀)
    (gen₀ : Subgroup.closure ({a₀,b₀} : Set A)=⊤) :
    ∃ k : ℕ,2≤k ∧ 25^k≤625*(Nat.card A)^4 ∧ cycleGraph (2^k) ⊑
      SimpleGraph.fromRel (fun u v : Bool × A => u.1=false ∧ v.1=true ∧
        (v.2=u.2 ∨ v.2=a₀*u.2 ∨ v.2=b₀*u.2)) := by
  let rightMatching {K : Type} [Group K] (s t : K) : SimpleGraph (Bool × K) :=
    SimpleGraph.fromRel fun u v => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*s ∨ v.2=u.2*t)
  have rightMatching_adj {K : Type} [Group K] (a b x y : K) :
      (rightMatching a b).Adj (false,x) (true,y) ↔ y=x ∨ y=x*a ∨ y=x*b := by
    simp [rightMatching,SimpleGraph.fromRel_adj]
  let Bounded {G : Type} [Group G] (a b : G) : Prop :=
    ∃ k : ℕ, 2≤k ∧ 25^k≤625*(Nat.card G)^4 ∧ cycleGraph (2^k) ⊑ rightMatching a b
  let Theta {V : Type} (B : SimpleGraph V) (d : ℕ) : Prop := ∃ (s t : V) (p : Fin 3 → ℕ → V), s≠t ∧
        (∀ c,p c 0=s) ∧ (∀ c,p c (d)=t) ∧
        (∀ c i,i<d → B.Adj (p c i) (p c (i+1))) ∧
        (∀ c i,0 < i → i<d → p c i≠s ∧ p c i≠t) ∧
        (∀ c e i k,0 < i → i<d → 0 < k → k<d → p c i=p e k → c=e ∧ i=k)
  have vertex_count {V : Type} [Finite V] {B : SimpleGraph V} {d : ℕ}
      (T : Theta B d) (hd : 1 ≤ d) : 2 + 3 * (d-1) ≤ Nat.card V := by
    obtain ⟨src,dst,arm,ends,_,_,_,avoid,distinct⟩ := T
    let idx (i : Fin (d-1)) : ℕ := i.val+1
    have pos (i : Fin (d-1)) : 0 < idx i := by simp [idx]
    have lt (i : Fin (d-1)) : idx i < d := by have := i.isLt; dsimp [idx]; omega
    let site : Bool ⊕ (Fin 3 × Fin (d-1)) → V :=
      Sum.elim (fun b => if b then dst else src) (fun z => arm z.1 (idx z.2))
    have inj : Function.Injective site := by
      rintro (a|⟨c,i⟩) (b|⟨e,j⟩) eq
      · cases a <;> cases b <;> first | rfl | exact (ends eq).elim | exact (ends eq.symm).elim
      · cases a
        · exact ((avoid e (idx j) (pos j) (lt j)).1 eq.symm).elim
        · exact ((avoid e (idx j) (pos j) (lt j)).2 eq.symm).elim
      · cases b
        · exact ((avoid c (idx i) (pos i) (lt i)).1 eq).elim
        · exact ((avoid c (idx i) (pos i) (lt i)).2 eq).elim
      · obtain ⟨rfl,h⟩:=distinct c e _ _ (pos i) (lt i) (pos j) (lt j) eq
        have ij : i=j := Fin.ext (by simpa [idx] using h)
        rw [ij]
    simpa only [Nat.card_sum, Nat.card_prod, cardBool, Nat.card_fin] using
      Nat.card_le_card_of_injective site inj
  have quotient_weight {Q : Type} [Group Q] [Finite Q] {a b : Q} {j : ℕ}
      (T : Theta (rightMatching a b) (2^j)) (hj : 1≤j) (jsmall : j≤4)
      (ho : Odd (Nat.card Q)) : 25^j ≤ Nat.card Q ^ 4 := by
    obtain ⟨k,hk⟩:=ho
    have cap:=vertex_count T (Nat.one_le_pow _ _ (by decide))
    rw [Nat.card_prod,cardBool] at cap
    interval_cases j <;> norm_num at cap ⊢
    · exact (by norm_num : 25 ≤ 3^4).trans (Nat.pow_le_pow_left (by omega) 4)
    · exact (by norm_num : 625 ≤ 7^4).trans (Nat.pow_le_pow_left (by omega) 4)
    · exact (by norm_num : 15625 ≤ 13^4).trans (Nat.pow_le_pow_left (by omega) 4)
    · exact (by norm_num : 390625 ≤ 25^4).trans (Nat.pow_le_pow_left (by omega) 4)
  have kernel_smaller {G Q : Type} [Group G] [Group Q] [Finite G] [Nontrivial Q] (π : G →* Q) (surj : Function.Surjective π) :
      Nat.card π.ker<Nat.card G := by
    by_contra! le
    obtain ⟨q,hq⟩ := exists_ne (1:Q)
    obtain ⟨x,hx⟩ := surj q
    obtain ⟨h,eq⟩ := (Subtype.val_injective.bijective_of_nat_card_le le).2 x
    exact hq (hx ▸ eq ▸ h.property)
  have base {G : Type} [Group G] [Finite G] {a b : G} {k : ℕ}
      (lo : 2≤k) (hi : k≤5) (cycle : cycleGraph (2^k) ⊑ rightMatching a b) : Bounded a b := by
    obtain ⟨f⟩:=cycle
    have size:=Nat.card_le_card_of_injective f f.injective
    rw [Nat.card_fin,Nat.card_prod,show Nat.card Bool=2 by rw [Nat.card_eq_fintype_card]; decide] at size
    exact ⟨k,lo,terminal size lo hi,⟨f⟩⟩
  have commuting_base {G : Type} [Group G] [Finite G] (a b : G)
      (comm : Commute a b) (a1 : a≠1) (b1 : b≠1) (ne : a≠b) : Bounded a b := by
    let p := Equiv.mulRight a
    let q := Equiv.mulRight b
    have sep (x : G) : p x ≠ x ∧ q x ≠ x ∧ p x ≠ q x := by
      change x*a≠x ∧ x*b≠x ∧ x*a≠x*b
      simpa using And.intro a1 (And.intro b1 ne)
    have eq (x : G) : p (q x)=q (p x) := by
      change x*b*a=x*a*b
      rw [mul_assoc,mul_assoc,comm.eq]
    rcases OMA.R_Erdos64_erdos_64_R1_H1_R1_H1_R1.LocalCommutation.near0 (rightMatching a b) p q sep
      (fun z => (rightMatching_adj a b z _).mpr (.inl rfl))
      (fun z => (rightMatching_adj a b z _).mpr (.inr (.inl rfl)))
      (fun z => (rightMatching_adj a b z _).mpr (.inr (.inr rfl))) 1 (eq _) (eq _) (eq _) (eq _) with h|h|h
    · exact base (k:=2) (by decide) (by decide) h
    · exact base (k:=3) (by decide) (by decide) h
    · exact base (k:=4) (by decide) (by decide) h
  have lift_bound {G Q : Type} [Group G] [Finite G] [Group Q] [Nontrivial Q]
      [Group.IsSolvable G] (odd : Odd (Nat.card G)) (π : G →* Q) (onto : Function.Surjective π)
      (a b : G) {j : ℕ} (hj : 1≤j) (small : j≤4)
      (T : Theta (rightMatching (π a) (π b)) (2^j))
      (ih : ∀ (H : Subgroup π.ker) (s t : H), s≠1 → t≠1 → s≠t →
        Subgroup.closure ({s,t} : Set H)=⊤ → Bounded s t) : Bounded a b := by
    let _ := Finite.of_surjective π onto
    have oddQ : Odd (Nat.card Q) := odd.of_dvd_nat (by
      rw [← Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective π onto).toEquiv]
      exact π.ker.card_quotient_dvd_card)
    have weight:=quotient_weight T hj small oddQ
    have hd : 2≤2^j := (show 2^1≤2^j from Nat.pow_le_pow_right (by decide) hj)
    rcases quotient_lengths π a b onto (by omega : 0 < 2^j) T with h|⟨H,s,t,s1,t1,st,gen,expand⟩
    · exact base (k:=j+1) (by omega) (by omega) (by rw [Nat.pow_succ,Nat.mul_comm]; exact h)
    · obtain ⟨k,lo,cap,cyc⟩:=ih H s t s1 t1 st gen
      have len : 3≤2^k := (by decide : 3≤2^2).trans (Nat.pow_le_pow_right (by decide) lo)
      exact ⟨k+j,by omega,compose (kernel_volume π onto H) cap weight,
        by rw [Nat.pow_add,Nat.mul_comm]; exact expand _ len cyc⟩
  have go (n : ℕ) : ∀ (K : Type) [Group K] [Finite K] [Group.IsSolvable K],
      Nat.card K=n → Odd (Nat.card K) → ∀ s t : K, s≠1 → t≠1 → s≠t →
      Subgroup.closure ({s,t} : Set K)=⊤ → Bounded s t := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro K _ _ _ card ho s t s1 t1 st genK
      by_cases ab : Commute s t
      · exact commuting_base s t ab s1 t1 st
      have step {Q : Type} [Group Q] [Nontrivial Q] (π : K →* Q) (onto : Function.Surjective π)
          {j : ℕ} (hj : 1≤j) (hi : j≤4) (T : Theta (rightMatching (π s) (π t)) (2^j)) :
          Bounded s t := by
        apply lift_bound ho π onto s t hj hi T
        intro H
        exact ih (Nat.card H) ((lt_of_le_of_lt
          (Nat.card_le_card_of_injective Subtype.val Subtype.val_injective)
          (kernel_smaller π onto)).trans_le card.le) H rfl
          (ho.of_dvd_nat (H.card_subgroup_dvd_card.trans π.ker.card_subgroup_dvd_card))
      have nc : commutator K≠⊥ := by
        intro triv
        exact ab (((commutator_eq_bot_iff K).mp triv).is_comm.comm s t)
      let N := derivedSeries K 2
      let f := QuotientGroup.mk' N
      obtain ⟨abM,gm,_,_,_,comm⟩:=metabelian_marking s t genK nc
      have oddM:=ho.of_dvd_nat N.card_quotient_dvd_card
      by_cases cm : IsCyclic (Abelianization (K ⧸ N))
      · obtain ⟨Q,_,_,π,onto,j,hj,hi,T⟩:=geom (K ⧸ N) oddM abM cm _ _ gm comm
        exact step (π.comp f) (onto.comp (QuotientGroup.mk'_surjective N)) hj hi T
      · obtain ⟨p,prime,op,π,onto,fa,fb⟩:=
          marked_abelianization oddM (f s) (f t) gm cm
        have low:=prime.two_le
        have lb : 3≤p := by obtain ⟨l,hl⟩:=op; omega
        let _ : Fact p.Prime := ⟨prime⟩
        obtain ⟨j,hj,hi,T⟩:=prime_plane op lb
        apply step (π.comp f) (onto.comp (QuotientGroup.mk'_surjective N)) hj hi
        simpa only [MonoidHom.comp_apply,fa,fb] using T
  obtain ⟨e,lo,cap,cycle⟩ := go (Nat.card A) A rfl oddA a₀ b₀ a₁ b₁ ab₀ gen₀
  exact ⟨e,lo,cap,cycle.trans (right_to_left _ _)⟩

