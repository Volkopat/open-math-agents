import OMAReductions.R_Erdos64_erdos_64_R1_H1_R1_H1_R1_H2_R2_H1_R1
import Mathlib

/-!
# Equal dyadic paths and solvability in the regular matching problem

For a finite odd solvable group generated by two noncommuting marks, their
images generate a nonabelian metabelian quotient by the second derived
subgroup. A noncyclic abelianization has a marked prime-plane quotient
with a short equal-arm theta. H1 supplies the cyclic-abelianization case.
The three path transports either close a cycle or give two generators in a
strictly smaller odd solvable subgroup of the quotient kernel. The
induction embeds a simple power-of-two cycle in the original graph.

H2 is the simple-group form of the Feit–Thompson odd-order theorem.
The proof below passes from simple groups to solvable groups by induction
through a proper normal subgroup and its quotient.

JamesSlash’s cubic reduction and PRs #5246, #5820, #7828 and #9593 supplied
the matching framework. PR #12281 settled the abelian voltage step. Halldon’s note 48826 gave equal-arm descent and
the prime-plane approach. The team developed the marked abelianization
quotient, the finite plane patterns, the cyclic geometry and the solvable
induction. Feit and Thompson proved the odd-order theorem in Pacific Journal
of Mathematics 13 (1963), 775–1029. Codex, gpt-6.2-astra.
-/

namespace OMA.R_Erdos64_erdos_64_R1_H1_R1_H1_R1_H2_R2_H1_R1_H2_R2
open SimpleGraph

/-- A finite odd nonabelian metabelian marking with cyclic abelianization has
a nontrivial quotient with three internally disjoint arms of the same dyadic
length, between two and sixteen edges. -/
def H1 : Prop :=
  ∀ (M : Type) [Group M] [Finite M], Odd (Nat.card M) →
    IsMulCommutative (commutator M) → IsCyclic (Abelianization M) →
    ∀ a b : M, Subgroup.closure ({a,b} : Set M)=⊤ → ¬ Commute a b →
    ∃ (Q : Type) (_ : Group Q) (_ : Nontrivial Q) (π : M →* Q), Function.Surjective π ∧
      ∃ j : ℕ, 1≤j ∧ j≤4 ∧
        ∃ (s t : Bool × Q) (p : Fin 3 → ℕ → Bool × Q), s≠t ∧
          (∀ c,p c 0=s) ∧ (∀ c,p c (2^j)=t) ∧
          (∀ c i,i<2^j → (SimpleGraph.fromRel (fun u v : Bool × Q =>
            u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*π a ∨ v.2=u.2*π b))).Adj (p c i) (p c (i+1))) ∧
          (∀ c i,0 < i → i<2^j → p c i≠s ∧ p c i≠t) ∧
          (∀ c e i k,0 < i → i<2^j → 0 < k → k<2^j → p c i=p e k → c=e ∧ i=k)

/-- The simple-group form of the odd-order theorem of Feit and Thompson. -/
def H2 : Prop :=
  ∀ (S : Type) [Group S] [Finite S] [IsSimpleGroup S], Odd (Nat.card S) →
    ∀ a b : S, a * b = b * a

section RegularMatching

private theorem adj_mod {n : ℕ} (hn : 2≤n) (i j : Fin n) :
    (cycleGraph n).Adj i j ↔ j.val = (i.val+1)%n ∨ i.val = (j.val+1)%n := by
  obtain ⟨m,rfl⟩ : ∃ m,n=m+2 := ⟨n-2,by omega⟩
  rw [cycleGraph_adj,sub_eq_iff_eq_add,sub_eq_iff_eq_add]
  simp only [Fin.ext_iff,Fin.val_add,Fin.val_one,add_comm 1]
  tauto

private theorem cycle_from_period {V : Type*} (G : SimpleGraph V) (m : ℕ) (hm : 2 ≤ m)
    (p : ℕ → V) (stepEdge : ∀ k,G.Adj (p k) (p (k+1))) (last : p m=p 0)
    (distinct : ∀ i j, i < m → j < m → p i=p j → i=j) : cycleGraph m ⊑ G := by
  have along (i j : Fin m) (h : j.val=(i.val+1)%m) : G.Adj (p i.val) (p j.val) := by
    rw [h]
    by_cases hk : i.val+1 < m
    · rw [Nat.mod_eq_of_lt hk]; exact stepEdge _
    · have eq : i.val+1=m := by omega
      rw [eq,Nat.mod_self,←last,←congrArg p eq]; exact stepEdge _
  exact ⟨⟨⟨fun i => p i.val,fun {i j} h =>
    ((adj_mod hm i j).mp h).elim (along i j) (fun k => (along j i k).symm)⟩,
    fun i j h => Fin.ext (distinct i j i.isLt j.isLt h)⟩⟩

set_option maxHeartbeats 2500000 in
/-- Halldon's equal-arm descent. The three transports determine the same
subgroup before any cycle in that subgroup is chosen. -/
private theorem quotient_lengths {A F : Type} [Group A] [Group F]
    (π₀ : A →* F) (a₀ b₀ : A) (onto₀ : Function.Surjective π₀) {n₀ : ℕ} (pos₀ : 0 < n₀)
    (certificate : ∃ (s t : Bool × F) (p : Fin 3 → ℕ → Bool × F), s≠t ∧
      (∀ c,p c 0=s) ∧ (∀ c,p c (n₀)=t) ∧
      (∀ c i,i<n₀ → (SimpleGraph.fromRel (fun u v : Bool × F => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*(π₀ a₀) ∨ v.2=u.2*(π₀ b₀)))).Adj (p c i) (p c (i+1))) ∧
      (∀ c i,0 < i → i<n₀ → p c i≠s ∧ p c i≠t) ∧
      (∀ c e i k,0 < i → i<n₀ → 0 < k → k<n₀ → p c i=p e k → c=e ∧ i=k)) :
    cycleGraph (2*n₀) ⊑ (SimpleGraph.fromRel (fun u v : Bool × A => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*a₀ ∨ v.2=u.2*b₀))) ∨
    ∃ (H : Subgroup π₀.ker) (s t : H),s≠1 ∧ t≠1 ∧ s≠t ∧
      Subgroup.closure ({s,t} : Set H)=⊤ ∧ ∀ n : ℕ,3≤n → cycleGraph n ⊑ (SimpleGraph.fromRel (fun u v : Bool × H => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*s ∨ v.2=u.2*t))) →
        cycleGraph (n₀*n) ⊑ (SimpleGraph.fromRel (fun u v : Bool × A => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*a₀ ∨ v.2=u.2*b₀))) := by
  classical
  let rightMatching {K : Type} [Group K] (s t : K) : SimpleGraph (Bool × K) :=
    SimpleGraph.fromRel fun u v => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*s ∨ v.2=u.2*t)
  have rightMatching_adj {K : Type} [Group K] (a b x y : K) :
      (rightMatching a b).Adj (false,x) (true,y) ↔ y=x ∨ y=x*a ∨ y=x*b := by
    simp [rightMatching,SimpleGraph.fromRel_adj]
  let shift {G : Type} [Group G] (t : G) (u : Bool × G) : Bool × G := (u.1,t*u.2)
  let project {G Q : Type} [Group G] [Group Q] (π : G →* Q) (u : Bool × G) : Bool × Q := (u.1,π u.2)
  have shift_adj {G : Type} [Group G] (a b t : G) {u v : Bool × G} (h : (rightMatching a b).Adj u v) :
      (rightMatching a b).Adj (shift t u) (shift t v) := by
    have forward (x y : G) (f : (rightMatching a b).Adj (false,x) (true,y)) :
        (rightMatching a b).Adj (false,t*x) (true,t*y) := by
      rw [rightMatching_adj] at f ⊢
      rcases f with eq | eq | eq
      · exact .inl (congrArg (t*·) eq)
      · exact .inr (.inl (by simp only [eq,mul_assoc]))
      · exact .inr (.inr (by simp only [eq,mul_assoc]))
    obtain ⟨s,x⟩ := u
    obtain ⟨r,y⟩ := v
    cases s <;> cases r
    · simp [rightMatching,SimpleGraph.fromRel_adj] at h
    · exact forward x y h
    · exact (forward y x h.symm).symm
    · simp [rightMatching,SimpleGraph.fromRel_adj] at h
  have shift_shift {G : Type} [Group G] (u v : G) (p : Bool × G) : shift u (shift v p)=shift (u*v) p := by
    simp [shift,mul_assoc]
  let index (n : ℕ) (hn : 0 < n) (k : ℕ) : Fin n := ⟨k%n,Nat.mod_lt _ hn⟩
  let next {n : ℕ} (hn : 0 < n) (i : Fin n) := index n hn (i.val+1)
  have next_index {n : ℕ} (hn : 0 < n) (k : ℕ) :
      next hn (index n hn k)=index n hn (k+1) := Fin.ext (Nat.mod_add_mod k n 1)
  have blocks {V : Type} (G : SimpleGraph V) {d n : ℕ} (hd : 0 < d) (hn : 2≤n)
      (p : Fin n → ℕ → V) (step : ∀ i k,k<d → G.Adj (p i k) (p i (k+1)))
      (link : ∀ i,p i d=p (next (by omega) i) 0)
      (unique : ∀ i j k t,k<d → t<d → p i k=p j t → i=j ∧ k=t) :
      cycleGraph (n*d) ⊑ G := by
    let hn' : 0 < n := by omega
    let f (k : ℕ) := p (index n hn' (k/d)) (k%d)
    have atBlock (q r : ℕ) (hr : r<d) : f (d*q+r)=p (index n hn' q) r := by
      simp only [f,Nat.mul_add_div hd,Nat.div_eq_of_lt hr,add_zero,Nat.mul_add_mod,Nat.mod_eq_of_lt hr]
    apply cycle_from_period G (n*d) (by nlinarith) f
    · intro k
      let q := k/d
      let r := k%d
      have hr : r<d := Nat.mod_lt _ hd
      have rep : d*q+r=k := Nat.div_add_mod _ _
      change G.Adj (p (index n hn' q) r) (f (k+1))
      have edge := step (index n hn' q) r hr
      by_cases inside : r+1<d
      · rw [show k+1=d*q+(r+1) by omega,atBlock _ _ inside]
        exact edge
      · have last : r+1=d := by omega
        have eq : k+1=d*(q+1)+0 := by rw [Nat.mul_add]; omega
        rw [eq,atBlock _ _ hd,← next_index hn' q,← link,← last]
        exact edge
    · simp [f,index,Nat.mul_div_cancel _ hd]
    · intro i j hi hj eq
      obtain ⟨hb,hr⟩ := unique _ _ _ _ (Nat.mod_lt i hd) (Nat.mod_lt j hd) eq
      have hq : i/d=j/d := by
        simpa only [index,Nat.mod_eq_of_lt ((Nat.div_lt_iff_lt_mul hd).mpr hi),
          Nat.mod_eq_of_lt ((Nat.div_lt_iff_lt_mul hd).mpr hj)] using congrArg Fin.val hb
      exact (Nat.div_add_mod i d).symm.trans
        ((congrArg₂ (fun q r => d*q+r) hq hr).trans (Nat.div_add_mod j d))
  let Subdivision {X E V : Type} (B : SimpleGraph V) (d : ℕ) (l r : E → X) : Prop :=
    ∃ (vertex : X ↪ V) (arm : E → ℕ → V),
      (∀ e,arm e 0=vertex (l e)) ∧ (∀ e,arm e d=vertex (r e)) ∧
      (∀ e i,i<d → B.Adj (arm e i) (arm e (i+1))) ∧
      (∀ e i,0 < i → i<d → ∀ x,arm e i≠vertex x) ∧
      (∀ e f i j,0 < i → i<d → 0 < j → j<d → arm e i=arm f j → e=f ∧ i=j)
  have polygon {X E V : Type} {G : SimpleGraph V} {d : ℕ} {l r : E → X} (S : Subdivision G d l r) (hd : 0 < d) {n : ℕ} (hn : 2≤n)
      (v : Fin n → X) (vi : Function.Injective v) (z : Fin n → E) (zi : Function.Injective z)
      (covers : ∀ i,(v i=l (z i) ∧ v (next (by omega) i)=r (z i)) ∨
        (v i=r (z i) ∧ v (next (by omega) i)=l (z i))) :
      cycleGraph (n*d) ⊑ G := by
    obtain ⟨subvertex,subarm,subhead,sublast,substep,subavoid,subdistinct⟩ := S
    classical
    let dir (i : Fin n) := decide (v i=l (z i) ∧ v (next (by omega) i)=r (z i))
    let atPos (i : Fin n) (k : ℕ) := if dir i then k else d-k
    let p (i : Fin n) (k : ℕ) := subarm (z i) (atPos i k)
    have ends (i : Fin n) : p i 0=subvertex (v i) ∧ p i d=subvertex (v (next (by omega) i)) := by
      by_cases h : v i=l (z i) ∧ v (next (by omega) i)=r (z i)
      · have e : dir i=true := decide_eq_true h
        simp [p,atPos,e,subhead,sublast,h.1,h.2]
      · have e : dir i=false := decide_eq_false h
        obtain ⟨a,b⟩ := (covers i).resolve_left h
        simp [p,atPos,e,subhead,sublast,a,b]
    refine blocks G hd hn p ?_ ?_ ?_
    · intro i k hk
      by_cases h : dir i=true
      · simpa only [p,atPos,h,if_true] using substep (z i) k hk
      · have edge := (substep (z i) (d-(k+1)) (by omega)).symm
        rw [show d-(k+1)+1=d-k by omega] at edge
        simpa only [p,atPos,if_neg h] using edge
    · intro i
      exact (ends i).2.trans (ends _).1.symm
    · intro i j k t hk ht eq
      have interior (i : Fin n) {j : ℕ} (pos : 0 < j) (lt : j<d) : 0 < atPos i j ∧ atPos i j<d := by
        dsimp [atPos]
        split <;> omega
      by_cases k0 : k=0 <;> by_cases t0 : t=0
      · subst k; subst t
        rw [(ends i).1,(ends j).1] at eq
        exact ⟨vi (subvertex.injective eq),rfl⟩
      · subst k
        rw [(ends i).1] at eq
        obtain ⟨lo,hi⟩ := interior j (by omega : 0 < t) ht
        exact (subavoid (z j) (atPos j t) lo hi (v i) eq.symm).elim
      · subst t
        rw [(ends j).1] at eq
        obtain ⟨lo,hi⟩ := interior i (by omega : 0 < k) hk
        exact (subavoid (z i) (atPos i k) lo hi (v j) eq).elim
      · obtain ⟨a,b⟩ := interior i (by omega : 0 < k) hk
        obtain ⟨c,e⟩ := interior j (by omega : 0 < t) ht
        obtain ⟨edge,offset⟩ := subdistinct (z i) (z j) _ _ a b c e eq
        obtain rfl := zi edge
        refine ⟨rfl,?_⟩
        dsimp only [atPos] at offset
        split at offset <;> omega
  have cycle {X E V : Type} {G : SimpleGraph V} {d : ℕ} {l r : E → X} (S : Subdivision G d l r) (hd : 0 < d) (B : SimpleGraph X)
      (covers : ∀ x y,B.Adj x y → ∃ z,(x=l z ∧ y=r z) ∨ (x=r z ∧ y=l z))
      {n : ℕ} (hn : 3≤n) (cycle : cycleGraph n ⊑ B) : cycleGraph (n*d) ⊑ G := by
    classical
    obtain ⟨f⟩ := cycle
    let nx := next (show 0 < n by omega)
    have edges (i : Fin n) := covers (f i) (f (nx i))
      (f.toHom.map_adj ((adj_mod (by omega) i (nx i)).mpr (.inl rfl)))
    choose z hz using edges
    have inc (i : Fin n) : (nx i).val=i.val+1 ∨ (nx i).val=0 ∧ i.val+1=n := by
      by_cases hi : i.val+1<n
      · exact .inl (Nat.mod_eq_of_lt hi)
      · have h : i.val+1=n := by omega
        exact .inr ⟨by simp [nx,next,index,h],h⟩
    have notflip (i : Fin n) : nx (nx i) ≠ i := by
      intro eq
      have ev := congrArg Fin.val eq
      rcases inc i with h|h <;> rcases inc (nx i) with t|t <;> omega
    apply polygon S hd (by omega : 2≤n) f f.injective z _ hz
    intro i j eq
    have x := hz i
    have y := hz j
    rw [eq] at x
    have alt : f i=f j ∨ (f (nx i)=f j ∧ f (nx j)=f i) := by
      rcases x with x|x <;> rcases y with y|y
      · exact .inl (x.1.trans y.1.symm)
      · exact .inr ⟨x.2.trans y.1.symm,y.2.trans x.1.symm⟩
      · exact .inr ⟨x.2.trans y.1.symm,y.2.trans x.1.symm⟩
      · exact .inl (x.1.trans y.1.symm)
    rcases alt with same|⟨sj,si⟩
    · exact f.injective same
    · have e1 := f.injective sj
      have e2 := f.injective si
      exact (notflip i ((congrArg nx e1).trans e2)).elim
  have parallel {X E V : Type} {G : SimpleGraph V} {d : ℕ} {l r : E → X} (S : Subdivision G d l r) (hd : 0 < d) {e f : E}
      (ne : e≠f) (left : l e=l f) (right : r e=r f) (ends : l e≠r e) :
      cycleGraph (2*d) ⊑ G := by
    let v : Fin 2 → X := ![l e,r e]
    let z : Fin 2 → E := ![e,f]
    apply polygon S hd (by decide : 2≤2) v _ z _
    · intro i
      fin_cases i
      · exact .inl ⟨rfl,rfl⟩
      · exact .inr ⟨right,left⟩
    · intro i j eq
      fin_cases i <;> fin_cases j <;> first | rfl | exact (ends eq).elim | exact (ends eq.symm).elim
    · intro i j eq
      fin_cases i <;> fin_cases j <;> first | rfl | exact (ne eq).elim | exact (ne eq.symm).elim
  let leftEnd {K : Type} (e : K × Fin 3) : Bool × K := (false,e.1)
  let rightEnd {K : Type} [Group K] (D : Fin 3 → K) (e : K × Fin 3) : Bool × K := (true,e.1*D e.2)
  have cover {K : Type} [Group K] {a b : K} (D : Fin 3 → K) (zero : D 0=1) (one : D 1=a) (two : D 2=b)
      (u v : Bool × K) (h : (rightMatching a b).Adj u v) :
      ∃ e,(u=leftEnd e ∧ v=rightEnd D e) ∨ (u=rightEnd D e ∧ v=leftEnd e) := by
    have forward (x y : K) (adj : (rightMatching a b).Adj (false,x) (true,y)) :
        ∃ i : Fin 3,y=x*D i := by
      rcases (rightMatching_adj _ _ _ _).mp adj with e|e|e
      · exact ⟨0,by simpa only [zero,mul_one] using e⟩
      · exact ⟨1,one.symm ▸ e⟩
      · exact ⟨2,two.symm ▸ e⟩
    obtain ⟨s,x⟩ := u; obtain ⟨t,y⟩ := v
    cases s <;> cases t
    · simp [rightMatching,SimpleGraph.fromRel_adj] at h
    · obtain ⟨i,eq⟩ := forward x y h
      exact ⟨(x,i),.inl ⟨rfl,Prod.ext rfl eq⟩⟩
    · obtain ⟨i,eq⟩ := forward y x h.symm
      exact ⟨(y,i),.inr ⟨Prod.ext rfl eq,rfl⟩⟩
    · simp [rightMatching,SimpleGraph.fromRel_adj] at h
  have subgroup_incl {K : Type} [Group K] (H : Subgroup K) (a b : H) :
      rightMatching a b ⊑ rightMatching a.val b.val := by
    let inc (v : Bool × H) : Bool × K := (v.1,v.2.val)
    have forward (x y : H) (adj : (rightMatching a b).Adj (false,x) (true,y)) :
        (rightMatching a.val b.val).Adj (false,x.val) (true,y.val) := by
      rw [rightMatching_adj] at adj ⊢
      rcases adj with e|e|e
      · exact .inl (congrArg Subtype.val e)
      · exact .inr (.inl (congrArg Subtype.val e))
      · exact .inr (.inr (congrArg Subtype.val e))
    refine ⟨⟨⟨inc,?_⟩,?_⟩⟩
    · intro ⟨s,x⟩ ⟨t,y⟩ h
      cases s <;> cases t
      · simp [rightMatching,SimpleGraph.fromRel_adj] at h
      · exact forward x y h
      · exact (forward y x h.symm).symm
      · simp [rightMatching,SimpleGraph.fromRel_adj] at h
    · intro x y eq
      exact Prod.ext (congrArg (fun v : Bool × K => v.1) eq)
        (Subtype.ext (congrArg (fun v : Bool × K => v.2) eq))
  let Lengths (K : Type) [Group K] {V : Type} (B : SimpleGraph V) (d : ℕ) : Prop :=
    cycleGraph (2*d) ⊑ B ∨ ∃ (H : Subgroup K) (a b : H),
      a≠1 ∧ b≠1 ∧ a≠b ∧ Subgroup.closure ({a,b} : Set H)=⊤ ∧
      ∀ n : ℕ,3≤n → cycleGraph n ⊑ rightMatching a b → cycleGraph (d*n) ⊑ B
  have subdivision_lengths {K : Type} [Group K] {V : Type} (B : SimpleGraph V) {d : ℕ} (hd : 0 < d) (D : Fin 3 → K)
      (zero : D 0=1) (S : Subdivision B d leftEnd (rightEnd D)) : Lengths K B d := by
    classical
    by_cases di : Function.Injective D
    · let H := Subgroup.closure ({D 1,D 2} : Set K)
      let a : H := ⟨D 1,Subgroup.subset_closure (by simp)⟩
      let b : H := ⟨D 2,Subgroup.subset_closure (by simp)⟩
      have a1 : a≠1 := fun h => (by decide : (1:Fin 3)≠0) (di ((congrArg Subtype.val h).trans zero.symm))
      have b1 : b≠1 := fun h => (by decide : (2:Fin 3)≠0) (di ((congrArg Subtype.val h).trans zero.symm))
      have ab : a≠b := fun h => (by decide : (1:Fin 3)≠2) (di (congrArg Subtype.val h))
      have pair : H.subtype ⁻¹' ({D 1,D 2} : Set K)=({a,b} : Set H) := by
        ext z
        change (z.val=D 1 ∨ z.val=D 2) ↔ z=a ∨ z=b
        exact or_congr (show z.val=a.val ↔ z=a from Subtype.ext_iff.symm)
          (show z.val=b.val ↔ z=b from Subtype.ext_iff.symm)
      have gen := Subgroup.closure_preimage_eq_top ({D 1,D 2} : Set K)
      rw [show (Subgroup.closure ({D 1,D 2} : Set K)).subtype ⁻¹' ({D 1,D 2} : Set K)=
        ({a,b} : Set H) from pair] at gen
      refine .inr ⟨H,a,b,a1,b1,ab,gen,?_⟩
      intro n hn cyc
      rw [Nat.mul_comm d n]
      exact cycle S hd (rightMatching (D 1) (D 2)) (cover D zero rfl rfl) hn
        (cyc.trans (subgroup_incl H a b))
    · obtain ⟨c,e,same,ne⟩ := Function.not_injective_iff.mp di
      let p : K × Fin 3 := (1,c)
      let q : K × Fin 3 := (1,e)
      have edge : p≠q := fun h => ne (congrArg Prod.snd h)
      have right : rightEnd D p=rightEnd D q := by simp [p,q,rightEnd,same]
      have cyc := parallel S hd edge (show leftEnd p=leftEnd q by rfl) right
        (show leftEnd p≠rightEnd D p from fun h => Bool.false_ne_true (congrArg Prod.fst h))
      exact .inl cyc
  have project_shift {G Q : Type} [Group G] [Group Q] (π : G →* Q) (t : π.ker) (v : Bool × G) :
      project π (shift t.val v)=project π v := by simp [project,shift,show π t.val=1 from t.property]
  have color {G Q : Type} [Group G] [Group Q] (π : G →* Q) (a b : G) (x y : Q)
      (h : (rightMatching (π a) (π b)).Adj (false,x) (true,y)) :
      ∃ d : G, y=x*π d ∧ ∀ z : G,(rightMatching a b).Adj (false,z) (true,z*d) := by
    rcases (rightMatching_adj _ _ _ _).mp h with eq | eq | eq
    · exact ⟨1,by simpa only [map_one,mul_one] using eq,fun z =>
        (rightMatching_adj _ _ _ _).mpr (Or.inl (mul_one z))⟩
    · exact ⟨a,eq,fun _ => (rightMatching_adj _ _ _ _).mpr (Or.inr (Or.inl rfl))⟩
    · exact ⟨b,eq,fun _ => (rightMatching_adj _ _ _ _).mpr (Or.inr (Or.inr rfl))⟩
  have step {G Q : Type} [Group G] [Group Q] (π : G →* Q) (a b : G) {u v : Bool × Q}
      (h : (rightMatching (π a) (π b)).Adj u v) :
      ∃ d : G, v.2=u.2*π d ∧ ∀ z : G,(rightMatching a b).Adj (u.1,z) (v.1,z*d) := by
    obtain ⟨s,x⟩ := u
    obtain ⟨t,y⟩ := v
    cases s <;> cases t
    · simp [rightMatching,SimpleGraph.fromRel_adj] at h
    · exact color π a b x y h
    · obtain ⟨d,eq,adj⟩ := color π a b y x h.symm
      refine ⟨d⁻¹,?_,fun z => ?_⟩
      · change y=x*π d⁻¹
        simp only [map_inv,eq,mul_inv_cancel_right]
      · exact (by simpa only [inv_mul_cancel_right] using (adj (z*d⁻¹)).symm)
    · simp [rightMatching,SimpleGraph.fromRel_adj] at h
  obtain ⟨src,dst,arm,ends,head,last,steps,avoid,distinct⟩ := certificate
  have paths : ∃ path : Fin 3 → ℕ → Bool × A,(∀ c,path c 0=path 0 0) ∧
        (∀ c i,i≤n₀ → project π₀ (path c i)=arm c i) ∧
        ∀ c i,i<n₀ → (rightMatching a₀ b₀).Adj (path c i) (path c (i+1)) := by
    classical
    obtain ⟨x,hx⟩ := onto₀ src.2
    have move (c : Fin 3) (i : ℕ) (hi : i<n₀) := step π₀ a₀ b₀ (steps c i hi)
    let delta (c : Fin 3) (i : ℕ) := if h : i<n₀ then (move c i h).choose else 1
    have ok (c : Fin 3) (i : ℕ) (hi : i<n₀) :
        (arm c (i+1)).2=(arm c i).2*π₀ (delta c i) ∧
        ∀ g : A,(rightMatching a₀ b₀).Adj ((arm c i).1,g) ((arm c (i+1)).1,g*delta c i) := by
      simpa only [delta,dif_pos hi] using (move c i hi).choose_spec
    let pos (c : Fin 3) : ℕ → A := Nat.rec x (fun i old => old*delta c i)
    let path (c : Fin 3) (i : ℕ) : Bool × A := ((arm c i).1,pos c i)
    have proj (c : Fin 3) (i : ℕ) (hi : i≤n₀) : π₀ (pos c i)=(arm c i).2 := by
      induction i with
      | zero => exact hx.trans (congrArg Prod.snd (head c).symm)
      | succ i ih =>
        change π₀ (pos c i * delta c i)=(arm c (i+1)).2
        rw [map_mul,ih (by omega),(ok c i (by omega)).1]
    refine ⟨path,?_,?_,?_⟩
    · intro c
      exact Prod.ext (congrArg (fun v : Bool × F => v.1) ((head c).trans (head 0).symm)) rfl
    · intro c i hi
      exact Prod.ext rfl (proj c i hi)
    · intro c i hi
      exact (ok c i hi).2 _
  obtain ⟨u,root,pr,edge⟩ := paths
  have subdivision : ∃ D : Fin 3 → π₀.ker,D 0=1 ∧ Nonempty (Subdivision (rightMatching a₀ b₀) n₀ leftEnd (rightEnd D)) := by
    let x := u 0 0
    let y := u 0 n₀
    have px : project π₀ x=src := (pr 0 0 (Nat.zero_le _)).trans (head 0)
    have py : project π₀ y=dst := (pr 0 n₀ le_rfl).trans (last 0)
    have pend (c : Fin 3) : project π₀ (u c n₀)=project π₀ y :=
      ((pr c n₀ le_rfl).trans (last c)).trans py.symm
    let D (c : Fin 3) : π₀.ker := ⟨(u c n₀).2*y.2⁻¹,by
      change π₀ ((u c n₀).2*y.2⁻¹)=1
      have same : π₀ (u c n₀).2=π₀ y.2 := congrArg Prod.snd (pend c)
      rw [map_mul,map_inv,same,mul_inv_cancel]⟩
    have D0 : D 0=1 := Subtype.ext (mul_inv_cancel y.2)
    have transportLast (c : Fin 3) : u c n₀=shift (D c).val y := by
      exact Prod.ext (congrArg (fun p : Bool × F => p.1) (pend c))
        (inv_mul_cancel_right (u c n₀).2 y.2).symm
    let w (s : Bool) := if s then y else x
    let v (t : Bool × π₀.ker) := shift t.2.val (w t.1)
    have projV (t : Bool × π₀.ker) : project π₀ (v t)=if t.1 then dst else src := by
      rw [show v t=shift t.2.val (w t.1) from rfl,project_shift]
      cases t.1 <;> simp [w,px,py]
    have injV : Function.Injective v := by
      intro ⟨s,g⟩ ⟨t,h⟩ eq
      have proj := congrArg (project π₀) eq
      rw [projV,projV] at proj
      have st : s=t := by
        cases s <;> cases t <;> first | rfl | exact (ends proj).elim | exact (ends proj.symm).elim
      subst t
      have same : g.val*(w s).2=h.val*(w s).2 := congrArg (fun p : Bool × A => p.2) eq
      exact Prod.ext rfl (Subtype.ext (mul_right_cancel same))
    let route (e : π₀.ker × Fin 3) (i : ℕ) := shift e.1.val (u e.2 i)
    have prRoute (e : π₀.ker × Fin 3) (i : ℕ) (hi : i≤n₀) :
        project π₀ (route e i)=arm e.2 i := (project_shift π₀ e.1 _).trans (pr e.2 i hi)
    refine ⟨D,D0,⟨?_⟩⟩
    refine ⟨⟨v,injV⟩,route,?_,?_,?_,?_,?_⟩
    · intro e
      change shift e.1.val (u e.2 0)=shift e.1.val x
      rw [root]
    · intro e
      change shift e.1.val (u e.2 n₀)=shift (e.1.val*(D e.2).val) y
      rw [transportLast,shift_shift]
    · intro e i hi
      exact shift_adj a₀ b₀ e.1.val (edge e.2 i hi)
    · intro e i lo hi t eq
      have same := congrArg (project π₀) eq
      change project π₀ (route e i)=project π₀ (v t) at same
      rw [prRoute e i (by omega),projV] at same
      obtain ⟨noSrc,noDst⟩ := avoid e.2 i lo hi
      cases h : t.1
      · rw [h] at same; exact noSrc same
      · rw [h] at same; exact noDst same
    · intro ⟨g,c⟩ ⟨h,e⟩ i k lo hi low high eq
      have same := congrArg (project π₀) eq
      rw [prRoute _ _ (by omega),prRoute _ _ (by omega)] at same
      obtain ⟨rfl,rfl⟩ := distinct c e i k lo hi low high same
      have pos : g.val*(u c i).2=h.val*(u c i).2 := congrArg (fun v : Bool × A => v.2) eq
      exact ⟨Prod.ext (Subtype.ext (mul_right_cancel pos)) rfl,rfl⟩
  obtain ⟨D,D0,⟨sub⟩⟩ := subdivision
  exact subdivision_lengths _ pos₀ D D0 sub

private theorem commute_of_generating_pair {M : Type*} [Group M] (a b : M)
    (gen : Subgroup.closure ({a,b} : Set M)=⊤) (comm : Commute a b) : IsMulCommutative M := by
  have pairs (x) (hx : x ∈ ({a,b} : Set M)) (y) (hy : y ∈ ({a,b} : Set M)) : x*y=y*x := by
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx hy
    rcases hx with rfl|rfl <;> rcases hy with rfl|rfl <;> first | rfl | exact comm.eq | exact comm.symm.eq
  have full := Subgroup.isMulCommutative_closure pairs
  rw [gen] at full
  exact IsMulCommutative.of_comm fun x y =>
    congrArg Subtype.val (full.is_comm.comm (⟨x,trivial⟩ : (⊤ : Subgroup M)) ⟨y,trivial⟩)

private theorem metabelian_marking {G : Type*} [Group G] [Group.IsSolvable G] (a b : G)
    (gen : Subgroup.closure ({a,b} : Set G)=⊤) (nonabelian : commutator G≠⊥) :
    let M := G ⧸ derivedSeries G 2
    let π := QuotientGroup.mk' (derivedSeries G 2)
    IsMulCommutative (commutator M) ∧ Subgroup.closure ({π a,π b} : Set M)=⊤ ∧
      π a≠1 ∧ π b≠1 ∧ π a≠π b ∧ ¬ Commute (π a) (π b) := by
  dsimp only
  let N := derivedSeries G 2
  let π := QuotientGroup.mk' N
  have onto := QuotientGroup.mk'_surjective N
  have genq : Subgroup.closure ({π a,π b} : Set (G ⧸ N))=⊤ := by
    rw [← Set.image_pair,← MonoidHom.map_closure,gen,← MonoidHom.range_eq_map]
    exact π.range_eq_top_of_surjective onto
  have abelian : IsMulCommutative (commutator (G ⧸ N)) := by
    apply Subgroup.commutator_self_eq_bot_iff.mp
    change derivedSeries (G ⧸ N) 2=⊥
    rw [← map_derivedSeries_eq onto 2]
    exact (Subgroup.map_eq_bot_iff _).mpr (QuotientGroup.ker_mk' N).symm.le
  have nc : ¬ Commute (π a) (π b) := by
    intro same
    have ab := commute_of_generating_pair (π a) (π b) genq same
    have killed : (commutator G).map π=⊥ :=
      (map_derivedSeries_eq onto 1).trans ((commutator_eq_bot_iff _).mpr ab)
    have incl := (Subgroup.map_eq_bot_iff _).mp killed
    rw [show π.ker=N from QuotientGroup.ker_mk' N] at incl
    exact (Group.IsSolvable.commutator_lt_of_ne_bot nonabelian).not_ge incl
  exact ⟨abelian,genq,fun h => nc (h ▸ Commute.one_left _),
    fun h => nc (h ▸ Commute.one_right _),fun h => nc (h ▸ Commute.refl _),nc⟩

section PrimeQuotients
variable {A : Type*} [AddCommGroup A] [Finite A]

private theorem character (a b : A) (gen : AddSubgroup.closure ({a,b} : Set A)=⊤)
    {d p : ℕ} (area : Nat.card A=AddMonoid.exponent A*d) (pd : p∣d) :
    ∃ f : A →+ ZMod p,f a=0 ∧ f b=1 := by
  let H := AddSubgroup.zmultiples a
  let q := QuotientAddGroup.mk' H
  have aq : q a=0 := (QuotientAddGroup.eq_zero_iff a).mpr (AddSubgroup.mem_zmultiples a)
  have generated (y : A ⧸ H) : y ∈ AddSubgroup.zmultiples (q b) := by
    obtain ⟨x,rfl⟩ := QuotientAddGroup.mk'_surjective H y
    obtain ⟨i,j,rep⟩ := AddSubgroup.mem_closure_pair.mp (gen ▸ AddSubgroup.mem_top x)
    change i • a+j • b=x at rep
    rw [← rep,map_add,map_zsmul,map_zsmul,aq,zsmul_zero,zero_add]
    exact ⟨j,rfl⟩
  have card : addOrderOf a * Nat.card (A ⧸ H)=Nat.card A := by
    rw [← show Nat.card H=addOrderOf a from Nat.card_zmultiples a,← H.index_eq_card,H.card_mul_index]
  obtain ⟨u,hu⟩ := AddMonoid.addOrder_dvd_exponent a
  have height : Nat.card (A ⧸ H)=u*d :=
    Nat.eq_of_mul_eq_mul_left (addOrderOf_pos a) (by rw [card,area,hu,Nat.mul_assoc])
  have divides : p∣Nat.card (A ⧸ H) := height ▸ pd.trans (Nat.dvd_mul_left _ _)
  let z := zmodAddEquivOfGenerator generated (rfl : Nat.card (A ⧸ H)=Nat.card (A ⧸ H))
  let reduce := ZMod.castHom divides (ZMod p)
  let f := reduce.toAddMonoidHom.comp (z.symm.toAddMonoidHom.comp q)
  refine ⟨f,?_,?_⟩
  · change reduce (z.symm (q a))=0
    rw [aq,map_zero,map_zero]
  · change reduce (z.symm (q b))=1
    rw [show z.symm (q b)=1 from zmodAddEquivOfGenerator_symm_apply_generator _ _,map_one]

theorem marked_additive (a b : A) (gen : AddSubgroup.closure ({a,b} : Set A)=⊤)
    (nc : ¬IsAddCyclic A) :
    ∃ p : ℕ,p.Prime ∧ p∣Nat.card A ∧
      ∃ f : A →+ ZMod p × ZMod p,Function.Surjective f ∧ f a=(1,0) ∧ f b=(0,1) := by
  obtain ⟨d,area⟩ := (AddGroup.exponent_dvd_nat_card (G:=A))
  have d1 : d≠1 := by
    intro h
    exact nc (IsAddCyclic.of_exponent_eq_card (by simpa only [h,mul_one] using area.symm))
  obtain ⟨p,prime,pd⟩ := Nat.exists_prime_and_dvd d1
  obtain ⟨y,ya,yb⟩ := character a b gen area pd
  obtain ⟨x,xb,xa⟩ := character b a (by simpa only [Set.pair_comm b a] using gen) area pd
  let f := x.prod y
  have fa : f a=(1,0) := Prod.ext xa ya
  have fb : f b=(0,1) := Prod.ext xb yb
  refine ⟨p,prime,area ▸ pd.trans (Nat.dvd_mul_left _ _),f,?_,fa,fb⟩
  rintro ⟨v,w⟩
  obtain ⟨i,rfl⟩ := ZMod.intCast_surjective v
  obtain ⟨j,rfl⟩ := ZMod.intCast_surjective w
  refine ⟨i • a+j • b,?_⟩
  rw [map_add,map_zsmul,map_zsmul,fa,fb]
  ext <;> simp [zsmul_eq_mul]

theorem marked_commutative {H : Type*} [CommGroup H] [Finite H] (a b : H)
    (gen : Subgroup.closure ({a,b} : Set H)=⊤) (nc : ¬IsCyclic H) :
    ∃ p : ℕ,p.Prime ∧ p∣Nat.card H ∧
      ∃ f : H →* Multiplicative (ZMod p × ZMod p),Function.Surjective f ∧
        f a=Multiplicative.ofAdd (1,0) ∧ f b=Multiplicative.ofAdd (0,1) := by
  have agen : AddSubgroup.closure ({Additive.ofMul a,Additive.ofMul b} : Set (Additive H))=⊤ := by
    apply top_unique
    intro z _
    obtain ⟨i,j,rep⟩ := Subgroup.mem_closure_pair.mp (gen ▸ Subgroup.mem_top z.toMul)
    exact AddSubgroup.mem_closure_pair.mpr ⟨i,j,congrArg Additive.ofMul rep⟩
  obtain ⟨p,prime,div,f,sur,fa,fb⟩ := marked_additive _ _ agen
    (fun h => nc (isAddCyclic_additive_iff.mp h))
  exact ⟨p,prime,div,AddMonoidHom.toMultiplicativeRight f,sur,fa,fb⟩

theorem marked_abelianization {G : Type*} [Group G] [Finite G] (odd : Odd (Nat.card G))
    (a b : G) (gen : Subgroup.closure ({a,b} : Set G)=⊤) (nc : ¬IsCyclic (Abelianization G)) :
    ∃ p : ℕ,p.Prime ∧ Odd p ∧
      ∃ f : G →* Multiplicative (ZMod p × ZMod p),Function.Surjective f ∧
        f a=Multiplicative.ofAdd (1,0) ∧ f b=Multiplicative.ofAdd (0,1) := by
  let q : G →* Abelianization G := Abelianization.of
  have sq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have gen' : Subgroup.closure ({q a,q b} : Set (Abelianization G))=⊤ := by
    rw [← Set.image_pair,← MonoidHom.map_closure,gen,← MonoidHom.range_eq_map]
    exact q.range_eq_top_of_surjective sq
  obtain ⟨p,prime,div,f,sur,fa,fb⟩ := marked_commutative _ _ gen' nc
  have oddp := odd.of_dvd_nat (div.trans (commutator G).card_quotient_dvd_card)
  exact ⟨p,prime,oddp,f.comp q,sur.comp sq,fa,fb⟩

end PrimeQuotients

set_option synthInstance.maxSize 4096 in
set_option maxHeartbeats 12000000 in
set_option maxRecDepth 65536 in
/-- Explicit marked paths in every odd prime plane (in fact in all odd moduli ≥ 3). -/
private theorem prime_plane {n : ℕ} (odd : Odd n) (hn : 3≤n) :
    ∃ j : ℕ,1≤j ∧ j≤4 ∧ ∃ (s t : Bool × Multiplicative (ZMod n × ZMod n)) (p : Fin 3 → ℕ → Bool × Multiplicative (ZMod n × ZMod n)), s≠t ∧
      (∀ c,p c 0=s) ∧ (∀ c,p c (2^j)=t) ∧
      (∀ c i,i<2^j → (SimpleGraph.fromRel (fun u v : Bool × Multiplicative (ZMod n × ZMod n) => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*(Multiplicative.ofAdd (1,0)) ∨ v.2=u.2*(Multiplicative.ofAdd (0,1))))).Adj (p c i) (p c (i+1))) ∧
      (∀ c i,0 < i → i<2^j → p c i≠s ∧ p c i≠t) ∧
      (∀ c e i k,0 < i → i<2^j → 0 < k → k<2^j → p c i=p e k → c=e ∧ i=k) := by
  let rightMatching {K : Type} [Group K] (s t : K) : SimpleGraph (Bool × K) :=
    SimpleGraph.fromRel fun u v => u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*s ∨ v.2=u.2*t)
  have rightMatching_adj {K : Type} [Group K] (a b x y : K) :
      (rightMatching a b).Adj (false,x) (true,y) ↔ y=x ∨ y=x*a ∨ y=x*b := by
    simp [rightMatching,SimpleGraph.fromRel_adj]
  let Site := Bool × ℤ × ℤ
  let Plane (n : ℕ) := Multiplicative (ZMod n × ZMod n)
  let a (n : ℕ) : Plane n := Multiplicative.ofAdd (1,0)
  let b (n : ℕ) : Plane n := Multiplicative.ofAdd (0,1)
  let project (n : ℕ) (p : Site) : Bool × Plane n :=
    (p.1,Multiplicative.ofAdd ((p.2.1 : ZMod n),(p.2.2 : ZMod n)))
  let Table (d : ℕ) := Fin 3 → Fin (d+1) → Site
  let forward (p q : Site) : Prop := p.1=false ∧ q.1=true ∧
    (q.2=p.2 ∨ q.2=(p.2.1+1,p.2.2) ∨ q.2=(p.2.1,p.2.2+1))
  have fedge (n : ℕ) {p q : Site} (h : forward p q) :
      (rightMatching (a n) (b n)).Adj (project n p) (project n q) := by
    rcases p with ⟨ps,x,y⟩
    rcases q with ⟨qs,X,Y⟩
    obtain ⟨rfl,rfl,h⟩ := h
    apply (rightMatching_adj _ _ _ _).2
    rcases h with eq|eq|eq
    · obtain ⟨hx,hy⟩ := Prod.mk.inj eq
      subst X
      subst Y
      exact Or.inl rfl
    · obtain ⟨hx,hy⟩ := Prod.mk.inj eq
      subst X
      subst Y
      apply Or.inr ∘ Or.inl
      change Multiplicative.ofAdd ((↑(x+1):ZMod n),(↑y:ZMod n)) =
        Multiplicative.ofAdd ((↑x:ZMod n)+1,(↑y:ZMod n)+0)
      simp
    · obtain ⟨hx,hy⟩ := Prod.mk.inj eq
      subst X
      subst Y
      right; right
      change Multiplicative.ofAdd ((↑x:ZMod n),(↑(y+1):ZMod n)) =
        Multiplicative.ofAdd ((↑x:ZMod n)+0,(↑y:ZMod n)+1)
      simp
  let verify {d : ℕ} (n : ℕ) (P : Table d) : Prop :=
    let v := fun (c : Fin 3) (i : Fin (d+1)) => project n (P c i)
    (∀ c,v c 0=v 0 0 ∧ v c (Fin.last d)=v 0 (Fin.last d)) ∧
    v 0 0 ≠ v 0 (Fin.last d) ∧
    (∀ (c : Fin 3) (i : Fin d),forward (P c i.castSucc) (P c i.succ) ∨
      forward (P c i.succ) (P c i.castSucc)) ∧
    (∀ (c : Fin 3) (i : Fin (d+1)), 0 < i.val → i.val < d →
      v c i≠v 0 0 ∧ v c i≠v 0 (Fin.last d)) ∧
    (∀ (c e : Fin 3) (i j : Fin (d+1)), 0 < i.val → i.val < d → 0 < j.val → j.val < d →
      v c i=v e j → c=e ∧ i=j)
  let bounded {d : ℕ} (P : Table d) : Prop :=
    ∀ c e i j, (P c i).1=(P e j).1 →
      ((P c i).2.1-(P e j).2.1).natAbs≤5 ∧ ((P c i).2.2-(P e j).2.2).natAbs≤5
  have large {d n : ℕ} (hn : 5<n) {P : Table d} (hb : bounded P) (h : verify 0 P) :
      verify n P := by
    have sample (c e : Fin 3) (i j : Fin (d+1)) : project n (P c i)=project n (P e j) ↔
        project 0 (P c i)=project 0 (P e j) := by
      let p := P c i
      let q := P e j
      have coord (x y : ℤ) (bound : (x-y).natAbs≤5) :
          (x:ZMod n)=(y:ZMod n) ↔ x=y := by
        constructor
        · intro eq
          have dv:=(ZMod.intCast_eq_intCast_iff_dvd_sub _ _ _).mp eq.symm
          have z:=Int.eq_zero_of_dvd_of_natAbs_lt_natAbs dv (show (x-y).natAbs < (n:ℤ).natAbs by simpa using lt_of_le_of_lt bound hn)
          omega
        · rintro rfl; rfl
      have parts (k : ℕ) : project k (P c i)=project k (P e j) ↔
          p.1=q.1 ∧ (p.2.1:ZMod k)=(q.2.1:ZMod k) ∧ (p.2.2:ZMod k)=(q.2.2:ZMod k) := by
        change (p.1,((p.2.1:ZMod k),(p.2.2:ZMod k)))=(q.1,((q.2.1:ZMod k),(q.2.2:ZMod k))) ↔ _
        simp only [Prod.mk.injEq]
      rw [parts,parts]
      by_cases hs : p.1=q.1
      · obtain ⟨hx,hy⟩:=hb c e i j hs
        change (p.2.1-q.2.1).natAbs≤5 at hx
        change (p.2.2-q.2.2).natAbs≤5 at hy
        rw [coord p.2.1 q.2.1 hx,coord p.2.2 q.2.2 hy]
        rfl
      · simp [hs]
    obtain ⟨ends,ne,st,av,dis⟩ := h
    exact ⟨fun c => ⟨(sample ..).mpr (ends c).1,(sample ..).mpr (ends c).2⟩,
      fun z => ne ((sample ..).mp z),st,
      fun c i a l => ⟨fun z => (av c i a l).1 ((sample ..).mp z),
        fun z => (av c i a l).2 ((sample ..).mp z)⟩,
      fun c e i j a l b m z => dis c e i j a l b m ((sample ..).mp z)⟩
  let three : Table 4 :=
