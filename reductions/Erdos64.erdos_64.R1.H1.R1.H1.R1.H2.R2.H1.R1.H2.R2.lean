private theorem right_to_left {A : Type} [Group A] (a b : A) :
    SimpleGraph.fromRel (fun u v : Bool × A =>
      u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*a ∨ v.2=u.2*b)) ⊑
    SimpleGraph.fromRel (fun u v : Bool × A =>
      u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=a*u.2 ∨ v.2=b*u.2)) := by
  let M := SimpleGraph.fromRel (fun u v : Bool × A =>
    u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=a*u.2 ∨ v.2=b*u.2))
  let j (v : Bool × A) : Bool × A := (!v.1,v.2⁻¹)
  have forward (u v : Bool × A)
      (h : u.1=false ∧ v.1=true ∧ (v.2=u.2 ∨ v.2=u.2*a ∨ v.2=u.2*b)) : M.Adj (j v) (j u) := by
    obtain ⟨s,x⟩ := u
    obtain ⟨t,y⟩ := v
    obtain ⟨rfl,rfl,e⟩ := h
    change y=x ∨ y=x*a ∨ y=x*b at e
    refine ⟨by simp [j],.inl ⟨rfl,rfl,?_⟩⟩
    change x⁻¹=y⁻¹ ∨ x⁻¹=a*y⁻¹ ∨ x⁻¹=b*y⁻¹
    rcases e with rfl|rfl|rfl <;> simp
  refine ⟨⟨⟨j,fun {u v} h => h.2.elim (fun e => (forward u v e).symm) (forward v u)⟩,?_⟩⟩
  rintro ⟨s,x⟩ ⟨t,y⟩ e
  exact Prod.ext (by simpa [j] using congrArg Prod.fst e) (by simpa [j] using congrArg Prod.snd e)

private theorem cardBool : Nat.card Bool = 2 := by rw [Nat.card_eq_fintype_card]; decide

private theorem kernel_volume {G Q : Type*} [Group G] [Group Q] [Finite G] [Finite Q]
    (π : G →* Q) (onto : Function.Surjective π) (K : Subgroup π.ker) :
    Nat.card K * Nat.card Q ≤ Nat.card G := by
  calc
    _ ≤ Nat.card π.ker * Nat.card Q :=
      Nat.mul_le_mul_right _ (Nat.card_le_card_of_injective Subtype.val Subtype.val_injective)
    _ = Nat.card G := by
      rw [← Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective π onto).toEquiv,
        ← π.ker.index_eq_card,π.ker.card_mul_index]

private theorem compose {n h q k j : ℕ} (volume : h*q≤n) (small : 25^k≤625*h^4)
    (weight : 25^j≤q^4) : 25^(k+j)≤625*n^4 := by
  rw [pow_add]
  calc
    _ ≤ (625*h^4)*q^4 := Nat.mul_le_mul small weight
    _ = 625*(h*q)^4 := by rw [mul_pow,Nat.mul_assoc]
    _ ≤ 625*n^4 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left volume 4)

private theorem terminal {n k : ℕ} (used : 2^k≤2*n) (lo : 2≤k) (hi : k≤5) :
    25^k≤625*n^4 := by
  interval_cases k <;> norm_num at used
  · exact (by norm_num : 625 ≤ 625*2^4).trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 4))
  · exact (by norm_num : 15625 ≤ 625*4^4).trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 4))
  · exact (by norm_num : 390625 ≤ 625*8^4).trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 4))
  · exact (by norm_num : 9765625 ≤ 625*16^4).trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 4))

