theorem solvable_of_simple_factors (oddSimple : H2) (A : Type) [Group A] [Finite A]
    (odd : Odd (Nat.card A)) : Group.IsSolvable A := by
  classical
  have go (n : ℕ) : ∀ (G : Type) [Group G] [Finite G], Nat.card G = n →
      Odd (Nat.card G) → Group.IsSolvable G := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro G _ _ size oddG
      cases subsingleton_or_nontrivial G with
      | inl triv => exact inferInstance
      | inr nontriv =>
        by_cases simple : IsSimpleGroup G
        · exact Group.isSolvable_of_comm (oddSimple G oddG)
        obtain ⟨H,normal,properBot,properTop⟩ :
            ∃ H : Subgroup G, H.Normal ∧ H ≠ ⊥ ∧ H ≠ ⊤ := by
          by_contra! all
          exact simple ⟨fun H hH => or_iff_not_imp_left.mpr (all H hH)⟩
        let _ := normal
        have nH : Nontrivial H := H.nontrivial_iff_ne_bot.mpr properBot
        have hi : 1 < H.index := H.one_lt_index_of_ne_top properTop
        have hc : 1 < Nat.card H := Finite.one_lt_card
        have mul := H.index_mul_card
        have sublt : Nat.card H < n := by
          rw [←size,←mul]
          simpa using Nat.mul_lt_mul_of_pos_right hi (by omega : 0 < Nat.card H)
        have qlt : Nat.card (G ⧸ H) < n := by
          change H.index < n
          rw [←size,←mul]
          simpa using Nat.mul_lt_mul_of_pos_left hc (by omega : 0 < H.index)
        exact (Group.isSolvable_iff_subgroup_quotient H).mpr
          ⟨ih _ sublt H rfl (oddG.of_dvd_nat H.card_subgroup_dvd_card),
           ih _ qlt (G ⧸ H) rfl (oddG.of_dvd_nat H.card_quotient_dvd_card)⟩
  exact go _ A rfl odd

