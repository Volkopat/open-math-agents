import OMAReductions.R_Erdos128_erdos_128_R2

/-!
# Degree constraints for the low-minimum-degree branch of Erdős 128

Every finite triangle-free graph with at most 9351 n² / 100000 edges has a
sparse half. The proof also bounds the sum of squared degrees and, at each
vertex, the sum of its neighbors' degrees in any counterexample. These
bounds give separate residual cases for regular and irregular graphs.

For u = (|S| - floor(n/2))/n, the new potential is
1/50 + 2u/25 + 4u²/25 + 5u³/16 up to 3/32, and
1/50 + 43u/509 + 10u²/81 above it. The 85 rational Bernstein cells below
certify every separator inequality over its entire interval. Summing the
result for complements of vertex neighborhoods gives the degree bounds.

The general independent-neighborhood induction is due to @iskamag (PR
10355). The abstract induction, cubic separator and degree-moment proof
are adapted from @AminAhantab's Erdős 128 research at commit
14eeb3d9cbaceb15c89fe8cf99b06b4c628d368b. The prior certificate gave
a cutoff of approximately 0.09346718. The coefficients, interval split,
and exact arithmetic in this file establish the stronger bound above.
-/

namespace OMA.R_Erdos128_erdos_128_R2_H3_R2

open Finset SimpleGraph OMA.R_Erdos128_erdos_128_R2
open scoped Classical

/-- In the regular case the remaining degree k satisfies an explicit quadratic inequality. -/
def H1 : Prop :=
  ∀ (V : Type) [Fintype V] (G : SimpleGraph V),
    let n := Fintype.card V
    let m := G.edgeSet.ncard
    let d := fun v => (G.neighborSet v).ncard
    12 ≤ n → 9351*n^2 < 100000*m → 500000*m < 99999*n^2 →
    (∀ I : Set V, G.IsIndepSet I → 5*I.ncard < 2*n) →
    (∃ a b c d : V, a ≠ c ∧ b ≠ d ∧ G.Adj a b ∧ G.Adj b c ∧ G.Adj c d ∧ G.Adj d a) →
    (∃ a b c d e : V, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ a ≠ e ∧ b ≠ c ∧ b ≠ d ∧ b ≠ e ∧
      c ≠ d ∧ c ≠ e ∧ d ≠ e ∧ G.Adj a b ∧ G.Adj b c ∧ G.Adj c d ∧ G.Adj d e ∧ G.Adj e a) →
    (∃ a b c d : V, a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ G.Adj a b ∧ G.Adj c d ∧
      ¬ G.Adj a c ∧ ¬ G.Adj a d ∧ ¬ G.Adj b c ∧ ¬ G.Adj b d) →
    (∃ k : ℕ, (∀ v, d v = k) ∧ 3*k ≤ n ∧
      2315950*k^2 + 191929*n^2 < 2061450*m + 428650*n*k) →
    (∀ S : Set V, 2*S.ncard+1 ≥ n → 50*(G.induce S).edgeSet.ncard > n^2) → ¬ G.CliqueFree 3

/-- Irregular candidates must satisfy both the global and local degree-moment bounds. -/
def H2 : Prop :=
  ∀ (V : Type) [Fintype V] (G : SimpleGraph V),
    let n := Fintype.card V
    let m := G.edgeSet.ncard
    let d := fun v => (G.neighborSet v).ncard
    12 ≤ n → 9351*n^2 < 100000*m → 500000*m < 99999*n^2 →
    (∀ I : Set V, G.IsIndepSet I → 5*I.ncard < 2*n) →
    (∃ a b c d : V, a ≠ c ∧ b ≠ d ∧ G.Adj a b ∧ G.Adj b c ∧ G.Adj c d ∧ G.Adj d a) →
    (∃ a b c d e : V, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ a ≠ e ∧ b ≠ c ∧ b ≠ d ∧ b ≠ e ∧
      c ≠ d ∧ c ≠ e ∧ d ≠ e ∧ G.Adj a b ∧ G.Adj b c ∧ G.Adj c d ∧ G.Adj d e ∧ G.Adj e a) →
    (∃ a b c d : V, a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ G.Adj a b ∧ G.Adj c d ∧
      ¬ G.Adj a c ∧ ¬ G.Adj a d ∧ ¬ G.Adj b c ∧ ¬ G.Adj b d) →
    (∃ v : V, 3*d v ≤ n) → (¬ ∃ k : ℕ, ∀ v, d v = k) →
    (2315950*(∑ v, d v^2) + 191929*n^3 < 2918750*n*m) →
    (∀ v : V, 2061450*(∑ w ∈ (G.neighborSet v).toFinset, d w) + 191929*n^2 + 254500*d v^2
      < 2061450*m + 428650*n*d v) →
    (∀ S : Set V, 2*S.ncard+1 ≥ n → 50*(G.induce S).edgeSet.ncard > n^2) → ¬ G.CliqueFree 3

