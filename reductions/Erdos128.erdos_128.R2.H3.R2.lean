          (M : ℚ)-F (((N-Fintype.card V/2 : ℕ) : ℚ)-x)-x^2 ≤ lam*(x-2*(M : ℚ)/(N : ℚ))) ∧
        (∀ x : ℚ, ((N-Fintype.card V/2 : ℕ) : ℚ) ≤ x →
