theorem main : H1 → H2 → OMA.R_Erdos128_erdos_128_R2.H3 := by
  classical
  intro hRegular hIrregular V _ G hn _ hUpper hInd hC4 hC5 h2K2 hLow hAll hTF
  obtain ⟨hLocal, hGlobal, _⟩ := counterexample_moments G hTF hAll
  have hLower := density_floor G hTF hAll
  by_cases hr : ∃ k : ℕ, ∀ v, (G.neighborSet v).ncard = k
  · obtain ⟨k, hk⟩ := hr
    obtain ⟨v, hv⟩ := hLow
    have hsum : (∑ w ∈ (G.neighborSet v).toFinset, (G.neighborSet w).ncard) = k^2 := by
      calc
        _ = (G.neighborSet v).toFinset.card * k := by simp [hk, nsmul_eq_mul]
        _ = k^2 := by rw [← Set.ncard_eq_toFinset_card', hk v, pow_two]
    have hq := hLocal v
    rw [hsum, hk v] at hq
    apply hRegular V G hn hLower hUpper hInd hC4 hC5 h2K2 ?_ hAll hTF
    exact ⟨k, hk, by simpa [hk] using hv, by nlinarith only [hq]⟩
  · exact hIrregular V G hn hLower hUpper hInd hC4 hC5 h2K2 hLow hr hGlobal hLocal hAll hTF

end OMA.R_Erdos128_erdos_128_R2_H3_R2
