theorem counterexample_moments {V : Type} [Fintype V] (G : SimpleGraph V)
    (hTF : G.CliqueFree 3)
    (hH : ∀ S : Set V, 2 * S.ncard + 1 ≥ Fintype.card V →
      50 * (G.induce S).edgeSet.ncard > Fintype.card V ^ 2) :
    (∀ v : V, 2061450 * (∑ w ∈ (G.neighborSet v).toFinset, (G.neighborSet w).ncard) +
      191929 * Fintype.card V ^ 2 + 254500 * (G.neighborSet v).ncard ^ 2 <
      2061450 * G.edgeSet.ncard + 428650 * Fintype.card V * (G.neighborSet v).ncard) ∧
    (2315950 * (∑ v : V, (G.neighborSet v).ncard ^ 2) + 191929 * Fintype.card V ^ 3 <
        2918750 * Fintype.card V * G.edgeSet.ncard) ∧
    (9263800 * G.edgeSet.ncard ^ 2 + 191929 * Fintype.card V ^ 4 <
        2918750 * Fintype.card V ^ 2 * G.edgeSet.ncard) := by
  classical
  let q1 (u : ℚ) : ℚ := 1/50 + 2*u/25 + 4*u^2/25 + 5*u^3/16
  let q2 (u : ℚ) : ℚ := 1/50 + 43*u/509 + 10*u^2/81
  let f (u : ℚ) : ℚ := if u ≤ 3/32 then q1 u else q2 u
  let ell1 (u : ℚ) : ℚ := 2/25 + 4*u/25 + 5*u^2/16 - 4*q1 u/(1/2+u)
  let ell2 (u : ℚ) : ℚ := 43/509 + 20*u/81 - (182/81)*(2*q2 u/(1/2+u))

  have q1_pos {u : ℚ} (hu : 0 ≤ u) : 0 < q1 u := by unfold q1; positivity
  have q2_pos {u : ℚ} (hu : 0 ≤ u) : 0 < q2 u := by unfold q2; positivity
  have f_pos {u : ℚ} (hu : 0 ≤ u) : 0 < f u := by
    unfold f; split <;> first | exact q1_pos hu | exact q2_pos hu

  have low_shape {u : ℚ} (hu : 0 < u) (hu1 : u ≤ 3/32) :
      ell1 u ≤ 0 ∧ 0 ≤ 11/24 + u + 2*ell1 u ∧
      (∀ x : ℚ, 0 ≤ x → x ≤ u →
        q1 u - q1 (u-x) - x^2 ≤ ell1 u*(x-2*q1 u/(1/2+u))) ∧
      (∀ x : ℚ, u ≤ x →
        (q1 u-1/50)/u*x-x^2 ≤ ell1 u*(x-2*q1 u/(1/2+u))) := by
    have hN : 0 < (1/2:ℚ)+u := by linarith
    have hn := low_lambda u 0 hu.le hu1 (by norm_num) (by norm_num)
    have hnid : -ell1 u*((1/2:ℚ)+u) = ((1 / 25) + ((4 / 25) * u) + ((15 / 16) * (u ^ 3)) + ((259 / 800) * (u ^ 2))) := by
      dsimp [ell1,q1]; field_simp [hN.ne']; ring
    have hL : ell1 u ≤ 0 := by rw [← hnid] at hn; nlinarith
    have ho := low_order u 0 hu.le hu1 (by norm_num) (by norm_num)
    have hoid : (11/24+u+2*ell1 u)*((1/2:ℚ)+u) = ((179 / 1200) + ((-15 / 8) * (u ^ 3)) + ((141 / 400) * (u ^ 2)) + ((383 / 600) * u)) := by
      dsimp [ell1,q1]; field_simp [hN.ne']; ring
    have hO : 0 ≤ 11/24+u+2*ell1 u := by rw [← hoid] at ho; exact nonneg_of_mul_nonneg_left ho hN
    refine ⟨hL,hO,?_,?_⟩
    · intro x hx0 hxu
      have hy0 : 0 ≤ x/u := div_nonneg hx0 hu.le
      have hy1 : x/u ≤ 1 := (div_le_one hu).2 hxu
      have hp := low_cross u (x/u) hu.le hu1 hy0 hy1
      have hp' : 0 ≤ -(q1 u-q1 (u-x)-x^2-ell1 u*(x-2*q1 u/(1/2+u)))*((1/2:ℚ)+u)^2 := by
        convert hp using 1 <;> dsimp [q1,ell1] <;> field_simp [hu.ne',hN.ne'] <;> ring
      have hnn := nonneg_of_mul_nonneg_left hp' (sq_pos_of_pos hN)
      linarith
    · intro x _
      let D : ℚ := 2*q1 u/(1/2+u)
      let p : ℚ := (q1 u-1/50)/u
      have hD : 0 ≤ D := by dsimp [D]; exact div_nonneg (mul_nonneg (by norm_num) (q1_pos hu.le).le) hN.le
      have ht := low_tail u 0 hu.le hu1 (by norm_num) (by norm_num)
      have htid : (D-p)*((1/2:ℚ)+u) = (((3 / 800) * (u ^ 2)) + ((5 / 16) * (u ^ 3))) := by
        dsimp [D,p]; unfold q1; field_simp [hu.ne',hN.ne']; ring
      rw [← htid] at ht
      have hdp : p ≤ D := by have := nonneg_of_mul_nonneg_left ht hN; linarith
      have hid : p*x-x^2-ell1 u*(x-D) = -(x-D)^2+D*(p-D) := by
        dsimp [D,p]; dsimp [ell1,q1]; field_simp [hu.ne',hN.ne']; ring
      have hprod := mul_nonpos_of_nonneg_of_nonpos hD (show p-D ≤ 0 by linarith)
      change p*x-x^2 ≤ ell1 u*(x-D)
      nlinarith [sq_nonneg (x-D)]

  have high_shape {u : ℚ} (hu : 3/32 < u) (hu1 : u ≤ 13/24) :
      ell2 u ≤ 0 ∧ 0 ≤ 11/24+u+2*ell2 u ∧
      (∀ x : ℚ, 0 ≤ x → x ≤ u →
        q2 u - f (u-x) - x^2 ≤ ell2 u*(x-2*q2 u/(1/2+u))) ∧
      (∀ x : ℚ, u ≤ x →
        (q2 u-1/50)/u*x-x^2 ≤ ell2 u*(x-2*q2 u/(1/2+u))) := by
    have hu0 : 0 < u := by linarith
    have hN : 0 < (1/2:ℚ)+u := by linarith
    have hn := high_lambda u 0 hu.le hu1 (by norm_num) (by norm_num)
    have hnid : -ell2 u*((1/2:ℚ)+u) = ((98201 / 2061450) + ((2020 / 6561) * (u ^ 2)) + ((7079 / 41229) * u)) := by
      dsimp [ell2,q2]; field_simp [hN.ne']; ring
    have hL : ell2 u ≤ 0 := by rw [← hnid] at hn; nlinarith
    have ho := high_order u 0 hu.le hu1 (by norm_num) (by norm_num)
    have hoid : (11/24+u+2*ell2 u)*((1/2:ℚ)+u) = ((2208109 / 16491600) + ((2521 / 6561) * (u ^ 2)) + ((202825 / 329832) * u)) := by
      dsimp [ell2,q2]; field_simp [hN.ne']; ring
    have hO : 0 ≤ 11/24+u+2*ell2 u := by rw [← hoid] at ho; exact nonneg_of_mul_nonneg_left ho hN
    refine ⟨hL,hO,?_,?_⟩
    · intro x hx0 hxu
      unfold f
      split
      · rename_i hy
        have hp := high_cross u (u-x) hu.le hu1 (by linarith) hy
        have hp' : 0 ≤ -(q2 u-q1 (u-x)-x^2-ell2 u*(x-2*q2 u/(1/2+u)))*((1/2:ℚ)+u)^2 := by
          convert hp using 1 <;> dsimp [q1,q2,ell2] <;> field_simp [hN.ne'] <;> ring
        have hnn := nonneg_of_mul_nonneg_left hp' (sq_pos_of_pos hN)
        linarith
      · have hp := high_regular u 0 hu.le hu1 (by norm_num) (by norm_num)
        let R : ℚ := 2*(91/81)*q2 u-(1/2+u)*(43/509+20*u/81)
        have hr : 0 ≤ R := by convert hp using 1 <;> dsimp [R,q2] <;> ring
        have hid : q2 u-q2 (u-x)-x^2-ell2 u*(x-2*q2 u/(1/2+u)) =
            -(91/81)*(x-2*q2 u/(1/2+u))^2 - 2*q2 u/((1/2:ℚ)+u)^2*R := by
          dsimp [R]; dsimp [q2,ell2]; field_simp [hN.ne']; ring
        have hcoef : 0 ≤ 2*q2 u/((1/2:ℚ)+u)^2 := by
          exact div_nonneg (by have := q2_pos hu0.le; positivity) (sq_nonneg _)
        have hprod := mul_nonneg hcoef hr
        nlinarith [sq_nonneg (x-2*q2 u/(1/2+u))]
    · intro x _
      let D : ℚ := 2*q2 u/(1/2+u)
      let p : ℚ := (q2 u-1/50)/u
      have ht := high_tail u 0 hu.le hu1 (by norm_num) (by norm_num)
      have htid : -((p-ell2 u)^2+4*ell2 u*D)*u^2*((1/2:ℚ)+u)^2 = (((-951554 / 2087218125) * (u ^ 2)) + ((5080700 / 43046721) * (u ^ 6)) + ((9323860 / 90167823) * (u ^ 5)) + ((35721388 / 14165253675) * (u ^ 3)) + ((23235196699 / 688431328605) * (u ^ 4))) := by
        dsimp [p,D]; dsimp [q2,ell2]; field_simp [hu0.ne',hN.ne']; ring
      rw [← htid] at ht
      have hs : 0 ≤ -((p-ell2 u)^2+4*ell2 u*D) :=
        nonneg_of_mul_nonneg_left (nonneg_of_mul_nonneg_left ht (sq_pos_of_pos hN)) (sq_pos_of_pos hu0)
      have hid : 4*(p*x-x^2-ell2 u*(x-D)) =
          (p-ell2 u)^2+4*ell2 u*D-(2*x-p+ell2 u)^2 := by ring
      change p*x-x^2 ≤ ell2 u*(x-D)
      nlinarith [sq_nonneg (2*x-p+ell2 u)]

  have normalized_separator {u : ℚ} (hu : 0 < u) (hu1 : u ≤ 13/24) :
      ∃ L : ℚ, L ≤ 0 ∧ 0 ≤ 11/24+u+2*L ∧
      (∀ x : ℚ, 0 ≤ x → x ≤ u → f u-f (u-x)-x^2 ≤ L*(x-2*f u/(1/2+u))) ∧
      (∀ x : ℚ, u ≤ x → (f u-1/50)/u*x-x^2 ≤ L*(x-2*f u/(1/2+u))) := by
    by_cases h : u ≤ 3/32
    · obtain ⟨hL,hO,hc,ht⟩ := low_shape hu h
      refine ⟨ell1 u,hL,hO,?_,?_⟩
      · intro x hx0 hxu
        have hyr : u-x ≤ 3/32 := by linarith
        simpa only [f,if_pos h,if_pos hyr] using hc x hx0 hxu
      · simpa only [f,if_pos h] using ht
    · obtain ⟨hL,hO,hc,ht⟩ := high_shape (by linarith) hu1
      exact ⟨ell2 u,hL,hO,by simpa only [f,if_neg h] using hc,by simpa only [f,if_neg h] using ht⟩


  have shrink_separator {a b Q M L t r x : ℚ}
      (ha : 0 < a) (hab : a ≤ b) (hL : L ≤ 0) (hLA : 0 ≤ a+2*L)
      (hQ : 0 ≤ Q) (hM : M ≤ Q) (ht : 1 ≤ t)
      (hbase : t*Q-r-x^2 ≤ L*(x-2*Q/b)) :
      t*M-r-x^2 ≤ L*(x-2*M/a) := by
    have hb : 0 < b := ha.trans_le hab
    have htA : 0 ≤ t*a+2*L := by nlinarith
    have hprod1 := mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hb.le htA) (show M-Q ≤ 0 by linarith)
    have hprod2 := mul_nonpos_of_nonpos_of_nonneg
      (mul_nonpos_of_nonpos_of_nonneg (show 2*L ≤ 0 by linarith) hQ) (show 0 ≤ b-a by linarith)
    have hid : a*b*((t*M-r-x^2-L*(x-2*M/a))-(t*Q-r-x^2-L*(x-2*Q/b))) =
        b*(t*a+2*L)*(M-Q)+2*L*Q*(b-a) := by field_simp [ha.ne',hb.ne']; ring
    have hdiff : (t*M-r-x^2-L*(x-2*M/a))-(t*Q-r-x^2-L*(x-2*Q/b)) ≤ 0 := by
      have hp : a*b*((t*M-r-x^2-L*(x-2*M/a))-(t*Q-r-x^2-L*(x-2*Q/b))) ≤ 0 := by linarith
      exact nonpos_of_mul_nonpos_right hp (mul_pos ha hb)
    linarith

  have graph_separator (n N M : ℕ) (hn12 : 12 ≤ n)
      (hNk : n/2 < N) (hNn : N ≤ n) (hMgt : n^2 < 50*M)
      (hMle : (M : ℚ) ≤ (n : ℚ)^2*f (((N-n/2 : ℕ) : ℚ)/(n : ℚ))) :
      ∃ lam : ℚ, lam ≤ 0 ∧
        (∀ x : ℚ, 0 ≤ x → x ≤ ((N-n/2 : ℕ) : ℚ) →
          (M : ℚ)-(n : ℚ)^2*f ((((N-n/2 : ℕ) : ℚ)-x)/(n : ℚ))-x^2 ≤
            lam*(x-2*(M : ℚ)/(N : ℚ))) ∧
        (∀ x : ℚ, ((N-n/2 : ℕ) : ℚ) ≤ x →
          ((M : ℚ)-(n : ℚ)^2/50)/((N-n/2 : ℕ) : ℚ)*x-x^2 ≤
            lam*(x-2*(M : ℚ)/(N : ℚ))) := by
    let nq : ℚ := n
    let Nq : ℚ := N
    let un : ℚ := ((N-n/2 : ℕ) : ℚ)
    let u : ℚ := un/nq
    let a : ℚ := Nq/nq
    let mu : ℚ := (M : ℚ)/nq^2
    have hn : 0 < nq := by dsimp [nq]; exact_mod_cast (show 0 < n by omega)
    have hN : 0 < Nq := by dsimp [Nq]; exact_mod_cast (show 0 < N by omega)
    have hun : 0 < un := by dsimp [un]; exact_mod_cast (show 0 < N-n/2 by omega)
    have hhalf : 2*(n/2) ≤ n := by omega
    have hhalflo : 11*n ≤ 24*(n/2) := by omega
    have hsum : Nq = (n/2 : ℕ)+un := by
      have h := Nat.sub_add_cancel (show n/2 ≤ N by omega)
      have hq : un+((n/2 : ℕ) : ℚ)=Nq := by dsimp [un,Nq]; exact_mod_cast h
      linarith
    have hhalfq : 2*((n/2 : ℕ) : ℚ) ≤ nq := by dsimp [nq]; exact_mod_cast hhalf
    have hhalfloq : 11*nq ≤ 24*((n/2 : ℕ) : ℚ) := by dsimp [nq]; exact_mod_cast hhalflo
    have hNnq : Nq ≤ nq := by dsimp [nq,Nq]; exact_mod_cast hNn
    have hu : 0 < u := div_pos hun hn
    have hu1 : u ≤ 13/24 := by apply (div_le_iff₀ hn).2; nlinarith
    have ha : 0 < a := div_pos hN hn
    have hab : a ≤ 1/2+u := by
      have heq : 1/2+u = (nq/2+un)/nq := by dsimp [u]; field_simp [hn.ne'] <;> ring
      rw [heq]
      exact (div_le_div_iff_of_pos_right hn).2 (by linarith)
    have halo : 11/24+u ≤ a := by
      have heq : 11/24+u = (11*nq/24+un)/nq := by dsimp [u]; field_simp [hn.ne'] <;> ring
      rw [heq]
      exact (div_le_div_iff_of_pos_right hn).2 (by linarith)
    obtain ⟨L,hL,hLO,hc,ht⟩ := normalized_separator hu hu1
    have hLA : 0 ≤ a+2*L := by linarith
    have hQ : 0 ≤ f u := (f_pos hu.le).le
    have hm : mu ≤ f u := by
      apply (div_le_iff₀ (sq_pos_of_pos hn)).2
      simpa only [u,un,nq,mul_comm] using hMle
    refine ⟨nq*L,mul_nonpos_of_nonneg_of_nonpos hn.le hL,?_,?_⟩
    · intro x hx0 hxu
      have hz0 : 0 ≤ x/nq := div_nonneg hx0 hn.le
      have hzu : x/nq ≤ u := (div_le_div_iff_of_pos_right hn).2 hxu
      have hbase := hc (x/nq) hz0 hzu
      have hh := shrink_separator ha hab hL hLA hQ hm (le_refl (1:ℚ))
        (by simpa only [one_mul] using hbase)
      have hs := mul_le_mul_of_nonneg_left hh (sq_nonneg nq)
      have harg : (un-x)/nq = u-x/nq := by dsimp [u]; ring
      change (M : ℚ)-nq^2*f ((un-x)/nq)-x^2 ≤ (nq*L)*(x-2*(M : ℚ)/Nq)
      rw [harg]
      convert hs using 1 <;> (try dsimp [mu,a]) <;> (try field_simp [hn.ne',hN.ne']) <;> rfl
    · intro x hxu
      have hzu : u ≤ x/nq := (div_le_div_iff_of_pos_right hn).2 hxu
      have hrat : 1 ≤ (x/nq)/u := (one_le_div hu).2 hzu
      have hbase := ht (x/nq) hzu
      have hbase' : ((x/nq)/u)*f u-(1/50)*((x/nq)/u)-(x/nq)^2 ≤
          L*((x/nq)-2*f u/(1/2+u)) := by convert hbase using 1 <;> ring
      have hh := shrink_separator ha hab hL hLA hQ hm hrat hbase'
      have hs := mul_le_mul_of_nonneg_left hh (sq_nonneg nq)
      change ((M : ℚ)-nq^2/50)/un*x-x^2 ≤ (nq*L)*(x-2*(M : ℚ)/Nq)
      convert hs using 1 <;> (try dsimp [mu,a,u]) <;> (try field_simp [hn.ne',hN.ne',hun.ne']) <;> rfl

  have induce_edgeSet_gt_cubic {V : Type} [Fintype V] (G : SimpleGraph V)
      (hTF : G.CliqueFree 3)
      (hH : ∀ V' : Set V, 2*V'.ncard+1 ≥ Fintype.card V →
        50*(G.induce V').edgeSet.ncard > Fintype.card V^2)
      (S : Finset V) (hSk : Fintype.card V/2 ≤ #S) :
      (Fintype.card V : ℚ)^2*f (((#S-Fintype.card V/2 : ℕ) : ℚ)/(Fintype.card V : ℚ)) <
        ((G.induce (S : Set V)).edgeSet.ncard : ℚ) := by
    apply induce_edgeSet_gt_potential G hTF hH
      (fun t => (Fintype.card V : ℚ)^2*f (t/(Fintype.card V : ℚ)))
    · norm_num [f,q1] <;> ring_nf <;> exact le_rfl
    · intro N M hNk hNn hMgt hMle
      exact graph_separator (Fintype.card V) N M (twelve_le_card G hTF hH) hNk hNn hMgt hMle
    · exact hSk
  let n := Fintype.card V
  let m := G.edgeSet.ncard
  let d : V → ℕ := fun v => #(Finset.univ.filter (G.Adj v))
  let Sv : V → ℕ := fun v => ∑ w ∈ Finset.univ.filter (G.Adj v), d w
  have hn12 : 12 ≤ n := twelve_le_card G hTF hH
  have hn : (0 : ℚ) < n := by exact_mod_cast (show 0 < n by omega)
  have hd : ∀ v, 5 * d v < 2 * n := by
    intro v
    have hdn : d v = (G.neighborSet v).ncard := by
      dsimp [d]
      rw [← Set.ncard_coe_finset]
      congr 1
      ext x
      simp
    rw [hdn]
    exact five_mul_deg_lt_two_mul_card G hTF hH v
  have hMuniv : (G.induce ((Finset.univ : Finset V) : Set V)).edgeSet.ncard = m := by
    have h1 := two_mul_induce_edgeSet_ncard G (Finset.univ : Finset V)
    have h2 : 2 * m = ∑ u : V, #(Finset.univ.filter (G.Adj u)) := by
      have hcard : G.edgeSet.ncard = #G.edgeFinset := by
        rw [SimpleGraph.edgeFinset, Set.ncard_eq_toFinset_card']
      dsimp [m]
      rw [hcard, ← SimpleGraph.sum_degrees_eq_twice_card_edges]
      apply Finset.sum_congr rfl
      intro u _
      rw [SimpleGraph.degree, SimpleGraph.neighborFinset]
      congr 1
      ext v
      simp
    omega
  have hsum_d : ∑ v, d v = 2 * m := by
    have h := two_mul_induce_edgeSet_ncard G (Finset.univ : Finset V)
    rw [hMuniv] at h
    exact h.symm
  have hsum_Sv : ∑ v, Sv v = ∑ v, (d v) ^ 2 := by
    calc
      ∑ v, Sv v = ∑ v, ∑ w, if G.Adj v w then d w else 0 := by
        apply Finset.sum_congr rfl
        intro v _
        exact Finset.sum_filter _ _
      _ = ∑ w, ∑ v, if G.Adj v w then d w else 0 := Finset.sum_comm
      _ = ∑ w, ∑ v, if G.Adj w v then d w else 0 := by
        apply Finset.sum_congr rfl
        intro w _
        apply Finset.sum_congr rfl
        intro v _
        simp [G.adj_comm]
      _ = ∑ w, (d w)^2 := by
        apply Finset.sum_congr rfl
        intro w _
        rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul]
        change d w * d w = d w ^ 2
        ring
  have hper : ∀ v, (Sv v : ℚ) < (m : ℚ) - 191929 * (n : ℚ)^2 / 2061450 +
      8573 * (n : ℚ) * (d v : ℚ) / 41229 - 10 * (d v : ℚ)^2 / 81 := by
    intro v
    let J := Finset.univ.filter (G.Adj v)
    let R := (Finset.univ : Finset V) \ J
    have hJS : J ⊆ Finset.univ := Finset.subset_univ _
    have hcard : #R = n - d v := by
      dsimp [R]
      rw [Finset.card_sdiff_of_subset hJS]
      rfl
    have hdv := hd v
    have hsize : n / 2 ≤ #R := by rw [hcard]; omega
    have hbranch : n < 10 * (#R - n / 2) := by rw [hcard]; omega
    have hp := induce_edgeSet_gt_cubic G hTF hH R hsize
    have hJindep : ∀ x ∈ J, ∀ y ∈ J, ¬ G.Adj x y := by
      intro x hx y hy hxy
      exact not_adj_of_cliqueFree_three hTF (Finset.mem_filter.mp hx).2 hxy
        (Finset.mem_filter.mp hy).2
    have he := induce_edgeSet_ncard_sdiff_indep G hJS hJindep
    rw [hMuniv] at he
    have heq : ((G.induce (R : Set V)).edgeSet.ncard : ℚ) + (Sv v : ℚ) = m := by
      exact_mod_cast he
    let t : ℚ := ((#R - n / 2 : ℕ) : ℚ)
    have hhalf : (n : ℚ) / 2 - (d v : ℚ) ≤ t := by
      have hnat : n ≤ 2 * ((#R - n / 2) + d v) := by rw [hcard]; omega
      have hq : (n : ℚ) ≤ 2 * (t + (d v : ℚ)) := by
        dsimp [t]
        exact_mod_cast hnat
      linarith
    have hdq : 5 * (d v : ℚ) < 2 * (n : ℚ) := by exact_mod_cast hdv
    have hbase : 0 ≤ (n : ℚ) / 2 - (d v : ℚ) := by linarith
    have hpot : 1 * (n : ℚ)^2 / 50 + 43 * (n : ℚ) *
        ((n : ℚ) / 2 - (d v : ℚ)) / 509 + 10 * ((n : ℚ) / 2 - (d v : ℚ))^2 / 81 ≤
        1 * (n : ℚ)^2 / 50 + 43 * (n : ℚ) * t / 509 + 10 * t^2 / 81 := by
      nlinarith
    change (n : ℚ)^2*f (t/(n : ℚ)) < _ at hp
    have htbranch : (3/32 : ℚ) < t/(n : ℚ) := by
      apply (lt_div_iff₀ hn).2
      have h : (n : ℚ) < 10*t := by dsimp [t]; exact_mod_cast hbranch
      linarith
    simp only [f,if_neg (not_le.mpr htbranch)] at hp
    have hscale : (n : ℚ)^2*q2 (t/(n : ℚ)) =
        (n : ℚ)^2/50+43*(n : ℚ)*t/509+10 *t^2 / 81 := by
      unfold q2; field_simp [hn.ne'] <;> ring
    rw [hscale] at hp
    nlinarith [hp, heq, hpot]
  have hsum_dq : (∑ v, (d v : ℚ)) = 2 * (m : ℚ) := by exact_mod_cast hsum_d
  have hsum_Svq : (∑ v, (Sv v : ℚ)) = ∑ v, (d v : ℚ)^2 := by
    exact_mod_cast hsum_Sv
  have hne : (Finset.univ : Finset V).Nonempty := by
    apply Finset.card_pos.mp
    simpa [n] using (show 0 < n by omega)
  have htotal := Finset.sum_lt_sum_of_nonempty hne (fun v _ => hper v)
  have hsumR : (∑ v, ((m : ℚ) - 191929 * (n : ℚ)^2 / 2061450 +
      8573 * (n : ℚ) * (d v : ℚ) / 41229 - 10 * (d v : ℚ)^2 / 81)) =
      (n : ℚ) * ((m : ℚ) - 191929 * (n : ℚ)^2 / 2061450) +
      17146 * (n : ℚ) * (m : ℚ) / 41229 - 10 * (∑ v, (d v : ℚ)^2) / 81 := by
    simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib,
      Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    rw [← Finset.sum_div, ← Finset.mul_sum, hsum_dq, ← Finset.sum_div, ← Finset.mul_sum]
    dsimp [n]
    ring
  rw [hsum_Svq, hsumR] at htotal
  have hcs := sq_sum_le_card_mul_sum_sq (s := (Finset.univ : Finset V))
    (f := fun v => (d v : ℚ))
  rw [hsum_dq, Finset.card_univ] at hcs
  change (2 * (m : ℚ))^2 ≤ (n : ℚ) * ∑ v, (d v : ℚ)^2 at hcs
  have hmul := mul_lt_mul_of_pos_left htotal hn
  have hfinal : 9263800 * (m : ℚ)^2 + 191929 * (n : ℚ)^4 <
      2918750 * (n : ℚ)^2 * (m : ℚ) := by nlinarith [hcs, hmul]
  have hmoment : 2315950 * (∑ v, (d v : ℚ)^2) + 191929*(n : ℚ)^3 <
      2918750*(n : ℚ)*(m : ℚ) := by linarith only [htotal]
  have hdset (v : V) : d v = (G.neighborSet v).ncard := by
    dsimp [d]
    rw [← Set.ncard_coe_finset]
    congr 1
    ext x
    simp
  have hmomentNat : 2315950 * (∑ v, (d v)^2) + 191929*n^3 < 2918750*n*m := by
    exact_mod_cast hmoment
  simp only [hdset] at hmomentNat
  have hlocal (v : V) : 2061450 * Sv v + 191929*n^2 + 254500*(d v)^2 <
      2061450*m + 428650*n*(d v) := by
    have hh : 2061450 * (Sv v : ℚ) + 191929*(n : ℚ)^2 + 254500*(d v : ℚ)^2 <
        2061450*(m : ℚ) + 428650*(n : ℚ)*(d v : ℚ) := by linarith only [hper v]
    exact_mod_cast hh
  refine ⟨?_, hmomentNat, by exact_mod_cast hfinal⟩
  intro v
  have hid : (Finset.univ.filter (G.Adj v)) = (G.neighborSet v).toFinset := by ext x; simp
  simpa only [Sv, hid, hdset] using hlocal v

/-- Every counterexample has edge density strictly above 0.09351. -/
theorem density_floor {V : Type} [Fintype V] (G : SimpleGraph V) (hTF : G.CliqueFree 3)
    (hH : ∀ S : Set V, 2*S.ncard+1 ≥ Fintype.card V →
      50*(G.induce S).edgeSet.ncard > Fintype.card V^2) :
    9351 * Fintype.card V^2 < 100000 * G.edgeSet.ncard := by
  let n : ℚ := Fintype.card V
  let m : ℚ := G.edgeSet.ncard
  have hp : 9263800 * m^2 + 191929 * n^4 < 2918750 * n^2 * m := by
    dsimp [n,m]
    exact_mod_cast (counterexample_moments G hTF hH).2.2
  by_contra! hle
  have hm : 100000*m ≤ 9351*n^2 := by dsimp [n,m]; exact_mod_cast hle
  have hA : 0 ≤ n^2 := sq_nonneg _
  have hf : 0 ≤ 2918750*n^2 - 9263800*(m + 9351*n^2/100000) := by linarith
  have hprod := mul_nonneg (show 0 ≤ 9351*n^2/100000-m by linarith) hf
  nlinarith [hprod, sq_nonneg (n^2)]


/-- At or below the density cutoff a subset of exactly half the vertices, rounded
down, spans at most the number of edges requested by Erdős 128. -/
theorem sparse_half_of_density {V : Type} [Fintype V] (G : SimpleGraph V)
    (hTF : G.CliqueFree 3) (hm : 100000 * G.edgeSet.ncard ≤ 9351 * Fintype.card V^2) :
    ∃ S : Set V, S.ncard = Fintype.card V / 2 ∧
      50 * (G.induce S).edgeSet.ncard ≤ Fintype.card V^2 := by
  classical
  have hex : ∃ T : Set V, 2*T.ncard+1 ≥ Fintype.card V ∧
      50*(G.induce T).edgeSet.ncard ≤ Fintype.card V^2 := by
    by_contra! h
    exact (Nat.not_lt_of_ge hm) (density_floor G hTF h)
  obtain ⟨T, hT, he⟩ := hex
  obtain ⟨S, hST, hs⟩ := T.exists_subset_card_eq (show Fintype.card V / 2 ≤ T.ncard by omega)
  have hcard : (G.induce S).edgeSet.ncard ≤ (G.induce T).edgeSet.ncard := by
    simpa only [← Nat.card_coe_set_eq, Nat.card_eq_fintype_card] using
      Fintype.card_le_of_embedding (G.induceHomOfLE hST).mapEdgeSet
  exact ⟨S, hs, (Nat.mul_le_mul_left 50 hcard).trans he⟩

end Certificate
