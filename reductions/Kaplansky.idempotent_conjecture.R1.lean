import FormalConjectures.Wikipedia.Kaplansky
import Mathlib

-- Reduction Kaplansky.idempotent_conjecture.R1 of Kaplansky's idempotent conjecture.
-- Credit: @marcusbuffett

/-!
# Kaplansky's idempotent conjecture: unique-product groups, and the open rest

The conjecture: for a field `K` and a torsion-free group `G`, `K[G]` has no idempotents other
than `0` and `1`.

* `H1` (classical): the conjecture holds for every unique-product group `G` (`UniqueProds G`),
  a class containing all left- and bi-orderable groups (so torsion-free abelian, free and
  torsion-free nilpotent groups). There `K[G]` has no zero divisors, and `e (e - 1) = 0`.
* `H2` (open): torsion-free groups without the unique-product property.

Both are stated for `K G : Type`. `main` handles the arbitrary universes of the target: an
idempotent `a ∈ K[G]` lives in `K₀[G₀]`, where `G₀ = F(n) ⧸ ker` is the subgroup generated by
the support of `a` (as a quotient of a free group on `n` letters) and `K₀` is the fraction field
of `ℤ[X₁, …, Xₙ] ⧸ ker`, the subring generated by its coefficients; both are in `Type`, and
`K₀[G₀] → K[G]` is an injective ring map hitting `a`. Then `main` splits on `UniqueProds G₀`.
This isolates the textbook case; it is not progress on the conjecture, which `H2` keeps.
-/

namespace OMA.R_Kaplansky_idempotent_conjecture_R1

open MonoidAlgebra

universe u v

/-- Transport an idempotent of `K[G]` (any universes) to `K₀[G₀]` with `K₀ G₀ : Type`. -/
theorem transport {K : Type u} [Field K] {G : Type v} [Group G] (hG : Monoid.IsTorsionFree G)
    (a : MonoidAlgebra K G) (ha : IsIdempotentElem a) :
    ∃ (K₀ : Type) (_ : Field K₀) (G₀ : Type) (_ : Group G₀), Monoid.IsTorsionFree G₀ ∧
      ∃ a₀ : MonoidAlgebra K₀ G₀, IsIdempotentElem a₀ ∧ (a₀ = 0 → a = 0) ∧ (a₀ = 1 → a = 1) := by
  classical
  set s := a.coeff.support
  set n := s.card
  let g : Fin n → G := fun i => (s.equivFin.symm i : G)
  let φ : FreeGroup (Fin n) →* G := FreeGroup.lift g
  let κ : FreeGroup (Fin n) ⧸ φ.ker →* G := QuotientGroup.kerLift φ
  have hκ : Function.Injective κ := QuotientGroup.kerLift_injective φ
  let ψ : MvPolynomial (Fin n) ℤ →+* K :=
    MvPolynomial.eval₂Hom (Int.castRingHom K) fun i => a.coeff (g i)
  have : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  let ι : FractionRing (MvPolynomial (Fin n) ℤ ⧸ RingHom.ker ψ) →+* K :=
    IsFractionRing.lift (RingHom.kerLift_injective ψ)
  let Φ := (mapDomainRingHom K κ).comp (mapRingHom (FreeGroup (Fin n) ⧸ φ.ker) ι)
  have hΦ : Function.Injective Φ := by
    refine (mapDomain_injective hκ).comp ?_
    rw [coe_mapRingHom]
    exact map_injective _ ι.injective
  let a₀ : MonoidAlgebra (FractionRing (MvPolynomial (Fin n) ℤ ⧸ RingHom.ker ψ))
      (FreeGroup (Fin n) ⧸ φ.ker) :=
    ∑ i : Fin n, single (QuotientGroup.mk (FreeGroup.of i))
      (algebraMap _ _ (Ideal.Quotient.mk (RingHom.ker ψ) (MvPolynomial.X i)))
  have hΦa : Φ a₀ = a := by
    simp only [a₀, map_sum, Φ, RingHom.comp_apply, mapRingHom_single, mapDomainRingHom_apply,
      mapDomain_single, ι, IsFractionRing.lift_algebraMap, RingHom.kerLift_mk, κ,
      QuotientGroup.kerLift_mk, φ, FreeGroup.lift_apply_of, ψ, MvPolynomial.eval₂Hom_X']
    conv_rhs => rw [← sum_coeff_single a]
    rw [Finsupp.sum, ← Finset.sum_coe_sort s]
    exact Equiv.sum_comp s.equivFin.symm (fun x : s => single (x : G) (a.coeff x))
  refine ⟨_, inferInstance, _, inferInstance, ?_, a₀, ?_, ?_, ?_⟩
  · intro x hx hfin
    refine hG (κ x) (fun h => hx (hκ (h.trans κ.map_one.symm))) ?_
    obtain ⟨m, hm, hpow⟩ := (isOfFinOrder_iff_pow_eq_one).mp hfin
    exact (isOfFinOrder_iff_pow_eq_one).mpr ⟨m, hm, by rw [← map_pow, hpow, map_one]⟩
  · exact hΦ (by rw [map_mul, hΦa]; exact ha)
  · intro h; rw [← hΦa, h, map_zero]
  · intro h; rw [← hΦa, h, map_one]

/-- Unique-product groups: `K[G]` has only the trivial idempotents. -/
def H1 : Prop :=
  ∀ (K : Type) [Field K] (G : Type) [Group G], UniqueProds G →
    ∀ a : MonoidAlgebra K G, IsIdempotentElem a → a = 0 ∨ a = 1

/-- The open part: torsion-free groups without unique products. -/
def H2 : Prop :=
  ∀ (K : Type) [Field K] (G : Type) [Group G], Monoid.IsTorsionFree G → ¬ UniqueProds G →
    ∀ a : MonoidAlgebra K G, IsIdempotentElem a → a = 0 ∨ a = 1

theorem main : H1 → H2 → type_of% @Kaplansky.idempotent_conjecture := by
  intro h1 h2 K _ G _ hG a ha
  obtain ⟨K₀, _, G₀, _, hG₀, a₀, ha₀, hz, ho⟩ := transport hG a ha
  have key : a₀ = 0 ∨ a₀ = 1 := by
    by_cases hU : UniqueProds G₀
    · exact h1 K₀ G₀ hU a₀ ha₀
    · exact h2 K₀ G₀ hG₀ hU a₀ ha₀
  exact key.imp hz ho

end OMA.R_Kaplansky_idempotent_conjecture_R1
