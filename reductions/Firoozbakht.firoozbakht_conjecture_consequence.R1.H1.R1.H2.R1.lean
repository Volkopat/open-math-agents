set_option maxRecDepth 4096 in
private theorem chain_append {left mid right : ℕ}
    {first second : List (ℕ × ℕ × ℕ × ℕ)}
    (hfirst : (Classical.choose rowAlgorithms).2 mid left first = true) (hsecond : (Classical.choose rowAlgorithms).2 right mid second = true) :
    (Classical.choose rowAlgorithms).2 right left (first ++ second) = true := by
  induction first generalizing left with
  | nil =>
    rw [chain_nil] at hfirst
    have h : left = mid := beq_iff_eq.mp hfirst
    simpa only [List.nil_append, h] using hsecond
  | cons row rest ih =>
    rcases row with ⟨lo, hi, count, exponent⟩
    rw [chain_cons] at hfirst
    have parts := Bool.and_eq_true_iff.mp hfirst
    rw [List.cons_append, chain_cons]
    exact Bool.and_eq_true_iff.mpr ⟨parts.1, ih parts.2⟩

set_option maxRecDepth 4096 in
private theorem exists_row {left right p : ℕ}
    {rows : List (ℕ × ℕ × ℕ × ℕ)}
    (covered : (Classical.choose rowAlgorithms).2 right left rows = true) (hleft : left ≤ p) (hright : p < right) :
    ∃ row ∈ rows, row.1 ≤ p ∧ p ≤ row.2.1 := by
  induction rows generalizing left with
  | nil =>
    rw [chain_nil] at covered
    have h : left = right := beq_iff_eq.mp covered
    omega
  | cons row rest ih =>
    rcases row with ⟨lo, hi, count, exponent⟩
    rw [chain_cons] at covered
    have parts := Bool.and_eq_true_iff.mp covered
    have bounds : lo = left ∧ (Classical.choose rowAlgorithms).2 right (hi + 1) rest = true :=
      ⟨beq_iff_eq.mp parts.1, parts.2⟩
    by_cases h : p ≤ hi
    · exact ⟨_, List.mem_cons_self, bounds.1 ▸ hleft, h⟩
    · obtain ⟨row, hr, hp⟩ := ih bounds.2 (by omega)
      exact ⟨row, List.mem_cons_of_mem _ hr, hp⟩

theorem certifyInterval {a b count h : ℕ} (hh : 0 < h) (hpow : 2 ^ h ≤ a ^ 256)
    (hcount : count ≤ a.primeCounting)
    (hcoef : (693147 * h) * 256000000 + 256000000 ^ 2 ≤ (693147 * h) ^ 2)
    (hsize : b * ((693147 * h) * 256000000) ≤
      count * ((693147 * h) ^ 2 - ((693147 * h) * 256000000 + 256000000 ^ 2)))
    {p : ℕ} (hap : a ≤ p) (hpb : p ≤ b) :
    ∃ h : ℕ, 0 < h ∧ 2 ^ h ≤ p ^ 256 ∧
      let u := 693147 * h
      let v := 256000000
      p * u * v + p.primeCounting * (u * v + v ^ 2) ≤ p.primeCounting * u ^ 2 := by
  refine ⟨h, hh, hpow.trans (Nat.pow_le_pow_left hap 256), ?_⟩
  let u : ℕ := 693147 * h
  let v : ℕ := 256000000
  let error := u * v + v ^ 2
  change p * u * v + p.primeCounting * error ≤ p.primeCounting * u ^ 2
  have countLe : count ≤ p.primeCounting := hcount.trans (Nat.monotone_primeCounting hap)
  have sizeLe : p * (u * v) ≤ p.primeCounting * (u ^ 2 - error) :=
    (Nat.mul_le_mul_right (u * v) hpb).trans
      (hsize.trans (Nat.mul_le_mul_right (u ^ 2 - error) countLe))
  rw [Nat.mul_assoc]
  calc
    _ ≤ p.primeCounting * (u ^ 2 - error) + p.primeCounting * error :=
      Nat.add_le_add_right sizeLe _
    _ = _ := by rw [← Nat.mul_add, Nat.sub_add_cancel hcoef]

private theorem all_append_check {xs ys : List (ℕ × ℕ × ℕ × ℕ)}
    (hx : ∀ row ∈ xs, (Classical.choose rowAlgorithms).1 row = true) (hy : ∀ row ∈ ys, (Classical.choose rowAlgorithms).1 row = true) :
    ∀ row ∈ xs ++ ys, (Classical.choose rowAlgorithms).1 row = true := by
  intro row hrow
  rcases List.mem_append.mp hrow with h | h
