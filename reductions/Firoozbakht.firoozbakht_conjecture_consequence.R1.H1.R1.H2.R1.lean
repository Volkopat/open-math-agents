import OMAReductions.R_Firoozbakht_firoozbakht_conjecture_consequence_R1_H1_R1
import Mathlib.NumberTheory.PrimeCounting

/-! # The finite prime-counting bound as certified interval checkpoints

Every interval has an integer lower logarithm witness. Monotonicity of the
prime count propagates a count at its left endpoint across the interval.
Three groups of prime counts remain. All arithmetic and coverage are checked
in the proof. -/

namespace OMA.R_Firoozbakht_firoozbakht_conjecture_consequence_R1_H1_R1_H2_R1

private theorem rowAlgorithms : ∃ f : ((ℕ × ℕ × ℕ × ℕ) → Bool) ×
    (ℕ → ℕ → List (ℕ × ℕ × ℕ × ℕ) → Bool), f =
    ((fun row =>
      let (lo, hi, count, h) := row
      let u := 693147 * h
      let v := 256000000
      decide (lo ≤ hi ∧ 0 < h ∧ 2 ^ h ≤ lo ^ 256 ∧
        u * v + v ^ 2 ≤ u ^ 2 ∧
        hi * (u * v) ≤ count * (u ^ 2 - (u * v + v ^ 2)))),
      (fun stop start rows =>
        (List.foldr (fun row rest left => (row.1 == left) && rest (row.2.1 + 1))
          (fun left => left == stop) rows) start)) := ⟨_, rfl⟩

private theorem chain_nil (stop start : ℕ) :
    (Classical.choose rowAlgorithms).2 stop start [] = (start == stop) := by
  simp only [Classical.choose_spec rowAlgorithms, List.foldr_nil]

private theorem chain_cons (stop start : ℕ) (row : ℕ × ℕ × ℕ × ℕ)
    (rows : List (ℕ × ℕ × ℕ × ℕ)) :
    (Classical.choose rowAlgorithms).2 stop start (row :: rows) =
      ((row.1 == start) && (Classical.choose rowAlgorithms).2 stop (row.2.1 + 1) rows) := by
  simp only [Classical.choose_spec rowAlgorithms, List.foldr_cons]

