/- Proof adapted from upstream PR #2033 by MrSeizy. -/

/-! Local extension counts in the indexed weight-fifteen search.

Each block is stored as its 60-bit exterior-point mask. A legal group consists of six
sorted blocks whose union is the allowed row. No block can use an endpoint twice.
For each center we retain the three triangles in which every pair of allowed rows
has 24 common exterior points. An extension to each triangle can be chosen separately.
-/

namespace OMA.R_Erdos723_erdos_723_variants_leq_11_R1_H2_R2_H3_R1_H3_R1_H2_R1_H2_R1

-- Upper bound when both marked exterior points lie in one block.
def H1 : Prop :=
  let allowed (g : Nat) := ((0xfffc3ef80fafa00f3bbfb03bed00eeaeefc0bef00bdbdcf43b5efe00e7db781eef77db7007715f55fdd75f5f003c3740d75d7ddf5d5c1dd01e7d77fa4b5ea76c0beee5fa2a83ababebbbaf00cccf3cf3f3f3f033333cf3cfcfcffc003cf3cf3f3f3ffffc0000fcfcfcfffffffff000000 : Nat) >>> (60*g)) % 2^60
  let incident (m : Fin 15) := ((0x2a0220020808000842110800400080511000410004040c008802082020003080481000010200c440400410001003c000082080008003c020010008040003c104004040000003f000000202000000fc002000100000003f010100000000000ff000000000000000ff000000000000000ff : Nat) >>> (60*m.val)) % 2^60
  let thin (n : Nat) := n &&& (n-1) = 0
  let legal (g : Nat) (b : List Nat) := b.length = 6 ∧ b.Pairwise (· ≤ ·) ∧
    b.foldr Nat.lor 0 = allowed g ∧ ∀ x ∈ b, ∀ m, thin (x &&& incident m)
  let compat (b c : List Nat) := ∀ x ∈ b, ∀ y ∈ c, thin (x &&& y)
  let pairs (g : Nat) : List (Nat × Nat) := if g = 0 then [(9,14),(10,13),(11,12)] else
    if g = 9 then [(0,14),(3,8),(4,7)] else [(0,9),(1,6),(2,5)]
  let viable (g : Nat) (b : List Nat) := legal g b ∧ ∀ t ∈ pairs g,
    ∃ c d, legal t.1 c ∧ legal t.2 d ∧ compat b c ∧ compat b d ∧ compat c d
  let marker (g : Nat) := if g = 0 then 4398063288320 else if g = 9 then 262400 else 131584
  let joined (g : Nat) (b : List Nat) := ∃ x ∈ b, x &&& marker g = marker g
  ∀ g ∈ [0,9,14], ∀ S : Finset (List Nat),
    (∀ b ∈ S, viable g b ∧ joined g b) → S.card ≤ 34

