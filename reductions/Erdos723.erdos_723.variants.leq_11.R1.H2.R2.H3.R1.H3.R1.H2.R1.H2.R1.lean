lemma fold_bits (l : List Nat) (p : Nat) :
    (l.foldr Nat.lor 0).testBit p = true ↔ ∃ x ∈ l, x.testBit p = true := by
  induction l with
  | nil => simp
  | cons a l ih => simp [ih]

lemma encode_set (s : Finset (Fin 60)) :
    ∃ w : Nat, ∀ k, w.testBit k = true ↔ ∃ p ∈ s, p.val = k := by
  refine ⟨((s.toList.map fun p => 2^p.val).foldr Nat.lor 0), ?_⟩
  intro k
  simp [fold_bits, Nat.testBit_two_pow]

lemma thin_of_unique (w : Nat)
    (h : ∀ i j, w.testBit i = true → w.testBit j = true → i = j) :
    w &&& (w-1) = 0 := by
  by_cases ex : ∃ i, w.testBit i = true
  · obtain ⟨i, hi⟩ := ex
    have hw : w = 2^i := by
      apply Nat.eq_of_testBit_eq
      intro j
      apply Bool.eq_iff_iff.mpr
      rw [Nat.testBit_two_pow, decide_eq_true_eq]
      exact ⟨fun hj => h i j hi hj, fun e => e ▸ hi⟩
    rw [hw, Nat.and_two_pow_sub_one_eq_mod, Nat.mod_self]
  · have hw : w = 0 := by
      apply Nat.eq_of_testBit_eq
      intro i
      simpa using Bool.eq_false_iff.mpr (fun hi => ex ⟨i, hi⟩)
    simp [hw]

lemma assorted {P Q : List Nat → Prop} [DecidablePred Q]
    {T : Finset (List Nat)} {b : List Nat} (hb : P b)
    (hT : ∀ x ∈ T, P x) (hnum : T.card = 86)
    (h₁ : ∀ S : Finset (List Nat), (∀ x ∈ S, P x ∧ Q x) → S.card ≤ 34)
    (h₂ : ∀ S : Finset (List Nat), (∀ x ∈ S, P x ∧ ¬ Q x) → S.card ≤ 52) :
    b ∈ T := by
  classical
  let S := insert b T
  have good : ∀ x ∈ S, P x := by
    intro x hx
    rcases Finset.mem_insert.mp hx with rfl | h
    · exact hb
    · exact hT x h
  have hleft := h₁ (S.filter Q) (fun x hx =>
    ⟨good x (Finset.mem_filter.mp hx).1, (Finset.mem_filter.mp hx).2⟩)
  have hright := h₂ (S.filter (fun x => ¬ Q x)) (fun x hx =>
    ⟨good x (Finset.mem_filter.mp hx).1, (Finset.mem_filter.mp hx).2⟩)
  have ht := Finset.card_filter_add_card_filter_not (s := S) Q
  by_contra hn
  have he : S.card = T.card + 1 := Finset.card_insert_of_notMem hn
  omega
lemma cut_bit (t w g k : Nat) :
    (((t >>> (w*g)) % 2^w).testBit k = true) ↔ k < w ∧ t.testBit (w*g+k) = true := by
  rw [← Nat.and_two_pow_sub_one_eq_mod]
  simp [Nat.testBit_shiftRight, Nat.add_comm]

lemma supported {legal : Nat → List Nat → Prop} {compat : List Nat → List Nat → Prop}
    (edges : Nat → List (Nat × Nat)) (decode : Nat → List Nat) (g : Nat)
    (rows : List (Nat × List (Nat × Nat)))
    (hc : ∀ r ∈ rows, legal g (decode r.1) ∧ ∀ t ∈ edges g, ∃ v ∈ r.2,
      legal t.1 (decode v.1) ∧ legal t.2 (decode v.2) ∧ compat (decode r.1) (decode v.1) ∧
      compat (decode r.1) (decode v.2) ∧ compat (decode v.1) (decode v.2)) :
    ∀ b ∈ (rows.map (fun r => decode r.1)).toFinset, legal g b ∧ ∀ t ∈ edges g,
      ∃ c d, legal t.1 c ∧ legal t.2 d ∧ compat b c ∧ compat b d ∧ compat c d := by
  intro b hb
  obtain ⟨r, hr, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hb)
  refine ⟨(hc r hr).1, fun t ht => ?_⟩
  obtain ⟨v, _, hv⟩ := (hc r hr).2 t ht
  exact ⟨_, _, hv⟩

