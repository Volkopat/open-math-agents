import FormalConjectures.Wikipedia.Irrational

-- Reduction Irrational.irrational_pi_to_e.R1 of the irrationality of π ^ e
-- Credit: @LordMike
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# `π ^ e` is irrational, from Schanuel's conjecture for `n = 2, 3, 4`

Schanuel's conjecture (the catalogue problem `Schanuel.schanuel_conjecture`): if `z₁, …, zₙ` are
complex numbers linearly independent over `ℚ`, then `ℚ(z₁, …, zₙ, exp z₁, …, exp zₙ)` has
transcendence degree at least `n` over `ℚ`. The hypotheses are its cases `n = 2, 3, 4`, in the
catalogue's wording. This is an UPWARD reduction: each hypothesis is a special case of a
conjecture that is far stronger than the target.

* `H1`: Schanuel for `n = 2`. Used for `(1, π i)`: the field is `ℚ(π i, e)`.
* `H2`: Schanuel for `n = 3`. Used for `(1, π i, log π)`: the field is `ℚ(π i, log π, e, π)`.
* `H3`: Schanuel for `n = 4`. Used for `(1, π i, log π, e log π)`: the field is
  `ℚ(π i, log π, e log π, e, π, π ^ e)`.

The proof is the classical three-stage argument.

1. If `log π = q` were rational then `π ^ q.den = e ^ q.num`, so `ℚ(π i, e)` would be algebraic
   over `ℚ(e)` and have transcendence degree at most `1`, against `H1`. So `log π` is irrational
   and `1, π i, log π` are linearly independent.
2. If `a + c log π + d e log π = 0` with rational `(a, c, d) ≠ 0`, then either `log π` is rational
   (`d = 0`) or `e ∈ ℚ(log π)` (`d ≠ 0`), and then `ℚ(π i, log π, e, π)` is algebraic over
   `ℚ(π i, log π)` and has transcendence degree at most `2`, against `H2`. So
   `1, π i, log π, e log π` are linearly independent.
3. If `π ^ e` were rational, the field of stage 3 would be algebraic over `ℚ(π i, log π, e)` and
   have transcendence degree at most `3`, against `H3`.

The upper bounds come from `trdeg_adjoin_le`: a field generated by a set whose elements are all
algebraic over the field generated by `m` of them has transcendence degree at most `m`.
No irrationality or transcendence result about `e` or `π` is used.
-/

namespace OMA.R_Irrational_irrational_pi_to_e_R1

open IntermediateField

/-- Schanuel's conjecture for `n = 2`. -/
def H1 : Prop :=
  ∀ z : Fin 2 → ℂ, LinearIndependent ℚ z →
    ((2 : ℕ) : Cardinal) ≤
      Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))

/-- Schanuel's conjecture for `n = 3`. -/
def H2 : Prop :=
  ∀ z : Fin 3 → ℂ, LinearIndependent ℚ z →
    ((3 : ℕ) : Cardinal) ≤
      Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))

/-- Schanuel's conjecture for `n = 4`. -/
def H3 : Prop :=
  ∀ z : Fin 4 → ℂ, LinearIndependent ℚ z →
    ((4 : ℕ) : Cardinal) ≤
      Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))

/-- A field generated by a set `S`, all of whose elements are algebraic over the field generated
by `m` of them, has transcendence degree at most `m`. -/
lemma trdeg_adjoin_le {S : Set ℂ} {m : ℕ} (t : Fin m → ℂ) (hTS : Set.range t ⊆ S)
    (halg : ∀ s ∈ S, IsAlgebraic (adjoin ℚ (Set.range t)) s) :
    Algebra.trdeg ℚ (adjoin ℚ S) ≤ (m : Cardinal) := by
  open IntermediateField.algebraAdjoinAdjoin in
  -- step 1: the polynomial ring surjects onto the subalgebra generated by `t`
  have h1 : Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range t)) ≤ (m : Cardinal) := by
    have hB : Algebra.adjoin ℚ (Set.range t) = (MvPolynomial.aeval t).range :=
      Algebra.adjoin_range_eq_range_aeval ℚ t
    let f : MvPolynomial (Fin m) ℚ →ₐ[ℚ] Algebra.adjoin ℚ (Set.range t) :=
      (MvPolynomial.aeval t).codRestrict _ (fun p => by rw [hB]; exact ⟨p, rfl⟩)
    have hf : Function.Surjective f := by
      rintro ⟨b, hb⟩
      rw [hB] at hb
      obtain ⟨p, hp⟩ := hb
      exact ⟨p, Subtype.ext hp⟩
    have := trdeg_le_of_surjective f hf
    rw [MvPolynomial.trdeg_of_isDomain] at this
    simpa using this
  -- step 2: `adjoin ℚ S` is an algebraic extension of that subalgebra
  have hBK : Algebra.adjoin ℚ (Set.range t) ≤ (adjoin ℚ S).toSubalgebra :=
    Algebra.adjoin_le (fun x hx => subset_adjoin ℚ S (hTS hx))
  let _ : Algebra (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    (Subalgebra.inclusion hBK).toAlgebra
  have : IsScalarTower ℚ (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.isScalarTower_left hBK _
  have : FaithfulSMul (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.faithfulSMul hBK
  have hle : adjoin ℚ S ≤ (algebraicClosure (adjoin ℚ (Set.range t)) ℂ).restrictScalars ℚ := by
    rw [adjoin_le_iff]
    intro s hs
    exact mem_algebraicClosure_iff.mpr (halg s hs)
  have : Algebra.IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) := by
    refine ⟨fun x => ?_⟩
    have hx : IsAlgebraic (adjoin ℚ (Set.range t)) (x : ℂ) :=
      mem_algebraicClosure_iff.mp (hle x.2)
    have hx' : IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (x : ℂ) :=
      (IsFractionRing.isAlgebraic_iff (Algebra.adjoin ℚ (Set.range t))
        (adjoin ℚ (Set.range t)) ℂ).mpr hx
    let g : (adjoin ℚ S) →ₐ[Algebra.adjoin ℚ (Set.range t)] ℂ :=
      { (adjoin ℚ S).val.toRingHom with commutes' := fun _ => rfl }
    exact (isAlgebraic_algHom_iff g Subtype.val_injective).mp hx'
  have h2 := trdeg_add_eq ℚ (Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S)
  rw [trdeg_eq_zero (R := Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S), add_zero] at h2
  rw [← h2]
  exact h1

/-- An element of an intermediate field is algebraic over it. -/
lemma alg_mem (F : IntermediateField ℚ ℂ) {x : ℂ} (hx : x ∈ F) : IsAlgebraic F x :=
  isAlgebraic_algebraMap (⟨x, hx⟩ : F)

/-- `I` is algebraic over every intermediate field. -/
lemma alg_I (F : IntermediateField ℚ ℂ) : IsAlgebraic F Complex.I := by
  refine IsAlgebraic.of_pow (n := 2) (by norm_num) ?_
  rw [Complex.I_sq]
  exact alg_mem F (neg_mem (one_mem F))

/-- If `π * I` lies in `F` then `π` is algebraic over `F`. -/
lemma alg_pi_of_pi_I (F : IntermediateField ℚ ℂ)
    (h : ((Real.pi : ℝ) : ℂ) * Complex.I ∈ F) : IsAlgebraic F ((Real.pi : ℝ) : ℂ) := by
  refine IsAlgebraic.of_pow (n := 2) (by norm_num) ?_
  have : ((Real.pi : ℝ) : ℂ) ^ 2 = -((((Real.pi : ℝ) : ℂ) * Complex.I) ^ 2) := by
    rw [mul_pow, Complex.I_sq]
    ring
  rw [this]
  exact alg_mem F (neg_mem (pow_mem h 2))

/-- If `log π = q` is rational then `π ^ q.den = e ^ q.num`. -/
lemma pi_pow_of_log_rat (q : ℚ) (hq : Real.log Real.pi = q) :
    Real.pi ^ q.den = Real.exp 1 ^ q.num := by
  have h1 : Real.pi = Real.exp (q : ℝ) := by
    rw [← hq, Real.exp_log Real.pi_pos]
  have hden : (q.den : ℝ) ≠ 0 := by exact_mod_cast q.den_pos.ne'
  have h2 : (q : ℝ) * q.den = q.num := by
    have : (q : ℝ) = (q.num : ℝ) / (q.den : ℝ) := by
      conv_lhs => rw [← Rat.num_div_den q]
      push_cast
      rfl
    rw [this]
    field_simp
  rw [h1, ← Real.exp_nat_mul, mul_comm, h2, ← Real.exp_one_rpow, Real.rpow_intCast]

/-- If `log π` is rational and `e ∈ F` then `π` is algebraic over `F`. -/
lemma alg_pi_of_log_rat (F : IntermediateField ℚ ℂ) (he : ((Real.exp 1 : ℝ) : ℂ) ∈ F) (q : ℚ)
    (hq : Real.log Real.pi = q) : IsAlgebraic F ((Real.pi : ℝ) : ℂ) := by
  refine IsAlgebraic.of_pow q.den_pos ?_
  have : ((Real.pi : ℝ) : ℂ) ^ q.den = ((Real.exp 1 : ℝ) : ℂ) ^ q.num := by
    exact_mod_cast congrArg (fun x : ℝ => (x : ℂ)) (pi_pow_of_log_rat q hq)
  rw [this]
  exact alg_mem F (zpow_mem he _)

lemma exp_one_eq : Complex.exp 1 = ((Real.exp 1 : ℝ) : ℂ) := by
  rw [Complex.ofReal_exp]
  simp

lemma exp_log_pi : Complex.exp ((Real.log Real.pi : ℝ) : ℂ) = ((Real.pi : ℝ) : ℂ) := by
  rw [← Complex.ofReal_exp, Real.exp_log Real.pi_pos]

lemma exp_e_log_pi :
    Complex.exp (((Real.exp 1 : ℝ) : ℂ) * ((Real.log Real.pi : ℝ) : ℂ)) =
      ((Real.pi ^ Real.exp 1 : ℝ) : ℂ) := by
  rw [← Complex.ofReal_mul, ← Complex.ofReal_exp, Real.rpow_def_of_pos Real.pi_pos, mul_comm]

/-- Algebraicity of every generator of the Schanuel field, checked coordinate by coordinate. -/
lemma alg_union {n : ℕ} (F : IntermediateField ℚ ℂ) (z : Fin n → ℂ)
    (h1 : ∀ i, IsAlgebraic F (z i)) (h2 : ∀ i, IsAlgebraic F (Complex.exp (z i))) :
    ∀ s ∈ Set.range z ∪ Set.range (Complex.exp ∘ z), IsAlgebraic F s := by
  rintro s (⟨i, rfl⟩ | ⟨i, rfl⟩)
  · exact h1 i
  · exact h2 i

/-- Real and imaginary parts of `x + y i = 0`. -/
lemma re_im_of (x y : ℝ) (h : (x : ℂ) + (y : ℂ) * Complex.I = 0) : x = 0 ∧ y = 0 := by
  have h' := Complex.ext_iff.mp h
  simpa using h'

lemma lin2 : LinearIndependent ℚ ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hg' : g 0 • (1 : ℂ) + g 1 • (((Real.pi : ℝ) : ℂ) * Complex.I) = 0 := by
    rw [Fin.sum_univ_two] at hg
    exact hg
  have key : (((g 0 : ℝ) : ℝ) : ℂ) + (((g 1 : ℝ) * Real.pi : ℝ) : ℂ) * Complex.I = 0 := by
    rw [← hg']
    simp only [Rat.smul_def]
    push_cast
    ring
  obtain ⟨hx, hy⟩ := re_im_of _ _ key
  have h1 : g 1 = 0 := by
    rcases mul_eq_zero.mp hy with h | h
    · exact_mod_cast h
    · exact absurd h Real.pi_ne_zero
  have h0 : g 0 = 0 := by exact_mod_cast hx
  intro i
  fin_cases i
  · exact h0
  · exact h1

lemma lin3 (h : ∀ q : ℚ, Real.log Real.pi ≠ q) :
    LinearIndependent ℚ
      ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ)] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hg' : g 0 • (1 : ℂ) + g 1 • (((Real.pi : ℝ) : ℂ) * Complex.I) +
      g 2 • ((Real.log Real.pi : ℝ) : ℂ) = 0 := by
    rw [Fin.sum_univ_three] at hg
    exact hg
  have key : (((g 0 : ℝ) + g 2 * Real.log Real.pi : ℝ) : ℂ) +
      (((g 1 : ℝ) * Real.pi : ℝ) : ℂ) * Complex.I = 0 := by
    rw [← hg']
    simp only [Rat.smul_def]
    push_cast
    ring
  obtain ⟨hx, hy⟩ := re_im_of _ _ key
  have h1 : g 1 = 0 := by
    rcases mul_eq_zero.mp hy with h | h
    · exact_mod_cast h
    · exact absurd h Real.pi_ne_zero
  have h2 : g 2 = 0 := by
    by_contra hne
    have hneR : (g 2 : ℝ) ≠ 0 := by exact_mod_cast hne
    apply h (-g 0 / g 2)
    push_cast
    field_simp
    linarith
  have h0 : g 0 = 0 := by
    rw [h2] at hx
    simp only [Rat.cast_zero, zero_mul, add_zero] at hx
    exact_mod_cast hx
  intro i
  fin_cases i
  · exact h0
  · exact h1
  · exact h2

lemma lin4
    (h : ∀ a c d : ℚ,
      (a : ℝ) + c * Real.log Real.pi + d * (Real.exp 1 * Real.log Real.pi) = 0 →
        a = 0 ∧ c = 0 ∧ d = 0) :
    LinearIndependent ℚ
      ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ),
        ((Real.exp 1 : ℝ) : ℂ) * ((Real.log Real.pi : ℝ) : ℂ)] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hg' : g 0 • (1 : ℂ) + g 1 • (((Real.pi : ℝ) : ℂ) * Complex.I) +
      g 2 • ((Real.log Real.pi : ℝ) : ℂ) +
      g 3 • (((Real.exp 1 : ℝ) : ℂ) * ((Real.log Real.pi : ℝ) : ℂ)) = 0 := by
    rw [Fin.sum_univ_four] at hg
    exact hg
  have key : (((g 0 : ℝ) + g 2 * Real.log Real.pi +
      g 3 * (Real.exp 1 * Real.log Real.pi) : ℝ) : ℂ) +
      (((g 1 : ℝ) * Real.pi : ℝ) : ℂ) * Complex.I = 0 := by
    rw [← hg']
    simp only [Rat.smul_def]
    push_cast
    ring
  obtain ⟨hx, hy⟩ := re_im_of _ _ key
  have h1 : g 1 = 0 := by
    rcases mul_eq_zero.mp hy with h | h
    · exact_mod_cast h
    · exact absurd h Real.pi_ne_zero
  obtain ⟨h0, h2, h3⟩ := h (g 0) (g 2) (g 3) hx
  intro i
  fin_cases i
  · exact h0
  · exact h1
  · exact h2
  · exact h3

/-- Stage 1: Schanuel for `(1, π i)` makes `log π` irrational. -/
lemma log_pi_not_rat (h1 : H1) (q : ℚ) : Real.log Real.pi ≠ q := by
  intro hq
  have lower := h1 _ lin2
  have he : ((Real.exp 1 : ℝ) : ℂ) ∈ adjoin ℚ (Set.range ![((Real.exp 1 : ℝ) : ℂ)]) :=
    subset_adjoin ℚ _ ⟨0, rfl⟩
  have upper := trdeg_adjoin_le
    (S := Set.range ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I] ∪
      Set.range (Complex.exp ∘ ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I]))
    ![((Real.exp 1 : ℝ) : ℂ)]
    (by
      rintro _ ⟨i, rfl⟩
      fin_cases i
      exact Or.inr ⟨0, exp_one_eq⟩)
    (alg_union _ _
      (fun i => by
        fin_cases i
        · exact alg_mem _ (one_mem _)
        · exact (alg_pi_of_log_rat _ he q hq).mul (alg_I _))
      (fun i => by
        fin_cases i
        · show IsAlgebraic _ (Complex.exp 1)
          rw [exp_one_eq]
          exact alg_mem _ he
        · show IsAlgebraic _ (Complex.exp (((Real.pi : ℝ) : ℂ) * Complex.I))
          rw [Complex.exp_pi_mul_I]
          exact alg_mem _ (neg_mem (one_mem _))))
  have h21 : (2 : ℕ) ≤ 1 := by exact_mod_cast lower.trans upper
  omega

/-- Stage 2: Schanuel for `(1, π i, log π)` excludes every rational relation between
`1`, `log π` and `e log π`. -/
lemma rel_e_log (h1 : H1) (h2 : H2) (a c d : ℚ)
    (h : (a : ℝ) + c * Real.log Real.pi + d * (Real.exp 1 * Real.log Real.pi) = 0) :
    a = 0 ∧ c = 0 ∧ d = 0 := by
  by_cases hd : d = 0
  · subst hd
    by_cases hc : c = 0
    · subst hc
      simp only [Rat.cast_zero, zero_mul, add_zero] at h
      exact ⟨by exact_mod_cast h, rfl, rfl⟩
    · exfalso
      have hcR : (c : ℝ) ≠ 0 := by exact_mod_cast hc
      apply log_pi_not_rat h1 (-a / c)
      simp only [Rat.cast_zero, zero_mul, add_zero] at h
      push_cast
      field_simp
      linarith
  · exfalso
    have hdR : (d : ℝ) ≠ 0 := by exact_mod_cast hd
    have hL : Real.log Real.pi ≠ 0 :=
      (Real.log_pos (by linarith [Real.pi_gt_three])).ne'
    have heq : Real.exp 1 = -((a : ℝ) + c * Real.log Real.pi) / (d * Real.log Real.pi) := by
      field_simp
      linarith
    have hpiI : ((Real.pi : ℝ) : ℂ) * Complex.I ∈ adjoin ℚ (Set.range
        ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ)]) :=
      subset_adjoin ℚ _ ⟨0, rfl⟩
    have hLF : ((Real.log Real.pi : ℝ) : ℂ) ∈ adjoin ℚ (Set.range
        ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ)]) :=
      subset_adjoin ℚ _ ⟨1, rfl⟩
    have he : ((Real.exp 1 : ℝ) : ℂ) ∈ adjoin ℚ (Set.range
        ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ)]) := by
      rw [heq]
      push_cast
      exact div_mem (neg_mem (add_mem (SubfieldClass.ratCast_mem _ a) (mul_mem (SubfieldClass.ratCast_mem _ c) hLF)))
        (mul_mem (SubfieldClass.ratCast_mem _ d) hLF)
    have lower := h2 _ (lin3 (log_pi_not_rat h1))
    have upper := trdeg_adjoin_le
      (S := Set.range ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I,
          ((Real.log Real.pi : ℝ) : ℂ)] ∪
        Set.range (Complex.exp ∘ ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I,
          ((Real.log Real.pi : ℝ) : ℂ)]))
      ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ)]
      (by
        rintro _ ⟨i, rfl⟩
        fin_cases i
        · exact Or.inl ⟨1, rfl⟩
        · exact Or.inl ⟨2, rfl⟩)
      (alg_union _ _
        (fun i => by
          fin_cases i
          · exact alg_mem _ (one_mem _)
          · exact alg_mem _ hpiI
          · exact alg_mem _ hLF)
        (fun i => by
          fin_cases i
          · show IsAlgebraic _ (Complex.exp 1)
            rw [exp_one_eq]
            exact alg_mem _ he
          · show IsAlgebraic _ (Complex.exp (((Real.pi : ℝ) : ℂ) * Complex.I))
            rw [Complex.exp_pi_mul_I]
            exact alg_mem _ (neg_mem (one_mem _))
          · show IsAlgebraic _ (Complex.exp ((Real.log Real.pi : ℝ) : ℂ))
            rw [exp_log_pi]
            exact alg_pi_of_pi_I _ hpiI))
    have h32 : (3 : ℕ) ≤ 2 := by exact_mod_cast lower.trans upper
    omega

/-- Stage 3: if `π ^ e` is rational, the Schanuel field of `(1, π i, log π, e log π)` has
transcendence degree at most 3. -/
lemma final_bound (r : ℚ) (hr : Real.pi ^ Real.exp 1 = r) :
    Algebra.trdeg ℚ (adjoin ℚ
      (Set.range ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ),
          ((Real.exp 1 : ℝ) : ℂ) * ((Real.log Real.pi : ℝ) : ℂ)] ∪
        Set.range (Complex.exp ∘ ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I,
          ((Real.log Real.pi : ℝ) : ℂ),
          ((Real.exp 1 : ℝ) : ℂ) * ((Real.log Real.pi : ℝ) : ℂ)]))) ≤ ((3 : ℕ) : Cardinal) := by
  have hpiI : ((Real.pi : ℝ) : ℂ) * Complex.I ∈ adjoin ℚ (Set.range
      ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ),
        ((Real.exp 1 : ℝ) : ℂ)]) :=
    subset_adjoin ℚ _ ⟨0, rfl⟩
  have hLF : ((Real.log Real.pi : ℝ) : ℂ) ∈ adjoin ℚ (Set.range
      ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ),
        ((Real.exp 1 : ℝ) : ℂ)]) :=
    subset_adjoin ℚ _ ⟨1, rfl⟩
  have he : ((Real.exp 1 : ℝ) : ℂ) ∈ adjoin ℚ (Set.range
      ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ),
        ((Real.exp 1 : ℝ) : ℂ)]) :=
    subset_adjoin ℚ _ ⟨2, rfl⟩
  exact trdeg_adjoin_le
    ![((Real.pi : ℝ) : ℂ) * Complex.I, ((Real.log Real.pi : ℝ) : ℂ), ((Real.exp 1 : ℝ) : ℂ)]
    (by
      rintro _ ⟨i, rfl⟩
      fin_cases i
      · exact Or.inl ⟨1, rfl⟩
      · exact Or.inl ⟨2, rfl⟩
      · exact Or.inr ⟨0, exp_one_eq⟩)
    (alg_union _ _
      (fun i => by
        fin_cases i
        · exact alg_mem _ (one_mem _)
        · exact alg_mem _ hpiI
        · exact alg_mem _ hLF
        · exact alg_mem _ (mul_mem he hLF))
      (fun i => by
        fin_cases i
        · show IsAlgebraic _ (Complex.exp 1)
          rw [exp_one_eq]
          exact alg_mem _ he
        · show IsAlgebraic _ (Complex.exp (((Real.pi : ℝ) : ℂ) * Complex.I))
          rw [Complex.exp_pi_mul_I]
          exact alg_mem _ (neg_mem (one_mem _))
        · show IsAlgebraic _ (Complex.exp ((Real.log Real.pi : ℝ) : ℂ))
          rw [exp_log_pi]
          exact alg_pi_of_pi_I _ hpiI
        · show IsAlgebraic _ (Complex.exp
