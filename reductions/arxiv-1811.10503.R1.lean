import OMAStatements.S_arxiv_1811_10503
import Mathlib

/-! The numbering exists in every linearly ordered abelian group. Sort by
multiplicative absolute value, breaking ties by the element itself. The
residual case consists of groups without a compatible abelian order. -/
namespace OMA.R_arxiv_1811_10503_R1


def H1 : Prop := ∀ (G : Type) [CommGroup G] [LinearOrder G] [IsOrderedMonoid G],
  ∀ (n : ℕ) (A : Finset G), A.card = n →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val+1))

def H2 : Prop := ∀ n : ℕ, 0 < n → ∀ (G : Type) [Group G],
  (¬ ((∀ a b : G, a*b=b*a) ∧ ∃ o : LinearOrder G,
    ∀ x y z : G, o.le x y → o.le (z*x) (z*y))) →
  (∀ g : G, orderOf g ∉ Finset.Icc 2 (n+1)) → ∀ A : Finset G, A.card = n →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val+1))

theorem smallCase : H1 → H2 → ∀ n : ℕ, 0 < n → ∀ (G : Type) [Group G],
  (∀ g : G, orderOf g ∉ Finset.Icc 2 (n+1)) → ∀ A : Finset G, A.card = n →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val+1)) := by
  intro ordered rest n hn G ginst horder A hA
  by_cases h : (∀ a b : G, a*b=b*a) ∧ ∃ o : LinearOrder G,
      ∀ x y z : G, o.le x y → o.le (z*x) (z*y)
  · obtain ⟨comm,o,mono⟩ := h
    letI : CommGroup G := { ginst with mul_comm := comm }
    letI : LinearOrder G := o
    haveI : IsOrderedMonoid G := { mul_le_mul_left := fun x y h z => by simpa [mul_comm] using mono x y z h }
    exact ordered G n A hA
  · exact rest n hn G h horder A hA

/-- The subgroup generated by A is the image of the free group on n letters.
Using its kernel quotient keeps both reduced statements in a fixed universe. -/
theorem main : H1 → H2 → type_of% @OMA.S_arxiv_1811_10503.main := by
  classical
  intro h1 h2 n hn G _ hord A hA
  let e : Fin n ≃ A := (Finset.equivFinOfCardEq hA).symm
  let φ : FreeGroup (Fin n) →* G := FreeGroup.lift (fun i => (e i : G))
  let Q := FreeGroup (Fin n) ⧸ φ.ker
  let ι : Q →* G := QuotientGroup.kerLift φ
  have hi : Function.Injective ι := QuotientGroup.kerLift_injective _
  let g (i : Fin n) : Q := QuotientGroup.mk (FreeGroup.of i)
  have he (i : Fin n) : ι (g i) = (e i : G) := by
    change QuotientGroup.kerLift φ (QuotientGroup.mk (FreeGroup.of i)) = _
    rw [QuotientGroup.kerLift_mk]
    exact FreeGroup.lift_apply_of
  have hg : Function.Injective g := by
    intro i j h
    apply e.injective
    apply Subtype.ext
    rw [← he, ← he, h]
  let B := Finset.univ.image g
  have hB : B.card = n := by simp [B,Finset.card_image_of_injective _ hg]
  have hQ (q : Q) : orderOf q ∉ Finset.Icc 2 (n+1) := by
    rw [← orderOf_injective ι hi]; exact hord _
  obtain ⟨b,hb,hr,hp⟩ := smallCase h1 h2 n hn Q hQ B hB
  refine ⟨ι ∘ b,hi.comp hb,?_,?_⟩
  · rw [Set.range_comp,hr]
    ext x
    constructor
    · rintro ⟨q,hq,rfl⟩
      obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hq
      rw [he]
      exact (e i).property
    · intro hx
      let i := e.symm ⟨x,hx⟩
      refine ⟨g i,Finset.mem_image_of_mem _ (Finset.mem_univ _),?_⟩
      simp [he,i]
  · intro i j h
    apply hp
    apply hi
    simpa only [map_pow,Function.comp_apply] using h

end OMA.R_arxiv_1811_10503_R1
