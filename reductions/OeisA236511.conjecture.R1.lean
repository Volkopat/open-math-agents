import FormalConjectures.OEIS.«236511»

-- Reduction OeisA236511.conjecture.R1 of Prime quadruplets generated by $p = 3\phi(k) + \phi(n-k) - 1$
-- Credit: @eltociear
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# Prime quadruplets from `3 phi(k) + phi(n - k) - 1`: the searched range and the open tail

`a n` counts the integers `0 < k < n` for which
`p = 3 * phi k + phi (n - k) - 1` makes `p`, `p + 2`, `p + 6`, `p + 8` all prime, that is, a prime
quadruplet `(p, p + 2, p + 6, p + 8)`. Sun's conjecture is that `a n > 0` for every `n > 1075`.

For a fixed `n` the count is a finite search over `k < n`, so every single `n` is decided by
computation; what is open is a uniform argument. As the entry says, the conjecture implies that
there are infinitely many prime quadruplets, so no known argument reaches it.

The OEIS entry A236511 records exactly how far the computation was pushed: `a(n) > 0` for all
`n > 1075` was verified for `n` up to `50000` (Zhi-Wei Sun; the entry carries a table of `a(n)` for
`n = 1..10000`). Beyond a finite search there is no proof. So the conjecture splits at the end of
the verified range:

* `H1` (searched range): `1075 < n <= 50000` has `a n > 0`. Finite: for each `n` at most `n - 1`
  quadruplet tests of numbers below `3 * 50000`.
* `H2` (the open tail): `50000 < n` has `a n > 0`. Nothing is known here: it contains the
  infinitude of prime quadruplets, which is open.

Neither hypothesis mentions the target, the other one, or `main`; `main` is the case split, with no
upstream lemma, so nothing depends on a `decide`-style proof of an upstream statement.
-/

namespace OMA.R_OeisA236511_conjecture_R1

/-- The searched range: every `n` with `1075 < n <= 50000` has a witness `k < n` for which
`p = 3 * phi k + phi (n - k) - 1` gives the prime quadruplet `p, p + 2, p + 6, p + 8`
(OEIS A236511: the conjecture `a(n) > 0` for `n > 1075` was verified for `n` up to `50000`). -/
def H1 : Prop :=
  ∀ n : ℕ, 1075 < n → n ≤ 50000 → 0 < OeisA236511.a n

/-- The open tail: every `n > 50000` has such a witness. This range contains the (open) statement
that there are infinitely many prime quadruplets, so no argument is known for it. -/
def H2 : Prop :=
  ∀ n : ℕ, 50000 < n → 0 < OeisA236511.a n

theorem main : H1 → H2 → type_of% @OeisA236511.conjecture := by
  intro h1 h2 n hn
  by_cases h : n ≤ 50000
  · exact h1 n hn h
  · exact h2 n (Nat.lt_of_not_le h)

end OMA.R_OeisA236511_conjecture_R1
