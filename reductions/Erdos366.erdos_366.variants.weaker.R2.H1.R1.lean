set_option maxRecDepth 20000 in
private theorem t_disjoint : evTree.all (fun x => !odTree.contains (x - 1) && !odTree.contains (x + 1)) = true := by
  decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private theorem t_gen : loopC evTree odTree 10000000001 318 2156 102 1 = true := by
  decide +kernel

/-- Unconditional kernel exclusion of every consecutive 3-full pair `n, n+1` with `0 < n ≤ 10^10`. -/
theorem no_pair_le_1e10 : ¬ ∃ n : ℕ, 0 < n ∧ n ≤ 10000000000 ∧ Nat.Full 3 n ∧ Nat.Full 3 (n + 1) := by
  rintro ⟨n, hn, hle, hfn, hfn1⟩
  exact no_pair_of_cert evTree odTree 10000000001 318 2156 102
    (by decide) (by decide) (by decide) t_disjoint t_gen n hn (by omega) hfn hfn1

private theorem full_three_of_abc (a b c : ℕ) : Nat.Full 3 (a ^ 3 * b ^ 4 * c ^ 5) := by
  intro p hp
  have hp' := Nat.mem_primeFactors.mp hp
  rcases hp'.1.dvd_mul.mp hp'.2.1 with hab | hc
  · rcases hp'.1.dvd_mul.mp hab with ha | hb
    · exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_left (pow_dvd_pow_of_dvd (hp'.1.dvd_of_dvd_pow ha) 3) _) _
    · exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (pow_dvd_pow_of_dvd_of_le (hp'.1.dvd_of_dvd_pow hb) (by decide)) _) _
  · exact dvd_mul_of_dvd_right
      (pow_dvd_pow_of_dvd_of_le (hp'.1.dvd_of_dvd_pow hc) (by decide)) _

/-- Necessity: any witness to `R2.H1` yields an integral point satisfying `H1`,
in particular with `10^10 < n`, `1 < K`, and `2 ∣ u`. -/
theorem elliptic_of_r2h1 : OMA.R_Erdos366_erdos_366_variants_weaker_R2.H1 → H1 := by
  rintro ⟨a, b, c, d, e, f, ha, hb, hc, _hd, _he, _hf, _, hEq⟩
  set n := a ^ 3 * b ^ 4 * c ^ 5 with hn_def
  have hn_pos : 0 < n := by positivity
  have hfn : Nat.Full 3 n := full_three_of_abc a b c
  have hfn1 : Nat.Full 3 (n + 1) := by
    rw [hn_def, hEq]
    exact full_three_of_abc d e f
  have hgt : 10000000000 < n := by
    by_contra hle
    exact no_pair_le_1e10 ⟨n, hn_pos, by omega, hfn, hfn1⟩
  obtain ⟨K, U, hK1, hUpos, h2U, hec, _, hrad_cf⟩ :=
    elliptic_of_consecutive_full n hn_pos hfn hfn1
