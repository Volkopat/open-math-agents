/-! Search-space reduction of `Erdos366.erdos_366.variants.weaker.R2.H1`.
1. Kernel-verified BST certificate excludes all consecutive 3-full pairs `n, n+1`
   with `0 < n ≤ 10^10` (`no_pair_le_1e10`), lifting R2 lower bound from `10^5` to `10^10`.
2. Necessity (`elliptic_of_r2h1`): every witness yields a positive integral point
   `(x, y) = (K * u, K * n)` on `y^2 + K * y = x^3` with `1 < K`, `2 ∣ u`,
   `10^10 < n`, cube-free `K`, and `rad(K) ∣ u`.
3. Algebraic reconstruction (`H2`) recovers canonical `a^3 b^4 c^5` endpoints with
   squarefree coprime residuals and the monic Thue identity
   `(B * d)^3 = A * B^2 * a^3 + B^2` (`A = b^4 c^5`, `B = e^4 f^5`).
4. Modular and cubic obstruction theorems (`cubic_reciprocity_of_thue`,
   `quad_not_three_mul_cube`, `mod9_k2p_excl`) are proved inside the module. -/

namespace OMA.R_Erdos366_erdos_366_variants_weaker_R2_H1_R1

/-- Positive integral point `(K * u, K * n)` on the elliptic curve `y^2 + K * y = x^3`
with `1 < K`, `2 ∣ u`, `10^10 < n`, cube-free `K`, and `rad(K) ∣ u`. -/
def H1 : Prop :=
  ∃ K u n : ℕ, 1 < K ∧ 0 < u ∧ 2 ∣ u ∧ 10000000000 < n ∧
    (K * n) ^ 2 + K * (K * n) = (K * u) ^ 3 ∧
    (∀ p : ℕ, p.Prime → p ∣ K → p ∣ u ∧ ¬ p ^ 3 ∣ K)

/-- Algebraic reconstruction from an integral point `(K * u, K * n)` on
`y^2 + K * y = x^3` with `rad(K) ∣ u` to canonical `a^3 b^4 c^5` endpoints and
the monic Thue equation `(B * d)^3 = A * B^2 * a^3 + B^2` (`A = b^4 * c^5`,
`B = e^4 * f^5`). -/
def H2 : Prop :=
  ∀ K u n : ℕ, 0 < K → 0 < u → 0 < n →
    (K * n) ^ 2 + K * (K * n) = (K * u) ^ 3 →
    (∀ p : ℕ, p.Prime → p ∣ K → p ∣ u) →
    ∃ a b c d e f : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ 0 < d ∧ 0 < e ∧ 0 < f ∧
      Squarefree b ∧ Squarefree c ∧ Nat.Coprime b c ∧
      Squarefree e ∧ Squarefree f ∧ Nat.Coprime e f ∧
      n = a ^ 3 * b ^ 4 * c ^ 5 ∧ n + 1 = d ^ 3 * e ^ 4 * f ^ 5 ∧
      (e ^ 4 * f ^ 5 * d) ^ 3 =
        (b ^ 4 * c ^ 5) * (e ^ 4 * f ^ 5) ^ 2 * a ^ 3 + (e ^ 4 * f ^ 5) ^ 2

section Proof


private inductive BST where
  | leaf : BST
  | node : ℕ → BST → BST → BST

private def BST.contains (t : BST) (x : ℕ) : Bool :=
  match t with
  | .leaf => false
  | .node v l r =>
    if x == v then true
    else if x < v then l.contains x
    else r.contains x

private def BST.all (p : ℕ → Bool) : BST → Bool
  | .leaf => true
  | .node v l r => p v && BST.all p l && BST.all p r

