private def bst_od : BST := BST.node 1341919727 bst_odL bst_odR

private def evTree : BST := bst_ev
private def odTree : BST := bst_od

private def loopA (evT odT : BST) (bc lim : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | f + 1, a =>
    let v := a * a * a * bc
    if lim < v then true
    else
      let ok := if v % 2 == 0 then evT.contains v
                else if v % 8 == 1 || v % 8 == 7 then odT.contains v
                else true
      ok && loopA evT odT bc lim f (a + 1)

private def loopB (evT odT : BST) (c c5 lim maxA : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | f + 1, b =>
    let b2 := b * b
    let bc := b2 * b2 * c5
    if lim < bc then true
    else
      let ok := if Nat.gcd b c == 1 then loopA evT odT bc lim maxA 1 else true
      ok && loopB evT odT c c5 lim maxA f (b + 1)

private def loopC (evT odT : BST) (lim maxB maxA : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | f + 1, c =>
    let c2 := c * c
    let c5 := c2 * c2 * c
    if lim < c5 then true
    else
      loopB evT odT c c5 lim maxA maxB 1 && loopC evT odT lim maxB maxA f (c + 1)


private theorem cube_full_canonical (n : ℕ) : 0 < n → (3).Full n →
    ∃ a b c : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ Squarefree b ∧ Squarefree c ∧ Nat.Coprime b c ∧
      n = a ^ 3 * b ^ 4 * c ^ 5 := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro hn hfull
    by_cases hn1 : n = 1
    · refine ⟨1, 1, 1, Nat.one_pos, Nat.one_pos, Nat.one_pos, squarefree_one, squarefree_one, ?_, ?_⟩
      · simp
      · simp [hn1]
    · let p := n.minFac
      have hp : p.Prime := Nat.minFac_prime hn1
      have hpn : p ∣ n := Nat.minFac_dvd n
      have hpf : p ∈ n.primeFactors := Nat.mem_primeFactors.mpr ⟨hp, hpn, hn.ne'⟩
      have hp3 : p ^ 3 ∣ n := hfull p hpf
      let k := n.factorization p
      have hk3 : 3 ≤ k := by
        rw [← hp.pow_dvd_iff_le_factorization hn.ne']
        exact hp3
      have hpk_dvd : p ^ k ∣ n := hp.pow_dvd_iff_le_factorization hn.ne' |>.mpr le_rfl
      have hpk1_ndvd : ¬ p ^ (k + 1) ∣ n := by
        rw [hp.pow_dvd_iff_le_factorization hn.ne']
        omega
      set m := n / p ^ k with hm_def
      have hdecomp : n = p ^ k * m := (Nat.mul_div_cancel' hpk_dvd).symm
      have hm_pos : 0 < m := Nat.div_pos (Nat.le_of_dvd hn hpk_dvd) (pow_pos hp.pos k)
      have hp_ndvd_m : ¬ p ∣ m := by
        intro hpm
        apply hpk1_ndvd
        rw [hdecomp, pow_succ]
        exact mul_dvd_mul_left (p ^ k) hpm
      have hp_pow_gt : 1 < p ^ k := one_lt_pow₀ hp.one_lt (by omega)
      have hm_lt : m < n := by
        calc m = 1 * m := (one_mul m).symm
        _ < p ^ k * m := mul_lt_mul_of_pos_right hp_pow_gt hm_pos
        _ = n := hdecomp.symm
      have hm_full : (3).Full m := by
        intro r hr
        have hr_mem := Nat.mem_primeFactors.mp hr
        have hr_ne : r ≠ p := by
          intro hEq
          subst hEq
          exact hp_ndvd_m hr_mem.2.1
        have hr_n : r ∈ n.primeFactors := Nat.mem_primeFactors.mpr
          ⟨hr_mem.1, hr_mem.2.1.trans (by rw [hdecomp]; exact dvd_mul_left _ _), hn.ne'⟩
        have hr3_n : r ^ 3 ∣ p ^ k * m := hdecomp ▸ hfull r hr_n
        have hcop_rp : (r ^ 3).Coprime (p ^ k) :=
          ((hr_mem.1.coprime_iff_not_dvd.mpr fun h =>
            hr_ne ((hp.dvd_iff_eq hr_mem.1.ne_one).mp h).symm).pow_left 3).pow_right k
        exact hcop_rp.dvd_of_dvd_mul_left hr3_n
      obtain ⟨a', b', c', ha', hb', hc', hsb', hsc', hbc', hm_eq⟩ := ih m hm_lt hm_pos hm_full
      have hpb' : ¬ p ∣ b' := fun h => hp_ndvd_m
        (hm_eq ▸ dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (dvd_pow h (by decide)) _) _)
      have hpc' : ¬ p ∣ c' := fun h => hp_ndvd_m
        (hm_eq ▸ dvd_mul_of_dvd_right (dvd_pow h (by decide)) _)
      have hcop_pb' : p.Coprime b' := hp.coprime_iff_not_dvd.mpr hpb'
      have hcop_pc' : p.Coprime c' := hp.coprime_iff_not_dvd.mpr hpc'
      have hmod : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
      rcases hmod with h0 | h1 | h2
      · refine ⟨a' * p ^ (k / 3), b', c', mul_pos ha' (pow_pos hp.pos _), hb', hc', hsb', hsc', hbc', ?_⟩
        calc n = p ^ k * m := hdecomp
        _ = (p ^ (k / 3)) ^ 3 * (a' ^ 3 * b' ^ 4 * c' ^ 5) := by
          rw [hm_eq, ← pow_mul]; congr 2; omega
        _ = (a' * p ^ (k / 3)) ^ 3 * b' ^ 4 * c' ^ 5 := by ring
      · refine ⟨a' * p ^ (k / 3 - 1), b' * p, c', mul_pos ha' (pow_pos hp.pos _),
          mul_pos hb' hp.pos, hc', ?_, hsc', ?_, ?_⟩
        · exact (Nat.squarefree_mul hcop_pb'.symm).mpr ⟨hsb', hp.squarefree⟩
        · exact hbc'.mul_left hcop_pc'
        · calc n = p ^ k * m := hdecomp
          _ = p ^ (3 * (k / 3 - 1) + 4) * (a' ^ 3 * b' ^ 4 * c' ^ 5) := by
            rw [hm_eq]; congr 2; omega
          _ = (a' * p ^ (k / 3 - 1)) ^ 3 * (b' * p) ^ 4 * c' ^ 5 := by ring
      · refine ⟨a' * p ^ (k / 3 - 1), b', c' * p, mul_pos ha' (pow_pos hp.pos _),
          hb', mul_pos hc' hp.pos, hsb', ?_, ?_, ?_⟩
        · exact (Nat.squarefree_mul hcop_pc'.symm).mpr ⟨hsc', hp.squarefree⟩
        · exact hbc'.mul_right hcop_pb'.symm
        · calc n = p ^ k * m := hdecomp
          _ = p ^ (3 * (k / 3 - 1) + 5) * (a' ^ 3 * b' ^ 4 * c' ^ 5) := by
            rw [hm_eq]; congr 2; omega
          _ = (a' * p ^ (k / 3 - 1)) ^ 3 * b' ^ 4 * (c' * p) ^ 5 := by ring

theorem eight_dvd_mul_succ_of_full (n : ℕ) (hn : 0 < n) (hfn : (3).Full n) (hfn1 : (3).Full (n + 1)) :
    8 ∣ n * (n + 1) := by
  by_cases hn_even : 2 ∣ n
  · have h8 : 8 ∣ n := by
      have hp2 : 2 ∈ n.primeFactors := Nat.mem_primeFactors.mpr ⟨Nat.prime_two, hn_even, hn.ne'⟩
      simpa using hfn 2 hp2
    exact h8.mul_right (n + 1)
  · have hn1_even : 2 ∣ n + 1 := by omega
    have h8 : 8 ∣ n + 1 := by
      have hp2 : 2 ∈ (n + 1).primeFactors :=
        Nat.mem_primeFactors.mpr ⟨Nat.prime_two, hn1_even, (Nat.succ_pos n).ne'⟩
      simpa using hfn1 2 hp2
    exact h8.mul_left n

theorem elliptic_of_consecutive_full (n : ℕ) (hn : 0 < n) (hfn : (3).Full n) (hfn1 : (3).Full (n + 1)) :
    ∃ K U : ℕ, 1 < K ∧ 0 < U ∧ 2 ∣ U ∧ (K * n) ^ 2 + K * (K * n) = (K * U) ^ 3 ∧
      8 ∣ K * U ^ 3 ∧ (∀ p, p.Prime → p ∣ K → p ∣ U ∧ ¬ p ^ 3 ∣ K) := by
  let M := n * (n + 1)
  have hM : 0 < M := mul_pos hn (Nat.succ_pos n)
  have hM_full : (3).Full M := by
    intro p hp
    have hp_prime := (Nat.mem_primeFactors.mp hp).1
    rcases hp_prime.dvd_mul.mp (Nat.dvd_of_mem_primeFactors hp) with h | h
    · exact (hfn p (Nat.mem_primeFactors.mpr ⟨hp_prime, h, hn.ne'⟩)).trans (dvd_mul_right _ _)
    · exact (hfn1 p (Nat.mem_primeFactors.mpr ⟨hp_prime, h, (Nat.succ_pos n).ne'⟩)).trans (dvd_mul_left _ _)
  obtain ⟨u, b, c, hu, hb, hc, hsb, hsc, hbc, hMeq⟩ := cube_full_canonical M hM hM_full
  have hKM : b * c ^ 2 * (u * b * c) ^ 3 = M := by
    calc b * c ^ 2 * (u * b * c) ^ 3 = u ^ 3 * b ^ 4 * c ^ 5 := by ring
    _ = M := hMeq.symm
  have h8 : 8 ∣ b * c ^ 2 * (u * b * c) ^ 3 := by
    rw [hKM]
    exact eight_dvd_mul_succ_of_full n hn hfn hfn1
  have hrad_and_cf : ∀ p, p.Prime → p ∣ b * c ^ 2 → p ∣ u * b * c ∧ ¬ p ^ 3 ∣ b * c ^ 2 := by
    intro p hp hpdvd
    refine ⟨?_, ?_⟩
    · rcases hp.dvd_mul.mp hpdvd with hpb | hpc2
      · exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_right hpb _) _
      · exact dvd_mul_of_dvd_right (hp.dvd_of_dvd_pow hpc2) _
    · intro hp3
      by_cases hpb : p ∣ b
      · have hnd_c : ¬ p ∣ c := fun hpc => hp.not_dvd_one (hbc.gcd_eq_one ▸ Nat.dvd_gcd hpb hpc)
        have hcop : (p ^ 3).Coprime (c ^ 2) := ((hp.coprime_iff_not_dvd.mpr hnd_c).pow_left 3).pow_right 2
        have hp3_b : p ^ 3 ∣ b := hcop.dvd_of_dvd_mul_right hp3
        have hp2_b : p ^ 2 ∣ b := (pow_dvd_pow p (by decide : 2 ≤ 3)).trans hp3_b
        exact hp.ne_one (Nat.isUnit_iff.mp (hsb p (by simpa [sq] using hp2_b)))
      · have hcop : (p ^ 3).Coprime b := (hp.coprime_iff_not_dvd.mpr hpb).pow_left 3
        have hp3_c2 : p ^ 3 ∣ c ^ 2 := hcop.dvd_of_dvd_mul_left hp3
        have hp_c2 : p ∣ c ^ 2 := dvd_trans (dvd_pow_self p (by decide : 3 ≠ 0)) hp3_c2
        have hp_c : p ∣ c := hp.dvd_of_dvd_pow hp_c2
        have hdiv : p ^ 3 ∣ p ^ 2 * (c / p) ^ 2 := by
          have hceq : c = p * (c / p) := (Nat.mul_div_cancel' hp_c).symm
          conv at hp3_c2 => rhs; rw [hceq]
          simpa [mul_pow] using hp3_c2
        have hp_dvd_cp : p ∣ (c / p) ^ 2 := by
          have hpow : p ^ 3 = p ^ 2 * p := by ring
          rw [hpow] at hdiv
          exact Nat.dvd_of_mul_dvd_mul_left (pow_pos hp.pos 2) hdiv
        have hp_c_sub : p ∣ c / p := hp.dvd_of_dvd_pow hp_dvd_cp
        have hp2_c : p ^ 2 ∣ c := by
          have : p * p ∣ p * (c / p) := Nat.mul_dvd_mul_left p hp_c_sub
          rwa [Nat.mul_div_cancel' hp_c, ← sq] at this
        exact hp.ne_one (Nat.isUnit_iff.mp (hsc p (by simpa [sq] using hp2_c)))
  have hK1 : 1 < b * c ^ 2 := by
    have hKpos : 0 < b * c ^ 2 := mul_pos hb (sq_pos_of_pos hc)
    by_contra hle
    have hKeq : b * c ^ 2 = 1 := by omega
    have hmul : n * (n + 1) = (u * b * c) ^ 3 := by
      calc n * (n + 1) = M := rfl
      _ = b * c ^ 2 * (u * b * c) ^ 3 := hKM.symm
      _ = (u * b * c) ^ 3 := by rw [hKeq, one_mul]
    have hcop1 : IsUnit (gcd n (n + 1)) := by
      change IsUnit (Nat.gcd n (n + 1))
      rw [Nat.coprime_self_add_right.mpr (Nat.coprime_one_right n)]
      exact isUnit_one
    have hcop2 : IsUnit (gcd (n + 1) n) := by
      change IsUnit (Nat.gcd (n + 1) n)
      rw [Nat.coprime_self_add_left.mpr (Nat.coprime_one_left n)]
      exact isUnit_one
    obtain ⟨x, hx⟩ := exists_eq_pow_of_mul_eq_pow hcop1 hmul
    obtain ⟨y, hy⟩ := exists_eq_pow_of_mul_eq_pow hcop2 (mul_comm n (n + 1) ▸ hmul)
    have hxy : x ^ 3 + 1 = y ^ 3 := by rw [← hx, ← hy]
    have hx1 : 1 ≤ x := by
      by_contra hx0
      have hx_zero : x = 0 := by omega
      subst hx_zero
      omega
    have hlt : x < y := by
      by_contra hyx
      have hy_le : y ≤ x := by omega
      have : y ^ 3 ≤ x ^ 3 := Nat.pow_le_pow_left hy_le 3
      omega
    have hxy_le : x + 1 ≤ y := hlt
    have hpow : (x + 1) ^ 3 ≤ y ^ 3 := Nat.pow_le_pow_left hxy_le 3
    nlinarith [sq_nonneg x]
  have h2U : 2 ∣ u * b * c := by
    by_contra hnd
    have hodd3 : ¬ 2 ∣ (u * b * c) ^ 3 := fun h => hnd (Nat.prime_two.dvd_of_dvd_pow h)
    have hcop : (8 : ℕ).Coprime ((u * b * c) ^ 3) :=
      (Nat.prime_two.coprime_iff_not_dvd.mpr hodd3).pow_left 3
    have h8K : 8 ∣ b * c ^ 2 := hcop.dvd_of_dvd_mul_right h8
    exact (hrad_and_cf 2 Nat.prime_two ((by decide : 2 ∣ 8).trans h8K)).2 h8K
  refine ⟨b * c ^ 2, u * b * c, hK1, mul_pos (mul_pos hu hb) hc, h2U, ?_, h8, hrad_and_cf⟩
  calc (b * c ^ 2 * n) ^ 2 + b * c ^ 2 * (b * c ^ 2 * n)
      = (b * c ^ 2) ^ 2 * M := by dsimp [M]; ring
    _ = (b * c ^ 2) ^ 2 * (u ^ 3 * b ^ 4 * c ^ 5) := by rw [← hMeq]
    _ = (b * c ^ 2 * (u * b * c)) ^ 3 := by ring

private theorem full_of_elliptic (K u n : ℕ) (hK : 0 < K) (_hu : 0 < u) (_hn : 0 < n)
    (hec : (K * n) ^ 2 + K * (K * n) = (K * u) ^ 3)
    (hrad : ∀ p, p.Prime → p ∣ K → p ∣ u) :
    (3).Full n ∧ (3).Full (n + 1) := by
  have hM : n * (n + 1) = K * u ^ 3 := by
    have hK2 : 0 < K ^ 2 := pow_pos hK 2
    have heq : K ^ 2 * (n * (n + 1)) = K ^ 2 * (K * u ^ 3) := by
      calc K ^ 2 * (n * (n + 1)) = (K * n) ^ 2 + K * (K * n) := by ring
      _ = (K * u) ^ 3 := hec
      _ = K ^ 2 * (K * u ^ 3) := by ring
    exact Nat.eq_of_mul_eq_mul_left hK2 heq
  have hdvd_full : ∀ x y : ℕ, x * y = K * u ^ 3 → Nat.Coprime x y → (3).Full x := by
    intro x y hxy hcop p hp
    have hpp := (Nat.mem_primeFactors.mp hp).1
    have hpx := Nat.dvd_of_mem_primeFactors hp
    have hpu : p ∣ u := by
      have hpKu3 : p ∣ K * u ^ 3 := hxy ▸ hpx.mul_right y
      rcases hpp.dvd_mul.mp hpKu3 with hpK | hpu3
      · exact hrad p hpp hpK
      · exact hpp.dvd_of_dvd_pow hpu3
    have hp3_xy : p ^ 3 ∣ x * y := hxy ▸ (pow_dvd_pow_of_dvd hpu 3).trans (dvd_mul_left _ _)
    have hp3_cop : (p ^ 3).Coprime y :=
      (hpp.coprime_iff_not_dvd.mpr fun hpy => hpp.not_dvd_one (hcop.gcd_eq_one ▸ Nat.dvd_gcd hpx hpy)).pow_left 3
    exact hp3_cop.dvd_of_dvd_mul_right hp3_xy
  refine ⟨hdvd_full n (n + 1) hM (Nat.coprime_self_add_right.mpr (Nat.coprime_one_right n)), ?_⟩
  exact hdvd_full (n + 1) n (by rw [mul_comm, hM]) (Nat.coprime_self_add_left.mpr (Nat.coprime_one_left n))

theorem cubic_reciprocity_of_thue {A B d a p : ℕ} (hp : p.Prime) (hp3 : p % 3 = 1)
    (heq : B * d ^ 3 = A * a ^ 3 + 1) (hpA : p ∣ A) :
    B ^ ((p - 1) / 3) % p = 1 := by
  have : Fact p.Prime := ⟨hp⟩
  have hd_ndvd : ¬ p ∣ d := by
    intro hpd
    have h1 : p ∣ B * d ^ 3 := dvd_mul_of_dvd_right (dvd_pow hpd (by decide)) B
    have h2 : p ∣ A * a ^ 3 := dvd_mul_of_dvd_left hpA _
    rw [heq] at h1
    exact hp.not_dvd_one ((Nat.dvd_add_right h2).mp h1)
  have hzA : (A : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff A p).mpr hpA
  have hz_eq : (B : ZMod p) * (d : ZMod p) ^ 3 = 1 := by
    have h := congr_arg (Nat.cast : ℕ → ZMod p) heq
    simpa [hzA] using h
  have hd_ne : (d : ZMod p) ≠ 0 := by
    intro h0
    exact hd_ndvd ((ZMod.natCast_eq_zero_iff d p).mp h0)
  have hpow := congr_arg (· ^ ((p - 1) / 3)) hz_eq
  simp only [mul_pow, one_pow] at hpow
  have hexp : 3 * ((p - 1) / 3) = p - 1 := by omega
  rw [← pow_mul, hexp, ZMod.pow_card_sub_one_eq_one hd_ne, mul_one] at hpow
  have : Fact (1 < p) := ⟨hp.one_lt⟩
  have hval := congr_arg ZMod.val hpow
  rwa [← Nat.cast_pow, ZMod.val_natCast, ZMod.val_one] at hval

theorem quad_not_three_mul_cube (v w : ℕ) (hv : 1 < v) (hw : 0 < w) :
    v ^ 2 + v + 1 ≠ 3 * w ^ 3 := by
  intro heq
  have hflt := fermatLastTheoremThree
  have heqZ : (v : ℤ) ^ 2 + (v : ℤ) + 1 = 3 * (w : ℤ) ^ 3 := by exact_mod_cast heq
  have hcubeZ : ((v : ℤ) + 2) ^ 3 + (1 - (v : ℤ)) ^ 3 = (3 * (w : ℤ)) ^ 3 := by
    calc ((v : ℤ) + 2) ^ 3 + (1 - (v : ℤ)) ^ 3
        = 9 * ((v : ℤ) ^ 2 + (v : ℤ) + 1) := by ring
      _ = 9 * (3 * (w : ℤ) ^ 3) := by rw [heqZ]
      _ = (3 * (w : ℤ)) ^ 3 := by ring
  have hnat : (v - 1) ^ 3 + (3 * w) ^ 3 = (v + 2) ^ 3 := by
    zify [show 1 ≤ v by omega] at *
    linarith
  exact hflt (v - 1) (3 * w) (v + 2) (by omega) (by omega) (by omega) hnat

private theorem mod9_k2p_excl_aux : ∀ x y : ZMod 9,
    ¬ (16 * y ^ 3 + 1 = 5 * x ^ 3 ∨ 5 * x ^ 3 + 1 = 16 * y ^ 3) := by decide

theorem mod9_k2p_excl (p a b : ℕ) (hp : p % 9 = 5) :
    ¬ (16 * b ^ 3 + 1 = p * a ^ 3 ∨ p * a ^ 3 + 1 = 16 * b ^ 3) := by
  have hpZ : (p : ZMod 9) = 5 := by
    rw [← Nat.div_add_mod p 9, hp]
    push_cast
    have h9 : (9 : ZMod 9) = 0 := by decide
    simp [h9]
  rintro (h | h)
  · have hz := congr_arg (Nat.cast : ℕ → ZMod 9) h
    push_cast at hz
    rw [hpZ] at hz
    exact mod9_k2p_excl_aux a b (Or.inl hz)
  · have hz := congr_arg (Nat.cast : ℕ → ZMod 9) h
    push_cast at hz
    rw [hpZ] at hz
    exact mod9_k2p_excl_aux a b (Or.inr hz)

private theorem BST.all_contains (t : BST) (p : ℕ → Bool) (x : ℕ) :
    t.all p = true → t.contains x = true → p x = true := by
  induction t with
  | leaf => simp [BST.contains]
  | node v l r ihl ihr =>
    intro hall hcont
    simp only [BST.all, Bool.and_eq_true] at hall
    simp only [BST.contains] at hcont
    split_ifs at hcont with hx hlt
    · rw [beq_iff_eq] at hx
      subst hx
      exact hall.1.1
    · exact ihl hall.1.2 hcont
    · exact ihr hall.2 hcont

private theorem loopA_sound (evT odT : BST) (bc lim f a0 a : ℕ) (_hbc : 0 < bc) (ha0 : a0 ≤ a)
    (hf : lim < (a0 + f) ^ 3 * bc) (hloop : loopA evT odT bc lim f a0 = true)
    (hle : a ^ 3 * bc ≤ lim) :
    (if a ^ 3 * bc % 2 = 0 then evT.contains (a ^ 3 * bc) = true
     else if a ^ 3 * bc % 8 = 1 ∨ a ^ 3 * bc % 8 = 7 then odT.contains (a ^ 3 * bc) = true else True) := by
  induction f generalizing a0 with
  | zero =>
    simp only [Nat.add_zero] at hf
    have : a0 ^ 3 * bc ≤ a ^ 3 * bc := Nat.mul_le_mul_right bc (Nat.pow_le_pow_left ha0 3)
    omega
  | succ f ih =>
    dsimp only [loopA] at hloop
    by_cases hlim : lim < a0 * a0 * a0 * bc
    · have ha3 : a0 ^ 3 * bc ≤ a ^ 3 * bc := Nat.mul_le_mul_right bc (Nat.pow_le_pow_left ha0 3)
      have hv : a0 * a0 * a0 * bc = a0 ^ 3 * bc := by ring
      omega
    · rw [if_neg hlim, Bool.and_eq_true] at hloop
      by_cases heq : a = a0
      · subst heq
        have hv : a * a * a * bc = a ^ 3 * bc := by ring
        rw [hv] at hloop
        have hok := hloop.1
        by_cases h2 : a ^ 3 * bc % 2 = 0
        · have h2b : (a ^ 3 * bc % 2 == 0) = true := beq_iff_eq.mpr h2
          rw [if_pos h2b] at hok
          rw [if_pos h2]
          exact hok
        · have h2b : (a ^ 3 * bc % 2 == 0) = false := beq_false_of_ne h2
          rw [if_neg (by simp [h2b])] at hok
          rw [if_neg h2]
          by_cases h8 : a ^ 3 * bc % 8 = 1 ∨ a ^ 3 * bc % 8 = 7
          · have h8b : ((a ^ 3 * bc % 8 == 1) || (a ^ 3 * bc % 8 == 7)) = true := by
              simp only [Bool.or_eq_true, beq_iff_eq]; exact h8
            rw [if_pos h8b] at hok
            rw [if_pos h8]
            exact hok
          · rw [if_neg h8]; trivial
      · have ha1 : a0 + 1 ≤ a := by omega
        have hf1 : lim < ((a0 + 1) + f) ^ 3 * bc := by
          have : a0 + 1 + f = a0 + (f + 1) := by omega
          rwa [this]
        exact ih (a0 + 1) ha1 hf1 hloop.2

private theorem loopB_sound (evT odT : BST) (c c5 lim maxA f b0 b : ℕ) (hc5 : 0 < c5) (hb : 1 ≤ b) (hb0 : b0 ≤ b)
    (hf : lim < (b0 + f) ^ 4 * c5) (hmaxA : lim < maxA ^ 3)
    (hloop : loopB evT odT c c5 lim maxA f b0 = true)
    (hcop : b.Coprime c) (a : ℕ) (ha : 1 ≤ a) (hle : a ^ 3 * (b ^ 4 * c5) ≤ lim) :
    (if (a ^ 3 * (b ^ 4 * c5)) % 2 = 0 then evT.contains (a ^ 3 * (b ^ 4 * c5)) = true
     else if (a ^ 3 * (b ^ 4 * c5)) % 8 = 1 ∨ (a ^ 3 * (b ^ 4 * c5)) % 8 = 7
          then odT.contains (a ^ 3 * (b ^ 4 * c5)) = true else True) := by
  induction f generalizing b0 with
  | zero =>
    simp only [Nat.add_zero] at hf
    have hb4 : b0 ^ 4 * c5 ≤ b ^ 4 * c5 := Nat.mul_le_mul_right c5 (Nat.pow_le_pow_left hb0 4)
    have ha1 : 1 ≤ a ^ 3 := Nat.one_le_pow 3 a ha
    have : b ^ 4 * c5 ≤ a ^ 3 * (b ^ 4 * c5) := Nat.le_mul_of_pos_left _ ha1
    omega
  | succ f ih =>
    dsimp only [loopB] at hloop
    by_cases hlim : lim < b0 * b0 * (b0 * b0) * c5
    · have hb4 : b0 ^ 4 * c5 ≤ b ^ 4 * c5 := Nat.mul_le_mul_right c5 (Nat.pow_le_pow_left hb0 4)
      have ha1 : 1 ≤ a ^ 3 := Nat.one_le_pow 3 a ha
      have hle2 : b ^ 4 * c5 ≤ a ^ 3 * (b ^ 4 * c5) := Nat.le_mul_of_pos_left _ ha1
      have hbc : b0 * b0 * (b0 * b0) * c5 = b0 ^ 4 * c5 := by ring
      omega
    · rw [if_neg hlim, Bool.and_eq_true] at hloop
      by_cases heq : b = b0
      · subst heq
        have hbc_eq : b * b * (b * b) * c5 = b ^ 4 * c5 := by ring
        rw [hbc_eq] at hloop
        have hbc_pos : 0 < b ^ 4 * c5 := mul_pos (pow_pos hb 4) hc5
        have hok := hloop.1
        have hgcd : (Nat.gcd b c == 1) = true := beq_iff_eq.mpr hcop
        rw [if_pos hgcd] at hok
        have hfA : lim < (1 + maxA) ^ 3 * (b ^ 4 * c5) := by
          have h1 : maxA ^ 3 ≤ (1 + maxA) ^ 3 := Nat.pow_le_pow_left (by omega) 3
          have h2 : (1 + maxA) ^ 3 ≤ (1 + maxA) ^ 3 * (b ^ 4 * c5) := Nat.le_mul_of_pos_right _ hbc_pos
          exact lt_of_lt_of_le hmaxA (h1.trans h2)
        exact loopA_sound evT odT (b ^ 4 * c5) lim maxA 1 a hbc_pos ha hfA hok hle
      · have hb1 : b0 + 1 ≤ b := by omega
        have hf1 : lim < ((b0 + 1) + f) ^ 4 * c5 := by
          have : b0 + 1 + f = b0 + (f + 1) := by omega
          rwa [this]
        exact ih (b0 + 1) hb1 hf1 hloop.2

private theorem loopC_sound (evT odT : BST) (lim maxB maxA f c0 c : ℕ) (hc_pos : 1 ≤ c) (hc0 : c0 ≤ c)
    (hf : lim < (c0 + f) ^ 5) (hmaxB : lim < maxB ^ 4) (hmaxA : lim < maxA ^ 3)
    (hloop : loopC evT odT lim maxB maxA f c0 = true)
    (a b : ℕ) (ha : 1 ≤ a) (hb : 1 ≤ b) (hcop : b.Coprime c) (hle : a ^ 3 * b ^ 4 * c ^ 5 ≤ lim) :
    (if (a ^ 3 * b ^ 4 * c ^ 5) % 2 = 0 then evT.contains (a ^ 3 * b ^ 4 * c ^ 5) = true
     else if (a ^ 3 * b ^ 4 * c ^ 5) % 8 = 1 ∨ (a ^ 3 * b ^ 4 * c ^ 5) % 8 = 7
          then odT.contains (a ^ 3 * b ^ 4 * c ^ 5) = true else True) := by
  induction f generalizing c0 with
  | zero =>
    simp only [Nat.add_zero] at hf
    have hc5 : c0 ^ 5 ≤ c ^ 5 := Nat.pow_le_pow_left hc0 5
    have ha1 : 0 < a ^ 3 * b ^ 4 := mul_pos (pow_pos ha 3) (pow_pos hb 4)
    have : c ^ 5 ≤ a ^ 3 * b ^ 4 * c ^ 5 := Nat.le_mul_of_pos_left _ ha1
    omega
  | succ f ih =>
    dsimp only [loopC] at hloop
    by_cases hlim : lim < c0 * c0 * (c0 * c0) * c0
    · have hc5 : c0 ^ 5 ≤ c ^ 5 := Nat.pow_le_pow_left hc0 5
      have ha1 : 0 < a ^ 3 * b ^ 4 := mul_pos (pow_pos ha 3) (pow_pos hb 4)
      have hle2 : c ^ 5 ≤ a ^ 3 * b ^ 4 * c ^ 5 := Nat.le_mul_of_pos_left _ ha1
      have hc_eq : c0 * c0 * (c0 * c0) * c0 = c0 ^ 5 := by ring
      omega
    · rw [if_neg hlim, Bool.and_eq_true] at hloop
      by_cases heq : c = c0
      · subst heq
        have hc_eq : c * c * (c * c) * c = c ^ 5 := by ring
        rw [hc_eq] at hloop
        have hc5_pos : 0 < c ^ 5 := pow_pos hc_pos 5
        have hfB : lim < (1 + maxB) ^ 4 * c ^ 5 := by
          have h1 : maxB ^ 4 ≤ (1 + maxB) ^ 4 := Nat.pow_le_pow_left (by omega) 4
          have h2 : (1 + maxB) ^ 4 ≤ (1 + maxB) ^ 4 * c ^ 5 := Nat.le_mul_of_pos_right _ hc5_pos
          exact lt_of_lt_of_le hmaxB (h1.trans h2)
        have hle' : a ^ 3 * (b ^ 4 * c ^ 5) ≤ lim := by linear_combination hle
        have res := loopB_sound evT odT c (c ^ 5) lim maxA maxB 1 b hc5_pos hb hb hfB hmaxA hloop.1 hcop a ha hle'
        have hassoc : a ^ 3 * (b ^ 4 * c ^ 5) = a ^ 3 * b ^ 4 * c ^ 5 := by ring
        rwa [hassoc] at res
      · have hc1 : c0 + 1 ≤ c := by omega
        have hf1 : lim < ((c0 + 1) + f) ^ 5 := by
          have : c0 + 1 + f = c0 + (f + 1) := by omega
          rwa [this]
        exact ih (c0 + 1) hc1 hf1 hloop.2

private theorem no_pair_of_cert (evT odT : BST) (lim maxB maxA maxC : ℕ)
    (hc : lim < (1 + maxC) ^ 5) (hb : lim < maxB ^ 4) (ha : lim < maxA ^ 3)
    (hdisj : evT.all (fun x => !odT.contains (x - 1) && !odT.contains (x + 1)) = true)
    (hgen : loopC evT odT lim maxB maxA maxC 1 = true)
    (n : ℕ) (hn : 0 < n) (hn_lim : n + 1 ≤ lim)
    (hfn : (3).Full n) (hfn1 : (3).Full (n + 1)) : False := by
  have contain_even_or_odd : ∀ m : ℕ, 0 < m → m ≤ lim → (3).Full m →
      (if m % 2 = 0 then evT.contains m = true
       else if m % 8 = 1 ∨ m % 8 = 7 then odT.contains m = true else True) := by
    intro m hm hm_lim hfm
    obtain ⟨a, b, c, ha0, hb0, hc0, _, _, hbc, hmeq⟩ := cube_full_canonical m hm hfm
    rw [hmeq]
    have hmeq' : a ^ 3 * b ^ 4 * c ^ 5 ≤ lim := hmeq ▸ hm_lim
    exact loopC_sound evT odT lim maxB maxA maxC 1 c hc0 hc0 hc hb ha hgen a b ha0 hb0 hbc hmeq'
  by_cases hn_even : n % 2 = 0
  · have hE := contain_even_or_odd n hn (by omega) hfn
    rw [if_pos hn_even] at hE
    have h8 : 8 ∣ n := by
      have hp2 : 2 ∈ n.primeFactors := Nat.mem_primeFactors.mpr ⟨Nat.prime_two, Nat.dvd_of_mod_eq_zero hn_even, hn.ne'⟩
      simpa using hfn 2 hp2
    have ho_mod : (n + 1) % 2 ≠ 0 ∧ ((n + 1) % 8 = 1 ∨ (n + 1) % 8 = 7) := by omega
    have hO := contain_even_or_odd (n + 1) (Nat.succ_pos n) hn_lim hfn1
    rw [if_neg ho_mod.1, if_pos ho_mod.2] at hO
    have hbot := BST.all_contains evT _ n hdisj hE
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at hbot
    rw [hO] at hbot
    exact Bool.false_ne_true hbot.2.symm
  · have hn1_even : (n + 1) % 2 = 0 := by omega
    have hE := contain_even_or_odd (n + 1) (Nat.succ_pos n) hn_lim hfn1
    rw [if_pos hn1_even] at hE
    have h8 : 8 ∣ n + 1 := by
      have hp2 : 2 ∈ (n + 1).primeFactors :=
        Nat.mem_primeFactors.mpr ⟨Nat.prime_two, Nat.dvd_of_mod_eq_zero hn1_even, (Nat.succ_pos n).ne'⟩
      simpa using hfn1 2 hp2
    have ho_mod : n % 2 ≠ 0 ∧ (n % 8 = 1 ∨ n % 8 = 7) := by omega
    have hO := contain_even_or_odd n hn (by omega) hfn
    rw [if_neg ho_mod.1, if_pos ho_mod.2] at hO
    have hbot := BST.all_contains evT _ (n + 1) hdisj hE
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at hbot
    simp only [Nat.add_sub_cancel] at hbot
    rw [hO] at hbot
    exact Bool.false_ne_true hbot.1.symm


