theorem oddKernelCovered (d : ℕ) (hodd : Odd d) (hd : d < 65536)
    (hopen : ∀ d ∈ openMultipliers, ∃ e : ℕ, 65536 ≤ d * 2 ^ e ∧ (d * 2 ^ e + 1).Prime)
    (hlong : ∀ d ∈ largerMultipliers, ∃ e : ℕ, 65536 ≤ d * 2 ^ e ∧ (d * 2 ^ e + 1).Prime) :
    ∃ e : ℕ, 65536 ≤ d * 2 ^ e ∧ (d * 2 ^ e + 1).Prime := by
  obtain ⟨i, rfl⟩ := hodd
  let b := i / 128
  let slot := i % 128
  have hjoin : 128 * b + slot = i := Nat.div_add_mod i 128
  have hb : b < 256 := by dsimp [b]; omega
  have hi : slot < 128 := Nat.mod_lt _ (by decide)
  let entry := unpack (blockWord b) slot
  have hc : checkEntry (2 * i + 1) entry = true := by
    simpa only [hjoin] using block_check (checkedBlock b hb) hi
  by_cases hmissing : entry.1 = 0
  · have hm : 2 * i + 1 ∈ exceptions := of_decide_eq_true (by
      simpa only [checkEntry, if_pos hmissing] using hc)
    simp only [exceptions, List.mem_append] at hm
    rcases hm with (ho | hl) | hs
    · exact hopen _ ho
    · exact hlong _ hl
    · exact shortWitness _ hs
  · have hv : checkWitness (2 * i + 1) entry.1 entry.2 = true := by
      simpa only [checkEntry, if_neg hmissing] using hc
    obtain ⟨he, hbound, hbig, hmod⟩ := witness_semantics hv
    obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero he.ne'
    refine ⟨entry.1, hbig, ?_⟩
    rw [hj]
    apply OMA.ProthAudit.prime_of_mod_certificate (2 * i + 1) j entry.2 (by omega)
    · simpa only [hj, Nat.succ_eq_add_one] using hbound
    · change _ % _ = _ % _ at hmod
      have hcert := hmod.trans (Nat.mod_eq_of_lt
        (Nat.lt_succ_self ((2 * i + 1) * 2 ^ entry.1)))
      simpa only [hj, Nat.succ_sub_one] using hcert

end OMA.A78680

namespace OMA.R_OeisA78680_conjecture_R1_H2_R1

open OMA.A78680

/-- Positive-exponent prime witnesses for the four still-open odd multipliers. -/
def H1 : Prop := ∀ d ∈ [21181, 22699, 24737, 55459],
  ∃ e : ℕ, 65536 ≤ d * 2 ^ e ∧ (d * 2 ^ e + 1).Prime

/-- Prime witnesses in the remaining finite list, beyond the bounded certificate search. -/
def H2 : Prop := ∀ d ∈ [383, 2897, 3061, 3443, 4037, 4847, 4861, 5297, 5359, 5897, 6319, 6977,
  7013, 7493, 7651, 7909, 7957, 8423, 8543, 9323, 10223, 10583, 10967, 12527,
  13787, 14027, 14119, 16519, 16817, 16987, 17597, 17701, 18107, 18203, 19021, 19249,
  20851, 21167, 21803, 23779, 24151, 25171, 25339, 25819, 25861, 27653, 27923, 28433,
  30091, 31951, 32161, 32393, 33661, 34565, 34711, 34999, 35987, 36781, 36983, 37561,
  38029, 39079, 39781, 40547, 42257, 43429, 44131, 44903, 45737, 46157, 46159, 46187,
  46403, 46471, 47179, 47897, 47911, 48833, 49219, 50693, 51617, 51917, 52771, 52909,
  53941, 54001, 54739, 54767, 56543, 57503, 59569, 60443, 60541, 60829, 62093, 62761,
  63017, 63379, 64007, 64039, 65057, 65477],
  ∃ e : ℕ, 65536 ≤ d * 2 ^ e ∧ (d * 2 ^ e + 1).Prime

theorem main : H1 → H2 → OMA.R_OeisA78680_conjecture_R1.H2 := by
  intro hopen hlong n ⟨hnpos, hnlt⟩
  change n < 65536 at hnlt
  obtain ⟨d, t, hdOdd, hdecomp⟩ := odd_decomposition (show 0 < n by omega)
  have hd_le : d ≤ n := by
    rw [hdecomp]
    exact Nat.le_mul_of_pos_right _ (pow_pos (by decide : 0 < 2) _)
  obtain ⟨e, hbig, hprime⟩ := oddKernelCovered d hdOdd (hd_le.trans_lt hnlt) hopen hlong
  have hex := exponent_transfer hnlt hdecomp hbig hprime
  classical
  rw [OeisA78680.a, dif_pos hex]
  exact (Nat.find_spec hex).1.ne'

end OMA.R_OeisA78680_conjecture_R1_H2_R1
