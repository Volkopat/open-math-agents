private def checkEntry (k : ℕ) (entry : ℕ × ℕ) : Bool :=
  if entry.1 = 0 then decide (k ∈ exceptions)
  else checkWitness k entry.1 entry.2

/-- Traverse the packed words from low to high, shortening the data at each step. -/
private def checkChunk : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | size + 1, first, packed =>
    checkEntry first (readEntry packed) &&
      checkChunk size (first + 2) (packed / 2 ^ 24)

private def checkBlock (packed b : ℕ) : Bool :=
  checkChunk 128 (2 * (128 * b) + 1) packed

private theorem checkChunk_sound {size first packed i : ℕ}
    (h : checkChunk size first packed = true) (hi : i < size) :
    checkEntry (first + 2 * i) (unpack packed i) = true := by
  induction size generalizing first packed i with
  | zero => omega
  | succ size ih =>
    rw [checkChunk, Bool.and_eq_true_iff] at h
    cases i with
    | zero => simpa only [Nat.mul_zero, Nat.add_zero, unpack, pow_zero, Nat.div_one] using h.1
    | succ i =>
      have hfirst : first + 2 * i.succ = first + 2 + 2 * i := by omega
      rw [unpack_succ, hfirst]
      exact ih h.2 (by omega)

private theorem block_check {packed b i : ℕ} (h : checkBlock packed b = true)
    (hi : i < 128) : checkEntry (2 * (128 * b + i) + 1) (unpack packed i) = true := by
  have heq : 2 * (128 * b + i) + 1 = 2 * (128 * b) + 1 + 2 * i := by omega
  rw [heq]
  exact checkChunk_sound h hi

