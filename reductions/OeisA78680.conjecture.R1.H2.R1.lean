import OMAReductions.R_OeisA78680_conjecture_R1
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.Tactic

/-!
Reduce the A078680 finite nonvanishing step using the odd part of the multiplier.
A Proth certificate gives a prime of the required form for each nonzero table entry.
Each verified prime is above the cutoff, so it also supplies a witness for every
allowed even multiplier with the same odd part.

The four open multipliers below 65536 are listed by PrimeGrid at
https://val2.primegrid.com/forum_thread.php?id=1647.
The bounded witness table was computed independently and is certified in Lean.
-/


namespace OMA.ProthAudit

/-- A Proth certificate gives primality using only ordinary modular arithmetic. -/
theorem prime_of_certificate (d e a : ℕ)
    (hd : 0 < d) (hbound : d < 2 ^ (e + 1))
    (hcert : (d * 2 ^ (e + 1) + 1) ∣ (a ^ (d * 2 ^ e) + 1)) :
    Nat.Prime (d * 2 ^ (e + 1) + 1) := by
  let N := d * 2 ^ (e + 1) + 1
  let p := N.minFac
  have ht : 0 < (2 : ℕ) ^ (e + 1) := by positivity
  have hN : 1 < N := Nat.lt_add_one_iff.mpr (Nat.succ_le_of_lt (Nat.mul_pos hd ht))
  have hp : Nat.Prime p := Nat.minFac_prime (ne_of_gt hN)
  have hpd : p ∣ N := Nat.minFac_dvd N
  have hp2 : 2 < p := by
    refine lt_of_le_of_ne hp.two_le ?_
    intro he
    have htwo : 2 ∣ N := he.symm ▸ hpd
    obtain ⟨c, hc⟩ := htwo
    dsimp [N] at hc
    rw [pow_succ, ← mul_assoc] at hc
    omega
  let : Fact (Nat.Prime p) := ⟨hp⟩
  let : Fact (2 < p) := ⟨hp2⟩
  let b := (a : ZMod p) ^ d
  have hplus : ((a ^ (d * 2 ^ e) + 1 : ℕ) : ZMod p) = 0 :=
    (ZMod.natCast_eq_zero_iff _ _).mpr (hpd.trans hcert)
  have hpow : b ^ (2 ^ e) = -1 := by
    push_cast at hplus
    rw [pow_mul] at hplus
    exact eq_neg_of_add_eq_zero_left hplus
  have hne : b ^ (2 ^ e) ≠ 1 := hpow ▸ ZMod.neg_one_ne_one
  have hb : b ≠ 0 := by
    intro hb
    exact (neg_ne_zero.mpr one_ne_zero) (hpow.symm.trans (by simp [hb]))
  have hnext : b ^ (2 ^ (e + 1)) = 1 := by
    rw [pow_succ, pow_mul, hpow]
    norm_num
  have hord : orderOf b = 2 ^ (e + 1) := by
    obtain ⟨k, hk, heq⟩ :=
      (Nat.dvd_prime_pow Nat.prime_two).mp (orderOf_dvd_of_pow_eq_one hnext)
    have hnk : ¬ k ≤ e := by
      intro hle
      have hdiv : orderOf b ∣ 2 ^ e := heq ▸ pow_dvd_pow 2 hle
      exact hne (orderOf_dvd_iff_pow_eq_one.mp hdiv)
    have hke : k = e + 1 := by omega
    simpa only [hke] using heq
  have hlarge : 2 ^ (e + 1) ≤ p - 1 :=
    Nat.le_of_dvd (by omega) (hord ▸ ZMod.orderOf_dvd_card_sub_one hb)
  by_contra hnot
  have hsq : p ^ 2 ≤ N := Nat.minFac_sq_le_self (by omega) hnot
  dsimp [N] at hsq
  have hpp : 2 ^ (e + 1) + 1 ≤ p := by omega
  have hmul : d * 2 ^ (e + 1) < (2 : ℕ) ^ (e + 1) * 2 ^ (e + 1) :=
    Nat.mul_lt_mul_of_pos_right hbound ht
  nlinarith [Nat.mul_self_le_mul_self hpp]

theorem prime_of_mod_certificate (d e a : ℕ)
    (hd : 0 < d) (hbound : d < 2 ^ (e + 1))
    (hcert : (a ^ (d * 2 ^ e)) % (d * 2 ^ (e + 1) + 1) = d * 2 ^ (e + 1)) :
    Nat.Prime (d * 2 ^ (e + 1) + 1) := by
  apply prime_of_certificate d e a hd hbound
  rw [Nat.dvd_iff_mod_eq_zero, Nat.add_mod, hcert]
  have hmod : 1 % (d * 2 ^ (e + 1) + 1) = 1 :=
    Nat.mod_eq_of_lt (Nat.lt_add_one_iff.mpr (Nat.succ_le_of_lt (by positivity)))
  rw [hmod, Nat.mod_self]

end OMA.ProthAudit

namespace OMA.A78680

/-- Compute a modular power by repeated squaring, reducing after each multiplication. -/
private def modPower (a n m : ℕ) : ℕ :=
  Nat.binaryRec (motive := fun _ => ℕ) (1 % m)
    (fun b _ t => (if b then a * (t * t) else t * t) % m) n

theorem cast_modPower (a n m : ℕ) : (modPower a n m : ZMod m) = (a : ZMod m) ^ n := by
  induction n using Nat.binaryRec with
  | zero => simp [modPower, ZMod.natCast_mod]
  | bit b n ih =>
    unfold modPower
    rw [Nat.binaryRec_eq b n (Or.inl (by
      change ((1 % m) * (1 % m)) % m = 1 % m
      simpa only [one_mul] using (Nat.mul_mod 1 1 m).symm))]
    change (((if b then a * (modPower a n m * modPower a n m)
      else modPower a n m * modPower a n m) % m : ℕ) : ZMod m) =
      (a : ZMod m) ^ (n.bit b)
    rw [ZMod.natCast_mod]
    cases b
    · simp [Nat.bit, two_mul, pow_add, ih]
    · simp [Nat.bit, pow_add, ih, mul_comm, pow_mul, pow_two]

private def squareIter (m : ℕ) : ℕ → ℕ → ℕ
  | 0, x => x
  | j + 1, x => squareIter m j ((x * x) % m)

theorem cast_squareIter (m j x : ℕ) :
    (squareIter m j x : ZMod m) = (x : ZMod m) ^ (2 ^ j) := by
  induction j generalizing x with
  | zero => simp [squareIter]
  | succ j ih =>
    rw [squareIter, ih, ZMod.natCast_mod, Nat.cast_mul, ← pow_two, ← pow_mul, pow_succ']

private def checkWitness (k e a : ℕ) : Bool :=
  let t := k * 2 ^ e
  decide (0 < e ∧ k < 2 ^ e ∧ 65536 ≤ t) &&
    squareIter (t + 1) (e - 1) (modPower a k (t + 1)) == t

theorem witness_semantics {k e a : ℕ} (hc : checkWitness k e a = true) :
    0 < e ∧ k < 2 ^ e ∧ 65536 ≤ k * 2 ^ e ∧
      a ^ (k * 2 ^ (e - 1)) ≡ k * 2 ^ e [MOD k * 2 ^ e + 1] := by
  unfold checkWitness at hc
  let t := k * 2 ^ e
  have ⟨hc₁, hc₂⟩ := Bool.and_eq_true_iff.mp hc
  obtain ⟨he, hk, ht⟩ := of_decide_eq_true hc₁
  have hmod : squareIter (t + 1) (e - 1) (modPower a k (t + 1)) = t := beq_iff_eq.mp hc₂
  have hcast := cast_squareIter (t + 1) (e - 1) (modPower a k (t + 1))
  rw [hmod, cast_modPower, ← pow_mul, ← Nat.cast_pow] at hcast
  exact ⟨he, hk, ht, (ZMod.natCast_eq_natCast_iff _ _ _).mp hcast.symm⟩

theorem odd_decomposition {n : ℕ} (hn : 0 < n) :
    ∃ k t : ℕ, Odd k ∧ n = k * 2 ^ t := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hodd : Odd n
    · exact ⟨n, 0, hodd, by simp⟩
    · obtain ⟨j, hj⟩ := Nat.not_odd_iff_even.mp hodd
      obtain ⟨k, t, hk, hkt⟩ := ih j (by omega) (by omega)
      refine ⟨k, t + 1, hk, ?_⟩
      rw [hj, hkt, pow_succ, ← Nat.mul_assoc]
      omega

theorem exponent_transfer {n k t e : ℕ} (hn : n < 65536)
    (heq : n = k * 2 ^ t) (hbig : 65536 ≤ k * 2 ^ e)
    (hp : (k * 2 ^ e + 1).Prime) :
    ∃ m : ℕ, 0 < m ∧ (n * 2 ^ m + 1).Prime := by
  have hte : t < e := by
    by_contra! hn'
    have hbound := Nat.mul_le_mul_left k (Nat.pow_le_pow_right (by decide : 0 < 2) hn')
    omega
  refine ⟨e - t, by omega, ?_⟩
  rw [heq, Nat.mul_assoc, ← pow_add, show t + (e - t) = e by omega]
  exact hp

/-- Read one 24-bit witness word. -/
private def readEntry (packed : ℕ) : ℕ × ℕ :=
  let word := packed % 2 ^ 24
  (word % 2 ^ 16, word / 2 ^ 16)

private def unpack (packed slot : ℕ) : ℕ × ℕ :=
  readEntry (packed / (2 ^ 24) ^ slot)

private theorem unpack_succ (packed i : ℕ) :
    unpack packed (i + 1) = unpack (packed / 2 ^ 24) i := by
  unfold unpack
  rw [Nat.div_div_eq_div_mul, pow_succ']

